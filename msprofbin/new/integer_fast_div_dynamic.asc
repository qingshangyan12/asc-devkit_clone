* Fast division using magic number - Dynamic Block Count Version
* Usage: ./demo [total_elements] [elements_per_thread]
* Example: ./demo 131072 64
*/

#include <chrono>
#include <iostream>
#include <iterator>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "tiling/platform/platform_ascendc.h"

namespace {
    constexpr uint32_t MAX_THREAD_COUNT = 2048;
    constexpr uint32_t MAX_BLOCK_COUNT = 65535;
    constexpr uint32_t BIT_64_LEN = 64;
    constexpr uint8_t BIT_32_LEN = 32;
}

__aicore__ inline int64_t CountLeadingZero(uint64_t x) {
    return clz(x);
}

__aicore__ inline int64_t GetBitCount1(uint64_t x) {
    return bcnt1(x);
}

__aicore__ inline void simd_calc_magic_shift(
    uint32_t& magic_out,
    uint32_t& shift_out,
    uint32_t divisor)
{
    if (divisor == 0) {
        magic_out = 0;
        shift_out = 0;
        return;
    }

    int64_t pos = BIT_64_LEN - CountLeadingZero(divisor);
    int64_t cnt1 = GetBitCount1(divisor);
    uint32_t shift = (cnt1 == 1) ? (pos - 1) : pos;
    uint32_t magic = (1l << BIT_32_LEN) * ((1l << shift) - divisor) / divisor + 1;

    magic_out = magic;
    shift_out = shift;
}

__simt_vf__ __launch_bounds__(2048) inline void simt_fast_div(
    __gm__ uint32_t* dividend,
    __gm__ uint32_t* output,
    uint32_t magic,
    uint32_t shift,
    uint32_t total_length,
    uint32_t elements_per_thread,
    uint32_t total_chunks,
    uint32_t total_threads)
{
    uint32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;

    for (uint32_t chunk_idx = global_idx; chunk_idx < total_chunks; chunk_idx += total_threads) {
        uint32_t start_idx = chunk_idx * elements_per_thread;
        uint32_t end_idx = start_idx + elements_per_thread;
        if (end_idx > total_length) {
            end_idx = total_length;
        }

        for (uint32_t i = start_idx; i < end_idx; i++) {
            uint32_t value = dividend[i];
            uint32_t q = __umulhi(value, magic);
            output[i] = (value + q) >> shift;
        }
    }
}

__global__ __vector__ void integer_fast_div_kernel(
    __gm__ uint32_t* dividend,
    __gm__ uint32_t* output,
    uint32_t divisor,
    uint32_t total_length,
    uint32_t elements_per_thread,
    uint32_t total_chunks,
    uint32_t total_threads,
    uint32_t thread_num_per_block)
{
    uint32_t magic;
    uint32_t shift;
    simd_calc_magic_shift(magic, shift, divisor);

    asc_vf_call<simt_fast_div>(dim3(thread_num_per_block), dividend, output,
                               magic, shift, total_length, elements_per_thread,
                               total_chunks, total_threads);
}

bool block_split(uint32_t index_total_length, uint32_t &numBlocks, uint32_t &thread_num_per_block) {
    uint32_t real_core_num = 0;
    const auto& platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformInfoMgr == nullptr) {
        std::cout << "[ERROR] Get platform info failed, please check device status." << std::endl;
        return false;
    }
    real_core_num = platformInfoMgr->GetCoreNumAiv();
    numBlocks = real_core_num;
    thread_num_per_block = (index_total_length + numBlocks -1) / numBlocks;
    if (thread_num_per_block > MAX_THREAD_COUNT) {
        thread_num_per_block = MAX_THREAD_COUNT;
        numBlocks = (index_total_length + thread_num_per_block - 1) / thread_num_per_block;
        if (numBlocks > MAX_BLOCK_COUNT) {
            std::cout << "[ERROR] index_total_length: "<< index_total_length << " can not be bigger than "
                << MAX_THREAD_COUNT * MAX_BLOCK_COUNT<< "."<< std::endl;
            return false;
        }
    }
    std::cout << "[INFO] AIV core number: " << real_core_num << std::endl;
    return true;
}

std::vector<uint32_t> integer_fast_div(
    std::vector<uint32_t>& dividend,
    uint32_t divisor,
    uint32_t elements_per_thread)
{
    uint32_t total_length = dividend.size();
    size_t total_byte_size = total_length * sizeof(uint32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* dividend_host = reinterpret_cast<uint8_t*>(dividend.data());
    uint8_t* output_host = nullptr;
    uint32_t* dividend_device = nullptr;
    uint32_t* output_device = nullptr;

    uint32_t total_chunks = (total_length + elements_per_thread - 1) / elements_per_thread;
    uint32_t num_blocks = 0;
    uint32_t thread_num_per_block = 0;
    if (!block_split(total_chunks, num_blocks, thread_num_per_block)) {
        return {};
    }
    uint32_t total_threads = num_blocks * thread_num_per_block;

    std::cout << "[INFO] Total length: " << total_length << std::endl;
    std::cout << "[INFO] Total chunks: " << total_chunks << std::endl;
    std::cout << "[INFO] Block number: " << num_blocks << std::endl;
    std::cout << "[INFO] Threads per block: " << thread_num_per_block << std::endl;
    std::cout << "[INFO] Total threads: " << total_threads << std::endl;
    std::cout << "[INFO] Elements per thread: " << elements_per_thread << std::endl;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMalloc((void**)&dividend_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(dividend_device, total_byte_size, dividend_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t dynUBufSize = 2048;

    auto start = std::chrono::high_resolution_clock::now();

    integer_fast_div_kernel<<<num_blocks, dynUBufSize, stream>>>(
        dividend_device, output_device, divisor, total_length, elements_per_thread,
        total_chunks, total_threads, thread_num_per_block);

    aclrtSynchronizeStream(stream);

    auto end = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);
    std::cout << "[PERF] Kernel execution time: " << duration.count() << " us" << std::endl;

    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> output((uint32_t*)output_host, (uint32_t*)(output_host + total_byte_size));

    aclrtFree(dividend_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

uint32_t verify_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    auto print_tensor = [](std::vector<uint32_t>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<uint32_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };

    print_tensor(output, "Output");
    print_tensor(golden, "Golden");

    uint32_t error_count = 0;
    for (size_t i = 0; i < output.size(); i++) {
        if (output[i] != golden[i]) {
            if (error_count < 10) {
                std::cout << "[Error] Index " << i << ": output=" << output[i]
                         << ", golden=" << golden[i] << std::endl;
            }
            error_count++;
        }
    }

    if (error_count == 0) {
        std::cout << "[Success] All " << output.size() << " elements are correct." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << error_count << " / " << output.size()
                 << " elements are incorrect." << std::endl;
        return 1;
    }
}

uint32_t random_uint32(uint32_t min, uint32_t max)
{
    static std::mt19937 engine(12345);
    std::uniform_int_distribution<uint32_t> dist(min, max);
    return dist(engine);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t total_elements = 131072;
    uint32_t elements_per_thread = 64;

    if (argc > 1) {
        total_elements = std::atoi(argv[1]);
    }
    if (argc > 2) {
        elements_per_thread = std::atoi(argv[2]);
    }

    if (total_elements == 0 || elements_per_thread == 0) {
        std::cerr << "Error: Invalid parameters" << std::endl;
        return 1;
    }

    std::vector<uint32_t> dividend(total_elements);
    for (uint32_t i = 0; i < total_elements; i++) {
        dividend[i] = random_uint32(1, 1000000);
    }

    uint32_t divisor = 9;
    std::cout << "Divisor: " << divisor << std::endl;

    std::vector<uint32_t> golden(total_elements);
    for (uint32_t i = 0; i < total_elements; i++) {
        golden[i] = dividend[i] / divisor;
    }

    std::vector<uint32_t> output = integer_fast_div(dividend, divisor, elements_per_thread);
    if (output.size() != golden.size()) {
        std::cerr << "Error: device output size mismatch" << std::endl;
        return 1;
    }

    return verify_result(output, golden);
}
