* Normal division - Configurable Version
* Usage: ./demo <num_blocks> <threads_per_block> [total_elements]
* Example: ./demo 1 16 131072
*/

#include <chrono>
#include <iostream>
#include <iterator>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "tiling/platform/platform_ascendc.h"

namespace {
    constexpr uint32_t MAX_THREAD_COUNT = 2048;
}

// SIMT function: each thread processes one element
__simt_vf__ __launch_bounds__(2048) inline void simt_normal_div(
    __gm__ uint32_t* dividend,
    __gm__ uint32_t* output,
    uint32_t divisor,
    uint32_t total_length)
{
    // Calculate global thread ID
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;

    // Boundary check
    if (idx >= total_length) {
        return;
    }

    // Each thread processes one element - single division
    uint32_t value = dividend[idx];
    output[idx] = value / divisor;
}

// Main kernel
__global__ __vector__ void integer_normal_div_kernel(
    __gm__ uint32_t* dividend,
    __gm__ uint32_t* output,
    uint32_t divisor,
    uint32_t total_length,
    uint32_t threads_per_block,
    uint32_t num_blocks)
{
    asc_vf_call<simt_normal_div>(dim3(threads_per_block), dividend, output,
                                 divisor, total_length);
}

// Host function
std::vector<uint32_t> integer_normal_div(
    std::vector<uint32_t>& dividend,
    uint32_t divisor,
    uint32_t num_blocks,
    uint32_t threads_per_block)
{
    uint32_t total_length = dividend.size();
    uint32_t total_threads = num_blocks * threads_per_block;

    std::cout << "[INFO] Total length: " << total_length << std::endl;
    std::cout << "[INFO] Block number: " << num_blocks << std::endl;
    std::cout << "[INFO] Threads per block: " << threads_per_block << std::endl;
    std::cout << "[INFO] Total threads: " << total_threads << std::endl;

    size_t total_byte_size = total_length * sizeof(uint32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* dividend_host = reinterpret_cast<uint8_t*>(dividend.data());
    uint8_t* output_host = nullptr;
    uint32_t* dividend_device = nullptr;
    uint32_t* output_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMalloc((void**)&dividend_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(dividend_device, total_byte_size, dividend_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t dynUBufSize = 2048;

    auto start = std::chrono::high_resolution_clock::now();

    integer_normal_div_kernel<<<num_blocks, dynUBufSize, stream>>>(
        dividend_device, output_device, divisor, total_length, threads_per_block, num_blocks);

    aclrtSynchronizeStream(stream);

    auto end = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);
    std::cout << "[PERF] Kernel execution time: " << duration.count() << " us" << std::endl;

    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> output((uint32_t*)output_host, (uint32_t*)(output_host + total_byte_size));

    aclrtFree(dividend_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

uint32_t verify_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    auto print_tensor = [](std::vector<uint32_t>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<uint32_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };

    print_tensor(output, "Output");
    print_tensor(golden, "Golden");

    uint32_t error_count = 0;
    for (size_t i = 0; i < output.size(); i++) {
        if (output[i] != golden[i]) {
            if (error_count < 10) {
                std::cout << "[Error] Index " << i << ": output=" << output[i]
                         << ", golden=" << golden[i] << std::endl;
            }
            error_count++;
        }
    }

    if (error_count == 0) {
        std::cout << "[Success] All " << output.size() << " elements are correct." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << error_count << " / " << output.size()
                 << " elements are incorrect." << std::endl;
        return 1;
    }
}

uint32_t random_uint32(uint32_t min, uint32_t max)
{
    static std::mt19937 engine(12345);
    std::uniform_int_distribution<uint32_t> dist(min, max);
    return dist(engine);
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc < 3) {
        std::cout << "Usage: " << argv[0] << " <num_blocks> <threads_per_block> [total_elements]" << std::endl;
        std::cout << "Example: " << argv[0] << " 1 16 131072" << std::endl;
        return 1;
    }

    uint32_t num_blocks = std::atoi(argv[1]);
    uint32_t threads_per_block = std::atoi(argv[2]);
    uint32_t total_elements = (argc > 3) ? std::atoi(argv[3]) : 131072;

    if (num_blocks == 0 || threads_per_block == 0 || threads_per_block > MAX_THREAD_COUNT) {
        std::cerr << "Error: Invalid parameters" << std::endl;
        return 1;
    }

    std::vector<uint32_t> dividend(total_elements);
    for (uint32_t i = 0; i < total_elements; i++) {
        dividend[i] = random_uint32(1, 1000000);
    }

    uint32_t divisor = 7;
    std::cout << "Divisor: " << divisor << std::endl;

    std::vector<uint32_t> golden(total_elements);
    for (uint32_t i = 0; i < total_elements; i++) {
        golden[i] = dividend[i] / divisor;
    }

    std::vector<uint32_t> output = integer_normal_div(dividend, divisor, num_blocks, threads_per_block);

    return verify_result(output, golden);
}
