#include <chrono>
#include <iostream>
#include <iterator>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "tiling/platform/platform_ascendc.h"
#include "utils/debug/asc_time.h"

namespace {
    constexpr uint32_t MAX_THREAD_COUNT = 2048;
    constexpr uint32_t BIT_64_LEN = 64;
    constexpr uint8_t BIT_32_LEN = 32;
}

__aicore__ inline int64_t CountLeadingZero(uint64_t x) {
    return clz(x);
}

__aicore__ inline int64_t GetBitCount1(uint64_t x) {
    return bcnt1(x);
}

__aicore__ inline void simd_calc_magic_shift(
    __ubuf__ uint32_t* magic_out,
    __ubuf__ uint32_t* shift_out,
    uint32_t divisor)
{
    if (divisor == 0) {
        *magic_out = 0;
        *shift_out = 0;
        return;
    }

    int64_t pos = BIT_64_LEN - CountLeadingZero(divisor);
    int64_t cnt1 = GetBitCount1(divisor);
    uint32_t shift = (cnt1 == 1) ? (pos - 1) : pos;
    uint32_t magic = (1l << BIT_32_LEN) * ((1l << shift) - divisor) / divisor + 1;

    *magic_out = magic;
    *shift_out = shift;
}

__simt_vf__ __launch_bounds__(2048) inline void simt_fast_div(
    __gm__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* clock_cycles,
    uint32_t magic,
    uint32_t shift,
    uint32_t total_length,
    uint32_t elements_per_thread)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    uint32_t start_idx = idx * elements_per_thread;

    if (start_idx >= total_length) {
        return;
    }

    uint32_t end_idx = start_idx + elements_per_thread;
    if (end_idx > total_length) end_idx = total_length;

    uint64_t start_clock = __asc_simt_vf::clock();

    for (uint32_t i = start_idx; i < end_idx; i++) {
        uint32_t value = input[i];
        uint32_t q = __umulhi(value, magic);
        output[i] = (value + q) >> shift;
    }

    uint64_t end_clock = __asc_simt_vf::clock();

    clock_cycles[idx] = end_clock - start_clock;
}

__global__ __vector__ void fastdiv_kernel(
    __gm__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* clock_cycles,
    uint32_t divisor,
    uint32_t total_length,
    uint32_t threads_per_block,
    uint32_t num_blocks,
    uint32_t elements_per_thread)
{
    __ubuf__ uint32_t magic_buf[1];
    __ubuf__ uint32_t shift_buf[1];
    simd_calc_magic_shift(magic_buf, shift_buf, divisor);
    uint32_t magic = magic_buf[0];
    uint32_t shift = shift_buf[0];

    asc_vf_call<simt_fast_div>(dim3(threads_per_block), input, output, clock_cycles,
                               magic, shift, total_length, elements_per_thread);
}

std::vector<uint32_t> fastdiv_compute(
    std::vector<uint32_t>& input,
    uint32_t divisor,
    uint32_t num_blocks,
    uint32_t threads_per_block)
{
    uint32_t total_length = input.size();
    uint32_t total_threads = num_blocks * threads_per_block;
    uint32_t elements_per_thread = (total_length + total_threads - 1) / total_threads;

    std::cout << "[FastDiv] 配置信息:" << std::endl;
    std::cout << "  - 除数(divisor): " << divisor << std::endl;
    std::cout << "  - 核数(blocks): " << num_blocks << std::endl;
    std::cout << "  - 每核线程数(threads): " << threads_per_block << std::endl;
    std::cout << "  - 总数据量(total): " << total_length << std::endl;
    std::cout << "  - 总线程数: " << total_threads << std::endl;
    std::cout << "  - 每线程处理元素数: " << elements_per_thread << std::endl;

    size_t total_byte_size = total_length * sizeof(uint32_t);
    size_t clock_byte_size = total_threads * sizeof(uint64_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* output_host = nullptr;
    uint8_t* clock_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    uint64_t* clock_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMallocHost((void**)(&clock_host), clock_byte_size);
    aclrtMalloc((void**)&input_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&clock_device, clock_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, total_byte_size, input_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t dynUBufSize = 2048;

    auto start = std::chrono::high_resolution_clock::now();

    fastdiv_kernel<<<num_blocks, dynUBufSize, stream>>>(
        input_device, output_device, clock_device, divisor, total_length, threads_per_block, num_blocks, elements_per_thread);

    aclrtSynchronizeStream(stream);

    auto end = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);
    std::cout << "[PERF] Kernel 执行时间: " << duration.count() << " us" << std::endl;

    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(clock_host, clock_byte_size, clock_device, clock_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    // 统计每个核的时钟周期
    std::cout << "\n[Clock Cycles] 每个核的执行周期统计:" << std::endl;
    uint64_t* clock_data = reinterpret_cast<uint64_t*>(clock_host);
    for (uint32_t block = 0; block < num_blocks; block++) {
        uint64_t min_cycles = UINT64_MAX;
        uint64_t max_cycles = 0;
        uint64_t sum_cycles = 0;

        uint32_t start_thread = block * threads_per_block;
        uint32_t end_thread = start_thread + threads_per_block;

        for (uint32_t t = start_thread; t < end_thread; t++) {
            uint64_t cycles = clock_data[t];
            if (cycles < min_cycles) min_cycles = cycles;
            if (cycles > max_cycles) max_cycles = cycles;
            sum_cycles += cycles;
        }

        uint64_t avg_cycles = sum_cycles / threads_per_block;
        std::cout << "  核" << block << ": 最小=" << min_cycles
                  << " cycles, 最大=" << max_cycles
                  << " cycles, 平均=" << avg_cycles << " cycles" << std::endl;
    }

    std::vector<uint32_t> output((uint32_t*)output_host, (uint32_t*)(output_host + total_byte_size));

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFree(clock_device);
    aclrtFreeHost(output_host);
    aclrtFreeHost(clock_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

uint32_t verify_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    auto print_tensor = [](std::vector<uint32_t>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<uint32_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };

    print_tensor(output, "Output");
    print_tensor(golden, "Golden");

    uint32_t error_count = 0;
    for (size_t i = 0; i < output.size(); i++) {
        if (output[i] != golden[i]) {
            if (error_count < 10) {
                std::cout << "[Error] Index " << i << ": output=" << output[i]
                         << ", golden=" << golden[i] << std::endl;
            }
            error_count++;
        }
    }

    if (error_count == 0) {
        std::cout << "[Success] All " << output.size() << " elements are correct." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << error_count << " / " << output.size()
                 << " elements are incorrect." << std::endl;
        return 1;
    }
}

uint32_t random_uint32(uint32_t min, uint32_t max)
{
    static std::mt19937 engine(12345);
    std::uniform_int_distribution<uint32_t> dist(min, max);
    return dist(engine);
}

void print_usage(const char* prog_name)
{
    std::cout << "用法: " << prog_name << " [选项]" << std::endl;
    std::cout << std::endl;
    std::cout << "选项:" << std::endl;
    std::cout << "  -b, --blocks <num>     核数 (默认: 8)" << std::endl;
    std::cout << "  -t, --threads <num>    每个核的线程数 (默认: 128)" << std::endl;
    std::cout << "  -n, --total <num>      总数据量 (默认: 8192)" << std::endl;
    std::cout << "  -d, --divisor <num>    除数 (默认: 7)" << std::endl;
    std::cout << "  -h, --help             显示此帮助信息" << std::endl;
    std::cout << std::endl;
    std::cout << "示例:" << std::endl;
    std::cout << "  " << prog_name << " -b 4 -t 128 -n 4096 -d 13" << std::endl;
    std::cout << "  " << prog_name << " --blocks 16 --threads 256 --total 16384 --divisor 127" << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    // 默认参数
    uint32_t num_blocks = 8;
    uint32_t threads_per_block = 128;
    uint32_t total_length = 8192;
    uint32_t divisor = 7;

    // 解析命令行参数
    for (int i = 1; i < argc; i++) {
        std::string arg = argv[i];
        if (arg == "-h" || arg == "--help") {
            print_usage(argv[0]);
            return 0;
        } else if ((arg == "-b" || arg == "--blocks") && i + 1 < argc) {
            num_blocks = std::atoi(argv[++i]);
        } else if ((arg == "-t" || arg == "--threads") && i + 1 < argc) {
            threads_per_block = std::atoi(argv[++i]);
        } else if ((arg == "-n" || arg == "--total") && i + 1 < argc) {
            total_length = std::atoi(argv[++i]);
        } else if ((arg == "-d" || arg == "--divisor") && i + 1 < argc) {
            divisor = std::atoi(argv[++i]);
        } else {
            std::cerr << "[Error] 未知参数: " << arg << std::endl;
            print_usage(argv[0]);
            return 1;
        }
    }

    // 参数验证
    if (threads_per_block == 0 || threads_per_block > MAX_THREAD_COUNT) {
        std::cerr << "[Error] 线程数必须在 1 到 " << MAX_THREAD_COUNT << " 之间" << std::endl;
        return 1;
    }
    if (num_blocks == 0 || total_length == 0 || divisor == 0) {
        std::cerr << "[Error] 核数、总数据量和除数必须大于0" << std::endl;
        return 1;
    }

    std::cout << "========================================" << std::endl;
    std::cout << "  快速除法演示算子 - SIMT编程" << std::endl;
    std::cout << "========================================" << std::endl;
    std::cout << std::endl;

    std::cout << "[Info] 生成测试数据..." << std::endl;
    std::vector<uint32_t> input(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input[i] = random_uint32(1, 1000000);
    }

    std::cout << "[Info] 计算Golden结果..." << std::endl;
    std::vector<uint32_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        golden[i] = input[i] / divisor;
    }

    std::cout << "[Info] 执行快速除法算子..." << std::endl;
    std::cout << std::endl;

    std::vector<uint32_t> output = fastdiv_compute(input, divisor, num_blocks, threads_per_block);

    std::cout << std::endl;
    std::cout << "[Info] 验证结果..." << std::endl;
    return verify_result(output, golden);
}
