/* !
 * \file c_api_asc_set_fp32_mode.asc
 * \brief 测试 asc_set_fp32_mode: 设置 MMAD 的 FP32 模式(不做舍入) (dav-2201)
 *
 * 验证方式: asc_set_fp32_mode (API Under Test) 设置FP32模式后执行 float MMAD
 *           → L0C→GM → 与 CPU 矩阵乘结果比较
 * 覆盖场景: 单核, 单分形 (16×16 float×float→float)
 */

#include <cstdint>
struct int4b_t { uint8_t v; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE, TOTAL_B = K_SIZE * N_SIZE;
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;

/* --------------------------------------------------------------------------
 * Kernel: asc_set_fp32_mode + asc_mmad_sync (float × float → float)
 * 先设置 FP32 模式, 再执行 float MMAD
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_set_fp32_mode(
    __gm__ float* gm_a, __gm__ float* gm_b, __gm__ float* gm_c)
{
    asc_init();
    __cbuf__ float l1_a[TOTAL_A], l1_b[TOTAL_B];
    __ca__ float l0a[TOTAL_A];
    __cb__ float l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    // 1. GM→L1 (2201: void* 重载, 3参数)
    asc_copy_gm2l1_nd2nz_sync((__cbuf__ half*)l1_a, (__gm__ half*)gm_a, 1/*nd_num*/, 16/*n=N*/, 16/*d=M*/,
        16/*src_nd_stride*/, 16/*src_d_value*/,
        1/*dst_nz_c0*/, 1/*dst_nz_n*/, 16/*dst_nz_matrix*/);
    asc_copy_gm2l1_nd2nz_sync((__cbuf__ half*)l1_b, (__gm__ half*)gm_b, 1, 16, 16, 16, 16, 1, 1, 16);

    // 2. L1→L0A/L0B (2201: 6参数分形搬运)
    asc_copy_l12l0a_sync(l0a, l1_a, 0/*start_index*/, 1/*repeat*/, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0/*start_index*/, 1/*repeat*/, 0, 0);

    // 3. API UNDER TEST: asc_set_fp32_mode
    //    void asc_set_fp32_mode() -- PIPE_S, 设置MMAD的FP32模式(不做舍入)
    asc_set_fp32_mode();

    // 4. MMAD (2201: float × float → float, k_direction_align 参数)
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, true, false, true);

    // 5. L0C→GM (2201: 9参数版本)
    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        1, 1, 0, 0, 0, 0, 0, false, true);
}

std::vector<float> run_kernel(std::vector<float> &a, std::vector<float> &b)
{
    size_t ba = a.size()*4, bb = b.size()*4, bc = TOTAL_C*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    float *aD = nullptr, *bD = nullptr, *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_set_fp32_mode<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

void save_csv(const std::string& apiname,
              const std::vector<float>& a, const std::vector<float>& b,
              const std::vector<float>& output, const std::vector<float>& expected,
              bool passed, float max_error)
{
    std::string fname = apiname + "_result.csv";
    std::ofstream f(fname);
    f << "# API: " << apiname << "\n";
    f << "# A matrix (MxK): " << M_SIZE << "x" << K_SIZE << "\n";
    f << "row,col,value\n";
    for (uint32_t r = 0; r < M_SIZE; ++r)
        for (uint32_t c = 0; c < K_SIZE; ++c)
            f << r << "," << c << "," << a[r*K_SIZE + c] << "\n";
    f << "# B matrix (KxN): " << K_SIZE << "x" << N_SIZE << "\n";
    f << "row,col,value\n";
    for (uint32_t r = 0; r < K_SIZE; ++r)
        for (uint32_t c = 0; c < N_SIZE; ++c)
            f << r << "," << c << "," << b[r*N_SIZE + c] << "\n";
    f << "# C matrix (MxN): output vs expected\n";
    f << "row,col,output,expected\n";
    for (uint32_t r = 0; r < M_SIZE; ++r)
        for (uint32_t c = 0; c < N_SIZE; ++c)
            f << r << "," << c << ","
              << output[r*N_SIZE + c] << ","
              << expected[r*N_SIZE + c] << "\n";
    f << "# Result: " << (passed?"PASS":"FAIL") << " (max_error=" << max_error << ")\n";
    f.close();
    std::cout << "  [CSV] " << fname << "\n";
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<float> a(TOTAL_A), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = (i + k) * 0.12f;
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = (k + j) * 0.08f;

    std::cout << "A[0:2]=";
    for (int i=0;i<3;++i) std::cout << a[i] << " ";
    std::cout << "\nB[0:2]=";
    for (int i=0;i<3;++i) std::cout << b[i] << " ";
    std::cout << std::endl;

    std::vector<float> output = run_kernel(a, b);

    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += a[i*K_SIZE+k] * b[k*N_SIZE+j];
            golden[i*N_SIZE+j] = sum;
        }

    std::cout << "output[0:2]=";
    for (int i=0;i<3;++i) std::cout << output[i] << " ";
    std::cout << "\ngolden[0:2]=";
    for (int i=0;i<3;++i) std::cout << golden[i] << " ";
    std::cout << std::endl;

    float mx = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i] - golden[i]);
        if (e > mx) mx = e;
    }
    bool ok = mx < 0.001f;
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_set_fp32_mode max_error=" << mx << std::endl;
    save_csv("asc_set_fp32_mode", a, b, output, golden, ok, mx);
    return ok?0:1;
}
