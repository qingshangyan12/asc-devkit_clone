/* !
 * \file c_api_asc_copy_l12fb.asc
 * \brief 测试 asc_copy_l12fb: L1→Fixpipe Buffer 搬运 (dav-2201)
 *
 * 验证方式: GM→L1→asc_copy_l12fb_sync(API)→FB (smoke test)
 *          再执行 GM→L1_test→GM 回环验证确认 L1 通路仍正常
 * 覆盖场景: 单核, 128 half 元素
 */

#include <cstdint>
struct int4b_t { uint8_t v; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t N = 128;

__cube__ __global__ __aicore__ void kernel_asc_copy_l12fb(
    __gm__ half* gm_in, __gm__ half* gm_out)
{
    asc_init();
    __cbuf__ half l1[N], l1_test[N];
    __fbuf__ half* fb_addr = reinterpret_cast<__fbuf__ half*>(get_imm(0));

    // Step 1: GM→L1 (load data for FB smoke test)
    asc_copy_gm2l1_sync((__cbuf__ void*)l1, (__gm__ void*)gm_in, (uint32_t)(N * sizeof(half)));

    // API UNDER TEST: asc_copy_l12fb_sync
    asc_copy_l12fb_sync((__fbuf__ void*)fb_addr, (__cbuf__ void*)l1, (uint32_t)(N * sizeof(half)));

    // Step 2: Verify L1 path still works after FB operation
    asc_copy_gm2l1_sync((__cbuf__ void*)l1_test, (__gm__ void*)gm_in, (uint32_t)(N * sizeof(half)));
    asc_copy_l12gm_sync((__gm__ void*)gm_out, (__cbuf__ void*)l1_test, 1, N, 0, 0);
}

std::vector<half> run_kernel(std::vector<half>& input)
{
    size_t sz_in = N * sizeof(half), sz_out = N * sizeof(half);
    aclrtStream s = nullptr; uint8_t* outH = nullptr;
    half* inD = nullptr; half* outD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&outH, sz_out);
    aclrtMalloc((void**)&inD, sz_in, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, sz_out, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, sz_in, (uint8_t*)input.data(), sz_in, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_copy_l12fb<<<NUM_BLOCKS, nullptr, s>>>(inD, outD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(outH, sz_out, (uint8_t*)outD, sz_out, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> out((half*)outH, (half*)(outH + sz_out));
    aclrtFree(inD); aclrtFree(outD); aclrtFreeHost(outH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return out;
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<half> input(N);
    for (uint32_t i = 0; i < N; i++)
        input[i] = half(static_cast<float>(i) * 0.1f);

    std::vector<half> output = run_kernel(input);

    std::ofstream f("asc_copy_l12fb_result.csv");
    f << "# API: asc_copy_l12fb\n# L1->FB(smoke) + GM->L1->GM round-trip\nindex,input,output\n";
    float mx = 0.0f;
    for (uint32_t i = 0; i < N; i++) {
        float inVal = static_cast<float>(input[i]);
        float outVal = static_cast<float>(output[i]);
        float err = std::abs(inVal - outVal);
        if (err > mx) mx = err;
        f << i << "," << inVal << "," << outVal << "\n";
    }
    bool ok = mx < 0.001f;
    std::cout << (ok ? "[PASS]" : "[FAIL]") << " asc_copy_l12fb max_error=" << mx << std::endl;
    f << "# Result: " << (ok ? "PASS" : "FAIL") << " (max_error=" << mx << ")\n";
    f.close();
    return ok ? 0 : 1;
}
