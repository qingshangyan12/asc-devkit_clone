/* !
 * \file c_api_asc_copy_gm2l1_pad1.asc
 * \brief 测试 asc_copy_gm2l1_pad1: GM→L1 PAD_MODE1 搬运 (dav-2201)
 *
 * 验证方式: GM→asc_copy_gm2l1_pad1_sync(API)→L1→asc_copy_l12gm_sync→GM
 *          纯回环验证 (round-trip)
 * 覆盖场景: 单核, 128 half 元素
 */

#include <cstdint>
struct int4b_t { uint8_t v; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t N = 128;

__cube__ __global__ __aicore__ void kernel_asc_copy_gm2l1_pad1(
    __gm__ half* gm_in, __gm__ half* gm_out)
{
    asc_init();
    __cbuf__ half l1[N];

    // API UNDER TEST: asc_copy_gm2l1_pad1_sync
    asc_copy_gm2l1_pad1_sync((__cbuf__ void*)l1, (__gm__ void*)gm_in, (uint32_t)(N * sizeof(half)));

    // Round-trip back: L1→GM
    asc_copy_l12gm_sync((__gm__ void*)gm_out, (__cbuf__ void*)l1, 1, N, 0, 0);
}

std::vector<half> run_kernel(std::vector<half>& input)
{
    size_t sz = N * sizeof(half);
    aclrtStream s = nullptr; uint8_t* outH = nullptr;
    half* inD = nullptr; half* outD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&outH, sz);
    aclrtMalloc((void**)&inD, sz, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, sz, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, sz, (uint8_t*)input.data(), sz, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_copy_gm2l1_pad1<<<NUM_BLOCKS, nullptr, s>>>(inD, outD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(outH, sz, (uint8_t*)outD, sz, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> out((half*)outH, (half*)(outH + sz));
    aclrtFree(inD); aclrtFree(outD); aclrtFreeHost(outH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return out;
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<half> input(N);
    for (uint32_t i = 0; i < N; i++)
        input[i] = half(static_cast<float>(i) * 0.1f);

    std::vector<half> output = run_kernel(input);

    std::ofstream f("asc_copy_gm2l1_pad1_result.csv");
    f << "# API: asc_copy_gm2l1_pad1\n# GM->L1(PAD1)->GM round-trip\nindex,input,output\n";
    float mx = 0.0f;
    for (uint32_t i = 0; i < N; i++) {
        float inVal = static_cast<float>(input[i]);
        float outVal = static_cast<float>(output[i]);
        float err = std::abs(inVal - outVal);
        if (err > mx) mx = err;
        f << i << "," << inVal << "," << outVal << "\n";
    }
    bool ok = mx < 0.001f;
    std::cout << (ok ? "[PASS]" : "[FAIL]") << " asc_copy_gm2l1_pad1 max_error=" << mx << std::endl;
    f << "# Result: " << (ok ? "PASS" : "FAIL") << " (max_error=" << mx << ")\n";
    f.close();
    return ok ? 0 : 1;
}
