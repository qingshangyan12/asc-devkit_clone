/* !
 * \file c_api_asc_copy_l0c2l1.asc
 * \brief 测试 asc_copy_l0c2l1: L0C→L1 搬运 (dav-2201, 11-param)
 *
 * 验证方式: GM→L1(nd2nz)→L0A/L0B→MMAD(float L0C)→asc_copy_l0c2l1_sync(API)→L1→GM
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
struct int4b_t { uint8_t v; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M=16,K=16,N=16; constexpr uint32_t TA=M*K,TB=K*N,TC=M*N;

__cube__ __global__ __aicore__ void kernel_asc_copy_l0c2l1(
    __gm__ half* a, __gm__ half* b, __gm__ float* c)
{
    asc_init();
    __cbuf__ half la[TA],lb[TB]; __cbuf__ float l1_out[TC];
    __ca__ half l0a[TA]; __cb__ half l0b[TB]; __cc__ float l0c[TC];

    // 1. GM→L1 nd2nz (correct fractal format for L0A/L0B)
    asc_copy_gm2l1_nd2nz_sync(la, a, 1, 16, 16, 16, 16, 1, 1, 16);
    asc_copy_gm2l1_nd2nz_sync(lb, b, 1, 16, 16, 16, 16, 1, 1, 16);

    // 2. L1→L0A/L0B (raw block copy, data already fractal)
    asc_copy_l12l0a_sync(l0a, la, 0, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, lb, 0, 1, 0, 0);

    // 3. MMAD → L0C (float)
    asc_mmad_sync(l0c, l0a, l0b, M, K, N, 0, true, false, true);

    // 4. API UNDER TEST: asc_copy_l0c2l1_sync (L0C→L1, float→float)
    asc_copy_l0c2l1_sync(l1_out, l0c, 1, 1, 0, 0, 0, 0, 0, false, false);

    // 5. L1→GM (round-trip verify L1 data)
    asc_copy_l12gm_sync((__gm__ void*)c, (__cbuf__ void*)l1_out, 1, TC, 0, 0);
}

std::vector<float> run_kernel(std::vector<half>& a, std::vector<half>& b)
{
    size_t ba=a.size()*2, bb=b.size()*2, bc=TC*4;
    aclrtStream s=nullptr; uint8_t* ch=nullptr; half* ad=nullptr,*bd=nullptr; float* cd=nullptr;
    aclInit(nullptr);aclrtSetDevice(0);aclrtCreateStream(&s);aclrtMallocHost((void**)&ch,bc);
    aclrtMalloc((void**)&ad,ba,ACL_MEM_MALLOC_HUGE_FIRST);aclrtMalloc((void**)&bd,bb,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cd,bc,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)ad,ba,(uint8_t*)a.data(),ba,ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bd,bb,(uint8_t*)b.data(),bb,ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_copy_l0c2l1<<<NUM_BLOCKS,nullptr,s>>>(ad,bd,cd); aclrtSynchronizeStream(s);
    aclrtMemcpy(ch,bc,(uint8_t*)cd,bc,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)ch,(float*)(ch+bc));
    aclrtFree(ad);aclrtFree(bd);aclrtFree(cd);aclrtFreeHost(ch);aclrtDestroyStream(s);aclrtResetDevice(0);aclFinalize();
    return out;
}

int32_t main(int32_t argc,char* argv[])
{
    std::vector<half> a(TA),b(TB);
    for(uint32_t i=0;i<M;++i)for(uint32_t k=0;k<K;++k)a[i*K+k]=half((i+k)*0.1f);
    for(uint32_t k=0;k<K;++k)for(uint32_t j=0;j<N;++j)b[k*N+j]=half(1.0f);

    std::vector<float> out=run_kernel(a,b);
    // Golden: MMAD result (float) then L0C→L1 (should preserve values)
    std::vector<float> golden(TC,0.0f);
    for(uint32_t i=0;i<M;++i)for(uint32_t j=0;j<N;++j){
        float s=0;for(uint32_t k=0;k<K;++k)s+=float(a[i*K+k])*float(b[k*N+j]);golden[i*N+j]=s;}

    std::ofstream f("asc_copy_l0c2l1_result.csv");
    f<<"# API: asc_copy_l0c2l1\n# MMAD→L0C→L1→GM round-trip\nrow,col,output,expected\n";
    for(uint32_t r=0;r<M;++r)for(uint32_t c=0;c<N;++c)f<<r<<","<<c<<","<<out[r*N+c]<<","<<golden[r*N+c]<<"\n";

    float mx=0;for(size_t i=0;i<golden.size();++i){float e=std::abs(out[i]-golden[i]);if(e>mx)mx=e;}
    bool ok=mx<0.1f;
    std::cout<<(ok?"[PASS]":"[FAIL]")<<" asc_copy_l0c2l1 max_error="<<mx<<std::endl;
    f<<"# Result: "<<(ok?"PASS":"FAIL")<<" (max_error="<<mx<<")\n";f.close();
    return ok?0:1;
}
