set(ASC_VALID_SOC_LIST ascend310b ascend310p ascend610 ascend910 ascend910b ascend910_93 ascend950 bs9sx1a bs9sx2a ascend610lite mc61am21a mc62 ascend910_96 kirinx90 kirin9030 mc32dm11a ascend350)

function(_asc_normalize_soc_series output_var)
    set(_normalized_soc_series)
    foreach(_soc_series IN LISTS ARGN)
        string(TOLOWER "${_soc_series}" _soc_series_lower)
        list(FIND ASC_VALID_SOC_LIST "${_soc_series_lower}" _soc_series_index)
        if(_soc_series_index EQUAL -1)
            message(FATAL_ERROR
                "SOC_SERIES ${_soc_series} does not support, the support list is ${ASC_VALID_SOC_LIST}")
        endif()
        list(APPEND _normalized_soc_series "${_soc_series_lower}")
    endforeach()
    set(${output_var} "${_normalized_soc_series}" PARENT_SCOPE)
endfunction()

# Project mode does not expose the raw -D arguments, so compare against the
# cache written by the previous configure to identify selectors supplied now.
function(_asc_get_previous_cache_entry variable output_value output_type output_found)
    set(_cache_file "${CMAKE_CACHEFILE_DIR}/CMakeCache.txt")
    if(EXISTS "${_cache_file}")
        file(STRINGS "${_cache_file}" _cache_entries REGEX "^${variable}:[^=]*=")
        foreach(_cache_entry IN LISTS _cache_entries)
            string(REGEX REPLACE "^${variable}:([^=]*)=.*$" "\\1" _previous_type "${_cache_entry}")
            string(REGEX REPLACE "^[^=]*=" "" _previous_value "${_cache_entry}")
            set(${output_value} "${_previous_value}" PARENT_SCOPE)
            set(${output_type} "${_previous_type}" PARENT_SCOPE)
            set(${output_found} TRUE PARENT_SCOPE)
            return()
        endforeach()
    endif()
    set(${output_value} "" PARENT_SCOPE)
    set(${output_type} "" PARENT_SCOPE)
    set(${output_found} FALSE PARENT_SCOPE)
endfunction()

function(_asc_selector_provided_this_config variable output_var)
    if(NOT DEFINED ${variable})
        set(${output_var} FALSE PARENT_SCOPE)
        return()
    endif()
    get_property(_current_type CACHE ${variable} PROPERTY TYPE)
    _asc_get_previous_cache_entry(${variable} _previous_value _previous_type _has_previous)
    if(NOT _has_previous OR NOT "${_previous_value}" STREQUAL "${${variable}}"
       OR (_current_type STREQUAL "UNINITIALIZED" AND _previous_type STREQUAL "STRING"))
        set(${output_var} TRUE PARENT_SCOPE)
    else()
        set(${output_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

_asc_selector_provided_this_config(ASCEND_SOC_SERIES _asc_soc_series_provided)
_asc_selector_provided_this_config(ASCEND_COMPUTE_UNIT _asc_compute_unit_provided)

# Check conflicts only for selectors supplied or changed by this configure call.
if(_asc_soc_series_provided AND _asc_compute_unit_provided)
    message(FATAL_ERROR "ASCEND_SOC_SERIES and ASCEND_COMPUTE_UNIT cannot be set together")
elseif(_asc_soc_series_provided)
    if("${ASCEND_SOC_SERIES}" STREQUAL "")
        message(FATAL_ERROR "ASCEND_SOC_SERIES cannot be empty")
    endif()
    _asc_normalize_soc_series(_ascend_soc_series_normalized ${ASCEND_SOC_SERIES})
    set(ASCEND_SOC_SERIES "${_ascend_soc_series_normalized}" CACHE STRING "" FORCE)
    unset(ASCEND_COMPUTE_UNIT CACHE)
    set(ASCEND_COMPUTE_UNIT "${_ascend_soc_series_normalized}" CACHE STRING "" FORCE)
elseif(_asc_compute_unit_provided)
    unset(ASCEND_SOC_SERIES CACHE)
    unset(ASCEND_SOC_SERIES)
    set(ASCEND_COMPUTE_UNIT "${ASCEND_COMPUTE_UNIT}" CACHE STRING "" FORCE)
elseif(DEFINED ASCEND_SOC_SERIES)
    if("${ASCEND_SOC_SERIES}" STREQUAL "")
        message(FATAL_ERROR "ASCEND_SOC_SERIES cannot be empty")
    endif()
    _asc_normalize_soc_series(_ascend_soc_series_normalized ${ASCEND_SOC_SERIES})
    set(ASCEND_SOC_SERIES "${_ascend_soc_series_normalized}" CACHE STRING "" FORCE)
    unset(ASCEND_COMPUTE_UNIT CACHE)
    set(ASCEND_COMPUTE_UNIT "${_ascend_soc_series_normalized}" CACHE STRING "" FORCE)
elseif(NOT DEFINED ASCEND_COMPUTE_UNIT)
    set(ASCEND_COMPUTE_UNIT ascend910b CACHE STRING "")
endif()

foreach(soc_version ${ASCEND_COMPUTE_UNIT})
    list(FIND ASC_VALID_SOC_LIST "${soc_version}" _SOC_INDEX)
    if(_SOC_INDEX EQUAL -1)
        message(FATAL_ERROR "COMPUTE_UNIT ${soc_version} does not support, the support list is ${ASC_VALID_SOC_LIST}")
    endif()
endforeach()

