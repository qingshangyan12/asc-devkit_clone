constexpr uint32_t REG_COUNT = 64;

__global__ __maxnreg__(REG_COUNT) void sin_custom(float* x, float* y, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;

    if (idx >= total_length) {
        return;
    }
    y[idx] = sinf(x[idx]) + cosf(x[idx]);
}

std::vector<float> compute_sin(std::vector<float>& x)
{
    size_t total_byte_size = x.size() * sizeof(float);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)(&y_host), total_byte_size);
    aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    aclrtMemcpy(x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    
    uint32_t total_length = x.size();
    std::cout << total_length << std::endl;
    uint32_t thread_num_per_block = 1024;
    uint32_t block_num = 2;
    uint32_t dyn_ubuf_size = 0;
    
    sin_custom<<<block_num, thread_num_per_block, dyn_ubuf_size, stream>>>(
        x_device, y_device, total_length
    );
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(y_host, total_byte_size, y_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output((float*)y_host, (float*)(y_host + total_byte_size));
    
    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    
    bool passed = true;
    for (size_t i = 0; i < output.size(); i++) {
        float diff = std::abs(output[i] - golden[i]);
        if (diff > 1e-5f) {
            passed = false;
            break;
        }
    }
    
    if (passed) {
        std::cout << "[Success] Sin computation verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Sin computation verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t in_shape = 256;
    std::vector<float> x(in_shape);
    
    for (uint32_t i = 0; i < in_shape; i++) {
        x[i] = static_cast<float>(i) * 0.1f - 12.8f;
    }

    std::vector<float> golden(in_shape);
    for (uint32_t i = 0; i < in_shape; i++) {
        golden[i] = sinf(x[i]);
    }

    std::vector<float> output = compute_sin(x);

    return verify_result(output, golden);
}  
       