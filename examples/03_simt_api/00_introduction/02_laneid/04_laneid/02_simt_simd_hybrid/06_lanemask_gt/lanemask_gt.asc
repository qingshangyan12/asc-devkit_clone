/* !
 * \file lanemask_gt_test.asc
 * \brief 验证lanemask_gt()功能的完整示例
 */
#include <iostream>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t THREAD_COUNT = 32;
constexpr uint32_t WARP_SIZE = 32;
} // namespace

__simt_vf__ inline void simt_lanemask_gt_test(
    __gm__ uint32_t* lanemaskOutput, uint32_t totalThreads)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= totalThreads) {
        return;
    }

    uint32_t mask = lanemask_gt();
    lanemaskOutput[idx] = mask;
}

__global__ __vector__ void lanemask_gt_test_kernel(
    __gm__ uint32_t* lanemaskOutput, uint32_t totalThreads)
{
    asc_vf_call<simt_lanemask_gt_test>(
        dim3(THREAD_COUNT), lanemaskOutput, totalThreads);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalThreads = 32;
    constexpr uint32_t numBlocks = 1;

    size_t outputByteSize = totalThreads * sizeof(uint32_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtMallocHost((void**)(&outputHost), outputByteSize);
    aclrtMalloc((void**)&outputDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    lanemask_gt_test_kernel<<<numBlocks, 2048, stream>>>(
        outputDevice, totalThreads);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t* outputData = (uint32_t*)outputHost;
    uint32_t golden[totalThreads];
    for (uint32_t i = 0; i < totalThreads; i++) {
        golden[i] = ~((1U << ((i % WARP_SIZE) + 1)) - 1);
    }
    
    printf("output:");
    for (uint32_t i = 0; i < totalThreads; i++) {
        if (i > 0) printf(",");
        printf("0x%08X", outputData[i]);
    }
    printf("\n");
    
    printf("golden:");
    for (uint32_t i = 0; i < totalThreads; i++) {
        if (i > 0) printf(",");
        printf("0x%08X", golden[i]);
    }
    printf("\n");
    
    bool allCorrect = true;
    for (uint32_t i = 0; i < totalThreads; i++) {
        if (outputData[i] != golden[i]) {
            allCorrect = false;
            break;
        }
    }
    
    if (allCorrect) {
        std::cout << "[Success] Lanemask_gt verification passed." << std::endl;
    } else {
        std::cout << "[Failed] Lanemask_gt verification failed!" << std::endl;
    }

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}