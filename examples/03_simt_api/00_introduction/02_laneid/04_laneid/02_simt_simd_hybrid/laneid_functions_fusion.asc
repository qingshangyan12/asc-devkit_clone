/* !
 * \file laneid_functions_fusion.asc
 * \brief Test laneid and lanemask functions in SIMD-SIMT fusion compute scenario
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t WARP_SIZE = 32;
}

__simt_vf__ inline void simt_laneid_test(
    __gm__ int32_t* laneidOutput)
{
    uint32_t idx = threadIdx.x;

    int32_t lane = laneid();
    laneidOutput[idx] = lane;
}

__simt_vf__ inline void simt_lanemask_eq_test(
    __gm__ uint32_t* lanemaskOutput)
{
    uint32_t idx = threadIdx.x;

    uint32_t mask = lanemask_eq();
    lanemaskOutput[idx] = mask;
}

__simt_vf__ inline void simt_lanemask_le_test(
    __gm__ uint32_t* lanemaskOutput)
{
    uint32_t idx = threadIdx.x;

    uint32_t mask = lanemask_le();
    lanemaskOutput[idx] = mask;
}

__simt_vf__ inline void simt_lanemask_lt_test(
    __gm__ uint32_t* lanemaskOutput)
{
    uint32_t idx = threadIdx.x;

    uint32_t mask = lanemask_lt();
    lanemaskOutput[idx] = mask;
}

__simt_vf__ inline void simt_lanemask_ge_test(
    __gm__ uint32_t* lanemaskOutput)
{
    uint32_t idx = threadIdx.x;

    uint32_t mask = lanemask_ge();
    lanemaskOutput[idx] = mask;
}

__simt_vf__ inline void simt_lanemask_gt_test(
    __gm__ uint32_t* lanemaskOutput)
{
    uint32_t idx = threadIdx.x;

    uint32_t mask = lanemask_gt();
    lanemaskOutput[idx] = mask;
}

__global__ __vector__ void laneid_functions_fusion_laneid_kernel(
    __gm__ int32_t* laneidOutput)
{
    asc_vf_call<simt_laneid_test>(dim3(THREAD_COUNT), laneidOutput);
}

__global__ __vector__ void laneid_functions_fusion_lanemask_eq_kernel(
    __gm__ uint32_t* lanemaskOutput)
{
    asc_vf_call<simt_lanemask_eq_test>(dim3(THREAD_COUNT), lanemaskOutput);
}

__global__ __vector__ void laneid_functions_fusion_lanemask_le_kernel(
    __gm__ uint32_t* lanemaskOutput)
{
    asc_vf_call<simt_lanemask_le_test>(dim3(THREAD_COUNT), lanemaskOutput);
}

__global__ __vector__ void laneid_functions_fusion_lanemask_lt_kernel(
    __gm__ uint32_t* lanemaskOutput)
{
    asc_vf_call<simt_lanemask_lt_test>(dim3(THREAD_COUNT), lanemaskOutput);
}

__global__ __vector__ void laneid_functions_fusion_lanemask_ge_kernel(
    __gm__ uint32_t* lanemaskOutput)
{
    asc_vf_call<simt_lanemask_ge_test>(dim3(THREAD_COUNT), lanemaskOutput);
}

__global__ __vector__ void laneid_functions_fusion_lanemask_gt_kernel(
    __gm__ uint32_t* lanemaskOutput)
{
    asc_vf_call<simt_lanemask_gt_test>(dim3(THREAD_COUNT), lanemaskOutput);
}

std::vector<int32_t> run_laneid_test()
{
    constexpr uint32_t total_length = THREAD_COUNT;
    size_t total_byte_size = total_length * sizeof(int32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    int32_t* output_device = nullptr;
    uint8_t* output_host = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&output_host, total_byte_size);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t dyn_ubuf_size = 0;
    laneid_functions_fusion_laneid_kernel<<<1, dyn_ubuf_size, stream>>>(output_device);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<int32_t> result;
    int32_t* output_data = (int32_t*)output_host;
    result.insert(result.end(), output_data, output_data + total_length);

    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return result;
}

std::vector<uint32_t> run_lanemask_test(int test_type)
{
    constexpr uint32_t total_length = THREAD_COUNT;
    size_t total_byte_size = total_length * sizeof(uint32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint32_t* output_device = nullptr;
    uint8_t* output_host = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&output_host, total_byte_size);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t dyn_ubuf_size = 0;

    if (test_type == 0) {
        laneid_functions_fusion_lanemask_eq_kernel<<<1, dyn_ubuf_size, stream>>>(output_device);
    } else if (test_type == 1) {
        laneid_functions_fusion_lanemask_le_kernel<<<1, dyn_ubuf_size, stream>>>(output_device);
    } else if (test_type == 2) {
        laneid_functions_fusion_lanemask_lt_kernel<<<1, dyn_ubuf_size, stream>>>(output_device);
    } else if (test_type == 3) {
        laneid_functions_fusion_lanemask_ge_kernel<<<1, dyn_ubuf_size, stream>>>(output_device);
    } else {
        laneid_functions_fusion_lanemask_gt_kernel<<<1, dyn_ubuf_size, stream>>>(output_device);
    }

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint32_t> result;
    uint32_t* output_data = (uint32_t*)output_host;
    result.insert(result.end(), output_data, output_data + total_length);

    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return result;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = THREAD_COUNT;
    uint32_t failed = 0;

    std::cout << "Testing laneid function..." << std::endl;
    std::vector<int32_t> laneid_result = run_laneid_test();

    for (uint32_t i = 0; i < total_length; i++) {
        int32_t expected = i % WARP_SIZE;
        if (laneid_result[i] != expected) {
            std::cout << "[Failed] laneid mismatch at " << i << ": got " << laneid_result[i]
                      << ", expected " << expected << std::endl;
            failed++;
        }
    }

    std::cout << "Testing lanemask_eq function..." << std::endl;
    std::vector<uint32_t> lanemask_eq_result = run_lanemask_test(0);

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected = (1U << (i % WARP_SIZE));
        if (lanemask_eq_result[i] != expected) {
            std::cout << "[Failed] lanemask_eq mismatch at " << i << ": got 0x" << std::hex << lanemask_eq_result[i]
                      << ", expected 0x" << expected << std::dec << std::endl;
            failed++;
        }
    }

    std::cout << "Testing lanemask_le function..." << std::endl;
    std::vector<uint32_t> lanemask_le_result = run_lanemask_test(1);

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected = (1U << ((i % WARP_SIZE) + 1)) - 1;
        if (lanemask_le_result[i] != expected) {
            std::cout << "[Failed] lanemask_le mismatch at " << i << ": got 0x" << std::hex << lanemask_le_result[i]
                      << ", expected 0x" << expected << std::dec << std::endl;
            failed++;
        }
    }

    std::cout << "Testing lanemask_lt function..." << std::endl;
    std::vector<uint32_t> lanemask_lt_result = run_lanemask_test(2);

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected = (1U << (i % WARP_SIZE)) - 1;
        if (lanemask_lt_result[i] != expected) {
            std::cout << "[Failed] lanemask_lt mismatch at " << i << ": got 0x" << std::hex << lanemask_lt_result[i]
                      << ", expected 0x" << expected << std::dec << std::endl;
            failed++;
        }
    }

    std::cout << "Testing lanemask_ge function..." << std::endl;
    std::vector<uint32_t> lanemask_ge_result = run_lanemask_test(3);

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected = ~((1U << (i % WARP_SIZE)) - 1);
        if (lanemask_ge_result[i] != expected) {
            std::cout << "[Failed] lanemask_ge mismatch at " << i << ": got 0x" << std::hex << lanemask_ge_result[i]
                      << ", expected 0x" << expected << std::dec << std::endl;
            failed++;
        }
    }

    std::cout << "Testing lanemask_gt function..." << std::endl;
    std::vector<uint32_t> lanemask_gt_result = run_lanemask_test(4);

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected = ~((1U << ((i % WARP_SIZE) + 1)) - 1);
        if (lanemask_gt_result[i] != expected) {
            std::cout << "[Failed] lanemask_gt mismatch at " << i << ": got 0x" << std::hex << lanemask_gt_result[i]
                      << ", expected 0x" << expected << std::dec << std::endl;
            failed++;
        }
    }

    if (failed == 0) {
        std::cout << "[Success] All laneid functions fusion tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Laneid functions fusion tests failed with " << failed << " errors." << std::endl;
        return 1;
    }
}