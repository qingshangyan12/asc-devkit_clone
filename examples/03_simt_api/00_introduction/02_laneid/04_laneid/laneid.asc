/* !
 * \file laneid.asc
 * \brief Verify laneid() API functionality
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

constexpr uint32_t REG_COUNT = 64;
constexpr uint32_t WARP_SIZE = 32;

__global__ __maxnreg__(REG_COUNT) void laneid_test(int32_t* laneid_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    laneid_output[idx] = laneid();
}

std::vector<int32_t> test_laneid(uint64_t total_length)
{
    size_t total_byte_size = total_length * sizeof(int32_t);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    int32_t* output_device = nullptr;
    int8_t* output_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t thread_num_per_block = 64;
    uint32_t block_num = (total_length + thread_num_per_block - 1) / thread_num_per_block;
    uint32_t dyn_ubuf_size = 0;
    
    laneid_test<<<block_num, thread_num_per_block, dyn_ubuf_size, stream>>>(
        output_device, total_length
    );
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> output(reinterpret_cast<int32_t*>(output_host), 
                                 reinterpret_cast<int32_t*>(output_host + total_byte_size));
    
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<int32_t>& output, uint32_t thread_num_per_block)
{
    std::cout << "Lane ID verification:" << std::endl;
    std::cout << "Total threads: " << output.size() << std::endl;
    std::cout << "Threads per block: " << thread_num_per_block << std::endl;
    std::cout << "Warp size: " << WARP_SIZE << std::endl;
    std::cout << std::endl;
    
    std::cout << "All lane IDs output:" << std::endl;
    for (size_t i = 0; i < output.size(); i++) {
        uint32_t block_id = i / thread_num_per_block;
        uint32_t thread_in_block = i % thread_num_per_block;
        uint32_t warp_id = thread_in_block / WARP_SIZE;
        uint32_t lane_id = thread_in_block % WARP_SIZE;
        
        if (thread_in_block == 0) {
            std::cout << "\n========== Block " << block_id << " ==========" << std::endl;
        }
        if (lane_id == 0) {
            std::cout << "  Warp " << warp_id << ": ";
        }
        
        std::cout << "[" << lane_id << "]=" << output[i] << " ";
        
        if (lane_id == WARP_SIZE - 1) {
            std::cout << std::endl;
        }
    }
    std::cout << std::endl;
    
    bool passed = true;
    for (size_t i = 0; i < output.size(); i++) {
        int32_t expected_laneid = i % WARP_SIZE;
        if (output[i] < 0 || output[i] >= static_cast<int32_t>(WARP_SIZE)) {
            std::cout << "[Error] Thread " << i << ": laneid=" << output[i] 
                      << " out of valid range [0, " << (WARP_SIZE - 1) << "]" << std::endl;
            passed = false;
        } else if (output[i] != expected_laneid) {
            std::cout << "[Error] Thread " << i << ": expected laneid=" << expected_laneid 
                      << ", got=" << output[i] << std::endl;
            passed = false;
        }
    }
    
    if (passed) {
        std::cout << "[Success] Laneid verification passed." << std::endl;
        std::cout << "Laneid range: [0, " << (WARP_SIZE - 1) << "]" << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Laneid verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t thread_num_per_block = 64;
    constexpr uint32_t block_num = 2;
    constexpr uint32_t total_length = thread_num_per_block * block_num;
    
    std::cout << "Testing laneid() API" << std::endl;
    std::cout << "Configuration: " << block_num << " blocks x " 
              << thread_num_per_block << " threads/block" << std::endl;
    std::cout << "Expected: Each block has " << (thread_num_per_block / WARP_SIZE) << " warps" << std::endl;
    std::cout << "          Each warp contains " << WARP_SIZE << " threads" << std::endl;
    std::cout << "          laneid range: [0, " << (WARP_SIZE - 1) << "]" << std::endl;
    std::cout << std::endl;
    
    std::vector<int32_t> output = test_laneid(total_length);
    
    return verify_result(output, thread_num_per_block);
}