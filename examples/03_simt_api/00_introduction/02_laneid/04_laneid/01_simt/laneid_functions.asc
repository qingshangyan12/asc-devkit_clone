/* !
 * \file laneid_functions.asc
 * \brief Test Lane ID and Lane Mask Functions: laneid(), lanemask_ge(), lanemask_eq(), lanemask_gt(), lanemask_le(), lanemask_lt()
 */

#include <iostream>
#include <iterator>
#include <vector>
#include <iomanip>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

constexpr uint32_t WARP_SIZE = 32;

__global__ void laneid_test(int32_t* laneid_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    laneid_output[idx] = laneid();
}

__global__ void lanemask_ge_test(uint32_t* lanemask_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    lanemask_output[idx] = lanemask_ge();
}

__global__ void lanemask_eq_test(uint32_t* lanemask_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    lanemask_output[idx] = lanemask_eq();
}

__global__ void lanemask_gt_test(uint32_t* lanemask_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    lanemask_output[idx] = lanemask_gt();
}

__global__ void lanemask_le_test(uint32_t* lanemask_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    lanemask_output[idx] = lanemask_le();
}

__global__ void lanemask_lt_test(uint32_t* lanemask_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    lanemask_output[idx] = lanemask_lt();
}

std::vector<int32_t> run_laneid_test(uint64_t total_length)
{
    size_t total_byte_size = total_length * sizeof(int32_t);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    int32_t* output_device = nullptr;
    int8_t* output_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t thread_num_per_block = 32;
    uint32_t block_num = (total_length + thread_num_per_block - 1) / thread_num_per_block;
    uint32_t dyn_ubuf_size = 0;
    
    laneid_test<<<block_num, thread_num_per_block, dyn_ubuf_size, stream>>>(
        output_device, total_length
    );
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> output(reinterpret_cast<int32_t*>(output_host), 
                                 reinterpret_cast<int32_t*>(output_host + total_byte_size));
    
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

