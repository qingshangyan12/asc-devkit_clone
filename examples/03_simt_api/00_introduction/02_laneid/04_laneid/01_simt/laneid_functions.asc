uint32_t verify_laneid_result(std::vector<int32_t>& output, std::vector<int32_t>& golden)
{
    auto print_tensor = [](std::vector<int32_t>& tensor, const char* name) {
        std::cout << name << ": ";
        for (size_t i = 0; i < tensor.size(); i++) {
            std::cout << tensor[i] << " ";
        }
        std::cout << std::endl;
    };
    
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    
    bool passed = true;
    for (size_t i = 0; i < output.size(); i++) {
        int32_t diff = output[i] - golden[i];
        if (diff != 0) {
            passed = false;
            break;
        }
    }
    
    if (passed) {
        std::cout << "[Success] Laneid verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Laneid verification failed!" << std::endl;
        return 1;
    }
}

uint32_t verify_lanemask_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden, const char* func_name)
{
    auto print_tensor = [](std::vector<uint32_t>& tensor, const char* name) {
        std::cout << name << ": ";
        for (size_t i = 0; i < tensor.size(); i++) {
            std::cout << "0x" << std::hex << std::setw(8) << std::setfill('0') << tensor[i] << " ";
        }
        std::cout << std::dec << std::endl;
    };
    
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    
    bool passed = true;
    for (size_t i = 0; i < output.size(); i++) {
        int32_t diff = static_cast<int32_t>(output[i] - golden[i]);
        if (diff != 0) {
            passed = false;
            break;
        }
    }
    
    if (passed) {
        std::cout << "[Success] " << func_name << " verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << func_name << " verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t thread_num_per_block = 32;
    constexpr uint32_t block_num = 1;
    constexpr uint32_t total_length = thread_num_per_block * block_num;
    uint32_t total_failed = 0;
    
    std::cout << "Testing laneid() function..." << std::endl;
    std::vector<int32_t> laneid_golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        laneid_golden[i] = i % WARP_SIZE;
    }
    std::vector<int32_t> laneid_output = run_laneid_test(total_length);
    total_failed += verify_laneid_result(laneid_output, laneid_golden);
    
    std::cout << "\nTesting lanemask_ge() function..." << std::endl;
    std::vector<uint32_t> lanemask_ge_golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        lanemask_ge_golden[i] = 0xFFFFFFFFU << i;
    }
    std::vector<uint32_t> lanemask_ge_output = run_lanemask_ge_test(total_length);
    total_failed += verify_lanemask_result(lanemask_ge_output, lanemask_ge_golden, "Lanemask_ge");
    
    std::cout << "\nTesting lanemask_eq() function..." << std::endl;
    std::vector<uint32_t> lanemask_eq_golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        lanemask_eq_golden[i] = 1U << i;
    }
    std::vector<uint32_t> lanemask_eq_output = run_lanemask_eq_test(total_length);
    total_failed += verify_lanemask_result(lanemask_eq_output, lanemask_eq_golden, "Lanemask_eq");
    
    std::cout << "\nTesting lanemask_gt() function..." << std::endl;
    std::vector<uint32_t> lanemask_gt_golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        lanemask_gt_golden[i] = 0xFFFFFFFFU << (i + 1);
    }
    std::vector<uint32_t> lanemask_gt_output = run_lanemask_gt_test(total_length);
    total_failed += verify_lanemask_result(lanemask_gt_output, lanemask_gt_golden, "Lanemask_gt");
    
    std::cout << "\nTesting lanemask_le() function..." << std::endl;
    std::vector<uint32_t> lanemask_le_golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        lanemask_le_golden[i] = 0xFFFFFFFFU >> (31 - i);
    }
    std::vector<uint32_t> lanemask_le_output = run_lanemask_le_test(total_length);
    total_failed += verify_lanemask_result(lanemask_le_output, lanemask_le_golden, "Lanemask_le");
    
    std::cout << "\nTesting lanemask_lt() function..." << std::endl;
    std::vector<uint32_t> lanemask_lt_golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        lanemask_lt_golden[i] = (1U << i) - 1;
    }
    std::vector<uint32_t> lanemask_lt_output = run_lanemask_lt_test(total_length);
    total_failed += verify_lanemask_result(lanemask_lt_output, lanemask_lt_golden, "Lanemask_lt");
    
    if (total_failed == 0) {
        std::cout << "\n[Success] All laneid functions tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "\n[Failed] laneid functions tests failed with " << total_failed << " total errors." << std::endl;
        return 1;
    }
}