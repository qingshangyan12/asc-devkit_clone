/* !
 * \file laneid.asc
 * \brief Verify laneid() API functionality
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

constexpr uint32_t WARP_SIZE = 32;

__global__ void laneid_test(int32_t* laneid_output, uint64_t total_length)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx >= total_length) {
        return;
    }
    
    laneid_output[idx] = laneid();
}

std::vector<int32_t> test_laneid(uint64_t total_length)
{
    size_t total_byte_size = total_length * sizeof(int32_t);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    int32_t* output_device = nullptr;
    int8_t* output_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t thread_num_per_block = 32;
    uint32_t block_num = (total_length + thread_num_per_block - 1) / thread_num_per_block;
    uint32_t dyn_ubuf_size = 0;
    
    laneid_test<<<block_num, thread_num_per_block, dyn_ubuf_size, stream>>>(
        output_device, total_length
    );
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> output(reinterpret_cast<int32_t*>(output_host), 
                                 reinterpret_cast<int32_t*>(output_host + total_byte_size));
    
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<int32_t>& output, std::vector<int32_t>& golden, uint32_t thread_num_per_block)
{
    auto print_tensor = [](std::vector<int32_t>& tensor, const char* name) {
        std::cout << name << ": ";
        for (size_t i = 0; i < tensor.size(); i++) {
            std::cout << tensor[i] << " ";
        }
        std::cout << std::endl;
    };
    
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    
    bool passed = true;
    for (size_t i = 0; i < output.size(); i++) {
        int32_t diff = output[i] - golden[i];
        if (diff != 0) {
            passed = false;
            break;
        }
    }
    
    if (passed) {
        std::cout << "[Success] Laneid verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Laneid verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t thread_num_per_block = 32;
    constexpr uint32_t block_num = 1;
    constexpr uint32_t total_length = thread_num_per_block * block_num;
    
    std::vector<int32_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        golden[i] = i % WARP_SIZE;
    }
    
    std::vector<int32_t> output = test_laneid(total_length);
    
    return verify_result(output, golden, thread_num_per_block);
}