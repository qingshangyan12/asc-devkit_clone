/**
 * test_pure.asc
 *
 * Pure SIMT mode test (--enable-simt).
 * Includes each modified simt_api header and calls one representative API
 * from each to verify that npu_arch_features.h correctly enables them.
 *
 * Headers under test:
 *   asc_fp16.h          -> __NPU_HAS_FP16__
 *   asc_bf16.h          -> __NPU_HAS_BF16__
 *   asc_fp8.h           -> excluded: asc_fp8_impl.h broken in pure SIMT on cann-9.1.0
 *   device_warp_functions.h   -> __NPU_HAS_WARP__
 *   vector_functions.h        -> __NPU_HAS_VECTOR_TYPES__
 *   device_atomic_functions.h -> __NPU_HAS_ATOMIC__
 *   common_functions.h        -> __NPU_HAS_VF_CALL__ (not used in pure SIMT)
 */

#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_bf16.h"
// asc_fp8.h excluded: __cvt_hifloat8x2_t undefined in pure SIMT mode on cann-9.1.0
#include "simt_api/device_warp_functions.h"
#include "simt_api/vector_functions.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/common_functions.h"

namespace {
    constexpr uint32_t BLOCK_NUM = 48;
    constexpr uint32_t THREAD_NUM = 256;
    constexpr uint32_t N = BLOCK_NUM * THREAD_NUM;
}

// Pure SIMT kernel: __global__ with plain pointers, no __gm__/__ubuf__ qualifiers
__global__ void test_pure_kernel(float* input, float* output, int32_t* counter, uint32_t n)
{
    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= (int32_t)n) { return; }

    float val = input[idx];

    // __NPU_HAS_FP16__: asc_fp16.h
    half h = __float2half(val);
    float f16_val = __half2float(h);

    // __NPU_HAS_BF16__: asc_bf16.h
    bfloat16_t b = __float2bfloat16(val);
    float bf16_val = __bfloat162float(b);

    // __NPU_HAS_VECTOR_TYPES__: vector_functions.h
    float2 fv = make_float2(f16_val, bf16_val);

    // __NPU_HAS_WARP__: device_warp_functions.h -- broadcast lane 0 value to all threads
    float broadcast = asc_shfl(fv.x, 0);

    // __NPU_HAS_ATOMIC__: device_atomic_functions.h -- plain pointer in pure SIMT mode
    asc_atomic_add(counter, 1);

    output[idx] = broadcast + fv.y;
}

int32_t main(int32_t argc, char* argv[])
{
    size_t byte_size = N * sizeof(float);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    float*   input_host  = nullptr;
    float*   output_host = nullptr;
    float*   input_dev   = nullptr;
    float*   output_dev  = nullptr;
    int32_t* counter_dev = nullptr;
    int32_t  counter_host = 0;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&input_host,  byte_size);
    aclrtMallocHost((void**)&output_host, byte_size);
    for (uint32_t i = 0; i < N; i++) { input_host[i] = (float)i * 0.01f; }

    aclrtMalloc((void**)&input_dev,   byte_size,         ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_dev,  byte_size,         ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&counter_dev, sizeof(int32_t),   ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(counter_dev, sizeof(int32_t), 0, sizeof(int32_t));
    aclrtMemcpy(input_dev, byte_size, input_host, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t dyn_ubuf_size = 0;
    test_pure_kernel<<<BLOCK_NUM, THREAD_NUM, dyn_ubuf_size, stream>>>(
        input_dev, output_dev, counter_dev, N);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, byte_size, output_dev, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(&counter_host, sizeof(int32_t), counter_dev, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        std::cerr << "[ERROR] " << err << std::endl;
    }

    std::cout << "[test_pure] counter=" << counter_host
              << " output[0]=" << output_host[0]
              << " output[1]=" << output_host[1] << std::endl;
    std::cout << (counter_host == (int32_t)N ? "[PASS]" : "[FAIL]")
              << " pure SIMT header coverage test" << std::endl;

    aclrtFree(input_dev);
    aclrtFree(output_dev);
    aclrtFree(counter_dev);
    aclrtFreeHost(input_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return (counter_host == (int32_t)N) ? 0 : 1;
}
