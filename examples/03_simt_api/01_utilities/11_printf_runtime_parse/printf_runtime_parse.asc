/*!
 * \file printf_runtime_parse.asc
 * \brief Standalone SIMT printf ring-buffer producer and host-side runtime parser demo.
 */

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <atomic>
#include <chrono>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <sstream>
#include <string>
#include <thread>
#include <type_traits>
#include <vector>

#include "acl/acl.h"
#include "simt_api/device_types.h"
#include "simt_api/device_warp_functions.h"

#ifndef __NPU_COMPILER_INTERNAL_PURE_SIMT__
#define __simt_gm__ __gm__
#else
#include "__clang_cce_simt_atomic.h"
#define __simt_gm__
#endif

namespace {
constexpr uint32_t BLOCK_SIZE = 2U * 1024U * 1024U;
constexpr uint32_t BLOCKS_PER_GRID = 64U;
constexpr uint32_t THREADS_PER_BLOCK = 2048U;
constexpr uint32_t LOGS_PER_THREAD = 128U;
constexpr uint32_t DIAG_RECORD_COUNT = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr uint32_t DIAG_MAGIC = 0x50535450U; // PSTP
constexpr uint32_t PRINT_SIMT = 2U;
constexpr uint16_t MAGIC_NUM = 0xAE86U;
constexpr uint32_t PRINT_ARG_LEN = 8U;
constexpr uint32_t RESV_LEN_SIMT = 40U;
constexpr uint32_t SIMT_PRINT_MSG_LEN_OFFSET = 44U;

enum class DumpType : uint32_t {
    DUMP_DEFAULT = 0,
    DUMP_SCALAR,
    DUMP_TENSOR,
    DUMP_SHAPE,
    DUMP_ASSERT,
    DUMP_META,
    DUMP_TIMESTAMP,
    DUMP_SIMT,
    DUMP_BUFI,
    DUMP_BUFO,
    DUMP_SKIP,
    DUMP_SIMT_ASSERT = 0xF0E00F0E,
    DUMP_SIMT_PRINTF = 0xF0F00F0F,
    DUMP_WAIT = 0xF0A55A0F,
};

enum class PrintfCallSite : uint32_t {
    GET_PRINT_TLV_LEN = 1,
    CHECK_AND_WAIT_RING_BUF_SPACE = 2,
    WRITE_RING_BUF_TLV_HEAD = 3,
    WRITE_RING_BUF_TLV_DATA = 4,
    DCCI_WRITE_DATA = 5,
    THREADFENCE = 6,
    WRITE_FINISH = 7,
    DCCI_WRITE_FINISH = 8,
};

enum class PrintfCallPhase : uint32_t {
    BEFORE = 1,
    AFTER = 2,
};

#pragma pack(push, 1)
struct BlockInfo {
    uint32_t length = 0;
    uint32_t coreId = 0;
    uint32_t blockNum = 0;
    uint32_t remainLen = 0;
    uint16_t magic = MAGIC_NUM;
    uint16_t flag = 0;
    uint32_t rsv = 0;
    uint64_t dumpAddr = 0;
    uint64_t dbgAddr = 0;
    uint32_t resv[4] = {0U};
};

struct DumpInfoHead {
    DumpType type = DumpType::DUMP_DEFAULT;
    uint32_t infoLen = 0U;
    uint8_t infoMsg[0U];
};

struct PrintTlvInfoHead {
    DumpType type = DumpType::DUMP_DEFAULT;
    uint32_t length = 0U;
    uint32_t blockIdx[3] = {0U};
    uint32_t threadIdx[3] = {0U};
    uint32_t resv[4] = {0U};
    uint64_t fmtOffset = 0U;
};

struct BlockWriteInfo {
    DumpType dumpType = DumpType::DUMP_BUFI;
    uint32_t length = 16U;
    uint64_t writeIdx = 0U;
    uint64_t packIdx = 0U;
};

struct BlockReadInfo {
    DumpType dumpType = DumpType::DUMP_BUFO;
    uint32_t length = 16U;
    uint64_t readIdx = 0U;
    uint64_t resv = 0U;
};

struct PrintfCallDiag {
    uint32_t magic = 0U;
    uint32_t block = 0U;
    uint32_t thread = 0U;
    uint32_t globalThread = 0U;
    uint32_t lastSeq = 0U;
    uint32_t callCount = 0U;
    uint32_t callSite = 0U;
    uint32_t callPhase = 0U;
};
#pragma pack(pop)

static_assert(sizeof(BlockInfo) == 56U, "BlockInfo layout must match runtime");
static_assert(sizeof(BlockReadInfo) == 24U, "BlockReadInfo layout must match runtime");
static_assert(sizeof(BlockWriteInfo) == 24U, "BlockWriteInfo layout must match runtime");
static_assert(sizeof(DumpInfoHead) == 8U, "DumpInfoHead layout must match runtime");
static_assert(sizeof(PrintTlvInfoHead) == 56U, "PrintTlvInfoHead layout must match device");

#if defined(__NPU_ARCH__) && ((__NPU_ARCH__ == 3510) || (__NPU_ARCH__ == 5102))
namespace device_printf {
constexpr uint32_t BYTE_ALIGN = 8U;

using HostDumpType = DumpType;

struct BlockRingBufInfo {
    uint32_t length = 0U;
    uint32_t coreId = 0U;
    uint32_t blockNum = 0U;
    uint32_t ringBufLen = 0U;
    uint16_t magic = 0U;
    uint16_t flag = 0U;
    uint32_t rsv = 0U;
    uint64_t ringBufAddr = 0U;
    uint64_t dbgAddr = 0U;
    uint32_t resvMem[4] = {0U};
};

struct RingBufWriteInfo {
    uint32_t type = static_cast<uint32_t>(HostDumpType::DUMP_BUFI);
    uint32_t length = 0U;
    uint64_t bufOffset = 0U;
    uint64_t packIdx = 0U;
};

struct RingBufReadInfo {
    uint32_t type = static_cast<uint32_t>(HostDumpType::DUMP_BUFO);
    uint32_t length = 0U;
    uint64_t bufOffset = 0U;
    uint64_t resv = 0U;
};

struct PrintTlvInfoHead {
    uint32_t type = 0U;
    uint32_t length = 0U;
    uint32_t blockIdx[3] = {0U};
    uint32_t threadIdx[3] = {0U};
    uint32_t resv[4] = {0U};
    uint64_t fmtOffset = 0U;
};

union TlvHeadToBytes {
    PrintTlvInfoHead tlvHead;
    uint8_t bytes[56];
};

union TypeToByte8 {
    int64_t valueS64;
    uint64_t valueU64;
    float valueF32;
    double valueF64;
    uint8_t bytes[8];
};

union TypeToByte4 {
    uint32_t value;
    uint8_t bytes[4];
};

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetStringLength(__simt_gm__ const char *s)
{
    uint32_t len = 0U;
    while (*(s + len) != '\0') {
        len++;
    }
    return len + 1U;
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetPrintArgsLen(uint32_t &argsNum)
{
    return 0U;
}

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetPrintArgsLen(uint32_t &argsNum, Args&&... args);

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetPrintArgsLenImpl(uint32_t &argsNum,
    __simt_gm__ const char *str, Args&&... args)
{
    argsNum++;
    return sizeof(uint64_t) + GetStringLength(str) + GetPrintArgsLen(argsNum, args...);
}

template <typename T, typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetPrintArgsLenImpl(uint32_t &argsNum, T, Args&&... args)
{
    argsNum++;
    return sizeof(uint64_t) + GetPrintArgsLen(argsNum, args...);
}

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetPrintArgsLen(uint32_t &argsNum, Args&&... args)
{
    return GetPrintArgsLenImpl(argsNum, args...);
}

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t GetPrintTlvLen(uint32_t &argsNum,
    __simt_gm__ const char *fmt, Args&&... args)
{
    return sizeof(PrintTlvInfoHead) + GetStringLength(fmt) + GetPrintArgsLen(argsNum, args...);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline __simt_gm__ RingBufReadInfo *GetRingBufReadInfo(
    __simt_gm__ BlockRingBufInfo *blockRingBufInfo)
{
    __simt_gm__ uint8_t *blockHead = reinterpret_cast<__simt_gm__ uint8_t *>(blockRingBufInfo);
    return reinterpret_cast<__simt_gm__ RingBufReadInfo *>(blockHead + sizeof(BlockRingBufInfo));
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline __simt_gm__ RingBufWriteInfo *GetRingBufWriteInfo(
    __simt_gm__ BlockRingBufInfo *blockRingBufInfo)
{
    __simt_gm__ uint8_t *ringBufAddr = reinterpret_cast<__simt_gm__ uint8_t *>(blockRingBufInfo->ringBufAddr);
    return reinterpret_cast<__simt_gm__ RingBufWriteInfo *>(ringBufAddr + blockRingBufInfo->ringBufLen);
}

template <uint32_t count = 1U>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void Nop()
{
#pragma unroll
    for (uint32_t i = 0U; i < count; ++i) {
        asm volatile("NOP wait:0b0000000 stall:15"::);
    }
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void RingBufferWait(__simt_gm__ RingBufReadInfo *readInfo, uint64_t endOffset)
{
    volatile uint64_t tmp = *reinterpret_cast<volatile uint64_t *>(&readInfo->bufOffset);
    constexpr uint32_t nopCount = 65536U;
    while (endOffset >= tmp) {
        tmp = *reinterpret_cast<volatile uint64_t *>(&readInfo->bufOffset);
        Nop<nopCount>();
    }
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint64_t CheckAndWaitRingBufSpace(
    __simt_gm__ BlockRingBufInfo *blockRingBufInfo, uint64_t tlvLen)
{
    __simt_gm__ RingBufReadInfo *readInfo = GetRingBufReadInfo(blockRingBufInfo);
    __simt_gm__ RingBufWriteInfo *writeInfo = GetRingBufWriteInfo(blockRingBufInfo);
    uint64_t startOffset = 0U;
    const uint32_t activeThread = __activemask();
    const uint64_t totalLen = static_cast<uint64_t>(__popc(activeThread)) * tlvLen;
    const int32_t laneId = __ffs(static_cast<int>(activeThread)) - 1;
    if (laneid() == laneId) {
#ifndef __NPU_COMPILER_INTERNAL_PURE_SIMT__
        startOffset = atomicAdd(&writeInfo->bufOffset, totalLen);
#else
        startOffset = __atomic_add(&writeInfo->bufOffset, totalLen);
#endif
        const uint64_t endOffset = startOffset + totalLen;
        if (endOffset > readInfo->bufOffset + blockRingBufInfo->ringBufLen) {
            RingBufferWait(readInfo, endOffset - blockRingBufInfo->ringBufLen);
        }
    }
    return asc_shfl(startOffset, laneId, warpSize) + tlvLen * laneid();
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void WriteRingBufTlvHead(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t &writePtr, uint32_t tlvLen, uint32_t argsNum)
{
    TlvHeadToBytes tmp{.tlvHead = {static_cast<uint32_t>(HostDumpType::DUMP_WAIT),
                                   static_cast<uint32_t>(tlvLen - sizeof(uint32_t) * 2U),
                                   {static_cast<uint32_t>(blockIdx.x), static_cast<uint32_t>(blockIdx.y),
                                    static_cast<uint32_t>(blockIdx.z)},
                                   {static_cast<uint32_t>(threadIdx.x), static_cast<uint32_t>(threadIdx.y),
                                    static_cast<uint32_t>(threadIdx.z)},
                                   {0U, 0U, 0U, 0U},
                                   (argsNum + 1U) * sizeof(uint64_t)}};
    __simt_gm__ uint8_t *dataPtr = reinterpret_cast<__simt_gm__ uint8_t *>(blockRingBufInfo->ringBufAddr);
    writePtr = writePtr % blockRingBufInfo->ringBufLen;
    for (uint32_t i = 0U; i < sizeof(PrintTlvInfoHead); ++i) {
        dataPtr[(writePtr + i) % blockRingBufInfo->ringBufLen] = tmp.bytes[i];
    }
    writePtr = (writePtr + sizeof(PrintTlvInfoHead)) % blockRingBufInfo->ringBufLen;
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline uint32_t WriteString(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    __simt_gm__ const char *str, uint32_t writePtr)
{
    const uint32_t strLen = GetStringLength(str);
    __simt_gm__ char *dataPtr = reinterpret_cast<__simt_gm__ char *>(blockRingBufInfo->ringBufAddr);
    for (uint32_t i = 0U; i < strLen; ++i) {
        dataPtr[(writePtr + i) % blockRingBufInfo->ringBufLen] = str[i];
    }
    return strLen;
}

template <typename T>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void WriteScalar(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t writePtr, T scalar)
{
    TypeToByte8 tmp{0};
    if constexpr (std::is_floating_point<T>::value) {
        tmp.valueF32 = static_cast<float>(scalar);
    } else if constexpr (std::is_pointer<T>::value) {
        tmp.valueU64 = reinterpret_cast<uintptr_t>(scalar);
    } else if constexpr (std::is_signed<T>::value) {
        tmp.valueS64 = static_cast<int64_t>(scalar);
    } else {
        tmp.valueU64 = static_cast<uint64_t>(scalar);
    }
    __simt_gm__ uint8_t *dataPtr = reinterpret_cast<__simt_gm__ uint8_t *>(blockRingBufInfo->ringBufAddr);
    for (uint32_t i = 0U; i < sizeof(uint64_t); ++i) {
        dataPtr[(writePtr + i) % blockRingBufInfo->ringBufLen] = tmp.bytes[i];
    }
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void SetParam(__simt_gm__ BlockRingBufInfo *, uint32_t, uint32_t, uint32_t)
{
}

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void SetParam(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t startOffset, uint32_t paramIdx, uint32_t strOffset, Args&&... args);

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void SetParamImpl(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t startOffset, uint32_t paramIdx, uint32_t strOffset, __simt_gm__ const char *str, Args&&... args)
{
    const uint32_t paramOffset = sizeof(uint64_t) * paramIdx;
    WriteScalar(blockRingBufInfo, startOffset + paramOffset, strOffset - paramOffset);
    const uint32_t strLen = WriteString(blockRingBufInfo, str, startOffset + strOffset);
    SetParam(blockRingBufInfo, startOffset, paramIdx + 1U, strOffset + strLen, args...);
}

template <typename T, typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void SetParamImpl(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t startOffset, uint32_t paramIdx, uint32_t strOffset, T scalar, Args&&... args)
{
    const uint32_t paramOffset = sizeof(uint64_t) * paramIdx;
    WriteScalar(blockRingBufInfo, startOffset + paramOffset, scalar);
    SetParam(blockRingBufInfo, startOffset, paramIdx + 1U, strOffset, args...);
}

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void SetParam(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t startOffset, uint32_t paramIdx, uint32_t strOffset, Args&&... args)
{
    SetParamImpl(blockRingBufInfo, startOffset, paramIdx, strOffset, args...);
}

template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void WriteRingBufTlvData(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint32_t startOffset, uint32_t argsNum, __simt_gm__ const char *fmt, Args&&... args)
{
    const uint32_t fmtOffset = argsNum * sizeof(uint64_t);
    const uint32_t strLen = WriteString(blockRingBufInfo, fmt, startOffset + fmtOffset);
    SetParam(blockRingBufInfo, startOffset, 0U, fmtOffset + strLen, args...);
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void WriteFinish(__simt_gm__ BlockRingBufInfo *blockRingBufInfo,
    uint64_t writePtr, HostDumpType printType)
{
    TypeToByte4 tmp{.value = static_cast<uint32_t>(printType)};
    __simt_gm__ uint8_t *dataPtr = reinterpret_cast<__simt_gm__ uint8_t *>(blockRingBufInfo->ringBufAddr);
    for (uint32_t i = 0U; i < sizeof(uint32_t); ++i) {
        dataPtr[(writePtr + i) % blockRingBufInfo->ringBufLen] = tmp.bytes[i];
    }
    __simt_gm__ RingBufWriteInfo *writeInfo = GetRingBufWriteInfo(blockRingBufInfo);
#ifndef __NPU_COMPILER_INTERNAL_PURE_SIMT__
    atomicAdd(&writeInfo->packIdx, 1UL);
#else
    __atomic_add(&writeInfo->packIdx, 1UL);
#endif
}

__SIMT_DEVICE_FUNCTIONS_DECL__ inline void RecordPrintfCall(__simt_gm__ PrintfCallDiag *diag,
    PrintfCallSite callSite, PrintfCallPhase callPhase, uint32_t seq)
{
    if (diag == nullptr) {
        return;
    }
    diag->magic = DIAG_MAGIC;
    diag->block = static_cast<uint32_t>(blockIdx.x);
    diag->thread = static_cast<uint32_t>(threadIdx.x);
    diag->globalThread = static_cast<uint32_t>(blockIdx.x * blockDim.x + threadIdx.x);
    diag->lastSeq = seq;
    diag->callCount = seq + 1U;
    diag->callSite = static_cast<uint32_t>(callSite);
    diag->callPhase = static_cast<uint32_t>(callPhase);
}
} // namespace device_printf
#endif

bool CheckAcl(aclError ret, const char *expr, const char *file, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL error at %s:%d: %s failed, code=%d, msg=%s\n",
        file, line, expr, static_cast<int32_t>(ret), aclGetRecentErrMsg());
    return false;
}

#define CHECK_ACL(expr) do {                          \
    if (!CheckAcl((expr), #expr, __FILE__, __LINE__)) { \
        return false;                                 \
    }                                                 \
} while (0)

template <typename T>
T LoadParam(const uint8_t *paramBegin, uint32_t paramIndex)
{
    T value {};
    std::memcpy(&value, paramBegin + static_cast<size_t>(paramIndex) * PRINT_ARG_LEN, sizeof(T));
    return value;
}

std::string ToHex(uint64_t value, bool upper)
{
    std::ostringstream os;
    if (upper) {
        os << std::uppercase;
    }
    os << std::hex << value;
    return os.str();
}

std::string HexBytes(const uint8_t *data, size_t size)
{
    std::ostringstream os;
    for (size_t i = 0; i < size; ++i) {
        if (i != 0U) {
            os << ' ';
        }
        os << std::hex << std::setw(2) << std::setfill('0') << static_cast<uint32_t>(data[i]);
    }
    return os.str();
}

void DumpRawWorkspace(const std::vector<uint8_t> &hostData, uint32_t round)
{
    const std::string path = "printf_workspace_round_" + std::to_string(round) + ".bin";
    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (!out) {
        std::fprintf(stderr, "[WARN] failed to open %s for writing\n", path.c_str());
        return;
    }
    out.write(reinterpret_cast<const char *>(hostData.data()), static_cast<std::streamsize>(hostData.size()));
    std::printf("[HOST_PARSE] dump raw workspace: %s (%zu bytes)\n", path.c_str(), hostData.size());
}

void PrintFirstTlvInfoHeadAfterRead(const std::vector<uint8_t> &hostData)
{
    const auto *blockInfo = reinterpret_cast<const BlockInfo *>(hostData.data());
    const auto *readInfo = reinterpret_cast<const BlockReadInfo *>(hostData.data() + sizeof(BlockInfo));
    if (blockInfo->remainLen == 0U) {
        std::printf("[HOST_PARSE] FirstPrintTlvInfoHeadAfterRead: <invalid remainLen=0>\n");
        return;
    }

    const uint64_t readIdxMod = readInfo->readIdx % blockInfo->remainLen;
    const uint64_t tlvOffset = sizeof(BlockInfo) + sizeof(BlockReadInfo) + readIdxMod;
    if (tlvOffset + sizeof(PrintTlvInfoHead) > hostData.size()) {
        std::printf("[HOST_PARSE] FirstPrintTlvInfoHeadAfterRead: <out-of-range offset=%llu>\n",
            static_cast<unsigned long long>(tlvOffset));
        return;
    }

    const auto *head = reinterpret_cast<const PrintTlvInfoHead *>(hostData.data() + tlvOffset);
    std::printf("[HOST_PARSE] FirstPrintTlvInfoHeadAfterRead: offset=%llu type=0x%x length=%u "
                "blockIdx=[%u,%u,%u] threadIdx=[%u,%u,%u] resv=[%u,%u,%u,%u] fmtOffset=0x%llx\n",
        static_cast<unsigned long long>(tlvOffset),
        static_cast<uint32_t>(head->type),
        head->length,
        head->blockIdx[0], head->blockIdx[1], head->blockIdx[2],
        head->threadIdx[0], head->threadIdx[1], head->threadIdx[2],
        head->resv[0], head->resv[1], head->resv[2], head->resv[3],
        static_cast<unsigned long long>(head->fmtOffset));
    const std::string rawHex = HexBytes(reinterpret_cast<const uint8_t *>(head), sizeof(PrintTlvInfoHead));
    std::printf("[HOST_PARSE] FirstPrintTlvInfoHeadRawHex: %s\n", rawHex.c_str());
}

std::string ParseFormatToken(const char *format)
{
    std::string token;
    if (*format == 'l') {
        token += *format++;
        if (*format == 'l') {
            token += *format++;
        }
    }
    if (*format != '\0') {
        token += *format;
    }
    return token;
}

void AppendFormattedParam(const std::string &token, const uint8_t *paramBegin, uint32_t paramIndex,
    std::string &out)
{
    const char spec = token.empty() ? '\0' : token.back();
    switch (spec) {
        case 'd':
        case 'i':
            out += std::to_string(LoadParam<int64_t>(paramBegin, paramIndex));
            return;
        case 'u':
            out += std::to_string(LoadParam<uint64_t>(paramBegin, paramIndex));
            return;
        case 'f':
        case 'F':
            out += std::to_string(LoadParam<float>(paramBegin, paramIndex));
            return;
        case 'p': {
            std::ostringstream os;
            os << "0x" << std::hex << LoadParam<uint64_t>(paramBegin, paramIndex);
            out += os.str();
            return;
        }
        case 'x':
            out += ToHex(LoadParam<uint64_t>(paramBegin, paramIndex), false);
            return;
        case 'X':
            out += ToHex(LoadParam<uint64_t>(paramBegin, paramIndex), true);
            return;
        case 's': {
            const uint64_t offset = LoadParam<uint64_t>(paramBegin, paramIndex);
            const char *offsetAddr = reinterpret_cast<const char *>(paramBegin + static_cast<size_t>(paramIndex) * PRINT_ARG_LEN);
            const char *str = offsetAddr + offset;
            const uint32_t maxLen = LoadParam<uint32_t>(paramBegin - SIMT_PRINT_MSG_LEN_OFFSET, 0);
            out += std::string(str, strnlen(str, maxLen));
            return;
        }
        default:
            out += "%" + token;
            return;
    }
}

void ParsePrintToStdout(const char *format, const uint8_t *paramBegin, uint32_t paramNum)
{
    uint32_t paramIndex = 0U;
    std::string printInfo;
    while (*format != '\0') {
        if (*format != '%') {
            printInfo += *format++;
            continue;
        }
        format++;
        const std::string token = ParseFormatToken(format);
        if (token == "%") {
            printInfo += '%';
            format++;
            continue;
        }
        paramIndex++;
        if (paramIndex > paramNum) {
            printInfo += "<missing-param>";
            break;
        }
        AppendFormattedParam(token, paramBegin, paramIndex, printInfo);
        format += token.size();
    }
    std::printf("%s", printInfo.c_str());
}

void PrintSimtDump(const DumpInfoHead *dumpHead)
{
    if (dumpHead->type != DumpType::DUMP_SIMT_PRINTF && dumpHead->type != DumpType::DUMP_SIMT_ASSERT) {
        return;
    }
    if (dumpHead->infoLen < RESV_LEN_SIMT + PRINT_ARG_LEN) {
        std::fprintf(stderr, "[WARN] bad SIMT printf infoLen=%u\n", dumpHead->infoLen);
        return;
    }

    const uint64_t strOffset = LoadParam<uint64_t>(dumpHead->infoMsg + RESV_LEN_SIMT, 0);
    const uint32_t argsNum = static_cast<uint32_t>(strOffset / PRINT_ARG_LEN) - 1U;
    const char *fmt = reinterpret_cast<const char *>(dumpHead->infoMsg + RESV_LEN_SIMT + strOffset);
    ParsePrintToStdout(fmt, dumpHead->infoMsg + RESV_LEN_SIMT, argsNum);
}

void InitSimtPrintfHost(std::vector<uint8_t> &hostData, void *deviceWorkspace)
{
    std::fill(hostData.begin(), hostData.end(), 0U);
    auto *blockInfo = reinterpret_cast<BlockInfo *>(hostData.data());
    blockInfo->length = BLOCK_SIZE;
    blockInfo->remainLen = BLOCK_SIZE - sizeof(BlockInfo) - sizeof(BlockReadInfo) - sizeof(BlockWriteInfo);
    blockInfo->magic = MAGIC_NUM;
    blockInfo->flag = PRINT_SIMT;
    blockInfo->dumpAddr = reinterpret_cast<uint64_t>(deviceWorkspace) + sizeof(BlockInfo) + sizeof(BlockReadInfo);

    auto *readInfo = reinterpret_cast<BlockReadInfo *>(hostData.data() + sizeof(BlockInfo));
    readInfo->dumpType = DumpType::DUMP_BUFO;
    readInfo->length = sizeof(uint64_t) + sizeof(uint64_t);
    readInfo->readIdx = 0U;

    auto *writeInfo = reinterpret_cast<BlockWriteInfo *>(hostData.data() + BLOCK_SIZE - sizeof(BlockWriteInfo));
    writeInfo->dumpType = DumpType::DUMP_BUFI;
    writeInfo->length = sizeof(uint64_t) + sizeof(uint64_t);
    writeInfo->writeIdx = readInfo->readIdx;
}

void GetReadLenAndAddr(uint8_t *blockAddr, uint64_t &totalReadBufLen, const uint8_t *&dumpReadStartAddr,
    std::vector<uint8_t> &linear)
{
    const auto *blockInfo = reinterpret_cast<const BlockInfo *>(blockAddr);
    const auto *readInfo = reinterpret_cast<const BlockReadInfo *>(blockAddr + sizeof(BlockInfo));
    const auto *writeInfo = reinterpret_cast<const BlockWriteInfo *>(blockAddr + BLOCK_SIZE - sizeof(BlockWriteInfo));
    const uint8_t *dumpStartAddr = blockAddr + sizeof(BlockInfo) + sizeof(BlockReadInfo);
    const uint64_t readIdx = readInfo->readIdx % blockInfo->remainLen;

    if (writeInfo->writeIdx - readInfo->readIdx > blockInfo->remainLen) {
        totalReadBufLen = blockInfo->remainLen;
        linear.resize(totalReadBufLen);
        std::memcpy(linear.data(), dumpStartAddr + readIdx, blockInfo->remainLen - readIdx);
        std::memcpy(linear.data() + blockInfo->remainLen - readIdx, dumpStartAddr, readIdx);
        dumpReadStartAddr = linear.data();
        return;
    }

    const uint64_t writeIdx = writeInfo->writeIdx % blockInfo->remainLen;
    if (readIdx > writeIdx) {
        totalReadBufLen = blockInfo->remainLen - readIdx + writeIdx;
        linear.resize(totalReadBufLen);
        std::memcpy(linear.data(), dumpStartAddr + readIdx, blockInfo->remainLen - readIdx);
        std::memcpy(linear.data() + blockInfo->remainLen - readIdx, dumpStartAddr, writeIdx);
        dumpReadStartAddr = linear.data();
    } else {
        totalReadBufLen = writeIdx - readIdx;
        dumpReadStartAddr = dumpStartAddr + readIdx;
    }
}

uint64_t CollectAndPrintSimtPrintf(const uint8_t *dumpReadStartAddr, uint64_t totalReadBufLen, uint64_t packIdx)
{
    uint64_t processedLen = 0U;
    uint64_t tlvCnt = 0U;
    while (processedLen < totalReadBufLen) {
        const auto *dumpHead = reinterpret_cast<const DumpInfoHead *>(dumpReadStartAddr + processedLen);
        if (tlvCnt == packIdx ||
            (dumpHead->type != DumpType::DUMP_SIMT_ASSERT && dumpHead->type != DumpType::DUMP_SIMT_PRINTF)) {
            break;
        }
        const uint64_t dumpInfoLen = sizeof(DumpInfoHead) + static_cast<uint64_t>(dumpHead->infoLen);
        if (dumpInfoLen == 0U || processedLen + dumpInfoLen > totalReadBufLen) {
            break;
        }
        PrintSimtDump(dumpHead);
        processedLen += dumpInfoLen;
        tlvCnt++;
    }
    return processedLen;
}

bool ParseSimtPrintfHost(uint8_t *deviceWorkspace, uint32_t round)
{
    std::vector<uint8_t> hostData(BLOCK_SIZE);
    CHECK_ACL(aclrtMemcpy(hostData.data(), hostData.size(), deviceWorkspace, hostData.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    DumpRawWorkspace(hostData, round);
    PrintFirstTlvInfoHeadAfterRead(hostData);

    auto *readInfo = reinterpret_cast<BlockReadInfo *>(hostData.data() + sizeof(BlockInfo));
    const auto *writeInfo = reinterpret_cast<const BlockWriteInfo *>(hostData.data() + BLOCK_SIZE - sizeof(BlockWriteInfo));
    if (readInfo->readIdx == writeInfo->writeIdx) {
        std::printf("[HOST_PARSE] no new printf data, readIdx=%llu writeIdx=%llu packIdx=%llu\n",
            static_cast<unsigned long long>(readInfo->readIdx),
            static_cast<unsigned long long>(writeInfo->writeIdx),
            static_cast<unsigned long long>(writeInfo->packIdx));
        return true;
    }

    uint64_t totalReadBufLen = 0U;
    const uint8_t *dumpReadStartAddr = nullptr;
    std::vector<uint8_t> linear;
    GetReadLenAndAddr(hostData.data(), totalReadBufLen, dumpReadStartAddr, linear);

    const uint64_t oldReadIdx = readInfo->readIdx;
    const uint64_t processedLen = CollectAndPrintSimtPrintf(dumpReadStartAddr, totalReadBufLen, writeInfo->packIdx);
    readInfo->readIdx += processedLen;
    CHECK_ACL(aclrtMemcpy(deviceWorkspace + sizeof(BlockInfo), sizeof(BlockReadInfo), readInfo,
        sizeof(BlockReadInfo), ACL_MEMCPY_HOST_TO_DEVICE));

    std::printf("[HOST_PARSE] readIdx %llu -> %llu, writeIdx=%llu, processedLen=%llu, packIdx=%llu\n",
        static_cast<unsigned long long>(oldReadIdx),
        static_cast<unsigned long long>(readInfo->readIdx),
        static_cast<unsigned long long>(writeInfo->writeIdx),
        static_cast<unsigned long long>(processedLen),
        static_cast<unsigned long long>(writeInfo->packIdx));
    return true;
}

void PollParseThread(int32_t deviceId, uint8_t *deviceWorkspace, std::atomic<bool> &done, std::atomic<bool> &ok)
{
    aclError ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::fprintf(stderr, "[HOST_POLL] aclrtSetDevice(%d) failed, code=%d, msg=%s\n",
            deviceId, static_cast<int32_t>(ret), aclGetRecentErrMsg());
        ok.store(false, std::memory_order_relaxed);
        return;
    }

    uint32_t pollIdx = 0U;
    while (!done.load(std::memory_order_relaxed)) {
        if (!ParseSimtPrintfHost(deviceWorkspace, pollIdx++)) {
            ok.store(false, std::memory_order_relaxed);
            return;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
    }

    if (!ParseSimtPrintfHost(deviceWorkspace, pollIdx++)) {
        ok.store(false, std::memory_order_relaxed);
    }
}

const char *PrintfCallSiteName(uint32_t site)
{
    switch (static_cast<PrintfCallSite>(site)) {
        case PrintfCallSite::GET_PRINT_TLV_LEN:
            return "GET_PRINT_TLV_LEN";
        case PrintfCallSite::CHECK_AND_WAIT_RING_BUF_SPACE:
            return "CHECK_AND_WAIT_RING_BUF_SPACE";
        case PrintfCallSite::WRITE_RING_BUF_TLV_HEAD:
            return "WRITE_RING_BUF_TLV_HEAD";
        case PrintfCallSite::WRITE_RING_BUF_TLV_DATA:
            return "WRITE_RING_BUF_TLV_DATA";
        case PrintfCallSite::DCCI_WRITE_DATA:
            return "DCCI_WRITE_DATA";
        case PrintfCallSite::THREADFENCE:
            return "THREADFENCE";
        case PrintfCallSite::WRITE_FINISH:
            return "WRITE_FINISH";
        case PrintfCallSite::DCCI_WRITE_FINISH:
            return "DCCI_WRITE_FINISH";
        default:
            return "UNKNOWN";
    }
}

const char *PrintfCallPhaseName(uint32_t phase)
{
    switch (static_cast<PrintfCallPhase>(phase)) {
        case PrintfCallPhase::BEFORE:
            return "BEFORE";
        case PrintfCallPhase::AFTER:
            return "AFTER";
        default:
            return "UNKNOWN";
    }
}

bool CopyAndParsePrintfCallDiag(PrintfCallDiag *diagDevice)
{
    std::vector<PrintfCallDiag> diagHost(DIAG_RECORD_COUNT);
    CHECK_ACL(aclrtMemcpy(diagHost.data(), diagHost.size() * sizeof(PrintfCallDiag), diagDevice,
        diagHost.size() * sizeof(PrintfCallDiag), ACL_MEMCPY_DEVICE_TO_HOST));

    constexpr uint32_t maxSite = static_cast<uint32_t>(PrintfCallSite::DCCI_WRITE_FINISH);
    constexpr uint32_t maxPhase = static_cast<uint32_t>(PrintfCallPhase::AFTER);
    uint64_t sitePhaseCount[maxSite + 1U][maxPhase + 1U] = {};
    uint64_t validCount = 0U;
    uint64_t completeCount = 0U;
    uint64_t invalidCount = 0U;
    uint32_t minSeq = LOGS_PER_THREAD;
    uint32_t maxSeq = 0U;
    bool hasSeq = false;

    std::printf("[DIAG] PrintfCallDiag records=%u\n", DIAG_RECORD_COUNT);
    uint32_t sampleCount = 0U;
    for (uint32_t i = 0U; i < DIAG_RECORD_COUNT; ++i) {
        const PrintfCallDiag &diag = diagHost[i];
        if (diag.magic != DIAG_MAGIC) {
            invalidCount++;
            continue;
        }

        validCount++;
        if (diag.lastSeq < minSeq) {
            minSeq = diag.lastSeq;
        }
        if (diag.lastSeq > maxSeq) {
            maxSeq = diag.lastSeq;
        }
        hasSeq = true;

        if (diag.callSite <= maxSite && diag.callPhase <= maxPhase) {
            sitePhaseCount[diag.callSite][diag.callPhase]++;
        }

        const bool complete = diag.lastSeq + 1U == LOGS_PER_THREAD &&
            diag.callSite == static_cast<uint32_t>(PrintfCallSite::DCCI_WRITE_FINISH) &&
            diag.callPhase == static_cast<uint32_t>(PrintfCallPhase::AFTER);
        if (complete) {
            completeCount++;
            continue;
        }

        if (sampleCount < 16U) {
            std::printf("[DIAG] incomplete sample global=%u block=%u thread=%u lastSeq=%u callCount=%u "
                        "site=%s(%u) phase=%s(%u)\n",
                diag.globalThread, diag.block, diag.thread, diag.lastSeq, diag.callCount,
                PrintfCallSiteName(diag.callSite), diag.callSite,
                PrintfCallPhaseName(diag.callPhase), diag.callPhase);
            sampleCount++;
        }
    }

    std::printf("[DIAG] valid=%llu invalid=%llu complete=%llu incomplete=%llu",
        static_cast<unsigned long long>(validCount),
        static_cast<unsigned long long>(invalidCount),
        static_cast<unsigned long long>(completeCount),
        static_cast<unsigned long long>(validCount - completeCount));
    if (hasSeq) {
        std::printf(" seqRange=[%u,%u]", minSeq, maxSeq);
    }
    std::printf("\n");

    for (uint32_t site = 1U; site <= maxSite; ++site) {
        const uint64_t beforeCount = sitePhaseCount[site][static_cast<uint32_t>(PrintfCallPhase::BEFORE)];
        const uint64_t afterCount = sitePhaseCount[site][static_cast<uint32_t>(PrintfCallPhase::AFTER)];
        if (beforeCount == 0U && afterCount == 0U) {
            continue;
        }
        std::printf("[DIAG] %-32s BEFORE=%llu AFTER=%llu\n",
            PrintfCallSiteName(site),
            static_cast<unsigned long long>(beforeCount),
            static_cast<unsigned long long>(afterCount));
    }
    return true;
}

#if defined(__NPU_ARCH__) && ((__NPU_ARCH__ == 3510) || (__NPU_ARCH__ == 5102))
template <typename... Args>
__SIMT_DEVICE_FUNCTIONS_DECL__ inline void simt_printf_to_workspace(
    __simt_gm__ uint8_t *workspace, __simt_gm__ PrintfCallDiag *diag, uint32_t seq,
    __simt_gm__ const char *fmt, Args&&... args)
{
#ifndef ASCENDC_CPU_DEBUG
    if (workspace == nullptr) {
        return;
    }
    __simt_gm__ device_printf::BlockRingBufInfo *blockRingBufInfo =
        reinterpret_cast<__simt_gm__ device_printf::BlockRingBufInfo *>(workspace);
    if (blockRingBufInfo->magic != MAGIC_NUM) {
        return;
    }

    uint32_t argsNum = 0U;
    device_printf::RecordPrintfCall(diag, PrintfCallSite::GET_PRINT_TLV_LEN, PrintfCallPhase::BEFORE, seq);
    uint32_t tlvLen = device_printf::GetPrintTlvLen(argsNum, fmt, args...);
    tlvLen = (tlvLen + device_printf::BYTE_ALIGN - 1U) & (~(device_printf::BYTE_ALIGN - 1U));
    device_printf::RecordPrintfCall(diag, PrintfCallSite::CHECK_AND_WAIT_RING_BUF_SPACE, PrintfCallPhase::BEFORE,
        seq);
    uint64_t startOffset = device_printf::CheckAndWaitRingBufSpace(blockRingBufInfo, tlvLen);
    startOffset = startOffset % blockRingBufInfo->ringBufLen;

    uint32_t writePtr = static_cast<uint32_t>(startOffset);
    device_printf::RecordPrintfCall(diag, PrintfCallSite::WRITE_RING_BUF_TLV_HEAD, PrintfCallPhase::BEFORE, seq);
    device_printf::WriteRingBufTlvHead(blockRingBufInfo, writePtr, tlvLen, argsNum);
    device_printf::RecordPrintfCall(diag, PrintfCallSite::WRITE_RING_BUF_TLV_DATA, PrintfCallPhase::BEFORE, seq);
    device_printf::WriteRingBufTlvData(blockRingBufInfo, writePtr, argsNum, fmt, args...);
    device_printf::RecordPrintfCall(diag, PrintfCallSite::DCCI_WRITE_DATA, PrintfCallPhase::BEFORE, seq);
    dcci(reinterpret_cast<__simt_gm__ void *>(blockRingBufInfo->ringBufAddr + startOffset), 1);

    device_printf::RecordPrintfCall(diag, PrintfCallSite::THREADFENCE, PrintfCallPhase::BEFORE, seq);
    __threadfence();
    device_printf::RecordPrintfCall(diag, PrintfCallSite::WRITE_FINISH, PrintfCallPhase::BEFORE, seq);
    device_printf::WriteFinish(blockRingBufInfo, startOffset, device_printf::HostDumpType::DUMP_SIMT_PRINTF);
    device_printf::RecordPrintfCall(diag, PrintfCallSite::DCCI_WRITE_FINISH, PrintfCallPhase::BEFORE, seq);
    dcci(reinterpret_cast<__simt_gm__ void *>(blockRingBufInfo->ringBufAddr + startOffset), 0);
    device_printf::RecordPrintfCall(diag, PrintfCallSite::DCCI_WRITE_FINISH, PrintfCallPhase::AFTER, seq);
#endif
}
#endif

__global__ __launch_bounds__(THREADS_PER_BLOCK) void printf_runtime_parse_kernel(
    uint8_t *workspace, PrintfCallDiag *diagRecords, uint32_t logsPerThread)
{
#if defined(__NPU_ARCH__) && ((__NPU_ARCH__ == 3510) || (__NPU_ARCH__ == 5102))
    const uint32_t globalThread = static_cast<uint32_t>(blockIdx.x * blockDim.x + threadIdx.x);
    __simt_gm__ PrintfCallDiag *diag = nullptr;
    if (diagRecords != nullptr && globalThread < DIAG_RECORD_COUNT) {
        diag = reinterpret_cast<__simt_gm__ PrintfCallDiag *>(diagRecords) + globalThread;
    }
    for (uint32_t seq = 0U; seq < logsPerThread; ++seq) {
        simt_printf_to_workspace(reinterpret_cast<__simt_gm__ uint8_t *>(workspace), diag, seq,
            "[RUNTIME_PARSE] seq=%u block=%u thread=%u global=%u text=%s\n",
            seq,
            static_cast<uint32_t>(blockIdx.x),
            static_cast<uint32_t>(threadIdx.x),
            globalThread,
            "workspace-param");
    }
#else
    (void)workspace;
    (void)diagRecords;
    (void)logsPerThread;
#endif
}

bool RunSample()
{
    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t *workspaceDevice = nullptr;
    PrintfCallDiag *diagDevice = nullptr;
    std::atomic<bool> pollDone(false);
    std::atomic<bool> pollOk(true);
    std::thread pollThread;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void **>(&workspaceDevice), BLOCK_SIZE, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void **>(&diagDevice),
        static_cast<size_t>(DIAG_RECORD_COUNT) * sizeof(PrintfCallDiag), ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<PrintfCallDiag> initDiag(DIAG_RECORD_COUNT);
    CHECK_ACL(aclrtMemcpy(diagDevice, initDiag.size() * sizeof(PrintfCallDiag), initDiag.data(),
        initDiag.size() * sizeof(PrintfCallDiag), ACL_MEMCPY_HOST_TO_DEVICE));

    std::vector<uint8_t> initData(BLOCK_SIZE);
    InitSimtPrintfHost(initData, workspaceDevice);
    CHECK_ACL(aclrtMemcpy(workspaceDevice, BLOCK_SIZE, initData.data(), BLOCK_SIZE, ACL_MEMCPY_HOST_TO_DEVICE));

    pollThread = std::thread(PollParseThread, deviceId, workspaceDevice, std::ref(pollDone), std::ref(pollOk));

    printf_runtime_parse_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, 0U, stream>>>(
        workspaceDevice, diagDevice, LOGS_PER_THREAD);
    const aclError syncRet = aclrtSynchronizeStream(stream);
    const aclError lastErr = aclrtGetLastError(ACL_RT_THREAD_LEVEL);

    pollDone.store(true, std::memory_order_relaxed);
    if (pollThread.joinable()) {
        pollThread.join();
    }
    if (!CheckAcl(syncRet, "aclrtSynchronizeStream(stream)", __FILE__, __LINE__)) {
        return false;
    }
    if (!CheckAcl(lastErr, "aclrtGetLastError(ACL_RT_THREAD_LEVEL)", __FILE__, __LINE__)) {
        return false;
    }
    if (!pollOk.load(std::memory_order_relaxed)) {
        return false;
    }
    if (!CopyAndParsePrintfCallDiag(diagDevice)) {
        return false;
    }

    CHECK_ACL(aclrtFree(diagDevice));
    CHECK_ACL(aclrtFree(workspaceDevice));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return true;
}
} // namespace

int32_t main()
{
    return RunSample() ? 0 : 1;
}
