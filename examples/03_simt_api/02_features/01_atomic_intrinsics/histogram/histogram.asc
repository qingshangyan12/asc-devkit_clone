#include <cassert>
#include <chrono>
#include <cstdio>
#include <cstdlib>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

constexpr unsigned int HISTOGRAM_BIN_COUNT = 256U;
constexpr unsigned int WARP_SHIFT = 5U;
constexpr unsigned int WARP_SIZE = 1U << WARP_SHIFT;
constexpr unsigned int WARP_COUNT = 6U;
constexpr unsigned int THREADS_PER_BLOCK = WARP_COUNT * WARP_SIZE;
constexpr unsigned int HISTOGRAM_TEMP_MEMORY = WARP_COUNT * HISTOGRAM_BIN_COUNT;
constexpr unsigned int REDUCE_BLOCK_SIZE = 256U;
constexpr unsigned int PARTIAL_HISTOGRAM_COUNT = 240U;
constexpr unsigned int FIXED_INPUT_BYTE_COUNT = 32U * 1024U * 1024U;
constexpr unsigned int FIXED_RUN_COUNT = 16U;
constexpr unsigned int FIXED_SEED = 2009U;

struct HostBuffers {
    unsigned char *inputBytes = nullptr;
    unsigned int *expectedHistogram = nullptr;
    unsigned int *actualHistogram = nullptr;
};

struct DeviceBuffers {
    unsigned int *inputWords = nullptr;
    unsigned int *finalHistogram = nullptr;
    unsigned int *partialHistogram = nullptr;
    aclrtStream stream = nullptr;
};

constexpr unsigned int fused_unsigned_mul_add(unsigned int lhs, unsigned int rhs, unsigned int offset)
{
    return lhs * rhs + offset;
}

bool report_acl_failure(aclError status, const char *callText, const char *filePath, int lineNumber)
{
    if (status == ACL_SUCCESS) {
        return true;
    }

    std::fprintf(stderr, "%s failed at %s:%d with error code %d\n", callText, filePath, lineNumber, static_cast<int>(status));
    return false;
}

bool report_launch_failure(const char *kernelName)
{
    const aclError status = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (status == ACL_SUCCESS) {
        return true;
    }

    std::fprintf(stderr, "%s launch failed with error code %d\n", kernelName, static_cast<int>(status));
    return false;
}

void compute_histogram_cpu(unsigned int *histogramOut, const void *byteData, unsigned int byteCount)
{
    for (unsigned int binIndex = 0; binIndex < HISTOGRAM_BIN_COUNT; ++binIndex) {
        histogramOut[binIndex] = 0;
    }

    assert(sizeof(unsigned int) == 4 && (byteCount % sizeof(unsigned int)) == 0);

    const unsigned int *packedWords = static_cast<const unsigned int *>(byteData);
    const unsigned int wordCount = byteCount / sizeof(unsigned int);

    for (unsigned int tid = 0; tid < wordCount; ++tid) {
        const unsigned int packedWord = packedWords[tid];
        histogramOut[(packedWord >> 0) & 0xFFU]++;
        histogramOut[(packedWord >> 8) & 0xFFU]++;
        histogramOut[(packedWord >> 16) & 0xFFU]++;
        histogramOut[(packedWord >> 24) & 0xFFU]++;
    }
}

void seed_input_bytes(unsigned char *bytes, unsigned int byteCount, unsigned int seed)
{
    std::srand(static_cast<int>(seed));
    for (unsigned int byteIndex = 0; byteIndex < byteCount; ++byteIndex) {
        bytes[byteIndex] = static_cast<unsigned char>(std::rand() % HISTOGRAM_BIN_COUNT);
    }
}

bool histograms_match(const unsigned int *lhs, const unsigned int *rhs, unsigned int *mismatchBin)
{
    for (unsigned int binIndex = 0; binIndex < HISTOGRAM_BIN_COUNT; ++binIndex) {
        if (lhs[binIndex] != rhs[binIndex]) {
            if (mismatchBin != nullptr) {
                *mismatchBin = binIndex;
            }
            return false;
        }
    }
    return true;
}

__global__ void accumulate_block_local_histogram(unsigned int *partialHistogram, const unsigned int *inputWords, unsigned int wordCount)
{
    __ubuf__ unsigned int sMemHistogram[HISTOGRAM_TEMP_MEMORY];
    __ubuf__ unsigned int *warpHistogram;
    warpHistogram = sMemHistogram + (threadIdx.x >> WARP_SHIFT) * HISTOGRAM_BIN_COUNT;

#pragma unroll
    for (unsigned int chunkIndex = 0; chunkIndex < (HISTOGRAM_TEMP_MEMORY / THREADS_PER_BLOCK); ++chunkIndex) {
        sMemHistogram[threadIdx.x + chunkIndex * THREADS_PER_BLOCK] = 0;
    }
    asc_syncthreads();
    for (unsigned int tid = fused_unsigned_mul_add(blockIdx.x, blockDim.x, threadIdx.x); tid < wordCount;
        tid += blockDim.x * gridDim.x) {
        const uint packedWord = inputWords[tid];
        asc_atomic_add(warpHistogram + ((packedWord >> 0) & 0xFFU), 1U);
        asc_atomic_add(warpHistogram + ((packedWord >> 8) & 0xFFU), 1U);
        asc_atomic_add(warpHistogram + ((packedWord >> 16) & 0xFFU), 1U);
        asc_atomic_add(warpHistogram + ((packedWord >> 24) & 0xFFU), 1U);
    }
    asc_syncthreads();
    for (unsigned int binIndex = threadIdx.x; binIndex < HISTOGRAM_BIN_COUNT; binIndex += THREADS_PER_BLOCK) {
        unsigned int binSum = 0;
        for (uint warpIndex = 0; warpIndex < WARP_COUNT; ++warpIndex) {
            binSum += sMemHistogram[binIndex + warpIndex * HISTOGRAM_BIN_COUNT];
        }
        partialHistogram[blockIdx.x * HISTOGRAM_BIN_COUNT + binIndex] = binSum;
    }
}

__global__ void merge_block_local_histogram(unsigned int *finalHistogram, const unsigned int *partialHistogram, unsigned int partialCount)
{
    __ubuf__ unsigned int hisBinsReduction[REDUCE_BLOCK_SIZE];
    unsigned int binAccumulator = 0;
    for (unsigned int partialIndex = threadIdx.x; partialIndex < partialCount; partialIndex += REDUCE_BLOCK_SIZE) {
        binAccumulator += partialHistogram[blockIdx.x + partialIndex * HISTOGRAM_BIN_COUNT];
    }
    hisBinsReduction[threadIdx.x] = binAccumulator;
    for (unsigned int stride = REDUCE_BLOCK_SIZE / 2; stride > 0; stride >>= 1) {
        asc_syncthreads();
        if (threadIdx.x < stride) {
            hisBinsReduction[threadIdx.x] += hisBinsReduction[threadIdx.x + stride];
        }
    }

    if (threadIdx.x == 0) {
        finalHistogram[blockIdx.x] = hisBinsReduction[0];
    }
}

void release_host_buffers(HostBuffers *host)
{
    std::free(host->inputBytes);
    std::free(host->expectedHistogram);
    std::free(host->actualHistogram);
    host->inputBytes = nullptr;
    host->expectedHistogram = nullptr;
    host->actualHistogram = nullptr;
}

void release_device_buffers(DeviceBuffers *device)
{
    if (device->partialHistogram != nullptr) {
        (void)aclrtFree(device->partialHistogram);
        device->partialHistogram = nullptr;
    }
    if (device->finalHistogram != nullptr) {
        (void)aclrtFree(device->finalHistogram);
        device->finalHistogram = nullptr;
    }
    if (device->inputWords != nullptr) {
        (void)aclrtFree(device->inputWords);
        device->inputWords = nullptr;
    }
    if (device->stream != nullptr) {
        (void)aclrtDestroyStream(device->stream);
        device->stream = nullptr;
    }
}

bool allocate_host_buffers(HostBuffers *host)
{
    host->inputBytes = static_cast<unsigned char *>(std::malloc(FIXED_INPUT_BYTE_COUNT));
    host->expectedHistogram = static_cast<unsigned int *>(std::malloc(HISTOGRAM_BIN_COUNT * sizeof(unsigned int)));
    host->actualHistogram = static_cast<unsigned int *>(std::malloc(HISTOGRAM_BIN_COUNT * sizeof(unsigned int)));

    if (host->inputBytes != nullptr && host->expectedHistogram != nullptr && host->actualHistogram != nullptr) {
        return true;
    }

    std::fprintf(stderr, "host memory allocation failed\n");
    release_host_buffers(host);
    return false;
}

void shutdown_acl_runtime()
{
    (void)aclrtResetDevice(0);
    (void)aclFinalize();
}

bool allocate_device_buffers(DeviceBuffers *device)
{
    return report_acl_failure(aclrtCreateStream(&device->stream), "aclrtCreateStream(&device->stream)", __FILE__, __LINE__) &&
           report_acl_failure(aclrtMalloc(reinterpret_cast<void **>(&device->inputWords),
                                         FIXED_INPUT_BYTE_COUNT,
                                         ACL_MEM_MALLOC_HUGE_FIRST),
                             "aclrtMalloc(device->inputWords)",
                             __FILE__,
                             __LINE__) &&
           report_acl_failure(aclrtMalloc(reinterpret_cast<void **>(&device->finalHistogram),
                                         HISTOGRAM_BIN_COUNT * sizeof(unsigned int),
                                         ACL_MEM_MALLOC_HUGE_FIRST),
                             "aclrtMalloc(device->finalHistogram)",
                             __FILE__,
                             __LINE__) &&
           report_acl_failure(aclrtMalloc(reinterpret_cast<void **>(&device->partialHistogram),
                                         PARTIAL_HISTOGRAM_COUNT * HISTOGRAM_BIN_COUNT * sizeof(unsigned int),
                                         ACL_MEM_MALLOC_HUGE_FIRST),
                             "aclrtMalloc(device->partialHistogram)",
                             __FILE__,
                             __LINE__);
}

bool launch_histogram_pipeline(const DeviceBuffers &device)
{
    const unsigned int wordCount = FIXED_INPUT_BYTE_COUNT / sizeof(unsigned int);
    const unsigned int dynamicUbufSize = 0;

    accumulate_block_local_histogram<<<dim3(PARTIAL_HISTOGRAM_COUNT), dim3(THREADS_PER_BLOCK), dynamicUbufSize, device.stream>>>(
        device.partialHistogram,
        device.inputWords,
        wordCount);
    if (!report_launch_failure("accumulate_block_local_histogram")) {
        return false;
    }

    merge_block_local_histogram<<<dim3(HISTOGRAM_BIN_COUNT), dim3(REDUCE_BLOCK_SIZE), dynamicUbufSize, device.stream>>>(
        device.finalHistogram,
        device.partialHistogram,
        PARTIAL_HISTOGRAM_COUNT);
    return report_launch_failure("merge_block_local_histogram");
}

void compute_histogram_npu(const DeviceBuffers &device, double *elapsedSeconds)
{
    const auto beginTime = std::chrono::steady_clock::now();
    for (unsigned int runIndex = 0; runIndex < FIXED_RUN_COUNT; ++runIndex) {
        launch_histogram_pipeline(device);
    }
    aclrtSynchronizeStream(device.stream);
    const auto endTime = std::chrono::steady_clock::now();
    *elapsedSeconds =
        std::chrono::duration_cast<std::chrono::duration<double>>(endTime - beginTime).count() / static_cast<double>(FIXED_RUN_COUNT);
}

int main()
{
    static_assert((FIXED_INPUT_BYTE_COUNT % 4) == 0, "FIXED_INPUT_BYTE_COUNT must be 4 Byte assign");
    HostBuffers host;
    if (!allocate_host_buffers(&host)) {
        return EXIT_FAILURE;
    }
    seed_input_bytes(host.inputBytes, FIXED_INPUT_BYTE_COUNT, FIXED_SEED);
    compute_histogram_cpu(host.expectedHistogram, host.inputBytes, FIXED_INPUT_BYTE_COUNT);
    aclInit(nullptr);
    aclrtSetDevice(0);
    DeviceBuffers device;
    if (!allocate_device_buffers(&device)) {
        release_device_buffers(&device);
        shutdown_acl_runtime();
        release_host_buffers(&host);
        return EXIT_FAILURE;
    }
    aclrtMemcpy(device.inputWords,
                FIXED_INPUT_BYTE_COUNT,
                host.inputBytes,
                FIXED_INPUT_BYTE_COUNT,
                ACL_MEMCPY_HOST_TO_DEVICE);

    std::printf("Running histogram256 on Ascend C SIMT for fixed %u bytes (%u runs)\n", FIXED_INPUT_BYTE_COUNT, FIXED_RUN_COUNT);
    double elapsedSeconds = 0.0;
    compute_histogram_npu(device, &elapsedSeconds);
    aclrtMemcpy(host.actualHistogram,
                HISTOGRAM_BIN_COUNT * sizeof(unsigned int),
                device.finalHistogram,
                HISTOGRAM_BIN_COUNT * sizeof(unsigned int),
                ACL_MEMCPY_DEVICE_TO_HOST);

    const double throughputMBs = (static_cast<double>(FIXED_INPUT_BYTE_COUNT) / 1.0e6) / elapsedSeconds;

    unsigned int mismatchBin = 0;
    const bool matched = histograms_match(host.actualHistogram, host.expectedHistogram, &mismatchBin);

    std::printf("histogram256 average time: %.6f sec, throughput: %.3f MB/s\n", elapsedSeconds, throughputMBs);
    if (matched) {
        std::printf("Validation passed\n");
    } else {
        std::fprintf(stderr,
                     "Validation failed at bin %u: device=%u cpu=%u\n",
                     mismatchBin,
                     host.actualHistogram[mismatchBin],
                     host.expectedHistogram[mismatchBin]);
    }
    release_device_buffers(&device);
    shutdown_acl_runtime();
    release_host_buffers(&host);
    return matched ? EXIT_SUCCESS : EXIT_FAILURE;
}
