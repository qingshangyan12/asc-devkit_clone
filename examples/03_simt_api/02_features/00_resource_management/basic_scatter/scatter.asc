/* !
 * \file scatter.asc
 * \brief
 */

#include <algorithm>
#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

namespace {
    constexpr uint32_t MAX_THREAD_COUNT = 2048;
    constexpr uint32_t MAX_BLOCK_COUNT = 65535;
    constexpr uint32_t MAX_RANK = 8;
}

template <typename type_data, typename type_idx>
__global__ __launch_bounds__(MAX_THREAD_COUNT) void scatter_custom(
    type_data* output,
    type_idx* index,
    type_data* src,
    uint32_t* input_shape,
    uint32_t* index_stride,
    uint32_t* output_stride,
    uint32_t rank,
    uint32_t dim,
    uint32_t index_total_length)
{
    uint32_t begin = blockIdx.x * blockDim.x + threadIdx.x;
    uint32_t stride = gridDim.x * blockDim.x;

    for (uint32_t i = begin; i < index_total_length; i += stride) {
        uint32_t remain = i;
        uint32_t output_offset = 0;
        bool valid = true;

        for (uint32_t axis = 0; axis < MAX_RANK; axis++) {
            if (axis >= rank) {
                break;
            }

            uint32_t coord = remain / index_stride[axis];
            remain -= coord * index_stride[axis];

            uint32_t output_coord = coord;
            if (axis == dim) {
                type_idx scatter_index = index[i];
                if (scatter_index < 0 || scatter_index >= static_cast<type_idx>(input_shape[dim])) {
                    valid = false;
                    break;
                }
                output_coord = static_cast<uint32_t>(scatter_index);
            }
            output_offset += output_coord * output_stride[axis];
        }

        if (valid) {
            output[output_offset] = src[i];
        }
    }
}

uint32_t compute_shape_size(const std::vector<uint32_t>& shape)
{
    uint32_t total_size = 1;
    for (uint32_t dim : shape) {
        total_size *= dim;
    }
    return total_size;
}

std::vector<uint32_t> compute_contiguous_stride(const std::vector<uint32_t>& shape)
{
    std::vector<uint32_t> stride(shape.size(), 1);
    for (int32_t i = static_cast<int32_t>(shape.size()) - 2; i >= 0; i--) {
        stride[i] = stride[i + 1] * shape[i + 1];
    }
    return stride;
}

bool block_split(uint32_t index_total_length, uint32_t &numBlocks, uint32_t &thread_num_per_block)
{
    const auto& platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformInfoMgr == nullptr) {
        std::cout << "[ERROR] Get platform info failed, please check device status." << std::endl;
        return false;
    }

    uint32_t real_core_num = platformInfoMgr->GetCoreNumAiv();
    thread_num_per_block = std::min(index_total_length, MAX_THREAD_COUNT);
    numBlocks = (index_total_length + thread_num_per_block - 1) / thread_num_per_block;
    if (numBlocks > real_core_num) {
        numBlocks = real_core_num;
        thread_num_per_block = MAX_THREAD_COUNT;
    }
    if (numBlocks > MAX_BLOCK_COUNT) {
        std::cout << "[ERROR] index_total_length: " << index_total_length << " can not be bigger than "
                  << MAX_THREAD_COUNT * MAX_BLOCK_COUNT << "." << std::endl;
        return false;
    }
    return true;
}

template <typename type_idx>
bool check_scatter_params(
    const std::vector<float>& input,
    const std::vector<uint32_t>& input_shape,
    uint32_t dim,
    const std::vector<type_idx>& index,
    const std::vector<uint32_t>& index_shape,
    const std::vector<float>& src,
    const std::vector<uint32_t>& src_shape)
{
    if (input.empty() || index.empty() || src.empty()) {
        std::cout << "[ERROR] Empty input tensors." << std::endl;
        return false;
    }
    if (input_shape.empty() || input_shape.size() > MAX_RANK) {
        std::cout << "[ERROR] input rank must be in [1, " << MAX_RANK << "]." << std::endl;
        return false;
    }
    if (dim >= input_shape.size()) {
        std::cout << "[ERROR] dim must be less than input rank." << std::endl;
        return false;
    }
    if (index_shape != src_shape || index_shape.size() != input_shape.size()) {
        std::cout << "[ERROR] index and src must have same rank and same shape." << std::endl;
        return false;
    }
    if (compute_shape_size(input_shape) != input.size()) {
        std::cout << "[ERROR] Input data size does not match input shape." << std::endl;
        return false;
    }
    if (compute_shape_size(index_shape) != index.size() || src.size() != index.size()) {
        std::cout << "[ERROR] index/src data size does not match shape." << std::endl;
        return false;
    }
    for (uint32_t axis = 0; axis < input_shape.size(); axis++) {
        if (axis != dim && index_shape[axis] > input_shape[axis]) {
            std::cout << "[ERROR] index shape must not exceed input shape except on dim." << std::endl;
            return false;
        }
    }
    for (type_idx value : index) {
        if (value < 0 || value >= static_cast<type_idx>(input_shape[dim])) {
            std::cout << "[ERROR] index value is out of range for dim." << std::endl;
            return false;
        }
    }
    return true;
}

std::vector<float> scatter(
    std::vector<float>& input,
    const std::vector<uint32_t>& input_shape,
    uint32_t dim,
    std::vector<int32_t>& index,
    const std::vector<uint32_t>& index_shape,
    std::vector<float>& src,
    const std::vector<uint32_t>& src_shape)
{
    if (!check_scatter_params(input, input_shape, dim, index, index_shape, src, src_shape)) {
        return {};
    }

    uint32_t rank = input_shape.size();
    uint32_t input_total_length = input.size();
    uint32_t index_total_length = index.size();
    std::vector<uint32_t> index_stride = compute_contiguous_stride(index_shape);
    std::vector<uint32_t> output_stride = compute_contiguous_stride(input_shape);

    uint32_t numBlocks = 0;
    uint32_t thread_num_per_block = 0;
    if (!block_split(index_total_length, numBlocks, thread_num_per_block)) {
        return {};
    }
    std::cout << "[INFO] Block number is " << numBlocks << "." << std::endl;
    std::cout << "[INFO] Thread number in a block is " << thread_num_per_block << "." << std::endl;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t *>(input.data());
    uint8_t* index_host = reinterpret_cast<uint8_t *>(index.data());
    uint8_t* src_host = reinterpret_cast<uint8_t *>(src.data());
    uint8_t* input_shape_host = reinterpret_cast<uint8_t *>(const_cast<uint32_t *>(input_shape.data()));
    uint8_t* index_stride_host = reinterpret_cast<uint8_t *>(index_stride.data());
    uint8_t* output_stride_host = reinterpret_cast<uint8_t *>(output_stride.data());

    float* output_device = nullptr;
    int32_t* index_device = nullptr;
    float* src_device = nullptr;
    uint32_t* input_shape_device = nullptr;
    uint32_t* index_stride_device = nullptr;
    uint32_t* output_stride_device = nullptr;
    uint8_t* output_host = nullptr;

    size_t input_total_byte_size = input_total_length * sizeof(float);
    size_t index_total_byte_size = index_total_length * sizeof(int32_t);
    size_t src_total_byte_size = src.size() * sizeof(float);
    size_t shape_byte_size = rank * sizeof(uint32_t);

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)(&output_host), input_total_byte_size);
    aclrtMalloc((void **)&output_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&index_device, index_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&src_device, src_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&input_shape_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&index_stride_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&output_stride_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(output_device, input_total_byte_size, input_host, input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(index_device, index_total_byte_size, index_host, index_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src_device, src_total_byte_size, src_host, src_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input_shape_device, shape_byte_size, input_shape_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(index_stride_device, shape_byte_size, index_stride_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_stride_device, shape_byte_size, output_stride_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;
    scatter_custom<<<numBlocks, thread_num_per_block, dyn_ubuf_size, stream>>>(
        output_device, index_device, src_device, input_shape_device, index_stride_device,
        output_stride_device, rank, dim, index_total_length);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host, input_total_byte_size, output_device, input_total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output((float *)output_host, (float *)(output_host + input_total_byte_size));

    aclrtFree(output_device);
    aclrtFree(index_device);
    aclrtFree(src_device);
    aclrtFree(input_shape_device);
    aclrtFree(index_stride_device);
    aclrtFree(output_stride_device);
    aclrtFreeHost(output_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

std::vector<float> scatter_golden(
    const std::vector<float>& input,
    const std::vector<uint32_t>& input_shape,
    uint32_t dim,
    const std::vector<int32_t>& index,
    const std::vector<uint32_t>& index_shape,
    const std::vector<float>& src)
{
    std::vector<float> golden = input;
    std::vector<uint32_t> index_stride = compute_contiguous_stride(index_shape);
    std::vector<uint32_t> output_stride = compute_contiguous_stride(input_shape);
    uint32_t rank = input_shape.size();
    uint32_t index_total_length = index.size();

    for (uint32_t i = 0; i < index_total_length; i++) {
        uint32_t remain = i;
        uint32_t output_offset = 0;
        for (uint32_t axis = 0; axis < rank; axis++) {
            uint32_t coord = remain / index_stride[axis];
            remain -= coord * index_stride[axis];
            uint32_t output_coord = (axis == dim) ? static_cast<uint32_t>(index[i]) : coord;
            output_offset += output_coord * output_stride[axis];
        }
        golden[output_offset] = src[i];
    }
    return golden;
}

int32_t main(int32_t argc, char* argv[])
{
    {
        const std::vector<uint32_t> input_shape = {3, 5};
        const std::vector<uint32_t> index_shape = {2, 5};
        const std::vector<uint32_t> src_shape = index_shape;
        constexpr uint32_t dim = 0;

        std::vector<float> input(compute_shape_size(input_shape), 0.0f);
        std::vector<int32_t> index = {
            0, 1, 2, 0, 0,
            2, 0, 0, 1, 2
        };
        std::vector<float> src = {
            1.0f, 2.0f, 3.0f, 4.0f, 5.0f,
            6.0f, 7.0f, 8.0f, 9.0f, 10.0f
        };

        std::vector<float> golden = scatter_golden(input, input_shape, dim, index, index_shape, src);
        std::vector<float> output = scatter(input, input_shape, dim, index, index_shape, src, src_shape);
        if (output.empty() || verify_result(output, golden) != 0) {
            return 1;
        }
    }

    {
        const std::vector<uint32_t> input_shape = {2, 4};
        const std::vector<uint32_t> index_shape = {2, 2};
        const std::vector<uint32_t> src_shape = index_shape;
        constexpr uint32_t dim = 1;

        std::vector<float> input(compute_shape_size(input_shape), 0.0f);
        std::vector<int32_t> index = {
            2, 0,
            3, 1
        };
        std::vector<float> src = {
            1.23f, 2.34f,
            3.45f, 4.56f
        };

        std::vector<float> golden = scatter_golden(input, input_shape, dim, index, index_shape, src);
        std::vector<float> output = scatter(input, input_shape, dim, index, index_shape, src, src_shape);
        if (output.empty() || verify_result(output, golden) != 0) {
            return 1;
        }
    }

    return 0;
}
