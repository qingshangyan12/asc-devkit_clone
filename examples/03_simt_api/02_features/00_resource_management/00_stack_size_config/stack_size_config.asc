/* !
 * \file stack_size_config.asc
 * \brief Demonstrates configuring SIMT stack size through aclInit config.
 */

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <iterator>
#include <string>
#include <vector>
#include "acl/acl.h"

constexpr uint32_t THREAD_COUNT = 128;
constexpr uint32_t OUTPUT_LENGTH = 128;
constexpr uint32_t STACK_FLOAT_COUNT = 2048;
constexpr uint32_t STACK_SAMPLE_STRIDE = 256;
constexpr float STACK_VALUE_SCALE = 0.001f;
constexpr float VERIFY_EPSILON = 1e-3f;
constexpr const char* DEFAULT_STACK_CONFIG_PATH = "acl_stack_config.json";

__global__ __launch_bounds__(THREAD_COUNT) void stack_size_kernel(float* input, float* output, uint32_t total_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }

    volatile float thread_stack[STACK_FLOAT_COUNT];
    float base_value = input[idx];
    for (uint32_t i = 0; i < STACK_FLOAT_COUNT; ++i) {
        thread_stack[i] = base_value + static_cast<float>(i) * STACK_VALUE_SCALE;
    }

    float sum = 0.0f;
    for (uint32_t i = 0; i < STACK_FLOAT_COUNT; i += STACK_SAMPLE_STRIDE) {
        sum += thread_stack[i];
    }
    output[idx] = sum;
}

bool CheckAcl(aclError ret, const char* expr)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::cerr << "[ERROR] " << expr << " failed, error code is " << ret << "." << std::endl;
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        std::cerr << err << std::endl;
    }
    return false;
}

struct SampleResult {
    bool success;
    std::vector<float> output;
};

SampleResult RunStackSizeSample(std::vector<float>& input, const char* config_path)
{
    if (input.empty()) {
        std::cout << "[ERROR] Empty input tensor." << std::endl;
        return {false, {}};
    }

    uint32_t total_length = input.size();
    size_t total_byte_size = total_length * sizeof(float);

    uint32_t threads_per_block = THREAD_COUNT;
    uint32_t blocks_per_grid = (total_length + threads_per_block - 1) / threads_per_block;
    uint32_t dyn_ubuf_size = 0;

    if (config_path == nullptr) {
        std::cout << "[INFO] ACL config file is nullptr." << std::endl;
    } else {
        std::cout << "[INFO] ACL config file is " << config_path << "." << std::endl;
    }
    std::cout << "[INFO] Block number is " << blocks_per_grid << "." << std::endl;
    std::cout << "[INFO] Thread number in a block is " << threads_per_block << "." << std::endl;
    std::cout << "[INFO] Per-thread local stack array bytes are "
              << STACK_FLOAT_COUNT * sizeof(float) << "." << std::endl;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint8_t* output_host = nullptr;
    float* input_device = nullptr;
    float* output_device = nullptr;
    bool initialized = false;
    bool device_set = false;
    bool stream_created = false;
    SampleResult result = {false, {}};

    if (!CheckAcl(aclInit(config_path), "aclInit")) {
        return result;
    }
    initialized = true;
    if (!CheckAcl(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    stream_created = true;

    if (!CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&output_host), total_byte_size), "aclrtMallocHost")) {
        goto cleanup;
    }
    if (!CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&input_device), total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc(input_device)")) {
        goto cleanup;
    }
    if (!CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&output_device), total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc(output_device)")) {
        goto cleanup;
    }
    if (!CheckAcl(aclrtMemcpy(input_device, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE),
                  "aclrtMemcpy(input_device)")) {
        goto cleanup;
    }

    stack_size_kernel<<<blocks_per_grid, threads_per_block, dyn_ubuf_size, stream>>>(
        input_device, output_device, total_length);

    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        goto cleanup;
    }
    if (!CheckAcl(aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST),
                  "aclrtMemcpy(output_host)")) {
        goto cleanup;
    }
    result.output.assign(reinterpret_cast<float*>(output_host), reinterpret_cast<float*>(output_host + total_byte_size));
    result.success = true;

cleanup:
    if (input_device != nullptr) {
        aclrtFree(input_device);
    }
    if (output_device != nullptr) {
        aclrtFree(output_device);
    }
    if (output_host != nullptr) {
        aclrtFreeHost(output_host);
    }
    if (stream_created) {
        aclrtDestroyStream(stream);
    }
    if (device_set) {
        aclrtResetDevice(device_id);
    }
    if (initialized) {
        aclFinalize();
    }
    return result;
}

std::vector<float> BuildGolden(std::vector<float>& input)
{
    std::vector<float> golden(input.size(), 0.0f);
    for (uint32_t idx = 0; idx < input.size(); ++idx) {
        float sum = 0.0f;
        for (uint32_t i = 0; i < STACK_FLOAT_COUNT; i += STACK_SAMPLE_STRIDE) {
            sum += input[idx] + static_cast<float>(i) * STACK_VALUE_SCALE;
        }
        golden[idx] = sum;
    }
    return golden;
}

uint32_t VerifyResult(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 8;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
                  std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };

    print_tensor(output, "Output");
    print_tensor(golden, "Golden");

    if (output.size() != golden.size()) {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    for (uint32_t i = 0; i < output.size(); ++i) {
        if (std::fabs(output[i] - golden[i]) > VERIFY_EPSILON) {
            std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
            return 1;
        }
    }

    std::cout << "[Success] Case accuracy is verification passed." << std::endl;
    return 0;
}

std::vector<float> BuildInput()
{
    std::vector<float> input(OUTPUT_LENGTH);
    for (uint32_t i = 0; i < OUTPUT_LENGTH; ++i) {
        input[i] = static_cast<float>(i) * 0.25f;
    }
    return input;
}

int32_t RunCase1WithoutStackConfig()
{
    std::cout << "========== Case 1: without SIMT stack size config ==========" << std::endl;
    std::cout << "[INFO] This case is expected to report a stack overflow or runtime launch failure." << std::endl;
    std::vector<float> input = BuildInput();
    SampleResult result = RunStackSizeSample(input, nullptr);
    if (!result.success) {
        std::cout << "[Success] Case1 reproduced the expected stack-size failure." << std::endl;
        return 0;
    }

    std::cout << "[Failed] Case1 unexpectedly passed without SIMT stack size config." << std::endl;
    return 1;
}

int32_t RunCase2WithStackConfig(const char* config_path)
{
    std::cout << "========== Case 2: with SIMT stack size config ==========" << std::endl;
    std::vector<float> input = BuildInput();
    std::vector<float> golden = BuildGolden(input);
    SampleResult result = RunStackSizeSample(input, config_path);
    if (!result.success) {
        return 1;
    }
    return VerifyResult(result.output, golden);
}

void PrintUsage(const char* program_path)
{
    std::cout << "Usage:" << std::endl;
    std::cout << "  " << program_path << "                         Run case2 with SIMT stack config." << std::endl;
    std::cout << "  " << program_path << " --case1                 Run without SIMT stack config." << std::endl;
    std::cout << "  " << program_path << " --case2 [config_path]   Run with SIMT stack config." << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc == 1) {
        return RunCase2WithStackConfig(DEFAULT_STACK_CONFIG_PATH);
    }

    std::string mode = argv[1];
    if (mode == "--case1") {
        return RunCase1WithoutStackConfig();
    }
    if (mode == "--case2") {
        const char* config_path = (argc > 2) ? argv[2] : DEFAULT_STACK_CONFIG_PATH;
        return RunCase2WithStackConfig(config_path);
    }
    if (mode == "--help" || mode == "-h") {
        PrintUsage(argv[0]);
        return 0;
    }

    return RunCase2WithStackConfig(argv[1]);
}
