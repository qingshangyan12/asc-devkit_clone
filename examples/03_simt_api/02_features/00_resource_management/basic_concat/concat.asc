/* !
 * \file concat.asc
 * \brief
 */

#include <algorithm>
#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

namespace {
    constexpr uint32_t MAX_THREAD_COUNT = 2048;
    constexpr uint32_t MAX_BLOCK_COUNT = 65535;
    constexpr uint32_t MAX_RANK = 8;
}

template <typename type_data>
__global__ __launch_bounds__(MAX_THREAD_COUNT) void concat_custom(
    type_data* input0,
    type_data* input1,
    type_data* output,
    uint32_t* input0_shape,
    uint32_t* input0_stride,
    uint32_t* input1_stride,
    uint32_t* output_stride,
    uint32_t rank,
    uint32_t dim,
    uint32_t output_total_length)
{
    uint32_t begin = blockIdx.x * blockDim.x + threadIdx.x;
    uint32_t stride = gridDim.x * blockDim.x;

    for (uint32_t i = begin; i < output_total_length; i += stride) {
        uint32_t remain = i;
        uint32_t coord[MAX_RANK] = {0};
        uint32_t input_offset = 0;
        bool select_input1 = false;

        for (uint32_t axis = 0; axis < MAX_RANK; axis++) {
            if (axis >= rank) {
                break;
            }

            coord[axis] = remain / output_stride[axis];
            remain -= coord[axis] * output_stride[axis];

            if (axis == dim && coord[axis] >= input0_shape[dim]) {
                select_input1 = true;
                coord[axis] -= input0_shape[dim];
            }
        }

        for (uint32_t axis = 0; axis < MAX_RANK; axis++) {
            if (axis >= rank) {
                break;
            }
            input_offset += coord[axis] * (select_input1 ? input1_stride[axis] : input0_stride[axis]);
        }

        output[i] = select_input1 ? input1[input_offset] : input0[input_offset];
    }
}

uint32_t compute_shape_size(const std::vector<uint32_t>& shape)
{
    uint32_t total_size = 1;
    for (uint32_t dim : shape) {
        total_size *= dim;
    }
    return total_size;
}

std::vector<uint32_t> compute_contiguous_stride(const std::vector<uint32_t>& shape)
{
    std::vector<uint32_t> stride(shape.size(), 1);
    for (int32_t i = static_cast<int32_t>(shape.size()) - 2; i >= 0; i--) {
        stride[i] = stride[i + 1] * shape[i + 1];
    }
    return stride;
}

bool block_split(uint32_t output_total_length, uint32_t &numBlocks, uint32_t &thread_num_per_block)
{
    const auto& platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformInfoMgr == nullptr) {
        std::cout << "[ERROR] Get platform info failed, please check device status." << std::endl;
        return false;
    }

    uint32_t real_core_num = platformInfoMgr->GetCoreNumAiv();
    thread_num_per_block = std::min(output_total_length, MAX_THREAD_COUNT);
    numBlocks = (output_total_length + thread_num_per_block - 1) / thread_num_per_block;
    if (numBlocks > real_core_num) {
        numBlocks = real_core_num;
        thread_num_per_block = MAX_THREAD_COUNT;
    }
    if (numBlocks > MAX_BLOCK_COUNT) {
        std::cout << "[ERROR] output_total_length: " << output_total_length << " can not be bigger than "
                  << MAX_THREAD_COUNT * MAX_BLOCK_COUNT << "." << std::endl;
        return false;
    }
    return true;
}

bool check_concat_params(
    const std::vector<float>& input0,
    const std::vector<uint32_t>& input0_shape,
    const std::vector<float>& input1,
    const std::vector<uint32_t>& input1_shape,
    uint32_t dim)
{
    if (input0.empty() || input1.empty()) {
        std::cout << "[ERROR] Empty input tensors." << std::endl;
        return false;
    }
    if (input0_shape.empty() || input0_shape.size() > MAX_RANK || input0_shape.size() != input1_shape.size()) {
        std::cout << "[ERROR] input rank must be same and in [1, " << MAX_RANK << "]." << std::endl;
        return false;
    }
    if (dim >= input0_shape.size()) {
        std::cout << "[ERROR] dim must be less than input rank." << std::endl;
        return false;
    }
    if (compute_shape_size(input0_shape) != input0.size() || compute_shape_size(input1_shape) != input1.size()) {
        std::cout << "[ERROR] Input data size does not match input shape." << std::endl;
        return false;
    }
    for (uint32_t axis = 0; axis < input0_shape.size(); axis++) {
        if (axis != dim && input0_shape[axis] != input1_shape[axis]) {
            std::cout << "[ERROR] Input shapes must be same except on concat dim." << std::endl;
            return false;
        }
    }
    return true;
}

std::vector<float> concat(
    std::vector<float>& input0,
    const std::vector<uint32_t>& input0_shape,
    std::vector<float>& input1,
    const std::vector<uint32_t>& input1_shape,
    uint32_t dim)
{
    if (!check_concat_params(input0, input0_shape, input1, input1_shape, dim)) {
        return {};
    }

    std::vector<uint32_t> output_shape = input0_shape;
    output_shape[dim] += input1_shape[dim];

    uint32_t rank = input0_shape.size();
    uint32_t input0_total_length = input0.size();
    uint32_t input1_total_length = input1.size();
    uint32_t output_total_length = compute_shape_size(output_shape);

    std::vector<uint32_t> input0_stride = compute_contiguous_stride(input0_shape);
    std::vector<uint32_t> input1_stride = compute_contiguous_stride(input1_shape);
    std::vector<uint32_t> output_stride = compute_contiguous_stride(output_shape);

    uint32_t numBlocks = 0;
    uint32_t thread_num_per_block = 0;
    if (!block_split(output_total_length, numBlocks, thread_num_per_block)) {
        return {};
    }
    std::cout << "[INFO] Block number is " << numBlocks << "." << std::endl;
    std::cout << "[INFO] Thread number in a block is " << thread_num_per_block << "." << std::endl;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input0_host = reinterpret_cast<uint8_t *>(input0.data());
    uint8_t* input1_host = reinterpret_cast<uint8_t *>(input1.data());
    uint8_t* input0_shape_host = reinterpret_cast<uint8_t *>(const_cast<uint32_t *>(input0_shape.data()));
    uint8_t* input0_stride_host = reinterpret_cast<uint8_t *>(input0_stride.data());
    uint8_t* input1_stride_host = reinterpret_cast<uint8_t *>(input1_stride.data());
    uint8_t* output_stride_host = reinterpret_cast<uint8_t *>(output_stride.data());

    float* input0_device = nullptr;
    float* input1_device = nullptr;
    float* output_device = nullptr;
    uint32_t* input0_shape_device = nullptr;
    uint32_t* input0_stride_device = nullptr;
    uint32_t* input1_stride_device = nullptr;
    uint32_t* output_stride_device = nullptr;
    uint8_t* output_host = nullptr;

    size_t input0_total_byte_size = input0_total_length * sizeof(float);
    size_t input1_total_byte_size = input1_total_length * sizeof(float);
    size_t output_total_byte_size = output_total_length * sizeof(float);
    size_t shape_byte_size = rank * sizeof(uint32_t);

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)(&output_host), output_total_byte_size);
    aclrtMalloc((void **)&input0_device, input0_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&input1_device, input1_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&output_device, output_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&input0_shape_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&input0_stride_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&input1_stride_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&output_stride_device, shape_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input0_device, input0_total_byte_size, input0_host, input0_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input1_device, input1_total_byte_size, input1_host, input1_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input0_shape_device, shape_byte_size, input0_shape_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input0_stride_device, shape_byte_size, input0_stride_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input1_stride_device, shape_byte_size, input1_stride_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_stride_device, shape_byte_size, output_stride_host, shape_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;
    concat_custom<<<numBlocks, thread_num_per_block, dyn_ubuf_size, stream>>>(
        input0_device, input1_device, output_device, input0_shape_device, input0_stride_device,
        input1_stride_device, output_stride_device, rank, dim, output_total_length);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host, output_total_byte_size, output_device, output_total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output((float *)output_host, (float *)(output_host + output_total_byte_size));

    aclrtFree(input0_device);
    aclrtFree(input1_device);
    aclrtFree(output_device);
    aclrtFree(input0_shape_device);
    aclrtFree(input0_stride_device);
    aclrtFree(input1_stride_device);
    aclrtFree(output_stride_device);
    aclrtFreeHost(output_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

std::vector<float> concat_golden(
    const std::vector<float>& input0,
    const std::vector<uint32_t>& input0_shape,
    const std::vector<float>& input1,
    const std::vector<uint32_t>& input1_shape,
    uint32_t dim)
{
    std::vector<uint32_t> output_shape = input0_shape;
    output_shape[dim] += input1_shape[dim];

    std::vector<uint32_t> input0_stride = compute_contiguous_stride(input0_shape);
    std::vector<uint32_t> input1_stride = compute_contiguous_stride(input1_shape);
    std::vector<uint32_t> output_stride = compute_contiguous_stride(output_shape);
    std::vector<float> golden(compute_shape_size(output_shape));
    uint32_t rank = output_shape.size();

    for (uint32_t i = 0; i < golden.size(); i++) {
        uint32_t remain = i;
        uint32_t coord[MAX_RANK] = {0};
        uint32_t input_offset = 0;
        bool select_input1 = false;

        for (uint32_t axis = 0; axis < rank; axis++) {
            coord[axis] = remain / output_stride[axis];
            remain -= coord[axis] * output_stride[axis];
            if (axis == dim && coord[axis] >= input0_shape[dim]) {
                select_input1 = true;
                coord[axis] -= input0_shape[dim];
            }
        }

        for (uint32_t axis = 0; axis < rank; axis++) {
            input_offset += coord[axis] * (select_input1 ? input1_stride[axis] : input0_stride[axis]);
        }
        golden[i] = select_input1 ? input1[input_offset] : input0[input_offset];
    }
    return golden;
}

int32_t main(int32_t argc, char* argv[])
{
    {
        const std::vector<uint32_t> input0_shape = {2, 4};
        const std::vector<uint32_t> input1_shape = {3, 4};
        constexpr uint32_t dim = 0;

        std::vector<float> input0(compute_shape_size(input0_shape));
        std::vector<float> input1(compute_shape_size(input1_shape));
        for (uint32_t i = 0; i < input0.size(); i++) {
            input0[i] = i * 1.1f;
        }
        for (uint32_t i = 0; i < input1.size(); i++) {
            input1[i] = 100.0f + i * 1.2f;
        }

        std::vector<float> golden = concat_golden(input0, input0_shape, input1, input1_shape, dim);
        std::vector<float> output = concat(input0, input0_shape, input1, input1_shape, dim);
        if (output.empty() || verify_result(output, golden) != 0) {
            return 1;
        }
    }

    {
        const std::vector<uint32_t> input0_shape = {3, 2};
        const std::vector<uint32_t> input1_shape = {3, 4};
        constexpr uint32_t dim = 1;

        std::vector<float> input0(compute_shape_size(input0_shape));
        std::vector<float> input1(compute_shape_size(input1_shape));
        for (uint32_t i = 0; i < input0.size(); i++) {
            input0[i] = i * 1.3f;
        }
        for (uint32_t i = 0; i < input1.size(); i++) {
            input1[i] = 200.0f + i * 1.4f;
        }

        std::vector<float> golden = concat_golden(input0, input0_shape, input1, input1_shape, dim);
        std::vector<float> output = concat(input0, input0_shape, input1, input1_shape, dim);
        if (output.empty() || verify_result(output, golden) != 0) {
            return 1;
        }
    }

    return 0;
}
