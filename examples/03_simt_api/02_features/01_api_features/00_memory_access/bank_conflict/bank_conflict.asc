/* !
 * \file bank_conflict.asc
 * \brief SIMT UB subbank conflict sample.
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "asc_printf.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 3
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 5
#error "SCENARIO_NUM must be one of 0, 1, 2, 3, 4, 5."
#endif

namespace {
constexpr uint32_t THREAD_COUNT = 32;
constexpr uint32_t REPEAT_TIMES = 100000;
constexpr uint32_t UB_ELEMENT_COUNT = 4096;
constexpr uint32_t SAME_BANK_SUBBANK_STRIDE = 128;       // 128 float = 512B
constexpr uint32_t SAME_BANK_GROUP_SUBBANK_STRIDE = 64;  // 64 float = 256B
} // namespace

inline const char* get_case_name(uint32_t scenario_num)
{
    switch (scenario_num) {
        case 0:
            return "same_address_merge";
        case 1:
            return "same_8byte_row_merge";
        case 2:
            return "same_subbank_different_rows_two_addresses";
        case 3:
            return "cross_bank_subbank_baseline";
        case 4:
            return "same_bank_same_subbank_different_rows";
        case 5:
            return "same_bank_group_same_subbank";
        default:
            return "unknown";
    }
}

__aicore__ inline uint32_t get_ub_index_device(uint32_t lane_id)
{
#if SCENARIO_NUM == 0
    // All lanes read exactly the same UB address.
    return 0;
#elif SCENARIO_NUM == 1
    // ub[0] and ub[1] are two float elements in the same 8B subbank row.
    return lane_id & 1;
#elif SCENARIO_NUM == 2
    // ub[0] and ub[128] are in the same bank and subbank at different depths.
    return (lane_id & 1) * SAME_BANK_SUBBANK_STRIDE;
#elif SCENARIO_NUM == 3
    // 8B stride distributes 32 lanes to 8 bank groups x 4 subbanks.
    return lane_id * 2;
#elif SCENARIO_NUM == 4
    // 512B stride returns to the same bank and subbank at different depths.
    return lane_id * SAME_BANK_SUBBANK_STRIDE;
#elif SCENARIO_NUM == 5
    // 256B stride toggles bank inside the same bank group while keeping the same subbank id.
    return lane_id * SAME_BANK_GROUP_SUBBANK_STRIDE;
#else
    return lane_id;
#endif
}

inline uint32_t get_ub_index_host(uint32_t lane_id)
{
#if SCENARIO_NUM == 0
    return 0;
#elif SCENARIO_NUM == 1
    return lane_id & 1;
#elif SCENARIO_NUM == 2
    return (lane_id & 1) * SAME_BANK_SUBBANK_STRIDE;
#elif SCENARIO_NUM == 3
    return lane_id * 2;
#elif SCENARIO_NUM == 4
    return lane_id * SAME_BANK_SUBBANK_STRIDE;
#elif SCENARIO_NUM == 5
    return lane_id * SAME_BANK_GROUP_SUBBANK_STRIDE;
#else
    return lane_id;
#endif
}

__aicore__ inline float make_ub_value_device(uint32_t index)
{
    return 1.0f + static_cast<float>(index % 251) * 0.125f;
}

inline float make_ub_value_host(uint32_t index)
{
    return 1.0f + static_cast<float>(index % 251) * 0.125f;
}

__global__ __launch_bounds__(THREAD_COUNT) void bank_conflict_kernel(float* output, uint64_t* cycle_output)
{
    __ubuf__ float ub[UB_ELEMENT_COUNT];

    uint32_t tid = threadIdx.x;
    uint32_t lane_id = laneid();
    for (uint32_t i = tid; i < UB_ELEMENT_COUNT; i += blockDim.x) {
        ub[i] = make_ub_value_device(i);
    }
    asc_syncthreads();

    uint32_t ub_index = get_ub_index_device(lane_id);
    // Keep every loop iteration as a real UB load for clock-based measurement.
    __ubuf__ volatile float* ub_ptr = ub;
    float acc = 0.0f;

    uint64_t start = clock();
    for (uint32_t i = 0; i < REPEAT_TIMES; ++i) {
        acc += ub_ptr[ub_index];
    }
    uint64_t end = clock();

    output[tid] = acc;
    if (tid == 0) {
        cycle_output[0] = end - start;
        printf("case %u execute cycle : %lu\n", static_cast<uint32_t>(SCENARIO_NUM), end - start);
    }
}

uint32_t verify_result(const std::vector<float>& output)
{
    constexpr float rel_tolerance = 1e-4f;
    constexpr float abs_tolerance = 1e-2f;
    if (output.size() != THREAD_COUNT) {
        std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
        return 1;
    }

    for (uint32_t lane_id = 0; lane_id < THREAD_COUNT; ++lane_id) {
        uint32_t ub_index = get_ub_index_host(lane_id);
        float golden = 0.0f;
        float value = make_ub_value_host(ub_index);
        for (uint32_t i = 0; i < REPEAT_TIMES; ++i) {
            golden += value;
        }
        float abs_err = std::fabs(output[lane_id] - golden);
        float rel_err = abs_err / std::fabs(golden);
        if (abs_err > abs_tolerance && rel_err > rel_tolerance) {
            std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
            std::cout << "lane: " << lane_id << ", output: " << output[lane_id] << ", golden: " << golden
                      << std::endl;
            return 1;
        }
    }

    std::cout << "[Success] Case accuracy verification passed." << std::endl;
    return 0;
}

std::vector<float> launch_kernel(uint64_t& cycles)
{
    constexpr size_t output_byte_size = THREAD_COUNT * sizeof(float);
    constexpr size_t cycle_byte_size = sizeof(uint64_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    float* output_device = nullptr;
    uint64_t* cycle_device = nullptr;
    uint8_t* output_host = nullptr;
    uint8_t* cycle_host = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_byte_size);
    aclrtMallocHost(reinterpret_cast<void**>(&cycle_host), cycle_byte_size);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&cycle_device), cycle_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    bank_conflict_kernel<<<1, THREAD_COUNT, 0, stream>>>(output_device, cycle_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_byte_size, output_device, output_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(cycle_host, cycle_byte_size, cycle_device, cycle_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> output(
        reinterpret_cast<float*>(output_host), reinterpret_cast<float*>(output_host + output_byte_size));
    cycles = *reinterpret_cast<uint64_t*>(cycle_host);

    aclrtFree(output_device);
    aclrtFree(cycle_device);
    aclrtFreeHost(output_host);
    aclrtFreeHost(cycle_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        std::fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

int32_t main(int32_t argc, char** argv)
{
    constexpr uint32_t scenario_num = static_cast<uint32_t>(SCENARIO_NUM);
    std::printf("Usage: %s (compile-time SCENARIO_NUM=%u)\n", argv[0], scenario_num);
    std::printf("Running case %u: %s...\n", scenario_num, get_case_name(scenario_num));

    uint64_t cycles = 0;
    std::vector<float> output = launch_kernel(cycles);
    std::printf("Case %u total cycles: %lu\n", scenario_num, cycles);
    return verify_result(output);
}
