#include <cstdint>
#include <cstdio>
#include <set>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

using namespace cooperative_groups;

namespace {

constexpr int32_t BLOCKS_PER_GRID = 4;
constexpr int32_t THREADS_PER_BLOCK = 1024;
constexpr int32_t TILE_SIZE = 32;
constexpr int32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr int32_t WARPS_PER_BLOCK = THREADS_PER_BLOCK / TILE_SIZE;
constexpr int32_t EXPECTED_TOTAL = TOTAL_THREADS * (TOTAL_THREADS + 1) / 2;
constexpr uint32_t DYN_UBUF_SIZE = 0; // pure SIMT form, no dynamic ubuf

enum class CaseKind {
    GRID,  //case0
    BLOCK,   //case1
    TILE,   //case2
};

struct CaseConfig {
    CaseKind kind;  //case类型
    int32_t reduce_domain;  //规约线程数
    const char* name;  //描述信息
};
//测试结构体实例
CaseConfig get_case_config(const std::string& case_name)
{
    if (case_name == "0") {
        return {CaseKind::GRID, TOTAL_THREADS, "cross-block reduction (grid_group)"};
    }
    if (case_name == "1") {
        return {CaseKind::BLOCK, THREADS_PER_BLOCK, "whole-block reduction (thread_block)"};
    }
    return {CaseKind::TILE, TILE_SIZE, "sub-group reduction (thread_block_tile<32>)"};
}
} // namespace

// 数据搬运的原理：val 在各线程私有的寄存器里，彼此不可见，所以每轮都要先把值写进全组可见的暂存区，同步，再读跨距为 i 的伙伴那一格。
//每轮活跃线程数折半，log2(g.size()) 轮之后组内 rank 0 持有全组的和。
template <typename PtrT>
__aicore__ inline int32_t reduce_sum(const thread_group& g, PtrT x, int32_t val)
{
    // 本线程在组内的序号
    const int32_t lane = static_cast<int32_t>(g.thread_rank());

    for (int32_t i = static_cast<int32_t>(g.size()) / 2; i > 0; i /= 2) {
        // 把本线程的当前值写入暂存区，使其对全组可见
        x[lane] = val;
        g.sync();
        if (lane < i) {
            val += x[lane + i];
        }
        // 等全组读完，下一轮的写才不会覆盖本轮尚未读完的值
        g.sync();
    }
    return lane == 0 ? val : -1;
}

__global__ void reduce_grid_group(const int32_t* input, int32_t* grid_workspace, int32_t* total_grid)
{
    grid_group grid = this_grid();

    const int32_t global_idx = static_cast<int32_t>(grid.thread_rank());

    volatile int32_t* ws = grid_workspace;
    const int32_t val = reduce_sum(grid, ws, input[global_idx]);

    if (grid.thread_rank() == 0) {
        *total_grid = val;
    }
}

__global__ void reduce_thread_block(const int32_t* input, int32_t* total_block)
{
    __ubuf__ static int32_t ub_workspace[THREADS_PER_BLOCK];

    thread_block block = this_thread_block();

    const int32_t global_idx = static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(blockDim.x) +
                               static_cast<int32_t>(block.thread_rank());

    const int32_t val = reduce_sum(block, ub_workspace, input[global_idx]);

    if (block.thread_rank() == 0) {
        asc_atomic_add(total_block, val);
    }
}

__global__ void reduce_block_tile(const int32_t* input, int32_t* total_tile)
{
    __ubuf__ static int32_t ub_workspace[THREADS_PER_BLOCK];
    __ubuf__ static int32_t ub_partial[WARPS_PER_BLOCK];

    thread_block block = this_thread_block();

    const int32_t global_idx = static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(blockDim.x) +
                               static_cast<int32_t>(block.thread_rank());

    thread_block_tile<TILE_SIZE, thread_block> tile = tiled_partition<TILE_SIZE>(block);

    const int32_t off = static_cast<int32_t>(tile.meta_group_rank()) * TILE_SIZE;

    int32_t val = reduce_sum(tile, ub_workspace + off, input[global_idx]);

    if (tile.thread_rank() == 0) {
        ub_partial[tile.meta_group_rank()] = val;
    }

    block.sync();

    if (tile.meta_group_rank() == 0) {
        val = reduce_sum(tile, ub_workspace, ub_partial[tile.thread_rank()]);

        if (tile.thread_rank() == 0) {
            asc_atomic_add(total_tile, val);
        }
    }
}

int32_t run_case0(int32_t* input_device, aclrtStream stream)
{
    printf(
        "  grid = %d blocks x %d threads, reduce domain = %d, workspace in global memory\n", BLOCKS_PER_GRID,
        THREADS_PER_BLOCK, TOTAL_THREADS);

    size_t workspace_byte_size = TOTAL_THREADS * sizeof(int32_t);
    int32_t* total_device = nullptr;
    int32_t* workspace_device = nullptr;

    aclrtMalloc((void**)&total_device, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&workspace_device, workspace_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    reduce_grid_group<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, workspace_device, total_device);
    aclrtSynchronizeStream(stream);

    int32_t total_host = 0;
    aclrtMemcpy(&total_host, sizeof(int32_t), total_device, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(workspace_device);
    aclrtFree(total_device);
    return total_host;
}

int32_t run_case1(int32_t* input_device, aclrtStream stream)
{
    printf(
        "  grid = %d blocks x %d threads, reduce domain = %d per block, workspace in shared memory\n", BLOCKS_PER_GRID,
        THREADS_PER_BLOCK, THREADS_PER_BLOCK);

    int32_t* total_device = nullptr;
    aclrtMalloc((void**)&total_device, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(total_device, sizeof(int32_t), 0, sizeof(int32_t));

    reduce_thread_block<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(input_device, total_device);
    aclrtSynchronizeStream(stream);

    int32_t total_host = 0;
    aclrtMemcpy(&total_host, sizeof(int32_t), total_device, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(total_device);
    return total_host;
}

int32_t run_case2(int32_t* input_device, aclrtStream stream)
{
    printf(
        "  grid = %d blocks x %d threads, %d tiles per block, reduce domain = %d, workspace in shared memory\n",
        BLOCKS_PER_GRID, THREADS_PER_BLOCK, WARPS_PER_BLOCK, TILE_SIZE);

    int32_t* total_device = nullptr;
    aclrtMalloc((void**)&total_device, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(total_device, sizeof(int32_t), 0, sizeof(int32_t));

    reduce_block_tile<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(input_device, total_device);
    aclrtSynchronizeStream(stream);

    int32_t total_host = 0;
    aclrtMemcpy(&total_host, sizeof(int32_t), total_device, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(total_device);
    return total_host;
}

int32_t reduce_sum_func(std::vector<int32_t>& input, CaseKind kind)
{
    size_t input_total_byte_size = input.size() * sizeof(int32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    int32_t* input_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMalloc((void**)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input_total_byte_size, input.data(), input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    int32_t total = 0;
    if (kind == CaseKind::GRID) {
        total = run_case0(input_device, stream);
    } else if (kind == CaseKind::BLOCK) {
        total = run_case1(input_device, stream);
    } else {
        total = run_case2(input_device, stream);
    }

    aclrtFree(input_device);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return total;
}

uint32_t verify_result(int32_t output, int32_t golden)
{
    printf("Output: %d\n", output);
    printf("Golden: %d\n", golden);

    if (output == golden) {
        printf("[Success] Case accuracy is verification passed.\n");
        return 0;
    }
    printf("[Failed] Case accuracy is verification failed!\n");
    return 1;
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 2) {
        printf("[Failed] Invalid input, only \"cooperative_groups 0\", \"1\" or \"2\" is supported.\n");
        return 1;
    }

    std::string case_name(argv[1]);
    std::set<std::string> supported_cases{"0", "1", "2"};
    if (!supported_cases.count(case_name)) {
        printf("[Failed] Invalid case name, only \"cooperative_groups 0\", \"1\" or \"2\" is supported.\n");
        return 1;
    }

    CaseConfig config = get_case_config(case_name);
    printf("Case %s: %s, reduce domain = %d\n", case_name.c_str(), config.name, config.reduce_domain);

    std::vector<int32_t> input(TOTAL_THREADS);
    for (int32_t i = 0; i < TOTAL_THREADS; i++) {
        input[i] = i + 1;
    }
    int32_t golden = EXPECTED_TOTAL;

    int32_t output = reduce_sum_func(input, config.kind);
    return verify_result(output, golden);
}
