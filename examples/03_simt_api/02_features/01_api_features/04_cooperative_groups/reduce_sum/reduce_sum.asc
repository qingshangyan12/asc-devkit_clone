#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <set>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

using namespace cooperative_groups;

namespace {

constexpr int32_t BLOCKS_PER_GRID = 4;
constexpr int32_t THREADS_PER_BLOCK = 1024;
constexpr int32_t TILE_SIZE = 32;
constexpr int32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr int32_t WARPS_PER_BLOCK = THREADS_PER_BLOCK / TILE_SIZE;
constexpr uint32_t DYN_UBUF_SIZE = 0;

enum class KernelType {
    GRID_GROUP,    // 跨block规约，workspace在global memory
    THREAD_BLOCK,  // block内规约，workspace在shared memory
    BLOCK_TILE,    // 子组(warp)内规约，再做block内二级规约
};

// 单个用例的配置，由get_scenario_config按命令行参数取得
struct ScenarioConfig {
    KernelType kernel;      // 用例对应的kernel，决定launch哪一个
    int32_t reduce_domain;  // 规约域线程数，即reduce_sum中的g.size()
    const char* name;       // 用例名
};

ScenarioConfig get_scenario_config(const std::string& case_name)
{
    if (case_name == "0") {
        return {KernelType::GRID_GROUP, TOTAL_THREADS, "cross-block reduction (grid_group)"};
    }
    if (case_name == "1") {
        return {KernelType::THREAD_BLOCK, THREADS_PER_BLOCK, "whole-block reduction (thread_block)"};
    }
    return {KernelType::BLOCK_TILE, TILE_SIZE, "sub-group reduction (thread_block_tile<32>)"};
}
}

// [核心] CHECK_ACL宏：捕获并打印ACL错误信息，失败即退出
// 注：aclGetRecentErrMsg() 无错误详情时可能返回 nullptr，直接传给 %s 是未定义行为，故做兜底
#define CHECK_ACL(expr)                                                                       \
    do {                                                                                      \
        aclError ret = (expr);                                                                \
        if (ret != ACL_SUCCESS) {                                                             \
            const char* msg = aclGetRecentErrMsg();                                           \
            fprintf(                                                                          \
                stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, __LINE__,        \
                static_cast<int>(ret), (msg != nullptr) ? msg : "no detail", #expr);          \
            exit(EXIT_FAILURE);                                                               \
        }                                                                                     \
    } while (0)

template <typename PtrT>
__aicore__ inline int32_t reduce_sum(const thread_group& g, PtrT x, int32_t val)
{
    // thread_rank()/size() 返回 unsigned long long，窄化到 int32_t 需显式转型
    const int32_t lane = (int32_t)g.thread_rank();

    for (int32_t i = (int32_t)g.size() / 2; i > 0; i /= 2) {
        x[lane] = val;
        g.sync();
        if (lane < i) {
            val += x[lane + i];
        }
        g.sync();
    }
    return lane == 0 ? val : -1;
}

__global__ void reduce_grid_group(
    const int32_t* input, int32_t* grid_workspace, int32_t* total_grid, int32_t num_elements)
{
    grid_group grid = this_grid();

    const int32_t global_idx = (int32_t)grid.thread_rank();

    volatile int32_t* ws = grid_workspace;

    const int32_t in_val = global_idx < num_elements ? input[global_idx] : 0;

    const int32_t val = reduce_sum(grid, ws, in_val);

    if (grid.thread_rank() == 0) {
        *total_grid = val;
    }
}

__global__ void reduce_thread_block(const int32_t* input, int32_t* total_block, int32_t num_elements)
{
    __ubuf__ static int32_t ub_workspace[THREADS_PER_BLOCK];

    thread_block block = this_thread_block();

    const int32_t global_idx = (int32_t)(blockIdx.x * blockDim.x + block.thread_rank());

    const int32_t in_val = global_idx < num_elements ? input[global_idx] : 0;

    const int32_t val = reduce_sum(block, ub_workspace, in_val);

    if (block.thread_rank() == 0) {
        asc_atomic_add(total_block, val);
    }
}

__global__ void reduce_block_tile(const int32_t* input, int32_t* total_tile, int32_t num_elements)
{
    __ubuf__ static int32_t ub_workspace[THREADS_PER_BLOCK];
    __ubuf__ static int32_t ub_partial[WARPS_PER_BLOCK];

    thread_block block = this_thread_block();

    const int32_t global_idx = (int32_t)(blockIdx.x * blockDim.x + block.thread_rank());

    auto tile = tiled_partition<TILE_SIZE>(block);

    const int32_t offset = (int32_t)tile.meta_group_rank() * TILE_SIZE;

    const int32_t in_val = global_idx < num_elements ? input[global_idx] : 0;

    int32_t val = reduce_sum(tile, ub_workspace + offset, in_val);

    if (tile.thread_rank() == 0) {
        ub_partial[tile.meta_group_rank()] = val;
    }

    block.sync();

    if (tile.meta_group_rank() == 0) {
        val = reduce_sum(tile, ub_workspace, ub_partial[tile.thread_rank()]);

        if (tile.thread_rank() == 0) {
            asc_atomic_add(total_tile, val);
        }
    }
}

// case0：规约域跨block，暂存区取全局内存，总和由rank 0唯一写出，不需要预先清零
int32_t run_global_workspace_case(int32_t* input_device, int32_t num_elements, aclrtStream stream)
{
    printf("grid = %d blocks x %d threads, reduce domain = %d, workspace in global memory\n", BLOCKS_PER_GRID,
        THREADS_PER_BLOCK, TOTAL_THREADS);

    size_t workspace_byte_size = TOTAL_THREADS * sizeof(int32_t);
    int32_t* total_device = nullptr;
    int32_t* workspace_device = nullptr;

    CHECK_ACL(aclrtMalloc((void**)&total_device, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&workspace_device, workspace_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));

    reduce_grid_group<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, workspace_device, total_device, num_elements);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    int32_t total_host = 0;
    CHECK_ACL(aclrtMemcpy(&total_host, sizeof(int32_t), total_device, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST));

    CHECK_ACL(aclrtFree(workspace_device));
    CHECK_ACL(aclrtFree(total_device));
    return total_host;
}

// case1与case2：规约域不跨block，暂存区取共享内存，各block的部分和经原子加汇总，总和须预先清零
int32_t run_shared_workspace_case(KernelType kernel, int32_t* input_device, int32_t num_elements, aclrtStream stream)
{
    int32_t* total_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&total_device, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(total_device, sizeof(int32_t), 0, sizeof(int32_t)));

    if (kernel == KernelType::THREAD_BLOCK) {
        printf("grid = %d blocks x %d threads, reduce domain = %d per block, workspace in shared memory\n",
            BLOCKS_PER_GRID, THREADS_PER_BLOCK, THREADS_PER_BLOCK);
        reduce_thread_block<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input_device, total_device, num_elements);
    } else {
        printf("grid = %d blocks x %d threads, %d tiles per block, reduce domain = %d, workspace in shared memory\n",
            BLOCKS_PER_GRID, THREADS_PER_BLOCK, WARPS_PER_BLOCK, TILE_SIZE);
        reduce_block_tile<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input_device, total_device, num_elements);
    }

    CHECK_ACL(aclrtSynchronizeStream(stream));

    int32_t total_host = 0;
    CHECK_ACL(aclrtMemcpy(&total_host, sizeof(int32_t), total_device, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST));

    CHECK_ACL(aclrtFree(total_device));
    return total_host;
}

uint32_t verify_result(int32_t output, int32_t golden)
{
    printf("Output: %d\n", output);
    printf("Golden: %d\n", golden);

    if (output == golden) {
        printf("[Success] Case accuracy verification passed.\n");
        return 0;
    }
    printf("[Failed] Case accuracy verification failed!\n");
    return 1;
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 2 && argc != 3) {
        printf("[Failed] Invalid input, usage: \"cooperative_groups <0|1|2> [num_elements]\".\n");
        return 1;
    }

    std::string case_name(argv[1]);
    std::set<std::string> supported_cases{"0", "1", "2"};
    if (!supported_cases.count(case_name)) {
        printf("[Failed] Invalid case name, only \"cooperative_groups 0\", \"1\" or \"2\" is supported.\n");
        return 1;
    }

    int32_t num_elements = TOTAL_THREADS;
    if (argc == 3) {
        char* end = nullptr;
        const long parsed = std::strtol(argv[2], &end, 10);
        if (end == argv[2] || *end != '\0' || parsed <= 0 || parsed > TOTAL_THREADS) {
            printf("[Failed] Invalid num_elements, expect an integer in [1, %d].\n", TOTAL_THREADS);
            return 1;
        }
        num_elements = static_cast<int32_t>(parsed);
    }

    ScenarioConfig config = get_scenario_config(case_name);
    printf("Case %s: %s, reduce domain = %d\n", case_name.c_str(), config.name, config.reduce_domain);
    printf("num_elements = %d, threads = %d\n", num_elements, TOTAL_THREADS);

    std::vector<int32_t> input(num_elements);
    for (int32_t i = 0; i < num_elements; i++) {
        input[i] = i + 1;
    }
    const int32_t golden = static_cast<int32_t>(num_elements * (num_elements + 1) / 2);
    const size_t input_total_byte_size = input.size() * sizeof(int32_t);

    const int32_t device_id = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));

    int32_t* input_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        input_device, input_total_byte_size, input.data(), input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));

    int32_t output = 0;
    if (config.kernel == KernelType::GRID_GROUP) {
        output = run_global_workspace_case(input_device, num_elements, stream);
    } else {
        output = run_shared_workspace_case(config.kernel, input_device, num_elements, stream);
    }

    CHECK_ACL(aclrtFree(input_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());

    return verify_result(output, golden);
}
