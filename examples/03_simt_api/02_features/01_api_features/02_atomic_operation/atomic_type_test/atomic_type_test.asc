/* !
 * \file atomic_type_test.asc
 * \brief SIMT asc_atomic_add workload sample for float, half, bfloat16_t, half2, and bfloat16x2_t.
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_bf16.h"

#ifndef TYPE_KIND
#define TYPE_KIND 0
#endif

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#ifndef BLOCK_NUM
#define BLOCK_NUM 48
#endif

#ifndef THREADS_PER_BLOCK
#define THREADS_PER_BLOCK 256
#endif

#ifndef ITERATIONS
#define ITERATIONS 256
#endif

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 1
#endif

#if TYPE_KIND < 0 || TYPE_KIND > 4
#error "TYPE_KIND must be one of 0..4."
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 4
#error "SCENARIO_NUM must be one of 1..4."
#endif

constexpr uint32_t kBlockNum = BLOCK_NUM;
constexpr uint32_t kThreadsPerBlock = THREADS_PER_BLOCK;
constexpr uint32_t kIterations = ITERATIONS;
constexpr uint32_t kSlots = 1024;
constexpr uint64_t kTotalThreads = static_cast<uint64_t>(kBlockNum) * kThreadsPerBlock;
constexpr uint64_t kTotalAtomicAdds = kTotalThreads * kIterations;
constexpr uint64_t kAtomicAddsPerBlock = static_cast<uint64_t>(kThreadsPerBlock) * kIterations;

void check_acl(aclError result, const char* const func, const char* const file, int const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, static_cast<int>(result),
            aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}

void check_acl_launch(const char* kernel_name, const char* const file, int const line)
{
    const aclError result = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d kernel=\"%s\" code=%d(%s)\n", file, line, kernel_name, static_cast<int>(result),
            aclGetRecentErrMsg());
        std::exit(EXIT_FAILURE);
    }
}

#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)
#define CHECK_ACL_LAUNCH(kernel_name) check_acl_launch((kernel_name), __FILE__, __LINE__)

#if TYPE_KIND == 0
using AtomicT = float;
#define ATOMIC_ONE 1.0f
#define ATOMIC_ZERO 0.0f
#define TYPE_NAME "float"
#elif TYPE_KIND == 1
using AtomicT = half;
#define ATOMIC_ONE __float2half_rn(1.0f)
#define ATOMIC_ZERO __float2half_rn(0.0f)
#define TYPE_NAME "half"
#elif TYPE_KIND == 2
using AtomicT = bfloat16_t;
using GmStorageT = uint16_t;
constexpr uint32_t kGmStorageElements = kSlots;
#define ATOMIC_ONE __float2bfloat16_rn(1.0f)
#define ATOMIC_ZERO __float2bfloat16_rn(0.0f)
#define TYPE_NAME "bfloat16_t"
#elif TYPE_KIND == 3
using AtomicT = half2;
#define ATOMIC_ONE __floats2half2_rn(1.0f, 1.0f)
#define ATOMIC_ZERO __floats2half2_rn(0.0f, 0.0f)
#define TYPE_NAME "half2"
#elif TYPE_KIND == 4
using AtomicT = bfloat16x2_t;
using GmStorageT = uint16_t;
constexpr uint32_t kGmStorageElements = kSlots * 2;
#define ATOMIC_ONE __float2bfloat162_rn(1.0f)
#define ATOMIC_ZERO __float2bfloat162_rn(0.0f)
#define TYPE_NAME "bfloat16x2_t"
#endif

#if TYPE_KIND != 2 && TYPE_KIND != 4
using GmStorageT = AtomicT;
constexpr uint32_t kGmStorageElements = kSlots;
#endif

__aicore__ inline AtomicT* gm_atomic_ptr(GmStorageT* storage)
{
#if TYPE_KIND == 2 || TYPE_KIND == 4
    return reinterpret_cast<AtomicT*>(storage);
#else
    return storage;
#endif
}

__aicore__ inline const AtomicT* gm_atomic_ptr(const GmStorageT* storage)
{
#if TYPE_KIND == 2 || TYPE_KIND == 4
    return reinterpret_cast<const AtomicT*>(storage);
#else
    return storage;
#endif
}

const char* scenario_name()
{
#if SCENARIO_NUM == 1
    return "GM with return value";
#elif SCENARIO_NUM == 2
    return "GM without return value";
#elif SCENARIO_NUM == 3
    return "UB with return value";
#elif SCENARIO_NUM == 4
    return "UB without return value";
#endif
}

constexpr bool scenario_uses_gm()
{
    return SCENARIO_NUM == 1 || SCENARIO_NUM == 2;
}

constexpr bool scenario_uses_ub_results()
{
    return SCENARIO_NUM == 3 || SCENARIO_NUM == 4;
}

constexpr uint64_t expected_atomic_adds_per_slot(uint32_t slot)
{
    const uint64_t base_threads = kTotalThreads / kSlots;
    const uint64_t extra_thread = slot < (kTotalThreads % kSlots) ? 1 : 0;
    return (base_threads + extra_thread) * kIterations;
}

constexpr uint64_t expected_atomic_adds_per_ub_slot(uint32_t block_index, uint32_t slot)
{
    uint64_t threads = 0;
    for (uint32_t thread = 0; thread < kThreadsPerBlock; ++thread) {
        const uint32_t global_tid = block_index * kThreadsPerBlock + thread;
        if ((global_tid % kSlots) == slot) {
            ++threads;
        }
    }
    return threads * kIterations;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_return(GmStorageT* storage)
{
    AtomicT* counters = gm_atomic_ptr(storage);
    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    AtomicT* counter = counters + (global_tid % kSlots);
    volatile AtomicT old_value_sink = ATOMIC_ZERO;
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        old_value_sink = asc_atomic_add(counter, ATOMIC_ONE);
    }
    (void)old_value_sink;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_no_return(GmStorageT* storage)
{
    AtomicT* counters = gm_atomic_ptr(storage);
    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    AtomicT* counter = counters + (global_tid % kSlots);
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        asc_atomic_add(counter, ATOMIC_ONE);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_ub_return(float* block_results)
{
    __ubuf__ AtomicT counters[kSlots];
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
        counters[slot] = ATOMIC_ZERO;
    }
    asc_syncthreads();

    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    AtomicT* counter = counters + (global_tid % kSlots);
    volatile AtomicT old_value_sink = ATOMIC_ZERO;
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        old_value_sink = asc_atomic_add(counter, ATOMIC_ONE);
    }
    (void)old_value_sink;

    asc_syncthreads();
    const uint32_t result_base = blockIdx.x * kSlots * 2;
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
#if TYPE_KIND == 0
        block_results[result_base + slot * 2] = counters[slot];
        block_results[result_base + slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 1
        block_results[result_base + slot * 2] = __half2float(counters[slot]);
        block_results[result_base + slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 2
        block_results[result_base + slot * 2] = __bfloat162float(counters[slot]);
        block_results[result_base + slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 3
        block_results[result_base + slot * 2] = __half2float(__low2half(counters[slot]));
        block_results[result_base + slot * 2 + 1] = __half2float(__high2half(counters[slot]));
#elif TYPE_KIND == 4
        block_results[result_base + slot * 2] = __bfloat162float(__low2bfloat16(counters[slot]));
        block_results[result_base + slot * 2 + 1] = __bfloat162float(__high2bfloat16(counters[slot]));
#endif
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_ub_no_return(float* block_results)
{
    __ubuf__ AtomicT counters[kSlots];
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
        counters[slot] = ATOMIC_ZERO;
    }
    asc_syncthreads();

    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    AtomicT* counter = counters + (global_tid % kSlots);
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        asc_atomic_add(counter, ATOMIC_ONE);
    }

    asc_syncthreads();
    const uint32_t result_base = blockIdx.x * kSlots * 2;
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
#if TYPE_KIND == 0
        block_results[result_base + slot * 2] = counters[slot];
        block_results[result_base + slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 1
        block_results[result_base + slot * 2] = __half2float(counters[slot]);
        block_results[result_base + slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 2
        block_results[result_base + slot * 2] = __bfloat162float(counters[slot]);
        block_results[result_base + slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 3
        block_results[result_base + slot * 2] = __half2float(__low2half(counters[slot]));
        block_results[result_base + slot * 2 + 1] = __half2float(__high2half(counters[slot]));
#elif TYPE_KIND == 4
        block_results[result_base + slot * 2] = __bfloat162float(__low2bfloat16(counters[slot]));
        block_results[result_base + slot * 2 + 1] = __bfloat162float(__high2bfloat16(counters[slot]));
#endif
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void convert_gm_to_float(const GmStorageT* storage, float* results)
{
    const AtomicT* counters = gm_atomic_ptr(storage);
    const uint32_t slot = blockIdx.x * blockDim.x + threadIdx.x;
    if (slot >= kSlots) {
        return;
    }
#if TYPE_KIND == 0
    results[slot * 2] = counters[slot];
    results[slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 1
    results[slot * 2] = __half2float(counters[slot]);
    results[slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 2
    results[slot * 2] = __bfloat162float(counters[slot]);
    results[slot * 2 + 1] = 0.0f;
#elif TYPE_KIND == 3
    results[slot * 2] = __half2float(__low2half(counters[slot]));
    results[slot * 2 + 1] = __half2float(__high2half(counters[slot]));
#elif TYPE_KIND == 4
    results[slot * 2] = __bfloat162float(__low2bfloat16(counters[slot]));
    results[slot * 2 + 1] = __bfloat162float(__high2bfloat16(counters[slot]));
#endif
}

void run_selected_kernel(aclrtStream stream, GmStorageT* gm_counters, float* ub_block_results)
{
    constexpr uint32_t dynamic_ubuf_size = 0;
#if SCENARIO_NUM == 1
    atomic_add_gm_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_counters);
    CHECK_ACL_LAUNCH("atomic_add_gm_return");
#elif SCENARIO_NUM == 2
    atomic_add_gm_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_counters);
    CHECK_ACL_LAUNCH("atomic_add_gm_no_return");
#elif SCENARIO_NUM == 3
    atomic_add_ub_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(ub_block_results);
    CHECK_ACL_LAUNCH("atomic_add_ub_return");
#elif SCENARIO_NUM == 4
    atomic_add_ub_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(ub_block_results);
    CHECK_ACL_LAUNCH("atomic_add_ub_no_return");
#endif
    CHECK_ACL(aclrtSynchronizeStream(stream));
}

bool close_enough(float actual, float expected)
{
    const float diff = std::fabs(actual - expected);
    const float tolerance = 0.5f;
    return diff <= tolerance;
}

bool validate_gm(aclrtStream stream, GmStorageT* gm_counters, float* converted_results)
{
    constexpr uint32_t threads = 256;
    const uint32_t blocks = (kSlots + threads - 1) / threads;
    convert_gm_to_float<<<dim3(blocks), dim3(threads), 0, stream>>>(gm_counters, converted_results);
    CHECK_ACL_LAUNCH("convert_gm_to_float");
    CHECK_ACL(aclrtSynchronizeStream(stream));

    float results[kSlots * 2] = {};
    CHECK_ACL(aclrtMemcpy(results, sizeof(results), converted_results, sizeof(results), ACL_MEMCPY_DEVICE_TO_HOST));

    float total_lane0 = 0.0f;
    float total_lane1 = 0.0f;
    bool matched = true;
    for (uint32_t slot = 0; slot < kSlots; ++slot) {
        const float expected = static_cast<float>(expected_atomic_adds_per_slot(slot));
        const float lane0 = results[slot * 2];
        const float lane1 = results[slot * 2 + 1];
        total_lane0 += lane0;
        total_lane1 += lane1;
        if (!close_enough(lane0, expected)) {
            std::fprintf(stderr, "Validation failed: slot=%u lane0=%f expected=%f\n", slot, lane0, expected);
            matched = false;
            break;
        }
#if TYPE_KIND == 3 || TYPE_KIND == 4
        if (!close_enough(lane1, expected)) {
            std::fprintf(stderr, "Validation failed: slot=%u lane1=%f expected=%f\n", slot, lane1, expected);
            matched = false;
            break;
        }
#endif
    }

    if (matched && !close_enough(total_lane0, static_cast<float>(kTotalAtomicAdds))) {
        std::fprintf(stderr, "Validation failed: total_lane0=%f expected=%lu\n", total_lane0, kTotalAtomicAdds);
        matched = false;
    }
#if TYPE_KIND == 3 || TYPE_KIND == 4
    if (matched && !close_enough(total_lane1, static_cast<float>(kTotalAtomicAdds))) {
        std::fprintf(stderr, "Validation failed: total_lane1=%f expected=%lu\n", total_lane1, kTotalAtomicAdds);
        matched = false;
    }
#else
    (void)total_lane1;
#endif
    return matched;
}

bool validate_ub(float* ub_block_results)
{
    float results[kBlockNum * kSlots * 2] = {};
    CHECK_ACL(aclrtMemcpy(results, sizeof(results), ub_block_results, sizeof(results), ACL_MEMCPY_DEVICE_TO_HOST));

    float total_lane0 = 0.0f;
    float total_lane1 = 0.0f;
    bool matched = true;
    for (uint32_t block_index = 0; block_index < kBlockNum; ++block_index) {
        float block_lane0 = 0.0f;
        float block_lane1 = 0.0f;
        const uint64_t block_base = static_cast<uint64_t>(block_index) * kSlots * 2;
        for (uint32_t slot = 0; slot < kSlots; ++slot) {
            const float expected = static_cast<float>(expected_atomic_adds_per_ub_slot(block_index, slot));
            const float lane0 = results[block_base + slot * 2];
            const float lane1 = results[block_base + slot * 2 + 1];
            block_lane0 += lane0;
            block_lane1 += lane1;
            if (!close_enough(lane0, expected)) {
                std::fprintf(
                    stderr, "Validation failed: block=%u slot=%u lane0=%f expected=%f\n", block_index, slot,
                    lane0, expected);
                matched = false;
                break;
            }
#if TYPE_KIND == 3 || TYPE_KIND == 4
            if (!close_enough(lane1, expected)) {
                std::fprintf(
                    stderr, "Validation failed: block=%u slot=%u lane1=%f expected=%f\n", block_index, slot,
                    lane1, expected);
                matched = false;
                break;
            }
#endif
        }
        total_lane0 += block_lane0;
        total_lane1 += block_lane1;
        if (!matched) {
            break;
        }
        if (!close_enough(block_lane0, static_cast<float>(kAtomicAddsPerBlock))) {
            std::fprintf(
                stderr, "Validation failed: block=%u lane0_total=%f expected_per_block=%lu\n", block_index,
                block_lane0, kAtomicAddsPerBlock);
            matched = false;
            break;
        }
#if TYPE_KIND == 3 || TYPE_KIND == 4
        if (!close_enough(block_lane1, static_cast<float>(kAtomicAddsPerBlock))) {
            std::fprintf(
                stderr, "Validation failed: block=%u lane1_total=%f expected_per_block=%lu\n", block_index,
                block_lane1, kAtomicAddsPerBlock);
            matched = false;
            break;
        }
#endif
    }

    if (matched && !close_enough(total_lane0, static_cast<float>(kTotalAtomicAdds))) {
        std::fprintf(stderr, "Validation failed: total_lane0=%f expected=%lu\n", total_lane0, kTotalAtomicAdds);
        matched = false;
    }
#if TYPE_KIND == 3 || TYPE_KIND == 4
    if (matched && !close_enough(total_lane1, static_cast<float>(kTotalAtomicAdds))) {
        std::fprintf(stderr, "Validation failed: total_lane1=%f expected=%lu\n", total_lane1, kTotalAtomicAdds);
        matched = false;
    }
#else
    (void)total_lane1;
#endif
    return matched;
}

int main()
{
    std::printf("Type %u (%s), Scenario %u: %s\n", static_cast<uint32_t>(TYPE_KIND), TYPE_NAME,
        static_cast<uint32_t>(SCENARIO_NUM), scenario_name());
    std::printf(
        "Workload: blocks=%u threads_per_block=%u iterations=%u slots=%u total_atomic_adds=%lu\n", kBlockNum,
        kThreadsPerBlock, kIterations, kSlots, kTotalAtomicAdds);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    GmStorageT* gm_counters = nullptr;
    float* ub_block_results = nullptr;
    float* converted_results = nullptr;

    CHECK_ACL(aclrtCreateStream(&stream));
    if (scenario_uses_gm()) {
        const uint64_t gm_bytes = static_cast<uint64_t>(kGmStorageElements) * sizeof(GmStorageT);
        CHECK_ACL(aclrtMalloc((void**)(&gm_counters), gm_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(gm_counters, gm_bytes, 0, gm_bytes));
#if !SKIP_VALIDATION
        const uint64_t result_bytes = static_cast<uint64_t>(kSlots) * 2 * sizeof(float);
        CHECK_ACL(aclrtMalloc((void**)(&converted_results), result_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(converted_results, result_bytes, 0, result_bytes));
#endif
    }
    if (scenario_uses_ub_results()) {
        const uint64_t ub_results_bytes = static_cast<uint64_t>(kBlockNum) * kSlots * 2 * sizeof(float);
        CHECK_ACL(aclrtMalloc((void**)(&ub_block_results), ub_results_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(ub_block_results, ub_results_bytes, 0, ub_results_bytes));
    }

    run_selected_kernel(stream, gm_counters, ub_block_results);

#if SKIP_VALIDATION
    const bool matched = true;
    std::printf("Validation skipped\n");
#else
    const bool matched = scenario_uses_gm() ? validate_gm(stream, gm_counters, converted_results)
                                            : validate_ub(ub_block_results);
    std::printf("%s\n", matched ? "Validation passed" : "Validation failed");
#endif

    if (converted_results != nullptr) {
        aclrtFree(converted_results);
    }
    if (ub_block_results != nullptr) {
        aclrtFree(ub_block_results);
    }
    if (gm_counters != nullptr) {
        aclrtFree(gm_counters);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return matched ? EXIT_SUCCESS : EXIT_FAILURE;
}
