/* !
 * \file atomic_add_perf.asc
 * \brief SIMT asc_atomic_add performance workload sample.
 */

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#ifndef BLOCK_NUM
#define BLOCK_NUM 48
#endif

#ifndef THREADS_PER_BLOCK
#define THREADS_PER_BLOCK 256
#endif

#ifndef ITERATIONS
#define ITERATIONS 256
#endif

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 6
#error "SCENARIO_NUM must be one of 1..6."
#endif

constexpr uint32_t kBlockNum = BLOCK_NUM;
constexpr uint32_t kThreadsPerBlock = THREADS_PER_BLOCK;
constexpr uint32_t kIterations = ITERATIONS;
constexpr uint32_t kSlots = 1024;
constexpr uint64_t kTotalThreads = static_cast<uint64_t>(kBlockNum) * kThreadsPerBlock;
constexpr uint64_t kTotalAtomicAdds = kTotalThreads * kIterations;
constexpr uint64_t kAtomicAddsPerBlock = static_cast<uint64_t>(kThreadsPerBlock) * kIterations;

void check_acl(aclError result, const char* const func, const char* const file, int const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, static_cast<int>(result),
            aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}

void check_acl_launch(const char* kernel_name, const char* const file, int const line)
{
    const aclError result = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d kernel=\"%s\" code=%d(%s)\n", file, line, kernel_name, static_cast<int>(result),
            aclGetRecentErrMsg());
        std::exit(EXIT_FAILURE);
    }
}

#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)
#define CHECK_ACL_LAUNCH(kernel_name) check_acl_launch((kernel_name), __FILE__, __LINE__)

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_i32_return(
    int32_t* counters)
{
    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    int32_t* counter = counters + (global_tid % kSlots);
    volatile int32_t old_value_sink = 0;
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        old_value_sink = asc_atomic_add(counter, 1);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_i32_no_return(int32_t* counters)
{
    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    int32_t* counter = counters + (global_tid % kSlots);
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        asc_atomic_add(counter, 1);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_i64_return(
    int64_t* counters)
{
    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    int64_t* counter = counters + (global_tid % kSlots);
    volatile int64_t old_value_sink = 0;
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        old_value_sink = asc_atomic_add(counter, 1LL);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_i64_no_return(int64_t* counters)
{
    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    int64_t* counter = counters + (global_tid % kSlots);
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        asc_atomic_add(counter, 1LL);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_ub_i32_return(
    uint64_t* block_results)
{
    __ubuf__ int32_t counters[kSlots];
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
        counters[slot] = 0;
    }
    asc_syncthreads();

    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    int32_t* counter = counters + (global_tid % kSlots);
    volatile int32_t old_value_sink = 0;
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        old_value_sink = asc_atomic_add(counter, 1);
    }

    asc_syncthreads();
    const uint32_t result_base = blockIdx.x * kSlots;
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
        block_results[result_base + slot] = static_cast<uint64_t>(counters[slot]);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_ub_i32_no_return(uint64_t* block_results)
{
    __ubuf__ int32_t counters[kSlots];
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
        counters[slot] = 0;
    }
    asc_syncthreads();

    const uint32_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    int32_t* counter = counters + (global_tid % kSlots);
    for (uint32_t iter = 0; iter < kIterations; ++iter) {
        asc_atomic_add(counter, 1);
    }

    asc_syncthreads();
    const uint32_t result_base = blockIdx.x * kSlots;
    for (uint32_t slot = threadIdx.x; slot < kSlots; slot += blockDim.x) {
        block_results[result_base + slot] = static_cast<uint64_t>(counters[slot]);
    }
}

const char* scenario_name()
{
#if SCENARIO_NUM == 1
    return "GM int32 with return value";
#elif SCENARIO_NUM == 2
    return "GM int32 without return value";
#elif SCENARIO_NUM == 3
    return "GM int64 with return value";
#elif SCENARIO_NUM == 4
    return "GM int64 without return value";
#elif SCENARIO_NUM == 5
    return "UB int32 with return value";
#elif SCENARIO_NUM == 6
    return "UB int32 without return value";
#endif
}

constexpr bool scenario_uses_gm_i32()
{
    return SCENARIO_NUM == 1 || SCENARIO_NUM == 2;
}

constexpr bool scenario_uses_gm_i64()
{
    return SCENARIO_NUM == 3 || SCENARIO_NUM == 4;
}

constexpr bool scenario_uses_ub_results()
{
    return SCENARIO_NUM == 5 || SCENARIO_NUM == 6;
}

constexpr uint64_t expected_atomic_adds_per_slot(uint32_t slot)
{
    const uint64_t base_threads = kTotalThreads / kSlots;
    const uint64_t extra_thread = slot < (kTotalThreads % kSlots) ? 1 : 0;
    return (base_threads + extra_thread) * kIterations;
}

constexpr uint64_t expected_atomic_adds_per_ub_slot(uint32_t block_index, uint32_t slot)
{
    uint64_t threads = 0;
    for (uint32_t thread = 0; thread < kThreadsPerBlock; ++thread) {
        const uint32_t global_tid = block_index * kThreadsPerBlock + thread;
        if ((global_tid % kSlots) == slot) {
            ++threads;
        }
    }
    return threads * kIterations;
}

void run_selected_kernel(
    aclrtStream stream, int32_t* gm_counter_i32, int64_t* gm_counter_i64, uint64_t* ub_block_results)
{
    constexpr uint32_t dynamic_ubuf_size = 0;
#if SCENARIO_NUM == 1
    atomic_add_gm_i32_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(
        gm_counter_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_i32_return");
#elif SCENARIO_NUM == 2
    atomic_add_gm_i32_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(
        gm_counter_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_i32_no_return");
#elif SCENARIO_NUM == 3
    atomic_add_gm_i64_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(
        gm_counter_i64);
    CHECK_ACL_LAUNCH("atomic_add_gm_i64_return");
#elif SCENARIO_NUM == 4
    atomic_add_gm_i64_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(
        gm_counter_i64);
    CHECK_ACL_LAUNCH("atomic_add_gm_i64_no_return");
#elif SCENARIO_NUM == 5
    atomic_add_ub_i32_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(
        ub_block_results);
    CHECK_ACL_LAUNCH("atomic_add_ub_i32_return");
#elif SCENARIO_NUM == 6
    atomic_add_ub_i32_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(
        ub_block_results);
    CHECK_ACL_LAUNCH("atomic_add_ub_i32_no_return");
#endif
    CHECK_ACL(aclrtSynchronizeStream(stream));
}

bool validate_gm_i32(int32_t* gm_counter_i32)
{
    int32_t counters[kSlots] = {};
    CHECK_ACL(aclrtMemcpy(counters, sizeof(counters), gm_counter_i32, sizeof(counters), ACL_MEMCPY_DEVICE_TO_HOST));

    uint64_t total = 0;
    bool matched = true;
    for (uint32_t slot = 0; slot < kSlots; ++slot) {
        const uint64_t actual = static_cast<uint64_t>(counters[slot]);
        const uint64_t expected = expected_atomic_adds_per_slot(slot);
        total += actual;
        if (actual != expected) {
            std::fprintf(stderr, "Validation failed: slot=%u counter=%lu expected=%lu\n", slot, actual, expected);
            matched = false;
            break;
        }
    }

    if (matched && total != kTotalAtomicAdds) {
        std::fprintf(stderr, "Validation failed: total=%lu expected=%lu\n", total, kTotalAtomicAdds);
        matched = false;
    }

    return matched;
}

bool validate_gm_i64(int64_t* gm_counter_i64)
{
    int64_t counters[kSlots] = {};
    CHECK_ACL(aclrtMemcpy(counters, sizeof(counters), gm_counter_i64, sizeof(counters), ACL_MEMCPY_DEVICE_TO_HOST));

    uint64_t total = 0;
    bool matched = true;
    for (uint32_t slot = 0; slot < kSlots; ++slot) {
        const uint64_t actual = static_cast<uint64_t>(counters[slot]);
        const uint64_t expected = expected_atomic_adds_per_slot(slot);
        total += actual;
        if (actual != expected) {
            std::fprintf(stderr, "Validation failed: slot=%u counter=%lu expected=%lu\n", slot, actual, expected);
            matched = false;
            break;
        }
    }

    if (matched && total != kTotalAtomicAdds) {
        std::fprintf(stderr, "Validation failed: total=%lu expected=%lu\n", total, kTotalAtomicAdds);
        matched = false;
    }

    return matched;
}

bool validate_ub_results(uint64_t* ub_block_results)
{
    uint64_t block_results[kBlockNum * kSlots] = {};

    CHECK_ACL(aclrtMemcpy(
        block_results, sizeof(block_results), ub_block_results, sizeof(block_results),
        ACL_MEMCPY_DEVICE_TO_HOST));

    uint64_t total = 0;
    bool matched = true;
    for (uint32_t block_index = 0; block_index < kBlockNum; ++block_index) {
        uint64_t block_total = 0;
        for (uint32_t slot = 0; slot < kSlots; ++slot) {
            const uint64_t actual = block_results[static_cast<uint64_t>(block_index) * kSlots + slot];
            const uint64_t expected = expected_atomic_adds_per_ub_slot(block_index, slot);
            block_total += actual;
            if (actual != expected) {
                std::fprintf(
                    stderr, "Validation failed: block=%u slot=%u counter=%lu expected=%lu\n", block_index, slot,
                    actual, expected);
                matched = false;
                break;
            }
        }
        total += block_total;
        if (!matched) {
            break;
        }
        if (block_total != kAtomicAddsPerBlock) {
            std::fprintf(
                stderr, "Validation failed: block=%u total=%lu expected_per_block=%lu\n", block_index, block_total,
                kAtomicAddsPerBlock);
            matched = false;
            break;
        }
    }

    if (matched && total != kTotalAtomicAdds) {
        std::fprintf(stderr, "Validation failed: total=%lu expected=%lu\n", total, kTotalAtomicAdds);
        matched = false;
    }

    return matched;
}

bool validate_result(int32_t* gm_counter_i32, int64_t* gm_counter_i64, uint64_t* ub_block_results)
{
    if (scenario_uses_gm_i32()) {
        return validate_gm_i32(gm_counter_i32);
    }
    if (scenario_uses_gm_i64()) {
        return validate_gm_i64(gm_counter_i64);
    }
    return validate_ub_results(ub_block_results);
}

int main()
{
    constexpr uint64_t kMaxAtomicAddsPerGmSlot = ((kTotalThreads + kSlots - 1) / kSlots) * kIterations;
    constexpr uint64_t kMaxAtomicAddsPerUbSlot = ((kThreadsPerBlock + kSlots - 1) / kSlots) * kIterations;
    static_assert(kMaxAtomicAddsPerGmSlot <= static_cast<uint64_t>(INT32_MAX), "GM int32 slots must not overflow");
    static_assert(kMaxAtomicAddsPerUbSlot <= static_cast<uint64_t>(INT32_MAX), "UB int32 slots must not overflow");

    std::printf("Scenario %u: %s\n", static_cast<uint32_t>(SCENARIO_NUM), scenario_name());
    std::printf(
        "Workload: blocks=%u threads_per_block=%u iterations=%u slots=%u total_atomic_adds=%lu\n", kBlockNum,
        kThreadsPerBlock, kIterations, kSlots, kTotalAtomicAdds);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    int32_t* gm_counter_i32 = nullptr;
    int64_t* gm_counter_i64 = nullptr;
    uint64_t* ub_block_results = nullptr;

    CHECK_ACL(aclrtCreateStream(&stream));
    if (scenario_uses_gm_i32()) {
        const uint64_t gm_i32_bytes = static_cast<uint64_t>(kSlots) * sizeof(int32_t);
        CHECK_ACL(aclrtMalloc((void**)(&gm_counter_i32), gm_i32_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(gm_counter_i32, gm_i32_bytes, 0, gm_i32_bytes));
    }
    if (scenario_uses_gm_i64()) {
        const uint64_t gm_i64_bytes = static_cast<uint64_t>(kSlots) * sizeof(int64_t);
        CHECK_ACL(aclrtMalloc((void**)(&gm_counter_i64), gm_i64_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(gm_counter_i64, gm_i64_bytes, 0, gm_i64_bytes));
    }
    if (scenario_uses_ub_results()) {
        const uint64_t ub_results_bytes = kBlockNum * kSlots * sizeof(uint64_t);
        CHECK_ACL(aclrtMalloc((void**)(&ub_block_results), ub_results_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(ub_block_results, ub_results_bytes, 0, ub_results_bytes));
    }
    run_selected_kernel(stream, gm_counter_i32, gm_counter_i64, ub_block_results);
#if SKIP_VALIDATION
    const bool matched = true;
    std::printf("Validation skipped\n");
#else
    const bool matched = validate_result(gm_counter_i32, gm_counter_i64, ub_block_results);
    std::printf("%s\n", matched ? "Validation passed" : "Validation failed");
#endif

    if (ub_block_results != nullptr) {
        aclrtFree(ub_block_results);
    }
    if (gm_counter_i64 != nullptr) {
        aclrtFree(gm_counter_i64);
    }
    if (gm_counter_i32 != nullptr) {
        aclrtFree(gm_counter_i32);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return matched ? EXIT_SUCCESS : EXIT_FAILURE;
}
