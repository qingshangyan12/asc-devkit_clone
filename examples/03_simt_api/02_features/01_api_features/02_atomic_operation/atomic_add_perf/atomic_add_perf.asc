/* !
 * \file atomic_add_perf.asc
 * \brief SIMT asc_atomic_add performance workload sample.
 *
 * Twelve scenarios grouped into five cases. Each scenario runs exactly one
 * kernel; pick it with -DSCENARIO_NUM=<n>. Every thread performs a single
 * asc_atomic_add, so the workload is fully described by (blocks, threads). Each
 * scenario ships a default (blocks, threads) that reproduces README.md; both
 * can still be overridden with -DBLOCK_NUM / -DTHREADS_PER_BLOCK.
 *
 *   Case 1  single GM address vs single UB address, one block, 2048 threads
 *           S1  GM  int32  direct atomic add   (no return value)
 *           S2  UB  int32  two-level reduction (no return value)
 *   Case 2  same address hit by 8 blocks x 256 threads
 *           S3  GM  int32  direct atomic add   (no return value)
 *           S4  UB  int32  two-level reduction (no return value)
 *   Case 3  return-value overhead, one block, 2048 threads on one address
 *           S5  GM  int32  with    return value
 *           S6  GM  int32  without return value
 *           S7  UB  int32  with    return value
 *           S8  UB  int32  without return value
 *   Case 4  int32 vs int64, dense per-thread counters, 48 blocks x 256 threads
 *           S9   GM int32  (no return value)
 *           S10  GM int64  (no return value)
 *   Case 5  cacheline queuing, dense per-thread counters, 48 blocks x 256 threads
 *           S11  GM int32  (with return value)
 *           S12  GM int64  (with return value)
 */

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 12
#error "SCENARIO_NUM must be one of 1..12."
#endif

// Scenario category (compile-time). Exactly one of these is true.
#define SC_SINGLE_GM ((SCENARIO_NUM == 1) || (SCENARIO_NUM == 3) || (SCENARIO_NUM == 5) || (SCENARIO_NUM == 6))
#define SC_UB_REDUCE ((SCENARIO_NUM == 2) || (SCENARIO_NUM == 4) || (SCENARIO_NUM == 7) || (SCENARIO_NUM == 8))
#define SC_DENSE_I32 ((SCENARIO_NUM == 9) || (SCENARIO_NUM == 11))
#define SC_DENSE_I64 ((SCENARIO_NUM == 10) || (SCENARIO_NUM == 12))

// Each scenario carries a default workload that reproduces README.md. Override
// with -DBLOCK_NUM / -DTHREADS_PER_BLOCK if you want to explore other sizes.
#ifndef BLOCK_NUM
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2 || (SCENARIO_NUM >= 5 && SCENARIO_NUM <= 8)
#define BLOCK_NUM 1
#elif SCENARIO_NUM == 3 || SCENARIO_NUM == 4
#define BLOCK_NUM 8
#else
#define BLOCK_NUM 48
#endif
#endif

#ifndef THREADS_PER_BLOCK
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2 || (SCENARIO_NUM >= 5 && SCENARIO_NUM <= 8)
#define THREADS_PER_BLOCK 2048
#else
#define THREADS_PER_BLOCK 256
#endif
#endif

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

// Case 4 / 5 map each thread to a target via (globalTid % TARGET_COUNT). With
// fewer targets than threads, several threads contend for the same address.
// Shrink TARGET_COUNT to intensify contention, enlarge it to relax contention.
#ifndef TARGET_COUNT
#define TARGET_COUNT 1024
#endif

constexpr uint32_t kBlockNum = BLOCK_NUM;
constexpr uint32_t kThreadsPerBlock = THREADS_PER_BLOCK;
constexpr uint64_t kTotalThreads = (uint64_t)kBlockNum * kThreadsPerBlock;
// Every thread does exactly one atomic add, so the total equals the thread count.
constexpr uint64_t kTotalAtomicAdds = kTotalThreads;
constexpr uint64_t kTargetCount = TARGET_COUNT;

void check_acl(aclError result, const char* const func, const char* const file, int const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, (int)result,
            aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}

void check_acl_launch(const char* kernel_name, const char* const file, int const line)
{
    const aclError result = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d kernel=\"%s\" code=%d(%s)\n", file, line, kernel_name, (int)result,
            aclGetRecentErrMsg());
        std::exit(EXIT_FAILURE);
    }
}

#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)
#define CHECK_ACL_LAUNCH(kernel_name) check_acl_launch((kernel_name), __FILE__, __LINE__)

// ---------------------------------------------------------------------------
// Case 1 / 2 / 3 -- single GM address.
// Every thread does one asc_atomic_add on the SAME gm counter, so the counter
// is contended by all (blocks x threads) threads at once: maximum contention.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_single_return(int32_t* counter)
{
    volatile int32_t old_value_sink = asc_atomic_add(counter, 1);
    (void)old_value_sink;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_single_no_return(int32_t* counter)
{
    asc_atomic_add(counter, 1);
}

// ---------------------------------------------------------------------------
// Case 2 / 3 -- two-level reduction.
// Each block accumulates into ONE private UB counter; thread 0 then adds the
// block subtotal into the single shared GM result. GM atomics drop from
// (blocks x threads) down to (blocks) -- the cross-block queuing on GM is
// replaced by fast intra-block UB atomics.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_ub_reduce_return(int32_t* gm_result)
{
    __ubuf__ int32_t local;
    if (threadIdx.x == 0) {
        local = 0;
    }
    asc_syncthreads();

    volatile int32_t old_value_sink = asc_atomic_add(&local, 1);
    (void)old_value_sink;
    asc_syncthreads();

    if (threadIdx.x == 0) {
        asc_atomic_add(gm_result, local);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_ub_reduce_no_return(int32_t* gm_result)
{
    __ubuf__ int32_t local;
    if (threadIdx.x == 0) {
        local = 0;
    }
    asc_syncthreads();

    asc_atomic_add(&local, 1);
    asc_syncthreads();

    if (threadIdx.x == 0) {
        asc_atomic_add(gm_result, local);
    }
}

// ---------------------------------------------------------------------------
// Case 4 / 5 -- dense counters over a shared target pool.
// Each thread maps to a target via (globalTid % TARGET_COUNT). With fewer
// targets than threads, several threads contend for the same address: real
// same-address contention. Targets stay packed tightly, so the cacheline-
// packing effect (32 int32 vs 16 int64 targets per 128B line) is present on
// top of the contention.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_dense_i32_no_return(int32_t* counters)
{
    asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % TARGET_COUNT), 1);
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_dense_i64_no_return(int64_t* counters)
{
    asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % TARGET_COUNT), 1LL);
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_dense_i32_return(int32_t* counters)
{
    volatile int32_t old_value_sink = asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % TARGET_COUNT), 1);
    (void)old_value_sink;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void atomic_add_gm_dense_i64_return(int64_t* counters)
{
    volatile int64_t old_value_sink = asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % TARGET_COUNT), 1LL);
    (void)old_value_sink;
}

const char* scenario_name()
{
#if SCENARIO_NUM == 1
    return "Case1 GM int32 single-address, no return value";
#elif SCENARIO_NUM == 2
    return "Case1 UB int32 two-level reduction, no return value";
#elif SCENARIO_NUM == 3
    return "Case2 GM int32 single-address, no return value";
#elif SCENARIO_NUM == 4
    return "Case2 UB int32 two-level reduction, no return value";
#elif SCENARIO_NUM == 5
    return "Case3 GM int32 single-address, with return value";
#elif SCENARIO_NUM == 6
    return "Case3 GM int32 single-address, no return value";
#elif SCENARIO_NUM == 7
    return "Case3 UB int32 two-level reduction, with return value";
#elif SCENARIO_NUM == 8
    return "Case3 UB int32 two-level reduction, no return value";
#elif SCENARIO_NUM == 9
    return "Case4 GM int32 dense, no return value";
#elif SCENARIO_NUM == 10
    return "Case4 GM int64 dense, no return value";
#elif SCENARIO_NUM == 11
    return "Case5 GM int32 dense, with return value";
#elif SCENARIO_NUM == 12
    return "Case5 GM int64 dense, with return value";
#endif
}

void run_selected_kernel(aclrtStream stream, int32_t* gm_i32, int64_t* gm_i64)
{
    constexpr uint32_t dynamic_ubuf_size = 0;
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 3
    atomic_add_gm_single_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_single_no_return");
#elif SCENARIO_NUM == 2 || SCENARIO_NUM == 4
    atomic_add_ub_reduce_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_ub_reduce_no_return");
#elif SCENARIO_NUM == 5
    atomic_add_gm_single_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_single_return");
#elif SCENARIO_NUM == 6
    atomic_add_gm_single_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_single_no_return");
#elif SCENARIO_NUM == 7
    atomic_add_ub_reduce_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_ub_reduce_return");
#elif SCENARIO_NUM == 8
    atomic_add_ub_reduce_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_ub_reduce_no_return");
#elif SCENARIO_NUM == 9
    atomic_add_gm_dense_i32_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_dense_i32_no_return");
#elif SCENARIO_NUM == 10
    atomic_add_gm_dense_i64_no_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i64);
    CHECK_ACL_LAUNCH("atomic_add_gm_dense_i64_no_return");
#elif SCENARIO_NUM == 11
    atomic_add_gm_dense_i32_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i32);
    CHECK_ACL_LAUNCH("atomic_add_gm_dense_i32_return");
#elif SCENARIO_NUM == 12
    atomic_add_gm_dense_i64_return<<<dim3(kBlockNum), dim3(kThreadsPerBlock), dynamic_ubuf_size, stream>>>(gm_i64);
    CHECK_ACL_LAUNCH("atomic_add_gm_dense_i64_return");
#endif
    CHECK_ACL(aclrtSynchronizeStream(stream));
}

// File-scope buffers keep the dense target arrays off the stack. Only the dense
// scenarios use the full arrays; single/reduce scenarios use element [0].
static int32_t g_raw_i32[kTargetCount];
static int64_t g_raw_i64[kTargetCount];

// Single-address / reduction: one counter holds every atomic add.
static bool check_single_total(uint64_t actual)
{
    if (actual != kTotalAtomicAdds) {
        std::fprintf(stderr, "Validation failed: counter=%lu expected=%lu\n", actual, kTotalAtomicAdds);
        return false;
    }
    return true;
}

// Dense: threads map to targets via (globalTid % kTargetCount). Target i is hit
// by every thread whose global id is congruent to i modulo kTargetCount, i.e.
// floor(T/N) threads, plus one more for the first (T % N) targets. The counts
// must match exactly and sum to kTotalAtomicAdds.
static bool check_dense_counts(const int64_t* counts)
{
    const uint64_t base = kTotalThreads / kTargetCount;
    const uint64_t rem = kTotalThreads % kTargetCount;
    uint64_t total = 0;
    for (uint64_t i = 0; i < kTargetCount; ++i) {
        const uint64_t expected = base + (i < rem ? 1 : 0);
        const uint64_t actual = (uint64_t)counts[i];
        if (actual != expected) {
            std::fprintf(stderr, "Validation failed: counter[%lu]=%lu expected=%lu\n", i, actual, expected);
            return false;
        }
        total += actual;
    }
    if (total != kTotalAtomicAdds) {
        std::fprintf(stderr, "Validation failed: total=%lu expected=%lu\n", total, kTotalAtomicAdds);
        return false;
    }
    return true;
}

bool validate_result(int32_t* gm_i32, int64_t* gm_i64)
{
#if SC_SINGLE_GM || SC_UB_REDUCE
    int32_t counter = 0;
    CHECK_ACL(aclrtMemcpy(&counter, sizeof(counter), gm_i32, sizeof(counter), ACL_MEMCPY_DEVICE_TO_HOST));
    return check_single_total((uint64_t)counter);
#elif SC_DENSE_I32
    const uint64_t bytes = kTargetCount * sizeof(int32_t);
    CHECK_ACL(aclrtMemcpy(g_raw_i32, bytes, gm_i32, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    for (uint64_t i = 0; i < kTargetCount; ++i) {
        g_raw_i64[i] = (int64_t)g_raw_i32[i];
    }
    return check_dense_counts(g_raw_i64);
#else  // SC_DENSE_I64
    const uint64_t bytes = kTargetCount * sizeof(int64_t);
    CHECK_ACL(aclrtMemcpy(g_raw_i64, bytes, gm_i64, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    return check_dense_counts(g_raw_i64);
#endif
}

int main()
{
    // Single-address counters accumulate kTotalAtomicAdds; dense counters hold 1
    // each. Both must fit int32.
#if SC_SINGLE_GM || SC_UB_REDUCE
    static_assert(kTotalAtomicAdds <= (uint64_t)INT32_MAX, "single-address counter must not overflow int32");
#endif

    std::printf("Scenario %u: %s\n", (uint32_t)SCENARIO_NUM, scenario_name());
    std::printf(
        "Workload: blocks=%u threads_per_block=%u total_atomic_adds=%lu\n", kBlockNum, kThreadsPerBlock,
        kTotalAtomicAdds);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    int32_t* gm_i32 = nullptr;
    int64_t* gm_i64 = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

#if SC_SINGLE_GM || SC_UB_REDUCE
    const uint64_t i32_bytes = sizeof(int32_t);  // one shared counter
#elif SC_DENSE_I32
    const uint64_t i32_bytes = kTargetCount * sizeof(int32_t);
#endif
#if SC_SINGLE_GM || SC_UB_REDUCE || SC_DENSE_I32
    CHECK_ACL(aclrtMalloc((void**)(&gm_i32), i32_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(gm_i32, i32_bytes, 0, i32_bytes));
#else  // SC_DENSE_I64
    const uint64_t i64_bytes = kTargetCount * sizeof(int64_t);
    CHECK_ACL(aclrtMalloc((void**)(&gm_i64), i64_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(gm_i64, i64_bytes, 0, i64_bytes));
#endif

    run_selected_kernel(stream, gm_i32, gm_i64);

#if SKIP_VALIDATION
    const bool matched = true;
    std::printf("Validation skipped\n");
#else
    const bool matched = validate_result(gm_i32, gm_i64);
    std::printf("%s\n", matched ? "Validation passed" : "Validation failed");
#endif

    if (gm_i64 != nullptr) {
        aclrtFree(gm_i64);
    }
    if (gm_i32 != nullptr) {
        aclrtFree(gm_i32);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return matched ? EXIT_SUCCESS : EXIT_FAILURE;
}
