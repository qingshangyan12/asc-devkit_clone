/* !
 * \file atomic_add_perf.asc
 * \brief SIMT asc_atomic_add performance workload sample.
 *
 * Sixteen scenarios grouped into five cases. Each scenario runs exactly one
 * kernel; pick it with -DSCENARIO_NUM=<n>. Every active thread issues one +1
 * update.
 *
 * The scenario -> config mapping lives in get_scenario_config(); every other
 * function reads the returned ScenarioConfig fields at runtime, so there is a
 * single point of scenario-specific branching instead of scattered #if chains.
 *
 *   Case 1  single GM address vs single UB address, one block, 1024 threads
 *           S1  GM  int32  direct atomic add   (no return value)
 *           S2  UB  int32  direct atomic add   (no return value)
 *   Case 2  same GM address hit by 8 blocks x 1024 threads
 *           S3  GM  int32  direct atomic add   (no return value)
 *           S4  UB  int32  block-local accumulation before GM writeback
 *   Case 3  return-value overhead, one block, 2048 threads on one address
 *           S5  GM  int32  with    return value
 *           S6  GM  int32  without return value
 *           S7  UB  int32  with    return value
 *           S8  UB  int32  without return value
 *   Case 4  same-address contention and Sector distribution, with return value,
 *           48 blocks x 256 threads and 32 logical int32 targets. Every active
 *           thread issues one update.
 *           S9   GM int32  padded  1 thread/addr
 *           S10  GM int32  padded  12 threads/addr
 *           S11  GM int32  padded  384 threads/addr
 *           S12  GM int32  dense   384 threads/addr
 *   Case 5  int32 vs int64 choice depends on whether the return value is used,
 *           dense per-thread counters, 48 blocks x 256 threads, target_count 1024
 *           S13  GM int32  (no return value)
 *           S14  GM int64  (no return value)
 *           S15  GM int32  (with return value)
 *           S16  GM int64  (with return value)
 */

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 16
#error "SCENARIO_NUM must be one of 1..16."
#endif

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

namespace {

// Upper bound on threads per block across all scenarios; used as the single
// __launch_bounds__ value for every kernel (actual launches may use fewer).
constexpr uint32_t MAX_THREADS_PER_BLOCK = 2048;

// Case 4 keeps 32 logical targets. Padded layouts place one target in each
// 128B Sector; the dense layout uses adjacent elements. Case 5 keeps its
// existing 1024 adjacent targets.
constexpr uint64_t MAX_PHYSICAL_TARGET_COUNT = 1024;

// Each kernel variant. Single/UB accumulation kernels and Case 4 operate on
// int32; Case 5 keeps its original dense int32/int64 variants.
enum class KernelType {
    GM_SINGLE_NO_RETURN,      // S1, S3, S6
    GM_SINGLE_RETURN,         // S5
    UB_LOCAL_NO_RETURN,       // S2, S8
    UB_LOCAL_RETURN,          // S7
    UB_BLOCK_ACCUM_NO_RETURN, // S4
    GM_CASE4_I32_RETURN,      // S9, S10, S11, S12
    GM_DENSE_I32_NO_RETURN,   // S13
    GM_DENSE_I64_NO_RETURN,   // S14
    GM_DENSE_I32_RETURN,      // S15
    GM_DENSE_I64_RETURN,      // S16
};

struct ScenarioConfig {
    uint32_t blocks;
    uint32_t threads;
    uint64_t target_count;
    uint64_t threads_per_target;
    uint64_t target_stride; // element stride; 0 for single/UB accumulation scenarios
    KernelType kernel;
    const char* name;
};

// Single source of truth for scenario -> config. Every other function reads
// these fields at runtime instead of re-deriving them from SCENARIO_NUM.
ScenarioConfig get_scenario_config(uint32_t scenario)
{
    switch (scenario) {
        case 1:
            return {
                1, 1024, 0, 0, 0, KernelType::GM_SINGLE_NO_RETURN, "Case1 GM int32 single-address, no return value"};
        case 2:
            return {1, 1024, 0, 0, 0, KernelType::UB_LOCAL_NO_RETURN, "Case1 UB int32 single-address, no return value"};
        case 3:
            return {
                8, 1024, 0, 0, 0, KernelType::GM_SINGLE_NO_RETURN, "Case2 GM int32 single-address, no return value"};
        case 4:
            return {8,
                    1024,
                    0,
                    0,
                    0,
                    KernelType::UB_BLOCK_ACCUM_NO_RETURN,
                    "Case2 UB int32 block-local accumulation, no return value"};
        case 5:
            return {1, 2048, 0, 0, 0, KernelType::GM_SINGLE_RETURN, "Case3 GM int32 single-address, with return value"};
        case 6:
            return {
                1, 2048, 0, 0, 0, KernelType::GM_SINGLE_NO_RETURN, "Case3 GM int32 single-address, no return value"};
        case 7:
            return {1, 2048, 0, 0, 0, KernelType::UB_LOCAL_RETURN, "Case3 UB int32 single-address, with return value"};
        case 8:
            return {1, 2048, 0, 0, 0, KernelType::UB_LOCAL_NO_RETURN, "Case3 UB int32 single-address, no return value"};
        // Case 4: every active thread performs one atomic add. Padded targets
        // use one address per 128B Sector; scenario 12 switches only the layout.
        case 9:
            return {48, 256, 32, 1, 32, KernelType::GM_CASE4_I32_RETURN, "Case4 GM int32 padded, 1 thread/addr"};
        case 10:
            return {48, 256, 32, 12, 32, KernelType::GM_CASE4_I32_RETURN, "Case4 GM int32 padded, 12 threads/addr"};
        case 11:
            return {48, 256, 32, 384, 32, KernelType::GM_CASE4_I32_RETURN, "Case4 GM int32 padded, 384 threads/addr"};
        case 12:
            return {48, 256, 32, 384, 1, KernelType::GM_CASE4_I32_RETURN, "Case4 GM int32 dense, 384 threads/addr"};
        case 13:
            return {48, 256, 1024, 12, 1, KernelType::GM_DENSE_I32_NO_RETURN, "Case5 GM int32 dense, no return value"};
        case 14:
            return {48, 256, 1024, 12, 1, KernelType::GM_DENSE_I64_NO_RETURN, "Case5 GM int64 dense, no return value"};
        case 15:
            return {48, 256, 1024, 12, 1, KernelType::GM_DENSE_I32_RETURN, "Case5 GM int32 dense, with return value"};
        case 16:
            return {48, 256, 1024, 12, 1, KernelType::GM_DENSE_I64_RETURN, "Case5 GM int64 dense, with return value"};
        default:
            return {1, 2048, 0, 0, 0, KernelType::GM_SINGLE_NO_RETURN, "unknown"};
    }
}

bool uses_target_pool(KernelType k)
{
    return k == KernelType::GM_CASE4_I32_RETURN || k == KernelType::GM_DENSE_I32_NO_RETURN ||
           k == KernelType::GM_DENSE_I64_NO_RETURN || k == KernelType::GM_DENSE_I32_RETURN ||
           k == KernelType::GM_DENSE_I64_RETURN;
}

bool is_case4(KernelType k) { return k == KernelType::GM_CASE4_I32_RETURN; }

bool is_i64(KernelType k) { return k == KernelType::GM_DENSE_I64_NO_RETURN || k == KernelType::GM_DENSE_I64_RETURN; }

bool writes_gm_result(KernelType k) { return k != KernelType::UB_LOCAL_NO_RETURN && k != KernelType::UB_LOCAL_RETURN; }

uint64_t get_physical_target_count(const ScenarioConfig& config)
{
    return uses_target_pool(config.kernel) ? (config.target_count - 1) * config.target_stride + 1 : 1;
}

} // namespace

void check_acl(aclError result, const char* const func, const char* const file, int const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, (int)result, aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}

void check_acl_launch(const char* kernel_name, const char* const file, int const line)
{
    const aclError result = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d kernel=\"%s\" code=%d(%s)\n", file, line, kernel_name, (int)result,
            aclGetRecentErrMsg());
        std::exit(EXIT_FAILURE);
    }
}

#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)
#define CHECK_ACL_LAUNCH(kernel_name) check_acl_launch((kernel_name), __FILE__, __LINE__)

// ---------------------------------------------------------------------------
// Case 1 / 2 / 3 -- single GM address.
// Every thread does one asc_atomic_add on the SAME gm counter, so the counter
// is contended by all (blocks x threads) threads at once: maximum contention.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_single_return(int32_t* counter)
{
    volatile int32_t old_value_sink = asc_atomic_add(counter, 1);
    (void)old_value_sink;
}

__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_single_no_return(int32_t* counter)
{
    asc_atomic_add(counter, 1);
}

// ---------------------------------------------------------------------------
// Case 1 / 3 -- single UB address.
// These kernels only call asc_atomic_add on UB and do not write a result back
// to GM. They are pure interface-call workloads for memory-tier and return-
// value comparisons.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_ub_local_return()
{
    __ubuf__ int32_t local[1];
    volatile int32_t old_value_sink = asc_atomic_add(&local[0], 1);
    (void)old_value_sink;
}

__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_ub_local_no_return()
{
    __ubuf__ int32_t local[1];
    asc_atomic_add(&local[0], 1);
}

// ---------------------------------------------------------------------------
// Case 2 -- block-local UB accumulation before GM writeback.
// Each block accumulates into one private UB counter, then thread 0 adds the
// block subtotal into the single shared GM result. GM atomics drop from
// (blocks x threads) down to blocks.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_ub_block_accum_no_return(int32_t* gm_result)
{
    __ubuf__ int32_t local[1];
    if (threadIdx.x == 0) {
        local[0] = 0;
    }
    asc_syncthreads();

    asc_atomic_add(&local[0], 1);
    asc_syncthreads();

    if (threadIdx.x == 0) {
        asc_atomic_add(gm_result, local[0]);
    }
}

// ---------------------------------------------------------------------------
// Case 4 / 5 -- multiple GM targets.
// Case 4 uses one atomic add per active thread. Padded scenarios place one
// target in each 128B Sector and vary the number of threads assigned to each
// target. The dense scenario keeps the same workload as the strongest padded
// scenario and uses adjacent targets. Case 5 uses dense targets.
// ---------------------------------------------------------------------------
__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_dense_i32_no_return(
    int32_t* counters, uint64_t target_count)
{
    asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % target_count), 1);
}

__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_dense_i64_no_return(
    int64_t* counters, uint64_t target_count)
{
    asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % target_count), 1LL);
}

__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_case4_i32_return(
    int32_t* counters, uint64_t target_count, uint64_t threads_per_target, uint64_t target_stride)
{
    uint64_t global_tid = blockIdx.x * blockDim.x + threadIdx.x;
    uint64_t active_threads = target_count * threads_per_target;
    if (global_tid >= active_threads) {
        return;
    }

    uint64_t target_id = global_tid % target_count;
    int32_t* target = counters + target_id * target_stride;
    volatile int32_t old_value_sink = asc_atomic_add(target, 1);
    (void)old_value_sink;
}

__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_dense_i32_return(
    int32_t* counters, uint64_t target_count)
{
    volatile int32_t old_value_sink =
        asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % target_count), 1);
    (void)old_value_sink;
}

__global__ __launch_bounds__(MAX_THREADS_PER_BLOCK) void atomic_add_gm_dense_i64_return(
    int64_t* counters, uint64_t target_count)
{
    volatile int64_t old_value_sink =
        asc_atomic_add(counters + ((blockIdx.x * blockDim.x + threadIdx.x) % target_count), 1LL);
    (void)old_value_sink;
}

// Dispatch the kernel selected by config. A single runtime switch replaces the
// old per-scenario #if/#elif chain.
void run_selected_kernel(aclrtStream stream, const ScenarioConfig& config, int32_t* gm_i32, int64_t* gm_i64)
{
    switch (config.kernel) {
        case KernelType::GM_SINGLE_NO_RETURN:
            atomic_add_gm_single_no_return<<<config.blocks, config.threads, 0, stream>>>(gm_i32);
            CHECK_ACL_LAUNCH("atomic_add_gm_single_no_return");
            break;
        case KernelType::GM_SINGLE_RETURN:
            atomic_add_gm_single_return<<<config.blocks, config.threads, 0, stream>>>(gm_i32);
            CHECK_ACL_LAUNCH("atomic_add_gm_single_return");
            break;
        case KernelType::UB_LOCAL_NO_RETURN:
            atomic_add_ub_local_no_return<<<config.blocks, config.threads, 0, stream>>>();
            CHECK_ACL_LAUNCH("atomic_add_ub_local_no_return");
            break;
        case KernelType::UB_LOCAL_RETURN:
            atomic_add_ub_local_return<<<config.blocks, config.threads, 0, stream>>>();
            CHECK_ACL_LAUNCH("atomic_add_ub_local_return");
            break;
        case KernelType::UB_BLOCK_ACCUM_NO_RETURN:
            atomic_add_ub_block_accum_no_return<<<config.blocks, config.threads, 0, stream>>>(gm_i32);
            CHECK_ACL_LAUNCH("atomic_add_ub_block_accum_no_return");
            break;
        case KernelType::GM_CASE4_I32_RETURN:
            atomic_add_gm_case4_i32_return<<<config.blocks, config.threads, 0, stream>>>(
                gm_i32, config.target_count, config.threads_per_target, config.target_stride);
            CHECK_ACL_LAUNCH("atomic_add_gm_case4_i32_return");
            break;
        case KernelType::GM_DENSE_I32_NO_RETURN:
            atomic_add_gm_dense_i32_no_return<<<config.blocks, config.threads, 0, stream>>>(
                gm_i32, config.target_count);
            CHECK_ACL_LAUNCH("atomic_add_gm_dense_i32_no_return");
            break;
        case KernelType::GM_DENSE_I64_NO_RETURN:
            atomic_add_gm_dense_i64_no_return<<<config.blocks, config.threads, 0, stream>>>(
                gm_i64, config.target_count);
            CHECK_ACL_LAUNCH("atomic_add_gm_dense_i64_no_return");
            break;
        case KernelType::GM_DENSE_I32_RETURN:
            atomic_add_gm_dense_i32_return<<<config.blocks, config.threads, 0, stream>>>(gm_i32, config.target_count);
            CHECK_ACL_LAUNCH("atomic_add_gm_dense_i32_return");
            break;
        case KernelType::GM_DENSE_I64_RETURN:
            atomic_add_gm_dense_i64_return<<<config.blocks, config.threads, 0, stream>>>(gm_i64, config.target_count);
            CHECK_ACL_LAUNCH("atomic_add_gm_dense_i64_return");
            break;
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));
}

// File-scope buffers keep multi-target result arrays off the stack.
static int32_t g_raw_i32[MAX_PHYSICAL_TARGET_COUNT];
static int64_t g_raw_i64[MAX_PHYSICAL_TARGET_COUNT];

// Single-address / block-local accumulation: one counter holds every atomic add.
static bool check_single_total(uint64_t actual, uint64_t expected)
{
    if (actual != expected) {
        std::fprintf(stderr, "Validation failed: counter=%lu expected=%lu\n", actual, expected);
        return false;
    }
    return true;
}

// Multi-target scenarios assign the same number of threads to every logical
// target. target_stride maps each logical target to its physical element in
// either a padded or dense allocation.
static bool check_target_counts(
    const int64_t* counts, uint64_t target_count, uint64_t target_stride, uint64_t expected_per_target,
    uint64_t total_atomic_adds)
{
    uint64_t total = 0;
    for (uint64_t i = 0; i < target_count; ++i) {
        const uint64_t physical_index = i * target_stride;
        const uint64_t actual = (uint64_t)counts[physical_index];
        if (actual != expected_per_target) {
            std::fprintf(
                stderr, "Validation failed: counter[%lu]=%lu expected=%lu\n", physical_index, actual,
                expected_per_target);
            return false;
        }
        total += actual;
    }
    if (total != total_atomic_adds) {
        std::fprintf(stderr, "Validation failed: total=%lu expected=%lu\n", total, total_atomic_adds);
        return false;
    }
    return true;
}

bool validate_result(const ScenarioConfig& config, int32_t* gm_i32, int64_t* gm_i64, uint64_t total_atomic_adds)
{
    if (!uses_target_pool(config.kernel)) {
        // Single-address / block-local accumulation: one int32 counter holds every atomic add.
        int32_t counter = 0;
        CHECK_ACL(aclrtMemcpy(&counter, sizeof(counter), gm_i32, sizeof(counter), ACL_MEMCPY_DEVICE_TO_HOST));
        return check_single_total((uint64_t)counter, total_atomic_adds);
    }
    const uint64_t physical_count = get_physical_target_count(config);
    const uint64_t expected_per_target = config.threads_per_target;
    if (!is_i64(config.kernel)) {
        // Widen int32 values to int64 to reuse check_target_counts.
        const uint64_t bytes = physical_count * sizeof(int32_t);
        CHECK_ACL(aclrtMemcpy(g_raw_i32, bytes, gm_i32, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        for (uint64_t i = 0; i < physical_count; ++i) {
            g_raw_i64[i] = (int64_t)g_raw_i32[i];
        }
        return check_target_counts(
            g_raw_i64, config.target_count, config.target_stride, expected_per_target, total_atomic_adds);
    }
    const uint64_t bytes = physical_count * sizeof(int64_t);
    CHECK_ACL(aclrtMemcpy(g_raw_i64, bytes, gm_i64, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    return check_target_counts(
        g_raw_i64, config.target_count, config.target_stride, expected_per_target, total_atomic_adds);
}

int main()
{
    const ScenarioConfig config = get_scenario_config(SCENARIO_NUM);
    const uint64_t launched_threads = (uint64_t)config.blocks * config.threads;
    const uint64_t active_threads =
        uses_target_pool(config.kernel) ? config.target_count * config.threads_per_target : launched_threads;
    const uint64_t total_atomic_adds = active_threads;
    const uint64_t physical_count = get_physical_target_count(config);
    const bool align_target_base = is_case4(config.kernel);

    if (active_threads > launched_threads) {
        std::fprintf(
            stderr, "active threads must not exceed launched threads (active=%lu launched=%lu)\n", active_threads,
            launched_threads);
        return EXIT_FAILURE;
    }
    if (physical_count > MAX_PHYSICAL_TARGET_COUNT) {
        std::fprintf(
            stderr, "physical target count exceeds host buffer (count=%lu limit=%lu)\n", physical_count,
            MAX_PHYSICAL_TARGET_COUNT);
        return EXIT_FAILURE;
    }

    // GM result counters accumulate total_atomic_adds and must fit int32.
    if (writes_gm_result(config.kernel) && !uses_target_pool(config.kernel) &&
        total_atomic_adds > (uint64_t)INT32_MAX) {
        std::fprintf(
            stderr, "single-address counter must not overflow int32 (total_atomic_adds=%lu)\n", total_atomic_adds);
        return EXIT_FAILURE;
    }

    std::printf("Scenario %u: %s\n", (uint32_t)SCENARIO_NUM, config.name);
    std::printf(
        "Workload: blocks=%u threads_per_block=%u total_atomic_adds=%lu\n", config.blocks, config.threads,
        total_atomic_adds);
    if (uses_target_pool(config.kernel)) {
        std::printf(
            "Targets: count=%lu threads_per_target=%lu stride=%lu\n", config.target_count, config.threads_per_target,
            config.target_stride);
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    int32_t* gm_i32 = nullptr;
    int64_t* gm_i64 = nullptr;
    int32_t* gm_i32_allocation = nullptr;
    int64_t* gm_i64_allocation = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    if (!is_i64(config.kernel)) {
        const uint64_t i32_bytes = physical_count * sizeof(int32_t);
        const uint64_t alloc_bytes = i32_bytes + (align_target_base ? 127 : 0);
        CHECK_ACL(aclrtMalloc((void**)(&gm_i32_allocation), alloc_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        gm_i32 = gm_i32_allocation;
        if (align_target_base) {
            gm_i32 = (int32_t*)(((uintptr_t)gm_i32_allocation + 127) & ~(uintptr_t)127);
        }
        CHECK_ACL(aclrtMemset(gm_i32, i32_bytes, 0, i32_bytes));
    } else {
        const uint64_t i64_bytes = physical_count * sizeof(int64_t);
        CHECK_ACL(aclrtMalloc((void**)(&gm_i64_allocation), i64_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        gm_i64 = gm_i64_allocation;
        CHECK_ACL(aclrtMemset(gm_i64, i64_bytes, 0, i64_bytes));
    }

    run_selected_kernel(stream, config, gm_i32, gm_i64);

#if SKIP_VALIDATION
    const bool matched = true;
    std::printf("Validation skipped\n");
#else
    const bool matched = !writes_gm_result(config.kernel) || validate_result(config, gm_i32, gm_i64, total_atomic_adds);
    if (!writes_gm_result(config.kernel)) {
        std::printf("Validation skipped: UB-only scenario has no GM result\n");
    } else {
        std::printf("%s\n", matched ? "Validation passed" : "Validation failed");
    }
#endif

    if (gm_i64_allocation != nullptr) {
        aclrtFree(gm_i64_allocation);
    }
    if (gm_i32_allocation != nullptr) {
        aclrtFree(gm_i32_allocation);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return matched ? EXIT_SUCCESS : EXIT_FAILURE;
}
