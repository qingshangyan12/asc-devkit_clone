#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr int TILE_DIM = 32;
// Repeat count used to reduce timing noise.
constexpr int NUM_REPS = 100;

inline bool verify_result(const std::vector<float> &output, const std::vector<float> &golden, float abs_tolerance)
{
    if (output.size() != golden.size()) {
        return false;
    }
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::fabs(output[i] - golden[i]) > abs_tolerance) {
            return false;
        }
    }
    return true;
}

void compute_transpose_gold(std::vector<float> &output, const std::vector<float> &input, int width, int height)
{
    // Host reference transpose:
    // output(col, row) = input(row, col)
    for (int row = 0; row < height; ++row) {
        for (int col = 0; col < width; ++col) {
            output[static_cast<size_t>(col) * height + row] =
                input[static_cast<size_t>(row) * width + col];
        }
    }
}
} // namespace

__global__ void copy_kernel(float *output, const float *input, int width, int height)
{
    // One thread handles one element in the current 32x32 tile.
    int x_index = blockIdx.x * TILE_DIM + threadIdx.x;
    int y_index = blockIdx.y * TILE_DIM + threadIdx.y;
    int index = x_index + width * y_index;

    output[index] = input[index];
}

__global__ void copy_shared_mem_kernel(float *output, const float *input, int width, int height)
{
    // Shared-memory staging buffer for the current tile.
    __ubuf__ float tile[TILE_DIM][TILE_DIM];

    int x_index = blockIdx.x * TILE_DIM + threadIdx.x;
    int y_index = blockIdx.y * TILE_DIM + threadIdx.y;
    int index = x_index + width * y_index;

    // GM -> UB.
    tile[threadIdx.y][threadIdx.x] = input[index];
    // Wait until the whole tile is available in UB.
    asc_syncthreads();
    // UB -> GM.
    output[index] = tile[threadIdx.y][threadIdx.x];
}

__global__ void transpose_naive_kernel(float *output, const float *input, int width, int height)
{
    // Original coordinates in input.
    int x_index = blockIdx.x * TILE_DIM + threadIdx.x;
    int y_index = blockIdx.y * TILE_DIM + threadIdx.y;

    int index_in = x_index + width * y_index;
    // Transposed coordinates in output.
    int index_out = y_index + height * x_index;

    output[index_out] = input[index_in];
}

__global__ void transpose_coalesced_kernel(float *output, const float *input, int width, int height)
{
    // Shared-memory tile used to reorganize global accesses.
    __ubuf__ float tile[TILE_DIM][TILE_DIM];

    // Read one input element from the current tile.
    int x_index = blockIdx.x * TILE_DIM + threadIdx.x;
    int y_index = blockIdx.y * TILE_DIM + threadIdx.y;
    int index_in = x_index + y_index * width;

    // GM -> UB with original layout.
    tile[threadIdx.y][threadIdx.x] = input[index_in];
    asc_syncthreads();

    // Swap block coordinates to point at the transposed output tile.
    x_index = blockIdx.y * TILE_DIM + threadIdx.x;
    y_index = blockIdx.x * TILE_DIM + threadIdx.y;
    int index_out = x_index + y_index * height;

    // Read transposed coordinates from UB and write back to GM.
    output[index_out] = tile[threadIdx.x][threadIdx.y];
}

__global__ void transpose_avoid_bank_conflicts_kernel(float *output, const float *input, int width, int height)
{
    // +1 padding changes the UB row stride to mitigate bank conflicts.
    __ubuf__ float tile[TILE_DIM][TILE_DIM + 1];

    int x_index = blockIdx.x * TILE_DIM + threadIdx.x;
    int y_index = blockIdx.y * TILE_DIM + threadIdx.y;
    int index_in = x_index + y_index * width;

    // GM -> UB with original layout.
    tile[threadIdx.y][threadIdx.x] = input[index_in];
    asc_syncthreads();

    // Swap block coordinates to point at the transposed output tile.
    x_index = blockIdx.y * TILE_DIM + threadIdx.x;
    y_index = blockIdx.x * TILE_DIM + threadIdx.y;
    int index_out = x_index + y_index * height;

    // Read transposed coordinates from the padded UB tile.
    output[index_out] = tile[threadIdx.x][threadIdx.y];
}

enum KernelKind {
    K_COPY = 0,
    K_COPY_SHARED = 1,
    K_TRANSPOSE_NAIVE = 2,
    K_TRANSPOSE_COALESCED = 3,
    K_TRANSPOSE_AVOID_BANK_CONFLICTS = 4,
};

int32_t run_transpose_benchmark(const std::vector<float> &input_host,
                                const std::vector<float> &golden_host,
                                int32_t matrix_width,
                                int32_t matrix_height)
{
    const size_t tensor_elem_count = input_host.size();
    const size_t tensor_byte_size = tensor_elem_count * sizeof(float);
    std::vector<float> output_host(tensor_elem_count, 0.0f);

    // Runtime setup.
    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float *input_device = nullptr;
    float *output_device = nullptr;
    // Allocate one input matrix and one output matrix in device memory.
    aclrtMalloc(reinterpret_cast<void **>(&input_device), tensor_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&output_device), tensor_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    // Upload the input matrix once; all kernels reuse it.
    aclrtMemcpy(input_device, tensor_byte_size, input_host.data(), tensor_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    // One block handles one 32x32 tile with 32x32 threads.
    dim3 grid(static_cast<uint32_t>(matrix_width / TILE_DIM), static_cast<uint32_t>(matrix_height / TILE_DIM), 1);
    dim3 block(static_cast<uint32_t>(TILE_DIM), static_cast<uint32_t>(TILE_DIM), 1);

    const char *kernel_name = nullptr;
    for (int kernel_kind = K_COPY; kernel_kind <= K_TRANSPOSE_AVOID_BANK_CONFLICTS; ++kernel_kind) {
        switch (kernel_kind) {
            case K_COPY:
                kernel_name = "copy";
                break;
            case K_COPY_SHARED:
                kernel_name = "copy_shared_mem";
                break;
            case K_TRANSPOSE_NAIVE:
                kernel_name = "transpose_naive";
                break;
            case K_TRANSPOSE_COALESCED:
                kernel_name = "transpose_coalesced";
                break;
            case K_TRANSPOSE_AVOID_BANK_CONFLICTS:
                kernel_name = "transpose_avoid_bank_conflicts";
                break;
            default:
                kernel_name = "unknown";
                break;
        }

        std::fill(output_host.begin(), output_host.end(), 0.0f);
        // Reset output on device before each kernel benchmark.
        aclrtMemcpy(output_device, tensor_byte_size, output_host.data(), tensor_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

        auto launch_kernel = [&](int kind) {
            if (kind == K_COPY) {
                copy_kernel<<<grid, block, 0, stream>>>(output_device, input_device, matrix_width, matrix_height);
            } else if (kind == K_COPY_SHARED) {
                copy_shared_mem_kernel<<<grid, block, 0, stream>>>(output_device, input_device, matrix_width, matrix_height);
            } else if (kind == K_TRANSPOSE_NAIVE) {
                transpose_naive_kernel<<<grid, block, 0, stream>>>(output_device, input_device, matrix_width, matrix_height);
            } else if (kind == K_TRANSPOSE_COALESCED) {
                transpose_coalesced_kernel<<<grid, block, 0, stream>>>(output_device, input_device, matrix_width, matrix_height);
            } else if (kind == K_TRANSPOSE_AVOID_BANK_CONFLICTS) {
                transpose_avoid_bank_conflicts_kernel<<<grid, block, 0, stream>>>(output_device, input_device, matrix_width, matrix_height);
            }
        };

        // Warmup launch to avoid first-launch overhead in measured time.
        launch_kernel(kernel_kind);
        aclrtGetLastError(ACL_RT_THREAD_LEVEL);
        aclrtSynchronizeStream(stream);

        aclrtEvent start_evt = nullptr;
        aclrtEvent stop_evt = nullptr;
        aclrtCreateEvent(&start_evt);
        aclrtCreateEvent(&stop_evt);

        // Timed kernel loop.
        aclrtRecordEvent(start_evt, stream);
        for (int rep = 0; rep < NUM_REPS; ++rep) {
            launch_kernel(kernel_kind);
            aclrtGetLastError(ACL_RT_THREAD_LEVEL);
        }
        aclrtRecordEvent(stop_evt, stream);
        aclrtSynchronizeEvent(stop_evt);

        float kernel_time_ms = 0.0f;
        // aclrtEventElapsedTime returns elapsed time in milliseconds.
        aclrtEventElapsedTime(&kernel_time_ms, start_evt, stop_evt);

        aclrtMemcpy(output_host.data(), tensor_byte_size, output_device, tensor_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

        // Copy kernels are checked against the input; transpose kernels against the golden transpose.
        bool ok = false;
        if (kernel_kind == K_COPY || kernel_kind == K_COPY_SHARED) {
            ok = verify_result(output_host, input_host, 1e-3f);
        } else {
            ok = verify_result(output_host, golden_host, 1e-3f);
        }

        const float ms_per_iter = kernel_time_ms / static_cast<float>(NUM_REPS);
        // Effective bandwidth:
        // bytes / ms = 10^6 bytes / s, so dividing by 1e6 converts to GB/s.
        // The factor 2 counts one full input read and one full output write.
        const float gbps = static_cast<float>((2.0 * tensor_byte_size) / (ms_per_iter * 1e6));

        std::printf("transpose %-20s Throughput = %.4f GB/s, Time = %.5f ms, Result = %s\n",
                    kernel_name,
                    gbps,
                    ms_per_iter,
                    ok ? "PASS" : "FAIL");

        aclrtDestroyEvent(start_evt);
        aclrtDestroyEvent(stop_evt);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}

int main(int argc, char **argv)
{
    int32_t matrix_width = 1024;
    int32_t matrix_height = 1024;

    if (matrix_width != matrix_height) {
        std::fprintf(stderr, "Only square matrices are supported in this migrated sample.\n");
        return EXIT_FAILURE;
    }

    if (matrix_width % TILE_DIM != 0 || matrix_height % TILE_DIM != 0) {
        std::fprintf(stderr, "Matrix shape must be multiple of TILE_DIM=%d.\n", TILE_DIM);
        return EXIT_FAILURE;
    }

    const size_t tensor_elem_count = static_cast<size_t>(matrix_width) * matrix_height;
    std::vector<float> input_host(tensor_elem_count);
    std::vector<float> golden_host(tensor_elem_count);

    // Initialize deterministic input data.
    for (size_t i = 0; i < tensor_elem_count; ++i) {
        input_host[i] = static_cast<float>(i * 1.25f);
    }

    // Build host reference once, then benchmark every kernel against it.
    compute_transpose_gold(golden_host, input_host, matrix_width, matrix_height);
    run_transpose_benchmark(input_host, golden_host, matrix_width, matrix_height);
    return 0;
}
