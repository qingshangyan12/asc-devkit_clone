/* !
 * \file hashtable_lookup.asc
 * \brief SoA vs AoS hash table mixed hit/miss lookup sample: one case per
 * access method, each a standalone kernel for msopprof profiling (SIMT).
 */


#ifndef SCENARIO_NUM
#define SCENARIO_NUM 3
#endif
#if SCENARIO_NUM < 0 || SCENARIO_NUM > 3
#error "SCENARIO_NUM must be one of 0, 1, 2, 3."
#endif

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <random>
#include <unordered_set>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {

// ==================== 基础常量 ====================
constexpr uint64_t EMPTY_KEY = 0xFFFFFFFFFFFFFFFFULL;  // 空槽标记

constexpr uint32_t CAPACITY = 1u << 20;  // 平铺表容量，1M 槽（2 的幂）
constexpr uint32_t DIM = 8;              // value 维度（AoS 槽 40B 的来源）
constexpr uint32_t STRIDE = 4;           // vcmp_eq4 每轮批量比较 4 个 digest
constexpr uint32_t WARP_SIZE = 32;       // 950PR warp 大小
constexpr uint32_t THREADS_PER_BLOCK = 512;  // 512 线程/block
constexpr double LOAD_FACTOR = 0.9;      // 固定负载因子
constexpr double HIT_RATIO = 0.8;        // 查询命中率（编译期固定）
constexpr uint32_t QUERY_NUM = 1u << 20;  // 查询数（混合命中/未命中）

}  // namespace

// ==================== 表结构体（字段全数组 / 内嵌数组，无指针） ====================

// AoS（Array of Structures）：一个槽 = {key, value}，value 数组内嵌槽内。
// miss 探测只读 8B key，但 value 把槽步长撑到 40B —— 布局代价的来源；
// 128B cache line 只装 3.2 个槽，探测逐行踩过整张表。
struct AoSSlot {
  uint64_t key;
  float value[DIM];
};

// SoA（Structure of Arrays）无 digest：key / value 两个字段各自成区。
// 探测只读 8B 步长的 key 区（8MB），value 区（32MB）与探测路径解耦，
// miss 路径一次也不会触碰 value 区。
struct SoaTableNoDigest {
  uint64_t key[CAPACITY];
  float value[CAPACITY][DIM];
};

// SoA + digest：key 区之前加 1B/槽的 digest 区（哈希高 8 位）。
// 探测先用 1B digest 预过滤，digest 命中（或空槽 digest）才读 8B key
// 确认；整个 digest 区 1MB，一次探测跨度 ~50B，稳落 1 条 cache line。
struct SoaTable {
  uint8_t digest[CAPACITY];
  uint64_t key[CAPACITY];
  float value[CAPACITY][DIM];
};

// ==================== 哈希 / digest ====================

// Murmur3Hash 64bit finalizer：host/device 共用同一实现，保证构表与
// 查找的哈希值、起始槽位完全一致。
__host__ __aicore__ inline uint64_t Murmur3Hash(uint64_t key) {
  key ^= key >> 33;
  key *= 0xff51afd7ed558ccdULL;
  key ^= key >> 33;
  key *= 0xc4ceb9fe1a85ec53ULL;
  key ^= key >> 33;
  return key;
}

// digest 取哈希高 8 位（1B/槽）
__host__ __aicore__ inline uint8_t DigestOf(uint64_t hashed) {
  return static_cast<uint8_t>(hashed >> 32);
}

// digest 复制 4 份拼成 word，供 vcmp_eq4 四路字节并行比较
__host__ __aicore__ inline uint32_t DigestWordOf(uint64_t hashed) {
  return static_cast<uint32_t>(DigestOf(hashed)) * 0x01010101u;
}

// ==================== SWAR 字节比较 ====================

// vcmp_eq4：4 路字节相等比较（CUDA __vcmpeq4 的软件实现），
// Hacker's Delight 6-1 风格的位并行推导，无逐字节三目/分支：
//   x = a ^ b             相等字节为 0x00；
//   d = (x & 0x7F..) + 0x7F..   每字节低 7 位求和 ≤ 0x7F + 0x7F =
//                         0xFE，无跨字节进位；字节低 7 位全 0 ⟺
//                         d 该字节 MSB = 0；
//   ~(d | x) & 0x80..     再排除 x 高位为 1（仅最高位不同）的假阳性；
//   >> 7                  产出每相等字节 0x01 的位图。
// 约 7 条 ALU 指令比完 4 个字节 —— SWAR 的本义：寄存器内位并行，
// 不浪费字节，也不引入分支。
__aicore__ inline uint32_t VcmpEq4(uint32_t a, uint32_t b) {
  const uint32_t x = a ^ b;  // 相等字节 0x00
  const uint32_t d = (x & 0x7F7F7F7Fu) + 0x7F7F7F7Fu;  // 低 7 位进位检测
  return ((~(d | x)) & 0x80808080u) >> 7;  // 0x01/相等字节
}


// ==================== 查找实现（case0-case2 共用） ====================

// AoS 查找：逐槽 8B key load（40B 步长），命中 / 空槽即返回。
// 线性探测不变量：起始位置之后遇到空槽，key 必然不存在。
__aicore__ inline bool FindAos(const AoSSlot* slots, uint64_t target_key,
                               uint32_t start) {
  uint32_t idx = start;
  for (uint32_t i = 0; i < CAPACITY; ++i) {
    const uint64_t slot_key = slots[idx].key;
    if (slot_key == target_key) {
      return true;
    }
    if (slot_key == EMPTY_KEY) {
      return false;
    }
    idx = (idx + 1) & (CAPACITY - 1);  // 全表回绕
  }
  return false;
}

// SoA（无 digest）查找：与 AoS 同算法，但 key 区 8B 紧凑步长，
// 探测不再逐行踩 value 区。
__aicore__ inline bool FindSoaNoDigest(const SoaTableNoDigest* table,
                                       uint64_t target_key, uint32_t start) {
  uint32_t idx = start;
  for (uint32_t i = 0; i < CAPACITY; ++i) {
    const uint64_t slot_key = table->key[idx];
    if (slot_key == target_key) {
      return true;
    }
    if (slot_key == EMPTY_KEY) {
      return false;
    }
    idx = (idx + 1) & (CAPACITY - 1);  // 全表回绕
  }
  return false;
}

// SoA + digest word 查找：每轮一次 4B word load（4 个 digest）+
// 两次 vcmp_eq4（先比目标 digest 找命中，再比空槽 digest 找早退），
// __ffs 消费命中位图，命中槽位读 8B key 精确确认。
// 上界 capacity + stride：第 0 轮 word 内位于 start 之前的槽被回绕
// 保护跳过，绕回重探该 word（最后一轮）时才允许作为 miss 证据。
__aicore__ inline bool FindSoaDigestVcmp(const SoaTable* table,
                                         uint64_t target_key,
                                         uint32_t start,
                                         uint32_t target_word) {
  const uint32_t empty_word = DigestWordOf(Murmur3Hash(EMPTY_KEY));
  const uint32_t first_pos = start & (CAPACITY - STRIDE);  // 对齐到 word
  for (uint32_t offset = 0; offset < CAPACITY + STRIDE; offset += STRIDE) {
    const uint32_t pos = (first_pos + offset) & (CAPACITY - 1);

    // 1. 比目标 digest：逐个消费命中槽位，key 确认（假阳性继续）
    const uint32_t probe =
        *reinterpret_cast<const uint32_t*>(table->digest + pos);
    uint32_t cmp = VcmpEq4(probe, target_word) & 0x01010101u;
    while (cmp != 0) {
      const uint32_t idx =
          pos + (((static_cast<uint32_t>(
                       __ffs(static_cast<int32_t>(cmp)))) - 1u) >> 3);
      cmp &= cmp - 1;
      if (table->key[idx] == target_key) {
        return true;
      }
    }

    // 2. 比空槽 digest：起始位置之后确认空槽 → miss 早退
    cmp = VcmpEq4(probe, empty_word) & 0x01010101u;
    while (cmp != 0) {
      const uint32_t idx =
          pos + (((static_cast<uint32_t>(
                       __ffs(static_cast<int32_t>(cmp)))) - 1u) >> 3);
      cmp &= cmp - 1;
      if (offset == 0 && idx < start) {
        continue;  // 回绕保护：第 0 轮 word 内位于 start 之前的槽，
                   // 逻辑上是回绕后才探到的，空了不能作为 miss 证据
      }
      if (table->key[idx] == EMPTY_KEY) {
        return false;  // 读 key 确认，排除 digest 假阳性
      }
    }
  }
  return false;
}

// ==================== Host 侧 ACL 返回值检查 ====================
// 任何设备/运行时调用失败立即打印错误码与位置并退出，杜绝
// “launch 失败但结果照常回读”的无效数据。
#define ACL_CHECK(expr)                                                \
  do {                                                                 \
    const int32_t acl_ret = static_cast<int32_t>(expr);                \
    if (acl_ret != ACL_SUCCESS) {                                      \
      std::fprintf(stderr, "ACL fail %d at %s:%d [%s]\n", acl_ret,     \
                   __FILE__, __LINE__, #expr);                         \
      std::exit(1);                                                    \
    }                                                                  \
  } while (0)

// ==================== Host：key 生成与逻辑槽位分配 ====================

// 生成 num 个互不重复的随机 key（固定种子，结果可复现）
std::vector<uint64_t> generate_unique_keys(size_t num) {
  std::mt19937_64 eng(12345);
  std::uniform_int_distribution<uint64_t> distr(0, (1ULL << 62) - 1);
  std::unordered_set<uint64_t> uniq;
  uniq.reserve(num);
  while (uniq.size() < num) {
    uniq.insert(distr(eng));
  }
  return std::vector<uint64_t>(uniq.begin(), uniq.end());
}

// host 单线程线性探测构表：与设备侧同一 hash、同一起点、同一探测序。
// 各 case 共享这份逻辑槽位分配（slot_keys），只差物理布局。
void build_slot_keys(const std::vector<uint64_t>& fill_keys,
                     std::vector<uint64_t>& slot_keys) {
  slot_keys.assign(CAPACITY, EMPTY_KEY);
  for (uint64_t key : fill_keys) {
    const uint64_t hashed = Murmur3Hash(key);
    uint32_t idx = static_cast<uint32_t>(hashed & (CAPACITY - 1));
    while (slot_keys[idx] != EMPTY_KEY) {
      idx = (idx + 1) & (CAPACITY - 1);  // 全表回绕，LF 0.9 必有空槽
    }
    slot_keys[idx] = key;
  }
}

// ==================== case 编号与校验 ====================

// case 编号 → 访问方式描述（main 打印用）
const char* get_case_name(int32_t case_kind) {
  switch (case_kind) {
    case 0:
      return "aos: thread-per-key, 40B slot stride (baseline)";
    case 1:
      return "soa: key region only, 8B stride";
    case 2:
      return "soa digest + vcmp_eq4 swar: 1B digest pre-filter, "
             "4-slot word compare";
    case 3:
      return "coop G=4 x swar: 16-slot window, asc_ballot";
    default:
      return "unknown";
  }
}

// 混合查询门：1M 查询的设备结果必须与 host 期望逐条一致（命中数亦须
// 相等）——被测 launch 即被校验 launch，回绕保护等逻辑错误会以
// “结果不一致”暴露。
uint32_t verify_result(size_t mismatches, size_t actual_hits,
                       size_t expected_hits) {
  printf("Hits: actual=%zu, expected=%zu\n", actual_hits, expected_hits);
  if (mismatches != 0 || actual_hits != expected_hits) {
    printf("[Failed] Case accuracy verification failed! (%zu mismatches)\n",
           mismatches);
    return 1;
  }
  printf("[Success] Case accuracy verification passed.\n");
  return 0;
}

// ==================== case 0：AoS 基线（thread-per-key） ====================
//
// 槽 = {key, value[8]} 共 40B，value 数组内嵌槽内。miss 探测逐槽读
// 8B key，40B 步长；128B cache line 只装 3.2 个槽，一次 miss 探测跨度
// ~50 × 40B = 2000B ≈ 16 line——value 内嵌撑大步长，探测逐行踩过
// 整张表。后续 case 的布局优化均以此为基线。
#if SCENARIO_NUM == 0

// thread-per-key：每线程独立处理一条查询 key；同 hash、同起点。
__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_aos_kernel(
    const AoSSlot* slots, const uint64_t* keys, uint8_t* founds,
    uint32_t query_num) {
  const uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
  if (idx >= query_num) {
    return;
  }
  bool found = false;
  const uint64_t key = keys[idx];
  if (key != EMPTY_KEY) {
    const uint64_t hashed = Murmur3Hash(key);  // 只算一次
    const uint32_t start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
    found = FindAos(slots, key, start);
  }
  founds[idx] = found ? 1 : 0;
}

// 本 case 的表布局：AoS 池——每槽 {key, 0x01 填充的 value}，槽位与
// slot_keys 一一对应（先整体 0x01 填充即成 value 区，再覆写 key）。
std::vector<uint8_t> build_case_table(
    const std::vector<uint64_t>& slot_keys) {
  constexpr size_t table_bytes =
      static_cast<size_t>(CAPACITY) * sizeof(AoSSlot);
  std::vector<uint8_t> pool(table_bytes, 1);
  auto* slots = reinterpret_cast<AoSSlot*>(pool.data());
  for (uint32_t i = 0; i < CAPACITY; ++i) {
    slots[i].key = slot_keys[i];
  }
  return pool;
}

// 统一入口（run_case 调用）：grid 精确覆盖查询数
void launch_case_kernel(uint8_t* table, uint64_t* d_keys, uint8_t* d_founds,
                        uint32_t query_num, aclrtStream stream) {
  const uint32_t blocks =
      (query_num + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
  lookup_aos_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
      reinterpret_cast<const AoSSlot*>(table), d_keys, d_founds, query_num);
}

#endif  // SCENARIO_NUM == 0

// ==================== case 1：SoA 纯布局（thread-per-key） ====================
//
// key/value 字段各自成区（数组直存结构体、无指针）。thread-per-key
// 逐槽读 8B key（8B 步长）；value 区（32MB）与探测路径完全解耦，
// miss 路径一次不触碰 value 区。探测访存跨度从 ~50×40B 压到
// ~50×8B = 400B ≈ 3~4 line——同一算法，只改布局。
#if SCENARIO_NUM == 1

// thread-per-key：每线程独立处理一条查询 key；同 hash、同起点。
__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_soa_kernel(
    const SoaTableNoDigest* table, const uint64_t* keys, uint8_t* founds,
    uint32_t query_num) {
  const uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
  if (idx >= query_num) {
    return;
  }
  bool found = false;
  const uint64_t key = keys[idx];
  if (key != EMPTY_KEY) {
    const uint64_t hashed = Murmur3Hash(key);  // 只算一次
    const uint32_t start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
    found = FindSoaNoDigest(table, key, start);
  }
  founds[idx] = found ? 1 : 0;
}

// 本 case 的表布局：SoA 无 digest——key/value 两区各自连续，value 区
// 0x01 填充，key 区覆写为 slot_keys（通过与设备侧相同的结构体类型写入，
// 保证各区偏移与设备寻址严格一致）。
std::vector<uint8_t> build_case_table(
    const std::vector<uint64_t>& slot_keys) {
  constexpr size_t table_bytes = static_cast<size_t>(CAPACITY) *
      (sizeof(uint64_t) + DIM * sizeof(float));
  std::vector<uint8_t> pool(table_bytes, 1);
  auto* table = reinterpret_cast<SoaTableNoDigest*>(pool.data());
  for (uint32_t i = 0; i < CAPACITY; ++i) {
    table->key[i] = slot_keys[i];
  }
  return pool;
}

// 统一入口（run_case 调用）：grid 精确覆盖查询数
void launch_case_kernel(uint8_t* table, uint64_t* d_keys, uint8_t* d_founds,
                        uint32_t query_num, aclrtStream stream) {
  const uint32_t blocks =
      (query_num + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
  lookup_soa_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
      reinterpret_cast<const SoaTableNoDigest*>(table), d_keys, d_founds,
      query_num);
}

#endif  // SCENARIO_NUM == 1

// ==================== case 2：digest 预过滤 + SWAR（thread-per-key） ====================
//
// key 区前加 1B/槽 digest 区（哈希高 8 位），digest 命中才读 8B key
// 精确确认；探测按 4B word 批量加载、四路字节并行比较（SWAR——SIMD
// within a register），主循环访存全部无条件，一次 miss 探测跨度 ~13
// 次 word load，稳落 1 条 cache line。digest 与 vcmp_eq4 是同一设计
// 决策的两半：digest 选 1B 粒度本身就是按 4B word 批量比较设计的
// （32bit÷8bit=4，批量步长须整除表容量 2^20）；标量逐槽形态会因热
// 循环条件访存断流水（实测暴跌约 1400 倍，E1/E2 归因见姊妹样例
// soa_aos_lookup）。
#if SCENARIO_NUM == 2

// thread-per-key：每线程独立处理一条查询 key；同 hash、同起点。
__global__ __launch_bounds__(THREADS_PER_BLOCK) void
lookup_soa_digest_swar_kernel(const SoaTable* table, const uint64_t* keys,
                              uint8_t* founds, uint32_t query_num) {
  const uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
  if (idx >= query_num) {
    return;
  }
  bool found = false;
  const uint64_t key = keys[idx];
  if (key != EMPTY_KEY) {
    const uint64_t hashed = Murmur3Hash(key);  // 只算一次
    const uint32_t start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
    found = FindSoaDigestVcmp(table, key, start, DigestWordOf(hashed));
  }
  founds[idx] = found ? 1 : 0;
}

// 本 case 的表布局：SoA + digest——key 区前 1B/槽 digest 区。空槽
// digest 填 EMPTY_KEY 哈希高 8 位（有意义的值，可用来判空槽）。
std::vector<uint8_t> build_case_table(
    const std::vector<uint64_t>& slot_keys) {
  constexpr size_t table_bytes = static_cast<size_t>(CAPACITY) *
      (sizeof(uint8_t) + sizeof(uint64_t) + DIM * sizeof(float));
  std::vector<uint8_t> pool(table_bytes, 1);
  auto* table = reinterpret_cast<SoaTable*>(pool.data());
  const uint8_t empty_digest = DigestOf(Murmur3Hash(EMPTY_KEY));
  for (uint32_t i = 0; i < CAPACITY; ++i) {
    table->key[i] = slot_keys[i];
    table->digest[i] = (slot_keys[i] == EMPTY_KEY)
                           ? empty_digest
                           : DigestOf(Murmur3Hash(slot_keys[i]));
  }
  return pool;
}

// 统一入口（run_case 调用）：grid 精确覆盖查询数
void launch_case_kernel(uint8_t* table, uint64_t* d_keys, uint8_t* d_founds,
                        uint32_t query_num, aclrtStream stream) {
  const uint32_t blocks =
      (query_num + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
  lookup_soa_digest_swar_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
      reinterpret_cast<const SoaTable*>(table), d_keys, d_founds, query_num);
}

#endif  // SCENARIO_NUM == 2

// ==================== case 3：协作 × SWAR 组合（warp 协作） ====================
//
// G=4 协作窗口 × 每 lane SWAR 4 槽 = 每轮 16 槽。定位：相对 case2
// （thread-per-key 纯 SWAR），每 warp-轮同为 32 次 word load / 128 槽
// （访存指令经济性相同），但每 key 串行链 13 轮 → 4 轮（16 槽/轮由
// 4 lane 并行加载），省下的轮间访存延迟远大于 2 票/轮的 asc_ballot
// 开销——组合反超纯 SWAR。
// 结构：每 lane 负责窗口内连续 4 槽（一次 4B word load + 两次
// VcmpEq4），word 内命中位图由 __ffs 迭代消费（罕见路径，与 case2 消费
// 循环同构），跨 lane 由 asc_ballot 投票汇总（2 票/轮，确认已折进
// 谓词）；round-0 回绕保护细化到字节粒度。G=4 形态全 grid 运行。
#if SCENARIO_NUM == 3

__global__ __launch_bounds__(THREADS_PER_BLOCK) void lookup_coop_swar_kernel(
    const SoaTable* table, const uint64_t* keys, uint8_t* founds,
    uint32_t query_num) {
  constexpr uint32_t kGroupSize = 4;    // 协作组大小
  constexpr uint32_t kSlotsPerLane = 4;  // 每 lane SWAR word 内 digest 数
  constexpr uint32_t kWindow = kGroupSize * kSlotsPerLane;  // 16 槽/轮
  constexpr uint32_t kGroupsPerWarp = WARP_SIZE / kGroupSize;
  constexpr uint32_t kGroupMask = (1u << kGroupSize) - 1u;
  constexpr uint32_t kMaxRounds = CAPACITY / kWindow + 1;  // +1 重探首窗

  const uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;
  const uint32_t lane_id = tid % WARP_SIZE;
  const uint32_t group_id = lane_id / kGroupSize;
  const uint32_t rank = lane_id % kGroupSize;
  const uint32_t group_shift = group_id * kGroupSize;
  const uint64_t warp_id = tid / WARP_SIZE;
  const uint64_t warp_total =
      (static_cast<uint64_t>(gridDim.x) * blockDim.x) / WARP_SIZE;

  const uint32_t empty_word = DigestWordOf(Murmur3Hash(EMPTY_KEY));

  // 每趟处理 [base, base + kGroupsPerWarp) 的 key，warp 一致推进
  for (uint64_t base = warp_id * kGroupsPerWarp; base < query_num;
       base += warp_total * kGroupsPerWarp) {
    const uint64_t key_idx = base + group_id;
    const bool active = key_idx < query_num;
    const uint64_t key = active ? keys[key_idx] : 0;

    bool found = false;
    bool done = !active;
    uint32_t start = 0;
    uint32_t target_word = 0;
    if (active && key != EMPTY_KEY) {
      const uint64_t hashed = Murmur3Hash(key);
      start = static_cast<uint32_t>(hashed & (CAPACITY - 1));
      target_word = DigestWordOf(hashed);
    } else {
      done = true;  // 非活跃组或哨兵 key：不参与探测，只惰性投票
    }
    const uint32_t first_pos = start & (CAPACITY - kWindow);  // 对齐到 16

    // warp 一致轮循环：每 lane 覆盖窗口内连续 4 槽
    for (uint32_t round = 0; round < kMaxRounds; ++round) {
      if (asc_all(done)) {
        break;
      }
      const bool working = !done;
      const uint32_t pos = (first_pos + round * kWindow +
                            rank * kSlotsPerLane) &
                           (CAPACITY - 1);

      // 1. 每 lane 一次 4B word load + 两次 SWAR 比较（128 槽/warp-轮）
      uint32_t tmask = 0;  // word 内目标 digest 命中位图（每字节 0x01）
      uint32_t emask = 0;  // word 内空槽 digest 位图
      if (working) {
        const uint32_t word =
            *reinterpret_cast<const uint32_t*>(table->digest + pos);
        tmask = VcmpEq4(word, target_word) & 0x01010101u;
        emask = VcmpEq4(word, empty_word) & 0x01010101u;
        if (round == 0) {
          // 回绕保护（字节粒度）：清掉位于 start 之前的低 shift 字节
          const uint32_t shift =
              (start > pos)
                  ? (kSlotsPerLane < start - pos ? kSlotsPerLane
                                                 : start - pos)
                  : 0u;
          emask &= ~static_cast<uint32_t>((1ull << (shift * 8)) - 1ull);
        }
      }

      // 2. 罕见路径：word 内 __ffs 迭代消费位图，读 key 确认
      //    （假阳性 1/256 由 key 确认兜底）
      bool match = false;
      while (tmask != 0) {
        const uint32_t idx =
            pos + (((static_cast<uint32_t>(
                         __ffs(static_cast<int32_t>(tmask)))) - 1u) >> 3);
        tmask &= tmask - 1;
        if (table->key[idx] == key) {
          match = true;
        }
      }
      bool miss_confirmed = false;
      while (emask != 0) {
        const uint32_t idx =
            pos + (((static_cast<uint32_t>(
                         __ffs(static_cast<int32_t>(emask)))) - 1u) >> 3);
        emask &= emask - 1;
        if (table->key[idx] == EMPTY_KEY) {
          miss_confirmed = true;
        }
      }

      // 3. warp 级投票 + 组位切片（2 票/轮，确认已折进谓词）
      const uint32_t match_ballot = asc_ballot(match);
      if (((match_ballot >> group_shift) & kGroupMask) != 0) {
        found = true;
        done = true;
      }
      const uint32_t confirm_ballot = asc_ballot(miss_confirmed);
      if (((confirm_ballot >> group_shift) & kGroupMask) != 0) {
        done = true;
      }
    }

    if (active && rank == 0) {
      founds[key_idx] = found ? 1 : 0;
    }
  }
}

// 本 case 的表布局：与 case2 同一张 SoA + digest 表（纯比访问/并行
// 策略，布局变量控制住）。
std::vector<uint8_t> build_case_table(
    const std::vector<uint64_t>& slot_keys) {
  constexpr size_t table_bytes = static_cast<size_t>(CAPACITY) *
      (sizeof(uint8_t) + sizeof(uint64_t) + DIM * sizeof(float));
  std::vector<uint8_t> pool(table_bytes, 1);
  auto* table = reinterpret_cast<SoaTable*>(pool.data());
  const uint8_t empty_digest = DigestOf(Murmur3Hash(EMPTY_KEY));
  for (uint32_t i = 0; i < CAPACITY; ++i) {
    table->key[i] = slot_keys[i];
    table->digest[i] = (slot_keys[i] == EMPTY_KEY)
                           ? empty_digest
                           : DigestOf(Murmur3Hash(slot_keys[i]));
  }
  return pool;
}

// 统一入口（run_case 调用）：grid 精确覆盖查询数（kernel 内部以 warp
// 为单位 grid-stride，8 key/warp）
void launch_case_kernel(uint8_t* table, uint64_t* d_keys, uint8_t* d_founds,
                        uint32_t query_num, aclrtStream stream) {
  const uint32_t blocks =
      (query_num + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
  lookup_coop_swar_kernel<<<blocks, THREADS_PER_BLOCK, 0, stream>>>(
      reinterpret_cast<const SoaTable*>(table), d_keys, d_founds, query_num);
}

#endif  // SCENARIO_NUM == 3

// ==================== run_case：单次启动 + 回读 ====================
//
// 构表（本 case 布局）→ 设备分配 → H2D → 单次 launch（1M 混合查询）→
// 同步 → 回读 → 逐条比对 → 释放。被测 launch 即被校验 launch——程序内
// 不计时，msopprof 采到的就是这次被校验过的任务。
struct RunResult {
  size_t mismatches;   // 设备结果与期望不一致的查询数
  size_t actual_hits;  // 设备侧命中的查询数
};

RunResult run_case(const std::vector<uint64_t>& query_keys,
                   const std::vector<uint8_t>& expected,
                   const std::vector<uint64_t>& slot_keys) {
  const uint32_t query_num = static_cast<uint32_t>(query_keys.size());
  const size_t query_bytes = static_cast<size_t>(query_num) * sizeof(uint64_t);
  const std::vector<uint8_t> table_host = build_case_table(slot_keys);
  const size_t table_bytes = table_host.size();

  ACL_CHECK(aclInit(nullptr));
  const char* device_env = std::getenv("SOA_AOS_DEVICE");
  const int32_t device_id = device_env ? std::atoi(device_env) : 0;
  ACL_CHECK(aclrtSetDevice(device_id));
  printf("Soc: %s  device: %d\n", aclrtGetSocName(), device_id);

  aclrtStream stream = nullptr;
  ACL_CHECK(aclrtCreateStream(&stream));

  uint8_t* d_table = nullptr;
  uint64_t* d_keys = nullptr;
  uint8_t* d_founds = nullptr;
  ACL_CHECK(aclrtMalloc((void**)&d_table, table_bytes,
                        ACL_MEM_MALLOC_HUGE_FIRST));
  ACL_CHECK(aclrtMalloc((void**)&d_keys, query_bytes,
                        ACL_MEM_MALLOC_HUGE_FIRST));
  ACL_CHECK(aclrtMalloc((void**)&d_founds, query_num,
                        ACL_MEM_MALLOC_HUGE_FIRST));
  ACL_CHECK(aclrtMemcpy(d_table, table_bytes, table_host.data(), table_bytes,
                        ACL_MEMCPY_HOST_TO_DEVICE));
  ACL_CHECK(aclrtMemcpy(d_keys, query_bytes, query_keys.data(), query_bytes,
                        ACL_MEMCPY_HOST_TO_DEVICE));

  launch_case_kernel(d_table, d_keys, d_founds, query_num, stream);
  ACL_CHECK(aclrtSynchronizeStream(stream));

  std::vector<uint8_t> founds_host(query_num);
  ACL_CHECK(aclrtMemcpy(founds_host.data(), query_num, d_founds, query_num,
                        ACL_MEMCPY_DEVICE_TO_HOST));

  ACL_CHECK(aclrtFree(d_table));
  ACL_CHECK(aclrtFree(d_keys));
  ACL_CHECK(aclrtFree(d_founds));
  ACL_CHECK(aclrtDestroyStream(stream));
  ACL_CHECK(aclrtResetDevice(device_id));
  ACL_CHECK(aclFinalize());

  RunResult result = {0, 0};
  for (size_t i = 0; i < query_num; ++i) {
    const bool found = founds_host[i] != 0;
    result.actual_hits += found ? 1 : 0;
    result.mismatches += (found != (expected[i] != 0)) ? 1 : 0;
  }
  return result;
}

int main(int argc, char** argv) {
  const uint32_t case_kind = static_cast<uint32_t>(SCENARIO_NUM);
  const size_t n_fill = static_cast<size_t>(CAPACITY * LOAD_FACTOR);
  const size_t n_miss_q =
      static_cast<size_t>(QUERY_NUM * (1.0 - HIT_RATIO));
  const size_t n_hit = QUERY_NUM - n_miss_q;  // 减法凑整，总数恒为 1M

  printf("Usage: %s (compile-time SCENARIO_NUM=%u)\n", argv[0], case_kind);
  printf("Running case %u: %s...\n", case_kind,
         get_case_name(static_cast<int32_t>(case_kind)));
  printf("Threads/Thread Block: %u\n", THREADS_PER_BLOCK);
  printf("Table: capacity=%u slots, load factor=%.1f, inserted=%zu\n",
         CAPACITY, LOAD_FACTOR, n_fill);
  printf("Queries: %u mixed keys, hit ratio=%.1f (%zu hits + %zu misses)\n",
         QUERY_NUM, HIT_RATIO, n_hit, n_miss_q);
  printf("Expected probes: hit ~5.5, miss ~50, mixed ~%.1f "
         "(Knuth, a=0.9)\n",
         HIT_RATIO * 5.5 + (1.0 - HIT_RATIO) * 50.0);

  // 生成 key：前 n_fill 个装表，后 n_miss_q 个互异 key 作 miss 池
  // （与装表 key 互斥，永不命中）
  std::vector<uint64_t> all_keys =
      generate_unique_keys(n_fill + n_miss_q);
  std::vector<uint64_t> fill_keys(all_keys.begin(),
                                  all_keys.begin() + n_fill);
  std::vector<uint64_t> miss_pool(all_keys.begin() + n_fill,
                                  all_keys.end());

  // 混合查询集：n_hit 条从 fill_keys 均匀抽取（必命中）+ n_miss_q 条从
  // miss_pool 抽取（必 miss），(key, expected) 成对记录后 shuffle 打散
  // ——比例精确、种子固定可复现；查询集允许重复 key（期望不变）
  std::mt19937_64 qeng(54321);
  std::uniform_int_distribution<size_t> fill_distr(0, n_fill - 1);
  std::uniform_int_distribution<size_t> miss_distr(0, n_miss_q - 1);
  std::vector<std::pair<uint64_t, uint8_t>> queries;
  queries.reserve(QUERY_NUM);
  for (size_t i = 0; i < n_hit; ++i) {
    queries.emplace_back(fill_keys[fill_distr(qeng)], 1);
  }
  for (size_t i = 0; i < n_miss_q; ++i) {
    queries.emplace_back(miss_pool[miss_distr(qeng)], 0);
  }
  std::shuffle(queries.begin(), queries.end(), qeng);
  std::vector<uint64_t> query_keys;
  std::vector<uint8_t> expected;
  query_keys.reserve(QUERY_NUM);
  expected.reserve(QUERY_NUM);
  for (const auto& q : queries) {
    query_keys.push_back(q.first);
    expected.push_back(q.second);
  }

  // host 单线程构表：与设备侧同 hash、同起点、同探测序的逻辑槽位分配
  std::vector<uint64_t> slot_keys;
  build_slot_keys(fill_keys, slot_keys);

  // 单次启动 1M 混合查询，设备结果必须与期望逐条一致
  const RunResult result = run_case(query_keys, expected, slot_keys);
  return verify_result(result.mismatches, result.actual_hits, n_hit);
}
