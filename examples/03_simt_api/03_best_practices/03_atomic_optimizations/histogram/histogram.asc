/* !
 * \file histogram.asc
 * \brief SIMT histogram sample comparing GM global and UB block-local atomic targets
 */
#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

// 直方图bin数量：统计uint8_t取值0-255的出现频率
constexpr uint32_t HISTOGRAM_BIN_COUNT = 256U;
constexpr uint32_t THREADS_PER_BLOCK = 2048U;
// 固定输入规模，对应64核测试环境下的 64 cores * 2048 threads * 2 bytes
constexpr uint32_t FIXED_INPUT_BYTE_COUNT = 262144U;
constexpr uint32_t FIXED_SEED = 2009U;
constexpr uint32_t CASE_GM_GLOBAL = 0U;
constexpr uint32_t CASE_UB_BLOCK_LOCAL = 1U;

static uint8_t g_input_host[FIXED_INPUT_BYTE_COUNT];
static uint32_t g_expected_histogram[HISTOGRAM_BIN_COUNT];
static uint32_t g_actual_histogram[HISTOGRAM_BIN_COUNT];

void check_acl(aclError result, const char* const func, const char* const file, int32_t const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, (int32_t)result, aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}

void check_acl_launch(const char* kernel_name, const char* const file, int32_t const line)
{
    const aclError result = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d kernel=\"%s\" code=%d(%s)\n", file, line, kernel_name, (int32_t)result,
            aclGetRecentErrMsg());
        std::exit(EXIT_FAILURE);
    }
}

#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)
#define CHECK_ACL_LAUNCH(kernel_name) check_acl_launch((kernel_name), __FILE__, __LINE__)

/*
 * Case 0（基线）：全部Block的全部线程对同一份GM直方图做原子累加。
 * 262144次原子更新全部集中在256个GM地址上，竞争范围覆盖全部131072个线程。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void histogram_gm_global(
    uint32_t* histogram, const uint8_t* input, uint32_t byte_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < byte_count; index += stride) {
        asc_atomic_add(histogram + (uint32_t)input[index], 1U);
    }
}

/*
 * Case 1（优化）：每个Block在UB上维护一份私有直方图，结束时合并到GM。
 * 原子更新总次数与Case 0一致，但原子目标下沉到AIV内的UB，
 * 且每个地址的竞争线程数从131072降到2048。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void histogram_ub_block_local(
    uint32_t* histogram, const uint8_t* input, uint32_t byte_count)
{
    __ubuf__ uint32_t block_histogram[HISTOGRAM_BIN_COUNT];

    // Block内线程协作清零UB直方图
    for (uint32_t bin_index = threadIdx.x; bin_index < HISTOGRAM_BIN_COUNT; bin_index += blockDim.x) {
        block_histogram[bin_index] = 0;
    }
    asc_syncthreads();

    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < byte_count; index += stride) {
        asc_atomic_add(block_histogram + (uint32_t)input[index], 1U);
    }
    asc_syncthreads();

    // 前256个线程各负责一个bin，把Block局部结果原子累加到最终GM直方图
    for (uint32_t bin_index = threadIdx.x; bin_index < HISTOGRAM_BIN_COUNT; bin_index += blockDim.x) {
        asc_atomic_add(histogram + bin_index, block_histogram[bin_index]);
    }
}

void compute_histogram_cpu(uint32_t* histogram_out, const uint8_t* bytes, uint32_t byte_count)
{
    for (uint32_t bin_index = 0; bin_index < HISTOGRAM_BIN_COUNT; ++bin_index) {
        histogram_out[bin_index] = 0;
    }
    for (uint32_t byte_index = 0; byte_index < byte_count; ++byte_index) {
        histogram_out[bytes[byte_index]]++;
    }
}

void seed_input_bytes(uint8_t* bytes, uint32_t byte_count, uint32_t seed)
{
    std::srand((int32_t)seed);
    for (uint32_t byte_index = 0; byte_index < byte_count; ++byte_index) {
        bytes[byte_index] = (uint8_t)(std::rand() % HISTOGRAM_BIN_COUNT);
    }
}

uint32_t verify_result(const uint32_t* output, const uint32_t* golden)
{
    for (uint32_t bin_index = 0; bin_index < HISTOGRAM_BIN_COUNT; ++bin_index) {
        if (output[bin_index] != golden[bin_index]) {
            std::fprintf(
                stderr, "[Failed] Case accuracy is verification failed at bin %u: device=%u cpu=%u\n", bin_index,
                output[bin_index], golden[bin_index]);
            return 1;
        }
    }
    std::printf("[Success] Case accuracy is verification passed.\n");
    return 0;
}

// 运行期查询物理Vector Core数量；查询失败或返回值非法时报错退出，不回退到经验值
bool query_aiv_core_num(int32_t device_id, uint32_t* core_num)
{
    int64_t value = 0;
    const aclError ret = aclrtGetDeviceInfo((uint32_t)device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &value);
    if (ret != ACL_SUCCESS || value <= 0) {
        std::fprintf(stderr, "failed to query vector core num: ret=%d value=%ld\n", (int32_t)ret, (long)value);
        return false;
    }
    *core_num = (uint32_t)value;
    return true;
}

void run_kernel(uint32_t case_id, uint32_t blocks_per_grid, uint32_t* histogram_host)
{
    const uint32_t histogram_byte_size = HISTOGRAM_BIN_COUNT * sizeof(uint32_t);
    const uint32_t dynamic_ubuf_size = 0;
    aclrtStream stream = nullptr;
    uint8_t* input_device = nullptr;
    uint32_t* histogram_device = nullptr;

    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMalloc((void**)(&input_device), FIXED_INPUT_BYTE_COUNT, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)(&histogram_device), histogram_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        input_device, FIXED_INPUT_BYTE_COUNT, g_input_host, FIXED_INPUT_BYTE_COUNT, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(histogram_device, histogram_byte_size, 0, histogram_byte_size));

    if (case_id == CASE_GM_GLOBAL) {
        histogram_gm_global<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            histogram_device, input_device, FIXED_INPUT_BYTE_COUNT);
        CHECK_ACL_LAUNCH("histogram_gm_global");
    } else {
        histogram_ub_block_local<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            histogram_device, input_device, FIXED_INPUT_BYTE_COUNT);
        CHECK_ACL_LAUNCH("histogram_ub_block_local");
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));

    CHECK_ACL(aclrtMemcpy(
        histogram_host, histogram_byte_size, histogram_device, histogram_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));

    CHECK_ACL(aclrtFree(histogram_device));
    CHECK_ACL(aclrtFree(input_device));
    CHECK_ACL(aclrtDestroyStream(stream));
}

void print_usage(const char* program_name)
{
    std::fprintf(stderr, "usage: %s <case_id>\n", program_name);
    std::fprintf(stderr, "  0  GM global histogram (baseline)\n");
    std::fprintf(stderr, "  1  UB block-local histogram\n");
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 2) {
        print_usage(argv[0]);
        return EXIT_FAILURE;
    }
    const uint32_t case_id = (uint32_t)std::atoi(argv[1]);
    if (case_id != CASE_GM_GLOBAL && case_id != CASE_UB_BLOCK_LOCAL) {
        print_usage(argv[0]);
        return EXIT_FAILURE;
    }

    seed_input_bytes(g_input_host, FIXED_INPUT_BYTE_COUNT, FIXED_SEED);
    compute_histogram_cpu(g_expected_histogram, g_input_host, FIXED_INPUT_BYTE_COUNT);

    const int32_t device_id = 0;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));

    uint32_t core_num = 0;
    if (!query_aiv_core_num(device_id, &core_num)) {
        aclrtResetDevice(device_id);
        aclFinalize();
        return EXIT_FAILURE;
    }

    std::printf(
        "Case %u (%s): %u bytes, %u blocks, %u threads per block\n", case_id,
        case_id == CASE_GM_GLOBAL ? "GM global" : "UB block-local", FIXED_INPUT_BYTE_COUNT, core_num,
        THREADS_PER_BLOCK);

    run_kernel(case_id, core_num, g_actual_histogram);

#if SKIP_VALIDATION
    std::printf("Validation skipped\n");
    const uint32_t failed = 0;
#else
    const uint32_t failed = verify_result(g_actual_histogram, g_expected_histogram);
#endif

    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return failed == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
}
