/* !
 * \file grid_config.asc
 * \brief SIMT gather and SIMD adds hybrid programming sample demonstrating grid/block configuration and vf call optimization
 */

#include <iostream>
#include <iterator>
#include <vector>
#include <cstdlib>
#include <ctime>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 9
#error "SCENARIO_NUM must be one of 1, 2, 3, 4, 5, 6, 7, 8, 9."
#endif

namespace {
constexpr uint32_t THREAD_NUM = 1024;
constexpr uint32_t IN_WIDTH = 256;
constexpr float ADDS_ADDEND = 1.0f;
constexpr uint32_t INDEX_ROWS = 1024;
constexpr uint32_t OUTPUT_TOTAL_LENGTH = INDEX_ROWS * IN_WIDTH;

struct ScenarioConfig {
    uint32_t num_blocks;
    uint32_t vf_call_times;
    bool use_gather_adds;
    bool vf_loop_inside;
    const char* name;
};

ScenarioConfig get_scenario_config(uint32_t scenario, uint32_t aiv_core_num)
{
    uint32_t vf_call_times = OUTPUT_TOTAL_LENGTH / aiv_core_num / THREAD_NUM;
    
    switch (scenario) {
        case 1: return {36, 1, false, false, "36 cores, 1 vf call (copy only)"};
        case 2: return {64, 1, false, false, "64 cores, 1 vf call (copy only)"};
        case 3: return {128, 1, false, false, "128 cores, 1 vf call (copy only)"};
        case 4: return {1024, 1, false, false, "1024 cores, 1 vf call (copy only)"};
        case 5: return {36, 2, false, false, "36 cores, 2 vf calls (copy only)"};
        case 6: return {1024, 2, false, false, "1024 cores, 2 vf calls (copy only)"};
        case 7: return {64, 14, false, false, "64 cores, 14 vf calls (copy only)"};
        case 8: return {aiv_core_num, vf_call_times, true, false, "AIV cores, vf loop outside (gather+adds)"};
        case 9: return {aiv_core_num, 1, true, true, "AIV cores, vf loop inside (gather+adds)"};
        default: return {36, 1, false, false, "unknown"};
    }
}
}

__simt_vf__ __launch_bounds__(THREAD_NUM) inline void simt_copy_dummy(
    __gm__ float* input, __gm__ uint32_t* index)
{
}

__simd_vf__ inline void simd_copy_dummy(__ubuf__ float* output)
{
}

__global__ __vector__ void vf_kernel(
    __gm__ float* input, __gm__ uint32_t* index, __gm__ float* output,
    uint32_t in_rows, uint32_t index_total_length, uint32_t vf_call_times)
{
    __ubuf__ float* out_ptr;
    for (uint32_t vf_idx = 0; vf_idx < vf_call_times; vf_idx++) {
        asc_vf_call<simt_copy_dummy>(dim3(THREAD_NUM), input, index);

        asc_vf_call<simd_copy_dummy>(out_ptr);
    }
}

__simt_vf__ __launch_bounds__(THREAD_NUM) inline void simt_gather(
    __gm__ float* input, __gm__ uint32_t* index, __ubuf__ float* gather_output,
    uint32_t in_rows, uint32_t index_start, uint32_t process_length)
{
    if (threadIdx.x >= process_length) {
        return;
    }

    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x + index_start;
    uint32_t gather_idx = index[idx];

    if (gather_idx >= in_rows) {
        gather_idx = 0;
    }

    for (uint32_t col = 0; col < IN_WIDTH; col++) {
        uint32_t input_offset = gather_idx * IN_WIDTH + col;
        uint32_t output_offset = threadIdx.x * IN_WIDTH + col;
        gather_output[output_offset] = input[input_offset];
    }
}

__simt_vf__ __launch_bounds__(THREAD_NUM) inline void simt_gather_vf_loop(
    __gm__ float* input, __gm__ uint32_t* index, __ubuf__ float* gather_output,
    uint32_t in_rows, uint32_t index_start, uint32_t vf_loop_times)
{
    for (uint32_t vf_idx = 0; vf_idx < vf_loop_times; vf_idx++) {
        uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x + index_start + vf_idx * THREAD_NUM;
        uint32_t gather_idx = index[idx];

        if (gather_idx >= in_rows) {
            gather_idx = 0;
        }

        uint32_t output_offset = vf_idx * IN_WIDTH;
        for (uint32_t col = 0; col < IN_WIDTH; col++) {
            uint32_t input_offset = gather_idx * IN_WIDTH + col;
            gather_output[output_offset + col] = input[input_offset];
        }
    }
}

__simd_vf__ inline void simd_adds(
    __ubuf__ float* output, __ubuf__ float* input, uint32_t process_length)
{
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::MaskReg maskReg;

    constexpr uint32_t one_repeat_size = AscendC::GetVecLen() / sizeof(float);
    uint32_t total_elements = process_length * IN_WIDTH;
    uint16_t repeat_times = (total_elements + one_repeat_size - 1) / one_repeat_size;

    for (uint16_t i = 0; i < repeat_times; i++) {
        uint32_t offset = i * one_repeat_size;
        uint32_t remaining = total_elements - offset;
        uint32_t mask_count = remaining < one_repeat_size ? remaining : one_repeat_size;
        maskReg = AscendC::Reg::UpdateMask<float>(mask_count);

        AscendC::Reg::LoadAlign(srcReg, input + offset);
        AscendC::Reg::Adds(dstReg, srcReg, ADDS_ADDEND, maskReg);
        AscendC::Reg::StoreAlign(output + offset, dstReg, maskReg);
    }
}

__simd_vf__ inline void simd_adds_vf_loop(
    __ubuf__ float* output, __ubuf__ float* input, uint32_t vf_loop_times)
{
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::MaskReg maskReg;

    constexpr uint32_t one_repeat_size = AscendC::GetVecLen() / sizeof(float);
    
    for (uint32_t vf_idx = 0; vf_idx < vf_loop_times; vf_idx++) {
        uint32_t offset = vf_idx * IN_WIDTH;
        
        for (uint16_t i = 0; i < (IN_WIDTH / one_repeat_size); i++) {
            uint32_t elem_offset = offset + i * one_repeat_size;
            maskReg = AscendC::Reg::UpdateMask<float>(one_repeat_size);

            AscendC::Reg::LoadAlign(srcReg, input + elem_offset);
            AscendC::Reg::Adds(dstReg, srcReg, ADDS_ADDEND, maskReg);
            AscendC::Reg::StoreAlign(output + elem_offset, dstReg, maskReg);
        }
    }
}

__global__ __vector__ void gather_adds_kernel(
    __gm__ float* input, __gm__ uint32_t* index, __gm__ float* output,
    uint32_t in_rows, uint32_t index_total_length, uint32_t vf_call_times)
{
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;

    uint32_t rows_per_block = index_total_length / AscendC::GetBlockNum();
    uint32_t rows_per_vf = rows_per_block / vf_call_times;

    AscendC::LocalTensor<float> gather_output = ubAllocator.Alloc<float>(rows_per_vf * IN_WIDTH);
    AscendC::LocalTensor<float> adds_output = ubAllocator.Alloc<float>(rows_per_vf * IN_WIDTH);

    for (uint32_t vf_idx = 0; vf_idx < vf_call_times; vf_idx++) {
        uint32_t vf_start = vf_idx * rows_per_vf;

        asc_vf_call<simt_gather>(
            dim3(THREAD_NUM), input, index, (__ubuf__ float*)gather_output.GetPhyAddr(),
            in_rows, vf_start, rows_per_vf);

        asc_vf_call<simd_adds>(
            (__ubuf__ float*)adds_output.GetPhyAddr(), (__ubuf__ float*)gather_output.GetPhyAddr(), rows_per_vf);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

        AscendC::GlobalTensor<float> output_global;
        uint32_t global_offset = (vf_start + AscendC::GetBlockIdx() * rows_per_block) * IN_WIDTH;
        output_global.SetGlobalBuffer(output + global_offset);
        AscendC::DataCopy(output_global, adds_output, rows_per_vf * IN_WIDTH);
    }
}

__global__ __vector__ void gather_adds_kernel_vf_inside(
    __gm__ float* input, __gm__ uint32_t* index, __gm__ float* output,
    uint32_t in_rows, uint32_t index_total_length, uint32_t vf_loop_times)
{
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;

    uint32_t rows_per_block = index_total_length / AscendC::GetBlockNum();
    uint32_t index_start = AscendC::GetBlockIdx() * rows_per_block;

    AscendC::LocalTensor<float> gather_output = ubAllocator.Alloc<float>(rows_per_block * IN_WIDTH);
    AscendC::LocalTensor<float> adds_output = ubAllocator.Alloc<float>(rows_per_block * IN_WIDTH);

    asc_vf_call<simt_gather_vf_loop>(
        dim3(THREAD_NUM), input, index, (__ubuf__ float*)gather_output.GetPhyAddr(),
        in_rows, index_start, vf_loop_times);

    asc_vf_call<simd_adds_vf_loop>(
        (__ubuf__ float*)adds_output.GetPhyAddr(), (__ubuf__ float*)gather_output.GetPhyAddr(), vf_loop_times);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

    AscendC::GlobalTensor<float> output_global;
    uint32_t global_offset = AscendC::GetBlockIdx() * rows_per_block * IN_WIDTH;
    output_global.SetGlobalBuffer(output + global_offset);
    AscendC::DataCopy(output_global, adds_output, rows_per_block * IN_WIDTH);
}

std::vector<float> run_kernel(std::vector<float>& input,
                              std::vector<uint32_t>& index,
                              uint32_t num_blocks,
                              uint32_t vf_call_times,
                              bool use_gather_adds,
                              bool vf_loop_inside)
{
    uint32_t input_total_length = input.size();
    size_t input_total_byte_size = input_total_length * sizeof(float);

    uint32_t index_total_length = index.size();
    size_t index_total_byte_size = index_total_length * sizeof(uint32_t);

    uint32_t output_total_length = index.size() * IN_WIDTH;
    size_t output_total_byte_size = output_total_length * sizeof(float);

    uint32_t in_rows = input_total_length / IN_WIDTH;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* index_host = reinterpret_cast<uint8_t*>(index.data());
    uint8_t* output_host = nullptr;
    float* input_device = nullptr;
    uint32_t* index_device = nullptr;
    float* output_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), output_total_byte_size);
    aclrtMalloc((void**)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&index_device, index_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, output_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, input_total_byte_size, input_host, input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(index_device, index_total_byte_size, index_host, index_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;

    if (use_gather_adds) {
        uint32_t rows_per_block = index_total_length / num_blocks;
        if (vf_loop_inside) {
            dyn_ubuf_size = rows_per_block * IN_WIDTH * sizeof(float);
            gather_adds_kernel_vf_inside<<<num_blocks, dyn_ubuf_size, stream>>>(
                input_device, index_device, output_device,
                in_rows, index_total_length, vf_call_times);
        } else {
            uint32_t rows_per_vf = rows_per_block / vf_call_times;
            dyn_ubuf_size = rows_per_vf * IN_WIDTH * sizeof(float);
            gather_adds_kernel<<<num_blocks, dyn_ubuf_size, stream>>>(
                input_device, index_device, output_device,
                in_rows, index_total_length, vf_call_times);
        }
    } else {
        aclrtMemcpy(output_device, output_total_byte_size, input_device, output_total_byte_size, ACL_MEMCPY_DEVICE_TO_DEVICE);
        vf_kernel<<<num_blocks, dyn_ubuf_size, stream>>>(
            input_device, index_device, output_device,
            in_rows, index_total_length, vf_call_times);
    }

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_total_byte_size, output_device, output_total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output((float*)output_host, (float*)(output_host + output_total_byte_size));

    aclrtFree(input_device);
    aclrtFree(index_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");

    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    srand(static_cast<uint32_t>(time(nullptr)));
    
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint32_t aiv_core_num = ascendcPlatform->GetCoreNumAiv();
    
    const uint32_t scenario = static_cast<uint32_t>(SCENARIO_NUM);
    ScenarioConfig config = get_scenario_config(scenario, aiv_core_num);

    printf("Scenario %u: %s, AIV cores: %u\n", scenario, config.name, aiv_core_num);

    constexpr uint32_t input_total_length = 300000;
    std::vector<float> input(input_total_length);
    for (uint32_t i = 0; i < input_total_length; i++) {
        input[i] = i * 1.2f;
    }

    uint32_t in_rows = input_total_length / IN_WIDTH;
    std::vector<uint32_t> index(INDEX_ROWS);
    for (uint32_t i = 0; i < INDEX_ROWS; i++) {
        index[i] = rand() % in_rows;
    }

    std::vector<float> golden(OUTPUT_TOTAL_LENGTH);
    if (config.use_gather_adds) {
        for (uint32_t i = 0; i < INDEX_ROWS; i++) {
            for (uint32_t j = 0; j < IN_WIDTH; j++) {
                uint32_t input_idx = index[i] * IN_WIDTH + j;
                uint32_t output_idx = i * IN_WIDTH + j;
                golden[output_idx] = input[input_idx] + ADDS_ADDEND;
            }
        }
    } else {
        for (uint32_t i = 0; i < OUTPUT_TOTAL_LENGTH; i++) {
            golden[i] = input[i];
        }
    }

    std::vector<float> output = run_kernel(input, index, config.num_blocks, config.vf_call_times, config.use_gather_adds, config.vf_loop_inside);
    if (output.empty()) {
        return 1;
    }
    return verify_result(output, golden);
}
