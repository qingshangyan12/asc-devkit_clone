/* !
 * \file vector_muladd_atomic.asc
 * \brief SIMT vector muladd sample comparing in-thread accumulation and asc_atomic_add
 */
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

constexpr uint32_t THREADS_PER_BLOCK = 2048U;
// 固定元素个数2^22：a、b、c三个float数组各16384KB
constexpr uint32_t FIXED_ELEMENT_COUNT = 4194304U;
constexpr uint32_t CASE_PLAIN_UPDATE = 0U;
constexpr uint32_t CASE_ATOMIC_UPDATE = 1U;

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

/*
 * Case 0（基线）：线程读出旧值后累加。
 * 各线程以总线程数为固定步长遍历整个数组，每处理一个元素都执行一次乘加：
 * 算出b[i] * c[i]，累加到a[i]的旧值上，写回a[i]。
 * a[i]的旧值必须先读进寄存器才能参与累加，每个元素产生3次读、1次写。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void vector_muladd_plain(
    float* a, const float* b, const float* c, uint32_t element_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < element_count; index += stride) {
        a[index] += b[index] * c[index];
    }
}

/*
 * Case 1（优化）：由存储侧就地累加。
 * 各线程只算出b[i] * c[i]的乘积，再对a[i]发起一次原子加，累加由存储侧就地完成，
 * a[i]的旧值不必读出，每个元素的读从3次降为2次。
 * 各线程访问互不重叠的地址，不存在同地址竞争，原子性本身并非功能需求。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void vector_muladd_atomic(
    float* a, const float* b, const float* c, uint32_t element_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < element_count; index += stride) {
        asc_atomic_add(&a[index], b[index] * c[index]);
    }
}

void print_usage(const char* program_name)
{
    std::fprintf(stderr, "usage: %s <case_id>\n", program_name);
    std::fprintf(stderr, "  0  plain update, thread reads old value (baseline)\n");
    std::fprintf(stderr, "  1  asc_atomic_add update\n");
}

// 用std::stoul替代atoi：非法字符串在atoi下会被静默当成0，这里要求整个参数都是合法数字且取值在用例范围内
bool parse_case_id(int32_t argc, char* argv[], uint32_t& case_id)
{
    if (argc != 2) {
        return false;
    }
    // stoul会跳过前导空白，这里要求参数首字符就是数字，整个参数都被消耗完
    const std::string argument(argv[1]);
    if (argument.empty() || argument[0] < '0' || argument[0] > '9') {
        return false;
    }
    try {
        size_t parsed_length = 0;
        const unsigned long value = std::stoul(argument, &parsed_length, 10);
        if (parsed_length != argument.length()) {
            return false;
        }
        if (value != CASE_PLAIN_UPDATE && value != CASE_ATOMIC_UPDATE) {
            return false;
        }
        case_id = (uint32_t)value;
        return true;
    } catch (const std::exception&) {
        return false;
    }
}

/*
 * 生成输入数据并在CPU上算出标杆结果。
 * 三个数组的取值都是2的负幂的小整数倍（0.5/0.25/0.125），乘积与和在float下
 * 均可精确表示，因此device侧无论是否使用乘加融合指令，结果都与CPU逐位一致，
 * 校验可以直接做精确比对，不需要设置浮点容差。
 */
void prepare_host_data(
    std::vector<float>& a_host, std::vector<float>& b_host, std::vector<float>& c_host,
    std::vector<float>& expected_host)
{
    for (uint32_t index = 0; index < FIXED_ELEMENT_COUNT; ++index) {
        a_host[index] = (float)(index % 13U) * 0.5F;
        b_host[index] = (float)(index % 7U) * 0.25F;
        c_host[index] = (float)(index % 11U) * 0.125F;
        expected_host[index] = a_host[index] + b_host[index] * c_host[index];
    }
}

uint32_t verify_result(const std::vector<float>& output, const std::vector<float>& golden)
{
    for (uint32_t index = 0; index < FIXED_ELEMENT_COUNT; ++index) {
        if (output[index] != golden[index]) {
            std::fprintf(
                stderr, "[Failed] Case accuracy is verification failed at element %u: device=%f cpu=%f\n", index,
                (double)output[index], (double)golden[index]);
            return 1;
        }
    }
    std::printf("[Success] Case accuracy is verification passed.\n");
    return 0;
}

// msopprof采集时a会被replay重复累加，此时用-DSKIP_VALIDATION=ON跳过校验
uint32_t validate_result(const std::vector<float>& actual, const std::vector<float>& expected)
{
#if SKIP_VALIDATION
    std::printf("Validation skipped\n");
    return 0;
#else
    return verify_result(actual, expected);
#endif
}

// 运行期查询物理Vector Core数量；查询失败或返回值非法时报错退出，不回退到经验值
bool query_aiv_core_num(int32_t device_id, uint32_t& core_num)
{
    int64_t value = 0;
    const aclError ret = aclrtGetDeviceInfo((uint32_t)device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &value);
    if (ret != ACL_SUCCESS || value <= 0) {
        std::fprintf(stderr, "failed to query vector core num: ret=%d value=%lld\n", (int32_t)ret, (long long)value);
        return false;
    }
    core_num = static_cast<uint32_t>(value);
    return true;
}

void print_case_info(uint32_t case_id, uint32_t blocks_per_grid)
{
    std::printf(
        "Case %u (%s): %u elements, %u blocks, %u threads per block\n", case_id,
        case_id == CASE_PLAIN_UPDATE ? "plain update" : "atomic update", FIXED_ELEMENT_COUNT, blocks_per_grid,
        THREADS_PER_BLOCK);
}

int32_t main(int32_t argc, char* argv[])
{
    // 1. 输入输出参数校验：命令行只接受一个用例编号，取值必须是0或1
    uint32_t case_id = 0;
    if (!parse_case_id(argc, argv, case_id)) {
        print_usage(argv[0]);
        return EXIT_FAILURE;
    }

    // 2. 数据准备：申请Host缓冲区，生成输入数据，并计算用于精度比对的CPU golden结果
    const size_t buffer_size = (size_t)FIXED_ELEMENT_COUNT * sizeof(float);
    std::vector<float> a_host(FIXED_ELEMENT_COUNT);
    std::vector<float> b_host(FIXED_ELEMENT_COUNT);
    std::vector<float> c_host(FIXED_ELEMENT_COUNT);
    std::vector<float> expected_host(FIXED_ELEMENT_COUNT);
    std::vector<float> actual_host(FIXED_ELEMENT_COUNT);
    prepare_host_data(a_host, b_host, c_host, expected_host);

    // 3. Device侧初始化：初始化ACL、绑定device、创建stream，并查询AIV核数作为Block数量
    const int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint32_t blocks_per_grid = 0;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));
    if (!query_aiv_core_num(device_id, blocks_per_grid)) {
        CHECK_ACL(aclrtDestroyStream(stream));
        CHECK_ACL(aclrtResetDevice(device_id));
        CHECK_ACL(aclFinalize());
        return EXIT_FAILURE;
    }
    print_case_info(case_id, blocks_per_grid);

    // 4. 数据传输（Host to Device）：申请device内存并拷入a、b、c三个数组
    float* a_device = nullptr;
    float* b_device = nullptr;
    float* c_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&a_device, buffer_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&b_device, buffer_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&c_device, buffer_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(a_device, buffer_size, a_host.data(), buffer_size, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(b_device, buffer_size, b_host.data(), buffer_size, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(c_device, buffer_size, c_host.data(), buffer_size, ACL_MEMCPY_HOST_TO_DEVICE));

    // 5. Kernel launch：按用例编号选择由线程累加还是由存储侧就地累加，随后等待stream执行完成
    const uint32_t dynamic_ubuf_size = 0;
    if (case_id == CASE_PLAIN_UPDATE) {
        vector_muladd_plain<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            a_device, b_device, c_device, FIXED_ELEMENT_COUNT);
    } else {
        vector_muladd_atomic<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            a_device, b_device, c_device, FIXED_ELEMENT_COUNT);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // 6. 数据回传（Device to Host）与精度校验
    CHECK_ACL(aclrtMemcpy(actual_host.data(), buffer_size, a_device, buffer_size, ACL_MEMCPY_DEVICE_TO_HOST));
    const uint32_t failed = validate_result(actual_host, expected_host);

    // 7. 资源释放：释放device内存与stream，最后去初始化device（Host缓冲区由vector自动释放）
    CHECK_ACL(aclrtFree(c_device));
    CHECK_ACL(aclrtFree(b_device));
    CHECK_ACL(aclrtFree(a_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return failed == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
}
