/* !
 * \file aligned_type.asc
 * \brief SIMT micro-bench: quantify alignment impact on Global Memory throughput on dav-3510.
 */

#include <cstdint>
#include <cstddef>
#include <cstdio>
#include <cstring>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"
// #include "tiling/platform/platform_ascendc.h"

constexpr uint32_t THREAD_COUNT   = 2048;                    // threads per block
constexpr uint32_t NUM_ITERATIONS = 32;                      // averaged for timing stability
constexpr size_t   MEM_BYTES      = 512ULL * 1024ULL * 1024ULL; // 512 MiB, shared by all cases — 2.8x the 192MB L2, already enough to spill reads to GM

// ---- 3 byte group (alignas 加 1B padding 把 alignof 从 1 提到 4 — 证明 padding 在 alignof=1→4 过渡上是净收益) ----
struct alignas(4) Align3    { unsigned char r, g, b; };      // sizeof=4(含 1B padding), alignof=4 → 单条 32-bit
struct            Misalign3 { unsigned char r, g, b; };      // sizeof=3, alignof=1 → 3 条 8-bit ld

// ---- 4 byte group ----
struct alignas(4) Align4    { unsigned char r, g, b, a; };   // sizeof=4,  alignof=4
struct            Misalign4 { unsigned char r, g, b, a; };   // sizeof=4,  alignof=1

// ---- 8 byte group ----
struct alignas(8) Align8    { unsigned int  l, a; };         // sizeof=8,  alignof=8
struct            Misalign8 { unsigned int  l, a; };         // sizeof=8,  alignof=4

// ---- 12 byte group (sizeof 非 2 的幂 — Misalign12 数组 stride=12 有真实地址错位) ----
struct alignas(16) Align12    { unsigned int r, g, b; };     // sizeof=16(含 4B padding), alignof=16
struct             Misalign12 { unsigned int r, g, b; };     // sizeof=12, alignof=4, stride=12 真错位

// ---- 16 byte group (三档对齐 16/8/4 — 同尺寸同元素数, 隔离"指令宽度"对吞吐的影响) ----
struct alignas(16) Align16    { unsigned int r, g, b, a; };  // sizeof=16, alignof=16 → 1×128-bit ld
struct alignas(8)  Align16_8  { unsigned int r, g, b, a; };  // sizeof=16, alignof=8  → 2×64-bit ld
struct             Misalign16 { unsigned int r, g, b, a; };  // sizeof=16, alignof=4  → 4×32-bit ld

// ---- 32 byte group (四档对齐 32/16/8/4 — 同尺寸同元素数, 隔离"指令宽度"对吞吐的影响) ----
struct alignas(32) Align32    { unsigned int v[8]; };        // sizeof=32, alignof=32 → 2×128-bit ld
struct alignas(16) Align32_16 { unsigned int v[8]; };        // sizeof=32, alignof=16 → 2×128-bit ld
struct alignas(8)  Align32_8  { unsigned int v[8]; };        // sizeof=32, alignof=8  → 4×64-bit ld
struct             Misalign32 { unsigned int v[8]; };        // sizeof=32, alignof=4  → 8×32-bit ld

template <class TData>
__global__ __launch_bounds__(THREAD_COUNT)
void aligned_copy_kernel(TData* d_odata, TData* d_idata, uint32_t num_elements)
{
    const uint32_t tid         = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t num_threads = blockDim.x * gridDim.x;
    for (uint32_t pos = tid; pos < num_elements; pos += num_threads) {
        d_odata[pos] = d_idata[pos];
    }
}

template <class TData>
bool verify_packed(const uint8_t* h_odata, const uint8_t* h_idata,
                   uint32_t num_elements, uint32_t packed_size)
{
    for (uint32_t pos = 0; pos < num_elements; pos++) {
        const uint8_t* src = h_idata + pos * sizeof(TData);
        const uint8_t* dst = h_odata + pos * sizeof(TData);
        for (uint32_t i = 0; i < packed_size; i++) {
            if (src[i] != dst[i]) {
                return false;
            }
        }
    }
    return true;
}

struct TestResult {
    const char* name;
    uint32_t    elem_size;
    uint32_t    elem_align;
    uint32_t    elements;
    float       avg_ms;
    double      gbps;
    bool        passed;
};

template <class TData>
TestResult run_test(const char* name, uint32_t packed_size,
                    uint8_t* d_idata, uint8_t* d_odata,
                    uint8_t* h_idata, uint8_t* h_odata,
                    aclrtStream stream)
{
    uint32_t num_elements = static_cast<uint32_t>(MEM_BYTES / sizeof(TData));
    // const auto& platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    // uint32_t aiv_num = platformInfoMgr->GetCoreNumAiv();  // 64
    aclrtMemset(d_odata, MEM_BYTES, 0, MEM_BYTES);

    aclrtEvent start_evt = nullptr;
    aclrtEvent end_evt   = nullptr;
    aclrtCreateEvent(&start_evt);
    aclrtCreateEvent(&end_evt);

    aclrtRecordEvent(start_evt, stream);
    for (uint32_t i = 0; i < NUM_ITERATIONS; i++) {
        aligned_copy_kernel<TData><<<1, THREAD_COUNT, 0, stream>>>(
            reinterpret_cast<TData*>(d_odata),
            reinterpret_cast<TData*>(d_idata),
            num_elements);
    }
    aclrtRecordEvent(end_evt, stream);
    aclrtSynchronizeStream(stream);

    float total_ms = 0.0f;
    aclrtEventElapsedTime(&total_ms, start_evt, end_evt);
    float avg_ms = total_ms / static_cast<float>(NUM_ITERATIONS);

    aclrtDestroyEvent(start_evt);
    aclrtDestroyEvent(end_evt);

    aclrtMemcpy(h_odata, MEM_BYTES, d_odata, MEM_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    bool passed = verify_packed<TData>(h_odata, h_idata, num_elements, packed_size);

    double bytes = static_cast<double>(num_elements) * sizeof(TData);
    double gbps  = bytes / (static_cast<double>(avg_ms) * 1e-3) / (1024.0 * 1024.0 * 1024.0);

    printf("[%-12s] sizeof=%2uB alignof=%2uB elems=%9u Avg.time: %8.4f ms / Throughput: %7.2f GB/s.   [%s]\n",
           name,
           static_cast<uint32_t>(sizeof(TData)),
           static_cast<uint32_t>(alignof(TData)),
           num_elements,
           avg_ms, gbps,
           passed ? "TEST OK" : "TEST FAIL");

    return TestResult{name,
                      static_cast<uint32_t>(sizeof(TData)),
                      static_cast<uint32_t>(alignof(TData)),
                      num_elements,
                      avg_ms,
                      gbps,
                      passed};
}

void print_summary(const std::vector<TestResult>& results)
{
    printf("\n============================ Summary ============================\n");
    printf(" TData       | sizeof | alignof |  elements |    ms    |  GB/s\n");
    printf("-------------+--------+---------+-----------+----------+--------\n");
    for (const auto& r : results) {
        printf(" %-11s | %5uB  | %6uB  | %9u | %8.4f | %6.2f\n",
               r.name, r.elem_size, r.elem_align,
               r.elements, r.avg_ms, r.gbps);
    }
    printf("=================================================================\n");
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    uint8_t* h_idata = nullptr;
    uint8_t* h_odata = nullptr;
    void* d_idata = nullptr;
    void* d_odata = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&h_idata), MEM_BYTES);
    aclrtMallocHost(reinterpret_cast<void**>(&h_odata), MEM_BYTES);
    aclrtMalloc(&d_idata, MEM_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&d_odata, MEM_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    for (size_t i = 0; i < MEM_BYTES; i++) {
        h_idata[i] = static_cast<uint8_t>((i & 0xFF) + 1);
    }
    aclrtMemcpy(d_idata, MEM_BYTES, h_idata, MEM_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    std::vector<TestResult> results;
    results.reserve(15);

    results.push_back(run_test<Align3    >("Align3",      3, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Misalign3 >("Misalign3",   3, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align4    >("Align4",      4, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Misalign4 >("Misalign4",   4, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align8    >("Align8",      8, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Misalign8 >("Misalign8",   8, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align12   >("Align12",    12, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Misalign12>("Misalign12", 12, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align16   >("Align16",    16, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align16_8 >("Align16_8",  16, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Misalign16>("Misalign16", 16, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align32   >("Align32",    32, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align32_16>("Align32_16", 32, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Align32_8 >("Align32_8",  32, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));
    results.push_back(run_test<Misalign32>("Misalign32", 32, static_cast<uint8_t*>(d_idata), static_cast<uint8_t*>(d_odata), h_idata, h_odata, stream));

    print_summary(results);

    uint32_t failures = 0;
    for (const auto& r : results) {
        if (!r.passed) {
            failures++;
        }
    }
    printf("\n[aligned_type] -> Test Results: %u failures.\n", failures);

    aclrtFree(d_idata);
    aclrtFree(d_odata);
    aclrtFreeHost(h_idata);
    aclrtFreeHost(h_odata);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return failures == 0 ? 0 : 1;
}
