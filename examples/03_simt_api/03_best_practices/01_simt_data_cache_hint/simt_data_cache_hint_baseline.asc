/* !
 * \file simt_data_cache_hint.asc
 * \brief Demo for data cache hint optimization using asc_ldcg and asc_stcg
 */

#include <cstdint>
#include <cstddef>
#include <cmath>
#include <random>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "asc_simt.h"

namespace {
constexpr float PI = 3.14159265358979323846f;
constexpr uint32_t KB16 = 16 * 1024;
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t USE_OPTIMIZED = 0;
constexpr uint32_t USE_BASELINE = 1;
}

__global__ __launch_bounds__(THREAD_COUNT) void sin_table_lookup_baseline(float* input, float* sin_table,
                                                                           float* output, uint32_t input_length,
                                                                           uint32_t table_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= input_length) {
        return;
    }

    float x = input[idx];
    float index_float = x / PI * static_cast<float>(table_length);
    uint32_t n = static_cast<uint32_t>(floorf(index_float));
    float frac = index_float - static_cast<float>(n);

    float low_val = sin_table[n];
    float high_val = 0.0f;
    if (n + 1 >=  table_length) {
        high_val = sin_table[0];
    } else {
        high_val = sin_table[n + 1];
    }

    output[idx] = low_val + frac * (high_val - low_val);
}

__global__ __launch_bounds__(THREAD_COUNT) void sin_table_lookup_optimized(float* input, float* sin_table,
                                                                           float* output, uint32_t input_length,
                                                                           uint32_t table_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= input_length) {
        return;
    }

    float x = input[idx];
    float index_float = x / PI * static_cast<float>(table_length);

    uint32_t n = static_cast<uint32_t>(floorf(index_float));
    float frac = index_float - static_cast<float>(n);

    float low_val = sin_table[n];
    float high_val = 0.0f;
    if (n + 1 >=  table_length) {
        high_val = sin_table[0];
    } else {
        high_val = sin_table[n + 1];
    }
    float y = low_val + frac * (high_val - low_val);

    asc_stcg(&output[idx], y);
}

void generate_input_data(std::vector<float>& input, uint32_t input_length)
{
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<float> dist(0.0f, PI);
    for (uint32_t i = 0; i < input_length; i++) {
        input[i] = dist(gen);
    }
}

void generate_sin_table(std::vector<float>& sin_table, uint32_t table_length)
{
    for (uint32_t i = 0; i < table_length; i++) {
        float angle = static_cast<float>(i) / table_length * PI;
        sin_table[i] = std::sin(angle);
    }
}

std::vector<float> launch_kernel(std::vector<float>& input, std::vector<float>& sin_table,
                                  uint32_t input_length, uint32_t table_length, uint32_t kernel_type)
{
    size_t input_bytes = input_length * sizeof(float);
    size_t table_bytes = table_length * sizeof(float);
    size_t output_bytes = input_length * sizeof(float);

    uint32_t num_blocks = (input_length + THREAD_COUNT - 1) / THREAD_COUNT;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    void* input_host = reinterpret_cast<void*>(input.data());
    void* input_device = nullptr;
    void* table_host = reinterpret_cast<void*>(sin_table.data());
    void* table_device = nullptr;
    void* output_host = nullptr;
    void* output_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    aclrtMallocHost(&output_host, output_bytes);
    aclrtMalloc(&input_device, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&table_device, table_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&output_device, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, input_bytes, input_host, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(table_device, table_bytes, table_host, table_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    for (int i = 0; i < 20; i++) {
        if (kernel_type == USE_BASELINE) {
            sin_table_lookup_baseline<<<num_blocks, THREAD_COUNT, 0, stream>>>(
                static_cast<float*>(input_device), static_cast<float*>(table_device),
                static_cast<float*>(output_device), input_length, table_length);
        } else {
            sin_table_lookup_optimized<<<num_blocks, THREAD_COUNT, 0, stream>>>(
                static_cast<float*>(input_device), static_cast<float*>(table_device),
                static_cast<float*>(output_device), input_length, table_length);
        }
    }
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output(static_cast<float*>(output_host), static_cast<float*>(output_host) + input_length);

    aclrtFree(input_device);
    aclrtFree(table_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

void check_result(std::vector<float>& input, std::vector<float>& sin_table, std::vector<float>& output,
                   uint32_t input_length, uint32_t table_length)
{
    constexpr float epsilon = 1e-5f;
    uint32_t count = 0;

    for (uint32_t i = 0; i < input_length; i++) {
        float x = input[i];
        float expected = std::sin(x);

        if (std::abs(output[i] - expected) > epsilon) {
            if (count < 5) {
                std::cout << "Check failed at index " << i << ": x=" << x
                          << ", expected " << expected << ", got " << output[i] << std::endl;
            }
            count++;
        }
    }

    if (count == 0) {
        std::cout << "[Success] All results are correct." << std::endl;
    } else {
        std::cout << "[Failed] Total " << count << " errors found." << std::endl;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t input_length = KB16 / sizeof(float);
    uint32_t table_length = KB16 / sizeof(float);

    std::vector<float> input(input_length);
    std::vector<float> sin_table(table_length);

    generate_input_data(input, input_length);
    generate_sin_table(sin_table, table_length);

    std::cout << "Input length: " << input_length << std::endl;
    std::cout << "Sin table length: " << table_length << std::endl;

    std::cout << "\n=== Running Baseline Kernel ===" << std::endl;
    std::vector<float> output_baseline = launch_kernel(input, sin_table, input_length, table_length, USE_BASELINE);
    check_result(input, sin_table, output_baseline, input_length, table_length);

    return 0;
}
