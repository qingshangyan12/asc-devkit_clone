/**
 * probe_gather.asc —— 参数化 gather 探针（TOTAL / NB / TPB 为编译宏），
 * 用于对不同 (元素总数, 核数) 组合扫描 msprof Task Duration，定位中-shape 下的最优核数。
 * 实测数据见 ../perf_data/measurements.md，原始 msprof CSV 见 ../perf_data/raw/。
 */
#include <iostream>
#include <vector>
#include <cstdlib>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#ifndef TOTAL
#define TOTAL 131072
#endif
#ifndef NB
#define NB 64
#endif
#ifndef TPB
#define TPB 2048
#endif

namespace { constexpr uint32_t THREAD_NUM = TPB; }

__global__ __launch_bounds__(THREAD_NUM) void gather_strided_kernel(
    float* input, uint32_t* index, float* output,
    uint32_t input_total_length, uint32_t index_total_length)
{
    uint32_t rows_per_block = index_total_length / gridDim.x;
    uint32_t index_start = blockIdx.x * rows_per_block;
    for (uint32_t local_idx = threadIdx.x; local_idx < rows_per_block; local_idx += blockDim.x) {
        uint32_t gather_idx = index[index_start + local_idx];
        if (gather_idx >= input_total_length) { gather_idx = 0; }
        output[index_start + local_idx] = input[gather_idx];
    }
}

int main() {
    srand(42);
    constexpr uint32_t input_total_length = 1100000;
    constexpr uint32_t total = TOTAL;
    std::vector<float> input(input_total_length);
    for (uint32_t i = 0; i < input_total_length; i++) input[i] = i * 1.2f;
    std::vector<uint32_t> index(total);
    for (uint32_t i = 0; i < total; i++) index[i] = rand() % input_total_length;

    int32_t device_id = 0; aclrtStream stream = nullptr;
    aclInit(nullptr); aclrtSetDevice(device_id); aclrtCreateStream(&stream);
    float* input_d=nullptr; uint32_t* index_d=nullptr; float* output_d=nullptr;
    aclrtMalloc((void**)&input_d, input_total_length*sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&index_d, total*sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_d, total*sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_d, input_total_length*sizeof(float), input.data(), input_total_length*sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(index_d, total*sizeof(uint32_t), index.data(), total*sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE);

    gather_strided_kernel<<<NB, THREAD_NUM, 0, stream>>>(input_d, index_d, output_d, input_total_length, total);
    aclrtSynchronizeStream(stream);

    printf("TOTAL=%u NB=%d rows_per_core=%u\n", total, NB, total/NB);
    aclrtFree(input_d); aclrtFree(index_d); aclrtFree(output_d);
    aclrtDestroyStream(stream); aclrtResetDevice(device_id); aclFinalize();
    return 0;
}
