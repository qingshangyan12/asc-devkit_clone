/* !
 * \file predicate_optimization.asc
 * \brief SIMT predicate optimization sample comparing early-return branches with predicated straight-line execution
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/math_functions.h"

namespace {

constexpr int32_t BLOCKS_PER_GRID = 8;
constexpr int32_t THREADS_PER_BLOCK = 1024;
constexpr int32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr uint32_t DYN_UBUF_SIZE = 0;
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;

// hlog10需要一步修正的六个特殊值及其修正结果（half域）
constexpr float HLOG10_SPECIAL_INPUTS[6] = {0.2362060546875f, 0.2490234375f, 3.0703125f, 126.0625f, 11496.0f, 2976.0f};
constexpr float HLOG10_SPECIAL_RESULTS[6] = {-0.62646484375f, -0.60400390625f, 0.487060546875f, 2.099609375f, 4.05859375f, 3.474609375f};

enum class BatchType {
    NORMAL,   // 全正常值批
    SPECIAL,  // 全特殊值批
    MIXED,    // 混合批
    LOW_DOM,  // 低值段为主批
    HIGH_DOM, // 高值段为主批（含中值段）
};

// 单个用例的配置，由get_scenario_config按命令行参数取得
struct ScenarioConfig {
    int32_t case_id;  // 用例编号，决定launch哪一个kernel
    BatchType batch;  // 输入数据批类型
    int32_t peer_id;  // 同组对照kernel编号，用于逐元素一致性比对
    const char* name; // 用例名
};

ScenarioConfig get_scenario_config(const std::string& case_name)
{
    // hlog10组：case 0/1，特殊值与正常值并存的单批输入，case0与case1互为对照
    if (case_name == "hlog10_case0") {
        return {0, BatchType::MIXED, 1, "hlog10_case0: special-value fix before normal path, early return"};
    }
    if (case_name == "hlog10_case1") {
        return {1, BatchType::MIXED, 0, "hlog10_case1: normal path first, fix temp at last, single return"};
    }
    // j0f组：case 2/3/4，四批输入，优化case与基线case2对照
    if (case_name == "j0f_case2_low") {
        return {2, BatchType::LOW_DOM, 3, "j0f_case2: all branches return immediately (baseline)"};
    }
    if (case_name == "j0f_case2_high") {
        return {2, BatchType::HIGH_DOM, 3, "j0f_case2: all branches return immediately (baseline)"};
    }
    if (case_name == "j0f_case2_special") {
        return {2, BatchType::SPECIAL, 3, "j0f_case2: all branches return immediately (baseline)"};
    }
    if (case_name == "j0f_case2_mixed") {
        return {2, BatchType::MIXED, 3, "j0f_case2: all branches return immediately (baseline)"};
    }
    if (case_name == "j0f_case3_low") {
        return {3, BatchType::LOW_DOM, 2, "j0f_case3: all branches overwrite result, single return"};
    }
    if (case_name == "j0f_case3_high") {
        return {3, BatchType::HIGH_DOM, 2, "j0f_case3: all branches overwrite result, single return"};
    }
    if (case_name == "j0f_case3_special") {
        return {3, BatchType::SPECIAL, 2, "j0f_case3: all branches overwrite result, single return"};
    }
    if (case_name == "j0f_case3_mixed") {
        return {3, BatchType::MIXED, 2, "j0f_case3: all branches overwrite result, single return"};
    }
    if (case_name == "j0f_case4_low") {
        return {4, BatchType::LOW_DOM, 2, "j0f_case4: wide branches return, rest overwrite, single return"};
    }
    if (case_name == "j0f_case4_high") {
        return {4, BatchType::HIGH_DOM, 2, "j0f_case4: wide branches return, rest overwrite, single return"};
    }
    if (case_name == "j0f_case4_special") {
        return {4, BatchType::SPECIAL, 2, "j0f_case4: wide branches return, rest overwrite, single return"};
    }
    if (case_name == "j0f_case4_mixed") {
        return {4, BatchType::MIXED, 2, "j0f_case4: wide branches return, rest overwrite, single return"};
    }
    return {-1, BatchType::NORMAL, -1, ""}; // 未匹配到用例名，由parse_args统一报错
}

constexpr int32_t DEVICE_ID = 0;
} // namespace

int32_t check_acl_result(aclError ret, const char* expr, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return SUCCESS;
    }
    const char* msg = aclGetRecentErrMsg();
    fprintf(
        stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, line, static_cast<int>(ret),
        (msg != nullptr) ? msg : "no detail", expr);
    return FAILED;
}

#define CHECK_ACL(expr)                                             \
    do {                                                            \
        if (check_acl_result((expr), #expr, __LINE__) != SUCCESS) { \
            return FAILED;                                          \
        }                                                           \
    } while (0)

__aicore__ inline half hlog10_case0(half x)
{
    if (x == static_cast<half>(0.2362060546875f)) {
        return static_cast<half>(-0.62646484375f);
    } else if (x == static_cast<half>(0.2490234375f)) {
        return static_cast<half>(-0.60400390625f);
    } else if (x == static_cast<half>(3.0703125f)) {
        return static_cast<half>(0.487060546875f);
    } else if (x == static_cast<half>(126.0625f)) {
        return static_cast<half>(2.099609375f);
    } else if (x == static_cast<half>(11496.0f)) {
        return static_cast<half>(4.05859375f);
    } else if (x == static_cast<half>(2976.0f)) {
        return static_cast<half>(3.474609375f);
    }
    float x_fp32 = __cvt_float<__internal_get_round<__RoundMode::CAST_RINT>(), RoundingSaturation::RS_DISABLE_VALUE>(x);
    float result_fp32 = logf(x_fp32) / logf(10.0f); // log10(x) = log(x) / log(10)
    return __cvt_half<__internal_get_round<__RoundMode::CAST_RINT>(), RoundingSaturation::RS_DISABLE_VALUE>(result_fp32);
}

__aicore__ inline half hlog10_case1(half x)
{
    float x_fp32 = __cvt_float<__internal_get_round<__RoundMode::CAST_RINT>(), RoundingSaturation::RS_DISABLE_VALUE>(x);
    float result_fp32 = logf(x_fp32) / logf(10.0f); // log10(x) = log(x) / log(10)
    half temp = __cvt_half<__internal_get_round<__RoundMode::CAST_RINT>(), RoundingSaturation::RS_DISABLE_VALUE>(result_fp32);
    if (x == static_cast<half>(0.2362060546875f)) {
        temp = static_cast<half>(-0.62646484375f);
    } else if (x == static_cast<half>(0.2490234375f)) {
        temp = static_cast<half>(-0.60400390625f);
    } else if (x == static_cast<half>(3.0703125f)) {
        temp = static_cast<half>(0.487060546875f);
    } else if (x == static_cast<half>(126.0625f)) {
        temp = static_cast<half>(2.099609375f);
    } else if (x == static_cast<half>(11496.0f)) {
        temp = static_cast<half>(4.05859375f);
    } else if (x == static_cast<half>(2976.0f)) {
        temp = static_cast<half>(3.474609375f);
    }
    return temp;
}

__aicore__ inline float j0f_case2(float x)
{
    if (__isnan(x)) {
        return x;
    }
    float ax = __fabsf(x);
    if (__isinf(ax)) {
        return 0.0f;
    }
    if (ax <= 8.0f) {
        return __internal_j0f_less8(ax);
    }
    if (ax <= 1.0e13f) {
        return __internal_j0f_middle_range(ax);
    }
    return __internal_j0f_huge_range(ax);
}

__aicore__ inline float j0f_case3(float x)
{
    float ax = __fabsf(x);
    float result = __internal_j0f_huge_range(ax);   // 无条件执行高值段计算
    if (ax <= 1.0e13f) {
        result = __internal_j0f_middle_range(ax);
    }
    if (ax <= 8.0f) {
        result = __internal_j0f_less8(ax);
    }
    if (__isnan(x)) {
        result = x;                         // NaN -> NaN
    }
    if (__isinf(ax)) {
        result = 0.0f;                      // ±Inf -> 0
    }
    return result;
}

__aicore__ inline float j0f_case4(float x)
{
    float ax = __fabsf(x);
    if (ax <= 8.0f) {
        return __internal_j0f_less8(ax);    // 分支体长：命中即返回，只执行命中方向
    }
    if (ax <= 1.0e13f) {
        return __internal_j0f_middle_range(ax);
    }
    float result = __internal_j0f_huge_range(ax);
    if (__isnan(x)) {
        result = x;
    }
    if (__isinf(ax)) {
        result = 0.0f;
    }
    return result;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void hlog10_case0_kernel(
    half* input, half* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = hlog10_case0(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("hlog10_case0 execute cycle : %lu\n", end - start);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void hlog10_case1_kernel(
    half* input, half* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = hlog10_case1(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("hlog10_case1 execute cycle : %lu\n", end - start);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_case2_kernel(
    float* input, float* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = j0f_case2(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("j0f_case2 execute cycle : %lu\n", end - start);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_case3_kernel(
    float* input, float* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = j0f_case3(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("j0f_case3 execute cycle : %lu\n", end - start);
    }
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_case4_kernel(
    float* input, float* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = j0f_case4(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("j0f_case4 execute cycle : %lu\n", end - start);
    }
}

int32_t parse_args(int32_t argc, char* argv[], ScenarioConfig& scenario)
{
    if (argc != 2) {
        printf("[Failed] Invalid input, usage: \"predicate_optimization "
               "<hlog10_case0|hlog10_case1|j0f_case2_low|j0f_case2_high|j0f_case2_special|"
               "j0f_case2_mixed|j0f_case3_low|j0f_case3_high|j0f_case3_special|j0f_case3_mixed|"
               "j0f_case4_low|j0f_case4_high|j0f_case4_special|j0f_case4_mixed>\".\n");
        return FAILED;
    }

    scenario = get_scenario_config(argv[1]);
    const bool is_valid = (scenario.case_id >= 0) && (scenario.case_id <= 4);
    if (!is_valid) {
        printf("[Failed] Invalid case name, expected one of the case names listed above.\n");
        return FAILED;
    }

    printf("Case %s: %s\n", argv[1], scenario.name);
    printf("num_elements = %d, blocks = %d, threads per block = %d\n", TOTAL_THREADS, BLOCKS_PER_GRID,
        THREADS_PER_BLOCK);
    return SUCCESS;
}

// 按批类型构造hlog10输入（uint16_t即half位表示），并同步算出CPU golden：
// 特殊值命中修正表，正常值走log10路径后经half往返（容差比对见verify_hlog10_result）
int32_t generate_hlog10_data(
    const ScenarioConfig& scenario, std::vector<uint16_t>& input, std::vector<uint16_t>& golden)
{
    input.resize(TOTAL_THREADS);
    golden.resize(TOTAL_THREADS);
    const BatchType batch = scenario.batch;
    for (int32_t i = 0; i < TOTAL_THREADS; i++) {
        float value = 1.0f + static_cast<float>(i % 4096) * 0.25f; // 正常值域，避开六个特殊值
        if (batch == BatchType::SPECIAL) {
            value = HLOG10_SPECIAL_INPUTS[i % 6];
        } else if (batch == BatchType::MIXED && (i % 16) == 0) {
            value = HLOG10_SPECIAL_INPUTS[i % 6];
        }
        input[i] = aclFloatToFloat16(value);
        golden[i] = aclFloatToFloat16(::log10f(value)); // 正常值路径
        for (int32_t j = 0; j < 6; j++) {
            if (input[i] == aclFloatToFloat16(HLOG10_SPECIAL_INPUTS[j])) {
                golden[i] = aclFloatToFloat16(HLOG10_SPECIAL_RESULTS[j]); // 特殊值命中一步修正结果
                break;
            }
        }
    }
    return SUCCESS;
}

// 按批类型构造j0f输入，并同步算出CPU golden（NaN/Inf等特殊值由golden统一表达）
int32_t generate_j0f_data(const ScenarioConfig& scenario, std::vector<float>& input, std::vector<float>& golden)
{
    input.resize(TOTAL_THREADS);
    golden.resize(TOTAL_THREADS);
    const BatchType batch = scenario.batch;
    for (int32_t i = 0; i < TOTAL_THREADS; i++) {
        float value = 0.5f + static_cast<float>(i % 64) * 0.1f; // 低值段为主，默认落在ax <= 8.0f
        if (batch == BatchType::HIGH_DOM) {
            value = 16.0f + static_cast<float>(i % 1024) * 16.0f; // 高值段为主，含中值段
        } else if (batch == BatchType::SPECIAL) {
            value = ((i % 2) == 0) ? std::numeric_limits<float>::quiet_NaN() :
                                     std::numeric_limits<float>::infinity();
        } else if (batch == BatchType::MIXED) {
            if ((i % 4) == 0) {
                value = 0.5f + static_cast<float>(i % 64) * 0.1f; // 低值段
            } else if ((i % 4) == 1) {
                value = 16.0f + static_cast<float>(i % 1024) * 16.0f; // 高值段为主，含中值段
            } else if ((i % 4) == 2) {
                value = std::numeric_limits<float>::quiet_NaN();
            } else {
                value = -std::numeric_limits<float>::infinity();
            }
        }
        input[i] = value;
        // CPU golden调用libm的j0f：设备侧为分段多项式近似，样例输入域实测偏差<1.1e-6
        golden[i] = ::j0f(value);
    }
    return SUCCESS;
}

int32_t set_device(int32_t device_id, aclrtStream& stream)
{
    if (check_acl_result(aclInit(nullptr), "aclInit(nullptr)", __LINE__) != SUCCESS) {
        return FAILED;
    }
    if (check_acl_result(aclrtSetDevice(device_id), "aclrtSetDevice(device_id)", __LINE__) != SUCCESS) {
        (void)aclFinalize();
        return FAILED;
    }
    if (check_acl_result(aclrtCreateStream(&stream), "aclrtCreateStream(&stream)", __LINE__) != SUCCESS) {
        (void)aclrtResetDevice(device_id);
        (void)aclFinalize();
        return FAILED;
    }
    return SUCCESS;
}

template <typename T>
int32_t release_device_memory(T*& input_device, T*& output_device, T*& peer_device)
{
    int32_t ret = SUCCESS;

    if (peer_device != nullptr) {
        ret = check_acl_result(aclrtFree(peer_device), "aclrtFree(peer_device)", __LINE__);
        peer_device = nullptr;
    }
    if (output_device != nullptr) {
        const int32_t free_ret = check_acl_result(aclrtFree(output_device), "aclrtFree(output_device)", __LINE__);
        ret = (ret == SUCCESS) ? free_ret : ret;
        output_device = nullptr;
    }
    if (input_device != nullptr) {
        const int32_t free_ret = check_acl_result(aclrtFree(input_device), "aclrtFree(input_device)", __LINE__);
        ret = (ret == SUCCESS) ? free_ret : ret;
        input_device = nullptr;
    }
    return ret;
}

template <typename T>
int32_t prepare_device_data(const std::vector<T>& input, T*& input_device, T*& output_device, T*& peer_device)
{
    const size_t total_byte_size = input.size() * sizeof(T);
    CHECK_ACL(aclrtMalloc((void**)&input_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        input_device, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));
    // 选定case与其同组对照case共用同一份输入，输出分开存放，保证结果可直接逐元素对比
    CHECK_ACL(aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&peer_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    return SUCCESS;
}

void launch_hlog10_kernel(int32_t case_id, half* input, half* output, uint64_t total_length, aclrtStream stream)
{
    if (case_id == 0) {
        hlog10_case0_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input, output, total_length);
    } else {
        hlog10_case1_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input, output, total_length);
    }
}

void launch_j0f_kernel(int32_t case_id, float* input, float* output, uint64_t total_length, aclrtStream stream)
{
    if (case_id == 2) {
        j0f_case2_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input, output, total_length);
    } else if (case_id == 3) {
        j0f_case3_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input, output, total_length);
    } else {
        j0f_case4_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input, output, total_length);
    }
}

// 在同一份输入上依次运行选定case与其同组对照case，返回两份输出
int32_t launch_selected_kernel(
    const ScenarioConfig& scenario, uint16_t* input_device, uint16_t* output_device, uint16_t* peer_device,
    size_t total_length, aclrtStream stream)
{
    half* input = reinterpret_cast<half*>(input_device);
    launch_hlog10_kernel(
        scenario.case_id, input, reinterpret_cast<half*>(output_device), total_length, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    launch_hlog10_kernel(
        scenario.peer_id, input, reinterpret_cast<half*>(peer_device), total_length, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    return SUCCESS;
}

int32_t launch_selected_kernel(
    const ScenarioConfig& scenario, float* input_device, float* output_device, float* peer_device, size_t total_length,
    aclrtStream stream)
{
    launch_j0f_kernel(scenario.case_id, input_device, output_device, total_length, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    launch_j0f_kernel(scenario.peer_id, input_device, peer_device, total_length, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    return SUCCESS;
}

template <typename T>
int32_t copy_output_to_host(T* output_device, T* peer_device, std::vector<T>& output, std::vector<T>& peer_output)
{
    const size_t total_byte_size = output.size() * sizeof(T);
    CHECK_ACL(aclrtMemcpy(output.data(), total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(peer_output.data(), total_byte_size, peer_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
    return SUCCESS;
}

template <typename T>
int32_t launch_kernel(
    const ScenarioConfig& scenario, const std::vector<T>& input, aclrtStream stream, std::vector<T>& output,
    std::vector<T>& peer_output)
{
    T* input_device = nullptr;
    T* output_device = nullptr;
    T* peer_device = nullptr;

    int32_t ret = prepare_device_data(input, input_device, output_device, peer_device);
    if (ret == SUCCESS) {
        output.resize(input.size());
        peer_output.resize(input.size());
        ret = launch_selected_kernel(scenario, input_device, output_device, peer_device, input.size(), stream);
    }
    if (ret == SUCCESS) {
        ret = copy_output_to_host(output_device, peer_device, output, peer_output);
    }

    const int32_t release_ret = release_device_memory(input_device, output_device, peer_device);
    return (ret == SUCCESS) ? release_ret : ret;
}

int32_t reset_device(int32_t device_id, aclrtStream& stream)
{
    CHECK_ACL(aclrtDestroyStream(stream));
    stream = nullptr;
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return SUCCESS;
}

// hlog10正确性：两case输出逐元素一致，且与generate_hlog10_data产出的CPU golden比对（容差）
int32_t verify_hlog10_result(const ScenarioConfig& scenario, const std::vector<uint16_t>& input,
    const std::vector<uint16_t>& output, const std::vector<uint16_t>& peer_output,
    const std::vector<uint16_t>& golden)
{
    bool is_match = (output.size() == input.size()) && (peer_output.size() == input.size()) &&
        (golden.size() == input.size());
    for (size_t i = 0; is_match && i < input.size(); i++) {
        // 分支结构调整不改语义：同组两case输出逐元素一致
        is_match = (output[i] == peer_output[i]);
        if (!is_match) {
            printf("[Failed] Output mismatch between case%d and case%d at element %zu!\n", scenario.case_id,
                scenario.peer_id, i);
            break;
        }
        // CPU golden比对：特殊值命中修正表，正常值走log10路径，均经half往返
        is_match = std::fabs(aclFloat16ToFloat(output[i]) - aclFloat16ToFloat(golden[i])) <= 1e-2f;
        if (!is_match) {
            printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
            break;
        }
    }
    if (is_match) {
        printf("[Success] Case accuracy verification passed.\n");
        return SUCCESS;
    }
    return FAILED;
}

// j0f正确性：两case输出逐元素一致（NaN按位一致），且与generate_j0f_data产出的CPU golden
// 比对（容差覆盖libm与设备实现的偏差；NaN/Inf语义由golden统一表达）
int32_t verify_j0f_result(const ScenarioConfig& scenario, const std::vector<float>& input,
    const std::vector<float>& output, const std::vector<float>& peer_output, const std::vector<float>& golden)
{
    bool is_match = (output.size() == input.size()) && (peer_output.size() == input.size()) &&
        (golden.size() == input.size());
    for (size_t i = 0; is_match && i < input.size(); i++) {
        // 分支结构调整不改语义：同组两case输出逐元素一致
        is_match = (output[i] == peer_output[i]) || (std::isnan(output[i]) && std::isnan(peer_output[i]));
        if (!is_match) {
            printf("[Failed] Output mismatch between case%d and case%d at element %zu!\n", scenario.case_id,
                scenario.peer_id, i);
            break;
        }
        // CPU golden比对：NaN/Inf在golden中已是期望值，正常值容差比对
        if (std::isnan(golden[i])) {
            is_match = std::isnan(output[i]);
        } else {
            is_match = std::fabs(output[i] - golden[i]) <= 1e-4f;
        }
        if (!is_match) {
            printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
            break;
        }
    }
    if (is_match) {
        printf("[Success] Case accuracy verification passed.\n");
        return SUCCESS;
    }
    return FAILED;
}

int32_t main(int32_t argc, char* argv[])
{
    ScenarioConfig scenario{};

    int32_t ret = parse_args(argc, argv, scenario);
    if (ret != SUCCESS) {
        return ret;
    }

    aclrtStream stream = nullptr;
    ret = set_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    if (scenario.case_id <= 1) {
        std::vector<uint16_t> input;
        std::vector<uint16_t> output;
        std::vector<uint16_t> peer_output;
        std::vector<uint16_t> golden;
        ret = generate_hlog10_data(scenario, input, golden);
        if (ret == SUCCESS) {
            ret = launch_kernel(scenario, input, stream, output, peer_output);
        }
        if (ret != SUCCESS) {
            (void)reset_device(DEVICE_ID, stream);
            return ret;
        }

        ret = reset_device(DEVICE_ID, stream);
        if (ret != SUCCESS) {
            return ret;
        }
        return verify_hlog10_result(scenario, input, output, peer_output, golden);
    }

    std::vector<float> input;
    std::vector<float> output;
    std::vector<float> peer_output;
    std::vector<float> golden;
    ret = generate_j0f_data(scenario, input, golden);
    if (ret == SUCCESS) {
        ret = launch_kernel(scenario, input, stream, output, peer_output);
    }
    if (ret != SUCCESS) {
        (void)reset_device(DEVICE_ID, stream);
        return ret;
    }

    ret = reset_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }
    return verify_j0f_result(scenario, input, output, peer_output, golden);
}
