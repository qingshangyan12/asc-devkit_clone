/* !
 * \file predicate_optimization.asc
 * \brief SIMT predicate optimization sample comparing early-return branches with predicated straight-line execution
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/math_functions.h"

// 运行的用例由编译宏SCENARIO_NUM在编译期选定（CMakeLists中通过-DSCENARIO_NUM=n配置）：
//   1 - hlog10_case0：特殊值修正链前置，命中即提前return（基线）
//   2 - hlog10_case1：正常值路径前置，修正链统一return覆盖temp（优化）
//   3 - j0f_case2：所有分支命中即直接返回（基线）
//   4 - j0f_case3：分段计算逐级覆盖result，全分支统一return（全谓词化）
//   5/6/7/8 - j0f_case4：真跳转与谓词化混合，输入批依次为低值段/高值段/全特殊值/混合
#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 8
#error "SCENARIO_NUM must be one of 1..8."
#endif

namespace {
constexpr int32_t BLOCKS_PER_GRID = 8;
constexpr int32_t THREADS_PER_BLOCK = 1024;
constexpr int32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr uint32_t DYN_UBUF_SIZE = 0;
constexpr int32_t DEVICE_ID = 0;
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;

// hlog10需要一步修正的六个特殊值及其修正结果（half域）
constexpr int32_t HLOG10_SPECIAL_COUNT = 6;
constexpr float HLOG10_SPECIAL_INPUTS[HLOG10_SPECIAL_COUNT] = {
    0.2362060546875f, 0.2490234375f, 3.0703125f, 126.0625f, 11496.0f, 2976.0f};
constexpr float HLOG10_SPECIAL_RESULTS[HLOG10_SPECIAL_COUNT] = {
    -0.62646484375f, -0.60400390625f, 0.487060546875f, 2.099609375f, 4.05859375f, 3.474609375f};

enum class BatchType {
    NORMAL,   // 常规批：大量数据落在低值段，约1/16为NaN/Inf特殊值
    SPECIAL,  // 全特殊值批
    MIXED,    // 混合批
    LOW_DOM,  // 低值段为主批
    HIGH_DOM, // 高值段为主批（含中值段）
};

// 当前用例的输入批类型
#if SCENARIO_NUM == 3 || SCENARIO_NUM == 4
constexpr BatchType BATCH_TYPE = BatchType::NORMAL;
#elif SCENARIO_NUM == 5
constexpr BatchType BATCH_TYPE = BatchType::LOW_DOM;
#elif SCENARIO_NUM == 6
constexpr BatchType BATCH_TYPE = BatchType::HIGH_DOM;
#elif SCENARIO_NUM == 7
constexpr BatchType BATCH_TYPE = BatchType::SPECIAL;
#else // 用例1 / 2 / 8
constexpr BatchType BATCH_TYPE = BatchType::MIXED;
#endif

const char* get_kernel_name(int32_t kernel_kind)
{
    switch (kernel_kind) {
        case 1:
            return "hlog10_case0";
        case 2:
            return "hlog10_case1";
        case 3:
            return "j0f_case2";
        case 4:
            return "j0f_case3";
        case 5:
            return "j0f_case4_low";
        case 6:
            return "j0f_case4_high";
        case 7:
            return "j0f_case4_special";
        case 8:
            return "j0f_case4_mixed";
        default:
            return "unknown";
    }
}

// hlog10组host侧以uint16_t存储half位表示，j0f组直接使用float
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
using HostT = uint16_t;
#else
using HostT = float;
#endif
} // namespace

int32_t check_acl_result(aclError ret, const char* expr, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return SUCCESS;
    }
    const char* msg = aclGetRecentErrMsg();
    fprintf(
        stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, line, static_cast<int>(ret),
        (msg != nullptr) ? msg : "no detail", expr);
    return FAILED;
}

#define CHECK_ACL(expr)                                             \
    do {                                                            \
        if (check_acl_result((expr), #expr, __LINE__) != SUCCESS) { \
            return FAILED;                                          \
        }                                                           \
    } while (0)

// =====================================================================================
// kernel实现：每个SCENARIO_NUM只编译当前case的计算函数与kernel，其余case不进产物
// =====================================================================================

#if SCENARIO_NUM == 1
__aicore__ inline half hlog10_case0(half x)
{
    if (x == static_cast<half>(0.2362060546875f)) {
        return static_cast<half>(-0.62646484375f);
    } else if (x == static_cast<half>(0.2490234375f)) {
        return static_cast<half>(-0.60400390625f);
    } else if (x == static_cast<half>(3.0703125f)) {
        return static_cast<half>(0.487060546875f);
    } else if (x == static_cast<half>(126.0625f)) {
        return static_cast<half>(2.099609375f);
    } else if (x == static_cast<half>(11496.0f)) {
        return static_cast<half>(4.05859375f);
    } else if (x == static_cast<half>(2976.0f)) {
        return static_cast<half>(3.474609375f);
    }
    float x_fp32 = __half2float(x);
    float result_fp32 = logf(x_fp32) / logf(10.0f); // log10(x) = log(x) / log(10)
    return __float2half_rn(result_fp32);
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void hlog10_case0_kernel(
    half* input, half* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = hlog10_case0(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("hlog10_case0 execute cycle : %lu\n", end - start);
    }
}
#elif SCENARIO_NUM == 2
__aicore__ inline half hlog10_case1(half x)
{
    float x_fp32 = __half2float(x);
    float result_fp32 = logf(x_fp32) / logf(10.0f); // log10(x) = log(x) / log(10)
    half temp = __float2half_rn(result_fp32);
    if (x == static_cast<half>(0.2362060546875f)) {
        temp = static_cast<half>(-0.62646484375f);
    } else if (x == static_cast<half>(0.2490234375f)) {
        temp = static_cast<half>(-0.60400390625f);
    } else if (x == static_cast<half>(3.0703125f)) {
        temp = static_cast<half>(0.487060546875f);
    } else if (x == static_cast<half>(126.0625f)) {
        temp = static_cast<half>(2.099609375f);
    } else if (x == static_cast<half>(11496.0f)) {
        temp = static_cast<half>(4.05859375f);
    } else if (x == static_cast<half>(2976.0f)) {
        temp = static_cast<half>(3.474609375f);
    }
    return temp;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void hlog10_case1_kernel(
    half* input, half* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = hlog10_case1(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("hlog10_case1 execute cycle : %lu\n", end - start);
    }
}
#elif SCENARIO_NUM == 3
__aicore__ inline float j0f_case2(float x)
{
    if (isnan(x)) {
        return x;
    }
    float ax = fabsf(x);
    if (isinf(ax)) {
        return 0.0f;
    }
    if (ax <= 8.0f) {
        return __internal_j0f_less8(ax);
    }
    if (ax <= 1.0e13f) {
        return __internal_j0f_middle_range(ax);
    }
    return __internal_j0f_huge_range(ax);
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_case2_kernel(
    float* input, float* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = j0f_case2(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("j0f_case2 execute cycle : %lu\n", end - start);
    }
}
#elif SCENARIO_NUM == 4
__aicore__ inline float j0f_case3(float x)
{
    float ax = fabsf(x);
    float result = __internal_j0f_huge_range(ax);   // 无条件执行高值段计算
    if (ax <= 1.0e13f) {
        result = __internal_j0f_middle_range(ax);
    }
    if (ax <= 8.0f) {
        result = __internal_j0f_less8(ax);
    }
    if (isnan(x)) {
        result = x;                         // NaN -> NaN
    }
    if (isinf(ax)) {
        result = 0.0f;                      // ±Inf -> 0
    }
    return result;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_case3_kernel(
    float* input, float* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = j0f_case3(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("j0f_case3 execute cycle : %lu\n", end - start);
    }
}
#else
__aicore__ inline float j0f_case4(float x)
{
    float ax = fabsf(x);
    if (ax <= 8.0f) {
        return __internal_j0f_less8(ax);    // 分支体长：命中即返回，只执行命中方向
    }
    if (ax <= 1.0e13f) {
        return __internal_j0f_middle_range(ax);
    }
    float result = __internal_j0f_huge_range(ax);
    if (isnan(x)) {
        result = x;
    }
    if (isinf(ax)) {
        result = 0.0f;
    }
    return result;
}

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_case4_kernel(
    float* input, float* output, uint64_t total_length)
{
    uint64_t start = clock();
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    output[idx] = j0f_case4(input[idx]);
    uint64_t end = clock();
    if (blockIdx.x == 0 && threadIdx.x == 0) {
        printf("j0f_case4 execute cycle : %lu\n", end - start);
    }
}
#endif

// =====================================================================================
// host侧流程：输入生成 / kernel launch / 结果校验，均按编译期选定的case组织
// =====================================================================================

// launch当前用例的kernel（编译期只保留当前case的分支）
void launch_case_kernel(HostT* input_device, HostT* output_device, uint64_t total_length, aclrtStream stream)
{
#if SCENARIO_NUM == 1
    hlog10_case0_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        reinterpret_cast<half*>(input_device), reinterpret_cast<half*>(output_device), total_length);
#elif SCENARIO_NUM == 2
    hlog10_case1_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        reinterpret_cast<half*>(input_device), reinterpret_cast<half*>(output_device), total_length);
#elif SCENARIO_NUM == 3
    j0f_case2_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, output_device, total_length);
#elif SCENARIO_NUM == 4
    j0f_case3_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, output_device, total_length);
#else
    j0f_case4_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, output_device, total_length);
#endif
}

#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
// hlog10组输入：uint16_t即half位表示
// 按批类型构造输入：混合批约1/16为特殊值，其余落在避开六个特殊值的正常值域
void generate_case_input(std::vector<HostT>& input)
{
    input.resize(TOTAL_THREADS);
    for (int32_t i = 0; i < TOTAL_THREADS; i++) {
        float value = 1.0f + static_cast<float>(i % 4096) * 0.25f; // 正常值域，避开六个特殊值
        if ((i % 16) == 0) {
            value = HLOG10_SPECIAL_INPUTS[i % HLOG10_SPECIAL_COUNT]; // 混合批：约1/16为特殊值
        }
        input[i] = aclFloatToFloat16(value);
    }
}

// hlog10组golden：正常值走log10路径后经half往返，命中特殊值则查表取一步修正结果
void compute_case_golden(const std::vector<HostT>& input, std::vector<HostT>& golden)
{
    golden.resize(input.size());
    for (size_t i = 0; i < input.size(); i++) {
        golden[i] = aclFloatToFloat16(
            ::log10f(aclFloat16ToFloat(input[i]))); // 正常值路径（输入经half往返保证golden与kernel同输入域）
        for (int32_t j = 0; j < HLOG10_SPECIAL_COUNT; j++) {
            if (input[i] == aclFloatToFloat16(HLOG10_SPECIAL_INPUTS[j])) {
                golden[i] = aclFloatToFloat16(HLOG10_SPECIAL_RESULTS[j]); // 特殊值命中一步修正结果
                break;
            }
        }
    }
}
#else
// j0f组输入：按批类型构造，控制各分段与NaN/Inf的命中比例
void generate_case_input(std::vector<HostT>& input)
{
    input.resize(TOTAL_THREADS);
    for (int32_t i = 0; i < TOTAL_THREADS; i++) {
        float value = 0.5f + static_cast<float>(i % 64) * 0.1f; // 低值段为主，默认落在ax <= 8.0f
        if (BATCH_TYPE == BatchType::NORMAL && (i % 16) == 0) {
            // 常规批：约1/16为NaN/Inf特殊值，其余大量落在低值段，构造思路与hlog10组一致
            value = ((i % 32) == 0) ? std::numeric_limits<float>::quiet_NaN() :
                                     std::numeric_limits<float>::infinity();
        } else if (BATCH_TYPE == BatchType::HIGH_DOM) {
            value = 16.0f + static_cast<float>(i % 1024) * 16.0f; // 高值段为主，含中值段
        } else if (BATCH_TYPE == BatchType::SPECIAL) {
            value = ((i % 2) == 0) ? std::numeric_limits<float>::quiet_NaN() :
                                     std::numeric_limits<float>::infinity();
        } else if (BATCH_TYPE == BatchType::MIXED) {
            if ((i % 4) == 0) {
                value = 0.5f + static_cast<float>(i % 64) * 0.1f; // 低值段
            } else if ((i % 4) == 1) {
                value = 16.0f + static_cast<float>(i % 1024) * 16.0f; // 高值段为主，含中值段
            } else if ((i % 4) == 2) {
                value = std::numeric_limits<float>::quiet_NaN();
            } else {
                value = -std::numeric_limits<float>::infinity();
            }
        }
        input[i] = value;
    }
}

// j0f组golden：调用libm的j0f（NaN/Inf等特殊值由golden统一表达）
// 设备侧为分段多项式近似，样例输入域实测偏差<1.1e-6，由校验容差覆盖
void compute_case_golden(const std::vector<HostT>& input, std::vector<HostT>& golden)
{
    golden.resize(input.size());
    for (size_t i = 0; i < input.size(); i++) {
        golden[i] = ::j0f(input[i]);
    }
}
#endif

void prepare_case_data(std::vector<HostT>& input, std::vector<HostT>& golden)
{
    generate_case_input(input);
    compute_case_golden(input, golden);
}

int32_t set_device(int32_t device_id, aclrtStream& stream)
{
    if (check_acl_result(aclInit(nullptr), "aclInit(nullptr)", __LINE__) != SUCCESS) {
        return FAILED;
    }
    if (check_acl_result(aclrtSetDevice(device_id), "aclrtSetDevice(device_id)", __LINE__) != SUCCESS) {
        (void)aclFinalize();
        return FAILED;
    }
    if (check_acl_result(aclrtCreateStream(&stream), "aclrtCreateStream(&stream)", __LINE__) != SUCCESS) {
        (void)aclrtResetDevice(device_id);
        (void)aclFinalize();
        return FAILED;
    }
    return SUCCESS;
}

int32_t reset_device(int32_t device_id, aclrtStream& stream)
{
    CHECK_ACL(aclrtDestroyStream(stream));
    stream = nullptr;
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return SUCCESS;
}

// 正确性：kernel输出与compute_case_golden产出的CPU golden比对
uint32_t verify_result(const std::vector<HostT>& output, const std::vector<HostT>& golden)
{
    if (output.size() != golden.size()) {
        printf("[Failed] Case accuracy verification failed!\n");
        return 1;
    }
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
    // hlog10：特殊值命中修正表，正常值走log10路径，均经half往返（容差比对）
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::fabs(aclFloat16ToFloat(output[i]) - aclFloat16ToFloat(golden[i])) > 1e-2f) {
            printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
            return 1;
        }
    }
#else
    // j0f：容差覆盖libm与设备实现的偏差；NaN/Inf语义由golden统一表达
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::isnan(golden[i])) {
            if (!std::isnan(output[i])) { // NaN -> NaN
                printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
                return 1;
            }
        } else if (std::fabs(output[i] - golden[i]) > 1e-4f) { // 正常值容差比对
            printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
            return 1;
        }
    }
#endif
    printf("[Success] Case accuracy verification passed.\n");
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv; // 运行的用例由编译宏SCENARIO_NUM选定，无需命令行参数

    const uint32_t kernel_kind = static_cast<uint32_t>(SCENARIO_NUM);
    printf("Running case %u: %s...\n", kernel_kind, get_kernel_name(static_cast<int32_t>(kernel_kind)));
    printf("num_elements = %d, blocks = %d, threads per block = %d\n", TOTAL_THREADS, BLOCKS_PER_GRID,
        THREADS_PER_BLOCK);

    aclrtStream stream = nullptr;
    int32_t ret = set_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    // 构造输入与CPU golden
    std::vector<HostT> input;
    std::vector<HostT> golden;
    prepare_case_data(input, golden);

    // 分配device内存并拷入输入
    std::vector<HostT> output(input.size());
    const size_t total_byte_size = input.size() * sizeof(HostT);
    HostT* input_device = nullptr;
    HostT* output_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&input_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        input_device, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));

    // launch当前用例的kernel，等待执行完成并取回kernel输出
    launch_case_kernel(input_device, output_device, input.size(), stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(
        output.data(), total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));

    // 释放device内存并去初始化
    CHECK_ACL(aclrtFree(input_device));
    CHECK_ACL(aclrtFree(output_device));
    ret = reset_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    // 校验：kernel输出与CPU golden比对
    return verify_result(output, golden);
}
