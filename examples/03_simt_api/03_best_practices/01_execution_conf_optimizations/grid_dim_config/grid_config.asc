/* !
 * \file grid_config.asc
 * \brief SIMT gather sample demonstrating grid/block configuration and per-thread loop optimization
 */

#include <iostream>
#include <iterator>
#include <vector>
#include <cstdlib>
#include <ctime>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 20
#error "SCENARIO_NUM must be one of 1..20."
#endif

namespace {
constexpr uint32_t THREAD_NUM = 2048;
constexpr uint32_t MAX_THREAD_NUM = 2048;
constexpr uint32_t INDEX_WIDTH = 2048;
constexpr uint32_t INDEX_ROWS = 1024;
// 大shape：[1024,2048] = 2097152个元素(Case 1)
constexpr uint32_t LARGE_SHAPE_TOTAL_LENGTH = INDEX_ROWS * INDEX_WIDTH;

// 中shape：[64,2048] = 131072个元素(Case 2)
constexpr uint32_t MEDIUM_SHAPE_TOTAL_LENGTH = 131072;

// 小shape：[8,2048] = 16384个元素(Case 3)
constexpr uint32_t SMALL_SHAPE_TOTAL_LENGTH = 16384;
constexpr uint32_t AIV_CORE_NUM = 64;

enum class KernelType {
    EMPTY,           // 空核函数，仅测调度基线
    GATHER_NAIVE,    // 每线程处理1个元素，无stride循环(最朴素写法)
    GATHER_STRIDED,  // 每个block跨步处理一段元素(优化写法)
};

struct ScenarioConfig {
    uint32_t num_blocks;
    uint32_t total_length;
    KernelType kernel;
    uint32_t thread_num;
    const char* name;
};

// 核函数的每block线程数：默认取硬件上限MAX_THREAD_NUM
// 当scenario显式给出thread_num时按其值启动(用于Case 3"线程数=实际元素数"对比)
uint32_t resolve_thread_num(uint32_t thread_num)
{
    return thread_num == 0 ? MAX_THREAD_NUM : thread_num;
}

ScenarioConfig get_scenario_config(uint32_t scenario)
{
    switch (scenario) {
        // 大shape [1024,2048] = 2097152
        case 1: return {1, LARGE_SHAPE_TOTAL_LENGTH, KernelType::EMPTY, 0, "large shape, 1 core, empty kernel"};
        case 2: return {32, LARGE_SHAPE_TOTAL_LENGTH, KernelType::EMPTY, 0, "large shape, 32 cores, empty kernel"};
        case 3: return {AIV_CORE_NUM, LARGE_SHAPE_TOTAL_LENGTH, KernelType::EMPTY, 0, "large shape, 64 cores, empty kernel"};
        case 4: return {128, LARGE_SHAPE_TOTAL_LENGTH, KernelType::EMPTY, 0, "large shape, 128 cores, empty kernel"};
        case 5: return {1024, LARGE_SHAPE_TOTAL_LENGTH, KernelType::EMPTY, 0, "large shape, 1024 cores, empty kernel"};
        case 6: return {1024, LARGE_SHAPE_TOTAL_LENGTH, KernelType::GATHER_NAIVE, 0, "large shape, 1024 cores, gather naive"};
        case 7: return {AIV_CORE_NUM, LARGE_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "large shape, 64 cores, gather strided"};
        case 8: return {32, LARGE_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "large shape, 32 cores, gather strided"};
        // 中shape [64,2048] = 131072，扫描核数16/32/64/128
        case 9: return {16, MEDIUM_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "medium shape(131072), 16 cores, gather strided"};
        case 10: return {32, MEDIUM_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "medium shape(131072), 32 cores, gather strided"};
        case 11: return {AIV_CORE_NUM, MEDIUM_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "medium shape(131072), 64 cores, gather strided"};
        case 12: return {128, MEDIUM_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "medium shape(131072), 128 cores, gather strided"};
        // 小shape [8,2048] = 16384，扫描核数4/8/16/32/64，每block线程数固定2048
        case 13: return {4, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "small shape(16384), 4 cores, gather strided"};
        case 14: return {8, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "small shape(16384), 8 cores, gather strided"};
        case 15: return {16, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "small shape(16384), 16 cores, gather strided"};
        case 16: return {32, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "small shape(16384), 32 cores, gather strided"};
        case 17: return {AIV_CORE_NUM, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, 0, "small shape(16384), 64 cores, gather strided"};
        // 小shape [8,2048] = 16384，每block线程数=每核实际元素数(16核→1024、32核→512、64核→256)，与case 15/16/17的固定2048线程对比
        case 18: return {16, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, SMALL_SHAPE_TOTAL_LENGTH / 16, "small shape(16384), 16 cores, gather strided, threads=elements/core(1024)"};
        case 19: return {32, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, SMALL_SHAPE_TOTAL_LENGTH / 32, "small shape(16384), 32 cores, gather strided, threads=elements/core(512)"};
        case 20: return {AIV_CORE_NUM, SMALL_SHAPE_TOTAL_LENGTH, KernelType::GATHER_STRIDED, SMALL_SHAPE_TOTAL_LENGTH / AIV_CORE_NUM, "small shape(16384), 64 cores, gather strided, threads=elements/core(256)"};
        default: return {32, LARGE_SHAPE_TOTAL_LENGTH, KernelType::EMPTY, 0, "unknown"};
    }
}
}

__global__ __launch_bounds__(THREAD_NUM) void empty_kernel(
    float* input, uint32_t* index, float* output,
    uint32_t input_total_length, uint32_t index_total_length)
{
}

// 最朴素写法：每个线程只处理1个元素，无for循环
// 要求 gridDim.x * blockDim.x == index_total_length(本样例 1024 * 2048 == 2097152)
// block对应[1024,2048]张量的一行，thread对应一列，线程号即元素号，一一对应
__global__ __launch_bounds__(INDEX_WIDTH) void gather_naive_kernel(
    float* input, uint32_t* index, float* output,
    uint32_t input_total_length, uint32_t index_total_length)
{
    uint32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;

    uint32_t gather_idx = index[global_idx];
    if (gather_idx >= input_total_length) {
        gather_idx = 0;
    }
    output[global_idx] = input[gather_idx];
}

// 优化写法：每个block跨步处理一段元素，单核工作集随核数下降而增大
// 逻辑核数可以小于元素数，每个线程以 blockDim.x 为步长循环处理多个元素
// gather为memory-bound，这里用更大的 MAX_THREAD_NUM(2048) 线程数，以更多并发访存请求掩盖GM延迟
__global__ __launch_bounds__(MAX_THREAD_NUM) void gather_strided_kernel(
    float* input, uint32_t* index, float* output,
    uint32_t input_total_length, uint32_t index_total_length)
{
    uint32_t rows_per_block = index_total_length / gridDim.x;
    uint32_t index_start = blockIdx.x * rows_per_block;

    for (uint32_t local_idx = threadIdx.x; local_idx < rows_per_block; local_idx += blockDim.x) {
        uint32_t gather_idx = index[index_start + local_idx];
        if (gather_idx >= input_total_length) {
            gather_idx = 0;
        }
        output[index_start + local_idx] = input[gather_idx];
    }
}

std::vector<float> run_kernel(std::vector<float>& input,
                              std::vector<uint32_t>& index,
                              uint32_t num_blocks,
                              KernelType kernel,
                              uint32_t thread_num)
{
    uint32_t input_total_length = input.size();
    size_t input_total_byte_size = input_total_length * sizeof(float);

    uint32_t index_total_length = index.size();
    size_t index_total_byte_size = index_total_length * sizeof(uint32_t);

    uint32_t output_total_length = index.size();
    size_t output_total_byte_size = output_total_length * sizeof(float);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* index_host = reinterpret_cast<uint8_t*>(index.data());
    uint8_t* output_host = nullptr;
    float* input_device = nullptr;
    uint32_t* index_device = nullptr;
    float* output_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), output_total_byte_size);
    aclrtMalloc((void**)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&index_device, index_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, output_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, input_total_byte_size, input_host, input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(index_device, index_total_byte_size, index_host, index_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    if (kernel == KernelType::GATHER_NAIVE) {
        gather_naive_kernel<<<num_blocks, INDEX_WIDTH, 0, stream>>>(
            input_device, index_device, output_device,
            input_total_length, index_total_length);
    } else if (kernel == KernelType::GATHER_STRIDED) {
        uint32_t strided_threads = resolve_thread_num(thread_num);
        gather_strided_kernel<<<num_blocks, strided_threads, 0, stream>>>(
            input_device, index_device, output_device,
            input_total_length, index_total_length);
    } else {
        aclrtMemcpy(output_device, output_total_byte_size, input_device, output_total_byte_size, ACL_MEMCPY_DEVICE_TO_DEVICE);
        empty_kernel<<<num_blocks, THREAD_NUM, 0, stream>>>(
            input_device, index_device, output_device,
            input_total_length, index_total_length);
    }

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_total_byte_size, output_device, output_total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output((float*)output_host, (float*)(output_host + output_total_byte_size));

    aclrtFree(input_device);
    aclrtFree(index_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");

    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    srand(static_cast<uint32_t>(time(nullptr)));
    
    const uint32_t scenario = static_cast<uint32_t>(SCENARIO_NUM);
    ScenarioConfig config = get_scenario_config(scenario);

    printf("Scenario %u: %s\n", scenario, config.name);

    constexpr uint32_t input_total_length = 2100000;
    std::vector<float> input(input_total_length);
    for (uint32_t i = 0; i < input_total_length; i++) {
        input[i] = i * 1.2f;
    }

    // 元素总数随场景而定：Case 0/1为大shape(2097152)，Case 2为中shape(131072)，Case 3为小shape(16384)
    const uint32_t total_length = config.total_length;
    std::vector<uint32_t> index(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        index[i] = rand() % input_total_length;
    }

    std::vector<float> golden(total_length);
    if (config.kernel == KernelType::EMPTY) {
        for (uint32_t i = 0; i < total_length; i++) {
            golden[i] = input[i];
        }
    } else {
        for (uint32_t i = 0; i < total_length; i++) {
            golden[i] = input[index[i]];
        }
    }

    std::vector<float> output = run_kernel(input, index, config.num_blocks, config.kernel, config.thread_num);
    if (output.empty()) {
        return 1;
    }
    return verify_result(output, golden);
}
