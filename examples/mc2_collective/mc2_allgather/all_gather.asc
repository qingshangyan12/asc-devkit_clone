/* !
 * \file all_gather.asc
 * \brief 纯通信AllGather样例的Device侧实现，不包含额外计算
 */

#include "kernel_operator.h"
#include "adv_api/hccl/hccl.h"

/* !
 * AIV核上的纯AllGather通信流程，遵循HCCL客户端用法：
 * InitV2 -> AllGather(Prepare) -> Commit/Wait -> Finalize。
 * AllGather<true>表示Prepare时同步Commit通知服务端可执行；
 * 服务端为Mc2AicpuKernelLaunch下发的AICPU KFC server(Mc2ServerKernel)。
 * sendCount和dataType为运行时参数，由Host侧根据用户指定的数据类型和输入文件大小推导后传入。
 */
__aicore__ inline void AllGatherCommunication(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint64_t sendCount, uint32_t dataType)
{
    // 1. 初始化HCCL客户端，context为Host侧Mc2AcquireCcResCtx返回的OpResCtx地址
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);
    // 2. 下发AllGather通信任务：每卡sendCount个dataType数据，按rankId顺序拼接到y，
    //    strideCount为0表示相邻rank数据块在y中连续存放
    AscendC::HcclHandle handleId =
        hccl.AllGather<true>(x, y, sendCount, static_cast<AscendC::HcclDataType>(dataType), 0);
    if (handleId < 0) {
        return;
    }
    // 3. 阻塞等待该handleId对应的通信任务执行完成
    hccl.Wait(handleId);
    // 全AIV核同步，防止部分核执行较快提前Finalize影响其他核Wait
    AscendC::SyncAll<true>();
    // 4. 通知服务端后续无通信任务，等待最后一个通信任务结束后退出
    hccl.Finalize();
}

/* !
 * AllGather核函数：x为输入GM地址，y为输出GM地址，mc2Context为通信上下文(OpResCtx)地址，
 * sendCount为每卡参与通信的元素个数，dataType为HcclDataType枚举值。
 * HCCL通信接口仅在AIV核上调用，AIC核直接返回。
 */
extern "C" __vector__ __global__ void all_gather_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint64_t sendCount, uint32_t dataType)
{
    if (g_coreType == AscendC::AIV) {
        AllGatherCommunication(x, y, mc2Context, sendCount, dataType);
    }
}

/* !
 * Host侧下发入口，Kernel直调场景使用<<<>>>内核调用符。
 * blockDim为启动的核数，需覆盖全部参与通信的AIV逻辑核。
 */
extern "C" void all_gather_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint64_t sendCount, uint32_t dataType)
{
    all_gather_custom<<<blockDim, nullptr, stream>>>(x, y, mc2Context, sendCount, dataType);
}
