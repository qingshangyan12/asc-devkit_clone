/*!
 * \file collective.asc
 * \brief MC2 allgather/allreduce/alltoall/alltoallv/reducescatter communication kernel.
 */

#include "kernel_operator.h"
#include "adv_api/hccl/hccl.h"
#include "collective_common.h"

/*!
 * The five operations share the same MC2 client lifecycle. The count argument means
 * sendCount, count, dataCount, or recvCount respectively; it is ignored by AlltoAllV.
 */
__aicore__ inline void CollectiveCommunication(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t opType, uint64_t count, uint32_t dataTypeValue,
    uint32_t reduceOpValue, GM_ADDR sendCounts, GM_ADDR sendDispls, GM_ADDR recvCounts, GM_ADDR recvDispls)
{
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);

    const auto dataType = static_cast<AscendC::HcclDataType>(dataTypeValue);
    const auto reduceOp = static_cast<AscendC::HcclReduceOp>(reduceOpValue);
    AscendC::HcclHandle handleId = -1;
    switch (opType) {
        case COLLECTIVE_ALLGATHER:
            handleId = hccl.AllGather<true>(x, y, count, dataType, 0);
            break;
        case COLLECTIVE_ALLREDUCE:
            handleId = hccl.AllReduce<true>(x, y, count, dataType, reduceOp);
            break;
        case COLLECTIVE_ALLTOALL:
            handleId = hccl.AlltoAll<true>(x, y, count, dataType, 0);
            break;
        case COLLECTIVE_ALLTOALLV:
            handleId = hccl.AlltoAllV<true>(
                x, reinterpret_cast<void*>(sendCounts), reinterpret_cast<void*>(sendDispls), dataType, y,
                reinterpret_cast<void*>(recvCounts), reinterpret_cast<void*>(recvDispls), dataType);
            break;
        case COLLECTIVE_REDUCESCATTER:
            handleId = hccl.ReduceScatter<true>(x, y, count, dataType, reduceOp, 0);
            break;
        default:
            return;
    }
    if (handleId < 0) {
        return;
    }
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
}

/*!
 * HCCL communication interfaces are called only from AIV cores.
 */
extern "C" __vector__ __global__ void collective_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t opType, uint64_t count, uint32_t dataTypeValue,
    uint32_t reduceOpValue, GM_ADDR sendCounts, GM_ADDR sendDispls, GM_ADDR recvCounts, GM_ADDR recvDispls)
{
    if (g_coreType == AscendC::AIV) {
        CollectiveCommunication(
            x, y, mc2Context, opType, count, dataTypeValue, reduceOpValue, sendCounts, sendDispls, recvCounts,
            recvDispls);
    }
}

/*!
 * Host-side kernel launch entry used by the direct <<<>>> launch path.
 */
extern "C" void collective_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t opType,
    uint64_t count, uint32_t dataTypeValue, uint32_t reduceOpValue, uint8_t* sendCounts, uint8_t* sendDispls,
    uint8_t* recvCounts, uint8_t* recvDispls)
{
    collective_custom<<<blockDim, nullptr, stream>>>(
        x, y, mc2Context, opType, count, dataTypeValue, reduceOpValue, sendCounts, sendDispls, recvCounts,
        recvDispls);
}
