/* !
 * \file all_to_all.asc
 * \brief 纯通信AlltoAll样例的Device侧实现，不包含额外计算。
 *        数据类型不在Device侧写死，由Host侧--dtype指定的运行时参数传入。
 */

#include "kernel_operator.h"
#include "adv_api/hccl/hccl.h"

/* !
 * AlltoAll中每卡发往每个rank的数据块元素个数dataCount，
 * 每卡收发总量均为dataCount * rankSize个元素。
 */
constexpr uint64_t DATA_COUNT = 32;

/* !
 * AIV核上的纯AlltoAll通信流程，遵循HCCL客户端用法：
 * InitV2 -> AlltoAll(Prepare) -> Commit/Wait -> Finalize。
 * AlltoAll<true>表示Prepare时同步Commit通知服务端可执行；
 * 服务端为Mc2AicpuKernelLaunch下发的AICPU KFC server(Mc2ServerKernel)。
 * dataType为运行时参数，由Host侧根据用户指定的数据类型传入。
 */
__aicore__ inline void AlltoAllCommunication(GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    // 1. 初始化HCCL客户端，context为Host侧Mc2AcquireCcResCtx返回的OpResCtx地址
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);
    // 2. 下发AlltoAll通信任务：sendBuf的第j块(DATA_COUNT个dataType元素)发往rank j，
    //    落入对端recvBuf的第rankId块；strideCount为0表示卡内数据块连续存放
    AscendC::HcclHandle handleId =
        hccl.AlltoAll<true>(x, y, DATA_COUNT, static_cast<AscendC::HcclDataType>(dataType), 0);
    if (handleId < 0) {
        return;
    }
    // 3. 阻塞等待该handleId对应的通信任务执行完成
    hccl.Wait(handleId);
    // 全AIV核同步，防止部分核执行较快提前Finalize影响其他核Wait
    AscendC::SyncAll<true>();
    // 4. 通知服务端后续无通信任务，等待最后一个通信任务结束后退出
    hccl.Finalize();
}

/* !
 * AlltoAll核函数：x为输入GM地址，y为输出GM地址，mc2Context为通信上下文(OpResCtx)地址，
 * dataType为HcclDataType枚举值。
 * HCCL通信接口仅在AIV核上调用，AIC核直接返回。
 */
extern "C" __vector__ __global__ void all_to_all_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    if (g_coreType == AscendC::AIV) {
        AlltoAllCommunication(x, y, mc2Context, dataType);
    }
}

/* !
 * Host侧下发入口，Kernel直调场景使用<<<>>>内核调用符。
 * blockDim为启动的核数，需覆盖全部参与通信的AIV逻辑核。
 */
extern "C" void all_to_all_do(uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context,
    uint32_t dataType)
{
    all_to_all_custom<<<blockDim, nullptr, stream>>>(x, y, mc2Context, dataType);
}
