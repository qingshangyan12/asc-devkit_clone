/* !
 * \file main.asc
 * \brief 纯通信AlltoAll样例的Host侧入口：初始化通信域、分配通信资源，
 *        并通过独立stream分别下发AICPU KFC server和AICore核函数。
 *        支持通过--dtype指定数据类型(默认fp16)，输入文件缺失时直接报错，不提供兜底数据。
 */

#include <algorithm>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <mutex>
#include <string>
#include <vector>
#include <thread>
#include <sys/stat.h>
#include <sys/types.h>

#include "acl/acl.h"
#include "hccl/hccl_comm.h"
#include "adv_api/hccl/hccl_common.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "../mc2_log_utils.h"

/* !
 * Device侧核函数的Host下发入口，定义在all_to_all.asc中。
 * dataType为HcclDataType枚举值。
 */
extern "C" void all_to_all_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t dataType);

/* !
 * AlltoAll中每卡发往每个rank的数据块元素个数dataCount，
 * 每卡收发总量均为DATA_COUNT * rankSize个元素。
 */
constexpr uint32_t DATA_COUNT = 32;
/* !
 * AICPU_TS引擎编号(OpExecuteConfig::AICPU_TS = 2)，表示通信任务由AICPU上的KFC server执行，
 * 与Host侧Mc2AicpuKernelLaunch下发的Mc2ServerKernel配套。
 */
constexpr uint8_t MC2_COMM_ENGINE_AICPU_TS = 2;
/* !
 * 打印输入/输出时最多展示的元素个数，避免刷屏。
 */
constexpr uint64_t PRINT_MAX_COUNT = 32;

/* !
 * 数据类型描述：命令行名称、HCCL数据类型枚举与元素字节大小。
 */
struct DtypeDesc {
    const char* name;
    AscendC::HcclDataType dataType;
    uint32_t size;
};

static const DtypeDesc DTYPE_TABLE[] = {
    {"int8", AscendC::HcclDataType::HCCL_DATA_TYPE_INT8, 1},
    {"uint8", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT8, 1},
    {"int16", AscendC::HcclDataType::HCCL_DATA_TYPE_INT16, 2},
    {"uint16", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT16, 2},
    {"fp16", AscendC::HcclDataType::HCCL_DATA_TYPE_FP16, 2},
    {"bf16", AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16, 2},
    {"int32", AscendC::HcclDataType::HCCL_DATA_TYPE_INT32, 4},
    {"uint32", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT32, 4},
    {"fp32", AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, 4},
    {"int64", AscendC::HcclDataType::HCCL_DATA_TYPE_INT64, 8},
    {"uint64", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT64, 8},
    {"fp64", AscendC::HcclDataType::HCCL_DATA_TYPE_FP64, 8},
    {"fp8_e8m0", AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E8M0, 1},
    {"fp8_e5m2", AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E5M2, 1},
    {"fp8_e4m3", AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E4M3, 1},
};

static std::mutex gPrintMutex;

static const DtypeDesc* FindDtypeByName(const char* name)
{
    for (const DtypeDesc& dtype : DTYPE_TABLE) {
        if (std::strcmp(dtype.name, name) == 0) {
            return &dtype;
        }
    }
    return nullptr;
}

static void PrintUsage(const char* program)
{
    printf("usage: %s [--dtype <name>]\n", program);
    printf("       supported dtype:");
    for (const DtypeDesc& dtype : DTYPE_TABLE) {
        printf(" %s", dtype.name);
    }
    printf(" (default fp16)\n");
    printf("       input file:  ./input/<rank>/x1.bin, size must be %u * rankSize elements\n", DATA_COUNT);
}

/* !
 * 半精度浮点(FP16)与单精度浮点(FP32)按IEEE 754位模式转换，仅用于打印。
 */
static float HalfToFloat(uint16_t h)
{
    const uint32_t sign = static_cast<uint32_t>(h & 0x8000U) << 16;
    const uint32_t exp = (h >> 10) & 0x1FU;
    const uint32_t frac = h & 0x3FFU;
    if (exp == 0) {
        if (frac == 0) {
            return sign == 0U ? 0.0F : -0.0F;
        }
        // 非规格化数：value = frac * 2^-24
        uint32_t msb = 0;
        while (((frac >> msb) & 1U) == 0U) {
            msb++;
        }
        const uint32_t e = 103U + msb;
        const uint32_t mant = (frac << (23U - msb)) & 0x7FFFFFU;
        uint32_t bits = sign | (e << 23) | mant;
        float out = 0.0F;
        std::memcpy(&out, &bits, sizeof(out));
        return out;
    }
    if (exp == 0x1FU) {
        const uint32_t bits = sign | 0x7F800000U | (frac << 13);
        float out = 0.0F;
        std::memcpy(&out, &bits, sizeof(out));
        return out;
    }
    const uint32_t bits = sign | ((exp + 112U) << 23) | (frac << 13);
    float out = 0.0F;
    std::memcpy(&out, &bits, sizeof(out));
    return out;
}

static std::string GetRankInputPath(uint32_t rank) { return "./input/" + std::to_string(rank) + "/x1.bin"; }

static std::string GetRankOutputPath(uint32_t rank) { return "./output/" + std::to_string(rank) + "/output_npu.bin"; }

static bool GetFileSize(const std::string& filePath, uint64_t& fileSize)
{
    std::ifstream file(filePath, std::ios::binary);
    if (!file.is_open()) {
        return false;
    }
    file.seekg(0, std::ios::end);
    const std::streamsize size = file.tellg();
    if (size < 0) {
        return false;
    }
    fileSize = static_cast<uint64_t>(size);
    return true;
}

/* !
 * 读取指定rank的输入文件，data的大小即期望的文件字节数。
 * 输入文件为必选项，读取失败直接报错，不提供兜底数据。
 */
static bool ReadRankInput(uint32_t rank, std::vector<uint8_t>& data)
{
    const std::string filePath = GetRankInputPath(rank);
    std::ifstream file(filePath, std::ios::binary);
    if (!file.is_open()) {
        printf(
            "[ERROR] rank%u input file not found: %s, generate it via scripts/gen_data.py first\n", rank,
            filePath.c_str());
        return false;
    }
    file.seekg(0, std::ios::end);
    const std::streamsize fileSize = file.tellg();
    const std::streamsize expectSize = static_cast<std::streamsize>(data.size());
    if (fileSize != expectSize) {
        printf(
            "[ERROR] rank%u input file size invalid: %s, expect %ld, got %ld\n", rank, filePath.c_str(),
            static_cast<long>(expectSize), static_cast<long>(fileSize));
        return false;
    }
    file.seekg(0, std::ios::beg);
    file.read(reinterpret_cast<char*>(data.data()), expectSize);
    if (!file.good()) {
        printf("[ERROR] rank%u read input file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    return true;
}

static bool WriteRankOutput(uint32_t rank, const std::vector<uint8_t>& data)
{
    (void)mkdir("./output", S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string cardDir = "./output/" + std::to_string(rank);
    (void)mkdir(cardDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string filePath = GetRankOutputPath(rank);
    std::ofstream file(filePath, std::ios::binary | std::ios::trunc);
    if (!file.is_open()) {
        printf("[ERROR] rank%u open output file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    file.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
    if (!file.good()) {
        printf("[ERROR] rank%u write output file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    return true;
}

static void PrintOneElement(const uint8_t* elem, const DtypeDesc& dtype)
{
    switch (dtype.dataType) {
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT8:
            printf(" %d", static_cast<int32_t>(*reinterpret_cast<const int8_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_UINT8:
            printf(" %u", static_cast<uint32_t>(*elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT16:
            printf(" %d", static_cast<int32_t>(*reinterpret_cast<const int16_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_UINT16:
            printf(" %u", static_cast<uint32_t>(*reinterpret_cast<const uint16_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP16:
            printf(" %g", HalfToFloat(*reinterpret_cast<const uint16_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16:
            // bf16按原始bit位打印，与实际通信的字节数据一致
            printf(" %u", static_cast<uint32_t>(*reinterpret_cast<const uint16_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E4M3:
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E5M2:
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E8M0:
            // fp8无Host侧原生类型，按原始bit位打印，与实际通信的字节数据一致
            printf(" %u", static_cast<uint32_t>(*elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT32:
            printf(" %d", *reinterpret_cast<const int32_t*>(elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_UINT32:
            printf(" %u", *reinterpret_cast<const uint32_t*>(elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP32:
            printf(" %g", *reinterpret_cast<const float*>(elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT64:
            printf(" %lld", static_cast<long long>(*reinterpret_cast<const int64_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_UINT64:
            printf(" %llu", static_cast<unsigned long long>(*reinterpret_cast<const uint64_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP64:
            printf(" %g", *reinterpret_cast<const double*>(elem));
            break;
        default:
            printf(" ?");
            break;
    }
}

static void PrintRankData(
    const char* tag, uint32_t rank, const std::vector<uint8_t>& data, uint64_t elemCount, const DtypeDesc& dtype)
{
    if (rank > 1U) {
        return;
    }
    std::lock_guard<std::mutex> lock(gPrintMutex);
    printf("%s rank%u:", tag, rank);
    const uint64_t printCount = std::min<uint64_t>(elemCount, PRINT_MAX_COUNT);
    for (uint64_t i = 0; i < printCount; i++) {
        PrintOneElement(data.data() + i * dtype.size, dtype);
    }
    if (elemCount > printCount) {
        printf(" ...");
    }
    printf("\n");
}

#define ACL_CHECK(ret)                                                             \
    do {                                                                           \
        aclError aclRet = (ret);                                                   \
        if (aclRet != ACL_SUCCESS) {                                               \
            printf("[ERROR] %s:%d ret=%d\n", __FILE__, __LINE__, (int32_t)aclRet); \
            return -1;                                                             \
        }                                                                          \
    } while (0)

#define HCCL_CHECK(ret)                                                             \
    do {                                                                            \
        HcclResult hcclRet = (ret);                                                 \
        if (hcclRet != HCCL_SUCCESS) {                                              \
            printf("[ERROR] %s:%d ret=%d\n", __FILE__, __LINE__, (int32_t)hcclRet); \
            return -1;                                                              \
        }                                                                           \
    } while (0)

/* !
 * 单个rank上的纯AlltoAll执行流程：
 * 1. 构造Mc2CcArgs并通过Mc2AcquireCcResCtx分配通信资源，得到Device侧OpResCtx；
 * 2. Mc2AicpuKernelLaunch在AICPU上下发Mc2ServerKernel，等待AICore侧的通信任务；
 * 3. 使用另一条stream通过<<<>>>下发AICore核函数，Device侧通过Hccl客户端下发
 *    AlltoAll任务并与server交互；
 * 4. 回读输出校验结果。数据类型以运行时参数传入，Device侧不写死数据规格。
 */
static int32_t RunAlltoAllCommunication(
    uint32_t deviceId, uint32_t rankSize, HcclRootInfo* rootInfo, const DtypeDesc& dtype)
{
    ACL_CHECK(aclrtSetDevice(static_cast<int32_t>(deviceId)));

    // 初始化HCCL通信域，所有rank使用同一份rootInfo
    HcclComm comm = nullptr;
    HCCL_CHECK(HcclCommInitRootInfo(rankSize, rootInfo, deviceId, &comm));

    char commName[COMM_NAME_MAX_LENGTH] = {0};
    HCCL_CHECK(HcclGetCommName(comm, commName));

    // AICPU KFC server会阻塞等待AICore client消息，不能与AICore kernel使用同一条stream。
    aclrtStream aicpuStream = nullptr;
    aclrtStream aicoreStream = nullptr;
    ACL_CHECK(aclrtCreateStream(&aicpuStream));
    ACL_CHECK(aclrtCreateStream(&aicoreStream));

    const uint64_t ioElems = static_cast<uint64_t>(DATA_COUNT) * rankSize;
    const size_t inputSize = static_cast<size_t>(ioElems) * dtype.size;
    const size_t outputSize = inputSize;

    // 申请Device内存并从输入文件读取数据，输入文件由scripts/gen_data.py生成，缺失时直接报错
    void* inputDev = nullptr;
    void* outputDev = nullptr;
    ACL_CHECK(aclrtMalloc(&inputDev, inputSize, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&outputDev, outputSize, ACL_MEM_MALLOC_HUGE_FIRST));

    std::vector<uint8_t> inputBuff(inputSize, 0);
    if (!ReadRankInput(deviceId, inputBuff)) {
        return -1;
    }
    PrintRankData("input", deviceId, inputBuff, ioElems, dtype);
    ACL_CHECK(aclrtMemcpy(inputDev, inputSize, inputBuff.data(), inputSize, ACL_MEMCPY_HOST_TO_DEVICE));

    // ============================================================
    // STEP 1: 按参数分配通信资源
    // 返回Device侧OpResCtx地址，既是Mc2AicpuKernelLaunch的下发参数，
    // 也是Device侧Hccl客户端InitV2的context参数。
    // ============================================================
    void* ccArgs = nullptr;
    char algConfig[] = "AlltoAll=level0:fullmesh;level1:pairwise";
    void* opResCtx = nullptr;
    uint32_t opResCtxSize = 0;
    HCCL_CHECK(Mc2GetCcArgs(&ccArgs));
    HCCL_CHECK(Mc2SetCcGroupName(ccArgs, commName));
    HCCL_CHECK(Mc2SetCcAlgConfig(ccArgs, algConfig));
    HCCL_CHECK(Mc2SetCcSrcDataType(ccArgs, static_cast<uint8_t>(dtype.dataType)));
    HCCL_CHECK(Mc2SetCcDstDataType(ccArgs, static_cast<uint8_t>(dtype.dataType)));
    HCCL_CHECK(Mc2SetCcCommEngine(ccArgs, MC2_COMM_ENGINE_AICPU_TS));
    HCCL_CHECK(Mc2AcquireCcResCtx(
        comm, static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLTOALL), ccArgs, &opResCtx, &opResCtxSize));
    HCCL_CHECK(Mc2FreeCcArgs(ccArgs));

    // ============================================================
    // STEP 2: 下发AICPU KFC server内核(Mc2ServerKernel)
    // blockDim取0时内部按1处理；opResCtx已在Device侧，无需额外H2D拷贝；
    // server阻塞等待AICore侧Hccl客户端写入消息区并执行AlltoAll通信
    // ============================================================
    HCCL_CHECK(Mc2AicpuKernelLaunch(0, aicpuStream, opResCtx, opResCtxSize));

    // ============================================================
    // STEP 3: 下发AICore核函数，Device侧Hccl客户端与server交互完成AlltoAll
    // dataType为运行时参数，来自用户指定的数据类型
    // ============================================================
    all_to_all_do(
        1, aicoreStream, reinterpret_cast<uint8_t*>(inputDev), reinterpret_cast<uint8_t*>(outputDev),
        reinterpret_cast<uint8_t*>(opResCtx), static_cast<uint32_t>(dtype.dataType));

    // 先等待AICore client完成，再等待收到Finalize消息后退出的AICPU server。
    ACL_CHECK(aclrtSynchronizeStream(aicoreStream));
    ACL_CHECK(aclrtSynchronizeStream(aicpuStream));

    // 仅在Host侧回读并校验通信结果，Device侧不执行额外计算
    std::vector<uint8_t> result(outputSize, 0);
    ACL_CHECK(aclrtMemcpy(result.data(), outputSize, outputDev, outputSize, ACL_MEMCPY_DEVICE_TO_HOST));
    PrintRankData("output", deviceId, result, ioElems, dtype);
    if (!WriteRankOutput(deviceId, result)) {
        return -1;
    }

    // 按AlltoAll语义计算期望输出：y[j * dataCount + m] = x_j[rankId * dataCount + m]，
    // 即本卡输出的第j块来自rank j输入的第rankId块；AlltoAll为纯数据搬运，逐字节比较
    std::vector<std::vector<uint8_t>> inputs(rankSize);
    bool checkOk = true;
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        inputs[rank].resize(inputSize, 0);
        if (!ReadRankInput(rank, inputs[rank])) {
            checkOk = false;
            break;
        }
    }
    if (checkOk) {
        const size_t blockSize = static_cast<size_t>(DATA_COUNT) * dtype.size;
        for (uint32_t peer = 0; peer < rankSize; peer++) {
            const uint8_t* golden = inputs[peer].data() + static_cast<size_t>(deviceId) * blockSize;
            const uint8_t* actual = result.data() + static_cast<size_t>(peer) * blockSize;
            if (std::memcmp(actual, golden, blockSize) != 0) {
                checkOk = false;
                for (uint64_t i = 0; i < blockSize; i++) {
                    if (actual[i] != golden[i]) {
                        printf(
                            "[ERROR] rank%u verify failed at block [%u] byte %llu, got %u, expect %u\n", deviceId, peer,
                            static_cast<unsigned long long>(i), actual[i], golden[i]);
                        break;
                    }
                }
            }
        }
    }
    printf("rank%u AlltoAll verify %s\n", deviceId, checkOk ? "pass" : "failed");

    // 释放资源
    ACL_CHECK(aclrtFree(inputDev));
    ACL_CHECK(aclrtFree(outputDev));
    HCCL_CHECK(HcclCommDestroy(comm));
    ACL_CHECK(aclrtDestroyStream(aicoreStream));
    ACL_CHECK(aclrtDestroyStream(aicpuStream));
    ACL_CHECK(aclrtResetDevice(static_cast<int32_t>(deviceId)));
    return checkOk ? 0 : -1;
}

/* !
 * 主入口：与HCCL集合通信样例一致，使用单进程多线程模拟多rank场景，
 * 每个线程绑定一个Device并初始化通信域后并发执行AlltoAll。
 * 支持通过--dtype指定数据类型(默认fp16)；输入文件为必选项，缺失或大小
 * 不符时直接报错退出，不提供兜底数据。
 */
int32_t main(int32_t argc, char* argv[])
{
    const DtypeDesc* dtype = nullptr;
    for (int32_t i = 1; i < argc; i++) {
        if (std::strcmp(argv[i], "--dtype") == 0 && i + 1 < argc) {
            dtype = FindDtypeByName(argv[i + 1]);
            if (dtype == nullptr) {
                printf("[ERROR] unsupported dtype: %s\n", argv[i + 1]);
                PrintUsage(argv[0]);
                return -1;
            }
            i++;
        } else {
            printf("[ERROR] invalid arguments\n");
            PrintUsage(argv[0]);
            return -1;
        }
    }
    if (dtype == nullptr) {
        dtype = FindDtypeByName("fp16");
    }

    if (!Mc2LogUtils::ClearAscendProcessLogPath()) {
        return -1;
    }
    ACL_CHECK(aclInit(nullptr));

    uint32_t devCount = 0;
    ACL_CHECK(aclrtGetDeviceCount(&devCount));
    if (devCount < 1) {
        printf("[ERROR] no available device\n");
        return -1;
    }
    const uint32_t rankSize = devCount;

    // 预检所有rank的输入文件：必须存在且大小为DATA_COUNT * rankSize个元素，
    // 缺失时直接报错退出，避免部分rank无法参与集合通信导致其他rank阻塞
    const uint64_t expectFileSize = static_cast<uint64_t>(DATA_COUNT) * rankSize * dtype->size;
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        uint64_t fileSize = 0;
        if (!GetFileSize(GetRankInputPath(rank), fileSize)) {
            printf(
                "[ERROR] rank%u input file not found: %s, generate it via scripts/gen_data.py first\n", rank,
                GetRankInputPath(rank).c_str());
            return -1;
        }
        if (fileSize != expectFileSize) {
            printf(
                "[ERROR] rank%u input file size %llu invalid, expect %llu bytes (%u * %u * %s)\n", rank,
                static_cast<unsigned long long>(fileSize), static_cast<unsigned long long>(expectFileSize), DATA_COUNT,
                rankSize, dtype->name);
            return -1;
        }
    }
    printf("AlltoAll sample start, rankSize = %u, dtype = %s, dataCount = %u\n", rankSize, dtype->name, DATA_COUNT);

    // rank0生成rootInfo，所有rank共享
    ACL_CHECK(aclrtSetDevice(0));
    HcclRootInfo rootInfo;
    HCCL_CHECK(HcclGetRootInfo(&rootInfo));

    std::vector<std::thread> threads(rankSize);
    std::vector<int32_t> results(rankSize, -1);
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        threads[rank] = std::thread([rank, rankSize, &rootInfo, &results, dtype]() {
            results[rank] = RunAlltoAllCommunication(rank, rankSize, &rootInfo, *dtype);
        });
    }
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        threads[rank].join();
    }

    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());

    for (uint32_t rank = 0; rank < rankSize; rank++) {
        if (results[rank] != 0) {
            printf("AlltoAll sample failed\n");
            return -1;
        }
    }
    printf("AlltoAll sample pass\n");
    return 0;
}
