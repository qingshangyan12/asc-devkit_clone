/* !
 * \file all_to_all_v.asc
 * \brief 纯通信AlltoAllV样例的Device侧实现，不包含额外计算。
 *        数据类型不在Device侧写死，由Host侧--dtype指定的运行时参数传入。
 */

#include "kernel_operator.h"
#include "adv_api/hccl/hccl.h"

/* !
 * AlltoAllV中每对rank收发数据量的基本单位，实际收发量为BASE * (1 + 偏移 % rankSize)个元素。
 */
constexpr uint64_t BASE_COUNT = 8;
/* !
 * AlltoAllV收发数组支持的最大rank数，Host侧按同一上限校验rankSize。
 */
constexpr uint32_t MAX_RANK_NUM = 32;

/* !
 * AIV核上的纯AlltoAllV通信流程，遵循HCCL客户端用法：
 * InitV2 -> AlltoAllV(Prepare) -> Commit/Wait -> Finalize。
 * AlltoAllV<true>表示Prepare时同步Commit通知服务端可执行；
 * 服务端为Mc2AicpuKernelLaunch下发的AICPU KFC server(Mc2ServerKernel)。
 * dataType为运行时参数，由Host侧根据用户指定的数据类型传入。
 */
__aicore__ inline void AlltoAllVCommunication(GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    // 1. 初始化HCCL客户端，context为Host侧Mc2AcquireCcResCtx返回的OpResCtx地址
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);
    // 2. 按公式定制本卡到每个rank的收发数据量和偏移，与Host侧真值计算保持一致：
    //    rank i发往rank j的数据量为BASE * (1 + ((2 * i + j) % rankSize))，
    //    rank i从rank j接收的数据量为BASE * (1 + ((i + 2 * j) % rankSize))
    uint64_t sendCounts[MAX_RANK_NUM] = {0};
    uint64_t sdispls[MAX_RANK_NUM] = {0};
    uint64_t recvCounts[MAX_RANK_NUM] = {0};
    uint64_t rdispls[MAX_RANK_NUM] = {0};
    const uint32_t rankDim = hccl.GetRankDim();
    const uint32_t rankId = hccl.GetRankId();
    uint64_t sendOffset = 0;
    uint64_t recvOffset = 0;
    for (uint32_t peer = 0; peer < rankDim; peer++) {
        const uint64_t sendCnt = BASE_COUNT * (1 + ((2 * rankId + peer) % rankDim));
        const uint64_t recvCnt = BASE_COUNT * (1 + ((rankId + 2 * peer) % rankDim));
        sendCounts[peer] = sendCnt;
        sdispls[peer] = sendOffset;
        sendOffset += sendCnt;
        recvCounts[peer] = recvCnt;
        rdispls[peer] = recvOffset;
        recvOffset += recvCnt;
    }
    const AscendC::HcclDataType commType = static_cast<AscendC::HcclDataType>(dataType);
    AscendC::HcclHandle handleId =
        hccl.AlltoAllV<true>(x, sendCounts, sdispls, commType, y, recvCounts, rdispls, commType);
    if (handleId < 0) {
        return;
    }
    // 3. 阻塞等待该handleId对应的通信任务执行完成
    hccl.Wait(handleId);
    // 全AIV核同步，防止部分核执行较快提前Finalize影响其他核Wait
    AscendC::SyncAll<true>();
    // 4. 通知服务端后续无通信任务，等待最后一个通信任务结束后退出
    hccl.Finalize();
}

/* !
 * AlltoAllV核函数：x为输入GM地址，y为输出GM地址，mc2Context为通信上下文(OpResCtx)地址，
 * dataType为HcclDataType枚举值。
 * HCCL通信接口仅在AIV核上调用，AIC核直接返回。
 */
extern "C" __vector__ __global__ void all_to_all_v_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    if (g_coreType == AscendC::AIV) {
        AlltoAllVCommunication(x, y, mc2Context, dataType);
    }
}

/* !
 * Host侧下发入口，Kernel直调场景使用<<<>>>内核调用符。
 * blockDim为启动的核数，需覆盖全部参与通信的AIV逻辑核。
 */
extern "C" void all_to_all_v_do(uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context,
    uint32_t dataType)
{
    all_to_all_v_custom<<<blockDim, nullptr, stream>>>(x, y, mc2Context, dataType);
}
