/* !
 * \file main.asc
 * \brief 纯通信ReduceScatter样例的Host侧入口：初始化通信域、分配通信资源，
 *        并通过独立stream分别下发AICPU KFC server和AICore核函数
 */

#include <algorithm>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <mutex>
#include <string>
#include <vector>
#include <thread>
#include <sys/stat.h>
#include <sys/types.h>

#include "acl/acl.h"
#include "hccl/hccl_comm.h"
#include "adv_api/hccl/hccl_common.h"
#include "adv_api/hccl/hccl_mc2.h"

/* !
 * Device侧核函数的Host下发入口，定义在reduce_scatter.asc中。
 */
extern "C" void reduce_scatter_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context);

/* !
 * 每卡ReduceScatter输出(接收)的half元素个数recvCount，每卡输入为RECV_COUNT * rankSize个half。
 */
constexpr uint32_t RECV_COUNT = 128;
/* !
 * AICPU_TS引擎编号(OpExecuteConfig::AICPU_TS = 2)，表示通信任务由AICPU上的KFC server执行，
 * 与Host侧Mc2AicpuKernelLaunch下发的Mc2ServerKernel配套。
 */
constexpr uint8_t MC2_COMM_ENGINE_AICPU_TS = 2;

static std::mutex gPrintMutex;

/* !
 * 半精度浮点(FP16)与单精度浮点(FP32)按IEEE 754位模式转换。
 * 样例数据均为绝对值不超过2048的整数，FP16可精确表示，转换无精度损失。
 */
static float HalfToFloat(uint16_t h)
{
    const uint32_t sign = static_cast<uint32_t>(h & 0x8000U) << 16;
    const uint32_t exp = (h >> 10) & 0x1FU;
    const uint32_t frac = h & 0x3FFU;
    if (exp == 0) {
        if (frac == 0) {
            return sign == 0U ? 0.0F : -0.0F;
        }
        // 非规格化数：value = frac * 2^-24
        uint32_t msb = 0;
        while (((frac >> msb) & 1U) == 0U) {
            msb++;
        }
        const uint32_t e = 103U + msb;
        const uint32_t mant = (frac << (23U - msb)) & 0x7FFFFFU;
        uint32_t bits = sign | (e << 23) | mant;
        float out = 0.0F;
        std::memcpy(&out, &bits, sizeof(out));
        return out;
    }
    if (exp == 0x1FU) {
        const uint32_t bits = sign | 0x7F800000U | (frac << 13);
        float out = 0.0F;
        std::memcpy(&out, &bits, sizeof(out));
        return out;
    }
    const uint32_t bits = sign | ((exp + 112U) << 23) | (frac << 13);
    float out = 0.0F;
    std::memcpy(&out, &bits, sizeof(out));
    return out;
}

static uint16_t FloatToHalf(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16) & 0x8000U;
    const uint32_t exp = (bits >> 23) & 0xFFU;
    const uint32_t frac = bits & 0x7FFFFFU;
    if (exp == 0xFFU) {
        // Inf/NaN
        return static_cast<uint16_t>(sign | 0x7C00U | ((frac != 0U) ? (0x200U | (frac >> 13)) : 0U));
    }
    const int32_t halfExp = static_cast<int32_t>(exp) - 127 + 15;
    if (halfExp >= 0x1F) {
        return static_cast<uint16_t>(sign | 0x7C00U);
    }
    if (halfExp <= 0) {
        if (halfExp < -10) {
            return static_cast<uint16_t>(sign);
        }
        // 非规格化数：携带隐含1后右移，按就近偶数舍入
        const uint32_t mant = frac | 0x800000U;
        const uint32_t shift = static_cast<uint32_t>(14 - halfExp);
        uint32_t sub = mant >> shift;
        const uint32_t rem = mant & ((1U << shift) - 1U);
        const uint32_t halfWay = 1U << (shift - 1U);
        if (rem > halfWay || (rem == halfWay && (sub & 1U) != 0U)) {
            sub += 1U;
        }
        return static_cast<uint16_t>(sign | sub);
    }
    uint32_t out = (static_cast<uint32_t>(halfExp) << 10) | (frac >> 13);
    const uint32_t rem = frac & 0x1FFFU;
    if (rem > 0x1000U || (rem == 0x1000U && ((frac >> 13) & 1U) != 0U)) {
        out += 1U;
    }
    return static_cast<uint16_t>(sign | out);
}

/* !
 * 兜底输入取值规则，与scripts/gen_data.py生成的数据一致：
 * 第rank卡第k个元素为(rank + 1) + (k mod 32)。
 * 归约结果不超过2048，FP16求和精确，校验结果确定。
 */
static uint16_t MakeFallbackInputValue(uint32_t rank, uint64_t index)
{
    const uint32_t value = (rank + 1) + static_cast<uint32_t>(index % 32U);
    return FloatToHalf(static_cast<float>(value));
}

static std::string GetRankInputPath(uint32_t rank)
{
    return "./input/" + std::to_string(rank) + "/x1.bin";
}

static std::string GetRankOutputPath(uint32_t rank)
{
    return "./output/" + std::to_string(rank) + "/output_npu.bin";
}

static bool ReadRankInput(uint32_t rank, std::vector<uint16_t>& data)
{
    const std::string filePath = GetRankInputPath(rank);
    std::ifstream file(filePath, std::ios::binary);
    if (!file.is_open()) {
        return false;
    }
    file.seekg(0, std::ios::end);
    const std::streamsize fileSize = file.tellg();
    const std::streamsize expectSize = static_cast<std::streamsize>(data.size() * sizeof(uint16_t));
    if (fileSize != expectSize) {
        printf("[ERROR] rank%u input file size invalid: %s, expect %ld, got %ld\n", rank, filePath.c_str(),
            static_cast<long>(expectSize), static_cast<long>(fileSize));
        return false;
    }
    file.seekg(0, std::ios::beg);
    file.read(reinterpret_cast<char*>(data.data()), static_cast<std::streamsize>(data.size() * sizeof(uint16_t)));
    if (!file.good()) {
        printf("[ERROR] rank%u read input file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    return true;
}

static void FillFallbackInput(uint32_t rank, std::vector<uint16_t>& data)
{
    for (uint64_t i = 0; i < data.size(); i++) {
        data[i] = MakeFallbackInputValue(rank, i);
    }
}

static bool LoadRankInput(uint32_t rank, std::vector<uint16_t>& data)
{
    if (ReadRankInput(rank, data)) {
        return true;
    }
    FillFallbackInput(rank, data);
    return false;
}

static bool WriteRankOutput(uint32_t rank, const std::vector<uint16_t>& data)
{
    (void)mkdir("./output", S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string cardDir = "./output/" + std::to_string(rank);
    (void)mkdir(cardDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string filePath = GetRankOutputPath(rank);
    std::ofstream file(filePath, std::ios::binary | std::ios::trunc);
    if (!file.is_open()) {
        printf("[ERROR] rank%u open output file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    file.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size() * sizeof(uint16_t)));
    if (!file.good()) {
        printf("[ERROR] rank%u write output file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    return true;
}

static void PrintRankData(const char* tag, uint32_t rank, const std::vector<uint16_t>& data)
{
    if (rank > 1U) {
        return;
    }
    constexpr uint64_t MAX_PRINT_COUNT = 32;
    std::lock_guard<std::mutex> lock(gPrintMutex);
    printf("%s rank%u:", tag, rank);
    const uint64_t printCount = std::min<uint64_t>(data.size(), MAX_PRINT_COUNT);
    for (uint64_t i = 0; i < printCount; i++) {
        printf(" %.0f", HalfToFloat(data[i]));
    }
    if (data.size() > printCount) {
        printf(" ...");
    }
    printf("\n");
}

static void PrintRankInputSource(uint32_t rank, const char* source)
{
    if (rank > 1U) {
        return;
    }
    std::lock_guard<std::mutex> lock(gPrintMutex);
    printf("rank%u input source: %s\n", rank, source);
}

#define ACL_CHECK(ret)                                                             \
    do {                                                                           \
        aclError aclRet = (ret);                                                   \
        if (aclRet != ACL_SUCCESS) {                                               \
            printf("[ERROR] %s:%d ret=%d\n", __FILE__, __LINE__, (int32_t)aclRet); \
            return -1;                                                             \
        }                                                                          \
    } while (0)

#define HCCL_CHECK(ret)                                                             \
    do {                                                                            \
        HcclResult hcclRet = (ret);                                                 \
        if (hcclRet != HCCL_SUCCESS) {                                              \
            printf("[ERROR] %s:%d ret=%d\n", __FILE__, __LINE__, (int32_t)hcclRet); \
            return -1;                                                              \
        }                                                                           \
    } while (0)

/* !
 * 单个rank上的纯ReduceScatter执行流程：
 * 1. 构造Mc2CcArgs并通过Mc2AcquireCcResCtx分配通信资源，得到Device侧OpResCtx；
 * 2. Mc2AicpuKernelLaunch在AICPU上下发Mc2ServerKernel，等待AICore侧的通信任务；
 * 3. 使用另一条stream通过<<<>>>下发AICore核函数，Device侧通过Hccl客户端下发
 *    ReduceScatter任务并与server交互；
 * 4. 回读输出校验结果。
 */
static int32_t RunReduceScatterCommunication(uint32_t deviceId, uint32_t rankSize, HcclRootInfo* rootInfo)
{
    ACL_CHECK(aclrtSetDevice(static_cast<int32_t>(deviceId)));

    // 初始化HCCL通信域，所有rank使用同一份rootInfo
    HcclComm comm = nullptr;
    HCCL_CHECK(HcclCommInitRootInfo(rankSize, rootInfo, deviceId, &comm));

    char commName[COMM_NAME_MAX_LENGTH] = {0};
    HCCL_CHECK(HcclGetCommName(comm, commName));

    // AICPU KFC server会阻塞等待AICore client消息，不能与AICore kernel使用同一条stream。
    aclrtStream aicpuStream = nullptr;
    aclrtStream aicoreStream = nullptr;
    ACL_CHECK(aclrtCreateStream(&aicpuStream));
    ACL_CHECK(aclrtCreateStream(&aicoreStream));

    const uint64_t inputElems = static_cast<uint64_t>(RECV_COUNT) * rankSize;
    const size_t inputSize = inputElems * sizeof(uint16_t);
    const size_t outputSize = RECV_COUNT * sizeof(uint16_t);

    // 申请Device内存并准备输入数据：优先读取脚本生成的数据，缺失时使用兜底数据
    void* inputDev = nullptr;
    void* outputDev = nullptr;
    ACL_CHECK(aclrtMalloc(&inputDev, inputSize, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&outputDev, outputSize, ACL_MEM_MALLOC_HUGE_FIRST));

    std::vector<uint16_t> inputBuff(inputElems, 0);
    const bool useFileInput = LoadRankInput(deviceId, inputBuff);
    PrintRankInputSource(deviceId, useFileInput ? GetRankInputPath(deviceId).c_str() : "fallback");
    PrintRankData("input", deviceId, inputBuff);
    ACL_CHECK(aclrtMemcpy(inputDev, inputSize, inputBuff.data(), inputSize, ACL_MEMCPY_HOST_TO_DEVICE));

    // ============================================================
    // STEP 1: 按参数分配通信资源
    // 返回Device侧OpResCtx地址，既是Mc2AicpuKernelLaunch的下发参数，
    // 也是Device侧Hccl客户端InitV2的context参数。
    // ============================================================
    void* ccArgs = nullptr;
    char algConfig[] = "ReduceScatter=level0:doublering";
    void* opResCtx = nullptr;
    uint32_t opResCtxSize = 0;
    HCCL_CHECK(Mc2GetCcArgs(&ccArgs));
    HCCL_CHECK(Mc2SetCcGroupName(ccArgs, commName));
    HCCL_CHECK(Mc2SetCcAlgConfig(ccArgs, algConfig));
    HCCL_CHECK(Mc2SetCcSrcDataType(ccArgs, AscendC::HcclDataType::HCCL_DATA_TYPE_FP16));
    HCCL_CHECK(Mc2SetCcDstDataType(ccArgs, AscendC::HcclDataType::HCCL_DATA_TYPE_FP16));
    HCCL_CHECK(Mc2SetCcReduceType(ccArgs, AscendC::HcclReduceOp::HCCL_REDUCE_SUM));
    HCCL_CHECK(Mc2SetCcCommEngine(ccArgs, MC2_COMM_ENGINE_AICPU_TS));
    HCCL_CHECK(Mc2AcquireCcResCtx(comm, static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_REDUCE_SCATTER), ccArgs,
        &opResCtx, &opResCtxSize));
    HCCL_CHECK(Mc2FreeCcArgs(ccArgs));

    // ============================================================
    // STEP 2: 下发AICPU KFC server内核(Mc2ServerKernel)
    // blockDim取0时内部按1处理；opResCtx已在Device侧，无需额外H2D拷贝；
    // server阻塞等待AICore侧Hccl客户端写入消息区并执行ReduceScatter通信
    // ============================================================
    HCCL_CHECK(Mc2AicpuKernelLaunch(0, aicpuStream, opResCtx, opResCtxSize));

    // ============================================================
    // STEP 3: 下发AICore核函数，Device侧Hccl客户端与server交互完成ReduceScatter
    // ============================================================
    reduce_scatter_do(1, aicoreStream, reinterpret_cast<uint8_t*>(inputDev), reinterpret_cast<uint8_t*>(outputDev),
        reinterpret_cast<uint8_t*>(opResCtx));

    // 先等待AICore client完成，再等待收到Finalize消息后退出的AICPU server。
    ACL_CHECK(aclrtSynchronizeStream(aicoreStream));
    ACL_CHECK(aclrtSynchronizeStream(aicpuStream));

    // 仅在Host侧回读并校验通信结果，Device侧不执行额外计算
    std::vector<uint16_t> result(RECV_COUNT, 0);
    ACL_CHECK(aclrtMemcpy(result.data(), outputSize, outputDev, outputSize, ACL_MEMCPY_DEVICE_TO_HOST));
    PrintRankData("output", deviceId, result);
    if (!WriteRankOutput(deviceId, result)) {
        return -1;
    }

    // 按ReduceScatter语义计算期望输出：y[i] = sum_rank(x_rank[rankId * recvCount + i])，
    // 即每个rank收到归约结果中第rankId块，FP16整数求和精确
    std::vector<std::vector<uint16_t>> inputs(rankSize);
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        inputs[rank].resize(inputElems);
        (void)LoadRankInput(rank, inputs[rank]);
    }
    bool checkOk = true;
    uint32_t errorCount = 0;
    for (uint32_t i = 0; i < RECV_COUNT; i++) {
        float sum = 0.0F;
        for (uint32_t rank = 0; rank < rankSize; rank++) {
            sum += HalfToFloat(inputs[rank][static_cast<uint64_t>(deviceId) * RECV_COUNT + i]);
        }
        const uint16_t golden = FloatToHalf(sum);
        if (result[i] != golden) {
            checkOk = false;
            if (errorCount < 10U) {
                printf("[ERROR] rank%u verify failed at [%u], got %.0f, expect %.0f\n", deviceId, i,
                    HalfToFloat(result[i]), HalfToFloat(golden));
            }
            errorCount++;
        }
    }
    if (errorCount > 10U) {
        printf("[ERROR] rank%u total mismatch count: %u / %u\n", deviceId, errorCount, RECV_COUNT);
    }
    printf("rank%u ReduceScatter verify %s\n", deviceId, checkOk ? "pass" : "failed");

    // 释放资源
    ACL_CHECK(aclrtFree(inputDev));
    ACL_CHECK(aclrtFree(outputDev));
    HCCL_CHECK(HcclCommDestroy(comm));
    ACL_CHECK(aclrtDestroyStream(aicoreStream));
    ACL_CHECK(aclrtDestroyStream(aicpuStream));
    ACL_CHECK(aclrtResetDevice(static_cast<int32_t>(deviceId)));
    return checkOk ? 0 : -1;
}

/* !
 * 主入口：与HCCL集合通信样例一致，使用单进程多线程模拟多rank场景，
 * 每个线程绑定一个Device并初始化通信域后并发执行ReduceScatter。
 */
int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    ACL_CHECK(aclInit(nullptr));

    uint32_t devCount = 0;
    ACL_CHECK(aclrtGetDeviceCount(&devCount));
    if (devCount < 1) {
        printf("[ERROR] no available device\n");
        return -1;
    }
    const uint32_t rankSize = devCount;
    printf("ReduceScatter sample start, rankSize = %u\n", rankSize);

    // rank0生成rootInfo，所有rank共享
    ACL_CHECK(aclrtSetDevice(0));
    HcclRootInfo rootInfo;
    HCCL_CHECK(HcclGetRootInfo(&rootInfo));

    std::vector<std::thread> threads(rankSize);
    std::vector<int32_t> results(rankSize, -1);
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        threads[rank] = std::thread([rank, rankSize, &rootInfo, &results]() {
            results[rank] = RunReduceScatterCommunication(rank, rankSize, &rootInfo);
        });
    }
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        threads[rank].join();
    }

    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());

    for (uint32_t rank = 0; rank < rankSize; rank++) {
        if (results[rank] != 0) {
            printf("ReduceScatter sample failed\n");
            return -1;
        }
    }
    printf("ReduceScatter sample pass\n");
    return 0;
}
