/* !
 * \file all_reduce.asc
 * \brief 纯通信AllReduce样例的Device侧实现，不包含额外计算
 */

#include "kernel_operator.h"
#include "adv_api/hccl/hccl.h"

/* !
 * 每卡参与AllReduce的half元素个数，各卡数据SUM归约后，输出y同为SEND_COUNT个half。
 */
constexpr uint64_t SEND_COUNT = 128;

/* !
 * AIV核上的纯AllReduce通信流程，遵循HCCL客户端用法：
 * InitV2 -> AllReduce(Prepare) -> Commit/Wait -> Finalize。
 * AllReduce<true>表示Prepare时同步Commit通知服务端可执行；
 * 服务端为Mc2AicpuKernelLaunch下发的AICPU KFC server(Mc2ServerKernel)。
 */
__aicore__ inline void AllReduceCommunication(GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context)
{
    // 1. 初始化HCCL客户端，context为Host侧Mc2AcquireCcResCtx返回的OpResCtx地址
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);
    // 2. 下发AllReduce通信任务：各卡SEND_COUNT个half按SUM归约后，结果同步到每卡输出y
    AscendC::HcclHandle handleId = hccl.AllReduce<true>(
        x, y, SEND_COUNT, AscendC::HcclDataType::HCCL_DATA_TYPE_FP16, AscendC::HcclReduceOp::HCCL_REDUCE_SUM);
    if (handleId < 0) {
        return;
    }
    // 3. 阻塞等待该handleId对应的通信任务执行完成
    hccl.Wait(handleId);
    // 全AIV核同步，防止部分核执行较快提前Finalize影响其他核Wait
    AscendC::SyncAll<true>();
    // 4. 通知服务端后续无通信任务，等待最后一个通信任务结束后退出
    hccl.Finalize();
}

/* !
 * AllReduce核函数：x为输入GM地址，y为输出GM地址，mc2Context为通信上下文(OpResCtx)地址。
 * HCCL通信接口仅在AIV核上调用，AIC核直接返回。
 */
extern "C" __vector__ __global__ void all_reduce_custom(GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context)
{
    if (g_coreType == AscendC::AIV) {
        AllReduceCommunication(x, y, mc2Context);
    }
}

/* !
 * Host侧下发入口，Kernel直调场景使用<<<>>>内核调用符。
 * blockDim为启动的核数，需覆盖全部参与通信的AIV逻辑核。
 */
extern "C" void all_reduce_do(uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context)
{
    all_reduce_custom<<<blockDim, nullptr, stream>>>(x, y, mc2Context);
}
