 * \file main.asc
 * \brief Host-side MC2 collective sample.
 */

#include <algorithm>
#include <cctype>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <limits>
#include <mutex>
#include <string>
#include <thread>
#include <vector>
#include <sys/stat.h>
#include <sys/types.h>

#include "acl/acl.h"
#include "hccl/hccl_comm.h"
#include "adv_api/hccl/hccl_common.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "collective_common.h"

extern "C" void collective_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t opType,
    uint64_t count, uint32_t dataTypeValue, uint32_t reduceOpValue, uint8_t* sendCounts, uint8_t* sendDispls,
    uint8_t* recvCounts, uint8_t* recvDispls);

enum class Operation : uint32_t {
    ALLGATHER = COLLECTIVE_ALLGATHER,
    ALLREDUCE = COLLECTIVE_ALLREDUCE,
    ALLTOALL = COLLECTIVE_ALLTOALL,
    ALLTOALLV = COLLECTIVE_ALLTOALLV,
    REDUCESCATTER = COLLECTIVE_REDUCESCATTER,
};

struct DataTypeInfo {
    const char* name;
    AscendC::HcclDataType type;
    size_t elementSize;
    bool reductionSupported;
};

static constexpr DataTypeInfo DATA_TYPES[] = {
    {"int8", AscendC::HcclDataType::HCCL_DATA_TYPE_INT8, sizeof(int8_t), true},
    {"int16", AscendC::HcclDataType::HCCL_DATA_TYPE_INT16, sizeof(int16_t), true},
    {"int32", AscendC::HcclDataType::HCCL_DATA_TYPE_INT32, sizeof(int32_t), true},
    {"fp16", AscendC::HcclDataType::HCCL_DATA_TYPE_FP16, sizeof(uint16_t), true},
    {"fp32", AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, sizeof(float), true},
    {"int64", AscendC::HcclDataType::HCCL_DATA_TYPE_INT64, sizeof(int64_t), false},
    {"uint64", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT64, sizeof(uint64_t), false},
    {"uint8", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT8, sizeof(uint8_t), false},
    {"uint16", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT16, sizeof(uint16_t), false},
    {"uint32", AscendC::HcclDataType::HCCL_DATA_TYPE_UINT32, sizeof(uint32_t), false},
    {"fp64", AscendC::HcclDataType::HCCL_DATA_TYPE_FP64, sizeof(double), false},
    {"bf16", AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16, sizeof(uint16_t), true},
    {"hif8", AscendC::HcclDataType::HCCL_DATA_TYPE_HIF8, sizeof(uint8_t), false},
    {"fp8e4m3", AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E4M3, sizeof(uint8_t), false},
    {"fp8e5m2", AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E5M2, sizeof(uint8_t), false},
    {"fp8e8m0", AscendC::HcclDataType::HCCL_DATA_TYPE_FP8E8M0, sizeof(uint8_t), false},
};

struct RunConfig {
    Operation operation = Operation::ALLGATHER;
    const DataTypeInfo* dataType = nullptr;
    AscendC::HcclReduceOp reduceOp = AscendC::HCCL_REDUCE_SUM;
    std::string inputDir = "./input";
    std::string outputDir = "./output";
    bool showHelp = false;
};

struct RankData {
    std::vector<uint8_t> input;
    std::vector<uint64_t> sendCounts;
    std::vector<uint64_t> sendDispls;
    std::vector<uint64_t> recvCounts;
    std::vector<uint64_t> recvDispls;
    size_t outputBytes = 0;
};

static std::mutex gPrintMutex;

static const DataTypeInfo* FindDataType(const std::string& name)
{
    std::string normalized(name);
    std::transform(normalized.begin(), normalized.end(), normalized.begin(), [](unsigned char value) {
        return static_cast<char>(std::tolower(value));
    });
    for (const DataTypeInfo& dataType : DATA_TYPES) {
        if (normalized == dataType.name) {
            return &dataType;
        }
    }
    return nullptr;
}

static bool IsReduceOperation(Operation operation)
{
    return operation == Operation::ALLREDUCE || operation == Operation::REDUCESCATTER;
}

static const char* OperationName(Operation operation)
{
    switch (operation) {
        case Operation::ALLGATHER:
            return "allgather";
        case Operation::ALLREDUCE:
            return "allreduce";
        case Operation::ALLTOALL:
            return "alltoall";
        case Operation::ALLTOALLV:
            return "alltoallv";
        case Operation::REDUCESCATTER:
            return "reducescatter";
        default:
            return "unknown";
    }
}

static AscendC::HcclCMDType GetCommandType(Operation operation)
{
    switch (operation) {
        case Operation::ALLGATHER:
            return AscendC::HcclCMDType::HCCL_CMD_ALLGATHER;
        case Operation::ALLREDUCE:
            return AscendC::HcclCMDType::HCCL_CMD_ALLREDUCE;
        case Operation::ALLTOALL:
            return AscendC::HcclCMDType::HCCL_CMD_ALLTOALL;
        case Operation::ALLTOALLV:
            return AscendC::HcclCMDType::HCCL_CMD_ALLTOALLV;
        case Operation::REDUCESCATTER:
            return AscendC::HcclCMDType::HCCL_CMD_REDUCE_SCATTER;
        default:
            return AscendC::HcclCMDType::HCCL_CMD_INVALID;
    }
}

static bool ParseOperation(const std::string& value, Operation& operation)
{
    if (value == "allgather") {
        operation = Operation::ALLGATHER;
    } else if (value == "allreduce") {
        operation = Operation::ALLREDUCE;
    } else if (value == "alltoall") {
        operation = Operation::ALLTOALL;
    } else if (value == "alltoallv") {
        operation = Operation::ALLTOALLV;
    } else if (value == "reducescatter") {
        operation = Operation::REDUCESCATTER;
    } else {
        return false;
    }
    return true;
}

static bool ParseReduceOp(const std::string& value, AscendC::HcclReduceOp& reduceOp)
{
    if (value == "sum") {
        reduceOp = AscendC::HCCL_REDUCE_SUM;
    } else if (value == "max") {
        reduceOp = AscendC::HCCL_REDUCE_MAX;
    } else if (value == "min") {
        reduceOp = AscendC::HCCL_REDUCE_MIN;
    } else {
        return false;
    }
    return true;
}

static void PrintSupportedDataTypes()
{
    printf("supported data types:");
    for (const DataTypeInfo& dataType : DATA_TYPES) {
        printf(" %s", dataType.name);
    }
    printf("\n");
}

static bool ParseArgs(int32_t argc, char* argv[], RunConfig& config)
{
    config.dataType = FindDataType("fp16");
    for (int32_t i = 1; i < argc; ++i) {
        const std::string argument(argv[i]);
        if (argument == "--help") {
            printf(
                "Usage: %s --ops OP [--data-type TYPE] [--reduce-op OP] "
                "[--input-dir DIR] [--output-dir DIR]\n",
                argv[0]);
            printf("ops: allgather allreduce alltoall alltoallv reducescatter\n");
            printf("reduce-op: sum max min; used by allreduce and reducescatter\n");
            printf("ordinary input: DIR/<rank>/x1.bin\n");
            printf("alltoallv metadata: DIR/<rank>/{send_counts,send_displs,recv_counts,recv_displs}.bin\n");
            PrintSupportedDataTypes();
            config.showHelp = true;
            return true;
        }
        if (argument == "--ops" || argument == "--data-type" || argument == "--reduce-op" ||
            argument == "--input-dir" || argument == "--output-dir") {
            if (i + 1 >= argc) {
                printf("[ERROR] missing value for %s\n", argument.c_str());
                return false;
            }
            const std::string value(argv[++i]);
            if (argument == "--ops") {
                if (!ParseOperation(value, config.operation)) {
                    printf("[ERROR] unsupported operation: %s\n", value.c_str());
                    return false;
                }
            } else if (argument == "--data-type") {
                config.dataType = FindDataType(value);
                if (config.dataType == nullptr) {
                    printf("[ERROR] unsupported data type: %s\n", value.c_str());
                    PrintSupportedDataTypes();
                    return false;
                }
            } else if (argument == "--reduce-op") {
                if (!ParseReduceOp(value, config.reduceOp)) {
                    printf("[ERROR] unsupported reduce operation: %s\n", value.c_str());
                    return false;
                }
            } else if (argument == "--input-dir") {
                config.inputDir = value;
            } else {
                config.outputDir = value;
            }
            continue;
        }
        printf("[ERROR] unknown argument: %s\n", argument.c_str());
        return false;
    }
    if (IsReduceOperation(config.operation) && !config.dataType->reductionSupported) {
        printf("[ERROR] data type %s is not supported by allreduce/reducescatter\n", config.dataType->name);
        return false;
    }
    return true;
}

static std::string RankFilePath(const std::string& directory, uint32_t rank, const char* name)
{
    return directory + "/" + std::to_string(rank) + "/" + name;
}

static bool ReadBinaryFile(const std::string& path, std::vector<uint8_t>& data)
{
    std::ifstream file(path, std::ios::binary);
    if (!file.is_open()) {
        printf("[ERROR] open input file failed: %s\n", path.c_str());
        return false;
    }
    file.seekg(0, std::ios::end);
    const std::streamoff fileSize = file.tellg();
    if (fileSize < 0 || static_cast<uint64_t>(fileSize) > SIZE_MAX) {
        printf("[ERROR] input file size invalid: %s\n", path.c_str());
        return false;
    }
    file.seekg(0, std::ios::beg);
    data.resize(static_cast<size_t>(fileSize));
    if (fileSize > 0) {
        file.read(reinterpret_cast<char*>(data.data()), fileSize);
        if (file.gcount() != fileSize) {
            printf("[ERROR] read input file failed: %s\n", path.c_str());
            return false;
        }
    }
    return true;
}

static bool ReadUint64Array(const std::string& path, uint32_t rankSize, std::vector<uint64_t>& values)
{
    std::vector<uint8_t> bytes;
    if (!ReadBinaryFile(path, bytes)) {
        return false;
    }
    const size_t expectedBytes = static_cast<size_t>(rankSize) * sizeof(uint64_t);
    if (bytes.size() != expectedBytes) {
        printf("[ERROR] metadata file size invalid: %s, expect %zu bytes, got %zu\n", path.c_str(), expectedBytes,
            bytes.size());
        return false;
    }
    values.resize(rankSize);
    if (expectedBytes != 0) {
        std::memcpy(values.data(), bytes.data(), expectedBytes);
    }
    return true;
}

static bool WriteRankOutput(
    const std::string& outputDir, uint32_t rank, const std::vector<uint8_t>& data)
{
    (void)mkdir(outputDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string rankDir = outputDir + "/" + std::to_string(rank);
    (void)mkdir(rankDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string path = rankDir + "/output_npu.bin";
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file.is_open()) {
        printf("[ERROR] open output file failed: %s\n", path.c_str());
        return false;
    }
    if (!data.empty()) {
        file.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
    }
    if (!file.good()) {
        printf("[ERROR] write output file failed: %s\n", path.c_str());
        return false;
    }
    return true;
}

static void PrintRankData(const char* tag, uint32_t rank, const std::vector<uint8_t>& data)
{
    if (rank > 1U) {
        return;
    }
    std::lock_guard<std::mutex> lock(gPrintMutex);
    constexpr size_t PRINT_BYTES = 64;
    printf("%s rank%u (%zu bytes):", tag, rank, data.size());
    for (size_t i = 0; i < std::min(data.size(), PRINT_BYTES); ++i) {
        printf(" %02x", static_cast<unsigned int>(data[i]));
    }
    if (data.size() > PRINT_BYTES) {
        printf(" ...");
    }
    printf("\n");
}

static bool ElementsToBytes(uint64_t elements, size_t elementSize, size_t& bytes)
{
    if (elementSize == 0 || elements > SIZE_MAX / elementSize) {
        return false;
    }
    bytes = static_cast<size_t>(elements) * elementSize;
    return true;
}

static bool GetArrayExtent(
    const std::vector<uint64_t>& counts, const std::vector<uint64_t>& displs, size_t elementSize, size_t& bytes)
{
    uint64_t maxElement = 0;
    for (size_t i = 0; i < counts.size(); ++i) {
        if (displs[i] > std::numeric_limits<uint64_t>::max() - counts[i]) {
            return false;
        }
        maxElement = std::max(maxElement, displs[i] + counts[i]);
    }
    return ElementsToBytes(maxElement, elementSize, bytes);
}

static bool LoadRankInputs(const RunConfig& config, uint32_t rankSize, std::vector<RankData>& ranks)
{
    ranks.assign(rankSize, RankData{});
    for (uint32_t rank = 0; rank < rankSize; ++rank) {
        if (!ReadBinaryFile(RankFilePath(config.inputDir, rank, "x1.bin"), ranks[rank].input)) {
            return false;
        }
        if (ranks[rank].input.size() % config.dataType->elementSize != 0) {
            printf("[ERROR] rank%u input size %zu is not divisible by element size %zu\n", rank,
                ranks[rank].input.size(), config.dataType->elementSize);
            return false;
        }
    }

    if (config.operation == Operation::ALLTOALLV) {
        for (uint32_t rank = 0; rank < rankSize; ++rank) {
            RankData& data = ranks[rank];
            if (!ReadUint64Array(RankFilePath(config.inputDir, rank, "send_counts.bin"), rankSize, data.sendCounts) ||
                !ReadUint64Array(RankFilePath(config.inputDir, rank, "send_displs.bin"), rankSize, data.sendDispls) ||
                !ReadUint64Array(RankFilePath(config.inputDir, rank, "recv_counts.bin"), rankSize, data.recvCounts) ||
                !ReadUint64Array(RankFilePath(config.inputDir, rank, "recv_displs.bin"), rankSize, data.recvDispls)) {
                return false;
            }
            size_t sendBytes = 0;
            size_t recvBytes = 0;
            if (!GetArrayExtent(data.sendCounts, data.sendDispls, config.dataType->elementSize, sendBytes) ||
                !GetArrayExtent(data.recvCounts, data.recvDispls, config.dataType->elementSize, recvBytes)) {
                printf("[ERROR] rank%u AlltoAllV metadata extent overflow\n", rank);
                return false;
            }
            if (data.input.size() < sendBytes) {
                printf("[ERROR] rank%u input has %zu bytes, but metadata needs %zu bytes\n", rank,
                    data.input.size(), sendBytes);
                return false;
            }
            data.outputBytes = recvBytes;
        }
        for (uint32_t source = 0; source < rankSize; ++source) {
            for (uint32_t destination = 0; destination < rankSize; ++destination) {
                if (ranks[source].sendCounts[destination] != ranks[destination].recvCounts[source]) {
                    printf("[ERROR] AlltoAllV count mismatch source=%u destination=%u\n", source, destination);
                    return false;
                }
            }
        }
        return true;
    }

    if (ranks.empty() || ranks[0].input.empty()) {
        printf("[ERROR] input must contain at least one element\n");
        return false;
    }
    const size_t inputBytes = ranks[0].input.size();
    for (uint32_t rank = 1; rank < rankSize; ++rank) {
        if (ranks[rank].input.size() != inputBytes) {
            printf("[ERROR] input size mismatch: rank0=%zu bytes, rank%u=%zu bytes\n", inputBytes, rank,
                ranks[rank].input.size());
            return false;
        }
    }

    const uint64_t inputElements = static_cast<uint64_t>(inputBytes / config.dataType->elementSize);
    size_t outputBytes = 0;
    switch (config.operation) {
        case Operation::ALLGATHER:
            if (inputBytes > SIZE_MAX / rankSize) {
                return false;
            }
            outputBytes = inputBytes * rankSize;
            break;
        case Operation::ALLREDUCE:
            outputBytes = inputBytes;
            break;
        case Operation::ALLTOALL:
            if (inputElements % rankSize != 0) {
                printf("[ERROR] AlltoAll input element count must be divisible by rank size\n");
                return false;
            }
            outputBytes = inputBytes;
            break;
        case Operation::REDUCESCATTER:
            if (inputElements % rankSize != 0) {
                printf("[ERROR] ReduceScatter input element count must be divisible by rank size\n");
                return false;
            }
            outputBytes = inputBytes / rankSize;
            break;
        default:
            return false;
    }
    for (RankData& data : ranks) {
        data.outputBytes = outputBytes;
    }
    return true;
}

static float HalfToFloat(uint16_t value)
{
    const uint32_t sign = (static_cast<uint32_t>(value & 0x8000U)) << 16U;
    const uint32_t exponent = (value >> 10U) & 0x1fU;
    const uint32_t mantissa = value & 0x03ffU;
    uint32_t bits = 0;
    if (exponent == 0) {
        if (mantissa != 0) {
            float result = static_cast<float>(mantissa) / 1024.0f;
            result = std::ldexp(result, -14);
            return (value & 0x8000U) == 0 ? result : -result;
        }
        bits = sign;
    } else if (exponent == 0x1fU) {
        bits = sign | 0x7f800000U | (mantissa << 13U);
    } else {
        bits = sign | ((exponent + 112U) << 23U) | (mantissa << 13U);
    }
    float result = 0.0f;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

static uint16_t FloatToHalf(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16U) & 0x8000U;
    const uint32_t absolute = bits & 0x7fffffffU;
    if (absolute >= 0x7f800000U) {
        return static_cast<uint16_t>(sign | 0x7c00U | ((absolute & 0x007fffffU) >> 13U));
    }
    const int32_t exponent = static_cast<int32_t>((absolute >> 23U) & 0xffU) - 127;
    const uint32_t mantissa = absolute & 0x007fffffU;
    if (exponent > 15) {
        return static_cast<uint16_t>(sign | 0x7c00U);
    }
    if (exponent < -14) {
        if (exponent < -24) {
            return static_cast<uint16_t>(sign);
        }
        const uint32_t significand = mantissa | 0x00800000U;
        const uint32_t shift = static_cast<uint32_t>(-exponent - 14 + 13);
        uint32_t halfMantissa = significand >> shift;
        const uint32_t remainderMask = (1U << shift) - 1U;
        const uint32_t remainder = significand & remainderMask;
        if (remainder > (1U << (shift - 1U)) ||
            (remainder == (1U << (shift - 1U)) && (halfMantissa & 1U) != 0U)) {
            ++halfMantissa;
        }
        return static_cast<uint16_t>(sign | halfMantissa);
    }
    uint32_t halfExponent = static_cast<uint32_t>(exponent + 15);
    uint32_t halfMantissa = mantissa >> 13U;
    const uint32_t remainder = mantissa & 0x1fffU;
    if (remainder > 0x1000U || (remainder == 0x1000U && (halfMantissa & 1U) != 0U)) {
        ++halfMantissa;
        if (halfMantissa == 0x400U) {
            halfMantissa = 0;
            ++halfExponent;
        }
    }
    if (halfExponent >= 0x1fU) {
        return static_cast<uint16_t>(sign | 0x7c00U);
    }
    return static_cast<uint16_t>(sign | (halfExponent << 10U) | halfMantissa);
}

static float Bf16ToFloat(uint16_t value)
{
    const uint32_t bits = static_cast<uint32_t>(value) << 16U;
    float result = 0.0f;
    std::memcpy(&result, &bits, sizeof(result));
    return result;
}

static uint16_t FloatToBf16(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    return static_cast<uint16_t>(bits >> 16U);
}

static float ApplyFloatReduce(float lhs, float rhs, AscendC::HcclReduceOp reduceOp)
{
    if (reduceOp == AscendC::HCCL_REDUCE_SUM) {
        return lhs + rhs;
    }
    if (reduceOp == AscendC::HCCL_REDUCE_MAX) {
        return std::max(lhs, rhs);
    }
    return std::min(lhs, rhs);
}

static bool ReduceOne(
    const DataTypeInfo& dataType, const uint8_t* lhs, const uint8_t* rhs, uint8_t* result,
    AscendC::HcclReduceOp reduceOp)
{
    if (std::strcmp(dataType.name, "int8") == 0) {
        int8_t a = 0;
        int8_t b = 0;
        std::memcpy(&a, lhs, sizeof(a));
        std::memcpy(&b, rhs, sizeof(b));
        const int8_t value = reduceOp == AscendC::HCCL_REDUCE_SUM
            ? static_cast<int8_t>(a + b)
            : (reduceOp == AscendC::HCCL_REDUCE_MAX ? std::max(a, b) : std::min(a, b));
        std::memcpy(result, &value, sizeof(value));
        return true;
    }
    if (std::strcmp(dataType.name, "int16") == 0) {
        int16_t a = 0;
        int16_t b = 0;
        std::memcpy(&a, lhs, sizeof(a));
        std::memcpy(&b, rhs, sizeof(b));
        const int16_t value = reduceOp == AscendC::HCCL_REDUCE_SUM
            ? static_cast<int16_t>(a + b)
            : (reduceOp == AscendC::HCCL_REDUCE_MAX ? std::max(a, b) : std::min(a, b));
        std::memcpy(result, &value, sizeof(value));
        return true;
    }
    if (std::strcmp(dataType.name, "int32") == 0) {
        int32_t a = 0;
        int32_t b = 0;
        std::memcpy(&a, lhs, sizeof(a));
        std::memcpy(&b, rhs, sizeof(b));
        const int32_t value = reduceOp == AscendC::HCCL_REDUCE_SUM
            ? a + b
            : (reduceOp == AscendC::HCCL_REDUCE_MAX ? std::max(a, b) : std::min(a, b));
        std::memcpy(result, &value, sizeof(value));
        return true;
    }
    if (std::strcmp(dataType.name, "fp32") == 0) {
        float a = 0.0f;
        float b = 0.0f;
        std::memcpy(&a, lhs, sizeof(a));
        std::memcpy(&b, rhs, sizeof(b));
        const float value = ApplyFloatReduce(a, b, reduceOp);
        std::memcpy(result, &value, sizeof(value));
        return true;
    }
    if (std::strcmp(dataType.name, "fp16") == 0 || std::strcmp(dataType.name, "bf16") == 0) {
        uint16_t aBits = 0;
        uint16_t bBits = 0;
        std::memcpy(&aBits, lhs, sizeof(aBits));
        std::memcpy(&bBits, rhs, sizeof(bBits));
        const float a = std::strcmp(dataType.name, "fp16") == 0 ? HalfToFloat(aBits) : Bf16ToFloat(aBits);
        const float b = std::strcmp(dataType.name, "fp16") == 0 ? HalfToFloat(bBits) : Bf16ToFloat(bBits);
        const uint16_t value = std::strcmp(dataType.name, "fp16") == 0
            ? FloatToHalf(ApplyFloatReduce(a, b, reduceOp))
            : FloatToBf16(ApplyFloatReduce(a, b, reduceOp));
        std::memcpy(result, &value, sizeof(value));
        return true;
    }
    return false;
}

static bool BuildExpected(
    const RunConfig& config, uint32_t rankSize, uint32_t rank, const std::vector<RankData>& ranks,
    std::vector<uint8_t>& expected)
{
    const RankData& local = ranks[rank];
    const size_t elementSize = config.dataType->elementSize;
    expected.assign(local.outputBytes, 0);
    if (config.operation == Operation::ALLGATHER) {
        for (uint32_t source = 0; source < rankSize; ++source) {
            std::memcpy(
                expected.data() + static_cast<size_t>(source) * ranks[source].input.size(), ranks[source].input.data(),
                ranks[source].input.size());
        }
        return true;
    }
    if (config.operation == Operation::ALLTOALL) {
        const uint64_t dataCount = static_cast<uint64_t>(ranks[0].input.size() / elementSize / rankSize);
        const size_t blockBytes = static_cast<size_t>(dataCount) * elementSize;
        for (uint32_t source = 0; source < rankSize; ++source) {
            const size_t sourceOffset = static_cast<size_t>(rank) * blockBytes;
            const size_t destinationOffset = static_cast<size_t>(source) * blockBytes;
            std::memcpy(
                expected.data() + destinationOffset, ranks[source].input.data() + sourceOffset, blockBytes);
        }
        return true;
    }
    if (config.operation == Operation::ALLTOALLV) {
        for (uint32_t source = 0; source < rankSize; ++source) {
            const uint64_t count = ranks[source].sendCounts[rank];
            size_t copyBytes = 0;
            if (!ElementsToBytes(count, elementSize, copyBytes)) {
                return false;
            }
            size_t sourceOffset = 0;
            size_t destinationOffset = 0;
            if (!ElementsToBytes(ranks[source].sendDispls[rank], elementSize, sourceOffset) ||
                !ElementsToBytes(local.recvDispls[source], elementSize, destinationOffset)) {
                return false;
            }
            if (copyBytes != 0) {
                std::memcpy(
                    expected.data() + destinationOffset, ranks[source].input.data() + sourceOffset, copyBytes);
            }
        }
        return true;
    }
    const uint64_t inputElements = static_cast<uint64_t>(ranks[0].input.size() / elementSize);
    uint64_t outputElements = inputElements;
    uint64_t inputOffset = 0;
    if (config.operation == Operation::REDUCESCATTER) {
        outputElements /= rankSize;
        inputOffset = static_cast<uint64_t>(rank) * outputElements;
    }
    for (uint64_t element = 0; element < outputElements; ++element) {
        const size_t sourceOffset = static_cast<size_t>(inputOffset + element) * elementSize;
        const size_t destinationOffset = static_cast<size_t>(element) * elementSize;
        std::memcpy(expected.data() + destinationOffset, ranks[0].input.data() + sourceOffset, elementSize);
        for (uint32_t source = 1; source < rankSize; ++source) {
            if (!ReduceOne(
                    *config.dataType, expected.data() + destinationOffset,
                    ranks[source].input.data() + sourceOffset, expected.data() + destinationOffset, config.reduceOp)) {
                return false;
            }
        }
    }
    return true;
}

static bool VerifyOutput(
    uint32_t rank, const std::vector<uint8_t>& expected, const std::vector<uint8_t>& actual)
{
    if (expected.size() != actual.size()) {
        printf("[ERROR] rank%u output size mismatch: expected %zu, got %zu\n", rank, expected.size(), actual.size());
        return false;
    }
    for (size_t i = 0; i < expected.size(); ++i) {
        if (expected[i] != actual[i]) {
            printf("[ERROR] rank%u verify failed at byte %zu, got 0x%02x, expect 0x%02x\n", rank, i,
                static_cast<unsigned int>(actual[i]), static_cast<unsigned int>(expected[i]));
            return false;
        }
    }
    return true;
}

static HcclResult SetCollectiveResourceArgs(
    void* ccArgs, const char* groupName, const RunConfig& config)
{
    char algConfig[Mc2CcArgs::ALG_CONFIG_SIZE] = "AllGather=level0:doublering";
    if (config.operation == Operation::ALLREDUCE) {
        std::strcpy(algConfig, "AllReduce=level0:doublering");
    } else if (config.operation == Operation::ALLTOALL || config.operation == Operation::ALLTOALLV) {
        std::strcpy(algConfig, "AlltoAll=level0:fullmesh;level1:pairwise");
    } else if (config.operation == Operation::REDUCESCATTER) {
        std::strcpy(algConfig, "ReduceScatter=level0:doublering");
    }
    HcclResult result = Mc2SetCcGroupName(ccArgs, const_cast<char*>(groupName));
    if (result != HCCL_SUCCESS) {
        return result;
    }
    result = Mc2SetCcAlgConfig(ccArgs, algConfig);
    if (result != HCCL_SUCCESS) {
        return result;
    }
    result = Mc2SetCcSrcDataType(ccArgs, static_cast<uint8_t>(config.dataType->type));
    if (result != HCCL_SUCCESS) {
        return result;
    }
    result = Mc2SetCcDstDataType(ccArgs, static_cast<uint8_t>(config.dataType->type));
    if (result != HCCL_SUCCESS) {
        return result;
    }
    if (IsReduceOperation(config.operation)) {
        result = Mc2SetCcReduceType(ccArgs, static_cast<uint32_t>(config.reduceOp));
        if (result != HCCL_SUCCESS) {
            return result;
        }
    }
    return Mc2SetCcCommEngine(ccArgs, 3);
}

static int32_t RunCollective(
    uint32_t deviceId, uint32_t rankSize, HcclRootInfo* rootInfo, const RunConfig& config,
    const std::vector<RankData>& ranks)
{
    bool deviceSet = false;
    HcclComm comm = nullptr;
    aclrtStream aicpuStream = nullptr;
    aclrtStream aicoreStream = nullptr;
    void* inputDev = nullptr;
    void* outputDev = nullptr;
    void* sendCountsDev = nullptr;
    void* sendDisplsDev = nullptr;
    void* recvCountsDev = nullptr;
    void* recvDisplsDev = nullptr;
    void* ccArgs = nullptr;
    void* opResCtx = nullptr;
    uint32_t opResCtxSize = 0;
    int32_t status = -1;
    const RankData& local = ranks[deviceId];
    const size_t metadataBytes = static_cast<size_t>(rankSize) * sizeof(uint64_t);
    const size_t inputAllocBytes = std::max<size_t>(local.input.size(), 1);
    const size_t outputAllocBytes = std::max<size_t>(local.outputBytes, 1);
    const uint64_t inputElements = static_cast<uint64_t>(local.input.size() / config.dataType->elementSize);
    uint64_t count = 0;
    if (config.operation == Operation::ALLGATHER || config.operation == Operation::ALLREDUCE) {
        count = inputElements;
    } else if (config.operation == Operation::ALLTOALL) {
        count = inputElements / rankSize;
    } else if (config.operation == Operation::REDUCESCATTER) {
        count = inputElements / rankSize;
    }

    if (aclrtSetDevice(static_cast<int32_t>(deviceId)) != ACL_SUCCESS) {
        printf("[ERROR] rank%u aclrtSetDevice failed\n", deviceId);
        goto cleanup;
    }
    deviceSet = true;
    if (HcclCommInitRootInfo(rankSize, rootInfo, deviceId, &comm) != HCCL_SUCCESS) {
        printf("[ERROR] rank%u HcclCommInitRootInfo failed\n", deviceId);
        goto cleanup;
    }
    if (aclrtCreateStream(&aicpuStream) != ACL_SUCCESS || aclrtCreateStream(&aicoreStream) != ACL_SUCCESS) {
        printf("[ERROR] rank%u create stream failed\n", deviceId);
        goto cleanup;
    }
    if (aclrtMalloc(&inputDev, inputAllocBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(&outputDev, outputAllocBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        printf("[ERROR] rank%u allocate data buffer failed\n", deviceId);
        goto cleanup;
    }
    if (!local.input.empty() &&
        aclrtMemcpy(inputDev, local.input.size(), local.input.data(), local.input.size(),
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        printf("[ERROR] rank%u copy input failed\n", deviceId);
        goto cleanup;
    }
    {
        std::vector<uint8_t> zeroOutput(local.outputBytes, 0);
        if (!zeroOutput.empty() &&
            aclrtMemcpy(outputDev, zeroOutput.size(), zeroOutput.data(), zeroOutput.size(),
                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
            printf("[ERROR] rank%u initialize output failed\n", deviceId);
            goto cleanup;
        }
    }

    if (config.operation == Operation::ALLTOALLV) {
        if (aclrtMalloc(&sendCountsDev, metadataBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
            aclrtMalloc(&sendDisplsDev, metadataBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
            aclrtMalloc(&recvCountsDev, metadataBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
            aclrtMalloc(&recvDisplsDev, metadataBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            printf("[ERROR] rank%u allocate AlltoAllV metadata failed\n", deviceId);
            goto cleanup;
        }
        if (aclrtMemcpy(sendCountsDev, metadataBytes, local.sendCounts.data(), metadataBytes,
                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
            aclrtMemcpy(sendDisplsDev, metadataBytes, local.sendDispls.data(), metadataBytes,
                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
            aclrtMemcpy(recvCountsDev, metadataBytes, local.recvCounts.data(), metadataBytes,
                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
            aclrtMemcpy(recvDisplsDev, metadataBytes, local.recvDispls.data(), metadataBytes,
                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
            printf("[ERROR] rank%u copy AlltoAllV metadata failed\n", deviceId);
            goto cleanup;
        }
    }

    {
        char commName[COMM_NAME_MAX_LENGTH] = {0};
        if (HcclGetCommName(comm, commName) != HCCL_SUCCESS) {
            printf("[ERROR] rank%u HcclGetCommName failed\n", deviceId);
            goto cleanup;
        }
        if (Mc2GetCcArgs(&ccArgs) != HCCL_SUCCESS ||
            SetCollectiveResourceArgs(ccArgs, commName, config) != HCCL_SUCCESS) {
            printf("[ERROR] rank%u configure MC2 resource failed\n", deviceId);
            goto cleanup;
        }
        if (Mc2AcquireCcResCtx(
                comm, static_cast<uint8_t>(GetCommandType(config.operation)), ccArgs, &opResCtx, &opResCtxSize,
                nullptr) != HCCL_SUCCESS) {
            printf("[ERROR] rank%u Mc2AcquireCcResCtx failed\n", deviceId);
            goto cleanup;
        }
        if (Mc2FreeCcArgs(ccArgs) != HCCL_SUCCESS) {
            printf("[ERROR] rank%u Mc2FreeCcArgs failed\n", deviceId);
            goto cleanup;
        }
        ccArgs = nullptr;
    }
    if (Mc2CcKernelLaunch(0, aicpuStream, opResCtx, opResCtxSize) != HCCL_SUCCESS) {
        printf("[ERROR] rank%u Mc2CcKernelLaunch failed\n", deviceId);
        goto cleanup;
    }

    PrintRankData("input", deviceId, local.input);
    collective_do(
        1, aicoreStream, reinterpret_cast<uint8_t*>(inputDev), reinterpret_cast<uint8_t*>(outputDev),
        reinterpret_cast<uint8_t*>(opResCtx), static_cast<uint32_t>(config.operation), count,
        static_cast<uint32_t>(config.dataType->type), static_cast<uint32_t>(config.reduceOp),
        reinterpret_cast<uint8_t*>(sendCountsDev), reinterpret_cast<uint8_t*>(sendDisplsDev),
        reinterpret_cast<uint8_t*>(recvCountsDev), reinterpret_cast<uint8_t*>(recvDisplsDev));
    if (aclrtSynchronizeStream(aicoreStream) != ACL_SUCCESS ||
        aclrtSynchronizeStream(aicpuStream) != ACL_SUCCESS) {
        printf("[ERROR] rank%u synchronize stream failed\n", deviceId);
        goto cleanup;
    }

    {
        std::vector<uint8_t> result(local.outputBytes, 0);
        if (!result.empty() &&
            aclrtMemcpy(result.data(), result.size(), outputDev, result.size(), ACL_MEMCPY_DEVICE_TO_HOST) !=
                ACL_SUCCESS) {
            printf("[ERROR] rank%u copy output failed\n", deviceId);
            goto cleanup;
        }
        PrintRankData("output", deviceId, result);
        if (!WriteRankOutput(config.outputDir, deviceId, result)) {
            goto cleanup;
        }
        std::vector<uint8_t> expected;
        if (!BuildExpected(config, rankSize, deviceId, ranks, expected) ||
            !VerifyOutput(deviceId, expected, result)) {
            printf("rank%u %s verify failed\n", deviceId, OperationName(config.operation));
            goto cleanup;
        }
        printf("rank%u %s verify pass\n", deviceId, OperationName(config.operation));
    }
    status = 0;

cleanup:
    if (ccArgs != nullptr) {
        (void)Mc2FreeCcArgs(ccArgs);
    }
    if (sendCountsDev != nullptr) {
        (void)aclrtFree(sendCountsDev);
    }
    if (sendDisplsDev != nullptr) {
        (void)aclrtFree(sendDisplsDev);
    }
    if (recvCountsDev != nullptr) {
        (void)aclrtFree(recvCountsDev);
    }
    if (recvDisplsDev != nullptr) {
        (void)aclrtFree(recvDisplsDev);
    }
    if (inputDev != nullptr) {
        (void)aclrtFree(inputDev);
    }
    if (outputDev != nullptr) {
        (void)aclrtFree(outputDev);
    }
    if (comm != nullptr) {
        (void)HcclCommDestroy(comm);
    }
    if (aicoreStream != nullptr) {
        (void)aclrtDestroyStream(aicoreStream);
    }
    if (aicpuStream != nullptr) {
        (void)aclrtDestroyStream(aicpuStream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(static_cast<int32_t>(deviceId));
    }
    return status;
}

int32_t main(int32_t argc, char* argv[])
{
    RunConfig config;
    if (!ParseArgs(argc, argv, config)) {
        return -1;
    }
    if (config.showHelp) {
        return 0;
    }
    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[ERROR] aclInit failed\n");
        return -1;
    }

    uint32_t devCount = 0;
    if (aclrtGetDeviceCount(&devCount) != ACL_SUCCESS || devCount == 0) {
        printf("[ERROR] no available device\n");
        (void)aclFinalize();
        return -1;
    }
    const uint32_t rankSize = devCount;
    std::vector<RankData> ranks;
    if (!LoadRankInputs(config, rankSize, ranks)) {
        (void)aclFinalize();
        return -1;
    }

    printf(
        "MC2 %s sample start, rankSize = %u, dataType = %s, reduceOp = %u\n", OperationName(config.operation),
        rankSize, config.dataType->name, static_cast<uint32_t>(config.reduceOp));
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        printf("[ERROR] set device 0 failed\n");
        (void)aclFinalize();
        return -1;
    }
    HcclRootInfo rootInfo;
    if (HcclGetRootInfo(&rootInfo) != HCCL_SUCCESS) {
        printf("[ERROR] HcclGetRootInfo failed\n");
        (void)aclrtResetDevice(0);
        (void)aclFinalize();
        return -1;
    }

    std::vector<std::thread> threads(rankSize);
    std::vector<int32_t> results(rankSize, -1);
    for (uint32_t rank = 0; rank < rankSize; ++rank) {
        threads[rank] = std::thread([rank, rankSize, &rootInfo, &config, &ranks, &results]() {
            results[rank] = RunCollective(rank, rankSize, &rootInfo, config, ranks);
        });
    }
    for (std::thread& thread : threads) {
        thread.join();
    }

    (void)aclrtResetDevice(0);
    (void)aclFinalize();
    for (int32_t result : results) {
        if (result != 0) {
            printf("MC2 %s sample failed\n", OperationName(config.operation));
            return -1;
        }
    }
    printf("MC2 %s sample pass\n", OperationName(config.operation));
    return 0;
}
