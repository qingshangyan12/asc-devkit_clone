/* !
 * \file all_gather_reduce_scatter.asc
 * \brief 纯通信AllGather+ReduceScatter复合样例的Device侧实现，不包含额外计算。
 *        AllGather与ReduceScatter分别为独立的核函数：单次分配的通信资源(OpResCtx)
 *        仅服务于一种通信命令，两级流水各自持有独立的通信上下文。
 *        数据类型不在Device侧写死，由Host侧--dtype指定的运行时参数传入。
 */

#include "kernel_operator.h"
#include "adv_api/hccl/hccl.h"

/* !
 * 每卡参与AllGather的元素个数sendCount，AllGather输出为sendCount * rankSize个元素，
 * 恰好等于ReduceScatter的输入规模(recvCount * rankSize，recvCount = sendCount)，
 * 因此AllGather输出可直接作为ReduceScatter输入，无需补齐或切分。
 */
constexpr uint64_t SEND_COUNT = 128;

/* !
 * AIV核上的纯AllGather通信流程，遵循HCCL客户端用法：
 * InitV2 -> AllGather(Prepare) -> Commit/Wait -> Finalize。
 * AllGather<true>表示Prepare时同步Commit通知服务端可执行；
 * 服务端为Mc2AicpuKernelLaunch下发的AICPU KFC server(Mc2ServerKernel)。
 * dataType为运行时参数，由Host侧根据用户指定的数据类型传入。
 */
__aicore__ inline void AllGatherStageCommunication(GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    // 1. 初始化HCCL客户端，context为Host侧Mc2AcquireCcResCtx返回的OpResCtx地址
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);
    // 2. 下发AllGather通信任务：每卡SEND_COUNT个dataType元素，按rankId顺序拼接到y，
    //    strideCount为0表示相邻rank数据块在y中连续存放
    AscendC::HcclHandle handleId =
        hccl.AllGather<true>(x, y, SEND_COUNT, static_cast<AscendC::HcclDataType>(dataType), 0);
    if (handleId < 0) {
        return;
    }
    // 3. 阻塞等待该handleId对应的通信任务执行完成
    hccl.Wait(handleId);
    // 全AIV核同步，防止部分核执行较快提前Finalize影响其他核Wait
    AscendC::SyncAll<true>();
    // 4. 通知服务端后续无通信任务，等待最后一个通信任务结束后退出
    hccl.Finalize();
}

/* !
 * AIV核上的纯ReduceScatter通信流程，遵循HCCL客户端用法：
 * InitV2 -> ReduceScatter(Prepare) -> Commit/Wait -> Finalize。
 * ReduceScatter<true>表示Prepare时同步Commit通知服务端可执行；
 * 服务端为Mc2AicpuKernelLaunch下发的AICPU KFC server(Mc2ServerKernel)。
 * 输入x为AllGather阶段输出，两级通信通过同一AICore stream的流序保证依赖。
 * dataType为运行时参数，由Host侧根据用户指定的数据类型传入。
 */
__aicore__ inline void ReduceScatterStageCommunication(GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    // 1. 初始化HCCL客户端，context为Host侧Mc2AcquireCcResCtx返回的OpResCtx地址
    AscendC::Hccl<> hccl;
    hccl.InitV2(mc2Context, nullptr);
    // 2. 下发ReduceScatter通信任务：各卡SEND_COUNT * rankSize个dataType元素按SUM归约后，
    //    按rankId均匀分散，每卡收到第rankId块；strideCount为0表示sendBuf中
    //    相邻rank数据块连续存放
    AscendC::HcclHandle handleId = hccl.ReduceScatter<true>(
        x, y, SEND_COUNT, static_cast<AscendC::HcclDataType>(dataType), AscendC::HcclReduceOp::HCCL_REDUCE_SUM, 0);
    if (handleId < 0) {
        return;
    }
    // 3. 阻塞等待该handleId对应的通信任务执行完成
    hccl.Wait(handleId);
    // 全AIV核同步，防止部分核执行较快提前Finalize影响其他核Wait
    AscendC::SyncAll<true>();
    // 4. 通知服务端后续无通信任务，等待最后一个通信任务结束后退出
    hccl.Finalize();
}

/* !
 * AllGather阶段核函数：x为输入GM地址，y为输出GM地址，mc2Context为通信上下文(OpResCtx)地址，
 * dataType为HcclDataType枚举值。
 * HCCL通信接口仅在AIV核上调用，AIC核直接返回。
 */
extern "C" __vector__ __global__ void all_gather_stage_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    if (g_coreType == AscendC::AIV) {
        AllGatherStageCommunication(x, y, mc2Context, dataType);
    }
}

/* !
 * ReduceScatter阶段核函数：x为AllGather阶段输出GM地址，y为最终输出GM地址，
 * mc2Context为通信上下文(OpResCtx)地址，dataType为HcclDataType枚举值。
 * HCCL通信接口仅在AIV核上调用，AIC核直接返回。
 */
extern "C" __vector__ __global__ void reduce_scatter_stage_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR mc2Context, uint32_t dataType)
{
    if (g_coreType == AscendC::AIV) {
        ReduceScatterStageCommunication(x, y, mc2Context, dataType);
    }
}

/* !
 * Host侧下发入口，Kernel直调场景使用<<<>>>内核调用符。
 * blockDim为启动的核数，需覆盖全部参与通信的AIV逻辑核。
 */
extern "C" void all_gather_stage_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t dataType)
{
    all_gather_stage_custom<<<blockDim, nullptr, stream>>>(x, y, mc2Context, dataType);
}

extern "C" void reduce_scatter_stage_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t dataType)
{
    reduce_scatter_stage_custom<<<blockDim, nullptr, stream>>>(x, y, mc2Context, dataType);
}
