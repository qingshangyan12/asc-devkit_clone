/* !
 * \file main.asc
 * \brief 纯通信AllGather+ReduceScatter复合样例的Host侧入口：初始化通信域后串行执行两级通信，
 *        每级分别分配通信资源，并通过独立stream分别下发AICPU KFC server和AICore核函数。
 *        AICPU stream展示A5 MC2 AICPU场景的另一种申请方式：先获取/申请unfold thread，
 *        再从thread资源中获取HCCL管理的stream。
 *        单次分配的通信资源(OpResCtx)仅服务于一种通信命令，AllGather与ReduceScatter
 *        各自持有独立的通信上下文，不能在同一上下文内混用。
 *        支持通过--dtype指定数据类型(默认fp16)，输入文件缺失时直接报错，不提供兜底数据。
 */

#include <algorithm>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <mutex>
#include <string>
#include <vector>
#include <thread>
#include <sys/stat.h>
#include <sys/types.h>

#include "acl/acl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_res.h"
#include "adv_api/hccl/hccl_common.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "../mc2_log_utils.h"

extern "C" HcclResult HcclGetNotifyNumInThread(
    HcclComm comm, ThreadHandle thread, CommEngine engine, uint32_t* notifyNum);

/* !
 * Device侧核函数的Host下发入口，定义在all_gather_reduce_scatter.asc中。
 * dataType为HcclDataType枚举值。
 */
extern "C" void all_gather_stage_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t dataType);
extern "C" void reduce_scatter_stage_do(
    uint32_t blockDim, void* stream, uint8_t* x, uint8_t* y, uint8_t* mc2Context, uint32_t dataType);

/* !
 * 每卡参与AllGather的元素个数sendCount，AllGather输出为sendCount * rankSize个元素，
 * 直接作为ReduceScatter输入，ReduceScatter输出为sendCount个元素。
 */
constexpr uint32_t SEND_COUNT = 128;
/* !
 * AICPU_TS引擎编号(OpExecuteConfig::AICPU_TS = 2)，表示通信任务由AICPU上的KFC server执行，
 * 与Host侧Mc2AicpuKernelLaunch下发的Mc2ServerKernel配套。
 */
constexpr uint8_t MC2_COMM_ENGINE_AICPU_TS = 2;
/* !
 * 打印输入/输出时最多展示的元素个数，避免刷屏。
 */
constexpr uint64_t PRINT_MAX_COUNT = 32;

/* !
 * 数据类型描述：命令行名称、HCCL数据类型枚举与元素字节大小。
 * 复合样例包含ReduceScatter的SUM归约，仅支持下列类型，不支持fp8/uint等类型。
 */
struct DtypeDesc {
    const char* name;
    AscendC::HcclDataType dataType;
    uint32_t size;
};

static const DtypeDesc DTYPE_TABLE[] = {
    {"int8", AscendC::HcclDataType::HCCL_DATA_TYPE_INT8, 1},
    {"int16", AscendC::HcclDataType::HCCL_DATA_TYPE_INT16, 2},
    {"int32", AscendC::HcclDataType::HCCL_DATA_TYPE_INT32, 4},
    {"fp16", AscendC::HcclDataType::HCCL_DATA_TYPE_FP16, 2},
    {"fp32", AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, 4},
    {"bf16", AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16, 2},
};

static std::mutex gPrintMutex;

static const DtypeDesc* FindDtypeByName(const char* name)
{
    for (const DtypeDesc& dtype : DTYPE_TABLE) {
        if (std::strcmp(dtype.name, name) == 0) {
            return &dtype;
        }
    }
    return nullptr;
}

static void PrintUsage(const char* program)
{
    printf("usage: %s [--dtype <name>]\n", program);
    printf("       supported dtype:");
    for (const DtypeDesc& dtype : DTYPE_TABLE) {
        printf(" %s", dtype.name);
    }
    printf(" (default fp16)\n");
    printf("       input file:  ./input/<rank>/x1.bin, size must be %u elements\n", SEND_COUNT);
}

/* !
 * 半精度浮点(FP16)/脑浮点(BF16)与单精度浮点(FP32)按IEEE 754位模式转换，用于打印和真值计算。
 */
static float HalfToFloat(uint16_t h)
{
    const uint32_t sign = static_cast<uint32_t>(h & 0x8000U) << 16;
    const uint32_t exp = (h >> 10) & 0x1FU;
    const uint32_t frac = h & 0x3FFU;
    if (exp == 0) {
        if (frac == 0) {
            return sign == 0U ? 0.0F : -0.0F;
        }
        // 非规格化数：value = frac * 2^-24
        uint32_t msb = 0;
        while (((frac >> msb) & 1U) == 0U) {
            msb++;
        }
        const uint32_t e = 103U + msb;
        const uint32_t mant = (frac << (23U - msb)) & 0x7FFFFFU;
        uint32_t bits = sign | (e << 23) | mant;
        float out = 0.0F;
        std::memcpy(&out, &bits, sizeof(out));
        return out;
    }
    if (exp == 0x1FU) {
        const uint32_t bits = sign | 0x7F800000U | (frac << 13);
        float out = 0.0F;
        std::memcpy(&out, &bits, sizeof(out));
        return out;
    }
    const uint32_t bits = sign | ((exp + 112U) << 23) | (frac << 13);
    float out = 0.0F;
    std::memcpy(&out, &bits, sizeof(out));
    return out;
}

static uint16_t FloatToHalf(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    const uint32_t sign = (bits >> 16) & 0x8000U;
    const uint32_t exp = (bits >> 23) & 0xFFU;
    const uint32_t frac = bits & 0x7FFFFFU;
    if (exp == 0xFFU) {
        // Inf/NaN
        return static_cast<uint16_t>(sign | 0x7C00U | ((frac != 0U) ? (0x200U | (frac >> 13)) : 0U));
    }
    const int32_t halfExp = static_cast<int32_t>(exp) - 127 + 15;
    if (halfExp >= 0x1F) {
        return static_cast<uint16_t>(sign | 0x7C00U);
    }
    if (halfExp <= 0) {
        if (halfExp < -10) {
            return static_cast<uint16_t>(sign);
        }
        // 非规格化数：携带隐含1后右移，按就近偶数舍入
        const uint32_t mant = frac | 0x800000U;
        const uint32_t shift = static_cast<uint32_t>(14 - halfExp);
        uint32_t sub = mant >> shift;
        const uint32_t rem = mant & ((1U << shift) - 1U);
        const uint32_t halfWay = 1U << (shift - 1U);
        if (rem > halfWay || (rem == halfWay && (sub & 1U) != 0U)) {
            sub += 1U;
        }
        return static_cast<uint16_t>(sign | sub);
    }
    uint32_t out = (static_cast<uint32_t>(halfExp) << 10) | (frac >> 13);
    const uint32_t rem = frac & 0x1FFFU;
    if (rem > 0x1000U || (rem == 0x1000U && ((frac >> 13) & 1U) != 0U)) {
        out += 1U;
    }
    return static_cast<uint16_t>(sign | out);
}

static float Bfloat16ToFloat(uint16_t b)
{
    const uint32_t bits = static_cast<uint32_t>(b) << 16;
    float out = 0.0F;
    std::memcpy(&out, &bits, sizeof(out));
    return out;
}

static uint16_t FloatToBfloat16(float value)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    // 截断高16位并按就近偶数舍入
    const uint32_t rounded = bits + 0x7FFFU + ((bits >> 16) & 1U);
    return static_cast<uint16_t>(rounded >> 16);
}

static std::string GetRankInputPath(uint32_t rank)
{
    return "./input/" + std::to_string(rank) + "/x1.bin";
}

static std::string GetRankOutputPath(uint32_t rank)
{
    return "./output/" + std::to_string(rank) + "/output_npu.bin";
}

static bool GetFileSize(const std::string& filePath, uint64_t& fileSize)
{
    std::ifstream file(filePath, std::ios::binary);
    if (!file.is_open()) {
        return false;
    }
    file.seekg(0, std::ios::end);
    const std::streamsize size = file.tellg();
    if (size < 0) {
        return false;
    }
    fileSize = static_cast<uint64_t>(size);
    return true;
}

/* !
 * 读取指定rank的输入文件，data的大小即期望的文件字节数。
 * 输入文件为必选项，读取失败直接报错，不提供兜底数据。
 */
static bool ReadRankInput(uint32_t rank, std::vector<uint8_t>& data)
{
    const std::string filePath = GetRankInputPath(rank);
    std::ifstream file(filePath, std::ios::binary);
    if (!file.is_open()) {
        printf("[ERROR] rank%u input file not found: %s, generate it via scripts/gen_data.py first\n", rank,
            filePath.c_str());
        return false;
    }
    file.seekg(0, std::ios::end);
    const std::streamsize fileSize = file.tellg();
    const std::streamsize expectSize = static_cast<std::streamsize>(data.size());
    if (fileSize != expectSize) {
        printf("[ERROR] rank%u input file size invalid: %s, expect %ld, got %ld\n", rank, filePath.c_str(),
            static_cast<long>(expectSize), static_cast<long>(fileSize));
        return false;
    }
    file.seekg(0, std::ios::beg);
    file.read(reinterpret_cast<char*>(data.data()), expectSize);
    if (!file.good()) {
        printf("[ERROR] rank%u read input file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    return true;
}

static bool WriteRankOutput(uint32_t rank, const std::vector<uint8_t>& data)
{
    (void)mkdir("./output", S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string cardDir = "./output/" + std::to_string(rank);
    (void)mkdir(cardDir.c_str(), S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH);
    const std::string filePath = GetRankOutputPath(rank);
    std::ofstream file(filePath, std::ios::binary | std::ios::trunc);
    if (!file.is_open()) {
        printf("[ERROR] rank%u open output file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    file.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
    if (!file.good()) {
        printf("[ERROR] rank%u write output file failed: %s\n", rank, filePath.c_str());
        return false;
    }
    return true;
}

static void PrintOneElement(const uint8_t* elem, const DtypeDesc& dtype)
{
    switch (dtype.dataType) {
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT8:
            printf(" %d", static_cast<int32_t>(*reinterpret_cast<const int8_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT16:
            printf(" %d", static_cast<int32_t>(*reinterpret_cast<const int16_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT32:
            printf(" %d", *reinterpret_cast<const int32_t*>(elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP16:
            printf(" %g", HalfToFloat(*reinterpret_cast<const uint16_t*>(elem)));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP32:
            printf(" %g", *reinterpret_cast<const float*>(elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16:
            printf(" %g", Bfloat16ToFloat(*reinterpret_cast<const uint16_t*>(elem)));
            break;
        default:
            printf(" ?");
            break;
    }
}

static void PrintRankData(
    const char* tag, uint32_t rank, const std::vector<uint8_t>& data, uint64_t elemCount, const DtypeDesc& dtype)
{
    if (rank > 1U) {
        return;
    }
    std::lock_guard<std::mutex> lock(gPrintMutex);
    printf("%s rank%u:", tag, rank);
    const uint64_t printCount = std::min<uint64_t>(elemCount, PRINT_MAX_COUNT);
    for (uint64_t i = 0; i < printCount; i++) {
        PrintOneElement(data.data() + i * dtype.size, dtype);
    }
    if (elemCount > printCount) {
        printf(" ...");
    }
    printf("\n");
}

#define ACL_CHECK(ret)                                                             \
    do {                                                                           \
        aclError aclRet = (ret);                                                   \
        if (aclRet != ACL_SUCCESS) {                                               \
            printf("[ERROR] %s:%d ret=%d\n", __FILE__, __LINE__, (int32_t)aclRet); \
            return -1;                                                             \
        }                                                                          \
    } while (0)

#define HCCL_CHECK(ret)                                                             \
    do {                                                                            \
        HcclResult hcclRet = (ret);                                                 \
        if (hcclRet != HCCL_SUCCESS) {                                              \
            printf("[ERROR] %s:%d ret=%d\n", __FILE__, __LINE__, (int32_t)hcclRet); \
            return -1;                                                              \
        }                                                                           \
    } while (0)

/* !
 * 读取一个输入元素并累加：整数类型累加到intSum，浮点类型经FP32解码后累加到floatSum。
 */
static void AccumulateElement(const uint8_t* elem, const DtypeDesc& dtype, int64_t& intSum, double& floatSum)
{
    switch (dtype.dataType) {
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT8:
            intSum += *reinterpret_cast<const int8_t*>(elem);
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT16:
            intSum += *reinterpret_cast<const int16_t*>(elem);
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT32:
            intSum += *reinterpret_cast<const int32_t*>(elem);
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP16:
            floatSum += HalfToFloat(*reinterpret_cast<const uint16_t*>(elem));
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP32:
            floatSum += *reinterpret_cast<const float*>(elem);
            break;
        case AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16:
            floatSum += Bfloat16ToFloat(*reinterpret_cast<const uint16_t*>(elem));
            break;
        default:
            break;
    }
}

/* !
 * 将归约结果编码为期望输出元素：整数类型按补码回绕截断，浮点类型按舍入转换为对应格式。
 * 样例数据均为小整数：fp16/fp32求和精确；bf16取值较小，任意归约顺序下部分和均不超过256，
 * bf16求和同样精确，真值与NPU的归约顺序无关。
 */
static void EncodeGoldenElement(uint8_t* dst, const DtypeDesc& dtype, int64_t intSum, double floatSum)
{
    switch (dtype.dataType) {
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT8: {
            const uint8_t v = static_cast<uint8_t>(static_cast<uint64_t>(intSum));
            std::memcpy(dst, &v, sizeof(v));
            break;
        }
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT16: {
            const uint16_t v = static_cast<uint16_t>(static_cast<uint64_t>(intSum));
            std::memcpy(dst, &v, sizeof(v));
            break;
        }
        case AscendC::HcclDataType::HCCL_DATA_TYPE_INT32: {
            const uint32_t v = static_cast<uint32_t>(static_cast<uint64_t>(intSum));
            std::memcpy(dst, &v, sizeof(v));
            break;
        }
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP16: {
            const uint16_t v = FloatToHalf(static_cast<float>(floatSum));
            std::memcpy(dst, &v, sizeof(v));
            break;
        }
        case AscendC::HcclDataType::HCCL_DATA_TYPE_FP32: {
            const float v = static_cast<float>(floatSum);
            std::memcpy(dst, &v, sizeof(v));
            break;
        }
        case AscendC::HcclDataType::HCCL_DATA_TYPE_BFP16: {
            const uint16_t v = FloatToBfloat16(static_cast<float>(floatSum));
            std::memcpy(dst, &v, sizeof(v));
            break;
        }
        default:
            break;
    }
}

static HcclResult AcquireUnfoldThread(HcclComm comm, ThreadHandle* thread)
{
    constexpr uint32_t UNFOLD_THREAD_NUM = 1U;
    constexpr uint16_t NOTIFY_NUM_PER_THREAD = 2U;

    ThreadConfig config;
    HcommResult initRet = ThreadConfigInit(&config, UNFOLD_THREAD_NUM);
    if (initRet != 0) {
        printf("[ERROR] ThreadConfigInit failed, ret=%d\n", initRet);
        return HCCL_E_INTERNAL;
    }
    config.notifyNumPerThread = NOTIFY_NUM_PER_THREAD;

    return HcclThreadAcquireWithConfig(comm, COMM_ENGINE_CPU, UNFOLD_THREAD_NUM, THREAD_TYPE_TS, &config, thread);
}

static HcclResult FillUnfoldCtxTag(HcclComm comm, char* unfoldCtxTag, size_t unfoldCtxTagSize)
{
    char commName[COMM_NAME_MAX_LENGTH] = {0};
    HcclResult ret = HcclGetCommName(comm, commName);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    int32_t len = snprintf(unfoldCtxTag, unfoldCtxTagSize, "%s_unfold", commName);
    if (len <= 0 || static_cast<size_t>(len) >= unfoldCtxTagSize) {
        printf("[ERROR] fill unfoldCtxTag failed, commName=%s\n", commName);
        return HCCL_E_INTERNAL;
    }
    return HCCL_SUCCESS;
}

static HcclResult SaveUnfoldThread(HcclComm comm, const char* unfoldCtxTag, ThreadHandle thread)
{
    void* ctx = nullptr;
    HcclResult ret = HcclEngineCtxCreate(comm, unfoldCtxTag, COMM_ENGINE_CPU_TS, sizeof(ThreadHandle), &ctx);
    if (ret != HCCL_SUCCESS || ctx == nullptr) {
        printf("[ERROR] HcclEngineCtxCreate failed, ret=%d, ctx=%p\n", static_cast<int32_t>(ret), ctx);
        return ret != HCCL_SUCCESS ? ret : HCCL_E_PTR;
    }

    *static_cast<ThreadHandle*>(ctx) = thread;
    return HCCL_SUCCESS;
}

static HcclResult GetUnfoldThread(HcclComm comm, ThreadHandle* thread)
{
    constexpr uint32_t UNFOLD_CTX_TAG_MAX_LENGTH = COMM_NAME_MAX_LENGTH + 16U;

    char unfoldCtxTag[UNFOLD_CTX_TAG_MAX_LENGTH] = {0};
    HcclResult ret = FillUnfoldCtxTag(comm, unfoldCtxTag, sizeof(unfoldCtxTag));
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    void* ctx = nullptr;
    uint64_t size = sizeof(ThreadHandle);
    ret = HcclEngineCtxGet(comm, unfoldCtxTag, COMM_ENGINE_CPU_TS, &ctx, &size);
    if (ret == HCCL_SUCCESS && ctx != nullptr) {
        *thread = *static_cast<ThreadHandle*>(ctx);

        uint32_t notifyNum = 0U;
        HcclResult notifyRet = HcclGetNotifyNumInThread(comm, *thread, COMM_ENGINE_CPU_TS, &notifyNum);
        if (notifyRet == HCCL_SUCCESS && notifyNum != 0U) {
            return HCCL_SUCCESS;
        }

        // A5 MC2 AICPU场景需要thread级notify；旧ctx中的unfold thread若没有notify槽位，则复用原线程补齐。
        ret = AcquireUnfoldThread(comm, thread);
        if (ret != HCCL_SUCCESS) {
            return ret;
        }
        *static_cast<ThreadHandle*>(ctx) = *thread;
        return HCCL_SUCCESS;
    }

    ret = AcquireUnfoldThread(comm, thread);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    return SaveUnfoldThread(comm, unfoldCtxTag, *thread);
}

static HcclResult AcquireAicpuStreamByUnfoldThread(HcclComm comm, aclrtStream* aicpuStream)
{
    ThreadHandle unfoldThread = 0U;
    HcclResult ret = GetUnfoldThread(comm, &unfoldThread);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    void* stream = nullptr;
    ret = HcclThreadResGetInfo(comm, unfoldThread, THREAD_RES_TYPE_STREAM, sizeof(void*), &stream);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    *aicpuStream = static_cast<aclrtStream>(stream);
    printf("acquire AICPU stream by unfold thread, thread=%lu, stream=%p\n", unfoldThread, *aicpuStream);
    return HCCL_SUCCESS;
}

/* !
 * 单个rank上的AllGather+ReduceScatter复合执行流程：
 * 1. 阶段一(AllGather)：Mc2AcquireCcResCtx按HCCL_CMD_ALLGATHER分配通信资源得到OpResCtx，
 *    Mc2AicpuKernelLaunch下发AICPU KFC server，AICore核函数经Hccl客户端下发AllGather任务，
 *    输出sendCount * rankSize个元素写入gatherDev；
 * 2. 阶段二(ReduceScatter)：按HCCL_CMD_REDUCE_SCATTER重新分配通信资源并下发第二个server，
 *    AICore核函数以gatherDev为输入下发ReduceScatter任务，两级核函数在同一AICore stream上
 *    顺序执行，流序保证AllGather输出先于ReduceScatter输入生效；
 * 3. 回读两级输出并逐级校验。数据类型以运行时参数传入，Device侧不写死数据规格。
 */
static int32_t RunCompositeCommunication(
    uint32_t deviceId, uint32_t rankSize, HcclRootInfo* rootInfo, const DtypeDesc& dtype)
{
    ACL_CHECK(aclrtSetDevice(static_cast<int32_t>(deviceId)));

    // 初始化HCCL通信域，所有rank使用同一份rootInfo
    HcclComm comm = nullptr;
    HCCL_CHECK(HcclCommInitRootInfo(rankSize, rootInfo, deviceId, &comm));

    char commName[COMM_NAME_MAX_LENGTH] = {0};
    HCCL_CHECK(HcclGetCommName(comm, commName));

    // AICPU KFC server会阻塞等待AICore client消息，不能与AICore kernel使用同一条stream。
    // 这里展示另一种申请方式：参考A5 MC2 AICPU场景，先从通信域获取/申请unfold thread，
    // 再通过HcclThreadResGetInfo取出HCCL管理的AICPU stream。
    aclrtStream aicpuStream = nullptr;
    aclrtStream aicoreStream = nullptr;
    HCCL_CHECK(AcquireAicpuStreamByUnfoldThread(comm, &aicpuStream));
    ACL_CHECK(aclrtCreateStream(&aicoreStream));

    const uint64_t gatherElems = static_cast<uint64_t>(SEND_COUNT) * rankSize;
    const size_t inputSize = static_cast<size_t>(SEND_COUNT) * dtype.size;
    const size_t gatherSize = static_cast<size_t>(gatherElems) * dtype.size;

    // 申请Device内存并从输入文件读取数据，输入文件由scripts/gen_data.py生成，缺失时直接报错。
    // gatherDev同时作为AllGather输出和ReduceScatter输入。
    void* inputDev = nullptr;
    void* gatherDev = nullptr;
    void* outputDev = nullptr;
    ACL_CHECK(aclrtMalloc(&inputDev, inputSize, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&gatherDev, gatherSize, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&outputDev, inputSize, ACL_MEM_MALLOC_HUGE_FIRST));

    std::vector<uint8_t> inputBuff(inputSize, 0);
    if (!ReadRankInput(deviceId, inputBuff)) {
        return -1;
    }
    PrintRankData("input", deviceId, inputBuff, SEND_COUNT, dtype);
    ACL_CHECK(aclrtMemcpy(inputDev, inputSize, inputBuff.data(), inputSize, ACL_MEMCPY_HOST_TO_DEVICE));

    // ============================================================
    // STEP 1: 阶段一，按HCCL_CMD_ALLGATHER分配通信资源并执行AllGather
    // 返回Device侧OpResCtx地址，既是Mc2AicpuKernelLaunch的下发参数，
    // 也是Device侧Hccl客户端InitV2的context参数。
    // ============================================================
    {
        void* ccArgs = nullptr;
        char algConfig[] = "AllGather=level0:doublering";
        void* agCtx = nullptr;
        uint32_t agCtxSize = 0;
        HCCL_CHECK(Mc2GetCcArgs(&ccArgs));
        HCCL_CHECK(Mc2SetCcGroupName(ccArgs, commName));
        HCCL_CHECK(Mc2SetCcAlgConfig(ccArgs, algConfig));
        HCCL_CHECK(Mc2SetCcSrcDataType(ccArgs, static_cast<uint8_t>(dtype.dataType)));
        HCCL_CHECK(Mc2SetCcDstDataType(ccArgs, static_cast<uint8_t>(dtype.dataType)));
        HCCL_CHECK(Mc2SetCcCommEngine(ccArgs, MC2_COMM_ENGINE_AICPU_TS));
        HCCL_CHECK(Mc2AcquireCcResCtx(comm, static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER), ccArgs,
            &agCtx, &agCtxSize));
        HCCL_CHECK(Mc2FreeCcArgs(ccArgs));

        // 下发AICPU KFC server内核(Mc2ServerKernel)，阻塞等待AllGather阶段client消息
        HCCL_CHECK(Mc2AicpuKernelLaunch(0, aicpuStream, agCtx, agCtxSize));

        // 下发AllGather阶段AICore核函数，输出sendCount * rankSize个元素到gatherDev；
        // dataType为运行时参数，来自用户指定的数据类型
        all_gather_stage_do(1, aicoreStream, reinterpret_cast<uint8_t*>(inputDev),
            reinterpret_cast<uint8_t*>(gatherDev), reinterpret_cast<uint8_t*>(agCtx),
            static_cast<uint32_t>(dtype.dataType));

        // 先等待AICore client完成，再等待收到Finalize消息后退出的AICPU server
        ACL_CHECK(aclrtSynchronizeStream(aicoreStream));
        ACL_CHECK(aclrtSynchronizeStream(aicpuStream));
    }

    // ============================================================
    // STEP 2: 阶段二，按HCCL_CMD_REDUCE_SCATTER重新分配通信资源并执行ReduceScatter
    // AllGather与ReduceScatter不能共用同一OpResCtx，须独立申请；
    // 两级核函数在同一aicoreStream上顺序执行，流序保证gatherDev数据依赖。
    // ============================================================
    {
        void* ccArgs = nullptr;
        char algConfig[] = "ReduceScatter=level0:doublering";
        void* rsCtx = nullptr;
        uint32_t rsCtxSize = 0;
        HCCL_CHECK(Mc2GetCcArgs(&ccArgs));
        HCCL_CHECK(Mc2SetCcGroupName(ccArgs, commName));
        HCCL_CHECK(Mc2SetCcAlgConfig(ccArgs, algConfig));
        HCCL_CHECK(Mc2SetCcSrcDataType(ccArgs, static_cast<uint8_t>(dtype.dataType)));
        HCCL_CHECK(Mc2SetCcDstDataType(ccArgs, static_cast<uint8_t>(dtype.dataType)));
        HCCL_CHECK(Mc2SetCcReduceType(ccArgs, AscendC::HcclReduceOp::HCCL_REDUCE_SUM));
        HCCL_CHECK(Mc2SetCcCommEngine(ccArgs, MC2_COMM_ENGINE_AICPU_TS));
        HCCL_CHECK(Mc2AcquireCcResCtx(comm, static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_REDUCE_SCATTER),
            ccArgs, &rsCtx, &rsCtxSize));
        HCCL_CHECK(Mc2FreeCcArgs(ccArgs));

        // 下发第二个AICPU KFC server内核，阻塞等待ReduceScatter阶段client消息
        HCCL_CHECK(Mc2AicpuKernelLaunch(0, aicpuStream, rsCtx, rsCtxSize));

        // 下发ReduceScatter阶段AICore核函数，输入为AllGather输出gatherDev；
        // dataType为运行时参数，来自用户指定的数据类型
        reduce_scatter_stage_do(1, aicoreStream, reinterpret_cast<uint8_t*>(gatherDev),
            reinterpret_cast<uint8_t*>(outputDev), reinterpret_cast<uint8_t*>(rsCtx),
            static_cast<uint32_t>(dtype.dataType));

        // 先等待AICore client完成，再等待收到Finalize消息后退出的AICPU server
        ACL_CHECK(aclrtSynchronizeStream(aicoreStream));
        ACL_CHECK(aclrtSynchronizeStream(aicpuStream));
    }

    // ============================================================
    // STEP 3: 回读并逐级校验通信结果，Device侧不执行额外计算
    // ============================================================
    std::vector<uint8_t> gatherResult(gatherSize, 0);
    ACL_CHECK(aclrtMemcpy(gatherResult.data(), gatherSize, gatherDev, gatherSize, ACL_MEMCPY_DEVICE_TO_HOST));
    PrintRankData("allgather output", deviceId, gatherResult, gatherElems, dtype);

    std::vector<uint8_t> result(inputSize, 0);
    ACL_CHECK(aclrtMemcpy(result.data(), inputSize, outputDev, inputSize, ACL_MEMCPY_DEVICE_TO_HOST));
    PrintRankData("reducescatter output", deviceId, result, SEND_COUNT, dtype);
    if (!WriteRankOutput(deviceId, result)) {
        return -1;
    }

    // 加载所有rank输入，用于两级结果的期望值计算
    std::vector<std::vector<uint8_t>> inputs(rankSize);
    bool loadOk = true;
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        inputs[rank].resize(inputSize, 0);
        if (!ReadRankInput(rank, inputs[rank])) {
            loadOk = false;
            break;
        }
    }

    // 阶段一校验，按AllGather语义：gatherResult[rank * sendCount + i] == x_rank[i]，
    // AllGather为纯数据搬运，逐字节比较
    bool gatherOk = loadOk;
    if (loadOk) {
        const size_t blockBytes = static_cast<size_t>(SEND_COUNT) * dtype.size;
        for (uint32_t rank = 0; rank < rankSize; rank++) {
            if (std::memcmp(gatherResult.data() + static_cast<size_t>(rank) * blockBytes, inputs[rank].data(),
                blockBytes) != 0) {
                gatherOk = false;
                for (uint64_t i = 0; i < blockBytes; i++) {
                    const uint8_t actual = gatherResult[static_cast<size_t>(rank) * blockBytes + i];
                    const uint8_t expect = inputs[rank][i];
                    if (actual != expect) {
                        printf("[ERROR] rank%u AllGather verify failed at block [%u] byte %llu, got %u, expect %u\n",
                            deviceId, rank, static_cast<unsigned long long>(i), actual, expect);
                        break;
                    }
                }
            }
        }
    }
    printf("rank%u AllGather stage verify %s\n", deviceId, gatherOk ? "pass" : "failed");

    // 阶段二校验，按ReduceScatter语义：y[i] = sum_rank(rsInput_rank[rankId * sendCount + i])，
    // 复合场景下各rank的rsInput均为AllGather输出且内容一致，第rankId块为x_rankId，
    // 故期望值等价于rankSize份x_rankId[i]求和：y[i] = rankSize * x_rankId[i]
    bool scatterOk = loadOk;
    if (loadOk) {
        std::vector<uint8_t> golden(inputSize, 0);
        for (uint32_t i = 0; i < SEND_COUNT; i++) {
            int64_t intSum = 0;
            double floatSum = 0.0;
            for (uint32_t rank = 0; rank < rankSize; rank++) {
                AccumulateElement(inputs[deviceId].data() + static_cast<size_t>(i) * dtype.size, dtype, intSum,
                    floatSum);
            }
            EncodeGoldenElement(golden.data() + static_cast<size_t>(i) * dtype.size, dtype, intSum, floatSum);
        }
        uint32_t errorCount = 0;
        for (uint32_t i = 0; i < SEND_COUNT; i++) {
            const uint8_t* actual = result.data() + static_cast<size_t>(i) * dtype.size;
            const uint8_t* expect = golden.data() + static_cast<size_t>(i) * dtype.size;
            if (std::memcmp(actual, expect, dtype.size) != 0) {
                scatterOk = false;
                if (errorCount < 10U) {
                    printf("[ERROR] rank%u ReduceScatter verify failed at [%u], got %u, expect %u\n", deviceId, i,
                        *actual, *expect);
                }
                errorCount++;
            }
        }
        if (errorCount > 10U) {
            printf("[ERROR] rank%u total mismatch count: %u / %u\n", deviceId, errorCount, SEND_COUNT);
        }
    }
    printf("rank%u ReduceScatter stage verify %s\n", deviceId, scatterOk ? "pass" : "failed");

    // 释放资源
    ACL_CHECK(aclrtFree(inputDev));
    ACL_CHECK(aclrtFree(gatherDev));
    ACL_CHECK(aclrtFree(outputDev));
    // aicpuStream由HcclThreadAcquireWithConfig申请，所有权属于HCCL/HCOMM；
    // HcclThreadResGetInfo只返回借用句柄，不能调用aclrtDestroyStream。
    // HcclCommDestroy释放通信域及其CommEngineResMgr/ThreadMgr时，由thread持有的Stream自动析构。
    HCCL_CHECK(HcclCommDestroy(comm));
    ACL_CHECK(aclrtDestroyStream(aicoreStream));
    ACL_CHECK(aclrtResetDevice(static_cast<int32_t>(deviceId)));
    return (gatherOk && scatterOk) ? 0 : -1;
}

/* !
 * 主入口：与HCCL集合通信样例一致，使用单进程多线程模拟多rank场景，
 * 每个线程绑定一个Device并初始化通信域后并发执行AllGather+ReduceScatter复合流程。
 * 支持通过--dtype指定数据类型(默认fp16)；输入文件为必选项，缺失或大小
 * 不符时直接报错退出，不提供兜底数据。
 */
int32_t main(int32_t argc, char* argv[])
{
    const DtypeDesc* dtype = nullptr;
    for (int32_t i = 1; i < argc; i++) {
        if (std::strcmp(argv[i], "--dtype") == 0 && i + 1 < argc) {
            dtype = FindDtypeByName(argv[i + 1]);
            if (dtype == nullptr) {
                printf("[ERROR] unsupported dtype: %s\n", argv[i + 1]);
                PrintUsage(argv[0]);
                return -1;
            }
            i++;
        } else {
            printf("[ERROR] invalid arguments\n");
            PrintUsage(argv[0]);
            return -1;
        }
    }
    if (dtype == nullptr) {
        dtype = FindDtypeByName("fp16");
    }

    if (!Mc2LogUtils::ClearAscendProcessLogPath()) {
        return -1;
    }
    ACL_CHECK(aclInit(nullptr));

    uint32_t devCount = 0;
    ACL_CHECK(aclrtGetDeviceCount(&devCount));
    if (devCount < 1) {
        printf("[ERROR] no available device\n");
        return -1;
    }
    const uint32_t rankSize = devCount;

    // 预检所有rank的输入文件：必须存在且大小为SEND_COUNT个元素，
    // 缺失时直接报错退出，避免部分rank无法参与集合通信导致其他rank阻塞
    const uint64_t expectFileSize = static_cast<uint64_t>(SEND_COUNT) * dtype->size;
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        uint64_t fileSize = 0;
        if (!GetFileSize(GetRankInputPath(rank), fileSize)) {
            printf("[ERROR] rank%u input file not found: %s, generate it via scripts/gen_data.py first\n", rank,
                GetRankInputPath(rank).c_str());
            return -1;
        }
        if (fileSize != expectFileSize) {
            printf("[ERROR] rank%u input file size %llu invalid, expect %llu bytes (%u * %s)\n", rank,
                static_cast<unsigned long long>(fileSize), static_cast<unsigned long long>(expectFileSize),
                SEND_COUNT, dtype->name);
            return -1;
        }
    }
    printf("AllGather+ReduceScatter composite sample start, rankSize = %u, dtype = %s, sendCount = %u\n", rankSize,
        dtype->name, SEND_COUNT);

    // rank0生成rootInfo，所有rank共享
    ACL_CHECK(aclrtSetDevice(0));
    HcclRootInfo rootInfo;
    HCCL_CHECK(HcclGetRootInfo(&rootInfo));

    std::vector<std::thread> threads(rankSize);
    std::vector<int32_t> results(rankSize, -1);
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        threads[rank] = std::thread([rank, rankSize, &rootInfo, &results, dtype]() {
            results[rank] = RunCompositeCommunication(rank, rankSize, &rootInfo, *dtype);
        });
    }
    for (uint32_t rank = 0; rank < rankSize; rank++) {
        threads[rank].join();
    }

    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());

    for (uint32_t rank = 0; rank < rankSize; rank++) {
        if (results[rank] != 0) {
            printf("AllGather+ReduceScatter composite sample failed\n");
            return -1;
        }
    }
    printf("AllGather+ReduceScatter composite sample pass\n");
    return 0;
}
