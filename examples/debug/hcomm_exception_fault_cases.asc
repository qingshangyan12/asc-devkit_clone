#include "kernel_operator.h"
#include "acl/acl.h"
#include "adv_api/hcomm/hcomm.h"
#include "hcomm_exception_fault_cases.h"

using namespace AscendC;

#define EXPORT_AIV_META_INFO(kernel_name) \
static const struct FunLevelKType kernel_name##_kernel_type_section __attribute__ \
((used, section (".ascend.meta." #kernel_name))) \
= {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}}

namespace {
constexpr uint32_t HCOMM_WORKSPACE_LEN = 512;
constexpr uint32_t HCOMM_DFX_DEFAULT_QP_IDX = 0;
constexpr uint32_t HCOMM_CQE_FAKE_STATUS = 0x5U;
constexpr uint32_t HCOMM_CQE_FAKE_SUBSTATUS = 0x12U;
constexpr uint32_t HCOMM_CQE_STAGE_ENTER = 1;
constexpr uint32_t HCOMM_CQE_STAGE_AFTER_INIT = 2;
constexpr uint32_t HCOMM_CQE_STAGE_BEFORE_WRITE = 3;
constexpr uint32_t HCOMM_CQE_STAGE_AFTER_WRITE = 4;
constexpr uint32_t HCOMM_CQE_STAGE_BEFORE_SNAPSHOT = 5;
constexpr uint32_t HCOMM_CQE_STAGE_AFTER_SNAPSHOT = 6;
constexpr uint32_t HCOMM_CQE_STAGE_AFTER_SEED_CQE = 7;
constexpr uint32_t HCOMM_CQE_STAGE_BEFORE_TRIGGER = 8;
constexpr uint32_t HCOMM_CQE_STAGE_AFTER_TRIGGER = 9;

__aicore__ inline uint32_t LoadU32(uint64_t addr)
{
    if (addr == 0) {
        return 0;
    }
    return static_cast<uint32_t>(ld_dev(reinterpret_cast<__gm__ uint32_t *>(addr), 0));
}

__aicore__ inline void StoreU32(uint64_t addr, uint32_t value)
{
    st_dev(value, reinterpret_cast<__gm__ uint32_t *>(addr), 0);
}

__aicore__ inline void SnapshotQueueDw(uint64_t addr, __gm__ uint32_t *dst)
{
    if (addr == 0 || dst == nullptr) {
        return;
    }
    dst[0] = LoadU32(addr);
    dst[1] = LoadU32(addr + 1U * sizeof(uint32_t));
    dst[2] = LoadU32(addr + 2U * sizeof(uint32_t));
    dst[3] = LoadU32(addr + 3U * sizeof(uint32_t));
}

__aicore__ inline void SnapshotChannelState(__gm__ CommContext *ctx, ChannelHandle channel, bool afterDrain)
{
    __gm__ ChannelEntity *channelEntity = reinterpret_cast<__gm__ ChannelEntity *>(channel);
    SqContext sqCtx = channelEntity->sqContextAddr[HCOMM_DFX_DEFAULT_QP_IDX];
    CqContext cqCtx = channelEntity->cqContextAddr[HCOMM_DFX_DEFAULT_QP_IDX];
    ctx->sqVa = sqCtx.contextInfo.ubJfs.sqVa;
    ctx->cqVa = cqCtx.contextInfo.ubJfc.scqVa;
    uint64_t sqHeadAddr = sqCtx.contextInfo.ubJfs.headAddr;
    uint64_t sqTailAddr = sqCtx.contextInfo.ubJfs.tailAddr;
    uint64_t cqTailAddr = cqCtx.contextInfo.ubJfc.tailAddr;
    if (afterDrain) {
        ctx->postDrainWqeCnt = channelEntity->wqeCnt;
        ctx->postDrainSqHead = LoadU32(sqHeadAddr);
        ctx->postDrainSqTail = LoadU32(sqTailAddr);
        ctx->postDrainCqTail = LoadU32(cqTailAddr);
    } else {
        ctx->postWriteWqeCnt = channelEntity->wqeCnt;
        ctx->postWriteSqHead = LoadU32(sqHeadAddr);
        ctx->postWriteSqTail = LoadU32(sqTailAddr);
        ctx->postWriteCqTail = LoadU32(cqTailAddr);
    }
    SnapshotQueueDw(ctx->sqVa, ctx->sqDw);
    SnapshotQueueDw(ctx->cqVa, ctx->cqDw);
}

__aicore__ inline uint32_t MakeFakeCqeDw0()
{
    constexpr uint32_t ownerShift = 2U;
    constexpr uint32_t opcodeWrite = 3U;
    constexpr uint32_t opcodeShift = 4U;
    constexpr uint32_t substatusShift = 16U;
    constexpr uint32_t statusShift = 24U;
    return (1U << ownerShift) | (opcodeWrite << opcodeShift) | (HCOMM_CQE_FAKE_SUBSTATUS << substatusShift) |
        (HCOMM_CQE_FAKE_STATUS << statusShift);
}

__aicore__ inline void SeedFakeWqe(__gm__ CommContext *ctx)
{
    if (ctx->sqVa == 0) {
        return;
    }
    constexpr uint32_t ownerShift = 31U;
    constexpr uint32_t opcodeWrite = 3U;
    constexpr uint32_t opcodeShift = 8U;
    constexpr uint32_t sgeNumShift = 24U;
    StoreU32(ctx->sqVa + 0U * sizeof(uint32_t), (1U << ownerShift) | 0x1U);
    StoreU32(ctx->sqVa + 1U * sizeof(uint32_t), (opcodeWrite << opcodeShift) | 0x23U);
    StoreU32(ctx->sqVa + 2U * sizeof(uint32_t), (1U << sgeNumShift) | 0x4567U);
    StoreU32(ctx->sqVa + 3U * sizeof(uint32_t), 0x89abU);
    StoreU32(ctx->sqVa + 4U * sizeof(uint32_t), 0U);
    StoreU32(ctx->sqVa + 5U * sizeof(uint32_t), 0x1000U);
    StoreU32(ctx->sqVa + 6U * sizeof(uint32_t), 0x2000U);
    StoreU32(ctx->sqVa + 7U * sizeof(uint32_t), 0x3000U);
    StoreU32(ctx->sqVa + 8U * sizeof(uint32_t), static_cast<uint32_t>(ctx->remoteBufferAddr));
    StoreU32(ctx->sqVa + 9U * sizeof(uint32_t), static_cast<uint32_t>(ctx->remoteBufferAddr >> 32U));
    StoreU32(ctx->sqVa + 10U * sizeof(uint32_t), static_cast<uint32_t>(ctx->localBufferAddr));
    StoreU32(ctx->sqVa + 11U * sizeof(uint32_t), static_cast<uint32_t>(ctx->localBufferAddr >> 32U));
    StoreU32(ctx->sqVa + 12U * sizeof(uint32_t), static_cast<uint32_t>(ctx->len));
    StoreU32(ctx->sqVa + 13U * sizeof(uint32_t), 0x4444U);
    StoreU32(ctx->sqVa + 14U * sizeof(uint32_t), 0x5555U);
    StoreU32(ctx->sqVa + 15U * sizeof(uint32_t), 0x6666U);
}

__aicore__ inline void SeedFakeCqeError(__gm__ CommContext *ctx)
{
    if (ctx->cqVa == 0) {
        return;
    }
    StoreU32(ctx->cqVa + 0U * sizeof(uint32_t), MakeFakeCqeDw0());
    StoreU32(ctx->cqVa + 1U * sizeof(uint32_t), 0U);
    StoreU32(ctx->cqVa + 2U * sizeof(uint32_t), 0x34U << 4U);
    StoreU32(ctx->cqVa + 3U * sizeof(uint32_t), 0x5678U);
    StoreU32(ctx->cqVa + 4U * sizeof(uint32_t), static_cast<uint32_t>(ctx->len));
    StoreU32(ctx->cqVa + 5U * sizeof(uint32_t), 0xaaaaU);
    StoreU32(ctx->cqVa + 6U * sizeof(uint32_t), 0xbbbbU);
    StoreU32(ctx->cqVa + 7U * sizeof(uint32_t), 0xcccc0000U);
    StoreU32(ctx->cqVa + 8U * sizeof(uint32_t), 0xcccc0001U);
    StoreU32(ctx->cqVa + 9U * sizeof(uint32_t), 0xcccc0002U);
    StoreU32(ctx->cqVa + 10U * sizeof(uint32_t), 0xcccc0003U);
    StoreU32(ctx->cqVa + 11U * sizeof(uint32_t), 0xddddU);
    StoreU32(ctx->cqVa + 12U * sizeof(uint32_t), 0xeeeeU);
    StoreU32(ctx->cqVa + 13U * sizeof(uint32_t), 0x1111U);
    StoreU32(ctx->cqVa + 14U * sizeof(uint32_t), 0x2222U);
    StoreU32(ctx->cqVa + 15U * sizeof(uint32_t), 0x3333U);
}

__aicore__ inline void TriggerFault(uint64_t invalidAddr)
{
    volatile uint64_t value = ld_dev(reinterpret_cast<__gm__ uint64_t *>(invalidAddr), 0);
    if (value == 0x12345678ULL) {
        StoreU32(invalidAddr, static_cast<uint32_t>(value));
    }
}
} // namespace

extern "C" __vector__ __global__ __aicore__ void HcommUrmaTimeoutFaultKernel(__gm__ CommContext *ctx)
{
    if (ctx == nullptr) {
        return;
    }

    Hcomm<COMM_PROTOCOL_UBC_CTP> hcomm;
    __ubuf__ uint8_t workspace[HCOMM_WORKSPACE_LEN];
    int32_t initRet = hcomm.Init(workspace, HCOMM_WORKSPACE_LEN);
    ctx->initRet = initRet;

    ChannelHandle channel = static_cast<ChannelHandle>(ctx->channelHandle);
    GM_ADDR src = reinterpret_cast<GM_ADDR>(ctx->localBufferAddr);
    GM_ADDR dst = reinterpret_cast<GM_ADDR>(ctx->remoteBufferAddr);
    uint64_t len = ctx->len;
    if (len <= 256ULL * 1024ULL * 1024ULL) {
        len = HCOMM_URMA_TIMEOUT_TEST_LEN;
    }

    int32_t writeRet = hcomm.WriteNbi(channel, dst, src, len);
    ctx->writeRet = writeRet;
    int32_t drainRet = hcomm.Drain(channel);
    ctx->drainRet = drainRet;
}

extern "C" __vector__ __global__ __aicore__ void HcommCqeSeedFaultQueuesKernel(__gm__ CommContext *ctx)
{
    if (ctx == nullptr) {
        return;
    }
    ctx->stage = HCOMM_CQE_STAGE_ENTER;

    ctx->initRet = 0;
    ctx->stage = HCOMM_CQE_STAGE_AFTER_INIT;

    uint64_t len = ctx->len;
    if (len == 0 || len > 1024ULL * 1024ULL) {
        len = HCOMM_CQE_ERROR_TEST_LEN;
    }

    ctx->stage = HCOMM_CQE_STAGE_BEFORE_WRITE;
    SeedFakeWqe(ctx);
    ctx->writeRet = 0;
    ctx->postWriteWqeCnt = ctx->preWqeCnt + 1U;
    ctx->postWriteSqHead = ctx->preSqHead;
    ctx->postWriteSqTail = ctx->preSqTail + 1U;
    ctx->postWriteCqTail = ctx->preCqTail;
    ctx->stage = HCOMM_CQE_STAGE_AFTER_WRITE;
    ctx->stage = HCOMM_CQE_STAGE_BEFORE_SNAPSHOT;
    SnapshotQueueDw(ctx->sqVa, ctx->sqDw);
    SnapshotQueueDw(ctx->cqVa, ctx->cqDw);
    ctx->stage = HCOMM_CQE_STAGE_AFTER_SNAPSHOT;
    SeedFakeCqeError(ctx);
    ctx->postDrainWqeCnt = ctx->postWriteWqeCnt;
    ctx->postDrainSqHead = ctx->postWriteSqHead;
    ctx->postDrainSqTail = ctx->postWriteSqTail;
    ctx->postDrainCqTail = ctx->preCqTail + 1U;
    ctx->stage = HCOMM_CQE_STAGE_AFTER_SEED_CQE;
    SnapshotQueueDw(ctx->cqVa, ctx->cqDw);
}

extern "C" __vector__ __global__ __aicore__ void HcommCqeErrorFaultKernel(__gm__ CommContext *ctx)
{
    if (ctx == nullptr) {
        return;
    }
    uint64_t invalidAddr = ctx->invalidBufferAddr;
    if (invalidAddr == 0) {
        invalidAddr = HCOMM_INVALID_BUFFER_ADDR;
    }
    ctx->stage = HCOMM_CQE_STAGE_BEFORE_TRIGGER;
    TriggerFault(invalidAddr);
    ctx->stage = HCOMM_CQE_STAGE_AFTER_TRIGGER;
}

EXPORT_AIV_META_INFO(HcommUrmaTimeoutFaultKernel);
EXPORT_AIV_META_INFO(HcommCqeSeedFaultQueuesKernel);
EXPORT_AIV_META_INFO(HcommCqeErrorFaultKernel);

void run_hcomm_urma_timeout_fault(CommContext *ctx, aclrtStream stream)
{
    HcommUrmaTimeoutFaultKernel<<<1, 0, stream>>>(ctx);
}

void run_hcomm_cqe_error_fault(CommContext *ctx, aclrtStream stream)
{
    HcommCqeErrorFaultKernel<<<1, 0, stream>>>(ctx);
}

void run_hcomm_cqe_seed_fault_queues(CommContext *ctx, aclrtStream stream)
{
    HcommCqeSeedFaultQueuesKernel<<<1, 0, stream>>>(ctx);
}
