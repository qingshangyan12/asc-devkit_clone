#include "kernel_operator.h"
#include "acl/acl.h"
#include "adv_api/hcomm/hcomm.h"
#include "hcomm_exception_fault_cases.h"

using namespace AscendC;

#define EXPORT_AIV_META_INFO(kernel_name) \
static const struct FunLevelKType kernel_name##_kernel_type_section __attribute__ \
((used, section (".ascend.meta." #kernel_name))) \
= {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}}

namespace {
constexpr uint32_t HCOMM_WORKSPACE_LEN = 512;
constexpr uint32_t HCOMM_DFX_DEFAULT_QP_IDX = 0;
constexpr uint32_t HCOMM_DFX_SEED_WORD_NUM = 32;
constexpr uint32_t HCOMM_DFX_SQE_WORD_NUM = 16;
constexpr uint32_t HCOMM_DFX_CQE_WORD_NUM = 16;

__aicore__ inline void StoreU32(uint64_t addr, uint32_t value)
{
    st_dev(value, reinterpret_cast<__gm__ uint32_t *>(addr), 0);
}

__aicore__ inline LocalTensor<uint32_t> MakeLocalTensor(__ubuf__ uint8_t *addr, uint32_t len)
{
    TBuffAddr buffAddr;
    buffAddr.logicPos = static_cast<uint8_t>(TPosition::VECOUT);
    buffAddr.bufferAddr = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(addr));
    buffAddr.dataLen = len;
    LocalTensor<uint32_t> tensor;
    tensor.SetAddr(buffAddr);
    return tensor;
}

__aicore__ inline uint32_t MakeUrmaSqeDw0()
{
    constexpr uint32_t flagShift = 16U;
    constexpr uint32_t nfShift = 27U;
    constexpr uint32_t tokenEnShift = 28U;
    constexpr uint32_t rmtJettyTypeShift = 29U;
    constexpr uint32_t ownerShift = 31U;
    return (1U << flagShift) | (1U << nfShift) | (1U << tokenEnShift) | (1U << rmtJettyTypeShift) |
        (1U << ownerShift);
}

__aicore__ inline uint32_t MakeUrmaSqeDw1()
{
    constexpr uint32_t targetHint = 1U;
    constexpr uint32_t opcodeWrite = 3U;
    constexpr uint32_t opcodeShift = 8U;
    return targetHint | (opcodeWrite << opcodeShift);
}

__aicore__ inline uint32_t MakeUrmaCqeDw0()
{
    constexpr uint32_t ownerShift = 2U;
    constexpr uint32_t opcode = 3U;
    constexpr uint32_t opcodeShift = 4U;
    constexpr uint32_t substatus = 0x12U;
    constexpr uint32_t substatusShift = 16U;
    constexpr uint32_t status = 0x5U;
    constexpr uint32_t statusShift = 24U;
    return (1U << ownerShift) | (opcode << opcodeShift) | (substatus << substatusShift) | (status << statusShift);
}

__aicore__ inline void SeedCqeErrorDumpState(ChannelHandle channel, uint64_t localAddr, uint64_t remoteAddr,
    uint64_t len, __ubuf__ uint8_t *workspace)
{
    __gm__ ChannelEntity *channelEntity = reinterpret_cast<__gm__ ChannelEntity *>(channel);
    SqContext sqCtx = channelEntity->sqContextAddr[HCOMM_DFX_DEFAULT_QP_IDX];
    CqContext cqCtx = channelEntity->cqContextAddr[HCOMM_DFX_DEFAULT_QP_IDX];
    uint64_t sqeAddr = sqCtx.contextInfo.ubJfs.sqVa;
    uint64_t cqeAddr = cqCtx.contextInfo.ubJfc.scqVa;
    uint32_t dumpLen = static_cast<uint32_t>(len);
    __ubuf__ uint8_t *seedAddr = reinterpret_cast<__ubuf__ uint8_t *>(AlignAddrTo32Bytes(workspace));
    LocalTensor<uint32_t> seed = MakeLocalTensor(seedAddr, HCOMM_DFX_SEED_WORD_NUM);

    seed.SetValue(0, MakeUrmaSqeDw0());
    seed.SetValue(1, MakeUrmaSqeDw1());
    seed.SetValue(2, (1U << 24U) | 0x123U);
    seed.SetValue(3, 0x456U);
    seed.SetValue(4, 0x11111111U);
    seed.SetValue(5, 0x22222222U);
    seed.SetValue(6, 0x33333333U);
    seed.SetValue(7, 0x44444444U);
    seed.SetValue(8, 0x5678U);
    seed.SetValue(9, 0U);
    seed.SetValue(10, static_cast<uint32_t>(remoteAddr));
    seed.SetValue(11, static_cast<uint32_t>(remoteAddr >> 32U));
    seed.SetValue(12, dumpLen);
    seed.SetValue(13, 0x9abcU);
    seed.SetValue(14, static_cast<uint32_t>(localAddr));
    seed.SetValue(15, static_cast<uint32_t>(localAddr >> 32U));

    seed.SetValue(16, MakeUrmaCqeDw0());
    seed.SetValue(17, 0U);
    seed.SetValue(18, 0x34U << 4U);
    seed.SetValue(19, 0x5678U);
    seed.SetValue(20, dumpLen);
    seed.SetValue(21, 0xaaaaU);
    seed.SetValue(22, 0xbbbbU);
    seed.SetValue(23, 0xcccc0000U);
    seed.SetValue(24, 0xcccc0001U);
    seed.SetValue(25, 0xcccc0002U);
    seed.SetValue(26, 0xcccc0003U);
    seed.SetValue(27, 0xddddU);
    seed.SetValue(28, 0xeeeeU);
    seed.SetValue(29, 0x1111U);
    seed.SetValue(30, 0x2222U);
    seed.SetValue(31, 0x3333U);

    GlobalTensor<uint32_t> sqeGm;
    sqeGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(sqeAddr));
    GlobalTensor<uint32_t> cqeGm;
    cqeGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(cqeAddr));
    SyncAction<HardEvent::S_MTE3>();
    DataCopy(sqeGm, seed, HCOMM_DFX_SQE_WORD_NUM);
    DataCopy(cqeGm, seed[HCOMM_DFX_SQE_WORD_NUM], HCOMM_DFX_CQE_WORD_NUM);
    SyncAction<HardEvent::MTE3_S>();
}

__aicore__ inline void TriggerFault(uint64_t invalidAddr)
{
    volatile uint64_t value = ld_dev(reinterpret_cast<__gm__ uint64_t *>(invalidAddr), 0);
    if (value == 0x12345678ULL) {
        StoreU32(invalidAddr, static_cast<uint32_t>(value));
    }
}
} // namespace

extern "C" __vector__ __global__ __aicore__ void HcommUrmaTimeoutFaultKernel(__gm__ CommContext *ctx)
{
    if (ctx == nullptr) {
        return;
    }

    Hcomm<COMM_PROTOCOL_UBC_CTP> hcomm;
    __ubuf__ uint8_t workspace[HCOMM_WORKSPACE_LEN];
    (void)hcomm.Init(workspace, HCOMM_WORKSPACE_LEN);

    ChannelHandle channel = static_cast<ChannelHandle>(ctx->channelHandle);
    GM_ADDR src = reinterpret_cast<GM_ADDR>(ctx->localBufferAddr);
    GM_ADDR dst = reinterpret_cast<GM_ADDR>(ctx->remoteBufferAddr);
    uint64_t len = ctx->len;
    if (len <= 256ULL * 1024ULL * 1024ULL) {
        len = HCOMM_URMA_TIMEOUT_TEST_LEN;
    }

    (void)hcomm.WriteNbi(channel, dst, src, len);
    (void)hcomm.Drain(channel);
}

extern "C" __vector__ __global__ __aicore__ void HcommCqeErrorFaultKernel(__gm__ CommContext *ctx)
{
    if (ctx == nullptr) {
        return;
    }

    Hcomm<COMM_PROTOCOL_UBC_CTP> hcomm;
    __ubuf__ uint8_t workspace[HCOMM_WORKSPACE_LEN];
    (void)hcomm.Init(workspace, HCOMM_WORKSPACE_LEN);

    ChannelHandle channel = static_cast<ChannelHandle>(ctx->channelHandle);
    uint64_t invalidAddr = ctx->invalidBufferAddr;
    if (invalidAddr == 0) {
        invalidAddr = HCOMM_INVALID_BUFFER_ADDR;
    }
    GM_ADDR src = reinterpret_cast<GM_ADDR>(ctx->localBufferAddr);
    GM_ADDR dst = reinterpret_cast<GM_ADDR>(ctx->remoteBufferAddr);

    uint64_t len = ctx->len;
    if (len == 0 || len > 1024ULL * 1024ULL) {
        len = HCOMM_CQE_ERROR_TEST_LEN;
    }

    (void)hcomm.WriteNbi(channel, dst, src, len);
    SeedCqeErrorDumpState(channel, ctx->localBufferAddr, ctx->remoteBufferAddr, len, workspace);
    TriggerFault(invalidAddr);
}

EXPORT_AIV_META_INFO(HcommUrmaTimeoutFaultKernel);
EXPORT_AIV_META_INFO(HcommCqeErrorFaultKernel);

void run_hcomm_urma_timeout_fault(CommContext *ctx, aclrtStream stream)
{
    HcommUrmaTimeoutFaultKernel<<<1, 0, stream>>>(ctx);
}

void run_hcomm_cqe_error_fault(CommContext *ctx, aclrtStream stream)
{
    HcommCqeErrorFaultKernel<<<1, 0, stream>>>(ctx);
}
