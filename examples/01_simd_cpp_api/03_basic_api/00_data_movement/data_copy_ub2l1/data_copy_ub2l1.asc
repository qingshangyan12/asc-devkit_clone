#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t ONE_BLK_SIZE = 32;

template <class InputType, class outputType>
class KernelMmad {
public:
    __aicore__ inline KernelMmad()
    {
        if constexpr (SCENARIO_NUM == 1) {
            // 场景1：对齐shape 128-128-128
            m = 128;
            n = 128;
            k = 128;
        } else {
            // 场景2：非对齐shape 120-120-120，对齐后为128-128-128
            m = 120;
            n = 120;
            k = 120;
        }

        mAlign = CeilAlign(m, CUBE_BLOCK);
        nAlign = CeilAlign(n, CUBE_BLOCK);
        kAlign = CeilAlign(k, CUBE_BLOCK);

        aSize = m * k;
        bSize = k * n;
        cSize = m * n;

        aSizeAlign = mAlign * kAlign;
        bSizeAlign = kAlign * nAlign;

        if constexpr (SCENARIO_NUM == 1) {
            // 场景1：UB中存放NZ格式数据，尺寸为对齐后尺寸
            ubASize = aSizeAlign;
            ubBSize = bSizeAlign;
        } else {
            // 场景2：UB中存放padded ND数据，行数为实际行数，列数为对齐后列数
            ubASize = m * kAlign;
            ubBSize = k * nAlign;
        }
        // temp区域用于ND2NZ转换，存放对齐后的NZ数据
        tempSize = aSizeAlign; // 复用同一temp区域处理A和B
    }

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
    {
        aGM.SetGlobalBuffer((__gm__ InputType*)x);
        bGM.SetGlobalBuffer((__gm__ InputType*)y);
        cGM.SetGlobalBuffer((__gm__ outputType*)z);
    }

    __aicore__ inline void Process()
    {
        uint64_t ubAddrA = 0;
        uint64_t ubAddrB = ubAddrA + ubASize * sizeof(InputType);
        uint64_t tempAddr = ubAddrB + ubBSize * sizeof(InputType);

        AscendC::LocalTensor<InputType> ubA1Local(AscendC::TPosition::VECIN, ubAddrA, ubASize);
        AscendC::LocalTensor<InputType> ubB1Local(AscendC::TPosition::VECIN, ubAddrB, ubBSize);
        AscendC::LocalTensor<InputType> a1Local(AscendC::TPosition::A1, a1Addr, aSizeAlign);
        AscendC::LocalTensor<InputType> a2Local(AscendC::TPosition::A2, a2Addr, aSizeAlign);
        AscendC::LocalTensor<InputType> b1Local(AscendC::TPosition::B1, b1Addr, bSizeAlign);
        AscendC::LocalTensor<InputType> b2Local(AscendC::TPosition::B2, b2Addr, bSizeAlign);
        AscendC::LocalTensor<outputType> co1Local(AscendC::TPosition::CO1, cAddr, cSize);

        if ASCEND_IS_AIV {
            CopyIn(ubA1Local, ubB1Local, tempAddr);
            if constexpr (SCENARIO_NUM == 1) {
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::DataCopy(a1Local, ubA1Local, aSizeAlign); // ub -> l1 no nd2nz
                AscendC::DataCopy(b1Local, ubB1Local, bSizeAlign); // ub -> l1 no nd2nz
            } else {
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                // 在UB上完成ND2NZ转换，同时完成矩阵对齐（height/width方向padding）
                CopyUB2L1ND2NZ(a1Local, ubA1Local, m, k, mAlign, kAlign, tempAddr, EVENT_ID0);
                // 等待A的UB->L1搬运完成后，再处理B，避免temp区域读写冲突
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                CopyUB2L1ND2NZ(b1Local, ubB1Local, k, n, kAlign, nAlign, tempAddr, EVENT_ID1);
            }
            AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(0x8);
        }
        if ASCEND_IS_AIC {
            AscendC::CrossCoreWaitFlag(0x8);
            SplitA(a1Local, a2Local);
            SplitB(b1Local, b2Local);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            Compute(co1Local, a2Local, b2Local);
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            CopyOut(co1Local);
        }
    }

private:
    __aicore__ inline uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
    __aicore__ inline uint32_t CeilAlign(uint32_t a, uint32_t b) { return (a + b - 1) / b * b; }

    __aicore__ inline void CopyIn(
        AscendC::LocalTensor<InputType>& ubA1Local, AscendC::LocalTensor<InputType>& ubB1Local, uint64_t tempAddr)
    {
        if constexpr (SCENARIO_NUM == 1) {
            // 场景1：GM中为NZ格式，连续搬运至UB
            AscendC::DataCopy(ubA1Local, aGM, aSizeAlign);
            AscendC::DataCopy(ubB1Local, bGM, bSizeAlign);
        } else {
            // 场景2：GM中为ND格式（非对齐），使用DataCopyPad搬运至UB
            // 搬运时在width方向进行padding，使UB中每行列宽对齐到C0_size(16)
            // height方向不padding，保持实际行数，ND2NZ转换时再处理height对齐
            AscendC::DataCopyExtParams copyParamsA;
            copyParamsA.blockCount = m;
            copyParamsA.blockLen = k * sizeof(InputType);
            copyParamsA.srcStride = 0;
            copyParamsA.dstStride = 0;
            copyParamsA.rsv = 0;

            AscendC::DataCopyPadExtParams<InputType> padParamsA;
            padParamsA.isPad = true;
            padParamsA.leftPadding = 0;
            padParamsA.rightPadding = kAlign - k;
            padParamsA.paddingValue = 0;
            AscendC::DataCopyPad(ubA1Local, aGM, copyParamsA, padParamsA);

            AscendC::DataCopyExtParams copyParamsB;
            copyParamsB.blockCount = k;
            copyParamsB.blockLen = n * sizeof(InputType);
            copyParamsB.srcStride = 0;
            copyParamsB.dstStride = 0;
            copyParamsB.rsv = 0;

            AscendC::DataCopyPadExtParams<InputType> padParamsB;
            padParamsB.isPad = true;
            padParamsB.leftPadding = 0;
            padParamsB.rightPadding = nAlign - n;
            padParamsB.paddingValue = 0;
            AscendC::DataCopyPad(ubB1Local, bGM, copyParamsB, padParamsB);
        }
    }

    __aicore__ inline void SplitA(AscendC::LocalTensor<InputType>& a1Local, AscendC::LocalTensor<InputType>& a2Local)
    {
        // L1 -> L0A, NZ -> NZ (950)
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = DivCeil(mAlign, 16);
        loadDataParams.kStep = DivCeil(kAlign * sizeof(InputType), 32);
        loadDataParams.srcStride = DivCeil(mAlign, 16);
        loadDataParams.dstStride = DivCeil(mAlign, 16);
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local, loadDataParams);
    }

    __aicore__ inline void SplitB(AscendC::LocalTensor<InputType>& b1Local, AscendC::LocalTensor<InputType>& b2Local)
    {
        // L1 -> L0B, Zn -> Zn (with transpose)
        uint16_t nAlignBlocks = DivCeil(nAlign * sizeof(InputType), 32);
        uint16_t kAlignBlocks = DivCeil(kAlign, 16);
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = kAlignBlocks;
        loadDataParams.kStep = nAlignBlocks;
        loadDataParams.srcStride = kAlignBlocks;
        loadDataParams.dstStride = nAlignBlocks;
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = true;
        AscendC::LoadData(b2Local, b1Local, loadDataParams);
    }

    __aicore__ inline void CopyUB2L1ND2NZ(
        AscendC::LocalTensor<InputType>& l1Local, AscendC::LocalTensor<InputType>& ubLocal, uint16_t height,
        uint16_t width, uint16_t heightAlign, uint16_t widthAlign, uint64_t tempAddr, uint8_t eventId)
    {
        // ND2NZ转换 + 矩阵对齐（padding）
        // 源数据：UB中的padded ND格式，height行 x widthAlign列（列已对齐）
        // 目标数据：UB中的NZ格式，heightAlign行 x widthAlign列（行也需对齐）
        // 最终搬运至L1
        uint16_t colBlocks = widthAlign * sizeof(InputType) / ONE_BLK_SIZE;
        uint64_t srcBase = ubLocal.GetPhyAddr();
        uint64_t dstBase = tempAddr;

        // Step 1: 零填充NZ目标区域，处理height方向的padding
        // heightAlign > height时，多出的行保持为0
        AscendC::LocalTensor<InputType> nzDstLocal(AscendC::TPosition::VECIN, dstBase, heightAlign * widthAlign);
        AscendC::Duplicate<InputType>(nzDstLocal, (InputType)0, heightAlign * widthAlign);
        AscendC::PipeBarrier<PIPE_V>();

        // Step 2: 逐列块进行ND->NZ转换
        // 源数据每行列宽已对齐（widthAlign），行步长为32字节对齐
        // 仅搬运height行有效数据，剩余heightAlign-height行保持零填充
        AscendC::DataCopyParams copyParams;
        copyParams.blockCount = height;
        copyParams.blockLen = 1;
        copyParams.srcStride = widthAlign * sizeof(InputType) / ONE_BLK_SIZE - 1;
        copyParams.dstStride = 0;

        for (uint16_t i = 0; i < colBlocks; i++) {
            AscendC::LocalTensor<InputType> srcView(
                AscendC::TPosition::VECIN, srcBase + i * ONE_BLK_SIZE, widthAlign * height);
            // NZ目标中，列块i的起始偏移 = i * heightAlign * 32字节
            AscendC::LocalTensor<InputType> dstView(
                AscendC::TPosition::VECIN, dstBase + i * heightAlign * ONE_BLK_SIZE, widthAlign * heightAlign);
            AscendC::DataCopy(dstView, srcView, copyParams);
        }

        // Step 3: 等待V管线完成，再将NZ数据从UB搬运至L1
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(static_cast<event_t>(eventId));
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(static_cast<event_t>(eventId));

        AscendC::LocalTensor<InputType> nzLocal(AscendC::TPosition::VECIN, dstBase, heightAlign * widthAlign);
        AscendC::DataCopy(l1Local, nzLocal, heightAlign * widthAlign);
    }

    __aicore__ inline void Compute(
        AscendC::LocalTensor<outputType>& co1Local, AscendC::LocalTensor<InputType>& a2Local,
        AscendC::LocalTensor<InputType>& b2Local)
    {
        AscendC::MmadParams mmadParams;
        mmadParams.m = m;
        mmadParams.n = n;
        mmadParams.k = k;
        mmadParams.isBias = false;
        AscendC::Mmad(co1Local, a2Local, b2Local, mmadParams);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<outputType>& co1Local)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fixpipeParams;
        fixpipeParams.mSize = m;
        fixpipeParams.srcStride = CeilAlign(n, CUBE_BLOCK);
        fixpipeParams.nSize = n;
        fixpipeParams.dstStride = n;
        AscendC::Fixpipe<outputType, outputType, AscendC::CFG_ROW_MAJOR>(cGM, co1Local, fixpipeParams);
    }

private:
    uint64_t a1Addr = 0;
    uint64_t a2Addr = 0;
    uint64_t b1Addr = 256 * 1024; // B1 addr offset is 256KB
    uint64_t b2Addr = 0;
    uint64_t cAddr = 0;
    AscendC::GlobalTensor<InputType> aGM, bGM;
    AscendC::GlobalTensor<outputType> cGM;
    uint16_t m, n, k;
    uint16_t mAlign, nAlign, kAlign;
    uint32_t aSize, bSize, cSize;
    uint32_t aSizeAlign, bSizeAlign;
    uint32_t ubASize, ubBSize, tempSize;
};

__global__ __mix__(1, 2) void data_copy_ub2l1(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    AscendC::InitSocState();
    KernelMmad<half, float> op;
    op.Init(x, y, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        aclrtFreeHost(goldenData);
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 根据编译选项SCENARIO_NUM选择shape
    constexpr uint32_t M = (SCENARIO_NUM == 1) ? 128 : 120;
    constexpr uint32_t N = (SCENARIO_NUM == 1) ? 128 : 120;
    constexpr uint32_t K = (SCENARIO_NUM == 1) ? 128 : 120;

    size_t aInputByteSize = static_cast<size_t>(1) * M * K * sizeof(half);
    size_t bInputByteSize = static_cast<size_t>(1) * K * N * sizeof(half);
    size_t outputByteSize = static_cast<size_t>(1) * M * N * sizeof(float);
    uint8_t *xHost, *yHost, *zHost;
    uint8_t *xDevice, *yDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), aInputByteSize);
    aclrtMallocHost((void**)(&yHost), bInputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, aInputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, bInputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", aInputByteSize, xHost, aInputByteSize);
    ReadFile("./input/input_y.bin", bInputByteSize, yHost, bInputByteSize);
    aclrtMemcpy(xDevice, aInputByteSize, xHost, aInputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, bInputByteSize, yHost, bInputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    data_copy_ub2l1<<<numBlocks, 0, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(zHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
