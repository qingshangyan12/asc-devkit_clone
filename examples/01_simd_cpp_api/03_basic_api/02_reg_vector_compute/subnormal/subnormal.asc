/* !
 * \file subnormal.asc
 * \brief 演示使用DivAlgo::DIFF_COMPENSATION差值补偿算法进行除法计算，验证0ulp精度
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

constexpr uint32_t totalLength = 1024;
constexpr uint32_t numBlocks = 1;
constexpr uint32_t singleCoreLength = totalLength / numBlocks;

template <typename T>
__simd_vf__ inline void SubnormalDivVF(
    __ubuf__ T* xAddr, __ubuf__ T* yAddr, __ubuf__ T* zAddr, uint32_t oneRepeatSize)
{
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::RegTensor<T> xReg1, xReg2, xReg3, xReg4, xReg5, xReg6, xReg7, xReg8;
    AscendC::Reg::RegTensor<T> xReg9, xReg10, xReg11, xReg12, xReg13, xReg14, xReg15, xReg16;
    AscendC::Reg::RegTensor<T> yReg1, yReg2, yReg3, yReg4, yReg5, yReg6, yReg7, yReg8;
    AscendC::Reg::RegTensor<T> yReg9, yReg10, yReg11, yReg12, yReg13, yReg14, yReg15, yReg16;
    AscendC::Reg::RegTensor<T> zReg1, zReg2, zReg3, zReg4, zReg5, zReg6, zReg7, zReg8;
    AscendC::Reg::RegTensor<T> zReg9, zReg10, zReg11, zReg12, zReg13, zReg14, zReg15, zReg16;
    // 使用差值补偿算法，最大精度误差为0ulp，输出与IEEE 754正确舍入结果一致
    static constexpr AscendC::Reg::DivSpecificMode mode = {
        AscendC::Reg::MaskMergeMode::ZEROING, false, AscendC::DivAlgo::DIFF_COMPENSATION};
    // Load
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg1, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg1, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg2, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg2, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg3, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg3, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg4, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg4, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg5, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg5, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg6, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg6, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg7, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg7, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg8, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg8, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg9, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg9, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg10, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg10, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg11, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg11, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg12, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg12, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg13, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg13, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg14, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg14, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg15, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg15, yAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(xReg16, xAddr, oneRepeatSize);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(yReg16, yAddr, oneRepeatSize);
    // Div
    for (uint16_t i = 0; i < 4; ++i) {
        AscendC::Reg::Div<T, &mode>(zReg1, xReg1, yReg1, mask);
        AscendC::Reg::Div<T, &mode>(zReg2, xReg2, yReg2, mask);
        AscendC::Reg::Div<T, &mode>(zReg3, xReg3, yReg3, mask);
        AscendC::Reg::Div<T, &mode>(zReg4, xReg4, yReg4, mask);
        AscendC::Reg::Div<T, &mode>(zReg5, xReg5, yReg5, mask);
        AscendC::Reg::Div<T, &mode>(zReg6, xReg6, yReg6, mask);
        AscendC::Reg::Div<T, &mode>(zReg7, xReg7, yReg7, mask);
        AscendC::Reg::Div<T, &mode>(zReg8, xReg8, yReg8, mask);
        AscendC::Reg::Div<T, &mode>(zReg9, xReg9, yReg9, mask);
        AscendC::Reg::Div<T, &mode>(zReg10, xReg10, yReg10, mask);
        AscendC::Reg::Div<T, &mode>(zReg11, xReg11, yReg11, mask);
        AscendC::Reg::Div<T, &mode>(zReg12, xReg12, yReg12, mask);
        AscendC::Reg::Div<T, &mode>(zReg13, xReg13, yReg13, mask);
        AscendC::Reg::Div<T, &mode>(zReg14, xReg14, yReg14, mask);
        AscendC::Reg::Div<T, &mode>(zReg15, xReg15, yReg15, mask);
        AscendC::Reg::Div<T, &mode>(zReg16, xReg16, yReg16, mask);
    }
    // Store
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg1, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg2, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg3, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg4, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg5, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg6, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg7, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg8, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg9, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg10, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg11, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg12, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg13, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg14, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg15, oneRepeatSize, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(zAddr, zReg16, oneRepeatSize, mask);
}

template <typename T, uint32_t SingleCoreLength = singleCoreLength>
class KernelSubnormal {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z));
    }
    __aicore__ inline void Process()
    {
        uint32_t coreOffset = AscendC::GetBlockIdx() * SingleCoreLength;

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, SingleCoreLength>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, SingleCoreLength>();
        AscendC::LocalTensor<T> zLocal = ubAllocator.Alloc<T, SingleCoreLength>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm[coreOffset], SingleCoreLength);
        AscendC::DataCopy(yLocal, yGm[coreOffset], SingleCoreLength);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        __ubuf__ T* zAddr = reinterpret_cast<__ubuf__ T*>(zLocal.GetPhyAddr());

        // 计算迭代次数
        constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        asc_vf_call<SubnormalDivVF<T>>(xAddr, yAddr, zAddr, oneRepeatSize);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM
        AscendC::DataCopy(zGm[coreOffset], zLocal, SingleCoreLength);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

__global__ __vector__ void subnormal(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    AscendC::InitSocState();
    KernelSubnormal<float> kernel;
    kernel.Init(x, y, z);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        aclrtFreeHost(goldenData);
        return false;
    }
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        unsigned int hex_val_a = *(unsigned int*)&a;
        unsigned int hex_val_b = *(unsigned int*)&b;
        // 0ulp精度，计算结果应与golden（IEEE 754正确舍入）完全一致
        if (hex_val_a != hex_val_b && i < 5) {
            printf("CompareResult golden.bin failed output is %e, golden is %e\n", a, b);
            printf("CompareResult golden.bin failed output is 0x%08x, golden is 0x%08x\n", hex_val_a, hex_val_b);
            wrongNum++;
        }
    }

    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = totalLength * sizeof(float);
    uint8_t *xHost, *yHost, *zHost;
    uint8_t *xDevice, *yDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    subnormal<<<numBlocks, 0, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);
    bool goldenResult = CompareResult(zHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
