/* !
 * \file scalar_cache_mode.asc
 * \brief
 * 基于SetScalarCacheMode和GetScalarCacheMode接口，验证CTRL寄存器的L2Cache读写模式设置功能
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t DATA_SIZE = 256;
constexpr uint32_t CTRL_SIZE = 32;

template <typename T>
class KernelScalarCacheMode {
public:
    __aicore__ inline KernelScalarCacheMode() {}
    __aicore__ inline void Init(uint64_t srcAddr, uint64_t dstCtrlAddr)
    {
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcAddr), DATA_SIZE);
        dstCtrlGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(dstCtrlAddr), CTRL_SIZE);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<int64_t> ctrlLocal = ubAllocator.Alloc<int64_t, CTRL_SIZE>();

        uint32_t idx = 0;

        // READ mode: 4种CacheMode测试
        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::READ, AscendC::CacheMode::CACHE_MODE_NORMAL>();
        AscendC::CacheMode mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::READ>();
        int64_t value = (mode == AscendC::CacheMode::CACHE_MODE_NORMAL) ? 0 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::READ, AscendC::CacheMode::CACHE_MODE_LAST>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::READ>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_LAST) ? 1 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::READ, AscendC::CacheMode::CACHE_MODE_PERSISTENT>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::READ>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_PERSISTENT) ? 2 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::READ, AscendC::CacheMode::CACHE_MODE_DISABLE>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::READ>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_DISABLE) ? 4 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // WRITE mode: 4种CacheMode测试
        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::WRITE, AscendC::CacheMode::CACHE_MODE_NORMAL>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::WRITE>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_NORMAL) ? 0 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::WRITE, AscendC::CacheMode::CACHE_MODE_LAST>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::WRITE>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_LAST) ? 1 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::WRITE, AscendC::CacheMode::CACHE_MODE_PERSISTENT>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::WRITE>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_PERSISTENT) ? 2 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        AscendC::SetScalarCacheMode<AscendC::CacheRwMode::WRITE, AscendC::CacheMode::CACHE_MODE_DISABLE>();
        mode = AscendC::GetScalarCacheMode<AscendC::CacheRwMode::WRITE>();
        value = (mode == AscendC::CacheMode::CACHE_MODE_DISABLE) ? 4 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

        AscendC::DataCopy(dstCtrlGlobal, ctrlLocal, CTRL_SIZE);

        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<int64_t> dstCtrlGlobal;
};

__global__ __vector__ void kernel_scalar_cache_mode(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstCtrlGm)
{
    AscendC::InitSocState();

    KernelScalarCacheMode<half> op;
    op.Init((uint64_t)srcGm, (uint64_t)dstCtrlGm);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t NUM_BLOCKS = 1;
    size_t inputByteSize = NUM_BLOCKS * DATA_SIZE * sizeof(half);
    size_t outputCtrlByteSize = NUM_BLOCKS * CTRL_SIZE * sizeof(int64_t);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *srcHost, *dstCtrlHost;
    uint8_t *srcDevice, *dstCtrlDevice;

    aclrtMallocHost((void**)(&srcHost), inputByteSize);
    aclrtMallocHost((void**)(&dstCtrlHost), outputCtrlByteSize);
    aclrtMalloc((void**)&srcDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstCtrlDevice, outputCtrlByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input.bin", inputByteSize, srcHost, inputByteSize);
    aclrtMemcpy(srcDevice, inputByteSize, srcHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_scalar_cache_mode<<<NUM_BLOCKS, nullptr, stream>>>(srcDevice, dstCtrlDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstCtrlHost, outputCtrlByteSize, dstCtrlDevice, outputCtrlByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    WriteFile("./output/output_ctrl.bin", dstCtrlHost, outputCtrlByteSize);

    aclrtFree(srcDevice);
    aclrtFree(dstCtrlDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(dstCtrlHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}