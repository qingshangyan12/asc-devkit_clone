/* !
 * \file atomic_type.asc
 * \brief
 * 基于SetAtomicType、SetAtomicMax、SetAtomicMin接口，验证原子操作寄存器设置功能
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t DATA_SIZE = 256;
constexpr uint32_t CTRL_SIZE = 32;

template <typename T>
class KernelAtomicType {
public:
    __aicore__ inline KernelAtomicType() {}
    __aicore__ inline void Init(uint64_t srcAddr, uint64_t dstCtrlAddr)
    {
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcAddr), DATA_SIZE);
        dstCtrlGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(dstCtrlAddr), CTRL_SIZE);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<int64_t> ctrlLocal = ubAllocator.Alloc<int64_t, CTRL_SIZE>();

        uint32_t idx = 0;
        uint16_t atomicType = 0;
        uint16_t atomicOp = 0;

        // SetAtomicType<half>: type=F16(2), op=SUM(0), expected config = (0 << 4) | 2 = 2
        AscendC::SetAtomicType<half>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        int64_t value = (atomicType == 2 && atomicOp == 0) ? 2 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // SetAtomicType<float>: type=F32(1), op=SUM(0), expected config = (0 << 4) | 1 = 1
        AscendC::SetAtomicType<float>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 1 && atomicOp == 0) ? 1 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // SetAtomicType<int32_t>: type=S32(4), op=SUM(0), expected config = (0 << 4) | 4 = 4
        AscendC::SetAtomicType<int32_t>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 4 && atomicOp == 0) ? 4 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // DisableDmaAtomic: type=NONE(0), op=SUM(0), expected config = 0
        AscendC::DisableDmaAtomic();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 0 && atomicOp == 0) ? 0 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // SetAtomicMax<half>: type=F16(2), op=MAX(1), expected config = (1 << 4) | 2 = 18
        AscendC::SetAtomicMax<half>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 2 && atomicOp == 1) ? 18 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // SetAtomicMax<float>: type=F32(1), op=MAX(1), expected config = (1 << 4) | 1 = 17
        AscendC::SetAtomicMax<float>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 1 && atomicOp == 1) ? 17 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // SetAtomicMin<half>: type=F16(2), op=MIN(2), expected config = (2 << 4) | 2 = 34
        AscendC::SetAtomicMin<half>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 2 && atomicOp == 2) ? 34 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);
        idx += 4;

        // SetAtomicMin<float>: type=F32(1), op=MIN(2), expected config = (2 << 4) | 1 = 33
        AscendC::SetAtomicMin<float>();
        AscendC::GetStoreAtomicConfig(atomicType, atomicOp);
        value = (atomicType == 1 && atomicOp == 2) ? 33 : -1;
        AscendC::Duplicate(ctrlLocal[idx], value, 4);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);

        AscendC::DataCopy(dstCtrlGlobal, ctrlLocal, CTRL_SIZE);

        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<int64_t> dstCtrlGlobal;
};

__global__ __vector__ void kernel_atomic_type(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstCtrlGm)
{
    AscendC::InitSocState();

    KernelAtomicType<half> op;
    op.Init((uint64_t)srcGm, (uint64_t)dstCtrlGm);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t NUM_BLOCKS = 1;
    size_t inputByteSize = NUM_BLOCKS * DATA_SIZE * sizeof(half);
    size_t outputCtrlByteSize = NUM_BLOCKS * CTRL_SIZE * sizeof(int64_t);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *srcHost, *dstCtrlHost;
    uint8_t *srcDevice, *dstCtrlDevice;

    aclrtMallocHost((void**)(&srcHost), inputByteSize);
    aclrtMallocHost((void**)(&dstCtrlHost), outputCtrlByteSize);
    aclrtMalloc((void**)&srcDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstCtrlDevice, outputCtrlByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input.bin", inputByteSize, srcHost, inputByteSize);
    aclrtMemcpy(srcDevice, inputByteSize, srcHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_atomic_type<<<NUM_BLOCKS, nullptr, stream>>>(srcDevice, dstCtrlDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstCtrlHost, outputCtrlByteSize, dstCtrlDevice, outputCtrlByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    WriteFile("./output/output_ctrl.bin", dstCtrlHost, outputCtrlByteSize);

    aclrtFree(srcDevice);
    aclrtFree(dstCtrlDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(dstCtrlHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}