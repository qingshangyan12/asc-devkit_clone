/*!
 * \file ain_test.asc
 * \brief Ain device class compile test
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdlib>

extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void AinTestKernel(GM_ADDR input, GM_ADDR output)
{
    (void)input;
    (void)output;

    ain::device::Ain dev((__gm__ void *)0, 0);
    ain::device::AinDescriptorUbuf ubuf = {(__ubuf__ uint8_t *)0, 512, 0};
    if (input != nullptr && output != nullptr) {
        dev.put(nullptr, 0, output, 0, input, 0, 0, ubuf);
        dev.get(nullptr, 0, input, 0, output, 0, 0, ubuf);
    }
    dev.flush();
}

void ain_test_launch(uint32_t blockDim, void *stream, uint8_t *input, uint8_t *output)
{
    AinTestKernel<<<blockDim, nullptr, stream>>>(input, output);
}

namespace {

bool CheckAcl(aclError status)
{
    return status == ACL_SUCCESS;
}

}  // namespace

int32_t main(int32_t argc, char **argv)
{
    int32_t deviceId = argc > 1 ? std::atoi(argv[1]) : 0;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    bool success = false;

    do {
        if (!CheckAcl(aclInit(nullptr))) {
            break;
        }
        aclInitialized = true;

        if (!CheckAcl(aclrtSetDevice(deviceId))) {
            break;
        }
        deviceSet = true;

        if (!CheckAcl(aclrtCreateStream(&stream))) {
            break;
        }

        ain_test_launch(1, stream, nullptr, nullptr);
        if (!CheckAcl(aclrtSynchronizeStream(stream))) {
            break;
        }

        success = true;
    } while (false);

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(deviceId);
    }
    if (aclInitialized) {
        (void)aclFinalize();
    }

    return success ? 0 : 1;
}
