/* !
 * \file conv2d_forward_tiling_tensor_api.asc
 * \brief 带切分的 Conv2D Forward 样例（大 Shape）。在 Conv2D 基础样例之上演示分核与核内分块：
 *
 *        核间：batch 方向 x N(Cout) 方向二维分核，每核负责 [1 个 batch, singleCoreN 个 Cout]。
 *        核内：M 方向（输出 HOUT*WOUT 展平）分 mLoop 块，K 方向（Cin 的 C1 维）分 kLoop 块，
 *              K 方向靠 MmadParams::cmatrixInitVal 在 L0C 上累加。
 *
 *        M 方向切分的关键：M 是 HOUT*WOUT 行主序展平的，切出的 tile 只覆盖部分输出行，
 *        因此每个 tile 需要
 *          1) 反算所需的输入 H 范围 [hinStart, hinStart+hinCount)，只把这些行搬进 L1；
 *          2) 按 tile 位置重算 padTop/padBottom —— 只有贴 fmap 上/下边缘的 tile 才需要 pad，
 *             中间 tile 上方已有真实数据。padLeft/padRight 不变（W 方向不切）。
 *        两者必须成对推导（见 DeriveHRange），保证 hinStart - padTop_tile == houtStart*strideH - padTop，
 *        即 tile 的第 0 个输出行正好对应全局第 houtStart 行。
 *
 *        K 方向切分按 C1 粒度：Slice L1 fmap 的 C1 维后 img2col 读到的 channelSize 自动变小，
 *        对应的 kExtension = KH*KW*(sliceC1*C0)。
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

// ---- 卷积规格（几何参考 pto conv2d_forward 样例）----
constexpr uint32_t N = 4;
constexpr uint32_t C1 = 2;
constexpr uint32_t C0 = 16;
constexpr uint32_t CIN = C1 * C0; // 32
constexpr uint32_t COUT = 128;
constexpr uint32_t H = 16;
constexpr uint32_t W = 96;
constexpr uint32_t KH = 3;
constexpr uint32_t KW = 3;
constexpr uint32_t STRIDE_H = 1;
constexpr uint32_t STRIDE_W = 1;
constexpr uint32_t DILATION_H = 1;
constexpr uint32_t DILATION_W = 1;
constexpr uint32_t PAD_TOP = 1;
constexpr uint32_t PAD_BOTTOM = 1;
constexpr uint32_t PAD_LEFT = 1;
constexpr uint32_t PAD_RIGHT = 1;
constexpr uint32_t PAD_VALUE = 0;

constexpr uint32_t HOUT = (H + PAD_TOP + PAD_BOTTOM - DILATION_H * (KH - 1) - 1) / STRIDE_H + 1; // 16
constexpr uint32_t WOUT = (W + PAD_LEFT + PAD_RIGHT - DILATION_W * (KW - 1) - 1) / STRIDE_W + 1; // 96

constexpr uint32_t M = HOUT * WOUT; // 单 batch 的 M：1536
constexpr uint32_t K = CIN * KH * KW; // 288

// ---- 切分参数 ----
// baseM 必须是 WOUT 的整数倍：保证 tile 按整行对齐，img2col 无需行内偏移(mStartPt)。
constexpr uint32_t ROWS_PER_TILE = 2;
constexpr uint32_t BASE_M = ROWS_PER_TILE * WOUT; // 192
constexpr uint32_t SINGLE_CORE_N = 64;            // 每核负责的 Cout 数
constexpr uint32_t BASE_N = SINGLE_CORE_N;        // N 方向核内不再切
constexpr uint32_t K_SLICE_C1 = 1;                // K 方向按 C1 粒度切，每次取 1 个 C1
constexpr uint32_t BASE_K = K_SLICE_C1 * C0 * KH * KW; // 144

constexpr uint32_t M_LOOP = M / BASE_M;             // 8
constexpr uint32_t K_LOOP = C1 / K_SLICE_C1;        // 2
constexpr uint32_t N_CORE = COUT / SINGLE_CORE_N;   // 2
constexpr uint32_t BLOCK_DIM = N * N_CORE;          // 4 * 2 = 8

// L1 fmap 只装单个 M tile 需要的行，容量按最大 hinCount 预留。
constexpr uint32_t MAX_HIN = (ROWS_PER_TILE - 1) * STRIDE_H + DILATION_H * (KH - 1) + 1; // 4
constexpr uint32_t L1_FMAP_SIZE = C1 * MAX_HIN * W * C0;
constexpr uint32_t L1_WEIGHT_SIZE = K * BASE_N;
constexpr uint32_t CUBE_BLOCK = 16;

constexpr uint32_t FMAP_BATCH_SIZE = C1 * H * W * C0;      // NC1HWC0 单 batch
constexpr uint32_t OUT_BATCH_SIZE = COUT / C0 * HOUT * WOUT * C0; // NC1HWC0 单 batch

// M tile 覆盖输出行 [houtStart, houtEnd] 时，反算输入 H 范围与该 tile 的上下 pad。
// 恒等式 hinStart - padTopTile == houtStart*STRIDE_H - PAD_TOP 保证窗口原点与全局对齐。
struct HRange {
    uint32_t hinStart;
    uint32_t hinCount;
    uint8_t padTop;
    uint8_t padBottom;
};

__aicore__ inline HRange DeriveHRange(uint32_t houtStart, uint32_t houtEnd)
{
    int32_t lo = static_cast<int32_t>(houtStart * STRIDE_H) - static_cast<int32_t>(PAD_TOP);
    int32_t hi = static_cast<int32_t>(houtEnd * STRIDE_H + DILATION_H * (KH - 1)) - static_cast<int32_t>(PAD_TOP);
    int32_t hinStart = lo > 0 ? lo : 0;
    int32_t hinEnd = hi < static_cast<int32_t>(H - 1) ? hi : static_cast<int32_t>(H - 1);
    HRange r;
    r.hinStart = static_cast<uint32_t>(hinStart);
    r.hinCount = static_cast<uint32_t>(hinEnd - hinStart + 1);
    r.padTop = static_cast<uint8_t>(lo < 0 ? -lo : 0);
    r.padBottom = static_cast<uint8_t>(hi > static_cast<int32_t>(H - 1) ? hi - static_cast<int32_t>(H - 1) : 0);
    return r;
}

extern "C" __global__ __cube__ void conv2d_forward_tiling_tensor_api_custom(
    __gm__ half* fmap, __gm__ half* weight, __gm__ half* out)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // 核间二维分核：batchIdx 选 batch，nCoreIdx 选 Cout 段。
    uint32_t blockIdx = AscendC::GetBlockIdx();
    if (blockIdx >= BLOCK_DIM) {
        return;
    }
    uint32_t batchIdx = blockIdx / N_CORE;
    uint32_t nCoreIdx = blockIdx % N_CORE;

    __cbuf__ half l1FmapBuf[L1_FMAP_SIZE];
    __cbuf__ half l1WeightBuf[L1_WEIGHT_SIZE];
    __ca__ half l0ABuf[BASE_M * BASE_K];
    __cb__ half l0BBuf[BASE_K * BASE_N];
    __cc__ float l0CBuf[BASE_M * BASE_N];

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyImg2ColAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    constexpr uint32_t L1_Index = 0;
    constexpr uint32_t L0_Index = 1;
    constexpr uint32_t L0C_Index = 2;

    // GM fmap：本核 batch 的 NC1HWC0(1, C1, H, W, C0)。
    auto gmFmapTensor = MakeTensor(
        MakeMemPtr(fmap + batchIdx * FMAP_BATCH_SIZE),
        MakeFrameLayout<NC1HWC0LayoutPtn>(
            1, static_cast<int32_t>(C1), static_cast<int32_t>(H), static_cast<int32_t>(W),
            static_cast<int32_t>(C0)));

    // GM weight：[K, COUT] 行优先，本核取 Cout 段 [nCoreIdx*SINGLE_CORE_N, +SINGLE_CORE_N)。
    auto gmWeightFull = MakeTensor(MakeMemPtr(weight), MakeFrameLayout<NDExtLayoutPtn>(K, COUT));
    auto l1WeightTensor = MakeTensor(MakeMemPtr(l1WeightBuf), MakeFrameLayout<ZNLayoutPtn, half>(K, BASE_N));

    // weight 整段（K 全长 x 本核 Cout 段）一次搬入 L1，K 方向切分时再从 L1 取子块到 L0B。
    AscendC::Mutex::Lock<PIPE_MTE2>(L1_Index);
    Copy(copyGM2L1Atom, l1WeightTensor,
         gmWeightFull.Slice(MakeCoord(0, nCoreIdx * SINGLE_CORE_N), MakeShape(K, BASE_N)));
    AscendC::Mutex::Unlock<PIPE_MTE2>(L1_Index);

    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, half>(BASE_M, BASE_K));
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, half>(BASE_K, BASE_N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn>(BASE_M, BASE_N));

    // 核内 M 方向分块。
    for (uint32_t mIter = 0; mIter < M_LOOP; ++mIter) {
        uint32_t houtStart = mIter * ROWS_PER_TILE;
        uint32_t houtEnd = houtStart + ROWS_PER_TILE - 1;
        HRange hr = DeriveHRange(houtStart, houtEnd);

        // 只把本 tile 需要的 H 行搬进 L1。L1 侧 C1 步长 = hinCount*W*C0（紧凑），
        // GM 侧 C1 步长 = H*W*C0，两端 stride 各自从 layout 读，通路自动处理。
        auto l1FmapTensor = MakeTensor(
            MakeMemPtr(l1FmapBuf),
            MakeFrameLayout<NC1HWC0LayoutPtn>(
                1, static_cast<int32_t>(C1), static_cast<int32_t>(hr.hinCount), static_cast<int32_t>(W),
                static_cast<int32_t>(C0)));

        AscendC::Mutex::Lock<PIPE_MTE2>(L1_Index);
        Copy(copyGM2L1Atom, l1FmapTensor,
             gmFmapTensor.Slice(
                 MakeCoord(0, 0, hr.hinStart, 0, 0),
                 MakeShape(1, static_cast<int32_t>(C1), static_cast<int32_t>(hr.hinCount), static_cast<int32_t>(W),
                           static_cast<int32_t>(C0))));
        AscendC::Mutex::Unlock<PIPE_MTE2>(L1_Index);
        AscendC::Mutex::Lock<PIPE_MTE1>(L1_Index);

        // 核内 K 方向分块（按 C1 粒度），在 L0C 上累加。
        for (uint32_t kIter = 0; kIter < K_LOOP; ++kIter) {
            Img2ColParams<half> img2colParams;
            img2colParams.filterW = KW;
            img2colParams.filterH = KH;
            img2colParams.mExtension = BASE_M;
            img2colParams.kExtension = BASE_K;
            img2colParams.strideW = STRIDE_W;
            img2colParams.strideH = STRIDE_H;
            img2colParams.dilationFilterW = DILATION_W;
            img2colParams.dilationFilterH = DILATION_H;
            img2colParams.padList[0] = PAD_LEFT;     // left：W 方向不切，保持原值
            img2colParams.padList[1] = PAD_RIGHT;    // right：同上
            img2colParams.padList[2] = hr.padTop;    // top：按 tile 位置重算
            img2colParams.padList[3] = hr.padBottom; // bottom：按 tile 位置重算
            img2colParams.padValue = PAD_VALUE;

            AscendC::Mutex::Lock<PIPE_MTE1>(L0_Index);
            // Slice L1 fmap 的 C1 维：img2col 读到的 channelSize 随之变为 K_SLICE_C1*C0。
            Copy(copyImg2ColAtom.with(img2colParams), l0ATensor,
                 l1FmapTensor.Slice(
                     MakeCoord(0, kIter * K_SLICE_C1, 0, 0, 0),
                     MakeShape(1, static_cast<int32_t>(K_SLICE_C1), static_cast<int32_t>(hr.hinCount),
                               static_cast<int32_t>(W), static_cast<int32_t>(C0))));
            // 对应的 weight K 子块：K 序为 (C1, KH, KW, C0)，按 C1 切即取连续的 BASE_K 行。
            Copy(copyL12L0BAtom, l0BTensor,
                 l1WeightTensor.Slice(MakeCoord(kIter * BASE_K, 0), MakeShape(BASE_K, BASE_N)));
            AscendC::Mutex::Unlock<PIPE_MTE1>(L0_Index);

            AscendC::Mutex::Lock<PIPE_M>(L0_Index);
            MmadParams mmadParams;
            mmadParams.m = BASE_M;
            mmadParams.n = BASE_N;
            mmadParams.k = BASE_K;
            mmadParams.cmatrixInitVal = (kIter == 0); // 首次初始化 L0C，其后累加
            Mmad(mmadAtom.with(mmadParams), l0CTensor, l0ATensor, l0BTensor);
            AscendC::Mutex::Unlock<PIPE_M>(L0_Index);
        }
        AscendC::Mutex::Unlock<PIPE_MTE1>(L1_Index);

        // L0C -> GM：本 tile 覆盖输出行 [houtStart, houtEnd]、Cout 段 [nCoreIdx*SINGLE_CORE_N, +BASE_N)。
        // 输出 NC1HWC0，tile 在 H 方向偏移 houtStart，在 C1 方向偏移 nCoreIdx*BASE_N/C0。
        AscendC::Mutex::Lock<PIPE_M>(L0C_Index);
        AscendC::Mutex::Lock<PIPE_FIX>(L0C_Index);
        auto gmOutTensor = MakeTensor(
            MakeMemPtr(out + batchIdx * OUT_BATCH_SIZE),
            MakeFrameLayout<NC1HWC0LayoutPtn>(
                1, static_cast<int32_t>(COUT / C0), static_cast<int32_t>(HOUT), static_cast<int32_t>(WOUT),
                static_cast<int32_t>(C0)));
        Copy(copyL0C2GMAtom,
             gmOutTensor.Slice(
                 MakeCoord(0, nCoreIdx * (BASE_N / C0), houtStart, 0, 0),
                 MakeShape(1, static_cast<int32_t>(BASE_N / C0), static_cast<int32_t>(ROWS_PER_TILE),
                           static_cast<int32_t>(WOUT), static_cast<int32_t>(C0))),
             l0CTensor);
        AscendC::Mutex::Unlock<PIPE_FIX>(L0C_Index);
        AscendC::Mutex::Unlock<PIPE_M>(L0C_Index);
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmapFileSize = N * FMAP_BATCH_SIZE * sizeof(half);
    size_t weightFileSize = K * COUT * sizeof(half);
    size_t outFileSize = N * OUT_BATCH_SIZE * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmapHost;
    half* fmapDevice;
    aclrtMallocHost((void**)(&fmapHost), fmapFileSize);
    aclrtMalloc((void**)&fmapDevice, fmapFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmapFileSize, fmapHost, fmapFileSize);
    aclrtMemcpy(fmapDevice, fmapFileSize, fmapHost, fmapFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weightHost;
    half* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightFileSize);
    aclrtMalloc((void**)&weightDevice, weightFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weightFileSize, weightHost, weightFileSize);
    aclrtMemcpy(weightDevice, weightFileSize, weightHost, weightFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outHost;
    half* outDevice;
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_tiling_tensor_api_custom<<<BLOCK_DIM, nullptr, stream>>>(fmapDevice, weightDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(fmapDevice);
    aclrtFreeHost(fmapHost);
    aclrtFree(weightDevice);
    aclrtFreeHost(weightHost);
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
