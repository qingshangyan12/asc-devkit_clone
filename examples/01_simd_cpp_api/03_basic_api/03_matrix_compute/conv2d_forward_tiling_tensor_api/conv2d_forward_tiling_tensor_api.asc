/* !
 * \file conv2d_forward_tiling_tensor_api.asc
 * \brief 带切分的 Conv2D Forward 样例（大 Shape），Global Memory 输入输出均为 NC1HWC0。
 *        切分参数、shape 与核数完全对齐 pto conv2d_forward 样例。
 *
 *        规格：fmap NC1HWC0 (4, 32, 16, 96, 16)，Cin = 512，Cout = 6144
 *              M = HOUT*WOUT = 1536（单 batch），K = Cin*KH*KW = 4608
 *
 *        切分结构：
 *          核间：24 核 = batch(4) x nCore(6)。mCoreIdx 即 batch 索引（singleCoreM = 1536 = 整个
 *                batch 的输出），nCoreIdx 选 Cout 段（singleCoreN = 1024）。
 *          核内：mLoop = 1536/128 = 12，nLoop = 1024/256 = 4，kLoop = 4608/48 = 96。
 *                K 方向靠 MmadParams::cmatrixInitVal 在 L0C 上累加。
 *
 *        三处与 pto 对应的关键处理：
 *
 *        1) L1 fmap 大包搬运（每 stepKa 次 kIter 搬一次）
 *           channelSize = stepKa*BASE_K/(KH*KW) = 144/9 = 16 = C0，即一次装一个 C1 块。
 *           L1 只装当前 M tile 需要的 H 行：ceil(BASE_M/WOUT) 行 + (KH-1) 行光环。
 *           kIter 对应的 C1 索引 = kIter*BASE_K/(KH*KW*C0)。
 *
 *        2) img2col 的窗口起点（BASE_M 非整行对齐时必需）
 *           BASE_M = 128、WOUT = 96，M tile 不从整行开始，故
 *             mStartPt = woutStart = (mIter*BASE_M) % WOUT
 *             kStartPt = (kIter % stepKa) * BASE_K   // 一个 C0 块被切成 stepKa 个 baseK
 *
 *        3) L0C -> GM 的部分行写出（重叠覆写）
 *           一个 tile 覆盖 BASE_M 个输出位置，但起点可能在行中间，故按 ceil(BASE_M/WOUT) 整行写出，
 *           mSize = ceil(BASE_M/WOUT)*WOUT >= BASE_M，多余位置由后续 mIter 覆写修正（与 pto 一致）。
 *           dst 用 MakePatternLayout 显式给 stride（等价 pto 的 gStrideOut）：C1 轴步长必须是完整
 *           HOUT*WOUT*C0，而 shape 的 H 只有 tile 行数 —— MakeFrameLayout 会按紧凑布局算错步长。
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

// ---- 卷积规格（与 pto conv2d_forward 完全一致）----
constexpr uint32_t N = 4;
constexpr uint32_t C1 = 32;
constexpr uint32_t C0 = 16;
constexpr uint32_t CIN = C1 * C0; // 512
constexpr uint32_t COUT = 6144;
constexpr uint32_t COUT_C1 = COUT / C0; // 384
constexpr uint32_t H = 16;
constexpr uint32_t W = 96;
constexpr uint32_t KH = 3;
constexpr uint32_t KW = 3;
constexpr uint32_t STRIDE_H = 1;
constexpr uint32_t STRIDE_W = 1;
constexpr uint32_t DILATION_H = 1;
constexpr uint32_t DILATION_W = 1;
constexpr uint32_t PAD_TOP = 1;
constexpr uint32_t PAD_BOTTOM = 1;
constexpr uint32_t PAD_LEFT = 1;
constexpr uint32_t PAD_RIGHT = 1;
constexpr uint32_t PAD_VALUE = 0;

constexpr uint32_t HOUT = (H + PAD_TOP + PAD_BOTTOM - DILATION_H * (KH - 1) - 1) / STRIDE_H + 1; // 16
constexpr uint32_t WOUT = (W + PAD_LEFT + PAD_RIGHT - DILATION_W * (KW - 1) - 1) / STRIDE_W + 1; // 96

constexpr uint32_t M = HOUT * WOUT;   // 1536，单 batch
constexpr uint32_t K = CIN * KH * KW; // 4608

// ---- 切分参数（与 pto 一致）----
constexpr uint32_t SINGLE_CORE_M = M;    // 1536，每核一个完整 batch
constexpr uint32_t SINGLE_CORE_N = 1024; // 每核负责的 Cout 数
constexpr uint32_t SINGLE_CORE_K = K;    // 4608
constexpr uint32_t BASE_M = 128;
constexpr uint32_t BASE_N = 256;
constexpr uint32_t BASE_K = 48;
constexpr uint32_t STEP_KA = 3;
constexpr uint32_t STEP_KB = 3;

constexpr uint32_t M_LOOP = SINGLE_CORE_M / BASE_M; // 12
constexpr uint32_t N_LOOP = SINGLE_CORE_N / BASE_N; // 4
constexpr uint32_t K_LOOP = SINGLE_CORE_K / BASE_K; // 96
constexpr uint32_t N_CORE = COUT / SINGLE_CORE_N;   // 6
constexpr uint32_t BLOCK_DIM = N * N_CORE;          // 24

// channelSize = stepKa*BASE_K/(KH*KW) = 16 = C0：一次 L1 搬运装一个 C1 块。
constexpr uint32_t CHANNEL_SIZE = STEP_KA * BASE_K / (KH * KW);
constexpr uint32_t L1_C1 = CHANNEL_SIZE / C0; // 1
// 一个 M tile 最多跨 ceil(BASE_M/WOUT) 个输出行，加 (KH-1) 行光环。
constexpr uint32_t TILE_OUT_ROWS = (BASE_M + WOUT - 1) / WOUT;                            // 2
constexpr uint32_t MAX_HIN = (TILE_OUT_ROWS - 1) * STRIDE_H + DILATION_H * (KH - 1) + 1;  // 4
constexpr uint32_t L1_FMAP_SIZE = L1_C1 * MAX_HIN * W * C0;
constexpr uint32_t L1_WEIGHT_SIZE = STEP_KB * BASE_K * BASE_N;

constexpr uint32_t FMAP_BATCH_SIZE = C1 * H * W * C0;
constexpr uint32_t OUT_BATCH_SIZE = COUT_C1 * HOUT * WOUT * C0;

// M tile 覆盖输出行 [houtStart, houtEnd] 时，反算所需输入 H 范围与该 tile 的上下 pad。
// 恒等式 hinStart - padTop == houtStart*STRIDE_H - PAD_TOP 保证窗口原点与全局对齐。
struct HRange {
    uint32_t hinStart;
    uint32_t hinCount;
    uint8_t padTop;
    uint8_t padBottom;
};

__aicore__ inline HRange DeriveHRange(uint32_t houtStart, uint32_t houtEnd)
{
    int32_t lo = houtStart * STRIDE_H - PAD_TOP;
    int32_t hi = houtEnd * STRIDE_H + DILATION_H * (KH - 1) - PAD_TOP;
    int32_t hinStart = lo > 0 ? lo : 0;
    int32_t hinEnd = hi < H - 1 ? hi : H - 1;
    HRange r;
    r.hinStart = static_cast<uint32_t>(hinStart);
    r.hinCount = static_cast<uint32_t>(hinEnd - hinStart + 1);
    r.padTop = static_cast<uint8_t>(lo < 0 ? -lo : 0);
    r.padBottom = static_cast<uint8_t>(hi > H - 1 ? hi - H - 1 : 0);
    return r;
}

extern "C" __global__ __cube__ void conv2d_forward_tiling_tensor_api_custom(
    __gm__ half* fmap, __gm__ half* weight, __gm__ half* out)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // 核间二维分核（同 pto InitGMOffsets）：mCoreIdx 即 batch，nCoreIdx 选 Cout 段。
    uint32_t blockIdx = AscendC::GetBlockIdx();
    if (blockIdx >= BLOCK_DIM) {
        return;
    }
    uint32_t batchIdx = blockIdx / N_CORE;
    uint32_t nCoreIdx = blockIdx % N_CORE;

    __cbuf__ half l1FmapBuf[L1_FMAP_SIZE];
    __cbuf__ half l1WeightBuf[L1_WEIGHT_SIZE];
    __ca__ half l0ABuf[BASE_M * BASE_K];
    __cb__ half l0BBuf[BASE_K * BASE_N];
    __cc__ float l0CBuf[BASE_M * BASE_N];

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyImg2ColAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    constexpr uint32_t L1_Index = 0;
    constexpr uint32_t L0_Index = 1;
    constexpr uint32_t L0C_Index = 2;

    // GM fmap：本核 batch 的完整 NC1HWC0。
    auto gmFmapTensor = MakeTensor(
        MakeMemPtr(fmap + batchIdx * FMAP_BATCH_SIZE),
        MakeFrameLayout<NC1HWC0LayoutPtn>(1, C1, H, W, C0));

    // GM weight：[K, COUT] 行优先。K 序 = (C1, KH, KW, C0)，按 C0 块切时是连续的 KH*KW*C0 行。
    auto gmWeightFull = MakeTensor(MakeMemPtr(weight), MakeFrameLayout<NDExtLayoutPtn>(K, COUT));
    auto l1WeightTensor =
        MakeTensor(MakeMemPtr(l1WeightBuf), MakeFrameLayout<ZNLayoutPtn, half>(STEP_KB * BASE_K, BASE_N));

    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, half>(BASE_M, BASE_K));
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, half>(BASE_K, BASE_N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn>(BASE_M, BASE_N));

    // 输出 GM 基址（本核 batch）。每个 tile 用显式 stride 的 layout 定位，见文件头说明 3)。
    __gm__ half* outBase = out + batchIdx * OUT_BATCH_SIZE;
    auto outStride = MakeStride(COUT_C1 * HOUT * WOUT * C0, HOUT * WOUT * C0, WOUT * C0, C0, 1);

    for (uint32_t mIter = 0; mIter < M_LOOP; ++mIter) {
        uint32_t mStart = mIter * BASE_M;
        uint32_t houtStart = mStart / WOUT;
        uint32_t woutStart = mStart % WOUT;             // img2col 的行内起点（mStartPt）
        uint32_t houtEnd = (mStart + BASE_M - 1) / WOUT;
        HRange hr = DeriveHRange(houtStart, houtEnd);

        // 本 tile 的 L1 fmap layout：只装 hinCount 行、L1_C1 个 C1 块。
        auto l1FmapTensor = MakeTensor(
            MakeMemPtr(l1FmapBuf),
            MakeFrameLayout<NC1HWC0LayoutPtn>(1, L1_C1, hr.hinCount, W, C0));

        for (uint32_t nIter = 0; nIter < N_LOOP; ++nIter) {
            uint32_t coutOffset = nCoreIdx * SINGLE_CORE_N + nIter * BASE_N;

            for (uint32_t kIter = 0; kIter < K_LOOP; ++kIter) {
                uint32_t kModStepKa = kIter % STEP_KA;

                // 每 STEP_KA 次 kIter 搬一次 L1（大包搬运），装 kIter 对应的那个 C1 块。
                if (kModStepKa == 0) {
                    uint32_t c1Idx = kIter * BASE_K / (KH * KW * C0);
                    AscendC::Mutex::Lock<PIPE_MTE2>(L1_Index);
                    Copy(copyGM2L1Atom, l1FmapTensor,
                         gmFmapTensor.Slice(
                             MakeCoord(0, c1Idx, hr.hinStart, 0, 0),
                             MakeShape(1, L1_C1, hr.hinCount, W, C0)));
                    // weight：本次 L1 装 STEP_KB*BASE_K 行 x BASE_N 列。
                    Copy(copyGM2L1Atom, l1WeightTensor,
                         gmWeightFull.Slice(
                             MakeCoord(kIter * BASE_K, coutOffset),
                             MakeShape(STEP_KB * BASE_K, BASE_N)));
                    AscendC::Mutex::Unlock<PIPE_MTE2>(L1_Index);
                    AscendC::Mutex::Lock<PIPE_MTE1>(L1_Index);
                }

                Img2ColParams<half> img2colParams;
                img2colParams.filterW = KW;
                img2colParams.filterH = KH;
                img2colParams.mExtension = BASE_M;
                img2colParams.kExtension = BASE_K;
                img2colParams.mStartPt = static_cast<uint16_t>(woutStart);           // 行内起点
                img2colParams.kStartPt = static_cast<uint16_t>(kModStepKa * BASE_K); // C0 块内 K 偏移
                img2colParams.strideW = STRIDE_W;
                img2colParams.strideH = STRIDE_H;
                img2colParams.dilationFilterW = DILATION_W;
                img2colParams.dilationFilterH = DILATION_H;
                img2colParams.padList[0] = PAD_LEFT;
                img2colParams.padList[1] = PAD_RIGHT;
                img2colParams.padList[2] = hr.padTop;    // 按 tile 位置重算
                img2colParams.padList[3] = hr.padBottom; // 按 tile 位置重算
                img2colParams.padValue = PAD_VALUE;

                AscendC::Mutex::Lock<PIPE_MTE1>(L0_Index);
                Copy(copyImg2ColAtom.with(img2colParams), l0ATensor, l1FmapTensor);
                // 从 L1 weight 取本次 BASE_K 子块（对应 kStartPt 所在的那段）。
                Copy(copyL12L0BAtom, l0BTensor,
                     l1WeightTensor.Slice(MakeCoord(kModStepKa * BASE_K, 0), MakeShape(BASE_K, BASE_N)));
                AscendC::Mutex::Unlock<PIPE_MTE1>(L0_Index);

                if ((kIter + 1) % STEP_KA == 0 || kIter + 1 == K_LOOP) {
                    AscendC::Mutex::Unlock<PIPE_MTE1>(L1_Index);
                }

                AscendC::Mutex::Lock<PIPE_M>(L0_Index);
                MmadParams mmadParams;
                mmadParams.m = BASE_M;
                mmadParams.n = BASE_N;
                mmadParams.k = BASE_K;
                mmadParams.cmatrixInitVal = (kIter == 0); // 首次初始化 L0C，其后累加
                Mmad(mmadAtom.with(mmadParams), l0CTensor, l0ATensor, l0BTensor);
                AscendC::Mutex::Unlock<PIPE_M>(L0_Index);
            }

            // L0C -> GM：按 TILE_OUT_ROWS 整行写出（mSize >= BASE_M，多余位置后续 mIter 覆写）。
            // 显式 stride 保证 C1 轴步长是完整 HOUT*WOUT*C0。
            AscendC::Mutex::Lock<PIPE_M>(L0C_Index);
            AscendC::Mutex::Lock<PIPE_FIX>(L0C_Index);
            auto outShape = MakeShape(1, BASE_N / C0, TILE_OUT_ROWS, WOUT, C0);
            auto gmOutTile = MakeTensor(
                MakeMemPtr(outBase + coutOffset / C0 * (HOUT * WOUT * C0) + mStart * C0),
                MakePatternLayout<NC1HWC0LayoutPtn, LayoutTraitDefault<half>>(outShape, outStride));
            Copy(copyL0C2GMAtom, gmOutTile, l0CTensor);
            AscendC::Mutex::Unlock<PIPE_FIX>(L0C_Index);
            AscendC::Mutex::Unlock<PIPE_M>(L0C_Index);
        }
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmapFileSize = static_cast<size_t>(N) * FMAP_BATCH_SIZE * sizeof(half);
    size_t weightFileSize = static_cast<size_t>(K) * COUT * sizeof(half);
    size_t outFileSize = static_cast<size_t>(N) * OUT_BATCH_SIZE * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmapHost;
    half* fmapDevice;
    aclrtMallocHost((void**)(&fmapHost), fmapFileSize);
    aclrtMalloc((void**)&fmapDevice, fmapFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmapFileSize, fmapHost, fmapFileSize);
    aclrtMemcpy(fmapDevice, fmapFileSize, fmapHost, fmapFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weightHost;
    half* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightFileSize);
    aclrtMalloc((void**)&weightDevice, weightFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weightFileSize, weightHost, weightFileSize);
    aclrtMemcpy(weightDevice, weightFileSize, weightHost, weightFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outHost;
    half* outDevice;
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_tiling_tensor_api_custom<<<BLOCK_DIM, nullptr, stream>>>(fmapDevice, weightDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(fmapDevice);
    aclrtFreeHost(fmapHost);
    aclrtFree(weightDevice);
    aclrtFreeHost(weightHost);
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
