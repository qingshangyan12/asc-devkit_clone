/* !
 * \file load_data_l0b_start_index.asc
 * \brief 使用LoadData2DParams.startIndex选择L1中的K方向分形，并将矩阵搬运到L0B Buffer。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

namespace {

#if SCENARIO_NUM == 1
constexpr uint32_t BLOCK_DIM = 2;
constexpr uint32_t M = 16;
constexpr uint32_t N = 16;
constexpr uint32_t K = 32;
#elif SCENARIO_NUM == 2
constexpr uint32_t BLOCK_DIM = 1;
constexpr uint32_t M = 32;
constexpr uint32_t N = 32;
constexpr uint32_t K = 32;
#else
#error "SCENARIO_NUM must be 1 or 2"
#endif
constexpr uint32_t FRACTAL_EDGE = 16;
constexpr uint32_t FRACTAL_ELEMENTS = FRACTAL_EDGE * FRACTAL_EDGE;
constexpr uint32_t A_ELEMENTS = M * K;
constexpr uint32_t B_ELEMENTS = K * N;
constexpr uint32_t C_ELEMENTS = M * N;

class KernelLoadDataL0BStartIndex {
public:
    __aicore__ inline void Init(__gm__ half* srcA, __gm__ half* srcB, __gm__ float* dst)
    {
        const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        srcAGm_.SetGlobalBuffer(srcA + blockIdx * A_ELEMENTS, A_ELEMENTS);
        srcBGm_.SetGlobalBuffer(srcB + blockIdx * B_ELEMENTS, B_ELEMENTS);
        dstGm_.SetGlobalBuffer(dst + blockIdx * C_ELEMENTS, C_ELEMENTS);

        pipe_.InitBuffer(aL1Queue_, 1, A_ELEMENTS * sizeof(half));
        pipe_.InitBuffer(bL1Queue_, 1, B_ELEMENTS * sizeof(half));
        pipe_.InitBuffer(aL0Queue_, 1, A_ELEMENTS * sizeof(half));
        pipe_.InitBuffer(bL0Queue_, 1, B_ELEMENTS * sizeof(half));
        pipe_.InitBuffer(cL0Queue_, 1, C_ELEMENTS * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> aL1 = aL1Queue_.AllocTensor<half>();
        AscendC::LocalTensor<half> bL1 = bL1Queue_.AllocTensor<half>();
        CopyIn(aL1, bL1);
        aL1Queue_.EnQue(aL1);
        bL1Queue_.EnQue(bL1);

        AscendC::LocalTensor<half> aL1Ready = aL1Queue_.DeQue<half>();
        AscendC::LocalTensor<half> bL1Ready = bL1Queue_.DeQue<half>();
        AscendC::LocalTensor<half> aL0 = aL0Queue_.AllocTensor<half>();
        AscendC::LocalTensor<half> bL0 = bL0Queue_.AllocTensor<half>();
        LoadA(aL0, aL1Ready);
        LoadB(bL0, bL1Ready);
        aL0Queue_.EnQue(aL0);
        bL0Queue_.EnQue(bL0);
        aL1Queue_.FreeTensor(aL1Ready);
        bL1Queue_.FreeTensor(bL1Ready);

        AscendC::LocalTensor<half> aL0Ready = aL0Queue_.DeQue<half>();
        AscendC::LocalTensor<half> bL0Ready = bL0Queue_.DeQue<half>();
        AscendC::LocalTensor<float> cL0 = cL0Queue_.AllocTensor<float>();
        Compute(cL0, aL0Ready, bL0Ready);
        cL0Queue_.EnQue(cL0);
        aL0Queue_.FreeTensor(aL0Ready);
        bL0Queue_.FreeTensor(bL0Ready);

        AscendC::LocalTensor<float> cL0Ready = cL0Queue_.DeQue<float>();
        CopyOut(cL0Ready);
        cL0Queue_.FreeTensor(cL0Ready);
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<half>& aL1, AscendC::LocalTensor<half>& bL1)
    {
#if SCENARIO_NUM == 2 && defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        AscendC::Nd2NzParams aParams(1, M, K, 0, K, M, 1, 0);
        AscendC::Nd2NzParams bParams(1, K, N, 0, N, K, 1, 0);
#else
        AscendC::Nd2NzParams aParams(M / FRACTAL_EDGE, FRACTAL_EDGE, K, FRACTAL_EDGE * K, K,
            FRACTAL_EDGE, 1, FRACTAL_EDGE * K);
        AscendC::Nd2NzParams bParams(K / FRACTAL_EDGE, FRACTAL_EDGE, N, FRACTAL_EDGE * N, N,
            FRACTAL_EDGE, 1, FRACTAL_EDGE * N);
#endif
        AscendC::DataCopy(aL1, srcAGm_, aParams);
        AscendC::DataCopy(bL1, srcBGm_, bParams);
    }

    __aicore__ inline void LoadA(AscendC::LocalTensor<half>& dst, AscendC::LocalTensor<half>& src)
    {
        constexpr uint32_t mFractals = M / FRACTAL_EDGE;
        constexpr uint32_t kFractals = K / FRACTAL_EDGE;
        for (uint32_t mIdx = 0; mIdx < mFractals; ++mIdx) {
            AscendC::LoadData2DParams params(0, kFractals, mFractals, 0, 0, false, 0);
            AscendC::LoadData(dst[mIdx * K * FRACTAL_EDGE], src[mIdx * FRACTAL_ELEMENTS], params);
        }
    }

    __aicore__ inline void LoadB(AscendC::LocalTensor<half>& dst, AscendC::LocalTensor<half>& src)
    {
        constexpr uint32_t nFractals = N / FRACTAL_EDGE;
        constexpr uint32_t kFractals = K / FRACTAL_EDGE;
        for (uint32_t kIdx = 0; kIdx < kFractals; ++kIdx) {
#if SCENARIO_NUM == 2 && defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
            AscendC::LoadData2DParams params(0, nFractals, kFractals, 0, 0, true, 0);
            AscendC::LoadData(dst[kIdx * N * FRACTAL_EDGE], src[kIdx * FRACTAL_ELEMENTS], params);
#elif SCENARIO_NUM == 2 || (defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510))
            AscendC::LoadData2DParams params(0, nFractals, 1, 0, 0, true, 0);
            AscendC::LoadData(dst[kIdx * N * FRACTAL_EDGE],
                src[kIdx * nFractals * FRACTAL_ELEMENTS], params);
#else
            AscendC::LoadData2DParams params(kIdx * nFractals, nFractals, 1, 0, 0, true, 0);
            AscendC::LoadData(dst[kIdx * N * FRACTAL_EDGE], src, params);
#endif
        }
    }

    __aicore__ inline void Compute(AscendC::LocalTensor<float>& dst, AscendC::LocalTensor<half>& srcA,
        AscendC::LocalTensor<half>& srcB)
    {
        AscendC::MmadParams params;
        params.m = M;
        params.n = N;
        params.k = K;
        params.unitFlag = 3;
        params.cmatrixSource = false;
        params.cmatrixInitVal = true;
        AscendC::Mmad(dst, srcA, srcB, params);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float>& src)
    {
        AscendC::FixpipeParamsV220 params;
        params.nSize = N;
        params.mSize = M;
        params.srcStride = M;
        params.dstStride = N;
        params.quantPre = QuantMode_t::NoQuant;
        params.ndNum = 1;
        params.srcNdStride = 0;
        params.dstNdStride = 0;
        params.unitFlag = 3;
        AscendC::Fixpipe<float, float, AscendC::CFG_ROW_MAJOR>(dstGm_, src, params);
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::A1, 1> aL1Queue_;
    AscendC::TQue<AscendC::QuePosition::B1, 1> bL1Queue_;
    AscendC::TQue<AscendC::QuePosition::A2, 1> aL0Queue_;
    AscendC::TQue<AscendC::QuePosition::B2, 1> bL0Queue_;
    AscendC::TQue<AscendC::QuePosition::CO1, 1> cL0Queue_;
    AscendC::GlobalTensor<half> srcAGm_;
    AscendC::GlobalTensor<half> srcBGm_;
    AscendC::GlobalTensor<float> dstGm_;
};

}  // namespace

extern "C" __global__ __aicore__ void LoadDataL0BStartIndex(GM_ADDR srcA, GM_ADDR srcB, GM_ADDR dst)
{
    if ASCEND_IS_AIV {
        return;
    }
    AscendC::InitSocState();
    KernelLoadDataL0BStartIndex op;
    op.Init(reinterpret_cast<__gm__ half*>(srcA), reinterpret_cast<__gm__ half*>(srcB),
        reinterpret_cast<__gm__ float*>(dst));
    op.Process();
}

bool CheckAcl(aclError error, const char* operation)
{
    if (error == ACL_SUCCESS) {
        return true;
    }
    const char* recentError = aclGetRecentErrMsg();
    ERROR_LOG("%s failed, error code: %d, message: %s", operation, static_cast<int32_t>(error),
        recentError == nullptr ? "<none>" : recentError);
    return false;
}

int32_t main()
{
    constexpr size_t aBytes = BLOCK_DIM * A_ELEMENTS * sizeof(uint16_t);
    constexpr size_t bBytes = BLOCK_DIM * B_ELEMENTS * sizeof(uint16_t);
    constexpr size_t cBytes = BLOCK_DIM * C_ELEMENTS * sizeof(float);
    int32_t result = 1;
    uint8_t* aHost = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* cHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* cDevice = nullptr;
    aclrtStream stream = nullptr;

    if (!CheckAcl(aclInit(nullptr), "aclInit") || !CheckAcl(aclrtSetDevice(0), "aclrtSetDevice") ||
        !CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&aHost), aBytes), "aclrtMallocHost A") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&bHost), bBytes), "aclrtMallocHost B") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&cHost), cBytes), "aclrtMallocHost C") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&aDevice), aBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc A") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&bDevice), bBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc B") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&cDevice), cBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc C")) {
        goto cleanup;
    }

    {
        size_t aFileSize = aBytes;
        size_t bFileSize = bBytes;
        if (!ReadFile("./input/x1_gm.bin", aFileSize, aHost, aBytes) || aFileSize != aBytes ||
            !ReadFile("./input/x2_gm.bin", bFileSize, bHost, bBytes) || bFileSize != bBytes) {
            goto cleanup;
        }
    }
    if (!CheckAcl(aclrtMemcpy(aDevice, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy A to device") ||
        !CheckAcl(aclrtMemcpy(bDevice, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy B to device")) {
        goto cleanup;
    }

    LoadDataL0BStartIndex<<<BLOCK_DIM, nullptr, stream>>>(aDevice, bDevice, cDevice);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !CheckAcl(aclrtMemcpy(cHost, cBytes, cDevice, cBytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy output to host") ||
        !WriteFile("./output/output.bin", cHost, cBytes)) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (aDevice != nullptr) {
        aclrtFree(aDevice);
    }
    if (bDevice != nullptr) {
        aclrtFree(bDevice);
    }
    if (cDevice != nullptr) {
        aclrtFree(cDevice);
    }
    if (aHost != nullptr) {
        aclrtFreeHost(aHost);
    }
    if (bHost != nullptr) {
        aclrtFreeHost(bHost);
    }
    if (cHost != nullptr) {
        aclrtFreeHost(cHost);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(0);
    aclFinalize();
    return result;
}
