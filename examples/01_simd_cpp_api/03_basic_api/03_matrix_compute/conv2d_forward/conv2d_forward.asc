/* !
 * \file conv2d_forward.asc
 * \brief 实现 Conv2D Forward样例。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

constexpr uint32_t BLOCK_DIM = 4;
constexpr uint32_t BATCH = 4;
constexpr uint32_t C1 = 2;
constexpr uint32_t H = 9;
constexpr uint32_t W = 9;
constexpr uint32_t C0 = 16;
constexpr uint32_t CIN = C1 * C0;
constexpr uint32_t COUT = 16;
constexpr uint32_t KH = 3;
constexpr uint32_t KW = 3;
constexpr uint32_t STRIDE_H = 2;
constexpr uint32_t STRIDE_W = 2;
constexpr uint32_t DILATION_H = 2;
constexpr uint32_t DILATION_W = 2;
constexpr uint32_t PAD_LEFT = 2;
constexpr uint32_t PAD_RIGHT = 2;
constexpr uint32_t PAD_TOP = 2;
constexpr uint32_t PAD_BOTTOM = 2;

constexpr uint32_t HOUT = (H + PAD_TOP + PAD_BOTTOM - DILATION_H * (KH - 1) - 1) / STRIDE_H + 1;
constexpr uint32_t WOUT = (W + PAD_LEFT + PAD_RIGHT - DILATION_W * (KW - 1) - 1) / STRIDE_W + 1;
constexpr uint32_t M = HOUT * WOUT;
constexpr uint32_t K = C1 * C0 * KH * KW;
constexpr uint32_t N = COUT;
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M_ALIGN = (M + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;
constexpr uint32_t K_ALIGN = (K + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;
constexpr uint32_t N_ALIGN = (N + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;

constexpr uint32_t FMAP_BATCH_SIZE = H * W * CIN;          // 单个batch的FeatureMap元素数。
constexpr uint32_t WEIGHT_GM_SIZE = COUT * K;              // Weight在GM上的元素数
constexpr uint32_t OUT_GM_BATCH_SIZE = HOUT * WOUT * COUT; // 单个batch的输出元素数(GM上NHWC布局)

template <typename T>
__aicore__ inline void CopyIn(
    const AscendC::GlobalTensor<T>& fmapGM, const AscendC::GlobalTensor<T>& weightGM, AscendC::LocalTensor<T>& a1Local,
    AscendC::LocalTensor<T>& b1Local)
{
#if SCENARIO_NUM != 4
    // 场景1/2/3：FeatureMap GM为NHWC=[H*W, CIN]，Weight GM为[K, Cout]，均走Nd2Nz随路转换。
    // Nd2Nz按C0=16将CIN切成C1个通道块，dstNzC0Stride=H*W使每个C0块按H*W连续，得到NC1HWC0。
    AscendC::Nd2NzParams nd2nzFmapParams;
    nd2nzFmapParams.ndNum = 1;
    nd2nzFmapParams.nValue = H * W;
    nd2nzFmapParams.dValue = CIN;
    nd2nzFmapParams.srcNdMatrixStride = 0;
    nd2nzFmapParams.srcDValue = CIN;
    nd2nzFmapParams.dstNzC0Stride = H * W;
    nd2nzFmapParams.dstNzNStride = 1;
    nd2nzFmapParams.dstNzMatrixStride = 0;
    AscendC::DataCopy(a1Local, fmapGM, nd2nzFmapParams);

    // Weight [K, Cout] 经Nd2Nz转为L1上的[K, Cout] NZ分形，再由LoadData2D转置搬到L0B。
    AscendC::Nd2NzParams nd2nzWeightParams;
    nd2nzWeightParams.ndNum = 1;
    nd2nzWeightParams.nValue = K;
    nd2nzWeightParams.dValue = COUT;
    nd2nzWeightParams.srcNdMatrixStride = 0;
    nd2nzWeightParams.srcDValue = COUT;
    nd2nzWeightParams.dstNzC0Stride = K_ALIGN;
    nd2nzWeightParams.dstNzNStride = 1;
    nd2nzWeightParams.dstNzMatrixStride = 0;
    AscendC::DataCopy(b1Local, weightGM, nd2nzWeightParams);
#else
    // 场景2（仅dav-3510）：FeatureMap GM为CHW=[CIN, H*W]通道优先，Weight GM为[Cout, K]，均走Dn2Nz。
    AscendC::Dn2NzParams dn2nzFmapParams;
    dn2nzFmapParams.dnNum = 1;
    dn2nzFmapParams.nValue = H * W;
    dn2nzFmapParams.dValue = CIN;
    dn2nzFmapParams.srcDnMatrixStride = 0;
    dn2nzFmapParams.srcDValue = H * W;
    dn2nzFmapParams.dstNzC0Stride = H * W;
    dn2nzFmapParams.dstNzNStride = 1;
    dn2nzFmapParams.dstNzMatrixStride = 0;
    AscendC::DataCopy(a1Local, fmapGM, dn2nzFmapParams);

    // Weight [Cout, K] 经Dn2Nz转为L1上的[K, Cout] NZ分形，再由LoadData2D转置搬到L0B。
    AscendC::Dn2NzParams dn2nzWeightParams;
    dn2nzWeightParams.dnNum = 1;
    dn2nzWeightParams.nValue = K;
    dn2nzWeightParams.dValue = COUT;
    dn2nzWeightParams.srcDnMatrixStride = 0;
    dn2nzWeightParams.srcDValue = K;
    dn2nzWeightParams.dstNzC0Stride = K_ALIGN;
    dn2nzWeightParams.dstNzNStride = 1;
    dn2nzWeightParams.dstNzMatrixStride = 0;
    AscendC::DataCopy(b1Local, weightGM, dn2nzWeightParams);
#endif
}

template <typename T>
__aicore__ inline void DataLoadA(AscendC::LocalTensor<T>& a2Local, AscendC::LocalTensor<T>& a1Local)
{
    AscendC::LoadData3DParamsV2<T> loadDataParams;
    loadDataParams.padList[0] = PAD_LEFT;
    loadDataParams.padList[1] = PAD_RIGHT;
    loadDataParams.padList[2] = PAD_TOP;
    loadDataParams.padList[3] = PAD_BOTTOM;
    loadDataParams.l1H = H;
    loadDataParams.l1W = W;
    loadDataParams.channelSize = C1 * C0;
#if SCENARIO_NUM == 2
    // 场景2：沿K(width)方向分块repeat。mExtension=M保持不变(避免M方向越界)，
    // 单次迭代搬K_ALIGN/repeatTime宽的K分块，沿K方向repeat共repeatTime次，
    constexpr uint32_t FMAP_REPEAT_TIME = 2;                     // K方向迭代次数
    loadDataParams.kExtension = K_ALIGN / FMAP_REPEAT_TIME;      // 每次迭代搬运的K宽度(须16对齐)
    loadDataParams.mExtension = M;
    constexpr uint32_t FMAP_REPEAT_MODE = 1;                     // 1:沿width(K)方向迭代
    constexpr uint32_t FMAP_REPEAT_STRIDE = (K_ALIGN / FMAP_REPEAT_TIME) / CUBE_BLOCK; // 每次K推进的分形数
    constexpr uint32_t FMAP_DST_STRIDE = M_ALIGN / CUBE_BLOCK;   // dav-3510: dstStride=CeilDiv(mExtension,16)，与repeat方向无关
#else
    loadDataParams.kExtension = K_ALIGN;
    loadDataParams.mExtension = M;
    constexpr uint32_t FMAP_REPEAT_TIME = 1;
    constexpr uint32_t FMAP_REPEAT_MODE = 0;
    constexpr uint32_t FMAP_REPEAT_STRIDE = 1;
    constexpr uint32_t FMAP_DST_STRIDE = M_ALIGN / CUBE_BLOCK;
#endif
    loadDataParams.kStartPt = 0;
    loadDataParams.mStartPt = 0;
    loadDataParams.strideW = STRIDE_W;
    loadDataParams.strideH = STRIDE_H;
    loadDataParams.filterW = KW;
    loadDataParams.filterH = KH;
    loadDataParams.dilationFilterW = DILATION_W;
    loadDataParams.dilationFilterH = DILATION_H;
    loadDataParams.enTranspose = false;
    loadDataParams.enSmallK = false;
    loadDataParams.filterSizeW = false;
    loadDataParams.filterSizeH = false;
    loadDataParams.fMatrixCtrl = 0;
    loadDataParams.padValue = 0;   // 结构体padValue字段；场景3改用显式接口设填充值，此字段不生效
#if SCENARIO_NUM == 3
    // 场景3：isSetFMatrix与isSetPadding均为false，结构体的l1H/l1W/padList与padValue字段均不生效，
    // 必须在Load3D前显式调用SetFmatrix设置FeatureMap属性、SetLoadDataPaddingValue设置pad填充值。
    // SetFmatrix的fmatrixMode需与loadDataParams.fMatrixCtrl(=0)一致，取FMATRIX_LEFT。两架构均支持。
    static constexpr AscendC::IsResetLoad3dConfig FMAP_LOAD3D_CONFIG = {false, false};
    const uint8_t fmatrixPadList[4] = {PAD_LEFT, PAD_RIGHT, PAD_TOP, PAD_BOTTOM};
    AscendC::SetFmatrix(H, W, fmatrixPadList, AscendC::FmatrixMode::FMATRIX_LEFT);
    AscendC::SetLoadDataPaddingValue(static_cast<T>(1));
#else
    static constexpr AscendC::IsResetLoad3dConfig FMAP_LOAD3D_CONFIG = AscendC::IS_RESER_LOAD3D_DEFAULT_CONFIG;
#endif
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    // dav-3510上LoadData3DV2必须先通过SetLoadDataRepeatWithStride配置repeat寄存器，
    AscendC::LoadDataRepeatParamWithStride repeatParams;
    repeatParams.repeatTime = FMAP_REPEAT_TIME;                  // 迭代次数
    repeatParams.repeatStride = FMAP_REPEAT_STRIDE;             // 前后迭代起始位置距离
    repeatParams.repeatMode = FMAP_REPEAT_MODE;                  // 0:沿height(M) 1:沿width(K)
    repeatParams.dstStride = FMAP_DST_STRIDE;                    // 单次迭代输出在K轴方向的分形偏移
    AscendC::SetLoadDataRepeatWithStride(repeatParams);
    AscendC::LoadDataWithStride<T, FMAP_LOAD3D_CONFIG>(a2Local, a1Local, loadDataParams);
#else
    // dav-2201：通过SetLoadDataRepeat配置L3DRPT寄存器（无dstStride字段）
    AscendC::LoadDataRepeatParam repeatParams;
    repeatParams.repeatTime = FMAP_REPEAT_TIME;
    repeatParams.repeatStride = FMAP_REPEAT_STRIDE;
    repeatParams.repeatMode = FMAP_REPEAT_MODE;
    AscendC::SetLoadDataRepeat(repeatParams);
    AscendC::LoadData<T, FMAP_LOAD3D_CONFIG>(a2Local, a1Local, loadDataParams);
#endif
}

template <typename T>
__aicore__ inline void DataLoadB(AscendC::LocalTensor<T>& b2Local, AscendC::LocalTensor<T>& b1Local)
{
    AscendC::LoadData2DParams loadDataParams;
    loadDataParams.startIndex = 0;
    loadDataParams.repeatTimes = K_ALIGN / CUBE_BLOCK * (N_ALIGN / CUBE_BLOCK);
    loadDataParams.srcStride = 1;
    loadDataParams.dstGap = 0;
    loadDataParams.ifTranspose = true;
    AscendC::LoadData(b2Local, b1Local, loadDataParams);
}

template <typename T>
__aicore__ inline void Compute(
    AscendC::LocalTensor<float>& co1Local, AscendC::LocalTensor<T>& a2Local, AscendC::LocalTensor<T>& b2Local)
{
    AscendC::MmadParams mmParams;
    mmParams.m = M;
    mmParams.n = N;
    mmParams.k = K_ALIGN;
    mmParams.cmatrixInitVal = true;
    AscendC::Mmad(co1Local, a2Local, b2Local, mmParams);
}

template <typename T>
__aicore__ inline void CopyOut(AscendC::GlobalTensor<T>& outGM, AscendC::LocalTensor<float>& co1Local)
{
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    // dav-3510使用FixpipeParamsArch3510，可直接配置CO2Layout为ROW_MAJOR输出NHWC。
    AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fixpipeParams;
    fixpipeParams.nSize = N;
    fixpipeParams.mSize = M;
    fixpipeParams.srcStride = M_ALIGN;
    fixpipeParams.dstStride = N;
    fixpipeParams.reluEn = false;
    fixpipeParams.quantPre = QuantMode_t::F322F16;
    fixpipeParams.deqScalar = 0;
    fixpipeParams.unitFlag = 0;
    AscendC::Fixpipe<T, float, AscendC::CFG_ROW_MAJOR>(outGM, co1Local, fixpipeParams);
#else
    // dav-2201使用FixpipeParamsV220，通过ndNum/dstNdStride将L0C的NZ结果转为ND(NHWC)搬回GM。
    AscendC::FixpipeParamsV220 fixpipeParams;
    fixpipeParams.nSize = N;
    fixpipeParams.mSize = M;
    fixpipeParams.srcStride = M_ALIGN;
    fixpipeParams.dstStride = N;
    fixpipeParams.reluEn = false;
    fixpipeParams.quantPre = QuantMode_t::F322F16;
    fixpipeParams.deqScalar = 0;
    fixpipeParams.ndNum = 1;
    fixpipeParams.srcNdStride = 0;
    fixpipeParams.dstNdStride = 0;
    fixpipeParams.unitFlag = 0;
    AscendC::Fixpipe(outGM, co1Local, fixpipeParams);
#endif
}

extern "C" __global__ __cube__ void conv2d_forward_custom(
    __gm__ uint8_t* fmap, __gm__ uint8_t* weight, __gm__ uint8_t* out)
{
    AscendC::InitSocState();
    uint32_t batchIdx = AscendC::GetBlockIdx();
    if (batchIdx >= BATCH) {
        return;
    }

    AscendC::GlobalTensor<half> fmapGM;
    AscendC::GlobalTensor<half> weightGM;
    AscendC::GlobalTensor<half> outGM;
    fmapGM.SetGlobalBuffer((__gm__ half*)fmap + batchIdx * FMAP_BATCH_SIZE);
    weightGM.SetGlobalBuffer((__gm__ half*)weight);
    outGM.SetGlobalBuffer((__gm__ half*)out + batchIdx * OUT_GM_BATCH_SIZE);

    // L1上fmap从0起、weight紧随其后；L0A/L0B/L0C各自独立空间，起始地址均为0。
    AscendC::LocalTensor<half> a1Local(AscendC::TPosition::A1, 0, FMAP_BATCH_SIZE);
    AscendC::LocalTensor<half> b1Local(AscendC::TPosition::B1, FMAP_BATCH_SIZE * sizeof(half), K_ALIGN * N_ALIGN);
    AscendC::LocalTensor<half> a2Local(AscendC::TPosition::A2, 0, M_ALIGN * K_ALIGN);
    AscendC::LocalTensor<half> b2Local(AscendC::TPosition::B2, 0, K_ALIGN * N_ALIGN);
    AscendC::LocalTensor<float> co1Local(AscendC::TPosition::CO1, 0, M_ALIGN * N_ALIGN);

    CopyIn(fmapGM, weightGM, a1Local, b1Local);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

    DataLoadA(a2Local, a1Local);
    DataLoadB(b2Local, b1Local);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

    Compute(co1Local, a2Local, b2Local);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

    CopyOut(outGM, co1Local);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmapFileSize = BATCH * FMAP_BATCH_SIZE * sizeof(half);
    size_t weightFileSize = WEIGHT_GM_SIZE * sizeof(half);
    size_t outFileSize = BATCH * OUT_GM_BATCH_SIZE * sizeof(half);
    uint32_t numBlocks = BLOCK_DIM;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmapHost;
    uint8_t* fmapDevice;
    aclrtMallocHost((void**)(&fmapHost), fmapFileSize);
    aclrtMalloc((void**)&fmapDevice, fmapFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmapFileSize, fmapHost, fmapFileSize);
    aclrtMemcpy(fmapDevice, fmapFileSize, fmapHost, fmapFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weightHost;
    uint8_t* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightFileSize);
    aclrtMalloc((void**)&weightDevice, weightFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weightFileSize, weightHost, weightFileSize);
    aclrtMemcpy(weightDevice, weightFileSize, weightHost, weightFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outHost;
    uint8_t* outDevice;
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_custom<<<numBlocks, nullptr, stream>>>(fmapDevice, weightDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(fmapDevice);
    aclrtFreeHost(fmapHost);
    aclrtFree(weightDevice);
    aclrtFreeHost(weightHost);
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
