/* !
 * \file conv2d_forward.asc
 * \brief 使用基础API在dav-3510架构上实现一个小shape Conv2D Forward样例。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

constexpr uint32_t BLOCK_DIM = 4;
constexpr uint32_t BATCH = 4;
constexpr uint32_t C1 = 1;
constexpr uint32_t H = 4;
constexpr uint32_t W = 4;
constexpr uint32_t C0 = 16;
constexpr uint32_t CIN = C1 * C0;
constexpr uint32_t COUT = 16;
constexpr uint32_t KH = 1;
constexpr uint32_t KW = 1;
constexpr uint32_t STRIDE_H = 1;
constexpr uint32_t STRIDE_W = 1;
constexpr uint32_t DILATION_H = 1;
constexpr uint32_t DILATION_W = 1;
constexpr uint32_t PAD_LEFT = 0;
constexpr uint32_t PAD_RIGHT = 0;
constexpr uint32_t PAD_TOP = 0;
constexpr uint32_t PAD_BOTTOM = 0;

constexpr uint32_t HOUT = (H + PAD_TOP + PAD_BOTTOM - DILATION_H * (KH - 1) - 1) / STRIDE_H + 1;
constexpr uint32_t WOUT = (W + PAD_LEFT + PAD_RIGHT - DILATION_W * (KW - 1) - 1) / STRIDE_W + 1;
constexpr uint32_t M = HOUT * WOUT;
constexpr uint32_t K = C1 * C0 * KH * KW;
constexpr uint32_t N = COUT;
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M_ALIGN = (M + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;
constexpr uint32_t K_ALIGN = (K + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;
constexpr uint32_t N_ALIGN = (N + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;
constexpr uint32_t FMAP_HW_ALIGN = (H * W + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK;
constexpr uint32_t FMAP_GM_BATCH_SIZE = H * W * CIN;
constexpr uint32_t FMAP_L1_SIZE = FMAP_HW_ALIGN * CIN;
constexpr uint32_t WEIGHT_GM_SIZE = COUT * CIN * KH * KW;
constexpr uint32_t WEIGHT_L1_SIZE = K_ALIGN * N_ALIGN;
constexpr uint32_t OUT_GM_BATCH_SIZE = HOUT * WOUT * COUT;
constexpr uint64_t L1_FMAP_ADDR = 0;
constexpr uint64_t L1_WEIGHT_ADDR = FMAP_L1_SIZE * sizeof(half);
constexpr uint64_t L0_ADDR = 0;

template <typename T>
__aicore__ inline void CopyIn(
    const AscendC::GlobalTensor<T>& fmapGM, const AscendC::GlobalTensor<T>& weightGM, AscendC::LocalTensor<T>& fmapL1,
    AscendC::LocalTensor<T>& weightL1)
{
    // FeatureMap GM格式为NHWC。当前C=16且H*W=16，ND2NZ后L1线性布局可作为NC1HWC0输入。
    AscendC::Nd2NzParams nd2nzFmapParams;
    nd2nzFmapParams.ndNum = 1;
    nd2nzFmapParams.nValue = H * W;
    nd2nzFmapParams.dValue = CIN;
    nd2nzFmapParams.srcNdMatrixStride = 0;
    nd2nzFmapParams.srcDValue = CIN;
    nd2nzFmapParams.dstNzC0Stride = FMAP_HW_ALIGN;
    nd2nzFmapParams.dstNzNStride = 1;
    nd2nzFmapParams.dstNzMatrixStride = 0;
    AscendC::DataCopy(fmapL1, fmapGM, nd2nzFmapParams);

    // Weight GM格式为NCHW，flatten为[Cout, C1 * Kh * Kw * C0]，DN2NZ后得到[K, Cout]分形布局。
    AscendC::Dn2NzParams dn2nzWeightParams;
    dn2nzWeightParams.dnNum = 1;
    dn2nzWeightParams.dValue = COUT;
    dn2nzWeightParams.nValue = K;
    dn2nzWeightParams.srcDnMatrixStride = 0;
    dn2nzWeightParams.srcDValue = K;
    dn2nzWeightParams.dstNzC0Stride = K_ALIGN;
    dn2nzWeightParams.dstNzNStride = 1;
    dn2nzWeightParams.dstNzMatrixStride = 0;
    AscendC::DataCopy(weightL1, weightGM, dn2nzWeightParams);
}

template <typename T>
__aicore__ inline void LoadFmapToL0A(AscendC::LocalTensor<T>& a2Local, AscendC::LocalTensor<T>& fmapL1)
{
    AscendC::LoadData3DParamsV2<T> loadDataParams;
    loadDataParams.padList[0] = PAD_LEFT;
    loadDataParams.padList[1] = PAD_RIGHT;
    loadDataParams.padList[2] = PAD_TOP;
    loadDataParams.padList[3] = PAD_BOTTOM;
    loadDataParams.l1H = H;
    loadDataParams.l1W = W;
    loadDataParams.channelSize = C1 * C0;
    loadDataParams.kExtension = K_ALIGN;
    loadDataParams.mExtension = M_ALIGN;
    loadDataParams.kStartPt = 0;
    loadDataParams.mStartPt = 0;
    loadDataParams.strideW = STRIDE_W;
    loadDataParams.strideH = STRIDE_H;
    loadDataParams.filterW = KW;
    loadDataParams.filterH = KH;
    loadDataParams.dilationFilterW = DILATION_W;
    loadDataParams.dilationFilterH = DILATION_H;
    loadDataParams.enTranspose = false;
    loadDataParams.enSmallK = false;
    loadDataParams.filterSizeW = false;
    loadDataParams.filterSizeH = false;
    loadDataParams.fMatrixCtrl = 0;
    loadDataParams.padValue = 0;
    AscendC::LoadData(a2Local, fmapL1, loadDataParams);
}

template <typename T>
__aicore__ inline void LoadWeightToL0B(AscendC::LocalTensor<T>& b2Local, AscendC::LocalTensor<T>& weightL1)
{
    AscendC::LoadData2DParams loadDataParams;
    loadDataParams.startIndex = 0;
    loadDataParams.repeatTimes = K_ALIGN / CUBE_BLOCK * (N_ALIGN / CUBE_BLOCK);
    loadDataParams.srcStride = 1;
    loadDataParams.dstGap = 0;
    loadDataParams.ifTranspose = true;
    AscendC::LoadData(b2Local, weightL1, loadDataParams);
}

template <typename T>
__aicore__ inline void Compute(
    AscendC::LocalTensor<float>& co1Local, AscendC::LocalTensor<T>& a2Local, AscendC::LocalTensor<T>& b2Local)
{
    AscendC::MmadParams mmParams;
    mmParams.m = M;
    mmParams.n = N;
    mmParams.k = K_ALIGN;
    mmParams.cmatrixInitVal = true;
    AscendC::Mmad(co1Local, a2Local, b2Local, mmParams);
}

template <typename T>
__aicore__ inline void CopyOut(AscendC::GlobalTensor<T>& outGM, AscendC::LocalTensor<float>& co1Local)
{
    AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fixpipeParams;
    fixpipeParams.nSize = N;
    fixpipeParams.mSize = M;
    fixpipeParams.srcStride = M_ALIGN;
    fixpipeParams.dstStride = N;
    fixpipeParams.reluEn = false;
    fixpipeParams.quantPre = QuantMode_t::F322F16;
    fixpipeParams.deqScalar = 0;
    fixpipeParams.unitFlag = 0;
    AscendC::Fixpipe<T, float, AscendC::CFG_ROW_MAJOR>(outGM, co1Local, fixpipeParams);
}

extern "C" __global__ __cube__ void conv2d_forward_custom(
    __gm__ uint8_t* fmap, __gm__ uint8_t* weight, __gm__ uint8_t* out)
{
    AscendC::InitSocState();
    uint32_t batchIdx = AscendC::GetBlockIdx();
    if (batchIdx >= BATCH) {
        return;
    }

    constexpr uint32_t a2Size = M_ALIGN * K_ALIGN;
    constexpr uint32_t b2Size = K_ALIGN * N_ALIGN;
    constexpr uint32_t co1Size = M_ALIGN * N_ALIGN;

    AscendC::GlobalTensor<half> fmapGM;
    AscendC::GlobalTensor<half> weightGM;
    AscendC::GlobalTensor<half> outGM;
    fmapGM.SetGlobalBuffer((__gm__ half*)fmap + batchIdx * FMAP_GM_BATCH_SIZE);
    weightGM.SetGlobalBuffer((__gm__ half*)weight);
    outGM.SetGlobalBuffer((__gm__ half*)out + batchIdx * OUT_GM_BATCH_SIZE);

    AscendC::LocalTensor<half> fmapL1(AscendC::TPosition::A1, L1_FMAP_ADDR, FMAP_L1_SIZE);
    AscendC::LocalTensor<half> weightL1(AscendC::TPosition::B1, L1_WEIGHT_ADDR, WEIGHT_L1_SIZE);
    AscendC::LocalTensor<half> a2Local(AscendC::TPosition::A2, L0_ADDR, a2Size);
    AscendC::LocalTensor<half> b2Local(AscendC::TPosition::B2, L0_ADDR, b2Size);
    AscendC::LocalTensor<float> co1Local(AscendC::TPosition::CO1, L0_ADDR, co1Size);

    CopyIn(fmapGM, weightGM, fmapL1, weightL1);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

    LoadFmapToL0A(a2Local, fmapL1);
    LoadWeightToL0B(b2Local, weightL1);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

    Compute(co1Local, a2Local, b2Local);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

    CopyOut(outGM, co1Local);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmapFileSize = BATCH * FMAP_GM_BATCH_SIZE * sizeof(half);
    size_t weightFileSize = WEIGHT_GM_SIZE * sizeof(half);
    size_t outFileSize = BATCH * OUT_GM_BATCH_SIZE * sizeof(half);
    uint32_t numBlocks = BLOCK_DIM;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmapHost;
    uint8_t* fmapDevice;
    aclrtMallocHost((void**)(&fmapHost), fmapFileSize);
    aclrtMalloc((void**)&fmapDevice, fmapFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmapFileSize, fmapHost, fmapFileSize);
    aclrtMemcpy(fmapDevice, fmapFileSize, fmapHost, fmapFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weightHost;
    uint8_t* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightFileSize);
    aclrtMalloc((void**)&weightDevice, weightFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weightFileSize, weightHost, weightFileSize);
    aclrtMemcpy(weightDevice, weightFileSize, weightHost, weightFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outHost;
    uint8_t* outDevice;
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_custom<<<numBlocks, nullptr, stream>>>(fmapDevice, weightDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(fmapDevice);
    aclrtFreeHost(fmapHost);
    aclrtFree(weightDevice);
    aclrtFreeHost(weightHost);
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
