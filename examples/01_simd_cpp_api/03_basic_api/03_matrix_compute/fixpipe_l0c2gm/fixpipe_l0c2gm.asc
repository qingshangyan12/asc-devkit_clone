/* !
 * \file fixpipe_l0c2gm.asc
 * \brief 本样例介绍如何使用Fixpipe将矩阵乘的结果从L0C Buffer搬出到GM（Global Memory）
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

// ============================================================================
// Scenario configuration helpers (compile-time)
// ============================================================================

// Determine if scenario uses int8_t input (int32_t L0C) vs half input (float L0C)
__host__ __aicore__ inline constexpr bool IsInt32Src()
{
    return SCENARIO_NUM >= 42 && SCENARIO_NUM <= 59;
}

// Determine if output is NZ format
__host__ __aicore__ inline constexpr bool IsNZOutput()
{
    return SCENARIO_NUM == 1 || SCENARIO_NUM == 7 || SCENARIO_NUM == 8 || SCENARIO_NUM == 9 ||
           SCENARIO_NUM == 12 || SCENARIO_NUM == 13 || SCENARIO_NUM == 15 || SCENARIO_NUM == 18 ||
           SCENARIO_NUM == 19 || SCENARIO_NUM == 21 || SCENARIO_NUM == 24 || SCENARIO_NUM == 25 ||
           SCENARIO_NUM == 28 || SCENARIO_NUM == 29 || SCENARIO_NUM == 34 || SCENARIO_NUM == 35 ||
           SCENARIO_NUM == 36 || SCENARIO_NUM == 37 || SCENARIO_NUM == 40 || SCENARIO_NUM == 41 ||
           SCENARIO_NUM == 43 || SCENARIO_NUM == 46 || SCENARIO_NUM == 47 || SCENARIO_NUM == 50 ||
           SCENARIO_NUM == 51 || SCENARIO_NUM == 54 || SCENARIO_NUM == 55 || SCENARIO_NUM == 58 ||
           SCENARIO_NUM == 59;
}

// Determine if output is DN format (scenario 3 only, 3510 only)
__host__ __aicore__ inline constexpr bool IsDNOutput()
{
    return SCENARIO_NUM == 3;
}

// Determine if output is ND format
__host__ __aicore__ inline constexpr bool IsNDOutput()
{
    return !IsNZOutput() && !IsDNOutput();
}

// Determine if scenario uses scalar quantization (Q-prefix, not V-prefix, not cast, not NoQuant)
__host__ __aicore__ inline constexpr bool IsScalarQuant()
{
    return SCENARIO_NUM == 4 || SCENARIO_NUM == 8 || SCENARIO_NUM == 10 || SCENARIO_NUM == 12 ||
           SCENARIO_NUM == 16 || SCENARIO_NUM == 18 || SCENARIO_NUM == 22 || SCENARIO_NUM == 24 ||
           SCENARIO_NUM == 26 || SCENARIO_NUM == 28 || SCENARIO_NUM == 30 || SCENARIO_NUM == 32 ||
           SCENARIO_NUM == 34 || SCENARIO_NUM == 36 || SCENARIO_NUM == 38 || SCENARIO_NUM == 40 ||
           SCENARIO_NUM == 44 || SCENARIO_NUM == 46 || SCENARIO_NUM == 48 || SCENARIO_NUM == 50 ||
           SCENARIO_NUM == 52 || SCENARIO_NUM == 54 || SCENARIO_NUM == 56 || SCENARIO_NUM == 58;
}

// Determine if scenario uses tensor quantization (V-prefix)
__host__ __aicore__ inline constexpr bool IsTensorQuant()
{
    return SCENARIO_NUM == 5 || SCENARIO_NUM == 9 || SCENARIO_NUM == 11 || SCENARIO_NUM == 13 ||
           SCENARIO_NUM == 17 || SCENARIO_NUM == 19 || SCENARIO_NUM == 23 || SCENARIO_NUM == 25 ||
           SCENARIO_NUM == 27 || SCENARIO_NUM == 29 || SCENARIO_NUM == 31 || SCENARIO_NUM == 33 ||
           SCENARIO_NUM == 35 || SCENARIO_NUM == 37 || SCENARIO_NUM == 39 || SCENARIO_NUM == 41 ||
           SCENARIO_NUM == 45 || SCENARIO_NUM == 47 || SCENARIO_NUM == 49 || SCENARIO_NUM == 51 ||
           SCENARIO_NUM == 53 || SCENARIO_NUM == 55 || SCENARIO_NUM == 57 || SCENARIO_NUM == 59;
}

// Determine if scenario uses cast mode (F322F16, F322BF16)
__host__ __aicore__ inline constexpr bool IsCastMode()
{
    return SCENARIO_NUM == 14 || SCENARIO_NUM == 15 || SCENARIO_NUM == 20 || SCENARIO_NUM == 21;
}

// Get the quantPre mode for the current scenario
__host__ __aicore__ inline constexpr QuantMode_t GetQuantPre()
{
    if (SCENARIO_NUM == 4 || SCENARIO_NUM == 8 || SCENARIO_NUM == 10 || SCENARIO_NUM == 12) {
        return QuantMode_t::QF322B8_PRE;
    }
    if (SCENARIO_NUM == 5 || SCENARIO_NUM == 9 || SCENARIO_NUM == 11 || SCENARIO_NUM == 13) {
        return QuantMode_t::VQF322B8_PRE;
    }
    if (SCENARIO_NUM == 14 || SCENARIO_NUM == 15) {
        return QuantMode_t::F322F16;
    }
    if (SCENARIO_NUM == 16 || SCENARIO_NUM == 18) {
        return QuantMode_t::QF322F16_PRE;
    }
    if (SCENARIO_NUM == 17 || SCENARIO_NUM == 19) {
        return QuantMode_t::VQF322F16_PRE;
    }
    if (SCENARIO_NUM == 20 || SCENARIO_NUM == 21) {
        return QuantMode_t::F322BF16;
    }
    if (SCENARIO_NUM == 22 || SCENARIO_NUM == 24) {
        return QuantMode_t::QF322BF16_PRE;
    }
    if (SCENARIO_NUM == 23 || SCENARIO_NUM == 25) {
        return QuantMode_t::VQF322BF16_PRE;
    }
    if (SCENARIO_NUM == 26 || SCENARIO_NUM == 28) {
        return QuantMode_t::QF322FP8_PRE;
    }
    if (SCENARIO_NUM == 27 || SCENARIO_NUM == 29) {
        return QuantMode_t::VQF322FP8_PRE;
    }
    if (SCENARIO_NUM == 30 || SCENARIO_NUM == 34) {
        return QuantMode_t::QF322HIF8_PRE;
    }
    if (SCENARIO_NUM == 31 || SCENARIO_NUM == 35) {
        return QuantMode_t::VQF322HIF8_PRE;
    }
    if (SCENARIO_NUM == 32 || SCENARIO_NUM == 36) {
        return QuantMode_t::QF322HIF8_PRE_HYBRID;
    }
    if (SCENARIO_NUM == 33 || SCENARIO_NUM == 37) {
        return QuantMode_t::VQF322HIF8_PRE_HYBRID;
    }
    if (SCENARIO_NUM == 38 || SCENARIO_NUM == 40) {
        return QuantMode_t::QF322F32_PRE;
    }
    if (SCENARIO_NUM == 39 || SCENARIO_NUM == 41) {
        return QuantMode_t::VQF322F32_PRE;
    }
    if (SCENARIO_NUM == 44 || SCENARIO_NUM == 46 || SCENARIO_NUM == 48 || SCENARIO_NUM == 50) {
        return QuantMode_t::REQ8;
    }
    if (SCENARIO_NUM == 45 || SCENARIO_NUM == 47 || SCENARIO_NUM == 49 || SCENARIO_NUM == 51) {
        return QuantMode_t::VREQ8;
    }
    if (SCENARIO_NUM == 52 || SCENARIO_NUM == 54) {
        return QuantMode_t::DEQF16;
    }
    if (SCENARIO_NUM == 53 || SCENARIO_NUM == 55) {
        return QuantMode_t::VDEQF16;
    }
    if (SCENARIO_NUM == 56 || SCENARIO_NUM == 58) {
        return QuantMode_t::QS322BF16_PRE;
    }
    if (SCENARIO_NUM == 57 || SCENARIO_NUM == 59) {
        return QuantMode_t::VQS322BF16_PRE;
    }
    return QuantMode_t::NoQuant;
}

// Determine if scenario enables ReLU (scenario 6)
__host__ __aicore__ inline constexpr bool IsReLU()
{
    return SCENARIO_NUM == 6;
}

// Determine if scenario enables ChannelSplit (scenario 7)
__host__ __aicore__ inline constexpr bool IsChannelSplit()
{
    return SCENARIO_NUM == 7;
}

// ============================================================================
// Boundary test configuration (scenarios 60-64)
// ============================================================================

// Determine if scenario is a boundary test
__host__ __aicore__ inline constexpr bool IsBoundaryTest()
{
    return SCENARIO_NUM >= 60 && SCENARIO_NUM <= 64;
}

// Saturation mode: CTRL[48]=0 (inf→±MAX, nan→0)
__host__ __aicore__ inline constexpr bool IsSaturationMode()
{
    return SCENARIO_NUM == 60 || SCENARIO_NUM == 62 || SCENARIO_NUM == 63;
}

// Non-saturation mode: CTRL[48]=1 (inf/nan preserved)
__host__ __aicore__ inline constexpr bool IsNonSaturationMode()
{
    return SCENARIO_NUM == 61 || SCENARIO_NUM == 64;
}

// CTRL[50]=1 for fp8: nan preserved in saturation mode
__host__ __aicore__ inline constexpr bool IsCtrl50NanPreserve()
{
    return SCENARIO_NUM == 63;
}

// ============================================================================

template <class inputType, class outputType, class l0cType, uint32_t baseM, uint32_t baseK, uint32_t baseN>
class KernelFixpipe {
public:
    __aicore__ inline KernelFixpipe()
    {
        AscendC::InitSocState();
        aSingleSize = baseM * baseK;
        bSingleSize = baseK * baseN;
        cSingleSize = baseM * baseN;

        // A 不转置
        aSizeAlignL1 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        aSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        // B 不转置
        bSizeAlignL1 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        bSizeAlignL0 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        // C矩阵无视数据类型和a、b是否转置，m,n都向16对齐
        cSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
    }

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* quantAlpha)
    {
        aGM.SetGlobalBuffer((__gm__ inputType*)a);
        bGM.SetGlobalBuffer((__gm__ inputType*)b);
        cGM.SetGlobalBuffer((__gm__ outputType*)c);
        quantAlphaGM.SetGlobalBuffer((__gm__ uint64_t*)quantAlpha);
    }

    __aicore__ inline void Process()
    {
        uint32_t chunkSize = K_ROUND;
        AscendC::LocalTensor<inputType> a1Local(AscendC::TPosition::A1, a1Addr, aSizeAlignL1);
        AscendC::LocalTensor<inputType> a2Local(AscendC::TPosition::A2, a2Addr, aSizeAlignL0);
        AscendC::LocalTensor<inputType> b1Local(AscendC::TPosition::B1, b1Addr, bSizeAlignL1);
        AscendC::LocalTensor<inputType> b2Local(AscendC::TPosition::B2, b2Addr, bSizeAlignL0);
        AscendC::LocalTensor<l0cType> c(AscendC::TPosition::CO1, co1Addr, cSizeAlignL0);
        for (uint32_t kIndex = 0; kIndex < chunkSize; kIndex++) {
            CopyIn(kIndex, a1Local, b1Local);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
            SplitA(kIndex, a1Local, a2Local);
            SplitB(kIndex, b1Local, b2Local);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            Compute(kIndex, c, a2Local, b2Local);
            AscendC::SetFlag<AscendC::HardEvent::M_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE2>(EVENT_ID0);
        }

        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        CopyOut(c);
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }

    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void CopyQuantAlphaGmToL1(AscendC::LocalTensor<uint64_t> quantAlphaTensor)
    {
        AscendC::SetFlag<AscendC::HardEvent::FIX_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE2>(EVENT_ID0);
        uint16_t burstLen = CeilAlign(baseN * sizeof(uint64_t), 128) / 32;
        AscendC::DataCopyParams intriParams{1, burstLen, 0, 0};
        AscendC::DataCopy(quantAlphaTensor, quantAlphaGM, intriParams);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_FIX>(EVENT_ID0);
    }

    __aicore__ inline void CopyIn(
        uint32_t kIndex, AscendC::LocalTensor<inputType> a1Local, AscendC::LocalTensor<inputType> b1Local)
    {
        AscendC::Nd2NzParams nd2nzA1Params;
        // 传输ND矩阵的数目
        nd2nzA1Params.ndNum = 1;
        nd2nzA1Params.nValue = baseM;
        nd2nzA1Params.dValue = baseK;
        // 源操作数相邻ND矩阵起始地址间的偏移，单位为元素。
        nd2nzA1Params.srcNdMatrixStride = 0;
        nd2nzA1Params.srcDValue = baseK;
        // 目的NZ矩阵中，来自源操作数同一行的多行数据相邻行起始地址间的偏移。
        // 取值范围：dstNzC0Stride∈[1, 16384]，单位：C0_SIZE（32B）。
        nd2nzA1Params.dstNzC0Stride = CeilAlign(baseM, CUBE_BLOCK);
        // 目的NZ矩阵中，Z型矩阵相邻行起始地址之间的偏移。单位：C0_SIZE（32B）。
        nd2nzA1Params.dstNzNStride = 1;
        // 目的NZ矩阵中，相邻NZ矩阵起始地址间的偏移，单位为元素。
        nd2nzA1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kIndex * aSingleSize], nd2nzA1Params);

        AscendC::Nd2NzParams nd2nzB1Params;
        nd2nzB1Params.ndNum = 1;
        nd2nzB1Params.nValue = baseK;
        nd2nzB1Params.dValue = baseN;
        nd2nzB1Params.srcNdMatrixStride = 0;
        nd2nzB1Params.srcDValue = baseN;
        nd2nzB1Params.dstNzC0Stride = CeilAlign(baseK, CUBE_BLOCK);
        nd2nzB1Params.dstNzNStride = 1;
        nd2nzB1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1Local, bGM[kIndex * bSingleSize], nd2nzB1Params);
    }

    __aicore__ inline void SplitA(
        uint32_t kIndex, AscendC::LocalTensor<inputType> a1Local, AscendC::LocalTensor<inputType> a2Local)
    {
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        uint32_t dstOffset = CeilDivision(baseK, CUBE_BLOCK) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        // Nz -> Zz
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(baseK, CUBE_BLOCK);
        loadDataParams.srcStride = CeilDivision(baseM, CUBE_BLOCK);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        for (int i = 0; i < CeilDivision(baseM, CUBE_BLOCK); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStep = CeilDivision(baseM, CUBE_BLOCK);
        loadDataParams.kStep = CeilDivision(baseK, C0_SIZE / sizeof(inputType));
        loadDataParams.srcStride = CeilDivision(baseM, CUBE_BLOCK);
        loadDataParams.dstStride = CeilDivision(baseM, CUBE_BLOCK);
        AscendC::LoadData(a2Local, a1Local, loadDataParams);
#endif
    }

    __aicore__ inline void SplitB(
        uint32_t kIndex, AscendC::LocalTensor<inputType> b1Local, AscendC::LocalTensor<inputType> b2Local)
    {
        uint32_t dstOffset = CeilDivision(baseN, CUBE_BLOCK) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        // Nz -> Zn
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.startIndex = 0;
        loadDataParams.repeatTimes = CeilDivision(baseN, CUBE_BLOCK);
        loadDataParams.srcStride = CeilDivision(baseK, CUBE_BLOCK);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = true;
        for (int i = 0; i < CeilDivision(baseK, CUBE_BLOCK); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], b1Local[i * srcOffset], loadDataParams);
        }
    }

    __aicore__ inline void Compute(
        uint32_t kIndex, AscendC::LocalTensor<l0cType> c, AscendC::LocalTensor<inputType> a,
        AscendC::LocalTensor<inputType> b)
    {
        AscendC::MmadParams mmadParams;
        mmadParams.m = baseM;
        mmadParams.n = CeilAlign(baseN, C0_SIZE);
        mmadParams.k = baseK;
        if (kIndex == 0) {
            mmadParams.cmatrixInitVal = true;
        } else {
            mmadParams.cmatrixInitVal = false;
        }

        AscendC::Mmad(c, a, b, mmadParams);
        if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
            AscendC::PipeBarrier<PIPE_M>();
        }
    }

    // ========================================================================
    // CopyOut: handles all 59 scenarios
    // ========================================================================
    __aicore__ inline void CopyOut(AscendC::LocalTensor<l0cType>& c)
    {
        // Set overflow mode for boundary test scenarios
        if constexpr (IsBoundaryTest()) {
            if constexpr (IsSaturationMode()) {
                AscendC::AscendCUtils::SetOverflow(0);
            } else {
                AscendC::AscendCUtils::SetOverflow(1);
            }
            // CTRL[50] for fp8_e4m3fn_t nan handling in saturation mode
            if constexpr (IsCtrl50NanPreserve()) {
                set_ctrl(sbitset1(get_ctrl(), 50));
            }
        }

        // C0 size for NZ output: 16 for types >= 2 bytes, 32 for 1-byte types
        constexpr uint16_t c0Size = (sizeof(outputType) == 1) ? 32 : 16;

        // === NZ output ===
        if constexpr (IsNZOutput()) {
            AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::NZ> fixpipeParams;
            fixpipeParams.mSize = baseM;
            fixpipeParams.srcStride = CeilAlign(baseM, CUBE_BLOCK);

            if constexpr (IsChannelSplit()) {
                // ChannelSplit: only float, c0Size = 8
                fixpipeParams.isChannelSplit = true;
                fixpipeParams.nSize = CeilAlign(baseN, static_cast<uint16_t>(8));
                fixpipeParams.dstStride = baseM * 8;
            } else {
                fixpipeParams.nSize = CeilAlign(baseN, c0Size);
                fixpipeParams.dstStride = baseM * c0Size;
            }

            CallFixpipeNZ(c, fixpipeParams);
        }
        // === ND output ===
        else if constexpr (IsNDOutput()) {
            AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fixpipeParams;
            fixpipeParams.mSize = baseM;
            fixpipeParams.srcStride = CeilAlign(baseM, CUBE_BLOCK);
            fixpipeParams.nSize = baseN;
            fixpipeParams.dstStride = baseN;

            if constexpr (IsReLU()) {
                fixpipeParams.reluEn = true;
            }

            CallFixpipeND(c, fixpipeParams);
        }
        // === DN output (scenario 3, 3510 only) ===
        else if constexpr (IsDNOutput()) {
            AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::COLUMN_MAJOR> fixpipeParams;
            fixpipeParams.mSize = baseM;
            fixpipeParams.srcStride = CeilAlign(baseM, CUBE_BLOCK);
            fixpipeParams.nSize = baseN;
            fixpipeParams.dstStride = baseM;
            fixpipeParams.params = {1, 0, 0, 1};
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_COLUMN_MAJOR>(cGM, c, fixpipeParams);
        }
    }

private:
    // Helper: set deqScalar for scalar quant modes
    __aicore__ inline uint64_t GetDeqScalar()
    {
        uint64_t deqScalar = static_cast<uint64_t>(*reinterpret_cast<int32_t*>(&quantScalar));
        constexpr bool sign = !AscendC::IsSameType<outputType, uint8_t>::value;
        deqScalar = (deqScalar & ~(static_cast<uint64_t>(1) << 46)) | (static_cast<uint64_t>(sign) << 46);
        return deqScalar;
    }

    // Helper: call Fixpipe for NZ output
    __aicore__ inline void CallFixpipeNZ(
        AscendC::LocalTensor<l0cType>& c,
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::NZ>& fixpipeParams)
    {
        if constexpr (IsTensorQuant()) {
            fixpipeParams.quantPre = GetQuantPre();
            AscendC::LocalTensor<uint64_t> quantAlphaTensor(AscendC::TPosition::C1, c1Addr, baseN);
            CopyQuantAlphaGmToL1(quantAlphaTensor);
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_NZ>(cGM, c, quantAlphaTensor, fixpipeParams);
        } else if constexpr (IsScalarQuant()) {
            fixpipeParams.quantPre = GetQuantPre();
            fixpipeParams.deqScalar = GetDeqScalar();
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_NZ>(cGM, c, fixpipeParams);
        } else {
            // NoQuant or Cast mode
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_NZ>(cGM, c, fixpipeParams);
        }
    }

    // Helper: call Fixpipe for ND output
    __aicore__ inline void CallFixpipeND(
        AscendC::LocalTensor<l0cType>& c,
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR>& fixpipeParams)
    {
        if constexpr (IsTensorQuant()) {
            fixpipeParams.quantPre = GetQuantPre();
            AscendC::LocalTensor<uint64_t> quantAlphaTensor(AscendC::TPosition::C1, c1Addr, baseN);
            CopyQuantAlphaGmToL1(quantAlphaTensor);
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_ROW_MAJOR>(cGM, c, quantAlphaTensor, fixpipeParams);
        } else if constexpr (IsScalarQuant()) {
            fixpipeParams.quantPre = GetQuantPre();
            fixpipeParams.deqScalar = GetDeqScalar();
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_ROW_MAJOR>(cGM, c, fixpipeParams);
        } else {
            // NoQuant or Cast mode
            AscendC::Fixpipe<outputType, l0cType, AscendC::CFG_ROW_MAJOR>(cGM, c, fixpipeParams);
        }
    }

private:
    static constexpr uint32_t a1Addr = 0;
    static constexpr uint32_t a2Addr = 0;
    static constexpr uint32_t b1Addr = 128 * 1024;
    static constexpr uint32_t b2Addr = 0;
    static constexpr uint32_t co1Addr = 0;
    // Vector quant参数 需要从GM拷贝到L1
    static constexpr uint32_t c1Addr = 0;

    AscendC::GlobalTensor<inputType> aGM;
    AscendC::GlobalTensor<inputType> bGM;
    AscendC::GlobalTensor<outputType> cGM;
    AscendC::GlobalTensor<uint64_t> quantAlphaGM;

    float quantScalar = 2.0;
    // 注意沿着K轴切分
    uint32_t aSingleSize, bSingleSize, cSingleSize;

    uint32_t aSizeAlignL1, bSizeAlignL1;
    uint32_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0;
};

// ============================================================================
// Main entry point: select template instantiation based on SCENARIO_NUM
// ============================================================================

// Macro to reduce boilerplate
#define RUN_KERNEL(inType, outType, l0cType, M, K, N)                                   \
    {                                                                                    \
        KernelFixpipe<inType, outType, l0cType, M, K / K_ROUND, N> op;                  \
        op.Init(a, b, c, quantAlpha);                                                    \
        op.Process();                                                                    \
    }

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void fixpipe_l0c2gm(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* quantAlpha)
{
    // --- float L0C (half input) ---
    // Group: half, float, float (NoQuant + QF322F32_PRE + VQF322F32_PRE)
    if constexpr (SCENARIO_NUM == 1 || SCENARIO_NUM == 2 || SCENARIO_NUM == 3 ||
                  SCENARIO_NUM == 6 || SCENARIO_NUM == 7 ||
                  SCENARIO_NUM == 38 || SCENARIO_NUM == 39 ||
                  SCENARIO_NUM == 40 || SCENARIO_NUM == 41) {
        RUN_KERNEL(half, float, float, M, K, N)
    }
    // Group: half, int8_t, float (QF322B8_PRE + VQF322B8_PRE)
    else if constexpr (SCENARIO_NUM == 4 || SCENARIO_NUM == 5 ||
                       SCENARIO_NUM == 8 || SCENARIO_NUM == 9) {
        RUN_KERNEL(half, int8_t, float, M, K, N)
    }
    // Group: half, uint8_t, float (QF322B8_PRE + VQF322B8_PRE)
    else if constexpr (SCENARIO_NUM == 10 || SCENARIO_NUM == 11 ||
                       SCENARIO_NUM == 12 || SCENARIO_NUM == 13) {
        RUN_KERNEL(half, uint8_t, float, M, K, N)
    }
    // Group: half, half, float (F322F16 + QF322F16_PRE + VQF322F16_PRE)
    else if constexpr (SCENARIO_NUM == 14 || SCENARIO_NUM == 15 ||
                       SCENARIO_NUM == 16 || SCENARIO_NUM == 17 ||
                       SCENARIO_NUM == 18 || SCENARIO_NUM == 19) {
        RUN_KERNEL(half, half, float, M, K, N)
    }
    // Group: half, bfloat16_t, float (F322BF16 + QF322BF16_PRE + VQF322BF16_PRE)
    else if constexpr (SCENARIO_NUM == 20 || SCENARIO_NUM == 21 ||
                       SCENARIO_NUM == 22 || SCENARIO_NUM == 23 ||
                       SCENARIO_NUM == 24 || SCENARIO_NUM == 25) {
        RUN_KERNEL(half, bfloat16_t, float, M, K, N)
    }
    // Group: half, fp8_e4m3fn_t, float (QF322FP8_PRE + VQF322FP8_PRE)
    else if constexpr (SCENARIO_NUM == 26 || SCENARIO_NUM == 27 ||
                       SCENARIO_NUM == 28 || SCENARIO_NUM == 29) {
        RUN_KERNEL(half, fp8_e4m3fn_t, float, M, K, N)
    }
    // Group: half, hifloat8_t, float (QF322HIF8_PRE + VQF322HIF8_PRE + HYBRID variants)
    else if constexpr (SCENARIO_NUM == 30 || SCENARIO_NUM == 31 ||
                       SCENARIO_NUM == 32 || SCENARIO_NUM == 33 ||
                       SCENARIO_NUM == 34 || SCENARIO_NUM == 35 ||
                       SCENARIO_NUM == 36 || SCENARIO_NUM == 37) {
        RUN_KERNEL(half, hifloat8_t, float, M, K, N)
    }
    // --- int32_t L0C (int8_t input) ---
    // Group: int8_t, int32_t, int32_t (NoQuant)
    else if constexpr (SCENARIO_NUM == 42 || SCENARIO_NUM == 43) {
        RUN_KERNEL(int8_t, int32_t, int32_t, M, K, N)
    }
    // Group: int8_t, int8_t, int32_t (REQ8 + VREQ8)
    else if constexpr (SCENARIO_NUM == 44 || SCENARIO_NUM == 45 ||
                       SCENARIO_NUM == 46 || SCENARIO_NUM == 47) {
        RUN_KERNEL(int8_t, int8_t, int32_t, M, K, N)
    }
    // Group: int8_t, uint8_t, int32_t (REQ8 + VREQ8)
    else if constexpr (SCENARIO_NUM == 48 || SCENARIO_NUM == 49 ||
                       SCENARIO_NUM == 50 || SCENARIO_NUM == 51) {
        RUN_KERNEL(int8_t, uint8_t, int32_t, M, K, N)
    }
    // Group: int8_t, half, int32_t (DEQF16 + VDEQF16)
    else if constexpr (SCENARIO_NUM == 52 || SCENARIO_NUM == 53 ||
                       SCENARIO_NUM == 54 || SCENARIO_NUM == 55) {
        RUN_KERNEL(int8_t, half, int32_t, M, K, N)
    }
    // Group: int8_t, bfloat16_t, int32_t (QS322BF16_PRE + VQS322BF16_PRE)
    else if constexpr (SCENARIO_NUM == 56 || SCENARIO_NUM == 57 ||
                       SCENARIO_NUM == 58 || SCENARIO_NUM == 59) {
        RUN_KERNEL(int8_t, bfloat16_t, int32_t, M, K, N)
    }
    // --- Boundary test scenarios (60-64) ---
    // Group: float, float, float (NoQuant + saturation/non-saturation, inf in L0C)
    else if constexpr (SCENARIO_NUM == 60 || SCENARIO_NUM == 61) {
        RUN_KERNEL(float, float, float, M, K, N)
    }
    // Group: half, fp8_e4m3fn_t, float (QF322FP8_PRE + saturation/non-saturation, overflow)
    else if constexpr (SCENARIO_NUM == 62 || SCENARIO_NUM == 63 || SCENARIO_NUM == 64) {
        RUN_KERNEL(half, fp8_e4m3fn_t, float, M, K, N)
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    // A No Trans, B No Trans
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 256;

    // Determine input type and size
    constexpr bool isInt32Src = IsInt32Src();
    constexpr bool isFloatInput = (SCENARIO_NUM >= 60 && SCENARIO_NUM <= 61);
    constexpr size_t inputTypeSize = isInt32Src ? sizeof(int8_t) : (isFloatInput ? sizeof(float) : sizeof(half));
    size_t aFileSize = M * K * inputTypeSize;
    size_t bFileSize = K * N * inputTypeSize;

    // Determine output type and size
    size_t cFileSize;
    if constexpr (IsInt32Src()) {
        if constexpr (SCENARIO_NUM == 42 || SCENARIO_NUM == 43) {
            cFileSize = M * N * sizeof(int32_t);
        } else if constexpr (SCENARIO_NUM == 44 || SCENARIO_NUM == 45 ||
                             SCENARIO_NUM == 46 || SCENARIO_NUM == 47) {
            cFileSize = M * N * sizeof(int8_t);
        } else if constexpr (SCENARIO_NUM == 48 || SCENARIO_NUM == 49 ||
                             SCENARIO_NUM == 50 || SCENARIO_NUM == 51) {
            cFileSize = M * N * sizeof(uint8_t);
        } else if constexpr (SCENARIO_NUM == 52 || SCENARIO_NUM == 53 ||
                             SCENARIO_NUM == 54 || SCENARIO_NUM == 55) {
            cFileSize = M * N * sizeof(half);
        } else { // 56-59: bfloat16_t
            cFileSize = M * N * sizeof(bfloat16_t);
        }
    } else {
        if constexpr (SCENARIO_NUM == 4 || SCENARIO_NUM == 5 ||
                      SCENARIO_NUM == 8 || SCENARIO_NUM == 9) {
            cFileSize = M * N * sizeof(int8_t);
        } else if constexpr (SCENARIO_NUM == 10 || SCENARIO_NUM == 11 ||
                             SCENARIO_NUM == 12 || SCENARIO_NUM == 13) {
            cFileSize = M * N * sizeof(uint8_t);
        } else if constexpr (SCENARIO_NUM == 14 || SCENARIO_NUM == 15 ||
                             SCENARIO_NUM == 16 || SCENARIO_NUM == 17 ||
                             SCENARIO_NUM == 18 || SCENARIO_NUM == 19) {
            cFileSize = M * N * sizeof(half);
        } else if constexpr (SCENARIO_NUM == 20 || SCENARIO_NUM == 21 ||
                             SCENARIO_NUM == 22 || SCENARIO_NUM == 23 ||
                             SCENARIO_NUM == 24 || SCENARIO_NUM == 25) {
            cFileSize = M * N * sizeof(bfloat16_t);
        } else if constexpr (SCENARIO_NUM == 26 || SCENARIO_NUM == 27 ||
                             SCENARIO_NUM == 28 || SCENARIO_NUM == 29) {
            cFileSize = M * N * sizeof(fp8_e4m3fn_t);
        } else if constexpr (SCENARIO_NUM == 30 || SCENARIO_NUM == 31 ||
                             SCENARIO_NUM == 32 || SCENARIO_NUM == 33 ||
                             SCENARIO_NUM == 34 || SCENARIO_NUM == 35 ||
                             SCENARIO_NUM == 36 || SCENARIO_NUM == 37) {
            cFileSize = M * N * sizeof(hifloat8_t);
        } else if constexpr (SCENARIO_NUM == 62 || SCENARIO_NUM == 63 ||
                             SCENARIO_NUM == 64) {
            cFileSize = M * N * sizeof(fp8_e4m3fn_t);
        } else { // 1,2,3,6,7,38-41,60,61: float
            cFileSize = M * N * sizeof(float);
        }
    }

    size_t quantAlphaSize = 1 * N * sizeof(uint64_t);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    // Allocate larger buffer for NZ output (padded to fractal size)
    size_t cAllocSize = cFileSize;
    if constexpr (IsNZOutput()) {
        // NZ format may require more space due to alignment
        // Allocate with enough padding
        cAllocSize = M * N * 8; // generous allocation
    }
    aclrtMallocHost((void**)(&cHost), cAllocSize);
    aclrtMalloc((void**)&cDevice, cAllocSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* quantAlphaHost;
    uint8_t* quantAlphaDevice;
    aclrtMallocHost((void**)(&quantAlphaHost), quantAlphaSize);
    aclrtMalloc((void**)&quantAlphaDevice, quantAlphaSize, ACL_MEM_MALLOC_HUGE_FIRST);
    // vector quant mode
    if constexpr (IsTensorQuant()) {
        ReadFile("./input/quant_pre.bin", quantAlphaSize, quantAlphaHost, quantAlphaSize);
    }
    aclrtMemcpy(quantAlphaDevice, quantAlphaSize, quantAlphaHost, quantAlphaSize, ACL_MEMCPY_HOST_TO_DEVICE);

    fixpipe_l0c2gm<M, K, N><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice, quantAlphaDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtFree(quantAlphaDevice);
    aclrtFreeHost(quantAlphaHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
