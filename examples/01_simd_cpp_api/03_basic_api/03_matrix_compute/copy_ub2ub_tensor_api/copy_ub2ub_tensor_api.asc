/* !
 * \file copy_ub2ub_tensor_api.asc
 * \brief 基于Tensor API演示UB到UB的搬运通路(CopyUB2UB)。
 *        流程为纯Vector搬运：GM -> UB(CopyGM2UB) -> UB(CopyUB2UB) -> GM(CopyUB2GM)，
 *        不涉及矩阵乘。由于是逐元素恒等搬运，GM上的输出应与输入完全一致。
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

template <typename T, int32_t ROW, int32_t COL>
__global__ __vector__ void copy_ub2ub_custom(__gm__ T* x, __gm__ T* z)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // GM 上的输入/输出张量，均按 ND 布局。
    auto gmInTensor = MakeTensor(MakeMemPtr(x), MakeFrameLayout<NDExtLayoutPtn>(ROW, COL));
    auto gmOutTensor = MakeTensor(MakeMemPtr(z), MakeFrameLayout<NDExtLayoutPtn>(ROW, COL));

    // UB 缓存：srcUB 承接 GM 搬入的数据，dstUB 承接 UB 到 UB 的搬运结果。
    __ubuf__ T srcUBBuf[ROW * COL];
    __ubuf__ T dstUBBuf[ROW * COL];

    auto srcUBTensor = MakeTensor(MakeMemPtr(srcUBBuf), MakeFrameLayout<NDExtLayoutPtn>(ROW, COL));
    auto dstUBTensor = MakeTensor(MakeMemPtr(dstUBBuf), MakeFrameLayout<NDExtLayoutPtn>(ROW, COL));

    auto copyGM2UBAtom = MakeCopy(CopyGM2UB{}, CopyGM2UBTraitDefault{});
    auto copyUB2UBAtom = MakeCopy(CopyUB2UB{}, CopyUB2UBTraitDefault{});
    auto copyUB2GMAtom = MakeCopy(CopyUB2GM{}, CopyUB2GMTraitDefault{});

    static constexpr uint32_t EVENT_ID = 0;

    // GM -> UB（MTE2）
    Copy(copyGM2UBAtom, srcUBTensor, gmInTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID);

    // UB -> UB（本样例重点，V 流水）
    Copy(copyUB2UBAtom, dstUBTensor, srcUBTensor);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID);

    // UB -> GM（MTE3）
    Copy(copyUB2GMAtom, gmOutTensor, dstUBTensor);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    using T = half;

    constexpr int32_t ROW = 128;
    constexpr int32_t COL = 256;
    constexpr uint32_t NUM_BLOCKS = 1;

    size_t dataFileSize = ROW * COL * sizeof(T);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    T* xDevice;
    T* zDevice;

    aclrtMallocHost((void**)(&xHost), dataFileSize);
    aclrtMallocHost((void**)(&zHost), dataFileSize);
    aclrtMalloc((void**)&xDevice, dataFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, dataFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", dataFileSize, xHost, dataFileSize);

    aclrtMemcpy(xDevice, dataFileSize, xHost, dataFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    copy_ub2ub_custom<T, ROW, COL><<<NUM_BLOCKS, 0, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, dataFileSize, zDevice, dataFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, dataFileSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
