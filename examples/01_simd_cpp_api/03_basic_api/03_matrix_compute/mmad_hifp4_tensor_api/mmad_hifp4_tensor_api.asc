/* !
 * \file mmad_hifp4_tensor_api.asc
 * \brief
 */
#include "acl/acl.h"
#include "basic_api/kernel_basic_intf.h"
#include "tensor_api/tensor.h"
#include "data_utils.h"

constexpr uint32_t SCALE_CEIL_NUMBER = 64;
constexpr uint32_t SCALE_ALIGN_NUMBER = 2;
constexpr uint32_t HIF4_SCALE_BYTES_PER_GROUP = 4;
constexpr uint32_t C0_ELEMENT_SCALE = 2;
constexpr uint32_t C0_ELEMENT_L0C = 16;

// hif4 packs each 64-element group's metadata into a 4-byte word (E6M2 + E1_8 + E1_16) and
// persists it on GM as HIF4_SCALE_BYTES_PER_GROUP consecutive fp8_e8m0_t bytes. Returns the
// number of fp8_e8m0_t bytes per row, so all the L1/L0 buffer sizing below stays in sync.
__aicore__ inline constexpr uint32_t ScaleKSize(uint32_t k)
{
    uint32_t groups = (k + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER;
    uint32_t aligned = (groups + SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER * SCALE_ALIGN_NUMBER;
    return aligned * HIF4_SCALE_BYTES_PER_GROUP;
}

// hifloat4 / fp4 packs two 4bit values per byte (PackFactor 2); fp8 keeps one element per byte.
template <class T>
constexpr uint32_t PackFactor = AscendC::Te::C0_SIZE<T> / 32;

constexpr AscendC::Te::MmadTrait MX_MMAD_TRAIT =
    AscendC::Te::MmadTrait{0, false, false, true, AscendC::Te::MmadType::MX};

struct MmadTraitMX {
    using TraitType = AscendC::Te::MmadTrait;
    static constexpr const TraitType value = MX_MMAD_TRAIT;
};

template <
    class A_DType, class B_DType, class C_DType,
    uint32_t M, uint32_t N, uint32_t K>
__cube__ __global__ void mmad_hifp4_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b,
    __gm__ uint8_t* scaleA, __gm__ uint8_t* scaleB,
    __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // hif4_scale on NPU is stored as fp8_e8m0_t (4 consecutive bytes form one 32-bit packed
    // scale word). MX Mmad has no bias input.
    using Scale_DType = fp8_e8m0_t;
    constexpr uint32_t scaleK = ScaleKSize(K);
    constexpr uint16_t AlignK = (K + 32 - 1) / 32 * 32;

    auto aPtr = reinterpret_cast<__gm__ A_DType*>(a);
    auto bPtr = reinterpret_cast<__gm__ B_DType*>(b);
    auto cPtr = reinterpret_cast<__gm__ C_DType*>(c);
    auto scaleAPtr = reinterpret_cast<__gm__ Scale_DType*>(scaleA);
    auto scaleBPtr = reinterpret_cast<__gm__ Scale_DType*>(scaleB);
    auto gmATensor = MakeTensor(MakeMemPtr(aPtr), MakeFrameLayout<NDExtLayoutPtn>(M, K));
    auto gmBTensor = MakeTensor(MakeMemPtr(bPtr), MakeFrameLayout<DNExtLayoutPtn>(K, N));
    auto gmScaleATensor = MakeTensor(MakeMemPtr(scaleAPtr), MakeFrameLayout<ScaleANDLayoutPtn>(M, scaleK));
    auto gmScaleBTensor = MakeTensor(MakeMemPtr(scaleBPtr), MakeFrameLayout<ScaleBDNLayoutPtn>(scaleK, N));
    auto gmCTensor = MakeTensor(MakeMemPtr(cPtr), MakeFrameLayout<NDExtLayoutPtn>(M, N));

    __cbuf__ A_DType l1ABuf[M * AlignK / PackFactor<A_DType>];
    __cbuf__ B_DType l1BBuf[AlignK * N / PackFactor<B_DType>];
    __cbuf__ Scale_DType l1ScaleABuf[M * scaleK];
    __cbuf__ Scale_DType l1ScaleBBuf[scaleK * N];
    __ca__ A_DType l0ABuf[M * AlignK / PackFactor<A_DType>];
    __cb__ B_DType l0BBuf[AlignK * N / PackFactor<B_DType>];
    __cc__ C_DType l0CBuf[M * N];

    auto l1ATensor = MakeTensor(
        MakeMemPtr(l1ABuf), MakeFrameLayout<NZLayoutPtn, C0_ELEMENT<A_DType>>(M, K));
    auto l1BTensor = MakeTensor(
        MakeMemPtr(l1BBuf), MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT<B_DType>>(K, N));
    auto l1ScaleATensor = MakeTensor(
        MakeMemPtr(l1ScaleABuf), MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(M, scaleK));
    auto l1ScaleBTensor = MakeTensor(
        MakeMemPtr(l1ScaleBBuf), MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(scaleK, N));
    auto l0ATensor = MakeTensor(
        MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, C0_ELEMENT<A_DType>>(M, K));
    auto l0BTensor = MakeTensor(
        MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT<B_DType>>(K, N));
    auto l0ScaleATensor = MakeTensor(
        MakeMemPtr<Location::L0ScaleA, Scale_DType>(reinterpret_cast<uint64_t>(l0ABuf) / 16),
        MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(M, scaleK));
    auto l0ScaleBTensor = MakeTensor(
        MakeMemPtr<Location::L0ScaleB, Scale_DType>(reinterpret_cast<uint64_t>(l0BBuf) / 16),
        MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(scaleK, N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_L0C>(M, N));

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL12L0ScaleAAtom = MakeCopy(CopyL12L0ScaleA{}, CopyL12L0ScaleATraitDefault{});
    auto copyL12L0ScaleBAtom = MakeCopy(CopyL12L0ScaleB{}, CopyL12L0ScaleBTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mxMmadAtom = MakeMmad(MmadOperation{}, MmadTraitMX{});

    constexpr uint32_t L1_EVENT_ID = 0;
    constexpr uint32_t L0_EVENT_ID = 1;
    constexpr uint32_t L0C_EVENT_ID = 2;
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);

    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    Copy(copyGM2L1Atom, l1ATensor, gmATensor);
    Copy(copyGM2L1Atom, l1BTensor, gmBTensor);
    Copy(copyGM2L1Atom, l1ScaleATensor, gmScaleATensor);
    Copy(copyGM2L1Atom, l1ScaleBTensor, gmScaleBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    Copy(copyL12L0AAtom, l0ATensor, l1ATensor);
    Copy(copyL12L0BAtom, l0BTensor, l1BTensor);
    Copy(copyL12L0ScaleAAtom, l0ScaleATensor, l1ScaleATensor);
    Copy(copyL12L0ScaleBAtom, l0ScaleBTensor, l1ScaleBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);

    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    MmadParams mxMmadParams{M, N, K, 0, true};
    Mmad(mxMmadAtom.with(mxMmadParams), l0CTensor, l0ATensor, l0BTensor);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);

    FixpipeParams fixpipeParams;
    Copy(copyL0C2GMAtom.with(fixpipeParams), gmCTensor, l0CTensor);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = hifloat4x2_t;
    using B_TYPE = hifloat4x2_t;
    using C_TYPE = float;

    constexpr uint32_t M = 128;
    constexpr uint32_t N = 128;
    constexpr uint32_t K = 256;
    constexpr uint32_t numBlocks = 1;

    constexpr uint32_t scaleKUnaligned = (K + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER;
    constexpr uint32_t sK = ((scaleKUnaligned + SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER) * SCALE_ALIGN_NUMBER;

    // hifloat4x2_t packs two 4-bit elements per byte; hif4_scale is HIF4_SCALE_BYTES_PER_GROUP
    // bytes per K-group (E6M2 + E1_8 + E1_16 packed into one 32-bit word).
    size_t aFileSize = static_cast<size_t>(M * K) * sizeof(uint8_t) / 2;
    size_t bFileSize = static_cast<size_t>(N * K) * sizeof(uint8_t) / 2;
    size_t asFileSize = static_cast<size_t>(M * sK) * HIF4_SCALE_BYTES_PER_GROUP * sizeof(uint8_t);
    size_t bsFileSize = static_cast<size_t>(N * sK) * HIF4_SCALE_BYTES_PER_GROUP * sizeof(uint8_t);
    size_t cFileSize = static_cast<size_t>(M * N) * sizeof(C_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* asHost;
    uint8_t* asDevice;
    aclrtMallocHost((void**)(&asHost), asFileSize);
    aclrtMalloc((void**)&asDevice, asFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/scaleA.bin", asFileSize, asHost, asFileSize);
    aclrtMemcpy(asDevice, asFileSize, asHost, asFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bsHost;
    uint8_t* bsDevice;
    aclrtMallocHost((void**)(&bsHost), bsFileSize);
    aclrtMalloc((void**)&bsDevice, bsFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/scaleB.bin", bsFileSize, bsHost, bsFileSize);
    aclrtMemcpy(bsDevice, bsFileSize, bsHost, bsFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_hifp4_custom<A_TYPE, B_TYPE, C_TYPE, M, N, K>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, asDevice, bsDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(asDevice);
    aclrtFreeHost(asHost);
    aclrtFree(bsDevice);
    aclrtFreeHost(bsHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
