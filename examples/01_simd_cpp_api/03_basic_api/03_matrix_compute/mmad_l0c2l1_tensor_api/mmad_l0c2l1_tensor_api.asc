/* !
 * \file mmad_l0c2l1_tensor_api.asc
 * \brief 基于Tensor API演示L0C到L1的搬运通路(CopyL0C2L1)。
 *        3510上L1不能直接搬出到GM，因此通过两次矩阵乘完成校验：
 *        第一次 A*B=C，结果经Fixpipe从L0C搬运到L1(NZ, half)；
 *        第二次 A*C=Out，C作为右矩阵从L1加载到L0B，结果输出到GM。
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

template <typename A_TYPE, typename C_TYPE, typename L0C_TYPE, int32_t M, int32_t N, int32_t K>
__cube__ __global__ void mmad_l0c2l1_custom(__gm__ A_TYPE* a, __gm__ A_TYPE* b, __gm__ C_TYPE* out)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // GM 上的输入/输出张量。A 按 ND 读取，B 转置存储按 DN 读取，Out 按 ND 写出。
    auto gmATensor = MakeTensor(MakeMemPtr(a), MakeFrameLayout<NDExtLayoutPtn>(M, K));
    auto gmBTensor = MakeTensor(MakeMemPtr(b), MakeFrameLayout<DNExtLayoutPtn>(K, N));
    auto gmOutTensor = MakeTensor(MakeMemPtr(out), MakeFrameLayout<NDExtLayoutPtn>(M, N));

    // L1 缓存：A(NZ)、B(ZN)，以及第一次矩阵乘的结果 C(NZ, half)。
    __cbuf__ A_TYPE l1ABuf[M * K];
    __cbuf__ A_TYPE l1BBuf[K * N];
    __cbuf__ C_TYPE l1CBuf[M * N];
    // L0 缓存：L0A(NZ)、L0B(ZN)、L0C(累加类型)。两次矩阵乘复用同一组 L0 缓存。
    __ca__ A_TYPE l0ABuf[M * K];
    __cb__ A_TYPE l0BBuf[K * N];
    __cc__ L0C_TYPE l0CBuf[M * N];

    auto l1ATensor = MakeTensor(MakeMemPtr(l1ABuf), MakeFrameLayout<NZLayoutPtn, A_TYPE>(M, K));
    auto l1BTensor = MakeTensor(MakeMemPtr(l1BBuf), MakeFrameLayout<ZNLayoutPtn, A_TYPE>(K, N));
    auto l1CTensor = MakeTensor(MakeMemPtr(l1CBuf), MakeFrameLayout<NZLayoutPtn, C_TYPE>(M, N));
    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, A_TYPE>(M, K));
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, A_TYPE>(K, N));
    // 第二次矩阵乘的右矩阵 C 从 L1(NZ) 加载到 L0B(ZN)，元素类型为 C_TYPE。
    auto l0CInputTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, C_TYPE>(K, N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn>(M, N));

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2L1Atom = MakeCopy(CopyL0C2L1{}, CopyL0C2L1TraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    static constexpr uint32_t EVENT_ID = 0;

    // ---------- 第一次矩阵乘：A * B = C ----------
    // GM -> L1
    Copy(copyGM2L1Atom, l1ATensor, gmATensor);
    Copy(copyGM2L1Atom, l1BTensor, gmBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID);

    // L1 -> L0A / L0B
    Copy(copyL12L0AAtom, l0ATensor, l1ATensor);
    Copy(copyL12L0BAtom, l0BTensor, l1BTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID);

    // mmad -> L0C
    MmadParams para1;
    para1.m = M;
    para1.n = N;
    para1.k = K;
    para1.cmatrixInitVal = true;
    Mmad(mmadAtom.with(para1), l0CTensor, l0ATensor, l0BTensor);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID);

    // L0C -> L1（新增通路）。dst 为 half、src 为 float，自动选择 F322F16 随路转换。
    Copy(copyL0C2L1Atom, l1CTensor, l0CTensor);
    AscendC::SetFlag<AscendC::HardEvent::FIX_MTE1>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE1>(EVENT_ID);

    // ---------- 第二次矩阵乘：A * C = Out ----------
    // A 已在 L1，重新加载到 L0A；C 从 L1(NZ) 加载到 L0B(ZN)。
    Copy(copyL12L0AAtom, l0ATensor, l1ATensor);
    Copy(copyL12L0BAtom, l0CInputTensor, l1CTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID);

    MmadParams para2;
    para2.m = M;
    para2.n = N;
    para2.k = K;
    para2.cmatrixInitVal = true;
    Mmad(mmadAtom.with(para2), l0CTensor, l0ATensor, l0CInputTensor);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID);

    // L0C -> GM，随路 F322F16 转换为 half 输出。
    Copy(copyL0C2GMAtom, gmOutTensor, l0CTensor);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = half;
    using C_TYPE = half;
    using L0C_TYPE = float;

    constexpr int32_t M = 128;
    constexpr int32_t N = 128;
    constexpr int32_t K = 128;
    constexpr uint32_t NUM_BLOCKS = 1;

    size_t aFileSize = M * K * sizeof(A_TYPE);
    size_t bFileSize = K * N * sizeof(A_TYPE);
    size_t outFileSize = M * N * sizeof(C_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost, *bHost, *outHost;
    A_TYPE* aDevice;
    A_TYPE* bDevice;
    C_TYPE* outDevice;

    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_a.bin", aFileSize, aHost, aFileSize);
    ReadFile("./input/input_b.bin", bFileSize, bHost, bFileSize);

    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    mmad_l0c2l1_custom<A_TYPE, C_TYPE, L0C_TYPE, M, N, K><<<NUM_BLOCKS, 0, stream>>>(aDevice, bDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
