/* !
 * \file ssbuf_boundary_cases.asc
 * \brief Verifies safe SSBuffer boundary cases in one AIC-to-two-AIV MIX task.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t SSBUF_BYTES = 3U * 1024U;
constexpr uint32_t RECORD_BYTES = 32U;
constexpr uint32_t LAST_RECORD_OFFSET = SSBUF_BYTES - RECORD_BYTES;
constexpr uint32_t AIV_COUNT = 2U;
constexpr uint32_t LAUNCH_COUNT = 16U;
constexpr uint32_t READY_MAGIC = 0x5A5A1234U;
constexpr uint16_t READY_FLAG_ID = 9U;

struct alignas(RECORD_BYTES) BoundaryRecord {
    volatile uint32_t ready;
    uint32_t producer;
    uint32_t round;
    uint32_t roundInverse;
    uint64_t payload;
    uint64_t payloadInverse;
};

struct BoundaryResult {
    uint32_t offset;
    uint32_t producer;
    uint32_t round;
    uint32_t valid;
    uint64_t payload;
    uint64_t payloadInverse;
};

static_assert(sizeof(BoundaryRecord) == RECORD_BYTES, "BoundaryRecord must occupy one 32-byte access unit");
static_assert(alignof(BoundaryRecord) == RECORD_BYTES, "BoundaryRecord must be 32-byte aligned");
static_assert(LAST_RECORD_OFFSET % RECORD_BYTES == 0, "The final record must be 32-byte aligned");
static_assert(LAST_RECORD_OFFSET + sizeof(BoundaryRecord) == SSBUF_BYTES, "The final record must end at 3KB");

__aicore__ inline void CompilerBarrier() { __asm__ __volatile__("" ::: "memory"); }

__aicore__ inline uint64_t MakePayload(uint32_t producer, uint32_t round)
{
    return 0x53534255464F554EULL + static_cast<uint64_t>(producer) * 0x10000ULL + round;
}

__aicore__ inline __ssbuf__ BoundaryRecord* GetRecord(__ssbuf__ void* base, uint32_t offset)
{
    __ssbuf__ uint8_t* bytes = reinterpret_cast<__ssbuf__ uint8_t*>(base);
    return reinterpret_cast<__ssbuf__ BoundaryRecord*>(bytes + offset);
}

__aicore__ inline void ClearRecord(__ssbuf__ BoundaryRecord* record)
{
    *reinterpret_cast<__ssbuf__ uint64_t*>(record) = 0;
}

__aicore__ inline void PublishRecord(__ssbuf__ BoundaryRecord* record, uint32_t producer, uint32_t round)
{
    const uint64_t payload = MakePayload(producer, round);
    record->producer = producer;
    record->round = round;
    record->roundInverse = ~round;
    record->payload = payload;
    record->payloadInverse = ~payload;
    CompilerBarrier();
    record->ready = READY_MAGIC;
}

__aicore__ inline void ConsumeRecord(__ssbuf__ BoundaryRecord* record, uint32_t offset, __gm__ BoundaryResult* output)
{
    while (record->ready != READY_MAGIC) {
        CompilerBarrier();
    }
    CompilerBarrier();

    const uint32_t producer = record->producer;
    const uint32_t round = record->round;
    const uint64_t payload = record->payload;
    const bool valid = record->roundInverse == ~round && record->payloadInverse == ~payload &&
                       payload == MakePayload(producer, round);

    output->offset = offset;
    output->producer = producer;
    output->round = round;
    output->valid = valid ? 1U : 0U;
    output->payload = payload;
    output->payloadInverse = record->payloadInverse;

    CompilerBarrier();
    ClearRecord(record);
}
} // namespace

extern "C" __global__ __mix__(1, 2) void ssbuf_boundary_cases(__gm__ BoundaryResult* output, uint32_t round)
{
    AscendC::InitSocState();
    __ssbuf__ void* base = AscendC::GetSsbufBaseAddr();
    __ssbuf__ BoundaryRecord* firstRecord = GetRecord(base, 0U);
    __ssbuf__ BoundaryRecord* lastRecord = GetRecord(base, LAST_RECORD_OFFSET);

    if ASCEND_IS_AIC {
        ClearRecord(firstRecord);
        ClearRecord(lastRecord);
        CompilerBarrier();
        AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(READY_FLAG_ID);
        ConsumeRecord(firstRecord, 0U, output);
        ConsumeRecord(lastRecord, LAST_RECORD_OFFSET, output + 1);
    }

    if ASCEND_IS_AIV {
        AscendC::CrossCoreWaitFlag<2>(READY_FLAG_ID);
        const uint32_t producer = static_cast<uint32_t>(AscendC::GetSubBlockIdx());
        PublishRecord(producer == 0U ? firstRecord : lastRecord, producer, round);
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CheckAcl(aclError result, const char* expression)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed, ret=%d\n", expression, static_cast<int32_t>(result));
    return false;
}

#define CHECK_ACL(expression)                      \
    do {                                           \
        if (!CheckAcl((expression), #expression)) { \
            return 1;                              \
        }                                          \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    constexpr int32_t DEVICE_ID = 0;
    constexpr size_t OUTPUT_BYTES = AIV_COUNT * sizeof(BoundaryResult);

    BoundaryResult* outputHost = nullptr;
    BoundaryResult* outputDevice = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&outputHost), OUTPUT_BYTES));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));

    bool passed = true;
    for (uint32_t round = 0; round < LAUNCH_COUNT; ++round) {
        CHECK_ACL(aclrtMemset(outputDevice, OUTPUT_BYTES, 0, OUTPUT_BYTES));
        ssbuf_boundary_cases<<<1, 0, stream>>>(outputDevice, round);
        CHECK_ACL(aclrtSynchronizeStream(stream));
        CHECK_ACL(aclrtMemcpy(outputHost, OUTPUT_BYTES, outputDevice, OUTPUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));

        const uint32_t expectedOffsets[AIV_COUNT] = {0U, LAST_RECORD_OFFSET};
        for (uint32_t producer = 0; producer < AIV_COUNT; ++producer) {
            const BoundaryResult& result = outputHost[producer];
            const uint64_t expectedPayload = 0x53534255464F554EULL +
                                             static_cast<uint64_t>(producer) * 0x10000ULL + round;
            if (result.offset != expectedOffsets[producer] || result.producer != producer || result.round != round ||
                result.valid != 1U || result.payload != expectedPayload || result.payloadInverse != ~expectedPayload) {
                std::fprintf(stderr, "[ERROR] round=%u producer=%u offset=%u outputProducer=%u outputRound=%u valid=%u\n",
                    round, producer, result.offset, result.producer, result.round, result.valid);
                passed = false;
            }
        }
    }

    CHECK_ACL(aclrtFree(outputDevice));
    CHECK_ACL(aclrtFreeHost(outputHost));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());

    std::printf(passed ? "test pass!\n" : "test failed!\n");
    return passed ? 0 : 1;
}
