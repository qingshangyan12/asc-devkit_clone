/* !
 * \file ssbuffer.asc
 * \brief SSBuffer核间通信样例的调用实现
 */
#include "ssbuffer.h"
#include "data_utils.h"

#include <cstdint>
#include <iostream>
#include <vector>

// 基址验证：确认Ascend 950PR/Ascend 950DT的NPU域能够调用GetSsbufBaseAddr并获得SSBuffer的特殊基址。
// 本核函数只读取基址，不读写SSBuffer中的消息；核间消息通信请参考ssbuffer_aiv_to_aic_verify。
__global__ __vector__ void ssbuffer_base_addr_verify()
{
    AscendC::InitSocState();
    __ssbuf__ void* ssbuf = AscendC::GetSsbufBaseAddr();
    AscendC::printf("GetSsbufBaseAddr: %p\n", ssbuf);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 消息验证：AIC:AIV为1:2分离模式下，AIV0将32字节消息写入SSBuffer并发布就绪标记，
// AIC等待标记完成后从SSBuffer读取消息，AIV侧将消息回写GM供Host校验。
__global__ __mix__(1, 2) __aicore__ void ssbuffer_aiv_to_aic_verify(__gm__ uint64_t* output)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    AscendC::InitSocState();

    __ssbuf__ uint8_t* ssbuffer =
        reinterpret_cast<__ssbuf__ uint8_t*>(AscendC::GetSsbufBaseAddr());
    __ssbuf__ SsbufferMessage* message =
        reinterpret_cast<__ssbuf__ SsbufferMessage*>(ssbuffer + VERIFY_MESSAGE_OFFSET);

    if ASCEND_IS_AIV {
        // 1:2场景中仅AIV0生产本示例的消息，AIV1仍须参与模式2同步。
        if (AscendC::GetSubBlockIdx() == 0) {
            message->value[0] = EXPECTED_VALUE[0];
            message->value[1] = EXPECTED_VALUE[1];
            message->value[2] = EXPECTED_VALUE[2];
            message->value[3] = EXPECTED_VALUE[3];

            // 回写GM供Host校验AIV侧写入结果。
            output[4] = message->value[0];
            output[5] = message->value[1];
            output[6] = message->value[2];
            output[7] = message->value[3];
        }

        // SSBuffer访问位于Scalar流水；先建立Scalar到Vector的核内顺序，
        // 再以模式2发布AIV到AIC的就绪标记。
        AscendC::SetFlag<AscendC::HardEvent::S_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(0);
        AscendC::CrossCoreSetFlag<2, PIPE_V>(AIV_TO_AIC_FLAG);
    }

    if ASCEND_IS_AIC {
        // 模式2等待同一逻辑AI Core上的两个AIV均发布完成。
        AscendC::CrossCoreWaitFlag<2, PIPE_M>(AIV_TO_AIC_FLAG);

        // 将等待所在的Cube流水与后续Scalar读取建立顺序。
        AscendC::SetFlag<AscendC::HardEvent::M_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::M_S>(0);

        output[0] = message->value[0];
        output[1] = message->value[1];
        output[2] = message->value[2];
        output[3] = message->value[3];
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    if constexpr (SCENARIO_NUM == 0) {
        // 场景0：基址验证。以单个AIV Block启动核函数并完成流同步，执行结果需检查打印日志。
        aclInit(nullptr);
        int32_t deviceId = 0;
        aclrtSetDevice(deviceId);
        aclrtStream stream = nullptr;
        aclrtCreateStream(&stream);

        ssbuffer_base_addr_verify<<<1, 0, stream>>>();
        aclrtSynchronizeStream(stream);

        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 0;
    } else {
        // 场景1：AIV->AIC消息验证。output共8个uint64_t：
        // output[0..3]为AIC从SSBuffer读取的消息，output[4..7]为AIV侧回写的消息。
        int32_t deviceId = 0;
        aclrtStream stream = nullptr;
        constexpr uint32_t outputCount = 8;
        constexpr size_t outputByteSize = outputCount * sizeof(uint64_t);

        aclInit(nullptr);
        aclrtSetDevice(deviceId);
        aclrtCreateStream(&stream);

        uint8_t* outputHost = nullptr;
        uint8_t* outputDevice = nullptr;
        aclrtMallocHost((void**)(&outputHost), outputByteSize);
        aclrtMalloc((void**)&outputDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemset(outputDevice, outputByteSize, 0, outputByteSize);

        ssbuffer_aiv_to_aic_verify<<<1, 0, stream>>>((__gm__ uint64_t*)outputDevice);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", outputHost, outputByteSize);

        aclrtFree(outputDevice);
        aclrtFreeHost(outputHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 0;
    }
}