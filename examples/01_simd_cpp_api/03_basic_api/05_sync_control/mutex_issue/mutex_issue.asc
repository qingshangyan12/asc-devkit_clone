/* !
 * \file mutex_issue.asc
 * \brief Validates Mutex synchronization between PIPE_V and PIPE_MTE3 on Ascend 950.
 */

#include <cstring>

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t SCENARIO = SCENARIO_NUM;
constexpr uint32_t BLOCK_NUM = 8;
constexpr uint32_t TILE_LENGTH = 16 * 1024;
constexpr uint32_t OUTPUT_LENGTH = BLOCK_NUM * TILE_LENGTH * 2;

class KernelMutexIssue {
public:
    __aicore__ inline void Init(__gm__ uint8_t* outputGm)
    {
        outputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(outputGm), OUTPUT_LENGTH);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<half> vector1Local = ubAllocator.Alloc<half, TILE_LENGTH>();
        AscendC::LocalTensor<half> vector2Local = ubAllocator.Alloc<half, TILE_LENGTH>();
        uint8_t mutexId = AscendC::AllocMutexID();

        if constexpr (SCENARIO == 0) {
            Question1First(mutexId, vector1Local, vector2Local);
        } else if constexpr (SCENARIO == 1) {
            Question1Second(mutexId, vector1Local, vector2Local);
        } else if constexpr (SCENARIO == 2) {
            Question2WithoutBarrier(mutexId, vector1Local, vector2Local);
        } else if constexpr (SCENARIO == 3) {
            Question3Original(mutexId, vector1Local, vector2Local);
        } else {
            Question3Correct(mutexId, vector1Local, vector2Local);
        }

        AscendC::ReleaseMutexID(mutexId);
    }

private:
    __aicore__ inline void Vector1(AscendC::LocalTensor<half>& vector1Local)
    {
        AscendC::Duplicate(vector1Local, static_cast<half>(1), TILE_LENGTH);
    }

    __aicore__ inline void Vector2Dependent(
        AscendC::LocalTensor<half>& vector1Local, AscendC::LocalTensor<half>& vector2Local)
    {
        AscendC::Adds(vector2Local, vector1Local, static_cast<half>(1), TILE_LENGTH);
    }

    __aicore__ inline void Vector2Independent(AscendC::LocalTensor<half>& vector2Local)
    {
        // Keep the second V section busy long enough to expose an early MTE3 acquisition.
        for (uint16_t value = 1; value <= 32; ++value) {
            AscendC::Duplicate(vector2Local, static_cast<half>(value), TILE_LENGTH);
        }
    }

    __aicore__ inline void CopyOut(uint8_t mutexId, AscendC::LocalTensor<half>& vector1Local,
        AscendC::LocalTensor<half>& vector2Local)
    {
        uint32_t offset = AscendC::GetBlockIdx() * TILE_LENGTH * 2;
        AscendC::DataCopyExtParams copyParams{1, TILE_LENGTH * sizeof(half), 0, 0, 0};
        AscendC::Mutex::Lock<PIPE_MTE3>(mutexId);
        // Copy Vector2 first to expose an MTE3 start that occurs before Vector2 completes.
        AscendC::DataCopyPad(outputGlobal[offset], vector2Local, copyParams);
        AscendC::DataCopyPad(outputGlobal[offset + TILE_LENGTH], vector1Local, copyParams);
        AscendC::Mutex::Unlock<PIPE_MTE3>(mutexId);
    }

    __aicore__ inline void Question1First(uint8_t mutexId, AscendC::LocalTensor<half>& vector1Local,
        AscendC::LocalTensor<half>& vector2Local)
    {
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector1(vector1Local);
        AscendC::PipeBarrier<PIPE_V>();
        Vector2Dependent(vector1Local, vector2Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
        CopyOut(mutexId, vector1Local, vector2Local);
    }

    __aicore__ inline void Question1Second(uint8_t mutexId, AscendC::LocalTensor<half>& vector1Local,
        AscendC::LocalTensor<half>& vector2Local)
    {
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector1(vector1Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector2Dependent(vector1Local, vector2Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
        CopyOut(mutexId, vector1Local, vector2Local);
    }

    __aicore__ inline void Question2WithoutBarrier(uint8_t mutexId,
        AscendC::LocalTensor<half>& vector1Local, AscendC::LocalTensor<half>& vector2Local)
    {
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector1(vector1Local);
        Vector2Dependent(vector1Local, vector2Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
        CopyOut(mutexId, vector1Local, vector2Local);
    }

    __aicore__ inline void Question3Original(uint8_t mutexId, AscendC::LocalTensor<half>& vector1Local,
        AscendC::LocalTensor<half>& vector2Local)
    {
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector1(vector1Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);

        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector2Independent(vector2Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
        CopyOut(mutexId, vector1Local, vector2Local);
    }

    __aicore__ inline void Question3Correct(uint8_t mutexId, AscendC::LocalTensor<half>& vector1Local,
        AscendC::LocalTensor<half>& vector2Local)
    {
        AscendC::Mutex::Lock<PIPE_V>(mutexId);
        Vector1(vector1Local);
        Vector2Independent(vector2Local);
        AscendC::Mutex::Unlock<PIPE_V>(mutexId);
        CopyOut(mutexId, vector1Local, vector2Local);
    }

private:
    AscendC::GlobalTensor<half> outputGlobal;
};

__vector__ __global__ void mutex_issue_custom(__gm__ uint8_t* output)
{
    AscendC::InitSocState();
    KernelMutexIssue op;
    op.Init(output);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t outputByteSize = OUTPUT_LENGTH * sizeof(uint16_t);
    int32_t deviceId = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtContext context;
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    std::memset(outputHost, 0, outputByteSize);
    aclrtMemcpy(outputDevice, outputByteSize, outputHost, outputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    mutex_issue_custom<<<BLOCK_NUM, 0, stream>>>(outputDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("output/output.bin", outputHost, outputByteSize);

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
