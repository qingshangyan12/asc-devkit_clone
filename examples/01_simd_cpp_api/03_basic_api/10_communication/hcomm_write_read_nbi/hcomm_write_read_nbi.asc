/*!
 * \file hcomm_write_read_nbi.asc
 * \brief Hcomm WriteNbi/ReadNbi 点对点通信样例。
 *        先通过 WriteNbi 将本地数据写入远端，再通过 ReadNbi 从远端读回本地，
 *        一个流程覆盖两个核心 P2P 通信接口的完整用法。
 *
 * 与集合通信（如AlltoAll）不同，P2P通信直接向目标NPU发起RDMA操作，无需等待所有rank同步，
 * 延迟更低且可精确控制每次搬运的数据量和提交时机，适用于MoE Dispatch/Combine、Pipeline并行等场景。
 *
 * 前置条件：
 *   Host侧需通过 HcclCommInitRootInfo / HcclCommMemReg / HcclChannelAcquire 完成通信资源初始化，
 *   因为Kernel侧的ChannelHandle封装了SQ/CQ上下文和远端buffer地址，这些资源只能由Host侧创建。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "adv_api/hcomm/hcomm.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// 512字节是Hcomm内部WQE+CQE+SQ PI等结构的总大小下限，小于此值Init会返回失败
constexpr uint32_t HCOMM_WORKSPACE_SIZE = 512U;
constexpr uint32_t DATA_SIZE = 256U;

namespace HcommExample {

// Kernel侧无法自行创建通信资源（SQ/CQ、远端buffer映射等），必须由Host侧通过HCCL接口初始化后传入
struct CommContext {
    uint64_t hcommHandle[8];        // 内核通过此句柄访问SQ/CQ，由Host侧 HcclChannelAcquire 创建
    uint64_t localBufferAddr[8];    // 本地读写操作的地址基址，由Host侧 HcclCommMemReg 注册
    uint64_t remoteBufferAddr[8];   // WriteNbi/ReadNbi内部会用远端地址查找tokenId，地址必须在此注册范围内
    uint32_t epRankId;
    uint32_t epWorldSize;
    // 校验结果：kernel写入，host读回。0=通过，非0=失败
    // 之所以通过GM回传而非返回值，是因为kernel的返回值无法被Host直接捕获，
    // 而GM上的字段可以通过aclrtMemcpy回读
    uint32_t testResult;
};

class KernelHcommWriteRead {
public:
    __aicore__ inline KernelHcommWriteRead() {}

    __aicore__ inline void Init(GM_ADDR context, AscendC::TPipe *pipe)
    {
        tpipe_ = pipe;
        context_ = reinterpret_cast<__gm__ CommContext *>(context);
        epRankId_ = context_->epRankId;
        epWorldSize_ = context_->epWorldSize;

        // Hcomm内部通过WQE/CQE队列管理通信任务，这些队列结构需要一块UB空间来存放，
        // 因此必须在任何通信操作之前调用Init分配并初始化这块工作空间
        tpipe_->InitBuffer(hcommBuf_, HCOMM_WORKSPACE_SIZE);
        hcommTensor_ = hcommBuf_.Get<uint8_t>();
        __ubuf__ uint8_t *bufPtr = reinterpret_cast<__ubuf__ uint8_t *>(hcommTensor_.GetPhyAddr());
        // 清零是因为WQE中的owner位用于判断队列条目是否有效，残留脏数据会导致PollCq误判
        for (uint32_t i = 0; i < HCOMM_WORKSPACE_SIZE; i++) {
            bufPtr[i] = 0;
        }
        if (hcomm_.Init(bufPtr, HCOMM_WORKSPACE_SIZE) != AscendC::HCOMM_SUCCESS) {
            initOk_ = false;
        }
    }

    __aicore__ inline void Process()
    {
        // 初始化为0（通过），VerifyPattern失败时会将其置1
        context_->testResult = 0;
        if (!initOk_ || epWorldSize_ < 2 || epRankId_ >= epWorldSize_) {
            Fail();
            return;
        }

        uint32_t peerRankId = (epRankId_ + 1) % epWorldSize_;
        AscendC::ChannelHandle channel = GetChannel(peerRankId);

        // 本样例只通过Hcomm接口访问远端buffer：先Write到远端，再Read回本地校验。
        // 本地buffer使用不同偏移段，避免ReadNbi写回时覆盖WriteNbi的本地源数据。
        GM_ADDR writeLocalSrc = GetLocalAddr(epRankId_, 0);
        GM_ADDR remoteBuf = GetRemoteAddr(peerRankId, 0);
        GM_ADDR readLocalDst = GetLocalAddr(epRankId_, DATA_SIZE);

        // --- 第一步：WriteNbi ---
        // 填充本rank的pattern，接收方收到后应与本rank的pattern一致
        FillPattern(epRankId_, writeLocalSrc, DATA_SIZE);

        // commit=true（默认值）：单次任务没有批量优化空间，入队后立即doorbell是最合理的选择
        // 如需批量优化，可改用 WriteNbi<false> 多次入队后统一 Commit，减少doorbell次数
        if (hcomm_.WriteNbi(channel, remoteBuf, writeLocalSrc, DATA_SIZE) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }

        // 必须Drain：WriteNbi只是将WQE入队并doorbell，实际RDMA写操作是异步的，
        // 不调用Drain则无法保证远端数据已可见，后续依赖该数据的计算可能读到旧值
        if (hcomm_.Drain(channel) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }

        // --- 第二步：ReadNbi ---
        // ReadNbi与WriteNbi参数语义一致（dst=本地, src=远端），但内部实现中
        // PostSend对Read操作交换了src/dst顺序（见hcomm_aiv_urma.h:406），这是RDMA Read语义决定的
        // 这里从刚刚写入的远端buffer读回本地，既演示ReadNbi用法，也避免直接load/store远端GM。
        if (hcomm_.ReadNbi(channel, readLocalDst, remoteBuf, DATA_SIZE) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }

        // Drain对Read同样必要：RDMA Read是异步的，Drain轮询CQ确认数据已写入本地GM后才返回
        if (hcomm_.Drain(channel) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }

        // 校验读取：Drain返回后本地buffer应包含本rank通过WriteNbi写到远端的pattern
        VerifyPattern(epRankId_, readLocalDst, DATA_SIZE);
    }

private:
    // Host侧为每对(rank_i, rank_j)创建channel时不包含自身，数组按"跳过自身"的方式紧凑存储，
    // 因此当目标rankId大于自身时索引需要减1来跳过自身位置
    AscendC::ChannelHandle GetChannel(uint32_t rankId)
    {
        uint32_t index = (rankId > epRankId_) ? (rankId - 1) : rankId;
        return context_->hcommHandle[index];
    }

    GM_ADDR GetLocalAddr(uint32_t rankId, uint32_t offset)
    {
        return reinterpret_cast<GM_ADDR>(context_->localBufferAddr[rankId] + offset);
    }

    // 远端地址必须通过此接口获取，因为WriteNbi/ReadNbi内部会用该地址在channel的remoteBuffer中
    // 查找对应的tokenId/tokenValue，传入非法地址会导致PostSend返回HCOMM_FAILED
    GM_ADDR GetRemoteAddr(uint32_t rankId, uint32_t offset)
    {
        return reinterpret_cast<GM_ADDR>(context_->remoteBufferAddr[rankId] + offset);
    }

    __aicore__ inline void Fail()
    {
        context_->testResult = 1;
    }

    // 用rankId生成确定性pattern：每个rank填充不同的值，通信后才能区分数据来源是否正确
    // 选择 (rankId + 1) 而非 rankId 是为了避免rank 0的pattern全为0，与未初始化的内存无法区分
    __aicore__ inline void FillPattern(uint32_t rankId, GM_ADDR buffer, uint32_t size)
    {
        __gm__ uint8_t *ptr = reinterpret_cast<__gm__ uint8_t *>(buffer);
        uint8_t pattern = static_cast<uint8_t>((rankId + 1) & 0xFF);
        for (uint32_t i = 0; i < size; i++) {
            ptr[i] = pattern;
        }
    }

    // 逐字节比对，发现不一致时将testResult置1
    // 不使用返回值而写context_是因为Host侧只能通过GM上的字段获取kernel的校验结果
    __aicore__ inline void VerifyPattern(uint32_t expectedRankId, GM_ADDR buffer, uint32_t size)
    {
        __gm__ uint8_t *ptr = reinterpret_cast<__gm__ uint8_t *>(buffer);
        uint8_t expected = static_cast<uint8_t>((expectedRankId + 1) & 0xFF);
        for (uint32_t i = 0; i < size; i++) {
            if (ptr[i] != expected) {
                context_->testResult = 1;
                return;
            }
        }
    }

    AscendC::TPipe *tpipe_{nullptr};
    // 使用VECOUT位置的TBuf是因为Hcomm工作空间不参与向量计算，放在VECOUT区避免与计算buffer冲突
    AscendC::TBuf<AscendC::TPosition::VECOUT> hcommBuf_;
    AscendC::LocalTensor<uint8_t> hcommTensor_;
    // 选择COMM_PROTOCOL_UBC_CTP（URMA协议）是因为Ascend 950系列使用统一总线架构，
    // RoCE协议（COMM_PROTOCOL_ROCE）适用于跨机通信场景
    AscendC::Hcomm<AscendC::COMM_PROTOCOL_UBC_CTP> hcomm_;
    __gm__ CommContext *context_{nullptr};
    uint32_t epRankId_{0};
    uint32_t epWorldSize_{0};
    bool initOk_{true};
};

} // namespace HcommExample

using namespace HcommExample;

// Kernel入口：TPipe必须在kernel函数内创建，因为pipeline资源是per-AICore的
extern "C" __global__ __aicore__ void kernel_hcomm_write_read_nbi(GM_ADDR context)
{
    AscendC::TPipe pipe;
    HcommExample::KernelHcommWriteRead op;
    op.Init(context, &pipe);
    op.Process();
}

// Host侧主函数（简化版）：
// 实际多卡场景中，各rank需分别完成 HcclCommInitRootInfo → HcclCommMemReg → HcclChannelAcquire，
// 因为通信域、对称内存、channel都是per-rank资源，无法在一个rank上代替其他rank创建
int32_t main()
{
    aclInit(nullptr);

    uint32_t devCount = 0;
    aclrtGetDeviceCount(&devCount);
    if (devCount == 0) {
        return -1;
    }

    int32_t rankId = 0;
    aclrtSetDevice(rankId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 此处省略了HCCL初始化步骤，因为本样例聚焦Kernel侧的WriteNbi/ReadNbi调用方式，
    // 实际使用时hcommHandle和bufferAddr需通过HcclCommMemReg + HcclChannelAcquire填充
    CommContext hostCtx = {};
    hostCtx.epRankId = rankId;
    hostCtx.epWorldSize = devCount;
    hostCtx.testResult = 0;

    // 使用ACL_MEM_MALLOC_HUGE_ONLY是因为CommContext需要放在GM上，kernel才能通过__gm__指针访问
    uint8_t *devContext = nullptr;
    aclrtMalloc(reinterpret_cast<void **>(&devContext), sizeof(CommContext), ACL_MEM_MALLOC_HUGE_ONLY);
    aclrtMemcpy(devContext, sizeof(CommContext), &hostCtx, sizeof(CommContext), ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_hcomm_write_read_nbi<<<1, nullptr, stream>>>(devContext);

    // 必须同步等待：kernel中的Drain只保证AICore侧看到通信完成，
    // Host侧需要aclrtSynchronizeStream确保整个kernel（含通信和校验）已执行完毕
    aclrtSynchronizeStream(stream);

    // 将kernel写入的校验结果从设备GM回读到Host，这是Host获取kernel内部状态的唯一途径
    aclrtMemcpy(&hostCtx, sizeof(CommContext), devContext, sizeof(CommContext), ACL_MEMCPY_DEVICE_TO_HOST);

    if (hostCtx.testResult == 0) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(devContext);
    aclrtDestroyStream(stream);
    aclFinalize();
    return 0;
}
