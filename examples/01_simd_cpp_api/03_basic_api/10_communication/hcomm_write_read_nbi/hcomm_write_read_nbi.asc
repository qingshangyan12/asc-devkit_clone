/* !
 * \file hcomm_write_read_nbi.asc
 * \brief Hcomm WriteNbi/ReadNbi点对点通信样例
 */

#include <cstdio>
#include <cstring>
#include <unistd.h>
#include <string>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <sys/wait.h>
#include <signal.h>
#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_rank_graph.h"
#include "kernel_operator.h"
#include "adv_api/hcomm/hcomm.h"

// Hcomm工作空间大小下限，小于此值Init返回失败
constexpr uint32_t HCOMM_WORKSPACE_SIZE = 512U;
// 单次通信数据量（字节），需32字节对齐
constexpr uint32_t DATA_SIZE = 256U;
// 每张卡的通信窗口大小
constexpr uint64_t COMM_BUF_SIZE = 4096U;
// 通信卡数：卡0写入，卡1读出
constexpr uint32_t NRANKS = 2U;

namespace HcommExample {

// Kernel与Host共享的通信上下文，存放在GM上
struct CommContext {
    uint64_t channelHandle;     // 本rank到对端的通道句柄
    uint64_t localBufferAddr;   // 本rank的通信buffer基址
    uint64_t remoteBufferAddr;  // 对端的通信buffer基址
    uint32_t rankId;            // 本rank编号
    uint32_t worldSize;         // 通信域rank总数
    uint32_t role;              // 0=writer(WriteNbi), 1=reader(ReadNbi)
    // 校验结果：kernel写入，host读回。0=通过，非0=失败
    uint32_t testResult;
};

class KernelHcommWriteRead {
public:
    __aicore__ inline KernelHcommWriteRead() {}

    __aicore__ inline void Init(GM_ADDR context, AscendC::TPipe *pipe)
    {
        tpipe_ = pipe;
        context_ = reinterpret_cast<__gm__ CommContext *>(context);
        channel_ = context_->channelHandle;
        localBuf_ = reinterpret_cast<__gm__ uint8_t *>(context_->localBufferAddr);
        remoteBuf_ = reinterpret_cast<GM_ADDR>(context_->remoteBufferAddr);
        rankId_ = context_->rankId;
        worldSize_ = context_->worldSize;
        role_ = context_->role;

        // Hcomm内部WQE/CQE队列需要一块UB空间存放，调用Init分配并初始化工作空间
        tpipe_->InitBuffer(hcommBuf_, HCOMM_WORKSPACE_SIZE);
        hcommTensor_ = hcommBuf_.Get<uint8_t>();
        __ubuf__ uint8_t *bufPtr = reinterpret_cast<__ubuf__ uint8_t *>(hcommTensor_.GetPhyAddr());
        for (uint32_t i = 0; i < HCOMM_WORKSPACE_SIZE; i++) {
            bufPtr[i] = 0;
        }
        if (hcomm_.Init(bufPtr, HCOMM_WORKSPACE_SIZE) != AscendC::HCOMM_SUCCESS) {
            initOk_ = false;
        }
    }

    __aicore__ inline void Process()
    {
        context_->testResult = 0;
        if (!initOk_ || worldSize_ < 2 || rankId_ >= worldSize_) {
            Fail();
            return;
        }

        if (role_ == 0) {
            DoWrite();
        } else {
            DoReadAndVerify();
        }
    }

private:
    // writer：填充本地pattern，通过WriteNbi写入对端
    __aicore__ inline void DoWrite()
    {
        FillPattern(rankId_, localBuf_, DATA_SIZE);

        // WriteNbi(channel, dst=远端, src=本地, len)：将本地数据写入远端NPU指定地址
        // commit=true（默认）：入队后立即doorbell通知server执行
        GM_ADDR localSrc = reinterpret_cast<GM_ADDR>(localBuf_);
        if (hcomm_.WriteNbi(channel_, remoteBuf_, localSrc, DATA_SIZE) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }
        // Drain轮询CQ等待通信任务完成，返回后远端数据已可见
        if (hcomm_.Drain(channel_) != AscendC::HCOMM_SUCCESS) {
            Fail();
        }
    }

    // reader：通过ReadNbi从对端读出数据，并校验WriteNbi写入与ReadNbi读回结果
    __aicore__ inline void DoReadAndVerify()
    {
        uint32_t peerRankId = (rankId_ + 1) % worldSize_;

        // ReadNbi(channel, dst=本地, src=远端, len)：从远端NPU指定地址读取数据到本地
        // 本地目的地址使用DATA_SIZE偏移段，避免覆盖对端通过WriteNbi写入本地的数据
        __gm__ uint8_t *readDst = localBuf_ + DATA_SIZE;
        GM_ADDR localDst = reinterpret_cast<GM_ADDR>(readDst);
        if (hcomm_.ReadNbi(channel_, localDst, remoteBuf_, DATA_SIZE) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }
        if (hcomm_.Drain(channel_) != AscendC::HCOMM_SUCCESS) {
            Fail();
            return;
        }

        // 校验1：本地前半段应包含对端通过WriteNbi写入的pattern（验证一张卡写入到达另一张卡）
        VerifyPattern(peerRankId, localBuf_, DATA_SIZE);
        // 校验2：本地后半段应包含本rank通过ReadNbi从对端读回的pattern（验证另一张卡读出与写入一致）
        VerifyPattern(peerRankId, localBuf_ + DATA_SIZE, DATA_SIZE);
    }

    __aicore__ inline void Fail()
    {
        context_->testResult = 1;
    }

    // 用rankId生成确定性pattern：(rankId + 1) & 0xFF，避免rank 0全0与未初始化内存无法区分
    __aicore__ inline void FillPattern(uint32_t rankId, __gm__ uint8_t *buffer, uint32_t size)
    {
        uint8_t pattern = static_cast<uint8_t>((rankId + 1) & 0xFF);
        for (uint32_t i = 0; i < size; i++) {
            buffer[i] = pattern;
        }
    }

    // 逐字节比对，不一致时将testResult置1
    __aicore__ inline void VerifyPattern(uint32_t expectedRankId, __gm__ uint8_t *buffer, uint32_t size)
    {
        uint8_t expected = static_cast<uint8_t>((expectedRankId + 1) & 0xFF);
        for (uint32_t i = 0; i < size; i++) {
            if (buffer[i] != expected) {
                context_->testResult = 1;
                return;
            }
        }
    }

    AscendC::TPipe *tpipe_{nullptr};
    AscendC::TBuf<AscendC::TPosition::VECOUT> hcommBuf_;
    AscendC::LocalTensor<uint8_t> hcommTensor_;
    // COMM_PROTOCOL_UBC_CTP（URMA协议）适用于Ascend 950系列；RoCE协议使用COMM_PROTOCOL_ROCE
    AscendC::Hcomm<AscendC::COMM_PROTOCOL_UBC_CTP> hcomm_;
    __gm__ CommContext *context_{nullptr};
    AscendC::ChannelHandle channel_{0};
    __gm__ uint8_t *localBuf_{nullptr};
    GM_ADDR remoteBuf_{nullptr};
    uint32_t rankId_{0};
    uint32_t worldSize_{0};
    uint32_t role_{0};
    bool initOk_{true};
};

} // namespace HcommExample

using namespace HcommExample;

// Kernel入口
extern "C" __global__ __aicore__ void kernel_hcomm_write_read_nbi(GM_ADDR context)
{
    AscendC::TPipe pipe;
    HcommExample::KernelHcommWriteRead op;
    op.Init(context, &pipe);
    op.Process();
}

// ============================================================================
// Host侧主函数：多进程方式，每个进程对应一个rank
// 用法:
//   ./demo [<rank> <nranks> <endpoint>]
//   无参数时自动fork两个子进程（rank0=writer, rank1=reader），使用默认endpoint
//   有参数时单进程运行指定rank: ./demo 0 2 tcp://127.0.0.1:29621
//   endpoint 格式: tcp://<ip>:<port>，用于进程间TCP通信交换rootInfo和同步
// ============================================================================

// 默认endpoint
constexpr const char *DEFAULT_ENDPOINT = "tcp://127.0.0.1:29621";

// 单rank执行流程，供fork后的子进程调用
static int32_t RunRank(uint32_t rank, uint32_t nranks, const std::string &endpoint);

// 解析tcp://<ip>:<port>格式的endpoint，提取ip和port
static bool ParseEndpoint(const std::string &endpoint, std::string &ip, uint16_t &port)
{
    const std::string prefix = "tcp://";
    if (endpoint.find(prefix) != 0) {
        return false;
    }
    std::string addr = endpoint.substr(prefix.size());
    auto colonPos = addr.rfind(':');
    if (colonPos == std::string::npos) {
        return false;
    }
    ip = addr.substr(0, colonPos);
    port = static_cast<uint16_t>(atoi(addr.substr(colonPos + 1).c_str()));
    return !ip.empty() && port > 0;
}

// rank 0作为server监听，rank 1作为client连接，建立TCP通道
static int32_t ConnectPeer(uint32_t rank, const std::string &ip, uint16_t port, int32_t &sock)
{
    if (rank == 0) {
        int32_t listenSock = socket(AF_INET, SOCK_STREAM, 0);
        if (listenSock < 0) {
            return -1;
        }
        int32_t opt = 1;
        setsockopt(listenSock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        struct sockaddr_in addr = {};
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        inet_pton(AF_INET, ip.c_str(), &addr.sin_addr);
        if (bind(listenSock, reinterpret_cast<struct sockaddr *>(&addr), sizeof(addr)) < 0 ||
            listen(listenSock, 1) < 0) {
            close(listenSock);
            return -1;
        }
        sock = accept(listenSock, nullptr, nullptr);
        close(listenSock);
        return sock < 0 ? -1 : 0;
    } else {
        sock = socket(AF_INET, SOCK_STREAM, 0);
        if (sock < 0) {
            return -1;
        }
        struct sockaddr_in addr = {};
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        inet_pton(AF_INET, ip.c_str(), &addr.sin_addr);
        // 重试连接，等待rank 0的server就绪
        for (int32_t i = 0; i < 100; i++) {
            if (connect(sock, reinterpret_cast<struct sockaddr *>(&addr), sizeof(addr)) == 0) {
                return 0;
            }
            usleep(100000); // 100ms
        }
        close(sock);
        return -1;
    }
}

// 通过socket收发完整数据
static int32_t SendAll(int32_t sock, const void *buf, size_t len)
{
    size_t sent = 0;
    while (sent < len) {
        ssize_t n = send(sock, static_cast<const char *>(buf) + sent, len - sent, 0);
        if (n <= 0) {
            return -1;
        }
        sent += static_cast<size_t>(n);
    }
    return 0;
}

static int32_t RecvAll(int32_t sock, void *buf, size_t len)
{
    size_t received = 0;
    while (received < len) {
        ssize_t n = recv(sock, static_cast<char *>(buf) + received, len - received, 0);
        if (n <= 0) {
            return -1;
        }
        received += static_cast<size_t>(n);
    }
    return 0;
}

// 通过TCP交换rootInfo：rank 0生成rootInfo后发送给rank 1
static int32_t ExchangeRootInfo(uint32_t rank, int32_t sock, HcclRootInfo *rootInfo)
{
    if (rank == 0) {
        HcclResult r = HcclGetRootInfo(rootInfo);
        if (r != HCCL_SUCCESS) {
            fprintf(stderr, "[ERROR] HcclGetRootInfo failed, ret=%d\n", (int32_t)r);
            return -1;
        }
        if (SendAll(sock, rootInfo, sizeof(HcclRootInfo)) != 0) {
            fprintf(stderr, "[ERROR] send rootInfo failed\n");
            return -1;
        }
    } else {
        if (RecvAll(sock, rootInfo, sizeof(HcclRootInfo)) != 0) {
            fprintf(stderr, "[ERROR] recv rootInfo failed\n");
            return -1;
        }
    }
    return 0;
}

// TCP barrier：双方各发一个int再收一个int，确保同时到达同步点
static void TcpBarrier(int32_t sock)
{
    int32_t flag = 1;
    SendAll(sock, &flag, sizeof(flag));
    int32_t recv = 0;
    RecvAll(sock, &recv, sizeof(recv));
}

// writer完成后通过socket通知reader
static void NotifyWriterDone(int32_t sock)
{
    int32_t flag = 1;
    SendAll(sock, &flag, sizeof(flag));
}

static void WaitWriterDone(int32_t sock)
{
    int32_t flag = 0;
    RecvAll(sock, &flag, sizeof(flag));
}

int32_t main(int32_t argc, char *argv[])
{
    // 无参数：自动fork两个子进程后台执行
    if (argc == 1) {
        std::string endpoint = DEFAULT_ENDPOINT;
        pid_t pid1 = fork();
        if (pid1 < 0) {
            fprintf(stderr, "[ERROR] fork failed\n");
            return -1;
        }
        if (pid1 == 0) {
            // 子进程1：rank 0 (writer)
            _exit(RunRank(0, NRANKS, endpoint));
        }
        // 父进程稍等rank 0启动server
        usleep(200000);
        pid_t pid2 = fork();
        if (pid2 < 0) {
            fprintf(stderr, "[ERROR] fork failed\n");
            kill(pid1, SIGKILL);
            waitpid(pid1, nullptr, 0);
            return -1;
        }
        if (pid2 == 0) {
            // 子进程2：rank 1 (reader)
            _exit(RunRank(1, NRANKS, endpoint));
        }
        // 父进程等待两个子进程结束
        int32_t status1 = 0;
        int32_t status2 = 0;
        waitpid(pid1, &status1, 0);
        waitpid(pid2, &status2, 0);
        int32_t ret1 = WIFEXITED(status1) ? WEXITSTATUS(status1) : -1;
        int32_t ret2 = WIFEXITED(status2) ? WEXITSTATUS(status2) : -1;
        if (ret1 == 0 && ret2 == 0) {
            printf("test pass!\n");
            return 0;
        }
        printf("test failed! writer=%d reader=%d\n", ret1, ret2);
        return -1;
    }

    // 有参数：单进程运行指定rank
    if (argc < 4) {
        fprintf(stderr, "Usage: %s [<rank> <nranks> <endpoint>]\n", argv[0]);
        fprintf(stderr, "  No args: auto fork two processes (rank0=writer, rank1=reader)\n");
        fprintf(stderr, "  With args: run single rank, e.g. %s 0 2 tcp://127.0.0.1:29621\n", argv[0]);
        return -1;
    }

    uint32_t rank = static_cast<uint32_t>(atoi(argv[1]));
    uint32_t nranks = static_cast<uint32_t>(atoi(argv[2]));
    std::string endpoint = argv[3];
    if (nranks != NRANKS || rank >= NRANKS) {
        fprintf(stderr, "[ERROR] nranks must be %u, rank must be 0~%u\n", NRANKS, NRANKS - 1);
        return -1;
    }
    return RunRank(rank, nranks, endpoint);
}

static int32_t RunRank(uint32_t rank, uint32_t nranks, const std::string &endpoint)
{
    std::string ip;
    uint16_t port = 0;
    if (!ParseEndpoint(endpoint, ip, port)) {
        fprintf(stderr, "[ERROR] invalid endpoint: %s\n", endpoint.c_str());
        return -1;
    }

    // 参考hccl_op样例的初始化顺序：先aclInit+SetDevice+CreateStream，再交换rootInfo
    aclInit(nullptr);
    uint32_t devCount = 0;
    aclrtGetDeviceCount(&devCount);
    aclrtSetDevice(rank);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 1. 建立TCP连接，交换rootInfo，barrier同步后创建通信域
    // 950需多进程方式：每进程一个rank，通过TCP交换rootInfo后各自调用HcclCommInitRootInfo
    int32_t sock = -1;
    if (ConnectPeer(rank, ip, port, sock) != 0) {
        fprintf(stderr, "[ERROR] rank %u connect peer failed\n", rank);
        aclrtDestroyStream(stream);
        aclrtResetDevice(rank);
        aclFinalize();
        return -1;
    }

    HcclRootInfo rootInfo;
    if (ExchangeRootInfo(rank, sock, &rootInfo) != 0) {
        aclrtDestroyStream(stream);
        aclrtResetDevice(rank);
        aclFinalize();
        close(sock);
        return -1;
    }

    // barrier确保两个rank都拿到rootInfo后再同时调用HcclCommInitRootInfo
    TcpBarrier(sock);

    // 950需通过config指定hcclOpExpansionMode为CCU_SCHED，否则TP QoS初始化失败
    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    config.hcclOpExpansionMode = HCCL_OP_EXPANSION_CCU_SCHED;

    HcclComm comm = nullptr;
    HcclResult hcclRet = HcclCommInitRootInfoConfig(nranks, &rootInfo, rank, &config, &comm);
    if (hcclRet != HCCL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u HcclCommInitRootInfo failed, ret=%d\n", rank, (int32_t)hcclRet);
        aclrtDestroyStream(stream);
        aclrtResetDevice(rank);
        aclFinalize();
        close(sock);
        return -1;
    }

    // 2. 分配通信buffer、注册内存、创建到对端的P2P通道、获取对端内存地址
    void *devBuf = nullptr;
    aclrtMalloc(&devBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY);
    uint8_t *devContext = nullptr;

    do {
        CommMem regMem = {};
        regMem.type = COMM_MEM_TYPE_DEVICE;
        regMem.addr = devBuf;
        regMem.size = COMM_BUF_SIZE;
        HcclMemHandle memHandle = nullptr;
        hcclRet = HcclCommMemReg(comm, "shareBuf", &regMem, &memHandle);
        if (hcclRet != HCCL_SUCCESS || memHandle == nullptr) {
            fprintf(stderr, "[ERROR] rank %u HcclCommMemReg failed, ret=%d memHandle=%p\n", rank,
                (int32_t)hcclRet, memHandle);
            break;
        }

        // 创建到对端的P2P通道
        uint32_t peerRank = (rank + 1) % NRANKS;
        HcclChannelDesc channelDesc;
        HcclChannelDescInit(&channelDesc, 1);
        channelDesc.remoteRank = peerRank;
        channelDesc.channelProtocol = COMM_PROTOCOL_UBC_CTP;
        channelDesc.memHandles = &memHandle;
        channelDesc.memHandleNum = 1;

        // 通过HcclRankGraph获取链路endpoint信息，填入channelDesc
        // HcclChannelAcquire需要localEndpoint和remoteEndpoint才能建链
        uint32_t *netLayers = nullptr;
        uint32_t netLayerNum = 0;
        hcclRet = HcclRankGraphGetLayers(comm, &netLayers, &netLayerNum);
        if (hcclRet != HCCL_SUCCESS || netLayerNum == 0) {
            fprintf(stderr, "[ERROR] rank %u HcclRankGraphGetLayers failed, ret=%d\n", rank, (int32_t)hcclRet);
            break;
        }
        uint32_t layerId = netLayers[0]; // 单机双卡只有一层网络
        CommLink *links = nullptr;
        uint32_t linkNum = 0;
        hcclRet = HcclRankGraphGetLinks(comm, layerId, rank, peerRank, &links, &linkNum);
        if (hcclRet != HCCL_SUCCESS || linkNum == 0 || links == nullptr) {
            fprintf(stderr, "[ERROR] rank %u HcclRankGraphGetLinks failed, ret=%d linkNum=%u\n", rank,
                (int32_t)hcclRet, linkNum);
            break;
        }
        // 查找匹配协议的链路
        bool linkFound = false;
        for (uint32_t i = 0; i < linkNum; i++) {
            if (links[i].linkAttr.linkProtocol == COMM_PROTOCOL_UBC_CTP) {
                channelDesc.localEndpoint = links[i].srcEndpointDesc;
                channelDesc.remoteEndpoint = links[i].dstEndpointDesc;
                linkFound = true;
                break;
            }
        }
        if (!linkFound) {
            fprintf(stderr, "[ERROR] rank %u no matching link for UBC_CTP protocol\n", rank);
            break;
        }

        ChannelHandle channel = 0;
        hcclRet = HcclChannelAcquire(comm, COMM_ENGINE_AIV, &channelDesc, 1, &channel);
        if (hcclRet != HCCL_SUCCESS || channel == 0) {
            fprintf(stderr, "[ERROR] rank %u HcclChannelAcquire failed, ret=%d channel=%lu\n", rank,
                (int32_t)hcclRet, (unsigned long)channel);
            break;
        }

        // 获取对端注册的内存地址
        uint32_t memNum = 0;
        CommMem *remoteMems = nullptr;
        char **memTags = nullptr;
        hcclRet = HcclChannelGetRemoteMems(comm, channel, &memNum, &remoteMems, &memTags);
        if (hcclRet != HCCL_SUCCESS || memNum == 0 || remoteMems == nullptr) {
            fprintf(stderr, "[ERROR] rank %u HcclChannelGetRemoteMems failed, ret=%d memNum=%u remoteMems=%p\n",
                rank, (int32_t)hcclRet, memNum, remoteMems);
            break;
        }
        uint64_t remoteBufAddr = reinterpret_cast<uint64_t>(remoteMems[0].addr);

        // 3. 构造CommContext并下发到GM
        CommContext hostCtx = {};
        hostCtx.channelHandle = channel;
        hostCtx.localBufferAddr = reinterpret_cast<uint64_t>(devBuf);
        hostCtx.remoteBufferAddr = remoteBufAddr;
        hostCtx.rankId = rank;
        hostCtx.worldSize = nranks;
        hostCtx.role = rank; // rank0=writer, rank1=reader
        hostCtx.testResult = 0;
        aclrtMalloc(reinterpret_cast<void **>(&devContext), sizeof(CommContext), ACL_MEM_MALLOC_HUGE_ONLY);
        aclrtMemcpy(devContext, sizeof(CommContext), &hostCtx, sizeof(CommContext), ACL_MEMCPY_HOST_TO_DEVICE);

        // 4. 分阶段执行：rank0(writer)先执行WriteNbi，rank1(reader)等待后执行ReadNbi
        if (rank == 0) {
            // writer：执行WriteNbi
            kernel_hcomm_write_read_nbi<<<1, nullptr, stream>>>(devContext);
            aclrtSynchronizeStream(stream);

            // 通知reader可以读出
            NotifyWriterDone(sock);
        } else {
            // reader：等待writer完成
            WaitWriterDone(sock);

            // 执行ReadNbi
            kernel_hcomm_write_read_nbi<<<1, nullptr, stream>>>(devContext);
            aclrtSynchronizeStream(stream);
        }

        // 5. 回读校验结果
        CommContext resultCtx = {};
        aclrtMemcpy(&resultCtx, sizeof(CommContext), devContext, sizeof(CommContext), ACL_MEMCPY_DEVICE_TO_HOST);

        if (resultCtx.testResult == 0) {
            printf("rank %u test pass!\n", rank);
        } else {
            printf("rank %u test failed! result=%u\n", rank, resultCtx.testResult);
        }
    } while (0);

    aclrtFree(devContext);
    aclrtFree(devBuf);
    aclrtDestroyStream(stream);
    if (comm != nullptr) {
        HcclCommDestroy(comm);
    }
    aclrtResetDevice(rank);
    aclFinalize();
    close(sock);
    return 0;
}
