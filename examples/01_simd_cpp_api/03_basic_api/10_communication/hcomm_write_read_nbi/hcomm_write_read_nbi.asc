/*!
 * \file hcomm_write_read_nbi.asc
 * \brief Hcomm WriteNbi/ReadNbi 点对点通信样例。
 *        展示三种典型使用模式：
 *        场景1 - 单次WriteNbi（commit=true）+ Drain
 *        场景2 - 批量WriteNbi（commit=false）+ Commit + Drain
 *        场景3 - ReadNbi + Drain
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "adv_api/hcomm/hcomm.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

constexpr uint32_t HCOMM_WORKSPACE_SIZE = 512U;
constexpr uint32_t DATA_SIZE = 256U;
constexpr uint32_t BATCH_NUM = 4U;

namespace HcommExample {

struct CommContext {
    uint64_t hcommHandle[8];
    uint64_t localBufferAddr[8];
    uint64_t remoteBufferAddr[8];
    uint32_t epRankId;
    uint32_t epWorldSize;
};

template <uint32_t scenario>
class KernelHcommWriteRead {
public:
    __aicore__ inline KernelHcommWriteRead() {}

    __aicore__ inline void Init(GM_ADDR context, TPipe *pipe)
    {
        tpipe_ = pipe;
        context_ = reinterpret_cast<__gm__ CommContext *>(context);
        epRankId_ = context_->epRankId;
        epWorldSize_ = context_->epWorldSize;

        tpipe_->InitBuffer(hcommBuf_, HCOMM_WORKSPACE_SIZE);
        hcommTensor_ = hcommBuf_.Get<uint8_t>();
        __ubuf__ uint8_t *bufPtr = reinterpret_cast<__ubuf__ uint8_t *>(hcommTensor_.GetPhyAddr());
        for (uint32_t i = 0; i < HCOMM_WORKSPACE_SIZE; i++) {
            bufPtr[i] = 0;
        }
        hcomm_.Init(bufPtr, HCOMM_WORKSPACE_SIZE);
    }

    __aicore__ inline void Process()
    {
        if constexpr (scenario == 1) {
            ProcessWriteSingle();
        } else if constexpr (scenario == 2) {
            ProcessWriteBatch();
        } else if constexpr (scenario == 3) {
            ProcessRead();
        }
    }

private:
    AscendC::ChannelHandle GetChannel(uint32_t rankId)
    {
        uint32_t index = (rankId > epRankId_) ? (rankId - 1) : rankId;
        return context_->hcommHandle[index];
    }

    GM_ADDR GetLocalAddr(uint32_t rankId, uint32_t offset)
    {
        return reinterpret_cast<GM_ADDR>(context_->localBufferAddr[rankId] + offset);
    }

    GM_ADDR GetRemoteAddr(uint32_t rankId, uint32_t offset)
    {
        return reinterpret_cast<GM_ADDR>(context_->remoteBufferAddr[rankId] + offset);
    }

    __aicore__ inline void ProcessWriteSingle()
    {
        uint32_t dstRankId = (epRankId_ + 1) % epWorldSize_;
        AscendC::ChannelHandle channel = GetChannel(dstRankId);

        GM_ADDR localSrc = GetLocalAddr(epRankId_, 0);
        GM_ADDR remoteDst = GetRemoteAddr(dstRankId, 0);

        hcomm_.WriteNbi(channel, remoteDst, localSrc, DATA_SIZE);

        hcomm_.Drain(channel);
    }

    __aicore__ inline void ProcessWriteBatch()
    {
        for (uint32_t dstRankId = 0; dstRankId < epWorldSize_; dstRankId++) {
            if (dstRankId == epRankId_) {
                continue;
            }
            AscendC::ChannelHandle channel = GetChannel(dstRankId);
            GM_ADDR localSrc = GetLocalAddr(epRankId_, 0);
            GM_ADDR remoteDst = GetRemoteAddr(dstRankId, 0);

            for (uint32_t i = 0; i < BATCH_NUM; i++) {
                uint32_t offset = i * DATA_SIZE;
                hcomm_.WriteNbi<false>(channel,
                    reinterpret_cast<GM_ADDR>(reinterpret_cast<uint64_t>(remoteDst) + offset),
                    reinterpret_cast<GM_ADDR>(reinterpret_cast<uint64_t>(localSrc) + offset),
                    DATA_SIZE);
            }

            hcomm_.Commit(channel);
            hcomm_.Drain(channel);
        }
    }

    __aicore__ inline void ProcessRead()
    {
        uint32_t srcRankId = (epRankId_ + 1) % epWorldSize_;
        AscendC::ChannelHandle channel = GetChannel(srcRankId);

        GM_ADDR localDst = GetLocalAddr(epRankId_, 0);
        GM_ADDR remoteSrc = GetRemoteAddr(srcRankId, 0);

        hcomm_.ReadNbi(channel, localDst, remoteSrc, DATA_SIZE);

        hcomm_.Drain(channel);
    }

    TPipe *tpipe_{nullptr};
    AscendC::TBuf<AscendC::TPosition::VECOUT> hcommBuf_;
    AscendC::LocalTensor<uint8_t> hcommTensor_;
    AscendC::Hcomm<AscendC::COMM_PROTOCOL_UBC_CTP> hcomm_;
    __gm__ CommContext *context_{nullptr};
    uint32_t epRankId_{0};
    uint32_t epWorldSize_{0};
};

} // namespace HcommExample

using namespace HcommExample;

extern "C" __global__ __aicore__ void kernel_hcomm_write_read_nbi(GM_ADDR context)
{
    AscendC::TPipe pipe;
    KernelHcommWriteRead<scenarioNum> op;
    op.Init(context, &pipe);
    op.Process();
}

#ifdef ASCENDC_CPU_DEBUG
extern "C" __global__ __aicore__ void kernel_hcomm_write_read_nbi_cpudebug(GM_ADDR context)
{
    AscendC::TPipe pipe;
    KernelHcommWriteRead<scenarioNum> op;
    op.Init(context, &pipe);
    op.Process();
}
#endif

#ifndef ASCENDC_CPU_DEBUG
int32_t main()
{
    aclInit(nullptr);

    uint32_t devCount = 0;
    aclrtGetDeviceCount(&devCount);
    if (devCount == 0) {
        return -1;
    }

    int32_t rankId = 0;
    aclrtSetDevice(rankId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    CommContext hostCtx = {};
    hostCtx.epRankId = rankId;
    hostCtx.epWorldSize = devCount;

    void *devContext = nullptr;
    aclrtMalloc(&devContext, sizeof(CommContext), ACL_MEM_MALLOC_HUGE_ONLY);
    aclrtMemcpy(devContext, sizeof(CommContext), &hostCtx, sizeof(CommContext), ACL_MEMCPY_HOST_TO_DEVICE);

    void *args[] = {&devContext};

#ifdef ASCENDC_CPU_DEBUG
    CPU_DEBUG_LAUNCH(kernel_hcomm_write_read_nbi_cpudebug, 1, args);
#else
    kernel_hcomm_write_read_nbi<<<1, nullptr, stream>>>(devContext);
#endif

    aclrtSynchronizeStream(stream);

    aclrtFree(devContext);
    aclrtDestroyStream(stream);
    aclFinalize();
    return 0;
}
#endif
