namespace {

constexpr uint32_t RANK_SIZE = 2;

// Single-host: keep 127.0.0.1. Cross-host: set this to the rank 0 host IP on both hosts.
constexpr const char* ROOT_INFO_IP = "127.0.0.1";
constexpr uint16_t ROOT_INFO_PORT = 8899;

// Select exactly one topology. Comment the active line before enabling the other one.
constexpr CommTopo TARGET_TOPO = COMM_TOPO_1DMESH;
// constexpr CommTopo TARGET_TOPO = COMM_TOPO_CLOS;

constexpr uint8_t PATH_MODE_MESH = 2;
constexpr uint8_t PATH_MODE_CLOS = 3;
constexpr CommProtocol TARGET_PROTOCOL = COMM_PROTOCOL_UB_MEM;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr size_t CHANNEL_MEMORY_BYTES = 2UL * 1024UL * 1024UL;
constexpr uint32_t VERIFY_BYTES = 4UL * 1024UL;
constexpr uint32_t TILE_ELEMENTS = 1024;

struct CommResources {
    HcclComm comm = nullptr;
    void* channelMemory = nullptr;
    aclrtStream stream = nullptr;
    void* verifyBuffer = nullptr;
};

const char* TopoName() { return TARGET_TOPO == COMM_TOPO_CLOS ? "clos" : "mesh"; }

uint8_t TargetPathMode() { return TARGET_TOPO == COMM_TOPO_CLOS ? PATH_MODE_CLOS : PATH_MODE_MESH; }

} // namespace

__global__ __vector__ void ubmem_data_copy_kernel(__gm__ uint8_t* dst, __gm__ uint8_t* src, uint32_t elemCount)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<uint32_t> dstGlobal;
    AscendC::GlobalTensor<uint32_t> srcGlobal;
    dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(dst), elemCount);
    srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(src), elemCount);

    AscendC::LocalTensor<uint32_t> local = AscendC::LocalTensor<uint32_t>(AscendC::TPosition::VECIN, 0, TILE_ELEMENTS);
    for (uint32_t offset = 0; offset < elemCount; offset += TILE_ELEMENTS) {
        uint32_t count = elemCount - offset;
        if (count > TILE_ELEMENTS) {
            count = TILE_ELEMENTS;
        }

        AscendC::DataCopy(local, srcGlobal[offset], count);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGlobal[offset], local, count);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

namespace {

int LaunchUbmemDataCopy(void* dst, void* src, uint32_t byteSize, aclrtStream stream)
{
    if (dst == nullptr || src == nullptr || stream == nullptr || byteSize == 0 || byteSize % sizeof(uint32_t) != 0) {
        return -1;
    }

    constexpr uint32_t blockNum = 1;
    ubmem_data_copy_kernel<<<blockNum, 0, stream>>>(
        static_cast<uint8_t*>(dst), static_cast<uint8_t*>(src), byteSize / sizeof(uint32_t));
    return ACL_SUCCESS;
}

int ReportError(uint32_t rank, const char* operation, int result)
{
    std::cerr << "rank " << rank << ": " << operation << " failed, ret=" << result << std::endl;
    return result;
}

int CleanupCommRes(uint32_t rank, CommResources& resources, int result)
{
    int releaseStatus = 0;
    if (resources.stream != nullptr) {
        releaseStatus |= aclrtDestroyStream(resources.stream);
    }

    bool commDestroyed = true;
    if (resources.comm != nullptr) {
        int status = HcclCommDestroy(resources.comm);
        commDestroyed = status == HCCL_SUCCESS;
        releaseStatus |= status;
    }
    if (resources.verifyBuffer != nullptr) {
        releaseStatus |= aclrtFree(resources.verifyBuffer);
    }
    if (resources.channelMemory != nullptr && commDestroyed) {
        releaseStatus |= aclrtFree(resources.channelMemory);
    }
    if (releaseStatus != 0) {
        std::cerr << "rank " << rank << ": resource release failed, status=" << releaseStatus << std::endl;
    }
    return result | releaseStatus;
}

int BuildChannelDesc(HcclComm comm, uint32_t rank, uint32_t peerRank, HcclMemHandle& memHandle, HcclChannelDesc& desc)
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0;
    int result = HcclRankGraphGetLayers(comm, &layers, &layerCount);
    if (result != HCCL_SUCCESS) {
        return ReportError(rank, "HcclRankGraphGetLayers", result);
    }

    for (uint32_t layerIndex = 0; layerIndex < layerCount; ++layerIndex) {
        CommTopo topo = COMM_TOPO_RESERVED;
        result = HcclRankGraphGetTopoTypeByLayer(comm, layers[layerIndex], &topo);
        if (result != HCCL_SUCCESS) {
            return ReportError(rank, "HcclRankGraphGetTopoTypeByLayer", result);
        }
        if (topo != TARGET_TOPO) {
            continue;
        }

        CommLink* links = nullptr;
        uint32_t linkCount = 0;
        result = HcclRankGraphGetLinks(comm, layers[layerIndex], rank, peerRank, &links, &linkCount);
        if (result != HCCL_SUCCESS) {
            return ReportError(rank, "HcclRankGraphGetLinks", result);
        }
        for (uint32_t linkIndex = 0; linkIndex < linkCount; ++linkIndex) {
            if (links[linkIndex].linkAttr.linkProtocol != TARGET_PROTOCOL) {
                continue;
            }

            result = HcclChannelDescInit(&desc, 1);
            if (result != HCCL_SUCCESS) {
                return ReportError(rank, "HcclChannelDescInit", result);
            }
            const CommLink& link = links[linkIndex];
            desc.remoteRank = peerRank;
            desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
            desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
            desc.localEndpoint.loc = link.srcEndpointDesc.loc;
            desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
            desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
            desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
            desc.channelProtocol = link.linkAttr.linkProtocol;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.memHandles = &memHandle;
            desc.memHandleNum = 1;
            desc.ubMemAttr.pathMode = TargetPathMode();
            std::cout << "rank " << rank << ": select " << TopoName() << " link to rank " << peerRank
                      << ", protocol=UB_MEM, path_mode=" << static_cast<uint32_t>(desc.ubMemAttr.pathMode) << std::endl;
            return HCCL_SUCCESS;
        }
    }

    std::cerr << "rank " << rank << ": no UB_MEM " << TopoName() << " link found to rank " << peerRank << std::endl;
    return HCCL_E_NOT_FOUND;
}

int VerifyRemoteDataCopy(
    uint32_t rank, uint32_t peerRank, void* remoteBuffer, uint64_t remoteBufferSize, CommResources& resources)
{
    if (remoteBuffer == nullptr || remoteBufferSize < VERIFY_BYTES) {
        std::cerr << "rank " << rank << ": remote HCCL buffer from rank " << peerRank
                  << " is too small, size=" << remoteBufferSize << std::endl;
        return HCCL_E_INTERNAL;
    }

    int result = aclrtMemset(resources.verifyBuffer, VERIFY_BYTES, 0, VERIFY_BYTES);
    if (result != ACL_SUCCESS) {
        return ReportError(rank, "aclrtMemset verify buffer", result);
    }
    result = LaunchUbmemDataCopy(resources.verifyBuffer, remoteBuffer, VERIFY_BYTES, resources.stream);
    if (result != ACL_SUCCESS) {
        return ReportError(rank, "LaunchUbmemDataCopy", result);
    }
    result = aclrtSynchronizeStream(resources.stream);
    if (result != ACL_SUCCESS) {
        return ReportError(rank, "aclrtSynchronizeStream", result);
    }

    std::vector<uint8_t> hostData(VERIFY_BYTES);
    result =
        aclrtMemcpy(hostData.data(), hostData.size(), resources.verifyBuffer, VERIFY_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    if (result != ACL_SUCCESS) {
        return ReportError(rank, "aclrtMemcpy verify data", result);
    }

    const uint8_t expected = static_cast<uint8_t>(peerRank);
    for (size_t offset = 0; offset < hostData.size(); ++offset) {
        if (hostData[offset] != expected) {
            std::cerr << "rank " << rank << ": data verification failed for rank " << peerRank << ", offset=" << offset
                      << ", actual=" << static_cast<uint32_t>(hostData[offset])
                      << ", expected=" << static_cast<uint32_t>(expected) << std::endl;
            return HCCL_E_INTERNAL;
        }
    }

    std::cout << "rank " << rank << ": data copy from remote rank " << peerRank << " passed, bytes=" << VERIFY_BYTES
              << std::endl;
    return HCCL_SUCCESS;
}

int TestOnePath(uint32_t rank, const HcclRootInfo& rootInfo)
{
    CommResources resources;
    HcclMemHandle memHandle = nullptr;
    const uint32_t peerRank = 1U - rank;

    int result = HcclCommInitRootInfo(RANK_SIZE, &rootInfo, rank, &resources.comm);
    if (result != HCCL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "HcclCommInitRootInfo", result));
    }

    void* localHcclBuffer = nullptr;
    uint64_t localHcclBufferSize = 0;
    result = HcclGetHcclBuffer(resources.comm, &localHcclBuffer, &localHcclBufferSize);
    if (result != HCCL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "HcclGetHcclBuffer", result));
    }
    if (localHcclBuffer == nullptr || localHcclBufferSize < VERIFY_BYTES) {
        std::cerr << "rank " << rank << ": local HCCL buffer is too small, size=" << localHcclBufferSize << std::endl;
        return CleanupCommRes(rank, resources, HCCL_E_INTERNAL);
    }
    result = aclrtMemset(localHcclBuffer, VERIFY_BYTES, static_cast<int32_t>(rank), VERIFY_BYTES);
    if (result != ACL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "aclrtMemset local HCCL buffer", result));
    }

    result = aclrtMalloc(&resources.channelMemory, CHANNEL_MEMORY_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    if (result != ACL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "aclrtMalloc channel memory", result));
    }
    result = aclrtMemset(resources.channelMemory, CHANNEL_MEMORY_BYTES, 0, CHANNEL_MEMORY_BYTES);
    if (result != ACL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "aclrtMemset channel memory", result));
    }

    std::string memoryTag = "link_select_rank_" + std::to_string(rank);
    CommMem channelMemory{COMM_MEM_TYPE_DEVICE, resources.channelMemory, CHANNEL_MEMORY_BYTES};
    result = HcclCommMemReg(resources.comm, memoryTag.c_str(), &channelMemory, &memHandle);
    if (result != HCCL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "HcclCommMemReg", result));
    }

    HcclChannelDesc channelDesc;
    result = BuildChannelDesc(resources.comm, rank, peerRank, memHandle, channelDesc);
    if (result != HCCL_SUCCESS) {
        return CleanupCommRes(rank, resources, result);
    }

    ChannelHandle channel = 0;
    result = HcclChannelAcquire(resources.comm, COMM_ENGINE_AIV, &channelDesc, 1, &channel);
    if (result != HCCL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "HcclChannelAcquire", result));
    }

    result = aclrtCreateStream(&resources.stream);
    if (result != ACL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "aclrtCreateStream", result));
    }
    result = aclrtMalloc(&resources.verifyBuffer, VERIFY_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    if (result != ACL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "aclrtMalloc verify buffer", result));
    }

    void* remoteHcclBuffer = nullptr;
    uint64_t remoteHcclBufferSize = 0;
    result = HcclChannelGetHcclBuffer(resources.comm, channel, &remoteHcclBuffer, &remoteHcclBufferSize);
    if (result != HCCL_SUCCESS) {
        return CleanupCommRes(rank, resources, ReportError(rank, "HcclChannelGetHcclBuffer", result));
    }
    result = VerifyRemoteDataCopy(rank, peerRank, remoteHcclBuffer, remoteHcclBufferSize, resources);
    return CleanupCommRes(rank, resources, result);
}

bool SendAll(int fd, const void* data, size_t size)
{
    const char* buffer = static_cast<const char*>(data);
    size_t sent = 0;
    while (sent < size) {
        ssize_t count = send(fd, buffer + sent, size - sent, 0);
        if (count <= 0) {
            return false;
        }
        sent += static_cast<size_t>(count);
    }
    return true;
}

bool RecvAll(int fd, void* data, size_t size)
{
    char* buffer = static_cast<char*>(data);
    size_t received = 0;
    while (received < size) {
        ssize_t count = recv(fd, buffer + received, size - received, 0);
        if (count <= 0) {
            return false;
        }
        received += static_cast<size_t>(count);
    }
    return true;
}

int CreateListenSocket()
{
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        std::cerr << "socket failed, errno=" << errno << std::endl;
        return -1;
    }

    int reuseAddress = 1;
    (void)setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuseAddress, sizeof(reuseAddress));

    sockaddr_in address{};
    address.sin_family = AF_INET;
    address.sin_port = htons(ROOT_INFO_PORT);
    address.sin_addr.s_addr = htonl(INADDR_ANY);
    if (bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
        std::cerr << "bind port " << ROOT_INFO_PORT << " failed, errno=" << errno << std::endl;
        close(fd);
        return -1;
    }
    if (listen(fd, 1) != 0) {
        std::cerr << "listen failed, errno=" << errno << std::endl;
        close(fd);
        return -1;
    }
    return fd;
}

int ConnectToRoot()
{
    constexpr int RETRY_TIMES = 300;
    constexpr int RETRY_INTERVAL_MS = 100;

    for (int retry = 0; retry < RETRY_TIMES; ++retry) {
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) {
            return -1;
        }

        sockaddr_in address{};
        address.sin_family = AF_INET;
        address.sin_port = htons(ROOT_INFO_PORT);
        if (inet_pton(AF_INET, ROOT_INFO_IP, &address.sin_addr) != 1) {
            hostent* hostEntry = gethostbyname(ROOT_INFO_IP);
            if (hostEntry == nullptr || hostEntry->h_addr_list == nullptr || hostEntry->h_addr_list[0] == nullptr) {
                close(fd);
                return -1;
            }
            std::memcpy(&address.sin_addr, hostEntry->h_addr_list[0], sizeof(address.sin_addr));
        }

        if (connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0) {
            return fd;
        }
        close(fd);
        std::this_thread::sleep_for(std::chrono::milliseconds(RETRY_INTERVAL_MS));
    }
    return -1;
}

int ExchangeRootInfo(uint32_t rank, HcclRootInfo& rootInfo)
{
    if (rank == 0) {
        int listenFd = CreateListenSocket();
        if (listenFd < 0) {
            return -1;
        }
        int connectionFd = accept(listenFd, nullptr, nullptr);
        if (connectionFd < 0) {
            std::cerr << "accept failed, errno=" << errno << std::endl;
            close(listenFd);
            return -1;
        }
        if (!SendAll(connectionFd, &rootInfo, sizeof(rootInfo))) {
            std::cerr << "send root info failed" << std::endl;
            close(connectionFd);
            close(listenFd);
            return -1;
        }
        close(connectionFd);
        close(listenFd);
        return 0;
    }

    int fd = ConnectToRoot();
    if (fd < 0) {
        std::cerr << "connect root info endpoint failed: " << ROOT_INFO_IP << ":" << ROOT_INFO_PORT << std::endl;
        return -1;
    }
    if (!RecvAll(fd, &rootInfo, sizeof(rootInfo))) {
        std::cerr << "recv root info failed" << std::endl;
        close(fd);
        return -1;
    }
    close(fd);
    return 0;
}

} // namespace

int main(int argc, char* argv[])
{
    if (argc != 3) {
        std::cerr << "Usage: " << argv[0] << " <rank_id> <device_id>" << std::endl;
        return 1;
    }

    int rankValue = std::atoi(argv[1]);
    int deviceValue = std::atoi(argv[2]);
    if (rankValue < 0 || rankValue >= static_cast<int>(RANK_SIZE) || deviceValue < 0) {
        std::cerr << "invalid rank_id or device_id" << std::endl;
        return 1;
    }
    uint32_t rank = static_cast<uint32_t>(rankValue);
    uint32_t device = static_cast<uint32_t>(deviceValue);

    int status = aclInit(nullptr);
    status |= aclrtSetDevice(static_cast<int32_t>(device));
    if (status != ACL_SUCCESS) {
        std::cerr << "rank " << rank << ": initialization failed, status=" << status << std::endl;
        return 1;
    }

    HcclRootInfo rootInfo{};
    if (rank == 0) {
        status = HcclGetRootInfo(&rootInfo);
        if (status != HCCL_SUCCESS) {
            std::cerr << "rank 0: HcclGetRootInfo failed, status=" << status << std::endl;
        }
    }

    if (status == HCCL_SUCCESS) {
        status = ExchangeRootInfo(rank, rootInfo);
    }

    if (status == HCCL_SUCCESS) {
        std::cout << "rank " << rank << "/" << RANK_SIZE << ": device=" << device << ", topo=" << TopoName()
                  << ", root=" << ROOT_INFO_IP << ":" << ROOT_INFO_PORT << std::endl;
        status = TestOnePath(rank, rootInfo);
    }

    status |= aclrtResetDevice(static_cast<int32_t>(device));
    status |= aclFinalize();
    if (status != 0) {
        std::cerr << "rank " << rank << ": execution failed, status=" << status << std::endl;
    }
    return status == 0 ? 0 : 1;
}
