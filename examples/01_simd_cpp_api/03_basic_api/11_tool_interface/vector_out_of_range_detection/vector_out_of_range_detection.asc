#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include <cstdlib>
#include <vector>

constexpr uint32_t LENGTH = 256;
constexpr uint32_t MASK_BYTES = LENGTH / 8;
constexpr uint32_t MASK_COUNT = 2;

__global__ __vector__ void vector_out_of_range_detection(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR masks)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    AscendC::GlobalTensor<uint8_t> masksGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), LENGTH);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), LENGTH);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), LENGTH);
    masksGm.SetGlobalBuffer(masks, MASK_COUNT * MASK_BYTES);

    // 使用静态Tensor分配UB内存，各缓冲区大小均为32字节的整数倍。
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, LENGTH>();
    AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float, LENGTH>();
    AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float, LENGTH>();
    AscendC::LocalTensor<float> limitLocal = ubAllocator.Alloc<float, LENGTH>();
    AscendC::LocalTensor<uint8_t> masksLocal = ubAllocator.Alloc<uint8_t, MASK_COUNT * MASK_BYTES>();

    AscendC::DataCopy(xLocal, xGm, LENGTH);
    AscendC::DataCopy(yLocal, yGm, LENGTH);
    // 等待MTE2搬运完成后执行矢量计算。
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Add(zLocal, xLocal, yLocal, LENGTH);
    AscendC::NumericLimits<float>::Infinity(limitLocal, LENGTH);
    AscendC::Compare(masksLocal, zLocal, limitLocal, AscendC::CMPMODE::EQ, LENGTH);
    AscendC::Compares(masksLocal[MASK_BYTES], zLocal,
        AscendC::NumericLimits<float>::NegativeInfinity(), AscendC::CMPMODE::EQ, LENGTH);

    // 等待矢量计算完成后将计算结果和比较结果搬运到GM。
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(zGm, zLocal, LENGTH);
    AscendC::DataCopy(masksGm, masksLocal, MASK_COUNT * MASK_BYTES);
    AscendC::PipeBarrier<PIPE_ALL>();
}

#define ACL_CHECK(call) do { \
    aclError error = (call); \
    if (error != ACL_SUCCESS) { \
        fprintf(stderr, "%s failed: %d\n", #call, static_cast<int>(error)); \
        return EXIT_FAILURE; \
    } \
} while (0)

int main()
{
    constexpr size_t dataBytes = LENGTH * sizeof(float);
    constexpr size_t maskBytes = MASK_COUNT * MASK_BYTES;
    std::vector<float> x(LENGTH), y(LENGTH), z(LENGTH);
    std::vector<uint8_t> masks(maskBytes);
    size_t fileSize = 0;
    if (!ReadFile("input/input_x.bin", fileSize, x.data(), dataBytes) || fileSize != dataBytes ||
        !ReadFile("input/input_y.bin", fileSize, y.data(), dataBytes) || fileSize != dataBytes) {
        return EXIT_FAILURE;
    }
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));
    uint8_t *xDevice = nullptr, *yDevice = nullptr, *zDevice = nullptr, *masksDevice = nullptr;
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&xDevice), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&yDevice), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&zDevice), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&masksDevice), maskBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(xDevice, dataBytes, x.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(yDevice, dataBytes, y.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    vector_out_of_range_detection<<<1, 0, stream>>>(xDevice, yDevice, zDevice, masksDevice);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(z.data(), dataBytes, zDevice, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    ACL_CHECK(aclrtMemcpy(masks.data(), maskBytes, masksDevice, maskBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    bool success = WriteFile("output/output_z.bin", z.data(), dataBytes) &&
        WriteFile("output/output_masks.bin", masks.data(), maskBytes);
    ACL_CHECK(aclrtFree(xDevice));
    ACL_CHECK(aclrtFree(yDevice));
    ACL_CHECK(aclrtFree(zDevice));
    ACL_CHECK(aclrtFree(masksDevice));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());
    return success ? EXIT_SUCCESS : EXIT_FAILURE;
}
