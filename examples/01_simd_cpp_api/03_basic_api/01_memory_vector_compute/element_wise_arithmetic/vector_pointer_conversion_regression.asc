#include "acl/acl.h"
#include "basic_api/kernel_operator_vec_binary_intf.h"
#include "basic_api/kernel_operator_vec_unary_intf.h"
#include "basic_api/kernel_operator_vec_binary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_ternary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_duplicate_intf.h"
#include "basic_api/kernel_operator_vec_reduce_intf.h"
#include "basic_api/kernel_operator_vec_createvecindex_intf.h"
#include "basic_api/kernel_operator_vec_vconv_intf.h"
#include "basic_api/kernel_operator_vec_mulcast_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>
#include <type_traits>

constexpr uint32_t CAPACITY = 2048;

template <int Op, typename D, typename A, typename B>
__aicore__ inline void Compute(D dst, A a, B b, uint32_t count, int form)
{
    using DT = typename AscendC::VectorOperand::Traits<D>::Element;
    using ST = typename AscendC::VectorOperand::Traits<A>::Element;
    constexpr uint32_t width = sizeof(DT) > sizeof(ST) ? sizeof(DT) : sizeof(ST);
    constexpr uint32_t lanes = 256 / width;
    uint64_t active = count < lanes ? count : lanes;
    uint64_t bits[2] = {
        active >= 64 ? ~uint64_t(0) : (uint64_t(1) << active) - 1, active == 128 ? ~uint64_t(0) :
                                                                   active > 64   ? (uint64_t(1) << (active - 64)) - 1 :
                                                                                   0};
    uint8_t repeats = (count + lanes - 1) / lanes;
    AscendC::UnaryRepeatParams u{1, 1, uint8_t(lanes * sizeof(DT) / 32), uint8_t(lanes * sizeof(ST) / 32)};
    AscendC::BinaryRepeatParams bparam{
        1, 1, 1, uint8_t(lanes * sizeof(DT) / 32), uint8_t(lanes * sizeof(ST) / 32), uint8_t(lanes * sizeof(ST) / 32)};
#define UNARY(API)                                \
    if (form == 0) {                              \
        AscendC::API(dst, a, count);              \
    } else if (form == 1) {                       \
        AscendC::API(dst, a, active, repeats, u); \
    } else {                                      \
        AscendC::API(dst, a, bits, repeats, u);   \
    }
#define BINARY(API)                                       \
    if (form == 0) {                                      \
        AscendC::API(dst, a, b, count);                   \
    } else if (form == 1) {                               \
        AscendC::API(dst, a, b, active, repeats, bparam); \
    } else {                                              \
        AscendC::API(dst, a, b, bits, repeats, bparam);   \
    }
    if constexpr (Op == 0) {
        if (form == 0) {
            AscendC::Cast(dst, a, AscendC::RoundMode::CAST_NONE, count);
        } else if (form == 1) {
            AscendC::Cast(dst, a, AscendC::RoundMode::CAST_NONE, active, repeats, u);
        } else {
            AscendC::Cast(dst, a, AscendC::RoundMode::CAST_NONE, bits, repeats, u);
        }
    } else if constexpr (Op == 1) {
        AscendC::SetDeqScale(half(1));
        UNARY(CastDeq);
    } else if constexpr (Op == 2) {
        AscendC::SetDeqScale(half(1));
        UNARY(CastDequant);
    } else if constexpr (Op == 3) {
        BINARY(AddReluCast);
    } else if constexpr (Op == 4) {
        BINARY(SubReluCast);
    } else if constexpr (Op == 5) {
        BINARY(MulCast);
    } else if constexpr (Op == 6) {
        AscendC::SetDeqScale(half(1));
        BINARY(AddDeqRelu);
    } else if constexpr (Op == 7) {
        AscendC::MulsCast(dst, a, float(2), count);
    }
#undef UNARY
#undef BINARY
}

template <int Op, typename T, typename DT>
__global__ __vector__ void BinaryPointerKernel(__gm__ T* x, __gm__ T* y, __gm__ DT* output, uint32_t count, int form)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> gx, gy;
    AscendC::GlobalTensor<DT> go;
    gx.SetGlobalBuffer(x, CAPACITY);
    gy.SetGlobalBuffer(y, CAPACITY);
    go.SetGlobalBuffer(output, 8 * CAPACITY);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufferA, bufferB, bufferD;
    pipe.InitBuffer(bufferA, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferB, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferD, sizeof(DT) * CAPACITY);
    auto a = bufferA.template Get<T>();
    auto b = bufferB.template Get<T>();
    auto d = bufferD.template Get<DT>();
    AscendC::DataCopy(a, gx, CAPACITY);
    AscendC::DataCopy(b, gy, CAPACITY);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    __ubuf__ T* pa = (__ubuf__ T*)a.GetPhyAddr();
    __ubuf__ T* pb = (__ubuf__ T*)b.GetPhyAddr();
    __ubuf__ DT* pd = (__ubuf__ DT*)d.GetPhyAddr();
    for (int mode = 0; mode < 8; ++mode) {
        AscendC::Duplicate(d, DT(-7), CAPACITY);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        switch (mode) {
            case 0:
                Compute<Op>(d, a, b, count, form);
                break;
            case 1:
                Compute<Op>(pd, a, b, count, form);
                break;
            case 2:
                Compute<Op>(d, pa, b, count, form);
                break;
            case 3:
                Compute<Op>(d, a, pb, count, form);
                break;
            case 4:
                Compute<Op>(pd, pa, b, count, form);
                break;
            case 5:
                Compute<Op>(pd, a, pb, count, form);
                break;
            case 6:
                Compute<Op>(d, pa, pb, count, form);
                break;
            case 7:
                Compute<Op>(pd, pa, pb, count, form);
                break;
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(go[mode * CAPACITY], d, CAPACITY);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

bool CheckAcl(aclError status, const char* expression)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL failure %d: %s\n", int(status), expression);
    return false;
}
#define CHECK_ACL(EXPR)                 \
    do {                                \
        if (!CheckAcl((EXPR), #EXPR)) { \
            return false;               \
        }                               \
    } while (0)

template <int Op, typename T, typename DT>
DT Expected(T a, T b)
{
    if constexpr (Op <= 2) {
        return DT(a);
    } else if constexpr (Op == 3 || Op == 6) {
        return DT(std::max(float(a) + float(b), 0.0f));
    } else if constexpr (Op == 4) {
        return DT(std::max(float(a) - float(b), 0.0f));
    } else if constexpr (Op == 5) {
        return DT(std::max(-128.0f, std::min(127.0f, float(a) * float(b))));
    } else {
        return DT(float(a) * 2.0f);
    }
}

template <int Op, typename T, typename DT>
bool Run(const char* name, aclrtStream stream)
{
    std::vector<T> x(CAPACITY), y(CAPACITY);
    std::vector<DT> output(8 * CAPACITY);
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        x[i] = T(int(i % 201) - 100);
        y[i] = T(int((7 * i + 3) % 201) - 100);
    }
    void *dx = nullptr, *dy = nullptr, *dout = nullptr;
    CHECK_ACL(aclrtMalloc(&dx, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dy, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dout, sizeof(DT) * 8 * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dx, sizeof(T) * CAPACITY, x.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dy, sizeof(T) * CAPACITY, y.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t count : {1u, 32u, 1024u, 2048u}) {
        constexpr bool countOnly = Op == 7;
        for (int form = 0; form < (countOnly ? 1 : 3); ++form) {
            BinaryPointerKernel<Op, T, DT><<<1, 0, stream>>>((T*)dx, (T*)dy, (DT*)dout, count, form);
            CHECK_ACL(aclrtSynchronizeStream(stream));
            CHECK_ACL(aclrtMemcpy(
                output.data(), sizeof(DT) * 8 * CAPACITY, dout, sizeof(DT) * 8 * CAPACITY, ACL_MEMCPY_DEVICE_TO_HOST));
            for (int mode = 0; mode < 8; ++mode) {
                for (uint32_t i = 0; i < CAPACITY; ++i) {
                    DT expected = i < count ? Expected<Op, T, DT>(x[i], y[i]) : DT(-7);
                    DT value = output[mode * CAPACITY + i];
                    bool hostMatch;
                    if constexpr (std::is_integral<DT>::value) {
                        hostMatch = value == expected;
                    } else {
                        hostMatch =
                            std::abs(double(value) - double(expected)) <= 1e-5 + 1e-4 * std::abs(double(expected));
                    }
                    if (!hostMatch || (i >= count && value != expected)) {
                        std::fprintf(
                            stderr, "FAIL %s count=%u form=%d mode=%d index=%u got=%g expected=%g\n", name, count, form,
                            mode, i, double(value), double(expected));
                        aclrtFree(dx);
                        aclrtFree(dy);
                        aclrtFree(dout);
                        return false;
                    }
                    if (value != output[i]) {
                        std::fprintf(stderr, "Tensor/pointer mismatch in %s\n", name);
                        aclrtFree(dx);
                        aclrtFree(dy);
                        aclrtFree(dout);
                        return false;
                    }
                }
            }
            std::printf("PASS %s count=%u form=%d modes=8 tensor_equal=true tail_unchanged=true\n", name, count, form);
        }
    }
    CHECK_ACL(aclrtFree(dx));
    CHECK_ACL(aclrtFree(dy));
    CHECK_ACL(aclrtFree(dout));
    return true;
}

bool Execute()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    bool passed = Run<0, float, half>("Cast", stream) && Run<1, int32_t, half>("CastDeq", stream) &&
                  Run<2, int32_t, half>("CastDequant", stream) && Run<3, float, half>("AddReluCast", stream) &&
                  Run<4, float, half>("SubReluCast", stream) && Run<5, half, int8_t>("MulCast", stream) &&
                  Run<6, int32_t, half>("AddDeqRelu", stream) && Run<7, float, half>("MulsCast", stream);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return passed;
}

int main() { return Execute() ? 0 : 1; }
