#include "acl/acl.h"
#include "basic_api/kernel_operator_proposal_intf.h"
#include "basic_api/kernel_operator_vec_duplicate_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <algorithm>
#include <cstdio>
#include <cstring>
#include <vector>
constexpr uint32_t CAPACITY = 2048;

template <bool Pointer, typename T>
__aicore__ inline auto Operand(AscendC::LocalTensor<T> value)
{
    if constexpr (Pointer) {
        return (__ubuf__ T*)value.GetPhyAddr();
    } else {
        return value;
    }
}
template <int Mode, bool Full>
__aicore__ inline void SortCase(
    AscendC::LocalTensor<float> dst, AscendC::LocalTensor<float> src, AscendC::LocalTensor<uint32_t> index,
    AscendC::LocalTensor<float> tmp, uint32_t count)
{
    auto scratch = Operand<(Mode & 8) != 0>(tmp);
    AscendC::Sort<float, Full>(
        Operand<(Mode & 1) != 0>(dst), Operand<(Mode & 2) != 0>(src), Operand<(Mode & 4) != 0>(index), scratch,
        count / 32);
}
template <int Mode>
__aicore__ inline void MergeCase(
    AscendC::LocalTensor<float> dst, AscendC::LocalTensor<float> src, uint32_t count, int form)
{
    auto list = AscendC::MrgSortSrcList(
        Operand<(Mode & 2) != 0>(src), Operand<(Mode & 4) != 0>(src[count / 2]), Operand<(Mode & 8) != 0>(src[count]),
        Operand<(Mode & 16) != 0>(src[count * 3 / 2]));
    uint16_t lengths[4] = {uint16_t(count / 4), uint16_t(count / 4), uint16_t(count / 4), uint16_t(count / 4)};
    if (form == 0) {
        AscendC::MrgSort4Info params(lengths, false, 15, 1);
        AscendC::MrgSort<float>(Operand<(Mode & 1) != 0>(dst), list, params);
    } else {
        uint32_t consumed[4]{};
        AscendC::MrgSort<float, false>(Operand<(Mode & 1) != 0>(dst), list, lengths, consumed, 15, 1);
    }
}
template <bool Merge, bool Full>
__global__ __vector__ void SortKernel(
    __gm__ float* input, __gm__ uint32_t* indices, __gm__ float* output, uint32_t count, int form)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> a, d, t, b;
    pipe.InitBuffer(a, CAPACITY * 8);
    pipe.InitBuffer(d, CAPACITY * 8);
    pipe.InitBuffer(t, CAPACITY * 8);
    pipe.InitBuffer(b, CAPACITY * 4);
    auto src = a.Get<float>(), dst = d.Get<float>(), tmp = t.Get<float>();
    auto index = b.Get<uint32_t>();
    AscendC::GlobalTensor<float> gi, go;
    AscendC::GlobalTensor<uint32_t> gindex;
    gi.SetGlobalBuffer(input, CAPACITY * 2);
    go.SetGlobalBuffer(output, 32 * CAPACITY * 2);
    gindex.SetGlobalBuffer(indices, CAPACITY);
    AscendC::DataCopy(src, gi, CAPACITY * 2);
    AscendC::DataCopy(index, gindex, CAPACITY);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    for (int mode = 0; mode < (Merge ? 32 : 16); ++mode) {
        AscendC::Duplicate(dst, float(-7), CAPACITY * 2);
        AscendC::PipeBarrier<PIPE_V>();
        if constexpr (Merge) {
            switch (mode) {
                case 0:
                    MergeCase<0>(dst, src, count, form);
                    break;
                case 1:
                    MergeCase<1>(dst, src, count, form);
                    break;
                case 2:
                    MergeCase<2>(dst, src, count, form);
                    break;
                case 3:
                    MergeCase<3>(dst, src, count, form);
                    break;
                case 4:
                    MergeCase<4>(dst, src, count, form);
                    break;
                case 5:
                    MergeCase<5>(dst, src, count, form);
                    break;
                case 6:
                    MergeCase<6>(dst, src, count, form);
                    break;
                case 7:
                    MergeCase<7>(dst, src, count, form);
                    break;
                case 8:
                    MergeCase<8>(dst, src, count, form);
                    break;
                case 9:
                    MergeCase<9>(dst, src, count, form);
                    break;
                case 10:
                    MergeCase<10>(dst, src, count, form);
                    break;
                case 11:
                    MergeCase<11>(dst, src, count, form);
                    break;
                case 12:
                    MergeCase<12>(dst, src, count, form);
                    break;
                case 13:
                    MergeCase<13>(dst, src, count, form);
                    break;
                case 14:
                    MergeCase<14>(dst, src, count, form);
                    break;
                case 15:
                    MergeCase<15>(dst, src, count, form);
                    break;
                case 16:
                    MergeCase<16>(dst, src, count, form);
                    break;
                case 17:
                    MergeCase<17>(dst, src, count, form);
                    break;
                case 18:
                    MergeCase<18>(dst, src, count, form);
                    break;
                case 19:
                    MergeCase<19>(dst, src, count, form);
                    break;
                case 20:
                    MergeCase<20>(dst, src, count, form);
                    break;
                case 21:
                    MergeCase<21>(dst, src, count, form);
                    break;
                case 22:
                    MergeCase<22>(dst, src, count, form);
                    break;
                case 23:
                    MergeCase<23>(dst, src, count, form);
                    break;
                case 24:
                    MergeCase<24>(dst, src, count, form);
                    break;
                case 25:
                    MergeCase<25>(dst, src, count, form);
                    break;
                case 26:
                    MergeCase<26>(dst, src, count, form);
                    break;
                case 27:
                    MergeCase<27>(dst, src, count, form);
                    break;
                case 28:
                    MergeCase<28>(dst, src, count, form);
                    break;
                case 29:
                    MergeCase<29>(dst, src, count, form);
                    break;
                case 30:
                    MergeCase<30>(dst, src, count, form);
                    break;
                case 31:
                    MergeCase<31>(dst, src, count, form);
                    break;
            }
        } else {
            switch (mode) {
                case 0:
                    SortCase<0, Full>(dst, src, index, tmp, count);
                    break;
                case 1:
                    SortCase<1, Full>(dst, src, index, tmp, count);
                    break;
                case 2:
                    SortCase<2, Full>(dst, src, index, tmp, count);
                    break;
                case 3:
                    SortCase<3, Full>(dst, src, index, tmp, count);
                    break;
                case 4:
                    SortCase<4, Full>(dst, src, index, tmp, count);
                    break;
                case 5:
                    SortCase<5, Full>(dst, src, index, tmp, count);
                    break;
                case 6:
                    SortCase<6, Full>(dst, src, index, tmp, count);
                    break;
                case 7:
                    SortCase<7, Full>(dst, src, index, tmp, count);
                    break;
                case 8:
                    SortCase<8, Full>(dst, src, index, tmp, count);
                    break;
                case 9:
                    SortCase<9, Full>(dst, src, index, tmp, count);
                    break;
                case 10:
                    SortCase<10, Full>(dst, src, index, tmp, count);
                    break;
                case 11:
                    SortCase<11, Full>(dst, src, index, tmp, count);
                    break;
                case 12:
                    SortCase<12, Full>(dst, src, index, tmp, count);
                    break;
                case 13:
                    SortCase<13, Full>(dst, src, index, tmp, count);
                    break;
                case 14:
                    SortCase<14, Full>(dst, src, index, tmp, count);
                    break;
                case 15:
                    SortCase<15, Full>(dst, src, index, tmp, count);
                    break;
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(go[mode * CAPACITY * 2], dst, CAPACITY * 2);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
bool Check(aclError code, const char* expression)
{
    if (code == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL failure %d: %s\n", int(code), expression);
    return false;
}
#define ACL_CHECK(x)           \
    do {                       \
        if (!Check((x), #x)) { \
            return false;      \
        }                      \
    } while (0)
template <bool Merge, bool Full>
bool Run(aclrtStream stream)
{
    const char* name = Merge ? "MrgSort" : Full ? "Sort" : "SortPartial";
    void *di = nullptr, *dx = nullptr, *dout = nullptr;
    ACL_CHECK(aclrtMalloc(&di, CAPACITY * 8, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&dx, CAPACITY * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&dout, 32 * CAPACITY * 8, ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<float> input(CAPACITY * 2), output(32 * CAPACITY * 2);
    std::vector<uint32_t> index(CAPACITY);
    bool pass = true;
    for (uint32_t count : {32u, 128u, 1024u, 2048u}) {
        if (Merge && count < 128) {
            continue;
        }
        std::vector<std::pair<float, uint32_t>> expected(count);
        for (uint32_t i = 0; i < count; ++i) {
            expected[i] = {float((i * 17) % count) * 200 / count - 100, i};
            index[i] = i;
        }
        if constexpr (Merge) {
            for (uint32_t start = 0; start < count; start += count / 4) {
                std::sort(expected.begin() + start, expected.begin() + start + count / 4, std::greater<>());
            }
            for (uint32_t i = 0; i < count; ++i) {
                input[2 * i] = expected[i].first;
                std::memcpy(&input[2 * i + 1], &expected[i].second, 4);
            }
        } else {
            for (uint32_t i = 0; i < count; ++i) {
                input[i] = expected[i].first;
            }
        }
        if constexpr (Merge || Full) {
            std::sort(expected.begin(), expected.end(), std::greater<>());
        } else {
            for (uint32_t start = 0; start < count; start += 32) {
                std::sort(expected.begin() + start, expected.begin() + start + 32, std::greater<>());
            }
        }
        ACL_CHECK(aclrtMemcpy(di, CAPACITY * 8, input.data(), CAPACITY * 8, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(dx, CAPACITY * 4, index.data(), CAPACITY * 4, ACL_MEMCPY_HOST_TO_DEVICE));
        for (int form = 0; form < (Merge ? 2 : 1); ++form) {
            SortKernel<Merge, Full><<<1, 0, stream>>>((float*)di, (uint32_t*)dx, (float*)dout, count, form);
            ACL_CHECK(aclrtSynchronizeStream(stream));
            ACL_CHECK(
                aclrtMemcpy(output.data(), 32 * CAPACITY * 8, dout, 32 * CAPACITY * 8, ACL_MEMCPY_DEVICE_TO_HOST));
            for (int mode = 0; mode < (Merge ? 32 : 16); ++mode) {
                for (uint32_t i = 0; i < count; ++i) {
                    uint32_t idx;
                    std::memcpy(&idx, &output[mode * CAPACITY * 2 + 2 * i + 1], 4);
                    float value = output[mode * CAPACITY * 2 + 2 * i];
                    if (value != expected[i].first || idx != expected[i].second ||
                        std::memcmp(&output[mode * CAPACITY * 2 + 2 * i], &output[2 * i], 8) != 0) {
                        std::fprintf(
                            stderr, "FAIL %s count=%u form=%d mode=%d i=%u got=(%g,%u) expected=(%g,%u)\n", name, count,
                            form, mode, i, value, idx, expected[i].first, expected[i].second);
                        pass = false;
                        goto cleanup;
                    }
                }
                for (uint32_t i = count * 2; i < CAPACITY * 2; ++i) {
                    if (output[mode * CAPACITY * 2 + i] != -7) {
                        std::fprintf(stderr, "FAIL %s tail modified\n", name);
                        pass = false;
                        goto cleanup;
                    }
                }
            }
            std::printf(
                "PASS %s count=%u form=%d modes=%d tensor_equal=true tail_unchanged=true\n", name, count, form,
                Merge ? 32 : 16);
        }
    }
cleanup:
    ACL_CHECK(aclrtFree(di));
    ACL_CHECK(aclrtFree(dx));
    ACL_CHECK(aclrtFree(dout));
    return pass;
}
bool Execute()
{
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));
    bool pass = Run<false, false>(stream) && Run<false, true>(stream) && Run<true, true>(stream);
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());
    return pass;
}
int main() { return Execute() ? 0 : 1; }
