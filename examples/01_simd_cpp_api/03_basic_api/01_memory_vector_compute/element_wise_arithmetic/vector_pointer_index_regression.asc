#include "acl/acl.h"
#include "basic_api/kernel_operator_vec_binary_intf.h"
#include "basic_api/kernel_operator_vec_unary_intf.h"
#include "basic_api/kernel_operator_vec_binary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_ternary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_duplicate_intf.h"
#include "basic_api/kernel_operator_vec_reduce_intf.h"
#include "basic_api/kernel_operator_vec_createvecindex_intf.h"
#include "basic_api/kernel_operator_vec_vconv_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <algorithm>
#include <cmath>
#include "basic_api/kernel_operator_vec_gather_intf.h"
#include "basic_api/kernel_operator_vec_scatter_intf.h"
#include "basic_api/kernel_operator_vec_gather_mask_intf.h"
#include "basic_api/kernel_operator_vec_brcb_intf.h"
#include <cstring>
#include "basic_api/kernel_operator_limits_intf.h"
#include <cstdint>
#include <cstdio>
#include <vector>
#include <type_traits>

constexpr uint32_t CAPACITY = 2048;

template <int Op, typename D, typename A, typename B>
__aicore__ inline void Compute(D dst, A src, B index, uint32_t count, int form)
{
    uint64_t active = count < 64 ? count : 64;
    uint64_t bits[2] = {active == 64 ? ~uint64_t(0) : (uint64_t(1) << active)-1, 0};
    uint8_t repeats = (count+63)/64;
    if constexpr (Op == 0) {
        if (form == 0) { AscendC::Gather(dst, src, index, 0, count); }
        else if (form == 1) { AscendC::Gather(dst, src, index, 0, active, repeats, 8); }
        else { AscendC::Gather(dst, src, index, 0, bits, repeats, 8); }
    } else if constexpr (Op == 1) {
        if (form == 0) { AscendC::Scatter(dst, src, index, 0, count); }
        else if (form == 1) { AscendC::Scatter(dst, src, index, 0, active, repeats, 8); }
        else { AscendC::Scatter(dst, src, index, 0, bits, repeats, 8); }
    } else if constexpr (Op == 2) {
        AscendC::GatherRepeatParams p{1,8};
        AscendC::Gatherb(dst, src, index, repeats, p);
    } else if constexpr (Op == 3 || Op == 4) {
        uint64_t reserved = 0;
        AscendC::GatherMaskParams p{1,1,8,0};
        if constexpr (Op == 3) { AscendC::GatherMask(dst, src, uint8_t(1), true, count, p, reserved); }
        else { AscendC::GatherMask(dst, src, index, true, count, p, reserved); }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::GetUnderlyingPtr(dst)[CAPACITY-1] = float(reserved);
    } else if constexpr (Op == 5) {
        AscendC::BrcbRepeatParams p{1,8};
        AscendC::Brcb(dst, src, repeats, p);
    } else {
#define REDUCE(API, STRIDE) \
        if (form == 1) { AscendC::API<AscendC::ReduceType::SUM>(dst, src, int32_t(active), repeats, STRIDE, 1, 8); } \
        else { AscendC::API<AscendC::ReduceType::SUM>(dst, src, bits, repeats, STRIDE, 1, 8); }
        if constexpr (Op == 6) { REDUCE(ReduceDataBlock, 1); }
        else if constexpr (Op == 7) { REDUCE(ReducePairElem, 1); }
        else if constexpr (Op == 8) { REDUCE(ReduceRepeat, 1); }
#undef REDUCE
    }
}

template <int Op, typename T>
__global__ __vector__ void BinaryPointerKernel(__gm__ T* x, __gm__ uint32_t* y, __gm__ T* output,
                                             uint32_t count, int form)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> gx, go;
    AscendC::GlobalTensor<uint32_t> gy;
    gx.SetGlobalBuffer(x, CAPACITY);
    gy.SetGlobalBuffer(y, CAPACITY);
    go.SetGlobalBuffer(output, 8 * CAPACITY);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufferA, bufferB, bufferD;
    pipe.InitBuffer(bufferA, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferB, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferD, sizeof(T) * CAPACITY);
    auto a = bufferA.template Get<T>();
    auto b = bufferB.template Get<uint32_t>();
    auto d = bufferD.template Get<T>();
    AscendC::DataCopy(a, gx, CAPACITY);
    AscendC::DataCopy(b, gy, CAPACITY);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    __ubuf__ T* pa = (__ubuf__ T*)a.GetPhyAddr();
    __ubuf__ uint32_t* pb = (__ubuf__ uint32_t*)b.GetPhyAddr();
    __ubuf__ T* pd = (__ubuf__ T*)d.GetPhyAddr();
    for (int mode = 0; mode < 8; ++mode) {
        AscendC::DataCopy(d, gx, CAPACITY);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        switch (mode) {
            case 0: Compute<Op>(d, a, b, count, form); break;
            case 1: Compute<Op>(pd, a, b, count, form); break;
            case 2: Compute<Op>(d, pa, b, count, form); break;
            case 3: Compute<Op>(d, a, pb, count, form); break;
            case 4: Compute<Op>(pd, pa, b, count, form); break;
            case 5: Compute<Op>(pd, a, pb, count, form); break;
            case 6: Compute<Op>(d, pa, pb, count, form); break;
            case 7: Compute<Op>(pd, pa, pb, count, form); break;
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(go[mode * CAPACITY], d, CAPACITY);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

bool CheckAcl(aclError status, const char* expression)
{
    if (status == ACL_SUCCESS) { return true; }
    std::fprintf(stderr, "ACL failure %d: %s\n", int(status), expression);
    return false;
}
#define CHECK_ACL(EXPR) do { if (!CheckAcl((EXPR), #EXPR)) { return false; } } while (0)

template <int Op, typename T>
bool Run(const char* name, aclrtStream stream)
{
    std::vector<T> x(CAPACITY), output(8 * CAPACITY);
    std::vector<uint32_t> y(CAPACITY);
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        x[i] = T(int(i % 201) - 100);
        y[i] = T(int((7 * i + 3) % 201) - 100);

    }
    void *dx = nullptr, *dy = nullptr, *dout = nullptr;
    CHECK_ACL(aclrtMalloc(&dx, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dy, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dout, sizeof(T) * 8 * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dx, sizeof(T) * CAPACITY, x.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dy, sizeof(T) * CAPACITY, y.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t count : {1u, 32u, 64u, 1024u, 2048u}) {
        if constexpr (Op == 2 || Op == 5) { if (count < 64) { continue; } }
        for (uint32_t i = 0; i < CAPACITY; ++i) {
            y[i] = i < count ? (count-1-i)*4 : 0;
            if constexpr (Op == 2) { y[i] = i < count/8 ? (count/8-1-i)*32 : 0; }
            if constexpr (Op == 4) { y[i] = 0x55555555; }
        }
        CHECK_ACL(aclrtMemcpy(dy, sizeof(uint32_t)*CAPACITY, y.data(), sizeof(uint32_t)*CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
        for (int form = Op >= 6 ? 1 : 0; form < (Op >= 2 && Op <= 5 ? 1 : 3); ++form) {
            BinaryPointerKernel<Op, T><<<1, 0, stream>>>((T*)dx, (uint32_t*)dy, (T*)dout, count, form);
            CHECK_ACL(aclrtSynchronizeStream(stream));
            CHECK_ACL(aclrtMemcpy(output.data(), sizeof(T) * 8 * CAPACITY, dout,
                                 sizeof(T) * 8 * CAPACITY, ACL_MEMCPY_DEVICE_TO_HOST));
            for (int mode = 0; mode < 8; ++mode) {
                for (uint32_t i = 0; i < CAPACITY; ++i) {
                    T expected = x[i];
                    uint32_t produced = count;
                    if constexpr (Op == 3 || Op == 4) { produced = (count+1)/2; }
                    if constexpr (Op == 6) { produced = (count+7)/8; }
                    if constexpr (Op == 7) { produced = (count+1)/2; }
                    if constexpr (Op == 8) { produced = (count+63)/64; }
                    if (i < produced) {
                        if constexpr (Op == 0 || Op == 1) { expected = x[count-1-i]; }
                        else if constexpr (Op == 2) { expected = x[(count/8-1-i/8)*8+i%8]; }
                        else if constexpr (Op == 3 || Op == 4) { expected = x[2*i]; }
                        else if constexpr (Op == 5) { expected = x[i/8]; }
                        else {
                            constexpr uint32_t width = Op == 6 ? 8 : Op == 7 ? 2 : 64;
                            expected = 0;
                            for (uint32_t k = i*width; k < std::min(count, (i+1)*width); ++k) { expected += x[k]; }
                        }
                    }
                    if constexpr (Op == 3 || Op == 4) { if (i == CAPACITY-1) { expected = T(produced); } }
                    T value = output[mode * CAPACITY + i];
                    bool hostMatch;
                    if constexpr (std::is_integral<T>::value) { hostMatch = value == expected; }
                    else { hostMatch = std::abs(double(value) - double(expected)) <= 1e-5 + 1e-4 * std::abs(double(expected)); }
                    if constexpr (Op >= 48) { hostMatch = std::memcmp(&value, &expected, sizeof(T)) == 0; }
                    if ((!hostMatch && (Op < 6 || i < produced))) {
                        std::fprintf(stderr, "FAIL %s count=%u form=%d mode=%d index=%u got=%g expected=%g\n",
                                     name, count, form, mode, i, double(value), double(expected));
                        aclrtFree(dx); aclrtFree(dy); aclrtFree(dout);
                        return false;
                    }
                    if (std::memcmp(&value, &output[i], sizeof(T)) != 0) {
                        std::fprintf(stderr, "Tensor/pointer mismatch in %s\n", name);
                        aclrtFree(dx); aclrtFree(dy); aclrtFree(dout);
                        return false;
                    }
                }
            }
            std::printf("PASS %s count=%u form=%d modes=8 tensor_equal=true full_tensor_equal=true\n", name, count, form);
        }
    }
    CHECK_ACL(aclrtFree(dx));
    CHECK_ACL(aclrtFree(dy));
    CHECK_ACL(aclrtFree(dout));
    return true;
}

bool Execute()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    bool passed = Run<0, float>("Gather", stream) &&
        Run<1, float>("Scatter", stream) &&
        Run<2, float>("Gatherb", stream) &&
        Run<3, float>("GatherMaskScalar", stream) &&
        Run<4, float>("GatherMask", stream) &&
        Run<5, float>("Brcb", stream) &&
        Run<6, float>("ReduceDataBlock", stream) &&
        Run<7, float>("ReducePairElem", stream) &&
        Run<8, float>("ReduceRepeat", stream);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return passed;
}

int main()
{
    return Execute() ? 0 : 1;
}
