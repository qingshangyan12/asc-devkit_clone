#include "acl/acl.h"
#include "basic_api/kernel_operator_vec_binary_intf.h"
#include "basic_api/kernel_operator_vec_unary_intf.h"
#include "basic_api/kernel_operator_vec_binary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_ternary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_duplicate_intf.h"
#include "basic_api/kernel_operator_vec_reduce_intf.h"
#include "basic_api/kernel_operator_vec_createvecindex_intf.h"
#include "basic_api/kernel_operator_vec_vconv_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <algorithm>
#include <cmath>
#include <cstring>
#include "basic_api/kernel_operator_limits_intf.h"
#include <cstdint>
#include <cstdio>
#include <vector>
#include <type_traits>

constexpr uint32_t CAPACITY = 2048;

template <int Op, typename D, typename A, typename B>
__aicore__ inline void Compute(D dst, A src0, B src1, uint32_t count, int form)
{
    constexpr uint32_t lanes = 256 / sizeof(typename AscendC::VectorOperand::Traits<D>::Element);
    uint64_t active = count < lanes ? count : lanes;
    uint64_t bits[2] = {
        active >= 64 ? ~uint64_t(0) : (uint64_t(1) << active) - 1, active == 128 ? ~uint64_t(0) :
                                                                   active > 64   ? (uint64_t(1) << (active - 64)) - 1 :
                                                                                   0};
    uint8_t repeats = (count + lanes - 1) / lanes;
    AscendC::BinaryRepeatParams params{1, 1, 1, 8, 8, 8};
#define RUN_BINARY(API)                                         \
    if (form == 0) {                                            \
        AscendC::API(dst, src0, src1, int32_t(count));          \
    } else if (form == 1) {                                     \
        AscendC::API(dst, src0, src1, active, repeats, params); \
    } else {                                                    \
        AscendC::API(dst, src0, src1, bits, repeats, params);   \
    }
    if constexpr (Op == 0) {
        RUN_BINARY(Add);
    } else if constexpr (Op == 1) {
        RUN_BINARY(Sub);
    } else if constexpr (Op == 2) {
        RUN_BINARY(Mul);
    } else if constexpr (Op == 3) {
        RUN_BINARY(Max);
    } else if constexpr (Op == 4) {
        RUN_BINARY(Min);
    } else if constexpr (Op == 5) {
        RUN_BINARY(And);
    } else if constexpr (Op == 6) {
        RUN_BINARY(Or);
    } else if constexpr (Op == 7) {
        RUN_BINARY(AddRelu);
    } else if constexpr (Op == 8) {
        RUN_BINARY(SubRelu);
    } else if constexpr (Op == 9) {
        RUN_BINARY(Div);
    } else if constexpr (Op == 10) {
        RUN_BINARY(FusedMulAdd);
    } else if constexpr (Op == 11) {
        RUN_BINARY(FusedMulAddRelu);
    } else if constexpr (Op == 12) {
        RUN_BINARY(MulAddDst);
    } else if constexpr (Op == 13) {
        RUN_BINARY(MulAddRelu);
    }
#undef RUN_BINARY
    AscendC::UnaryRepeatParams unary{1, 1, 8, 8};
#define RUN_UNARY(API)                                   \
    if (form == 0) {                                     \
        AscendC::API(dst, src0, int32_t(count));         \
    } else if (form == 1) {                              \
        AscendC::API(dst, src0, active, repeats, unary); \
    } else {                                             \
        AscendC::API(dst, src0, bits, repeats, unary);   \
    }
    if constexpr (Op == 14) {
        RUN_UNARY(Abs);
    } else if constexpr (Op == 15) {
        RUN_UNARY(Relu);
    } else if constexpr (Op == 16) {
        RUN_UNARY(Exp);
    } else if constexpr (Op == 17) {
        RUN_UNARY(Ln);
    } else if constexpr (Op == 18) {
        RUN_UNARY(Sqrt);
    } else if constexpr (Op == 19) {
        RUN_UNARY(Rsqrt);
    } else if constexpr (Op == 20) {
        RUN_UNARY(Reciprocal);
    } else if constexpr (Op == 21) {
        RUN_UNARY(Not);
    } else if constexpr (Op == 22) {
        AscendC::Neg(dst, src0, count);
    }
#undef RUN_UNARY
    using T = typename AscendC::VectorOperand::Traits<D>::Element;
#define RUN_SCALAR(API)                                        \
    if (form == 0) {                                           \
        AscendC::API(dst, src0, T(2), int32_t(count));         \
    } else if (form == 1) {                                    \
        AscendC::API(dst, src0, T(2), active, repeats, unary); \
    } else {                                                   \
        AscendC::API(dst, src0, T(2), bits, repeats, unary);   \
    }
    if constexpr (Op == 23) {
        RUN_SCALAR(Adds);
    } else if constexpr (Op == 24) {
        RUN_SCALAR(Muls);
    } else if constexpr (Op == 25) {
        RUN_SCALAR(Maxs);
    } else if constexpr (Op == 26) {
        RUN_SCALAR(Mins);
    } else if constexpr (Op == 27) {
        RUN_SCALAR(Divs);
    } else if constexpr (Op == 28) {
        RUN_SCALAR(Subs);
    } else if constexpr (Op == 29) {
        RUN_SCALAR(Ands);
    } else if constexpr (Op == 30) {
        RUN_SCALAR(Ors);
    } else if constexpr (Op == 31) {
        RUN_SCALAR(Axpy);
    } else if constexpr (Op == 32) {
        if (form == 0) {
            AscendC::Duplicate(dst, T(2), int32_t(count));
        } else if (form == 1) {
            AscendC::Duplicate(dst, T(2), active, repeats, uint16_t(1), uint8_t(8));
        } else {
            AscendC::Duplicate(dst, T(2), bits, repeats, uint16_t(1), uint8_t(8));
        }
    } else if constexpr (Op == 33) {
        AscendC::Duplicate(dst, src0, int32_t(count));
    }
#undef RUN_SCALAR
#define RUN_REDUCE(API)                                                               \
    if (form == 0) {                                                                  \
        AscendC::API(dst, src0, src1, int32_t(count));                                \
    } else if (form == 1) {                                                           \
        AscendC::API(dst, src0, src1, int32_t(active), int32_t(repeats), int32_t(8)); \
    } else {                                                                          \
        AscendC::API(dst, src0, src1, bits, int32_t(repeats), int32_t(8));            \
    }
    if constexpr (Op == 34) {
        RUN_REDUCE(ReduceSum);
    } else if constexpr (Op == 35) {
        RUN_REDUCE(ReduceMax);
    } else if constexpr (Op == 36) {
        RUN_REDUCE(ReduceMin);
    } else if constexpr (Op == 37) {
        if (form == 0) {
            AscendC::CreateVecIndex(dst, T(0), count);
        } else if (form == 1) {
            AscendC::CreateVecIndex(dst, T(0), active, repeats, uint16_t(1), uint8_t(8));
        } else {
            AscendC::CreateVecIndex(dst, T(0), bits, repeats, uint16_t(1), uint8_t(8));
        }
    }
#undef RUN_REDUCE
    if constexpr (Op == 38) {
        AscendC::Prelu(dst, src0, src1, count);
    } else if constexpr (Op == 39) {
        AscendC::AbsSub(dst, src0, src1, count);
    } else if constexpr (Op == 40) {
        AscendC::FusedAbsSub(dst, src0, src1, count);
    } else if constexpr (Op == 41) {
        AscendC::ExpSub(dst, src0, src1, count);
    } else if constexpr (Op == 42) {
        AscendC::FusedExpSub(dst, src0, src1, count);
    } else if constexpr (Op == 43) {
        if (form == 0) {
            AscendC::LeakyRelu(dst, src0, T(2), int32_t(count));
        } else if (form == 1) {
            AscendC::LeakyRelu(dst, src0, T(2), active, repeats, unary);
        } else {
            AscendC::LeakyRelu(dst, src0, T(2), bits, repeats, unary);
        }
    } else if constexpr (Op == 44) {
        if (form == 0) {
            AscendC::ShiftLeft(dst, src0, T(2), int32_t(count));
        } else if (form == 1) {
            AscendC::ShiftLeft(dst, src0, T(2), active, repeats, unary);
        } else {
            AscendC::ShiftLeft(dst, src0, T(2), bits, repeats, unary);
        }
    } else if constexpr (Op == 45) {
        if (form == 0) {
            AscendC::ShiftRight(dst, src0, T(2), int32_t(count));
        } else if (form == 1) {
            AscendC::ShiftRight(dst, src0, T(2), active, repeats, unary, false);
        } else {
            AscendC::ShiftRight(dst, src0, T(2), bits, repeats, unary, false);
        }
    } else if constexpr (Op == 46) {
        AscendC::CopyRepeatParams copy{1, 1, 8, 8};
        if (form == 0) {
            AscendC::Copy(dst, src0, count);
        } else if (form == 1) {
            AscendC::Copy(dst, src0, active, repeats, copy);
        } else {
            AscendC::Copy(dst, src0, bits, repeats, copy);
        }
    } else if constexpr (Op == 47) {
        AscendC::Truncate<T, AscendC::RoundMode::CAST_TRUNC>(dst, src0, count);
    } else if constexpr (Op == 48) {
        AscendC::NumericLimits<T>::DeNormMin(dst, count);
    } else if constexpr (Op == 49) {
        AscendC::NumericLimits<T>::Infinity(dst, count);
    } else if constexpr (Op == 50) {
        AscendC::NumericLimits<T>::Lowest(dst, count);
    } else if constexpr (Op == 51) {
        AscendC::NumericLimits<T>::NegativeInfinity(dst, count);
    } else if constexpr (Op == 52) {
        AscendC::NumericLimits<T>::QuietNaN(dst, count);
    } else if constexpr (Op == 53) {
        AscendC::NumericLimits<T>::SignalingNaN(dst, count);
    }
}

template <int Op, typename T>
__global__ __vector__ void BinaryPointerKernel(__gm__ T* x, __gm__ T* y, __gm__ T* output, uint32_t count, int form)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> gx, gy, go;
    gx.SetGlobalBuffer(x, CAPACITY);
    gy.SetGlobalBuffer(y, CAPACITY);
    go.SetGlobalBuffer(output, 8 * CAPACITY);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufferA, bufferB, bufferD;
    pipe.InitBuffer(bufferA, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferB, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferD, sizeof(T) * CAPACITY);
    auto a = bufferA.template Get<T>();
    auto b = bufferB.template Get<T>();
    auto d = bufferD.template Get<T>();
    AscendC::DataCopy(a, gx, CAPACITY);
    AscendC::DataCopy(b, gy, CAPACITY);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    __ubuf__ T* pa = (__ubuf__ T*)a.GetPhyAddr();
    __ubuf__ T* pb = (__ubuf__ T*)b.GetPhyAddr();
    __ubuf__ T* pd = (__ubuf__ T*)d.GetPhyAddr();
    for (int mode = 0; mode < 8; ++mode) {
        AscendC::DataCopy(d, gx, CAPACITY);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        switch (mode) {
            case 0:
                Compute<Op>(d, a, b, count, form);
                break;
            case 1:
                Compute<Op>(pd, a, b, count, form);
                break;
            case 2:
                Compute<Op>(d, pa, b, count, form);
                break;
            case 3:
                Compute<Op>(d, a, pb, count, form);
                break;
            case 4:
                Compute<Op>(pd, pa, b, count, form);
                break;
            case 5:
                Compute<Op>(pd, a, pb, count, form);
                break;
            case 6:
                Compute<Op>(d, pa, pb, count, form);
                break;
            case 7:
                Compute<Op>(pd, pa, pb, count, form);
                break;
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(go[mode * CAPACITY], d, CAPACITY);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

bool CheckAcl(aclError status, const char* expression)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL failure %d: %s\n", int(status), expression);
    return false;
}
#define CHECK_ACL(EXPR)                 \
    do {                                \
        if (!CheckAcl((EXPR), #EXPR)) { \
            return false;               \
        }                               \
    } while (0)

template <int Op, typename T>
T Expected(T a, T b)
{
    if constexpr (Op == 0) {
        return a + b;
    } else if constexpr (Op == 1) {
        return a - b;
    } else if constexpr (Op == 2) {
        return a * b;
    } else if constexpr (Op == 3) {
        return std::max(a, b);
    } else if constexpr (Op == 4) {
        return std::min(a, b);
    } else if constexpr (Op == 5) {
        return a & b;
    } else if constexpr (Op == 6) {
        return a | b;
    } else if constexpr (Op == 7) {
        return std::max(T(a + b), T(0));
    } else if constexpr (Op == 8) {
        return std::max(T(a - b), T(0));
    } else if constexpr (Op == 9) {
        return a / b;
    } else if constexpr (Op == 10) {
        return std::fma(a, a, b);
    } else if constexpr (Op == 11 || Op == 13) {
        return std::max(T(std::fma(a, a, b)), T(0));
    } else if constexpr (Op == 12) {
        return std::fma(a, b, a);
    } else if constexpr (Op == 14) {
        return std::abs(a);
    } else if constexpr (Op == 15) {
        return std::max(a, T(0));
    } else if constexpr (Op == 16) {
        return std::exp(a);
    } else if constexpr (Op == 17) {
        return std::log(a);
    } else if constexpr (Op == 18) {
        return std::sqrt(a);
    } else if constexpr (Op == 19) {
        return T(1) / std::sqrt(a);
    } else if constexpr (Op == 20) {
        return T(1) / a;
    } else if constexpr (Op == 21) {
        return T(~a);
    } else if constexpr (Op == 22) {
        return -a;
    } else if constexpr (Op == 23) {
        return a + T(2);
    } else if constexpr (Op == 24) {
        return a * T(2);
    } else if constexpr (Op == 25) {
        return std::max(a, T(2));
    } else if constexpr (Op == 26) {
        return std::min(a, T(2));
    } else if constexpr (Op == 27) {
        return a / T(2);
    } else if constexpr (Op == 28) {
        return a - T(2);
    } else if constexpr (Op == 29) {
        return a & T(2);
    } else if constexpr (Op == 30) {
        return a | T(2);
    } else if constexpr (Op == 31) {
        return a * T(3);
    } else if constexpr (Op == 32) {
        return T(2);
    } else if constexpr (Op == 38) {
        return a >= T(0) ? a : a * b;
    } else if constexpr (Op == 39 || Op == 40) {
        return std::abs(a - b);
    } else if constexpr (Op == 41 || Op == 42) {
        return std::exp(a - b);
    } else if constexpr (Op == 43) {
        return a >= T(0) ? a : a * T(2);
    } else if constexpr (Op == 44) {
        return T(a << 2);
    } else if constexpr (Op == 45) {
        return T(a >> 2);
    } else if constexpr (Op == 46) {
        return a;
    } else if constexpr (Op == 47) {
        return std::trunc(a);
    } else {
        return T(-100);
    }
}

template <int Op, typename T>
bool Run(const char* name, aclrtStream stream)
{
    std::vector<T> x(CAPACITY), y(CAPACITY), output(8 * CAPACITY);
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        x[i] = T(int(i % 201) - 100);
        y[i] = T(int((7 * i + 3) % 201) - 100);
        if constexpr (std::is_unsigned<T>::value) {
            x[i] = T(i % 101);
            y[i] = T((7 * i + 3) % 101);
        }
        if constexpr (Op == 9) {
            if (y[i] == T(0)) {
                y[i] = T(1);
            }
        }
        if constexpr (Op == 16) {
            x[i] = x[i] / T(25);
        }
        if constexpr (Op >= 17 && Op <= 20) {
            x[i] = T(i % 100 + 1) / T(8);
        }
        if constexpr (Op == 41 || Op == 42) {
            x[i] /= T(25);
            y[i] /= T(25);
        }
        if constexpr (Op == 44 || Op == 45) {
            x[i] = T(i % 101);
        }
        if constexpr (Op == 47) {
            x[i] /= T(3);
        }
    }
    void *dx = nullptr, *dy = nullptr, *dout = nullptr;
    CHECK_ACL(aclrtMalloc(&dx, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dy, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dout, sizeof(T) * 8 * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dx, sizeof(T) * CAPACITY, x.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dy, sizeof(T) * CAPACITY, y.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t count : {1u, 32u, 1024u, 2048u}) {
        constexpr bool countOnly = Op == 22 || Op == 33 || (Op >= 38 && Op <= 42) || Op >= 47;
        for (int form = 0; form < (countOnly ? 1 : 3); ++form) {
            BinaryPointerKernel<Op, T><<<1, 0, stream>>>((T*)dx, (T*)dy, (T*)dout, count, form);
            CHECK_ACL(aclrtSynchronizeStream(stream));
            CHECK_ACL(aclrtMemcpy(
                output.data(), sizeof(T) * 8 * CAPACITY, dout, sizeof(T) * 8 * CAPACITY, ACL_MEMCPY_DEVICE_TO_HOST));
            for (int mode = 0; mode < 8; ++mode) {
                for (uint32_t i = 0; i < CAPACITY; ++i) {
                    T expected = i < count ? Expected<Op>(x[i], y[i]) : x[i];
                    if constexpr (Op >= 34 && Op <= 36) {
                        expected = x[i];
                        if (i == 0) {
                            expected = x[0];
                            for (uint32_t k = 1; k < count; ++k) {
                                if constexpr (Op == 34) {
                                    expected += x[k];
                                } else if constexpr (Op == 35) {
                                    expected = std::max(expected, x[k]);
                                } else {
                                    expected = std::min(expected, x[k]);
                                }
                            }
                        }
                    }
                    if constexpr (Op == 37) {
                        if (i < count) {
                            expected = T(i);
                        }
                    }
                    if constexpr (Op >= 48) {
                        const uint32_t patterns[] = {0x00000001u, 0x7F800000u, 0xFF7FFFFFu,
                                                     0xFF800000u, 0x7FC00000u, 0x7FA00000u};
                        if (i < count) {
                            std::memcpy(&expected, &patterns[Op - 48], sizeof(expected));
                        }
                    }
                    T value = output[mode * CAPACITY + i];
                    bool hostMatch;
                    if constexpr (std::is_integral<T>::value) {
                        hostMatch = value == expected;
                    } else {
                        hostMatch =
                            std::abs(double(value) - double(expected)) <= 1e-5 + 1e-4 * std::abs(double(expected));
                    }
                    if constexpr (Op >= 48) {
                        hostMatch = std::memcmp(&value, &expected, sizeof(T)) == 0;
                    }
                    if (!hostMatch || (i >= count && value != expected)) {
                        std::fprintf(
                            stderr, "FAIL %s count=%u form=%d mode=%d index=%u got=%g expected=%g\n", name, count, form,
                            mode, i, double(value), double(expected));
                        aclrtFree(dx);
                        aclrtFree(dy);
                        aclrtFree(dout);
                        return false;
                    }
                    if (std::memcmp(&value, &output[i], sizeof(T)) != 0) {
                        std::fprintf(stderr, "Tensor/pointer mismatch in %s\n", name);
                        aclrtFree(dx);
                        aclrtFree(dy);
                        aclrtFree(dout);
                        return false;
                    }
                }
            }
            std::printf("PASS %s count=%u form=%d modes=8 tensor_equal=true tail_unchanged=true\n", name, count, form);
        }
    }
    CHECK_ACL(aclrtFree(dx));
    CHECK_ACL(aclrtFree(dy));
    CHECK_ACL(aclrtFree(dout));
    return true;
}

bool Execute()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    bool passed =
        Run<0, float>("Add", stream) && Run<1, float>("Sub", stream) && Run<2, float>("Mul", stream) &&
        Run<3, float>("Max", stream) && Run<4, float>("Min", stream) && Run<5, int32_t>("And", stream) &&
        Run<6, int32_t>("Or", stream) && Run<7, float>("AddRelu", stream) && Run<8, float>("SubRelu", stream) &&
        Run<9, float>("Div", stream) && Run<10, float>("FusedMulAdd", stream) &&
        Run<11, float>("FusedMulAddRelu", stream) && Run<12, float>("MulAddDst", stream) &&
        Run<13, float>("MulAddRelu", stream) && Run<14, float>("Abs", stream) && Run<15, float>("Relu", stream) &&
        Run<16, float>("Exp", stream) && Run<17, float>("Ln", stream) && Run<18, float>("Sqrt", stream) &&
        Run<19, float>("Rsqrt", stream) && Run<20, float>("Reciprocal", stream) && Run<21, uint16_t>("Not", stream) &&
        Run<22, float>("Neg", stream) && Run<23, float>("Adds", stream) && Run<24, float>("Muls", stream) &&
        Run<25, float>("Maxs", stream) && Run<26, float>("Mins", stream) && Run<27, float>("Divs", stream) &&
        Run<28, float>("Subs", stream) && Run<29, int16_t>("Ands", stream) && Run<30, int16_t>("Ors", stream) &&
        Run<31, float>("Axpy", stream) && Run<32, float>("DuplicateScalar", stream) &&
        Run<33, float>("DuplicateTensor", stream) && Run<34, float>("ReduceSum", stream) &&
        Run<35, float>("ReduceMax", stream) && Run<36, float>("ReduceMin", stream) &&
        Run<37, float>("CreateVecIndex", stream) && Run<38, float>("Prelu", stream) &&
        Run<39, float>("AbsSub", stream) && Run<40, float>("FusedAbsSub", stream) && Run<41, float>("ExpSub", stream) &&
        Run<42, float>("FusedExpSub", stream) && Run<43, float>("LeakyRelu", stream) &&
        Run<44, uint32_t>("ShiftLeft", stream) && Run<45, uint32_t>("ShiftRight", stream) &&
        Run<46, float>("Copy", stream) && Run<47, float>("Truncate", stream) && Run<48, float>("DeNormMin", stream) &&
        Run<49, float>("Infinity", stream) && Run<50, float>("Lowest", stream) &&
        Run<51, float>("NegativeInfinity", stream) && Run<52, float>("QuietNaN", stream) &&
        Run<53, float>("SignalingNaN", stream);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return passed;
}

int main() { return Execute() ? 0 : 1; }
