#include "acl/acl.h"
#include "basic_api/kernel_operator_mm_intf.h"
#include "basic_api/kernel_operator_vec_vconv_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <cstdio>
#include <vector>

constexpr uint32_t CAPACITY = 2048;
__global__ __mix__(1, 2) void FillKernel(__gm__ half* output, uint32_t count, bool pointer)
{
    AscendC::InitSocState();
    AscendC::LocalTensor<half> l1(AscendC::TPosition::A1, 0, CAPACITY);
    AscendC::LocalTensor<half> ub(AscendC::TPosition::VECCALC, 0, CAPACITY);
    if ASCEND_IS_AIC {
        AscendC::InitConstValueParams<half> clear{1,CAPACITY/16,0,half(-7)};
        AscendC::Fill(l1, clear);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::InitConstValueParams<half> params{1,uint16_t(count/16),0,half(3)};
        if (pointer) { AscendC::Fill((__cbuf__ half*)l1.GetPhyAddr(), params); }
        else { AscendC::Fill(l1, params); }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyL1ToUB<half,0>(ub,l1,CAPACITY);
        AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(8);
    }
    if ASCEND_IS_AIV {
        AscendC::CrossCoreWaitFlag<2>(8);
        if (AscendC::GetSubBlockIdx() == 0) {
            AscendC::GlobalTensor<half> go;
            go.SetGlobalBuffer(output,CAPACITY);
            AscendC::DataCopy(go,ub,CAPACITY);
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void ScaleKernel(__gm__ uint64_t* output, bool pointer)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer,128);
    auto dst=buffer.Get<uint64_t>();
    AscendC::VdeqInfo info{};
    for(int i=0;i<16;++i) {
        info.vdeqScale[i]=1.0f;
        info.vdeqOffset[i]=i-8;
        info.vdeqSignMode[i]=i%2;
    }
    if(pointer) { AscendC::SetDeqScale((__ubuf__ uint64_t*)dst.GetPhyAddr(),info); }
    else { AscendC::SetDeqScale(dst,info); }
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    AscendC::GlobalTensor<uint64_t> go;
    go.SetGlobalBuffer(output,16);
    AscendC::DataCopy(go,dst,16);
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool Check(aclError code,const char* expression)
{
    if(code==ACL_SUCCESS) { return true; }
    std::fprintf(stderr,"ACL failure %d: %s\n",int(code),expression); return false;
}
#define ACL_CHECK(x) do { if(!Check((x),#x)) { return false; } } while(0)
bool Run()
{
    ACL_CHECK(aclInit(nullptr)); ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream=nullptr; ACL_CHECK(aclrtCreateStream(&stream));
    void* device=nullptr; ACL_CHECK(aclrtMalloc(&device,CAPACITY*2,ACL_MEM_MALLOC_HUGE_FIRST));
    bool pass=true;
    std::vector<half> output(CAPACITY),reference(CAPACITY);
    for(uint32_t count : {16u,32u,1024u,2048u}) {
        for(int mode=0;mode<2;++mode) {
            FillKernel<<<1,0,stream>>>((half*)device,count,mode);
            ACL_CHECK(aclrtSynchronizeStream(stream));
            ACL_CHECK(aclrtMemcpy(output.data(),CAPACITY*2,device,CAPACITY*2,ACL_MEMCPY_DEVICE_TO_HOST));
            if(mode==0) { reference=output; }
            for(uint32_t i=0;i<CAPACITY;++i) {
                half expected=i<count?half(3):half(-7);
                if(output[i]!=expected || output[i]!=reference[i]) {
                    std::fprintf(stderr,"FAIL Fill count=%u mode=%d i=%u got=%g expected=%g\n",count,mode,i,double(output[i]),double(expected));
                    pass=false; break;
                }
            }
        }
        if(pass) { std::printf("PASS Fill count=%u form=0 modes=2 tensor_equal=true tail_unchanged=true\n",count); }
    }
    std::vector<uint64_t> config(16),previous(16);
    for(int mode=0;mode<2;++mode) {
        ScaleKernel<<<1,0,stream>>>((uint64_t*)device,mode);
        ACL_CHECK(aclrtSynchronizeStream(stream));
        ACL_CHECK(aclrtMemcpy(config.data(),128,device,128,ACL_MEMCPY_DEVICE_TO_HOST));
        if(mode==0) { previous=config; }
        for(int i=0;i<16;++i) {
            uint64_t expected=(uint64_t(i%2)<<46)|(uint64_t((i-8)&0x1ff)<<37)|0x3F800000u;
            if(config[i]!=expected || config[i]!=previous[i]) {
                std::fprintf(stderr,"FAIL SetDeqScale mode=%d i=%d\n",mode,i); pass=false;
            }
        }
    }
    if(pass) { std::puts("PASS SetDeqScale count=16 form=0 modes=2 tensor_equal=true"); }
    ACL_CHECK(aclrtFree(device)); ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0)); ACL_CHECK(aclFinalize());
    return pass;
}
int main() { return Run()?0:1; }
