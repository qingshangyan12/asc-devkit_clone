#include "acl/acl.h"
#include "basic_api/kernel_operator_vec_binary_intf.h"
#include "basic_api/kernel_operator_vec_unary_intf.h"
#include "basic_api/kernel_operator_vec_binary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_ternary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_duplicate_intf.h"
#include "basic_api/kernel_operator_vec_reduce_intf.h"
#include "basic_api/kernel_operator_vec_createvecindex_intf.h"
#include "basic_api/kernel_operator_vec_vconv_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <algorithm>
#include <cmath>
#include "basic_api/kernel_operator_vec_cmpsel_intf.h"
#include <cstring>
#include "basic_api/kernel_operator_limits_intf.h"
#include <cstdint>
#include <cstdio>
#include <vector>
#include <type_traits>

constexpr uint32_t CAPACITY = 2048;

constexpr AscendC::BinaryConfig SCALAR_FIRST{0};
template <int Op, typename D, typename M, typename A, typename B>
__aicore__ inline void Compute(D d, M m, A a, B b, uint32_t count)
{
    if constexpr (Op == 0) { AscendC::Compare(m, a, b, AscendC::CMPMODE::LT, count); }
    else if constexpr (Op == 1) { AscendC::CompareScalar(m, a, float(2), AscendC::CMPMODE::LT, count); }
    else if constexpr (Op == 2) { AscendC::Compares(m, a, float(2), AscendC::CMPMODE::LT, count); }
    else if constexpr (Op == 8) {
        AscendC::BinaryRepeatParams p{1,1,1,8,8,8};
        AscendC::Compare(a, b, AscendC::CMPMODE::LT, uint64_t(count), p);
        AscendC::GetCmpMask(m);
    } else if constexpr (Op == 9) {
        AscendC::SetCmpMask(m);
        AscendC::GetCmpMask(m);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    if constexpr (Op == 4) { AscendC::Select(d, m, a, float(2), AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, count); }
    else if constexpr (Op == 5) { AscendC::Select(d, m, float(2), b, AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, count); }
    else if constexpr (Op == 6) { AscendC::Select<float, uint8_t, AscendC::DEFAULT_BINARY_CONFIG>(d, m, a, b, AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, count); }
    else if constexpr (Op == 7) { AscendC::Select<float, uint8_t, SCALAR_FIRST>(d, m, a, b, AscendC::SELMODE::VSEL_TENSOR_SCALAR_MODE, count); }
    else { AscendC::Select(d, m, a, b, AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count); }
}

template <int Op, typename T>
__global__ __vector__ void BinaryPointerKernel(__gm__ T* x, __gm__ T* y, __gm__ T* output,
                                             uint32_t count, int form)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> gx, gy, go;
    gx.SetGlobalBuffer(x, CAPACITY);
    gy.SetGlobalBuffer(y, CAPACITY);
    go.SetGlobalBuffer(output, 16 * CAPACITY);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufferA, bufferB, bufferD, bufferM;
    pipe.InitBuffer(bufferA, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferB, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferD, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferM, CAPACITY);
    auto m = bufferM.template Get<uint8_t>();
    auto a = bufferA.template Get<T>();
    auto b = bufferB.template Get<T>();
    auto d = bufferD.template Get<T>();
    AscendC::DataCopy(a, gx, CAPACITY);
    AscendC::DataCopy(b, gy, CAPACITY);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    __ubuf__ T* pa = (__ubuf__ T*)a.GetPhyAddr();
    __ubuf__ T* pb = (__ubuf__ T*)b.GetPhyAddr();
    __ubuf__ T* pd = (__ubuf__ T*)d.GetPhyAddr();
    __ubuf__ uint8_t* pm = (__ubuf__ uint8_t*)m.GetPhyAddr();
    for (int mode = 0; mode < 16; ++mode) {
        AscendC::DataCopy(d, gx, CAPACITY);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::Duplicate(m, uint8_t(0xAA), CAPACITY);
        AscendC::PipeBarrier<PIPE_ALL>();
        switch (mode) {
            case 0: Compute<Op>(d, m, a, b, count); break;
            case 1: Compute<Op>(pd, m, a, b, count); break;
            case 2: Compute<Op>(d, pm, a, b, count); break;
            case 3: Compute<Op>(pd, pm, a, b, count); break;
            case 4: Compute<Op>(d, m, pa, b, count); break;
            case 5: Compute<Op>(pd, m, pa, b, count); break;
            case 6: Compute<Op>(d, pm, pa, b, count); break;
            case 7: Compute<Op>(pd, pm, pa, b, count); break;
            case 8: Compute<Op>(d, m, a, pb, count); break;
            case 9: Compute<Op>(pd, m, a, pb, count); break;
            case 10: Compute<Op>(d, pm, a, pb, count); break;
            case 11: Compute<Op>(pd, pm, a, pb, count); break;
            case 12: Compute<Op>(d, m, pa, pb, count); break;
            case 13: Compute<Op>(pd, m, pa, pb, count); break;
            case 14: Compute<Op>(d, pm, pa, pb, count); break;
            case 15: Compute<Op>(pd, pm, pa, pb, count); break;
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(go[mode * CAPACITY], d, CAPACITY);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

bool CheckAcl(aclError status, const char* expression)
{
    if (status == ACL_SUCCESS) { return true; }
    std::fprintf(stderr, "ACL failure %d: %s\n", int(status), expression);
    return false;
}
#define CHECK_ACL(EXPR) do { if (!CheckAcl((EXPR), #EXPR)) { return false; } } while (0)

template <int Op, typename T>
bool Run(const char* name, aclrtStream stream)
{
    std::vector<T> x(CAPACITY), y(CAPACITY), output(16 * CAPACITY);
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        x[i] = T(int(i % 201) - 100);
        y[i] = T(int((7 * i + 3) % 201) - 100);

    }
    void *dx = nullptr, *dy = nullptr, *dout = nullptr;
    CHECK_ACL(aclrtMalloc(&dx, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dy, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dout, sizeof(T) * 16 * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dx, sizeof(T) * CAPACITY, x.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dy, sizeof(T) * CAPACITY, y.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t count : {1u, 32u, 1024u, 2048u}) {
        if constexpr (Op >= 8) { if (count > 64) { continue; } }
        constexpr bool countOnly = true;
        for (int form = 0; form < (countOnly ? 1 : 3); ++form) {
            BinaryPointerKernel<Op, T><<<1, 0, stream>>>((T*)dx, (T*)dy, (T*)dout, count, form);
            CHECK_ACL(aclrtSynchronizeStream(stream));
            CHECK_ACL(aclrtMemcpy(output.data(), sizeof(T) * 16 * CAPACITY, dout,
                                 sizeof(T) * 16 * CAPACITY, ACL_MEMCPY_DEVICE_TO_HOST));
            for (int mode = 0; mode < 16; ++mode) {
                for (uint32_t i = 0; i < CAPACITY; ++i) {
                    bool choose = i % 2 != 0;
                    if constexpr (Op == 0 || Op == 8) { choose = x[i] < y[i]; }
                    if constexpr (Op == 1 || Op == 2) { choose = x[i] < T(2); }
                    T first = x[i], second = y[i];
                    if constexpr (Op == 4) { second = 2; }
                    if constexpr (Op == 5) { first = 2; }
                    if constexpr (Op == 6) { second = y[0]; }
                    if constexpr (Op == 7) { first = x[0]; }
                    T expected = i < count ? (choose ? first : second) : x[i];
                    T value = output[mode*CAPACITY+i];
                    if (value != expected || value != output[i]) {
                        std::fprintf(stderr, "FAIL %s count=%u mode=%d i=%u got=%g expected=%g\n",
                            name, count, mode, i, double(value), double(expected));
                        aclrtFree(dx); aclrtFree(dy); aclrtFree(dout); return false;
                    }
                }
            }
            std::printf("PASS %s count=%u form=0 modes=16 tensor_equal=true tail_unchanged=true\n", name, count);
        }
    }

    CHECK_ACL(aclrtFree(dx));
    CHECK_ACL(aclrtFree(dy));
    CHECK_ACL(aclrtFree(dout));
    return true;
}

bool Execute()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    bool passed = Run<0, float>("Compare", stream) && Run<1, float>("CompareScalar", stream) &&
        Run<2, float>("Compares", stream) && Run<3, float>("Select", stream) &&
        Run<4, float>("SelectScalarRight", stream) && Run<5, float>("SelectScalarLeft", stream) &&
        Run<6, float>("SelectTensorScalarRight", stream) && Run<7, float>("SelectTensorScalarLeft", stream) &&
        Run<8, float>("GetCmpMask", stream) && Run<9, float>("SetCmpMask", stream);
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return passed;
}

int main()
{
    return Execute() ? 0 : 1;
}
