#include "acl/acl.h"
#include "basic_api/kernel_operator_vec_binary_intf.h"
#include "basic_api/kernel_operator_vec_unary_intf.h"
#include "basic_api/kernel_operator_vec_binary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_ternary_scalar_intf.h"
#include "basic_api/kernel_operator_vec_duplicate_intf.h"
#include "basic_api/kernel_operator_vec_reduce_intf.h"
#include "basic_api/kernel_operator_vec_createvecindex_intf.h"
#include "basic_api/kernel_operator_vec_vconv_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <algorithm>
#include <cmath>
#include "basic_api/kernel_operator_vec_transpose_intf.h"
#include <cstring>
#include "basic_api/kernel_operator_limits_intf.h"
#include <cstdint>
#include <cstdio>
#include <vector>
#include <type_traits>

constexpr uint32_t CAPACITY = 2048;

template <typename X>
__aicore__ inline auto Slice(X x, uint32_t offset)
{
    if constexpr (AscendC::VectorOperand::Traits<X>::isPointer) {
        return x + offset;
    } else {
        return x[offset];
    }
}
template <typename Model>
__aicore__ inline auto AddressOperand(AscendC::LocalTensor<uint64_t> x)
{
    if constexpr (AscendC::VectorOperand::Traits<Model>::isPointer) {
        return (__ubuf__ uint64_t*)x.GetPhyAddr();
    } else {
        return x;
    }
}
template <int Op, typename D, typename A, typename B>
__aicore__ inline void Compute(
    D dst, A src, B scratch, AscendC::LocalTensor<uint64_t> da, AscendC::LocalTensor<uint64_t> sa, uint32_t count,
    int form)
{
    if constexpr (Op == 0) {
        for (uint32_t k = 0; k < count; k += 256) {
            AscendC::Transpose(Slice(dst, k), Slice(src, k));
        }
    } else if constexpr (Op == 1) {
        D ds[16];
        A ss[16];
        for (int i = 0; i < 16; ++i) {
            ds[i] = Slice(dst, i * 16);
            ss[i] = Slice(src, i * 16);
        }
        AscendC::TransDataTo5HDParams params{
            false, false, uint8_t(count / 256), uint16_t(count == 256 ? 0 : 16), uint16_t(count == 256 ? 0 : 16)};
        AscendC::TransDataTo5HD(ds, ss, params);
    } else if constexpr (Op == 2) {
        uint64_t ds[16], ss[16];
        for (int i = 0; i < 16; ++i) {
            ds[i] = reinterpret_cast<uint64_t>(AscendC::GetUnderlyingPtr(dst) + i * 16);
            ss[i] = reinterpret_cast<uint64_t>(AscendC::GetUnderlyingPtr(src) + i * 16);
        }
        AscendC::TransDataTo5HDParams params{
            false, false, uint8_t(count / 256), uint16_t(count == 256 ? 0 : 16), uint16_t(count == 256 ? 0 : 16)};
        AscendC::TransDataTo5HD<half>(ds, ss, params);
    } else if constexpr (Op == 4) {
        for (int i = 0; i < 16; ++i) {
            da.SetValue(i, reinterpret_cast<uint64_t>(AscendC::GetUnderlyingPtr(dst) + i * 16));
            sa.SetValue(i, reinterpret_cast<uint64_t>(AscendC::GetUnderlyingPtr(src) + i * 16));
        }
        AscendC::TransDataTo5HDParams params{
            false, false, uint8_t(count / 256), uint16_t(count == 256 ? 0 : 16), uint16_t(count == 256 ? 0 : 16)};
        AscendC::TransDataTo5HD<half>(AddressOperand<D>(da), AddressOperand<A>(sa), params);
    } else {
        AscendC::TransposeParamsExt params{1, 16, 1, uint16_t(count / 16), AscendC::TransposeType::TRANSPOSE_NCHW2NHWC};
        AscendC::Transpose(dst, src, scratch, params);
    }
}

template <int Op, typename T>
__global__ __vector__ void BinaryPointerKernel(__gm__ T* x, __gm__ T* y, __gm__ T* output, uint32_t count, int form)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> gx, gy, go;
    gx.SetGlobalBuffer(x, CAPACITY);
    gy.SetGlobalBuffer(y, CAPACITY);
    go.SetGlobalBuffer(output, 8 * CAPACITY);
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufferA, bufferB, bufferD, addressD, addressS;
    pipe.InitBuffer(bufferA, sizeof(T) * CAPACITY);
    pipe.InitBuffer(bufferB, (16 + 2) * 16 * 16 * sizeof(T)); // Documented NCHW2NHWC workspace.
    pipe.InitBuffer(bufferD, sizeof(T) * CAPACITY);
    pipe.InitBuffer(addressD, 128);
    pipe.InitBuffer(addressS, 128);
    auto da = addressD.template Get<uint64_t>();
    auto sa = addressS.template Get<uint64_t>();
    auto a = bufferA.template Get<T>();
    auto b = bufferB.template Get<uint8_t>();
    auto d = bufferD.template Get<T>();
    AscendC::DataCopy(a, gx, CAPACITY);
    AscendC::Duplicate(b, uint8_t(0), (16 + 2) * 16 * 16 * sizeof(T));
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    __ubuf__ T* pa = (__ubuf__ T*)a.GetPhyAddr();
    __ubuf__ uint8_t* pb = (__ubuf__ uint8_t*)b.GetPhyAddr();
    __ubuf__ T* pd = (__ubuf__ T*)d.GetPhyAddr();
    for (int mode = 0; mode < 8; ++mode) {
        AscendC::DataCopy(d, gx, CAPACITY);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        switch (mode) {
            case 0:
                Compute<Op>(d, a, b, da, sa, count, form);
                break;
            case 1:
                Compute<Op>(pd, a, b, da, sa, count, form);
                break;
            case 2:
                Compute<Op>(d, pa, b, da, sa, count, form);
                break;
            case 3:
                Compute<Op>(d, a, pb, da, sa, count, form);
                break;
            case 4:
                Compute<Op>(pd, pa, b, da, sa, count, form);
                break;
            case 5:
                Compute<Op>(pd, a, pb, da, sa, count, form);
                break;
            case 6:
                Compute<Op>(d, pa, pb, da, sa, count, form);
                break;
            case 7:
                Compute<Op>(pd, pa, pb, da, sa, count, form);
                break;
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(go[mode * CAPACITY], d, CAPACITY);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

bool CheckAcl(aclError status, const char* expression)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL failure %d: %s\n", int(status), expression);
    return false;
}
#define CHECK_ACL(EXPR)                 \
    do {                                \
        if (!CheckAcl((EXPR), #EXPR)) { \
            return false;               \
        }                               \
    } while (0)

template <int Op, typename T>
bool Run(const char* name, aclrtStream stream)
{
    std::vector<T> x(CAPACITY), y(CAPACITY), output(8 * CAPACITY);
    for (uint32_t i = 0; i < CAPACITY; ++i) {
        x[i] = T(int(i % 201) - 100);
        y[i] = T(int((7 * i + 3) % 201) - 100);
    }
    void *dx = nullptr, *dy = nullptr, *dout = nullptr;
    CHECK_ACL(aclrtMalloc(&dx, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dy, sizeof(T) * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&dout, sizeof(T) * 8 * CAPACITY, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dx, sizeof(T) * CAPACITY, x.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dy, sizeof(T) * CAPACITY, y.data(), sizeof(T) * CAPACITY, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t count : {256u, 1024u, 2048u}) {
        for (int form = 0; form < 1; ++form) {
            BinaryPointerKernel<Op, T><<<1, 0, stream>>>((T*)dx, (T*)dy, (T*)dout, count, form);
            CHECK_ACL(aclrtSynchronizeStream(stream));
            CHECK_ACL(aclrtMemcpy(
                output.data(), sizeof(T) * 8 * CAPACITY, dout, sizeof(T) * 8 * CAPACITY, ACL_MEMCPY_DEVICE_TO_HOST));
            for (int mode = 0; mode < 8; ++mode) {
                for (uint32_t i = 0; i < CAPACITY; ++i) {
                    T expected = x[i];
                    if (i < count) {
                        if constexpr (Op == 3) {
                            expected = x[(i % 16) * (count / 16) + i / 16];
                        } else {
                            expected = x[(i / 256) * 256 + (i % 16) * 16 + (i % 256) / 16];
                        }
                    }
                    T value = output[mode * CAPACITY + i];
                    bool hostMatch;
                    if constexpr (std::is_integral<T>::value) {
                        hostMatch = value == expected;
                    } else {
                        hostMatch =
                            std::abs(double(value) - double(expected)) <= 1e-5 + 1e-4 * std::abs(double(expected));
                    }
                    if constexpr (Op >= 48) {
                        hostMatch = std::memcmp(&value, &expected, sizeof(T)) == 0;
                    }
                    if (!hostMatch || (i >= count && value != expected)) {
                        std::fprintf(
                            stderr, "FAIL %s count=%u form=%d mode=%d index=%u got=%g expected=%g\n", name, count, form,
                            mode, i, double(value), double(expected));
                        aclrtFree(dx);
                        aclrtFree(dy);
                        aclrtFree(dout);
                        return false;
                    }
                    if (std::memcmp(&value, &output[i], sizeof(T)) != 0) {
                        std::fprintf(stderr, "Tensor/pointer mismatch in %s\n", name);
                        aclrtFree(dx);
                        aclrtFree(dy);
                        aclrtFree(dout);
                        return false;
                    }
                }
            }
            std::printf("PASS %s count=%u form=%d modes=8 tensor_equal=true tail_unchanged=true\n", name, count, form);
        }
    }
    CHECK_ACL(aclrtFree(dx));
    CHECK_ACL(aclrtFree(dy));
    CHECK_ACL(aclrtFree(dout));
    return true;
}

bool Execute()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    bool passed = Run<0, half>("Transpose", stream);
    passed = Run<1, half>("TransDataTo5HDArray", stream) && passed;
    passed = Run<2, half>("TransDataTo5HDAddressArray", stream) && passed;
    passed = Run<3, half>("TransposeExtended", stream) && passed;
    passed = Run<4, half>("TransDataTo5HD", stream) && passed;
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return passed;
}

int main() { return Execute() ? 0 : 1; }
