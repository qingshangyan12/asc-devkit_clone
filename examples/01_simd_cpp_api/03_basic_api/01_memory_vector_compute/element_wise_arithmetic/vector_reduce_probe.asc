// Minimal Tensor-only control for investigating ReduceSum runtime failures.
#include "acl/acl.h"
#include "basic_api/kernel_operator_vec_reduce_intf.h"
#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_tpipe.h"
#include <cstdio>
#include <vector>

__global__ __vector__ void ReduceProbe(__gm__ float* input, __gm__ float* output, uint32_t count)
{
    using namespace AscendC;
    InitSocState();
    GlobalTensor<float> x, y;
    x.SetGlobalBuffer(input, 2048);
    y.SetGlobalBuffer(output, 2048);
#ifdef VECTOR_PROBE_TPIPE
    TPipe pipe;
    TBuf<TPosition::VECCALC> a, b, c;
    pipe.InitBuffer(a, 8192);
    pipe.InitBuffer(b, 8192);
    pipe.InitBuffer(c, 8192);
    auto src = a.Get<float>();
    auto dst = b.Get<float>();
    auto tmp = c.Get<float>();
#else
    LocalMemAllocator<Hardware::UB> allocator;
    auto src = allocator.Alloc<float, 2048>();
    auto dst = allocator.Alloc<float, 2048>();
    auto tmp = allocator.Alloc<float, 2048>();
#endif
    DataCopy(src, x, 2048);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    ReduceSum(dst, src, tmp, int32_t(count));
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(y, dst, 8);
    PipeBarrier<PIPE_ALL>();
}

#define ACL_CHECK(call) do { auto status = (call); if (status != ACL_SUCCESS) { \
    std::fprintf(stderr, "ACL failure %d: %s\n", int(status), #call); return 1; } } while (0)
int main()
{
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream;
    ACL_CHECK(aclrtCreateStream(&stream));
    void *input, *output;
    ACL_CHECK(aclrtMalloc(&input, 8192, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&output, 8192, ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<float> host(2048, 1.0f);
    ACL_CHECK(aclrtMemcpy(input, 8192, host.data(), 8192, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t count : {1u, 32u, 1024u, 2048u}) {
        std::printf("BEGIN Tensor ReduceSum count=%u\n", count);
        std::fflush(stdout);
        ReduceProbe<<<1, 0, stream>>>((float*)input, (float*)output, count);
        ACL_CHECK(aclrtSynchronizeStream(stream));
        ACL_CHECK(aclrtMemcpy(host.data(), 8192, output, 8192, ACL_MEMCPY_DEVICE_TO_HOST));
        std::printf("RESULT count=%u sum=%g\n", count, double(host[0]));
        if (host[0] != float(count)) { return 2; }
    }
    ACL_CHECK(aclrtFree(input));
    ACL_CHECK(aclrtFree(output));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());
    return 0;
}
