/* !
 * \file floor_mod.asc
 * \brief int32_t floor_mod with multiple implementation modes selected by SCENARIO_NUM:
 *        SCENARIO_NUM=0: pure SIMT direct GM access (no GM<->UB DataCopy)
 *        SCENARIO_NUM=1: SIMD
 *        SCENARIO_NUM=2: SIMT non-contiguous access
 *        SCENARIO_NUM=3: SIMT contiguous access
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;
namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t BLOCK_DIM = 64;
constexpr uint32_t TOTAL_LENGTH = 8192 * 8192;
constexpr uint32_t DATA_LEN_PER_CORE = TOTAL_LENGTH / BLOCK_DIM;
constexpr uint32_t TILE_LENGTH = 8192;
constexpr uint32_t TILE_NUM_PER_CORE = DATA_LEN_PER_CORE / TILE_LENGTH;
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TENSOR_NUM_PER_BUFFER = 3;
constexpr uint32_t UB_SIZE_BYTES = 256 * 1024;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DCACHE_BYTES = 32 * 1024;
constexpr uint32_t MAX_DYNAMIC_UB_BYTES = UB_SIZE_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DCACHE_BYTES;
constexpr uint32_t VECTOR_LENGTH = 256U; // 256: Reg length
constexpr uint32_t FMOD_B32_SIGN = 0x80000000;
} // namespace

// =====================================================================
// SCENARIO_NUM=0: Pure SIMT direct GM access
// =====================================================================
template <typename T>
__simt_vf__ inline void floor_mod_simt_gm_contiguous(
    __gm__ T* self, __gm__ T* other, __gm__ T* out, uint32_t input_total_length)
{
    for (uint32_t index = static_cast<uint32_t>(threadIdx.x); index < input_total_length;
         index += static_cast<uint32_t>(blockDim.x)) {
        T otherValue = other[index];
        const auto rem = self[index] % otherValue;
        bool signs_differ = ((rem < 0) != (otherValue < 0));
        if (signs_differ && (rem != 0)) {
            out[index] = rem + otherValue;
        } else {
            out[index] = rem;
        }
    }
}

// =====================================================================
// SCENARIO_NUM=1: SIMD implementation (self-contained Div + zero protection)
// =====================================================================
template <typename T>
__simd_vf__ inline void floor_mod_int_simd(
    __ubuf__ T* dstAddr, __ubuf__ T* input1Addr, __ubuf__ T* input2Addr, const uint32_t count)
{
    uint32_t vecLen = VECTOR_LENGTH / sizeof(T);
    uint16_t loopTimes = (count + vecLen - 1) / vecLen;

    AscendC::Reg::RegTensor<T> zeroValue;
    AscendC::Reg::RegTensor<T> defaultValue;
    AscendC::Reg::RegTensor<T> signValue;
    AscendC::Reg::RegTensor<T> input1Value;
    AscendC::Reg::RegTensor<T> input2Value;
    AscendC::Reg::RegTensor<T> divValue;
    AscendC::Reg::RegTensor<T> mulValue;
    AscendC::Reg::RegTensor<T> subValue;
    AscendC::Reg::RegTensor<T> modValue;
    AscendC::Reg::RegTensor<T> modSignValue;
    AscendC::Reg::RegTensor<T> addValue;
    AscendC::Reg::RegTensor<T> input2SignValue;
    AscendC::Reg::RegTensor<T> resValue;

    AscendC::Reg::MaskReg preg;
    AscendC::Reg::MaskReg cmpValue;
    AscendC::Reg::MaskReg negValue;
    AscendC::Reg::MaskReg signNegValue;
    AscendC::Reg::MaskReg resMaskValue;
    uint32_t sregMask = count;

    AscendC::Reg::Duplicate(zeroValue, T(0));
    AscendC::Reg::Duplicate(defaultValue, T(-1));
    AscendC::Reg::Duplicate(signValue, FMOD_B32_SIGN);

    for (uint16_t j = 0; j < loopTimes; j++) {
        preg = AscendC::Reg::UpdateMask<T>(sregMask);
        AscendC::Reg::DataCopy<T, AscendC::Reg::LoadDist::DIST_NORM>(input1Value, input1Addr + vecLen * j);
        AscendC::Reg::DataCopy<T, AscendC::Reg::LoadDist::DIST_NORM>(input2Value, input2Addr + vecLen * j);

        // int32_t SIMD computes trunc division inside VF, then builds rem = self - other * div.
        AscendC::Reg::Div(divValue, input1Value, input2Value, preg);
        AscendC::Reg::Mul(mulValue, input2Value, divValue, preg);
        AscendC::Reg::Sub(subValue, input1Value, mulValue, preg);

        // Divide-by-zero protection: when input2 == 0, result is -1.
        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(cmpValue, input2Value, zeroValue, preg);
        AscendC::Reg::Select(modValue, subValue, defaultValue, cmpValue);

        // Adjust trunc remainder to floor_mod.
        AscendC::Reg::Add(addValue, modValue, input2Value, preg);
        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(negValue, modValue, zeroValue, preg);
        AscendC::Reg::And(input2SignValue, input2Value, signValue, preg);
        AscendC::Reg::And(modSignValue, modValue, signValue, preg);
        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(signNegValue, modSignValue, input2SignValue, preg);
        AscendC::Reg::MaskAnd(resMaskValue, signNegValue, negValue, preg);
        AscendC::Reg::Select(resValue, addValue, modValue, resMaskValue);
        AscendC::Reg::DataCopy<T, AscendC::Reg::StoreDist::DIST_NORM>(dstAddr + vecLen * j, resValue, preg);
    }
}

// =====================================================================
// SCENARIO_NUM=2: SIMT non-contiguous access
// =====================================================================
template <typename T>
__simt_vf__ inline void floor_mod_simt_non_contiguous(
    __ubuf__ T* self, __ubuf__ T* other, __ubuf__ T* out, uint32_t input_total_length)
{
    constexpr uint32_t elems_per_thread = TILE_LENGTH / THREAD_COUNT;
    uint32_t tid = threadIdx.x;
    for (uint32_t i = 0; i < elems_per_thread; i++) {
        uint32_t index = tid * elems_per_thread + i;
        if (index >= input_total_length)
            break;
        T otherValue = other[index];
        auto rem = self[index] % otherValue;
        bool signs_differ = ((rem < 0) != (otherValue < 0));
        if (signs_differ && (rem != 0)) {
            out[index] = rem + otherValue;
        } else {
            out[index] = rem;
        }
    }
}

// =====================================================================
// SCENARIO_NUM=3: SIMT contiguous access
// =====================================================================
template <typename T>
__simt_vf__ inline void floor_mod_simt_contiguous(
    __ubuf__ T* self, __ubuf__ T* other, __ubuf__ T* out, uint32_t input_total_length)
{
    for (uint32_t index = static_cast<uint32_t>(threadIdx.x); index < input_total_length;
         index += static_cast<uint32_t>(blockDim.x)) {
        T otherValue = other[index];
        const auto rem = self[index] % otherValue;
        bool signs_differ = ((rem < 0) != (otherValue < 0));
        if (signs_differ && (rem != 0)) {
            out[index] = rem + otherValue;
        } else {
            out[index] = rem;
        }
    }
}

// =====================================================================
// Kernel class (shared by all scenarios)
// =====================================================================
template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* out, uint32_t total_count)
    {
        this->selfGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(self) + AscendC::GetBlockIdx() * DATA_LEN_PER_CORE);
        this->otherGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(other) + AscendC::GetBlockIdx() * DATA_LEN_PER_CORE);
        this->outGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(out) + AscendC::GetBlockIdx() * DATA_LEN_PER_CORE);
        this->selfGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
        this->otherGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);

        if constexpr (scenarioNum != 0) {
            selfPing = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, SELF_PING_OFFSET, count_per_tile);
            otherPing = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OTHER_PING_OFFSET, count_per_tile);
            outPing = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OUT_PING_OFFSET, count_per_tile);
            selfPong = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, SELF_PONG_OFFSET, count_per_tile);
            otherPong = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OTHER_PONG_OFFSET, count_per_tile);
            outPong = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OUT_PONG_OFFSET, count_per_tile);
        }
    }

    __aicore__ inline void CopyIn(
        uint32_t tileIdx, uint32_t count, AscendC::LocalTensor<T>& selfLocal, AscendC::LocalTensor<T>& otherLocal)
    {
        uint32_t tileOffset = tileIdx * count_per_tile;
        AscendC::DataCopy(selfLocal, selfGm[tileOffset], count);
        AscendC::DataCopy(otherLocal, otherGm[tileOffset], count);
    }

    __aicore__ inline void Compute(
        uint32_t count, AscendC::LocalTensor<T>& selfLocal, AscendC::LocalTensor<T>& otherLocal,
        AscendC::LocalTensor<T>& outLocal)
    {
        __ubuf__ T* input1Addr = (__ubuf__ T*)selfLocal.GetPhyAddr();
        __ubuf__ T* input2Addr = (__ubuf__ T*)otherLocal.GetPhyAddr();
        __ubuf__ T* dstAddr = (__ubuf__ T*)outLocal.GetPhyAddr();

        if constexpr (scenarioNum == 1) {
            // ---- SCENARIO 1: int32_t SIMD ----
            asc_vf_call<floor_mod_int_simd<T>>(dstAddr, input1Addr, input2Addr, count);
        } else if constexpr (scenarioNum == 2) {
            // ---- SCENARIO 2: int32_t SIMT non-contiguous access ----
            asc_vf_call<floor_mod_simt_non_contiguous<T>>(dim3(THREAD_COUNT), input1Addr, input2Addr, dstAddr, count);
            // SIMT writes UB directly; wait for those UB accesses before MTE3 reads or buffers are reused.
            AscendC::DataSyncBarrier<AscendC::MemDsbT::UB>();
        } else if constexpr (scenarioNum == 3) {
            // ---- SCENARIO 3: int32_t SIMT contiguous access ----
            asc_vf_call<floor_mod_simt_contiguous<T>>(dim3(THREAD_COUNT), input1Addr, input2Addr, dstAddr, count);
            // SIMT writes UB directly; wait for those UB accesses before MTE3 reads or buffers are reused.
            AscendC::DataSyncBarrier<AscendC::MemDsbT::UB>();
        }
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t count, AscendC::LocalTensor<T>& outLocal)
    {
        uint32_t tileOffset = tileIdx * count_per_tile;
        AscendC::DataCopy(outGm[tileOffset], outLocal, count);
    }

    __aicore__ inline void Process()
    {
        if constexpr (scenarioNum == 0) {
            ProcessGmSimt();
            return;
        }

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);

        // --- Full tiles (count_per_tile elements each) ---
        for (uint32_t tileIdx = 0; tileIdx < TILE_NUM_PER_CORE; ++tileIdx) {
            int32_t eventId = ((tileIdx & 1) == 0 ? EVENT_ID0 : EVENT_ID1);
            AscendC::LocalTensor<T>& selfLocal = ((tileIdx & 1) == 0 ? selfPing : selfPong);
            AscendC::LocalTensor<T>& otherLocal = ((tileIdx & 1) == 0 ? otherPing : otherPong);
            AscendC::LocalTensor<T>& outLocal = ((tileIdx & 1) == 0 ? outPing : outPong);

            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(eventId);
            CopyIn(tileIdx, count_per_tile, selfLocal, otherLocal);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventId);

            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(eventId);
            Compute(count_per_tile, selfLocal, otherLocal, outLocal);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(eventId);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventId);
            CopyOut(tileIdx, count_per_tile, outLocal);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(eventId);
        }

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
    }

    __aicore__ inline void ProcessGmSimt()
    {
        asc_vf_call<floor_mod_simt_gm_contiguous<T>>(
            dim3(THREAD_COUNT), const_cast<__gm__ T*>(selfGm.GetPhyAddr()), const_cast<__gm__ T*>(otherGm.GetPhyAddr()),
            const_cast<__gm__ T*>(outGm.GetPhyAddr()), DATA_LEN_PER_CORE);
    }

private:
    static constexpr uint64_t SELF_PING_OFFSET = 0;
    static constexpr uint64_t OTHER_PING_OFFSET = TILE_LENGTH * sizeof(T);
    static constexpr uint64_t OUT_PING_OFFSET = 2 * TILE_LENGTH * sizeof(T);
    static constexpr uint64_t SELF_PONG_OFFSET = 3 * TILE_LENGTH * sizeof(T);
    static constexpr uint64_t OTHER_PONG_OFFSET = 4 * TILE_LENGTH * sizeof(T);
    static constexpr uint64_t OUT_PONG_OFFSET = 5 * TILE_LENGTH * sizeof(T);
    uint32_t count_per_tile = TILE_LENGTH;
    uint32_t tile_num_per_core = TILE_NUM_PER_CORE;
    AscendC::GlobalTensor<T> selfGm;
    AscendC::GlobalTensor<T> otherGm;
    AscendC::GlobalTensor<T> outGm;
    AscendC::LocalTensor<T> selfPing;
    AscendC::LocalTensor<T> otherPing;
    AscendC::LocalTensor<T> outPing;
    AscendC::LocalTensor<T> selfPong;
    AscendC::LocalTensor<T> otherPong;
    AscendC::LocalTensor<T> outPong;
};

template <typename T>
__global__ __vector__ void floor_mod(
    __gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* output, uint32_t total_count)
{
    AscendC::InitSocState();
    Kernel<T> kernel;
    kernel.Init(self, other, output, total_count);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    using T = int32_t;
    constexpr uint32_t input_total_length = TOTAL_LENGTH; // 8192 * 8192 elements
    // Reserve the dynamic UB region used by the static LocalTensor addresses in this SIMD/SIMT mixed kernel.
    constexpr uint32_t dynUBufSize =
        (scenarioNum == 0) ? 0 : TILE_LENGTH * sizeof(T) * TENSOR_NUM_PER_BUFFER * BUFFER_NUM;
    static_assert(dynUBufSize <= MAX_DYNAMIC_UB_BYTES, "Double buffer UB usage exceeds SIMD/SIMT mixed limit.");
    constexpr uint32_t numBlocks = BLOCK_DIM; // 64 cores
    size_t inputByteSize = input_total_length * sizeof(T);
    size_t outputByteSize = input_total_length * sizeof(T);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* selfHost = nullptr;
    uint8_t* otherHost = nullptr;
    uint8_t* outputHost = nullptr;
    uint8_t* selfDevice = nullptr;
    uint8_t* otherDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    aclrtMallocHost((void**)(&selfHost), inputByteSize);
    aclrtMalloc((void**)&selfDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_self.bin", inputByteSize, selfHost, inputByteSize);
    aclrtMemcpy(selfDevice, inputByteSize, selfHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMallocHost((void**)(&otherHost), inputByteSize);
    aclrtMalloc((void**)&otherDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_other.bin", inputByteSize, otherHost, inputByteSize);
    aclrtMemcpy(otherDevice, inputByteSize, otherHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMallocHost((void**)(&outputHost), outputByteSize);
    aclrtMalloc((void**)&outputDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    floor_mod<T><<<numBlocks, dynUBufSize, stream>>>(selfDevice, otherDevice, outputDevice, input_total_length);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, outputByteSize);

    aclrtFree(selfDevice);
    aclrtFreeHost(selfHost);
    aclrtFree(otherDevice);
    aclrtFreeHost(otherHost);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
