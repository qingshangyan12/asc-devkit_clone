/* !
 * \file floor_mod.asc
 * \brief int32_t floor_mod with multiple implementation modes selected by SCENARIO_NUM:
 *        SCENARIO_NUM=0: pure SIMT direct GM access (no GM<->UB DataCopy)
 *        SCENARIO_NUM=1: SIMD
 *        SCENARIO_NUM=2: SIMT non-contiguous access
 *        SCENARIO_NUM=3: SIMT contiguous access
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;
namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TENSOR_NUM_PER_BUFFER = 3;
constexpr uint32_t UB_SIZE_BYTES = 256 * 1024;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DCACHE_BYTES = 32 * 1024;
constexpr uint32_t MAX_DYNAMIC_UB_BYTES = UB_SIZE_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DCACHE_BYTES;
constexpr uint32_t FMOD_B32_SIGN = 0x80000000;
} // namespace

// =====================================================================
// SCENARIO_NUM=0: Pure SIMT direct GM access
// =====================================================================
template <typename T>
__simt_vf__ inline void floor_mod_simt_gm_contiguous(
    __gm__ T* self, __gm__ T* other, __gm__ T* out, uint32_t input_total_length)
{
    for (uint32_t index = static_cast<uint32_t>(threadIdx.x); index < input_total_length;
         index += static_cast<uint32_t>(blockDim.x)) {
        T otherValue = other[index];
        const auto rem = self[index] % otherValue;
        bool signs_differ = ((rem < 0) != (otherValue < 0));
        if (signs_differ && (rem != 0)) {
            out[index] = rem + otherValue;
        } else {
            out[index] = rem;
        }
    }
}

// =====================================================================
// SCENARIO_NUM=1: SIMD implementation (self-contained Div + zero protection)
// =====================================================================
template <typename T>
__simd_vf__ inline void floor_mod_simd(
    __ubuf__ T* dstAddr, __ubuf__ T* input1Addr, __ubuf__ T* input2Addr, const uint32_t count)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
    uint16_t loopTimes = AscendC::CeilDivision(count, oneRepeatSize);

    AscendC::Reg::RegTensor<T> input1Value;
    AscendC::Reg::RegTensor<T> input2Value;
    AscendC::Reg::RegTensor<T> modValue;
    AscendC::Reg::RegTensor<T> tempValue;
    AscendC::Reg::RegTensor<T> defaultValue;
    AscendC::Reg::RegTensor<T> signValue;

    AscendC::Reg::MaskReg mask;
    AscendC::Reg::MaskReg selectMask;
    AscendC::Reg::MaskReg adjustMask;
    uint32_t maskCount = count;

    AscendC::Reg::Duplicate(defaultValue, T(-1));
    AscendC::Reg::Duplicate(signValue, FMOD_B32_SIGN);

    for (uint16_t i = 0; i < loopTimes; i++) {
        mask = AscendC::Reg::UpdateMask<T>(maskCount);
        AscendC::Reg::LoadAlign(input1Value, input1Addr + i * oneRepeatSize);
        AscendC::Reg::LoadAlign(input2Value, input2Addr + i * oneRepeatSize);

        // int32_t SIMD computes trunc division inside VF, then builds rem = self - other * div.
        AscendC::Reg::Div(tempValue, input1Value, input2Value, mask);
        AscendC::Reg::Mul(tempValue, input2Value, tempValue, mask);
        AscendC::Reg::Sub(modValue, input1Value, tempValue, mask);

        // Divide-by-zero protection: when input2 == 0, result is -1.
        AscendC::Reg::Compares<T, AscendC::CMPMODE::NE>(selectMask, input2Value, T(0), mask);
        AscendC::Reg::Select(tempValue, modValue, defaultValue, selectMask);

        // Adjust trunc remainder to floor_mod.
        AscendC::Reg::Add(modValue, tempValue, input2Value, mask);
        AscendC::Reg::Compares<T, AscendC::CMPMODE::NE>(adjustMask, tempValue, T(0), mask);
        AscendC::Reg::And(input1Value, tempValue, signValue, mask);
        AscendC::Reg::And(input2Value, input2Value, signValue, mask);
        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(selectMask, input1Value, input2Value, mask);
        AscendC::Reg::MaskAnd(adjustMask, selectMask, adjustMask, mask);
        AscendC::Reg::Select(modValue, modValue, tempValue, adjustMask);
        AscendC::Reg::StoreAlign(dstAddr + i * oneRepeatSize, modValue, mask);
    }
}

// =====================================================================
// SCENARIO_NUM=2: SIMT non-contiguous access
// =====================================================================
template <typename T, uint32_t TileLength>
__simt_vf__ inline void floor_mod_simt_non_contiguous(
    __ubuf__ T* self, __ubuf__ T* other, __ubuf__ T* out, uint32_t input_total_length)
{
    constexpr uint32_t elems_per_thread = TileLength / THREAD_COUNT;
    uint32_t tid = threadIdx.x;
    for (uint32_t i = 0; i < elems_per_thread; i++) {
        uint32_t index = tid * elems_per_thread + i;
        if (index >= input_total_length)
            break;
        T otherValue = other[index];
        auto rem = self[index] % otherValue;
        bool signs_differ = ((rem < 0) != (otherValue < 0));
        if (signs_differ && (rem != 0)) {
            out[index] = rem + otherValue;
        } else {
            out[index] = rem;
        }
    }
}

// =====================================================================
// SCENARIO_NUM=3: SIMT contiguous access
// =====================================================================
template <typename T>
__simt_vf__ inline void floor_mod_simt_contiguous(
    __ubuf__ T* self, __ubuf__ T* other, __ubuf__ T* out, uint32_t input_total_length)
{
    for (uint32_t index = static_cast<uint32_t>(threadIdx.x); index < input_total_length;
         index += static_cast<uint32_t>(blockDim.x)) {
        T otherValue = other[index];
        const auto rem = self[index] % otherValue;
        bool signs_differ = ((rem < 0) != (otherValue < 0));
        if (signs_differ && (rem != 0)) {
            out[index] = rem + otherValue;
        } else {
            out[index] = rem;
        }
    }
}

// =====================================================================
// Kernel class for SCENARIO_NUM=0
// =====================================================================
template <typename T, uint32_t DataLenPerCore>
class KernelGmSimt {
public:
    __aicore__ inline void Init(__gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* out)
    {
        this->selfGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(self) + AscendC::GetBlockIdx() * DataLenPerCore);
        this->otherGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(other) + AscendC::GetBlockIdx() * DataLenPerCore);
        this->outGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(out) + AscendC::GetBlockIdx() * DataLenPerCore);
        this->selfGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
        this->otherGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    }

    __aicore__ inline void ProcessGmSimt()
    {
        asc_vf_call<floor_mod_simt_gm_contiguous<T>>(
            dim3(THREAD_COUNT), const_cast<__gm__ T*>(selfGm.GetPhyAddr()), const_cast<__gm__ T*>(otherGm.GetPhyAddr()),
            const_cast<__gm__ T*>(outGm.GetPhyAddr()), DataLenPerCore);
    }

private:
    AscendC::GlobalTensor<T> selfGm;
    AscendC::GlobalTensor<T> otherGm;
    AscendC::GlobalTensor<T> outGm;
};

// =====================================================================
// Shared GM<->UB tiling pipeline for SCENARIO_NUM=1/2/3
// =====================================================================
template <typename T, typename Derived, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
class KernelUbBase {
public:
    __aicore__ inline void Init(__gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* out)
    {
        this->selfGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(self) + AscendC::GetBlockIdx() * DataLenPerCore);
        this->otherGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(other) + AscendC::GetBlockIdx() * DataLenPerCore);
        this->outGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(out) + AscendC::GetBlockIdx() * DataLenPerCore);
        this->selfGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
        this->otherGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);

        selfPing = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, SELF_PING_OFFSET, TileLength);
        otherPing = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OTHER_PING_OFFSET, TileLength);
        outPing = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OUT_PING_OFFSET, TileLength);
        selfPong = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, SELF_PONG_OFFSET, TileLength);
        otherPong = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OTHER_PONG_OFFSET, TileLength);
        outPong = AscendC::LocalTensor<T>(AscendC::TPosition::VECCALC, OUT_PONG_OFFSET, TileLength);
    }

    __aicore__ inline void ProcessTiles()
    {
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);

        for (uint32_t tileIdx = 0; tileIdx < TileNumPerCore; ++tileIdx) {
            int32_t eventId = ((tileIdx & 1) == 0 ? EVENT_ID0 : EVENT_ID1);
            AscendC::LocalTensor<T>& selfLocal = ((tileIdx & 1) == 0 ? selfPing : selfPong);
            AscendC::LocalTensor<T>& otherLocal = ((tileIdx & 1) == 0 ? otherPing : otherPong);
            AscendC::LocalTensor<T>& outLocal = ((tileIdx & 1) == 0 ? outPing : outPong);

            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(eventId);
            CopyIn(tileIdx, TileLength, selfLocal, otherLocal);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventId);

            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(eventId);
            static_cast<Derived*>(this)->Compute(TileLength, selfLocal, otherLocal, outLocal);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(eventId);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventId);
            CopyOut(tileIdx, TileLength, outLocal);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(eventId);
        }

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
    }

protected:
    __aicore__ inline void CopyIn(
        uint32_t tileIdx, uint32_t count, AscendC::LocalTensor<T>& selfLocal, AscendC::LocalTensor<T>& otherLocal)
    {
        uint32_t tileOffset = tileIdx * TileLength;
        AscendC::DataCopy(selfLocal, selfGm[tileOffset], count);
        AscendC::DataCopy(otherLocal, otherGm[tileOffset], count);
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t count, AscendC::LocalTensor<T>& outLocal)
    {
        uint32_t tileOffset = tileIdx * TileLength;
        AscendC::DataCopy(outGm[tileOffset], outLocal, count);
    }

private:
    static constexpr uint64_t SELF_PING_OFFSET = 0;
    static constexpr uint64_t OTHER_PING_OFFSET = TileLength * sizeof(T);
    static constexpr uint64_t OUT_PING_OFFSET = 2 * TileLength * sizeof(T);
    static constexpr uint64_t SELF_PONG_OFFSET = 3 * TileLength * sizeof(T);
    static constexpr uint64_t OTHER_PONG_OFFSET = 4 * TileLength * sizeof(T);
    static constexpr uint64_t OUT_PONG_OFFSET = 5 * TileLength * sizeof(T);
    AscendC::GlobalTensor<T> selfGm;
    AscendC::GlobalTensor<T> otherGm;
    AscendC::GlobalTensor<T> outGm;
    AscendC::LocalTensor<T> selfPing;
    AscendC::LocalTensor<T> otherPing;
    AscendC::LocalTensor<T> outPing;
    AscendC::LocalTensor<T> selfPong;
    AscendC::LocalTensor<T> otherPong;
    AscendC::LocalTensor<T> outPong;
};

template <typename T, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
class KernelSimd
    : public KernelUbBase<
          T, KernelSimd<T, DataLenPerCore, TileLength, TileNumPerCore>, DataLenPerCore, TileLength, TileNumPerCore> {
public:
    __aicore__ inline void Compute(
        uint32_t count, AscendC::LocalTensor<T>& selfLocal, AscendC::LocalTensor<T>& otherLocal,
        AscendC::LocalTensor<T>& outLocal)
    {
        __ubuf__ T* input1Addr = (__ubuf__ T*)selfLocal.GetPhyAddr();
        __ubuf__ T* input2Addr = (__ubuf__ T*)otherLocal.GetPhyAddr();
        __ubuf__ T* dstAddr = (__ubuf__ T*)outLocal.GetPhyAddr();

        asc_vf_call<floor_mod_simd<T>>(dstAddr, input1Addr, input2Addr, count);
    }
};

template <typename T, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
class KernelSimtNonContiguous : public KernelUbBase<
                                    T, KernelSimtNonContiguous<T, DataLenPerCore, TileLength, TileNumPerCore>,
                                    DataLenPerCore, TileLength, TileNumPerCore> {
public:
    __aicore__ inline void Compute(
        uint32_t count, AscendC::LocalTensor<T>& selfLocal, AscendC::LocalTensor<T>& otherLocal,
        AscendC::LocalTensor<T>& outLocal)
    {
        __ubuf__ T* input1Addr = (__ubuf__ T*)selfLocal.GetPhyAddr();
        __ubuf__ T* input2Addr = (__ubuf__ T*)otherLocal.GetPhyAddr();
        __ubuf__ T* dstAddr = (__ubuf__ T*)outLocal.GetPhyAddr();

        asc_vf_call<floor_mod_simt_non_contiguous<T, TileLength>>(
            dim3(THREAD_COUNT), input1Addr, input2Addr, dstAddr, count);
        // SIMT writes UB directly; wait for those UB accesses before MTE3 reads or buffers are reused.
        AscendC::DataSyncBarrier<AscendC::MemDsbT::UB>();
    }
};

template <typename T, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
class KernelSimtContiguous : public KernelUbBase<
                                 T, KernelSimtContiguous<T, DataLenPerCore, TileLength, TileNumPerCore>, DataLenPerCore,
                                 TileLength, TileNumPerCore> {
public:
    __aicore__ inline void Compute(
        uint32_t count, AscendC::LocalTensor<T>& selfLocal, AscendC::LocalTensor<T>& otherLocal,
        AscendC::LocalTensor<T>& outLocal)
    {
        __ubuf__ T* input1Addr = (__ubuf__ T*)selfLocal.GetPhyAddr();
        __ubuf__ T* input2Addr = (__ubuf__ T*)otherLocal.GetPhyAddr();
        __ubuf__ T* dstAddr = (__ubuf__ T*)outLocal.GetPhyAddr();

        asc_vf_call<floor_mod_simt_contiguous<T>>(dim3(THREAD_COUNT), input1Addr, input2Addr, dstAddr, count);
        // SIMT writes UB directly; wait for those UB accesses before MTE3 reads or buffers are reused.
        AscendC::DataSyncBarrier<AscendC::MemDsbT::UB>();
    }
};

template <typename T, uint32_t DataLenPerCore>
__global__ __vector__ void floor_mod_gm_simt(__gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* output)
{
    AscendC::InitSocState();
    KernelGmSimt<T, DataLenPerCore> kernel;
    kernel.Init(self, other, output);
    kernel.ProcessGmSimt();
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
__global__ __vector__ void floor_mod_simd(__gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* output)
{
    AscendC::InitSocState();
    KernelSimd<T, DataLenPerCore, TileLength, TileNumPerCore> kernel;
    kernel.Init(self, other, output);
    kernel.ProcessTiles();
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
__global__ __vector__ void floor_mod_simt_non_contiguous_kernel(
    __gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* output)
{
    AscendC::InitSocState();
    KernelSimtNonContiguous<T, DataLenPerCore, TileLength, TileNumPerCore> kernel;
    kernel.Init(self, other, output);
    kernel.ProcessTiles();
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <typename T, uint32_t DataLenPerCore, uint32_t TileLength, uint32_t TileNumPerCore>
__global__ __vector__ void floor_mod_simt_contiguous_kernel(
    __gm__ uint8_t* self, __gm__ uint8_t* other, __gm__ uint8_t* output)
{
    AscendC::InitSocState();
    KernelSimtContiguous<T, DataLenPerCore, TileLength, TileNumPerCore> kernel;
    kernel.Init(self, other, output);
    kernel.ProcessTiles();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    using T = int32_t;
    constexpr uint32_t inputShapeH = 8192;
    constexpr uint32_t inputShapeW = 8192;
    constexpr uint32_t inputTotalLength = inputShapeH * inputShapeW;
    constexpr uint32_t blockDim = 64;
    constexpr uint32_t tileLength = 8192;
    constexpr uint32_t dataLenPerCore = inputTotalLength / blockDim;
    constexpr uint32_t tileNumPerCore = dataLenPerCore / tileLength;
    constexpr uint32_t ubKernelDynUBufSize = tileLength * sizeof(T) * TENSOR_NUM_PER_BUFFER * BUFFER_NUM;
    constexpr uint32_t numBlocks = blockDim;
    size_t inputByteSize = inputTotalLength * sizeof(T);
    size_t outputByteSize = inputTotalLength * sizeof(T);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* selfHost = nullptr;
    uint8_t* otherHost = nullptr;
    uint8_t* outputHost = nullptr;
    uint8_t* selfDevice = nullptr;
    uint8_t* otherDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    aclrtMallocHost((void**)(&selfHost), inputByteSize);
    aclrtMalloc((void**)&selfDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_self.bin", inputByteSize, selfHost, inputByteSize);
    aclrtMemcpy(selfDevice, inputByteSize, selfHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMallocHost((void**)(&otherHost), inputByteSize);
    aclrtMalloc((void**)&otherDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_other.bin", inputByteSize, otherHost, inputByteSize);
    aclrtMemcpy(otherDevice, inputByteSize, otherHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMallocHost((void**)(&outputHost), outputByteSize);
    aclrtMalloc((void**)&outputDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    if constexpr (scenarioNum == 0) {
        floor_mod_gm_simt<T, dataLenPerCore><<<numBlocks, 0, stream>>>(selfDevice, otherDevice, outputDevice);
    } else if constexpr (scenarioNum == 1) {
        floor_mod_simd<T, dataLenPerCore, tileLength, tileNumPerCore>
            <<<numBlocks, ubKernelDynUBufSize, stream>>>(selfDevice, otherDevice, outputDevice);
    } else if constexpr (scenarioNum == 2) {
        floor_mod_simt_non_contiguous_kernel<T, dataLenPerCore, tileLength, tileNumPerCore>
            <<<numBlocks, ubKernelDynUBufSize, stream>>>(selfDevice, otherDevice, outputDevice);
    } else {
        floor_mod_simt_contiguous_kernel<T, dataLenPerCore, tileLength, tileNumPerCore>
            <<<numBlocks, ubKernelDynUBufSize, stream>>>(selfDevice, otherDevice, outputDevice);
    }
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, outputByteSize);

    aclrtFree(selfDevice);
    aclrtFreeHost(selfHost);
    aclrtFree(otherDevice);
    aclrtFreeHost(otherHost);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
