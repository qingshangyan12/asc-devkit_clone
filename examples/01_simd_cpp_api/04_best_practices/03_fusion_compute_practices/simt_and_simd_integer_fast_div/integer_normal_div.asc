/*!
 * \file integer_normal_div.asc
 * \brief
 */

#include <iostream>
#include <iterator>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"
#include "tiling/platform/platform_ascendc.h"
#include "utils/debug/asc_time.h"

namespace {
    constexpr uint32_t MAX_THREAD_COUNT = 2048;
    constexpr uint32_t MAX_BLOCK_COUNT = 65535;
    constexpr uint32_t MAX_UB_ELEMENTS = 32768;

    constexpr uint32_t DATA_SIZE = 32768;  // number of input elements
    constexpr uint32_t DIVISOR = 7;       // divisor for normal division
}

__simt_vf__ __launch_bounds__(2048) inline void normal_div_compute(
    __ubuf__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* clock_cycles,
    uint32_t divisor,
    uint32_t total_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;

    if (idx >= total_length) {
        clock_cycles[idx] = 0;
        return;
    }

    uint32_t value = input[idx];

    uint64_t start_clock = clock();
    uint32_t result = value / divisor;
    uint64_t end_clock = clock();

    output[idx] = result;
    clock_cycles[idx] = end_clock - start_clock;
}

__global__ __vector__ void integer_normal_div(
    __gm__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* clock_cycles,
    uint32_t divisor,
    uint32_t total_length,
    uint32_t thread_num_per_block)
{
    __ubuf__ uint32_t input_buf[MAX_UB_ELEMENTS];
    uint32_t blk_length = total_length * sizeof(uint32_t);
    asc_copy_gm2ub_align(input_buf, input, 1, blk_length, 0, 0, false, 0, 0, 0);

    if ASC_IS_AIV {
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    }

    asc_vf_call<normal_div_compute>(dim3(thread_num_per_block), input_buf, output, clock_cycles,
                                 divisor, total_length);
}

bool block_split(uint32_t index_total_length, uint32_t &numBlocks, uint32_t &thread_num_per_block) {
    uint32_t real_core_num = 0;
    const auto& platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformInfoMgr == nullptr) {
        std::cout << "[ERROR] Get platform info failed, please check device status." << std::endl;
        return false;
    }
    real_core_num = platformInfoMgr->GetCoreNumAiv();
    numBlocks = std::min(real_core_num, index_total_length);
    thread_num_per_block = (index_total_length + numBlocks - 1) / numBlocks;
    if (thread_num_per_block > MAX_THREAD_COUNT) {
        thread_num_per_block = MAX_THREAD_COUNT;
        numBlocks = (index_total_length + thread_num_per_block - 1) / thread_num_per_block;
        if (numBlocks > MAX_BLOCK_COUNT) {
            std::cout << "[ERROR] index_total_length: " << index_total_length << " can not be bigger than "
                << MAX_THREAD_COUNT * MAX_BLOCK_COUNT << "." << std::endl;
            return false;
        }
    }
    std::cout << "[INFO] AIV core number: " << real_core_num << std::endl;
    return true;
}

void print_clock_cycles(uint64_t* clock_data, uint32_t num_blocks, uint32_t threads_per_block, uint32_t total_length)
{
    uint32_t total_threads = num_blocks * threads_per_block;

    uint64_t total_sum = 0;
    for (uint32_t i = 0; i < total_threads; i++) {
        total_sum += clock_data[i];
    }
    double overall_avg = static_cast<double>(total_sum) / total_length;
    std::cout << "\n[Total Sum] Total cycle sum of all threads: " << total_sum << std::endl;
    std::cout << "[Overall Average] Overall average cycles of all threads: " << overall_avg << std::endl;
}

std::vector<uint32_t> normaldiv_compute(
    std::vector<uint32_t>& input,
    uint32_t divisor)
{
    uint32_t total_length = input.size();

    if (total_length > MAX_UB_ELEMENTS) {
        std::cout << "[ERROR] total_length " << total_length << " exceeds MAX_UB_ELEMENTS "
                  << MAX_UB_ELEMENTS << std::endl;
        return {};
    }

    uint32_t num_blocks = 0;
    uint32_t thread_num_per_block = 0;
    if (!block_split(total_length, num_blocks, thread_num_per_block)) {
        return {};
    }
    uint32_t total_threads = num_blocks * thread_num_per_block;

    size_t total_byte_size = total_length * sizeof(uint32_t);
    size_t clock_byte_size = total_threads * sizeof(uint64_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* output_host = nullptr;
    uint8_t* clock_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    uint64_t* clock_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMallocHost((void**)(&clock_host), clock_byte_size);
    aclrtMalloc((void**)&input_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&clock_device, clock_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, total_byte_size, input_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t dynUBufSize = 0;

    integer_normal_div<<<num_blocks, dynUBufSize, stream>>>(
        input_device, output_device, clock_device, divisor, total_length, thread_num_per_block);

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(clock_host, clock_byte_size, clock_device, clock_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    uint64_t* clock_data = reinterpret_cast<uint64_t*>(clock_host);
    print_clock_cycles(clock_data, num_blocks, thread_num_per_block, total_length);

    std::vector<uint32_t> output((uint32_t*)output_host, (uint32_t*)(output_host + total_byte_size));

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFree(clock_device);
    aclrtFreeHost(output_host);
    aclrtFreeHost(clock_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

uint32_t verify_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    auto print_tensor = [](std::vector<uint32_t>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<uint32_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

uint32_t random_uint32(uint32_t min, uint32_t max)
{
    static std::mt19937 engine(12345);
    std::uniform_int_distribution<uint32_t> dist(min, max);
    return dist(engine);
}

int32_t main()
{
    uint32_t total_length = DATA_SIZE;
    uint32_t divisor = DIVISOR;

    std::vector<uint32_t> input(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input[i] = random_uint32(1, 1000000);
    }

    std::vector<uint32_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        golden[i] = input[i] / divisor;
    }

    std::vector<uint32_t> output = normaldiv_compute(input, divisor);

    if (output.empty()) {
        return 1;
    }

    return verify_result(output, golden);
}
