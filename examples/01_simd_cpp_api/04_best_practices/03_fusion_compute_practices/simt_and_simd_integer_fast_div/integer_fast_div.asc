/*!
 * \file integer_fast_div.asc
 * \brief
 */

#include <iostream>
#include <iterator>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"
#include "tiling/platform/platform_ascendc.h"
#include "utils/debug/asc_time.h"

namespace {
    constexpr uint32_t THREAD_COUNT = 512;
    constexpr uint32_t MAX_UB_ELEMENTS = 32768;
    constexpr uint32_t BIT_64_LEN = 64;
    constexpr uint8_t BIT_32_LEN = 32;

    constexpr uint32_t DATA_SIZE = 32768;  // number of input elements
    constexpr uint32_t DIVISOR = 7;       // divisor for fast division
}

__aicore__ inline int64_t CountLeadingZero(uint64_t x) {
    return clz(x);
}

__aicore__ inline int64_t GetBitCount1(uint64_t x) {
    return bcnt1(x);
}

__aicore__ inline void calc_magic_shift(
    uint32_t& magic_out,
    uint32_t& shift_out,
    uint32_t divisor)
{
    if (divisor == 0) {
        magic_out = 0;
        shift_out = 0;
        return;
    }

    int64_t pos = BIT_64_LEN - CountLeadingZero(divisor);
    int64_t cnt1 = GetBitCount1(divisor);
    uint32_t shift = (cnt1 == 1) ? (pos - 1) : pos;
    uint32_t magic = (1l << BIT_32_LEN) * ((1l << shift) - divisor) / divisor + 1;

    magic_out = magic;
    shift_out = shift;
}

// per-thread clock timing for fast division cycles
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_fast_div_clock(
    __ubuf__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* clock_cycles,
    uint32_t magic,
    uint32_t shift,
    uint32_t total_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;

    if (idx >= total_length) {
        clock_cycles[idx] = 0;
        return;
    }

    uint32_t value = input[idx];

    uint64_t start_clock = clock();
    uint32_t q = __umulhi(value, magic);
    uint32_t result = (value + q) >> shift;
    uint64_t end_clock = clock();

    output[idx] = result;
    clock_cycles[idx] = end_clock - start_clock;
}

// plain fast division, timed by GetSystemCycle in kernel
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_fast_div(
    __ubuf__ uint32_t* input,
    __gm__ uint32_t* output,
    uint32_t magic,
    uint32_t shift,
    uint32_t total_length)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;

    if (idx >= total_length) {
        return;
    }

    uint32_t value = input[idx];
    uint32_t q = __umulhi(value, magic);
    output[idx] = (value + q) >> shift;
}

// Kernel: measure calc_magic_shift and simt_fast_div VF elapsed cycles via GetSystemCycle
__global__ __vector__ void integer_fast_div(
    __gm__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* vf_cycles,
    uint32_t divisor,
    uint32_t total_length)
{
    uint32_t magic;
    uint32_t shift;
    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t magic_start = AscendC::GetSystemCycle();
    calc_magic_shift(magic, shift, divisor);
    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t magic_end = AscendC::GetSystemCycle();
    if (AscendC::GetBlockIdx() == 0) {
        vf_cycles[0] = magic_end - magic_start;
    }

    __ubuf__ uint32_t input_buf[MAX_UB_ELEMENTS];
    uint32_t blk_length = total_length * sizeof(uint32_t);
    asc_copy_gm2ub_align(input_buf, input, 1, blk_length, 0, 0, false, 0, 0, 0);

    if ASC_IS_AIV {
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t start_cycle = AscendC::GetSystemCycle();
    asc_vf_call<simt_fast_div>(dim3(THREAD_COUNT), input_buf, output, magic, shift, total_length);
    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t end_cycle = AscendC::GetSystemCycle();
    if (AscendC::GetBlockIdx() == 0) {
        vf_cycles[1] = end_cycle - start_cycle;
    }
}

// Kernel: measure per-thread fast division cycles via clock
__global__ __vector__ void integer_fast_div_clock(
    __gm__ uint32_t* input,
    __gm__ uint32_t* output,
    __gm__ uint64_t* clock_cycles,
    uint32_t divisor,
    uint32_t total_length)
{
    uint32_t magic;
    uint32_t shift;
    calc_magic_shift(magic, shift, divisor);

    __ubuf__ uint32_t input_buf[MAX_UB_ELEMENTS];
    uint32_t blk_length = total_length * sizeof(uint32_t);
    asc_copy_gm2ub_align(input_buf, input, 1, blk_length, 0, 0, false, 0, 0, 0);

    if ASC_IS_AIV {
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    }

    asc_vf_call<simt_fast_div_clock>(dim3(THREAD_COUNT), input_buf, output, clock_cycles,
                                magic, shift, total_length);
}

void print_clock_cycles(uint64_t* clock_data, uint32_t num_blocks, uint32_t total_length)
{
    uint32_t total_threads = num_blocks * THREAD_COUNT;

    uint64_t total_sum = 0;
    for (uint32_t i = 0; i < total_threads; i++) {
        total_sum += clock_data[i];
    }
    double overall_avg = static_cast<double>(total_sum) / total_length;
    std::cout << "[Total Sum] Total cycle sum of all threads: " << total_sum << std::endl;
    std::cout << "[Overall Average] Overall average cycles of all threads: " << overall_avg << std::endl;
}

std::vector<uint32_t> fastdiv_compute(
    std::vector<uint32_t>& input,
    uint32_t divisor)
{
    uint32_t total_length = input.size();

    if (total_length > MAX_UB_ELEMENTS) {
        std::cout << "[ERROR] total_length " << total_length << " exceeds MAX_UB_ELEMENTS "
                  << MAX_UB_ELEMENTS << std::endl;
        return {};
    }

    uint32_t num_blocks = (total_length + THREAD_COUNT - 1) / THREAD_COUNT;

    size_t total_byte_size = total_length * sizeof(uint32_t);
    size_t clock_byte_size = num_blocks * THREAD_COUNT * sizeof(uint64_t);
    size_t vf_byte_size = 2 * sizeof(uint64_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* output_host = nullptr;
    uint8_t* clock_host = nullptr;
    uint8_t* vf_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    uint64_t* clock_device = nullptr;
    uint64_t* vf_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&output_host), total_byte_size);
    aclrtMallocHost((void**)(&clock_host), clock_byte_size);
    aclrtMallocHost((void**)(&vf_host), vf_byte_size);
    aclrtMalloc((void**)&input_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&clock_device, clock_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&vf_device, vf_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, total_byte_size, input_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;  // No need to alloc dynamic memory.

    integer_fast_div<<<num_blocks, dyn_ubuf_size, stream>>>(
        input_device, output_device, vf_device, divisor, total_length);
    aclrtSynchronizeStream(stream);

    integer_fast_div_clock<<<num_blocks, dyn_ubuf_size, stream>>>(
        input_device, output_device, clock_device, divisor, total_length);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(clock_host, clock_byte_size, clock_device, clock_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(vf_host, vf_byte_size, vf_device, vf_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    uint64_t* clock_data = reinterpret_cast<uint64_t*>(clock_host);
    uint64_t magic_elapsed = reinterpret_cast<uint64_t*>(vf_host)[0];
    uint64_t vf_elapsed = reinterpret_cast<uint64_t*>(vf_host)[1];
    std::cout << "[INFO] num_blocks: " << num_blocks << ", THREAD_COUNT: " << THREAD_COUNT << std::endl;
    std::cout << "[Magic Cycles] Block 0 calc_magic_shift elapsed cycles: " << magic_elapsed << std::endl;
    std::cout << "[VF Cycles] Block 0 simt_fast_div elapsed cycles: " << vf_elapsed << std::endl;
    print_clock_cycles(clock_data, num_blocks, total_length);

    std::vector<uint32_t> output((uint32_t*)output_host, (uint32_t*)(output_host + total_byte_size));

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFree(clock_device);
    aclrtFree(vf_device);
    aclrtFreeHost(output_host);
    aclrtFreeHost(clock_host);
    aclrtFreeHost(vf_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

uint32_t verify_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    auto print_tensor = [](std::vector<uint32_t>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<uint32_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

uint32_t random_uint32(uint32_t min, uint32_t max)
{
    static std::mt19937 engine(12345);
    std::uniform_int_distribution<uint32_t> dist(min, max);
    return dist(engine);
}

int32_t main()
{
    uint32_t total_length = DATA_SIZE;
    uint32_t divisor = DIVISOR;

    std::vector<uint32_t> input(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input[i] = random_uint32(0, INT32_MAX);
    }

    std::vector<uint32_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        golden[i] = input[i] / divisor;
    }

    std::vector<uint32_t> output = fastdiv_compute(input, divisor);

    if (output.empty()) {
        return 1;
    }

    return verify_result(output, golden);
}
