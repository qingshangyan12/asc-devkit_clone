/**
 * Ascend C SIMT Sobel 算子实现 v2
 *
 * 功能：使用SIMT编程模型实现Sobel边缘检测
 *       sobel_kernel_shared_with_mte 使用 AscendC::DataCopyPad 将数据
 *       批量加载至共享内存（UB），计算部分仍以 SIMT 方式实现。
 *
 * 与 backup.asc 的区别：
 * - sobel_vf_shared_with_mte：接收外层已加载好的 __ubuf__ 指针，
 *   无需在 VF 内逐元素读取 GM，也无需 asc_syncthreads()。
 * - sobel_kernel_shared_with_mte：在调用 asc_vf_call 前，先用
 *   AscendC::DataCopyPad 将 (BLOCK_SIZE+2)x(BLOCK_SIZE+2) 瓦片
 *   从 GM 批量复制到 UB，并用 MTE2_V 事件保证数据就绪。
 */

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "kernel_operator.h"

namespace {

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 2
#error "SCENARIO_NUM must be one of 0, 1, 2."
#endif

constexpr int32_t BLOCK_SIZE = 32;
constexpr int32_t THREAD_COUNT = BLOCK_SIZE * BLOCK_SIZE;
// UB 中每行的实际字节步长：将 BLOCK_SIZE+2=34 向上对齐到 32B → 64
// Normal 模式下 DataCopyPad 每 block 自动补齐到 32B，行起始地址因此始终 32B 对齐
constexpr uint32_t UB_ROW_STRIDE = ((static_cast<uint32_t>(BLOCK_SIZE) + 2U + 31U) / 32U) * 32U;
enum SobelKernelType {
    K_GLOBAL = 0,
    K_SHARED_LD = 1,
    K_SHARED_MTE = 2,
};


uint32_t verify_result(const std::vector<uint8_t> &output, const std::vector<uint8_t> &golden)
{
    if (output.size() != golden.size()) {
        printf("[Failed] Output size mismatch!\n");
        return 1;
    }

    size_t mismatch_count = 0;
    for (size_t i = 0; i < output.size(); ++i) {
        if (output[i] != golden[i]) {
            mismatch_count++;
            if (mismatch_count <= 10) {
                printf("Mismatch at index %zu: output=%u, golden=%u\n",
                       i, output[i], golden[i]);
            }
        }
    }

    if (mismatch_count == 0) {
        printf("[Success] Case accuracy verification passed.\n");
        return 0;
    } else {
        printf("[Failed] %zu mismatches found.\n", mismatch_count);
        return 1;
    }
}

std::vector<uint8_t> compute_golden(const std::vector<uint8_t> &input, int width, int height)
{
    std::vector<uint8_t> output(width * height, 0);

    for (int y = 1; y < height - 1; ++y) {
        for (int x = 1; x < width - 1; ++x) {
            int tl = input[(y-1) * width + (x-1)];
            int tc = input[(y-1) * width + x];
            int tr = input[(y-1) * width + (x+1)];
            int ml = input[y * width + (x-1)];
            int mr = input[y * width + (x+1)];
            int bl = input[(y+1) * width + (x-1)];
            int bc = input[(y+1) * width + x];
            int br = input[(y+1) * width + (x+1)];

            int gx = -tl + tr - 2*ml + 2*mr - bl + br;
            int gy = -tl - 2*tc - tr + bl + 2*bc + br;

            int magnitude = std::min(255, std::abs(gx) + std::abs(gy));
            output[y * width + x] = static_cast<uint8_t>(magnitude);
        }
    }

    return output;
}
}

/**
 * 不使用共享内存的Sobel算子核函数
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) void sobel_vf_global(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height, int32_t gridX)
{
    int32_t blockIdxX = blockIdx.x % gridX;
    int32_t blockIdxY = blockIdx.x / gridX;
    int x = blockIdxX * blockDim.x + threadIdx.x;
    int y = blockIdxY * blockDim.y + threadIdx.y;

    if (x >= width || y >= height) {
        return;
    }
    if (x == 0 || x == width - 1 || y == 0 || y == height - 1) {
        output[y * width + x] = 0;
        return;
    }

    int tl = input[(y-1) * width + (x-1)];
    int tc = input[(y-1) * width + x];
    int tr = input[(y-1) * width + (x+1)];
    int ml = input[y * width + (x-1)];
    int mr = input[y * width + (x+1)];
    int bl = input[(y+1) * width + (x-1)];
    int bc = input[(y+1) * width + x];
    int br = input[(y+1) * width + (x+1)];

    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*tc - tr + bl + 2*bc + br;

    int magnitude = 0;
    if (gx < 0) magnitude -= gx; else magnitude += gx;
    if (gy < 0) magnitude -= gy; else magnitude += gy;
    if (magnitude > 255) magnitude = 255;

    output[y * width + x] = static_cast<uint8_t>(magnitude);
}

__global__ __vector__ void sobel_kernel_global(__gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height, int32_t gridX)
{
    asc_vf_call<sobel_vf_global>(dim3(BLOCK_SIZE, BLOCK_SIZE), input, output, width, height, gridX);
}

/**
 * 使用共享内存 + 逐元素加载（LD方式）的Sobel算子核函数
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) void sobel_vf_shared_with_ld(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height, int32_t gridX)
{
    __ubuf__ uint8_t shared_block[BLOCK_SIZE + 2][BLOCK_SIZE + 2];

    int32_t blockIdxX = blockIdx.x % gridX;
    int32_t blockIdxY = blockIdx.x / gridX;
    int x = blockIdxX * blockDim.x + threadIdx.x;
    int y = blockIdxY * blockDim.y + threadIdx.y;

    int local_x = threadIdx.x + 1;
    int local_y = threadIdx.y + 1;

    if (x < width && y < height) {
        shared_block[local_y][local_x] = input[y * width + x];
    } else {
        shared_block[local_y][local_x] = 0;
    }

    if (threadIdx.y == 0 && y > 0 && x < width) {
        shared_block[0][local_x] = input[(y - 1) * width + x];
    }
    if (threadIdx.y == blockDim.y - 1 && y < height - 1 && x < width) {
        shared_block[BLOCK_SIZE + 1][local_x] = input[(y + 1) * width + x];
    }
    if (threadIdx.x == 0 && x > 0 && y < height) {
        shared_block[local_y][0] = input[y * width + (x - 1)];
    }
    if (threadIdx.x == blockDim.x - 1 && x < width - 1 && y < height) {
        shared_block[local_y][BLOCK_SIZE + 1] = input[y * width + (x + 1)];
    }
    if (threadIdx.x == 0 && threadIdx.y == 0 && x > 0 && y > 0) {
        shared_block[0][0] = input[(y - 1) * width + (x - 1)];
    }
    if (threadIdx.x == blockDim.x - 1 && threadIdx.y == 0 && x < width - 1 && y > 0) {
        shared_block[0][BLOCK_SIZE + 1] = input[(y - 1) * width + (x + 1)];
    }
    if (threadIdx.x == 0 && threadIdx.y == blockDim.y - 1 && x > 0 && y < height - 1) {
        shared_block[BLOCK_SIZE + 1][0] = input[(y + 1) * width + (x - 1)];
    }
    if (threadIdx.x == blockDim.x - 1 && threadIdx.y == blockDim.y - 1 && x < width - 1 && y < height - 1) {
        shared_block[BLOCK_SIZE + 1][BLOCK_SIZE + 1] = input[(y + 1) * width + (x + 1)];
    }

    asc_syncthreads();

    if (x >= width || y >= height) return;
    if (x == 0 || x == width - 1 || y == 0 || y == height - 1) {
        output[y * width + x] = 0;
        return;
    }

    int tl = shared_block[local_y - 1][local_x - 1];
    int tc = shared_block[local_y - 1][local_x];
    int tr = shared_block[local_y - 1][local_x + 1];
    int ml = shared_block[local_y][local_x - 1];
    int mr = shared_block[local_y][local_x + 1];
    int bl = shared_block[local_y + 1][local_x - 1];
    int bc = shared_block[local_y + 1][local_x];
    int br = shared_block[local_y + 1][local_x + 1];

    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*tc - tr + bl + 2*bc + br;

    int magnitude = 0;
    if (gx < 0) magnitude -= gx; else magnitude += gx;
    if (gy < 0) magnitude -= gy; else magnitude += gy;
    if (magnitude > 255) magnitude = 255;

    output[y * width + x] = static_cast<uint8_t>(magnitude);
}

__global__ __vector__ void sobel_kernel_shared_with_ld(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height, int32_t gridX)
{
    asc_vf_call<sobel_vf_shared_with_ld>(dim3(BLOCK_SIZE, BLOCK_SIZE), input, output, width, height, gridX);
}


/**
 * 使用共享内存 + MTE（DataCopyPad）方式加载的Sobel计算VF函数
 *
 * 说明：
 * - 共享内存瓦片由外层 sobel_kernel_shared_with_mte 通过 DataCopyPad 预加载完毕
 * - 进入 VF 时数据已就绪，无需逐元素加载，也无需 asc_syncthreads()
 * - shared_block 为 (BLOCK_SIZE+2)*(BLOCK_SIZE+2) 的 1D 布局，行步长为 BLOCK_SIZE+2
 * - blockIdxX / blockIdxY 由外层直接传入（取自 AscendC::GetBlockIdx()）
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) void sobel_vf_shared_with_mte(
    __ubuf__ uint8_t* shared_block, __gm__ uint8_t* output,
    int width, int height, int32_t blockIdxX, int32_t blockIdxY)
{
    constexpr int32_t STRIDE = static_cast<int32_t>(UB_ROW_STRIDE);  // 64，与 Normal 模式的 UB 行步长一致

    int x = blockIdxX * BLOCK_SIZE + static_cast<int32_t>(threadIdx.x);
    int y = blockIdxY * BLOCK_SIZE + static_cast<int32_t>(threadIdx.y);
    int local_x = static_cast<int32_t>(threadIdx.x) + 1;
    int local_y = static_cast<int32_t>(threadIdx.y) + 1;

    if (x >= width || y >= height) return;

    if (x == 0 || x == width - 1 || y == 0 || y == height - 1) {
        output[y * width + x] = 0;
        return;
    }

    /**
     * 从预加载的共享内存中读取 3x3 邻域（1D 索引，行步长 = BLOCK_SIZE+2）
     *
     * 瓦片坐标与全局坐标映射：
     *   tile 行 local_y-1..local_y+1 对应 全局行 y-1..y+1
     *   tile 列 local_x-1..local_x+1 对应 全局列 x-1..x+1
     */
    int tl = shared_block[(local_y - 1) * STRIDE + (local_x - 1)];
    int tc = shared_block[(local_y - 1) * STRIDE + local_x];
    int tr = shared_block[(local_y - 1) * STRIDE + (local_x + 1)];
    int ml = shared_block[local_y * STRIDE + (local_x - 1)];
    int mr = shared_block[local_y * STRIDE + (local_x + 1)];
    int bl = shared_block[(local_y + 1) * STRIDE + (local_x - 1)];
    int bc = shared_block[(local_y + 1) * STRIDE + local_x];
    int br = shared_block[(local_y + 1) * STRIDE + (local_x + 1)];

    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*tc - tr + bl + 2*bc + br;

    int magnitude = 0;
    if (gx < 0) magnitude -= gx; else magnitude += gx;
    if (gy < 0) magnitude -= gy; else magnitude += gy;
    if (magnitude > 255) magnitude = 255;

    output[y * width + x] = static_cast<uint8_t>(magnitude);
}


/**
 * 使用 DataCopyPad 批量加载共享内存的 Sobel 算子核函数
 *
 * 数据加载流程：
 * 1. 从 GetBlockIdx() 解算当前块的二维坐标 (blockIdxX, blockIdxY)
 * 2. 计算需要加载的全局内存区域（带光晕，共 (BLOCK_SIZE+2)×(BLOCK_SIZE+2) 元素）
 * 3. 处理图像边界：
 *    - 左/右边界：通过 DataCopyPadExtParams.leftPadding / rightPadding 补零
 *    - 上/下边界：跳过不可访问的光晕行（VF 计算时边界像素直接输出 0，不会访问）
 * 4. 调用 DataCopyPad 将有效区域从 GM 批量写入 UB（LocalTensor）
 * 5. SetFlag/WaitFlag(MTE2_V) 确保 DataCopyPad 完成后再启动 VF
 * 6. 将 UB 指针传给 sobel_vf_shared_with_mte，以 SIMT 方式完成 Sobel 计算
 *
 * DataCopyExtParams 参数说明：
 *   blockCount = validRows          有效源行数（扣除上/下超界行）
 *   blockLen   = validCols          每行实际读取的字节数（uint8_t，1B/元素）
 *   srcStride  = width - validCols  源相邻行之间的跳跃字节数
 *   dstStride  = 0                  目标行连续存放（leftPad+validCols+rightPad = BLOCK_SIZE+2）
 *
 * DataCopyPadExtParams 参数说明：
 *   isPad        = (leftPad>0 || rightPad>0)
 *   leftPadding  = leftPad   图像左边界超界时补零元素数（0 或 1）
 *   rightPadding = rightPad  图像右边界超界时补零元素数（0 或多个）
 *   paddingValue = 0
 */
__global__ __vector__ void sobel_kernel_shared_with_mte(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height, int32_t gridX)
{
    uint32_t blockId = AscendC::GetBlockIdx();
    int32_t blockIdxX = static_cast<int32_t>(blockId) % gridX;
    int32_t blockIdxY = static_cast<int32_t>(blockId) / gridX;

    // 瓦片在全局内存中的起始坐标（可能为 -1，表示超出图像左/上边界）
    int32_t srcStartX = blockIdxX * BLOCK_SIZE - 1;
    int32_t srcStartY = blockIdxY * BLOCK_SIZE - 1;

    // 计算各方向的超界补零量
    int32_t leftPad   = (srcStartX < 0) ? 1 : 0;
    int32_t rightPad  = (srcStartX + BLOCK_SIZE + 2 > width)  ? (srcStartX + BLOCK_SIZE + 2 - width)  : 0;
    int32_t topPad    = (srcStartY < 0) ? 1 : 0;
    int32_t bottomPad = (srcStartY + BLOCK_SIZE + 2 > height) ? (srcStartY + BLOCK_SIZE + 2 - height) : 0;

    // 有效源数据的行列数
    int32_t validCols = BLOCK_SIZE + 2 - leftPad - rightPad;
    int32_t validRows = BLOCK_SIZE + 2 - topPad - bottomPad;

    // 有效源数据在全局内存中的起始坐标（已对齐到图像边界）
    int32_t validSrcX = srcStartX + leftPad;
    int32_t validSrcY = srcStartY + topPad;

    // 在 UB 地址 0 处分配共享瓦片
    // 每行占 UB_ROW_STRIDE=64B（Normal 模式将 34B 自动补齐到 32B 的整数倍 64B），
    // 共 BLOCK_SIZE+2=34 行，总计 34*64=2176B（已是 32B 对齐）。
    // 这样 tile[row] 的起始地址 = row * 64，始终满足 32B 对齐要求。
    constexpr uint32_t TILE_ELEMS = static_cast<uint32_t>(BLOCK_SIZE + 2) * UB_ROW_STRIDE;
    AscendC::LocalTensor<uint8_t> sharedTile(AscendC::TPosition::VECCALC, 0, TILE_ELEMS);

    // 绑定全局内存输入
    AscendC::GlobalTensor<uint8_t> inputGm;
    inputGm.SetGlobalBuffer(input);

    // DataCopyPad（Normal 模式，默认）：将有效区域（含左/右边界补零）批量写入 UB
    //
    // 使用 Normal 模式的原因：
    //   Normal 模式下每 block（行）自动补齐到 32B，34B → 64B，
    //   因此 tile[row] 的 UB 偏移 = row * 64，始终满足 LocalTensor 32B 对齐要求。
    //   若用 Compact 模式，tile[1] 偏移为 34B（非 32B 对齐），会触发 MTE 地址未对齐异常。
    //
    // 参数说明：
    //   srcStride 单位字节（源在 GM），= width - validCols（跳过行尾到下行头的间距）
    //   dstStride 单位 dataBlock=32B（目标在 VECIN/VECOUT），= 0（行间无额外间隔，
    //             每行由硬件自动补至 64B，连续排布）
    AscendC::DataCopyExtParams copyParams = {
        static_cast<uint16_t>(validRows),              // blockCount
        static_cast<uint32_t>(validCols),              // blockLen（字节）
        static_cast<uint32_t>(width - validCols),      // srcStride（GM 侧，字节）
        0U,                                             // dstStride（UB 侧，dataBlock，0=行紧跟行）
        0U                                              // rsv
    };
    AscendC::DataCopyPadExtParams<uint8_t> padParams(
        static_cast<bool>(leftPad > 0 || rightPad > 0),
        static_cast<uint8_t>(leftPad),
        static_cast<uint8_t>(rightPad),
        uint8_t(0)
    );

    uint64_t srcOffset = static_cast<uint64_t>(validSrcY) * static_cast<uint64_t>(width) + static_cast<uint64_t>(validSrcX);
    // 目标偏移 topPad * UB_ROW_STRIDE：topPad=0 → 0B；topPad=1 → 64B（32B 对齐）✓
    AscendC::DataCopyPad<uint8_t>(
        sharedTile[topPad * UB_ROW_STRIDE],
        inputGm[srcOffset],
        copyParams,
        padParams
    );

    // 等待 MTE2（DataCopyPad）完成，再启动 VF 读取 UB
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(static_cast<event_t>(0));
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(static_cast<event_t>(0));

    // 将 UB 地址转为 __ubuf__ 指针传给 SIMT VF
    __ubuf__ uint8_t* sharedPtr = reinterpret_cast<__ubuf__ uint8_t*>(sharedTile.GetPhyAddr());
    asc_vf_call<sobel_vf_shared_with_mte>(dim3(BLOCK_SIZE, BLOCK_SIZE),
        sharedPtr, output, width, height, blockIdxX, blockIdxY);
}


std::vector<uint8_t> sobel_filter(const std::vector<uint8_t> &input_host,
                                  int width, int height, int kernelType)
{
    const size_t total_elem = width * height;
    const size_t total_byte_size = total_elem * sizeof(uint8_t);
    std::vector<uint8_t> output_host(total_elem, 0);

    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *input_device = nullptr;
    uint8_t *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void **>(&input_device), total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&output_device), total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, total_byte_size, input_host.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;
    const uint32_t gridX = (width + BLOCK_SIZE - 1) / BLOCK_SIZE;
    const uint32_t gridY = (height + BLOCK_SIZE - 1) / BLOCK_SIZE;
    const uint32_t blockNum = gridX * gridY;

    if (kernelType == K_GLOBAL) {
        sobel_kernel_global<<<blockNum, dyn_ubuf_size, stream>>>(input_device, output_device, width, height, gridX);
    } else if (kernelType == K_SHARED_LD) {
        sobel_kernel_shared_with_ld<<<blockNum, dyn_ubuf_size, stream>>>(input_device, output_device, width, height, gridX);
    } else {
        sobel_kernel_shared_with_mte<<<blockNum, dyn_ubuf_size, stream>>>(input_device, output_device, width, height, gridX);
    }

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host.data(), total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    const char *err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "Error: %s\n", err);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    return output_host;
}

int main(int argc, char **argv)
{
    SobelKernelType kernelType = static_cast<SobelKernelType>(SCENARIO_NUM);

    printf("Running Sobel filter with kernel: %d\n", static_cast<int32_t>(SCENARIO_NUM));

    constexpr int32_t width = 768;
    constexpr int32_t height = 1024;
    const size_t total_elem = width * height;

    std::vector<uint8_t> input(total_elem);
    for (size_t i = 0; i < total_elem; ++i) {
        if (i < total_elem / 2) {
            input[i] = static_cast<uint8_t>(1);
        } else {
            input[i] = static_cast<uint8_t>(2);
        }
    }

    auto golden = compute_golden(input, width, height);
    auto output = sobel_filter(input, width, height, kernelType);

    return verify_result(output, golden);
}
