/**
 * Ascend C SIMT Sobel 算子实现 v4
 *
 * 与 v3 的核心区别：
 * - v3: blockNum = totalTiles（每个block处理1个tile）
 * - v4: blockNum = 64（固定），每个block通过循环处理多个tile
 *   每个 tile 仍是 BLOCK_SIZE×BLOCK_SIZE (32×32) 的搬运 + 30×30 的 Sobel 计算，
 *   但每个 block 在外层 kernel 中循环遍历 tilesPerBlock 个 tile。
 *
 * 设计意图：
 * - 减少block数量（64 vs 910），降低block调度开销
 * - 增加每个block的工作量（多tile循环），提高单block资源利用率
 * - 保持VF维度不变（32×32 threads），VF内部逻辑与v3完全相同
 * - 三种变体（Global/LD/MTE）的差异仍在数据搬运方式，计算逻辑完全一致
 *
 * 数据流：
 * - 每个 block 的外层 kernel 计算自己负责的 tile 范围：
 *   startTileIdx = blockIdx * tilesPerBlock
 *   循环 tilesPerBlock 次，每次处理一个 tile
 * - VF 函数接收 startX/startY 参数（不再从 blockIdx 推算）
 * - MTE 变体在循环中复用同一块 UB，每次 DataCopyPad 后需 MTE2_V 同步，
 *   VF 完成后需 V_MTE2 同步（确保 V 读完成后再写入下一个 tile）
 */

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "kernel_operator.h"

namespace {

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 2
#error "SCENARIO_NUM must be one of 0, 1, 2."
#endif

constexpr int32_t BLOCK_SIZE = 32;
constexpr int32_t COMPUTE_SIZE = BLOCK_SIZE - 2;
constexpr int32_t THREAD_COUNT = BLOCK_SIZE * BLOCK_SIZE;
constexpr uint32_t BLOCK_NUM = 64;

enum SobelKernelType {
    K_GLOBAL = 0,
    K_SHARED_LD = 1,
    K_SHARED_MTE = 2,
};

uint32_t verify_result(const std::vector<uint8_t> &output, const std::vector<uint8_t> &golden)
{
    if (output.size() != golden.size()) {
        printf("[Failed] Output size mismatch!\n");
        return 1;
    }

    size_t mismatch_count = 0;
    for (size_t i = 0; i < output.size(); ++i) {
        if (output[i] != golden[i]) {
            mismatch_count++;
            if (mismatch_count <= 10) {
                printf("Mismatch at index %zu: output=%u, golden=%u\n",
                       i, output[i], golden[i]);
            }
        }
    }

    if (mismatch_count == 0) {
        printf("[Success] Case accuracy verification passed.\n");
        return 0;
    } else {
        printf("[Failed] %zu mismatches found.\n", mismatch_count);
        return 1;
    }
}

std::vector<uint8_t> compute_golden(const std::vector<uint8_t> &input, int width, int height)
{
    std::vector<uint8_t> output = input;

    for (int y = 1; y < height - 1; ++y) {
        for (int x = 1; x < width - 1; ++x) {
            int tl = input[(y-1) * width + (x-1)];
            int tc = input[(y-1) * width + x];
            int tr = input[(y-1) * width + (x+1)];
            int ml = input[y * width + (x-1)];
            int mr = input[y * width + (x+1)];
            int bl = input[(y+1) * width + (x-1)];
            int bc = input[(y+1) * width + x];
            int br = input[(y+1) * width + (x+1)];

            int gx = -tl + tr - 2*ml + 2*mr - bl + br;
            int gy = -tl - 2*tc - tr + bl + 2*bc + br;

            int magnitude = std::min(255, std::abs(gx) + std::abs(gy));
            output[y * width + x] = static_cast<uint8_t>(magnitude);
        }
    }

    return output;
}
}

/**
 * Sobel算子VF函数 —— 直接从GM读取8邻居
 *
 * 与v3的区别：接收 startX/startY 参数而非从 blockIdx 推算。
 * 外层 kernel 在循环中为每个 tile 传入不同的 startX/startY。
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) void sobel_vf_global(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height,
    int32_t startX, int32_t startY)
{
    int32_t x = startX + threadIdx.x;
    int32_t y = startY + threadIdx.y;

    if (threadIdx.x == 0 || threadIdx.x == BLOCK_SIZE - 1 ||
        threadIdx.y == 0 || threadIdx.y == BLOCK_SIZE - 1) return;
    if (x < 1 || x > width - 2 || y < 1 || y > height - 2) return;

    int tl = input[(y-1) * width + (x-1)];
    int tc = input[(y-1) * width + x];
    int tr = input[(y-1) * width + (x+1)];
    int ml = input[y * width + (x-1)];
    int mr = input[y * width + (x+1)];
    int bl = input[(y+1) * width + (x-1)];
    int bc = input[(y+1) * width + x];
    int br = input[(y+1) * width + (x+1)];

    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*tc - tr + bl + 2*bc + br;

    int magnitude = 0;
    if (gx < 0) magnitude -= gx; else magnitude += gx;
    if (gy < 0) magnitude -= gy; else magnitude += gy;
    if (magnitude > 255) magnitude = 255;

    output[y * width + x] = static_cast<uint8_t>(magnitude);
}

/**
 * Global变体外层kernel —— 循环处理多个tile
 *
 * 每个 block 从 startTileIdx 开始，循环 tilesPerBlock 次，
 * 每次为一个 tile 调用一次 sobel_vf_global。
 */
__global__ __vector__ void sobel_kernel_global(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height,
    int32_t totalTilesX, int32_t tilesPerBlock)
{
    uint32_t blockId = AscendC::GetBlockIdx();
    int32_t startTileIdx = static_cast<int32_t>(blockId) * tilesPerBlock;

    for (int32_t t = 0; t < tilesPerBlock; t++) {
        int32_t tileIdx = startTileIdx + t;
        int32_t startX = (tileIdx % totalTilesX) * COMPUTE_SIZE;
        int32_t startY = (tileIdx / totalTilesX) * COMPUTE_SIZE;

        if (startX >= width || startY >= height) break;

        asc_vf_call<sobel_vf_global>(dim3(BLOCK_SIZE, BLOCK_SIZE),
            input, output, width, height, startX, startY);
    }
}

/**
 * Sobel算子VF函数 —— 逐元素加载(LD方式)到UB
 *
 * 与v3逻辑完全相同：每thread搬1像素到shared_block[32][32]，
 * clamp处理越界，asc_syncthreads后30×30计算。
 * 区别仅在于 startX/startY 由参数传入。
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) void sobel_vf_shared_with_ld(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height,
    int32_t startX, int32_t startY)
{
    __ubuf__ uint8_t shared_block[BLOCK_SIZE][BLOCK_SIZE];

    int32_t x = startX + threadIdx.x;
    int32_t y = startY + threadIdx.y;

    int32_t cx = (x < 0) ? 0 : (x >= width) ? width - 1 : x;
    int32_t cy = (y < 0) ? 0 : (y >= height) ? height - 1 : y;
    shared_block[threadIdx.y][threadIdx.x] = input[cy * width + cx];

    asc_syncthreads();

    if (threadIdx.x == 0 || threadIdx.x == BLOCK_SIZE - 1 ||
        threadIdx.y == 0 || threadIdx.y == BLOCK_SIZE - 1) return;
    if (x < 1 || x > width - 2 || y < 1 || y > height - 2) return;

    int tl = shared_block[threadIdx.y - 1][threadIdx.x - 1];
    int tc = shared_block[threadIdx.y - 1][threadIdx.x];
    int tr = shared_block[threadIdx.y - 1][threadIdx.x + 1];
    int ml = shared_block[threadIdx.y][threadIdx.x - 1];
    int mr = shared_block[threadIdx.y][threadIdx.x + 1];
    int bl = shared_block[threadIdx.y + 1][threadIdx.x - 1];
    int bc = shared_block[threadIdx.y + 1][threadIdx.x];
    int br = shared_block[threadIdx.y + 1][threadIdx.x + 1];

    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*tc - tr + bl + 2*bc + br;

    int magnitude = 0;
    if (gx < 0) magnitude -= gx; else magnitude += gx;
    if (gy < 0) magnitude -= gy; else magnitude += gy;
    if (magnitude > 255) magnitude = 255;

    output[y * width + x] = static_cast<uint8_t>(magnitude);
}

/**
 * LD变体外层kernel —— 循环处理多个tile
 *
 * 每个 VF 调用内部独立分配 __ubuf__ shared_block（1024B），
 * VF完成后自动释放，下一个 tile 重新分配。
 */
__global__ __vector__ void sobel_kernel_shared_with_ld(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height,
    int32_t totalTilesX, int32_t tilesPerBlock)
{
    uint32_t blockId = AscendC::GetBlockIdx();
    int32_t startTileIdx = static_cast<int32_t>(blockId) * tilesPerBlock;

    for (int32_t t = 0; t < tilesPerBlock; t++) {
        int32_t tileIdx = startTileIdx + t;
        int32_t startX = (tileIdx % totalTilesX) * COMPUTE_SIZE;
        int32_t startY = (tileIdx / totalTilesX) * COMPUTE_SIZE;

        if (startX >= width || startY >= height) break;

        asc_vf_call<sobel_vf_shared_with_ld>(dim3(BLOCK_SIZE, BLOCK_SIZE),
            input, output, width, height, startX, startY);
    }
}

/**
 * Sobel算子VF函数 —— DataCopyPad(MTE方式)预加载到UB
 *
 * 与v3逻辑完全相同：从预加载的UB读取8邻居，1D索引stride=BLOCK_SIZE。
 * 区别仅在于 startX/startY 由参数传入。
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) void sobel_vf_shared_with_mte(
    __ubuf__ uint8_t* shared_block, __gm__ uint8_t* output,
    int width, int height, int32_t startX, int32_t startY)
{
    int32_t x = startX + threadIdx.x;
    int32_t y = startY + threadIdx.y;

    if (threadIdx.x == 0 || threadIdx.x == BLOCK_SIZE - 1 ||
        threadIdx.y == 0 || threadIdx.y == BLOCK_SIZE - 1) return;
    if (x < 1 || x > width - 2 || y < 1 || y > height - 2) return;

    int tl = shared_block[(threadIdx.y - 1) * BLOCK_SIZE + (threadIdx.x - 1)];
    int tc = shared_block[(threadIdx.y - 1) * BLOCK_SIZE + threadIdx.x];
    int tr = shared_block[(threadIdx.y - 1) * BLOCK_SIZE + (threadIdx.x + 1)];
    int ml = shared_block[threadIdx.y * BLOCK_SIZE + (threadIdx.x - 1)];
    int mr = shared_block[threadIdx.y * BLOCK_SIZE + (threadIdx.x + 1)];
    int bl = shared_block[(threadIdx.y + 1) * BLOCK_SIZE + (threadIdx.x - 1)];
    int bc = shared_block[(threadIdx.y + 1) * BLOCK_SIZE + threadIdx.x];
    int br = shared_block[(threadIdx.y + 1) * BLOCK_SIZE + (threadIdx.x + 1)];

    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*tc - tr + bl + 2*bc + br;

    int magnitude = 0;
    if (gx < 0) magnitude -= gx; else magnitude += gx;
    if (gy < 0) magnitude -= gy; else magnitude += gy;
    if (magnitude > 255) magnitude = 255;

    output[y * width + x] = static_cast<uint8_t>(magnitude);
}

/**
 * MTE变体外层kernel —— 循环处理多个tile，复用同一块UB
 *
 * 与LD变体的关键区别：
 * - UB (LocalTensor) 仅分配一次（1024B），所有tile复用
 * - 每个 tile 需要 MTE2_V 同步（DataCopyPad完成→VF可读）
 *   和 V_MTE2 同步（VF读完成→下一个DataCopyPad可写）
 * - LD变体的 __ubuf__ 在每次VF调用时分配/释放，MTE变体仅分配一次
 *
 * 同步事件说明：
 * - MTE2_V: DataCopyPad(MTE2引擎写UB) → VF(V引擎读UB)
 * - V_MTE2: VF(V引擎读UB完成) → 下一个DataCopyPad(MTE2引擎写UB)
 */
__global__ __vector__ void sobel_kernel_shared_with_mte(
    __gm__ uint8_t* input, __gm__ uint8_t* output, int width, int height,
    int32_t totalTilesX, int32_t tilesPerBlock)
{
    uint32_t blockId = AscendC::GetBlockIdx();
    int32_t startTileIdx = static_cast<int32_t>(blockId) * tilesPerBlock;

    constexpr uint32_t TILE_ELEMS = static_cast<uint32_t>(BLOCK_SIZE) * static_cast<uint32_t>(BLOCK_SIZE);
    AscendC::LocalTensor<uint8_t> sharedTile(AscendC::TPosition::VECCALC, 0, TILE_ELEMS);

    AscendC::GlobalTensor<uint8_t> inputGm;
    inputGm.SetGlobalBuffer(input);

    __ubuf__ uint8_t* sharedPtr = reinterpret_cast<__ubuf__ uint8_t*>(sharedTile.GetPhyAddr());

    for (int32_t t = 0; t < tilesPerBlock; t++) {
        int32_t tileIdx = startTileIdx + t;
        int32_t startX = (tileIdx % totalTilesX) * COMPUTE_SIZE;
        int32_t startY = (tileIdx / totalTilesX) * COMPUTE_SIZE;

        if (startX >= width || startY >= height) break;

        int32_t validCols = std::min(BLOCK_SIZE, width - startX);
        int32_t validRows = std::min(BLOCK_SIZE, height - startY);
        int32_t rightPad = BLOCK_SIZE - validCols;

        AscendC::DataCopyExtParams copyParams = {
            static_cast<uint16_t>(validRows),
            static_cast<uint32_t>(validCols),
            static_cast<uint32_t>(width - validCols),
            0U,
            0U
        };
        AscendC::DataCopyPadExtParams<uint8_t> padParams(
            static_cast<bool>(rightPad > 0),
            static_cast<uint8_t>(0),
            static_cast<uint8_t>(rightPad),
            uint8_t(0)
        );

        uint64_t srcOffset = static_cast<uint64_t>(startY) * static_cast<uint64_t>(width) + static_cast<uint64_t>(startX);
        AscendC::DataCopyPad<uint8_t>(
            sharedTile[0],
            inputGm[srcOffset],
            copyParams,
            padParams
        );

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(static_cast<event_t>(0));
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(static_cast<event_t>(0));

        asc_vf_call<sobel_vf_shared_with_mte>(dim3(BLOCK_SIZE, BLOCK_SIZE),
            sharedPtr, output, width, height, startX, startY);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(static_cast<event_t>(0));
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(static_cast<event_t>(0));
    }
}


std::vector<uint8_t> sobel_filter(const std::vector<uint8_t> &input_host,
                                  int width, int height, int kernelType)
{
    const size_t total_elem = width * height;
    const size_t total_byte_size = total_elem * sizeof(uint8_t);

    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *input_device = nullptr;
    uint8_t *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void **>(&input_device), total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&output_device), total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, total_byte_size, input_host.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMemcpy(output_device, total_byte_size, input_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;
    const uint32_t totalTilesX = (width - 2 + COMPUTE_SIZE - 1) / COMPUTE_SIZE;
    const uint32_t totalTilesY = (height - 2 + COMPUTE_SIZE - 1) / COMPUTE_SIZE;
    const uint32_t totalTiles = totalTilesX * totalTilesY;
    const uint32_t tilesPerBlock = (totalTiles + BLOCK_NUM - 1) / BLOCK_NUM;

    if (kernelType == K_GLOBAL) {
        sobel_kernel_global<<<BLOCK_NUM, dyn_ubuf_size, stream>>>(
            input_device, output_device, width, height, totalTilesX, tilesPerBlock);
    } else if (kernelType == K_SHARED_LD) {
        sobel_kernel_shared_with_ld<<<BLOCK_NUM, dyn_ubuf_size, stream>>>(
            input_device, output_device, width, height, totalTilesX, tilesPerBlock);
    } else {
        sobel_kernel_shared_with_mte<<<BLOCK_NUM, dyn_ubuf_size, stream>>>(
            input_device, output_device, width, height, totalTilesX, tilesPerBlock);
    }

    aclrtSynchronizeStream(stream);
    std::vector<uint8_t> output_host(total_elem);
    aclrtMemcpy(output_host.data(), total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    const char *err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "Error: %s\n", err);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    return output_host;
}

int main(int argc, char **argv)
{
    SobelKernelType kernelType = static_cast<SobelKernelType>(SCENARIO_NUM);

    printf("Running Sobel filter with kernel: %d\n", static_cast<int32_t>(SCENARIO_NUM));

    constexpr int32_t width = 768;
    constexpr int32_t height = 1024;
    const size_t total_elem = width * height;

    std::vector<uint8_t> input(total_elem);
    for (size_t i = 0; i < total_elem; ++i) {
        if (i < total_elem / 2) {
            input[i] = static_cast<uint8_t>(1);
        } else {
            input[i] = static_cast<uint8_t>(2);
        }
    }

    auto golden = compute_golden(input, width, height);
    auto output = sobel_filter(input, width, height, kernelType);

    return verify_result(output, golden);
}