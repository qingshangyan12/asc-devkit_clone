#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

__simd_vf__ inline static void ExperimentVfBasic(
    __ubuf__ float* xAddr, __ubuf__ float* yAddr, uint32_t count, uint32_t loopNum)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    AscendC::Reg::MaskReg mask, cmpMask0, cmpMask1;
    AscendC::Reg::RegTensor<float> srcReg, selReg0, selReg1, dupZeroReg, dupOneReg, dupNegOneReg;

    AscendC::Reg::Duplicate<float>(dupZeroReg, 0);
    AscendC::Reg::Duplicate<float>(dupOneReg, 1);
    AscendC::Reg::Duplicate<float>(dupNegOneReg, -1);

    for (uint16_t i = 0; i < loopNum; ++i) {
        // Set mask according to count. count -= oneRepeatSize after execution
        mask = AscendC::Reg::UpdateMask<float>(count);

        // Step1: Load data from unified buffer to register
        AscendC::Reg::LoadAlign(srcReg, xAddr + i * oneRepeatSize);

        // Step2: Compute
        AscendC::Reg::CompareScalar<float, AscendC::CMPMODE::LT>(cmpMask0, srcReg, 0, mask);
        AscendC::Reg::CompareScalar<float, AscendC::CMPMODE::GT>(cmpMask1, srcReg, 0, mask);
        AscendC::Reg::Select(selReg0, dupNegOneReg, dupZeroReg, cmpMask0);
        AscendC::Reg::Select(selReg1, dupOneReg, selReg0, cmpMask1);

        // Step3: Store data from register to unified buffer
        AscendC::Reg::StoreAlign(yAddr + i * oneRepeatSize, selReg1, mask);
    }
}

