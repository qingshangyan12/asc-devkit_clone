/* !
 * \file gelu.asc
 * \brief GELU operator performance tuning sample
 *
 * GELU formula (tanh approximation):
 * GELU(x) ≈ x / (1 + e^(-1.595769 · (x + 0.044715 · x³)))
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace Custom {
template <typename T>
struct SoftmaxTiling {
    uint32_t aDim = 0;
    uint32_t rDim = 0;
    uint32_t rDimAlign = 0;
    uint32_t loopCount = 0;
    uint32_t singleCoreLength = 0;
    uint32_t singleCoreAlignLength = 0;
    T tData;
};
}

namespace Custom {
union DataUnion {
    constexpr __aicore__ DataUnion() : f(0.0f) {}
    constexpr __aicore__ DataUnion(uint32_t val) : i(val) {}
    float f;
    uint32_t i;
};
constexpr DataUnion fp32MinValue(0x00800000u);
}

template <typename T, typename U, typename V>
__simd_callee__ inline void LoadWithCastIfNeed(__ubuf__ T* srcAddr, U& dstReg, 
    V& preg, uint32_t offset)
{
    if constexpr (AscendC::IsSameType<T, half>::value) {
        AscendC::Reg::RegTensor<half> srcReg;
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, AscendC::layoutZMrgZ>(dstReg, srcReg, preg);
    } else {
        AscendC::Reg::LoadAlign(dstReg, srcAddr + offset);
    }
}

template <typename T, typename U, typename V>
__simd_callee__ inline void StoreWithCastIfNeed(__ubuf__ T* dstAddr, U& srcReg, 
    V& preg, uint32_t offset)
{
    if constexpr (AscendC::IsSameType<T, half>::value) {
        AscendC::Reg::RegTensor<half> dstReg;
        AscendC::Reg::Cast<T, float, AscendC::LayoutZMrgZRndRSatNS>(dstReg, srcReg, preg);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(dstAddr + offset, dstReg, preg);
    } else {
        AscendC::Reg::StoreAlign(dstAddr + offset, srcReg);
    }
}

template <typename T>
__simd_vf__ inline void CustomSoftmaxVF(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, __ubuf__ float* maxAddr,
    uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    uint16_t repeatTimes = AscendC::CeilDivision(rDim, oneRepeatSize);
    AscendC::Reg::MaskReg maskFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> expReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> divReg;

    // Phase 1: ReduceMax + Sub + Exp
    for (uint32_t i = 0; i < aDim; i++) {
        uint32_t count = rDim;
        AscendC::Reg::Duplicate(maxReg, Custom::fp32MinValue.f, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(count);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Max(maxReg, maxReg, srcReg, maskFull);
        }
        AscendC::Reg::ReduceMax(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(maxReg, maxReg, maskFull);
        uint32_t sreg0 = rDim;
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg0);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::ExpSub(expReg, srcReg, maxReg, mask);
            // AscendC::Reg::Sub(expReg, srcReg, maxReg, mask);
            // AscendC::Reg::Exp(expReg, expReg, mask);
            AscendC::Reg::StoreAlign<float>(maxAddr + i * rDimAlign + j * oneRepeatSize, expReg, mask);
        }
    }

    for (uint32_t i = 0; i < aDim; i++) {
        // ReduceSum + Div, Dtype: float
        uint32_t sreg1 = rDim;
        AscendC::Reg::Duplicate(sumReg, 0.0, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg1);
            AscendC::Reg::LoadAlign(srcReg, maxAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumReg, sumReg, srcReg, mask);
        }
        AscendC::Reg::ReduceSum(sumReg, sumReg, maskFull);
        AscendC::Reg::Duplicate(sumReg, sumReg, maskFull);
        uint32_t sreg2 = rDim;
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg2);
            AscendC::Reg::LoadAlign(maxReg, maxAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Div(divReg, maxReg, sumReg, mask);
            StoreWithCastIfNeed(dstAddr, divReg, mask, i * rDimAlign + j * oneRepeatSize);
        }
    }
}

template <typename T>
__aicore__ inline void CustomSoftmax(const AscendC::LocalTensor<T>& dstTensor, const AscendC::LocalTensor<T>& srcTensor,
    const AscendC::LocalTensor<float>& maxTensor, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(srcTensor.GetPhyAddr());
    __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(dstTensor.GetPhyAddr());
    __ubuf__ float* maxAddr = reinterpret_cast<__ubuf__ float*>(maxTensor.GetPhyAddr());

    CustomSoftmaxVF(yAddr, xAddr, maxAddr, aDim, rDim, rDimAlign);
}


// ======================= 核函数 =========================
template <typename T>
__global__ __vector__ void softmax_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, Custom::SoftmaxTiling<T> tiling)
{
    // ReduceSum必须使用TPipe，预计下个软件版本解耦
    AscendC::TPipe tPipe;
    AscendC::InitSocState();

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    xGm.SetGlobalBuffer((__gm__ T *)x + AscendC::GetBlockIdx() * tiling.singleCoreLength, tiling.singleCoreLength);
    yGm.SetGlobalBuffer((__gm__ T *)y + AscendC::GetBlockIdx() * tiling.singleCoreLength, tiling.singleCoreLength);

    // use local memory allocator to simplify memor allocation
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;

    // alloc localTensor
    AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T>(tiling.singleCoreAlignLength);
    AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T>(tiling.singleCoreAlignLength);
    AscendC::LocalTensor<float> maxTensor = ubAllocator.Alloc<float>(tiling.singleCoreAlignLength);

    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    for (uint32_t i = 0; i < tiling.loopCount; i++) {
        // dependency of PIPE_MTE3 & PIPE_MTE2 caused by xLocal/yLocal between 2 sequential loops
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        for (uint32_t j = 0; j < tiling.aDim; j++) {
            AscendC::DataCopyPad(xLocal[j * tiling.rDimAlign], xGm[i * tiling.singleCoreLength + j * tiling.rDim], 
                {1, static_cast<uint16_t>(tiling.rDim * sizeof(T)), 0, 0, 0},
                {true, 0, static_cast<uint8_t>(tiling.rDimAlign - tiling.rDim), 0});
        }
        // dependency of PIPE_MTE2 & PIPE_V caused by xLocal/yLocal in one single loop
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        // call custom softmax API
        CustomSoftmax(yLocal, xLocal, maxTensor, tiling.aDim, tiling.rDim, tiling.rDimAlign);
        // dependency of PIPE_V & PIPE_MTE3 caused by yLocal in one single loop
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        for (uint32_t j = 0; j < tiling.aDim; j++) {
            AscendC::DataCopyPad(yGm[i * tiling.singleCoreLength + j * tiling.rDim], yLocal[j * tiling.rDimAlign], 
                {1, static_cast<uint16_t>(tiling.rDim * sizeof(T)), 0, 0, 0});
        }
        // dependency of PIPE_MTE3 & PIPE_MTE2 caused by yLocal between 2 sequential loops
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t blockLen = 16 * 1568;
    uint32_t numBlocks = 1;

    constexpr uint32_t kDim = 1;
    constexpr uint32_t kHeight = 16;
    constexpr uint32_t kWidth = 1568;
    constexpr uint32_t kTotalLen = kHeight * kWidth;

    constexpr uint32_t singleCoreHeight = kHeight;

    uint32_t loopCount = kHeight / singleCoreHeight;
    uint32_t singleCoreLength = singleCoreHeight * kWidth;
    uint32_t alignUnit = 32 / 4;
    uint32_t widthAlign = (kWidth + alignUnit - 1) / alignUnit * alignUnit;
    uint32_t singleCoreAlignLength = singleCoreHeight * widthAlign;
    Custom::SoftmaxTiling<half> tiling = {kHeight, kWidth, widthAlign, loopCount, singleCoreLength, singleCoreAlignLength};


    size_t inputByteSize = numBlocks * blockLen * sizeof(half);
    size_t outputByteSize = numBlocks * blockLen * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* inputHost = nullptr;
    uint8_t* inputDevice = nullptr;
    aclrtMallocHost((void**)(&inputHost), inputByteSize);
    aclrtMalloc((void**)(&inputDevice), inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input.bin", inputByteSize, inputHost, inputByteSize);
    aclrtMemcpy(inputDevice, inputByteSize, inputHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;
    aclrtMallocHost((void**)(&outputHost), outputByteSize);
    aclrtMalloc((void**)(&outputDevice), outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    softmax_custom<half><<<numBlocks, nullptr, stream>>>(inputDevice, outputDevice, tiling);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, outputByteSize);

    aclrtFree(inputDevice);
    aclrtFreeHost(inputHost);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("operator completed.\n");
    return 0;
}
