#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#include <cstddef>
#include <cstdint>

#ifndef SCENARIO
#define SCENARIO 2
#endif

static_assert(SCENARIO == 1 || SCENARIO == 2, "SCENARIO must be 1 or 2");

#ifndef NPU_ARCH
#define NPU_ARCH 2201
#endif

static_assert(NPU_ARCH == 2201 || NPU_ARCH == 3510, "NPU_ARCH must be 2201 or 3510");

namespace {

// ─── 架构相关参数（仅这一小段按架构隔离） ─────────────────────────────────
// 2201 (Atlas A2/A3)：48 AIV、UB 192KB、16 bank groups、周期 16 DataBlock。
//   scatter 走 `AscendC::Copy()` (vcopy)，单 repeat 处理 128 half = 8 个 C0 块。
// 3510 (Ascend 950PR/DT)：64 AIV、UB 256KB、8 bank groups、周期 8 DataBlock。
//   scatter 走 `Reg::LoadAlign` + `Reg::StoreAlign<DATA_BLOCK_COPY>`，单条
//   StoreAlign 处理 1 个 RegTensor (VL=256B=128 half=8 DataBlock，VL 出处：
//   `docs/guide/编程指南/硬件实现/架构规格/NPU架构版本351x.md`)。
// 两个架构都用 `DST_NZ_C0_STRIDE = 128 / 129`：与各自 bank-group 周期同模则
// 单条指令的 8 个写命中同一 bank group 触发冲突，错开 1 个 DataBlock 即规避。
#if NPU_ARCH == 2201
constexpr uint32_t NUM_BLOCKS = 48;
constexpr uint32_t UB_SIZE_BYTES = 192 * 1024;
#elif NPU_ARCH == 3510
constexpr uint32_t NUM_BLOCKS = 64;
constexpr uint32_t UB_SIZE_BYTES = 256 * 1024;
#endif

// ─── 输入矩阵（ND 行优先） ────────────────────────────────────────────────
constexpr uint32_t MATRIX_H = 8192;                       // N 维行数
constexpr uint32_t MATRIX_W = 8192;                       // D 维列数
constexpr uint32_t INPUT_ELEMENTS = MATRIX_H * MATRIX_W;

// ─── tile 切分：固定 128×256，TILE_ROWS*TILE_COLS = 2048 个 tile ──────────
constexpr uint32_t TILE_H = 128;
constexpr uint32_t TILE_W = 256;
constexpr uint32_t TILE_ROWS = MATRIX_H / TILE_H;
constexpr uint32_t TILE_COLS = MATRIX_W / TILE_W;
constexpr uint32_t TOTAL_TILES = TILE_ROWS * TILE_COLS;

// ─── NZ 分形布局：16 half (32B) = 1 个 C0 块 = 1 个 DataBlock ─────────────
constexpr uint32_t C0_ELEMS = 16;
constexpr uint32_t TILE_C0_COLS   = TILE_W / C0_ELEMS;     // = 16
constexpr uint32_t GLOBAL_C0_COLS = MATRIX_W / C0_ELEMS;   // = 512

// ─── 单条 Vec scatter 指令的处理宽度 ────────────────────────────────────
// 两个架构对 half 都是 256B = 128 元素 = 8 DataBlock，但语义出处不同：
//   2201：一条 vcopy `Copy()` 每个 repeat 处理的元素数（vcopy 的 count-mode mask）
//   3510：一条 `Reg::StoreAlign` 处理的元素数，等于 RegTensor 位宽 VL
//         （出处：`docs/guide/编程指南/概念原理和术语/术语表.md`，VL=256B）
// 取通用名 SCATTER_LEN_*：不引入 VL/Reg 这种 Regbase 专属术语。
constexpr uint32_t SCATTER_LEN_HALF  = 128;
constexpr uint32_t SCATTER_LEN_DBS   = SCATTER_LEN_HALF / C0_ELEMS;   // = 8
constexpr uint32_t SCATTERS_PER_ROW  = TILE_W / SCATTER_LEN_HALF;     // = 2
static_assert(TILE_W % SCATTER_LEN_HALF == 0,
              "TILE_W must be a multiple of one scatter instruction's half count");
static_assert(TILE_C0_COLS % SCATTER_LEN_DBS == 0,
              "TILE_C0_COLS must be a multiple of one scatter instruction's DataBlock count");

// ─── scatter 步长（单位都是 DataBlock = 32B） ─────────────────────────────
// DST_NZ_C0_STRIDE 是本样例的核心旋钮：UB 内 D 方向相邻 C0 列的落点间距。
// 同时给：① 2201 vcopy 的 dstStride / ND2NZ 的 dstNzC0Stride；② 3510
// StoreAlign 的 dataBlockStride 使用，三者语义一致。
constexpr uint32_t DST_NZ_N_STRIDE  = 1;
constexpr uint32_t DST_NZ_C0_STRIDE = (SCENARIO == 1) ? TILE_H : (TILE_H + 1);
constexpr uint32_t GLOBAL_DST_NZ_C0_STRIDE = MATRIX_H;     // GM 全局 NZ 列间距

// ─── 缓冲区大小推导 ──────────────────────────────────────────────────────
// ndBuf: GM→UB 线性中转区，紧凑 ND 布局。
constexpr uint32_t ND_BUF_ELEMS = TILE_H * TILE_W;          // = 32768 half = 64KB

// nzBuf: scatter 的目的区，按 NZ 紧凑布局 + 列尾空洞组织。
// 占用 DataBlock 数 = (N - 1)*Nstride + (D - 1)*C0stride + 1
//   S1: 127 + 15*128 + 1 = 2048 (64KB，紧凑)
//   S2: 127 + 15*129 + 1 = 2063 (~64.5KB，含 15 个 32B 空洞)
constexpr uint32_t TILE_OUT_C0_BLOCKS =
    (TILE_H - 1) * DST_NZ_N_STRIDE + (TILE_C0_COLS - 1) * DST_NZ_C0_STRIDE + 1;
constexpr uint32_t TILE_OUT_ELEMS = TILE_OUT_C0_BLOCKS * C0_ELEMS;

constexpr uint32_t GLOBAL_OUT_C0_BLOCKS =
    (MATRIX_H - 1) * DST_NZ_N_STRIDE + (GLOBAL_C0_COLS - 1) * GLOBAL_DST_NZ_C0_STRIDE + 1;
constexpr uint32_t OUTPUT_ELEMENTS = GLOBAL_OUT_C0_BLOCKS * C0_ELEMS;

constexpr uint32_t ND_BUF_ADDR = 0;
constexpr uint32_t NZ_BUF_ADDR = ND_BUF_ELEMS * sizeof(half);

static_assert((ND_BUF_ELEMS + TILE_OUT_ELEMS) * sizeof(half) <= UB_SIZE_BYTES,
              "ndBuf + nzBuf exceeds UB size");

#if SCENARIO == 1
constexpr const char *OUTPUT_FILE = "./output/output_s1.bin";
#else
constexpr const char *OUTPUT_FILE = "./output/output_s2.bin";
#endif

} // namespace

// ─────────────────────────────────────────────────────────────────────────
// Vec 侧 scatter：ndBuf(UB ND) → nzBuf(UB NZ)。
// 两个架构做的是同一件事——单条指令一次写 SCATTER_LEN_DBS (=8) 个 32B 块到
// 目标 8 个 C0 列，由 DST_NZ_C0_STRIDE 决定落点间距；只是用的 API 不同。
// 函数签名公用，函数体内按 NPU_ARCH 宏切换实现。
// ─────────────────────────────────────────────────────────────────────────

#if NPU_ARCH == 3510
// 950 没有 vcopy/Copy 的 repeat 机制，手写 __simd_vf__：外层 scatter 列组、
// 内层行循环；每迭代一条 LoadAlign + 一条 StoreAlign，由 dataBlockStride
// 决定 8 个 DataBlock 的落点。VEC_LOAD / VEC_STORE 两条独立子流水可双发。
__simd_vf__ inline void Nd2NzRegLoadStoreVF(
    __ubuf__ half *dstAddr,
    __ubuf__ half *srcAddr)
{
    AscendC::Reg::RegTensor<half> reg;
    AscendC::Reg::MaskReg mask =
        AscendC::Reg::CreateMask<half, AscendC::Reg::MaskPattern::ALL>();

    for (uint16_t k = 0; k < SCATTERS_PER_ROW; ++k) {
        // 第 k 次 scatter 覆盖的列组在 nzBuf 内的起点（half 单位）。
        const uint32_t dstColGroupOffset = k * SCATTER_LEN_DBS * DST_NZ_C0_STRIDE * C0_ELEMS;

        for (uint16_t r = 0; r < TILE_H; ++r) {
            AscendC::Reg::LoadAlign<half>(reg, srcAddr + r * TILE_W + k * SCATTER_LEN_HALF);

            __ubuf__ half *dstRowAddr = dstAddr + dstColGroupOffset + r * C0_ELEMS;
            AscendC::Reg::StoreAlign<half, AscendC::Reg::DataCopyMode::DATA_BLOCK_COPY>(
                dstRowAddr, reg, DST_NZ_C0_STRIDE, mask);
        }
    }
}
#endif

__aicore__ inline void ScatterNd2Nz(
    AscendC::LocalTensor<half> &nzBuf,
    AscendC::LocalTensor<half> &ndBuf)
{
#if NPU_ARCH == 2201
    // vcopy/Copy 把"行循环"作为 repeat 内置：repeatTimes = TILE_H = 128。
    // 一行 16 个 C0 块 = 2 次 scatter (每次 8 个 C0 块)，拆 2 次 Copy 覆盖前/后 8 列。
    AscendC::CopyRepeatParams copyParams;
    copyParams.dstStride     = DST_NZ_C0_STRIDE;            // = vcopy 的 dst_block_stride
    copyParams.srcStride     = 1;                           // 源紧凑
    copyParams.dstRepeatSize = DST_NZ_N_STRIDE;             // N 方向步长
    copyParams.srcRepeatSize = TILE_W / C0_ELEMS;           // 源每行 16 个 C0 块

    for (uint32_t k = 0; k < SCATTERS_PER_ROW; ++k) {
        // 第 k 次 scatter 覆盖 C0 列 [k*SCATTER_LEN_DBS, (k+1)*SCATTER_LEN_DBS)。
        AscendC::Copy(nzBuf[k * SCATTER_LEN_DBS * DST_NZ_C0_STRIDE * C0_ELEMS],
                      ndBuf[k * SCATTER_LEN_HALF],
                      static_cast<uint64_t>(SCATTER_LEN_HALF),  // count-mode mask = 单条 scatter 宽度
                      static_cast<uint8_t>(TILE_H),             // 128 行 = 128 repeats
                      copyParams);
    }
#elif NPU_ARCH == 3510
    Nd2NzRegLoadStoreVF(
        reinterpret_cast<__ubuf__ half *>(nzBuf.GetPhyAddr()),
        reinterpret_cast<__ubuf__ half *>(ndBuf.GetPhyAddr()));
#endif
}

// ─────────────────────────────────────────────────────────────────────────
// 共享 kernel：CopyTile 三步流水（MTE2 → Vec → MTE3）对两个架构完全相同，
// 只在 Step2 调用 ScatterNd2Nz()，由架构特化决定具体 API。
// ─────────────────────────────────────────────────────────────────────────
class KernelNd2Nz {
public:
    __aicore__ inline KernelNd2Nz() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ half *)x, INPUT_ELEMENTS);
        zGm.SetGlobalBuffer((__gm__ half *)z, OUTPUT_ELEMENTS);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> ndBuf(AscendC::TPosition::VECIN,  ND_BUF_ADDR, ND_BUF_ELEMS);
        AscendC::LocalTensor<half> nzBuf(AscendC::TPosition::VECOUT, NZ_BUF_ADDR, TILE_OUT_ELEMS);

        const uint32_t blockIdx  = AscendC::GetBlockIdx();
        const uint32_t blockNum  = AscendC::GetBlockNum();
        const uint32_t baseCount = TOTAL_TILES / blockNum;
        const uint32_t remain    = TOTAL_TILES % blockNum;
        const uint32_t tileCount = baseCount + (blockIdx < remain ? 1 : 0);
        const uint32_t startTile = blockIdx * baseCount + (blockIdx < remain ? blockIdx : remain);

        for (uint32_t i = 0; i < tileCount; ++i) {
            CopyTile(ndBuf, nzBuf, startTile + i);
        }
    }

private:
    // CopyTile 三步流水：
    //   Step1 (MTE2): GM(ND) → ndBuf(ND) 整块线性搬运
    //   Step2 (Vec):  ndBuf → nzBuf 经 scatter（bank 冲突点，架构特化）
    //   Step3 (MTE3): nzBuf → GM 紧凑 NZ 回写
    __aicore__ inline void CopyTile(
        AscendC::LocalTensor<half> &ndBuf,
        AscendC::LocalTensor<half> &nzBuf,
        uint32_t tileId)
    {
        const uint32_t tileRow   = tileId / TILE_COLS;
        const uint32_t tileCol   = tileId % TILE_COLS;
        const uint32_t srcOffset = tileRow * TILE_H * MATRIX_W + tileCol * TILE_W;

        // ── Step1: GM(ND) → ndBuf(UB ND)，整 tile 一次搬运 ───────────────
        AscendC::DataCopyParams ndParams;
        ndParams.blockCount = TILE_H;
        ndParams.blockLen   = TILE_W / C0_ELEMS;
        ndParams.srcStride  = (MATRIX_W - TILE_W) / C0_ELEMS;
        ndParams.dstStride  = 0;
        AscendC::DataCopy(ndBuf, xGm[srcOffset], ndParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // ── Step2: ndBuf → nzBuf scatter（架构特化的 bank 冲突点） ───────
        ScatterNd2Nz(nzBuf, ndBuf);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // ── Step3: nzBuf → GM 紧凑 NZ 回写，跳过列尾空洞 ─────────────────
        AscendC::DataCopyParams outParams;
        outParams.blockCount = TILE_C0_COLS;
        outParams.blockLen   = TILE_H;
        outParams.srcStride  = DST_NZ_C0_STRIDE - TILE_H;
        outParams.dstStride  = GLOBAL_DST_NZ_C0_STRIDE - TILE_H;

        const uint32_t dstBlockOffset =
            tileRow * TILE_H * DST_NZ_N_STRIDE + tileCol * TILE_C0_COLS * GLOBAL_DST_NZ_C0_STRIDE;
        AscendC::DataCopy(zGm[dstBlockOffset * C0_ELEMS], nzBuf, outParams);

        // 下一 tile 复用 ndBuf/nzBuf：
        //   MTE3_V    保护 Vec scatter 重新写 nzBuf；
        //   MTE3_MTE2 保护 MTE2 重新写 ndBuf。两个事件必须用不同 event id。
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

private:
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> zGm;
};

__global__ __vector__ void bank_conflict_nd2nz(GM_ADDR x, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelNd2Nz op;
    op.Init(x, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t inputByteSize  = static_cast<size_t>(INPUT_ELEMENTS)  * sizeof(half);
    constexpr size_t outputByteSize = static_cast<size_t>(OUTPUT_ELEMENTS) * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost = nullptr;
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *zDevice = nullptr;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputFileSize = 0;
    if (!ReadFile("./input/input.bin", inputFileSize, xHost, inputByteSize)) {
        return 1;
    }

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    bank_conflict_nd2nz<<<NUM_BLOCKS, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(OUTPUT_FILE, zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
