#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#include <cstddef>
#include <cstdint>

#ifndef SCENARIO
#define SCENARIO 1
#endif

static_assert(SCENARIO == 1 || SCENARIO == 2, "SCENARIO must be 1 or 2");

namespace {
constexpr uint32_t MATRIX_H = 8192;
constexpr uint32_t MATRIX_W = 8192;
constexpr uint32_t TILE_H = 256;
constexpr uint32_t TILE_W = 256;
constexpr uint32_t TILE_ROWS = MATRIX_H / TILE_H;
constexpr uint32_t TILE_COLS = MATRIX_W / TILE_W;
constexpr uint32_t TOTAL_TILES = TILE_ROWS * TILE_COLS;
constexpr uint32_t C0_ELEMS = 16;
constexpr uint32_t TILE_C0_COLS = TILE_W / C0_ELEMS;
constexpr uint32_t DST_NZ_N_STRIDE = 1;
constexpr uint32_t DST_NZ_C0_STRIDE = (SCENARIO == 1) ? 256 : 257;
constexpr uint32_t TILE_OUT_C0_BLOCKS =
    (TILE_H - 1) * DST_NZ_N_STRIDE + (TILE_C0_COLS - 1) * DST_NZ_C0_STRIDE + 1;
constexpr uint32_t TILE_OUT_ELEMS = TILE_OUT_C0_BLOCKS * C0_ELEMS;
constexpr uint32_t INPUT_ELEMENTS = MATRIX_H * MATRIX_W;
constexpr uint32_t OUTPUT_ELEMENTS = TOTAL_TILES * TILE_OUT_ELEMS;
static_assert(TILE_OUT_ELEMS * sizeof(half) <= 192 * 1024, "TILE_OUT_ELEMS exceeds UB size (192KB)");

#if SCENARIO == 1
constexpr const char *OUTPUT_FILE = "./output/output_s1.bin";
#else
constexpr const char *OUTPUT_FILE = "./output/output_s2.bin";
#endif
} // namespace

class KernelNd2Nz {
public:
    __aicore__ inline KernelNd2Nz() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ half *)x, INPUT_ELEMENTS);
        zGm.SetGlobalBuffer((__gm__ half *)z, OUTPUT_ELEMENTS);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> tileLocal(AscendC::TPosition::VECIN, TILE_LOCAL_ADDR, TILE_OUT_ELEMS);
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = AscendC::GetBlockNum();
        const uint32_t baseCount = TOTAL_TILES / blockNum;
        const uint32_t remain = TOTAL_TILES % blockNum;
        const uint32_t tileCount = baseCount + (blockIdx < remain ? 1 : 0);
        const uint32_t startTile = blockIdx * baseCount + (blockIdx < remain ? blockIdx : remain);

        for (uint32_t i = 0; i < tileCount; ++i) {
            CopyTile(tileLocal, startTile + i);
        }
    }

private:
    __aicore__ inline void CopyTile(AscendC::LocalTensor<half> &tileLocal, uint32_t tileId)
    {
        const uint32_t tileRow = tileId / TILE_COLS;
        const uint32_t tileCol = tileId % TILE_COLS;
        const uint32_t srcOffset = tileRow * TILE_H * MATRIX_W + tileCol * TILE_W;
        const uint32_t dstOffset = tileId * TILE_OUT_ELEMS;

        half zero = static_cast<half>(0);
        AscendC::Duplicate(tileLocal, zero, TILE_OUT_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Nd2NzParams params;
        params.ndNum = 1;
        params.nValue = TILE_H - 1;
        params.dValue = TILE_W;
        params.srcNdMatrixStride = 0;
        params.srcDValue = MATRIX_W;
        params.dstNzC0Stride = DST_NZ_C0_STRIDE;
        params.dstNzNStride = DST_NZ_N_STRIDE;
        params.dstNzMatrixStride = 0;

        // ND2NZ 分两段搬运：nValue=255 搬前 255 行，再补最后 1 行。
        // 直接 nValue=256 时，末行写入地址偏移不符预期，需拆开处理。
        AscendC::DataCopy(tileLocal, xGm[srcOffset], params);
        AscendC::PipeBarrier<PIPE_ALL>();
        params.nValue = 1;
        AscendC::DataCopy(tileLocal[(TILE_H - 1) * C0_ELEMS], xGm[srcOffset + (TILE_H - 1) * MATRIX_W], params);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(zGm[dstOffset], tileLocal, TILE_OUT_ELEMS);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    static constexpr uint32_t TILE_LOCAL_ADDR = 0;
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> zGm;
};

__global__ __vector__ void bank_conflict_nd2nz(GM_ADDR x, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelNd2Nz op;
    op.Init(x, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    (void)argc;
    (void)argv;

    constexpr uint32_t numBlocks = 48; // Atlas A3/A2 AIV 核数
    constexpr size_t inputByteSize = static_cast<size_t>(INPUT_ELEMENTS) * sizeof(half);
    constexpr size_t outputByteSize = static_cast<size_t>(OUTPUT_ELEMENTS) * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost = nullptr;
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *zDevice = nullptr;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputFileSize = 0;
    if (!ReadFile("./input/input.bin", inputFileSize, xHost, inputByteSize)) {
        return 1;
    }

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    bank_conflict_nd2nz<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(OUTPUT_FILE, zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
