#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#include <cstddef>
#include <cstdint>

#ifndef SCENARIO
#define SCENARIO 1
#endif

static_assert(SCENARIO == 1 || SCENARIO == 2 || SCENARIO == 3,
              "SCENARIO must be 1, 2, or 3");

namespace {

// ── 数据规格 ──────────────────────────────────────────────────────────────────
// 8192×8192 ND half 矩阵，切为 128×256 的 tile 逐块处理。
// TILE_C0_COLS=16 与 example 03 一致，保证 MTE2 冲突信号强度（16-way 写冲突）。
// UB 用量约 130KB（50%），低于 256×256 双 buffer 的 ~257KB 上限。
constexpr uint32_t MATRIX_H    = 8192;
constexpr uint32_t MATRIX_W    = 8192;
constexpr uint32_t TILE_H      = 128;
constexpr uint32_t TILE_W      = 256;
constexpr uint32_t TILE_ROWS   = MATRIX_H / TILE_H;            // = 64
constexpr uint32_t TILE_COLS   = MATRIX_W / TILE_W;            // = 32
constexpr uint32_t TOTAL_TILES = TILE_ROWS * TILE_COLS;        // = 2048
constexpr uint32_t C0_ELEMS    = 16;
constexpr uint32_t TILE_C0_COLS = TILE_W / C0_ELEMS;           // = 16
constexpr uint32_t DST_NZ_N_STRIDE = 1;
constexpr uint32_t INPUT_ELEMENTS  = MATRIX_H * MATRIX_W;

// ── 冲突控制①：ND2NZ dstNzC0Stride（MTE2 写写冲突）─────────────────────────
// NZ 紧凑布局的自然 stride = TILE_H = 128（相邻 C1 列组间距 = N1×N0 = TILE_H）。
// 但 128%8==0，每行 16 个 C0 写全部落在 bank 0：
//   row 0 列位置: 0, 128, 256, ..., 1920 → bank_id 全是 0
//   → 16 个写争抢 bank 0 单个端口，并行度退化为 1（16 拍/行）。
// stride=129 = TILE_H+1：每列偏 1 DataBlock，
//   row 0 列位置: 0, 129, 258, ..., 1935 → bank_id 依次 0,1,2,...,15
//   → 16 个写分散到 16 个不同 bank，1 拍并行完成。代价：每列 1 DataBlock 空洞。
#if SCENARIO == 1
constexpr uint32_t DST_NZ_C0_STRIDE = 128;  // = TILE_H，紧凑但 MTE2 冲突
#else
constexpr uint32_t DST_NZ_C0_STRIDE = 129;  // = TILE_H+1，规避 MTE2 冲突
#endif

// stride=128: 127 + 15×128 + 1 = 2048 blocks，TILE_OUT_ELEMS=32768=256×VL（整除）
// stride=129: 127 + 15×129 + 1 = 2063 blocks，TILE_OUT_ELEMS=33008
constexpr uint32_t TILE_OUT_C0_BLOCKS =
    (TILE_H - 1) * DST_NZ_N_STRIDE + (TILE_C0_COLS - 1) * DST_NZ_C0_STRIDE + 1;
constexpr uint32_t TILE_OUT_ELEMS  = TILE_OUT_C0_BLOCKS * C0_ELEMS;
constexpr uint32_t OUTPUT_ELEMENTS = TOTAL_TILES * TILE_OUT_ELEMS;

// ── buf1 分配（16-DataBlock 对齐，使 buf1 结束位置可控）─────────────────────
// stride=128: 2048 已对齐；stride=129: 2063 向上对齐到 2064（=129×16）
constexpr uint32_t BUF1_ALLOC_C0_BLOCKS =
    ((TILE_OUT_C0_BLOCKS + 15) / 16) * 16;
constexpr uint32_t BUF1_ALLOC_BYTES = BUF1_ALLOC_C0_BLOCKS * 32;
constexpr uint32_t BUF1_ALLOC_ELEMS = BUF1_ALLOC_C0_BLOCKS * C0_ELEMS;

// ── 冲突控制②：Vec 侧 src/dst 地址差（LoadAlign/StoreAlign 跨迭代双发冲突）──
//
// __simd_vf__ 循环中，编译器将迭代 i 的 StoreAlign（写 dst+i×VL）与迭代 i+1 的
// LoadAlign（读 src+(i+1)×VL）双发到同一 cycle。
//
//   d = (dstUbAddr/32 - srcUbAddr/32) % 16
//   d = 8 → 双发时二者覆盖相同的 8 个 bank → 冲突
//   d = 0 → 二者覆盖互补的 8 个 bank → 无冲突
//
// buf1 起始 DataBlock = 0：
//   SCENARIO=1: buf1_alloc=2048, +PAD=256B(8) → buf2_DataBlock=2056, %16=8 → d=8 冲突
//   SCENARIO=2: buf1_alloc=2064, +PAD=256B(8) → buf2_DataBlock=2072, %16=8 → d=8 冲突
//   SCENARIO=3: buf1_alloc=2064, +PAD=0      → buf2_DataBlock=2064, %16=0 → d=0 无冲突
#if SCENARIO == 3
constexpr uint32_t VEC_PADDING_BYTES = 0;    // 自然布局：双发时 bank 集合互补
#else
constexpr uint32_t VEC_PADDING_BYTES = 256;  // 8 DataBlocks：强制双发时 bank 集合重叠
#endif

constexpr uint32_t BUF2_START_BYTES = BUF1_ALLOC_BYTES + VEC_PADDING_BYTES;

// VF_VL = 256B = 128 half（950PR/DT）
// stride=128: TILE_OUT_ELEMS=32768=256×VL，整除
// stride=129: TILE_OUT_ELEMS=33008 → 向上取整到 258×128=33024，余量由 Duplicate 填零
constexpr uint32_t VF_VL         = 128;
constexpr uint32_t VF_COPY_ELEMS = ((TILE_OUT_ELEMS + VF_VL - 1) / VF_VL) * VF_VL;

// UB 使用量验证（三个 scenario 均约 130KB）
static_assert(BUF2_START_BYTES + VF_COPY_ELEMS * sizeof(half) <= 256 * 1024,
              "UB usage exceeds 256KB");

#if SCENARIO == 1
constexpr const char* OUTPUT_FILE = "./output/output_s1.bin";
#elif SCENARIO == 2
constexpr const char* OUTPUT_FILE = "./output/output_s2.bin";
#else
constexpr const char* OUTPUT_FILE = "./output/output_s3.bin";
#endif

} // namespace

// ── VF 函数：buf1(UB) → Reg → buf2(UB)（Vec 侧冲突点）─────────────────────
// __simd_vf__：编译器在此函数内对相邻迭代做跨迭代双发优化。
// 双发时 StoreAlign(iter i) 与 LoadAlign(iter i+1) 落在相同 bank 集合时发生冲突。
__simd_vf__ inline void CopyVF(
    __ubuf__ half* dst, __ubuf__ half* src, uint32_t n, uint32_t loopNum)
{
    constexpr uint32_t oneVL = VF_VL;
    AscendC::Reg::RegTensor<half> reg;
    AscendC::Reg::MaskReg mask;

    for (uint16_t i = 0; i < loopNum; ++i) {
        mask = AscendC::Reg::UpdateMask<half>(n);  // n >> oneVL → 全满掩码
        AscendC::Reg::LoadAlign(reg, src + i * oneVL);
        AscendC::Reg::StoreAlign(dst + i * oneVL, reg, mask);
    }
}

// ── 核函数类 ──────────────────────────────────────────────────────────────────
class KernelCombined {
public:
    __aicore__ inline KernelCombined() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        AscendC::InitSocState();
        xGm.SetGlobalBuffer((__gm__ half*)x, INPUT_ELEMENTS);
        yGm.SetGlobalBuffer((__gm__ half*)y, OUTPUT_ELEMENTS);
    }

    __aicore__ inline void Process()
    {
        // buf1/buf2 跨 tile 复用同一块 UB 空间
        AscendC::LocalTensor<half> buf1(AscendC::TPosition::VECCALC,
                                        0, BUF1_ALLOC_ELEMS);
        AscendC::LocalTensor<half> buf2(AscendC::TPosition::VECCALC,
                                        BUF2_START_BYTES, VF_COPY_ELEMS);

        const uint32_t blockIdx  = AscendC::GetBlockIdx();
        const uint32_t blockNum  = AscendC::GetBlockNum();
        const uint32_t baseCount = TOTAL_TILES / blockNum;
        const uint32_t remain    = TOTAL_TILES % blockNum;
        const uint32_t tileCount = baseCount + (blockIdx < remain ? 1 : 0);
        const uint32_t startTile = blockIdx * baseCount + (blockIdx < remain ? blockIdx : remain);

        for (uint32_t i = 0; i < tileCount; ++i) {
            ProcessTile(buf1, buf2, startTile + i);
        }
    }

private:
    __aicore__ inline void ProcessTile(
        AscendC::LocalTensor<half>& buf1,
        AscendC::LocalTensor<half>& buf2,
        uint32_t tileId)
    {
        const uint32_t tileRow   = tileId / TILE_COLS;
        const uint32_t tileCol   = tileId % TILE_COLS;
        const uint32_t srcOffset = tileRow * TILE_H * MATRIX_W + tileCol * TILE_W;
        const uint32_t dstOffset = tileId * TILE_OUT_ELEMS;

        // ── Step 1: 清零 buf1 ──────────────────────────────────────────
        // SCENARIO=2/3 (stride=129) 列间有 1 DataBlock 空洞（共 15 个），需预填 0。
        // SCENARIO=1 (stride=128) 紧凑无洞，Duplicate 在此为代码统一保留（开销可忽略）。
        half zero = static_cast<half>(0);
        AscendC::Duplicate(buf1, zero, BUF1_ALLOC_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        // ── Step 2: GM(ND) → buf1(NZ) via ND2NZ（MTE2，冲突点①）──────
        // stride=128: 一行 16 个 C0 块全部打 bank 0 → 16-way 写写冲突
        // stride=129: 16 个块分散到 bank 0~15 → 完美 16-way 并行
        AscendC::Nd2NzParams params;
        params.ndNum             = 1;
        params.nValue            = TILE_H - 1;  // 先搬前 H-1 行
        params.dValue            = TILE_W;
        params.srcNdMatrixStride = 0;
        params.srcDValue         = MATRIX_W;
        params.dstNzC0Stride     = DST_NZ_C0_STRIDE;
        params.dstNzNStride      = DST_NZ_N_STRIDE;
        params.dstNzMatrixStride = 0;

        AscendC::DataCopy(buf1, xGm[srcOffset], params);
        AscendC::PipeBarrier<PIPE_ALL>();

        // 补最后一行：nValue=TILE_H 时末行目标偏移不符预期，拆开处理。
        params.nValue = 1;
        AscendC::DataCopy(buf1[(TILE_H - 1) * C0_ELEMS],
                          xGm[srcOffset + (TILE_H - 1) * MATRIX_W], params);
        AscendC::PipeBarrier<PIPE_ALL>();

        // ── Step 3: buf1(UB) → Reg → buf2(UB)（Vec，冲突点②）─────────
        constexpr uint32_t loopNum = VF_COPY_ELEMS / VF_VL;
        CopyVF((__ubuf__ half*)buf2.GetPhyAddr(),
               (__ubuf__ half*)buf1.GetPhyAddr(),
               VF_COPY_ELEMS, loopNum);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // ── Step 4: buf2(UB) → GM（MTE3）────────────────────────────────
        AscendC::DataCopy(yGm[dstOffset], buf2, TILE_OUT_ELEMS);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
};

// ── 全局核函数 ────────────────────────────────────────────────────────────────
__global__ __vector__ void bank_conflict_combined_950(GM_ADDR x, GM_ADDR y)
{
    KernelCombined op;
    op.Init(x, y);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ── Host 主函数 ───────────────────────────────────────────────────────────────
int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr uint32_t numBlocks    = 64; // Ascend 950PR/DT AIV 核数
    constexpr size_t inputByteSize  = static_cast<size_t>(INPUT_ELEMENTS)  * sizeof(half);
    constexpr size_t outputByteSize = static_cast<size_t>(OUTPUT_ELEMENTS) * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost   = nullptr;
    uint8_t* yHost   = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;

    aclrtMallocHost((void**)(&xHost),  inputByteSize);
    aclrtMallocHost((void**)(&yHost),  outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputFileSize = 0;
    if (!ReadFile("./input/input.bin", inputFileSize, xHost, inputByteSize)) {
        return 1;
    }

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    bank_conflict_combined_950<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(OUTPUT_FILE, yHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
