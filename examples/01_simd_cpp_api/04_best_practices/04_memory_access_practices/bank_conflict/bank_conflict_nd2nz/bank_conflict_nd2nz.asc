/* !
 * \file bank_conflict_nd2nz.asc
 * \brief bank conflict nd2nz operator performance tuning sample
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#include <cstddef>
#include <cstdint>

#ifndef SCENARIO
#define SCENARIO 1
#endif

static_assert(SCENARIO == 1 || SCENARIO == 2, "SCENARIO must be 1 or 2");

#ifndef NPU_ARCH
#define NPU_ARCH 2201
#endif

static_assert(NPU_ARCH == 2201 || NPU_ARCH == 3510, "NPU_ARCH must be 2201 or 3510");

namespace {
#if NPU_ARCH == 2201
constexpr uint32_t ubSizeBytes = 192 * 1024;
#elif NPU_ARCH == 3510
constexpr uint32_t ubSizeBytes = 256 * 1024;
#endif

constexpr uint32_t c0Elems = 16;
constexpr uint32_t vecLenHalf = 128;
constexpr uint32_t vecLenDbs = vecLenHalf / c0Elems;
constexpr uint32_t dstNzNStride = 1;
} // namespace

#if NPU_ARCH == 3510
template <uint32_t tileH, uint32_t tileW>
__simd_vf__ inline void Nd2NzRegLoadStoreVF(__ubuf__ half* dstAddr, __ubuf__ half* srcAddr)
{
    constexpr uint32_t dstNzC0Stride = (SCENARIO == 1) ? tileH : (tileH + 1);
    constexpr uint32_t vecsPerRow = tileW / vecLenHalf;

    AscendC::Reg::RegTensor<half> reg;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<half, AscendC::Reg::MaskPattern::ALL>();

    for (uint16_t k = 0; k < vecsPerRow; ++k) {
        const uint32_t dstColGroupOffset = k * vecLenDbs * dstNzC0Stride * c0Elems;

        for (uint16_t r = 0; r < tileH; ++r) {
            AscendC::Reg::LoadAlign<half>(reg, srcAddr + r * tileW + k * vecLenHalf);

            __ubuf__ half* dstRowAddr = dstAddr + dstColGroupOffset + r * c0Elems;
            AscendC::Reg::StoreAlign<half, AscendC::Reg::DataCopyMode::DATA_BLOCK_COPY>(
                dstRowAddr, reg, dstNzC0Stride, mask);
        }
    }
}
#endif

template <uint32_t totalM, uint32_t totalN, uint32_t tileH, uint32_t tileW>
class KernelNd2Nz {

    static constexpr uint32_t tileC0Cols = tileW / c0Elems;
    static constexpr uint32_t tileCols = totalN / tileW;
    static constexpr uint32_t dstNzC0Stride = (SCENARIO == 1) ? tileH : (tileH + 1);
    static constexpr uint32_t ndBufElems = tileH * tileW;

    // UB 内 NZ tile 在 S2 会在相邻 C0 列之间多偏移 1 个 DataBlock，写回 GM 时由 MTE3 跳过
    static constexpr uint32_t tileOutElems =
        ((tileH - 1) * dstNzNStride + (tileC0Cols - 1) * dstNzC0Stride + 1) * c0Elems;
    static constexpr uint32_t ndBufBytes = ndBufElems * sizeof(half);
    static constexpr uint32_t nzBufBytes = tileOutElems * sizeof(half);

    // UB 按 [ndPing | ndPong | nzPing | nzPong] 顺序摆放（nd 全部在前、nz 全部在后），
    // 这样在 2201 上 nd 落进第一组 bank（slot 0）、nz 落进第二组 bank（slot 1），
    // V scatter 一拍内读 ndBuf 和写 nzBuf 落到不同 bank，避免 V 内部读写冲突放大。
    // 在 3510 上 4 个 buf 因 bank 容量大都在 slot 0，本顺序与原 [nd|nz|nd|nz] 等效。
    static constexpr uint32_t tileBufBytes = ndBufBytes + nzBufBytes;

    static_assert(tileW % vecLenHalf == 0, "tileW must be a multiple of one vector instruction's half count");
    static_assert(
        tileC0Cols % vecLenDbs == 0, "tileC0Cols must be a multiple of one vector instruction's DataBlock count");
    static_assert(2 * tileBufBytes <= ubSizeBytes, "ping-pong ndBuf + nzBuf exceeds UB size");

public:
    __aicore__ inline KernelNd2Nz() {}

    __aicore__ inline void Init(__gm__ uint8* x, __gm__ uint8* z)
    {
        xGm.SetGlobalBuffer((__gm__ half*)x, totalM * totalN);
        zGm.SetGlobalBuffer((__gm__ half*)z, totalM * totalN);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> ndPing(AscendC::TPosition::VECIN,  0,                            ndBufElems);
        AscendC::LocalTensor<half> ndPong(AscendC::TPosition::VECIN,  ndBufBytes,                   ndBufElems);
        AscendC::LocalTensor<half> nzPing(AscendC::TPosition::VECOUT, 2 * ndBufBytes,               tileOutElems);
        AscendC::LocalTensor<half> nzPong(AscendC::TPosition::VECOUT, 2 * ndBufBytes + nzBufBytes,  tileOutElems);

        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = AscendC::GetBlockNum();
        constexpr uint32_t totalTiles = (totalM / tileH) * tileCols;
        const uint32_t baseCount = totalTiles / blockNum;
        const uint32_t remain = totalTiles % blockNum;
        const uint32_t tileCount = baseCount + (blockIdx < remain ? 1 : 0);
        const uint32_t startTile = blockIdx * baseCount + (blockIdx < remain ? blockIdx : remain);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);

        if (tileCount > 0) {
            CopyIn(ndPing, startTile, EVENT_ID0);
        }

        for (uint32_t i = 0; i < tileCount; ++i) {
            const int32_t eventID = ((i & 1) == 0) ? EVENT_ID0 : EVENT_ID1;
            AscendC::LocalTensor<half>& ndBuf = ((i & 1) == 0) ? ndPing : ndPong;
            AscendC::LocalTensor<half>& nzBuf = ((i & 1) == 0) ? nzPing : nzPong;

            // 首轮先填充第二块输入 buffer，使 MTE2(tile 1) 可以和 V(tile 0) 重叠。
            // 后续预取会在 V 释放当前 ndBuf 后立即发起。
            if (i == 0 && tileCount > 1) {
                CopyIn(ndPong, startTile + 1, EVENT_ID1);
            }

#if NPU_ARCH == 2201
            ComputeTileNd2nzWithCopy(ndBuf, nzBuf, eventID);
#elif NPU_ARCH == 3510
            ComputeTileNd2nzWithRegVF(ndBuf, nzBuf, eventID);
#endif

            // ComputeTile... 已经消费完当前 ndBuf，因此同一个 ndBuf/eventID 可以立即
            // 复用给 tile i+2。这里的预取只依赖 V_MTE2，不依赖下面 nzBuf 的 MTE3 写回。
            const uint32_t preload = i + 2;
            if (preload < tileCount) {
                CopyIn(ndBuf, startTile + preload, eventID);
            }

            // 写回当前 NZ tile。MTE3_V 只约束下一次写同一个 nzBuf 的 Compute，
            // 后续 tile 的 MTE2 可以提前在路上。
            CopyOut(nzBuf, startTile + i, eventID);
        }

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<half>& ndBuf, uint32_t tileId, int32_t eventID)
    {
        const uint32_t tileRow = tileId / tileCols;
        const uint32_t tileCol = tileId % tileCols;
        const uint32_t srcOffset = tileRow * tileH * totalN + tileCol * tileW;

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(eventID);

        AscendC::DataCopyParams ndParams;
        ndParams.blockCount = tileH;
        ndParams.blockLen = tileW / c0Elems;
        ndParams.srcStride = (totalN - tileW) / c0Elems;
        ndParams.dstStride = 0;
        AscendC::DataCopy(ndBuf, xGm[srcOffset], ndParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventID);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<half>& nzBuf, uint32_t tileId, int32_t eventID)
    {
        const uint32_t tileRow = tileId / tileCols;
        const uint32_t tileCol = tileId % tileCols;

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventID);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventID);

        AscendC::DataCopyParams outParams;
        outParams.blockCount = tileC0Cols;
        outParams.blockLen = tileH;
        outParams.srcStride = dstNzC0Stride - tileH;
        outParams.dstStride = totalM - tileH;

        const uint32_t dstBlockOffset = tileRow * tileH * dstNzNStride + tileCol * tileC0Cols * totalM;
        AscendC::DataCopy(zGm[dstBlockOffset * c0Elems], nzBuf, outParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(eventID);
    }

#if NPU_ARCH == 2201
    __aicore__ inline void ComputeTileNd2nzWithCopy(
        AscendC::LocalTensor<half>& ndBuf, AscendC::LocalTensor<half>& nzBuf, int32_t eventID)
    {
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventID);

        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(eventID);

        AscendC::CopyRepeatParams copyParams;
        copyParams.dstStride = dstNzC0Stride;
        copyParams.srcStride = 1;
        copyParams.dstRepeatSize = dstNzNStride;
        copyParams.srcRepeatSize = tileW / c0Elems;

        for (uint32_t k = 0; k < tileW / vecLenHalf; ++k) {
            AscendC::Copy(
                nzBuf[k * vecLenDbs * dstNzC0Stride * c0Elems], ndBuf[k * vecLenHalf],
                static_cast<uint64_t>(vecLenHalf), static_cast<uint8_t>(tileH), copyParams);
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(eventID);
    }
#elif NPU_ARCH == 3510
    __aicore__ inline void ComputeTileNd2nzWithRegVF(
        AscendC::LocalTensor<half>& ndBuf, AscendC::LocalTensor<half>& nzBuf, int32_t eventID)
    {
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventID);

        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(eventID);
        Nd2NzRegLoadStoreVF<tileH, tileW>(
            reinterpret_cast<__ubuf__ half*>(nzBuf.GetPhyAddr()),
            reinterpret_cast<__ubuf__ half*>(ndBuf.GetPhyAddr()));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(eventID);
    }
#endif

private:
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> zGm;
};

template <uint32_t totalM, uint32_t totalN, uint32_t tileH, uint32_t tileW>
__global__ __vector__ void bank_conflict_nd2nz(__gm__ uint8* x, __gm__ uint8* z)
{
    AscendC::InitSocState();
    KernelNd2Nz<totalM, totalN, tileH, tileW> op;
    op.Init(x, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr uint32_t totalM = 8192;
    constexpr uint32_t totalN = 8192;
    constexpr uint32_t tileH = 128;
    constexpr uint32_t tileW = 128;

#if NPU_ARCH == 2201
    constexpr uint32_t numBlocks = 48;
#elif NPU_ARCH == 3510
    constexpr uint32_t numBlocks = 64;
#endif

    constexpr size_t inputByteSize = static_cast<size_t>(totalM) * totalN * sizeof(half);
    constexpr size_t outputByteSize = static_cast<size_t>(totalM) * totalN * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost = nullptr;
    uint8_t* zHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* zDevice = nullptr;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputFileSize = 0;
    if (!ReadFile("./input/input.bin", inputFileSize, xHost, inputByteSize)) {
        return 1;
    }

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    bank_conflict_nd2nz<totalM, totalN, tileH, tileW><<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
