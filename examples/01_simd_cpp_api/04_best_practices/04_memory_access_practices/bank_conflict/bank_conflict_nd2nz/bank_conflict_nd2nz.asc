/* !
 * \file bank_conflict_nd2nz.asc
 * \brief bank conflict nd2nz operator performance tuning sample
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#include <cstddef>
#include <cstdint>

#ifndef SCENARIO
#define SCENARIO 1
#endif

static_assert(SCENARIO == 1 || SCENARIO == 2, "SCENARIO must be 1 or 2");

#ifndef NPU_ARCH
#define NPU_ARCH 2201
#endif

static_assert(NPU_ARCH == 2201 || NPU_ARCH == 3510, "NPU_ARCH must be 2201 or 3510");

namespace {
#if NPU_ARCH == 2201
constexpr uint32_t ubSizeBytes = 192 * 1024;
#elif NPU_ARCH == 3510
constexpr uint32_t ubSizeBytes = 256 * 1024;
#endif

constexpr uint32_t c0Elems = 16;
constexpr uint32_t scatterLenHalf = 128;
constexpr uint32_t scatterLenDbs = scatterLenHalf / c0Elems;
constexpr uint32_t dstNzNStride = 1;
} // namespace

#if NPU_ARCH == 3510
template <uint32_t tileH, uint32_t tileW>
__simd_vf__ inline void Nd2NzRegLoadStoreVF(
    __ubuf__ half *dstAddr,
    __ubuf__ half *srcAddr)
{
    constexpr uint32_t dstNzC0Stride = (SCENARIO == 1) ? tileH : (tileH + 1);
    constexpr uint32_t scattersPerRow = tileW / scatterLenHalf;

    AscendC::Reg::RegTensor<half> reg;
    AscendC::Reg::MaskReg mask =
        AscendC::Reg::CreateMask<half, AscendC::Reg::MaskPattern::ALL>();

    for (uint16_t k = 0; k < scattersPerRow; ++k) {
        const uint32_t dstColGroupOffset = k * scatterLenDbs * dstNzC0Stride * c0Elems;

        for (uint16_t r = 0; r < tileH; ++r) {
            AscendC::Reg::LoadAlign<half>(reg, srcAddr + r * tileW + k * scatterLenHalf);

            __ubuf__ half *dstRowAddr = dstAddr + dstColGroupOffset + r * c0Elems;
            AscendC::Reg::StoreAlign<half, AscendC::Reg::DataCopyMode::DATA_BLOCK_COPY>(
                dstRowAddr, reg, dstNzC0Stride, mask);
        }
    }
}
#endif

template <uint32_t totalM, uint32_t totalN, uint32_t tileH, uint32_t tileW>
class KernelNd2Nz {
    static constexpr uint32_t inputElements = totalM * totalN;
    static constexpr uint32_t tileC0Cols = tileW / c0Elems;
    static constexpr uint32_t tileRows = totalM / tileH;
    static constexpr uint32_t tileCols = totalN / tileW;
    static constexpr uint32_t totalTiles = tileRows * tileCols;
    static constexpr uint32_t scattersPerRow = tileW / scatterLenHalf;
    static constexpr uint32_t dstNzC0Stride = (SCENARIO == 1) ? tileH : (tileH + 1);
    static constexpr uint32_t globalC0Cols = totalN / c0Elems;
    static constexpr uint32_t globalDstNzC0Stride = totalM;
    static constexpr uint32_t ndBufElems = tileH * tileW;
    static constexpr uint32_t tileOutC0Blocks =
        (tileH - 1) * dstNzNStride + (tileC0Cols - 1) * dstNzC0Stride + 1;
    static constexpr uint32_t tileOutElems = tileOutC0Blocks * c0Elems;
    static constexpr uint32_t globalOutC0Blocks =
        (totalM - 1) * dstNzNStride + (globalC0Cols - 1) * globalDstNzC0Stride + 1;
    static constexpr uint32_t outputElements = globalOutC0Blocks * c0Elems;
    static constexpr uint32_t ndBufAddr = 0;
    static constexpr uint32_t nzBufAddr = ndBufElems * sizeof(half);

    static_assert(tileW % scatterLenHalf == 0,
                  "tileW must be a multiple of one scatter instruction's half count");
    static_assert(tileC0Cols % scatterLenDbs == 0,
                  "tileC0Cols must be a multiple of one scatter instruction's DataBlock count");
    static_assert((ndBufElems + tileOutElems) * sizeof(half) <= ubSizeBytes,
                  "ndBuf + nzBuf exceeds UB size");

public:
    __aicore__ inline KernelNd2Nz() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ half *)x, inputElements);
        zGm.SetGlobalBuffer((__gm__ half *)z, outputElements);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> ndBuf(AscendC::TPosition::VECIN,  ndBufAddr, ndBufElems);
        AscendC::LocalTensor<half> nzBuf(AscendC::TPosition::VECOUT, nzBufAddr, tileOutElems);

        const uint32_t blockIdx  = AscendC::GetBlockIdx();
        const uint32_t blockNum  = AscendC::GetBlockNum();
        const uint32_t baseCount = totalTiles / blockNum;
        const uint32_t remain    = totalTiles % blockNum;
        const uint32_t tileCount = baseCount + (blockIdx < remain ? 1 : 0);
        const uint32_t startTile = blockIdx * baseCount + (blockIdx < remain ? blockIdx : remain);

        for (uint32_t i = 0; i < tileCount; ++i) {
            CopyTile(ndBuf, nzBuf, startTile + i);
        }
    }

private:
    __aicore__ inline void ScatterNd2Nz(
        AscendC::LocalTensor<half> &nzBuf,
        AscendC::LocalTensor<half> &ndBuf)
    {
#if NPU_ARCH == 2201
        AscendC::CopyRepeatParams copyParams;
        copyParams.dstStride     = dstNzC0Stride;
        copyParams.srcStride     = 1;
        copyParams.dstRepeatSize = dstNzNStride;
        copyParams.srcRepeatSize = tileW / c0Elems;

        for (uint32_t k = 0; k < scattersPerRow; ++k) {
            AscendC::Copy(nzBuf[k * scatterLenDbs * dstNzC0Stride * c0Elems],
                          ndBuf[k * scatterLenHalf],
                          static_cast<uint64_t>(scatterLenHalf),
                          static_cast<uint8_t>(tileH),
                          copyParams);
        }
#elif NPU_ARCH == 3510
        Nd2NzRegLoadStoreVF<tileH, tileW>(
            reinterpret_cast<__ubuf__ half *>(nzBuf.GetPhyAddr()),
            reinterpret_cast<__ubuf__ half *>(ndBuf.GetPhyAddr()));
#endif
    }

    __aicore__ inline void CopyTile(
        AscendC::LocalTensor<half> &ndBuf,
        AscendC::LocalTensor<half> &nzBuf,
        uint32_t tileId)
    {
        const uint32_t tileRow   = tileId / tileCols;
        const uint32_t tileCol   = tileId % tileCols;
        const uint32_t srcOffset = tileRow * tileH * totalN + tileCol * tileW;

        AscendC::DataCopyParams ndParams;
        ndParams.blockCount = tileH;
        ndParams.blockLen   = tileW / c0Elems;
        ndParams.srcStride  = (totalN - tileW) / c0Elems;
        ndParams.dstStride  = 0;
        AscendC::DataCopy(ndBuf, xGm[srcOffset], ndParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        ScatterNd2Nz(nzBuf, ndBuf);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        AscendC::DataCopyParams outParams;
        outParams.blockCount = tileC0Cols;
        outParams.blockLen   = tileH;
        outParams.srcStride  = dstNzC0Stride - tileH;
        outParams.dstStride  = globalDstNzC0Stride - tileH;

        const uint32_t dstBlockOffset =
            tileRow * tileH * dstNzNStride + tileCol * tileC0Cols * globalDstNzC0Stride;
        AscendC::DataCopy(zGm[dstBlockOffset * c0Elems], nzBuf, outParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

private:
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> zGm;
};

template <uint32_t totalM, uint32_t totalN, uint32_t tileH, uint32_t tileW>
__global__ __vector__ void bank_conflict_nd2nz(GM_ADDR x, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelNd2Nz<totalM, totalN, tileH, tileW> op;
    op.Init(x, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    (void)argc;
    (void)argv;

    constexpr uint32_t totalM = 8192;
    constexpr uint32_t totalN = 8192;
    constexpr uint32_t tileH = 128;
    constexpr uint32_t tileW = 256;

#if NPU_ARCH == 2201
    constexpr uint32_t numBlocks = 48;
#elif NPU_ARCH == 3510
    constexpr uint32_t numBlocks = 64;
#endif

    using Kernel = KernelNd2Nz<totalM, totalN, tileH, tileW>;
    constexpr size_t inputByteSize  = static_cast<size_t>(Kernel::inputElements)  * sizeof(half);
    constexpr size_t outputByteSize = static_cast<size_t>(Kernel::outputElements) * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost = nullptr;
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *zDevice = nullptr;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputFileSize = 0;
    if (!ReadFile("./input/input.bin", inputFileSize, xHost, inputByteSize)) {
        return 1;
    }

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    bank_conflict_nd2nz<totalM, totalN, tileH, tileW>
        <<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
