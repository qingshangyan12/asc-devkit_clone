/*!
 * \file bank_conflict_a5.asc
 * \brief A5 UB bank conflict verification sample
 *
 * A5 UB (Unified Buffer) structure:
 *   - 256KB total, 8 bank groups, 2 banks per group (16 banks total)
 *   - Each bank: 512 rows x 32B = 16KB
 *   - Low address interleaving: UB_ADDR = {DEPTH[8:0], BANK[0], BG[2:0], WIDTH[4:0]}
 *   - Each bank group: 2 read ports + 1 write port
 *   - 4 subbanks per bank (only relevant for gather/scatter discrete access)
 *
 * Key differences from A2/A3:
 *   - 2 read ports per BG (vs 1) -> no read-read conflict for 2-input operations
 *   - 2 banks per BG (vs 3) -> RW conflict more prevalent
 *   - Low address interleaving changes address-to-bank mapping
 *   - Bank group = 32KB (vs 64KB on A2/A3)
 *
 * 4 test cases (switch via CASE_NUM macro):
 *   Case 1: dst covers src1 -> HW delay avoids RW conflict (baseline)
 *   Case 2: dst offsets src1 -> RW conflict (~1.5x cycles)
 *   Case 3: 2 reads same bank, dst diff bank -> no conflict (A5 2-port advantage)
 *   Case 4: all 3 on same bank -> RW conflict (~1.5x cycles)
 *
 * A5 address encoding: addr = depth * 512 + bank * 256 + bg * 32 + width
 *   Addr     | depth | bank | bg
 *   0x0000   | 0     | 0    | 0
 *   0x4000   | 32    | 0    | 0
 *   0x8000   | 64    | 0    | 0
 *   0x10100  | 128   | 1    | 0
 *   0x10120  | 128   | 1    | 1
 *   0x20100  | 256   | 1    | 0
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

constexpr int32_t TOTAL_LENGTH = 4096;
constexpr int32_t A5_BANKGROUP_SIZE = 1024 * 32;
constexpr int32_t A5_BANK_SIZE = 1024 * 16;
constexpr int32_t ONE_REPEAT_SIZE = 256;

constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000;
constexpr uint32_t CASE_NUM = 1;

__aicore__ inline void Process(AscendC::GlobalTensor<float> xGm, AscendC::GlobalTensor<float> yGm,
    AscendC::GlobalTensor<float> zGm, AscendC::LocalTensor<float> xLocal, AscendC::LocalTensor<float> yLocal,
    AscendC::LocalTensor<float> zLocal)
{
    AscendC::DataCopy(xLocal, xGm, TOTAL_LENGTH);
    AscendC::DataCopy(yLocal, yGm, TOTAL_LENGTH);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::PRINTF("\n[A5] CASE_NUM = %d\n", CASE_NUM);
    AscendC::PRINTF("[A5] GetPhyAddr(xLocal) = 0x%x\n", xLocal.GetPhyAddr());
    AscendC::PRINTF("[A5] GetPhyAddr(yLocal) = 0x%x\n", yLocal.GetPhyAddr());
    AscendC::PRINTF("[A5] GetPhyAddr(zLocal) = 0x%x\n", zLocal.GetPhyAddr());

    uint32_t itemsPerIter = 256 / sizeof(float);
    uint32_t repeatTimes = TOTAL_LENGTH / itemsPerIter;
    uint64_t mask = itemsPerIter;

    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t systemCycleBefore = AscendC::GetSystemCycle();
    for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXCUTE; ++i) {
        AscendC::Mul(zLocal, xLocal, yLocal, mask, repeatTimes, {1, 1, 1, 8, 8, 8});
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t systemCycleAfter = AscendC::GetSystemCycle();
    AscendC::PRINTF("[A5] systemCycleBefore: %d\n", systemCycleBefore);
    AscendC::PRINTF("[A5] systemCycleAfter: %d\n", systemCycleAfter);
    AscendC::PRINTF("[A5] Mul x1000 total cycles: %d\n", (systemCycleAfter - systemCycleBefore));

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(zGm, zLocal, TOTAL_LENGTH);
}

extern "C" __global__ __vector__ void bank_conflict_a5_kernel(__gm__ uint8_t *x, __gm__ uint8_t *y, __gm__ uint8_t *z)
{
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ float *)x, TOTAL_LENGTH);
    yGm.SetGlobalBuffer((__gm__ float *)y, TOTAL_LENGTH);
    zGm.SetGlobalBuffer((__gm__ float *)z, TOTAL_LENGTH);

    uint32_t xLocalAddr, yLocalAddr, zLocalAddr;

    /*
     * Case 1: dst covers src1 (same address) -> HW delay avoids RW conflict
     *   src0=depth=0,bank=0  src1=depth=128,bank=1  dst=depth=128,bank=1
     */
    if constexpr (CASE_NUM == 1) {
        xLocalAddr = 0x0000;
        yLocalAddr = 0x10100;
        zLocalAddr = 0x10100;
    }
    /*
     * Case 2: dst offsets src1 by 1 BG -> RW conflict
     *   src0=depth=0,bank=0  src1=depth=128,bank=1,bg=0  dst=depth=128,bank=1,bg=1
     */
    else if constexpr (CASE_NUM == 2) {
        xLocalAddr = 0x0000;
        yLocalAddr = 0x10100;
        zLocalAddr = 0x10120;
    }
    /*
     * Case 3: 2 reads same bank (bank=0, A5 2-port no RR conflict), dst diff bank
     *   src0=depth=0,bank=0  src1=depth=32,bank=0  dst=depth=256,bank=1
     */
    else if constexpr (CASE_NUM == 3) {
        xLocalAddr = 0x0000;
        yLocalAddr = 0x4000;
        zLocalAddr = 0x20100;
    }
    /*
     * Case 4: all 3 on same bank (bank=0) -> RW conflict
     *   src0=depth=0,bank=0  src1=depth=32,bank=0  dst=depth=64,bank=0
     */
    else if constexpr (CASE_NUM == 4) {
        xLocalAddr = 0x0000;
        yLocalAddr = 0x4000;
        zLocalAddr = 0x8000;
    }

    AscendC::LocalTensor<float> xLocal(AscendC::TPosition::VECCALC, xLocalAddr, TOTAL_LENGTH);
    AscendC::LocalTensor<float> yLocal(AscendC::TPosition::VECCALC, yLocalAddr, TOTAL_LENGTH);
    AscendC::LocalTensor<float> zLocal(AscendC::TPosition::VECCALC, zLocalAddr, TOTAL_LENGTH);

    Process(xGm, yGm, zGm, xLocal, yLocal, zLocal);
}

int32_t main(int32_t argc, char *argv[])
{
    uint32_t numBlocks = 1;
    uint32_t dataLen = TOTAL_LENGTH;
    size_t inputByteSize = dataLen * sizeof(float);
    size_t outputByteSize = dataLen * sizeof(float);

    std::vector<ArgInfo> inputsInfo = {{"./input/input_x.bin", inputByteSize}, {"./input/input_y.bin", inputByteSize}};
    std::vector<ArgInfo> outputsInfo = {{"./output/output_z.bin", outputByteSize}};

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());

    for (uint32_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)(&inputHost[i]), inputsInfo[i].length);
        aclrtMalloc((void **)(&inputDevice[i]), inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(
            inputDevice[i], inputsInfo[i].length, inputHost[i], inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (uint32_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)(&outputHost[i]), outputsInfo[i].length);
        aclrtMalloc((void **)(&outputDevice[i]), outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    bank_conflict_a5_kernel<<<numBlocks, nullptr, stream>>>(inputDevice[0], inputDevice[1], outputDevice[0]);

    aclrtSynchronizeStream(stream);

    for (uint32_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }

    for (uint32_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(
            outputHost[i], outputsInfo[i].length, outputDevice[i], outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
