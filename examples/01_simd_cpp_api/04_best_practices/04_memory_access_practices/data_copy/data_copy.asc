/* !
 * \file data_copy.asc
 * \brief DataCopy best practices
 */

#include "data_copy.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <uint32_t M, uint32_t N, uint32_t NUM_BLOCKS, uint32_t SINGLE_CORE_M, uint32_t TILE_M, uint32_t BLOCK_LEN>
__global__ __vector__ void kernel_data_copy_pad_gm2ub(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    KernelDataCopyPadGm2Ub<M, N, NUM_BLOCKS, SINGLE_CORE_M, TILE_M, BLOCK_LEN> op;
    op.Init(src, dst);
    op.ProcessDataCopy();
    AscendC::PipeBarrier<PIPE_ALL>();
}

template <uint32_t M, uint32_t N, uint32_t NUM_BLOCKS, uint32_t SINGLE_CORE_M, uint32_t TILE_M, uint32_t TILE_N>
__global__ __cube__ void kernel_data_copy_gm2l1(GM_ADDR src)
{
    AscendC::InitSocState();
    KernelDataCopyGm2L1<M, N, NUM_BLOCKS, SINGLE_CORE_M, TILE_M, TILE_N> op;
    op.Init(src);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
#ifdef COPY_DST_UB
    constexpr uint32_t M = 12288;
    constexpr uint32_t N = (scenarioNum >= 4) ? 12287 : 12288;
    constexpr uint32_t TILE_M = (scenarioNum == 1 || scenarioNum == 4) ? 1 : 64;
    constexpr uint32_t BLOCK_LEN = (scenarioNum == 3 || scenarioNum == 6) ? 1024 : 64;
#elif defined(COPY_DST_L1)
    constexpr uint32_t M = 12288;
    constexpr uint32_t N = (scenarioNum >= 3) ? 12287 : 12288;
    constexpr uint32_t TILE_M = 64;
    constexpr uint32_t TILE_N = (scenarioNum == 1 || scenarioNum == 3) ? 64 : 256;
#endif

    constexpr uint32_t NUM_BLOCKS = 48;
    constexpr uint32_t SINGLE_CORE_M = M / NUM_BLOCKS;

    size_t fileSize = M * N * sizeof(half);
    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    uint8_t* inputHost;
    uint8_t* inputDevice;
    aclrtMallocHost((void**)(&inputHost), fileSize);
    aclrtMalloc((void**)&inputDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input.bin", fileSize, inputHost, fileSize);
    aclrtMemcpy(inputDevice, fileSize, inputHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

#ifdef COPY_DST_UB
    uint8_t* outputHost;
    uint8_t* outputDevice;
    aclrtMallocHost((void**)(&outputHost), fileSize);
    aclrtMalloc((void**)&outputDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
#endif

#ifdef COPY_DST_UB
    kernel_data_copy_pad_gm2ub<M, N, NUM_BLOCKS, SINGLE_CORE_M, TILE_M, BLOCK_LEN>
        <<<NUM_BLOCKS, nullptr, stream>>>(inputDevice, outputDevice);
#elif defined(COPY_DST_L1)
    kernel_data_copy_gm2l1<M, N, NUM_BLOCKS, SINGLE_CORE_M, TILE_M, TILE_N>
        <<<NUM_BLOCKS, nullptr, stream>>>(inputDevice);
#endif

    aclrtSynchronizeStream(stream);

#ifdef COPY_DST_UB
    aclrtMemcpy(outputHost, fileSize, outputDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, fileSize);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
#endif

    aclrtFree(inputDevice);
    aclrtFreeHost(inputHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
