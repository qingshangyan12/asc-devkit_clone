/* !
 * \file pre_allocation_datacopy.asc
 * \brief MTE2 Pre-Allocation样例：在double buffer的DataCopy搬运场景使能pre-allocation特性，
 *        通过同一块UB buffer承担MTE2写入与MTE3读出，构造MTE3→MTE2依赖并由pre-allocation跳过该屏障
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

constexpr uint32_t TILE_LENGTH = 1024;
constexpr uint32_t TILE_NUM = 8;
constexpr uint32_t TOTAL_LENGTH = TILE_LENGTH * TILE_NUM;
constexpr float SCALE_VALUE = 1.0f;

template <typename T>
class KernelPreAllocDataCopy {
public:
    __aicore__ inline KernelPreAllocDataCopy() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<T> bufPing(AscendC::TPosition::VECCALC, bufPingAddr, TILE_LENGTH);
        AscendC::LocalTensor<T> bufPong(AscendC::TPosition::VECCALC, bufPongAddr, TILE_LENGTH);

        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);

        for (uint32_t i = 0; i < TILE_NUM; i++) {
            int32_t eventID = (i % 2 == 0) ? EVENT_ID0 : EVENT_ID1;
            AscendC::LocalTensor<T>& buf = (i % 2 == 0) ? bufPing : bufPong;

            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
            AscendC::DataCopy(buf, xGm[i * TILE_LENGTH], TILE_LENGTH, true);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventID);
            AscendC::Adds<T>(buf, buf, static_cast<T>(SCALE_VALUE), TILE_LENGTH);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventID);
            AscendC::DataCopy(yGm[i * TILE_LENGTH], buf, TILE_LENGTH);

            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
        }
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    static constexpr uint32_t bufPingAddr = 0x0;
    static constexpr uint32_t bufPongAddr = TILE_LENGTH * sizeof(float);
};

__global__ __vector__ void pre_allocation_datacopy(GM_ADDR x, GM_ADDR y)
{
    AscendC::TPipe pipe;
    KernelPreAllocDataCopy<float> kernel;
    kernel.Init(x, y);
    kernel.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    size_t inputByteSize = static_cast<size_t>(TOTAL_LENGTH) * sizeof(float);
    size_t outputByteSize = static_cast<size_t>(TOTAL_LENGTH) * sizeof(float);
    uint8_t* xHost;
    uint8_t* yHost;
    uint8_t* xDevice;
    uint8_t* yDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    pre_allocation_datacopy<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputByteSize);
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
