/* !
 * \file mmad_mx.asc
 * \brief matmul_mxfp4_tensor_api_high_performance
 */

#include "acl/acl.h"
#include "basic_api/kernel_basic_intf.h"
#include "tensor_api/tensor.h"
#include "data_utils.h"

constexpr uint32_t SCALE_CEIL_NUMBER = 32;
constexpr uint32_t SCALE_ALIGN_NUMBER = 2;
constexpr uint32_t C0_ELEMENT_SCALE = 2;
constexpr uint32_t C0_ELEMENT_L0C = 16;
constexpr uint32_t C0_ELEMENT_B4 = 64;
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M_IDX = 0;
constexpr uint32_t N_IDX = 1;
constexpr uint32_t K_IDX = 2;

constexpr AscendC::Te::MmadTrait MX_MMAD_TRAIT = AscendC::Te::MmadTrait{0, false, false, true, AscendC::Te::MmadType::MX};
struct MmadTraitMX {
    using TraitType = AscendC::Te::MmadTrait;
    static constexpr const TraitType value = MX_MMAD_TRAIT;
};

using ProblemShape = AscendC::Te::Shape<uint32_t, uint32_t, uint32_t>;
using SingleShape = AscendC::Te::Shape<uint32_t, uint32_t, uint32_t>;
using BaseShape = AscendC::Te::Shape<uint32_t, uint32_t, uint32_t>;


template<ProblemShape problemShape, SingleShape singleShape, BaseShape baseShape, uint32_t stepK, uint32_t scaleFactorK>
class KernelMmadmx {
public:
    __aicore__ inline KernelMmadmx() {}

    __aicore__ inline void Process(__gm__ fp4x2_e1m2_t* a, __gm__ fp4x2_e1m2_t* b, __gm__ fp8_e8m0_t* as, __gm__ fp8_e8m0_t* bs, __gm__ bfloat16_t* c)
    {
        InitComputeParams();

        // Init GM tensor
        auto gmTensorA = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(a), AscendC::Te::MakeFrameLayout<NDExtLayoutPtn>(M, K));
        auto gmTensorB = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(b), AscendC::Te::MakeFrameLayout<AscendC::Te::DNExtLayoutPtn>(K, N));
       
        auto gmTensorAs = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(as), AscendC::Te::MakeFrameLayout<ScaleANDLayoutPtn>(M, scaleK));
        auto gmTensorBs = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(bs), AscendC::Te::MakeFrameLayout<ScaleBDNLayoutPtn>(scaleK, N));
        auto gmTensorC = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(c), AscendC::Te::MakeFrameLayout<NDExtLayoutPtn>(M, N));

        // Slice single core tensor
        auto gmSingleTensorA = gmTensorA.Slice(AscendC::Te::MakeCoord(mIterIdx * singleCoreM, 0), AscendC::Te::MakeShape(actualSingleCoreM, singleCoreK));
        auto gmSingleTensorB = gmTensorB.Slice(AscendC::Te::MakeCoord(0, nIterIdx * singleCoreN), AscendC::Te::MakeShape(singleCoreK, actualSingleCoreN));
        auto gmSingleTensorAs = gmTensorAs.Slice(AscendC::Te::MakeCoord(mIterIdx * singleCoreM, 0), AscendC::Te::MakeShape(actualSingleCoreM, scaleK));
        auto gmSingleTensorBs = gmTensorBs.Slice(AscendC::Te::MakeCoord(0, nIterIdx * singleCoreN), AscendC::Te::MakeShape(scaleK, actualSingleCoreN));
        auto gmSingleTensorC = gmTensorC.Slice(AscendC::Te::MakeCoord(mIterIdx * singleCoreM, nIterIdx * singleCoreN), AscendC::Te::MakeShape(actualSingleCoreM, actualSingleCoreN));

        ProcessLoop(gmSingleTensorA, gmSingleTensorB, gmSingleTensorAs, gmSingleTensorBs, gmSingleTensorC);
    
    }

private:
    // TODO: A5同步用Mutex.lock/unlock
    __aicore__ inline int32_t GetDataEventId(uint32_t pingPongIdx) const
    {
        return (pingPongIdx == 0) ? EVENT_ID0 : EVENT_ID1;
    }

    __aicore__ inline int32_t GetScaleEventId(uint32_t pingPongIdx) const
    {
        return (pingPongIdx == 0) ? EVENT_ID2 : EVENT_ID3;
    }

    __aicore__ inline int32_t GetL0EventId(uint32_t pingPongIdx) const
    {
        return (pingPongIdx == 0) ? EVENT_ID0 : EVENT_ID1;
    }


    // Main loop of matrix multiplication, including L1 prefetching, L1 to L0 copy, Mmad compute, and L0 to GM copy
    template <typename TensorA, typename TensorB, typename TensorAs, typename TensorBs, typename TensorC>
    __aicore__ inline void ProcessLoop(const TensorA& a, const TensorB& b, const TensorAs& as, const TensorBs& bs, TensorC& c)
    {
        constexpr auto l1LayoutA = AscendC::Te::MakeFrameLayout<AscendC::Te::NZLayoutPtn, C0_ELEMENT_B4>(baseM, baseK * stepK);
        constexpr auto l1LayoutB = AscendC::Te::MakeFrameLayout<AscendC::Te::ZNLayoutPtn, C0_ELEMENT_B4>(baseK * stepK, baseN);
        constexpr auto l1LayoutAs = AscendC::Te::MakeFrameLayout<AscendC::Te::ZZLayoutPtn, C0_ELEMENT_SCALE>(baseM, baseScaleK * stepK * scaleFactorK);
        constexpr auto l1LayoutBs = AscendC::Te::MakeFrameLayout<AscendC::Te::NNLayoutPtn, C0_ELEMENT_SCALE>(baseScaleK * stepK * scaleFactorK, baseN);

        // Malloc L1 and L0 buffers
        __cbuf__ fp4x2_e1m2_t l1BufAPing[l1SizeA / 2];
        __cbuf__ fp4x2_e1m2_t l1BufAPong[l1SizeA / 2];
        __cbuf__ fp4x2_e1m2_t l1BufBPing[l1SizeB / 2];
        __cbuf__ fp4x2_e1m2_t l1BufBPong[l1SizeB / 2];
        __cbuf__ fp8_e8m0_t l1BufAsPing[l1SizeAs];
        __cbuf__ fp8_e8m0_t l1BufAsPong[l1SizeAs];
        __cbuf__ fp8_e8m0_t l1BufBsPing[l1SizeBs];
        __cbuf__ fp8_e8m0_t l1BufBsPong[l1SizeBs];
        __ca__ fp4x2_e1m2_t l0BufAPing[l0SizeA / 2];
        __ca__ fp4x2_e1m2_t l0BufAPong[l0SizeA / 2];
        __cb__ fp4x2_e1m2_t l0BufBPing[l0SizeB / 2];
        __cb__ fp4x2_e1m2_t l0BufBPong[l0SizeB / 2];
        __cc__ float l0BufC[l0SizeC];
        
        auto l0PtrAPing = AscendC::Te::MakeMemPtr(l0BufAPing);
        auto l0PtrAPong = AscendC::Te::MakeMemPtr(l0BufAPong);
        auto l0PtrBPing = AscendC::Te::MakeMemPtr(l0BufBPing);
        auto l0PtrBPong = AscendC::Te::MakeMemPtr(l0BufBPong);
        auto l0PtrAsPing = AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0A, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0BufAPing));
        auto l0PtrAsPong = AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0A, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0BufAPong));
        auto l0PtrBsPing = AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0B, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0BufBPing));
        auto l0PtrBsPong = AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0B, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0BufBPong));

        auto l1TensorAPing = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufAPing), l1LayoutA);
        auto l1TensorAPong = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufAPong), l1LayoutA);
        auto l1TensorBPing = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufBPing), l1LayoutB);
        auto l1TensorBPong = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufBPong), l1LayoutB);
        auto l1TensorAsPing = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufAsPing), l1LayoutAs);
        auto l1TensorAsPong = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufAsPong), l1LayoutAs);
        auto l1TensorBsPing = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufBsPing), l1LayoutBs);
        auto l1TensorBsPong = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr(l1BufBsPong), l1LayoutBs);
        

        // ============================================================
        // 同步标志初始化：反向同步需预置，防止首次 WaitFlag 死锁
        // ============================================================
        // MTE1_MTE2 (反向): DataCopyIn 可覆盖通知
        // EVENT_ID0: A/B Ping 可写 | EVENT_ID1: A/B Pong 可写
        // EVENT_ID2: As/Bs Ping 可写 | EVENT_ID3: As/Bs Pong 可写
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        // M_MTE1 (反向): L0 双缓冲，DataLoad 可覆盖通知
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);

        // ============================================================
        // N/M 外层循环 + K 主循环
        // ============================================================
        for (uint32_t nBlockIdx = 0; nBlockIdx < nLoopCount; nBlockIdx++) {
            uint16_t curN = (nBlockIdx + 1 == nLoopCount) ? tailN : baseN;
            for (uint32_t mBlockIdx = 0; mBlockIdx < mLoopCount; mBlockIdx++) {
                uint16_t curM = (mBlockIdx + 1 == mLoopCount) ? tailM : baseM;
                // 每个 (mBlockIdx, nBlockIdx) 子块重置 DataCopyIn 进度
                uint32_t dataNextKChunkIdx = 0;  // A/B 下一次 DataCopyIn 要搬的 K 方向大包索引
                uint32_t scaleNextKChunkIdx = 0; // As/Bs 下一次 DataCopyIn 要搬的 K 方向大包索引
                uint8_t dataCopyInIdx = 0;       // A/B 下一次 DataCopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)
                uint8_t scaleCopyInIdx = 0;      // As/Bs 下一次 DataCopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)

                // ---- 搬入 A/B 以及 As/Bs 的首个大包 ----
                int32_t dataWriteEvent = GetDataEventId(dataCopyInIdx);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(dataWriteEvent); // A/B Ping 可写
              
                constexpr uint32_t stepCurK = dataChunkStep * baseK;
                // A: GM -> L1
                AscendC::Te::Copy(gm2L1Atom, l1TensorAPing, a.Slice(AscendC::Te::MakeCoord(mBlockIdx * baseM, dataNextKChunkIdx * baseK), AscendC::Te::MakeShape(curM, stepCurK)));
                // B: GM -> L1
                AscendC::Te::Copy(gm2L1Atom, l1TensorBPing, b.Slice(AscendC::Te::MakeCoord(dataNextKChunkIdx * baseK, nBlockIdx * baseN), AscendC::Te::MakeShape(stepCurK, curN)));

                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(dataWriteEvent); // A/B Ping 数据就绪
                dataNextKChunkIdx += dataChunkStep;
                dataCopyInIdx ^= 1; // 下次写 Pong

                int32_t scaleWriteEvent = GetScaleEventId(scaleCopyInIdx);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(scaleWriteEvent); // As/Bs Ping 可写
                
                constexpr uint32_t stepCurScaleK = AscendC::AlignUp(AscendC::DivCeil(scaleChunkStep * baseK, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
                // scaleA: GM -> L1
                AscendC::Te::Copy(gm2L1Atom, l1TensorAsPing, as.Slice(AscendC::Te::MakeCoord(mBlockIdx * baseM, scaleNextKChunkIdx * baseScaleK), AscendC::Te::MakeShape(curM, stepCurScaleK)));
                // scaleB: GM -> L1
                AscendC::Te::Copy(gm2L1Atom, l1TensorBsPing, bs.Slice(AscendC::Te::MakeCoord(scaleNextKChunkIdx * baseScaleK, nBlockIdx * baseN), AscendC::Te::MakeShape(stepCurScaleK, curN)));

                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(scaleWriteEvent); // As/Bs Ping 数据就绪
                scaleNextKChunkIdx += scaleChunkStep;
                scaleCopyInIdx ^= 1;

                auto l0LayoutC = MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_L0C>(curM, curN);
                auto l0TensorC = MakeTensor(MakeMemPtr(l0BufC), l0LayoutC);

                // ---- K 方向主循环 ----
                for (uint32_t kBlockIdx = 0; kBlockIdx < kLoopCount; kBlockIdx++) {
                    constexpr uint16_t curK = baseK;
                    // 确定当前 kBlockIdx 对应的 L1 读取缓冲区（Ping/Pong）
                    uint32_t dataReadIdx = (kBlockIdx / dataChunkStep) % 2;
                    uint32_t scaleReadIdx = (kBlockIdx / scaleChunkStep) % 2;
                    uint32_t kOffsetInDataChunk = kBlockIdx % dataChunkStep;
                    uint32_t kOffsetInScaleChunk = kBlockIdx % scaleChunkStep;

                    const auto& l1ReadBufA = (dataReadIdx == 0) ? l1TensorAPing : l1TensorAPong;
                    const auto& l1ReadBufB = (dataReadIdx == 0) ? l1TensorBPing : l1TensorBPong;
                    const auto& l1ReadBufAs = (scaleReadIdx == 0) ? l1TensorAsPing : l1TensorAsPong;
                    const auto& l1ReadBufBs = (scaleReadIdx == 0) ? l1TensorBsPing : l1TensorBsPong;


                    auto l0LayoutA = MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_B4>(curM, curK);
                    auto l0LayoutB = MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT_B4>(curK, curN);
                    auto l0TensorAPing = MakeTensor(l0PtrAPing, l0LayoutA);
                    auto l0TensorAPong = MakeTensor(l0PtrAPong, l0LayoutA);
                    auto l0TensorBPing = MakeTensor(l0PtrBPing, l0LayoutB);
                    auto l0TensorBPong = MakeTensor(l0PtrBPong, l0LayoutB);

                    constexpr uint32_t curScaleK = AscendC::AlignUp(AscendC::DivCeil(curK, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
                    auto l0LayoutAs = MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(curM, curScaleK);
                    auto l0LayoutBs = MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(curScaleK, curN);
                    auto l0TensorAsPing = MakeTensor(l0PtrAsPing, l0LayoutAs);
                    auto l0TensorAsPong = MakeTensor(l0PtrAsPong, l0LayoutAs);
                    auto l0TensorBsPing = MakeTensor(l0PtrBsPing, l0LayoutBs);
                    auto l0TensorBsPong = MakeTensor(l0PtrBsPong, l0LayoutBs);

                    // L0 双缓冲选择
                    const auto& l0TensorA = (mte1DBFlag == 0) ? l0TensorAPing : l0TensorAPong;
                    const auto& l0TensorB = (mte1DBFlag == 0) ? l0TensorBPing : l0TensorBPong;
                    const auto& l0TensorAs = (mte1DBFlag == 0) ? l0TensorAsPing : l0TensorAsPong;
                    const auto& l0TensorBs = (mte1DBFlag == 0) ? l0TensorBsPing : l0TensorBsPong;

                    // ---- 反向同步：等待上一轮 Compute 释放 L0 缓冲区 ----
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(GetL0EventId(mte1DBFlag));

                    // ---- 正向同步：等待 L1 大包数据就绪（仅大包中首元素需等待） ----
                    if (kOffsetInDataChunk == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(GetDataEventId(dataReadIdx));
                    }
                    if (kOffsetInScaleChunk == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(GetScaleEventId(scaleReadIdx));
                    }

                    // ---- DataLoad: L1 → L0 ----
                    // A:L1 -> L0A
                    AscendC::Te::Copy(l12l0AAtom, l0TensorA, l1ReadBufA.Slice(AscendC::Te::MakeCoord(0, kOffsetInDataChunk * baseK), AscendC::Te::MakeShape(curM, curK)));
                    // B:L1 -> L0B
                    AscendC::Te::Copy(l12l0BAtom, l0TensorB, l1ReadBufB.Slice(AscendC::Te::MakeCoord(kOffsetInDataChunk * baseK, 0), AscendC::Te::MakeShape(curK, curN)));

                    // scaleA:L1 -> L0AScale
                    AscendC::Te::Copy(l12l0AAtom, l0TensorAs, l1ReadBufAs.Slice(AscendC::Te::MakeCoord(0, kOffsetInScaleChunk * baseScaleK), AscendC::Te::MakeShape(curM, curScaleK)));
                    // scaleB:L1 -> L0BScale
                    AscendC::Te::Copy(l12l0BAtom, l0TensorBs, l1ReadBufBs.Slice(AscendC::Te::MakeCoord(kOffsetInScaleChunk * baseScaleK, 0), AscendC::Te::MakeShape(curScaleK, curN)));

                    // ---- 反向同步：当前 L1 大包消费完毕，通知 DataCopyIn 可覆盖 ----
                    if (((kOffsetInDataChunk + 1) == dataChunkStep) || (kBlockIdx + 1 == kLoopCount)) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(GetDataEventId(dataReadIdx));
                    }
                    if (((kOffsetInScaleChunk + 1) == scaleChunkStep) || (kBlockIdx + 1 == kLoopCount)) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(GetScaleEventId(scaleReadIdx));
                    }

                    // ---- Compute: Mmad 矩阵乘累加 ----
                    // MTE1_M 正向同步：等待 MTE1 完成 L1 → L0 搬运
                    int32_t l0Event = GetL0EventId(mte1DBFlag);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0Event);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0Event);
                    MmadParams mmadParams{curM, curN, curK, 0, true};
                    mmadParams.cmatrixInitVal = (kBlockIdx == 0);
                    // TODO: 后续会新增MxMmad
                    Mmad(mmadAtom.with(mmadParams), l0TensorC, l0TensorA, l0TensorB);
                    // M_MTE1 反向同步：通知下一轮 DataLoad 可以覆盖 L0 缓冲区
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0Event);
                    mte1DBFlag ^= 1;

                    // ---- 搬入下一个 L1 大包，使 DataCopyIn 与 Compute 流水重叠 ----
                    // 触发条件：
                    //   (1) kBlockIdx == 0：首个 K 块计算时，A1/B1 Pong 尚未使用，可直接搬入
                    //   (2) 当前 L1 大包最后一个 baseK 被消费完，该缓冲区可被覆盖
                    if (((kBlockIdx == 0) || ((kOffsetInDataChunk + 1) == dataChunkStep)) &&
                        dataNextKChunkIdx < kLoopCount) {
                        const auto& l1WriteBufA = (dataCopyInIdx == 0) ? l1TensorAPing : l1TensorAPong;
                        const auto& l1WriteBufB = (dataCopyInIdx == 0) ? l1TensorBPing : l1TensorBPong;
                        int32_t dataWriteEvent = GetDataEventId(dataCopyInIdx);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(dataWriteEvent);
                        // A: GM -> L1
                        AscendC::Te::Copy(gm2L1Atom, l1WriteBufA, a.Slice(AscendC::Te::MakeCoord(mBlockIdx * baseM, dataNextKChunkIdx * baseK), AscendC::Te::MakeShape(curM, stepCurK)));
                        // B: GM -> L1
                        AscendC::Te::Copy(gm2L1Atom, l1WriteBufB, b.Slice(AscendC::Te::MakeCoord(dataNextKChunkIdx * baseK, nBlockIdx * baseN), AscendC::Te::MakeShape(stepCurK, curN)));
                                

                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(dataWriteEvent);
                        dataNextKChunkIdx += dataChunkStep;
                        dataCopyInIdx ^= 1;
                    }
                    if (((kBlockIdx == 0) || ((kOffsetInScaleChunk + 1) == scaleChunkStep)) &&
                        scaleNextKChunkIdx < kLoopCount) {
                        const auto& l1WriteBufAs = (scaleCopyInIdx == 0) ? l1TensorAsPing : l1TensorAsPong;
                        const auto& l1WriteBufBs = (scaleCopyInIdx == 0) ? l1TensorBsPing : l1TensorBsPong;
                        int32_t scaleWriteEvent = GetScaleEventId(scaleCopyInIdx);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(scaleWriteEvent);
                        // scaleA: GM -> L1
                        AscendC::Te::Copy(gm2L1Atom, l1WriteBufAs, as.Slice(AscendC::Te::MakeCoord(mBlockIdx * baseM, scaleNextKChunkIdx * baseScaleK), AscendC::Te::MakeShape(curM, stepCurScaleK)));
                        // scaleB: GM -> L1
                        AscendC::Te::Copy(gm2L1Atom, l1WriteBufBs, bs.Slice(AscendC::Te::MakeCoord(scaleNextKChunkIdx * baseScaleK, nBlockIdx * baseN), AscendC::Te::MakeShape(stepCurScaleK, curN)));

                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(scaleWriteEvent);
                        scaleNextKChunkIdx += scaleChunkStep;
                        scaleCopyInIdx ^= 1;
                    }
                }
                // ---- CopyOut: L0C → GM ----
                AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                FixpipeParams fixpipeParams;
                // L0C -> GM
                AscendC::Te::Copy(l0c2GmAtom.with(fixpipeParams), c.Slice(AscendC::Te::MakeCoord(mBlockIdx * baseM, nBlockIdx * baseN), AscendC::Te::MakeShape(curM, curN)), l0TensorC);

                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
            }
        }

        // ============================================================
        // 4. 等待所有同步完成
        // ============================================================
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);

    }

    __aicore__ inline void InitComputeParams()
    {
        // ---- 1. 计算当前核在 M/N 方向的迭代索引，确定 GM 起始偏移 ----
        constexpr uint32_t mIter = AscendC::DivCeil(M, singleCoreM);
        mIterIdx = AscendC::GetBlockIdx() % mIter;
        nIterIdx = AscendC::GetBlockIdx() / mIter;

        // ---- 2. 计算当前核实际的 M/N 维度大小（最后一块可能不满 singleCore） ----
        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        // ---- 3. 计算 M/N/K 三个维度的循环次数 ----
        mLoopCount = AscendC::DivCeil(actualSingleCoreM, baseM);
        nLoopCount = AscendC::DivCeil(actualSingleCoreN, baseN);
        kLoopCount = AscendC::DivCeil(singleCoreK, baseK);

        // ---- 4. 计算 M/N 方向分块参数 ----
        tailM = (actualSingleCoreM % baseM != 0) ? actualSingleCoreM % baseM : baseM;
        tailN = (actualSingleCoreN % baseN != 0) ? actualSingleCoreN % baseN : baseN;
    }


private:
    uint32_t actualSingleCoreM, actualSingleCoreN;
    uint32_t mIterIdx, nIterIdx;
    uint32_t mLoopCount, nLoopCount, kLoopCount;
    uint32_t tailM, tailN;
    uint8_t mte1DBFlag = 0;

    static constexpr uint32_t M = AscendC::Get<M_IDX>(problemShape);
    static constexpr uint32_t N = AscendC::Get<N_IDX>(problemShape);
    static constexpr uint32_t K = AscendC::Get<K_IDX>(problemShape);

    static constexpr uint32_t singleCoreM = AscendC::Get<M_IDX>(singleShape);
    static constexpr uint32_t singleCoreN = AscendC::Get<N_IDX>(singleShape);
    static constexpr uint32_t singleCoreK = AscendC::Get<K_IDX>(singleShape);

    static constexpr uint32_t baseM = AscendC::Get<M_IDX>(baseShape);
    static constexpr uint32_t baseN = AscendC::Get<N_IDX>(baseShape);
    static constexpr uint32_t baseK = AscendC::Get<K_IDX>(baseShape);

    static constexpr uint32_t scaleK = AscendC::AlignUp(AscendC::DivCeil(K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
    static constexpr uint32_t baseScaleK = AscendC::AlignUp(AscendC::DivCeil(baseK, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);

    static constexpr size_t l1SizeA = baseM * (baseK * stepK);
    static constexpr size_t l1SizeB = (baseK * stepK) * baseN;
    static constexpr size_t l1SizeAs = baseM * (baseScaleK * stepK * scaleFactorK);
    static constexpr size_t l1SizeBs = (baseScaleK * stepK * scaleFactorK) * baseN;

    static constexpr size_t l0SizeA = baseM * baseK;
    static constexpr size_t l0SizeB = baseK * baseN;
    static constexpr size_t l0SizeC = baseM * baseN;

    static constexpr auto gm2L1Atom = CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{};
    static constexpr auto l12l0AAtom = CopyAtom<CopyTraits<CopyL12L0A, CopyL12L0ATraitDefault>>{};
    static constexpr auto l12l0BAtom = CopyAtom<CopyTraits<CopyL12L0B, CopyL12L0BTraitDefault>>{};
    static constexpr auto l0c2GmAtom = CopyAtom<CopyTraits<CopyL0C2GM, CopyL0C2GMTraitDefault>>{};
    static constexpr auto mmadAtom = MmadAtom<MmadTraits<MmadOperation, MmadTraitMX>>{};

    static constexpr uint32_t dataChunkStep = stepK;
    static constexpr uint32_t scaleChunkStep = stepK * scaleFactorK;

};
// TODO: 新增KernelTrait结构体，静态参数放在里面
template <uint32_t M, uint32_t K, uint32_t N, uint32_t singleCoreM,uint32_t singleCoreK, uint32_t singleCoreN, 
            uint32_t baseM, uint32_t baseK, uint32_t baseN, uint32_t stepK, uint32_t scaleFactorK>
__global__ __cube__ void mmadmx_custom(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c) { // 使用具体数据类型
    AscendC::InitSocState();
    KernelMmadmx<M, K, N, singleCoreM, singleCoreK, singleCoreN, baseM, baseK, baseN, stepK, scaleFactorK> op;
    op.Process(a, b, as, bs, c);

    AscendC::PipeBarrier<PIPE_ALL>();
}


int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 8192;
    constexpr uint32_t K = 8192;
    constexpr uint32_t N = 8192;
    constexpr ProblemShape problemShape = AscendC::Te::MakeShape(M, N, K);
    
    constexpr uint32_t singleCoreM = 2048;
    constexpr uint32_t singleCoreK = 8192;
    constexpr uint32_t singleCoreN = 1024;
    constexpr SingleShape singleShape = AscendC::Te::MakeShape(singleCoreM, singleCoreN, singleCoreK);

    constexpr uint32_t baseM = 256;
    constexpr uint32_t baseK = 256;
    constexpr uint32_t baseN = 256;
    constexpr BaseShape baseShape = AscendC::Te::MakeShape(baseM, baseN, baseK);

    constexpr uint32_t stepK = 2;
    constexpr uint32_t scaleFactorK = 4;

    constexpr uint32_t numBlocks = 32;

    constexpr uint32_t scaleKUnaligned = (K + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER;
    constexpr uint32_t sK = ((scaleKUnaligned + SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER) * SCALE_ALIGN_NUMBER;

    size_t aFileSize = static_cast<size_t>(M * K) * sizeof(uint8_t) / 2;
    size_t bFileSize = static_cast<size_t>(N * K) * sizeof(uint8_t) / 2;
    size_t asFileSize = static_cast<size_t>(M * sK) * sizeof(uint8_t);
    size_t bsFileSize = static_cast<size_t>(N * sK) * sizeof(uint8_t);
    size_t cFileSize = M * N * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* asHost;
    uint8_t* asDevice;
    aclrtMallocHost((void**)(&asHost), asFileSize);
    aclrtMalloc((void**)&asDevice, asFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_scale_gm.bin", asFileSize, asHost, asFileSize);
    aclrtMemcpy(asDevice, asFileSize, asHost, asFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bsHost;
    uint8_t* bsDevice;
    aclrtMallocHost((void**)(&bsHost), bsFileSize);
    aclrtMalloc((void**)&bsDevice, bsFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_scale_gm.bin", bsFileSize, bsHost, bsFileSize);
    aclrtMemcpy(bsDevice, bsFileSize, bsHost, bsFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmadmx_custom<
        problemShape, singleShape, baseShape, stepK, scaleFactorK><<<numBlocks, nullptr, stream>>>(aDevice, bDevice, asDevice, bsDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(asDevice);
    aclrtFreeHost(asHost);
    aclrtFree(bsDevice);
    aclrtFreeHost(bsHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
