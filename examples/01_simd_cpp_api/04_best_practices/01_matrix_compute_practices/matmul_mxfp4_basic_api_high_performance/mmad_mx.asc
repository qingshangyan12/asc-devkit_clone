/* !
 * \file mmad_mx.asc
 * \brief matmul_mxfp4_basic_api_high_performance
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;
constexpr uint32_t L0_PINGPONG_BYTES = 32 * 1024;
constexpr uint32_t L1_PINGPONG_BYTES = 256 * 1024;
constexpr bool IS_B_TRANSPOSE = true;
constexpr bool IS_BS_TRANSPOSE = true;
constexpr uint32_t SCALE_CEIL_NUMBER = 32;
constexpr uint32_t SCALE_ALIGN_NUMBER = 2;
constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN,
          uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
          uint32_t stepKa, uint32_t stepKb, uint32_t scaleFactorKa, uint32_t scaleFactorKb>
class KernelMmadmx {
    // Common compile-time constants to avoid duplicated formulas and unit confusion.
    static constexpr uint32_t PACKED_K = AscendC::DivCeil(K, 2); // fp4x2 elements per row, 2 fp4 packed in uint8 （只有在gm2l1的时候调用nd2nzparam用）
    static constexpr uint32_t SCALE_K = AscendC::AlignUp(AscendC::DivCeil(K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
    static constexpr uint32_t PACKED_BASE_K = AscendC::DivCeil(baseK, 2);

public:
    __aicore__ inline KernelMmadmx()
    {

    }
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c)
    {
        aGMOri.SetGlobalBuffer((__gm__ fp4x2_e1m2_t *)a);
        bGMOri.SetGlobalBuffer((__gm__ fp4x2_e1m2_t *)b);
        asGMOri.SetGlobalBuffer((__gm__ fp8_e8m0_t *)as);
        bsGMOri.SetGlobalBuffer((__gm__ fp8_e8m0_t *)bs);
        cGMOri.SetGlobalBuffer((__gm__ bfloat16_t *)c);
    }

    __aicore__ inline void Process()
    {
        InitComputeParams();

        // ============================================================
        // 1. Buffer 分配：L1 / L0 双缓冲 Ping-Pong 布局
        // ============================================================
        // L1: A1 + AS1 Ping/Pong (0~256KB), B1 + BS1 Ping/Pong (256~512KB)
        // L0: A2/B2 Ping/Pong (0~32KB / 32KB~64KB)
        // L0AMX L0BMX 无需考虑地址（占4KB）
        // A/B in L1 are fp4x2 packed tensors, so K-span uses packed width.
        constexpr uint32_t a1BufSize = baseM * AscendC::DivCeil(baseK * stepKa, 2);
        constexpr uint32_t b1BufSize = baseN * AscendC::DivCeil(baseK * stepKb, 2);
        constexpr uint32_t as1BufSize = baseM * AscendC::DivCeil(baseK * stepKa, SCALE_CEIL_NUMBER) * scaleFactorKa;
        constexpr uint32_t bs1BufSize = baseN * AscendC::DivCeil(baseK * stepKb, SCALE_CEIL_NUMBER) * scaleFactorKb;
        static_assert(2 * a1BufSize + 2 * as1BufSize <= L1_PINGPONG_BYTES,
            "A/As ping-pong L1 footprint exceeds 256KB");
        static_assert(2 * b1BufSize + 2 * bs1BufSize <= L1_PINGPONG_BYTES,
            "B/Bs ping-pong L1 footprint exceeds 256KB");
        uint32_t a2PingpongSize = baseM * baseK;
        uint32_t b2PingpongSize = baseK * baseN;

        // A1: L1 Ping/Pong
        AscendC::LocalTensor<fp4x2_e1m2_t> a1LocalPing(AscendC::TPosition::A1, 0, a1BufSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> a1LocalPong(AscendC::TPosition::A1, a1BufSize, a1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> as1LocalPing(AscendC::TPosition::A1, 2 * a1BufSize, as1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> as1LocalPong(AscendC::TPosition::A1, 2 * a1BufSize + as1BufSize, as1BufSize);

        // B1: L1 Ping/Pong
        AscendC::LocalTensor<fp4x2_e1m2_t> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1BufSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> b1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1BufSize, b1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> bs1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES + 2 * b1BufSize, bs1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> bs1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + 2 * b1BufSize + bs1BufSize, bs1BufSize);

        // A2: L0 Ping/Pong  32KB
        AscendC::LocalTensor<fp4x2_e1m2_t> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);
        // B2: L0 Ping/Pong  32KB
        AscendC::LocalTensor<fp4x2_e1m2_t> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);

        // CO1: L0C
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        ProcessLoop(a1LocalPing, a1LocalPong, as1LocalPing, as1LocalPong,
                       a2LocalPing, a2LocalPong,
                       b1LocalPing, b1LocalPong, bs1LocalPing, bs1LocalPong,
                       b2LocalPing, b2LocalPong, cLocal);
    }

    // ============================================================
    // L2 Cache 优化：双重外层循环（M 维度 + N 维度分批）
    // ============================================================
    __aicore__ inline void ProcessL2Cache()
    {
        // ---- Step 1: Buffer 分配：L1 / L0 双缓冲 Ping-Pong 布局
        // A/B in L1 are fp4x2 packed tensors, so K-span uses packed width.
        constexpr uint32_t a1BufSize = baseM * AscendC::DivCeil(baseK * stepKa, 2);
        constexpr uint32_t b1BufSize = baseN * AscendC::DivCeil(baseK * stepKb, 2);
        constexpr uint32_t as1BufSize = baseM * AscendC::DivCeil(baseK * stepKa, SCALE_CEIL_NUMBER) * scaleFactorKa;
        constexpr uint32_t bs1BufSize = baseN * AscendC::DivCeil(baseK * stepKb, SCALE_CEIL_NUMBER) * scaleFactorKb;
        static_assert(2 * a1BufSize + 2 * as1BufSize <= L1_PINGPONG_BYTES,
            "A/As ping-pong L1 footprint exceeds 256KB");
        static_assert(2 * b1BufSize + 2 * bs1BufSize <= L1_PINGPONG_BYTES,
            "B/Bs ping-pong L1 footprint exceeds 256KB");
        uint32_t a2PingpongSize = baseM * baseK;
        uint32_t b2PingpongSize = baseK * baseN;

        AscendC::LocalTensor<fp4x2_e1m2_t> a1LocalPing(AscendC::TPosition::A1, 0, a1BufSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> a1LocalPong(AscendC::TPosition::A1, a1BufSize, a1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> as1LocalPing(AscendC::TPosition::A1, 2 * a1BufSize, as1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> as1LocalPong(AscendC::TPosition::A1, 2 * a1BufSize + as1BufSize, as1BufSize);

        AscendC::LocalTensor<fp4x2_e1m2_t> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1BufSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> b1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1BufSize, b1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> bs1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES + 2 * b1BufSize, bs1BufSize);
        AscendC::LocalTensor<fp8_e8m0_t> bs1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + 2 * b1BufSize + bs1BufSize, bs1BufSize);

        AscendC::LocalTensor<fp4x2_e1m2_t> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        AscendC::LocalTensor<fp4x2_e1m2_t> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        // ---- Step 2: 计算分批参数
        constexpr uint32_t mIterTotal = AscendC::DivCeil(M, singleCoreM);
        constexpr uint32_t nIterTotal = AscendC::DivCeil(N, singleCoreN);
        // 每轮 numBlocks 核覆盖的 M 份数
        constexpr uint32_t mIterPerRound = AscendC::DivCeil(M, singleCoreM * 2); // 2 轮 M
        // 外层循环轮数
        constexpr uint32_t outerMLoopCount = AscendC::DivCeil(mIterTotal, mIterPerRound);

        // ---- Step 3: outerMIdx/outerNIdx 外层循环
        for (uint32_t outerMIdx = 0; outerMIdx < outerMLoopCount; outerMIdx++) {
            uint32_t mIterIdx = AscendC::GetBlockIdx() % mIterPerRound + outerMIdx * mIterPerRound;
            uint32_t nIterIdx = AscendC::GetBlockIdx() / mIterPerRound;

            // 边界保护：当 M/N 不能被整除时，最后一轮部分核会超出子块范围，直接跳过
            if (mIterIdx >= mIterTotal || nIterIdx >= nIterTotal) continue;

            // 根据子块坐标计算 GM 偏移、循环次数、尾块参数等
            InitComputeParamsL2Cache(mIterIdx, nIterIdx);

            // 执行当前子块的完整 N/M/K 循环计算
            ProcessLoop(a1LocalPing, a1LocalPong, as1LocalPing, as1LocalPong,
                           a2LocalPing, a2LocalPong,
                           b1LocalPing, b1LocalPong, bs1LocalPing, bs1LocalPong,
                           b2LocalPing, b2LocalPong, cLocal);

            // 每轮外层循环后重置双缓冲 flag
            mte1DBFlag = 0;
        }
    }

private:
    // N/M/K 主循环：执行当前核的完整计算
    __aicore__ inline void ProcessLoop(
        AscendC::LocalTensor<fp4x2_e1m2_t> &a1LocalPing, AscendC::LocalTensor<fp4x2_e1m2_t> &a1LocalPong,
        AscendC::LocalTensor<fp8_e8m0_t> &as1LocalPing, AscendC::LocalTensor<fp8_e8m0_t> &as1LocalPong,
        AscendC::LocalTensor<fp4x2_e1m2_t> &a2LocalPing, AscendC::LocalTensor<fp4x2_e1m2_t> &a2LocalPong,
        AscendC::LocalTensor<fp4x2_e1m2_t> &b1LocalPing, AscendC::LocalTensor<fp4x2_e1m2_t> &b1LocalPong,
        AscendC::LocalTensor<fp8_e8m0_t> &bs1LocalPing, AscendC::LocalTensor<fp8_e8m0_t> &bs1LocalPong,
        AscendC::LocalTensor<fp4x2_e1m2_t> &b2LocalPing, AscendC::LocalTensor<fp4x2_e1m2_t> &b2LocalPong,
        AscendC::LocalTensor<float> &cLocal)
    {
        // ============================================================
        // 1. DataCopyIn 进度跟踪变量
        // ============================================================
        uint32_t a1NextKChunkIdx = 0;  // A 下一次 DataCopyIn 要搬的 K 方向大包索引
        uint32_t b1NextKChunkIdx = 0;  // B 下一次 DataCopyIn 要搬的 K 方向大包索引
        uint32_t as1NextKChunkIdx = 0; // As 下一次 DataCopyIn 要搬的 K 方向大包索引
        uint32_t bs1NextKChunkIdx = 0; // Bs 下一次 DataCopyIn 要搬的 K 方向大包索引
        uint8_t a1CopyInIdx = 0;       // A 下一次 DataCopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)
        uint8_t b1CopyInIdx = 0;       // B 下一次 DataCopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)
        uint8_t as1CopyInIdx = 0;      // As 下一次 DataCopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)
        uint8_t bs1CopyInIdx = 0;      // Bs 下一次 DataCopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)
        constexpr uint32_t asChunkStep = stepKa * scaleFactorKa;
        constexpr uint32_t bsChunkStep = stepKb * scaleFactorKb;

        // ============================================================
        // 2. 同步标志初始化：反向同步需预置，防止首次 WaitFlag 死锁
        // ============================================================
        // MTE1_MTE2 (反向): DataCopyIn 可覆盖通知
        //   flag 0: A1 Ping 可写 | flag 1: A1 Pong 可写
        //   flag 2: B1 Ping 可写 | flag 3: B1 Pong 可写
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(0);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(2);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(3);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(4);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(5);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(6);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(7);
        // M_MTE1 (反向): L0 双缓冲，DataLoad 可覆盖通知
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(0);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(1);

        // ============================================================
        // 3. N/M 外层循环 + K 主循环
        // ============================================================
        for (uint32_t nBlockIdx = 0; nBlockIdx < nLoopCount; nBlockIdx++) {
            for (uint32_t mBlockIdx = 0; mBlockIdx < mLoopCount; mBlockIdx++) {
                // 每个 (mBlockIdx, nBlockIdx) 子块重置 DataCopyIn 进度
                a1NextKChunkIdx = 0;
                b1NextKChunkIdx = 0;
                as1NextKChunkIdx = 0;
                bs1NextKChunkIdx = 0;
                a1CopyInIdx = 0;
                b1CopyInIdx = 0;
                as1CopyInIdx = 0;
                bs1CopyInIdx = 0;

                // ---- 搬入 A1/B1 以及 As1/Bs1 的首个大包 ----
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(0);  // A1 Ping 可写
                DataCopyInA(a1LocalPing, a1NextKChunkIdx, mBlockIdx);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(0);   // A1 Ping 数据就绪
                a1NextKChunkIdx += stepKa;
                a1CopyInIdx ^= 1;  // 下次写 Pong

                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(4);  // As1 Ping 可写
                DataCopyInAs(as1LocalPing, as1NextKChunkIdx, mBlockIdx);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(4);   // As1 Ping 数据就绪
                as1NextKChunkIdx += asChunkStep;
                as1CopyInIdx ^= 1;

                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(2);  // B1 Ping 可写
                DataCopyInB(b1LocalPing, b1NextKChunkIdx, nBlockIdx);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(2);   // B1 Ping 数据就绪
                b1NextKChunkIdx += stepKb;
                b1CopyInIdx ^= 1;  // 下次写 Pong

                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(6);  // Bs1 Ping 可写
                DataCopyInBs(bs1LocalPing, bs1NextKChunkIdx, nBlockIdx);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(6);   // Bs1 Ping 数据就绪
                bs1NextKChunkIdx += bsChunkStep;
                bs1CopyInIdx ^= 1;

                // ---- K 方向主循环 ----
                for (uint32_t kBlockIdx = 0; kBlockIdx < kLoopCount; kBlockIdx++) {
                    // 确定当前 kBlockIdx 对应的 L1 读取缓冲区（Ping/Pong）
                    uint32_t a1ReadIdx = (kBlockIdx / stepKa) % 2;
                    uint32_t b1ReadIdx = (kBlockIdx / stepKb) % 2;
                    uint32_t as1ReadIdx = (kBlockIdx / asChunkStep) % 2;
                    uint32_t bs1ReadIdx = (kBlockIdx / bsChunkStep) % 2;
                    uint32_t kOffsetInChunkA = kBlockIdx % stepKa;
                    uint32_t kOffsetInChunkB = kBlockIdx % stepKb;
                    uint32_t kOffsetInScaleChunkA = kBlockIdx % asChunkStep;
                    uint32_t kOffsetInScaleChunkB = kBlockIdx % bsChunkStep;

                    AscendC::LocalTensor<fp4x2_e1m2_t> a1ReadBuf = (a1ReadIdx == 0) ? a1LocalPing : a1LocalPong;
                    AscendC::LocalTensor<fp4x2_e1m2_t> b1ReadBuf = (b1ReadIdx == 0) ? b1LocalPing : b1LocalPong;
                    AscendC::LocalTensor<fp8_e8m0_t> as1ReadBuf = (as1ReadIdx == 0) ? as1LocalPing : as1LocalPong;
                    AscendC::LocalTensor<fp8_e8m0_t> bs1ReadBuf = (bs1ReadIdx == 0) ? bs1LocalPing : bs1LocalPong;

                    // L0 双缓冲选择
                    AscendC::LocalTensor<fp4x2_e1m2_t> a2Local = (mte1DBFlag == 0) ? a2LocalPing : a2LocalPong;
                    AscendC::LocalTensor<fp4x2_e1m2_t> b2Local = (mte1DBFlag == 0) ? b2LocalPing : b2LocalPong;

                    // ---- 反向同步：等待上一轮 Compute 释放 L0 缓冲区 ----
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag);

                    // ---- 正向同步：等待 L1 大包数据就绪（仅大包中首元素需等待） ----
                    if (kOffsetInChunkA == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(a1ReadIdx);
                    }
                    if (kOffsetInChunkB == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(b1ReadIdx + 2);
                    }
                    if (kOffsetInScaleChunkA == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(as1ReadIdx + 4);
                    }
                    if (kOffsetInScaleChunkB == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(bs1ReadIdx + 6);
                    }

                    // ---- DataLoad: L1 → L0 ----
                    DataLoadA(a1ReadBuf, as1ReadBuf, a2Local, mBlockIdx, kOffsetInChunkA, kOffsetInScaleChunkA);
                    DataLoadB(b1ReadBuf, bs1ReadBuf, b2Local, nBlockIdx, kOffsetInChunkB, kOffsetInScaleChunkB);

                    // ---- 反向同步：当前 L1 大包消费完毕，通知 DataCopyIn 可覆盖 ----
                    if ((kOffsetInChunkA + 1) == stepKa) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(a1ReadIdx);
                    }
                    if ((kOffsetInChunkB + 1) == stepKb) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(b1ReadIdx + 2);
                    }
                    if (((kOffsetInScaleChunkA + 1) == asChunkStep) || (kBlockIdx + 1 == kLoopCount)) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(as1ReadIdx + 4);
                    }
                    if (((kOffsetInScaleChunkB + 1) == bsChunkStep) || (kBlockIdx + 1 == kLoopCount)) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bs1ReadIdx + 6);
                    }

                    // ---- Compute: Mmad 矩阵乘累加 ----
                    Compute(cLocal, a2Local, b2Local, kBlockIdx, mBlockIdx, nBlockIdx);

                    // ---- 搬入下一个 L1 大包，使 DataCopyIn 与 Compute 流水重叠 ----
                    // 触发条件：
                    //   (1) kBlockIdx == 0：首个 K 块计算时，A1/B1 Pong 尚未使用，可直接搬入
                    //   (2) 当前 L1 大包最后一个 baseK 被消费完，该缓冲区可被覆盖
                    if (((kBlockIdx == 0) || ((kOffsetInChunkB + 1) == stepKb)) && b1NextKChunkIdx < kLoopCount) {
                        AscendC::LocalTensor<fp4x2_e1m2_t> b1WriteBuf = (b1CopyInIdx == 0) ? b1LocalPing : b1LocalPong;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(b1CopyInIdx + 2);
                        DataCopyInB(b1WriteBuf, b1NextKChunkIdx, nBlockIdx);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(b1CopyInIdx + 2);
                        b1NextKChunkIdx += stepKb;
                        b1CopyInIdx ^= 1;
                    }
                    if (((kBlockIdx == 0) || ((kOffsetInChunkA + 1) == stepKa)) && a1NextKChunkIdx < kLoopCount) {
                        AscendC::LocalTensor<fp4x2_e1m2_t> a1WriteBuf = (a1CopyInIdx == 0) ? a1LocalPing : a1LocalPong;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(a1CopyInIdx);
                        DataCopyInA(a1WriteBuf, a1NextKChunkIdx, mBlockIdx);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(a1CopyInIdx);
                        a1NextKChunkIdx += stepKa;
                        a1CopyInIdx ^= 1;
                    }
                    if (((kBlockIdx == 0) || ((kOffsetInScaleChunkA + 1) == asChunkStep)) && as1NextKChunkIdx < kLoopCount) {
                        AscendC::LocalTensor<fp8_e8m0_t> as1WriteBuf = (as1CopyInIdx == 0) ? as1LocalPing : as1LocalPong;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(as1CopyInIdx + 4);
                        DataCopyInAs(as1WriteBuf, as1NextKChunkIdx, mBlockIdx);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(as1CopyInIdx + 4);
                        as1NextKChunkIdx += asChunkStep;
                        as1CopyInIdx ^= 1;
                    }
                    if (((kBlockIdx == 0) || ((kOffsetInScaleChunkB + 1) == bsChunkStep)) && bs1NextKChunkIdx < kLoopCount) {
                        AscendC::LocalTensor<fp8_e8m0_t> bs1WriteBuf = (bs1CopyInIdx == 0) ? bs1LocalPing : bs1LocalPong;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bs1CopyInIdx + 6);
                        DataCopyInBs(bs1WriteBuf, bs1NextKChunkIdx, nBlockIdx);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(bs1CopyInIdx + 6);
                        bs1NextKChunkIdx += bsChunkStep;
                        bs1CopyInIdx ^= 1;
                    }
                }
                // ---- CopyOut: CO1 → GM ----
                CopyOut(cLocal, mBlockIdx, nBlockIdx);
            }
        }

        // ============================================================
        // 4. 等待所有同步完成
        // ============================================================
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(0);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(3);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(4);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(6);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(7);
    }

    __aicore__ inline void InitComputeParams()
    {
        // ---- 1. 计算当前核在 M/N 方向的迭代索引，确定 GM 起始偏移 ----
        constexpr uint32_t mIter = AscendC::DivCeil(M, singleCoreM);
        uint32_t mIterIdx = AscendC::GetBlockIdx() % mIter;
        uint32_t nIterIdx = AscendC::GetBlockIdx() / mIter;

        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        uint64_t gmOffsetAs = mIterIdx * singleCoreM * SCALE_K;
        uint64_t gmOffsetBs = IS_BS_TRANSPOSE ? nIterIdx * SCALE_K * singleCoreN : nIterIdx * singleCoreN;
        aGM = aGMOri[gmOffsetA];
        bGM = bGMOri[gmOffsetB];
        asGM = asGMOri[gmOffsetAs];
        bsGM = bsGMOri[gmOffsetBs];
        cGM = cGMOri[gmOffsetC];

        // ---- 2. 计算当前核实际的 M/N 维度大小（最后一块可能不满 singleCore） ----
        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        // ---- 3. 计算 K/M/N 三个维度的循环次数 ----
        kLoopCount = AscendC::DivCeil(singleCoreK, baseK);
        mLoopCount = AscendC::DivCeil(actualSingleCoreM, baseM);
        nLoopCount = AscendC::DivCeil(actualSingleCoreN, baseN);

        // ---- 4. 计算 N 方向分块参数：完整 baseN 块数 + 尾块大小及对齐 ----
        baseNCount = actualSingleCoreN / baseN;
        tailN = actualSingleCoreN % baseN;
        tailNAlign = AscendC::DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;

        // ---- 5. 计算 M 方向分块参数：完整 baseM 块数 + 尾块大小及对齐 ----
        baseMCount = actualSingleCoreM / baseM;
        tailM = actualSingleCoreM % baseM;
        tailMAlign = AscendC::DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
    }

    // 根据子块索引设置当前子块的全部计算参数
    // mIterIdx: 当前核在 M 方向的子块索引
    // nIterIdx: 当前核在 N 方向的子块索引
    __aicore__ inline void InitComputeParamsL2Cache(uint32_t mIterIdx, uint32_t nIterIdx)
    {
        // ----  计算当前子块在 GM 中的起始偏移 ----
        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        uint64_t gmOffsetAs = mIterIdx * singleCoreM * SCALE_K;
        uint64_t gmOffsetBs = IS_BS_TRANSPOSE ? nIterIdx * SCALE_K * singleCoreN : nIterIdx * singleCoreN;
        aGM = aGMOri[gmOffsetA];
        bGM = bGMOri[gmOffsetB];
        asGM = asGMOri[gmOffsetAs];
        bsGM = bsGMOri[gmOffsetBs];
        cGM = cGMOri[gmOffsetC];

        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        kLoopCount = AscendC::DivCeil(singleCoreK, baseK);
        mLoopCount = AscendC::DivCeil(actualSingleCoreM, baseM);
        nLoopCount = AscendC::DivCeil(actualSingleCoreN, baseN);
        baseNCount = actualSingleCoreN / baseN;
        tailN = actualSingleCoreN % baseN;
        tailNAlign = AscendC::DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;

        baseMCount = actualSingleCoreM / baseM;
        tailM = actualSingleCoreM % baseM;
        tailMAlign = AscendC::DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
    }

    // GM → A1: 将 A 矩阵的一个大包 (stepKa 个 baseK) 搬入 L1，同时搬入对应的 scale 数据
    // kChunkIdx: K 方向大包索引，用于计算 GM 读取偏移
    // mBlockIdx: M 方向 baseM 块索引，用于计算 GM 读取偏移及判断尾块
    __aicore__ inline void DataCopyInA(AscendC::LocalTensor<fp4x2_e1m2_t> a1Local, uint32_t kChunkIdx, uint32_t mBlockIdx)
    {
        // NOTE:
        // aGM/a1Local 的元素类型是 fp4x2_e1m2_t（1 个元素打包 2 个 fp4）。
        // 因此 DataCopy 的宽度/步长/偏移都要按“打包后元素个数”计算：
        // packedK = ceil(K / 2)，而不是按原始 fp4 元素个数 K。
        // 尾块使用 tailM，否则使用 baseM
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        constexpr uint32_t packedStepK = AscendC::DivCeil(baseK * stepKa, 2);
        AscendC::Nd2NzParams nd2nzA1Params;
        nd2nzA1Params.ndNum = 1;
        nd2nzA1Params.nValue = curM;
        // Nd2Nz on fp4x2 buffers must use packed-K (fp4x2 element count), not logical fp4 count.
        nd2nzA1Params.dValue = packedStepK;
        // 源操作数两个相邻的nd矩阵之间的起始地址偏移
        nd2nzA1Params.srcNdMatrixStride = 0;
        // 源操作数同一nd矩阵间的相邻行的起始地址偏移（packed K）
        nd2nzA1Params.srcDValue = PACKED_K;
        // nd转换到nz格式后，目的nz矩阵中，同一行的数据切成多行他们的起始地址间隔，单位为32B
        nd2nzA1Params.dstNzC0Stride = baseM;
        // ND矩阵的第x行和第x+1行转换为nz格式之后在dst中的偏移
        nd2nzA1Params.dstNzNStride = 1;
        nd2nzA1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kChunkIdx * baseK + mBlockIdx * K * baseM], nd2nzA1Params);
    }

    __aicore__ inline void DataCopyInAs(AscendC::LocalTensor<fp8_e8m0_t> as1Local, uint32_t kChunkIdx, uint32_t mBlockIdx)
    {
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        constexpr uint32_t stepScaleK = AscendC::DivCeil(baseK * stepKa * scaleFactorKa, SCALE_CEIL_NUMBER);
        static_assert(stepScaleK % 2 == 0, "stepScaleK should be 2B aligned for Dn2Nz.b16");
        static_assert(baseK % 64 == 0, "baseK must be 64-aligned for b16 scale copy offset");
        uint32_t scaleOffset = (kChunkIdx * baseK) / SCALE_CEIL_NUMBER;
        // Scale 为 fp8(1B)，硬件在 MX 路径下要求 K 方向按 2B 连续搬运；
        // 因此将 2 个 fp8 视作 1 个 b16，使用 Dn2Nz 完成 [M, stepScaleK] -> K-major/NZ 布局。
        AscendC::Dn2NzParams dn2nzParams;
        dn2nzParams.dnNum = 1;
        dn2nzParams.dValue = curM;
        dn2nzParams.nValue = stepScaleK / 2;
        dn2nzParams.srcDnMatrixStride = 0;
        dn2nzParams.srcDValue = SCALE_K / 2;
        dn2nzParams.dstNzC0Stride = stepScaleK / 2;
        dn2nzParams.dstNzNStride = 1;
        dn2nzParams.dstNzMatrixStride = 0;

        AscendC::GlobalTensor<half> asGMB16;
        asGMB16.SetGlobalBuffer(((__gm__ half *)(asGM.GetPhyAddr())) + (mBlockIdx * baseM * SCALE_K + scaleOffset) / 2,
                                curM * (SCALE_K / 2));
        auto asLocalB16 = as1Local.ReinterpretCast<half>();
        AscendC::DataCopy(asLocalB16, asGMB16, dn2nzParams);
    }

    // GM → A1 scale (ND直拷版本，保留用于对比验证；默认流程不调用)
    __aicore__ inline void DataCopyInAsNd(AscendC::LocalTensor<fp8_e8m0_t> as1Local, uint32_t kChunkIdx, uint32_t mBlockIdx)
    {
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        constexpr uint32_t stepScaleK = AscendC::DivCeil(baseK * stepKa * scaleFactorKa, SCALE_CEIL_NUMBER);
        uint32_t scaleOffset = (kChunkIdx * baseK) / SCALE_CEIL_NUMBER;
        if constexpr ((stepScaleK % 32) == 0) {
            AscendC::DataCopyParams scaleCopyParams;
            scaleCopyParams.blockCount = curM;
            scaleCopyParams.blockLen = stepScaleK / 32;
            scaleCopyParams.srcStride = (SCALE_K - stepScaleK) / 32;
            scaleCopyParams.dstStride = 0;
            AscendC::DataCopy(as1Local, asGM[mBlockIdx * baseM * SCALE_K + scaleOffset], scaleCopyParams);
        } else {
            for (uint32_t row = 0; row < curM; ++row) {
                AscendC::DataCopy(as1Local[row * stepScaleK],
                                  asGM[(mBlockIdx * baseM + row) * SCALE_K + scaleOffset],
                                  stepScaleK);
            }
        }
    }

    // GM → B1: 将 B 矩阵的一个大包 (stepKb 个 baseK) 搬入 L1，同时搬入对应的 scale 数据
    // kChunkIdx: K 方向大包索引，用于计算 GM 读取偏移
    // nBlockIdx: N 方向 baseN 块索引，用于计算 GM 读取偏移及判断尾块
    __aicore__ inline void DataCopyInB(AscendC::LocalTensor<fp4x2_e1m2_t> b1Local, uint32_t kChunkIdx, uint32_t nBlockIdx)
    {
        // NOTE:
        // bGM/b1Local 同样是 fp4x2_e1m2_t，地址与 stride 也都按 packedK=ceil(K/2) 计。
        // 只有 Mmad 参数里的 k 才是逻辑 fp4 元素个数 K。
        // 尾块使用 tailN，否则使用 baseN
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        constexpr uint32_t packedStepK = AscendC::DivCeil(baseK * stepKb, 2);
        AscendC::Nd2NzParams nd2nzB1Params;
        if constexpr (!IS_B_TRANSPOSE) {
            nd2nzB1Params.ndNum = 1;
            nd2nzB1Params.nValue = packedStepK;
            nd2nzB1Params.dValue = curN;
            nd2nzB1Params.srcNdMatrixStride = 0;
            nd2nzB1Params.srcDValue = N;
            nd2nzB1Params.dstNzC0Stride = packedStepK;
            nd2nzB1Params.dstNzNStride = 1;
            nd2nzB1Params.dstNzMatrixStride = 0;
            AscendC::DataCopy(b1Local, bGM[kChunkIdx * baseK * N + nBlockIdx * baseN], nd2nzB1Params);
        } else {
            nd2nzB1Params.ndNum = 1;
            nd2nzB1Params.nValue = curN;
            nd2nzB1Params.dValue = packedStepK;
            nd2nzB1Params.srcNdMatrixStride = 0;
            nd2nzB1Params.srcDValue = PACKED_K;
            nd2nzB1Params.dstNzC0Stride = baseN;
            nd2nzB1Params.dstNzNStride = 1;
            nd2nzB1Params.dstNzMatrixStride = 0;
            AscendC::DataCopy(b1Local, bGM[kChunkIdx * baseK + nBlockIdx * baseN * K], nd2nzB1Params);
        }
    }

    __aicore__ inline void DataCopyInBs(AscendC::LocalTensor<fp8_e8m0_t> bs1Local, uint32_t kChunkIdx, uint32_t nBlockIdx)
    {
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        constexpr uint32_t stepScaleK = AscendC::DivCeil(baseK * stepKb * scaleFactorKb, SCALE_CEIL_NUMBER);
        static_assert(stepScaleK % 2 == 0, "stepScaleK should be 2B aligned for Dn2Nz.b16");
        static_assert(baseK % 64 == 0, "baseK must be 64-aligned for b16 scale copy offset");
        uint32_t scaleOffset = (kChunkIdx * baseK) / SCALE_CEIL_NUMBER;
        // 与 A scale 同理：按 b16 视图做 Dn2Nz，保证后续 LOAD_MX_2D 读到的 scale 排布正确。
        AscendC::Dn2NzParams dn2nzParams;
        dn2nzParams.dnNum = 1;
        dn2nzParams.dValue = curN;
        dn2nzParams.nValue = stepScaleK / 2;
        dn2nzParams.srcDnMatrixStride = 0;
        dn2nzParams.srcDValue = SCALE_K / 2;
        dn2nzParams.dstNzC0Stride = stepScaleK / 2;
        dn2nzParams.dstNzNStride = 1;
        dn2nzParams.dstNzMatrixStride = 0;

        AscendC::GlobalTensor<half> bsGMB16;
        bsGMB16.SetGlobalBuffer(((__gm__ half *)(bsGM.GetPhyAddr())) + (nBlockIdx * baseN * SCALE_K + scaleOffset) / 2,
                                curN * (SCALE_K / 2));
        auto bsLocalB16 = bs1Local.ReinterpretCast<half>();
        AscendC::DataCopy(bsLocalB16, bsGMB16, dn2nzParams);
    }

    // GM → B1 scale (ND直拷版本，保留用于对比验证；默认流程不调用)
    __aicore__ inline void DataCopyInBsNd(AscendC::LocalTensor<fp8_e8m0_t> bs1Local, uint32_t kChunkIdx, uint32_t nBlockIdx)
    {
        if constexpr (!IS_BS_TRANSPOSE) {
            return;
        }
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        constexpr uint32_t stepScaleK = AscendC::DivCeil(baseK * stepKb * scaleFactorKb, SCALE_CEIL_NUMBER);
        uint32_t scaleOffset = (kChunkIdx * baseK) / SCALE_CEIL_NUMBER;
        if constexpr ((stepScaleK % 32) == 0) {
            AscendC::DataCopyParams scaleCopyParams;
            scaleCopyParams.blockCount = curN;
            scaleCopyParams.blockLen = stepScaleK / 32;
            scaleCopyParams.srcStride = (SCALE_K - stepScaleK) / 32;
            scaleCopyParams.dstStride = 0;
            AscendC::DataCopy(bs1Local, bsGM[nBlockIdx * baseN * SCALE_K + scaleOffset], scaleCopyParams);
        } else {
            for (uint32_t row = 0; row < curN; ++row) {
                AscendC::DataCopy(bs1Local[row * stepScaleK],
                                  bsGM[(nBlockIdx * baseN + row) * SCALE_K + scaleOffset],
                                  stepScaleK);
            }
        }
    }

    // A1 → A2: 将 L1 中的一个 baseM * baseK 切片搬入 L0 (MX 格式含 scale)
    // mBlockIdx: M 方向 baseM 块索引，用于判断尾块对齐
    // kOffsetInChunkA: 当前 base块 在大包内的偏移序号 (0 ~ stepKa-1)
    __aicore__ inline void DataLoadA(AscendC::LocalTensor<fp4x2_e1m2_t> a1Local, AscendC::LocalTensor<fp8_e8m0_t> as1Local,
                                     AscendC::LocalTensor<fp4x2_e1m2_t> a2Local, uint32_t mBlockIdx,
                                     uint32_t kOffsetInChunkA, uint32_t kOffsetInScaleChunkA)
    {
        // For fp4x2 LocalTensor indexing in LoadData path, use logical fp4 K span to avoid half-step addressing.
        uint32_t srcAddr = kOffsetInChunkA * baseK * baseM;
        uint32_t scaleSrcAddr = (kOffsetInScaleChunkA * baseK / SCALE_CEIL_NUMBER) * CUBE_BLOCK;
        // 尾块使用对齐后的 tailMAlign，保证 LoadData 地址对齐
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;

        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        // 以m*k为例 ，m轴方向搬运长度，单位为16 element
        loadDataParams.mStep = AscendC::DivCeil(curMAlign, CUBE_BLOCK);
        // 以m*k为例 ，m轴方向搬运长度，单位为32B
        loadDataParams.kStep = AscendC::DivCeil(baseK, 64);
        // k方向前一个分形起始地址与后一个分形起始地址的间隔，单位为512B
        loadDataParams.srcStride = AscendC::DivCeil(baseM, CUBE_BLOCK);
        // 目标矩阵K方向前一个分形起始地址与后一个分形起始地址的间隔，单位为512B
        loadDataParams.dstStride = AscendC::DivCeil(curMAlign, CUBE_BLOCK);
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = false;
        AscendC::LoadData2DMxParams loadMxDataParams;
        loadMxDataParams.xStartPosition = 0;
        loadMxDataParams.yStartPosition = 0;
        // m维度，单位为1个分型
        loadMxDataParams.xStep = AscendC::DivCeil(curMAlign, CUBE_BLOCK);
        // k维度，单位为32B
        loadMxDataParams.yStep = AscendC::DivCeil(baseK, 64);
        loadMxDataParams.srcStride = AscendC::DivCeil(baseK * stepKa * scaleFactorKa, 64);
        loadMxDataParams.dstStride = AscendC::DivCeil(baseK, 64) ;
        AscendC::LoadData(a2Local, a1Local[srcAddr], as1Local[scaleSrcAddr], loadDataParams, loadMxDataParams);
    }

    // B1 → B2: 将 L1 中的一个 baseK * baseN 切片搬入 L0 (MX 格式含 scale)
    // nBlockIdx: N 方向 baseN 块索引，用于判断尾块对齐
    // kOffsetInChunkB: 当前 base块 在大包内的偏移序号 (0 ~ stepKb-1)
    __aicore__ inline void DataLoadB(AscendC::LocalTensor<fp4x2_e1m2_t> b1Local, AscendC::LocalTensor<fp8_e8m0_t> bs1Local,
                                     AscendC::LocalTensor<fp4x2_e1m2_t> b2Local, uint32_t nBlockIdx,
                                     uint32_t kOffsetInChunkB, uint32_t kOffsetInScaleChunkB)
    {
        uint32_t srcAddr = kOffsetInChunkB * baseK * (IS_B_TRANSPOSE ? baseN : CUBE_BLOCK);
        uint32_t scaleSrcAddr = (kOffsetInScaleChunkB * baseK / SCALE_CEIL_NUMBER) * CUBE_BLOCK;
        // 尾块使用对齐后的 tailNAlign，保证 LoadData 地址对齐
        uint32_t curNAlign = (nBlockIdx != baseNCount) ? baseN : tailNAlign;

        AscendC::LoadData2DParamsV2 loadDataParamsB;
        loadDataParamsB.mStartPosition = 0;
        loadDataParamsB.kStartPosition = 0;
        loadDataParamsB.mStep = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
        loadDataParamsB.kStep = AscendC::DivCeil(baseK, 64);
        loadDataParamsB.srcStride = AscendC::DivCeil(baseN, CUBE_BLOCK);
        loadDataParamsB.dstStride = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
        loadDataParamsB.ifTranspose = false;
        AscendC::LoadData2DMxParams loadMxDataParams;
        loadMxDataParams.xStartPosition = 0;
        loadMxDataParams.yStartPosition = 0;
        loadMxDataParams.xStep = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
        loadMxDataParams.yStep = AscendC::DivCeil(baseK, 64);
        loadMxDataParams.srcStride = AscendC::DivCeil(baseK * stepKb * scaleFactorKb, 64);
        loadMxDataParams.dstStride = AscendC::DivCeil(baseK, 64);
        AscendC::LoadData(b2Local, b1Local[srcAddr], bs1Local[scaleSrcAddr], loadDataParamsB, loadMxDataParams);

    }

    // A2 * B2 → CO1: 执行一次 Mmad 矩阵乘累加，A矩阵大小 baseM * baseK，B矩阵 baseK * baseN
    // kBlockIdx: K 方向 baseK 块索引，用于判断是否首次累加
    // mBlockIdx/nBlockIdx: M/N 方向块索引，用于判断尾块实际尺寸
    __aicore__ inline void Compute(AscendC::LocalTensor<float> cLocal,
                                   AscendC::LocalTensor<fp4x2_e1m2_t> a2Local, AscendC::LocalTensor<fp4x2_e1m2_t> b2Local,
                                   uint32_t kBlockIdx, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // MTE1_M 正向同步：等待 MTE1 完成 L1 → L0 搬运
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        // 尾块使用 tailM/tailN，否则使用 baseM/baseN
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::MmadParams mmadParams;
        mmadParams.m = curM;
        mmadParams.n = curN;
        mmadParams.k = baseK;
        mmadParams.cmatrixInitVal = (kBlockIdx == 0);
        mmadParams.unitFlag = (kBlockIdx != kLoopCount - 1) ? 2 : 3;    //开启 UnitFlag
        AscendC::Mmad(cLocal, a2Local, b2Local, mmadParams);
        // M_MTE1 反向同步：通知下一轮 DataLoad 可以覆盖 L0 缓冲区
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag);
        mte1DBFlag ^= 1;
    }

    // CO1 → GM: 将计算结果从 L0C 写回 Global Memory
    // mBlockIdx/nBlockIdx: M/N 方向块索引，用于计算 GM 写入偏移及判断尾块尺寸
    __aicore__ inline void CopyOut(AscendC::LocalTensor<float> cLocal, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // 尾块使用对齐后的 tailMAlign 作为 srcStride，使用 tailM/tailN 作为实际行列数
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = curN;
        fixpipeParams.mSize = curM;
        fixpipeParams.srcStride = curMAlign;
        fixpipeParams.dstStride = N;
        fixpipeParams.quantPre = QuantMode_t::F322BF16;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        fixpipeParams.unitFlag = 3;
        AscendC::Fixpipe(cGM[mBlockIdx * baseM * N + nBlockIdx * baseN], cLocal, fixpipeParams);
    }

private:
    AscendC::GlobalTensor<fp4x2_e1m2_t> aGM;
    AscendC::GlobalTensor<fp4x2_e1m2_t> bGM;
    AscendC::GlobalTensor<fp8_e8m0_t> asGM;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGM;
    AscendC::GlobalTensor<bfloat16_t> cGM;
    AscendC::GlobalTensor<fp4x2_e1m2_t> aGMOri;
    AscendC::GlobalTensor<fp4x2_e1m2_t> bGMOri;
    AscendC::GlobalTensor<fp8_e8m0_t> asGMOri;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGMOri;
    AscendC::GlobalTensor<bfloat16_t> cGMOri;
    uint32_t actualSingleCoreM, actualSingleCoreN;
    uint32_t mLoopCount, nLoopCount, kLoopCount;
    uint32_t baseMCount, baseNCount;
    uint32_t tailM, tailN;
    uint32_t tailMAlign, tailNAlign;
    uint8_t mte1DBFlag = 0;
};

template <uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN,
          uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
          uint32_t stepKa, uint32_t stepKb, uint32_t scaleFactorKa, uint32_t scaleFactorKb>
__global__  __cube__ void mmadmx_custom(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c)
{
    AscendC::InitSocState();
    KernelMmadmx<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN,
               stepKa, stepKb, scaleFactorKa, scaleFactorKb> op;
    op.Init(a, b, as, bs, c);
    if constexpr (scenarioNum == 1) {
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        op.ProcessL2Cache();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t M = 8192;
    constexpr uint32_t K = 8192;
    constexpr uint32_t N = 8192;
    constexpr uint32_t baseM = 256;
    constexpr uint32_t baseK = 256;
    constexpr uint32_t baseN = 256;
    constexpr uint32_t singleCoreM = 2048;
    constexpr uint32_t singleCoreK = 8192;
    constexpr uint32_t singleCoreN = 1024;

    constexpr uint32_t stepKa = 2;
    constexpr uint32_t stepKb = 2;
    constexpr uint32_t scaleFactorKa = 2;
    constexpr uint32_t scaleFactorKb = 2;

    constexpr uint32_t numBlocks = 32;

    constexpr uint32_t scaleKUnaligned = (K + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER;
    constexpr uint32_t sK = ((scaleKUnaligned + SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER) * SCALE_ALIGN_NUMBER;

    size_t aFileSize = static_cast<size_t>(M * K) * sizeof(uint8_t) / 2;
    size_t bFileSize = static_cast<size_t>(N * K) * sizeof(uint8_t) / 2;
    size_t asFileSize = static_cast<size_t>(M * sK) * sizeof(uint8_t);
    size_t bsFileSize = static_cast<size_t>(N * sK) * sizeof(uint8_t);
    size_t cFileSize = M * N * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* asHost;
    uint8_t* asDevice;
    aclrtMallocHost((void**)(&asHost), asFileSize);
    aclrtMalloc((void**)&asDevice, asFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_scale_gm.bin", asFileSize, asHost, asFileSize);
    aclrtMemcpy(asDevice, asFileSize, asHost, asFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bsHost;
    uint8_t* bsDevice;
    aclrtMallocHost((void**)(&bsHost), bsFileSize);
    aclrtMalloc((void**)&bsDevice, bsFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_scale_gm.bin", bsFileSize, bsHost, bsFileSize);
    aclrtMemcpy(bsDevice, bsFileSize, bsHost, bsFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmadmx_custom<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN,
                stepKa, stepKb, scaleFactorKa, scaleFactorKb>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, asDevice, bsDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(asDevice);
    aclrtFreeHost(asHost);
    aclrtFree(bsDevice);
    aclrtFreeHost(bsHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
