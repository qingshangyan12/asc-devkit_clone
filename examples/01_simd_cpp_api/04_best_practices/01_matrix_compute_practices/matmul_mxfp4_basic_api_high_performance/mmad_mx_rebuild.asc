/* !
 * \file mmad_mx_rebuild.asc
 * \brief matmul_mxfp4 basic api rebuild from scratch
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t SCALE_CEIL_NUMBER = 32;
constexpr uint32_t SCALE_ALIGN_NUMBER = 2;
constexpr uint32_t TILE_M = 128;
constexpr uint32_t TILE_K = 256;
constexpr uint32_t TILE_N = 128;

template <uint32_t M, uint32_t K, uint32_t N>
class KernelMmadMxRebuild {
public:
    __aicore__ inline KernelMmadMxRebuild() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c)
    {
        aGM.SetGlobalBuffer((__gm__ fp4x2_e1m2_t *)a);
        bGM.SetGlobalBuffer((__gm__ fp4x2_e1m2_t *)b);
        asGM.SetGlobalBuffer((__gm__ fp8_e8m0_t *)as);
        bsGM.SetGlobalBuffer((__gm__ fp8_e8m0_t *)bs);
        cGM.SetGlobalBuffer((__gm__ bfloat16_t *)c);
    }

    __aicore__ inline void Process()
    {
        constexpr uint32_t packedK = AscendC::DivCeil(K, 2);
        constexpr uint32_t scaleK = AscendC::AlignUp(AscendC::DivCeil(K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
        constexpr uint32_t packedTileK = AscendC::DivCeil(TILE_K, 2);
        constexpr uint32_t tileScaleK = AscendC::AlignUp(AscendC::DivCeil(TILE_K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
        static_assert(TILE_M % CUBE_BLOCK == 0 && TILE_N % CUBE_BLOCK == 0,
            "TILE_M/TILE_N should be 16-aligned");
        static_assert(TILE_K % SCALE_CEIL_NUMBER == 0, "TILE_K should be 32-aligned");
        static_assert((tileScaleK % 2) == 0, "tileScaleK should be even for Dn2Nz.b16 path");
        static_assert(M >= TILE_M && K >= TILE_K && N >= TILE_N, "Tile should not exceed matrix size");
        static_assert((M % TILE_M) == 0 && (K % TILE_K) == 0 && (N % TILE_N) == 0,
            "Current rebuild only supports exact tile division");

        // L1: per-tile A / As
        AscendC::LocalTensor<fp4x2_e1m2_t> a1Local(AscendC::TPosition::A1, 0, TILE_M * packedTileK);
        AscendC::LocalTensor<fp8_e8m0_t> as1Local(AscendC::TPosition::A1, TILE_M * packedTileK, TILE_M * tileScaleK);

        // L1: per-tile B / Bs (B 输入按 [N, K] 预转置)
        AscendC::LocalTensor<fp4x2_e1m2_t> b1Local(AscendC::TPosition::B1, 0, TILE_N * packedTileK);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Local(AscendC::TPosition::B1, TILE_N * packedTileK, TILE_N * tileScaleK);

        // Step 3: tiled L1 -> L0 -> CO1
        AscendC::LocalTensor<fp4x2_e1m2_t> a2Local(AscendC::TPosition::A2, 0, TILE_M * TILE_K);
        AscendC::LocalTensor<fp4x2_e1m2_t> b2Local(AscendC::TPosition::B2, 0, TILE_K * TILE_N);
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, TILE_M * TILE_N);

        constexpr uint32_t mLoopCount = M / TILE_M;
        constexpr uint32_t nLoopCount = N / TILE_N;
        constexpr uint32_t kLoopCount = K / TILE_K;

        for (uint32_t nBlockIdx = 0; nBlockIdx < nLoopCount; ++nBlockIdx) {
            for (uint32_t mBlockIdx = 0; mBlockIdx < mLoopCount; ++mBlockIdx) {
                for (uint32_t kBlockIdx = 0; kBlockIdx < kLoopCount; ++kBlockIdx) {
                    const uint32_t mStart = mBlockIdx * TILE_M;
                    const uint32_t nStart = nBlockIdx * TILE_N;
                    const uint32_t kStart = kBlockIdx * TILE_K;
                    CopyGmTileToA1Nd2Nz(a1Local, mStart, kStart);
                    CopyScaleGmTileToAs1Dn2NzB16(as1Local, mStart, kStart);
                    CopyGmTileToB1Nd2Nz(b1Local, nStart, kStart);
                    CopyScaleGmTileToBs1Dn2NzB16(bs1Local, nStart, kStart);
                    // Ensure GM->L1 copies are visible before L1->L0 LoadData starts.
                    pipe_barrier(PIPE_ALL);

                    LoadA1ToA2(a2Local, a1Local, as1Local);
                    LoadB1ToB2(b2Local, b1Local, bs1Local);
                    // Ensure L1->L0 loads are visible before Mmad reads A2/B2.
                    pipe_barrier(PIPE_ALL);
                    ComputeOneTile(cLocal, a2Local, b2Local, (kBlockIdx == 0), (kBlockIdx == (kLoopCount - 1)));
                }

                // Step 4: CO1 -> GM
                CopyOut(cLocal, mBlockIdx * TILE_M, nBlockIdx * TILE_N);
            }
        }
    }

private:
    __aicore__ inline void CopyGmTileToA1Nd2Nz(AscendC::LocalTensor<fp4x2_e1m2_t> a1Local,
                                               uint32_t mStart,
                                               uint32_t kStart)
    {
        constexpr uint32_t packedK = AscendC::DivCeil(K, 2);
        constexpr uint32_t packedTileK = AscendC::DivCeil(TILE_K, 2);
        const uint32_t packedKStart = AscendC::DivCeil(kStart, 2);
        AscendC::Nd2NzParams nd2nzParams;
        nd2nzParams.ndNum = 1;
        nd2nzParams.nValue = TILE_M;
        nd2nzParams.dValue = packedTileK;
        nd2nzParams.srcNdMatrixStride = 0;
        nd2nzParams.srcDValue = packedK;
        nd2nzParams.dstNzC0Stride = TILE_M;
        nd2nzParams.dstNzNStride = 1;
        nd2nzParams.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[mStart * packedK + packedKStart], nd2nzParams);
    }

    __aicore__ inline void CopyGmTileToB1Nd2Nz(AscendC::LocalTensor<fp4x2_e1m2_t> b1Local,
                                               uint32_t nStart,
                                               uint32_t kStart)
    {
        // B 输入是 [N, K]（预转置）
        constexpr uint32_t packedK = AscendC::DivCeil(K, 2);
        constexpr uint32_t packedTileK = AscendC::DivCeil(TILE_K, 2);
        const uint32_t packedKStart = AscendC::DivCeil(kStart, 2);
        AscendC::Nd2NzParams nd2nzParams;
        nd2nzParams.ndNum = 1;
        nd2nzParams.nValue = TILE_N;
        nd2nzParams.dValue = packedTileK;
        nd2nzParams.srcNdMatrixStride = 0;
        nd2nzParams.srcDValue = packedK;
        nd2nzParams.dstNzC0Stride = TILE_N;
        nd2nzParams.dstNzNStride = 1;
        nd2nzParams.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1Local, bGM[nStart * packedK + packedKStart], nd2nzParams);
    }

    __aicore__ inline void CopyScaleGmTileToAs1Dn2NzB16(AscendC::LocalTensor<fp8_e8m0_t> as1Local,
                                                        uint32_t mStart,
                                                        uint32_t kStart)
    {
        // scaleA in this FP4 pipeline is consumed as ND layout [M, scaleK].
        // Prefer direct ND copy to avoid potential fp8-pair (b16) re-interpret ordering mismatch.
        constexpr uint32_t scaleK = AscendC::AlignUp(AscendC::DivCeil(K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
        constexpr uint32_t tileScaleK = AscendC::AlignUp(AscendC::DivCeil(TILE_K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
        const uint32_t scaleKStart = kStart / SCALE_CEIL_NUMBER;
        if constexpr ((tileScaleK % 32) == 0) {
            AscendC::DataCopyParams scaleCopyParams;
            scaleCopyParams.blockCount = TILE_M;
            scaleCopyParams.blockLen = tileScaleK / 32;
            scaleCopyParams.srcStride = (scaleK - tileScaleK) / 32;
            scaleCopyParams.dstStride = 0;
            AscendC::DataCopy(as1Local, asGM[mStart * scaleK + scaleKStart], scaleCopyParams);
        } else {
            // Small-k fallback: copy each row directly in element count.
            for (uint32_t row = 0; row < TILE_M; ++row) {
                AscendC::DataCopy(as1Local[row * tileScaleK],
                                  asGM[(mStart + row) * scaleK + scaleKStart],
                                  tileScaleK);
            }
        }
    }

    __aicore__ inline void CopyScaleGmTileToBs1Dn2NzB16(AscendC::LocalTensor<fp8_e8m0_t> bs1Local,
                                                        uint32_t nStart,
                                                        uint32_t kStart)
    {
        // scaleB is also consumed as ND layout [N, scaleK] in this rebuild path.
        constexpr uint32_t scaleK = AscendC::AlignUp(AscendC::DivCeil(K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
        constexpr uint32_t tileScaleK = AscendC::AlignUp(AscendC::DivCeil(TILE_K, SCALE_CEIL_NUMBER), SCALE_ALIGN_NUMBER);
        const uint32_t scaleKStart = kStart / SCALE_CEIL_NUMBER;
        if constexpr ((tileScaleK % 32) == 0) {
            AscendC::DataCopyParams scaleCopyParams;
            scaleCopyParams.blockCount = TILE_N;
            scaleCopyParams.blockLen = tileScaleK / 32;
            scaleCopyParams.srcStride = (scaleK - tileScaleK) / 32;
            scaleCopyParams.dstStride = 0;
            AscendC::DataCopy(bs1Local, bsGM[nStart * scaleK + scaleKStart], scaleCopyParams);
        } else {
            for (uint32_t row = 0; row < TILE_N; ++row) {
                AscendC::DataCopy(bs1Local[row * tileScaleK],
                                  bsGM[(nStart + row) * scaleK + scaleKStart],
                                  tileScaleK);
            }
        }
    }

    __aicore__ inline void LoadA1ToA2(AscendC::LocalTensor<fp4x2_e1m2_t> a2Local,
                                      AscendC::LocalTensor<fp4x2_e1m2_t> a1Local,
                                      AscendC::LocalTensor<fp8_e8m0_t> as1Local)
    {
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = AscendC::DivCeil(TILE_M, CUBE_BLOCK);
        loadDataParams.kStep = AscendC::DivCeil(TILE_K, 64);
        loadDataParams.srcStride = AscendC::DivCeil(TILE_M, CUBE_BLOCK);
        loadDataParams.dstStride = AscendC::DivCeil(TILE_M, CUBE_BLOCK);
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = false;

        AscendC::LoadData2DMxParams loadMxDataParams;
        loadMxDataParams.xStartPosition = 0;
        loadMxDataParams.yStartPosition = 0;
        loadMxDataParams.xStep = AscendC::DivCeil(TILE_K, 64);
        loadMxDataParams.yStep = AscendC::DivCeil(TILE_M, CUBE_BLOCK);
        loadMxDataParams.srcStride = AscendC::DivCeil(TILE_M, CUBE_BLOCK);
        loadMxDataParams.dstStride = AscendC::DivCeil(TILE_M, CUBE_BLOCK);

        AscendC::LoadData(a2Local, a1Local, as1Local, loadDataParams, loadMxDataParams);
    }

    __aicore__ inline void LoadB1ToB2(AscendC::LocalTensor<fp4x2_e1m2_t> b2Local,
                                      AscendC::LocalTensor<fp4x2_e1m2_t> b1Local,
                                      AscendC::LocalTensor<fp8_e8m0_t> bs1Local)
    {
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = AscendC::DivCeil(TILE_N, CUBE_BLOCK);
        loadDataParams.kStep = AscendC::DivCeil(TILE_K, 64);
        loadDataParams.srcStride = AscendC::DivCeil(TILE_N, CUBE_BLOCK);
        loadDataParams.dstStride = AscendC::DivCeil(TILE_N, CUBE_BLOCK);
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = false;

        AscendC::LoadData2DMxParams loadMxDataParams;
        loadMxDataParams.xStartPosition = 0;
        loadMxDataParams.yStartPosition = 0;
        loadMxDataParams.xStep = AscendC::DivCeil(TILE_K, 64);
        loadMxDataParams.yStep = AscendC::DivCeil(TILE_N, CUBE_BLOCK);
        loadMxDataParams.srcStride = AscendC::DivCeil(TILE_N, CUBE_BLOCK);
        loadMxDataParams.dstStride = AscendC::DivCeil(TILE_N, CUBE_BLOCK);

        AscendC::LoadData(b2Local, b1Local, bs1Local, loadDataParams, loadMxDataParams);
    }

    __aicore__ inline void ComputeOneTile(AscendC::LocalTensor<float> cLocal,
                                          AscendC::LocalTensor<fp4x2_e1m2_t> a2Local,
                                          AscendC::LocalTensor<fp4x2_e1m2_t> b2Local,
                                          bool isFirstK,
                                          bool isLastK)
    {
        AscendC::MmadParams mmadParams;
        mmadParams.m = TILE_M;
        mmadParams.n = TILE_N;
        mmadParams.k = TILE_K;
        mmadParams.cmatrixInitVal = isFirstK;
        mmadParams.unitFlag = isLastK ? 3 : 2;
        pipe_barrier(PIPE_ALL);
        AscendC::Mmad(cLocal, a2Local, b2Local, mmadParams);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float> cLocal, uint32_t mStart, uint32_t nStart)
    {
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = TILE_N;
        fixpipeParams.mSize = TILE_M;
        fixpipeParams.srcStride = TILE_M;
        fixpipeParams.dstStride = N;
        fixpipeParams.quantPre = QuantMode_t::F322BF16;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        fixpipeParams.unitFlag = 3;
        AscendC::Fixpipe(cGM[mStart * N + nStart], cLocal, fixpipeParams);
    }

    AscendC::GlobalTensor<fp4x2_e1m2_t> aGM;
    AscendC::GlobalTensor<fp4x2_e1m2_t> bGM;
    AscendC::GlobalTensor<fp8_e8m0_t> asGM;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGM;
    AscendC::GlobalTensor<bfloat16_t> cGM;
};

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void mmadmx_rebuild_custom(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c)
{
    AscendC::InitSocState();
    KernelMmadMxRebuild<M, K, N> op;
    op.Init(a, b, as, bs, c);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    (void)argc;
    (void)argv;

    constexpr uint32_t M = 256;
    constexpr uint32_t K = 256;
    constexpr uint32_t N = 256;
    constexpr uint32_t numBlocks = 1;

    constexpr uint32_t scaleKUnaligned = (K + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER;
    constexpr uint32_t sK = ((scaleKUnaligned + SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER) * SCALE_ALIGN_NUMBER;

    size_t aFileSize = static_cast<size_t>(M * K) * sizeof(uint8_t) / 2;
    size_t bFileSize = static_cast<size_t>(N * K) * sizeof(uint8_t) / 2;
    size_t asFileSize = static_cast<size_t>(M * sK) * sizeof(uint8_t);
    size_t bsFileSize = static_cast<size_t>(N * sK) * sizeof(uint8_t);
    size_t cFileSize = static_cast<size_t>(M) * N * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost = nullptr;
    uint8_t *aDevice = nullptr;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost = nullptr;
    uint8_t *bDevice = nullptr;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *asHost = nullptr;
    uint8_t *asDevice = nullptr;
    aclrtMallocHost((void **)(&asHost), asFileSize);
    aclrtMalloc((void **)&asDevice, asFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_scale_gm.bin", asFileSize, asHost, asFileSize);
    aclrtMemcpy(asDevice, asFileSize, asHost, asFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bsHost = nullptr;
    uint8_t *bsDevice = nullptr;
    aclrtMallocHost((void **)(&bsHost), bsFileSize);
    aclrtMalloc((void **)&bsDevice, bsFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_scale_gm.bin", bsFileSize, bsHost, bsFileSize);
    aclrtMemcpy(bsDevice, bsFileSize, bsHost, bsFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost = nullptr;
    uint8_t *cDevice = nullptr;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmadmx_rebuild_custom<M, K, N>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, asDevice, bsDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(asDevice);
    aclrtFreeHost(asHost);
    aclrtFree(bsDevice);
    aclrtFreeHost(bsHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
