/* !
 * \file mmad_constants.asc
 * \brief MMAD with compile-time constants tiling parameters
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;
constexpr bool IS_B_TRANSPOSE = true;
constexpr uint32_t L0_PINGPONG_BYTES = 32 * 1024;
constexpr uint32_t L1_PINGPONG_BYTES = 256 * 1024;
__aicore__ inline constexpr uint32_t CeilDivision(uint32_t num1, uint32_t num2) {
    return num2 == 0 ? 0 : (num1 + num2 - 1) / num2;
}

__aicore__ inline constexpr uint32_t CeilAlignment(uint32_t num1, uint32_t num2) {
    return num2 == 0 ? 0 : ((num1 + num2 - 1) / num2) * num2;
}

template <uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN,
          uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
          uint32_t stepM, uint32_t stepKa, uint32_t stepKb, uint32_t stepN>
class KernelMmad {

public:
    __aicore__ inline KernelMmad()
    {

    }
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c)
    {
        aGM.SetGlobalBuffer((__gm__ half *)a);
        bGM.SetGlobalBuffer((__gm__ half *)b);
        cGM.SetGlobalBuffer((__gm__ half *)c);
        InitGMOffsets();
    }

__aicore__ inline void Process()
    {
        // L1 Buffer 双缓冲分配：A1 Ping/Pong (0-256KB), B1 Ping/Pong (256-512KB)
        uint32_t a1PingpongSize = baseM * baseK * stepKa;
        uint32_t b1PingpongSize = baseK * baseN * stepKb;
        uint32_t a2PingpongSize = baseM * baseK;
        uint32_t b2PingpongSize = baseK * baseN;        
        AscendC::LocalTensor<half> a1LocalPing(AscendC::TPosition::A1, 0, a1PingpongSize);
        AscendC::LocalTensor<half> a1LocalPong(AscendC::TPosition::A1, a1PingpongSize * sizeof(half), a1PingpongSize);
        AscendC::LocalTensor<half> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        AscendC::LocalTensor<half> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);

        AscendC::LocalTensor<half> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1PingpongSize);
        AscendC::LocalTensor<half> b1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1PingpongSize * sizeof(half), b1PingpongSize);
        AscendC::LocalTensor<half> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        AscendC::LocalTensor<half> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        // CopyIn 进度跟踪，独立于 kIndex
        uint32_t a1NextKBase = 0;  // A 下一次 CopyIn 要搬的 kIndex 基址
        uint32_t b1NextKBase = 0;  // B 下一次 CopyIn 要搬的 kIndex 基址
        uint8_t a1CopyInIdx = 0;   // A 下一次 CopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)
        uint8_t b1CopyInIdx = 0;   // B 下一次 CopyIn 写入的 L1 buffer 索引 (0=Ping, 1=Pong)

        // 初始化反向同步标志，防止第一次 WaitFlag 死锁
        // MTE1_MTE2 flag 0: A1 Ping 可写 | flag 1: A1 Pong 可写
        // MTE1_MTE2 flag 2: B1 Ping 可写 | flag 3: B1 Pong 可写
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(0);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(2);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(3);
        // M_MTE1: L0 双缓冲反向同步
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(0);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(1);

        for (uint32_t mIndex = 0; mIndex < mLoopCount; mIndex++) {
            for (uint32_t nIndex = 0; nIndex < nLoopCount; nIndex++) {
                // 重置 A/B CopyIn 进度
                a1NextKBase = 0;
                b1NextKBase = 0;
                a1CopyInIdx = 0;  // 下一次 CopyIn 写 Ping
                b1CopyInIdx = 0;

                // 预取：只搬 A1Ping 和 B1Ping
                {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(0); // A1 Ping 可写
                    CopyInABlock(a1LocalPing, a1NextKBase, mIndex);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(0); // A1 Ping 数据就绪
                    a1NextKBase += stepKa;
                    a1CopyInIdx ^= 1; // 下次 CopyIn 写 Pong
                }
                {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(2); // B1 Ping 可写
                    CopyInBBlock(b1LocalPing, b1NextKBase, nIndex);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(2); // B1 Ping 数据就绪
                    b1NextKBase += stepKb;
                    b1CopyInIdx ^= 1; // 下次 CopyIn 写 Pong
                }

                // 主 K 循环
                for (uint32_t kIndex = 0; kIndex < kLoopCount; kIndex++) {
                    // ---- 确定 DataLoad 要读的 L1 buffer ----
                    uint32_t a1ReadIdx = (kIndex / stepKa) % 2;
                    uint32_t b1ReadIdx = (kIndex / stepKb) % 2;
                    uint32_t kModStepKa = kIndex % stepKa;
                    uint32_t kModStepKb = kIndex % stepKb;

                    AscendC::LocalTensor<half> a1ReadBuf = (a1ReadIdx == 0) ? a1LocalPing : a1LocalPong;
                    AscendC::LocalTensor<half> b1ReadBuf = (b1ReadIdx == 0) ? b1LocalPing : b1LocalPong;

                    // L0 双缓冲选择
                    AscendC::LocalTensor<half> a2Local = (mte1DBFlag == 0) ? a2LocalPing : a2LocalPong;
                    AscendC::LocalTensor<half> b2Local = (mte1DBFlag == 0) ? b2LocalPing : b2LocalPong;

                    // ---- M_MTE1 反向同步：等待上一轮 Compute 完成 ----
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag);

                    // ---- MTE2_MTE1 正向同步：等待 L1 数据就绪（大包开头） ----
                    if (kModStepKa == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(a1ReadIdx);
                    }
                    if (kModStepKb == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(b1ReadIdx + 2);
                    }

                    // ---- DataLoad: L1 → L0 ----
                    DataLoadA(a1ReadBuf, a2Local, mIndex, kModStepKa);
                    DataLoadB(b1ReadBuf, b2Local, nIndex, kModStepKb);

                    // ---- DataLoad 消费完 L1 大包的最后一个 baseK 后，通知 CopyIn 可覆盖 ----
                    if ((kModStepKa + 1) == stepKa) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(a1ReadIdx);
                    }
                    if ((kModStepKb + 1) == stepKb) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(b1ReadIdx + 2);
                    }

                    // ---- Compute ----
                    Compute(cLocal, a2Local, b2Local, kIndex, mIndex, nIndex);
                    // ---- Preload：大包开头数据就绪后，立即异步搬运下一个 L1 buffer ----
                    // 参照高阶 API 的 DoPreloadLoad 机制：当前大包 CopyIn 完成后，
                    // 立即发起下一个 buffer 的搬运，使 MTE2 和后续计算流水重叠
                    if (kModStepKb == 0 && b1NextKBase < kLoopCount) {
                        AscendC::LocalTensor<half> b1WriteBuf = (b1CopyInIdx == 0) ? b1LocalPing : b1LocalPong;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(b1CopyInIdx + 2);
                        CopyInBBlock(b1WriteBuf, b1NextKBase, nIndex);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(b1CopyInIdx + 2);
                        b1NextKBase += stepKb;
                        b1CopyInIdx ^= 1;
                    }
                    if (kModStepKa == 0 && a1NextKBase < kLoopCount) {
                        AscendC::LocalTensor<half> a1WriteBuf = (a1CopyInIdx == 0) ? a1LocalPing : a1LocalPong;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(a1CopyInIdx);
                        CopyInABlock(a1WriteBuf, a1NextKBase, mIndex);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(a1CopyInIdx);
                        a1NextKBase += stepKa;
                        a1CopyInIdx ^= 1;
                    }

                }
                CopyOut(cLocal, mIndex, nIndex);
            }
        }
        // 等待所有同步完成
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(0);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(3);
    }

private:
    __aicore__ inline void InitGMOffsets()
    {
        constexpr uint32_t mIter = CeilDivision(M, singleCoreM);
        uint32_t mIterIdx = get_block_idx() % mIter;
        uint32_t nIterIdx = get_block_idx() / mIter;

        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        aGM = aGM[gmOffsetA];
        bGM = bGM[gmOffsetB];
        cGM = cGM[gmOffsetC];

        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        kLoopCount = CeilDivision(singleCoreK, baseK);
        mLoopCount = CeilDivision(actualSingleCoreM, baseM);
        nLoopCount = CeilDivision(actualSingleCoreN, baseN);
        baseNCount = actualSingleCoreN / baseN;
        tailNSize = actualSingleCoreN % baseN;
        tailNAlignSize = CeilAlignment(tailNSize, CUBE_BLOCK);

        baseMCount = actualSingleCoreM / baseM;
        tailMSize = actualSingleCoreM % baseM;
        tailMAlignSize = CeilAlignment(tailMSize, CUBE_BLOCK);
    }

    __aicore__ inline void CopyInABlock(AscendC::LocalTensor<half> a1Local, uint32_t kBase, uint32_t mIndex)
    {
        uint32_t actualM = (mIndex != baseMCount) ? baseM : tailMSize;
        AscendC::Nd2NzParams nd2nzA1Params;
        nd2nzA1Params.ndNum = 1;
        nd2nzA1Params.nValue = actualM;
        nd2nzA1Params.dValue = baseK * stepKa;
        nd2nzA1Params.srcNdMatrixStride = 0;
        nd2nzA1Params.srcDValue = K;
        nd2nzA1Params.dstNzC0Stride = baseM;
        nd2nzA1Params.dstNzNStride = 1;
        nd2nzA1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kBase * baseK + mIndex * K * baseM], nd2nzA1Params);
    }

    __aicore__ inline void CopyInBBlock(AscendC::LocalTensor<half> b1Local, uint32_t kBase, uint32_t nIndex)
    {
        uint32_t actualN = (nIndex != baseNCount) ? baseN : tailNSize;
        AscendC::Nd2NzParams nd2nzB1Params;
        if constexpr (!IS_B_TRANSPOSE) {
            nd2nzB1Params.ndNum = 1;
            nd2nzB1Params.nValue = baseK * stepKb;
            nd2nzB1Params.dValue = actualN;
            nd2nzB1Params.srcNdMatrixStride = 0;
            nd2nzB1Params.srcDValue = N;
            nd2nzB1Params.dstNzC0Stride = baseK * stepKb;
            nd2nzB1Params.dstNzNStride = 1;
            nd2nzB1Params.dstNzMatrixStride = 0;
            AscendC::DataCopy(b1Local, bGM[kBase * baseK * N + nIndex * baseN], nd2nzB1Params);
        } else {
            nd2nzB1Params.ndNum = 1;
            nd2nzB1Params.nValue = actualN;
            nd2nzB1Params.dValue = baseK * stepKb;
            nd2nzB1Params.srcNdMatrixStride = 0;
            nd2nzB1Params.srcDValue = K;
            nd2nzB1Params.dstNzC0Stride = baseN;
            nd2nzB1Params.dstNzNStride = 1;
            nd2nzB1Params.dstNzMatrixStride = 0;
            AscendC::DataCopy(b1Local, bGM[kBase * baseK + nIndex * baseN * K], nd2nzB1Params);
        }
    }

    __aicore__ inline void DataLoadA(AscendC::LocalTensor<half> a1Local, AscendC::LocalTensor<half> a2Local, uint32_t mIndex, uint32_t kModStepKa)
    {
        uint32_t srcAddr = kModStepKa * baseK * baseM;
        uint32_t actualMAlign = (mIndex != baseMCount) ? baseM : tailMAlignSize;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201 || __NPU_ARCH__ == 2202)
AscendC::LoadData3DParamsV2<half> loadDataParams;
        // 源操作数height
        loadDataParams.l1H = 1;
        // 源操作数wight
        loadDataParams.l1W = baseM;
        // 源操作数的通道数，
        // img2col的结果矩阵高度为ho * wo,根据ho和wo的计算公式，代入卷积核宽度、卷积核滑动步长、卷积核膨胀系数等参数可知：ho * wo = loadDataParams.l1H * loadDataParams.l1w
        // img2col的结果矩阵宽度为ci * kh * kw,代入kh=1,kw=1，可知结果矩阵的宽度为ci=loadDataParams.channelSize = m
        loadDataParams.channelSize = baseK;
        // 该指令在目的操作数width维度的传输长度，如果不覆盖最右侧的分形，对于half类型，应为16的倍数，对于int8_t/uint8_t应为32的倍数；覆盖的情况则无倍数要求。
        loadDataParams.kExtension = baseK;
        // 该指令在目的操作数height维度的传输长度，如果不覆盖最下侧的分形，对于half/int8_t/uint8_t，应为16的倍数；覆盖的情况则无倍数要求。
        loadDataParams.mExtension = actualMAlign;
        // loadDataParams.kExtension = baseK;
        // 该指令在目的操作数height维度的传输长度，如果不覆盖最下侧的分形，对于half/int8_t/uint8_t，应为16的倍数；覆盖的情况则无倍数要求。
        loadDataParams.mStartPt = 0;
        loadDataParams.kStartPt = 0;
        AscendC::LoadData(a2Local, a1Local[srcAddr], loadDataParams);
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = CeilDivision(actualMAlign, CUBE_BLOCK);
        loadDataParams.kStep = CeilDivision(baseK, CUBE_BLOCK);
        loadDataParams.srcStride = CeilDivision(baseM, CUBE_BLOCK);
        loadDataParams.dstStride = CeilDivision(actualMAlign, CUBE_BLOCK);
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local[srcAddr], loadDataParams);
#endif
    }

    __aicore__ inline void DataLoadB(AscendC::LocalTensor<half> b1Local, AscendC::LocalTensor<half> b2Local, uint32_t nIndex, uint32_t kModStepKb)
    {
        uint32_t srcAddr = kModStepKb * baseK * (IS_B_TRANSPOSE ? baseN : CUBE_BLOCK);
        uint32_t actualNAlign = (nIndex != baseNCount) ? baseN : tailNAlignSize;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201 || __NPU_ARCH__ == 2202)
        uint32_t dstOffset = CeilDivision(actualNAlign, CUBE_BLOCK) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        AscendC::LoadData2DParams loadDataParamsB;
        if constexpr (!IS_B_TRANSPOSE) {
            loadDataParamsB.repeatTimes = CeilDivision(actualNAlign, CUBE_BLOCK);
            loadDataParamsB.srcStride = CeilDivision(baseK * stepKb, CUBE_BLOCK);
            loadDataParamsB.dstGap = 0;
            loadDataParamsB.ifTranspose = true;
            for (int i = 0; i < CeilDivision(baseK, CUBE_BLOCK); ++i) {
                AscendC::LoadData(b2Local[i * dstOffset], b1Local[srcAddr + i * srcOffset], loadDataParamsB);
            }
        } else {
            dstOffset = actualNAlign * CUBE_BLOCK;
            srcOffset = baseN * CUBE_BLOCK;
            loadDataParamsB.repeatTimes = CeilDivision(actualNAlign, CUBE_BLOCK);
            loadDataParamsB.srcStride = 1;
            loadDataParamsB.dstGap = 0;
            loadDataParamsB.ifTranspose = false;
            
            for (int i = 0; i < CeilDivision(baseK, CUBE_BLOCK); ++i) {
                AscendC::LoadData(b2Local[i * dstOffset], b1Local[srcAddr + i * srcOffset], loadDataParamsB);
            }
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        if constexpr (!IS_B_TRANSPOSE) {
            AscendC::LoadData2DParamsV2 loadDataParamsB;
            loadDataParamsB.mStartPosition = 0;
            loadDataParamsB.kStartPosition = 0;
            loadDataParamsB.mStep = AscendC::DivCeil(baseK, CUBE_BLOCK);
            loadDataParamsB.kStep = AscendC::DivCeil(actualNAlign * sizeof(half), 32);
            loadDataParamsB.srcStride = AscendC::DivCeil(baseK * stepKb, CUBE_BLOCK);
            loadDataParamsB.dstStride = AscendC::DivCeil(actualNAlign, CUBE_BLOCK);
            loadDataParamsB.ifTranspose = true;
            AscendC::LoadData(b2Local, b1Local[srcAddr], loadDataParamsB);
        } else {
            AscendC::LoadData2DParamsV2 loadDataParamsB;
            loadDataParamsB.mStartPosition = 0;
            loadDataParamsB.kStartPosition = 0;
            loadDataParamsB.mStep = AscendC::DivCeil(actualNAlign, CUBE_BLOCK);
            loadDataParamsB.kStep = AscendC::DivCeil(baseK * sizeof(half), 32);
            loadDataParamsB.srcStride = AscendC::DivCeil(baseN, CUBE_BLOCK);
            loadDataParamsB.dstStride = AscendC::DivCeil(actualNAlign, CUBE_BLOCK);
            loadDataParamsB.ifTranspose = false;
            AscendC::LoadData(b2Local, b1Local[srcAddr], loadDataParamsB);
        }
#endif
    }

    __aicore__ inline void Compute(AscendC::LocalTensor<float> cLocal, AscendC::LocalTensor<half> a2Local, AscendC::LocalTensor<half> b2Local, uint32_t kIndex, uint32_t mIndex, uint32_t nIndex)
    {
        // MTE1_M 正向同步：M 等待 MTE1 数据搬运完成
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        uint32_t actualM = (mIndex != baseMCount) ? baseM : tailMSize;
        uint32_t actualN = (nIndex != baseNCount) ? baseN : tailNSize;
        AscendC::MmadParams mmadParams;
        mmadParams.m = actualM;
        mmadParams.n = actualN;
        mmadParams.k = baseK;
        mmadParams.cmatrixInitVal = (kIndex == 0);
        mmadParams.unitFlag = (kIndex != kLoopCount - 1) ? 2 : 3;
        AscendC::Mmad(cLocal, a2Local, b2Local, mmadParams);
        // M_MTE1 反向同步：通知下一轮 DataLoad 可以开始
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag);
        mte1DBFlag ^= 1;
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float> cLocal, uint32_t mIndex, uint32_t nIndex)
    {
        uint32_t actualMAlign = (mIndex != baseMCount) ? baseM : tailMAlignSize;
        uint32_t actualM = (mIndex != baseMCount) ? baseM : tailMSize;
        uint32_t actualN = (nIndex != baseNCount) ? baseN : tailNSize;
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = actualN;
        fixpipeParams.mSize = actualM;
        fixpipeParams.srcStride = actualMAlign;
        fixpipeParams.dstStride = N;
        fixpipeParams.quantPre = QuantMode_t::F322F16;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        fixpipeParams.unitFlag = 3;
        AscendC::Fixpipe(cGM[mIndex * baseM * N + nIndex * baseN], cLocal, fixpipeParams);
    }

private:
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<half> cGM;
    uint32_t actualSingleCoreM, actualSingleCoreN;
    uint32_t mLoopCount, nLoopCount, kLoopCount;
    uint32_t baseMCount, baseNCount;
    uint32_t tailMSize, tailNSize;
    uint32_t tailMAlignSize, tailNAlignSize;
    uint8_t mte1DBFlag = 0;
};

template <uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN,
          uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
          uint32_t stepM, uint32_t stepKa, uint32_t stepKb, uint32_t stepN>
__global__  __cube__ void mmad_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::InitSocState();
    KernelMmad<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN,
               stepM, stepKa, stepKb, stepN> op;
    op.Init(a, b, c);
    op.Process();
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t M = 8192;
    constexpr uint32_t K = 8192;
    constexpr uint32_t N = 8192;
    constexpr uint32_t baseM = 128;
    constexpr uint32_t baseK = 64;
    constexpr uint32_t baseN = 256;
    constexpr uint32_t singleCoreM = 2048;
    constexpr uint32_t singleCoreK = 8192;
    constexpr uint32_t singleCoreN = 1536;
    constexpr uint32_t stepM = 1;
    constexpr uint32_t stepKa = 8;
    constexpr uint32_t stepKb = 4;
    constexpr uint32_t stepN = 1;

    size_t aFileSize = M * K * sizeof(int16_t);
    size_t bFileSize = K * N * sizeof(int16_t);
    size_t cFileSize = M * N * sizeof(int16_t);
    uint32_t numBlocks = 24;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_custom<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN,
                stepM, stepKa, stepKb, stepN>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
