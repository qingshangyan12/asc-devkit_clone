/* !
 * \file matmul.asc
 * \brief Matmul_mx sample with case0~case2
 */

#include "matmul_mx.h"

#ifndef CASE_TYPE
#define CASE_TYPE 0
#endif

constexpr int DEPTH_A1 = 4;      // GM->L1中一次搬A矩阵的块数
constexpr int DEPTH_B1 = 4;      // GM->L1中一次搬B矩阵的块数
constexpr int STEP_KA = 2;        // A矩阵在K方向的步长（baseK倍数）
constexpr int STEP_KB = 2;        // B矩阵在K方向的步长（baseK倍数）
constexpr int STEP_M = 1;         // A矩阵在M方向的步长（baseM倍数）
constexpr int STEP_N = 1;         // B矩阵在N方向的步长（baseN倍数）
constexpr int DB_L0A = 2;         // L0A double buffer
constexpr int DB_L0B = 2;         // L0B double buffer

// mxTypePara bit layout (TCubeTiling):
// [0:6]   scaleFactorKa
// [8:14]  scaleFactorKb
// [16:22] scaleFactorM
// [24:30] scaleFactorN
// Each factor range: [1, 127]
constexpr uint32_t MX_SCALE_FACTOR_KA = 4U;
constexpr uint32_t MX_SCALE_FACTOR_KB = 4U;
constexpr uint32_t MX_SCALE_FACTOR_M = 1U;
constexpr uint32_t MX_SCALE_FACTOR_N = 1U;
static_assert(MX_SCALE_FACTOR_KA >= 1U && MX_SCALE_FACTOR_KA <= 127U, "scaleFactorKa out of range");
static_assert(MX_SCALE_FACTOR_KB >= 1U && MX_SCALE_FACTOR_KB <= 127U, "scaleFactorKb out of range");
static_assert(MX_SCALE_FACTOR_M >= 1U && MX_SCALE_FACTOR_M <= 127U, "scaleFactorM out of range");
static_assert(MX_SCALE_FACTOR_N >= 1U && MX_SCALE_FACTOR_N <= 127U, "scaleFactorN out of range");

constexpr uint32_t BuildMxTypePara(
    uint32_t scaleFactorKa, uint32_t scaleFactorKb, uint32_t scaleFactorM, uint32_t scaleFactorN)
{
    return ((scaleFactorKa & 0x7FU) << 0) | ((scaleFactorKb & 0x7FU) << 8) | ((scaleFactorM & 0x7FU) << 16) |
           ((scaleFactorN & 0x7FU) << 24);
}

constexpr uint32_t MX_TYPE_PARA = BuildMxTypePara(
    MX_SCALE_FACTOR_KA, MX_SCALE_FACTOR_KB, MX_SCALE_FACTOR_M, MX_SCALE_FACTOR_N);

template <typename TTiling>
inline void ApplyManualMdlL1Tiling(TTiling& tilingData)
{
    // Keep MDL constraints valid when K is not fully loaded in one step.
    tilingData.set_depthA1(DEPTH_A1);
    tilingData.set_depthB1(DEPTH_B1);
    tilingData.set_stepKa(STEP_KA);
    tilingData.set_stepKb(STEP_KB);
    tilingData.set_stepM(STEP_M);
    tilingData.set_stepN(STEP_N);
    tilingData.set_dbL0A(DB_L0A);
    tilingData.set_dbL0B(DB_L0B);
}


__global__ __cube__ void matmul_custom(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR bias, GM_ADDR c, GM_ADDR workspace,
                                       GM_ADDR tilingGm)
{
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGm);
    AscendC::TPipe pipe;

    MatmulKernel<fp4x2_e1m2_t, fp4x2_e1m2_t, half, half> matmulKernel;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulKernel.matmulObj, &tiling);
    matmulKernel.Init(a, b, as, bs, bias, c, tiling);
    matmulKernel.Process(&pipe);
}

__global__ __cube__ void matmul_custom_mdl(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR bias, GM_ADDR c, GM_ADDR workspace,
                                           GM_ADDR tilingGm)
{
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGm);
    AscendC::TPipe pipe;

    MatmulKernel<fp4x2_e1m2_t, fp4x2_e1m2_t, half, half, true> matmulKernel;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulKernel.matmulObj, &tiling);
    matmulKernel.Init(a, b, as, bs, bias, c, tiling);
    matmulKernel.Process(&pipe);
}

template <bool isTiling>
void GenerateTilingSingleCore(platform_ascendc::PlatformAscendC* ascendcPlatform, uint8_t* tilingBuf)
{
    optiling::TCubeTiling tilingData;
    matmul_tiling::MatmulApiTiling tilingApi(*ascendcPlatform);
    SetTilingTypes<matmul_tiling::MatmulApiTiling, isTiling>(tilingApi, tilingData);
    if constexpr (!isTiling) {
        tilingData.set_baseK(64);
    }
    SetL1(tilingData);
    uint32_t tcubeTilingSize = tilingData.GetDataSize();
    tilingData.SaveToBuffer(tilingBuf, tcubeTilingSize);
}

template <bool IsBaselineMX, bool IsMXScale, bool IsMxTypePara>
void GenerateTilingMultiCore(platform_ascendc::PlatformAscendC* ascendcPlatform,
                             uint8_t* tilingBuf)
{
    optiling::TCubeTiling tilingData;
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);

    if constexpr (IsBaselineMX) {
        tilingApi.SetDim(ascendcPlatform->GetCoreNumAic());
        tilingApi.SetSingleShape(SINGLE_M, SINGLE_N, K);
        SetTilingCommon(tilingApi);
        tilingApi.SetFixSplit(BASE_M, BASE_N, BASE_K);
        if (tilingApi.GetTiling(tilingData) == -1) {
            std::cout << "GenerateTilingMultiCore(IsBaselineMX) failed" << std::endl;
        }
    } else if constexpr (IsMXScale) {
        tilingApi.SetDim(ascendcPlatform->GetCoreNumAic());
        tilingApi.SetSingleShape(SINGLE_M, SINGLE_N, K);
        SetTilingCommon(tilingApi);
        tilingApi.SetFixSplit(BASE_M, BASE_N, BASE_K);
        if (tilingApi.GetTiling(tilingData) == -1) {
            std::cout << "GenerateTilingMultiCore(IsMXScale) failed" << std::endl;
        }
        ApplyManualMdlL1Tiling(tilingData);
        tilingData.set_mxTypePara(MX_TYPE_PARA);
    }

    tilingData.SaveToBuffer(tilingBuf, tilingData.GetDataSize());
}

int32_t main(int32_t argc, char* argv[])
{
    printf("Usage: %s (compile-time CASE_TYPE=%u)\n", argv[0], (uint32_t)CASE_TYPE);
    printf("Running case %u...\n", (uint32_t)CASE_TYPE);

    const char* modeName = "";
    uint32_t numBlocks = 1;
    auto ascendc = platform_ascendc::PlatformAscendCManager::GetInstance();

    if constexpr (CASE_TYPE == 0) {
        modeName = "Single Core Basic";
        numBlocks = 1;
    } else if constexpr (CASE_TYPE == 1) {
        modeName = "Multi Core MDL Reference";
        numBlocks = ascendc->GetCoreNumAic();
    } else if constexpr (CASE_TYPE == 2) {
        modeName = "Multi Core MDL Manual Tiling";
        numBlocks = ascendc->GetCoreNumAic();
    }
    else {
        std::cout << "Invalid CASE_TYPE: " << CASE_TYPE << std::endl;
        return -1;
    }

    std::cout << "Running mode: " << modeName << std::endl;

    int sK = static_cast<int>((K + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER * SCALE_NUMBER);
    size_t aFileSize = static_cast<size_t>(M * K) * sizeof(uint8_t) / 2;
    size_t bFileSize = static_cast<size_t>(K * N) * sizeof(uint8_t) / 2;
    size_t asFileSize = static_cast<size_t>(M * sK) * sizeof(uint8_t);
    size_t bsFileSize = static_cast<size_t>(sK * N) * sizeof(uint8_t);
    size_t cFileSize = static_cast<size_t>(M * N) * sizeof(uint16_t);
    size_t biasFileSize = static_cast<size_t>(N) * sizeof(uint16_t);

    const size_t tilingFileSize = sizeof(TCubeTiling);
    uint8_t* tilingBuf = (uint8_t*)malloc(tilingFileSize);

    if constexpr (CASE_TYPE == 0) {
        GenerateTilingSingleCore(ascendc, tilingBuf);
    } else if constexpr (CASE_TYPE == 1) {
        GenerateTilingMultiCore<true, false, false>(ascendc, tilingBuf);  // 场景0
    } else if constexpr (CASE_TYPE == 2) {
        GenerateTilingMultiCore<false, true, false>(ascendc, tilingBuf);  // 场景1
    }

    const auto* generatedTiling = reinterpret_cast<const TCubeTiling*>(tilingBuf);
    numBlocks = generatedTiling->usedCoreNum;

    size_t userWorkspaceSize = 0;
    size_t systemWorkspaceSize = static_cast<size_t>(ascendc->GetLibApiWorkSpaceSize());
    size_t workspaceSize = userWorkspaceSize + systemWorkspaceSize;

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* asHost;
    uint8_t* asDevice;
    aclrtMallocHost((void**)(&asHost), asFileSize);
    aclrtMalloc((void**)&asDevice, asFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_scale_gm.bin", asFileSize, asHost, asFileSize);
    aclrtMemcpy(asDevice, asFileSize, asHost, asFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bsHost;
    uint8_t* bsDevice;
    aclrtMallocHost((void**)(&bsHost), bsFileSize);
    aclrtMalloc((void**)&bsDevice, bsFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_scale_gm.bin", bsFileSize, bsHost, bsFileSize);
    aclrtMemcpy(bsDevice, bsFileSize, bsHost, bsFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* biasHost;
    uint8_t* biasDevice;
    if (IS_BIAS) {
        aclrtMallocHost((void**)(&biasHost), biasFileSize);
        aclrtMalloc((void**)&biasDevice, biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/bias_gm.bin", biasFileSize, biasHost, biasFileSize);
        aclrtMemcpy(biasDevice, biasFileSize, biasHost, biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* workspaceDevice;
    aclrtMalloc((void**)&workspaceDevice, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* tilingHost;
    uint8_t* tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), tilingFileSize);
    aclrtMalloc((void**)&tilingDevice, tilingFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(tilingHost, tilingFileSize, tilingBuf, tilingFileSize, ACL_MEMCPY_HOST_TO_HOST);
    aclrtMemcpy(tilingDevice, tilingFileSize, tilingHost, tilingFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr auto selectedKernel = []() {
        if constexpr (CASE_TYPE == 0) {
            return matmul_custom;
        } else {
            return matmul_custom_mdl;
        }
    }();
    selectedKernel<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, asDevice, bsDevice, biasDevice, cDevice, workspaceDevice, tilingDevice);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);
    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(asDevice);
    aclrtFreeHost(asHost);
    aclrtFree(bsDevice);
    aclrtFreeHost(bsHost);
    if (IS_BIAS) {
        aclrtFree(biasDevice);
        aclrtFreeHost(biasHost);
    }
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(tilingHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (tilingBuf != nullptr) {
        free(tilingBuf);
    }
    return 0;
}
