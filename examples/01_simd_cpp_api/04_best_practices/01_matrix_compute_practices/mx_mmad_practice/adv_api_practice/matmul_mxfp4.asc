/* !
 * \file matmul_mxfp4.asc
 * \brief 基于 Ascend C 高阶 Matmul API 的 MxFP4 Matmul 多场景样例。
 *
 * MxMatmul 与普通 Matmul 的区别在于，两个输入操作数都带有按块组织的量化系数矩阵。
 * 逻辑公式如下：
 *   C = (scaleA ⊗ A) * (scaleB ⊗ B)
 * 其中“⊗”表示将量化 scale 广播到低比特 fp4 数据上。
 *
 * 按照 Ascend C 的 MXMatmul 编程模型：
 * - A/B 为 fp4 数据张量
 * - scaleA/scaleB 为 fp8 量化系数矩阵
 * - 在 K 轴上每 32 个元素共用 1 个 scale
 * - Host 侧需要配置 MXMODE Tiling 及量化系数矩阵元信息
 * - Kernel 侧需要使用 MatmulTypeWithScale + MatmulWithScalePolicy
 */

#include "data_utils.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;
// scaleK = ceil(K / 32)，并且这里的运行时数据还会额外做 2 字节对齐。
// 本样例中使用 ceil(K / 64) * 2，等价于对 ceil(K / 32) 结果做偶数对齐。
constexpr uint32_t SCALE_CEIL_NUMBER = 64;
constexpr uint32_t SCALE_NUMBER = 2;

__aicore__ inline void CopyTiling(TCubeTiling* tiling, GM_ADDR tilingGm)
{
    uint32_t* ptr = reinterpret_cast<uint32_t*>(tiling);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); i++, ptr++) {
        *ptr = *(tiling32 + i);
    }
}

template <typename AType, typename BType, typename CType, bool IS_TRANS_A, bool IS_TRANS_B>
class MatmulMxfp4Kernel {
public:
    __aicore__ inline MatmulMxfp4Kernel(){};

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c, GM_ADDR tilingGm);
    __aicore__ inline void Process(AscendC::TPipe* pipe);

    // MatmulTypeWithScale 表示 A/B 是 MX 输入，并且每个输入都带有配套的量化系数矩阵。
    // 转置模板参数必须与实际 GM 布局和 Host 侧 Tiling 配置保持一致。
    // MxMatmul场景通过MatmulTypeWithScale定义A、scaleA、B、scaleB的参数类型信息
    using aType =
        AscendC::MatmulTypeWithScale<AscendC::TPosition::GM, AscendC::TPosition::GM, CubeFormat::ND, AType, IS_TRANS_A>;
    using bType =
        AscendC::MatmulTypeWithScale<AscendC::TPosition::GM, AscendC::TPosition::GM, CubeFormat::ND, BType, IS_TRANS_B>;
    using cType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, CType>;

    // 定义matmul对象时，传入MatmulWithScalePolicy表明使能MxMatmul模板策略，CFG_MDL表示使能Matmul Config的MDL模板
    AscendC::Matmul<aType, bType, cType, cType, CFG_MDL,
        AscendC::MatmulCallBackFunc<nullptr, nullptr, nullptr>,
        AscendC::Impl::Detail::MatmulWithScalePolicy> matmulObj;

private:
    __aicore__ inline void CalcOffset(int32_t blockIdx, int32_t& offsetA, int32_t& offsetB,
        int32_t& offsetAscale, int32_t& offsetBscale, int32_t& offsetC);

    AscendC::GlobalTensor<AType> aGlobal;
    AscendC::GlobalTensor<BType> bGlobal;
    AscendC::GlobalTensor<CType> cGlobal;
    AscendC::GlobalTensor<AscendC::fp8_e8m0_t> asGlobal;
    AscendC::GlobalTensor<AscendC::fp8_e8m0_t> bsGlobal;
    TCubeTiling tiling;
    int32_t mCoreIndex{0};
    int32_t nCoreIndex{0};
};

template <typename AType, typename BType, typename CType, bool IS_TRANS_A, bool IS_TRANS_B>
__aicore__ inline void MatmulMxfp4Kernel<AType, BType, CType, IS_TRANS_A, IS_TRANS_B>::Init(
    GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c, GM_ADDR tilingGm)
{
    CopyTiling(&tiling, tilingGm);

    // MxMatmul 需要在 GM 中同时提供左右矩阵和对应的量化系数矩阵。
    // 在本样例中，scaleK 按照对 ceil(K / 32) 做偶数对齐后的方式存储。
    int sK = (tiling.Ka + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER * SCALE_NUMBER;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AType*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BType*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ CType*>(c), tiling.M * tiling.N);
    asGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AscendC::fp8_e8m0_t*>(as), tiling.M * sK);
    bsGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AscendC::fp8_e8m0_t*>(bs), sK * tiling.N);

    int32_t offsetA = 0;
    int32_t offsetB = 0;
    int32_t offsetAscale = 0;
    int32_t offsetBscale = 0;
    int32_t offsetC = 0;

    CalcOffset(AscendC::GetBlockIdx(), offsetA, offsetB, offsetAscale, offsetBscale, offsetC);

    // 完成偏移切片后，每个核只会看到自己负责的 A/B/scaleA/scaleB/C 分块窗口。
    aGlobal = aGlobal[offsetA];
    bGlobal = bGlobal[offsetB];
    cGlobal = cGlobal[offsetC];
    asGlobal = asGlobal[offsetAscale];
    bsGlobal = bsGlobal[offsetBscale];
}

template <typename AType, typename BType, typename CType, bool IS_TRANS_A, bool IS_TRANS_B>
__aicore__ inline void MatmulMxfp4Kernel<AType, BType, CType, IS_TRANS_A, IS_TRANS_B>::Process(
    AscendC::TPipe* pipe)
{
    if (AscendC::GetBlockIdx() >= tiling.usedCoreNum) {
        return;
    }

    // 当 singleCoreM/N 不能完整覆盖 M/N 时，Matmul 对象会使用当前核的尾块尺寸处理最后一个分块。
    int tailM = tiling.M - mCoreIndex * tiling.singleCoreM;
    tailM = tailM < tiling.singleCoreM ? tailM : tiling.singleCoreM;

    int tailN = tiling.N - nCoreIndex * tiling.singleCoreN;
    tailN = tailN < tiling.singleCoreN ? tailN : tiling.singleCoreN;

    if (tailM < tiling.singleCoreM || tailN < tiling.singleCoreN) {
        matmulObj.SetTail(tailM, tailN);
    }

    // 设置左矩阵A、右矩阵B、左量化系数矩阵scaleA、右量化系数矩阵scaleB, 保持相同的转置语义。
    matmulObj.SetTensorA(aGlobal, IS_TRANS_A);
    matmulObj.SetTensorB(bGlobal, IS_TRANS_B);
    matmulObj.SetTensorScaleA(asGlobal, IS_TRANS_A);
    matmulObj.SetTensorScaleB(bsGlobal, IS_TRANS_B);

    // IterateAll 完成单核上所有数据的计算。
    matmulObj.IterateAll(cGlobal);
    matmulObj.End();
}

template <typename AType, typename BType, typename CType, bool IS_TRANS_A, bool IS_TRANS_B>
__aicore__ inline void MatmulMxfp4Kernel<AType, BType, CType, IS_TRANS_A, IS_TRANS_B>::CalcOffset(
    int32_t blockIdx, int32_t& offsetA, int32_t& offsetB, int32_t& offsetAscale, int32_t& offsetBscale, int32_t& offsetC)
{
    const TCubeTiling& t = tiling;
    int sK = (t.Ka + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER * SCALE_NUMBER;
    auto mSingleBlocks = (t.M + t.singleCoreM - 1) / t.singleCoreM;
    mCoreIndex = blockIdx % mSingleBlocks;
    nCoreIndex = blockIdx / mSingleBlocks;

    // A/B 与 scaleA/scaleB 必须按一致的逻辑分块方式进行切片。
    // 它们的区别只在于 GM 上的行跨度不同：fp4 数据使用 K，scale 使用 scaleK。
    if (IS_TRANS_A) {
        offsetA = mCoreIndex * t.singleCoreM;
        offsetAscale = mCoreIndex * t.singleCoreM;
    } else {
        offsetA = mCoreIndex * t.Ka * t.singleCoreM;
        offsetAscale = mCoreIndex * sK * t.singleCoreM;
    }

    if (IS_TRANS_B) {
        offsetB = nCoreIndex * t.Kb * t.singleCoreN;
        offsetBscale = nCoreIndex * sK * t.singleCoreN;
    } else {
        offsetB = nCoreIndex * t.singleCoreN;
        offsetBscale = nCoreIndex * t.singleCoreN;
    }

    offsetC = mCoreIndex * t.N * t.singleCoreM + nCoreIndex * t.singleCoreN;
}

template <uint32_t M, uint32_t K, uint32_t N, bool IS_TRANS_A, bool IS_TRANS_B>
__global__ __cube__ void matmul_mxfp4_custom(GM_ADDR a, GM_ADDR b, GM_ADDR as, GM_ADDR bs, GM_ADDR c,
    GM_ADDR tilingGm)
{
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGm);
    AscendC::TPipe pipe;

    MatmulMxfp4Kernel<fp4x2_e1m2_t, fp4x2_e1m2_t, bfloat16_t, IS_TRANS_A, IS_TRANS_B> matmulKernel;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulKernel.matmulObj, &tiling);
    matmulKernel.Init(a, b, as, bs, c, tilingGm);
    matmulKernel.Process(&pipe);
}

template <uint32_t M, uint32_t K, uint32_t N, uint32_t USED_CORE_NUM, bool IS_TRANS_A, bool IS_TRANS_B>
void GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform, uint8_t* tilingBuf)
{
    optiling::TCubeTiling tilingData;
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);

    // Host 侧 Tiling 既要描述数据张量，也要描述量化系数矩阵。
    // 同时需要将 MAD 模式切换为 MXMODE，使生成的 Tiling 面向 MxMatmul 而不是普通 Matmul。
    tilingApi.SetDim(USED_CORE_NUM);
    tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT4_E1M2, IS_TRANS_A);
    tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT4_E1M2, IS_TRANS_B);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_BFLOAT16);

    tilingApi.SetScaleAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, IS_TRANS_A);
    tilingApi.SetScaleBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, IS_TRANS_B);

    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.SetBufferSpace(-1, -1, -1);
    tilingApi.SetMadType(matmul_tiling::MatrixMadType::MXMODE);

    int64_t res = tilingApi.GetTiling(tilingData);
    if (res == -1) {
        std::cout << "gen tiling failed" << std::endl;
    }
    uint32_t tcubeTilingSize = tilingData.GetDataSize();
    tilingData.SaveToBuffer(tilingBuf, tcubeTilingSize);
}

template <uint32_t M, uint32_t K, uint32_t N, uint32_t USED_CORE_NUM, bool IS_TRANS_A, bool IS_TRANS_B>
int32_t RunScenario()
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    constexpr uint32_t scaleK = (K + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER * SCALE_NUMBER;

    std::cout << "Running scenario " << scenarioNum << ": M=" << M << ", K=" << K << ", N=" << N
              << ", coreNum=" << USED_CORE_NUM << std::endl;

    size_t aFileSize = static_cast<size_t>(M * K) * sizeof(uint8_t) / 2;
    size_t bFileSize = static_cast<size_t>(K * N) * sizeof(uint8_t) / 2;
    size_t asFileSize = static_cast<size_t>(M * scaleK) * sizeof(uint8_t);
    size_t bsFileSize = static_cast<size_t>(scaleK * N) * sizeof(uint8_t);
    size_t cFileSize = static_cast<size_t>(M * N) * sizeof(uint16_t);

    size_t tilingFileSize = sizeof(TCubeTiling);
    uint8_t* tilingBuf = (uint8_t*)malloc(tilingFileSize);
    GenerateTiling<M, K, N, USED_CORE_NUM, IS_TRANS_A, IS_TRANS_B>(ascendcPlatform, tilingBuf);

    size_t userWorkspaceSize = 0;
    size_t systemWorkspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());
    size_t workspaceSize = userWorkspaceSize + systemWorkspaceSize;

    auto* tilingData = reinterpret_cast<TCubeTiling*>(tilingBuf);
    uint32_t numBlocks = tilingData->usedCoreNum;

    std::cout << "Tiling: usedCoreNum=" << numBlocks << ", singleCoreM=" << tilingData->singleCoreM
              << ", singleCoreN=" << tilingData->singleCoreN << ", baseM=" << tilingData->baseM
              << ", baseN=" << tilingData->baseN << ", baseK=" << tilingData->baseK
              << ", stepKa=" << tilingData->stepKa << ", mxTypePara=" << tilingData->mxTypePara << std::endl;

            
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* asHost;
    uint8_t* asDevice;
    aclrtMallocHost((void**)(&asHost), asFileSize);
    aclrtMalloc((void**)&asDevice, asFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_scale_gm.bin", asFileSize, asHost, asFileSize);
    aclrtMemcpy(asDevice, asFileSize, asHost, asFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bsHost;
    uint8_t* bsDevice;
    aclrtMallocHost((void**)(&bsHost), bsFileSize);
    aclrtMalloc((void**)&bsDevice, bsFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_scale_gm.bin", bsFileSize, bsHost, bsFileSize);
    aclrtMemcpy(bsDevice, bsFileSize, bsHost, bsFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* tilingHost;
    uint8_t* tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), tilingFileSize);
    aclrtMalloc((void**)&tilingDevice, tilingFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingHost, tilingFileSize, tilingBuf, tilingFileSize, ACL_MEMCPY_HOST_TO_HOST);
    aclrtMemcpy(tilingDevice, tilingFileSize, tilingHost, tilingFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    matmul_mxfp4_custom<M, K, N, IS_TRANS_A, IS_TRANS_B>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, asDevice, bsDevice, cDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(asDevice);
    aclrtFreeHost(asHost);
    aclrtFree(bsDevice);
    aclrtFreeHost(bsHost);
    aclrtFree(tilingDevice);
    aclrtFreeHost(tilingHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    free(tilingBuf);
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    if constexpr (scenarioNum == 1) {
        constexpr uint32_t M = 256;
        constexpr uint32_t K = 256;
        constexpr uint32_t N = 256;
        constexpr uint32_t usedCoreNum = 1;
        constexpr bool isTransA = false;
        constexpr bool isTransB = true;
        return RunScenario<M, K, N, usedCoreNum, isTransA, isTransB>();
    } else if constexpr (scenarioNum == 2) {
        constexpr uint32_t M = 40;
        constexpr uint32_t K = 70;
        constexpr uint32_t N = 80;
        constexpr uint32_t usedCoreNum = 1;
        constexpr bool isTransA = false;
        constexpr bool isTransB = true;
        return RunScenario<M, K, N, usedCoreNum, isTransA, isTransB>();
    } else if constexpr (scenarioNum == 3) {
        constexpr uint32_t M = 1024;
        constexpr uint32_t K = 1024;
        constexpr uint32_t N = 1024;
        constexpr uint32_t usedCoreNum = 8;
        constexpr bool isTransA = false;
        constexpr bool isTransB = true;
        return RunScenario<M, K, N, usedCoreNum, isTransA, isTransB>();
    } else {
        std::cout << "Invalid SCENARIO_NUM: " << scenarioNum << std::endl;
        return -1;
    }
}
