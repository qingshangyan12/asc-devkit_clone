#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include <cstring>
#include <cmath>
#define __ASCENDC_INCLUDE_INTERNAL_HEADERS__
#include "/home/joey/code/joey/asc-devkit/impl/adv_api/detail/math/log1p/log1p_3510_impl.h"

template <typename T>
class KernelLog1p {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t count, AscendC::TPipe* pipeIn)
    {
        this->pipe = pipeIn;
        this->count = count;
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->pipe->InitBuffer(inQueueX, 1, sizeof(T) * count);
        this->pipe->InitBuffer(outQueueY, 1, sizeof(T) * count);
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm, count);
        inQueueX.EnQue<T>(xLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();

        AscendC::Log1pImpl<T>(yLocal, xLocal, count);

        outQueueY.EnQue<T>(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopy(yGm, yLocal, count);
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    AscendC::TPipe* pipe = nullptr;
    uint32_t count;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY;
};

__global__ __vector__ void log1p_kernel_float(GM_ADDR x, GM_ADDR y)
{
    uint32_t count = 2048;
    AscendC::TPipe pipe;
    KernelLog1p<float> kernel;
    kernel.Init(x, y, count, &pipe);
    kernel.Process();
}

__global__ __vector__ void log1p_kernel_half(GM_ADDR x, GM_ADDR y)
{
    uint32_t count = 2048;
    AscendC::TPipe pipe;
    KernelLog1p<half> kernel;
    kernel.Init(x, y, count, &pipe);
    kernel.Process();
}

static bool CompareResultFloat(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden_float.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("ReadFile golden_float.bin failed!\n");
        return false;
    }
    printf("ReadFile golden_float.bin success!\n");

    constexpr float EPS_ABS = 1e-4f;
    constexpr float EPS_REL = 1e-4f;
    size_t total = outSize / sizeof(float);
    int64_t wrongNum = 0;
    float maxAbsErr = 0.0f;

    for (size_t i = 0; i < total; i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::fabs(a - b);
        float re = ae / std::max(std::fabs(b), 1e-8f);
        if (ae > maxAbsErr) {
            maxAbsErr = ae;
        }
        if (ae > EPS_ABS && re > EPS_REL) {
            printf("[float] idx=%zu output=%e golden=%e abs_err=%e rel_err=%e\n",
                   i, a, b, ae, re);
            wrongNum++;
            if (wrongNum >= 10) {
                printf("[float] too many errors, stopping comparison...\n");
                break;
            }
        }
    }
    aclrtFreeHost(goldenData);
    printf("[float] max_abs_err=%e\n", maxAbsErr);
    if (wrongNum != 0) {
        printf("[float] %lld mismatches out of %zu elements.\n", (long long)wrongNum, total);
        return false;
    } else {
        printf("[float] CompareResult golden_float.bin success (0 mismatches / %zu elements)!\n", total);
        return true;
    }
}

static float HalfToFloat(uint16_t h)
{
    uint32_t sign = (h >> 15) & 1;
    int32_t exp = (h >> 10) & 0x1f;
    uint32_t mant = h & 0x3ff;

    if (exp == 0) {
        if (mant == 0) {
            uint32_t bits = sign << 31;
            float f;
            std::memcpy(&f, &bits, sizeof(f));
            return f;
        }
        while ((mant & 0x400) == 0) {
            mant <<= 1;
            exp--;
        }
        mant &= 0x3ff;
        exp++;
    } else if (exp == 0x1f) {
        uint32_t bits = (sign << 31) | (0xff << 23);
        if (mant != 0) bits |= 1; // NaN
        float f;
        std::memcpy(&f, &bits, sizeof(f));
        return f;
    }
    exp = exp - 15 + 127;
    uint32_t bits = (sign << 31) | (static_cast<uint32_t>(exp) << 23) | (mant << 13);
    float f;
    std::memcpy(&f, &bits, sizeof(f));
    return f;
}

static bool CompareResultHalf(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden_half.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("ReadFile golden_half.bin failed!\n");
        return false;
    }
    printf("ReadFile golden_half.bin success!\n");

    constexpr float EPS_REL = 1e-2f;
    size_t total = outSize / sizeof(uint16_t);
    int64_t wrongNum = 0;
    float maxRelErr = 0.0f;

    for (size_t i = 0; i < total; i++) {
        float a = HalfToFloat(reinterpret_cast<const uint16_t*>(outputData)[i]);
        float b = HalfToFloat(reinterpret_cast<const uint16_t*>(goldenData)[i]);
        float ae = std::fabs(a - b);
        float re = ae / std::max(std::fabs(b), 1e-8f);
        if (re > maxRelErr) {
            maxRelErr = re;
        }
        if (re > EPS_REL) {
            printf("[half] idx=%zu output=%e golden=%e abs_err=%e rel_err=%e\n",
                   i, a, b, ae, re);
            wrongNum++;
            if (wrongNum >= 10) {
                printf("[half] too many errors, stopping comparison...\n");
                break;
            }
        }
    }
    aclrtFreeHost(goldenData);
    printf("[half] max_rel_err=%e\n", maxRelErr);
    if (wrongNum != 0) {
        printf("[half] %lld mismatches out of %zu elements.\n", (long long)wrongNum, total);
        return false;
    } else {
        printf("[half] CompareResult golden_half.bin success (0 mismatches / %zu elements)!\n", total);
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    size_t countFloat = 2048;
    size_t countHalf = 2048;
    size_t inputFloatByteSize = countFloat * sizeof(float);
    size_t outputFloatByteSize = countFloat * sizeof(float);
    size_t inputHalfByteSize = countHalf * sizeof(uint16_t);
    size_t outputHalfByteSize = countHalf * sizeof(uint16_t);

    uint8_t *xHostFloat, *yHostFloat, *xHostHalf, *yHostHalf;
    uint8_t *xDeviceFloat, *yDeviceFloat, *xDeviceHalf, *yDeviceHalf;

    aclrtMallocHost((void**)(&xHostFloat), inputFloatByteSize);
    aclrtMallocHost((void**)(&yHostFloat), outputFloatByteSize);
    aclrtMallocHost((void**)(&xHostHalf), inputHalfByteSize);
    aclrtMallocHost((void**)(&yHostHalf), outputHalfByteSize);

    aclrtMalloc((void**)&xDeviceFloat, inputFloatByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDeviceFloat, outputFloatByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&xDeviceHalf, inputHalfByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDeviceHalf, outputHalfByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    bool floatPass = false;
    bool halfPass = false;

    // ---- float test ----
    {
        ReadFile("./input/input_x_float.bin", inputFloatByteSize, xHostFloat, inputFloatByteSize);
        aclrtMemcpy(xDeviceFloat, inputFloatByteSize, xHostFloat, inputFloatByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

        log1p_kernel_float<<<1, nullptr, stream>>>(xDeviceFloat, yDeviceFloat);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(yHostFloat, outputFloatByteSize, yDeviceFloat, outputFloatByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output_float.bin", yHostFloat, outputFloatByteSize);

        floatPass = CompareResultFloat(yHostFloat, outputFloatByteSize);
    }

    // ---- half test ----
    {
        ReadFile("./input/input_x_half.bin", inputHalfByteSize, xHostHalf, inputHalfByteSize);
        aclrtMemcpy(xDeviceHalf, inputHalfByteSize, xHostHalf, inputHalfByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

        log1p_kernel_half<<<1, nullptr, stream>>>(xDeviceHalf, yDeviceHalf);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(yHostHalf, outputHalfByteSize, yDeviceHalf, outputHalfByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output_half.bin", yHostHalf, outputHalfByteSize);

        halfPass = CompareResultHalf(yHostHalf, outputHalfByteSize);
    }

    printf("\n========== Results ==========\n");
    printf("  [float] log1p test: %s\n", floatPass ? "PASS" : "FAIL");
    printf("  [half]  log1p test: %s\n", halfPass ? "PASS" : "FAIL");
    printf("=============================\n");

    aclrtFree(xDeviceFloat);
    aclrtFree(yDeviceFloat);
    aclrtFree(xDeviceHalf);
    aclrtFree(yDeviceHalf);
    aclrtFreeHost(xHostFloat);
    aclrtFreeHost(yHostFloat);
    aclrtFreeHost(xHostHalf);
    aclrtFreeHost(yHostHalf);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return (floatPass && halfPass) ? 0 : 1;
}
