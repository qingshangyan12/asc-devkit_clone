#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <cfloat>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "adv_api/math/log1p.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t BUFFER_NUM = 2;

class KernelLog1p {
public:
    __aicore__ inline KernelLog1p() {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, uint32_t totalLength)
    {
        if (totalLength < BUFFER_NUM) {
            return;
        }
        this->totalLength = totalLength;
        this->tileLength = totalLength / BUFFER_NUM;

        inputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(input), totalLength);
        outputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output), totalLength);

        pipe.InitBuffer(inQueue, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueue, BUFFER_NUM, this->tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if (totalLength < BUFFER_NUM) {
            return;
        }
        int32_t loopCount = BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueue.AllocTensor<float>();
        AscendC::DataCopy(xLocal, inputGlobal[progress * this->tileLength], this->tileLength);
        inQueue.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueue.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQueue.AllocTensor<float>();
        AscendC::Log1p(yLocal, xLocal, this->tileLength);
        outQueue.EnQue<float>(yLocal);
        inQueue.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> yLocal = outQueue.DeQue<float>();
        AscendC::DataCopy(outputGlobal[progress * this->tileLength], yLocal, this->tileLength);
        outQueue.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueue;
    AscendC::GlobalTensor<float> inputGlobal;
    AscendC::GlobalTensor<float> outputGlobal;
    uint32_t totalLength;
    uint32_t tileLength;
};

__global__ __vector__ void log1p_custom(GM_ADDR input, GM_ADDR output, uint32_t totalLength)
{
    KernelLog1p op;
    op.Init(input, output, totalLength);
    op.Process();
}

void ComputeGolden(const float* input, float* golden, uint32_t count)
{
    for (uint32_t i = 0; i < count; i++) {
        golden[i] = log1pf(input[i]);
    }
}

static bool IsClose(float a, float b)
{
    if (std::isnan(a) && std::isnan(b)) {
        return true;
    }
    if (std::isinf(a) && std::isinf(b)) {
        return std::signbit(a) == std::signbit(b);
    }
    float absDiff = fabsf(a - b);
    float maxVal = fmaxf(fabsf(a), fabsf(b));
    float threshold = 1e-5f + 1e-4f * maxVal;
    return absDiff <= threshold;
}

static uint32_t CompareResults(const float* output, const float* golden, uint32_t count,
                                const char* testName)
{
    uint32_t errorCount = 0;
    for (uint32_t i = 0; i < count; i++) {
        if (!IsClose(output[i], golden[i])) {
            if (errorCount < 10) {
                printf("  [%u] got=%e (%08x) expected=%e (%08x)\n",
                       i, output[i], *(uint32_t*)(output + i),
                       golden[i], *(uint32_t*)(golden + i));
            }
            errorCount++;
        }
    }
    if (errorCount == 0) {
        printf("  [PASS] %s (%u elements)\n", testName, count);
    } else {
        printf("  [FAIL] %s: %u/%u mismatches\n", testName, errorCount, count);
    }
    return errorCount;
}

static void RunLog1p(const float* inputHost, float* outputHost, uint32_t totalLength)
{
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    size_t byteSize = totalLength * sizeof(float);
    uint8_t *inputDevice = nullptr;
    uint8_t *outputDevice = nullptr;

    aclrtMalloc(reinterpret_cast<void**>(&inputDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(inputDevice, byteSize, inputHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    log1p_custom<<<1, nullptr, stream>>>(inputDevice, outputDevice, totalLength);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, byteSize, outputDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(inputDevice);
    aclrtFree(outputDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
}

static uint32_t RunTest(const float* input, uint32_t count, const char* testName)
{
    constexpr uint32_t align = BUFFER_NUM * 8u;
    uint32_t paddedCount = (count + align - 1u) & ~(align - 1u);
    float* paddedInput = new float[paddedCount];
    float* output = new float[paddedCount];
    float* golden = new float[count];

    memcpy(paddedInput, input, count * sizeof(float));
    for (uint32_t i = count; i < paddedCount; i++) {
        paddedInput[i] = 0.0f;
    }

    RunLog1p(paddedInput, output, paddedCount);
    ComputeGolden(input, golden, count);
    uint32_t errors = CompareResults(output, golden, count, testName);

    delete[] paddedInput;
    delete[] output;
    delete[] golden;
    return errors;
}

static float MakeFloat(uint32_t u)
{
    float f;
    memcpy(&f, &u, sizeof(f));
    return f;
}

int main()
{
    uint32_t totalErrors = 0;

    printf("========================================\n");
    printf("  Log1p API Test (arch: dav-3510)\n");
    printf("========================================\n\n");

    // Test 1: Normal positive values
    {
        printf("[Test 1] Normal positive values\n");
        float input[] = {
            0.0f, 0.001f, 0.01f, 0.1f, 0.25f, 0.5f, 0.75f,
            1.0f, 1.5f, 2.0f, 3.0f, 5.0f, 10.0f, 20.0f, 50.0f, 100.0f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Positive values [0..100]");
        printf("\n");
    }

    // Test 2: Small values near zero
    {
        printf("[Test 2] Small values near zero\n");
        float input[] = {
            0.0f, -0.0f,
            1e-7f, -1e-7f,
            1e-6f, -1e-6f,
            1e-5f, -1e-5f,
            1e-4f, -1e-4f,
            1e-3f, -1e-3f,
            FLT_MIN, -FLT_MIN,
            FLT_EPSILON, -FLT_EPSILON
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Small values near zero");
        printf("\n");
    }

    // Test 3: Negative values in (-1, 0)
    {
        printf("[Test 3] Negative values in (-1, 0)\n");
        float input[] = {
            -0.001f, -0.01f, -0.1f, -0.2f, -0.3f, -0.4f, -0.5f,
            -0.6f, -0.7f, -0.8f, -0.9f, -0.95f, -0.99f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Negative values (-1, 0)");
        printf("\n");
    }

    // Test 4: Values very close to -1
    {
        printf("[Test 4] Values very close to -1\n");
        float input[] = {
            -0.9f, -0.99f, -0.999f, -0.9999f,
            -0.99999f, -0.999999f, -0.9999999f*1.0f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Values near -1");
        printf("\n");
    }

    // Test 5: Special values (inf, -inf, nan, -1.0, large values)
    {
        printf("[Test 5] Special values\n");
        float inf = MakeFloat(0x7F800000u);
        float negInf = MakeFloat(0xFF800000u);
        float nanVal = MakeFloat(0x7FC00000u);
        float negOne = -1.0f;
        float negZero = -0.0f;
        float input[] = {inf, negInf, nanVal, negOne, negZero, 0.0f};
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Special values (inf, -inf, nan, -1, +/-0)");
        printf("\n");
    }

    // Test 6: Large positive values
    {
        printf("[Test 6] Large positive values\n");
        float input[] = {
            1e3f, 1e4f, 1e5f, 1e6f, 1e7f, 1e8f, 1e9f, 1e10f,
            1e15f, 1e20f, 1e25f, 1e30f, 1e35f, FLT_MAX
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Large positive values");
        printf("\n");
    }

    // Test 7: Edge values (FLT_MIN, subnormals, etc.)
    {
        printf("[Test 7] Edge / boundary values\n");
        float input[] = {
            FLT_MIN, FLT_MAX,
            MakeFloat(0x00800000u),  // smallest normal float
            MakeFloat(0x00000001u),  // smallest subnormal
            MakeFloat(0x00400000u),  // subnormal
            0.5f, 1.0f,
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Edge / boundary values");
        printf("\n");
    }

    // Test 8: Bulk random test
    {
        printf("[Test 8] Bulk random test (2048 elements)\n");
        constexpr uint32_t count = 2048;
        float* input = new float[count];
        srand(42);
        for (uint32_t i = 0; i < count; i++) {
            float val = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
            val = val * 200.0f - 1.0f;
            input[i] = val;
        }
        totalErrors += RunTest(input, count, "Bulk random [-1, 199] (2048)");
        delete[] input;
        printf("\n");
    }

    // Test 9: Monotonic increasing sequence
    {
        printf("[Test 9] Monotonic increasing sequence\n");
        constexpr uint32_t count = 256;
        float input[count];
        for (uint32_t i = 0; i < count; i++) {
            input[i] = -0.9f + static_cast<float>(i) * 1.9f / static_cast<float>(count - 1);
        }
        totalErrors += RunTest(input, count, "Monotonic [-0.9, 1.0] (256)");
        printf("\n");
    }

    // Test 10: Subnormal values
    {
        printf("[Test 10] Subnormal values\n");
        float input[] = {
            MakeFloat(0x00000001u),
            MakeFloat(0x00000010u),
            MakeFloat(0x00000100u),
            MakeFloat(0x00001000u),
            MakeFloat(0x00010000u),
            MakeFloat(0x00100000u),
            MakeFloat(0x00400000u),
            MakeFloat(0x007FFFFFu),
            -MakeFloat(0x00000001u),
            -MakeFloat(0x00001000u),
            -MakeFloat(0x007FFFFFu),
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Subnormal values");
        printf("\n");
    }

    printf("========================================\n");
    if (totalErrors == 0) {
        printf("  ALL TESTS PASSED\n");
    } else {
        printf("  TOTAL MISMATCHES: %u\n", totalErrors);
        printf("  SOME TESTS FAILED\n");
    }
    printf("========================================\n");

    return totalErrors > 0 ? 1 : 0;
}
