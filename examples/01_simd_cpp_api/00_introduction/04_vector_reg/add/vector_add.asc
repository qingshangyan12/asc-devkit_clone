#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include <cassert>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t innerLength = 1024;
constexpr uint32_t outterLength = 1024;
constexpr uint32_t singleOutterLength = outterLength / 4;

template <typename T, uint32_t innerLength>
__simd_vf__ inline void AddVF(__ubuf__ T* dstAddr, uint32_t rowIdx, uint16_t repeatTimes, uint32_t oneRepeatSize)
{
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::RegTensor<T> srcReg, dstReg;
    
    for (uint16_t i = 0; i < repeatTimes; ++i) {
        AscendC::Reg::LoadAlign(srcReg, dstAddr + rowIdx * innerLength + i * oneRepeatSize);
        AscendC::Reg::LoadAlign(dstReg, dstAddr + (rowIdx + 1) * innerLength + i * oneRepeatSize);
        AscendC::Reg::Add(dstReg, dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign(dstAddr + (rowIdx + 1) * innerLength + i * oneRepeatSize, dstReg, mask);
        AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_LOAD>();
    }
}

template <typename T, uint32_t innerLength, uint32_t singleOutterLength>
class KernelAdd {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }

    __aicore__ inline uint32_t GetCoreOffset()
    {
        return AscendC::GetBlockIdx() * innerLength * singleOutterLength;
    }

    __aicore__ inline void Process()
    {
        uint32_t coreOffset = GetCoreOffset();

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, innerLength * singleOutterLength>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, innerLength * singleOutterLength>();

        AscendC::DataCopy(yLocal, xGm[coreOffset], innerLength * singleOutterLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        __ubuf__ T* dstAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        uint16_t repeatTimes = AscendC::CeilDivision(innerLength, oneRepeatSize);

        for (uint16_t i = 0; i < singleOutterLength - 1; ++i) {
            asc_vf_call<AddVF<T, innerLength>>(dstAddr, i, repeatTimes, oneRepeatSize);
        }

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        AscendC::DataCopy(yGm[coreOffset], yLocal, innerLength * singleOutterLength);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void vector_add(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    KernelAdd<float, innerLength, singleOutterLength> kernel;
    kernel.Init(x, y);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclError ret = aclrtMallocHost((void**)(&goldenData), outSize);
    assert(ret == ACL_SUCCESS && "aclrtMallocHost failed!");
    size_t goldenSize = outSize;
    bool readFileRet = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (readFileRet) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        if (goldenData != nullptr) {
            aclrtFreeHost(goldenData);
        }
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    if (goldenData != nullptr) {
        aclrtFreeHost(goldenData);
    }
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 4;
    aclError ret = aclInit(nullptr);
    assert(ret == ACL_SUCCESS && "aclInit failed!");
    int32_t deviceId = 0;
    ret = aclrtSetDevice(deviceId);
    assert(ret == ACL_SUCCESS && "aclrtSetDevice failed!");
    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    assert(ret == ACL_SUCCESS && "aclrtCreateStream failed!");
    int32_t inner = 1024, outter = 1024;
    size_t aInputByteSize = static_cast<size_t>(1) * inner * outter * sizeof(float);
    size_t outputByteSize = static_cast<size_t>(1) * inner * outter * sizeof(float);
    uint8_t *xHost, *yHost;
    uint8_t *xDevice, *yDevice;
    ret = aclrtMallocHost((void**)(&xHost), aInputByteSize);
    assert(ret == ACL_SUCCESS && "aclrtMallocHost failed!");
    ret = aclrtMallocHost((void**)(&yHost), outputByteSize);
    assert(ret == ACL_SUCCESS && "aclrtMallocHost failed!");
    ret = aclrtMalloc((void**)&xDevice, aInputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    assert(ret == ACL_SUCCESS && "aclrtMalloc failed!");
    ret = aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    assert(ret == ACL_SUCCESS && "aclrtMalloc failed!");
    ReadFile("./input/input_x.bin", aInputByteSize, xHost, aInputByteSize);
    ret = aclrtMemcpy(xDevice, aInputByteSize, xHost, aInputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    assert(ret == ACL_SUCCESS && "aclrtMemcpy failed!");
    vector_add<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
    ret = aclrtSynchronizeStream(stream);
    assert(ret == ACL_SUCCESS && "aclrtSynchronizeStream failed!");
    ret = aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    assert(ret == ACL_SUCCESS && "aclrtMemcpy failed!");
    WriteFile("./output/output.bin", yHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(yHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    if (xDevice != nullptr) {
        aclrtFree(xDevice);
    }
    if (yDevice != nullptr) {
        aclrtFree(yDevice);
    }
    if (xHost != nullptr) {
        aclrtFreeHost(xHost);
    }
    if (yHost != nullptr) {
        aclrtFreeHost(yHost);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
