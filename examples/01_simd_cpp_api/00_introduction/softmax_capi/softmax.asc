/* !
 * \file softmax.asc
 * \brief Softmax C API sample.
 */

#include <cstdint>
#include <cstdio>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "softmax.h"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr uint32_t blockNum = 1;
    constexpr uint32_t totalLength = LOOP_COUNT * SINGLE_VF_DATA_LEN;
    constexpr size_t dataByteSize = totalLength * sizeof(float);

    std::vector<ArgInfo> inputsInfo = {{"./input/input_x.bin", dataByteSize}};
    std::vector<ArgInfo> outputsInfo = {{"./output/output.bin", dataByteSize}};

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    std::vector<uint8_t*> inputHost(inputsInfo.size(), nullptr);
    std::vector<uint8_t*> inputDevice(inputsInfo.size(), nullptr);
    std::vector<uint8_t*> outputHost(outputsInfo.size(), nullptr);
    std::vector<uint8_t*> outputDevice(outputsInfo.size(), nullptr);

    for (uint32_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost(reinterpret_cast<void**>(&inputHost[i]), inputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice[i]), inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        if (!ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length)) {
            ERROR_LOG("read input file failed: %s", inputsInfo[i].fileName.c_str());
            return 1;
        }
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i], inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (uint32_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost(reinterpret_cast<void**>(&outputHost[i]), outputsInfo[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&outputDevice[i]), outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    softmax_custom<<<blockNum, nullptr, stream>>>(inputDevice[0], outputDevice[0]);
    aclrtSynchronizeStream(stream);

    for (uint32_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i], outputsInfo[i].length,
            ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (uint32_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Softmax C API sample completed.\n");
    return 0;
}
