/* !
 * \file add.asc
 * \brief Add算子多场景样例，展示Ascend C向量计算基本用法
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

// 场景1和场景2：shape=[8, 2048]，单核处理2048个元素
template <uint32_t singleCoreLength>
class KernelAddBasic {
public:
    __aicore__ inline KernelAddBasic() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ float*)x + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, singleCoreLength>();
        AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float, singleCoreLength>();
        AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float, singleCoreLength>();

        if constexpr (scenarioNum == 1) {
            // 场景1：使用PipeBarrier同步
            AscendC::DataCopy(xLocal, xGm, singleCoreLength);
            AscendC::DataCopy(yLocal, yGm, singleCoreLength);
            AscendC::PipeBarrier<PIPE_ALL>();
            
            AscendC::Add(zLocal, xLocal, yLocal, singleCoreLength);
            AscendC::PipeBarrier<PIPE_ALL>();
            
            AscendC::DataCopy(zGm, zLocal, singleCoreLength);
        } else if constexpr (scenarioNum == 2) {
            // 场景2：使用SetFlag/WaitFlag同步
            AscendC::DataCopy(xLocal, xGm, singleCoreLength);
            AscendC::DataCopy(yLocal, yGm, singleCoreLength);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            
            AscendC::Add(zLocal, xLocal, yLocal, singleCoreLength);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            
            AscendC::DataCopy(zGm, zLocal, singleCoreLength);
        }
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
};

// 场景3：shape=[2048, 2048]，Tile切分，单缓冲
template <uint32_t singleCoreLength, uint32_t tileLength>
class KernelAddTile {
public:
    __aicore__ inline KernelAddTile() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ float*)x + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        loopCount = singleCoreLength / tileLength;
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float, tileLength>();

        for (uint32_t i = 0; i < loopCount; i++) {
            AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
            AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            
            AscendC::Add(zLocal, xLocal, yLocal, tileLength);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            
            AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t loopCount;
};

// 场景4：shape=[2048, 2048]，Tile切分，Double Buffer
template <uint32_t singleCoreLength, uint32_t tileLength>
class KernelAddDoubleBuffer {
public:
    __aicore__ inline KernelAddDoubleBuffer() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ float*)x + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        loopCount = singleCoreLength / tileLength;
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocalPing = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> yLocalPing = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> zLocalPing = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> xLocalPong = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> yLocalPong = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> zLocalPong = ubAllocator.Alloc<float, tileLength>();

        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
        for (uint32_t i = 0; i < loopCount; i++) {
            int32_t eventID = (i % 2 == 0 ? EVENT_ID0 : EVENT_ID1);
            AscendC::LocalTensor<float>& xLocal = (i % 2 == 0 ? xLocalPing : xLocalPong);
            AscendC::LocalTensor<float>& yLocal = (i % 2 == 0 ? yLocalPing : yLocalPong);
            AscendC::LocalTensor<float>& zLocal = (i % 2 == 0 ? zLocalPing : zLocalPong);
            
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
            AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
            AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventID);
            AscendC::Add(zLocal, xLocal, yLocal, tileLength);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventID);
            AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
        }
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t loopCount;
};

__global__ __vector__ void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    
    if constexpr (scenarioNum == 1 || scenarioNum == 2) {
        // 场景1和场景2：shape=[8, 2048]
        constexpr uint32_t singleCoreLength = 2048;
        KernelAddBasic<singleCoreLength> op;
        op.Init(x, y, z);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        // 场景3：shape=[2048, 2048]，Tile切分，单缓冲
        constexpr uint32_t singleCoreLength = 256 * 2048;
        constexpr uint32_t tileLength = 4 * 2048;
        KernelAddTile<singleCoreLength, tileLength> op;
        op.Init(x, y, z);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        // 场景4：shape=[2048, 2048]，Tile切分，Double Buffer
        constexpr uint32_t singleCoreLength = 256 * 2048;
        constexpr uint32_t tileLength = 4 * 2048;
        KernelAddDoubleBuffer<singleCoreLength, tileLength> op;
        op.Init(x, y, z);
        op.Process();
    } else {
        AscendC::printf("scenarioNum %d is not supported!\n", scenarioNum);
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t numBlocks = 8;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;
    
    if constexpr (scenarioNum == 1 || scenarioNum == 2) {
        inputByteSize = 8 * 2048 * sizeof(float);
        outputByteSize = 8 * 2048 * sizeof(float);
    } else if constexpr (scenarioNum == 3 || scenarioNum == 4) {
        inputByteSize = 2048 * 2048 * sizeof(float);
        outputByteSize = 2048 * 2048 * sizeof(float);
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* zHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    uint8_t* zDevice = nullptr;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    
    aclrtMallocHost((void**)(&yHost), inputByteSize);
    aclrtMalloc((void**)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    add_custom<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
