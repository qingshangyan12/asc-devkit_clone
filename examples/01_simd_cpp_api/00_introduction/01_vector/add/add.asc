/* !
 * \file add.asc
 * \brief Add算子样例，展示Ascend C向量计算基本用法
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cassert>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t BUFFER_NUM = 2;

template<uint32_t singleCoreLength, uint32_t tileLength>
class KernelAddV3 {
public:
    __aicore__ inline KernelAddV3() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ float *)x + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + AscendC::GetBlockIdx() * singleCoreLength, singleCoreLength);
        loopCount = singleCoreLength / tileLength;
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocalPing = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> yLocalPing = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> zLocalPing = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> xLocalPong = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> yLocalPong = ubAllocator.Alloc<float, tileLength>();
        AscendC::LocalTensor<float> zLocalPong = ubAllocator.Alloc<float, tileLength>();

        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
        for (uint32_t i = 0; i < loopCount; i++) {
            int32_t eventID = (i % 2 == 0 ? EVENT_ID0 : EVENT_ID1);
            AscendC::LocalTensor<float> &xLocal = (i % 2 == 0 ? xLocalPing : xLocalPong);
            AscendC::LocalTensor<float> &yLocal = (i % 2 == 0 ? yLocalPing : yLocalPong);
            AscendC::LocalTensor<float> &zLocal = (i % 2 == 0 ? zLocalPing : zLocalPong);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
            AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
            AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventID);
            AscendC::Add(zLocal, xLocal, yLocal, tileLength);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventID);
            AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
        }
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t loopCount;
};

struct ArgInfo {
    std::string fileName;
    size_t length;
};

template<uint32_t singleCoreLength, uint32_t tileLength>
__global__ __vector__ void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelAddV3<singleCoreLength, tileLength> op;
    op.Init(x, y, z);
    op.Process();
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t numBlocks = 8;
    constexpr uint32_t singleCoreLength = 4096 * 9;
    constexpr uint32_t tileLength = 4096;
    constexpr uint32_t dataLen = singleCoreLength * numBlocks;
    constexpr size_t inputByteSize = dataLen * sizeof(float);
    constexpr size_t outputByteSize = dataLen * sizeof(float);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", inputByteSize},
        {"./input/input_y.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());

    aclError ret = aclInit(nullptr);
    assert(ret == ACL_SUCCESS && "aclInit failed!");

    int32_t deviceId = 0;
    ret = aclrtSetDevice(deviceId);
    assert(ret == ACL_SUCCESS && "aclrtSetDevice failed!");

    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    assert(ret == ACL_SUCCESS && "aclrtCreateStream failed!");

    ret = aclrtMallocHost((void **)(&inputHost[0]), inputsInfo[0].length);
    assert(ret == ACL_SUCCESS && "aclrtMallocHost inputHost[0] failed!");
    ret = aclrtMalloc((void **)(&inputDevice[0]), inputsInfo[0].length, ACL_MEM_MALLOC_HUGE_FIRST);
    assert(ret == ACL_SUCCESS && "aclrtMalloc inputDevice[0] failed!");
    ReadFile(inputsInfo[0].fileName, inputsInfo[0].length, inputHost[0], inputsInfo[0].length);
    ret = aclrtMemcpy(inputDevice[0], inputsInfo[0].length, inputHost[0], inputsInfo[0].length, ACL_MEMCPY_HOST_TO_DEVICE);
    assert(ret == ACL_SUCCESS && "aclrtMemcpy inputHost[0] to inputDevice[0] failed!");

    ret = aclrtMallocHost((void **)(&inputHost[1]), inputsInfo[1].length);
    assert(ret == ACL_SUCCESS && "aclrtMallocHost inputHost[1] failed!");
    ret = aclrtMalloc((void **)(&inputDevice[1]), inputsInfo[1].length, ACL_MEM_MALLOC_HUGE_FIRST);
    assert(ret == ACL_SUCCESS && "aclrtMalloc inputDevice[1] failed!");
    ReadFile(inputsInfo[1].fileName, inputsInfo[1].length, inputHost[1], inputsInfo[1].length);
    ret = aclrtMemcpy(inputDevice[1], inputsInfo[1].length, inputHost[1], inputsInfo[1].length, ACL_MEMCPY_HOST_TO_DEVICE);
    assert(ret == ACL_SUCCESS && "aclrtMemcpy inputHost[1] to inputDevice[1] failed!");

    ret = aclrtMallocHost((void **)(&outputHost[0]), outputsInfo[0].length);
    assert(ret == ACL_SUCCESS && "aclrtMallocHost outputHost[0] failed!");
    ret = aclrtMalloc((void **)(&outputDevice[0]), outputsInfo[0].length, ACL_MEM_MALLOC_HUGE_FIRST);
    assert(ret == ACL_SUCCESS && "aclrtMalloc outputDevice[0] failed!");

    add_custom<singleCoreLength, tileLength><<<numBlocks, nullptr, stream>>>(inputDevice[0], inputDevice[1], outputDevice[0]);
    ret = aclrtSynchronizeStream(stream);
    assert(ret == ACL_SUCCESS && "aclrtSynchronizeStream failed!");

    ret = aclrtMemcpy(outputHost[0], outputsInfo[0].length, outputDevice[0], outputsInfo[0].length, ACL_MEMCPY_DEVICE_TO_HOST);
    assert(ret == ACL_SUCCESS && "aclrtMemcpy outputDevice[0] to outputHost[0] failed!");
    WriteFile(outputsInfo[0].fileName, outputHost[0], outputsInfo[0].length);

    if (outputDevice[0] != nullptr) {
        aclrtFree(outputDevice[0]);
        outputDevice[0] = nullptr;
    }
    if (outputHost[0] != nullptr) {
        aclrtFreeHost(outputHost[0]);
        outputHost[0] = nullptr;
    }

    if (inputDevice[0] != nullptr) {
        aclrtFree(inputDevice[0]);
        inputDevice[0] = nullptr;
    }
    if (inputHost[0] != nullptr) {
        aclrtFreeHost(inputHost[0]);
        inputHost[0] = nullptr;
    }
    if (inputDevice[1] != nullptr) {
        aclrtFree(inputDevice[1]);
        inputDevice[1] = nullptr;
    }
    if (inputHost[1] != nullptr) {
        aclrtFreeHost(inputHost[1]);
        inputHost[1] = nullptr;
    }

    if (stream != nullptr) {
        aclrtDestroyStream(stream);
        stream = nullptr;
    }

    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}