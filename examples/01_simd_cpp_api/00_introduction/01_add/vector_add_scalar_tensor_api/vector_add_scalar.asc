/* !
 * \file vector_add_scalar.asc
 * \brief Vector element-wise add scalar based on tensor_api Transform<AddScalar>
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "kernel_operator.h"
#include <cstdint>
#include <random>
#include <cmath>
#include <cstdio>

// T: data type, U: instruction type
template <typename T, typename U>
__global__ __vector__ void add_scalar_custom(__gm__ T* inputPtr, __gm__ T* resultPtr, T scalar, uint32_t totalLength)
{
    using namespace AscendC::Te;
    uint8_t mutexId = 0;

    // Create GM tensors (1D layout)
    auto gmInput = MakeTensor(MakeMemPtr(inputPtr), MakeFrameLayout<NDExtLayoutPtn>(AscendC::Std::Int<1>{}, totalLength));
    auto gmResult = MakeTensor(MakeMemPtr(resultPtr), MakeFrameLayout<NDExtLayoutPtn>(AscendC::Std::Int<1>{}, totalLength));

    // UB addr offset
    uint32_t ubInputOffset = 0;
    uint32_t ubResultOffset = totalLength * sizeof(T);

    // Create UB tensors
    auto ubInput = MakeTensor(MakeMemPtr<Location::UB, T>(ubInputOffset), MakeFrameLayout<NDExtLayoutPtn>(AscendC::Std::Int<1>{}, totalLength));
    auto ubResult = MakeTensor(MakeMemPtr<Location::UB, T>(ubResultOffset), MakeFrameLayout<NDExtLayoutPtn>(AscendC::Std::Int<1>{}, totalLength));

    // Create copy atoms
    auto copyGM2UBAtom = MakeCopy(CopyGM2UB{});
    auto copyUB2GMAtom = MakeCopy(CopyUB2GM{});

    // Copy input from GM to UB
    AscendC::Mutex::Lock<PIPE_MTE2>(mutexId);
    Copy(copyGM2UBAtom, ubInput, gmInput);
    AscendC::Mutex::Unlock<PIPE_MTE2>(mutexId);

    // Perform element-wise add scalar instruction
    AscendC::Mutex::Lock<PIPE_V>(mutexId);
    Transform<U>(ubResult, ubInput, scalar);
    AscendC::Mutex::Unlock<PIPE_V>(mutexId);

    // Copy result from UB to GM
    AscendC::Mutex::Lock<PIPE_MTE3>(mutexId);
    Copy(copyUB2GMAtom, gmResult, ubResult);
    AscendC::Mutex::Unlock<PIPE_MTE3>(mutexId);
}

int32_t main(int32_t argc, char* argv[])
{
    using dataType = float;
    uint32_t totalLength = 256;
    size_t fileSize = totalLength * sizeof(dataType);
    uint32_t numBlocks = 1;
    dataType scalar = 3.14f;

    // Generate random input data and compute golden result
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<float> dis(-50.0f, 50.0f);

    dataType inputHost[totalLength];
    dataType golden[totalLength];
    for (uint32_t i = 0; i < totalLength; ++i) {
        inputHost[i] = dis(gen);
        golden[i] = inputHost[i] + scalar;
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    dataType* inputDevice;
    aclrtMalloc((void**)&inputDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(inputDevice, fileSize, inputHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    dataType* resultHost;
    dataType* resultDevice;
    aclrtMallocHost((void**)(&resultHost), fileSize);
    aclrtMalloc((void**)&resultDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    add_scalar_custom<dataType, AscendC::Te::Inst::AddScalar><<<numBlocks, 0, stream>>>(inputDevice, resultDevice, scalar, totalLength);
    aclrtSynchronizeStream(stream);

    // Verify result
    aclrtMemcpy(resultHost, fileSize, resultDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);

    constexpr float EPS = 1e-4f;
    int64_t wrongNum = 0;
    for (uint32_t i = 0; i < totalLength; ++i) {
        dataType output = reinterpret_cast<dataType*>(resultHost)[i];
        dataType expected = golden[i];
        float diff = std::fabs(output - expected);
        if (diff > EPS) {
            printf("CompareResult failed at index %u: output is %f, golden is %f\n", i, output, expected);
            wrongNum++;
        }
    }

    if (wrongNum == 0) {
        printf("CompareResult passed, all %u elements are correct.\n", totalLength);
    } else {
        printf("CompareResult failed, %ld elements are wrong.\n", wrongNum);
    }

    aclrtFree(inputDevice);
    aclrtFreeHost(inputHost);
    aclrtFree(resultDevice);
    aclrtFreeHost(resultHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
