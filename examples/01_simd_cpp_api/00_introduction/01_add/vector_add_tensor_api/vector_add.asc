/* !
 * \file vector_add.asc
 * \brief Vector element-wise add based on tensor_api Transform<Add>
 */

#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

template <uint32_t totalLength>
__global__ __vector__ void add_custom(__gm__ float* a, __gm__ float* b, __gm__ float* c)
{
    using namespace AscendC::Te;

    // Create GM tensors (1D layout)
    auto gmA = MakeTensor(MakeMemPtr<Location::GM>(a), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto gmB = MakeTensor(MakeMemPtr<Location::GM>(b), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto gmC = MakeTensor(MakeMemPtr<Location::GM>(c), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));

    // Allocate UB buffers
    __ubuf__ float ubABuf[totalLength];
    __ubuf__ float ubBBuf[totalLength];
    __ubuf__ float ubCBuf[totalLength];

    // Create UB tensors
    auto ubA = MakeTensor(MakeMemPtr(ubABuf), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto ubB = MakeTensor(MakeMemPtr(ubBBuf), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto ubC = MakeTensor(MakeMemPtr(ubCBuf), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));

    // Create copy atoms
    auto copyGM2UBAtom = MakeCopy(CopyGM2UB{}, CopyGM2UBTraitDefault{});
    auto copyUB2GMAtom = MakeCopy(CopyUB2GM{}, CopyUB2GMTraitDefault{});

    // Copy inputs from GM to UB
    Copy(copyGM2UBAtom, ubA, gmA);
    Copy(copyGM2UBAtom, ubB, gmB);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // Perform element-wise addition: C = A + B
    Transform<AscendC::Te::Inst::Add>(ubC, ubA, ubB);

    // Copy result from UB to GM
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    Copy(copyUB2GMAtom, gmC, ubC);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalLength = 8192;
    size_t fileSize = totalLength * sizeof(float);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* aHost;
    float* aDevice;
    aclrtMallocHost((void**)(&aHost), fileSize);
    aclrtMalloc((void**)&aDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fileSize, aHost, fileSize);
    aclrtMemcpy(aDevice, fileSize, aHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    float* bHost;
    float* bDevice;
    aclrtMallocHost((void**)(&bHost), fileSize);
    aclrtMalloc((void**)&bDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", fileSize, bHost, fileSize);
    aclrtMemcpy(bDevice, fileSize, bHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    float* cHost;
    float* cDevice;
    aclrtMallocHost((void**)(&cHost), fileSize);
    aclrtMalloc((void**)&cDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    add_custom<totalLength><<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, fileSize, cDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, fileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
