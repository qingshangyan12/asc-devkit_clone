/* !
 * \file vector_add.asc
 * \brief Vector element-wise add based on tensor_api Transform<Add>
 */

#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"
#include <cstdint>

constexpr uint32_t totalLength = 256;

template <typename T>
__global__ __vector__ void add_custom(GM_ADDR input_x, GM_ADDR input_y, GM_ADDR result)
{
    using namespace AscendC::Te;

    // Create GM tensors (1D layout)
    auto gmInputX = MakeTensor(MakeMemPtr(reinterpret_cast<__gm__ T *>(input_x)), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto gmInputY = MakeTensor(MakeMemPtr(reinterpret_cast<__gm__ T *>(input_y)), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto gmResult = MakeTensor(MakeMemPtr(reinterpret_cast<__gm__ T *>(result)), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));

    // Allocate UB buffers
    __ubuf__ T ubInputXBuf[totalLength];
    __ubuf__ T ubInputYBuf[totalLength];
    __ubuf__ T ubResultBuf[totalLength];

    // Create UB tensors
    auto ubInputX = MakeTensor(MakeMemPtr(ubInputXBuf), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto ubInputY = MakeTensor(MakeMemPtr(ubInputYBuf), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));
    auto ubResult = MakeTensor(MakeMemPtr(ubResultBuf), MakeFrameLayout<NDExtLayoutPtn>(_1{}, AscendC::Std::Int<totalLength>{}));

    // Create copy atoms
    auto copyGM2UBAtom = MakeCopy(CopyGM2UB{});
    auto copyUB2GMAtom = MakeCopy(CopyUB2GM{});

    // Copy inputs from GM to UB
    Copy(copyGM2UBAtom, ubInputX, gmInputX);
    Copy(copyGM2UBAtom, ubInputY, gmInputY);

    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    // Perform element-wise addition: result = input_x + input_y
    Transform<AscendC::Te::Inst::Add>(ubResult, ubInputX, ubInputY);

    // Copy result from UB to GM
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    Copy(copyUB2GMAtom, gmResult, ubResult);
}

int32_t main(int32_t argc, char* argv[])
{
    using dataType = float;
    size_t fileSize = totalLength * sizeof(dataType);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* inputXHost;
    uint8_t* inputXDevice;
    aclrtMallocHost((void**)(&inputXHost), fileSize);
    aclrtMalloc((void**)&inputXDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", fileSize, inputXHost, fileSize);
    aclrtMemcpy(inputXDevice, fileSize, inputXHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* inputYHost;
    uint8_t* inputYDevice;
    aclrtMallocHost((void**)(&inputYHost), fileSize);
    aclrtMalloc((void**)&inputYDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_y.bin", fileSize, inputYHost, fileSize);
    aclrtMemcpy(inputYDevice, fileSize, inputYHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* resultHost;
    uint8_t* resultDevice;
    aclrtMallocHost((void**)(&resultHost), fileSize);
    aclrtMalloc((void**)&resultDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    add_custom<dataType><<<numBlocks, nullptr, stream>>>(inputXDevice, inputYDevice, resultDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(resultHost, fileSize, resultDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", resultHost, fileSize);

    aclrtFree(inputXDevice);
    aclrtFreeHost(inputXHost);
    aclrtFree(inputYDevice);
    aclrtFreeHost(inputYHost);
    aclrtFree(resultDevice);
    aclrtFreeHost(resultHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
