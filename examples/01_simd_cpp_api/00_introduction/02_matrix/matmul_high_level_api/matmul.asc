/* !
 * \file matmul.asc
 * \brief 使用Matmul高级API实现矩阵乘法，展示高阶矩阵乘接口的使用方法
 */

#include "data_utils.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

using namespace matmul;

__aicore__ inline void CopyTiling(TCubeTiling* tiling, __gm__ uint8_t* tilingGM)
{
    uint32_t* ptr = reinterpret_cast<uint32_t*>(tiling);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t*>(tilingGM);

    // Host侧通过GetTiling生成TCubeTiling后，会把tiling数据拷贝到Device侧GM。
    // Kernel侧不能直接访问Host指针，因此这里按uint32_t逐字段读取GM中的tiling数据，
    // 拷贝到局部变量tiling后，再传给Matmul高阶API用于控制分核、base块大小和内部buffer使用。
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); i++, ptr++) {
        *ptr = *(tiling32 + i);
    }
}

__global__ __aicore__ void matmul_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* workspace, __gm__ uint8_t* tilingGm)
{
    // 这里的workspace是Kernel运行时注入的系统工作区，Matmul高阶API会通过GetSysWorkSpacePtr()使用该参数，其主要用于保存Matmul内部运行所需的临时资源和中间状态。
    AscendC::TPipe pipe;
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGm);

    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> cGlobal;
    // A、B、C矩阵均按ND格式连续存放在GM中，SetGlobalBuffer的第二个参数是元素个数。
    // A矩阵形状为[M, Ka]，B矩阵形状为[Kb, N]，C矩阵形状为[M, N]。
    // GlobalTensor只描述GM上的地址和长度，真正的数据搬运、L1/L0C切分由Matmul高阶API结合tiling完成。
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);

    // Matmul模板参数描述A/B/C矩阵在Kernel侧的位置、格式和数据类型：
    // - A、B、C都来自GM，格式均为ND；
    // - A/B为half，C为float；
    // - 这里的配置需要和Host侧SetAType、SetBType、SetCType保持一致。
    Matmul<
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        mm;
    // REGIST_MATMUL_OBJ用于初始化Matmul对象。需要传入TPipe、系统workspace、Matmul对象以及与该对象对应的TCubeTiling。
    // Matmul内部会基于这些信息管理数据搬运、Cube计算调度以及必要的内部同步资源。
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    // usedCoreNum是Host侧GetTiling计算出的实际使用核数。启动Kernel时numBlocks也来自该字段，
    // 避免异常情况下无效block继续访问输入输出地址。
    if (GetBlockIdx() >= tiling.usedCoreNum) {
        return;
    }
    // SetOrgShape设置原始完整矩阵形状，单位为元素。接口要求在SetTensorA、SetTensorB之前调用。
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    // SetTensorA/SetTensorB设置当前核参与计算的A、B矩阵起始地址，第二个参数false表示不转置。
    // SetTensorA接口要求A地址空间至少覆盖singleM * singleK。本样例按M轴分核：
    // - A偏移 = blockIdx * singleCoreM * Ka，表示跳过前面核已经处理的A矩阵行；
    // - B不按M轴分核，两个核都需要完整B矩阵参与K轴累加，因此从bGlobal[0]开始读取。
    mm.SetTensorA(aGlobal[GetBlockIdx() * tiling.Ka * tiling.singleCoreM], false);
    mm.SetTensorB(bGlobal[0], false);
    // IterateAll一次计算当前核负责的singleCoreM * singleCoreN大小的C矩阵块。
    // 本样例输出C按[M, N]连续存放，当前核写回偏移为blockIdx * singleCoreM * N。
    mm.IterateAll(cGlobal[GetBlockIdx() * tiling.singleCoreM * tiling.N]);
    // End用于结束当前Matmul对象的使用并释放内部计算资源；后续如果还有其他Matmul对象，
    // 调用End可避免多个Matmul对象之间的资源冲突。
    mm.End();
}

void GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform, uint8_t* tilingBuf)
{
    constexpr int32_t M = 512;
    constexpr int32_t N = 1024;
    constexpr int32_t K = 512;

    optiling::TCubeTiling tilingData;
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);

    // SetDim设置多核Matmul tiling计算时可使用的核数。纯Cube矩阵计算场景下，
    // GetTiling会在该核数约束内生成实际使用核数usedCoreNum。本样例固定为2，
    // 便于观察两核沿M轴分工的地址偏移关系。
    tilingApi.SetDim(2);
    // SetAType/SetBType/SetCType设置矩阵所在位置、数据格式和数据类型。
    // 这些信息需要和Kernel侧MatmulType模板参数、SetTensorA/SetTensorB的转置参数保持一致：
    // A/B/C都在GM，格式为ND；A/B为float16且不转置；C为float。
    tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);

    // SetOrgShape设置原始完整矩阵形状，SetShape设置本次实际参与Matmul计算的m/n/k。
    // 本样例计算完整矩阵乘，没有局部矩阵或脏数据列，因此两者都设置为M/N/K。
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    // 本样例只计算C=A*B，不带bias；设置为false后Kernel侧也不需要调用SetBias。
    tilingApi.EnableBias(false);
    // SetBufferSpace用于设置Matmul可使用的L1/L0C/UB空间大小，单位为字节。
    // 传入-1表示使用当前AI处理器对应buffer的默认大小，由tiling接口据此选择base块和搬运策略。
    tilingApi.SetBufferSpace(-1, -1, -1);

    // GetTiling输出TCubeTiling，里面包含usedCoreNum、singleCoreM/N/K、baseM/N/K等信息。
    // 如果返回-1表示tiling计算失败，此时tiling结果不可继续使用。
    int64_t res = tilingApi.GetTiling(tilingData);
    if (res == -1) {
        std::cout << "gen tiling failed" << std::endl;
    }
    uint32_t tcubeTilingSize = tilingData.GetDataSize();
    // 将Host侧tiling结构序列化到tilingBuf，后续拷贝到Device侧GM，Kernel通过CopyTiling读取。
    tilingData.SaveToBuffer(tilingBuf, tcubeTilingSize);
}

int32_t main(int32_t argc, char* argv[])
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    size_t aFileSize = 512 * 512 * sizeof(uint16_t);
    size_t bFileSize = 512 * 1024 * sizeof(uint16_t);
    size_t cFileSize = 512 * 1024 * sizeof(float);
    size_t tilingFileSize = sizeof(TCubeTiling);
    size_t userWorkspaceSize = 0;
    size_t systemWorkspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());
    // Matmul高阶API内部可能使用系统workspace，Kernel侧通过GetSysWorkSpacePtr()取得该空间。
    size_t workspaceSize = userWorkspaceSize + systemWorkspaceSize;
    uint8_t* tilingBuf = (uint8_t*)malloc(tilingFileSize);
    GenerateTiling(ascendcPlatform, tilingBuf);
    // Kernel启动核数使用tiling实际生成的usedCoreNum，而不是直接写死SetDim传入值。
    // 这样Host侧启动配置和Matmul tiling结果保持一致。
    uint32_t numBlocks = reinterpret_cast<TCubeTiling*>(tilingBuf)->usedCoreNum;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* workspaceDevice;
    aclrtMalloc((void**)&workspaceDevice, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* tilingHost;
    uint8_t* tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), tilingFileSize);
    aclrtMalloc((void**)&tilingDevice, tilingFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    // tilingBuf是Host普通内存，先拷贝到Host页锁定内存tilingHost，再拷贝到Device侧tilingDevice。
    // Kernel入参tilingDevice指向GM中的TCubeTiling数据。
    aclrtMemcpy(tilingHost, tilingFileSize, tilingBuf, tilingFileSize, ACL_MEMCPY_HOST_TO_HOST);
    aclrtMemcpy(tilingDevice, tilingFileSize, tilingHost, tilingFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_custom<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, workspaceDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(tilingHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    free(tilingBuf);
    return 0;
}
