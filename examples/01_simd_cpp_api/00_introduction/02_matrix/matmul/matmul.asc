/* !
 * \file matmul.asc
 * \brief 使用静态Tensor编程模式实现矩阵乘法，展示Cube单元的基本使用方法
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M = 128;
constexpr uint32_t K = 128;
constexpr uint32_t N = 128;

__global__ __cube__ void matmul_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> cGm;
    aGm.SetGlobalBuffer((__gm__ half*)a, M * K);
    bGm.SetGlobalBuffer((__gm__ half*)b, K * N);
    cGm.SetGlobalBuffer((__gm__ half*)c, M * N);

    uint32_t blockIdx = AscendC::GetBlockIdx();
    uint32_t localM = M / 2;

    AscendC::LocalTensor<half> l1aLocal(AscendC::TPosition::A1, 0, localM * K);
    AscendC::LocalTensor<half> l1bLocal(AscendC::TPosition::B1, 256 * 1024, K * N);
    AscendC::LocalTensor<half> l0aLocal(AscendC::TPosition::A2, 0, localM * K);
    AscendC::LocalTensor<half> l0bLocal(AscendC::TPosition::B2, 0, K * N);
    AscendC::LocalTensor<float> l0cLocal(AscendC::TPosition::CO1, 0, localM * N);

    AscendC::DataCopy(
        l1aLocal, aGm[blockIdx * localM * K],
        AscendC::Nd2NzParams{1, static_cast<uint16_t>(localM), K, 0, K, static_cast<uint16_t>(localM), 1, 0});
    AscendC::DataCopy(l1bLocal, bGm, AscendC::Nd2NzParams{1, K, N, 0, N, K, 1, 0});

    AscendC::PipeBarrier<PIPE_ALL>();

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
    for (int i = 0; i < localM / CUBE_BLOCK; ++i) {
        AscendC::LoadData(
            l0aLocal[i * K * CUBE_BLOCK], l1aLocal[i * 512 / sizeof(half)],
            AscendC::LoadData2DParams{0, K / CUBE_BLOCK, static_cast<uint16_t>(localM / CUBE_BLOCK), 0, 0, false, 0});
    }
    for (int i = 0; i < K / CUBE_BLOCK; ++i) {
        AscendC::LoadData(
            l0bLocal[i * N * CUBE_BLOCK], l1bLocal[i * 512 / sizeof(half)],
            AscendC::LoadData2DParams{0, N / CUBE_BLOCK, K / CUBE_BLOCK, 0, 0, true, 0});
    }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    AscendC::LoadData(
        l0aLocal, l1aLocal,
        AscendC::LoadData2DParamsV2{
            0, 0, static_cast<uint16_t>(AscendC::DivCeil(localM, CUBE_BLOCK)), AscendC::DivCeil(K * sizeof(half), 32),
            static_cast<int32_t>(AscendC::DivCeil(localM, CUBE_BLOCK)),
            static_cast<uint16_t>(AscendC::DivCeil(localM, CUBE_BLOCK)), false, 0});
    AscendC::LoadData(
        l0bLocal, l1bLocal,
        AscendC::LoadData2DParamsV2{
            0, 0, AscendC::DivCeil(K, CUBE_BLOCK), AscendC::DivCeil(N * sizeof(half), 32),
            AscendC::DivCeil(K, CUBE_BLOCK), AscendC::DivCeil(N, CUBE_BLOCK), true, 0});
#endif

    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Mmad(
        l0cLocal, l0aLocal, l0bLocal,
        AscendC::MmadParams{
            static_cast<uint16_t>(localM), static_cast<uint16_t>(N), static_cast<uint16_t>(K), static_cast<uint16_t>(0),
            false, true});

    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Fixpipe(
        cGm[blockIdx * localM * N], l0cLocal,
        AscendC::FixpipeParamsV220{
            N, static_cast<uint16_t>(localM), static_cast<uint16_t>(localM), N, false, QuantMode_t::F322F16, 0, 1, 0, 0,
            0});

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize = M * N * sizeof(half);
    uint32_t numBlocks = 2;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_custom<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
