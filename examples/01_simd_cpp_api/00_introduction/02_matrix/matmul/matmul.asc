/* !
 * \file matmul.asc
 * \brief 使用静态Tensor编程模式实现矩阵乘法，展示Cube单元的基本使用方法
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M = 128;
constexpr uint32_t K = 128;
constexpr uint32_t N = 128;

constexpr uint32_t DST_OFFSET_A = K * CUBE_BLOCK;
constexpr uint32_t DST_OFFSET_B = N * CUBE_BLOCK;
constexpr uint32_t SRC_OFFSET = 512 / sizeof(half);
constexpr uint32_t SIZE_A = M * K;
constexpr uint32_t SIZE_B = K * N;
constexpr uint32_t SIZE_C = M * N;

__aicore__ inline AscendC::Nd2NzParams MakeCopyAParams()
{
    AscendC::Nd2NzParams p{};
    p.ndNum = 1;
    p.nValue = M;
    p.dValue = K;
    p.srcNdMatrixStride = 0;
    p.srcDValue = K;
    p.dstNzC0Stride = M;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    return p;
}

__aicore__ inline AscendC::Nd2NzParams MakeCopyBParams()
{
    AscendC::Nd2NzParams p{};
    p.ndNum = 1;
    p.nValue = K;
    p.dValue = N;
    p.srcNdMatrixStride = 0;
    p.srcDValue = N;
    p.dstNzC0Stride = K;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    return p;
}

__aicore__ inline AscendC::LoadData2DParams MakeLoadAParams()
{
    AscendC::LoadData2DParams p{};
    p.repeatTimes = K / CUBE_BLOCK;
    p.srcStride = M / CUBE_BLOCK;
    p.dstGap = 0;
    p.ifTranspose = false;
    return p;
}

__aicore__ inline AscendC::LoadData2DParams MakeLoadBParams()
{
    AscendC::LoadData2DParams p{};
    p.repeatTimes = N / CUBE_BLOCK;
    p.srcStride = K / CUBE_BLOCK;
    p.dstGap = 0;
    p.ifTranspose = true;
    return p;
}

__aicore__ inline AscendC::MmadParams MakeMmadParams()
{
    AscendC::MmadParams p{};
    p.m = M;
    p.n = N;
    p.k = K;
    p.cmatrixInitVal = true;
    return p;
}

__aicore__ inline AscendC::FixpipeParamsV220 MakeFixpipeParams()
{
    AscendC::FixpipeParamsV220 p{};
    p.nSize = N;
    p.mSize = M;
    p.srcStride = M;
    p.dstStride = N;
    p.quantPre = QuantMode_t::F322F16;
    p.ndNum = 1;
    p.srcNdStride = 0;
    p.dstNdStride = 0;
    return p;
}

__global__ __cube__ void matmul_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> cGm;
    aGm.SetGlobalBuffer((__gm__ half*)a, SIZE_A);
    bGm.SetGlobalBuffer((__gm__ half*)b, SIZE_B);
    cGm.SetGlobalBuffer((__gm__ half*)c, SIZE_C);

    AscendC::LocalTensor<half> l1aLocal(AscendC::TPosition::A1, 0, SIZE_A);
    AscendC::LocalTensor<half> l1bLocal(AscendC::TPosition::B1, 256 * 1024, SIZE_B);
    AscendC::LocalTensor<half> l0aLocal(AscendC::TPosition::A2, 0, SIZE_A);
    AscendC::LocalTensor<half> l0bLocal(AscendC::TPosition::B2, 0, SIZE_B);
    AscendC::LocalTensor<float> l0cLocal(AscendC::TPosition::CO1, 0, SIZE_C);

    auto copyAParams = MakeCopyAParams();
    auto copyBParams = MakeCopyBParams();
    auto loadAParams = MakeLoadAParams();
    auto loadBParams = MakeLoadBParams();
    auto mmadParams = MakeMmadParams();
    auto fixpipeParams = MakeFixpipeParams();

    AscendC::DataCopy(l1aLocal, aGm, copyAParams);
    AscendC::DataCopy(l1bLocal, bGm, copyBParams);

    AscendC::PipeBarrier<PIPE_ALL>();

    for (int i = 0; i < M / CUBE_BLOCK; ++i) {
        AscendC::LoadData(l0aLocal[i * DST_OFFSET_A], l1aLocal[i * SRC_OFFSET], loadAParams);
    }
    for (int i = 0; i < K / CUBE_BLOCK; ++i) {
        AscendC::LoadData(l0bLocal[i * DST_OFFSET_B], l1bLocal[i * SRC_OFFSET], loadBParams);
    }

    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Mmad(l0cLocal, l0aLocal, l0bLocal, mmadParams);

    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Fixpipe(cGm, l0cLocal, fixpipeParams);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t aFileSize = SIZE_A * sizeof(half);
    size_t bFileSize = SIZE_B * sizeof(half);
    size_t cFileSize = SIZE_C * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_custom<<<1, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
