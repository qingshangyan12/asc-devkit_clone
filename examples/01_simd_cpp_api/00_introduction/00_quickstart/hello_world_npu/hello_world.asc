#include "kernel_operator.h"
#include "acl/acl.h"
#include <iostream>
#include <atomic>
#include <errno.h>
#include <pthread.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/time.h>
#include <time.h>
#include <unistd.h>
#include "driver/ascend_hal_base.h"
#include "profiling/aprof_pub.h"
#include "runtime/rt_external_base.h"

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        PROF_LOG("call %s", #expr);                                                                     \
        aclError ret = (expr);                                                                          \
        if (ret != ACL_SUCCESS) {                                                                       \
            PROF_LOG("%s failed, ret=%d", #expr, ret);                                                  \
            return ret;                                                                                 \
        }                                                                                               \
        PROF_LOG("%s success", #expr);                                                                  \
    } while (0)

#define PROF_LOG(fmt, ...)                                                                              \
    do {                                                                                                \
        (void)fprintf(stderr, "[PROF-DEMO] " fmt "\n", ##__VA_ARGS__);                                  \
        (void)fflush(stderr);                                                                           \
    } while (0)

#define PROF_MARK_STAMP_COUNT 300U

class KernelAddV3 {
public:
    __aicore__ inline KernelAddV3() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer((__gm__ float *)x);
        yGm.SetGlobalBuffer((__gm__ float *)y);
    }

    __aicore__ inline void Process()
    {
        // use local memory allocator to simplify memor allocation
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        // ping
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, 10 * 1024>();

        // double buffer
        for (int i = 0; i < 1000; i++) {
            AscendC::DataCopy(xLocal, xGm, 10 * 1024);
            bisheng::cce::mark_stamp<PIPE_S>(1234);
            AscendC::PipeBarrier<PIPE_ALL>();
            for (uint32_t j = 0; j < PROF_MARK_STAMP_COUNT; ++j) {
                bisheng::cce::mark_stamp<PIPE_MTE2>(123);
            }
            AscendC::DataCopy(yGm, xLocal, 10 * 1024);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Nop<100000>();
        }
        // dependency of PIPE_MTE3 & PIPE_MTE2 caused by zLocal between 2 sequential loops
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
};

__global__ __vector__ void hello_world(GM_ADDR x, GM_ADDR y)
{
    KernelAddV3 op;
    op.Init(x, y);
    op.Process();

}

#define PROF_READ_BUF_SIZE (256U * 1024U)
#define PROF_READ_IDLE_US  (10U * 1000U)
#define PROF_DEFAULT_DEVICE_ID 0U
#define PROF_INSTR 0x00800000ULL
#define PROF_KERNEL_LAUNCH_COUNT 100U
#define PROF_KERNEL_BLOCK_COUNT 64U
#define PROF_BIU_PERF_CYCLE 16U
#define PROF_BIU_PC_SAMPLING_MODE 0U
#define PROF_BIU_DIE0_AICORE_NUM 18U
#define PROF_BIU_GROUP_NUM 6U
#define PROF_BIU_LOWER_GROUP_NUM 3U
#define PROF_BIU_HIGHER_GROUP_NUM 6U
#define PROF_BIU_GROUP_CHANNEL_NUM 3U
#define PROF_BIU_GROUP_TYPE_AIC 0U
#define PROF_BIU_GROUP_TYPE_AIV0 1U
#define PROF_BIU_GROUP_TYPE_AIV1 2U
#define PROF_BIU_SAMPLE_GROUP_ID 0U
#define PROF_BIU_SAMPLE_GROUP_TYPE PROF_BIU_GROUP_TYPE_AIV0
#define PROF_BIU_SAMPLE_OUTPUT_FILE "hello_world_biu_perf_aiv0.bin"

typedef struct {
    uint32_t period;
    uint32_t biuPcSamplingMode;
    uint32_t groupType;
    uint32_t groupNo;
} ProfBiuProfileConfig;

typedef struct {
    unsigned int device_id;
    unsigned int channel_id;
    uint32_t biu_group_id;
    uint32_t biu_group_type;
    uint32_t biu_group_no;
    uint64_t total_bytes;
    uint32_t read_count;

    char output_path[512];
    pthread_t thread;
    std::atomic<int> stop_requested;
    pthread_mutex_t start_mutex;
    pthread_cond_t start_cond;
    int start_done;
    int start_ret;

    int thread_ret;
} ProfSampler;

static const unsigned int g_biu_group_channel_map[PROF_BIU_GROUP_NUM][PROF_BIU_GROUP_CHANNEL_NUM] = {
    {CHANNEL_BIU_GROUP0_AIC, CHANNEL_BIU_GROUP0_AIV0, CHANNEL_BIU_GROUP0_AIV1},
    {CHANNEL_BIU_GROUP1_AIC, CHANNEL_BIU_GROUP1_AIV0, CHANNEL_BIU_GROUP1_AIV1},
    {CHANNEL_BIU_GROUP2_AIC, CHANNEL_BIU_GROUP2_AIV0, CHANNEL_BIU_GROUP2_AIV1},
    {CHANNEL_BIU_GROUP3_AIC, CHANNEL_BIU_GROUP3_AIV0, CHANNEL_BIU_GROUP3_AIV1},
    {CHANNEL_BIU_GROUP4_AIC, CHANNEL_BIU_GROUP4_AIV0, CHANNEL_BIU_GROUP4_AIV1},
    {CHANNEL_BIU_GROUP5_AIC, CHANNEL_BIU_GROUP5_AIV0, CHANNEL_BIU_GROUP5_AIV1},
};

static const char *const g_biu_group_type_names[PROF_BIU_GROUP_CHANNEL_NUM] = {
    "aic",
    "aiv0",
    "aiv1",
};

static int prof_channel_get_biu_group_type(unsigned int channel_id, uint32_t *group_type)
{
    for (uint32_t group_id = 0; group_id < PROF_BIU_GROUP_NUM; ++group_id) {
        for (uint32_t type = 0; type < PROF_BIU_GROUP_CHANNEL_NUM; ++type) {
            if (g_biu_group_channel_map[group_id][type] == channel_id) {
                if (group_type != NULL) {
                    *group_type = type;
                }
                return 1;
            }
        }
    }

    return 0;
}

static uint32_t prof_biu_generate_group_vector(unsigned int device_id, uint32_t *group_vector, uint32_t max_groups)
{
    int64_t ai_core_num = 0;
    uint32_t lower_core;
    int ret;

    if (group_vector == NULL || max_groups < PROF_BIU_HIGHER_GROUP_NUM) {
        return 0;
    }

    ret = halGetDeviceInfo(device_id, MODULE_TYPE_AICORE, INFO_TYPE_CORE_NUM, &ai_core_num);
    if (ret != DRV_ERROR_NONE || ai_core_num <= 0 || ai_core_num > UINT32_MAX) {
        PROF_LOG("halGetDeviceInfo AICORE core num failed or invalid, ret=%d, ai_core_num=%ld; use fallback group vector",
            ret, (long)ai_core_num);
        group_vector[0] = 0U;
        group_vector[1] = 9U;
        group_vector[2] = 17U;
        group_vector[3] = 18U;
        group_vector[4] = 27U;
        group_vector[5] = 35U;
        return PROF_BIU_HIGHER_GROUP_NUM;
    }

    lower_core = (uint32_t)ai_core_num;
    if ((uint32_t)ai_core_num > PROF_BIU_DIE0_AICORE_NUM) {
        lower_core = (uint32_t)ai_core_num >> 1U;
    }

    group_vector[0] = 0U;
    group_vector[1] = lower_core >> 1U;
    group_vector[2] = lower_core - 1U;
    if ((uint32_t)ai_core_num > PROF_BIU_DIE0_AICORE_NUM) {
        group_vector[3] = lower_core;
        group_vector[4] = (uint32_t)ai_core_num - (lower_core >> 1U);
        group_vector[5] = (uint32_t)ai_core_num - 1U;
        PROF_LOG("BIU group vector generated, ai_core_num=%ld, groups=%u, vector=%u,%u,%u,%u,%u,%u",
            (long)ai_core_num, PROF_BIU_HIGHER_GROUP_NUM, group_vector[0], group_vector[1], group_vector[2],
            group_vector[3], group_vector[4], group_vector[5]);
        return PROF_BIU_HIGHER_GROUP_NUM;
    }

    PROF_LOG("BIU group vector generated, ai_core_num=%ld, groups=%u, vector=%u,%u,%u",
        (long)ai_core_num, PROF_BIU_LOWER_GROUP_NUM, group_vector[0], group_vector[1], group_vector[2]);
    return PROF_BIU_LOWER_GROUP_NUM;
}

static int prof_channel_available(unsigned int device_id, unsigned int channel_id)
{
    channel_list_t channels;
    int ret;

    (void)memset(&channels, 0, sizeof(channels));
    ret = prof_drv_get_channels(device_id, &channels);
    if (ret != PROF_OK) {
        PROF_LOG("prof_drv_get_channels failed while checking channel=%u, ret=%d", channel_id, ret);
        return 0;
    }

    for (unsigned int i = 0; i < channels.channel_num && i < PROF_CHANNEL_NUM_MAX; ++i) {
        if (channels.channel[i].channel_id == channel_id) {
            return 1;
        }
    }

    return 0;
}

static void prof_sampler_sleep_idle()
{
    struct timespec req = {0};

    req.tv_sec = 0;
    req.tv_nsec = PROF_READ_IDLE_US * 1000U;
    (void)nanosleep(&req, NULL);
}

static int prof_sampler_write(FILE *fp, const char *buf, int len)
{
    size_t written;

    if (len <= 0) {
        return 0;
    }

    written = fwrite(buf, 1, (size_t)len, fp);
    if (written != (size_t)len) {
        PROF_LOG("write profile data failed, expect=%d, written=%zu", len, written);
        return -EIO;
    }

    return 0;
}

static void prof_dump_available_channels(unsigned int device_id)
{
    channel_list_t channels;
    int ret;

    (void)memset(&channels, 0, sizeof(channels));
    PROF_LOG("prof_drv_get_channels begin, device=%u", device_id);
    ret = prof_drv_get_channels(device_id, &channels);
    PROF_LOG("prof_drv_get_channels return, ret=%d, chip_type=%u, channel_num=%u",
        ret, channels.chip_type, channels.channel_num);
    if (ret != PROF_OK) {
        return;
    }

    for (unsigned int i = 0; i < channels.channel_num && i < PROF_CHANNEL_NUM_MAX; ++i) {
        PROF_LOG("channel[%u]: id=%u, type=%u, name=%s",
            i, channels.channel[i].channel_id, channels.channel[i].channel_type, channels.channel[i].channel_name);
    }
}

static void prof_sampler_notify_start(ProfSampler *sampler, int start_ret)
{
    PROF_LOG("sampler notify start, ret=%d", start_ret);
    (void)pthread_mutex_lock(&sampler->start_mutex);
    sampler->start_ret = start_ret;
    sampler->start_done = 1;
    (void)pthread_cond_signal(&sampler->start_cond);
    (void)pthread_mutex_unlock(&sampler->start_mutex);
}

static void prof_sampler_drain(ProfSampler *sampler, FILE *fp, char *buf)
{
    int ret;
    uint64_t drain_total = 0;
    uint32_t drain_count = 0;

    PROF_LOG("BIU sampler drain begin, group=%u, type=%s, device=%u, channel=%u, read_method=prof_channel_read",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type],
        sampler->device_id, sampler->channel_id);
    for (;;) {
        ret = prof_channel_read(sampler->device_id, sampler->channel_id, buf, PROF_READ_BUF_SIZE);
        if (ret <= 0) {
            PROF_LOG("BIU sampler drain end, group=%u, type=%s, channel=%u, last_ret=%d, read_count=%u, bytes=%lu",
                sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->channel_id,
                ret, drain_count, (unsigned long)drain_total);
            break;
        }

        if (prof_sampler_write(fp, buf, ret) != 0) {
            sampler->thread_ret = -EIO;
            break;
        }
        drain_count++;
        drain_total += (uint64_t)ret;
        sampler->read_count++;
        sampler->total_bytes += (uint64_t)ret;
    }
}

static void *prof_sampler_thread(void *arg)
{
    ProfSampler *sampler = (ProfSampler *)arg;
    rtProfCommandHandle_t command;
    int switch_ret;

    (void)memset(&command, 0, sizeof(command));
    command.profSwitch = PROF_INSTR;
    command.type = PROF_COMMANDHANDLE_TYPE_START;
    command.modelId = 0xFFFFFFFFUL;
    command.cacheFlag = 0;
    command.devNums = 1;
    command.devIdList[0] = sampler->device_id;
    PROF_LOG("rtProfSetProSwitch start begin, profSwitch=0x%lx, type=%u, device=%u",
        (unsigned long)command.profSwitch, command.type, sampler->device_id);
    switch_ret = rtProfSetProSwitch(&command, sizeof(command));
    PROF_LOG("rtProfSetProSwitch start return, ret=%d", switch_ret);

    struct prof_start_para start_para;
    ProfBiuProfileConfig biu_config;
    char *buf = NULL;
    FILE *fp = NULL;
    int ret;

    (void)memset(&start_para, 0, sizeof(start_para));
    (void)memset(&biu_config, 0, sizeof(biu_config));
    biu_config.period = PROF_BIU_PERF_CYCLE;
    biu_config.biuPcSamplingMode = PROF_BIU_PC_SAMPLING_MODE;
    biu_config.groupNo = sampler->biu_group_no;

    if (!prof_channel_get_biu_group_type(sampler->channel_id, &biu_config.groupType)) {
        sampler->thread_ret = -EINVAL;
        PROF_LOG("sampler only supports BIU perf channel, channel=%u, ret=%d",
            sampler->channel_id, sampler->thread_ret);
        prof_sampler_notify_start(sampler, sampler->thread_ret);
        return NULL;
    }
    PROF_LOG("BIU config group_type resolved, channel=%u, biu_config.groupType=%u(%s), sampler_group_type=%u(%s)",
        sampler->channel_id, biu_config.groupType, g_biu_group_type_names[biu_config.groupType],
        sampler->biu_group_type, g_biu_group_type_names[sampler->biu_group_type]);
    if (biu_config.groupType != sampler->biu_group_type) {
        sampler->thread_ret = -EINVAL;
        PROF_LOG("BIU group type mismatch, channel=%u, expected=%u, detected=%u, ret=%d",
            sampler->channel_id, sampler->biu_group_type, biu_config.groupType, sampler->thread_ret);
        prof_sampler_notify_start(sampler, sampler->thread_ret);
        return NULL;
    }

    start_para.channel_type = PROF_TS_TYPE;
    start_para.sample_period = 0;
    start_para.real_time = PROF_REAL;
    start_para.user_data = &biu_config;
    start_para.user_data_size = sizeof(biu_config);

    PROF_LOG("BIU sampler thread enter, group=%u, type=%s, group_no=%u, device=%u, channel=%u, output=%s",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->biu_group_no,
        sampler->device_id, sampler->channel_id, sampler->output_path);
    buf = (char *)malloc(PROF_READ_BUF_SIZE);
    if (buf == NULL) {
        sampler->thread_ret = -ENOMEM;
        PROF_LOG("sampler malloc read buffer failed, size=%u, ret=%d", PROF_READ_BUF_SIZE, sampler->thread_ret);
        prof_sampler_notify_start(sampler, sampler->thread_ret);
        return NULL;
    }
    PROF_LOG("sampler malloc read buffer success, ptr=%p, size=%u", (void *)buf, PROF_READ_BUF_SIZE);

    PROF_LOG("sampler fopen begin, output=%s", sampler->output_path);
    fp = fopen(sampler->output_path, "wb");
    if (fp == NULL) {
        sampler->thread_ret = -errno;
        PROF_LOG("sampler fopen failed, errno=%d, ret=%d", errno, sampler->thread_ret);
        free(buf);
        prof_sampler_notify_start(sampler, sampler->thread_ret);
        return NULL;
    }
    PROF_LOG("sampler fopen success");

    PROF_LOG("BIU perf config: group=%u, type=%s, channel=%u, period=%u, pc_sampling_mode=%u, group_type=%u, group_no=%u",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type],
        sampler->channel_id, biu_config.period, biu_config.biuPcSamplingMode,
        biu_config.groupType, biu_config.groupNo);
    PROF_LOG("prof_drv_start begin, device=%u, channel=%u, type=%d, period=%u, real_time=%u, user_data=%p, size=%u",
        sampler->device_id, sampler->channel_id, start_para.channel_type, start_para.sample_period,
        start_para.real_time, start_para.user_data, start_para.user_data_size);
    ret = prof_drv_start(sampler->device_id, sampler->channel_id, &start_para);
    PROF_LOG("prof_drv_start return, ret=%d", ret);
    prof_sampler_notify_start(sampler, ret);
    if (ret != PROF_OK) {
        sampler->thread_ret = ret;
        (void)fclose(fp);
        free(buf);
        return NULL;
    }

    while (sampler->stop_requested.load() == 0) {
        ret = prof_channel_read(sampler->device_id, sampler->channel_id, buf, PROF_READ_BUF_SIZE);
        if (ret > 0) {
            int write_ret;

            sampler->read_count++;
            sampler->total_bytes += (uint64_t)ret;
            PROF_LOG("BIU prof_channel_read got data, group=%u, type=%s, channel=%u, len=%d, total_bytes=%lu, read_count=%u",
                sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->channel_id,
                ret, (unsigned long)sampler->total_bytes, sampler->read_count);
            write_ret = prof_sampler_write(fp, buf, ret);
            if (write_ret != 0) {
                sampler->thread_ret = write_ret;
                break;
            }
            continue;
        }

        if (ret == 0) {
            PROF_LOG("BIU prof_channel_read idel");
            prof_sampler_sleep_idle();
            continue;
        }

        if (ret == PROF_STOPPED_ALREADY) {
            PROF_LOG("BIU prof_channel_read reports stopped already");
            break;
        }

        sampler->thread_ret = ret;
        PROF_LOG("BIU prof_channel_read failed, group=%u, type=%s, channel=%u, ret=%d",
            sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->channel_id, ret);
        break;
    }

    PROF_LOG("BIU sampler read loop exit, group=%u, type=%s, channel=%u, stop_requested=%d, thread_ret=%d, bytes=%lu, read_count=%u",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->channel_id,
        sampler->stop_requested.load(), sampler->thread_ret,
        (unsigned long)sampler->total_bytes, sampler->read_count);
    if (sampler->thread_ret == 0) {
        prof_sampler_drain(sampler, fp, buf);
    }

    rtProfCommandHandle_t command2;
    (void)memset(&command2, 0, sizeof(command2));
    command2.profSwitch = PROF_INSTR;
    command2.type = PROF_COMMANDHANDLE_TYPE_STOP;
    command2.modelId = 0xFFFFFFFFUL;
    command2.cacheFlag = 0;
    command2.devNums = 1;
    command2.devIdList[0] = sampler->device_id;
    PROF_LOG("rtProfSetProSwitch stop begin, profSwitch=0x%lx, type=%u, device=%u",
        (unsigned long)command2.profSwitch, command2.type, sampler->device_id);
    switch_ret = rtProfSetProSwitch(&command2, sizeof(command2));
    PROF_LOG("rtProfSetProSwitch stop return, ret=%d", switch_ret);
    PROF_LOG("prof_stop begin, group=%u, type=%s, device=%u, channel=%u",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type],
        sampler->device_id, sampler->channel_id);
    ret = prof_stop(sampler->device_id, sampler->channel_id);
    PROF_LOG("prof_stop return, group=%u, type=%s, channel=%u, ret=%d",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->channel_id, ret);
    if (ret != PROF_OK && sampler->thread_ret == 0) {
        sampler->thread_ret = ret;
    }

    (void)fflush(fp);
    (void)fclose(fp);
    free(buf);
    PROF_LOG("BIU sampler thread exit, group=%u, type=%s, channel=%u, thread_ret=%d, bytes=%lu, read_count=%u",
        sampler->biu_group_id, g_biu_group_type_names[sampler->biu_group_type], sampler->channel_id,
        sampler->thread_ret, (unsigned long)sampler->total_bytes, sampler->read_count);
    return NULL;
}

static int prof_sampler_start(ProfSampler *sampler, unsigned int device_id, unsigned int channel_id,
    const char *output_path, uint32_t biu_group_no, uint32_t biu_group_id, uint32_t biu_group_type)
{
    int ret;

    if (sampler == NULL || output_path == NULL || biu_group_type >= PROF_BIU_GROUP_CHANNEL_NUM) {
        PROF_LOG("prof_sampler_start invalid args, sampler=%p, output_path=%p", (void *)sampler, (void *)output_path);
        return -EINVAL;
    }

    PROF_LOG("prof_sampler_start enter, group=%u, type=%s, device=%u, channel=%u, output=%s, biu_group_no=%u",
        biu_group_id, g_biu_group_type_names[biu_group_type], device_id, channel_id, output_path, biu_group_no);
    sampler->device_id = device_id;
    sampler->channel_id = channel_id;
    sampler->biu_group_id = biu_group_id;
    sampler->biu_group_type = biu_group_type;
    sampler->biu_group_no = biu_group_no;
    sampler->total_bytes = 0;
    sampler->read_count = 0;
    sampler->output_path[0] = '\0';
    sampler->start_done = 0;
    sampler->start_ret = 0;
    sampler->thread_ret = 0;
    sampler->stop_requested.store(0);
    (void)pthread_mutex_init(&sampler->start_mutex, NULL);
    (void)pthread_cond_init(&sampler->start_cond, NULL);

    if (snprintf(sampler->output_path, sizeof(sampler->output_path), "%s", output_path) >=
        (int)sizeof(sampler->output_path)) {
        PROF_LOG("prof_sampler_start output path too long, output=%s", output_path);
        (void)pthread_cond_destroy(&sampler->start_cond);
        (void)pthread_mutex_destroy(&sampler->start_mutex);
        return -ENAMETOOLONG;
    }

    PROF_LOG("prof_sampler_start create thread begin");
    ret = pthread_create(&sampler->thread, NULL, prof_sampler_thread, sampler);
    if (ret != 0) {
        PROF_LOG("prof_sampler_start pthread_create failed, ret=%d", ret);
        (void)pthread_cond_destroy(&sampler->start_cond);
        (void)pthread_mutex_destroy(&sampler->start_mutex);
        return ret;
    }
    PROF_LOG("prof_sampler_start waiting for prof_drv_start result");

    (void)pthread_mutex_lock(&sampler->start_mutex);
    while (sampler->start_done == 0) {
        (void)pthread_cond_wait(&sampler->start_cond, &sampler->start_mutex);
    }
    ret = sampler->start_ret;
    (void)pthread_mutex_unlock(&sampler->start_mutex);

    if (ret != PROF_OK) {
        PROF_LOG("prof_sampler_start failed after thread start, ret=%d", ret);
        (void)pthread_join(sampler->thread, NULL);
        (void)pthread_cond_destroy(&sampler->start_cond);
        (void)pthread_mutex_destroy(&sampler->start_mutex);
        return ret;
    }

    PROF_LOG("prof_sampler_start success");
    return PROF_OK;
}

static void prof_sampler_stop(ProfSampler *sampler)
{
    if (sampler != NULL) {
        PROF_LOG("prof_sampler_stop set stop flag");
        sampler->stop_requested.store(1);
    }
}

static int prof_sampler_join(ProfSampler *sampler)
{
    int ret;

    if (sampler == NULL) {
        PROF_LOG("prof_sampler_join invalid sampler");
        return -EINVAL;
    }

    PROF_LOG("prof_sampler_join begin");
    (void)pthread_join(sampler->thread, NULL);
    ret = sampler->thread_ret;
    (void)pthread_cond_destroy(&sampler->start_cond);
    (void)pthread_mutex_destroy(&sampler->start_mutex);
    PROF_LOG("prof_sampler_join end, ret=%d", ret);
    return ret;
}

int32_t main(int argc, char const *argv[])
{
    (void)argc;
    (void)argv;

    PROF_LOG("main enter");
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = PROF_DEFAULT_DEVICE_ID;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    constexpr uint32_t dataCount = 10 * 1024;
    constexpr uint32_t dataSize = dataCount * sizeof(float);
    uint8_t *xGm = nullptr;
    uint8_t *yGm = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&xGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc xGm success, ptr=%p, size=%u", (void *)xGm, dataSize);
    CHECK_ACL(aclrtMalloc((void **)&yGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc yGm success, ptr=%p, size=%u", (void *)yGm, dataSize);

    ProfSampler sampler;
    int samplerStarted = 0;
    uint32_t groupVector[PROF_BIU_GROUP_NUM] = {0};
    uint32_t groupNum;
    const uint32_t sampleGroupId = PROF_BIU_SAMPLE_GROUP_ID;
    const uint32_t sampleGroupType = PROF_BIU_SAMPLE_GROUP_TYPE;
    unsigned int sampleChannelId;
    int profRet = PROF_OK;

    PROF_LOG("start BIU profiling sampler preparation");
    prof_dump_available_channels(PROF_DEFAULT_DEVICE_ID);

    groupNum = prof_biu_generate_group_vector(PROF_DEFAULT_DEVICE_ID, groupVector, PROF_BIU_GROUP_NUM);
    if (groupNum == 0 || groupNum > PROF_BIU_GROUP_NUM) {
        std::cerr << "failed to generate BIU group vector, groupNum=" << groupNum << std::endl;
        (void)aclrtFree(xGm);
        (void)aclrtFree(yGm);
        (void)aclrtDestroyStream(stream);
        (void)aclrtResetDevice(deviceId);
        (void)aclFinalize();
        return -EINVAL;
    }

    if (sampleGroupId >= groupNum || sampleGroupType >= PROF_BIU_GROUP_CHANNEL_NUM) {
        std::cerr << "invalid BIU sample target, group_id=" << sampleGroupId
                  << ", group_type=" << sampleGroupType << ", groupNum=" << groupNum << std::endl;
        (void)aclrtFree(xGm);
        (void)aclrtFree(yGm);
        (void)aclrtDestroyStream(stream);
        (void)aclrtResetDevice(deviceId);
        (void)aclFinalize();
        return -EINVAL;
    }

    sampleChannelId = g_biu_group_channel_map[sampleGroupId][sampleGroupType];
    PROF_LOG("selected BIU sampler, group_id=%u, group_type=%u(%s), group_no=%u, channel=%u, output=%s",
        sampleGroupId, sampleGroupType, g_biu_group_type_names[sampleGroupType], groupVector[sampleGroupId],
        sampleChannelId, PROF_BIU_SAMPLE_OUTPUT_FILE);
    if (!prof_channel_available(PROF_DEFAULT_DEVICE_ID, sampleChannelId)) {
        std::cerr << "selected BIU channel is unavailable, channel_id=" << sampleChannelId << std::endl;
        (void)aclrtFree(xGm);
        (void)aclrtFree(yGm);
        (void)aclrtDestroyStream(stream);
        (void)aclrtResetDevice(deviceId);
        (void)aclFinalize();
        return -ENODEV;
    }


    profRet = prof_sampler_start(&sampler, PROF_DEFAULT_DEVICE_ID, sampleChannelId,
        PROF_BIU_SAMPLE_OUTPUT_FILE, groupVector[sampleGroupId], sampleGroupId, sampleGroupType);
    usleep(100U * 1000U);
    if (profRet != PROF_OK) {
        std::cerr << "prof_sampler_start failed, ret=" << profRet
                  << ", channel_id=" << sampleChannelId << std::endl;
        (void)aclrtFree(xGm);
        (void)aclrtFree(yGm);
        (void)aclrtDestroyStream(stream);
        (void)aclrtResetDevice(deviceId);
        (void)aclFinalize();
        return profRet;
    }
    samplerStarted = 1;
    PROF_LOG("BIU sampler start summary, group_num=%u, sampler_count=1", groupNum);

    constexpr uint32_t numBlocks = PROF_KERNEL_BLOCK_COUNT;
    PROF_LOG("launch hello_world kernels, numBlocks=%u, launch_count=%u", numBlocks, PROF_KERNEL_LAUNCH_COUNT);
    for (uint32_t i = 0; i < PROF_KERNEL_LAUNCH_COUNT; ++i) {
        PROF_LOG("launch hello_world kernel[%u/%u]", i + 1, PROF_KERNEL_LAUNCH_COUNT);
        hello_world<<<numBlocks, nullptr, stream>>>(xGm, yGm);
    }
    PROF_LOG("kernel launches issued, synchronize stream begin");
    PROF_LOG("call aclrtSynchronizeStream(stream)");
    aclError syncRet = aclrtSynchronizeStream(stream);
    if (syncRet != ACL_SUCCESS) {
        PROF_LOG("aclrtSynchronizeStream(stream) failed, ret=%d", syncRet);
        profRet = syncRet;
    } else {
        PROF_LOG("aclrtSynchronizeStream(stream) success");
        PROF_LOG("stream synchronized");
    }
    PROF_LOG("wait briefly before stopping BIU channel");
    usleep(100U * 1000U);

    // command.type = 2;
    // rtProfSetProSwitch(&command, sizeof(command));
    if (samplerStarted != 0) {
        prof_sampler_stop(&sampler);
    }


    int samplerRet = (samplerStarted != 0) ? prof_sampler_join(&sampler) : PROF_OK;
    samplerStarted = 0;
    if (samplerRet != PROF_OK) {
        std::cerr << "prof_sampler_join failed, ret=" << samplerRet << std::endl;
        if (profRet == PROF_OK) {
            profRet = samplerRet;
        }
    } else {
        PROF_LOG("BIU sampler summary, group=%u, type=%s, channel=%u, bytes=%lu, read_count=%u, file=%s, ret=%d",
            sampler.biu_group_id, g_biu_group_type_names[sampler.biu_group_type], sampler.channel_id,
            (unsigned long)sampler.total_bytes, sampler.read_count, sampler.output_path, samplerRet);
        std::cout << "profiling file " << sampler.output_path
                  << " group=" << sampler.biu_group_id
                  << " type=" << g_biu_group_type_names[sampler.biu_group_type]
                  << " channel=" << sampler.channel_id
                  << " bytes=" << sampler.total_bytes
                  << " reads=" << sampler.read_count << std::endl;
    }

    PROF_LOG("cleanup begin");
    CHECK_ACL(aclrtFree(xGm));
    CHECK_ACL(aclrtFree(yGm));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    PROF_LOG("main exit, ret=%d", profRet);
    return profRet;
}
