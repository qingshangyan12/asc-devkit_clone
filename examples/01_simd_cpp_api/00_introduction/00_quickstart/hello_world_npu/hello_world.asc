/* !
 * \file hello_world.asc
 * \brief
 */

#include "debug/asc_printf.h"
#include "acl/acl.h"

__global__ __vector__ void hello_world()
{
    printf("[Block (%lu/%lu)]: Hello World!!!\n", blockIdx, blockNum);
}

int32_t main(int argc, char const *argv[])
{
    aclrtSetDevice(0);
    hello_world<<<8>>>();
    aclrtSynchronizeDevice();
    return 0;
}