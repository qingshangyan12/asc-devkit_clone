#include "kernel_operator.h"
#include "acl/acl.h"
#include <iostream>
#include <atomic>
#include <errno.h>
#include <pthread.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/time.h>
#include <time.h>
#include <unistd.h>
#include "driver/ascend_hal_base.h"
#include "runtime/rt_external_base.h"

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        PROF_LOG("call %s", #expr);                                                                     \
        aclError ret = (expr);                                                                          \
        if (ret != ACL_SUCCESS) {                                                                       \
            PROF_LOG("%s failed, ret=%d", #expr, ret);                                                  \
            return ret;                                                                                 \
        }                                                                                               \
        PROF_LOG("%s success", #expr);                                                                  \
    } while (0)

#define PROF_LOG(fmt, ...)                                                                              \
    do {                                                                                                \
        (void)fprintf(stderr, "[PROF-DEMO] " fmt "\n", ##__VA_ARGS__);                                  \
        (void)fflush(stderr);                                                                           \
    } while (0)

#define PROF_MARK_STAMP_COUNT 300U

class KernelAddV3 {
public:
    __aicore__ inline KernelAddV3() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer((__gm__ float *)x);
        yGm.SetGlobalBuffer((__gm__ float *)y);
    }

    __aicore__ inline void Process()
    {
        // use local memory allocator to simplify memor allocation
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        // ping
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, 10 * 1024>();

        // double buffer
        for (int i = 0; i < 1000; i++) {
            AscendC::DataCopy(xLocal, xGm, 10 * 1024);
            AscendC::PipeBarrier<PIPE_ALL>();
            for (uint32_t j = 0; j < PROF_MARK_STAMP_COUNT; ++j) {
                bisheng::cce::mark_stamp<PIPE_MTE2>(123);
            }
            AscendC::DataCopy(yGm, xLocal, 10 * 1024);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::Nop<100000>();
        }
        // dependency of PIPE_MTE3 & PIPE_MTE2 caused by zLocal between 2 sequential loops
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
};

__global__ __vector__ void hello_world(GM_ADDR x, GM_ADDR y)
{
    KernelAddV3 op;
    op.Init(x, y);
    op.Process();

}

#define PROF_READ_BUF_SIZE (256U * 1024U)
#define PROF_READ_IDLE_US  (10U * 1000U)
#define PROF_OUTPUT_FILE   "hello_world_prof.bin"
#define PROF_DEFAULT_DEVICE_ID 0U
#define PROF_DEFAULT_CHANNEL_ID CHANNEL_NPU_APP_MEM
#define PROF_DEFAULT_SAMPLE_PERIOD 40U
#define PROF_KERNEL_LAUNCH_COUNT 1000U
#define PROF_RUNTIME_SWITCH_MASK PROF_TASK_TIME_MASK
#define PROF_TSFW_ENABLE 1U
#define PROF_TSFW_MANAGEMENT_ENABLE 0x81000001U
#define PROF_TSFW_AICPU_ENABLE      0x82000001U
#define PROF_TSFW_MEMCPY_ENABLE     0x84000001U
#define PROF_ACC_EVENT_MAX_NUM 10U
#define PROF_FFTS_MODE_AIC 0U
#define PROF_FFTS_MODE_AIV 1U
#define PROF_FFTS_MODE_NUM 2U
#define PROF_FFTS_CFG_AIC (1U << PROF_FFTS_MODE_AIC)
#define PROF_FFTS_CFG_AIV (1U << PROF_FFTS_MODE_AIV)
#define PROF_FFTS_TYPE_TASK_BASE (1U << 0U)
#define PROF_FFTS_TYPE_SAMPLE_BASE (1U << 1U)
#define PROF_FFTS_TYPE_BLOCK (1U << 2U)
#define PROF_FFTS_TYPE_SUBTASK (1U << 3U)
#define PROF_FFTS_AIV_CORE_MASK 0U

typedef struct {
    uint32_t period;
    uint32_t ts_task_track;
    uint32_t ts_cpu_usage;
    uint32_t ai_core_status;
    uint32_t ts_timeline;
    uint32_t ai_vector_status;
    uint32_t ts_keypoint;
    uint32_t ts_memcpy;
    uint32_t tsBlockdim;
} ProfTsFwConfig;

typedef struct {
    uint32_t type;
    uint32_t period;
    uint32_t coreMask;
    uint32_t eventNum;
    uint16_t event[PROF_ACC_EVENT_MAX_NUM];
} ProfAccCoreConfig;

typedef struct {
    uint32_t cfgMode;
    ProfAccCoreConfig aiEventCfg[PROF_FFTS_MODE_NUM];
    uint32_t tag;
    uint32_t blockShinkFlag;
    uint32_t aicScale;
} ProfStarsAccProfileConfig;

typedef struct {
    unsigned int device_id;
    unsigned int channel_id;
    struct prof_start_para start_para;

    char output_path[512];
    pthread_t thread;
    std::atomic<int> stop_requested;
    pthread_mutex_t start_mutex;
    pthread_cond_t start_cond;
    int start_done;
    int start_ret;

    int thread_ret;
} ProfSampler;

static int prof_channel_is_peripheral(unsigned int channel_id)
{
    switch (channel_id) {
        case CHANNEL_NPU_APP_MEM:
        case CHANNEL_NPU_MEM:
        case CHANNEL_LP:
        case CHANNEL_QOS:
        case CHANNEL_SOC_PMU:
        case CHANNEL_NPU_MODULE_MEM:
        case CHANNEL_AICPU:
        case CHANNEL_CUS_AICPU:
        case CHANNEL_ADPROF:
        case CHANNEL_UB:
        case CHANNEL_CCU0_INSTRUCT:
        case CHANNEL_CCU0_CHAN_INSTRUCT:
        case CHANNEL_CCU1_INSTRUCT:
        case CHANNEL_CCU1_CHAN_INSTRUCT:
        case CHANNEL_NTS_TASK:
        case CHANNEL_NTS_PMU:
            return 1;
        default:
            return 0;
    }
}

static void prof_sampler_sleep_idle()
{
    struct timespec req = {0};

    req.tv_sec = 0;
    req.tv_nsec = PROF_READ_IDLE_US * 1000U;
    (void)nanosleep(&req, NULL);
}

static int prof_runtime_switch(unsigned int device_id, uint32_t command_type)
{
    rtProfCommandHandle_t command;
    rtError_t ret;

    (void)memset(&command, 0, sizeof(command));
    command.profSwitch = PROF_RUNTIME_SWITCH_MASK;
    command.profSwitchHi = 0;
    command.devNums = 1;
    command.devIdList[0] = device_id;
    command.type = command_type;
    command.cacheFlag = 0;

    PROF_LOG("rtProfSetProSwitch begin, device=%u, command_type=%u, profSwitch=0x%llx, len=%zu",
        device_id, command_type, (unsigned long long)command.profSwitch, sizeof(command));
    ret = rtProfSetProSwitch(&command, sizeof(command));
    PROF_LOG("rtProfSetProSwitch return, ret=%d", ret);
    return ret;
}

static int prof_sampler_write(FILE *fp, const char *buf, int len)
{
    size_t written;

    if (len <= 0) {
        return 0;
    }

    written = fwrite(buf, 1, (size_t)len, fp);
    if (written != (size_t)len) {
        PROF_LOG("write profile data failed, expect=%d, written=%zu", len, written);
        return -EIO;
    }

    return 0;
}

static void prof_dump_available_channels(unsigned int device_id)
{
    channel_list_t channels;
    int ret;

    (void)memset(&channels, 0, sizeof(channels));
    PROF_LOG("prof_drv_get_channels begin, device=%u", device_id);
    ret = prof_drv_get_channels(device_id, &channels);
    PROF_LOG("prof_drv_get_channels return, ret=%d, chip_type=%u, channel_num=%u",
        ret, channels.chip_type, channels.channel_num);
    if (ret != PROF_OK) {
        return;
    }

    for (unsigned int i = 0; i < channels.channel_num && i < PROF_CHANNEL_NUM_MAX; ++i) {
        PROF_LOG("channel[%u]: id=%u, type=%u, name=%s",
            i, channels.channel[i].channel_id, channels.channel[i].channel_type, channels.channel[i].channel_name);
    }
}

static void prof_sampler_notify_start(ProfSampler *sampler, int start_ret)
{
    PROF_LOG("sampler notify start, ret=%d", start_ret);
    (void)pthread_mutex_lock(&sampler->start_mutex);
    sampler->start_ret = start_ret;
    sampler->start_done = 1;
    (void)pthread_cond_signal(&sampler->start_cond);
    (void)pthread_mutex_unlock(&sampler->start_mutex);
}

static void prof_sampler_drain(ProfSampler *sampler, FILE *fp, char *buf)
{
    int ret;
    unsigned int flush_len = 0;
    uint64_t drain_total = 0;
    uint32_t drain_count = 0;

    PROF_LOG("halProfDataFlush begin, device=%u, channel=%u", sampler->device_id, sampler->channel_id);
    ret = halProfDataFlush(sampler->device_id, sampler->channel_id, &flush_len);
    PROF_LOG("halProfDataFlush return, ret=%d, flush_len=%u", ret, flush_len);

    PROF_LOG("sampler drain begin, device=%u, channel=%u, flush_len=%u",
        sampler->device_id, sampler->channel_id, flush_len);
    for (;;) {
        ret = prof_channel_read(sampler->device_id, sampler->channel_id, buf, PROF_READ_BUF_SIZE);
        if (ret <= 0) {
            PROF_LOG("sampler drain end, last_ret=%d, read_count=%u, bytes=%lu",
                ret, drain_count, (unsigned long)drain_total);
            break;
        }

        if (prof_sampler_write(fp, buf, ret) != 0) {
            sampler->thread_ret = -EIO;
            break;
        }
        drain_count++;
        drain_total += (uint64_t)ret;
        if (flush_len > 0 && drain_total >= (uint64_t)flush_len) {
            PROF_LOG("sampler drain reached flush len, read_count=%u, bytes=%lu",
                drain_count, (unsigned long)drain_total);
            break;
        }
    }
}

static void *prof_sampler_thread(void *arg)
{
    ProfSampler *sampler = (ProfSampler *)arg;
    struct prof_start_para start_para;
    ProfTsFwConfig tsfw_config;
    ProfStarsAccProfileConfig acc_config;
    int use_peripheral;
    char *buf = NULL;
    FILE *fp = NULL;
    int ret;

    (void)memset(&start_para, 0, sizeof(start_para));
    (void)memset(&tsfw_config, 0, sizeof(tsfw_config));
    tsfw_config.period = sampler->start_para.sample_period;
    tsfw_config.ts_task_track = PROF_TSFW_ENABLE;
    tsfw_config.ts_timeline = PROF_TSFW_ENABLE;
    tsfw_config.ts_keypoint = PROF_TSFW_ENABLE;
    tsfw_config.ts_memcpy = PROF_TSFW_AICPU_ENABLE | PROF_TSFW_MEMCPY_ENABLE | PROF_TSFW_MANAGEMENT_ENABLE;
    tsfw_config.tsBlockdim = PROF_TSFW_ENABLE;

    (void)memset(&acc_config, 0, sizeof(acc_config));
    acc_config.cfgMode = PROF_FFTS_CFG_AIV;
    acc_config.aiEventCfg[PROF_FFTS_MODE_AIC].type = PROF_FFTS_TYPE_TASK_BASE | PROF_FFTS_TYPE_SUBTASK;
    acc_config.aiEventCfg[PROF_FFTS_MODE_AIC].period = 0;
    acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].type = PROF_FFTS_TYPE_TASK_BASE | PROF_FFTS_TYPE_SUBTASK;
    acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].period = 0;
    acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].coreMask = PROF_FFTS_AIV_CORE_MASK;
    acc_config.tag = 0;
    acc_config.blockShinkFlag = 0;
    acc_config.aicScale = 0;

    use_peripheral = prof_channel_is_peripheral(sampler->channel_id);
    start_para.channel_type = use_peripheral ? PROF_PERIPHERAL_TYPE : PROF_TS_TYPE;
    start_para.sample_period = sampler->start_para.sample_period;
    start_para.real_time = PROF_REAL;
    if (use_peripheral) {
        start_para.user_data = NULL;
        start_para.user_data_size = 0;
    } else if (sampler->channel_id == CHANNEL_TSFW || sampler->channel_id == CHANNEL_TSFW1 ||
        sampler->channel_id == CHANNEL_TSFW_L2) {
        start_para.user_data = &tsfw_config;
        start_para.user_data_size = sizeof(tsfw_config);
    } else if (sampler->channel_id == CHANNEL_FFTS_PROFILE_BUFFER_TASK ||
               sampler->channel_id == CHANNEL_FFTS_PROFILE_BUFFER_SAMPLE) {
        if (sampler->channel_id == CHANNEL_FFTS_PROFILE_BUFFER_SAMPLE) {
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].type = PROF_FFTS_TYPE_SAMPLE_BASE;
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].period = 10;
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].eventNum = 1;
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].event[0] = 0x8;
        }
        start_para.sample_period = 0;
        start_para.user_data = &acc_config;
        start_para.user_data_size = sizeof(acc_config);
    } else {
        start_para.user_data = NULL;
        start_para.user_data_size = 0;
    }

    PROF_LOG("sampler thread enter, device=%u, channel=%u, output=%s, period=%u",
        sampler->device_id, sampler->channel_id, sampler->output_path, start_para.sample_period);
    buf = (char *)malloc(PROF_READ_BUF_SIZE);
    if (buf == NULL) {
        sampler->thread_ret = -ENOMEM;
        PROF_LOG("sampler malloc read buffer failed, size=%u, ret=%d", PROF_READ_BUF_SIZE, sampler->thread_ret);
        prof_sampler_notify_start(sampler, sampler->thread_ret);
        return NULL;
    }
    PROF_LOG("sampler malloc read buffer success, ptr=%p, size=%u", (void *)buf, PROF_READ_BUF_SIZE);

    PROF_LOG("sampler fopen begin, output=%s", sampler->output_path);
    fp = fopen(sampler->output_path, "wb");
    if (fp == NULL) {
        sampler->thread_ret = -errno;
        PROF_LOG("sampler fopen failed, errno=%d, ret=%d", errno, sampler->thread_ret);
        free(buf);
        prof_sampler_notify_start(sampler, sampler->thread_ret);
        return NULL;
    }
    PROF_LOG("sampler fopen success");

    if (use_peripheral) {
        PROF_LOG("Peripheral config: channel=%u, period=%u, real_time=%u, user_data=NULL, size=0",
            sampler->channel_id, start_para.sample_period, start_para.real_time);
    } else {
        PROF_LOG("TSFW config: period=%u, task_track=%u, cpu_usage=%u, ai_core_status=%u, timeline=%u, "
                 "ai_vector_status=%u, keypoint=%u, memcpy=0x%x, blockdim=%u",
            tsfw_config.period, tsfw_config.ts_task_track, tsfw_config.ts_cpu_usage, tsfw_config.ai_core_status,
            tsfw_config.ts_timeline, tsfw_config.ai_vector_status, tsfw_config.ts_keypoint, tsfw_config.ts_memcpy,
            tsfw_config.tsBlockdim);
        PROF_LOG("ACC config: cfgMode=0x%x, tag=%u, blockShink=%u, aicScale=%u, aicType=0x%x, aicPeriod=%u, "
                 "aicCoreMask=0x%x, aicEventNum=%u, aivType=0x%x, aivPeriod=%u, aivCoreMask=0x%x, aivEventNum=%u",
            acc_config.cfgMode, acc_config.tag, acc_config.blockShinkFlag, acc_config.aicScale,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIC].type,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIC].period,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIC].coreMask,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIC].eventNum,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].type,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].period,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].coreMask,
            acc_config.aiEventCfg[PROF_FFTS_MODE_AIV].eventNum);
    }
    PROF_LOG("prof_drv_start begin, device=%u, channel=%u, type=%d, period=%u, real_time=%u, user_data=%p, size=%u",
        sampler->device_id, sampler->channel_id, start_para.channel_type, start_para.sample_period,
        start_para.real_time, start_para.user_data, start_para.user_data_size);
    ret = prof_drv_start(sampler->device_id, sampler->channel_id, &start_para);
    PROF_LOG("prof_drv_start return, ret=%d", ret);
    prof_sampler_notify_start(sampler, ret);
    if (ret != PROF_OK) {
        sampler->thread_ret = ret;
        (void)fclose(fp);
        free(buf);
        return NULL;
    }

    while (sampler->stop_requested.load() == 0) {
        ret = prof_channel_read(sampler->device_id, sampler->channel_id, buf, PROF_READ_BUF_SIZE);
        if (ret > 0) {
            PROF_LOG("prof_channel_read got data, len=%d", ret);
            ret = prof_sampler_write(fp, buf, ret);
            if (ret != 0) {
                sampler->thread_ret = ret;
                break;
            }
            continue;
        }

        if (ret == 0) {
            prof_sampler_sleep_idle();
            continue;
        }

        if (ret == PROF_STOPPED_ALREADY) {
            PROF_LOG("prof_channel_read reports stopped already");
            break;
        }

        sampler->thread_ret = ret;
        PROF_LOG("prof_channel_read failed, ret=%d", ret);
        break;
    }

    PROF_LOG("sampler read loop exit, stop_requested=%d, thread_ret=%d",
        sampler->stop_requested.load(), sampler->thread_ret);
    if (sampler->thread_ret == 0) {
        prof_sampler_drain(sampler, fp, buf);
    }

    PROF_LOG("prof_stop begin, device=%u, channel=%u", sampler->device_id, sampler->channel_id);
    ret = prof_stop(sampler->device_id, sampler->channel_id);
    PROF_LOG("prof_stop return, ret=%d", ret);
    if (ret != PROF_OK && sampler->thread_ret == 0) {
        sampler->thread_ret = ret;
    }

    (void)fflush(fp);
    (void)fclose(fp);
    free(buf);
    PROF_LOG("sampler thread exit, thread_ret=%d", sampler->thread_ret);
    return NULL;
}

static int prof_sampler_start(ProfSampler *sampler, unsigned int device_id, unsigned int channel_id,
    const char *output_path, unsigned int sample_period)
{
    int ret;

    if (sampler == NULL || output_path == NULL) {
        PROF_LOG("prof_sampler_start invalid args, sampler=%p, output_path=%p", (void *)sampler, (void *)output_path);
        return -EINVAL;
    }

    PROF_LOG("prof_sampler_start enter, device=%u, channel=%u, output=%s, period=%u",
        device_id, channel_id, output_path, sample_period);
    sampler->device_id = device_id;
    sampler->channel_id = channel_id;
    sampler->start_para.sample_period = sample_period;
    sampler->output_path[0] = '\0';
    sampler->start_done = 0;
    sampler->start_ret = 0;
    sampler->thread_ret = 0;
    sampler->stop_requested.store(0);
    (void)pthread_mutex_init(&sampler->start_mutex, NULL);
    (void)pthread_cond_init(&sampler->start_cond, NULL);

    if (snprintf(sampler->output_path, sizeof(sampler->output_path), "%s", output_path) >=
        (int)sizeof(sampler->output_path)) {
        PROF_LOG("prof_sampler_start output path too long, output=%s", output_path);
        return -ENAMETOOLONG;
    }

    PROF_LOG("prof_sampler_start create thread begin");
    ret = pthread_create(&sampler->thread, NULL, prof_sampler_thread, sampler);
    if (ret != 0) {
        PROF_LOG("prof_sampler_start pthread_create failed, ret=%d", ret);
        (void)pthread_cond_destroy(&sampler->start_cond);
        (void)pthread_mutex_destroy(&sampler->start_mutex);
        return ret;
    }
    PROF_LOG("prof_sampler_start waiting for prof_drv_start result");

    (void)pthread_mutex_lock(&sampler->start_mutex);
    while (sampler->start_done == 0) {
        (void)pthread_cond_wait(&sampler->start_cond, &sampler->start_mutex);
    }
    ret = sampler->start_ret;
    (void)pthread_mutex_unlock(&sampler->start_mutex);

    if (ret != PROF_OK) {
        PROF_LOG("prof_sampler_start failed after thread start, ret=%d", ret);
        (void)pthread_join(sampler->thread, NULL);
        (void)pthread_cond_destroy(&sampler->start_cond);
        (void)pthread_mutex_destroy(&sampler->start_mutex);
        return ret;
    }

    PROF_LOG("prof_sampler_start success");
    return PROF_OK;
}

static void prof_sampler_stop(ProfSampler *sampler)
{
    if (sampler != NULL) {
        PROF_LOG("prof_sampler_stop set stop flag");
        sampler->stop_requested.store(1);
    }
}

static int prof_sampler_join(ProfSampler *sampler)
{
    int ret;

    if (sampler == NULL) {
        PROF_LOG("prof_sampler_join invalid sampler");
        return -EINVAL;
    }

    PROF_LOG("prof_sampler_join begin");
    (void)pthread_join(sampler->thread, NULL);
    ret = sampler->thread_ret;
    (void)pthread_cond_destroy(&sampler->start_cond);
    (void)pthread_mutex_destroy(&sampler->start_mutex);
    PROF_LOG("prof_sampler_join end, ret=%d", ret);
    return ret;
}

int32_t main(int argc, char const *argv[])
{
    (void)argc;
    (void)argv;

    PROF_LOG("main enter");
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = PROF_DEFAULT_DEVICE_ID;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    constexpr uint32_t dataCount = 10 * 1024;
    constexpr uint32_t dataSize = dataCount * sizeof(float);
    uint8_t *xGm = nullptr;
    uint8_t *yGm = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&xGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc xGm success, ptr=%p, size=%u", (void *)xGm, dataSize);
    CHECK_ACL(aclrtMalloc((void **)&yGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc yGm success, ptr=%p, size=%u", (void *)yGm, dataSize);

    ProfSampler sampler;
    PROF_LOG("start profiling sampler");
    prof_dump_available_channels(PROF_DEFAULT_DEVICE_ID);
    int useRuntimeSwitch = !prof_channel_is_peripheral(PROF_DEFAULT_CHANNEL_ID);
    int profRet = prof_sampler_start(&sampler, PROF_DEFAULT_DEVICE_ID, PROF_DEFAULT_CHANNEL_ID,
        PROF_OUTPUT_FILE, PROF_DEFAULT_SAMPLE_PERIOD);
    if (profRet != PROF_OK) {
        std::cerr << "prof_sampler_start failed, ret=" << profRet
                  << ", channel_id=" << PROF_DEFAULT_CHANNEL_ID << std::endl;
        (void)aclrtFree(xGm);
        (void)aclrtFree(yGm);
        (void)aclrtDestroyStream(stream);
        (void)aclrtResetDevice(deviceId);
        (void)aclFinalize();
        return profRet;
    }
    if (useRuntimeSwitch) {
        profRet = prof_runtime_switch(PROF_DEFAULT_DEVICE_ID, PROF_COMMANDHANDLE_TYPE_START);
        if (profRet != RT_ERROR_NONE) {
            std::cerr << "prof_runtime_switch start failed, ret=" << profRet << std::endl;
            prof_sampler_stop(&sampler);
            (void)prof_sampler_join(&sampler);
            (void)aclrtFree(xGm);
            (void)aclrtFree(yGm);
            (void)aclrtDestroyStream(stream);
            (void)aclrtResetDevice(deviceId);
            (void)aclFinalize();
            return profRet;
        }
    } else {
        PROF_LOG("skip rtProfSetProSwitch for peripheral channel=%u", PROF_DEFAULT_CHANNEL_ID);
    }

    constexpr uint32_t numBlocks = 8;
    PROF_LOG("launch hello_world kernels, numBlocks=%u, launch_count=%u", numBlocks, PROF_KERNEL_LAUNCH_COUNT);
    for (uint32_t i = 0; i < PROF_KERNEL_LAUNCH_COUNT; ++i) {
        PROF_LOG("launch hello_world kernel[%u/%u]", i + 1, PROF_KERNEL_LAUNCH_COUNT);
        hello_world<<<numBlocks, nullptr, stream>>>(xGm, yGm);
    }
    PROF_LOG("kernel launches issued, synchronize stream begin");
    CHECK_ACL(aclrtSynchronizeStream(stream));
    PROF_LOG("stream synchronized");
    if (useRuntimeSwitch) {
        profRet = prof_runtime_switch(PROF_DEFAULT_DEVICE_ID, PROF_COMMANDHANDLE_TYPE_STOP);
        if (profRet != RT_ERROR_NONE) {
            std::cerr << "prof_runtime_switch stop failed, ret=" << profRet << std::endl;
        }
    } else {
        PROF_LOG("skip rtProfSetProSwitch stop for peripheral channel=%u", PROF_DEFAULT_CHANNEL_ID);
    }
    PROF_LOG("wait briefly before stopping profiler");
    usleep(100U * 1000U);

    prof_sampler_stop(&sampler);
    int samplerRet = prof_sampler_join(&sampler);
    if (samplerRet != PROF_OK) {
        std::cerr << "prof_sampler_join failed, ret=" << samplerRet << std::endl;
        if (profRet == RT_ERROR_NONE) {
            profRet = samplerRet;
        }
    } else {
        std::cout << "profiling data saved to " << PROF_OUTPUT_FILE << std::endl;
    }

    PROF_LOG("cleanup begin");
    CHECK_ACL(aclrtFree(xGm));
    CHECK_ACL(aclrtFree(yGm));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    PROF_LOG("main exit, ret=%d", profRet);
    return profRet;
}
