#define PROF_COMMANDHANDLE_TYPE_START 1
#define  PROF_COMMANDHANDLE_TYPE_STOP 2
#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        PROF_LOG("call %s", #expr);                                                                     \
        aclError ret = (expr);                                                                          \
        if (ret != ACL_SUCCESS) {                                                                       \
            PROF_LOG("%s failed, ret=%d", #expr, ret);                                                  \
            return ret;                                                                                 \
        }                                                                                               \
        PROF_LOG("%s success", #expr);                                                                  \
    } while (0)

#define PROF_LOG(fmt, ...)                                                                              \
    do {                                                                                                \
        (void)fprintf(stderr, "[PROF-DEMO] " fmt "\n", ##__VA_ARGS__);                                  \
        (void)fflush(stderr);                                                                           \
    } while (0)

#define PROF_MARK_STAMP_COUNT 600U

namespace {
constexpr uint32_t PROF_KERNEL_DATA_LENGTH = 10 * 1024;
constexpr uint32_t TILE_LENGTH = 1024;
}

template <pipe_t pipe>
__aicore__ inline void MarkStamp(int32_t region) {
#ifdef ENABLE_TIMESTAMP
#ifdef __DAV_VEC__
    // bisheng::cce::mark_stamp<pipe>(region);
    __dfx_region(region, pipe);
#endif
#endif
}

class KernelAddV3 {
public:
    __aicore__ inline KernelAddV3() = default;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        uint32_t blockOffset = AscendC::GetBlockIdx() * PROF_KERNEL_DATA_LENGTH;
        xGm.SetGlobalBuffer((__gm__ float *)x + blockOffset, PROF_KERNEL_DATA_LENGTH);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockOffset, PROF_KERNEL_DATA_LENGTH);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockOffset, PROF_KERNEL_DATA_LENGTH);
        loopCount = PROF_KERNEL_DATA_LENGTH / TILE_LENGTH;
    }

    __aicore__ inline void Process()
    {
        // use local memory allocator to simplify memor allocation
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        // ping
        AscendC::LocalTensor<float> xLocalPing = ubAllocator.Alloc<float, TILE_LENGTH>();
        AscendC::LocalTensor<float> yLocalPing = ubAllocator.Alloc<float, TILE_LENGTH>();
        AscendC::LocalTensor<float> zLocalPing = ubAllocator.Alloc<float, TILE_LENGTH>();
        // pong
        AscendC::LocalTensor<float> xLocalPong = ubAllocator.Alloc<float, TILE_LENGTH>();
        AscendC::LocalTensor<float> yLocalPong = ubAllocator.Alloc<float, TILE_LENGTH>();
        AscendC::LocalTensor<float> zLocalPong = ubAllocator.Alloc<float, TILE_LENGTH>();

        // double buffer
        MarkStamp<PIPE_S>(100);
        for (uint32_t i = 0; i < loopCount; i++) {
            int32_t eventID = (i % 2 == 0 ? EVENT_ID0 : EVENT_ID1);
            AscendC::LocalTensor<float> &xLocal = (i % 2 == 0 ? xLocalPing : xLocalPong);
            AscendC::LocalTensor<float> &yLocal = (i % 2 == 0 ? yLocalPing : yLocalPong);
            AscendC::LocalTensor<float> &zLocal = (i % 2 == 0 ? zLocalPing : zLocalPong);
            // dependency of PIPE_MTE3 & PIPE_MTE2 caused by xLocal/yLocal between 2 sequential loops
            AscendC::Mutex::Lock<PIPE_MTE2>(eventID);
            MarkStamp<PIPE_MTE2>(200);
            AscendC::DataCopy(xLocal, xGm[i * TILE_LENGTH], TILE_LENGTH);
            MarkStamp<PIPE_MTE2>(201);
            AscendC::DataCopy(yLocal, yGm[i * TILE_LENGTH], TILE_LENGTH);
            MarkStamp<PIPE_MTE2>(202);
            AscendC::Mutex::Unlock<PIPE_MTE2>(eventID);
            
            // dependency of PIPE_MTE2 & PIPE_V caused by xLocal/yLocal in one single loop
            AscendC::Mutex::Lock<PIPE_V>(eventID);
            MarkStamp<PIPE_V>(300);
            AscendC::Add(zLocal, xLocal, yLocal, TILE_LENGTH);
            MarkStamp<PIPE_V>(301);
            AscendC::Mutex::Unlock<PIPE_V>(eventID);
            AscendC::Mutex::Lock<PIPE_MTE3>(eventID);
            // dependency of PIPE_V & PIPE_MTE3 caused by zLocal in one single loop
            MarkStamp<PIPE_MTE3>(400);
            AscendC::DataCopy(zGm[i * TILE_LENGTH], zLocal, TILE_LENGTH);
            MarkStamp<PIPE_MTE3>(401);
            AscendC::Mutex::Unlock<PIPE_MTE3>(eventID);
            // dependency of PIPE_MTE3 & PIPE_MTE2 caused by zLocal between 2 sequential loops
        }
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t loopCount;
};

__global__ __vector__ void hello_world(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelAddV3 op;
    op.Init(x, y, z);
    op.Process();
}

#define PROF_READ_BUF_SIZE (256U * 1024U)
#define PROF_READ_IDLE_US  (10U * 1000U)
#define PROF_DEFAULT_DEVICE_ID 0U
constexpr uint64_t PROF_INSTR = 0x00800000;
#define PROF_KERNEL_LAUNCH_COUNT 1U
#define PROF_KERNEL_BLOCK_COUNT 64U
#define PROF_BIU_PERF_CYCLE 16U
#define PROF_BIU_PC_SAMPLING_MODE 0U
#define PROF_BIU_DIE0_AICORE_NUM 18U
#define PROF_BIU_GROUP_NUM 6U
#define PROF_BIU_LOWER_GROUP_NUM 3U
#define PROF_BIU_HIGHER_GROUP_NUM 6U
#define PROF_BIU_GROUP_CHANNEL_NUM 3U
#define PROF_BIU_GROUP_TYPE_AIC 0U
#define PROF_BIU_GROUP_TYPE_AIV0 1U
#define PROF_BIU_GROUP_TYPE_AIV1 2U
#define PROF_BIU_SAMPLE_GROUP_ID 0U
#define PROF_BIU_SAMPLE_TARGET_COUNT 3U
#define PROF_BIU_SAMPLE_OUTPUT_FILE_AIC "hello_world_biu_perf_aic.bin"
#define PROF_BIU_SAMPLE_OUTPUT_FILE_AIV0 "hello_world_biu_perf_aiv0.bin"
#define PROF_BIU_SAMPLE_OUTPUT_FILE_AIV1 "hello_world_biu_perf_aiv1.bin"
#define PROF_ASCEND_LOG_DIR "/root/ascend/log"
#define PROF_ASCEND_DEBUG_LOG_DIR "/root/ascend/log/debug"
#define PROF_MSNPU_REPORT_TS_DEBUG_CMD "/usr/local/Ascend/driver/tools/msnpureport --docker -m TS:debug"
#define PROF_MSNPU_REPORT_FLUSH_CMD "/usr/local/Ascend/driver/tools/msnpureport --docker -f"
#define PROF_LOG_SEARCH_KEYWORD "biu"
#define PROF_LOG_SEARCH_LINE_SIZE 4096U

typedef struct {
    uint32_t period;
    uint32_t biuPcSamplingMode;
    uint32_t groupType;
    uint32_t groupNo;
} ProfBiuProfileConfig;

typedef struct {
    uint32_t group_id;
    uint32_t group_type;
    const char *output_file;
} ProfBiuSampleTarget;

static const unsigned int g_biu_group_channel_map[PROF_BIU_GROUP_NUM][PROF_BIU_GROUP_CHANNEL_NUM] = {
    {CHANNEL_BIU_GROUP0_AIC, CHANNEL_BIU_GROUP0_AIV0, CHANNEL_BIU_GROUP0_AIV1},
    {CHANNEL_BIU_GROUP1_AIC, CHANNEL_BIU_GROUP1_AIV0, CHANNEL_BIU_GROUP1_AIV1},
    {CHANNEL_BIU_GROUP2_AIC, CHANNEL_BIU_GROUP2_AIV0, CHANNEL_BIU_GROUP2_AIV1},
    {CHANNEL_BIU_GROUP3_AIC, CHANNEL_BIU_GROUP3_AIV0, CHANNEL_BIU_GROUP3_AIV1},
    {CHANNEL_BIU_GROUP4_AIC, CHANNEL_BIU_GROUP4_AIV0, CHANNEL_BIU_GROUP4_AIV1},
    {CHANNEL_BIU_GROUP5_AIC, CHANNEL_BIU_GROUP5_AIV0, CHANNEL_BIU_GROUP5_AIV1},
};

static const char *const g_biu_group_type_names[PROF_BIU_GROUP_CHANNEL_NUM] = {
    "aic",
    "aiv0",
    "aiv1",
};

static const ProfBiuSampleTarget g_biu_sample_targets[PROF_BIU_SAMPLE_TARGET_COUNT] = {
    {PROF_BIU_SAMPLE_GROUP_ID, PROF_BIU_GROUP_TYPE_AIC, PROF_BIU_SAMPLE_OUTPUT_FILE_AIC},
    {PROF_BIU_SAMPLE_GROUP_ID, PROF_BIU_GROUP_TYPE_AIV0, PROF_BIU_SAMPLE_OUTPUT_FILE_AIV0},
    {PROF_BIU_SAMPLE_GROUP_ID, PROF_BIU_GROUP_TYPE_AIV1, PROF_BIU_SAMPLE_OUTPUT_FILE_AIV1},
};
int g_start = 0;

static int prof_find_sample_target_by_channel(unsigned int channel_id)
{
    for (uint32_t i = 0; i < PROF_BIU_SAMPLE_TARGET_COUNT; i++) {
        if (g_biu_group_channel_map[g_biu_sample_targets[i].group_id][g_biu_sample_targets[i].group_type] == channel_id) {
            return (int)i;
        }
    }
    return -1;
}

static void prof_sampler_sleep_idle()
{
    struct timespec req = {0};

    req.tv_sec = 0;
    req.tv_nsec = PROF_READ_IDLE_US * 1000U;
    (void)nanosleep(&req, NULL);
}

static void *prof_sampler_thread(void *arg)
{
    rtProfCommandHandle_t command = {0};
    command.profSwitch = PROF_INSTR;
    command.type = PROF_COMMANDHANDLE_TYPE_START;
    command.modelId = 0xFFFFFFFFUL;
    command.cacheFlag = 0;
    command.devNums = 1;
    command.devIdList[0] = 0;
    PROF_LOG("rtProfSetProSwitch start begin, profSwitch=0x%lx, type=%u, device=%u",
        (unsigned long)command.profSwitch, command.type, 0);
    auto ret = rtProfSetProSwitch(&command, sizeof(command));
    PROF_LOG("rtProfSetProSwitch start return, ret=%d", ret);

    // enable channel
    struct prof_start_para start_para;
    ProfBiuProfileConfig biu_config;
    char *buf = NULL;
    FILE *dataFiles[PROF_BIU_SAMPLE_TARGET_COUNT] = {NULL};
    uint64_t dataBytes[PROF_BIU_SAMPLE_TARGET_COUNT] = {0};
    uint32_t dataWrites[PROF_BIU_SAMPLE_TARGET_COUNT] = {0};

    for (uint32_t i = 0; i < PROF_BIU_SAMPLE_TARGET_COUNT; i++) {
        (void)memset(&start_para, 0, sizeof(start_para));
        (void)memset(&biu_config, 0, sizeof(biu_config));
        biu_config.period = PROF_BIU_PERF_CYCLE;
        biu_config.biuPcSamplingMode = PROF_BIU_PC_SAMPLING_MODE;
        biu_config.groupType = g_biu_sample_targets[i].group_type;
        biu_config.groupNo = g_biu_sample_targets[i].group_id;

        start_para.channel_type = PROF_TS_TYPE;
        start_para.sample_period = 0;
        start_para.real_time = PROF_REAL;
        start_para.user_data = &biu_config;
        start_para.user_data_size = sizeof(biu_config);

        PROF_LOG("BIU sampler thread enter, group=%u, type=%u, group_no=%u, channel id %u",
        g_biu_sample_targets[i].group_id, g_biu_sample_targets[i].group_type, biu_config.groupNo,  g_biu_group_channel_map[g_biu_sample_targets[i].group_id][i]);

        ret = prof_drv_start(0, g_biu_group_channel_map[g_biu_sample_targets[i].group_id][i], &start_para);
        if (ret != PROF_OK) {
            PROF_LOG("prof_drv_start return, ret=%d", ret);
            return NULL;
        }
        PROF_LOG("####prof_drv_start channel = %u, ret=%d", g_biu_group_channel_map[g_biu_sample_targets[i].group_id][i], ret);
    }
    

    buf = (char *)malloc(PROF_READ_BUF_SIZE);
    if (buf == NULL) {
        PROF_LOG("sampler malloc read buffer failed, size=%u", PROF_READ_BUF_SIZE);
        return NULL;
    }

    for (uint32_t i = 0; i < PROF_BIU_SAMPLE_TARGET_COUNT; i++) {
        dataFiles[i] = fopen(g_biu_sample_targets[i].output_file, "wb");
        if (dataFiles[i] == NULL) {
            PROF_LOG("open %s failed, errno=%d", g_biu_sample_targets[i].output_file, errno);
            for (uint32_t j = 0; j < i; j++) {
                (void)fclose(dataFiles[j]);
            }
            free(buf);
            return NULL;
        }
    }
    
    struct prof_poll_info channels[6] = {0};
    while (g_start == 0) {

        ret = prof_channel_poll(channels, 6, 1);
        PROF_LOG("====================================================================================%d=", ret);
        if (ret < 0 || ret > 6) {
            PROF_LOG("prof_channel_poll error, ret=%d", ret);
	        return NULL;
        }
        if (ret == 0) {
             PROF_LOG("skip channel poll");
            continue;
        }
        for (uint32_t i = 0; i < ret; i++) {
            int ret1 = 0;
            do {
            PROF_LOG("==== device id: %u, channel id: %d", channels[i].device_id, channels[i].channel_id);
            ret1 = prof_channel_read(channels[i].device_id, channels[i].channel_id, buf, PROF_READ_BUF_SIZE);
            if (ret1 > 0) {
                int targetIndex = prof_find_sample_target_by_channel(channels[i].channel_id);
                if (targetIndex < 0) {
                    PROF_LOG("skip unknown BIU channel data, channel=%d, len=%d", channels[i].channel_id, ret1);
                    continue;
                }
                FILE *fp = dataFiles[targetIndex];
                size_t written = fwrite(buf, 1, (size_t)ret1, fp);
                if (written != (size_t)ret1) {
                    PROF_LOG("write %s failed, expect=%d, written=%zu, errno=%d",
                        g_biu_sample_targets[targetIndex].output_file, ret1, written, errno);
                    for (uint32_t j = 0; j < PROF_BIU_SAMPLE_TARGET_COUNT; j++) {
                        if (dataFiles[j] != NULL) {
                            (void)fclose(dataFiles[j]);
                        }
                    }
                    free(buf);
                    return NULL;
                }
                dataWrites[targetIndex]++;
                dataBytes[targetIndex] += (uint64_t)ret1;
                PROF_LOG("BIU prof_channel %d _read length = %d", channels[i].channel_id, ret1);
            } else {
                PROF_LOG("BIU prof_channel %d read failed ret %d", channels[i].channel_id, ret1);
            }
            } while (ret1 > 0);
        }
    }


    for (uint32_t i = 0; i < PROF_BIU_SAMPLE_TARGET_COUNT; i++) {
        PROF_LOG("BIU sampler thread stop, group=%u, type=%u, channel id: %u",
        g_biu_sample_targets[i].group_id, g_biu_sample_targets[i].group_type,  g_biu_group_channel_map[g_biu_sample_targets[i].group_id][i]);

        ret = prof_stop(0, g_biu_group_channel_map[g_biu_sample_targets[i].group_id][i]);
        if (ret != PROF_OK) {
            PROF_LOG("prof_drv_start return, ret=%d", ret);
            return NULL;
        }
    }

    rtProfCommandHandle_t command2;
    (void)memset(&command2, 0, sizeof(command2));
    command2.profSwitch = PROF_INSTR;
    command2.type = PROF_COMMANDHANDLE_TYPE_STOP;
    command2.modelId = 0xFFFFFFFFUL;
    command2.cacheFlag = 0;
    command2.devNums = 1;
    command2.devIdList[0] = 0;
    PROF_LOG("rtProfSetProSwitch stop begin, profSwitch=0x%lx, type=%u, device=%u",
        (unsigned long)command2.profSwitch, command2.type, 0);
    ret = rtProfSetProSwitch(&command2, sizeof(command2));
    PROF_LOG("rtProfSetProSwitch stop return, ret=%d", ret);
    for (uint32_t i = 0; i < PROF_BIU_SAMPLE_TARGET_COUNT; i++) {
        if (dataFiles[i] != NULL) {
            (void)fflush(dataFiles[i]);
            (void)fclose(dataFiles[i]);
        }
        PROF_LOG("prof_channel_read data written, channel=%u, file=%s, bytes=%lu, writes=%u",
            g_biu_group_channel_map[g_biu_sample_targets[i].group_id][g_biu_sample_targets[i].group_type],
            g_biu_sample_targets[i].output_file, (unsigned long)dataBytes[i], dataWrites[i]);
    }
    free(buf);
    return NULL;
}

int32_t main(int argc, char const *argv[])
{
    (void)argc;
    (void)argv;

    PROF_LOG("main enter");
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = PROF_DEFAULT_DEVICE_ID;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    constexpr uint32_t numBlocks = PROF_KERNEL_BLOCK_COUNT;
    constexpr uint32_t dataCount = 10 * 1024 * numBlocks;
    constexpr uint32_t dataSize = dataCount * sizeof(float);
    uint8_t *xGm = nullptr;
    uint8_t *yGm = nullptr;
    uint8_t *zGm = nullptr;
    float *xHost = nullptr;
    float *yHost = nullptr;
    float *zHost = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&xGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc xGm success, ptr=%p, size=%u", (void *)xGm, dataSize);
    CHECK_ACL(aclrtMalloc((void **)&yGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc yGm success, ptr=%p, size=%u", (void *)yGm, dataSize);
    CHECK_ACL(aclrtMalloc((void **)&zGm, dataSize, ACL_MEM_MALLOC_HUGE_FIRST));
    PROF_LOG("aclrtMalloc zGm success, ptr=%p, size=%u", (void *)zGm, dataSize);
    CHECK_ACL(aclrtMallocHost((void **)&xHost, dataSize));
    CHECK_ACL(aclrtMallocHost((void **)&yHost, dataSize));
    CHECK_ACL(aclrtMallocHost((void **)&zHost, dataSize));

    for (uint32_t i = 0; i < dataCount; ++i) {
        xHost[i] = (float)(2U * i);
        yHost[i] = (float)(2U * i + 1U);
        zHost[i] = 0.0f;
    }
    CHECK_ACL(aclrtMemcpy(xGm, dataSize, xHost, dataSize, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(yGm, dataSize, yHost, dataSize, ACL_MEMCPY_HOST_TO_DEVICE));


    pthread_t tid;
    pthread_create(&tid, NULL, prof_sampler_thread, nullptr);
    usleep(5000U * 1000U);
    
    PROF_LOG("launch hello_world kernels, numBlocks=%u, launch_count=%u", numBlocks, PROF_KERNEL_LAUNCH_COUNT);
    for (uint32_t i = 0; i < PROF_KERNEL_LAUNCH_COUNT; ++i) {
        PROF_LOG("launch hello_world kernel[%u/%u]", i + 1, PROF_KERNEL_LAUNCH_COUNT);
        hello_world<<<numBlocks, nullptr, stream>>>(xGm, yGm, zGm);
    }
    PROF_LOG("kernel launches issued, synchronize stream begin");
    PROF_LOG("call aclrtSynchronizeStream(stream)");
    int32_t verifyRet = 0;
    aclError syncRet = aclrtSynchronizeStream(stream);
    if (syncRet != ACL_SUCCESS) {
        PROF_LOG("aclrtSynchronizeStream(stream) failed, ret=%d", syncRet);
        verifyRet = syncRet;
    } else {
        PROF_LOG("aclrtSynchronizeStream(stream) success");
        PROF_LOG("stream synchronized");
        PROF_LOG("call aclrtMemcpy(zHost, dataSize, zGm, dataSize, ACL_MEMCPY_DEVICE_TO_HOST)");
        aclError copyRet = aclrtMemcpy(zHost, dataSize, zGm, dataSize, ACL_MEMCPY_DEVICE_TO_HOST);
        if (copyRet != ACL_SUCCESS) {
            PROF_LOG("aclrtMemcpy(zHost, dataSize, zGm, dataSize, ACL_MEMCPY_DEVICE_TO_HOST) failed, ret=%d", copyRet);
            verifyRet = copyRet;
        } else {
            PROF_LOG("aclrtMemcpy(zHost, dataSize, zGm, dataSize, ACL_MEMCPY_DEVICE_TO_HOST) success");
            uint32_t mismatchCount = 0;
            for (uint32_t i = 0; i < dataCount; ++i) {
                float expected = (float)(4U * i + 1U);
                if (zHost[i] != expected) {
                    if (mismatchCount < 8U) {
                        PROF_LOG("verify mismatch index=%u, x=%f, y=%f, z=%f, expected=%f",
                            i, xHost[i], yHost[i], zHost[i], expected);
                    }
                    mismatchCount++;
                }
            }
            if (mismatchCount != 0U) {
                PROF_LOG("verify z result failed, mismatches=%u, count=%u", mismatchCount, dataCount);
                verifyRet = -1;
            } else {
                PROF_LOG("verify z result success, count=%u, x[0]=%f, y[0]=%f, z[0]=%f, z[last]=%f",
                    dataCount, xHost[0], yHost[0], zHost[0], zHost[dataCount - 1]);
            }
        }
    }
    PROF_LOG("wait briefly before stopping BIU channel");
    usleep(100U * 1000U);
    g_start = 1;
    PROF_LOG("cleanup begin");
    pthread_join(tid, nullptr);
    
    PROF_LOG("cleanup end");
    CHECK_ACL(aclrtFreeHost(xHost));
    CHECK_ACL(aclrtFreeHost(yHost));
    CHECK_ACL(aclrtFreeHost(zHost));
    CHECK_ACL(aclrtFree(xGm));
    CHECK_ACL(aclrtFree(yGm));
    CHECK_ACL(aclrtFree(zGm));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return verifyRet;
}
