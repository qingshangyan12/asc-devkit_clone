#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <cfloat>

#include "acl/acl.h"
#include "kernel_operator.h"

#if defined(ASCENDC_CPU_DEBUG)
#include "tikicpulib.h"
#endif

#include "adv_api/detail/math/erfcx/erfcx_3510_impl.h"

constexpr uint32_t BUFFER_NUM = 1;

class KernelErfcx {
public:
    __aicore__ inline KernelErfcx() {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, uint32_t totalLength)
    {
        if (totalLength == 0) {
            return;
        }
        this->tileLength = totalLength;

        inputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(input), totalLength);
        outputGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output), totalLength);

        pipe.InitBuffer(inQueue, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueue, BUFFER_NUM, this->tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if (tileLength == 0) {
            return;
        }
        CopyIn(0);
        Compute(0);
        CopyOut(0);
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueue.AllocTensor<float>();
        AscendC::DataCopy(xLocal, inputGlobal[progress * this->tileLength], this->tileLength);
        inQueue.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueue.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQueue.AllocTensor<float>();
        AscendC::ErfcxImpl<float>(yLocal, xLocal, this->tileLength);
        outQueue.EnQue<float>(yLocal);
        inQueue.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> yLocal = outQueue.DeQue<float>();
        AscendC::DataCopy(outputGlobal[progress * this->tileLength], yLocal, this->tileLength);
        outQueue.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueue;
    AscendC::GlobalTensor<float> inputGlobal;
    AscendC::GlobalTensor<float> outputGlobal;
    uint32_t tileLength;
};

__global__ __vector__ void erfcx_custom(GM_ADDR input, GM_ADDR output, uint32_t totalLength)
{
    KernelErfcx op;
    op.Init(input, output, totalLength);
    op.Process();
}

static float erfcx_golden(float x)
{
    const float kThreshold = 10.055f;
    const float kInvSqrtPi = 0.5641896f;
    float ax = fabsf(x);
    float result;

    if (ax < kThreshold) {
        float inv_ax_plus_4 = 1.0f / (ax + 4.0f);
        float t = (ax - 4.0f) * inv_ax_plus_4;
        float residual_t = fmaf(-t, ax, fmaf(-4.0f, t + 1.0f, ax));
        t = fmaf(inv_ax_plus_4, residual_t, t);
        float p = fmaf(0.0008912171f, t, 0.007045788f);
        p = fmaf(p, t, -0.0158668961f);
        p = fmaf(p, t, 0.036429625f);
        p = fmaf(p, t, -0.06664343f);
        p = fmaf(p, t, 0.09381453f);
        p = fmaf(p, t, -0.100990564f);
        p = fmaf(p, t, 0.068094f);
        p = fmaf(p, t, -0.0153773874f);
        p = fmaf(p, t, -0.139621079f);
        p = fmaf(p, t, 1.23299515f);
        float inv_denom = 1.0f / (2.0f * ax + 1.0f);
        float q = p * inv_denom;
        float residual_q = fmaf(ax, -2.0f * q, p) - q;
        result = fmaf(residual_q, inv_denom, q);
    } else {
        float inv_x = 1.0f / ax;
        float z = inv_x * inv_x;
        float poly = fmaf(6.5625f, z, -1.875f);
        poly = fmaf(poly, z, 0.75f);
        poly = fmaf(poly, z, -0.5f);
        poly = fmaf(poly, z, 1.0f);
        result = kInvSqrtPi * inv_x * poly;
    }

    if (x < 0.0f) {
        float exp_term = expf(ax * ax);
        if (std::isinf(exp_term)) {
            return exp_term;
        }
        result = 2.0f * exp_term - result;
    }

    return result;
}

static bool IsClose(float a, float b)
{
    if (std::isnan(a) && std::isnan(b)) {
        return true;
    }
    if (std::isinf(a) && std::isinf(b)) {
        return std::signbit(a) == std::signbit(b);
    }
    float absDiff = fabsf(a - b);
    float maxVal = fmaxf(fabsf(a), fabsf(b));
    float threshold = 1e-5f + 1e-3f * maxVal;
    return absDiff <= threshold;
}

static uint32_t CompareResults(const float* output, const float* golden, uint32_t count,
                                const char* testName)
{
    uint32_t errorCount = 0;
    for (uint32_t i = 0; i < count; i++) {
        if (!IsClose(output[i], golden[i])) {
            if (errorCount < 10) {
                printf("  [%u] got=%e (%08x) expected=%e (%08x)\n",
                       i, output[i], *(const uint32_t*)(output + i),
                       golden[i], *(const uint32_t*)(golden + i));
            }
            errorCount++;
        }
    }
    if (errorCount == 0) {
        printf("  [PASS] %s (%u elements)\n", testName, count);
    } else {
        printf("  [FAIL] %s: %u/%u mismatches\n", testName, errorCount, count);
    }
    return errorCount;
}

static void RunErfcx(const float* inputHost, float* outputHost, uint32_t totalLength)
{
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    size_t byteSize = totalLength * sizeof(float);
    uint8_t *inputDevice = nullptr;
    uint8_t *outputDevice = nullptr;

    aclrtMalloc(reinterpret_cast<void**>(&inputDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(inputDevice, byteSize, inputHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

#if defined(ASCENDC_CPU_DEBUG)
    AscendC::SetKernelMode(KernelMode::AIV_MODE);
    ICPU_RUN_KF(erfcx_custom, 1, inputDevice, outputDevice, totalLength);
#else
    erfcx_custom<<<1, nullptr, stream>>>(inputDevice, outputDevice, totalLength);
#endif
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, byteSize, outputDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(inputDevice);
    aclrtFree(outputDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
}

static uint32_t RunTest(const float* input, uint32_t count, const char* testName)
{
    constexpr uint32_t align = 8u;
    uint32_t paddedCount = (count + align - 1u) & ~(align - 1u);
    float* paddedInput = new float[paddedCount];
    float* output = new float[paddedCount];
    float* golden = new float[count];

    memcpy(paddedInput, input, count * sizeof(float));
    for (uint32_t i = count; i < paddedCount; i++) {
        paddedInput[i] = 0.0f;
    }

    RunErfcx(paddedInput, output, paddedCount);
    for (uint32_t i = 0; i < count; i++) {
        golden[i] = erfcx_golden(input[i]);
    }
    uint32_t errors = CompareResults(output, golden, count, testName);

    delete[] paddedInput;
    delete[] output;
    delete[] golden;
    return errors;
}

static float MakeFloat(uint32_t u)
{
    float f;
    memcpy(&f, &u, sizeof(f));
    return f;
}

int main()
{
    uint32_t totalErrors = 0;

    printf("========================================\n");
    printf("  Erfcx API Test (single-core, dav-3510)\n");
    printf("========================================\n\n");

    // Test 1: Normal positive values (low path, ax < kThreshold)
    {
        printf("[Test 1] Normal positive values\n");
        float input[] = {
            0.0f, 0.001f, 0.01f, 0.1f, 0.25f, 0.5f, 0.75f,
            1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 5.0f, 7.0f, 9.0f, 10.0f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Positive values [0..10]");
        printf("\n");
    }

    // Test 2: Small values near zero
    {
        printf("[Test 2] Small values near zero\n");
        float input[] = {
             1e-7f, -1e-7f,
             1e-6f, -1e-6f,
             1e-5f, -1e-5f,
             1e-4f, -1e-4f,
             1e-3f, -1e-3f,
             1e-2f, -1e-2f,
            FLT_MIN, -FLT_MIN,
            FLT_EPSILON
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Small values near zero");
        printf("\n");
    }

    // Test 3: Negative values (negative path: 2*exp - result)
    {
        printf("[Test 3] Negative values\n");
        float input[] = {
            -0.001f, -0.01f, -0.1f, -0.25f, -0.5f, -0.75f,
            -1.0f, -1.5f, -2.0f, -3.0f, -4.0f, -5.0f, -6.0f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Negative values");
        printf("\n");
    }

    // Test 4: Large positive values (high path, ax >= kThreshold)
    {
        printf("[Test 4] Large positive values (asymptotic)\n");
        float input[] = {
            10.1f, 10.5f, 11.0f, 12.0f, 13.0f, 14.0f, 15.0f,
            16.0f, 18.0f, 20.0f, 25.0f, 30.0f, 40.0f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Large positive values");
        printf("\n");
    }

    // Test 5: Large negative values (overflow path)
    {
        printf("[Test 5] Large negative values (overflow)\n");
        float input[] = {
            -5.0f, -6.0f, -7.0f, -8.0f, -9.0f, -10.0f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Large negative values");
        printf("\n");
    }

    // Test 6: Special values (inf, -inf, nan, +/-0)
    {
        printf("[Test 6] Special values\n");
        float inf = MakeFloat(0x7F800000u);
        float negInf = MakeFloat(0xFF800000u);
        float nanVal = MakeFloat(0x7FC00000u);
        float negZero = -0.0f;
        float input[] = {inf, negInf, nanVal, -1.0f, negZero, 0.0f};
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Special values (inf, -inf, nan, -1, +/-0)");
        printf("\n");
    }

    // Test 7: Values near branch threshold (kThreshold = 10.055)
    {
        printf("[Test 7] Values near threshold (10.055)\n");
        float input[] = {
            9.8f, 9.9f, 10.0f, 10.03f, 10.05f, 10.06f,
            10.07f, 10.1f, 10.2f, 10.5f
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Values near threshold");
        printf("\n");
    }

    // Test 8: Edge / boundary values
    {
        printf("[Test 8] Edge / boundary values\n");
        float input[] = {
            FLT_MIN, FLT_MAX,
            MakeFloat(0x00800000u),
            MakeFloat(0x00000001u),
            MakeFloat(0x00400000u),
            MakeFloat(0x007FFFFFu),
            0.5f, 1.0f, 4.0f,
        };
        uint32_t count = sizeof(input) / sizeof(float);
        totalErrors += RunTest(input, count, "Edge / boundary values");
        printf("\n");
    }

    // Test 9: Bulk random test [-8, 16]
    {
        printf("[Test 9] Bulk random test (2048 elements)\n");
        constexpr uint32_t count = 2048;
        float* input = new float[count];
        srand(42);
        for (uint32_t i = 0; i < count; i++) {
            float val = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
            val = val * 24.0f - 8.0f;
            input[i] = val;
        }
        totalErrors += RunTest(input, count, "Bulk random [-8, 16] (2048)");
        delete[] input;
        printf("\n");
    }

    // Test 10: Monotonic sequence [-4, 12]
    {
        printf("[Test 10] Monotonic sequence\n");
        constexpr uint32_t count = 256;
        float input[count];
        for (uint32_t i = 0; i < count; i++) {
            input[i] = -4.0f + static_cast<float>(i) * 16.0f / static_cast<float>(count - 1);
        }
        totalErrors += RunTest(input, count, "Monotonic [-4, 12] (256)");
        printf("\n");
    }

    printf("========================================\n");
    if (totalErrors == 0) {
        printf("  ALL TESTS PASSED\n");
    } else {
        printf("  TOTAL MISMATCHES: %u\n", totalErrors);
        printf("  SOME TESTS FAILED\n");
    }
    printf("========================================\n");

    return totalErrors > 0 ? 1 : 0;
}
