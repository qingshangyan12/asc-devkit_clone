/* !
 * \file sum-mean.asc
 * \brief 多场景样例：Sum 和 Mean 高阶API演示
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 场景编号：1=Sum, 2=Mean
constexpr uint32_t scenarioNum = SCENARIO_NUM;

struct MeanSumCustomTilingData {
    uint32_t inner;
    uint32_t outter;
    uint32_t n;
    uint32_t tmpBufSize;
    uint32_t outInner;
};

void GenerateTilingData(uint8_t* tilingBuf, const uint32_t m, const uint32_t n)
{
    MeanSumCustomTilingData* tiling = reinterpret_cast<MeanSumCustomTilingData*>(tilingBuf);
    uint32_t maxValue, minValue;
    
    if constexpr (scenarioNum == 1) {
        // 场景1：Sum - 获取 Sum API 需要的临时空间大小
        AscendC::GetSumMaxMinTmpSize(n, sizeof(float), sizeof(float), false, maxValue, minValue);
    } else {
        // 场景2：Mean - 获取 Mean API 需要的临时空间大小
        AscendC::GetMeanMaxMinTmpSize(n, sizeof(float), sizeof(float), false, maxValue, minValue);
    }
    
    auto paddingFunc = [](const uint32_t n1, const uint32_t typeSize) -> uint32_t {
        return (n1 * typeSize + 31) / 32 * 32 / typeSize;
    };
    
    tiling->outter = m;
    tiling->inner = paddingFunc(n, sizeof(float));
    tiling->n = n;
    tiling->tmpBufSize = minValue;
    tiling->outInner = paddingFunc(m, sizeof(float));
}

template <typename T>
class KernelMeanSum {
public:
    __aicore__ inline KernelMeanSum() {}
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, uint8_t* tilingData,
                                uint32_t outter, uint32_t inner, uint32_t n, uint32_t Size,
                                AscendC::TPipe* pipeIn)
    {
        ASCENDC_ASSERT(AscendC::GetBlockNum() != 0, { KERNEL_LOG(KERNEL_ERROR, "block dim can not be zero!"); });

        srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);

        pipe = pipeIn;
        pipe->InitBuffer(inQueue, 1, inner * outter * sizeof(T));
        pipe->InitBuffer(outQueue, 1,
                         (outter * sizeof(T) + AscendC::ONE_BLK_SIZE - 1) / AscendC::ONE_BLK_SIZE
                             * AscendC::ONE_BLK_SIZE);
        if constexpr (scenarioNum == 2) {
            // 场景2：Mean 需要临时缓冲区
            pipe->InitBuffer(tmpBuf, 1, Size);
        }
        
        // 分别设置 Mean 和 Sum 的参数结构体
        meanParams.outter = outter;
        meanParams.inner = inner;
        meanParams.n = n;
        
        params.outter = outter;
        params.inner = inner;
        params.n = n;
        
        tmpSize = Size;
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.AllocTensor<T>();
        if constexpr (scenarioNum == 1) {
            // 场景1：Sum
            AscendC::DataCopy(srcLocal, srcGlobal, params.inner * params.outter);
        } else {
            // 场景2：Mean
            AscendC::DataCopy(srcLocal, srcGlobal, meanParams.inner * meanParams.outter);
        }
        inQueue.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueue.AllocTensor<T>();
        
        T scalar(0);
        uint32_t aligned_outter;
        if constexpr (scenarioNum == 1) {
            aligned_outter = (params.outter * sizeof(T) + AscendC::ONE_BLK_SIZE - 1) /
                              AscendC::ONE_BLK_SIZE * AscendC::ONE_BLK_SIZE / sizeof(T);
        } else {
            aligned_outter = (meanParams.outter * sizeof(T) + AscendC::ONE_BLK_SIZE - 1) /
                              AscendC::ONE_BLK_SIZE * AscendC::ONE_BLK_SIZE / sizeof(T);
        }
        AscendC::Duplicate<T>(dstLocal, scalar, aligned_outter);
        
        if constexpr (scenarioNum == 1) {
            // 场景1：Sum - 计算每行的和
            AscendC::Sum<T>(dstLocal, srcLocal, params);
        } else {
            // 场景2：Mean - 计算每行的均值
            if (tmpSize != 0) {
                AscendC::LocalTensor<uint8_t> tmplocalTensor = tmpBuf.Get<uint8_t>();
                AscendC::Mean<T, T>(dstLocal, srcLocal, tmplocalTensor, meanParams);
            } else {
                AscendC::Mean<T, T>(dstLocal, srcLocal, meanParams);
            }
        }
        
        outQueue.EnQue<T>(dstLocal);
        inQueue.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.DeQue<T>();
        uint32_t aligned_outter;
        if constexpr (scenarioNum == 1) {
            aligned_outter = (params.outter * sizeof(T) + AscendC::ONE_BLK_SIZE - 1) /
                              AscendC::ONE_BLK_SIZE * AscendC::ONE_BLK_SIZE / sizeof(T);
        } else {
            aligned_outter = (meanParams.outter * sizeof(T) + AscendC::ONE_BLK_SIZE - 1) /
                              AscendC::ONE_BLK_SIZE * AscendC::ONE_BLK_SIZE / sizeof(T);
        }
        AscendC::DataCopy(dstGlobal, dstLocal, aligned_outter);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;

    AscendC::MeanParams meanParams;  // Mean API 参数结构体
    AscendC::SumParams params;       // Sum API 参数结构体
    uint32_t tmpSize;
};

__global__ __vector__ void sum_mean_custom(GM_ADDR srcGm, GM_ADDR dstGm, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    constexpr uint32_t M = 3;
    constexpr uint32_t N = 32;
    
    MeanSumCustomTilingData tilingData;
    GenerateTilingData(reinterpret_cast<uint8_t*>(&tilingData), M, N);
    
    KernelMeanSum<float> op;
    op.Init(srcGm, dstGm, reinterpret_cast<uint8_t*>(&tilingData), M, N, N, tilingData.tmpBufSize, &pipe);
    op.Process();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b + EPS);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("wrongNum: %ld\n", wrongNum);
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t M = 3;
    uint32_t N = 32;
    size_t inputFileSize = M * N * sizeof(float);
    size_t outputFileSize = ((M * sizeof(float) + 31) / 32 * 32);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    aclrtMallocHost((void**)(&xHost), inputFileSize);
    aclrtMalloc((void**)&xDevice, inputFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputFileSize, xHost, inputFileSize);
    aclrtMemcpy(xDevice, inputFileSize, xHost, inputFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* yHost;
    uint8_t* yDevice;
    aclrtMallocHost((void**)(&yHost), outputFileSize);
    aclrtMalloc((void**)&yDevice, outputFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* tilingHost;
    uint8_t* tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MeanSumCustomTilingData));
    aclrtMalloc((void**)&tilingDevice, sizeof(MeanSumCustomTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    GenerateTilingData(tilingHost, M, N);
    aclrtMemcpy(tilingDevice, sizeof(MeanSumCustomTilingData), tilingHost, sizeof(MeanSumCustomTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    sum_mean_custom<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    aclrtFreeHost(tilingHost);

    aclrtMemcpy(yHost, outputFileSize, yDevice, outputFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputFileSize);

    bool goldenResult = true;
    goldenResult = CompareResult(yHost, outputFileSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(xDevice);
    aclrtFreeHost(xHost);
    aclrtFree(yDevice);
    aclrtFreeHost(yHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
