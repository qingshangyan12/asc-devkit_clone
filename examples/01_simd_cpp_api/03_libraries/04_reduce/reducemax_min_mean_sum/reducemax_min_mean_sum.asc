/* !
 * \file reducemax_min_mean_sum.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "tiling/tiling_api.h"

constexpr int32_t BUFFER_NUM = 1;

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <typename TYPE, int32_t EXTENT>
struct ReduceType {
    using T = TYPE;
    constexpr static int32_t extent = EXTENT;
};

template <class Type>
__aicore__ inline constexpr uint32_t Align32B()
{
    const int alignSize = 32 / sizeof(typename Type::T);
    return (Type::extent + alignSize - 1) / alignSize * alignSize;
}

template <class X_TYPE, class Y_TYPE, uint32_t Pattern, uint32_t IsReuseSource, uint32_t UseTemp>
class KernelReduce {
public:
    using T_TYPE = typename X_TYPE::T;

    __aicore__ inline KernelReduce() {}

    __aicore__ inline void Init(GM_ADDR srcGm, GM_ADDR dstGm, const uint32_t aLength, const uint32_t rLength,
                                const uint32_t srcInnerPad, AscendC::TPipe* pipeIn)
    {
#if defined(__DAV_c310__)
#ifdef __CCE_KT_TEST__
        g_coreType = 2;
#endif
#endif
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T_TYPE*)srcGm, X_TYPE::extent);
        dstGlobal.SetGlobalBuffer((__gm__ T_TYPE*)dstGm, Y_TYPE::extent);

        const uint32_t alignSize = 32 / sizeof(T_TYPE);
        this->aLength = aLength;
        this->rLength = rLength;
        this->aLengthAlign = (aLength + alignSize - 1) / alignSize * alignSize;
        this->rLengthAlign = (rLength + alignSize - 1) / alignSize * alignSize;
        this->srcInnerPad = (srcInnerPad == 1) ? true : false;
        this->size = aLength * rLength;
        this->outputSize = (Pattern == 0) ? rLength : aLength;

        if constexpr (scenarioNum == 3) {
            pipe->InitBuffer(inQueueX, 1, size * sizeof(T_TYPE));
            pipe->InitBuffer(outQueue, 1, outputSize * sizeof(T_TYPE));
            if constexpr (UseTemp == 1) {
                uint32_t k = 0, firstCopy = aLength;
                while (firstCopy > 0) {
                    k++;
                    firstCopy >>= 1;
                }
                uint32_t splitK = 1 << (k - 1);
                constexpr uint32_t elePerRep = 256 / sizeof(T_TYPE);
                constexpr uint32_t elePerBlk = 32 / sizeof(T_TYPE);
                if constexpr (Pattern == 0) {
                    pipe->InitBuffer(bufQueue, splitK * rLength * sizeof(T_TYPE));
                } else {
                    if (rLength < elePerRep) {
                        pipe->InitBuffer(bufQueue, aLength * elePerBlk * sizeof(T_TYPE));
                    } else if (rLength >= elePerRep) {
                        pipe->InitBuffer(bufQueue, aLength * elePerRep * sizeof(T_TYPE));
                    }
                }
            }
        } else {
            pipe->InitBuffer(inQueueX, BUFFER_NUM, Align32B<X_TYPE>() * sizeof(T_TYPE));
            pipe->InitBuffer(outQueue, BUFFER_NUM, Y_TYPE::extent * sizeof(T_TYPE));
        }
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T_TYPE> srcLocal = inQueueX.AllocTensor<T_TYPE>();
        AscendC::DataCopyPadExtParams<T_TYPE> padParams;
        AscendC::DataCopyExtParams copyParams;
        
        if constexpr (scenarioNum == 3) {
            DataCopy(srcLocal, srcGlobal, size);
        } else {
            if (srcInnerPad == 0) {
                copyParams.blockCount = 1;
                copyParams.blockLen = X_TYPE::extent * sizeof(T_TYPE);
                copyParams.srcStride = 0;
                copyParams.dstStride = 0;
                padParams.isPad = 0;
                padParams.leftPadding = 0;
                padParams.rightPadding = 0;
                padParams.paddingValue = 0;
                DataCopyPad(srcLocal, srcGlobal, copyParams, padParams);
            } else {
                padParams.isPad = 1;
                padParams.leftPadding = 0;
                padParams.paddingValue = 0;
                if constexpr (Pattern == 0) {
                    copyParams.blockCount = aLength;
                    copyParams.blockLen = rLength * sizeof(T_TYPE);
                    copyParams.srcStride = rLength * sizeof(T_TYPE);
                    copyParams.dstStride = rLengthAlign * sizeof(T_TYPE) / 32;
                    padParams.rightPadding = rLengthAlign - rLength;
                } else {
                    padParams.rightPadding = aLengthAlign - aLength;
                }
                DataCopyPad(srcLocal, srcGlobal, copyParams, padParams);
            }
        }
        inQueueX.EnQue(srcLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T_TYPE> srcLocal = inQueueX.DeQue<T_TYPE>();
        AscendC::LocalTensor<T_TYPE> dstLocal = outQueue.AllocTensor<T_TYPE>();

        constexpr bool isReuse = (IsReuseSource == 1) ? true : false;
        constexpr bool useTemp = (UseTemp == 1) ? true : false;

        if constexpr (scenarioNum == 3) {
            AscendC::Duplicate<T_TYPE>(dstLocal, static_cast<T_TYPE>(0), outputSize);
            AscendC::PipeBarrier<PIPE_V>();
            uint32_t shape[2] = {aLength, rLength};

            if constexpr (useTemp) {
                AscendC::LocalTensor<uint8_t> tmpLocal = bufQueue.Get<uint8_t>();
                if constexpr (Pattern == 0) {
                    AscendC::ReduceMean<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(dstLocal, srcLocal, tmpLocal, shape, true);
                } else {
                    AscendC::ReduceMean<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(dstLocal, srcLocal, tmpLocal, shape, true);
                }
            } else {
                if constexpr (Pattern == 0) {
                    AscendC::ReduceMean<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(dstLocal, srcLocal, shape, true);
                } else {
                    AscendC::ReduceMean<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(dstLocal, srcLocal, shape, true);
                }
            }
        } else {
            if constexpr (Pattern == 0) {
                uint32_t srcShape[2] = {aLength, rLength};
                if constexpr (scenarioNum == 1) {
                    AscendC::ReduceMax<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(dstLocal, srcLocal, srcShape, srcInnerPad);
                } else if constexpr (scenarioNum == 2) {
                    AscendC::ReduceMin<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(dstLocal, srcLocal, srcShape, srcInnerPad);
                } else if constexpr (scenarioNum == 4) {
                    AscendC::ReduceSum<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(dstLocal, srcLocal, srcShape, srcInnerPad);
                }
            } else if constexpr (Pattern == 1) {
                uint32_t srcShape[2] = {rLength, aLength};
                if constexpr (scenarioNum == 1) {
                    AscendC::ReduceMax<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(dstLocal, srcLocal, srcShape, srcInnerPad);
                } else if constexpr (scenarioNum == 2) {
                    AscendC::ReduceMin<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(dstLocal, srcLocal, srcShape, srcInnerPad);
                } else if constexpr (scenarioNum == 4) {
                    AscendC::ReduceSum<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(dstLocal, srcLocal, srcShape, srcInnerPad);
                }
            }
        }

        outQueue.EnQue<T_TYPE>(dstLocal);
        inQueueX.FreeTensor(srcLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T_TYPE> dstLocal = outQueue.DeQue<T_TYPE>();
        AscendC::DataCopyExtParams copyParams;
        AscendC::DataCopyPadExtParams<T_TYPE> padParams;

        if constexpr (scenarioNum == 3) {
            copyParams.blockCount = 1;
            copyParams.blockLen = outputSize * sizeof(T_TYPE);
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            padParams.isPad = false;
            padParams.leftPadding = 0;
            padParams.rightPadding = 0;
            padParams.paddingValue = 0;
            AscendC::DataCopyPad<T_TYPE>(dstGlobal, dstLocal, copyParams);
        } else {
            if (srcInnerPad == 0) {
                copyParams.blockCount = 1;
                copyParams.blockLen = Y_TYPE::extent * sizeof(T_TYPE);
                copyParams.srcStride = 0;
                copyParams.dstStride = 0;
                AscendC::DataCopyPad(dstGlobal, dstLocal, copyParams);
            } else {
                copyParams.blockCount = aLength;
                copyParams.blockLen = rLength * sizeof(T_TYPE);
                copyParams.srcStride = rLength * sizeof(T_TYPE);
                copyParams.dstStride = rLengthAlign * sizeof(T_TYPE) / 32;
                AscendC::DataCopyPad(dstGlobal, dstLocal, copyParams);
            }
        }
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueue;
    AscendC::TBuf<AscendC::QuePosition::VECIN> bufQueue;
    AscendC::GlobalTensor<T_TYPE> srcGlobal;
    AscendC::GlobalTensor<T_TYPE> dstGlobal;
    uint32_t aLength;
    uint32_t rLength;
    uint32_t aLengthAlign;
    uint32_t rLengthAlign;
    uint32_t size;
    uint32_t outputSize;
    bool srcInnerPad;
};

__global__ __vector__ void reduce_custom(GM_ADDR src_gm, GM_ADDR dst_gm)
{
    AscendC::TPipe pipe;
    typedef ReduceType<float, 4352> xTypeMax;
    typedef ReduceType<float, 136> yTypeMax;
    typedef ReduceType<float, 64> xTypeMinSum;
    typedef ReduceType<float, 2> yTypeMinSum;

    if constexpr (scenarioNum == 1) {
        constexpr uint32_t aLength = 136;
        constexpr uint32_t rLength = 32;
        constexpr uint32_t srcInnerPad = 0;
        constexpr uint32_t pattern = 1;
        constexpr uint32_t isReuseSource = 1;
        constexpr uint32_t useTemp = 0;
        KernelReduce<xTypeMax, yTypeMax, pattern, isReuseSource, useTemp> op;
        op.Init(src_gm, dst_gm, aLength, rLength, srcInnerPad, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        constexpr uint32_t aLength = 2;
        constexpr uint32_t rLength = 32;
        constexpr uint32_t srcInnerPad = 0;
        constexpr uint32_t pattern = 0;
        constexpr uint32_t isReuseSource = 1;
        constexpr uint32_t useTemp = 0;
        KernelReduce<xTypeMinSum, yTypeMinSum, pattern, isReuseSource, useTemp> op;
        op.Init(src_gm, dst_gm, aLength, rLength, srcInnerPad, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        constexpr uint32_t aLength = 1;
        constexpr uint32_t rLength = 32;
        constexpr uint32_t srcInnerPad = 0;
        constexpr uint32_t pattern = 1;
        constexpr uint32_t isReuseSource = 1;
        constexpr uint32_t useTemp = 0;
        KernelReduce<ReduceType<float, 32>, ReduceType<float, 1>, pattern, isReuseSource, useTemp> op;
        op.Init(src_gm, dst_gm, aLength, rLength, srcInnerPad, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        constexpr uint32_t aLength = 2;
        constexpr uint32_t rLength = 32;
        constexpr uint32_t srcInnerPad = 1;
        constexpr uint32_t pattern = 0;
        constexpr uint32_t isReuseSource = 1;
        constexpr uint32_t useTemp = 0;
        KernelReduce<xTypeMinSum, yTypeMinSum, pattern, isReuseSource, useTemp> op;
        op.Init(src_gm, dst_gm, aLength, rLength, srcInnerPad, &pipe);
        op.Process();
    }
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("wrongNum: %ld\n", wrongNum);
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    size_t param1FileSize = 4352 * sizeof(float);
    size_t param2FileSize = 136 * sizeof(float);
    size_t param3FileSize = 0;
    uint32_t numBlocks = 1;

    if constexpr (scenarioNum == 2 || scenarioNum == 4) {
        param1FileSize = 64 * sizeof(float);
        param2FileSize = 2 * sizeof(float);
    } else if constexpr (scenarioNum == 3) {
        param1FileSize = 32 * sizeof(float);
        param2FileSize = 1 * sizeof(float);
        param3FileSize = 2 * sizeof(uint32_t);
    }

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* param1Host;
    uint8_t* param1Device;
    aclrtMallocHost((void**)(&param1Host), param1FileSize);
    aclrtMalloc((void**)&param1Device, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", param1FileSize, param1Host, param1FileSize);
    aclrtMemcpy(param1Device, param1FileSize, param1Host, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* param2Host;
    uint8_t* param2Device;
    aclrtMallocHost((void**)(&param2Host), param2FileSize);
    aclrtMalloc((void**)&param2Device, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* param3Host = nullptr;
    uint8_t* param3Device = nullptr;
    if constexpr (scenarioNum == 3) {
        aclrtMallocHost((void**)(&param3Host), param3FileSize);
        aclrtMalloc((void**)&param3Device, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/input_shape.bin", param3FileSize, param3Host, param3FileSize);
        aclrtMemcpy(param3Device, param3FileSize, param3Host, param3FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    reduce_custom<<<numBlocks, nullptr, stream>>>(param1Device, param2Device);
    aclrtSynchronizeStream(stream);

    aclrtFree(param1Device);
    aclrtFreeHost(param1Host);

    if constexpr (scenarioNum == 3) {
        aclrtFree(param3Device);
        aclrtFreeHost(param3Host);
    }

    aclrtMemcpy(param2Host, param2FileSize, param2Device, param2FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", param2Host, param2FileSize);

    bool goldenResult = true;
    goldenResult = CompareResult(param2Host, param2FileSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(param2Device);
    aclrtFreeHost(param2Host);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
