/* !
 * \file reducemax_min_mean_sum.asc
 * \brief 多场景样例：支持ReduceMax、ReduceMin、ReduceMean、ReduceSum四种场景
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "tiling/tiling_api.h"

constexpr int32_t BUFFER_NUM = 1;
// 场景编号：1=ReduceMax, 2=ReduceMin, 3=ReduceMean, 4=ReduceSum
constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <typename TYPE, int32_t EXTENT>
struct ReduceType {
    using T = TYPE;
    constexpr static int32_t extent = EXTENT;
};

template <class Type>
__aicore__ inline constexpr uint32_t Align32B()
{
    const int alignSize = 32 / sizeof(typename Type::T);
    return (Type::extent + alignSize - 1) / alignSize * alignSize;
}

// ReduceMax/Min/Sum通用Kernel类
template <class X_TYPE, class Y_TYPE, uint32_t Pattern, uint32_t IsReuseSource>
class KernelReduceMaxMinSum {
public:
    using T_TYPE = typename X_TYPE::T;

    __aicore__ inline KernelReduceMaxMinSum() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const uint32_t aLength, const uint32_t rLength,
                                const uint32_t srcInnerPad, AscendC::TPipe* pipeIn)
    {
#if defined(__DAV_c310__)
#ifdef __CCE_KT_TEST__
        g_coreType = 2;
#endif
#endif
        pipe = pipeIn;
        xGm.SetGlobalBuffer((__gm__ T_TYPE*)x, X_TYPE::extent);
        yGm.SetGlobalBuffer((__gm__ T_TYPE*)y, Y_TYPE::extent);
        pipe->InitBuffer(inQueueX, BUFFER_NUM, Align32B<X_TYPE>() * sizeof(T_TYPE));
        pipe->InitBuffer(outQueueY, BUFFER_NUM, Align32B<Y_TYPE>() * sizeof(T_TYPE));

        const uint32_t alignSize = 32 / sizeof(T_TYPE);

        this->aLength = aLength;
        this->rLength = rLength;
        this->aLengthAlign = (aLength + alignSize - 1) / alignSize * alignSize;
        this->rLengthAlign = (rLength + alignSize - 1) / alignSize * alignSize;
        this->srcInnerPad = (srcInnerPad == 1) ? true : false;
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T_TYPE> xLocal = inQueueX.DeQue<T_TYPE>();
        AscendC::LocalTensor<T_TYPE> yLocal = outQueueY.AllocTensor<T_TYPE>();

        if constexpr (Pattern == 0) {
            uint32_t srcShape[2] = {aLength, rLength};
            constexpr bool isReuse = (IsReuseSource == 1) ? true : false;

            // 场景1：ReduceMax
            if constexpr (scenarioNum == 1) {
                AscendC::ReduceMax<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
            // 场景2：ReduceMin
            else if constexpr (scenarioNum == 2) {
                AscendC::ReduceMin<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
            // 场景3：ReduceMean
            else if constexpr (scenarioNum == 3) {
                AscendC::ReduceMean<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
            // 场景4：ReduceSum
            else if constexpr (scenarioNum == 4) {
                AscendC::ReduceSum<T_TYPE, AscendC::Pattern::Reduce::AR, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
        } else if constexpr (Pattern == 1) {
            uint32_t srcShape[2] = {rLength, aLength};
            constexpr bool isReuse = (IsReuseSource == 1) ? true : false;

            // 场景1：ReduceMax
            if constexpr (scenarioNum == 1) {
                AscendC::ReduceMax<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
            // 场景2：ReduceMin
            else if constexpr (scenarioNum == 2) {
                AscendC::ReduceMin<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
            // 场景3：ReduceMean
            else if constexpr (scenarioNum == 3) {
                AscendC::ReduceMean<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
            // 场景4：ReduceSum
            else if constexpr (scenarioNum == 4) {
                AscendC::ReduceSum<T_TYPE, AscendC::Pattern::Reduce::RA, isReuse>(yLocal, xLocal, srcShape, srcInnerPad);
            }
        }

        outQueueY.EnQue<T_TYPE>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T_TYPE> xLocal = inQueueX.AllocTensor<T_TYPE>();
        AscendC::DataCopyPadExtParams<T_TYPE> padParams;
        AscendC::DataCopyExtParams copyParams;

        // 场景4 (ReduceSum) 使用简化的CopyIn，不处理srcInnerPad分支
        if constexpr (scenarioNum == 4) {
            copyParams.blockCount = 1;
            copyParams.blockLen = X_TYPE::extent * sizeof(T_TYPE);
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            padParams.isPad = 0;
            padParams.leftPadding = 0;
            padParams.rightPadding = 0;
            padParams.paddingValue = 0;
            DataCopyPad(xLocal, xGm, copyParams, padParams);
        } else {
            // 场景1、2使用原有的CopyIn逻辑
            if (srcInnerPad == 0) {
                copyParams.blockCount = 1;
                copyParams.blockLen = X_TYPE::extent * sizeof(T_TYPE);
                copyParams.srcStride = 0;
                copyParams.dstStride = 0;
                padParams.isPad = 0;
                padParams.leftPadding = 0;
                padParams.rightPadding = 0;
                padParams.paddingValue = 0;
                DataCopyPad(xLocal, xGm, copyParams, padParams);
            } else {
                padParams.isPad = 1;
                padParams.leftPadding = 0;
                padParams.paddingValue = 0;
                if constexpr (Pattern == 0) {
                    copyParams.blockCount = aLength;
                    copyParams.blockLen = rLength * sizeof(T_TYPE);
                    copyParams.srcStride = rLength * sizeof(T_TYPE);
                    copyParams.dstStride = rLengthAlign * sizeof(T_TYPE) / 32;
                    padParams.rightPadding = rLengthAlign - rLength;
                } else {
                    padParams.rightPadding = aLengthAlign - aLength;
                }
                DataCopyPad(xLocal, xGm, copyParams, padParams);
            }
        }

        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T_TYPE> yLocal = outQueueY.DeQue<T_TYPE>();

        // 场景4 (ReduceSum) 使用简化的CopyOut
        if constexpr (scenarioNum == 4) {
            DataCopyPad(yGm, yLocal, {1, static_cast<uint32_t>(Y_TYPE::extent * sizeof(T_TYPE)), 0, 0});
        } else {
            // 场景1、2使用原有的CopyOut逻辑
            AscendC::DataCopyExtParams copyParams;
            if (srcInnerPad == 0) {
                copyParams.blockCount = 1;
                copyParams.blockLen = Y_TYPE::extent * sizeof(T_TYPE);
                copyParams.srcStride = 0;
                copyParams.dstStride = 0;
                DataCopyPad(yGm, yLocal, copyParams);
            } else {
                copyParams.blockCount = aLength;
                copyParams.blockLen = rLength * sizeof(T_TYPE);
                copyParams.srcStride = rLength * sizeof(T_TYPE);
                copyParams.dstStride = rLengthAlign * sizeof(T_TYPE) / 32;
                DataCopyPad(yGm, yLocal, copyParams);
            }
        }
        outQueueY.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    AscendC::GlobalTensor<T_TYPE> xGm;
    AscendC::GlobalTensor<T_TYPE> yGm;
    uint32_t aLength;
    uint32_t rLength;
    uint32_t aLengthAlign;
    uint32_t rLengthAlign;
    bool srcInnerPad;
};

__global__ __vector__ void reducemax_min_mean_sum_custom(GM_ADDR src_gm, GM_ADDR dst_gm)
{
    AscendC::TPipe pipe;

    // 场景1：ReduceMax - 输入shape [136, 32], 输出shape [136], Pattern=RA
    if constexpr (scenarioNum == 1) {
        constexpr uint32_t X_EXTENT = 4352;
        constexpr uint32_t Y_EXTENT = 136;
        constexpr uint32_t ALength = 136;
        constexpr uint32_t RLength = 32;
        constexpr uint32_t SrcInnerPad = 0;
        constexpr uint32_t Pattern = 1;  // RA
        constexpr uint32_t IsReuseSource = 1;
        typedef ReduceType<float, X_EXTENT> xType;
        typedef ReduceType<float, Y_EXTENT> yType;
        KernelReduceMaxMinSum<xType, yType, Pattern, IsReuseSource> op;
        op.Init(src_gm, dst_gm, ALength, RLength, SrcInnerPad, &pipe);
        op.Process();
    }
    // 场景2：ReduceMin - 输入shape [2, 32], 输出shape [2], Pattern=AR
    else if constexpr (scenarioNum == 2) {
        constexpr uint32_t X_EXTENT = 64;
        constexpr uint32_t Y_EXTENT = 2;
        constexpr uint32_t ALength = 2;
        constexpr uint32_t RLength = 32;
        constexpr uint32_t SrcInnerPad = 0;
        constexpr uint32_t Pattern = 0;  // AR
        constexpr uint32_t IsReuseSource = 1;
        typedef ReduceType<float, X_EXTENT> xType;
        typedef ReduceType<float, Y_EXTENT> yType;
        KernelReduceMaxMinSum<xType, yType, Pattern, IsReuseSource> op;
        op.Init(src_gm, dst_gm, ALength, RLength, SrcInnerPad, &pipe);
        op.Process();
    }
    // 场景3：ReduceMean - 输入shape [136, 32], 输出shape [136], Pattern=RA
    else if constexpr (scenarioNum == 3) {
        constexpr uint32_t X_EXTENT = 4352;
        constexpr uint32_t Y_EXTENT = 136;
        constexpr uint32_t ALength = 136;
        constexpr uint32_t RLength = 32;
        constexpr uint32_t SrcInnerPad = 0;
        constexpr uint32_t Pattern = 1;  // RA
        constexpr uint32_t IsReuseSource = 1;
        typedef ReduceType<float, X_EXTENT> xType;
        typedef ReduceType<float, Y_EXTENT> yType;
        KernelReduceMaxMinSum<xType, yType, Pattern, IsReuseSource> op;
        op.Init(src_gm, dst_gm, ALength, RLength, SrcInnerPad, &pipe);
        op.Process();
    }
    // 场景4：ReduceSum - 输入shape [2, 32], 输出shape [2], Pattern=AR
    else if constexpr (scenarioNum == 4) {
        constexpr uint32_t X_EXTENT = 64;
        constexpr uint32_t Y_EXTENT = 2;
        constexpr uint32_t ALength = 2;
        constexpr uint32_t RLength = 32;
        constexpr uint32_t SrcInnerPad = 1;
        constexpr uint32_t Pattern = 0;  // AR
        constexpr uint32_t IsReuseSource = 1;
        typedef ReduceType<float, X_EXTENT> xType;
        typedef ReduceType<float, Y_EXTENT> yType;
        KernelReduceMaxMinSum<xType, yType, Pattern, IsReuseSource> op;
        op.Init(src_gm, dst_gm, ALength, RLength, SrcInnerPad, &pipe);
        op.Process();
    }
    else {
        AscendC::printf("not support scenarioNum: %d\n", scenarioNum);
    }
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("wrongNum: %ld\n", wrongNum);
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    // 场景1：ReduceMax - 输入4352个float，输出136个float
    // 场景2：ReduceMin - 输入64个float，输出2个float
    // 场景3：ReduceMean - 输入4352个float，输出136个float
    // 场景4：ReduceSum - 输入64个float，输出2个float
    size_t param1FileSize = 0;
    size_t param2FileSize = 0;

    if constexpr (scenarioNum == 1) {
        param1FileSize = 4352 * sizeof(float);
        param2FileSize = 136 * sizeof(float);
    } else if constexpr (scenarioNum == 2) {
        param1FileSize = 64 * sizeof(float);
        param2FileSize = 2 * sizeof(float);
    } else if constexpr (scenarioNum == 3) {
        param1FileSize = 4352 * sizeof(float);
        param2FileSize = 136 * sizeof(float);
    } else if constexpr (scenarioNum == 4) {
        param1FileSize = 64 * sizeof(float);
        param2FileSize = 2 * sizeof(float);
    }

    uint32_t numBlocks = 1;

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* param1Host;
    uint8_t* param1Device;
    aclrtMallocHost((void**)(&param1Host), param1FileSize);
    aclrtMalloc((void**)&param1Device, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", param1FileSize, param1Host, param1FileSize);
    aclrtMemcpy(param1Device, param1FileSize, param1Host, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* param2Host;
    uint8_t* param2Device;
    aclrtMallocHost((void**)(&param2Host), param2FileSize);
    aclrtMalloc((void**)&param2Device, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    reducemax_min_mean_sum_custom<<<numBlocks, nullptr, stream>>>(param1Device, param2Device);
    aclrtSynchronizeStream(stream);

    aclrtFree(param1Device);
    aclrtFreeHost(param1Host);

    aclrtMemcpy(param2Host, param2FileSize, param2Device, param2FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", param2Host, param2FileSize);

    bool goldenResult = true;
    goldenResult = CompareResult(param2Host, param2FileSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(param2Device);
    aclrtFreeHost(param2Host);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
