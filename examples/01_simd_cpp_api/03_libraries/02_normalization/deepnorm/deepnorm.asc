#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "tiling/tiling_api.h"
#include <algorithm>

constexpr uint32_t BLENGTH = 4;
constexpr uint32_t SLENGTH = 16;
constexpr uint32_t HLENGTH = 64;
constexpr uint32_t ORIGINAL_HLENGTH = 64;
constexpr float ALPHA = -5.5f;
constexpr float EPSILON = 65504.0f;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr bool IS_REUSE_SRC = false;
constexpr bool IS_BASIC_BLOCK = true;
constexpr uint32_t TILINGDATA_SIZE = 1024;
constexpr uint32_t WORKSPACE_SIZE = 16 * 1024 * 1024;

namespace optiling {
/**
 * @brief DeepNorm自定义Tiling数据结构
 */
struct DeepNormCustomTiling {
    AscendC::tiling::DeepNormTiling deepnormTilingData;
    float alpha = 0.0f;
    float epsilon = 0.0f;
    uint32_t bLength = 0;
    uint32_t sLength = 0;
    uint32_t hLength = 0;
    uint32_t originalHLength = 0;
    uint32_t isReuseSrc = 0;
    uint32_t isBasicBlock = 0;
};
} // namespace optiling

/**
 * @brief DeepNorm核函数入口
 * @param inputX_gm 输入张量
 * @param inputGx_gm SubLayer计算结果
 * @param beta_gm beta参数
 * @param gamma_gm gamma参数
 * @param output_gm 输出张量
 * @param outputMean_gm 均值输出
 * @param outputVariance_gm 方差输出
 */
extern
#if defined(__cplusplus)
    __C__
#endif
        __global__ __vector__ void deepnorm_custom(
            GM_ADDR inputX_gm, GM_ADDR inputGx_gm, GM_ADDR beta_gm, GM_ADDR gamma_gm, GM_ADDR output_gm,
            GM_ADDR outputMean_gm, GM_ADDR outputVariance_gm, GM_ADDR workspace, GM_ADDR tiling)
{
    std::vector<int64_t> shapeVec = {BLENGTH, SLENGTH, HLENGTH};
    std::vector<int64_t> originShapeVec = {BLENGTH, SLENGTH, ORIGINAL_HLENGTH};

    ge::Shape srcShape(shapeVec);
    ge::Shape originSrcShape(originShapeVec);

    optiling::DeepNormCustomTiling tilingData;

    uint32_t minValue = 0, maxValue = 0;
    bool ret =
        AscendC::GetDeepNormMaxMinTmpSize(srcShape, sizeof(float), IS_REUSE_SRC, IS_BASIC_BLOCK, maxValue, minValue);

    if (!ret) {
        printf("Error: Failed to get DeepNorm max/min tmp size\n");
        return nullptr;
    }

    uint32_t stackBufferSize = minValue;

    // 获取Tiling参数
    AscendC::tiling::DeepNormTiling deepnormTiling;
    ret = AscendC::GetDeepNormTilingInfo(
        srcShape, originSrcShape, stackBufferSize, sizeof(float), IS_REUSE_SRC, IS_BASIC_BLOCK, deepnormTiling);

    if (!ret) {
        printf("Error: Failed to get DeepNorm tiling info\n");
        return nullptr;
    }

    tilingData.deepnormTilingData = deepnormTiling;
    tilingData.alpha = ALPHA;
    tilingData.epsilon = EPSILON;
    tilingData.bLength = BLENGTH;
    tilingData.sLength = SLENGTH;
    tilingData.hLength = HLENGTH;
    tilingData.originalHLength = ORIGINAL_HLENGTH;
    tilingData.isReuseSrc = IS_REUSE_SRC ? 1 : 0;
    tilingData.isBasicBlock = IS_BASIC_BLOCK ? 1 : 0;

    uint8_t* buf = (uint8_t*)malloc(sizeof(optiling::DeepNormCustomTiling));
    if (buf) {
        memcpy(buf, &tilingData, sizeof(optiling::DeepNormCustomTiling));
    }

    return buf;
}

/**
 * @brief DeepNorm内核类
 */
template <typename T, bool isReuseSrc = false, bool isBasicBlock = false>
class KernelDeepNorm {
public:
    __aicore__ inline KernelDeepNorm() {}

    /**
     * @brief 初始化函数
     */
    __aicore__ inline void Init(
        GM_ADDR inputX_gm, GM_ADDR inputGx_gm, GM_ADDR beta_gm, GM_ADDR gamma_gm, GM_ADDR output_gm,
        GM_ADDR outputMean_gm, GM_ADDR outputVariance_gm, const optiling::DeepNormCustomTiling& customTilingData,
        AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;

        // 从Tiling数据获取参数
        tiling = customTilingData.deepnormTilingData;
        alpha = static_cast<T>(customTilingData.alpha);
        epsilon = static_cast<T>(customTilingData.epsilon);
        bLength = customTilingData.bLength;
        sLength = customTilingData.sLength;
        hLength = customTilingData.hLength;
        originalHLength = customTilingData.originalHLength;

        bshLength = bLength * sLength * hLength;
        bsLength = bLength * sLength;

        inputX_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(inputX_gm), bshLength);
        inputGx_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(inputGx_gm), bshLength);
        beta_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(beta_gm), hLength);
        gamma_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma_gm), hLength);

        output_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output_gm), bshLength);
        outputMean_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(outputMean_gm), bsLength);
        outputVariance_global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(outputVariance_gm), bsLength);

        constexpr uint32_t typeSize = sizeof(T);
        pipe->InitBuffer(inQueueX, 1, bshLength * typeSize);
        pipe->InitBuffer(inQueueGx, 1, bshLength * typeSize);
        pipe->InitBuffer(inQueueBeta, 1, hLength * typeSize);
        pipe->InitBuffer(inQueueGamma, 1, hLength * typeSize);
        pipe->InitBuffer(outQueue, 1, bshLength * typeSize);
        pipe->InitBuffer(outQueueMean, 1, bsLength * typeSize);
        pipe->InitBuffer(outQueueVariance, 1, bsLength * typeSize);
    }

    __aicore__ inline void Process()
    {
        AscendC::AscendCUtils::SetOverflow(1);
        CopyIn();
        Compute();
        CopyOut();
        AscendC::AscendCUtils::SetOverflow(0);
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> inputXLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> inputGxLocal = inQueueGx.AllocTensor<T>();
        AscendC::LocalTensor<T> gammaLocal = inQueueGamma.AllocTensor<T>();
        AscendC::LocalTensor<T> betaLocal = inQueueBeta.AllocTensor<T>();

        AscendC::DataCopy(inputXLocal, inputX_global, bshLength);
        AscendC::DataCopy(inputGxLocal, inputGx_global, bshLength);
        AscendC::DataCopy(gammaLocal, gamma_global, hLength);
        AscendC::DataCopy(betaLocal, beta_global, hLength);

        inQueueX.EnQue(inputXLocal);
        inQueueGx.EnQue(inputGxLocal);
        inQueueBeta.EnQue(betaLocal);
        inQueueGamma.EnQue(gammaLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> inputXLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> inputGxLocal = inQueueGx.DeQue<T>();
        AscendC::LocalTensor<T> gammaLocal = inQueueGamma.DeQue<T>();
        AscendC::LocalTensor<T> betaLocal = inQueueBeta.DeQue<T>();

        AscendC::LocalTensor<T> outputLocal = outQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> meanLocal = outQueueMean.AllocTensor<T>();
        AscendC::LocalTensor<T> varianceLocal = outQueueVariance.AllocTensor<T>();

        /**
         * @brief DeepNorm调用
         * @param outputLocal 输出：归一化结果
         * @param meanLocal 输出：均值
         * @param varianceLocal 输出：方差
         * @param inputXLocal 输入：原始输入
         * @param inputGxLocal 输入：SubLayer计算结果
         * @param betaLocal 输入：beta参数
         * @param gammaLocal 输入：gamma参数
         * @param alpha 输入：权重系数
         * @param epsilon 输入：防除零系数
         * @param tiling 输入：Tiling参数
         */
        AscendC::DeepNorm<T, isReuseSrc, isBasicBlock>(
            outputLocal, meanLocal, varianceLocal, inputXLocal, inputGxLocal, betaLocal, gammaLocal, alpha, epsilon,
            tiling);

        outQueue.EnQue<T>(outputLocal);
        outQueueMean.EnQue<T>(meanLocal);
        outQueueVariance.EnQue<T>(varianceLocal);

        inQueueX.FreeTensor(inputXLocal);
        inQueueGx.FreeTensor(inputGxLocal);
        inQueueGamma.FreeTensor(gammaLocal);
        inQueueBeta.FreeTensor(betaLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> outputLocal = outQueue.DeQue<T>();
        AscendC::LocalTensor<T> meanLocal = outQueueMean.DeQue<T>();
        AscendC::LocalTensor<T> varianceLocal = outQueueVariance.DeQue<T>();

        AscendC::DataCopy(output_global, outputLocal, bshLength);
        AscendC::DataCopy(outputMean_global, meanLocal, bsLength);
        AscendC::DataCopy(outputVariance_global, varianceLocal, bsLength);

        outQueue.FreeTensor(outputLocal);
        outQueueMean.FreeTensor(meanLocal);
        outQueueVariance.FreeTensor(varianceLocal);
    }

private:
    AscendC::GlobalTensor<T> inputX_global;
    AscendC::GlobalTensor<T> inputGx_global;
    AscendC::GlobalTensor<T> gamma_global;
    AscendC::GlobalTensor<T> beta_global;

    AscendC::GlobalTensor<T> output_global;
    AscendC::GlobalTensor<T> outputMean_global;
    AscendC::GlobalTensor<T> outputVariance_global;

    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueGx;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueGamma;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueBeta;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueMean;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueVariance;

    AscendC::tiling::DeepNormTiling tiling;

    uint32_t bLength = 0;
    uint32_t sLength = 0;
    uint32_t hLength = 0;
    uint32_t originalHLength = 0;
    uint32_t bshLength = 0;
    uint32_t bsLength = 0;
    T alpha = T(0);
    T epsilon = T(0);
};

// 从全局内存复制Tiling数据
__aicore__ inline void CopyDeepNormTilingData(optiling::DeepNormCustomTiling* tilingData, GM_ADDR tilingGM)
{
    uint32_t* ptr = reinterpret_cast<uint32_t*>(tilingData);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t*>(tilingGM);

    for (int i = 0; i < sizeof(optiling::DeepNormCustomTiling) / sizeof(uint32_t); i++, ptr++) {
        *ptr = *(tiling32 + i);
    }
}

/**
 * @brief DeepNorm核函数入口
 */
extern "C" __global__ __vector__ void deepnorm_custom(
    GM_ADDR inputX_gm,         // 输入张量
    GM_ADDR inputGx_gm,        // SubLayer计算结果
    GM_ADDR beta_gm,           // beta参数
    GM_ADDR gamma_gm,          // gamma参数
    GM_ADDR output_gm,         // 输出张量
    GM_ADDR outputMean_gm,     // 均值输出
    GM_ADDR outputVariance_gm, // 方差输出
    GM_ADDR workspace,         // 工作空间
    GM_ADDR tiling)            // Tiling数据
{
    AscendC::TPipe pipe;

    optiling::DeepNormCustomTiling tilingData;
    CopyDeepNormTilingData(&tilingData, tiling);

    KernelDeepNorm<float, false, true> op;
    op.Init(inputX_gm, inputGx_gm, beta_gm, gamma_gm, output_gm, outputMean_gm, outputVariance_gm, tilingData, &pipe);

    op.Process();
}

/**
 * @brief  DeepNorm核函数入口
 * @param  inputX_gm 输入张量
 * @param  inputGx_gm SubLayer计算结果
 * @param  beta_gm beta参数
 * @param  gamma_gm gamma参数
 * @param  output_gm 输出张量
 * @param  outputMean_gm 均值输出
 * @param  outputVariance_gm 方差输出
 */
extern
#if defined(__cplusplus)
    __C__
#endif
        __global__ __vector__ void deepnorm_custom(
            GM_ADDR inputX_gm, GM_ADDR inputGx_gm, GM_ADDR beta_gm, GM_ADDR gamma_gm, GM_ADDR output_gm,
            GM_ADDR outputMean_gm, GM_ADDR outputVariance_gm, GM_ADDR workspace, GM_ADDR tiling)
{
    void* goldenData = nullptr;
    aclrtMallocHost((void**)(&goldenData), outSize);
    if (!goldenData) {
        printf("Error: Failed to allocate host memory for golden data\n");
        return false;
    }

    size_t goldenSize = outSize;
    std::string goldenPath = "./output/golden_output_" + goldenName + ".bin";
    bool ret = ReadFile(goldenPath.c_str(), goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("ReadFile %s failed!\n", goldenPath.c_str());
        aclrtFreeHost(goldenData);
        return false;
    }

    printf("ReadFile %s success!\n", goldenPath.c_str());

    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;
    int64_t totalNum = outSize / sizeof(float);

    for (int i = 0; i < totalNum; i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = (std::abs(b) > EPS) ? (ae / std::abs(b)) : ae;
        if (ae > EPS && re > EPS) {
            if (wrongNum < 10) {
                printf(
                    "CompareResult golden_output_%s.bin failed at [%d]: output=%f, golden=%f\n", goldenName.c_str(), i,
                    a, b);
            }
            wrongNum++;
        }
    }

    aclrtFreeHost(goldenData);

    if (wrongNum != 0) {
        printf(
            "CompareResult golden_output_%s.bin failed, wrongNum = %ld, totalNum = %ld\n", goldenName.c_str(), wrongNum,
            totalNum);
        return false;
    } else {
        printf("CompareResult golden_output_%s.bin success!\n", goldenName.c_str());
        return true;
    }
}

/**
 * @brief DeepNorm核函数入口
 * @param inputX_gm 输入张量
 * @param inputGx_gm SubLayer计算结果
 * @param beta_gm beta参数
 * @param gamma_gm gamma参数
 * @param output_gm 输出张量
 * @param outputMean_gm 均值输出
 * @param outputVariance_gm 方差输出
 */
extern
#if defined(__cplusplus)
    __C__
#endif
        __global__ __vector__ void deepnorm_custom(
            GM_ADDR inputX_gm, GM_ADDR inputGx_gm, GM_ADDR beta_gm, GM_ADDR gamma_gm, GM_ADDR output_gm,
            GM_ADDR outputMean_gm, GM_ADDR outputVariance_gm, GM_ADDR workspace, GM_ADDR tiling)
{
    uint32_t numBlocks = NUM_BLOCKS;

    size_t workspaceSize = WORKSPACE_SIZE;
    size_t inputXSize = BLENGTH * SLENGTH * HLENGTH * sizeof(float);
    size_t inputGxSize = BLENGTH * SLENGTH * HLENGTH * sizeof(float);
    size_t betaSize = HLENGTH * sizeof(float);
    size_t gammaSize = HLENGTH * sizeof(float);
    size_t outputSize = BLENGTH * SLENGTH * HLENGTH * sizeof(float);
    size_t outputMeanSize = BLENGTH * SLENGTH * sizeof(float);
    size_t outputVarianceSize = BLENGTH * SLENGTH * sizeof(float);

    // 生成Tiling数据
    uint8_t* tilingBuf = GenerateDeepNormTiling();
    if (!tilingBuf) {
        printf("Error: Failed to generate DeepNorm tiling\n");
        return -1;
    }
    size_t tilingFileSize = sizeof(optiling::DeepNormCustomTiling);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *inputXHost = nullptr, *inputGxHost = nullptr, *betaHost = nullptr, *gammaHost = nullptr;
    uint8_t *outputHost = nullptr, *outputMeanHost = nullptr, *outputVarianceHost = nullptr;
    uint8_t *workspaceHost = nullptr, *tilingHost = nullptr;

    aclrtMallocHost((void**)(&inputXHost), inputXSize);
    aclrtMallocHost((void**)(&inputGxHost), inputGxSize);
    aclrtMallocHost((void**)(&betaHost), betaSize);
    aclrtMallocHost((void**)(&gammaHost), gammaSize);
    aclrtMallocHost((void**)(&outputHost), outputSize);
    aclrtMallocHost((void**)(&outputMeanHost), outputMeanSize);
    aclrtMallocHost((void**)(&outputVarianceHost), outputVarianceSize);
    aclrtMallocHost((void**)(&workspaceHost), workspaceSize);
    aclrtMallocHost((void**)(&tilingHost), tilingFileSize);

    if (!inputXHost || !inputGxHost || !betaHost || !gammaHost || !outputHost || !outputMeanHost ||
        !outputVarianceHost || !workspaceHost || !tilingHost) {
        printf("Error: Failed to allocate host memory\n");
        return -1;
    }

    bool readSuccess = true;
    readSuccess &= ReadFile("./input/input_inputX.bin", inputXSize, inputXHost, inputXSize);
    readSuccess &= ReadFile("./input/input_inputGx.bin", inputGxSize, inputGxHost, inputGxSize);
    readSuccess &= ReadFile("./input/input_beta.bin", betaSize, betaHost, betaSize);
    readSuccess &= ReadFile("./input/input_gamma.bin", gammaSize, gammaHost, gammaSize);

    if (!readSuccess) {
        printf("Error: Failed to read input files\n");
        return -1;
    }

    memcpy(tilingHost, tilingBuf, tilingFileSize);

    uint8_t *inputXDevice = nullptr, *inputGxDevice = nullptr, *betaDevice = nullptr, *gammaDevice = nullptr;
    uint8_t *outputDevice = nullptr, *outputMeanDevice = nullptr, *outputVarianceDevice = nullptr;
    uint8_t *workspaceDevice = nullptr, *tilingDevice = nullptr;

    aclrtMalloc((void**)&inputXDevice, inputXSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&inputGxDevice, inputGxSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&betaDevice, betaSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&gammaDevice, gammaSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputMeanDevice, outputMeanSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputVarianceDevice, outputVarianceSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&workspaceDevice, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tilingDevice, tilingFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    if (!inputXDevice || !inputGxDevice || !betaDevice || !gammaDevice || !outputDevice || !outputMeanDevice ||
        !outputVarianceDevice || !workspaceDevice || !tilingDevice) {
        printf("Error: Failed to allocate device memory\n");
        return -1;
    }

    aclrtMemcpy(inputXDevice, inputXSize, inputXHost, inputXSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(inputGxDevice, inputGxSize, inputGxHost, inputGxSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(betaDevice, betaSize, betaHost, betaSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(gammaDevice, gammaSize, gammaHost, gammaSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(workspaceDevice, workspaceSize, workspaceHost, workspaceSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tilingDevice, tilingFileSize, tilingHost, tilingFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    deepnorm_custom<<<numBlocks, nullptr, stream>>>(
        inputXDevice, inputGxDevice, betaDevice, gammaDevice, outputDevice, outputMeanDevice, outputVarianceDevice,
        workspaceDevice, tilingDevice);

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputSize, outputDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(outputMeanHost, outputMeanSize, outputMeanDevice, outputMeanSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(
        outputVarianceHost, outputVarianceSize, outputVarianceDevice, outputVarianceSize, ACL_MEMCPY_DEVICE_TO_HOST);

    WriteFile("./output/output_result.bin", outputHost, outputSize);
    WriteFile("./output/output_mean.bin", outputMeanHost, outputMeanSize);
    WriteFile("./output/output_variance.bin", outputVarianceHost, outputVarianceSize);

    bool goldenResult = true;
    goldenResult &= CompareResult(outputHost, outputSize, "result");
    goldenResult &= CompareResult(outputMeanHost, outputMeanSize, "mean");
    goldenResult &= CompareResult(outputVarianceHost, outputVarianceSize, "variance");

    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(inputXDevice);
    aclrtFree(inputGxDevice);
    aclrtFree(betaDevice);
    aclrtFree(gammaDevice);
    aclrtFree(outputDevice);
    aclrtFree(outputMeanDevice);
    aclrtFree(outputVarianceDevice);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);

    aclrtFreeHost(inputXHost);
    aclrtFreeHost(inputGxHost);
    aclrtFreeHost(betaHost);
    aclrtFreeHost(gammaHost);
    aclrtFreeHost(outputHost);
    aclrtFreeHost(outputMeanHost);
    aclrtFreeHost(outputVarianceHost);
    aclrtFreeHost(workspaceHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    free(tilingBuf);

    return goldenResult ? 0 : -1;
}