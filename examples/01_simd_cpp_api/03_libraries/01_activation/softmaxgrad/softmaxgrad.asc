/* !
 * \file softmaxgrad.asc
 * \brief SoftmaxGrad / SoftmaxGradFront 合并样例
 *        默认编译为 SoftmaxGrad 模式（isFront=false）
 *        添加 -DUSE_FRONT_MODE 编译为 SoftmaxGradFront 模式（isFront=true）
 *        两种模式仅 isFront 参数不同，核函数名统一为 softmaxgrad_custom
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "tiling/tiling_api.h"

constexpr uint32_t ROW_NUM = 960;
constexpr uint32_t COLUMN_NUM = 960;
constexpr uint32_t USED_CORE_NUM = 40;
constexpr uint32_t WORKSPACE_SIZE = 1024;
constexpr uint32_t TILINGDATA_SIZE = 28;
constexpr uint32_t FLOAT_NUM_PER_BLOCK = 8;

#ifdef USE_FRONT_MODE
constexpr bool IS_FRONT = true;
constexpr uint32_t Z_ELEM_COUNT = ROW_NUM * FLOAT_NUM_PER_BLOCK;
#else
constexpr bool IS_FRONT = false;
constexpr uint32_t Z_ELEM_COUNT = ROW_NUM * ROW_NUM;
#endif

namespace optiling {
BEGIN_TILING_DATA_DEF(SoftmaxgradCustomTilingData)
TILING_DATA_FIELD_DEF(uint32_t, columnLength);
TILING_DATA_FIELD_DEF(uint32_t, rowLength);
TILING_DATA_FIELD_DEF(uint32_t, sharedTmpBufferSize);
TILING_DATA_FIELD_DEF(uint32_t, usedNumBlocks);
TILING_DATA_FIELD_DEF(uint32_t, coreRowNum);
TILING_DATA_FIELD_DEF(uint32_t, tailCoreRowNum);
TILING_DATA_FIELD_DEF(uint32_t, singleLoopCoreRowNum);
TILING_DATA_FIELD_DEF(uint32_t, singleCoreLoopCount);
TILING_DATA_FIELD_DEF(uint32_t, singleCoreLoopTail);
TILING_DATA_FIELD_DEF(uint32_t, tailCoreSingleLoopCoreRowNum);
TILING_DATA_FIELD_DEF(uint32_t, tailCoreSingleCoreLoopCount);
TILING_DATA_FIELD_DEF(uint32_t, tailCoreSingleCoreLoopTail);
TILING_DATA_FIELD_DEF_STRUCT(SoftMaxTiling, softmaxTilingData);
END_TILING_DATA_DEF;

REGISTER_TILING_DATA_CLASS(SoftmaxgradCustom, SoftmaxgradCustomTilingData)
} // namespace optiling

namespace SoftmaxgradCustomTiling {
constexpr uint32_t SHARED_TMP_BUFFER_SIZE = 61440;
struct SingleCoreLoopParam {
    uint32_t singleLoopCoreRowNum{0};
    uint32_t singleCoreLoopCount{0};
    uint32_t singleCoreLoopTail{0};
};

const std::vector<std::pair<uint32_t, uint32_t>> SLICE_TABLE = {
    {8192, 1}, {4096, 2}, {2048, 4}, {1024, 8}, {512, 16}, {256, 32}, {0, 64}};

SingleCoreLoopParam GetSingleCoreLoopParam(const uint32_t colNum, const uint32_t coreRowNum)
{
    for (auto param : SLICE_TABLE) {
        if (colNum >= param.first) {
            return {param.second, coreRowNum / param.second, coreRowNum % param.second};
        }
    }
    return {};
}

void ComputeTiling(const uint32_t rowNum, const uint32_t colNum, const uint32_t coreNum,
                   optiling::SoftmaxgradCustomTilingData& tiling)
{
    uint32_t localworkspaceSize = SHARED_TMP_BUFFER_SIZE;
    // 分核策略：将总行数向上对齐后均分给各 Core，最后一个 Core 处理剩余尾行
    // 例：rowNum=960, coreNum=40 → alignedRowNum=960, coreRowNum=24, tailCoreRowNum=0
    auto alignedRowNum = (rowNum + coreNum - 1) / coreNum * coreNum;
    auto coreRowNum = alignedRowNum / coreNum;       // 每个 Core 分配的行数
    auto tailCoreRowNum = rowNum % coreRowNum;       // 尾核额外处理的行数
    auto usedNumBlocks = rowNum / coreRowNum;        // 实际使用的 Core 数量

    // 根据 reduce 轴长度查询 SLICE_TABLE，确定每次循环处理的行数
    auto mainParam = GetSingleCoreLoopParam(colNum, coreRowNum);
    auto tailParam = (usedNumBlocks == coreNum && tailCoreRowNum == 0)
                         ? GetSingleCoreLoopParam(colNum, coreRowNum)
                         : GetSingleCoreLoopParam(colNum, tailCoreRowNum);

    tiling.set_columnLength(colNum);
    tiling.set_rowLength(rowNum);
    tiling.set_sharedTmpBufferSize(localworkspaceSize);
    tiling.set_usedNumBlocks(usedNumBlocks);
    tiling.set_coreRowNum(coreRowNum);
    tiling.set_tailCoreRowNum(tailCoreRowNum);
    tiling.set_singleLoopCoreRowNum(mainParam.singleLoopCoreRowNum);
    tiling.set_singleCoreLoopCount(mainParam.singleCoreLoopCount);
    tiling.set_singleCoreLoopTail(mainParam.singleCoreLoopTail);
    tiling.set_tailCoreSingleLoopCoreRowNum(tailParam.singleLoopCoreRowNum);
    tiling.set_tailCoreSingleCoreLoopCount(tailParam.singleCoreLoopCount);
    tiling.set_tailCoreSingleCoreLoopTail(tailParam.singleCoreLoopTail);

    ge::Shape softmaxComputeShape({mainParam.singleLoopCoreRowNum, colNum});
    uint32_t apiNeedMinTmpSize =
        AscendC::GetSoftMaxGradMinTmpSize(softmaxComputeShape, sizeof(float), IS_FRONT, true);
    if (apiNeedMinTmpSize > SHARED_TMP_BUFFER_SIZE) {
        localworkspaceSize = apiNeedMinTmpSize;
    }
    AscendC::SoftMaxGradTilingFunc(
        softmaxComputeShape, sizeof(float), localworkspaceSize, tiling.softmaxTilingData, IS_FRONT);
}
} // namespace SoftmaxgradCustomTiling

void GenerateTiling(const uint32_t rowNum, const uint32_t colNum, const uint32_t coreNum,
                    const uint32_t tilingSize, uint8_t* tilingBuffer)
{
    optiling::SoftmaxgradCustomTilingData tiling;
    SoftmaxgradCustomTiling::ComputeTiling(rowNum, colNum, coreNum, tiling);
    tiling.SaveToBuffer(tilingBuffer, tilingSize);
}

namespace MyCustomKernel {
constexpr int32_t BUFFER_NUM = 1;

struct VecTiling {
    uint32_t columnLength = 0;
    uint32_t rowLength = 0;
    uint32_t sharedTmpBufferSize = 0;
    uint32_t usedNumBlocks = 0;
    uint32_t coreRowNum = 0;
    uint32_t tailCoreRowNum = 0;
    uint32_t singleLoopCoreRowNum = 0;
    uint32_t singleCoreLoopCount = 0;
    uint32_t singleCoreLoopTail = 0;
    uint32_t tailCoreSingleLoopCoreRowNum = 0;
    uint32_t tailCoreSingleCoreLoopCount = 0;
    uint32_t tailCoreSingleCoreLoopTail = 0;
    SoftMaxTiling softmaxTilingData;
};

/**
 * @brief SoftmaxGrad / SoftmaxGradFront 核函数实现
 *        通过 USE_FRONT_MODE 宏控制两种模式
 */
class KernelSoftmax {
public:
    __aicore__ inline KernelSoftmax() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const VecTiling& tiling, AscendC::TPipe* pipeIn)
    {
        ASSERT(AscendC::GetBlockNum() != 0 && "block dim can not be zero!");
        pipe = pipeIn;

        columnLength = tiling.columnLength;
        rowLength = tiling.rowLength;
        sharedTmpBufferSize = tiling.sharedTmpBufferSize;
        usedNumBlocks = tiling.usedNumBlocks;
        coreRowNum = tiling.coreRowNum;
        softmaxTiling = tiling.softmaxTilingData;
        singleLoopCoreRowNum = tiling.singleLoopCoreRowNum;
        singleCoreLoopCount = tiling.singleCoreLoopCount;
        leftRow = tiling.singleCoreLoopTail;

        // 尾核使用独立的循环参数
        if (AscendC::GetBlockIdx() == usedNumBlocks) {
            singleLoopCoreRowNum = tiling.tailCoreSingleLoopCoreRowNum;
            singleCoreLoopCount = tiling.tailCoreSingleCoreLoopCount;
            leftRow = tiling.tailCoreSingleCoreLoopTail;
        }

        blockLength = coreRowNum * columnLength;
        tileLength = singleLoopCoreRowNum * columnLength;

        // 根据 Core 编号计算各自在 GM 上的数据偏移
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t offset1 = blockLength * blockIdx;
        xGm.SetGlobalBuffer((__gm__ float*)x + offset1, blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + offset1, blockLength);
#ifdef USE_FRONT_MODE
        uint32_t offset2 = coreRowNum * FLOAT_NUM_PER_BLOCK * blockIdx;
        zGm.SetGlobalBuffer((__gm__ float*)z + offset2, coreRowNum * FLOAT_NUM_PER_BLOCK);
#else
        zGm.SetGlobalBuffer((__gm__ float*)z + offset1, blockLength);
#endif

        pipe->InitBuffer(queueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe->InitBuffer(queueY, BUFFER_NUM, tileLength * sizeof(float));
#ifdef USE_FRONT_MODE
        pipe->InitBuffer(queueZ, BUFFER_NUM, singleLoopCoreRowNum * FLOAT_NUM_PER_BLOCK * sizeof(float));
#endif
        pipe->InitBuffer(sharedTmpBuffer, sharedTmpBufferSize);
    }

    __aicore__ inline void Process()
    {
        // 超出实际使用范围的 Core 直接返回
        if (AscendC::GetBlockIdx() > usedNumBlocks) {
            return;
        }

        // 主循环：按 tile 大小分批处理，每批 singleLoopCoreRowNum 行
        for (int32_t i = 0; i < singleCoreLoopCount; i++) {
            CopyIn(i, singleLoopCoreRowNum);
            Compute(i, singleLoopCoreRowNum);
            CopyOut(i, singleLoopCoreRowNum);
        }
#ifndef USE_FRONT_MODE
        event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE3_MTE2));
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventId);
#endif
        // 处理剩余不足一个 tile 的尾行
        if (leftRow > 0) {
            CopyIn(singleCoreLoopCount, leftRow);
            Compute(singleCoreLoopCount, leftRow);
            CopyOut(singleCoreLoopCount, leftRow);
        }
    }

        // 主循环：按 tile 大小分批处理，每批 singleLoopCoreRowNum 行
        for (int32_t i = 0; i < singleCoreLoopCount; i++) {
            CopyIn(i, singleLoopCoreRowNum);
            Compute(i, singleLoopCoreRowNum);
            CopyOut(i, singleLoopCoreRowNum);
        }
#ifndef USE_FRONT_MODE
        event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE3_MTE2));
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventId);
#endif
        // 处理剩余不足一个 tile 的尾行
        if (leftRow > 0) {
            CopyIn(singleCoreLoopCount, leftRow);
            Compute(singleCoreLoopCount, leftRow);
            CopyOut(singleCoreLoopCount, leftRow);
        }
    }

        // 主循环：按 tile 大小分批处理，每批 singleLoopCoreRowNum 行
        for (int32_t i = 0; i < singleCoreLoopCount; i++) {
            CopyIn(i, singleLoopCoreRowNum);
            Compute(i, singleLoopCoreRowNum);
            CopyOut(i, singleLoopCoreRowNum);
        }
#ifndef USE_FRONT_MODE
        event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE3_MTE2));
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventId);
#endif
        // 处理剩余不足一个 tile 的尾行
        if (leftRow > 0) {
            CopyIn(singleCoreLoopCount, leftRow);
            Compute(singleCoreLoopCount, leftRow);
            CopyOut(singleCoreLoopCount, leftRow);
