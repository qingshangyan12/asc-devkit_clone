/* !
 * \file softmaxgrad.asc
 * \brief 基于 SoftmaxGrad 高阶 API 实现 softmax 梯度反向计算
 *
 * 计算公式: dst = (grad - sum(grad * src)) * src
 * 其中:
 *   - grad: 上游梯度（对应输入 x）
 *   - src: softmax 前向输出（对应输入 y）
 *   - dst: 输出梯度（对应输出 z）
 *
 * 内部计算流程（共 5 步矢量计算）:
 *   1. muls = grad * src        （逐元素相乘）
 *   2. sum = rowsum(muls)       （按行求和）
 *   3. broadcast(sum)           （广播到原始 shape）
 *   4. sub = grad - sum         （减法）
 *   5. dst = sub * src          （逐元素相乘）
 *
 * 输入规格:
 *   - 输入 x (grad): shape [960, 960], float 类型
 *   - 输入 y (src):  shape [960, 960], float 类型
 *   - 输出 z (dst):  shape [960, 960], float 类型
 *   - last 轴长度需满足 32 字节对齐（float 类型为 8 的倍数）
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "tiling/tiling_api.h"

// ============================================================================
// Tiling 数据结构定义
// ============================================================================

namespace optiling {
BEGIN_TILING_DATA_DEF(SoftmaxgradCustomTilingData)
TILING_DATA_FIELD_DEF(uint32_t, columnLength);              // 列数（reduce 轴长度）
TILING_DATA_FIELD_DEF(uint32_t, rowLength);                 // 总行数
TILING_DATA_FIELD_DEF(uint32_t, sharedTmpBufferSize);       // 共享临时缓冲区大小
TILING_DATA_FIELD_DEF(uint32_t, usedNumBlocks);             // 实际使用的 Core 数量
TILING_DATA_FIELD_DEF(uint32_t, coreRowNum);                // 每个 Core 分配的行数
TILING_DATA_FIELD_DEF(uint32_t, tailCoreRowNum);            // 尾核处理的剩余行数
TILING_DATA_FIELD_DEF(uint32_t, singleLoopCoreRowNum);      // 主核每次循环处理的行数
TILING_DATA_FIELD_DEF(uint32_t, singleCoreLoopCount);       // 主核完整循环次数
TILING_DATA_FIELD_DEF(uint32_t, singleCoreLoopTail);        // 主核尾块行数
TILING_DATA_FIELD_DEF(uint32_t, tailCoreSingleLoopCoreRowNum);  // 尾核每次循环处理的行数
TILING_DATA_FIELD_DEF(uint32_t, tailCoreSingleCoreLoopCount);   // 尾核完整循环次数
TILING_DATA_FIELD_DEF(uint32_t, tailCoreSingleCoreLoopTail);    // 尾核尾块行数
TILING_DATA_FIELD_DEF_STRUCT(SoftMaxTiling, softmaxTilingData); // SoftMax API 内部 Tiling 参数
END_TILING_DATA_DEF;

REGISTER_TILING_DATA_CLASS(SoftmaxgradCustom, SoftmaxgradCustomTilingData)
} // namespace optiling

// ============================================================================
// Tiling 计算逻辑（Host 端）
// ============================================================================

namespace SoftmaxgradCustomTiling {
constexpr uint32_t SHARED_TMP_BUFFER_SIZE = 61440; // 预留 60KB 临时缓冲区供 SoftMax API 使用

/**
 * @brief 单个 Core 内部的循环分块参数
 */
struct SingleCoreLoopParam {
    uint32_t singleLoopCoreRowNum{0}; // 每次循环处理的行数
    uint32_t singleCoreLoopCount{0};  // 完整循环次数
    uint32_t singleCoreLoopTail{0};   // 尾块行数
};

/**
 * @brief 切片查找表：根据 reduce 轴长度决定每次循环处理多少行
 *
 * reduce 轴越长，每行占用 UB 空间越大，每次能处理的行数越少。
 * 格式: {reduce 轴长度阈值, 每次循环处理的行数}
 */
const std::vector<std::pair<uint32_t, uint32_t>> SLICE_TABLE = {
    {8192, 1}, {4096, 2}, {2048, 4}, {1024, 8}, {512, 16}, {256, 32}, {0, 64}};

/**
 * @brief 根据 reduce 轴长度和分配给该 Core 的总行数，计算单 Core 内部循环分块参数
 *
 * @param colNum     reduce 轴长度（列数）
 * @param coreRowNum 分配给该 Core 的总行数
 * @return SingleCoreLoopParam 包含每次循环行数、循环次数、尾块行数
 */
SingleCoreLoopParam GetSingleCoreLoopParam(const uint32_t colNum, const uint32_t coreRowNum)
{
    // 遍历查找表，找到第一个满足 colNum >= 阈值的配置
    for (auto param : SLICE_TABLE) {
        if (colNum >= param.first) {
            SingleCoreLoopParam singleCoreLoopParam;
            singleCoreLoopParam.singleLoopCoreRowNum = param.second;
            singleCoreLoopParam.singleCoreLoopCount = coreRowNum / param.second;  // 完整循环次数
            singleCoreLoopParam.singleCoreLoopTail = coreRowNum % param.second;   // 尾块行数
            return singleCoreLoopParam;
        }
    }
    return {};
}

/**
 * @brief 计算 SoftmaxGrad 算子的 Tiling 参数
 *
 * 采用"平均分配法"将输入 Tensor 的行均匀分配给多个 Core。
 * 以 rowNum=960, coreNum=40 为例:
 *   - alignedRowNum = 960（向上对齐到 40 的倍数）
 *   - coreRowNum = 24（每个 Core 分配 24 行）
 *   - tailCoreRowNum = 0（无剩余行）
 *   - usedNumBlocks = 40（实际使用 40 个 Core）
 */
void ComputeTiling(const uint32_t rowNum, const uint32_t colNum, const uint32_t coreNum,
                   optiling::SoftmaxgradCustomTilingData& tiling)
{
    uint32_t localworkspaceSize = SHARED_TMP_BUFFER_SIZE;

    // 步骤 1: 平均分配法 - 计算每个 Core 分配的行数
    auto alignedRowNum = (rowNum + coreNum - 1) / coreNum * coreNum;  // 向上对齐
    auto coreRowNum = alignedRowNum / coreNum;                         // 每个 Core 分配的行数
    auto tailCoreRowNum = rowNum % coreRowNum;                         // 尾核处理的剩余行数
    auto usedNumBlocks = rowNum / coreRowNum;                          // 实际使用的 Core 数量

    // 步骤 2: 计算主核的内部循环分块参数
    SingleCoreLoopParam mainCoreLoopParam = GetSingleCoreLoopParam(colNum, coreRowNum);

    // 步骤 3: 计算尾核的内部循环分块参数
    SingleCoreLoopParam tailCoreLoopParam;
    if (usedNumBlocks == coreNum && tailCoreRowNum == 0) {
        // 所有 Core 均匀分配，尾核参数与主核相同
        tailCoreLoopParam = GetSingleCoreLoopParam(colNum, coreRowNum);
    } else {
        // 尾核处理较少行数，需要重新计算分块参数
        tailCoreLoopParam = GetSingleCoreLoopParam(colNum, tailCoreRowNum);
    }

    // 步骤 4: 填充 Tiling 数据结构
    tiling.set_columnLength(colNum);
    tiling.set_rowLength(rowNum);
    tiling.set_sharedTmpBufferSize(localworkspaceSize);
    tiling.set_usedNumBlocks(usedNumBlocks);
    tiling.set_coreRowNum(coreRowNum);
    tiling.set_tailCoreRowNum(tailCoreRowNum);

    tiling.set_singleLoopCoreRowNum(mainCoreLoopParam.singleLoopCoreRowNum);
    tiling.set_singleCoreLoopCount(mainCoreLoopParam.singleCoreLoopCount);
    tiling.set_singleCoreLoopTail(mainCoreLoopParam.singleCoreLoopTail);
    tiling.set_tailCoreSingleLoopCoreRowNum(tailCoreLoopParam.singleLoopCoreRowNum);
    tiling.set_tailCoreSingleCoreLoopCount(tailCoreLoopParam.singleCoreLoopCount);
    tiling.set_tailCoreSingleCoreLoopTail(tailCoreLoopParam.singleCoreLoopTail);

    // 步骤 5: 获取 SoftMax API 所需的最小临时缓冲区大小并生成 Tiling 参数
    ge::Shape softmaxComputeShape({mainCoreLoopParam.singleLoopCoreRowNum, colNum});
    uint32_t apiNeedMinTmpSize = AscendC::GetSoftMaxGradMinTmpSize(softmaxComputeShape, sizeof(float), false, true);
    if (apiNeedMinTmpSize > SHARED_TMP_BUFFER_SIZE) {
        localworkspaceSize = apiNeedMinTmpSize;
    } else {
        localworkspaceSize = SHARED_TMP_BUFFER_SIZE;
    }
    // 生成 SoftMax API 内部所需的 Tiling 参数（false 表示非 Front 模式）
    AscendC::SoftMaxGradTilingFunc(softmaxComputeShape, sizeof(float), localworkspaceSize, tiling.softmaxTilingData,
                                   false);
}
} // namespace SoftmaxgradCustomTiling

/**
 * @brief 入口函数：计算 Tiling 并保存到缓冲区
 */
void GenerateTiling(const uint32_t rowNum, const uint32_t colNum, const uint32_t coreNum, const uint32_t tilingSize,
                    uint8_t* tilingBuffer)
{
    optiling::SoftmaxgradCustomTilingData tiling;
    SoftmaxgradCustomTiling::ComputeTiling(rowNum, colNum, coreNum, tiling);

    // 将 Tiling 数据序列化到缓冲区
    tiling.SaveToBuffer(tilingBuffer, tilingSize);
}

// ============================================================================
// Kernel 实现（Device 端）
// ============================================================================

namespace MyCustomKernel {
constexpr int32_t BUFFER_NUM = 1; // 队列缓冲区数量（单缓冲模式）

/**
 * @brief Tiling 参数的 Device 端副本结构
 *
 * 用于从 GM 拷贝 Tiling 数据到本地，供核函数访问。
 */
struct VecTiling {
    uint32_t columnLength = 0;
    uint32_t rowLength = 0;
    uint32_t sharedTmpBufferSize = 0;
    uint32_t usedNumBlocks = 0;
    uint32_t coreRowNum = 0;
    uint32_t tailCoreRowNum = 0;
    uint32_t singleLoopCoreRowNum = 0;
    uint32_t singleCoreLoopCount = 0;
    uint32_t singleCoreLoopTail = 0;
    uint32_t tailCoreSingleLoopCoreRowNum = 0;
    uint32_t tailCoreSingleCoreLoopCount = 0;
    uint32_t tailCoreSingleCoreLoopTail = 0;
    SoftMaxTiling softmaxTilingData;
};

/**
 * @brief SoftmaxGrad 核函数实现类
 *
 * 数据流:
 *   CopyIn: 从 GM 搬运 x(grad) 和 y(src) 到 Local Tensor
 *   Compute: 调用 SoftmaxGrad API 计算梯度，结果写入 yLocal（原地复用）
 *   CopyOut: 将结果从 yLocal 搬回 GM 的 z 输出
 */
class KernelSoftmax {
public:
    __aicore__ inline KernelSoftmax() {}

    /**
     * @brief 初始化 Tiling 参数（从 GM 拷贝到本地成员变量）
     */
    __aicore__ inline void InitTiling(const VecTiling& tilingData)
    {
        rowLength = tilingData.rowLength;
        sharedTmpBufferSize = tilingData.sharedTmpBufferSize;
        columnLength = tilingData.columnLength;
        usedNumBlocks = tilingData.usedNumBlocks;
        coreRowNum = tilingData.coreRowNum;
        softmaxTiling = tilingData.softmaxTilingData;
        singleLoopCoreRowNum = tilingData.singleLoopCoreRowNum;
        singleCoreLoopCount = tilingData.singleCoreLoopCount;
        leftRow = tilingData.singleCoreLoopTail;
        tailCoreSingleLoopCoreRowNum = tilingData.tailCoreSingleLoopCoreRowNum;
        tailCoreSingleCoreLoopCount = tilingData.tailCoreSingleCoreLoopCount;
        tailCoreSingleCoreLoopTail = tilingData.tailCoreSingleCoreLoopTail;
    }

    /**
     * @brief 初始化核函数：设置全局缓冲区、本地队列和 Tiling 参数
     *
     * @param x      GM 输入 grad tensor
     * @param y      GM 输入 src tensor
     * @param z      GM 输出 dst tensor
     * @param tiling Tiling 参数
     * @param pipeIn TPipe 指针
     */
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const VecTiling& tiling, AscendC::TPipe* pipeIn)
    {
        ASSERT(AscendC::GetBlockNum() != 0 && "block dim can not be zero!");
        InitTiling(tiling);
        pipe = pipeIn;

        // 尾核（最后一个 Core）使用独立的循环参数处理剩余行
        if (AscendC::GetBlockIdx() == this->usedNumBlocks) {
            this->singleLoopCoreRowNum = this->tailCoreSingleLoopCoreRowNum;
            this->singleCoreLoopCount = this->tailCoreSingleCoreLoopCount;
            this->leftRow = this->tailCoreSingleCoreLoopTail;
        }

        // 计算每个 Core 处理的数据块大小和偏移
        this->blockLength = this->coreRowNum * this->columnLength;
        uint32_t offset1 = this->blockLength * AscendC::GetBlockIdx();

        // 设置全局缓冲区（GM 上的输入输出）
        xGm.SetGlobalBuffer((__gm__ float*)x + offset1, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + offset1, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + offset1, this->blockLength);

        // 计算每次循环处理的数据量并初始化本地队列
        this->tileLength = this->singleLoopCoreRowNum * this->columnLength;
        pipe->InitBuffer(queueX, BUFFER_NUM, this->tileLength * sizeof(float));  // VECIN 队列：存放 grad 输入
        pipe->InitBuffer(queueY, BUFFER_NUM, this->tileLength * sizeof(float));  // VECOUT 队列：存放 src 输入和 dst 输出（原地复用）

        // 初始化共享临时缓冲区（供 SoftmaxGrad API 内部使用）
        pipe->InitBuffer(sharedTmpBuffer, sharedTmpBufferSize);
    }

    /**
     * @brief 主处理流程：分循环处理和尾块处理两阶段
     *
     * 流程:
     *   1. 完整循环：按 tile 大小分批处理
     *   2. MTE3->MTE2 事件同步：确保所有 DataCopy 写 GM 操作完成
     *   3. 尾块处理：处理剩余不足一个 tile 的行
     */
    __aicore__ inline void Process()
    {
        // 超出实际使用范围的 Core 直接返回
        if (AscendC::GetBlockIdx() > usedNumBlocks) {
            return;
        }

        // 主循环：按 tile 大小分批处理，每批 singleLoopCoreRowNum 行
        for (int32_t i = 0; i < this->singleCoreLoopCount; i++) {
            CopyIn(i, this->singleLoopCoreRowNum);
            Compute(i, this->singleLoopCoreRowNum);
            CopyOut(i, this->singleLoopCoreRowNum);
        }

        // 事件同步：确保所有 CopyOut 的 DataCopy 写 GM 操作完成
        event_t eventIdMte3ToMte2 = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE3_MTE2));
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventIdMte3ToMte2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventIdMte3ToMte2);

        // 处理剩余不足一个 tile 的尾行
        if (this->leftRow > 0) {
            CopyIn(this->singleCoreLoopCount, this->leftRow);
            Compute(this->singleCoreLoopCount, this->leftRow);
            CopyOut(this->singleCoreLoopCount, this->leftRow);
        }
    }

private:
    /**
     * @brief 数据搬入：从 GM 搬运 x(grad) 和 y(src) 到 Local Tensor
     *
     * @param progress 当前循环进度（用于计算偏移）
     * @param rowNum   本次搬运的行数
     */
    __aicore__ inline void CopyIn(int32_t progress, uint32_t rowNum)
    {
        AscendC::LocalTensor<float> xLocal = queueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = queueY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], rowNum * this->columnLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], rowNum * this->columnLength);
        queueX.EnQue(xLocal);
        queueY.EnQue(yLocal);
    }

    /**
     * @brief 核心计算：调用 SoftmaxGrad API 完成梯度计算
     *
     * API 调用说明:
     *   SoftmaxGrad<float, true>(dst, grad, src, tmpBuffer, tiling, isFront, shape)
     *   - 模板参数 true 表示 isReuseSource=true，允许原地复用 src 缓冲区
     *   - dst=yLocal: 输出写入 yLocal（与 src 同一缓冲区，原地计算）
     *   - grad=xLocal: 上游梯度输入
     *   - src=yLocal: softmax 前向输出（与 dst 同缓冲区，原地复用）
     *   - isFront=false: 完整 SoftmaxGrad 模式（非 Front 截断模式）
     */
    __aicore__ inline void Compute(int32_t progressm, uint32_t rowNum)
    {
        AscendC::LocalTensor<float> xLocal = queueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = queueY.DeQue<float>();
        AscendC::LocalTensor<uint8_t> tmpBuffer = sharedTmpBuffer.Get<uint8_t>();

        // 构造 SoftMax 形状信息: {srcM, srcK, oriSrcM, oriSrcK}
        AscendC::SoftMaxShapeInfo srcShape = {rowNum, this->columnLength, rowNum, this->columnLength};

        // 调用 SoftmaxGrad 高阶 API 计算梯度
        // 公式: dst = (grad - sum(grad * src)) * src
        AscendC::SoftmaxGrad<float, true>(yLocal, xLocal, yLocal, tmpBuffer, softmaxTiling, false, srcShape);

        // 将计算结果入队（yLocal 已包含输出），释放输入缓冲区 xLocal
        queueY.EnQue(yLocal);
        queueX.FreeTensor(xLocal);
    }

    /**
     * @brief 数据搬出：将计算结果从 Local Tensor 搬回 GM 的输出 z
     *
     * @param progress 当前循环进度（用于计算偏移）
     * @param rowNum   本次搬运的行数
     */
    __aicore__ inline void CopyOut(int32_t progress, uint32_t rowNum)
    {
        // 从 queueY 出队获取计算结果（Compute 中已写入 yLocal）
        AscendC::LocalTensor<float> zLocal = queueY.DeQue<float>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, rowNum * this->columnLength);
        queueY.FreeTensor(zLocal);
    }

private:
    // TPipe 和缓冲区
    AscendC::TPipe* pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sharedTmpBuffer;  // 共享临时缓冲区
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> queueX; // VECIN 队列：grad 输入
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> queueY; // VECOUT 队列：src 输入 / dst 输出（原地复用）

    // 全局 Tensor（GM 上的输入输出）
    AscendC::GlobalTensor<float> xGm; // grad 输入
    AscendC::GlobalTensor<float> yGm; // src 输入
    AscendC::GlobalTensor<float> zGm; // dst 输出

    // Tiling 相关成员变量
    uint32_t blockLength = 0;             // 每个 Core 处理的数据块大小
    uint32_t usedNumBlocks = 0;           // 实际使用的 Core 数量
    uint32_t rowLength = 0;               // 总行数
    uint32_t columnLength = 0;            // 列数
    uint32_t coreRowNum = 0;              // 每个 Core 分配的行数
    uint32_t tileLength = 0;              // 每次循环处理的数据量
    uint32_t msTileLength = 0;            // 保留字段
    uint32_t loopCount = 0;               // 保留字段
    uint32_t sharedTmpBufferSize = 0;     // 共享临时缓冲区大小
    uint32_t singleLoopCoreRowNum = 0;    // 每次循环处理的行数
    uint32_t singleCoreLoopCount = 0;     // 完整循环次数
    uint32_t leftRow = 0;                 // 尾块行数
    uint32_t tailCoreSingleLoopCoreRowNum = 0;    // 尾核每次循环行数
    uint32_t tailCoreSingleCoreLoopCount = 0;     // 尾核循环次数
    uint32_t tailCoreSingleCoreLoopTail = 0;      // 尾核尾块行数
    SoftMaxTiling softmaxTiling;          // SoftMax API 内部 Tiling 参数
};
} // namespace MyCustomKernel

/**
 * @brief 将 Tiling 数据从 GM 拷贝到本地
 */
__aicore__ inline void CopyTiling(MyCustomKernel::VecTiling* tiling, GM_ADDR tilingGM)
{
    uint32_t* ptr = reinterpret_cast<uint32_t*>(tiling);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t*>(tilingGM);

    for (int i = 0; i < sizeof(MyCustomKernel::VecTiling) / sizeof(uint32_t); i++, ptr++) { *ptr = *(tiling32 + i); }
    return;
}

/**
 * @brief 核函数入口：SoftmaxGrad 自定义算子
 *
 * @param x         GM 输入 grad tensor
 * @param y         GM 输入 src tensor
 * @param z         GM 输出 dst tensor
 * @param workspace 工作空间（保留参数）
 * @param tiling    Tiling 参数 GM 地址
 */
extern "C" __global__ __vector__ void softmaxgrad_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR workspace,
                                                         GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    MyCustomKernel::VecTiling tilingData;
    CopyTiling(&tilingData, tiling);
    MyCustomKernel::KernelSoftmax op;
    op.Init(x, y, z, tilingData, &pipe);
    op.Process();
}

// ============================================================================
// Host 端：主函数
// ============================================================================

constexpr uint32_t ROW_NUM = 960;
constexpr uint32_t COLUMN_NUM = 960;
constexpr uint32_t USED_CORE_NUM = 40;
constexpr uint32_t WORKSPACE_SIZE = 1024;
constexpr uint32_t TILINGDATA_SIZE = 28; // SoftmaxgradCustomTilingData 结构的 uint32_t 元素个数
constexpr uint32_t FLOAT_NUM_PER_BLOCK = 8;

/**
 * @brief 对比输出结果与真值数据
 *
 * @param outputData 输出数据指针
 * @param outSize    输出数据大小（字节）
 * @return 错误元素个数，-1 表示读取真值失败
 */
static int64_t CompareResult(void* outputData, const int64_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden success!\n");
    } else {
        aclrtFreeHost(goldenData);
        return -1;
    }
    constexpr float EPS = 1e-5;
    int64_t wrongNum = 0;

    for (int i = 0; i < outSize / sizeof(float); i++) {
        float a = ((float*)outputData)[i];
        float b = ((float*)goldenData)[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    return wrongNum;
}

int32_t main(int32_t argc, char* argv[])
{
    size_t xSize = ROW_NUM * ROW_NUM * sizeof(float);
    size_t workspaceSize = WORKSPACE_SIZE * sizeof(float);
    size_t tilingSize = TILINGDATA_SIZE * sizeof(uint32_t);
    size_t ySize = ROW_NUM * ROW_NUM * sizeof(float);
    size_t zSize = ROW_NUM * ROW_NUM * sizeof(float);
    int64_t wrongNum = -1;

    // 初始化 ACL 资源和设备上下文
    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost, *yHost, *workspaceHost, *tilingHost;
    uint8_t *xDevice, *zDevice, *yDevice, *workspaceDevice, *tilingDevice;

    // 分配 Host 和 Device 内存
    aclrtMallocHost((void**)(&xHost), xSize);
    aclrtMallocHost((void**)(&yHost), ySize);
    aclrtMallocHost((void**)(&zHost), zSize);
    aclrtMallocHost((void**)(&workspaceHost), workspaceSize);
    aclrtMallocHost((void**)(&tilingHost), tilingSize);

    aclrtMalloc((void**)&xDevice, xSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, ySize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, zSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&workspaceDevice, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 读取输入数据
    ReadFile("./input/input_x.bin", xSize, xHost, xSize);
    ReadFile("./input/input_y.bin", ySize, yHost, ySize);
    ReadFile("./input/workspace.bin", workspaceSize, workspaceHost, workspaceSize);

    // 生成 Tiling 参数
    GenerateTiling(ROW_NUM, COLUMN_NUM, USED_CORE_NUM, tilingSize, tilingHost);

    // 拷贝数据到 Device
    aclrtMemcpy(xDevice, xSize, xHost, xSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, ySize, yHost, ySize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(workspaceDevice, workspaceSize, workspaceHost, workspaceSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tilingDevice, tilingSize, tilingHost, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 执行核函数
    softmaxgrad_custom<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, zDevice, workspaceDevice, tilingDevice);

    // 等待核函数执行完成
    aclrtSynchronizeStream(stream);

    // 拷贝结果回 Host 并写入文件
    aclrtMemcpy(zHost, zSize, zDevice, zSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_z.bin", zHost, zSize);

    // 对比结果
    wrongNum = CompareResult(zHost, zSize);

    // 释放资源
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFree(yDevice);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(workspaceHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (wrongNum != 0) {
        printf("test failed!\n");
    } else {
        printf("test pass!\n");
    }
    return 0;
}
