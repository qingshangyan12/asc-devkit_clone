/* !
 * \file swish.asc
 * \brief Swish/Silu/SwiGLU激活函数样例
 *
 * 本样例展示三个API的数学关系：
 * 1. Swish: y = x * sigmoid(beta * x)，beta控制非线性程度
 * 2. Silu:  y = x * sigmoid(x)，即 Swish(beta=1) 的特例
 * 3. SwiGLU: dst = src0 * Swish(src1)，以Swish为门控函数的GLU变体
 *
 * 编译宏控制：
 * - 默认：Swish模式 (beta=1.702，GELU近似)
 * - USE_SILU_MODE：Silu模式 (等价于Swish beta=1)
 * - USE_SWIGLU_MODE：SwiGLU模式 (src0 * Swish(src1))
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "tiling/tiling_api.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// ============================================================================
// Kernel 实现
// ============================================================================

/**
 * @brief Swish/Silu/SwiGLU统一Kernel类
 *
 * 数学关系：
 * - Swish(x, beta) = x * sigmoid(beta * x) = x / (1 + exp(-beta * x))
 * - Silu(x) = Swish(x, beta=1) = x / (1 + exp(-x))
 * - SwiGLU(src0, src1) = src0 ⊗ Swish(src1)
 *
 * 当beta=1时，Swish与Silu完全等价，可互相替换。
 */
template <typename T>
class KernelSwish {
public:
    __aicore__ inline KernelSwish() {}

    __aicore__ inline void Init(GM_ADDR srcGm, GM_ADDR dstGm, uint32_t inputSize, T beta, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        betaValue = beta;
        dataSize = inputSize;
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcGm), dataSize);
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGm), dataSize);
        pipe->InitBuffer(inQueueX, 1, dataSize * sizeof(T));
        pipe->InitBuffer(outQueue, 1, dataSize * sizeof(T));
        isSwiGLU = false;
    }

    __aicore__ inline void InitSwiGLU(GM_ADDR src0Gm, GM_ADDR src1Gm, GM_ADDR dstGm, uint32_t inputSize, T beta,
                                      uint32_t tmpBufSizeIn, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        betaValue = beta;
        dataSize = inputSize;
        src0Global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(src0Gm), dataSize);
        src1Global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(src1Gm), dataSize);
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGm), dataSize);
        pipe->InitBuffer(inQueue0, 1, dataSize * sizeof(T));
        pipe->InitBuffer(inQueue1, 1, dataSize * sizeof(T));
        pipe->InitBuffer(outQueue, 1, dataSize * sizeof(T));
        tmpBufSize = tmpBufSizeIn;
        if (tmpBufSize) {
            pipe->InitBuffer(bufQueue, tmpBufSize);
        }
        isSwiGLU = true;
    }

    __aicore__ inline void Process()
    {
        if (isSwiGLU) {
            CopyInSwiGLU();
            ComputeSwiGLU();
            CopyOutSwiGLU();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }

private:
    // ---- Swish/Silu 单输入路径 ----
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, dataSize);
        inQueueX.EnQue(srcLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> srcLocal = inQueueX.DeQue<T>();

#ifdef USE_SILU_MODE
        // Silu模式：等价于 Swish(beta=1)
        // 以下两种调用结果完全等价：
        //   AscendC::Silu<T, false>(dstLocal, srcLocal, dataSize);
        //   AscendC::Swish(dstLocal, srcLocal, dataSize, 1.0f);
        AscendC::Silu<T, false>(dstLocal, srcLocal, dataSize);
#else
        // Swish模式：beta=1.702（GELU近似值）
        // 当beta=1时，等价于Silu
        AscendC::Swish(dstLocal, srcLocal, dataSize, betaValue);
#endif
        outQueue.EnQue<T>(dstLocal);
        inQueueX.FreeTensor(srcLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
        outQueue.FreeTensor(dstLocal);
    }

    // ---- SwiGLU 双输入路径 ----
    __aicore__ inline void CopyInSwiGLU()
    {
        AscendC::LocalTensor<T> src0Local = inQueue0.AllocTensor<T>();
        AscendC::LocalTensor<T> src1Local = inQueue1.AllocTensor<T>();
        AscendC::DataCopy(src0Local, src0Global, dataSize);
        AscendC::DataCopy(src1Local, src1Global, dataSize);
        inQueue0.EnQue(src0Local);
        inQueue1.EnQue(src1Local);
    }

    __aicore__ inline void ComputeSwiGLU()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> src0Local = inQueue0.DeQue<T>();
        AscendC::LocalTensor<T> src1Local = inQueue1.DeQue<T>();
        AscendC::LocalTensor<uint8_t> tmpLocal;
        if (tmpBufSize > 0) {
            tmpLocal = bufQueue.Get<uint8_t>();
            // SwiGLU内部计算：dst = src0 * Swish(src1, beta)
            AscendC::SwiGLU(dstLocal, src0Local, src1Local, betaValue, tmpLocal);
        } else {
            AscendC::SwiGLU(dstLocal, src0Local, src1Local, betaValue);
        }
        outQueue.EnQue<T>(dstLocal);
        inQueue0.FreeTensor(src0Local);
        inQueue1.FreeTensor(src1Local);
    }

    __aicore__ inline void CopyOutSwiGLU()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe = nullptr;
    // Swish/Silu 单输入队列
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX;
    // SwiGLU 双输入队列
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueue0;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueue1;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufQueue;
    // 输出队列（共用）
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    // Global Tensor（共用dst，按模式使用src或src0/src1）
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> src0Global;
    AscendC::GlobalTensor<T> src1Global;
    AscendC::GlobalTensor<T> dstGlobal;

    uint32_t dataSize = 0;
    T betaValue = 0;
    uint32_t tmpBufSize = 0;
    bool isSwiGLU = false;
};

// ---- Kernel 入口函数 ----
#if defined(USE_SWIGLU_MODE)
__global__ __vector__ void swish_custom(GM_ADDR src0Gm, GM_ADDR src1Gm, GM_ADDR dstGm, uint32_t tmpBufSize)
{
    AscendC::TPipe pipe;
    constexpr uint32_t inputSize = 32;
    // SwiGLU内部使用Swish，beta=1时等价于Silu作为门控函数
    float betaValue = 1;
    KernelSwish<float> op;
    op.InitSwiGLU(src0Gm, src1Gm, dstGm, inputSize, betaValue, tmpBufSize, &pipe);
    op.Process();
}
#else
__global__ __vector__ void swish_custom(GM_ADDR srcGm, GM_ADDR dstGm)
{
    AscendC::TPipe pipe;
    constexpr uint32_t inputSize = 32;
#ifdef USE_SILU_MODE
    // Silu模式：beta=1，Swish的特例
    float betaValue = 1.0f;
#else
    // Swish模式：beta=1.702，GELU近似
    float betaValue = 1.702f;
#endif
    KernelSwish<float> op;
    op.Init(srcGm, dstGm, inputSize, betaValue, &pipe);
    op.Process();
}
#endif

// ============================================================================
// Host 端
// ============================================================================

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("ReadFile golden.bin failed!\n");
        aclrtFreeHost(goldenData);
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;
    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    }
    printf("CompareResult golden.bin success!\n");
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t inputSize = 32;
    uint32_t numBlocks = 1;
    size_t fileSize = inputSize * sizeof(float);
    bool goldenResult = false;

    // 初始化ACL环境
    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

#if defined(USE_SWIGLU_MODE)
    printf("[SwiGLU Mode] dst = src0 * Swish(src1, beta=1)\n");
    printf("  Swish(x, beta=1) = Silu(x) = x / (1 + exp(-x))\n");

    // 获取SwiGLU所需临时空间
    std::vector<int64_t> shapeVec = {inputSize};
    ge::Shape srcShape(shapeVec);
    uint32_t maxValue = 0, minValue = 0;
    AscendC::GetSwiGLUMaxMinTmpSize(srcShape, sizeof(float), maxValue, minValue, false);

    // 分配内存（双输入）
    uint8_t *src0Host, *src0Device, *src1Host, *src1Device, *dstHost, *dstDevice;
    aclrtMallocHost((void**)(&src0Host), fileSize);
    aclrtMalloc((void**)&src0Device, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)(&src1Host), fileSize);
    aclrtMalloc((void**)&src1Device, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)(&dstHost), fileSize);
    aclrtMalloc((void**)&dstDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_src0.bin", fileSize, src0Host, fileSize);
    ReadFile("./input/input_src1.bin", fileSize, src1Host, fileSize);
    aclrtMemcpy(src0Device, fileSize, src0Host, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1Device, fileSize, src1Host, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    swish_custom<<<numBlocks, nullptr, stream>>>(src0Device, src1Device, dstDevice, minValue);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, fileSize, dstDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, fileSize);
    goldenResult = CompareResult(dstHost, fileSize);

    aclrtFree(src0Device); aclrtFreeHost(src0Host);
    aclrtFree(src1Device); aclrtFreeHost(src1Host);
    aclrtFree(dstDevice);  aclrtFreeHost(dstHost);

#elif defined(USE_SILU_MODE)
    printf("[Silu Mode] y = x / (1 + exp(-x))\n");
    printf("  Silu(x) = Swish(x, beta=1)，两者完全等价可替换\n");

    // 获取Silu所需临时空间
    std::vector<int64_t> shapeVec = {inputSize};
    ge::Shape srcShape(shapeVec);
    uint32_t maxValue = 0, minValue = 0;
    AscendC::GetSiluTmpSize(srcShape, sizeof(float), false, maxValue, minValue);

    // 分配内存（单输入）
    uint8_t *srcHost, *srcDevice, *dstHost, *dstDevice;
    aclrtMallocHost((void**)(&srcHost), fileSize);
    aclrtMalloc((void**)&srcDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)(&dstHost), fileSize);
    aclrtMalloc((void**)&dstDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_src.bin", fileSize, srcHost, fileSize);
    aclrtMemcpy(srcDevice, fileSize, srcHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    swish_custom<<<numBlocks, nullptr, stream>>>(srcDevice, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, fileSize, dstDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, fileSize);
    goldenResult = CompareResult(dstHost, fileSize);

    aclrtFree(srcDevice); aclrtFreeHost(srcHost);
    aclrtFree(dstDevice); aclrtFreeHost(dstHost);

#else
    printf("[Swish Mode] y = x / (1 + exp(-1.702 * x))\n");
    printf("  当beta=1时，Swish(x, beta=1) = Silu(x)\n");

    // 获取Swish所需临时空间
    std::vector<int64_t> shapeVec = {inputSize};
    ge::Shape srcShape(shapeVec);
    uint32_t maxValue = 0, minValue = 0;
    AscendC::GetSwishTmpSize(srcShape, sizeof(float), false, maxValue, minValue);

    // 分配内存（单输入）
    uint8_t *srcHost, *srcDevice, *dstHost, *dstDevice;
    aclrtMallocHost((void**)(&srcHost), fileSize);
    aclrtMalloc((void**)&srcDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)(&dstHost), fileSize);
    aclrtMalloc((void**)&dstDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_src.bin", fileSize, srcHost, fileSize);
    aclrtMemcpy(srcDevice, fileSize, srcHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    swish_custom<<<numBlocks, nullptr, stream>>>(srcDevice, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, fileSize, dstDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, fileSize);
    goldenResult = CompareResult(dstHost, fileSize);

    aclrtFree(srcDevice); aclrtFreeHost(srcHost);
    aclrtFree(dstDevice); aclrtFreeHost(dstHost);
#endif

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    return 0;
}
