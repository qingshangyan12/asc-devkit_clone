#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t ROW = 1;
constexpr uint32_t COL = 64;
constexpr uint32_t INPUT_LENGTH = ROW * COL;
constexpr uint32_t OUTPUT_LENGTH = 2 * INPUT_LENGTH;

template <typename T, typename U, typename V>
__simd_vf__ inline void data_reorder_vf(T x_tensor, U y_tensor, V z_tensor)
{
    using data_type = typename T::data_type;
    auto mask = asc::te::all_mask<data_type>();
    auto x_reg = x_tensor.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto y_reg = y_tensor.load(asc::te::make_coord(0, 0)).with_mask(mask);

    if constexpr (scenarioNum == 1) {
        auto result = asc::te::interleave(x_reg, y_reg);
        z_tensor.store(asc::te::make_coord(0, 0), result.first);
        z_tensor.store(asc::te::make_coord(1, 0), result.second);
    } else {
        auto result = asc::te::deinterleave(x_reg, y_reg);
        z_tensor.store(asc::te::make_coord(0, 0), result.first);
        z_tensor.store(asc::te::make_coord(1, 0), result.second);
    }
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Process(__gm__ T* x, __gm__ T* y, __gm__ T* z)
    {
        auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(ROW, COL);
        auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(2 * ROW, COL);
        auto x_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(x), input_layout);
        auto y_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(y), input_layout);
        auto z_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(z), output_layout);

        constexpr uint32_t x_offset = 0;
        constexpr uint32_t y_offset = INPUT_LENGTH * sizeof(T);
        constexpr uint32_t z_offset = 2 * INPUT_LENGTH * sizeof(T);
        auto x_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(x_offset), input_layout);
        auto y_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(y_offset), input_layout);
        auto z_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(z_offset), output_layout);

        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), x_ub, x_gm);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), y_ub, y_gm);
        asc_sync_notify(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);
        asc_sync_wait(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);
        data_reorder_vf(x_ub, y_ub, z_ub);
        asc_sync_notify(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
        asc_sync_wait(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), z_gm, z_ub);
    }
};

template <typename T>
__global__ __vector__ void data_reorder(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    asc_init();
    Kernel<T> kernel;
    kernel.Process(reinterpret_cast<__gm__ T*>(x), reinterpret_cast<__gm__ T*>(y),
        reinterpret_cast<__gm__ T*>(z));
    asc_sync();
}

static bool CheckAcl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::printf("%s failed, error code: %d\n", operation, static_cast<int>(status));
    return false;
}

static bool CompareResult(const float* output, size_t byteSize)
{
    std::vector<float> golden(OUTPUT_LENGTH);
    if (!ReadFile("./output/golden.bin", golden.data(), byteSize)) {
        std::printf("Failed to read output/golden.bin or its size is invalid.\n");
        return false;
    }
    for (uint32_t i = 0; i < OUTPUT_LENGTH; ++i) {
        if (std::abs(output[i] - golden[i]) > 1e-6F) {
            std::printf("Mismatch at %u: output=%f, golden=%f\n", i, output[i], golden[i]);
            return false;
        }
    }
    return true;
}

int32_t main()
{
    constexpr size_t inputBytes = INPUT_LENGTH * sizeof(float);
    constexpr size_t outputBytes = OUTPUT_LENGTH * sizeof(float);
    float *xHost = nullptr, *yHost = nullptr, *zHost = nullptr;
    float *xDevice = nullptr, *yDevice = nullptr, *zDevice = nullptr;
    aclrtStream stream = nullptr;
    bool ok = CheckAcl(aclInit(nullptr), "aclInit") &&
        CheckAcl(aclrtSetDevice(0), "aclrtSetDevice") &&
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") &&
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&xHost), inputBytes), "aclrtMallocHost(x)") &&
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&yHost), inputBytes), "aclrtMallocHost(y)") &&
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&zHost), outputBytes), "aclrtMallocHost(z)") &&
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&xDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(x)") &&
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&yDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(y)") &&
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&zDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(z)");

    ok = ok && ReadFile("./input/input_x.bin", xHost, inputBytes) &&
        ReadFile("./input/input_y.bin", yHost, inputBytes);
    ok = ok && CheckAcl(aclrtMemcpy(xDevice, inputBytes, xHost, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x") &&
        CheckAcl(aclrtMemcpy(yDevice, inputBytes, yHost, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy y");
    if (ok) {
        data_reorder<float><<<1, nullptr, stream>>>(reinterpret_cast<uint8_t*>(xDevice),
            reinterpret_cast<uint8_t*>(yDevice), reinterpret_cast<uint8_t*>(zDevice));
        ok = CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") &&
            CheckAcl(aclrtMemcpy(zHost, outputBytes, zDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy z");
    }
    ok = ok && WriteFile("./output/output.bin", zHost, outputBytes) && CompareResult(zHost, outputBytes);
    std::printf(ok ? "test pass!\n" : "test failed!\n");

    if (xDevice != nullptr) aclrtFree(xDevice);
    if (yDevice != nullptr) aclrtFree(yDevice);
    if (zDevice != nullptr) aclrtFree(zDevice);
    if (xHost != nullptr) aclrtFreeHost(xHost);
    if (yHost != nullptr) aclrtFreeHost(yHost);
    if (zHost != nullptr) aclrtFreeHost(zHost);
    if (stream != nullptr) aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ok ? 0 : 1;
}
