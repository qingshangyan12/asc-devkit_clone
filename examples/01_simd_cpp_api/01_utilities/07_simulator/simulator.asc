/*!
 * \file simulator.asc
 * \brief 基于MatmulLeakyRelu的CAmodel仿真样例。
 */
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <iterator>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

/*
 * matmul_leakyrelu_custom完成矩阵乘和LeakyRelu激活的融合计算。
 *
 * 本样例的SetDim(usedCoreNum = 4)表示tiling侧配置4个Vector核参与Matmul计算发起。
 * __mix__(1, 2)表示核函数按Cube:Vector = 1:2的比例执行，实际启动的Cube/Vector组合数由
 * Host侧kernel launch的numBlocks配置决定。
 *
 * 当前矩阵规格为M=512、N=16、K=256，仅按M轴分核。Cube核负责对应M轴分片上的
 * Matmul主体计算，按照baseM * baseN = 64 * 16的粒度逐块生成A * B中间结果，
 * 并将中间结果输出到VECIN位置。与该Cube核配套的Vector核读取VECIN中的Matmul中间结果，
 * 执行LeakyRelu逐元素激活，再将激活结果搬运回GM中对应的C矩阵输出区域。
 */
template <typename aType, typename bType, typename cType>
__global__ __mix__(1, 2) void matmul_leakyrelu_custom(__gm__ aType* a, __gm__ bType* b, __gm__ cType* c,
    __kfc_workspace__ __gm__ uint8_t* workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<aType> aGlobal;
    AscendC::GlobalTensor<bType> bGlobal;
    AscendC::GlobalTensor<cType> cGlobal;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> reluOutQueue;

    aGlobal.SetGlobalBuffer(a, tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(b, tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(c, tiling.M * tiling.N);

    uint32_t blockIdx = AscendC::GetBlockIdx();
    if ASCEND_IS_AIV {
        blockIdx = blockIdx / 2;
    }
    aGlobal = aGlobal[blockIdx * tiling.singleCoreM * tiling.Ka];
    cGlobal = cGlobal[blockIdx * tiling.singleCoreM * tiling.N];

    pipe.InitBuffer(reluOutQueue, 1, tiling.baseM * tiling.baseN * sizeof(cType));

    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, aType>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, bType>,
        matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, cType>>
        matmulObj;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);

    matmulObj.SetTensorA(aGlobal);
    matmulObj.SetTensorB(bGlobal);
    uint32_t computeRound = 0;
    while (matmulObj.template Iterate<true>()) {
        AscendC::LocalTensor<cType> reluOutLocal = reluOutQueue.AllocTensor<cType>();
        matmulObj.template GetTensorC<true>(reluOutLocal, false, true);
        AscendC::LeakyRelu(reluOutLocal, reluOutLocal, static_cast<cType>(0.001), tiling.baseM * tiling.baseN);
        reluOutQueue.EnQue(reluOutLocal);

        reluOutLocal = reluOutQueue.DeQue<cType>();
        const uint32_t roundM = tiling.singleCoreM / tiling.baseM;
        const uint32_t startOffset = computeRound % roundM * tiling.baseM * tiling.N +
            computeRound / roundM * tiling.baseN;
        AscendC::DataCopy(cGlobal[startOffset], reluOutLocal,
            AscendC::DataCopyParams{static_cast<uint16_t>(tiling.baseM),
                static_cast<uint16_t>(tiling.baseN * sizeof(cType) / AscendC::DEFAULT_C0_SIZE), 0,
                static_cast<uint16_t>((tiling.N - tiling.baseN) * sizeof(cType) / AscendC::DEFAULT_C0_SIZE)});
        reluOutQueue.FreeTensor(reluOutLocal);
        computeRound++;
    }
    matmulObj.End();
}

template <uint32_t M, uint32_t N, uint32_t K, uint32_t baseM, uint32_t baseN, uint32_t baseK, uint32_t usedCoreNum>
AscendC::tiling::TCubeTiling GenerateTiling(platform_ascendc::PlatformAscendC* ascendcPlatform)
{
    using TPosition = matmul_tiling::TPosition;
    using CubeFormat = matmul_tiling::CubeFormat;
    using DataType = matmul_tiling::DataType;

    matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);
    tilingApi.SetDim(usedCoreNum);
    tilingApi.SetAType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT16, false);
    tilingApi.SetBType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT16, false);
    tilingApi.SetCType(TPosition::VECIN, CubeFormat::ND, DataType::DT_FLOAT);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.SetBias(false);
    tilingApi.SetFixSplit(baseM, baseN, baseK);
    tilingApi.SetBufferSpace(-1, -1, -1);

    AscendC::tiling::TCubeTiling tilingData;
    int64_t res = tilingApi.GetTiling(tilingData);
    if (res == -1) {
        std::cout << "gen tiling failed" << std::endl;
    }
    return tilingData;
}

uint32_t VerifyResult(const std::vector<float>& output, float goldenValue)
{
    constexpr size_t maxPrintSize = 20;
    constexpr float tolerance = 1e-3f;
    std::cout << "Output: ";
    std::copy(output.begin(), output.begin() + std::min(output.size(), maxPrintSize),
        std::ostream_iterator<float>(std::cout, " "));
    if (output.size() > maxPrintSize) {
        std::cout << "...";
    }
    std::cout << std::endl;
    std::cout << "Golden: " << goldenValue << " ..." << std::endl;

    bool pass = std::all_of(output.begin(), output.end(), [goldenValue](float value) {
        return std::fabs(value - goldenValue) <= tolerance;
    });
    if (pass) {
        std::cout << "test pass!" << std::endl;
        return 0;
    }
    std::cout << "test failed!" << std::endl;
    return 1;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 512;
    constexpr uint32_t N = 16;
    constexpr uint32_t K = 256;
    constexpr uint32_t baseM = 64;
    constexpr uint32_t baseN = 16;
    constexpr uint32_t baseK = 256;
    constexpr uint32_t usedCoreNum = 4;
    constexpr uint32_t numBlocks = 4;
    constexpr float negativeSlope = 0.001f;
    constexpr float goldenValue = -static_cast<float>(K) * negativeSlope;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    size_t aByteSize = M * K * sizeof(half);
    size_t bByteSize = K * N * sizeof(half);
    size_t cByteSize = M * N * sizeof(float);
    size_t workspaceSize = static_cast<size_t>(ascendcPlatform->GetLibApiWorkSpaceSize());
    auto tiling = GenerateTiling<M, N, K, baseM, baseN, baseK, usedCoreNum>(ascendcPlatform);

    std::vector<half> inputA(M * K, static_cast<half>(1.0f));
    std::vector<half> inputB(K * N, static_cast<half>(-1.0f));
    std::vector<float> outputC(M * N);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* inputADevice = nullptr;
    half* inputBDevice = nullptr;
    float* outputCDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;
    aclrtMalloc((void**)&inputADevice, aByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&inputBDevice, bByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputCDevice, cByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&workspaceDevice, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(inputADevice, aByteSize, inputA.data(), aByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(inputBDevice, bByteSize, inputB.data(), bByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    matmul_leakyrelu_custom<half, half, float><<<numBlocks, nullptr, stream>>>(
        inputADevice, inputBDevice, outputCDevice, workspaceDevice, tiling);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputC.data(), cByteSize, outputCDevice, cByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(inputADevice);
    aclrtFree(inputBDevice);
    aclrtFree(outputCDevice);
    aclrtFree(workspaceDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return VerifyResult(outputC, goldenValue);
}
