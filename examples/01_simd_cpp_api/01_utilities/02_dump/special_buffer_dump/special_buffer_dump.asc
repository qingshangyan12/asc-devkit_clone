/*!
 * \file special_buffer_dump.asc
 * \brief 展示dav-3510上L1、Bias Table Buffer和Fixpipe Buffer的DumpTensor打印能力
 */

#include <cstdint>
#include <iomanip>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t BIAS_ELEMENT_COUNT = 32;
constexpr uint32_t BIAS_DATA_BYTES = BIAS_ELEMENT_COUNT * sizeof(int32_t);
constexpr uint32_t FIXPIPE_ELEMENT_COUNT = 16;
constexpr uint32_t FIXPIPE_DATA_BYTES = FIXPIPE_ELEMENT_COUNT * sizeof(uint64_t);
constexpr uint32_t DATA_BLOCK_BYTES = 32;
constexpr uint64_t FIXPIPE_QUANT_VISIBLE_MASK = 0x00007fe0ffffe0ffULL;
} // namespace

class KernelSpecialBufferDump {
public:
    __aicore__ inline void Init(GM_ADDR biasInput, GM_ADDR fixpipeInput)
    {
        biasGm.SetGlobalBuffer((__gm__ int32_t*)biasInput, BIAS_ELEMENT_COUNT);
        fixpipeGm.SetGlobalBuffer((__gm__ uint64_t*)fixpipeInput, FIXPIPE_ELEMENT_COUNT);
    }

    __aicore__ inline void Process()
    {
        DumpBiasBuffer();
        DumpFixpipeBuffer();
    }

private:
    __aicore__ inline void DumpBiasBuffer()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Allocator;
        AscendC::LocalTensor<int32_t> biasL1 = l1Allocator.Alloc<int32_t>(BIAS_ELEMENT_COUNT);
        AscendC::DataCopy(biasL1, biasGm, AscendC::DataCopyParams{1, BIAS_DATA_BYTES / DATA_BLOCK_BYTES, 0, 0});
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::printf("========== Bias source in L1 Buffer ==========\n");
        AscendC::DumpTensor(biasL1, 101, BIAS_ELEMENT_COUNT);

        AscendC::LocalMemAllocator<AscendC::Hardware::BIAS> biasAllocator;
        AscendC::LocalTensor<int32_t> biasLocal = biasAllocator.Alloc<int32_t>(BIAS_ELEMENT_COUNT);
        AscendC::DataCopy(biasLocal, biasL1, AscendC::DataCopyParams{1, BIAS_DATA_BYTES / DATA_BLOCK_BYTES, 0, 0});
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::printf("========== Data in Bias Table Buffer ==========\n");
        AscendC::DumpTensor(biasLocal, 201, BIAS_ELEMENT_COUNT);
    }

    __aicore__ inline void DumpFixpipeBuffer()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Allocator;
        AscendC::LocalTensor<uint64_t> fixpipeL1 = l1Allocator.Alloc<uint64_t>(FIXPIPE_ELEMENT_COUNT);
        AscendC::DataCopy(
            fixpipeL1, fixpipeGm, AscendC::DataCopyParams{1, FIXPIPE_DATA_BYTES / DATA_BLOCK_BYTES, 0, 0});
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::printf("========== Quant parameters in L1 Buffer ==========\n");
        AscendC::DumpTensor(fixpipeL1, 102, FIXPIPE_ELEMENT_COUNT);

        AscendC::LocalMemAllocator<AscendC::Hardware::FIXBUF> fixpipeAllocator;
        AscendC::LocalTensor<uint64_t> fixpipeLocal = fixpipeAllocator.Alloc<uint64_t>(FIXPIPE_ELEMENT_COUNT);
        AscendC::DataCopy(fixpipeLocal, fixpipeL1, AscendC::DataCopyParams{1, FIXPIPE_DATA_BYTES / 128, 0, 0});
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::printf("========== Quant parameters in Fixpipe Buffer ==========\n");
        AscendC::DumpTensor(fixpipeLocal, 301, FIXPIPE_ELEMENT_COUNT);
    }

private:
    AscendC::GlobalTensor<int32_t> biasGm;
    AscendC::GlobalTensor<uint64_t> fixpipeGm;
};

__global__ __cube__ void SpecialBufferDumpKernel(GM_ADDR biasInput, GM_ADDR fixpipeInput)
{
    AscendC::InitSocState();
    KernelSpecialBufferDump op;
    op.Init(biasInput, fixpipeInput);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static void FillBiasInput(std::vector<int32_t>& input)
{
    for (uint32_t i = 0; i < BIAS_ELEMENT_COUNT; ++i) {
        input[i] = (i % 2 == 0) ? static_cast<int32_t>(1000 + i) : -static_cast<int32_t>(1000 + i);
    }
}

static void FillFixpipeInput(std::vector<uint64_t>& input)
{
    const uint64_t cases[FIXPIPE_ELEMENT_COUNT] = {
        0x0000000000000000ULL, 0x00000000000000ffULL, 0x0000000000000100ULL, 0x0000000000001f00ULL,
        0x0000000000002000ULL, 0x00000000ffffe000ULL, 0x0000000100000000ULL, 0x0000001f00000000ULL,
        0x0000002000000000ULL, 0x00007fe000000000ULL, 0x0000800000000000ULL, 0x7fff800000000000ULL,
        0x00000000000dbba0ULL, 0x00000000000dbbb0ULL, 0x00007fe1ffffe1ffULL, 0x0123456789abcdefULL,
    };
    for (uint32_t i = 0; i < FIXPIPE_ELEMENT_COUNT; ++i) {
        input[i] = cases[i];
    }
}

static void PrintExpectedData(const std::vector<int32_t>& biasInput, const std::vector<uint64_t>& fixpipeInput)
{
    for (uint32_t i = 0; i < BIAS_ELEMENT_COUNT; ++i) {
        std::cout << "BIAS_CASE[" << std::setw(2) << i << "] input=" << biasInput[i] << std::endl;
    }
    for (uint32_t i = 0; i < FIXPIPE_ELEMENT_COUNT; ++i) {
        std::cout << "FIXPIPE_CASE[" << std::setw(2) << i << "] input=0x" << std::hex << std::setw(16)
                  << std::setfill('0') << fixpipeInput[i] << " expected=0x" << std::setw(16)
                  << (fixpipeInput[i] & FIXPIPE_QUANT_VISIBLE_MASK) << std::dec << std::setfill(' ') << std::endl;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<int32_t> biasInput(BIAS_ELEMENT_COUNT);
    std::vector<uint64_t> fixpipeInput(FIXPIPE_ELEMENT_COUNT);
    FillBiasInput(biasInput);
    FillFixpipeInput(fixpipeInput);
    PrintExpectedData(biasInput, fixpipeInput);

    aclrtStream stream = nullptr;
    uint8_t* biasDevice = nullptr;
    uint8_t* fixpipeDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int32_t result = 1;

    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed: " << ret << std::endl;
        goto cleanup;
    }
    aclInitialized = true;

    ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed: " << ret << std::endl;
        goto cleanup;
    }
    deviceSet = true;

    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtCreateStream failed: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMalloc((void**)&biasDevice, BIAS_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc bias input failed: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMalloc((void**)&fixpipeDevice, FIXPIPE_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc fixpipe input failed: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMemcpy(biasDevice, BIAS_DATA_BYTES, biasInput.data(), BIAS_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy bias input failed: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMemcpy(
        fixpipeDevice, FIXPIPE_DATA_BYTES, fixpipeInput.data(), FIXPIPE_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy fixpipe input failed: " << ret << std::endl;
        goto cleanup;
    }

    SpecialBufferDumpKernel<<<1, 0, stream>>>(biasDevice, fixpipeDevice);
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStream failed: " << ret << std::endl;
        goto cleanup;
    }
    result = 0;

cleanup:
    if (fixpipeDevice != nullptr) {
        aclrtFree(fixpipeDevice);
    }
    if (biasDevice != nullptr) {
        aclrtFree(biasDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        aclrtResetDevice(0);
    }
    if (aclInitialized) {
        aclFinalize();
    }
    return result;
}
