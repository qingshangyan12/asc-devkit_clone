/*!
 * \file l0ab_buffer_dump.asc
 * \brief 以 dav-9201（A6）half 矩阵乘为背景，通过 DumpTensor 打印 L0A、L0B Buffer 中的数据，
 *        并对照打印 L1 Buffer 中的搬入数据。L0A/L0B 的 dump 经芯片 DebugBus 通路读取。
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t MATMUL_M = 16;
constexpr uint32_t MATMUL_N = 16;
constexpr uint32_t MATMUL_K = 32;
constexpr uint32_t A_ELEMENT_COUNT = MATMUL_M * MATMUL_K;      // 512
constexpr uint32_t B_ELEMENT_COUNT = MATMUL_K * MATMUL_N;      // 512
constexpr uint32_t OUTPUT_ELEMENT_COUNT = MATMUL_M * MATMUL_N; // 256
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t DATA_BLOCK_BYTES = 32;

constexpr uint32_t A_DATA_BYTES = A_ELEMENT_COUNT * sizeof(half);
constexpr uint32_t B_DATA_BYTES = B_ELEMENT_COUNT * sizeof(half);
constexpr uint32_t OUTPUT_DATA_BYTES = OUTPUT_ELEMENT_COUNT * sizeof(float);

// L1 布局：A1 在前，B1 紧随其后；均 32B 对齐。
constexpr uint64_t A_L1_ADDR = 0;
constexpr uint64_t B_L1_ADDR = A_L1_ADDR + A_DATA_BYTES;
// L0A、L0B 为独立 Buffer，各自从地址 0 起始（512B 对齐，满足 LoadData 目的地址约束）。
constexpr uint64_t A_L0_ADDR = 0;
constexpr uint64_t B_L0_ADDR = 0;
} // namespace

class KernelL0abBufferDump {
public:
    __aicore__ inline void Init(GM_ADDR aInput, GM_ADDR bInput, GM_ADDR output)
    {
        aGm.SetGlobalBuffer((__gm__ half*)aInput, A_ELEMENT_COUNT);
        bGm.SetGlobalBuffer((__gm__ half*)bInput, B_ELEMENT_COUNT);
        outputGm.SetGlobalBuffer((__gm__ float*)output, OUTPUT_ELEMENT_COUNT);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> aL1(AscendC::TPosition::A1, A_L1_ADDR, A_ELEMENT_COUNT);
        AscendC::LocalTensor<half> bL1(AscendC::TPosition::B1, B_L1_ADDR, B_ELEMENT_COUNT);

        CopyInputsToL1(aL1, bL1);
        DumpL1Inputs(aL1, bL1);

        AscendC::LocalTensor<half> aL0(AscendC::TPosition::A2, A_L0_ADDR, A_ELEMENT_COUNT);
        AscendC::LocalTensor<half> bL0(AscendC::TPosition::B2, B_L0_ADDR, B_ELEMENT_COUNT);

        CopyL1ToL0(aL0, aL1, bL0, bL1);
        AscendC::PipeBarrier<PIPE_ALL>();
        DumpL0Inputs(aL0, bL0);

        AscendC::LocalTensor<float> cL0(AscendC::TPosition::CO1, 0, OUTPUT_ELEMENT_COUNT);
        Compute(cL0, aL0, bL0);
        CopyOutput(cL0);
    }

private:
    __aicore__ inline void CopyInputsToL1(const AscendC::LocalTensor<half>& aL1, const AscendC::LocalTensor<half>& bL1)
    {
        // GM -> L1（随路 ND2NZ）：A 视为 [M, K]，B 视为 [K, N]。
        AscendC::Nd2NzParams aParams{1, MATMUL_M, MATMUL_K, 0, MATMUL_K, MATMUL_M, 1, 0};
        AscendC::Nd2NzParams bParams{1, MATMUL_K, MATMUL_N, 0, MATMUL_N, MATMUL_K, 1, 0};
        AscendC::DataCopy(aL1, aGm, aParams);
        AscendC::DataCopy(bL1, bGm, bParams);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void DumpL1Inputs(const AscendC::LocalTensor<half>& aL1, const AscendC::LocalTensor<half>& bL1)
    {
        AscendC::printf("========== Matrix A in L1 Buffer ==========\n");
        AscendC::DumpTensor(aL1, 100, A_ELEMENT_COUNT);
        AscendC::printf("========== Matrix B in L1 Buffer ==========\n");
        AscendC::DumpTensor(bL1, 101, B_ELEMENT_COUNT);
    }

    __aicore__ inline void CopyL1ToL0(
        const AscendC::LocalTensor<half>& aL0, const AscendC::LocalTensor<half>& aL1,
        const AscendC::LocalTensor<half>& bL0, const AscendC::LocalTensor<half>& bL1)
    {
        // L1 -> L0A（NZ -> NZ，不转置）：mStep=1 个 M 分形，kStep=2 个 K 分形（每个 32B=16 个 half）。
        AscendC::LoadData2DParamsV2 aParams;
        aParams.mStep = MATMUL_M / CUBE_BLOCK;
        aParams.kStep = MATMUL_K * sizeof(half) / DATA_BLOCK_BYTES;
        aParams.srcStride = MATMUL_M / CUBE_BLOCK;
        aParams.dstStride = MATMUL_M / CUBE_BLOCK;
        aParams.ifTranspose = false;
        AscendC::LoadData(aL0, aL1, aParams);

        // L1 -> L0B（NZ -> ZN，每个分形转置）：B1 视为 [K, N]，按 K 方向 2 个分形搬入并转置。
        AscendC::LoadData2DParamsV2 bParams;
        bParams.mStep = MATMUL_K / CUBE_BLOCK;
        bParams.kStep = MATMUL_N * sizeof(half) / DATA_BLOCK_BYTES;
        bParams.srcStride = MATMUL_K / CUBE_BLOCK;
        bParams.dstStride = MATMUL_N * sizeof(half) / DATA_BLOCK_BYTES;
        bParams.ifTranspose = true;
        AscendC::LoadData(bL0, bL1, bParams);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
    }

    __aicore__ inline void DumpL0Inputs(const AscendC::LocalTensor<half>& aL0, const AscendC::LocalTensor<half>& bL0)
    {
        AscendC::printf("========== Matrix A in L0A Buffer ==========\n");
        AscendC::DumpTensor(aL0, 200, A_ELEMENT_COUNT);
        AscendC::printf("========== Matrix B in L0B Buffer ==========\n");
        AscendC::DumpTensor(bL0, 201, B_ELEMENT_COUNT);
    }

    __aicore__ inline void Compute(
        const AscendC::LocalTensor<float>& cL0, const AscendC::LocalTensor<half>& aL0,
        const AscendC::LocalTensor<half>& bL0)
    {
        AscendC::MmadParams params;
        params.m = MATMUL_M;
        params.n = MATMUL_N;
        params.k = MATMUL_K;
        params.cmatrixInitVal = true;
        AscendC::Mmad<float, half, half, float>(cL0, aL0, bL0, params);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID2);
    }

    __aicore__ inline void CopyOutput(const AscendC::LocalTensor<float>& cL0)
    {
        // L0C -> GM，float -> float（NoQuant），ROW_MAJOR 排布。
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> params(MATMUL_N, MATMUL_M, MATMUL_M, MATMUL_N);
        AscendC::Fixpipe<float, float, AscendC::CFG_ROW_MAJOR>(outputGm, cL0, params);
    }

private:
    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<float> outputGm;
};

__global__ __cube__ void L0abBufferDump(GM_ADDR aInput, GM_ADDR bInput, GM_ADDR output)
{
    AscendC::InitSocState();
    KernelL0abBufferDump op;
    op.Init(aInput, bInput, output);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<uint16_t> aInput(A_ELEMENT_COUNT);
    std::vector<uint16_t> bInput(B_ELEMENT_COUNT);
    std::vector<float> output(OUTPUT_ELEMENT_COUNT);
    size_t aFileSize = A_DATA_BYTES;
    size_t bFileSize = B_DATA_BYTES;
    if (!ReadFile("./input/a_gm.bin", aFileSize, aInput.data(), A_DATA_BYTES) || aFileSize != A_DATA_BYTES ||
        !ReadFile("./input/b_gm.bin", bFileSize, bInput.data(), B_DATA_BYTES) || bFileSize != B_DATA_BYTES) {
        std::cerr << "Read input failed" << std::endl;
        return 1;
    }

    uint8_t* aDevice = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    int32_t deviceId = 0;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtMalloc((void**)&aDevice, A_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bDevice, B_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputDevice, OUTPUT_DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(aDevice, A_DATA_BYTES, aInput.data(), A_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, B_DATA_BYTES, bInput.data(), B_DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    L0abBufferDump<<<1, 0, stream>>>(aDevice, bDevice, outputDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output.data(), OUTPUT_DATA_BYTES, outputDevice, OUTPUT_DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    bool writeSuccess = WriteFile("./output/output.bin", output.data(), OUTPUT_DATA_BYTES);

    aclrtFree(outputDevice);
    aclrtFree(bDevice);
    aclrtFree(aDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return writeSuccess ? 0 : 1;
}
