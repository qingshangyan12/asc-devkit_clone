+
+# 本地编译适配：OPS_BUILD_FILTER 环境变量可指定只构建部分算子（逗号分隔目录名）
+macro(recursive_add_subdirectory_filtered)
+    file(GLOB CURRENT_DIRS RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/*)
+    foreach(SUB_DIR ${CURRENT_DIRS})
+        if(DEFINED ENV{OPS_BUILD_FILTER})
+            string(FIND ",$ENV{OPS_BUILD_FILTER}," ",${SUB_DIR}," _FOUND)
+            if(_FOUND EQUAL -1)
+                continue()
+            endif()
+        endif()
+        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${SUB_DIR}/${NPU_SOC_VERSION}/CMakeLists.txt")
+            add_subdirectory(${SUB_DIR}/${NPU_SOC_VERSION})
+        endif()
+    endforeach()
+endmacro()
+recursive_add_subdirectory_filtered()
