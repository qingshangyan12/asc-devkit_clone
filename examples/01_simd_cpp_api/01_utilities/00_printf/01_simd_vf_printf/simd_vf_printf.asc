/* !
 * \file simd_vf_printf.asc
 * \brief 使用vector编程模式，展示simd_vf printf接口的基本使用方法
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include <vector>
#include <iostream>

namespace {
    constexpr uint32_t DATA_LEN = 32;
}

// simd_vf printf演示: int, uint, float, string格式打印
__simd_vf__ inline void SimdVfPrintFormat()
{
    __ubuf__ const char* fmt = "[simd_vf] int=%d, uint=%u, float=%f, string=%s\n";
    printf(fmt, 10, 20U, 3.14f, "hello");
}

// simd_vf printf演示: 十六进制和指针格式打印
__simd_vf__ inline void SimdVfPrintHexPtr()
{
    __ubuf__ const char* fmt = "[simd_vf] hex=%x, ptr=%p\n";
    printf(fmt, 255, fmt);
}

// simd_vf printf演示: 纯字符串打印
__simd_vf__ inline void SimdVfPrintStr()
{
    __ubuf__ const char* fmt = "[simd_vf] This is a simd_vf printf demo string.\n";
    printf(fmt);
}

// simd_vf dump演示: 使用asc_dump_ubuf打印UB数据
__simd_vf__ inline void SimdVfDumpData(__ubuf__ float* x)
{
    __ubuf__ const float* fmt = (__ubuf__ const float*)"[simd_vf] dump ubuf (5 elem x 32):\n";
    __asc_simd_vf::asc_dump_ubuf<float>(x, 5, 32);
    asc_dump<float>(x, 5, 16);
}

__global__ __vector__ void simd_vf_printf_kernel(__gm__ uint8_t* x)
{
    uint32_t xLength = DATA_LEN;

    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> gmInput;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    gmInput.SetGlobalBuffer((__gm__ float*)x, xLength * sizeof(float));
    pipe.InitBuffer(inQueueX, 1, xLength * sizeof(float));

    AscendC::LocalTensor<float> ubInput = inQueueX.AllocTensor<float>();
    AscendC::DataCopy(ubInput, gmInput, xLength);

    // 1. aicore侧printf
    AscendC::printf("[aicore] simd_vf printf demo start ...\n");
    AscendC::printf("[aicore] blockIdx=%u\n", AscendC::GetBlockIdx());

    // 2. 调用simd_vf printf接口：打印int/uint/float/string格式
    asc_vf_call<SimdVfPrintFormat>();

    // 3. 调用simd_vf printf接口：打印hex/ptr格式
    asc_vf_call<SimdVfPrintHexPtr>();

    // 4. 调用simd_vf printf接口：纯字符串打印
    asc_vf_call<SimdVfPrintStr>();

    // 5. 调用simd_vf dump接口：打印UB数据
    asc_vf_call<SimdVfDumpData>((__ubuf__ float *)ubInput.GetPhyAddr());

    AscendC::printf("[aicore] simd_vf printf demo end ...\n");
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr uint32_t x_total_length = DATA_LEN;
    std::vector<float> x(x_total_length, 1.0f);
    for (uint32_t i = 0; i < x_total_length; i++) {
        x[i] = static_cast<float>(i) + 0.1f;
    }
    uint32_t x_total_byte_size = x_total_length * sizeof(float);

    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* x_device = nullptr;

    aclrtMalloc((void**)&x_device, x_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(x_device, x_total_byte_size, x_host, x_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t numBlocks = 1;
    simd_vf_printf_kernel<<<numBlocks, nullptr, stream>>>(x_device);
    aclrtSynchronizeStream(stream);

    aclrtFree(x_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
