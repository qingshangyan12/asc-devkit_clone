/*!
 * \file simd_vf_fifo_stress.asc
 * \brief Stress-tests mixed AICore and SIMD VF printf traffic with automatic log verification.
 */

#include "acl/acl.h"
#include "utils/debug/asc_printf.h"
#include "kernel_operator.h"

#include <cstdio>

namespace {
constexpr uint32_t KERNEL_ROUNDS = 5U;
constexpr uint32_t SINGLE_VF_RECORDS = 8192U;
constexpr uint32_t MULTI_VF_RECORDS = 2048U;
constexpr uint32_t AICORE_RECORDS = 24U;
constexpr uint32_t MIN_RECORD_BYTES = 112U;
constexpr uint32_t RECORDS_PER_ROUND = SINGLE_VF_RECORDS + 4U * MULTI_VF_RECORDS + AICORE_RECORDS;
static_assert(SINGLE_VF_RECORDS * MIN_RECORD_BYTES > 512U * 1024U);
static_assert(RECORDS_PER_ROUND * MIN_RECORD_BYTES > 1024U * 1024U);
} // namespace

__simd_vf__ inline void SimdVfSingleBurst(uint32_t round, uint32_t recordCount)
{
    __ubuf__ const char* fmt =
        "[FIFO_TEST][VF_SINGLE] round=%u record=%u signed=%d hex=%x "
        "payload=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-single-burst\n";
    for (uint32_t record = 0U; record < recordCount; ++record) {
        printf(fmt, round, record, static_cast<int32_t>(record) - 4096, round * 0x10000U + record + 0x100U);
    }
}

__simd_vf__ inline void SimdVfPhaseA(uint32_t round, uint32_t phase, uint32_t recordCount)
{
    __ubuf__ const char* fmt =
        "[FIFO_TEST][VF_A] round=%u phase=%u record=%u value=%u "
        "payload=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n";
    for (uint32_t record = 0U; record < recordCount; ++record) {
        printf(fmt, round, phase, record, round * 1000000U + phase * 10000U + record);
    }
}

__simd_vf__ inline void SimdVfPhaseB(uint32_t round, uint32_t recordCount)
{
    __ubuf__ const char* fmt =
        "[FIFO_TEST][VF_B] round=%u record=%u signed=%d hex=%x "
        "payload=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\n";
    for (uint32_t record = 0U; record < recordCount; ++record) {
        printf(fmt, round, record, static_cast<int32_t>(record) - 1024,
            round * 0x10000U + record + 0xB00U);
    }
}

__simd_vf__ inline void SimdVfPhaseC(uint32_t round, uint32_t recordCount)
{
    __ubuf__ const char* fmt =
        "[FIFO_TEST][VF_C] round=%u record=%u float=%f "
        "payload=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC\n";
    for (uint32_t record = 0U; record < recordCount; ++record) {
        printf(fmt, round, record, 3.25f);
    }
}

template <uint32_t Record>
__aicore__ inline void PrintAicoreBulkRecord(uint32_t round)
{
    AscendC::printf(
        "[FIFO_TEST][AICORE_BULK] round=%u record=%u signed=%d hex=%x "
        "payload=DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD\n",
        round, Record, static_cast<int32_t>(Record) - 12, round * 0x10000U + Record + 0xA00U);
}

extern "C" __global__ __vector__ void simd_vf_fifo_stress_kernel(uint32_t round)
{
    AscendC::InitSocState();

    AscendC::printf("[FIFO_TEST][AICORE_NS] round=%u stage=start single=%u multi=%u float=%f\n", round,
        SINGLE_VF_RECORDS, MULTI_VF_RECORDS, 1.5f);
    asc_vf_call<SimdVfSingleBurst>(round, SINGLE_VF_RECORDS);
    printf("[FIFO_TEST][AICORE_GLOBAL] round=%u stage=after_single\n", round);

    PrintAicoreBulkRecord<0U>(round);
    PrintAicoreBulkRecord<1U>(round);
    PrintAicoreBulkRecord<2U>(round);
    PrintAicoreBulkRecord<3U>(round);
    PrintAicoreBulkRecord<4U>(round);
    PrintAicoreBulkRecord<5U>(round);
    PrintAicoreBulkRecord<6U>(round);
    PrintAicoreBulkRecord<7U>(round);
    PrintAicoreBulkRecord<8U>(round);
    PrintAicoreBulkRecord<9U>(round);
    PrintAicoreBulkRecord<10U>(round);
    PrintAicoreBulkRecord<11U>(round);
    PrintAicoreBulkRecord<12U>(round);
    PrintAicoreBulkRecord<13U>(round);
    PrintAicoreBulkRecord<14U>(round);
    PrintAicoreBulkRecord<15U>(round);
    PrintAicoreBulkRecord<16U>(round);
    PrintAicoreBulkRecord<17U>(round);
    PrintAicoreBulkRecord<18U>(round);
    PrintAicoreBulkRecord<19U>(round);
    PrintAicoreBulkRecord<20U>(round);
    PrintAicoreBulkRecord<21U>(round);
    PrintAicoreBulkRecord<22U>(round);
    PrintAicoreBulkRecord<23U>(round);

    asc_vf_call<SimdVfPhaseA>(round, 1U, MULTI_VF_RECORDS);
    AscendC::printf("[FIFO_TEST][AICORE_NS] round=%u stage=between_a_b\n", round);
    asc_vf_call<SimdVfPhaseB>(round, MULTI_VF_RECORDS);
    printf("[FIFO_TEST][AICORE_GLOBAL] round=%u stage=between_b_c\n", round);
    asc_vf_call<SimdVfPhaseC>(round, MULTI_VF_RECORDS);
    AscendC::printf("[FIFO_TEST][AICORE_NS] round=%u stage=before_repeat_a\n", round);
    asc_vf_call<SimdVfPhaseA>(round, 4U, MULTI_VF_RECORDS);
    AscendC::printf("[FIFO_TEST][AICORE_NS] round=%u stage=end\n", round);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclError setDeviceRet = ACL_ERROR_FAILURE;
    aclError createStreamRet = ACL_ERROR_FAILURE;
    aclError launchRet = ACL_ERROR_FAILURE;
    aclError syncRet = ACL_ERROR_FAILURE;

    const char* aclConfig = argc > 1 ? argv[1] : nullptr;
    aclError initRet = aclInit(aclConfig);
    if (initRet == ACL_SUCCESS) {
        setDeviceRet = aclrtSetDevice(deviceId);
    }
    if (setDeviceRet == ACL_SUCCESS) {
        createStreamRet = aclrtCreateStream(&stream);
    }
    uint32_t completedRounds = 0U;
    if (createStreamRet == ACL_SUCCESS) {
        for (uint32_t round = 0U; round < KERNEL_ROUNDS; ++round) {
            simd_vf_fifo_stress_kernel<<<1, 0, stream>>>(round);
            launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
            syncRet = launchRet == ACL_SUCCESS ? aclrtSynchronizeStream(stream) : ACL_ERROR_FAILURE;
            bool roundPassed = launchRet == ACL_SUCCESS && syncRet == ACL_SUCCESS;
            std::fprintf(stderr, "[FIFO_TEST][HOST_ROUND] round=%u launch=%d sync=%d result=%s\n", round,
                launchRet, syncRet, roundPassed ? "PASS" : "FAIL");
            if (!roundPassed) {
                break;
            }
            completedRounds++;
        }
    }

    aclError destroyStreamRet = stream == nullptr ? ACL_SUCCESS : aclrtDestroyStream(stream);
    aclError resetDeviceRet = setDeviceRet == ACL_SUCCESS ? aclrtResetDevice(deviceId) : ACL_SUCCESS;
    aclError finalizeRet = initRet == ACL_SUCCESS ? aclFinalize() : ACL_SUCCESS;
    bool passed = initRet == ACL_SUCCESS && setDeviceRet == ACL_SUCCESS && createStreamRet == ACL_SUCCESS &&
        completedRounds == KERNEL_ROUNDS && launchRet == ACL_SUCCESS && syncRet == ACL_SUCCESS &&
        destroyStreamRet == ACL_SUCCESS &&
        resetDeviceRet == ACL_SUCCESS && finalizeRet == ACL_SUCCESS;

    std::fprintf(stderr,
        "[FIFO_TEST][HOST] rounds=%u completed=%u init=%d set_device=%d create_stream=%d launch=%d sync=%d "
        "destroy_stream=%d reset_device=%d finalize=%d result=%s\n",
        KERNEL_ROUNDS, completedRounds, initRet, setDeviceRet, createStreamRet, launchRet, syncRet, destroyStreamRet,
        resetDeviceRet, finalizeRet, passed ? "PASS" : "FAIL");
    return passed ? 0 : 1;
}
