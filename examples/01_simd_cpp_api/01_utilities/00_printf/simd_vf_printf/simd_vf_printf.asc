/*!
 * \file simd_vf_printf.asc
 * \brief 使用vector编程模式，展示simd_vf printf接口的FIFO传输能力
 */

#include "acl/acl.h"
#include "utils/debug/asc_printf.h"
#include "kernel_operator.h"

constexpr uint32_t PRINT_RECORD_COUNT = 32;
constexpr uint32_t MIN_BYTES_PER_RECORD = 96;
static_assert(PRINT_RECORD_COUNT * MIN_BYTES_PER_RECORD > 2 * 1024);

// 单次asc_vf_call内打印至少3KB文本，跨越2KB预留UB边界，验证FIFO可持续传输。
__simd_vf__ inline void SimdVfPrintFifoData(uint32_t recordCount)
{
    __ubuf__ const char* fmt =
        "[simd_vf][fifo] record=%u payload=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\n";
    for (uint32_t record = 0; record < recordCount; ++record) {
        printf(fmt, record);
    }
}

extern "C" __global__ __vector__ void simd_vf_printf_kernel()
{
    AscendC::InitSocState();

    AscendC::printf("[aicore] simd_vf fifo printf demo start ...\n");
    asc_vf_call<SimdVfPrintFifoData>(PRINT_RECORD_COUNT);
    AscendC::printf("[aicore] simd_vf fifo printf demo end ...\n");
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    simd_vf_printf_kernel<<<1, 0, stream>>>();

    aclrtSynchronizeStream(stream);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
