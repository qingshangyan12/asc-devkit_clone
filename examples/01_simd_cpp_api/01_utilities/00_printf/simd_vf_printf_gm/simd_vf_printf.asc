#include "acl/acl.h"
#include <cstdio>
#include <string>
#include "utils/debug/asc_printf.h"
// Host/precompile parsing also needs the handle type.
#include "utils/debug/asc_gm_debug_string.h"
#include "kernel_operator.h"

__simd_vf__ inline void PrintGmStrings(
    __ubuf__ const __asc_simd_vf::GmCStringRef* strings, __ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z)
{
    // Direct VF literal: exercise the UB-compatible overload before the GM records.
    printf("[simd_vf] string in gm!\n");
    __asc_simd_vf::printf_gm(__asc_simd_vf::load_gm_cstring_ref(strings), 10, 20U, 3.14f, __asc_simd_vf::load_gm_cstring_ref(strings + 1));
    __asc_simd_vf::printf_gm(__asc_simd_vf::load_gm_cstring_ref(strings + 2), 255, (void*)(uintptr_t)0x12ff);
    __asc_simd_vf::printf_gm(__asc_simd_vf::load_gm_cstring_ref(strings + 3));
    __asc_simd_vf::printf_gm(__asc_simd_vf::load_gm_cstring_ref(strings + 4), 0U, x[0], y[0], z[0]);
    __asc_simd_vf::printf_gm(__asc_simd_vf::load_gm_cstring_ref(strings + 5), __asc_simd_vf::load_gm_cstring_ref(strings + 6));
}

// Temporary compiler adapter: obtain a genuine GM address on AICore, without a length.
__aicore__ inline void StageString(__ubuf__ __asc_simd_vf::GmCStringRef* dst, __gm__ const char* string)
{
    const auto ref = __asc_simd_vf::make_gm_cstring_ref(string);
    dst->addressLow = ref.addressLow;
    dst->addressHigh = ref.addressHigh;
}

extern "C" __global__ __vector__ void simd_vf_printf_gm_cstring_kernel(
    __gm__ const char* hostText)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    // Seven 8-byte address-only handles in UB; their string bodies stay in GM.
    // The direct literal inside PrintGmStrings uses the separate UB-compatible path.
    auto table = allocator.Alloc<uint32_t, 16>();
    auto x = allocator.Alloc<float, 16>();
    auto y = allocator.Alloc<float, 16>();
    auto z = allocator.Alloc<float, 16>();
    auto* strings = (__ubuf__ __asc_simd_vf::GmCStringRef*)table.GetPhyAddr();
    StageString(strings, "[simd_vf] int=%d, uint=%u, float=%f, string=%s\n");
    StageString(strings + 1, "hello");
    StageString(strings + 2, "[simd_vf] hex=%x, ptr=%p\n");
    StageString(strings + 3, "[simd_vf] This is a simd_vf printf demo string.\n");
    StageString(strings + 4, "[simd_vf] add[%u]: %f + %f = %f\n");
    StageString(strings + 5, "[gm_long] %s\n");
    StageString(strings + 6, hostText);
    AscendC::Duplicate<float>(x, 1.25f, 16);
    AscendC::Duplicate<float>(y, 10.0f, 16);
    AscendC::Add(z, x, y, 16);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::printf("[aicore] simd_vf printf demo start ...\n");
    AscendC::printf("[aicore] blockIdx=%u\n", AscendC::GetBlockIdx());
    asc_vf_call<PrintGmStrings>(strings, (__ubuf__ float*)x.GetPhyAddr(),
        (__ubuf__ float*)y.GetPhyAddr(), (__ubuf__ float*)z.GetPhyAddr());
    AscendC::printf("[aicore] simd_vf printf demo end ...\n");
}

int main(int argc, char** argv)
{
    const char* config = argc > 1 ? argv[1] : "acl.json";
    const std::string hostText = "GM_BEGIN:" + std::string(2300, 'G') + ":GM_END";
    aclrtStream stream = nullptr;
    void* deviceText = nullptr;
    bool initialized = false;
    bool deviceSet = false;
    int status = 0;
    // Print the exact failing API; still release resources after a failure.
#define CHECK_ACL(call) do { \
    const aclError error = (call); \
    if (error != ACL_SUCCESS) { \
        std::fprintf(stderr, "%s failed: %d\n", #call, static_cast<int>(error)); \
        status = 1; goto cleanup; \
    } \
} while (0)
    CHECK_ACL(aclInit(config));
    initialized = true;
    CHECK_ACL(aclrtSetDevice(0));
    deviceSet = true;
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMalloc(&deviceText, hostText.size() + 1, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(deviceText, hostText.size() + 1, hostText.c_str(),
        hostText.size() + 1, ACL_MEMCPY_HOST_TO_DEVICE));
    simd_vf_printf_gm_cstring_kernel<<<1, 0, stream>>>(
        static_cast<const char*>(deviceText));
    CHECK_ACL(aclrtSynchronizeStream(stream));
cleanup:
    if (deviceText != nullptr && aclrtFree(deviceText) != ACL_SUCCESS) { status = 1; }
    if (stream != nullptr && aclrtDestroyStream(stream) != ACL_SUCCESS) { status = 1; }
    if (deviceSet && aclrtResetDevice(0) != ACL_SUCCESS) { status = 1; }
    if (initialized && aclFinalize() != ACL_SUCCESS) { status = 1; }
    return status;
#undef CHECK_ACL
}
