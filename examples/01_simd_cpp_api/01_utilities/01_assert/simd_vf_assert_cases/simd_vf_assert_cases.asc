/*!
 * \file simd_vf_assert_cases.asc
 * \brief Progressive SIMD VF printf/assert cases with automatic runtime validation.
 */

#include "acl/acl.h"
#include "utils/debug/asc_printf.h"
#include <cassert>
#include "utils/debug/asc_assert.h"
#include "kernel_operator.h"

#include <cstdio>

#ifndef ASSERT_CASE_ID
#error "ASSERT_CASE_ID must be defined by CMake"
#endif

namespace {
constexpr uint32_t CASE_ID_VALUE = static_cast<uint32_t>(ASSERT_CASE_ID);
constexpr uint32_t CASE_VALUE = 7U;
constexpr uint32_t LARGE_BURST_RECORDS = 36U;
constexpr bool EXPECT_ASSERT_FAILURE = ASSERT_CASE_ID == 1 || ASSERT_CASE_ID == 2 || ASSERT_CASE_ID == 3 ||
    ASSERT_CASE_ID == 4 || ASSERT_CASE_ID == 5 || ASSERT_CASE_ID == 6 || ASSERT_CASE_ID == 8 ||
    ASSERT_CASE_ID == 9 || ASSERT_CASE_ID == 10 || ASSERT_CASE_ID == 11 || ASSERT_CASE_ID == 18;
} // namespace

#if ASSERT_CASE_ID == 0
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE0][VF] stage=before value=%u\n";
    __ubuf__ const char* passFmt = "[ASSERT_TEST][CASE0][VF] stage=after_pass value=%u\n";
    printf(beginFmt, value);
    assert(value == CASE_VALUE);
    printf(passFmt, value);
}
#elif ASSERT_CASE_ID == 1
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* fmt = "[ASSERT_TEST][CASE1][VF] stage=before value=%u\n";
    printf(fmt, value);
    assert(value < 4U);
}
#elif ASSERT_CASE_ID == 2
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE2][VF] stage=before value=%u\n";
    __ubuf__ const char* detailFmt = "[ASSERT_TEST][CASE2][VF] stage=detail signed=%d hex=%x\n";
    printf(beginFmt, value);
    printf(detailFmt, static_cast<int32_t>(value) - 10, value + 0x200U);
    ascendc_assert(value == 9U, "[ASSERT_TEST][CASE2][CUSTOM] value=%u expected=9\n", value);
}
#elif ASSERT_CASE_ID == 3
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE3][VF] stage=before value=%u\n";
    __ubuf__ const char* betweenFmt = "[ASSERT_TEST][CASE3][VF] stage=between_sites value=%u\n";
    printf(beginFmt, value);
    assert(value > 0U, "[ASSERT_TEST][CASE3][SITE0_FAIL] value=%u\n", value);
    printf(betweenFmt, value);
    assert(value < 4U, "[ASSERT_TEST][CASE3][SITE1_FAIL] value=%u limit=4\n", value);
}
#elif ASSERT_CASE_ID == 4
__simd_vf__ inline void AssertCase4FirstVf(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE4][FIRST_VF] stage=before value=%u\n";
    __ubuf__ const char* endFmt = "[ASSERT_TEST][CASE4][FIRST_VF] stage=after_pass value=%u\n";
    printf(beginFmt, value);
    assert(value == CASE_VALUE, "[ASSERT_TEST][CASE4][FIRST_FAIL] value=%u\n", value);
    printf(endFmt, value);
}

__simd_vf__ inline void AssertCase4SecondVf(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE4][SECOND_VF] stage=before value=%u\n";
    __ubuf__ const char* middleFmt = "[ASSERT_TEST][CASE4][SECOND_VF] stage=before_fail value=%u\n";
    printf(beginFmt, value);
    assert((value & 1U) != 0U);
    printf(middleFmt, value);
    ascendc_assert(value == 8U, "[ASSERT_TEST][CASE4][SECOND_FAIL] value=%u expected=8\n", value);
}
#elif ASSERT_CASE_ID == 5
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* fmt =
        "[ASSERT_TEST][CASE5][BURST] record=%u value=%u "
        "payload=EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE\n";
    for (uint32_t record = 0U; record < LARGE_BURST_RECORDS; ++record) {
        printf(fmt, record, value * 100U + record);
    }
    assert(value == 10U, "[ASSERT_TEST][CASE5][FAIL] value=%u expected=10\n", value);
}
#elif ASSERT_CASE_ID == 6
__simd_callee__ inline void AssertCase6LevelOne(uint32_t value)
{
    __ubuf__ const char* fmt = "[ASSERT_TEST][CASE6][LEVEL1] value=%u\n";
    printf(fmt, value);
    assert(value > 0U, "[ASSERT_TEST][CASE6][LEVEL1_FAIL] value=%u\n", value);
}

__simd_callee__ inline void AssertCase6LevelTwo(uint32_t value)
{
    __ubuf__ const char* fmt = "[ASSERT_TEST][CASE6][LEVEL2] value=%u\n";
    printf(fmt, value);
    ascendc_assert(value == 42U, "[ASSERT_TEST][CASE6][LEVEL2_FAIL] value=%u expected=42\n", value);
}

__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* rootFmt = "[ASSERT_TEST][CASE6][ROOT] stage=before value=%u\n";
    __ubuf__ const char* betweenFmt = "[ASSERT_TEST][CASE6][ROOT] stage=between_levels value=%u\n";
    printf(rootFmt, value);
    AssertCase6LevelOne(value);
    printf(betweenFmt, value);
    AssertCase6LevelTwo(value);
}
#elif ASSERT_CASE_ID == 7
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE7][VF] stage=before value=%u\n";
    __ubuf__ const char* passFmt = "[ASSERT_TEST][CASE7][VF] stage=after_pass value=%u\n";
    printf(beginFmt, value);
    ascendc_assert(value == CASE_VALUE);
    printf(passFmt, value);
}
#elif ASSERT_CASE_ID == 8
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE8][VF] stage=before value=%u\n";
    __ubuf__ const char* forbiddenFmt = "[ASSERT_TEST][CASE8][VF] stage=forbidden_after_fail\n";
    bool ready = value == 8U;
    printf(beginFmt, value);
    ascendc_assert(ready);
    printf(forbiddenFmt);
}
#elif ASSERT_CASE_ID == 9
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE9][VF] stage=before value=%u\n";
    __ubuf__ const char* assertFmt =
        "[ASSERT_TEST][CASE9][MIXED] signed=%d unsigned=%u hex=%x float=%f text=%s\n";
    __ubuf__ const char* label = "simd-vf";
    __ubuf__ const char* forbiddenFmt = "[ASSERT_TEST][CASE9][VF] stage=forbidden_after_fail\n";
    printf(beginFmt, value);
    ascendc_assert(value == 9U, assertFmt, -3, value, value + 0x900U, 1.25f, label);
    printf(forbiddenFmt);
}
#elif ASSERT_CASE_ID == 10
__simd_vf__ inline void RunRepeatedAssertCase(uint32_t value, uint32_t invocation, uint32_t expected)
{
    __ubuf__ const char* beginFmt =
        "[ASSERT_TEST][CASE10][VF] invocation=%u stage=before value=%u expected=%u\n";
    __ubuf__ const char* passFmt = "[ASSERT_TEST][CASE10][VF] invocation=%u stage=after_pass\n";
    printf(beginFmt, invocation, value, expected);
    ascendc_assert(value == expected,
        "[ASSERT_TEST][CASE10][FAIL] invocation=%u value=%u expected=%u\n", invocation, value, expected);
    printf(passFmt, invocation);
}
#elif ASSERT_CASE_ID == 11
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* loopFmt = "[ASSERT_TEST][CASE11][LOOP] record=%u value=%u\n";
    __ubuf__ const char* forbiddenFmt = "[ASSERT_TEST][CASE11][VF] stage=forbidden_after_loop\n";
    for (uint32_t record = 0U; record < 9U; ++record) {
        printf(loopFmt, record, value * 100U + record);
        ascendc_assert(record < 8U, "[ASSERT_TEST][CASE11][FAIL] record=%u limit=8\n", record);
    }
    printf(forbiddenFmt);
}
#elif ASSERT_CASE_ID == 12
__simd_vf__ inline void AssertCase12FirstVf(uint32_t value)
{
    __ubuf__ const char* fmt = "[ASSERT_TEST][CASE12][FIRST_VF] value=%u\n";
    printf(fmt, value);
    assert(value == CASE_VALUE);
}

__simd_vf__ inline void AssertCase12SecondVf(uint32_t value)
{
    __ubuf__ const char* fmt = "[ASSERT_TEST][CASE12][SECOND_VF] value=%u\n";
    printf(fmt, value);
    ascendc_assert(value > 0U, "[ASSERT_TEST][CASE12][UNEXPECTED_FAIL] value=%u\n", value);
}
#elif ASSERT_CASE_ID == 13 || ASSERT_CASE_ID == 14
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* fmt = "[ASSERT_TEST][DISABLED][VF] case=%u value=%u\n";
    printf(fmt, CASE_ID_VALUE, value);
    assert(value == 0U);
    ascendc_assert(value == 1U, "[ASSERT_TEST][DISABLED][FAIL] value=%u\n", value);
}
#elif ASSERT_CASE_ID == 15
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE15][VF] stage=before value=%u\n";
    __ubuf__ const char* passFmt = "[ASSERT_TEST][CASE15][VF] stage=after_pass value=%u\n";
    printf(beginFmt, value);
    assert(value == CASE_VALUE, "[ASSERT_TEST][CASE15][UNEXPECTED_FAIL] value=%u\n", value);
    printf(passFmt, value);
}
#elif ASSERT_CASE_ID == 16
__simd_vf__ inline void RunAssertCase(uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE16][VF] stage=before value=%u\n";
    __ubuf__ const char* plainPassFmt = "[ASSERT_TEST][CASE16][VF] stage=after_plain value=%u\n";
    __ubuf__ const char* formattedPassFmt = "[ASSERT_TEST][CASE16][VF] stage=after_formatted value=%u\n";
    __ubuf__ const char* allPassFmt = "[ASSERT_TEST][CASE16][VF] stage=after_all value=%u\n";
    printf(beginFmt, value);
    assert(value > 0U);
    printf(plainPassFmt, value);
    ascendc_assert(value == CASE_VALUE, "[ASSERT_TEST][CASE16][SITE1_FAIL] value=%u\n", value);
    printf(formattedPassFmt, value);
    assert((value & 1U) != 0U, "[ASSERT_TEST][CASE16][SITE2_FAIL] value=%u\n", value);
    printf(allPassFmt, value);
}
#elif ASSERT_CASE_ID == 17
__simd_vf__ inline void RunNullptrAssertCase(__ubuf__ uint32_t* ubufPtr, uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE17][VF] stage=before value=%u\n";
    __ubuf__ const char* passFmt = "[ASSERT_TEST][CASE17][VF] stage=after_nonnull value=%u\n";
    printf(beginFmt, value);
    assert(ubufPtr != nullptr);
    printf(passFmt, value);
}
#elif ASSERT_CASE_ID == 18
__simd_vf__ inline void RunNullptrAssertCase(__ubuf__ uint32_t* ubufPtr, uint32_t value)
{
    __ubuf__ const char* beginFmt = "[ASSERT_TEST][CASE18][VF] stage=before value=%u\n";
    __ubuf__ const char* forbiddenFmt = "[ASSERT_TEST][CASE18][VF] stage=forbidden_after_fail\n";
    printf(beginFmt, value);
    ascendc_assert(ubufPtr == nullptr, "[ASSERT_TEST][CASE18][NULL_FAIL] value=%u ptr=%p\n", value, ubufPtr);
    printf(forbiddenFmt);
}
#else
#error "Unsupported ASSERT_CASE_ID"
#endif

extern "C" __global__ __vector__ void simd_vf_assert_case_kernel(uint32_t value)
{
    AscendC::InitSocState();
    AscendC::printf("[ASSERT_TEST][AICORE] case=%u stage=before value=%u\n", CASE_ID_VALUE, value);

#if ASSERT_CASE_ID == 4
    asc_vf_call<AssertCase4FirstVf>(value);
    AscendC::printf("[ASSERT_TEST][AICORE] case=4 stage=between_vfs\n");
    asc_vf_call<AssertCase4SecondVf>(value);
#elif ASSERT_CASE_ID == 10
    asc_vf_call<RunRepeatedAssertCase>(value, 0U, value);
    AscendC::printf("[ASSERT_TEST][AICORE] case=10 stage=between_invocations\n");
    asc_vf_call<RunRepeatedAssertCase>(value, 1U, value + 1U);
#elif ASSERT_CASE_ID == 12
    asc_vf_call<AssertCase12FirstVf>(value);
    AscendC::printf("[ASSERT_TEST][AICORE] case=12 stage=between_vfs\n");
    asc_vf_call<AssertCase12SecondVf>(value);
#elif ASSERT_CASE_ID == 17 || ASSERT_CASE_ID == 18
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<uint32_t> payload = allocator.Alloc<uint32_t, 16>();
    auto* ubufPtr = reinterpret_cast<__ubuf__ uint32_t*>(payload.GetPhyAddr());
    asc_vf_call<RunNullptrAssertCase>(ubufPtr, value);
#else
    asc_vf_call<RunAssertCase>(value);
#endif

    AscendC::printf("[ASSERT_TEST][AICORE] case=%u stage=after\n", CASE_ID_VALUE);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclError setDeviceRet = ACL_ERROR_FAILURE;
    aclError createStreamRet = ACL_ERROR_FAILURE;
    aclError launchRet = ACL_ERROR_FAILURE;
    aclError syncRet = ACL_ERROR_FAILURE;

    aclError initRet = aclInit(nullptr);
    if (initRet == ACL_SUCCESS) {
        setDeviceRet = aclrtSetDevice(deviceId);
    }
    if (setDeviceRet == ACL_SUCCESS) {
        createStreamRet = aclrtCreateStream(&stream);
    }
    if (createStreamRet == ACL_SUCCESS) {
        simd_vf_assert_case_kernel<<<1, 0, stream>>>(CASE_VALUE);
        launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
        if (launchRet == ACL_SUCCESS) {
            syncRet = aclrtSynchronizeStream(stream);
        }
    }

    aclError destroyStreamRet = stream == nullptr ? ACL_SUCCESS : aclrtDestroyStream(stream);
    aclError resetDeviceRet = setDeviceRet == ACL_SUCCESS ? aclrtResetDevice(deviceId) : ACL_SUCCESS;
    aclError finalizeRet = initRet == ACL_SUCCESS ? aclFinalize() : ACL_SUCCESS;
    bool observedAssertFailure =
        syncRet == ACL_ERROR_RT_VECTOR_CORE_EXCEPTION || syncRet == ACL_ERROR_RT_VECTOR_CORE_TRAP_EXCEPTION;
    bool observedExpected = EXPECT_ASSERT_FAILURE ? observedAssertFailure : syncRet == ACL_SUCCESS;
    bool setupSucceeded = initRet == ACL_SUCCESS && setDeviceRet == ACL_SUCCESS &&
        createStreamRet == ACL_SUCCESS && launchRet == ACL_SUCCESS;
    bool cleanupSucceeded =
        destroyStreamRet == ACL_SUCCESS && resetDeviceRet == ACL_SUCCESS && finalizeRet == ACL_SUCCESS;
    bool passed = setupSucceeded && observedExpected && cleanupSucceeded;

    std::fprintf(stderr,
        "[ASSERT_TEST][HOST] case=%u init=%d set_device=%d create_stream=%d launch=%d sync=%d "
        "destroy_stream=%d reset_device=%d finalize=%d expected=%s observed=%s result=%s\n",
        CASE_ID_VALUE, initRet, setDeviceRet, createStreamRet, launchRet, syncRet, destroyStreamRet, resetDeviceRet,
        finalizeRet, EXPECT_ASSERT_FAILURE ? "failure" : "success",
        observedAssertFailure ? "failure" : (syncRet == ACL_SUCCESS ? "success" : "other"), passed ? "PASS" : "FAIL");
    return passed ? 0 : 1;
}
