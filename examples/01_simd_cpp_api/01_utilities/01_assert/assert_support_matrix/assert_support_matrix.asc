/*!
 * \file assert_support_matrix.asc
 * \brief 展示SIMD VF assert当前可编译用法及已知编译限制
 */

#include "acl/acl.h"
#include "utils/debug/asc_assert.h"
#include "kernel_operator.h"

#include <cstdio>

// 可编译用法集中在一个有效assert站点：支持标量组合条件、格式化消息，以及UB指针与整数0比较。
__simd_vf__ inline void SupportedAssert(__ubuf__ uint32_t* ubufPtr, uint32_t value)
{
    bool scalarCondition = value < 4U && (value & 1U) != 0U;
    bool pointerCondition = ubufPtr != 0;
    assert(scalarCondition && pointerCondition, "[simd_vf][assert] value=%u ptr=%p\n", value, ubufPtr);
}

// 当前BiSheng后端无法展开__ubuf__指针与nullptr比较形成的assert条件。
template <typename T>
__simd_vf__ inline void UnsupportedNullptrAssert(__ubuf__ T* ubufPtr)
{
    assert(ubufPtr != nullptr);
}

// 当前BiSheng在同一SIMD VF函数含两个以上有效assert站点时，会在指令选择阶段异常退出。
template <uint32_t FirstLimit, uint32_t SecondLimit>
__simd_vf__ inline void UnsupportedMultipleAssertSites(uint32_t value)
{
    assert(value < FirstLimit);
    assert(value < SecondLimit);
}

extern "C" __global__ __vector__ void assert_support_matrix_kernel(uint32_t value)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    AscendC::LocalTensor<uint32_t> payload = allocator.Alloc<uint32_t, 16>();
    auto* ubufPtr = reinterpret_cast<__ubuf__ uint32_t*>(payload.GetPhyAddr());

    asc_vf_call<SupportedAssert>(ubufPtr, value);

    // 暂不支持：后端报错“Do not know how to expand this operator's operand”。
    // asc_vf_call<UnsupportedNullptrAssert<uint32_t>>(ubufPtr);

    // 暂不支持：BiSheng在VF DAG指令选择阶段触发stack smashing并退出。
    // asc_vf_call<UnsupportedMultipleAssertSites<4U, 8U>>(value);
}

int32_t main(int32_t argc, char* argv[])
{
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclError setDeviceRet = ACL_ERROR_FAILURE;
    aclError createStreamRet = ACL_ERROR_FAILURE;
    aclError launchRet = ACL_ERROR_FAILURE;
    aclError syncRet = ACL_ERROR_FAILURE;

    aclError initRet = aclInit(nullptr);
    if (initRet == ACL_SUCCESS) {
        setDeviceRet = aclrtSetDevice(deviceId);
    }
    if (setDeviceRet == ACL_SUCCESS) {
        createStreamRet = aclrtCreateStream(&stream);
    }
    if (createStreamRet == ACL_SUCCESS) {
        // 传入5使受支持的运行时条件失败，验证assert信息经FIFO发布后触发异常。
        assert_support_matrix_kernel<<<1, 0, stream>>>(5U);
        launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
        if (launchRet == ACL_SUCCESS) {
            syncRet = aclrtSynchronizeStream(stream);
        }
    }

    aclError destroyStreamRet = stream == nullptr ? ACL_SUCCESS : aclrtDestroyStream(stream);
    aclError resetDeviceRet = setDeviceRet == ACL_SUCCESS ? aclrtResetDevice(deviceId) : ACL_SUCCESS;
    aclError finalizeRet = initRet == ACL_SUCCESS ? aclFinalize() : ACL_SUCCESS;
    std::fprintf(stderr,
        "initRet=%d setDeviceRet=%d createStreamRet=%d launchRet=%d syncRet=%d destroyStreamRet=%d "
        "resetDeviceRet=%d finalizeRet=%d\n",
        initRet, setDeviceRet, createStreamRet, launchRet, syncRet, destroyStreamRet, resetDeviceRet, finalizeRet);

    bool expectedAssertFailure =
        syncRet == ACL_ERROR_RT_VECTOR_CORE_EXCEPTION || syncRet == ACL_ERROR_RT_VECTOR_CORE_TRAP_EXCEPTION;
    bool setupSucceeded =
        initRet == ACL_SUCCESS && setDeviceRet == ACL_SUCCESS && createStreamRet == ACL_SUCCESS;
    bool cleanupSucceeded =
        destroyStreamRet == ACL_SUCCESS && resetDeviceRet == ACL_SUCCESS && finalizeRet == ACL_SUCCESS;
    return setupSucceeded && launchRet == ACL_SUCCESS && expectedAssertFailure && cleanupSucceeded ? 0 : 1;
}
