/*!
 * \file add.asc
 * \brief 基于Add的msProf profiling样例。
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

template <uint32_t dim0, uint32_t dim1>
__global__ __vector__ void add_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    AscendC::InitSocState();

    const uint32_t blockLength = dim0 * dim1 / AscendC::GetBlockNum();
    const uint64_t xAddr = 0;
    const uint64_t yAddr = xAddr + blockLength * sizeof(half);
    const uint64_t zAddr = yAddr + blockLength * sizeof(half);

    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;
    xGm.SetGlobalBuffer((__gm__ half *)x + blockLength * AscendC::GetBlockIdx(), blockLength);
    yGm.SetGlobalBuffer((__gm__ half *)y + blockLength * AscendC::GetBlockIdx(), blockLength);
    zGm.SetGlobalBuffer((__gm__ half *)z + blockLength * AscendC::GetBlockIdx(), blockLength);

    AscendC::LocalTensor<half> xLocal(AscendC::TPosition::VECCALC, xAddr, blockLength);
    AscendC::LocalTensor<half> yLocal(AscendC::TPosition::VECCALC, yAddr, blockLength);
    AscendC::LocalTensor<half> zLocal(AscendC::TPosition::VECCALC, zAddr, blockLength);

    AscendC::DataCopy(xLocal, xGm, blockLength);
    AscendC::DataCopy(yLocal, yGm, blockLength);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Add(zLocal, xLocal, yLocal, blockLength);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(zGm, zLocal, blockLength);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t addCustomShapeDim0 = 8;
    constexpr uint32_t addCustomShapeDim1 = 2048;
    constexpr uint32_t blockNum = 8;
    constexpr size_t totalLength = addCustomShapeDim0 * addCustomShapeDim1;
    constexpr size_t totalByteSize = totalLength * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *inputXHost = nullptr;
    uint8_t *inputXDevice = nullptr;
    aclrtMallocHost((void **)(&inputXHost), totalByteSize);
    aclrtMalloc((void **)&inputXDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t inputXFileSize = totalByteSize;
    ReadFile("./input/x1_gm.bin", inputXFileSize, inputXHost, totalByteSize);
    aclrtMemcpy(inputXDevice, totalByteSize, inputXHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *inputYHost = nullptr;
    uint8_t *inputYDevice = nullptr;
    aclrtMallocHost((void **)(&inputYHost), totalByteSize);
    aclrtMalloc((void **)&inputYDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t inputYFileSize = totalByteSize;
    ReadFile("./input/x2_gm.bin", inputYFileSize, inputYHost, totalByteSize);
    aclrtMemcpy(inputYDevice, totalByteSize, inputYHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *outputZHost = nullptr;
    uint8_t *outputZDevice = nullptr;
    aclrtMallocHost((void **)(&outputZHost), totalByteSize);
    aclrtMalloc((void **)&outputZDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    add_custom<addCustomShapeDim0, addCustomShapeDim1><<<blockNum, nullptr, stream>>>(
        inputXDevice, inputYDevice, outputZDevice);

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputZHost, totalByteSize, outputZDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputZHost, totalByteSize);

    aclrtFree(inputXDevice);
    aclrtFreeHost(inputXHost);
    aclrtFree(inputYDevice);
    aclrtFreeHost(inputYHost);
    aclrtFree(outputZDevice);
    aclrtFreeHost(outputZHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
