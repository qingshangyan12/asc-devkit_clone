/* !
 * \file add_check_memory.asc
 * \brief Test CheckLocalMemoryIA using KernelAdd (TQue CopyIn/Compute/CopyOut pipeline) pattern
 */

#include "kernel_operator.h"
#include "acl/acl.h"
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t BLOCK_SIZE = 32;

struct AddCheckMemoryTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelAddWithCheck {
public:
    __aicore__ inline KernelAddWithCheck() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / GetBlockNum();
        this->tileNum = tileNum;
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;
        xGm.SetGlobalBuffer((__gm__ float *)x + this->blockLength * GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + this->blockLength * GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + this->blockLength * GetBlockIdx(), this->blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));

        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        uint32_t startAddr = (uint32_t)(zLocal.GetPhyAddr() / BLOCK_SIZE);
        uint32_t endAddr = (uint32_t)((zLocal.GetPhyAddr() + BUFFER_NUM * this->tileLength * sizeof(float)) / BLOCK_SIZE);
        CheckLocalMemoryIAParam checkParams(
            SET_DATA_EXP_ZERO,
            startAddr,
            endAddr,
            false,
            false,
            false,
            true,
            false,
            false,
            true
        );
        CheckLocalMemoryIA(checkParams);
        printf("CheckLocalMemoryIA enabled: monitoring vector write on zLocal [0x%x, 0x%x)\n", startAddr, endAddr);
        outQueueZ.FreeTensor(zLocal);
    }
    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        Add(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

class KernelAddNormal {
public:
    __aicore__ inline KernelAddNormal() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / GetBlockNum();
        this->tileNum = tileNum;
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;
        xGm.SetGlobalBuffer((__gm__ float *)x + this->blockLength * GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + this->blockLength * GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + this->blockLength * GetBlockIdx(), this->blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        Add(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ __vector__ void add_check_enabled_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, AddCheckMemoryTilingData tiling)
{
    KernelAddWithCheck op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

__global__ __aicore__ __vector__ void add_check_disabled_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, AddCheckMemoryTilingData tiling)
{
    KernelAddNormal op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    size_t totalByteSize = totalLength * sizeof(float);
    constexpr uint32_t numBlocks = 8;
    AddCheckMemoryTilingData tiling = {totalLength, 8};
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::cout << "===== Test 1: CheckLocalMemoryIA enabled (monitoring vector write on zLocal) =====" << std::endl;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost1 = reinterpret_cast<uint8_t *>(x.data());
    uint8_t *yHost1 = reinterpret_cast<uint8_t *>(y.data());
    uint8_t *zHost1 = nullptr;
    uint8_t *xDevice1 = nullptr;
    uint8_t *yDevice1 = nullptr;
    uint8_t *zDevice1 = nullptr;

    aclrtMallocHost((void **)(&zHost1), totalByteSize);
    aclrtMalloc((void **)&xDevice1, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice1, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice1, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice1, totalByteSize, xHost1, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice1, totalByteSize, yHost1, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    add_check_enabled_kernel<<<numBlocks, nullptr, stream>>>(xDevice1, yDevice1, zDevice1, tiling);
    aclError ret = aclrtSynchronizeStream(stream);

    if (ret == ACL_ERROR_RT_VECTOR_CORE_EXCEPTION) {
        std::cout << "[EXPECTED] Caught ACL_ERROR_RT_VECTOR_CORE_EXCEPTION" << std::endl;
        std::cout << "CheckLocalMemoryIA successfully detected vector write on zLocal!" << std::endl;
    } else if (ret == ACL_SUCCESS) {
        std::cout << "[WARNING] No exception detected. CheckLocalMemoryIA may not be working as expected." << std::endl;
    } else {
        std::cout << "[ERROR] Unexpected error: " << ret << std::endl;
    }

    aclrtFree(xDevice1);
    aclrtFree(yDevice1);
    aclrtFree(zDevice1);
    aclrtFreeHost(zHost1);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);

    std::cout << "\n===== Test 2: Normal Add without CheckLocalMemoryIA =====" << std::endl;

    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    uint8_t *xHost2 = reinterpret_cast<uint8_t *>(x.data());
    uint8_t *yHost2 = reinterpret_cast<uint8_t *>(y.data());
    uint8_t *zHost2 = nullptr;
    uint8_t *xDevice2 = nullptr;
    uint8_t *yDevice2 = nullptr;
    uint8_t *zDevice2 = nullptr;

    aclrtMallocHost((void **)(&zHost2), totalByteSize);
    aclrtMalloc((void **)&xDevice2, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice2, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice2, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice2, totalByteSize, xHost2, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice2, totalByteSize, yHost2, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    add_check_disabled_kernel<<<numBlocks, nullptr, stream>>>(xDevice2, yDevice2, zDevice2, tiling);
    ret = aclrtSynchronizeStream(stream);

    if (ret == ACL_SUCCESS) {
        aclrtMemcpy(zHost2, totalByteSize, zDevice2, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<float> output((float *)zHost2, (float *)(zHost2 + totalByteSize));
        std::vector<float> golden(totalLength, valueX + valueY);
        VerifyResult(output, golden);
    } else {
        std::cout << "[ERROR] Kernel execution failed: " << ret << std::endl;
    }

    aclrtFree(xDevice2);
    aclrtFree(yDevice2);
    aclrtFree(zDevice2);
    aclrtFreeHost(zHost2);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    std::cout << "\n===== All tests completed =====" << std::endl;
    return 0;
}