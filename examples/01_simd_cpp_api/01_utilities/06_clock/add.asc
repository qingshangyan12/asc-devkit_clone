/* !
 * \file add.asc
 * \brief Add示例，展示在SIMT核函数中使用clock接口统计执行周期。
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

template <uint32_t totalLength, uint32_t threadNumPerBlock>
__simt_vf__ __launch_bounds__(threadNumPerBlock) inline void simt_add(
    __gm__ float* x,
    __gm__ float* y,
    __gm__ float* z)
{
    static_assert(totalLength > 0 && threadNumPerBlock > 0);
    // 记录当前线程执行Add计算前的时间戳。
    uint64_t t1 = clock();

    int32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= totalLength) {
        return;
    }
    z[idx] = x[idx] + y[idx];

    // 记录当前线程执行Add计算后的时间戳，并输出两次打点之间的周期差。
    uint64_t t2 = clock();
    printf("simt execute cycle : %lu\n", t2 - t1);
}

template <uint32_t totalLength, uint32_t threadNumPerBlock>
__global__ __vector__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_vf_call<simt_add<totalLength, threadNumPerBlock>>(dim3(threadNumPerBlock), x, y, z);
}

template <uint32_t totalLength, uint32_t blockNum, uint32_t threadNumPerBlock>
std::vector<float> add(std::vector<float>& x, std::vector<float>& y)
{
    static_assert(totalLength > 0 && blockNum > 0 && threadNumPerBlock > 0);
    size_t total_byte_size = totalLength * sizeof(float);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* x_host = reinterpret_cast<uint8_t *>(x.data());
    uint8_t* y_host = reinterpret_cast<uint8_t *>(y.data());
    uint8_t* z_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    float* z_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void **)(&z_host), total_byte_size);
    aclrtMalloc((void **)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&z_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, total_byte_size, y_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0;
    add_custom<totalLength, threadNumPerBlock><<<blockNum, dyn_ubuf_size, stream>>>(x_device, y_device, z_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, total_byte_size, z_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> output((float *)z_host, (float *)(z_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return output;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t blockNum = 48;
    constexpr uint32_t threadNumPerBlock = 256;
    constexpr uint32_t totalLength = blockNum * threadNumPerBlock;

    std::vector<float> x(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        x[i] = i * 1.1f;
    }

    std::vector<float> y(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        y[i] = i + 3.4f;
    }

    std::vector<float> golden(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        golden[i] = x[i] + y[i];
    }

    std::vector<float> output = add<totalLength, blockNum, threadNumPerBlock>(x, y);
    return verify_result(output, golden);
}
