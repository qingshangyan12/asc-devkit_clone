/*!
 * \file vector_copy_tensor_api.asc
 * \brief Tensor API sample for GM-to-UB, UB-to-UB, UB-to-GM, and UB-to-L1 vector copies.
 */

#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "tensor_api/tensor.h"

#include "data_utils.h"

namespace {

constexpr uint32_t MATRIX_DIM = 16;
constexpr uint32_t PADDED_COLUMNS = 32;
constexpr uint32_t PADDED_ELEMENTS = MATRIX_DIM * PADDED_COLUMNS;
constexpr uint32_t MATRIX_ELEMENTS = MATRIX_DIM * MATRIX_DIM;
constexpr uint8_t VECTOR_COPY_MUTEX_ID = 0;

__global__ __vector__ void vector_copy_tensor_api_kernel(__gm__ uint16_t* output, __gm__ uint16_t* input)
{
    asc_init();

    __ubuf__ half sourceUb[PADDED_ELEMENTS];
    __ubuf__ half copyUb[PADDED_ELEMENTS];
    __cbuf__ half outputL1[MATRIX_ELEMENTS];

    auto paddedLayout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, half>(MATRIX_DIM, PADDED_COLUMNS);
    auto matrixLayout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, half>(MATRIX_DIM, MATRIX_DIM);

    auto inputGm = asc::te::make_tensor(
        asc::te::make_mem_ptr(reinterpret_cast<__gm__ half*>(input)), paddedLayout);
    auto outputGm = asc::te::make_tensor(
        asc::te::make_mem_ptr(reinterpret_cast<__gm__ half*>(output)), paddedLayout);
    auto sourceUbTensor = asc::te::make_tensor(asc::te::make_mem_ptr(sourceUb), paddedLayout);
    auto copyUbTensor = asc::te::make_tensor(asc::te::make_mem_ptr(copyUb), paddedLayout);
    auto outputL1Tensor = asc::te::make_tensor(asc::te::make_mem_ptr(outputL1), matrixLayout);

    auto gmToUb = asc::te::make_copy(asc::te::copy_gm_to_ub{}, asc::te::gm_to_ub_trait_default{});
    auto ubToUb = asc::te::make_copy(asc::te::copy_ub_to_ub{}, asc::te::ub_to_ub_trait_default{});
    auto ubToGm = asc::te::make_copy(asc::te::copy_ub_to_gm{}, asc::te::ub_to_gm_trait_default{});
    auto ubToL1 = asc::te::make_copy(asc::te::copy_ub_to_l1{}, asc::te::ub_to_l1_trait_default{});

    // GM -> UB uses byte strides between the starts of adjacent rows.
    asc_lock(PIPE_MTE2, VECTOR_COPY_MUTEX_ID);
    asc::te::copy(gmToUb, sourceUbTensor, inputGm);
    asc_unlock(PIPE_MTE2, VECTOR_COPY_MUTEX_ID);

    // Copy 16 half values from every 32-value row. The UB gaps are one DataBlock (32 bytes).
    asc_lock(PIPE_V, VECTOR_COPY_MUTEX_ID);
    asc::te::copy(ubToUb, copyUbTensor, sourceUbTensor, asc::te::zero_coord, asc::te::zero_coord,
        asc::te::make_shape(MATRIX_DIM, MATRIX_DIM));
    asc_unlock(PIPE_V, VECTOR_COPY_MUTEX_ID);

    // UB -> GM uses byte strides; UB -> L1 uses tail-to-head gaps in DataBlocks.
    asc_lock(PIPE_MTE3, VECTOR_COPY_MUTEX_ID);
    asc::te::copy(ubToGm, outputGm, copyUbTensor, asc::te::zero_coord, asc::te::zero_coord,
        asc::te::make_shape(MATRIX_DIM, MATRIX_DIM));
    asc::te::copy(ubToL1, outputL1Tensor, copyUbTensor, asc::te::zero_coord, asc::te::zero_coord,
        asc::te::make_shape(MATRIX_DIM, MATRIX_DIM));
    asc_unlock(PIPE_MTE3, VECTOR_COPY_MUTEX_ID);

    asc_sync_pipe(PIPE_ALL);
}

bool CheckAcl(aclError error, const char* operation)
{
    if (error == ACL_SUCCESS) {
        return true;
    }
    std::cerr << operation << " failed, error code: " << error << std::endl;
    return false;
}

} // namespace

int32_t main()
{
    constexpr size_t paddedBytes = PADDED_ELEMENTS * sizeof(uint16_t);

    std::vector<uint16_t> input(PADDED_ELEMENTS);
    std::vector<uint16_t> output(PADDED_ELEMENTS, 0);
    size_t fileSize = 0;
    if (!ReadFile("./input/input.bin", fileSize, input.data(), paddedBytes) || fileSize != paddedBytes) {
        return 1;
    }

    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    if (!CheckAcl(aclrtSetDevice(0), "aclrtSetDevice")) {
        aclFinalize();
        return 1;
    }

    aclrtStream stream = nullptr;
    uint16_t* inputDevice = nullptr;
    uint16_t* outputDevice = nullptr;
    bool success = CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") &&
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&inputDevice), paddedBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(input)") &&
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), paddedBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(output)");

    if (success) {
        success = CheckAcl(aclrtMemcpy(inputDevice, paddedBytes, input.data(), paddedBytes,
                               ACL_MEMCPY_HOST_TO_DEVICE), "copy input to device") &&
            CheckAcl(aclrtMemcpy(outputDevice, paddedBytes, output.data(), paddedBytes,
                         ACL_MEMCPY_HOST_TO_DEVICE), "initialize output");
    }

    if (success) {
        vector_copy_tensor_api_kernel<<<1, nullptr, stream>>>(outputDevice, inputDevice);
        success = CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") &&
            CheckAcl(aclrtMemcpy(output.data(), paddedBytes, outputDevice, paddedBytes,
                         ACL_MEMCPY_DEVICE_TO_HOST), "copy output to host");
    }

    if (success) {
        success = WriteFile("./output/output.bin", output.data(), paddedBytes);
    }

    if (inputDevice != nullptr) {
        aclrtFree(inputDevice);
    }
    if (outputDevice != nullptr) {
        aclrtFree(outputDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(0);
    aclFinalize();

    return success ? 0 : 1;
}
