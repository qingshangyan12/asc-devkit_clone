#include <cstdint>
#include <iostream>

#include "c_api/sync/sync.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/logical_compute.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t RESULT_ROWS = 8;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(int32_t);

enum result_row : uint32_t {
    ROW_LOGICAL_NOT,
    ROW_BIT_AND,
    ROW_BIT_OR,
    ROW_BIT_XOR,
    ROW_SHIFT_LEFT_REG,
    ROW_SHIFT_LEFT_SCALAR,
    ROW_SHIFT_RIGHT_REG,
    ROW_SHIFT_RIGHT_SCALAR,
};

__simd_vf__ inline void compute(__ubuf__ int32_t* src_a, __ubuf__ int32_t* src_b,
    __ubuf__ int32_t* shifts, __ubuf__ int32_t* output)
{
    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = asc::te::make_tensor(asc::te::make_mem_ptr(src_a), input_layout);
    auto input_b = asc::te::make_tensor(asc::te::make_mem_ptr(src_b), input_layout);
    auto shift_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(shifts), input_layout);
    auto result = asc::te::make_tensor(asc::te::make_mem_ptr(output), output_layout);

    auto mask = asc::te::all_mask<int32_t>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto shift = shift_tensor.load(asc::te::make_coord(0, 0)).with_mask(mask);

    result.store(asc::te::make_coord(ROW_LOGICAL_NOT, 0), !a);
    result.store(asc::te::make_coord(ROW_BIT_AND, 0), a & b);
    result.store(asc::te::make_coord(ROW_BIT_OR, 0), a | 16);
    result.store(asc::te::make_coord(ROW_BIT_XOR, 0), 7 ^ a);
    result.store(asc::te::make_coord(ROW_SHIFT_LEFT_REG, 0), a << shift);
    result.store(asc::te::make_coord(ROW_SHIFT_LEFT_SCALAR, 0), a << static_cast<int16_t>(2));
    result.store(asc::te::make_coord(ROW_SHIFT_RIGHT_REG, 0), a >> shift);
    result.store(asc::te::make_coord(ROW_SHIFT_RIGHT_SCALAR, 0), a >> static_cast<int16_t>(2));
}

__global__ __vector__ void logical_compute_tensor_api(__gm__ int32_t* src_a, __gm__ int32_t* src_b,
    __gm__ int32_t* shifts, __gm__ int32_t* output)
{
    constexpr uint32_t input_a_offset = 0;
    constexpr uint32_t input_b_offset = input_a_offset + VECTOR_BYTES;
    constexpr uint32_t shift_offset = input_b_offset + VECTOR_BYTES;
    constexpr uint32_t output_offset = shift_offset + VECTOR_BYTES;

    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, VECTOR_LENGTH);
    auto src_a_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_a), input_layout);
    auto src_b_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_b), input_layout);
    auto shifts_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(shifts), input_layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), output_layout);
    auto src_a_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(input_a_offset), input_layout);
    auto src_b_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(input_b_offset), input_layout);
    auto shifts_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(shift_offset), input_layout);
    auto output_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(output_offset), output_layout);

    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, src_a_ub, src_a_gm);
    asc::te::copy(copy_in, src_b_ub, src_b_gm);
    asc::te::copy(copy_in, shifts_ub, shifts_gm);
    asc_sync_notify(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);

    compute(src_a_ub.data().get(), src_b_ub.data().get(), shifts_ub.data().get(), output_ub.data().get());

    asc_sync_notify(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_ub);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<int32_t> src_a;
    example::buffer<int32_t> src_b;
    example::buffer<int32_t> shifts;
    example::buffer<int32_t> output;
    if (!runtime.init() || !src_a.load_to_device("./input/src_a.bin", VECTOR_LENGTH) ||
        !src_b.load_to_device("./input/src_b.bin", VECTOR_LENGTH) ||
        !shifts.load_to_device("./input/shifts.bin", VECTOR_LENGTH) ||
        !output.allocate(RESULT_ROWS * VECTOR_LENGTH)) {
        return 1;
    }

    logical_compute_tensor_api<<<1, 0, runtime.stream()>>>(
        src_a.device(), src_b.device(), shifts.device(), output.device());
    if (!runtime.synchronize() || !output.save_from_device("./output/output.bin")) {
        return 1;
    }
    std::cout << "logical_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
