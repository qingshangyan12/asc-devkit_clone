/* !
 * \file mmad.asc
 * \brief
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

template <
    typename AType, typename BType, typename L0CType, typename CType, int32_t BaseM, int32_t BaseN, int32_t BaseK,
    int32_t StepM, int32_t StepN, int32_t StepK, bool EnableUnitFlag>
__cube__ __global__ void mmad_quant_custom(
    __gm__ AType* x, __gm__ BType* y, __gm__ CType* z, __gm__ uint64_t* quant, int32_t m, int32_t n, int32_t k,
    int32_t single_core_m, int32_t single_core_n, int32_t single_core_k)
{
    using a_type = AType;
    using b_type = BType;
    using l0c_type = L0CType;
    using c_type = CType;
    constexpr int32_t base_m = BaseM;
    constexpr int32_t base_n = BaseN;
    constexpr int32_t base_k = BaseK;
    constexpr int32_t step_m = StepM;
    constexpr int32_t step_n = StepN;
    constexpr int32_t step_k = StepK;
    constexpr bool enable_unit_flag = EnableUnitFlag;
    asc_init();
    // Copy tiling info from GM to local
    uint32_t m_iter = (m + single_core_m - 1) / single_core_m;
    uint32_t m_iter_idx = block_idx % m_iter;
    uint32_t n_iter_idx = block_idx / m_iter;
    int32_t actual_single_core_m = m - m_iter_idx * single_core_m;
    int32_t actual_single_core_n = n - n_iter_idx * single_core_n;
    actual_single_core_m = actual_single_core_m < single_core_m ? actual_single_core_m : single_core_m;
    actual_single_core_n = actual_single_core_n < single_core_n ? actual_single_core_n : single_core_n;

    auto gm_a_tensor =
        asc::te::make_tensor(asc::te::make_mem_ptr(x), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(m, k));
    auto gm_b_tensor =
        asc::te::make_tensor(asc::te::make_mem_ptr(y), asc::te::make_frame_layout<asc::te::dn_ext_layout_ptn>(k, n));
    auto gm_c_tensor =
        asc::te::make_tensor(asc::te::make_mem_ptr(z), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(m, n));
    auto gm_quant_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(quant), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, n));

    auto gm_a_single_tensor = gm_a_tensor.slice(
        asc::te::make_coord(m_iter_idx * single_core_m, 0), asc::te::make_shape(actual_single_core_m, single_core_k));
    auto gm_b_single_tensor = gm_b_tensor.slice(
        asc::te::make_coord(0, n_iter_idx * single_core_n), asc::te::make_shape(single_core_k, actual_single_core_n));
    auto gm_c_single_tensor = gm_c_tensor.slice(
        asc::te::make_coord(m_iter_idx * single_core_m, n_iter_idx * single_core_n),
        asc::te::make_shape(actual_single_core_m, actual_single_core_n));
    auto gm_quant_single_tensor = gm_quant_tensor.slice(
        asc::te::make_coord(0, n_iter_idx * single_core_n), asc::te::make_shape(1, actual_single_core_n));

    __cbuf__ a_type l1a_buf[base_m * step_m * base_k * step_k];
    __cbuf__ b_type l1b_buf[base_k * step_k * base_n * step_n];
    __cbuf__ uint64_t l1_quant_buf[base_n * step_n];
    __ca__ a_type l0a_buf[base_m * base_k];
    __cb__ b_type l0b_buf[base_k * base_n];
    __cc__ l0c_type l0c_buf[base_m * base_n];

    auto l1_quant_ptr = asc::te::make_mem_ptr(l1_quant_buf);
    auto l0a_ptr = asc::te::make_mem_ptr(l0a_buf);
    auto l0b_ptr = asc::te::make_mem_ptr(l0b_buf);
    auto l0c_ptr = asc::te::make_mem_ptr(l0c_buf);

    auto copy_gm_to_l1_atom = asc::te::make_copy(asc::te::copy_gm_to_l1{}, asc::te::gm_to_l1_trait_default{});
    auto copy_l1_to_l0a_atom = asc::te::make_copy(asc::te::copy_l1_to_l0a{}, asc::te::l1_to_l0a_trait_default{});
    auto copy_l1_to_l0b_atom = asc::te::make_copy(asc::te::copy_l1_to_l0b{}, asc::te::l1_to_l0b_trait_default{});
    auto copy_l0c_to_gm_atom = asc::te::make_copy(asc::te::copy_l0c_to_gm{}, asc::te::l0c_to_gm_trait_default{});
    auto mmad_atom = asc::te::make_mmad(asc::te::mmad_operation{}, asc::te::mmad_trait_default{});

    auto l1a_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l1a_buf),
        asc::te::make_frame_layout<asc::te::nz_layout_ptn, a_type>(base_m * step_m, base_k * step_k));
    auto l1b_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l1b_buf),
        asc::te::make_frame_layout<asc::te::zn_layout_ptn, b_type>(base_k * step_k, base_n * step_n));

    uint32_t m_loop = (actual_single_core_m + base_m - 1) / base_m;
    uint32_t n_loop = (actual_single_core_n + base_n - 1) / base_n;
    uint32_t k_loop = (single_core_k + base_k - 1) / base_k;

    static constexpr uint32_t l1_index = 0;
    static constexpr uint32_t l0_index = 1;
    static constexpr uint32_t l0c_index = 2;
    static constexpr uint32_t quant_index = 3;
    uint16_t tile_m = (actual_single_core_m % base_m != 0) ? actual_single_core_m % base_m : base_m;
    uint16_t tile_n = (actual_single_core_n % base_n != 0) ? actual_single_core_n % base_n : base_n;
    uint16_t tile_k = (single_core_k % base_k != 0) ? single_core_k % base_k : base_k;

    for (uint32_t i = 0; i < m_loop; i++) {
        uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
        for (uint32_t j = 0; j < n_loop; j++) {
            uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
            auto l0c_tensor =
                asc::te::make_tensor(l0c_ptr, asc::te::make_frame_layout<asc::te::nz_layout_ptn>(cur_m, cur_n));
            for (uint32_t k_iter = 0; k_iter < k_loop; k_iter++) {
                uint16_t cur_k = (k_iter + 1 == k_loop) ? tile_k : base_k;
                auto l0a_tensor = asc::te::make_tensor(
                    l0a_ptr, asc::te::make_frame_layout<asc::te::nz_layout_ptn, a_type>(cur_m, cur_k));
                auto l0b_tensor = asc::te::make_tensor(
                    l0b_ptr, asc::te::make_frame_layout<asc::te::zn_layout_ptn, b_type>(cur_k, cur_n));
                if (k_iter % step_k == 0) {
                    uint16_t cur_step_k = static_cast<uint16_t>(single_core_k - k_iter * base_k);
                    cur_step_k = cur_step_k < base_k * step_k ? cur_step_k : base_k * step_k;
                    asc_lock(PIPE_MTE2, l1_index);
                    // GM -> L1A
                    asc::te::copy(
                        copy_gm_to_l1_atom, l1a_tensor,
                        gm_a_single_tensor.slice(
                            asc::te::make_coord(i * base_m, k_iter * base_k), asc::te::make_shape(cur_m, cur_step_k)));
                    // GM -> L1B
                    asc::te::copy(
                        copy_gm_to_l1_atom, l1b_tensor,
                        gm_b_single_tensor.slice(
                            asc::te::make_coord(k_iter * base_k, j * base_n), asc::te::make_shape(cur_step_k, cur_n)));
                    asc_unlock(PIPE_MTE2, l1_index);
                    asc_lock(PIPE_MTE1, l1_index);
                }
                asc_lock(PIPE_MTE1, l0_index);
                // L1A -> L0A
                asc::te::copy(
                    copy_l1_to_l0a_atom, l0a_tensor,
                    l1a_tensor.slice(
                        asc::te::make_coord(0, k_iter % step_k * base_k), asc::te::make_shape(cur_m, cur_k)));
                // L1B -> L0B
                asc::te::copy(
                    copy_l1_to_l0b_atom, l0b_tensor,
                    l1b_tensor.slice(
                        asc::te::make_coord(k_iter % step_k * base_k, 0), asc::te::make_shape(cur_k, cur_n)));
                if ((k_iter + 1) % step_k == 0 || k_iter + 1 == k_loop) {
                    asc_unlock(PIPE_MTE1, l1_index);
                }
                asc_unlock(PIPE_MTE1, l0_index);
                asc_lock(PIPE_M, l0_index);

                // Mmad
                if (k_iter == 0) {
                    asc_lock(PIPE_M, l0c_index);
                }

                asc::te::mmad_params para;
                para.m = cur_m;
                para.n = cur_n;
                para.k = cur_k;
                para.init_with_zero = (k_iter == 0) ? true : false;
                if constexpr (enable_unit_flag) {
                    para.unit_flag = (k_iter == k_loop - 1) ? asc::te::unit_flag_mode::enable_update :
                                                              asc::te::unit_flag_mode::enable_keep;
                }
                asc::te::mmad(mmad_atom.with(para), l0c_tensor, l0a_tensor, l0b_tensor);
                if (k_iter == k_loop - 1) {
                    asc_unlock(PIPE_M, l0c_index);
                }

                asc_unlock(PIPE_M, l0_index);
            }
            // L0C -> GM
            asc_lock(PIPE_MTE2, quant_index);
            auto gm_c_slice = gm_c_single_tensor.slice(
                asc::te::make_coord(i * base_m, j * base_n), asc::te::make_shape(cur_m, cur_n));
            auto l1_quant_tensor =
                asc::te::make_tensor(l1_quant_ptr, asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, cur_n));
            asc::te::copy(
                copy_gm_to_l1_atom, l1_quant_tensor,
                gm_quant_single_tensor.slice(asc::te::make_coord(0, j * base_n), asc::te::make_shape(1, cur_n)));
            asc_unlock(PIPE_MTE2, quant_index);
            asc_lock(PIPE_FIX, quant_index);

            asc_lock(PIPE_FIX, l0c_index);
            if constexpr (enable_unit_flag) {
                asc::te::l0c_to_gm_params params;
                params.unit_flag = asc::te::unit_flag_mode::enable_update;
                asc::te::copy(copy_l0c_to_gm_atom.with(params), gm_c_slice, l0c_tensor, l1_quant_tensor);
            } else {
                asc::te::copy(copy_l0c_to_gm_atom, gm_c_slice, l0c_tensor, l1_quant_tensor);
            }
            asc_unlock(PIPE_FIX, l0c_index);
            asc_unlock(PIPE_FIX, quant_index);
        }
    }
}

int32_t main(int32_t argc, char* argv[])
{
    using a_type = int8_t;
    using b_type = int8_t;
    using l0c_type = int32_t;
    using c_type = half;

    int32_t m = 1024;
    int32_t n = 1024;
    int32_t k = 256;
    int32_t single_core_m = 256;
    int32_t single_core_n = 128;
    int32_t single_core_k = 256;

    constexpr int32_t base_m = 256;
    constexpr int32_t base_n = 256;
    constexpr int32_t base_k = 64;
    constexpr int32_t step_m = 1;
    constexpr int32_t step_n = 1;
    constexpr int32_t step_k = 4;

    constexpr bool enable_unit_flag = true;
    constexpr uint32_t num_blocks = 32;

    size_t param1_file_size = m * k * sizeof(a_type);
    size_t param2_file_size = n * k * sizeof(b_type);
    size_t param3_file_size = m * n * sizeof(c_type);
    size_t param4_file_size = n * sizeof(uint64_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *x_host, *y_host, *z_host, *quant_host;
    a_type* x_device;
    b_type* y_device;
    c_type* z_device;
    uint64_t* quant_device;

    aclrtMallocHost((void**)(&x_host), param1_file_size);
    aclrtMallocHost((void**)(&y_host), param2_file_size);
    aclrtMallocHost((void**)(&z_host), param3_file_size);
    aclrtMallocHost((void**)(&quant_host), param4_file_size);
    aclrtMalloc((void**)&x_device, param1_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, param2_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, param3_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&quant_device, param4_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    read_file("./input/input_x.bin", param1_file_size, x_host, param1_file_size);
    read_file("./input/input_y.bin", param2_file_size, y_host, param2_file_size);
    read_file("./input/quant.bin", param4_file_size, quant_host, param4_file_size);

    aclrtMemcpy(x_device, param1_file_size, x_host, param1_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, param2_file_size, y_host, param2_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(quant_device, param4_file_size, quant_host, param4_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    mmad_quant_custom<
        a_type, b_type, l0c_type, c_type, base_m, base_n, base_k, step_m, step_n, step_k, enable_unit_flag>
        <<<num_blocks, 0, stream>>>(
            x_device, y_device, z_device, quant_device, m, n, k, single_core_m, single_core_n, single_core_k);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, param3_file_size, z_device, param3_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", z_host, param3_file_size);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFree(quant_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(z_host);
    aclrtFreeHost(quant_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return 0;
}
