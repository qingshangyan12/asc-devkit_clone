/* !
 * \file matmul.asc
 * \brief Static matrix multiplication based on Tensor API.
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

template <uint32_t M, uint32_t K, uint32_t N, uint32_t SingleCoreM, uint32_t BaseM, uint32_t BaseK, uint32_t BaseN>
__global__ __cube__ void matmul_custom(__gm__ half* a, __gm__ half* b, __gm__ half* c)
{
    constexpr uint32_t m = M;
    constexpr uint32_t k = K;
    constexpr uint32_t n = N;
    constexpr uint32_t single_core_m = SingleCoreM;
    constexpr uint32_t base_m = BaseM;
    constexpr uint32_t base_k = BaseK;
    constexpr uint32_t base_n = BaseN;
    asc_init();

    // Split the output matrix by m and n tiles across Cube cores.
    constexpr uint32_t m_iter = m / single_core_m;
    uint32_t m_iter_idx = block_idx % m_iter;
    uint32_t n_iter_idx = block_idx / m_iter;

    // Create GM tensors and slice the tile handled by the current core.
    auto gm_a =
        asc::te::make_tensor(asc::te::make_mem_ptr(a), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(m, k));
    auto gm_b =
        asc::te::make_tensor(asc::te::make_mem_ptr(b), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(k, n));
    auto gm_c =
        asc::te::make_tensor(asc::te::make_mem_ptr(c), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(m, n));

    auto global_a = gm_a.slice(asc::te::make_coord(m_iter_idx * single_core_m, 0), asc::te::make_shape(base_m, k));
    auto global_b = gm_b.slice(asc::te::make_coord(0, n_iter_idx * base_n), asc::te::make_shape(k, base_n));
    auto global_c = gm_c.slice(
        asc::te::make_coord(m_iter_idx * single_core_m, n_iter_idx * base_n), asc::te::make_shape(base_m, base_n));

    auto l1a_layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn>(base_m, k);
    auto l1b_layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn>(k, base_n);
    auto l0a_layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn>(base_m, base_k);
    auto l0b_layout = asc::te::make_frame_layout<asc::te::zn_layout_ptn>(base_k, base_n);
    auto l0c_layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn>(base_m, base_n);

    __cbuf__ half l1a_buf[base_m * k];
    __cbuf__ half l1b_buf[k * base_n];
    __ca__ half l0a_buf[base_m * base_k];
    __cb__ half l0b_buf[base_k * base_n];
    __cc__ float l0c_buf[base_m * base_n];

    auto l1a_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(l1a_buf), l1a_layout);
    auto l1b_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(l1b_buf), l1b_layout);
    auto l0a_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(l0a_buf), l0a_layout);
    auto l0b_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(l0b_buf), l0b_layout);
    auto l0c_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(l0c_buf), l0c_layout);

    auto copy_gm_to_l1_atom = asc::te::make_copy(asc::te::copy_gm_to_l1{}, asc::te::gm_to_l1_trait_default{});
    auto copy_l1_to_l0a_atom = asc::te::make_copy(asc::te::copy_l1_to_l0a{}, asc::te::l1_to_l0a_trait_default{});
    auto copy_l1_to_l0b_atom = asc::te::make_copy(asc::te::copy_l1_to_l0b{}, asc::te::l1_to_l0b_trait_default{});
    auto copy_l0c_to_gm_atom = asc::te::make_copy(asc::te::copy_l0c_to_gm{}, asc::te::l0c_to_gm_trait_default{});
    auto mmad_atom = asc::te::make_mmad(asc::te::mmad_operation{}, asc::te::mmad_trait_default{});

    constexpr uint32_t k_loop = k / base_k;
    constexpr uint32_t l1_index = 0;
    constexpr uint32_t l0_index = 1;
    constexpr uint32_t l0c_index = 2;

    asc_lock(PIPE_M, l0c_index);
    // Move the current core's full A/B tiles from GM to L1 once.
    asc_lock(PIPE_MTE2, l1_index);
    asc::te::copy(copy_gm_to_l1_atom, l1a_tensor, global_a);
    asc::te::copy(copy_gm_to_l1_atom, l1b_tensor, global_b);
    asc_unlock(PIPE_MTE2, l1_index);
    asc_lock(PIPE_MTE1, l1_index);

    for (uint32_t k_iter = 0; k_iter < k_loop; ++k_iter) {
        // Load one k tile from L1 to L0, then accumulate it into L0C.
        asc_lock(PIPE_MTE1, l0_index);
        asc::te::copy(
            copy_l1_to_l0a_atom, l0a_tensor,
            l1a_tensor.slice(asc::te::make_coord(0, k_iter * base_k), asc::te::make_shape(base_m, base_k)));
        asc::te::copy(
            copy_l1_to_l0b_atom, l0b_tensor,
            l1b_tensor.slice(asc::te::make_coord(k_iter * base_k, 0), asc::te::make_shape(base_k, base_n)));
        asc_unlock(PIPE_MTE1, l0_index);
        asc_lock(PIPE_M, l0_index);

        asc::te::mmad_params para{base_m, base_n, base_k, asc::te::unit_flag_mode::disable, k_iter == 0};
        asc::te::mmad(mmad_atom.with(para), l0c_tensor, l0a_tensor, l0b_tensor);

        asc_unlock(PIPE_M, l0_index);
    }
    asc_unlock(PIPE_MTE1, l1_index);
    asc_unlock(PIPE_M, l0c_index);
    // Store the completed output tile from L0C back to GM.
    asc_lock(PIPE_FIX, l0c_index);
    asc::te::copy(copy_l0c_to_gm_atom, global_c, l0c_tensor);
    asc_unlock(PIPE_FIX, l0c_index);
}

int32_t main(int32_t argc, char* argv[])
{
    // matmul参数
    constexpr uint32_t m = 512;
    constexpr uint32_t k = 512;
    constexpr uint32_t n = 1024;
    // 矩阵乘执行单元Tile参数
    constexpr uint32_t base_m = 128;
    constexpr uint32_t base_k = 64;
    constexpr uint32_t base_n = 256;

    size_t a_file_size = m * k * sizeof(half);
    size_t b_file_size = k * n * sizeof(half);
    size_t c_file_size = m * n * sizeof(half);
    uint32_t num_blocks = 16;

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* a_host;
    half* a_device;
    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    half* b_host;
    half* b_device;
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    half* c_host;
    half* c_device;
    aclrtMallocHost((void**)(&c_host), c_file_size);
    aclrtMalloc((void**)&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_custom<m, k, n, base_m, base_m, base_k, base_n><<<num_blocks, 0, stream>>>(a_device, b_device, c_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
