/* !
 * \file batch_matmul.asc
 * \brief 本样例介绍基于Tensor API实现带batch的矩阵乘法。
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "utils/std/cmath.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

template <typename T, uint32_t B, uint32_t M, uint32_t K, uint32_t N, uint32_t L1BatchSize, uint32_t L0BatchSize>
__global__ __cube__ void batch_matmul(__gm__ T* a, __gm__ T* b, __gm__ T* c, __gm__ T* bias)
{
    using data_type = T;
    constexpr uint32_t batch = B;
    constexpr uint32_t m = M;
    constexpr uint32_t k = K;
    constexpr uint32_t n = N;
    constexpr uint32_t l1_batch_capacity = L1BatchSize;
    constexpr uint32_t l0_batch_capacity = L0BatchSize;
    asc_init();

    constexpr uint32_t c0 = 32 / sizeof(data_type);
    constexpr uint32_t l1_a_size = AscendC::Std::ceil_align(m, 16) * AscendC::Std::ceil_align(k, c0);
    constexpr uint32_t l1_b_size = AscendC::Std::ceil_align(k, 16) * AscendC::Std::ceil_align(n, c0);
    constexpr uint32_t l0_a_size = l1_a_size;
    constexpr uint32_t l0_b_size = AscendC::Std::ceil_align(k, c0) * AscendC::Std::ceil_align(n, 16);
    constexpr uint32_t l0_c_size = AscendC::Std::ceil_align(m, 16) * AscendC::Std::ceil_align(n, 16);

    uint32_t block_index = block_idx;
    uint32_t single_core_b = batch / block_num;
    uint32_t single_core_res_b = batch % block_num;
    uint32_t actual_single_core_b = single_core_b + (single_core_res_b > block_index ? 1 : 0);
    uint32_t b_index_start = single_core_b * block_index + min(block_index, single_core_res_b);
    uint32_t b_index_end = actual_single_core_b + b_index_start;

    auto gm_a = asc::te::make_tensor(
        asc::te::make_mem_ptr(a), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(batch, m, k));
    auto gm_b = asc::te::make_tensor(
        asc::te::make_mem_ptr(b), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(batch, k, n));
    auto gm_c = asc::te::make_tensor(
        asc::te::make_mem_ptr(c), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(batch, m, n));
    auto gm_bias = asc::te::make_tensor(
        asc::te::make_mem_ptr(bias), asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(batch, 1, n));

    __cbuf__ data_type l1a_buf[l1_batch_capacity * l1_a_size];
    __cbuf__ data_type l1b_buf[l1_batch_capacity * l1_b_size];
    __cbuf__ data_type l1_bias_buf[l1_batch_capacity * n];
    __ca__ data_type l0a_buf[l0_batch_capacity * l0_a_size];
    __cb__ data_type l0b_buf[l0_batch_capacity * l0_b_size];
    __cc__ float l0c_buf[l0_batch_capacity * l0_c_size];
    __biasbuf__ float l0_bias_buf[l0_batch_capacity * n];

    auto l1a_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l1a_buf),
        asc::te::make_frame_layout<asc::te::nz_layout_ptn, data_type>(l1_batch_capacity, m, k));
    auto l1b_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l1b_buf),
        asc::te::make_frame_layout<asc::te::nz_layout_ptn, data_type>(l1_batch_capacity, k, n));
    auto l1_bias_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l1_bias_buf),
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, data_type>(l1_batch_capacity, 1, n));
    auto l0a_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l0a_buf),
        asc::te::make_frame_layout<asc::te::nz_layout_ptn, data_type>(l0_batch_capacity, m, k));
    auto l0b_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l0b_buf),
        asc::te::make_frame_layout<asc::te::zn_layout_ptn, data_type>(l0_batch_capacity, k, n));
    auto l0c_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l0c_buf), asc::te::make_frame_layout<asc::te::nz_layout_ptn>(l0_batch_capacity, m, n));
    auto l0_bias_tensor = asc::te::make_tensor(
        asc::te::make_mem_ptr(l0_bias_buf),
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(l0_batch_capacity, 1, n));

    auto copy_gm_to_l1_atom = asc::te::make_copy(asc::te::copy_gm_to_l1{}, asc::te::gm_to_l1_trait_default{});
    auto copy_l1_to_l0a_atom = asc::te::make_copy(asc::te::copy_l1_to_l0a{}, asc::te::l1_to_l0a_trait_default{});
    auto copy_l1_to_l0b_atom = asc::te::make_copy(asc::te::copy_l1_to_l0b{}, asc::te::l1_to_l0b_trait_default{});
    auto copy_l1_to_biastable_atom =
        asc::te::make_copy(asc::te::copy_l1_to_biastable{}, asc::te::l1_to_biastable_trait_default{});
    auto copy_l0c_to_gm_atom = asc::te::make_copy(asc::te::copy_l0c_to_gm{}, asc::te::l0c_to_gm_trait_default{});
    auto mmad_atom = asc::te::make_mmad(asc::te::mmad_operation{}, asc::te::mmad_trait_default{});

    constexpr uint32_t l1_index = 0;
    constexpr uint32_t l0_index = 1;
    constexpr uint32_t l0c_index = 2;
    for (uint32_t l1_batch_index = b_index_start; l1_batch_index < b_index_end; l1_batch_index += l1_batch_capacity) {
        asc_lock(PIPE_MTE2, l1_index);
        uint32_t l1_batch_size = min(l1_batch_capacity, b_index_end - l1_batch_index);
        asc::te::copy(
            copy_gm_to_l1_atom, l1a_tensor,
            gm_a.slice(
                asc::te::make_coord(l1_batch_index, asc::te::make_coord(0, 0)),
                asc::te::make_shape(l1_batch_size, asc::te::make_shape(m, k))));
        asc::te::copy(
            copy_gm_to_l1_atom, l1b_tensor,
            gm_b.slice(
                asc::te::make_coord(l1_batch_index, asc::te::make_coord(0, 0)),
                asc::te::make_shape(l1_batch_size, asc::te::make_shape(k, n))));
        asc::te::copy(
            copy_gm_to_l1_atom, l1_bias_tensor,
            gm_bias.slice(
                asc::te::make_coord(l1_batch_index, asc::te::make_coord(0, 0)),
                asc::te::make_shape(l1_batch_size, asc::te::make_shape(1, n))));
        asc_unlock(PIPE_MTE2, l1_index);
        asc_lock(PIPE_MTE1, l1_index);
        for (uint32_t l0_batch_index = 0; l0_batch_index < l1_batch_size; l0_batch_index += l0_batch_capacity) {
            asc_lock(PIPE_MTE1, l0_index);
            uint32_t l0_batch_size = min(l0_batch_capacity, l1_batch_size - l0_batch_index);
            asc::te::copy(
                copy_l1_to_l0a_atom, l0a_tensor,
                l1a_tensor.slice(
                    asc::te::make_coord(l0_batch_index, asc::te::make_coord(0, 0)),
                    asc::te::make_shape(l0_batch_size, asc::te::make_shape(m, k))));
            asc::te::copy(
                copy_l1_to_l0b_atom, l0b_tensor,
                l1b_tensor.slice(
                    asc::te::make_coord(l0_batch_index, asc::te::make_coord(0, 0)),
                    asc::te::make_shape(l0_batch_size, asc::te::make_shape(k, n))));
            asc::te::copy(
                copy_l1_to_biastable_atom, l0_bias_tensor,
                l1_bias_tensor.slice(
                    asc::te::make_coord(l0_batch_index, asc::te::make_coord(0, 0)),
                    asc::te::make_shape(l0_batch_size, asc::te::make_shape(1, n))));
            asc_unlock(PIPE_MTE1, l0_index);
            asc_lock(PIPE_M, l0_index);
            asc_lock(PIPE_M, l0c_index);
            for (uint32_t l0c_batch_index = 0; l0c_batch_index < l0_batch_size; l0c_batch_index++) {
                asc::te::mmad(
                    mmad_atom.with(asc::te::mmad_params{
                        static_cast<uint16_t>(m), static_cast<uint16_t>(n), static_cast<uint16_t>(k),
                        asc::te::unit_flag_mode::disable, true}),
                    l0c_tensor.slice(
                        asc::te::make_coord(l0c_batch_index, asc::te::make_coord(0, 0)),
                        asc::te::make_shape(1, asc::te::make_shape(m, n))),
                    l0a_tensor.slice(
                        asc::te::make_coord(l0c_batch_index, asc::te::make_coord(0, 0)),
                        asc::te::make_shape(1, asc::te::make_shape(m, k))),
                    l0b_tensor.slice(
                        asc::te::make_coord(l0c_batch_index, asc::te::make_coord(0, 0)),
                        asc::te::make_shape(1, asc::te::make_shape(k, n))),
                    l0_bias_tensor.slice(
                        asc::te::make_coord(l0c_batch_index, asc::te::make_coord(0, 0)),
                        asc::te::make_shape(1, asc::te::make_shape(1, n))));
            }
            asc_unlock(PIPE_M, l0_index);
            asc_unlock(PIPE_M, l0c_index);
            asc_lock(PIPE_FIX, l0c_index);
            asc::te::copy(
                copy_l0c_to_gm_atom,
                gm_c.slice(
                    asc::te::make_coord(l1_batch_index + l0_batch_index, asc::te::make_coord(0, 0)),
                    asc::te::make_shape(l0_batch_size, asc::te::make_shape(m, n))),
                l0c_tensor);
            asc_unlock(PIPE_FIX, l0c_index);
        }
        asc_unlock(PIPE_MTE1, l1_index);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    using data_type = half;
    constexpr uint32_t batch_size = 128;
    constexpr uint32_t m = 32;
    constexpr uint32_t k = 32;
    constexpr uint32_t n = 32;
    constexpr uint32_t l1_batch_size = 32;
    constexpr uint32_t l0_batch_size = 4;

    size_t a_file_size = batch_size * m * k * sizeof(data_type);
    size_t b_file_size = batch_size * k * n * sizeof(data_type);
    size_t c_file_size = batch_size * m * n * sizeof(data_type);
    size_t bias_file_size = batch_size * 1 * n * sizeof(data_type);

    uint32_t num_blocks = 32;

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host;
    data_type* a_device;
    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host;
    data_type* b_device;
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bias_host;
    data_type* bias_device;
    aclrtMallocHost((void**)(&bias_host), bias_file_size);
    aclrtMalloc((void**)&bias_device, bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/bias.bin", bias_file_size, bias_host, bias_file_size);
    aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host;
    data_type* c_device;
    aclrtMallocHost((void**)(&c_host), c_file_size);
    aclrtMalloc((void**)&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    batch_matmul<data_type, batch_size, m, k, n, l1_batch_size, l0_batch_size>
        <<<num_blocks, 0, stream>>>(a_device, b_device, c_device, bias_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
    aclrtFree(bias_device);
    aclrtFreeHost(bias_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
