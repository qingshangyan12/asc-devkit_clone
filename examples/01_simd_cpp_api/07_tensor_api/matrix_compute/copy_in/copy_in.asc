/* !
 * \file copy_in.asc
 * \brief copy_in
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

struct matmul_tiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t single_core_m;
    int32_t single_core_n;
    int32_t single_core_k;
};

struct core_iter_info {
    uint32_t m_iter;
    uint32_t m_iter_idx;
    uint32_t n_iter_idx;
    int32_t actual_single_core_m;
    int32_t actual_single_core_n;
};

// Copy tiling information from GM to a local struct
__aicore__ inline void copy_tiling_from_gm(__gm__ matmul_tiling* src_info, matmul_tiling& dst_info)
{
    auto src_ptr = reinterpret_cast<__gm__ int32_t*>(src_info);
    auto dst_ptr = reinterpret_cast<int32_t*>(&dst_info);
    for (size_t i = 0; i < sizeof(matmul_tiling) / sizeof(int32_t); ++i) {
        dst_ptr[i] = src_ptr[i];
    }
}

// Calculate iteration information for the current core from tiling parameters and the core index
__aicore__ inline core_iter_info calc_core_iter_info(const matmul_tiling& tiling)
{
    uint32_t m_iter = (tiling.m + tiling.single_core_m - 1) / tiling.single_core_m;
    uint32_t m_iter_idx = block_idx % m_iter;
    uint32_t n_iter_idx = block_idx / m_iter;
    int32_t actual_single_core_m = tiling.m - m_iter_idx * tiling.single_core_m;
    actual_single_core_m = actual_single_core_m < tiling.single_core_m ? actual_single_core_m : tiling.single_core_m;
    int32_t actual_single_core_n = tiling.n - n_iter_idx * tiling.single_core_n;
    actual_single_core_n = actual_single_core_n < tiling.single_core_n ? actual_single_core_n : tiling.single_core_n;
    return {m_iter, m_iter_idx, n_iter_idx, actual_single_core_m, actual_single_core_n};
}

template <
    typename AType, typename BType, typename CType, typename BiasType, int32_t BaseM, int32_t BaseN, int32_t BaseK,
    int32_t StepM, int32_t StepN, int32_t StepK>
__cube__ __global__ void copy_in(
    __gm__ AType* x, __gm__ BType* y, __gm__ CType* z, __gm__ BiasType* bias, __gm__ matmul_tiling* tiling_info)
{
    using a_type = AType;
    using b_type = BType;
    using c_type = CType;
    using bias_type = BiasType;
    constexpr int32_t base_m = BaseM;
    constexpr int32_t base_n = BaseN;
    constexpr int32_t base_k = BaseK;
    constexpr int32_t step_m = StepM;
    constexpr int32_t step_n = StepN;
    constexpr int32_t step_k = StepK;
    asc_init();

    // 1. Copy tiling information from GM
    matmul_tiling tiling;
    copy_tiling_from_gm(tiling_info, tiling);

    // 2. Select layout and data types based on SCENARIO_NUM
    constexpr uint32_t scenario_num = SCENARIO_NUM;
    using gm_layout = typename AscendC::Std::conditional_t<
        (scenario_num < 2), asc::te::nd_ext_layout_ptn, asc::te::dn_ext_layout_ptn>;
    using l1_layout =
        typename AscendC::Std::conditional_t<(scenario_num < 2), asc::te::nz_layout_ptn, asc::te::zn_layout_ptn>;

    // 3. Calculate iteration information for the current core
    core_iter_info iter_info = calc_core_iter_info(tiling);

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t single_core_m = tiling.single_core_m;
    int32_t single_core_n = tiling.single_core_n;
    int32_t single_core_k = tiling.single_core_k;

    // 4. Create GM tensors and slices
    auto gm_ptr_a = asc::te::make_mem_ptr(x);
    auto gm_ptr_b = asc::te::make_mem_ptr(y);
    auto gm_ptr_c = asc::te::make_mem_ptr(z);
    auto gm_ptr_bias = asc::te::make_mem_ptr(bias);

    auto gm_a = asc::te::make_tensor(gm_ptr_a, asc::te::make_frame_layout<gm_layout>(m, k));
    auto gm_b = asc::te::make_tensor(gm_ptr_b, asc::te::make_frame_layout<gm_layout>(k, n));
    auto gm_c = asc::te::make_tensor(gm_ptr_c, asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(m, n));
    auto gm_bias = asc::te::make_tensor(gm_ptr_bias, asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, n));

    // Slice the current single-core data block from the complete GM tensors.
    auto global_a = gm_a.slice(
        asc::te::make_coord(iter_info.m_iter_idx * single_core_m, 0),
        asc::te::make_shape(iter_info.actual_single_core_m, single_core_k));
    auto global_b = gm_b.slice(
        asc::te::make_coord(0, iter_info.n_iter_idx * single_core_n),
        asc::te::make_shape(single_core_k, iter_info.actual_single_core_n));
    auto global_c = gm_c.slice(
        asc::te::make_coord(iter_info.m_iter_idx * single_core_m, iter_info.n_iter_idx * single_core_n),
        asc::te::make_shape(iter_info.actual_single_core_m, iter_info.actual_single_core_n));
    auto global_bias = gm_bias.slice(
        asc::te::make_coord(0, iter_info.n_iter_idx * single_core_n),
        asc::te::make_shape(1, iter_info.actual_single_core_n));

    // 5. Create L1 tensors
    auto l1a_layout = asc::te::make_frame_layout<l1_layout, a_type>(base_m * step_m, base_k * step_k);
    auto l1b_layout = asc::te::make_frame_layout<l1_layout, b_type>(base_k * step_k, base_n * step_n);
    auto l1_bias_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, base_n * step_n);

    __cbuf__ a_type l1a_buf[base_m * step_m * base_k * step_k];
    __cbuf__ b_type l1b_buf[base_k * step_k * base_n * step_n];
    __cbuf__ bias_type l1_bias_buf[base_n * step_n];
    __ca__ a_type l0a_buf[base_m * base_k];
    __cb__ b_type l0b_buf[base_k * base_n];
    __biasbuf__ bias_type l0_bias_buf[base_n];
    __cc__ c_type l0c_buf[base_m * base_n];

    auto l1a_ptr = asc::te::make_mem_ptr(l1a_buf);
    auto l1b_ptr = asc::te::make_mem_ptr(l1b_buf);
    auto l1_bias_ptr = asc::te::make_mem_ptr(l1_bias_buf);
    auto l0a_ptr = asc::te::make_mem_ptr(l0a_buf);
    auto l0b_ptr = asc::te::make_mem_ptr(l0b_buf);
    auto l0_bias_ptr = asc::te::make_mem_ptr(l0_bias_buf);
    auto l0c_ptr = asc::te::make_mem_ptr(l0c_buf);

    auto l1a_tensor = asc::te::make_tensor(l1a_ptr, l1a_layout);
    auto l1b_tensor = asc::te::make_tensor(l1b_ptr, l1b_layout);
    auto l1_bias_tensor = asc::te::make_tensor(l1_bias_ptr, l1_bias_layout);
    auto copy_gm_to_l1_atom = asc::te::make_copy(asc::te::copy_gm_to_l1{}, asc::te::gm_to_l1_trait_default{});
    auto copy_l1_to_biastable_atom =
        asc::te::make_copy(asc::te::copy_l1_to_biastable{}, asc::te::l1_to_biastable_trait_default{});
    auto copy_l1_to_l0a_atom = asc::te::make_copy(asc::te::copy_l1_to_l0a{}, asc::te::l1_to_l0a_trait_default{});
    auto copy_l1_to_l0b_atom = asc::te::make_copy(asc::te::copy_l1_to_l0b{}, asc::te::l1_to_l0b_trait_default{});
    auto copy_l0c_to_gm_atom = asc::te::make_copy(asc::te::copy_l0c_to_gm{}, asc::te::l0c_to_gm_trait_default{});
    auto mmad_atom = asc::te::make_mmad(asc::te::mmad_operation{}, asc::te::mmad_trait_default{});

    // 6. Calculate loop counts
    uint32_t m_loop = (iter_info.actual_single_core_m + base_m - 1) / base_m;
    uint32_t n_loop = (iter_info.actual_single_core_n + base_n - 1) / base_n;
    uint32_t k_loop = (single_core_k + base_k - 1) / base_k;
    uint32_t tile_m = (iter_info.actual_single_core_m % base_m != 0) ? iter_info.actual_single_core_m % base_m : base_m;
    uint32_t tile_n = (iter_info.actual_single_core_n % base_n != 0) ? iter_info.actual_single_core_n % base_n : base_n;
    uint32_t tile_k = (single_core_k % base_k != 0) ? single_core_k % base_k : base_k;

    constexpr uint32_t l1_index = 0;
    constexpr uint32_t l0_index = 1;
    constexpr uint32_t l0c_index = 2;
    constexpr uint32_t l1_bias_index = 3;
    constexpr uint32_t l0_bias_index = 4;

    // 7. Main compute loop
    for (uint32_t i = 0; i < m_loop; i++) {
        uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
        for (uint32_t j = 0; j < n_loop; j++) {
            uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
            auto l0c_layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn>(cur_m, cur_n);
            auto l0_bias_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, cur_n);
            auto l0c_tensor = asc::te::make_tensor(l0c_ptr, l0c_layout);
            auto l0_bias_tensor = asc::te::make_tensor(l0_bias_ptr, l0_bias_layout);

            // Move bias along the N dimension once, first from GM to L1
            asc_lock(PIPE_MTE2, l1_bias_index);
            asc::te::copy(
                copy_gm_to_l1_atom, l1_bias_tensor,
                global_bias.slice(asc::te::make_coord(0, j * base_n), asc::te::make_shape(1, cur_n)));
            asc_unlock(PIPE_MTE2, l1_bias_index);
            asc_lock(PIPE_MTE1, l1_bias_index);
            // Move bias along the N dimension once from L1 to BT for the first Mmad of this N tile
            asc_lock(PIPE_MTE1, l0_bias_index);
            asc::te::copy(
                copy_l1_to_biastable_atom, l0_bias_tensor,
                l1_bias_tensor.slice(asc::te::make_coord(0, 0), asc::te::make_shape(1, cur_n)));
            asc_unlock(PIPE_MTE1, l0_bias_index);
            asc_unlock(PIPE_MTE1, l1_bias_index);

            for (uint32_t k_iter = 0; k_iter < k_loop; k_iter++) {
                uint16_t cur_k = (k_iter + 1 == k_loop) ? tile_k : base_k;
                auto l0a_layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn, a_type>(cur_m, cur_k);
                auto l0b_layout = asc::te::make_frame_layout<asc::te::zn_layout_ptn, b_type>(cur_k, cur_n);
                auto l0a_tensor = asc::te::make_tensor(l0a_ptr, l0a_layout);
                auto l0b_tensor = asc::te::make_tensor(l0b_ptr, l0b_layout);

                // GM -> L1
                if (k_iter % step_k == 0) {
                    uint16_t cur_step_k = static_cast<uint16_t>(single_core_k - k_iter * base_k);
                    cur_step_k = cur_step_k < base_k * step_k ? cur_step_k : base_k * step_k;
                    asc_lock(PIPE_MTE2, l1_index);
                    asc::te::copy(
                        copy_gm_to_l1_atom, l1a_tensor,
                        global_a.slice(
                            asc::te::make_coord(i * base_m, k_iter * base_k), asc::te::make_shape(cur_m, cur_step_k)));
                    asc::te::copy(
                        copy_gm_to_l1_atom, l1b_tensor,
                        global_b.slice(
                            asc::te::make_coord(k_iter * base_k, j * base_n), asc::te::make_shape(cur_step_k, cur_n)));
                    asc_unlock(PIPE_MTE2, l1_index);
                    asc_lock(PIPE_MTE1, l1_index);
                }

                // L1 -> L0
                asc_lock(PIPE_MTE1, l0_index);
                asc::te::copy(
                    copy_l1_to_l0a_atom, l0a_tensor,
                    l1a_tensor.slice(
                        asc::te::make_coord(0, k_iter % step_k * base_k), asc::te::make_shape(cur_m, cur_k)));
                asc::te::copy(
                    copy_l1_to_l0b_atom, l0b_tensor,
                    l1b_tensor.slice(
                        asc::te::make_coord(k_iter % step_k * base_k, 0), asc::te::make_shape(cur_k, cur_n)));
                if ((k_iter + 1) % step_k == 0 || k_iter + 1 == k_loop) {
                    asc_unlock(PIPE_MTE1, l1_index);
                }
                asc_unlock(PIPE_MTE1, l0_index);
                asc_lock(PIPE_M, l0_index);

                if (k_iter == 0) {
                    asc_lock(PIPE_M, l0c_index);
                }

                // Mmad compute
                if (k_iter == 0) {
                    asc_lock(PIPE_M, l0_bias_index);
                    asc::te::mmad(
                        mmad_atom.with(
                            asc::te::mmad_params{cur_m, cur_n, cur_k, asc::te::unit_flag_mode::disable, true}),
                        l0c_tensor, l0a_tensor, l0b_tensor, l0_bias_tensor);
                    asc_unlock(PIPE_M, l0_bias_index);
                } else {
                    asc::te::mmad(
                        mmad_atom.with(
                            asc::te::mmad_params{cur_m, cur_n, cur_k, asc::te::unit_flag_mode::disable, false}),
                        l0c_tensor, l0a_tensor, l0b_tensor);
                }
                if (k_iter == k_loop - 1) {
                    asc_unlock(PIPE_M, l0c_index);
                }
                asc_unlock(PIPE_M, l0_index);
            }

            // L0C -> GM
            asc_lock(PIPE_FIX, l0c_index);
            asc::te::copy(
                copy_l0c_to_gm_atom,
                global_c.slice(asc::te::make_coord(i * base_m, j * base_n), asc::te::make_shape(cur_m, cur_n)),
                l0c_tensor);
            asc_unlock(PIPE_FIX, l0c_index);
        }
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t scenario_num = SCENARIO_NUM;
    using a_type = typename std::conditional_t<(scenario_num % 2 == 0), half, float>;
    using b_type = typename std::conditional_t<(scenario_num % 2 == 0), half, float>;
    using c_type = float;
    using bias_type = float;

    // Tiling info filled into struct (dynamic at runtime)
    matmul_tiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.single_core_m = 256;
    tiling.single_core_n = 128;
    tiling.single_core_k = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t base_m = 128;
    constexpr int32_t base_n = 128;
    constexpr int32_t base_k = 64;
    constexpr int32_t step_m = 1;
    constexpr int32_t step_n = 1;
    constexpr int32_t step_k = 4;

    constexpr uint32_t num_blocks = 32;

    size_t param1_file_size = tiling.m * tiling.k * sizeof(a_type);
    size_t param2_file_size = tiling.n * tiling.k * sizeof(b_type);
    size_t param3_file_size = tiling.m * tiling.n * sizeof(c_type);
    size_t param4_file_size = tiling.n * sizeof(bias_type);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *x_host, *y_host, *z_host, *bias_host;
    a_type* x_device;
    b_type* y_device;
    c_type* z_device;
    bias_type* bias_device;

    aclrtMallocHost((void**)(&x_host), param1_file_size);
    aclrtMallocHost((void**)(&y_host), param2_file_size);
    aclrtMallocHost((void**)(&z_host), param3_file_size);
    aclrtMallocHost((void**)(&bias_host), param4_file_size);
    aclrtMalloc((void**)&x_device, param1_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, param2_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, param3_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bias_device, param4_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    read_file("./input/input_x.bin", param1_file_size, x_host, param1_file_size);
    read_file("./input/input_y.bin", param2_file_size, y_host, param2_file_size);
    read_file("./input/bias.bin", param4_file_size, bias_host, param4_file_size);

    aclrtMemcpy(x_device, param1_file_size, x_host, param1_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, param2_file_size, y_host, param2_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, param4_file_size, bias_host, param4_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    matmul_tiling* tiling_host;
    matmul_tiling* tiling_device;
    aclrtMallocHost((void**)(&tiling_host), sizeof(matmul_tiling));
    aclrtMalloc((void**)&tiling_device, sizeof(matmul_tiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tiling_host = tiling;
    aclrtMemcpy(tiling_device, sizeof(matmul_tiling), tiling_host, sizeof(matmul_tiling), ACL_MEMCPY_HOST_TO_DEVICE);

    copy_in<a_type, b_type, c_type, bias_type, base_m, base_n, base_k, step_m, step_n, step_k>
        <<<num_blocks, 0, stream>>>(x_device, y_device, z_device, bias_device, tiling_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, param3_file_size, z_device, param3_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", z_host, param3_file_size);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFree(bias_device);
    aclrtFree(tiling_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(z_host);
    aclrtFreeHost(bias_host);
    aclrtFreeHost(tiling_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return 0;
}
