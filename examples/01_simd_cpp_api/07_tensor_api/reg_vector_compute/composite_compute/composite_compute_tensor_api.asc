#include <cstdint>
#include <fstream>
#include <iostream>
#include <string>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "tensor_api/tensor.h"

namespace example {

inline bool check_acl(aclError result, const char* api)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << api << " failed, error code: " << result << std::endl;
    return false;
}

class runtime {
public:
    runtime() = default;
    runtime(const runtime&) = delete;
    runtime& operator=(const runtime&) = delete;

    bool init()
    {
        if (!check_acl(aclInit(nullptr), "aclInit")) {
            return false;
        }
        initialized_ = true;
        if (!check_acl(aclrtSetDevice(device_id_), "aclrtSetDevice")) {
            return false;
        }
        device_set_ = true;
        return check_acl(aclrtCreateStream(&stream_), "aclrtCreateStream");
    }

    ~runtime()
    {
        if (stream_ != nullptr) {
            (void)aclrtDestroyStream(stream_);
        }
        if (device_set_) {
            (void)aclrtResetDevice(device_id_);
        }
        if (initialized_) {
            (void)aclFinalize();
        }
    }

    aclrtStream stream() const
    {
        return stream_;
    }

    bool synchronize() const
    {
        return check_acl(aclrtSynchronizeStream(stream_), "aclrtSynchronizeStream");
    }

private:
    int32_t device_id_ = 0;
    bool initialized_ = false;
    bool device_set_ = false;
    aclrtStream stream_ = nullptr;
};

template <typename T>
class buffer {
public:
    buffer() = default;
    buffer(const buffer&) = delete;
    buffer& operator=(const buffer&) = delete;

    bool allocate(size_t count)
    {
        bytes_ = count * sizeof(T);
        if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&host_), bytes_), "aclrtMallocHost")) {
            return false;
        }
        return check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&device_), bytes_, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }

    ~buffer()
    {
        if (device_ != nullptr) {
            (void)aclrtFree(device_);
        }
        if (host_ != nullptr) {
            (void)aclrtFreeHost(host_);
        }
    }

    bool load(const std::string& path)
    {
        std::ifstream file(path, std::ios::binary | std::ios::ate);
        if (!file.is_open() || static_cast<size_t>(file.tellg()) != bytes_) {
            std::cerr << "Unexpected input file: " << path << std::endl;
            return false;
        }
        file.seekg(0);
        return static_cast<bool>(file.read(reinterpret_cast<char*>(host_), bytes_));
    }

    bool save(const std::string& path) const
    {
        std::ofstream file(path, std::ios::binary | std::ios::trunc);
        return file.is_open() && static_cast<bool>(file.write(reinterpret_cast<const char*>(host_), bytes_));
    }

    bool copy_to_device() const
    {
        return check_acl(aclrtMemcpy(device_, bytes_, host_, bytes_, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device");
    }

    bool copy_to_host() const
    {
        return check_acl(aclrtMemcpy(host_, bytes_, device_, bytes_, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host");
    }

    bool load_to_device(const std::string& path, size_t count)
    {
        return allocate(count) && load(path) && copy_to_device();
    }

    bool save_from_device(const std::string& path) const
    {
        return copy_to_host() && save(path);
    }

    T* device() const
    {
        return device_;
    }

private:
    T* host_ = nullptr;
    T* device_ = nullptr;
    size_t bytes_ = 0;
};

} // namespace example

constexpr uint32_t vector_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_fma(
    InputTensor input_a, InputTensor input_b, InputTensor input_c, OutputTensor output)
{
    using data_type = typename InputTensor::data_type;

    auto mask = asc::te::make_mask<asc::te::mask_pattern::vl64, data_type>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto c = input_c.load(asc::te::make_coord(0, 0)).with_mask(mask);
    output.store(asc::te::make_coord(0, 0), asc::te::fma(a, b, c));
}

__global__ __vector__ void composite_compute_tensor_api(
    __gm__ half* half_input_a, __gm__ half* half_input_b, __gm__ half* half_input_c,
    __gm__ float* float_input_a, __gm__ float* float_input_b, __gm__ float* float_input_c,
    __gm__ half* half_output, __gm__ float* float_output)
{
    constexpr uint32_t half_bytes = vector_length * sizeof(half);
    constexpr uint32_t float_bytes = vector_length * sizeof(float);

    constexpr uint32_t half_input_a_offset = 0;
    constexpr uint32_t half_input_b_offset = half_input_a_offset + half_bytes;
    constexpr uint32_t half_input_c_offset = half_input_b_offset + half_bytes;
    constexpr uint32_t half_output_offset = half_input_c_offset + half_bytes;
    constexpr uint32_t float_input_a_offset = half_output_offset + half_bytes;
    constexpr uint32_t float_input_b_offset = float_input_a_offset + float_bytes;
    constexpr uint32_t float_input_c_offset = float_input_b_offset + float_bytes;
    constexpr uint32_t float_output_offset = float_input_c_offset + float_bytes;

    auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto half_input_a_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input_a), layout);
    auto half_input_b_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input_b), layout);
    auto half_input_c_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input_c), layout);
    auto float_input_a_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input_a), layout);
    auto float_input_b_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input_b), layout);
    auto float_input_c_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input_c), layout);
    auto half_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_output), layout);
    auto float_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_output), layout);

    auto half_input_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_a_offset), layout);
    auto half_input_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_b_offset), layout);
    auto half_input_c_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_c_offset), layout);
    auto half_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_output_offset), layout);
    auto float_input_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_a_offset), layout);
    auto float_input_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_b_offset), layout);
    auto float_input_c_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_c_offset), layout);
    auto float_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_output_offset), layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, half_input_a_ub, half_input_a_gm);
    asc::te::copy(copy_in, half_input_b_ub, half_input_b_gm);
    asc::te::copy(copy_in, half_input_c_ub, half_input_c_gm);
    asc::te::copy(copy_in, float_input_a_ub, float_input_a_gm);
    asc::te::copy(copy_in, float_input_b_ub, float_input_b_gm);
    asc::te::copy(copy_in, float_input_c_ub, float_input_c_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_fma(half_input_a_ub, half_input_b_ub, half_input_c_ub, half_output_ub);
    compute_fma(float_input_a_ub, float_input_b_ub, float_input_c_ub, float_output_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
    asc::te::copy(copy_out, half_output_gm, half_output_ub);
    asc::te::copy(copy_out, float_output_gm, float_output_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<half> half_input_a;
    example::buffer<half> half_input_b;
    example::buffer<half> half_input_c;
    example::buffer<float> float_input_a;
    example::buffer<float> float_input_b;
    example::buffer<float> float_input_c;
    example::buffer<half> half_output;
    example::buffer<float> float_output;
    if (!runtime.init() || !half_input_a.load_to_device("./input/half_input_a.bin", vector_length) ||
        !half_input_b.load_to_device("./input/half_input_b.bin", vector_length) ||
        !half_input_c.load_to_device("./input/half_input_c.bin", vector_length) ||
        !float_input_a.load_to_device("./input/float_input_a.bin", vector_length) ||
        !float_input_b.load_to_device("./input/float_input_b.bin", vector_length) ||
        !float_input_c.load_to_device("./input/float_input_c.bin", vector_length) ||
        !half_output.allocate(vector_length) || !float_output.allocate(vector_length)) {
        return 1;
    }

    composite_compute_tensor_api<<<1, 0, runtime.stream()>>>(
        half_input_a.device(), half_input_b.device(), half_input_c.device(),
        float_input_a.device(), float_input_b.device(), float_input_c.device(),
        half_output.device(), float_output.device());
    if (!runtime.synchronize() || !half_output.save_from_device("./output/half_output.bin") ||
        !float_output.save_from_device("./output/float_output.bin")) {
        return 1;
    }
    std::cout << "composite_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
