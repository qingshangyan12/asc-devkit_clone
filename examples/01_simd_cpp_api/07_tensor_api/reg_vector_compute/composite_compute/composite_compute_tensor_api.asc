/* !
 * \file composite_compute_tensor_api.asc
 * \brief composite_compute_tensor_api
 */

#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t vector_length = 64;
constexpr uint32_t half_vector_length = 128;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_fma(
    InputTensor input_a, InputTensor input_b, InputTensor input_c, OutputTensor output)
{
    auto mask = asc::te::make_mask<asc::te::mask_pattern::vl64, float>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto c = input_c.load(asc::te::make_coord(0, 0)).with_mask(mask);
    output.store(asc::te::make_coord(0, 0), asc::te::experimental::fma(a, b, c));
}

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_exp_diff(
    InputTensor input_a, InputTensor input_b, OutputTensor output_even, OutputTensor output_odd)
{
    auto mask = asc::te::make_mask<asc::te::mask_pattern::vl128, half>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);
    output_even.store(
        asc::te::make_coord(0, 0), asc::te::experimental::exp_diff(a, b, ASC_POSITION_EVEN));
    output_odd.store(
        asc::te::make_coord(0, 0), asc::te::experimental::exp_diff(a, b, ASC_POSITION_ODD));
}

__global__ __vector__ void composite_compute_tensor_api(
    __gm__ float* input_a, __gm__ float* input_b, __gm__ float* input_c, __gm__ float* output,
    __gm__ half* exp_input_a, __gm__ half* exp_input_b, __gm__ float* exp_output_even,
    __gm__ float* exp_output_odd)
{
    constexpr uint32_t tensor_bytes = vector_length * sizeof(float);
    constexpr uint32_t half_tensor_bytes = half_vector_length * sizeof(half);
    constexpr uint32_t input_a_offset = 0;
    constexpr uint32_t input_b_offset = input_a_offset + tensor_bytes;
    constexpr uint32_t input_c_offset = input_b_offset + tensor_bytes;
    constexpr uint32_t output_offset = input_c_offset + tensor_bytes;
    constexpr uint32_t exp_input_a_offset = output_offset + tensor_bytes;
    constexpr uint32_t exp_input_b_offset = exp_input_a_offset + half_tensor_bytes;
    constexpr uint32_t exp_output_even_offset = exp_input_b_offset + half_tensor_bytes;
    constexpr uint32_t exp_output_odd_offset = exp_output_even_offset + tensor_bytes;

    auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto half_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_128 {});
    auto input_a_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input_a), layout);
    auto input_b_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input_b), layout);
    auto input_c_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input_c), layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), layout);
    auto input_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(input_a_offset), layout);
    auto input_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(input_b_offset), layout);
    auto input_c_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(input_c_offset), layout);
    auto output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(output_offset), layout);
    auto exp_input_a_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(exp_input_a), half_layout);
    auto exp_input_b_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(exp_input_b), half_layout);
    auto exp_output_even_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(exp_output_even), layout);
    auto exp_output_odd_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(exp_output_odd), layout);
    auto exp_input_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(exp_input_a_offset), half_layout);
    auto exp_input_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(exp_input_b_offset), half_layout);
    auto exp_output_even_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(exp_output_even_offset), layout);
    auto exp_output_odd_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(exp_output_odd_offset), layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, input_a_ub, input_a_gm);
    asc::te::copy(copy_in, input_b_ub, input_b_gm);
    asc::te::copy(copy_in, input_c_ub, input_c_gm);
    asc::te::copy(copy_in, exp_input_a_ub, exp_input_a_gm);
    asc::te::copy(copy_in, exp_input_b_ub, exp_input_b_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_fma(input_a_ub, input_b_ub, input_c_ub, output_ub);
    compute_exp_diff(exp_input_a_ub, exp_input_b_ub, exp_output_even_ub, exp_output_odd_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
    asc::te::copy(copy_out, output_gm, output_ub);
    asc::te::copy(copy_out, exp_output_even_gm, exp_output_even_ub);
    asc::te::copy(copy_out, exp_output_odd_gm, exp_output_odd_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t tensor_bytes = vector_length * sizeof(float);
    size_t half_tensor_bytes = half_vector_length * sizeof(half);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* input_a_host = nullptr;
    float* input_b_host = nullptr;
    float* input_c_host = nullptr;
    float* output_host = nullptr;
    half* exp_input_a_host = nullptr;
    half* exp_input_b_host = nullptr;
    float* exp_output_even_host = nullptr;
    float* exp_output_odd_host = nullptr;
    float* input_a_device = nullptr;
    float* input_b_device = nullptr;
    float* input_c_device = nullptr;
    float* output_device = nullptr;
    half* exp_input_a_device = nullptr;
    half* exp_input_b_device = nullptr;
    float* exp_output_even_device = nullptr;
    float* exp_output_odd_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&input_a_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&input_b_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&input_c_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&exp_input_a_host), half_tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&exp_input_b_host), half_tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&exp_output_even_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&exp_output_odd_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_a_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&input_b_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&input_c_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&exp_input_a_device), half_tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&exp_input_b_device), half_tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&exp_output_even_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&exp_output_odd_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/input_a.bin", file_size, input_a_host, tensor_bytes);
    ReadFile("./input/input_b.bin", file_size, input_b_host, tensor_bytes);
    ReadFile("./input/input_c.bin", file_size, input_c_host, tensor_bytes);
    ReadFile("./input/exp_input_a.bin", file_size, exp_input_a_host, half_tensor_bytes);
    ReadFile("./input/exp_input_b.bin", file_size, exp_input_b_host, half_tensor_bytes);
    aclrtMemcpy(input_a_device, tensor_bytes, input_a_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input_b_device, tensor_bytes, input_b_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input_c_device, tensor_bytes, input_c_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(exp_input_a_device, half_tensor_bytes, exp_input_a_host, half_tensor_bytes,
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(exp_input_b_device, half_tensor_bytes, exp_input_b_host, half_tensor_bytes,
        ACL_MEMCPY_HOST_TO_DEVICE);

    composite_compute_tensor_api<<<1, nullptr, stream>>>(
        input_a_device, input_b_device, input_c_device, output_device, exp_input_a_device,
        exp_input_b_device, exp_output_even_device, exp_output_odd_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, tensor_bytes, output_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(exp_output_even_host, tensor_bytes, exp_output_even_device, tensor_bytes,
        ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(exp_output_odd_host, tensor_bytes, exp_output_odd_device, tensor_bytes,
        ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", output_host, tensor_bytes);
    WriteFile("./output/exp_output_even.bin", exp_output_even_host, tensor_bytes);
    WriteFile("./output/exp_output_odd.bin", exp_output_odd_host, tensor_bytes);

    aclrtFree(input_a_device);
    aclrtFree(input_b_device);
    aclrtFree(input_c_device);
    aclrtFree(output_device);
    aclrtFree(exp_input_a_device);
    aclrtFree(exp_input_b_device);
    aclrtFree(exp_output_even_device);
    aclrtFree(exp_output_odd_device);
    aclrtFreeHost(input_a_host);
    aclrtFreeHost(input_b_host);
    aclrtFreeHost(input_c_host);
    aclrtFreeHost(output_host);
    aclrtFreeHost(exp_input_a_host);
    aclrtFreeHost(exp_input_b_host);
    aclrtFreeHost(exp_output_even_host);
    aclrtFreeHost(exp_output_odd_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "composite_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
