#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t ROW = 16;
constexpr uint32_t COL = 16;
constexpr uint32_t TOTAL_LENGTH = ROW * COL;
constexpr uint8_t BUFFER_LOCK_ID = 0;

template <typename T, typename U>
__simd_vf__ inline void fill_vf(T y_tensor, U scalar,
    uint32_t repeat_times, uint32_t one_repeat_size)
{
    uint32_t count = TOTAL_LENGTH;
    using data_type = typename T::data_type;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        auto mask = asc::te::experimental::update_mask<data_type>(count);
        uint32_t offset = i * one_repeat_size;
        const auto coord = asc::te::make_coord(offset / COL, offset % COL);
        auto y_reg = asc::te::experimental::fill(scalar, mask);
        asc::te::experimental::store(y_tensor, coord, y_reg);
    }
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void process(__gm__ T* y)
    {
        auto layer_out = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(ROW, COL);
        auto y_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(y), layer_out);
        constexpr uint32_t y_offset = 0;
        auto y_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(y_offset), layer_out);
        T scalar = 1;
        constexpr uint32_t one_repeat_size = asc_get_vf_len() / sizeof(T);
        uint16_t repeat_times = static_cast<uint16_t>(
            AscendC::Std::ceil_align(TOTAL_LENGTH, one_repeat_size) / one_repeat_size);
        asc_lock(pipe_t::PIPE_V, BUFFER_LOCK_ID);
        fill_vf(y_ub, scalar, repeat_times, one_repeat_size);
        asc_unlock(pipe_t::PIPE_V, BUFFER_LOCK_ID);
        asc_lock(pipe_t::PIPE_MTE3, BUFFER_LOCK_ID);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), y_gm, y_ub);
        asc_unlock(pipe_t::PIPE_MTE3, BUFFER_LOCK_ID);
    }
};

template <typename T>
__global__ __vector__ void fill(__gm__ uint8_t* y)
{
    Kernel<T> kernel;
    kernel.process(reinterpret_cast<__gm__ T*>(y));
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed at index %zu: output is %lf, golden is %lf\n", i, a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t totalLength = TOTAL_LENGTH;
    size_t outputByteSize = static_cast<size_t>(1) * totalLength * sizeof(float);
    uint8_t* yHost;
    uint8_t* yDevice;
    aclrtMallocHost((void**)(&yHost), outputByteSize);
    aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    fill<float><<<numBlocks, 0, stream>>>(yDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(yHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(yDevice);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
