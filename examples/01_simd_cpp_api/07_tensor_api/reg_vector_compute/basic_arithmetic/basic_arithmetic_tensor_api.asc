#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t total_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_mull(
    InputTensor src0_tensor, InputTensor src1_tensor, OutputTensor low_tensor, OutputTensor high_tensor)
{
    constexpr uint32_t offset = 0;
    const auto coord = asc::te::make_coord(offset);
    auto mask = asc::te::experimental::all_mask<uint32_t>();
    auto src0 = asc::te::experimental::load(src0_tensor, coord).with_mask(mask);
    auto src1 = asc::te::experimental::load(src1_tensor, coord).with_mask(mask);
    asc::te::experimental::reg_tensor<uint32_t> high;
    auto low = asc::te::experimental::mull(high, src0, src1);
    asc::te::experimental::store(low_tensor, coord, low);
    asc::te::experimental::store(high_tensor, coord, high);
}

class Kernel {
public:
    __aicore__ inline void process(
        __gm__ uint32_t* src0, __gm__ uint32_t* src1, __gm__ uint32_t* low, __gm__ uint32_t* high)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(uint32_t);
        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = src0_offset + tensor_bytes;
        constexpr uint32_t low_offset = src1_offset + tensor_bytes;
        constexpr uint32_t high_offset = low_offset + tensor_bytes;

        auto copy_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, total_length);
        auto vector_layout = asc::te::make_layout(asc::te::make_shape(total_length));
        auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), copy_layout);
        auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), copy_layout);
        auto low_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(low), copy_layout);
        auto high_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(high), copy_layout);

        auto src0_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(src0_offset);
        auto src1_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(src1_offset);
        auto low_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(low_offset);
        auto high_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(high_offset);
        auto src0_copy_ub = asc::te::make_tensor(src0_mem, copy_layout);
        auto src1_copy_ub = asc::te::make_tensor(src1_mem, copy_layout);
        auto low_copy_ub = asc::te::make_tensor(low_mem, copy_layout);
        auto high_copy_ub = asc::te::make_tensor(high_mem, copy_layout);
        auto src0_ub = asc::te::make_tensor(src0_mem, vector_layout);
        auto src1_ub = asc::te::make_tensor(src1_mem, vector_layout);
        auto low_ub = asc::te::make_tensor(low_mem, vector_layout);
        auto high_ub = asc::te::make_tensor(high_mem, vector_layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
        asc::te::copy(copy_in, src0_copy_ub, src0_gm);
        asc::te::copy(copy_in, src1_copy_ub, src1_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        compute_mull(src0_ub, src1_ub, low_ub, high_ub);
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);

        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
        asc::te::copy(copy_out, low_gm, low_copy_ub);
        asc::te::copy(copy_out, high_gm, high_copy_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void basic_arithmetic_tensor_api(
    __gm__ uint32_t* src0, __gm__ uint32_t* src1, __gm__ uint32_t* low, __gm__ uint32_t* high)
{
    Kernel kernel;
    kernel.process(src0, src1, low, high);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t tensor_bytes = total_length * sizeof(uint32_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint32_t* src0_host = nullptr;
    uint32_t* src1_host = nullptr;
    uint32_t* low_host = nullptr;
    uint32_t* high_host = nullptr;
    uint32_t* src0_device = nullptr;
    uint32_t* src1_device = nullptr;
    uint32_t* low_device = nullptr;
    uint32_t* high_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&src0_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&src1_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&low_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&high_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&low_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&high_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/src0_input.bin", file_size, src0_host, tensor_bytes);
    ReadFile("./input/src1_input.bin", file_size, src1_host, tensor_bytes);
    aclrtMemcpy(src0_device, tensor_bytes, src0_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, tensor_bytes, src1_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    basic_arithmetic_tensor_api<<<1, nullptr, stream>>>(src0_device, src1_device, low_device, high_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(low_host, tensor_bytes, low_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(high_host, tensor_bytes, high_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/low_output.bin", low_host, tensor_bytes);
    WriteFile("./output/high_output.bin", high_host, tensor_bytes);

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(low_device);
    aclrtFree(high_device);
    aclrtFreeHost(src0_host);
    aclrtFreeHost(src1_host);
    aclrtFreeHost(low_host);
    aclrtFreeHost(high_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "basic_arithmetic_tensor_api executed successfully." << std::endl;
    return 0;
}
