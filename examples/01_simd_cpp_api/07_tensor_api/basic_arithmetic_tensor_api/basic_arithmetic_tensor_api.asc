#include <cstdint>
#include <iostream>

#include "c_api/sync/sync.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/basic_arithmetic.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t FLOAT_RESULT_ROWS = 28;
constexpr uint32_t UINT32_RESULT_ROWS = 10;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(float);
constexpr float ADD_SCALAR = 0.5f;
constexpr float SUB_SCALAR = 0.75f;
constexpr float MUL_SCALAR = 1.25f;
constexpr float DIV_SCALAR = 2.0f;
constexpr float MAX_SCALAR = 0.25f;
constexpr float MIN_SCALAR = -0.25f;

enum float_result_row : uint32_t {
    ROW_ABS,
    ROW_EXP,
    ROW_SQRT,
    ROW_LOG,
    ROW_LOG2,
    ROW_LOG10,
    ROW_NEG,
    ROW_RELU,
    ROW_PRELU,
    ROW_LEAKY_RELU,
    ROW_ADD_REG_REG,
    ROW_ADD_REG_SCALAR,
    ROW_ADD_SCALAR_REG,
    ROW_SUB_REG_REG,
    ROW_SUB_REG_SCALAR,
    ROW_SUB_SCALAR_REG,
    ROW_MUL_REG_REG,
    ROW_MUL_REG_SCALAR,
    ROW_MUL_SCALAR_REG,
    ROW_DIV_REG_REG,
    ROW_DIV_REG_SCALAR,
    ROW_DIV_SCALAR_REG,
    ROW_MAX_REG_REG,
    ROW_MAX_REG_SCALAR,
    ROW_MAX_SCALAR_REG,
    ROW_MIN_REG_REG,
    ROW_MIN_REG_SCALAR,
    ROW_MIN_SCALAR_REG,
};

enum uint32_result_row : uint32_t {
    ROW_ADD_LOW,
    ROW_ADD_CARRY,
    ROW_ADD_C_LOW,
    ROW_ADD_C_CARRY,
    ROW_SUB_LOW,
    ROW_SUB_CARRY,
    ROW_SUB_C_LOW,
    ROW_SUB_C_CARRY,
    ROW_MULL_LOW,
    ROW_MULL_HIGH,
};

__simd_vf__ inline void compute(
    __ubuf__ float* src_a, __ubuf__ float* src_b, __ubuf__ float* slope, __ubuf__ float* output)
{
    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(FLOAT_RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = asc::te::make_tensor(asc::te::make_mem_ptr(src_a), input_layout);
    auto input_b = asc::te::make_tensor(asc::te::make_mem_ptr(src_b), input_layout);
    auto slope_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(slope), input_layout);
    auto result = asc::te::make_tensor(asc::te::make_mem_ptr(output), output_layout);

    auto mask = asc::te::all_mask<float>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto slope_reg = slope_tensor.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto positive = asc::te::abs(a) + 0.5f;

    result.store(asc::te::make_coord(ROW_ABS, 0), asc::te::abs(a));
    result.store(asc::te::make_coord(ROW_EXP, 0), asc::te::exp(a));
    result.store(asc::te::make_coord(ROW_SQRT, 0), asc::te::sqrt(positive));
    result.store(asc::te::make_coord(ROW_LOG, 0), asc::te::log(positive));
    result.store(asc::te::make_coord(ROW_LOG2, 0), asc::te::log2(positive));
    result.store(asc::te::make_coord(ROW_LOG10, 0), asc::te::log10(positive));
    result.store(asc::te::make_coord(ROW_NEG, 0), -a);
    result.store(asc::te::make_coord(ROW_RELU, 0), asc::te::relu(a));
    result.store(asc::te::make_coord(ROW_PRELU, 0), asc::te::prelu(a, slope_reg));
    result.store(asc::te::make_coord(ROW_LEAKY_RELU, 0), asc::te::leaky_relu(a, 0.1f));

    // Exercise every register/scalar operand form provided by the binary APIs.
    result.store(asc::te::make_coord(ROW_ADD_REG_REG, 0), a + b);
    result.store(asc::te::make_coord(ROW_ADD_REG_SCALAR, 0), a + ADD_SCALAR);
    result.store(asc::te::make_coord(ROW_ADD_SCALAR_REG, 0), ADD_SCALAR + a);
    result.store(asc::te::make_coord(ROW_SUB_REG_REG, 0), a - b);
    result.store(asc::te::make_coord(ROW_SUB_REG_SCALAR, 0), a - SUB_SCALAR);
    result.store(asc::te::make_coord(ROW_SUB_SCALAR_REG, 0), SUB_SCALAR - a);
    result.store(asc::te::make_coord(ROW_MUL_REG_REG, 0), a * b);
    result.store(asc::te::make_coord(ROW_MUL_REG_SCALAR, 0), a * MUL_SCALAR);
    result.store(asc::te::make_coord(ROW_MUL_SCALAR_REG, 0), MUL_SCALAR * a);
    result.store(asc::te::make_coord(ROW_DIV_REG_REG, 0), a / b);
    result.store(asc::te::make_coord(ROW_DIV_REG_SCALAR, 0), a / DIV_SCALAR);
    result.store(asc::te::make_coord(ROW_DIV_SCALAR_REG, 0), DIV_SCALAR / positive);
    result.store(asc::te::make_coord(ROW_MAX_REG_REG, 0), asc::te::max(a, b));
    result.store(asc::te::make_coord(ROW_MAX_REG_SCALAR, 0), asc::te::max(a, MAX_SCALAR));
    result.store(asc::te::make_coord(ROW_MAX_SCALAR_REG, 0), asc::te::max(MAX_SCALAR, a));
    result.store(asc::te::make_coord(ROW_MIN_REG_REG, 0), asc::te::min(a, b));
    result.store(asc::te::make_coord(ROW_MIN_REG_SCALAR, 0), asc::te::min(a, MIN_SCALAR));
    result.store(asc::te::make_coord(ROW_MIN_SCALAR_REG, 0), asc::te::min(MIN_SCALAR, a));
}

__simd_callee__ inline asc::te::reg_tensor<uint32_t> predicate_to_uint32(
    const asc::te::reg_tensor<bool>& predicate)
{
    asc::te::reg_tensor<uint32_t> result {predicate.mask};
    result = 0U;
    asc_duplicate_scalar(result.reg, 1U, predicate.reg);
    return result;
}

__simd_vf__ inline void compute_uint32(
    __ubuf__ uint32_t* src_a, __ubuf__ uint32_t* src_b, __ubuf__ uint32_t* output)
{
    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(UINT32_RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = asc::te::make_tensor(asc::te::make_mem_ptr(src_a), input_layout);
    auto input_b = asc::te::make_tensor(asc::te::make_mem_ptr(src_b), input_layout);
    auto result = asc::te::make_tensor(asc::te::make_mem_ptr(output), output_layout);

    auto mask = asc::te::all_mask<uint32_t>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);

    asc::te::reg_tensor<bool> add_carry;
    auto add_low = asc::te::add(add_carry, a, b);
    asc::te::reg_tensor<bool> add_c_carry;
    auto add_c_low = asc::te::add_c(add_c_carry, a, b, add_carry);

    asc::te::reg_tensor<bool> sub_carry;
    auto sub_low = asc::te::sub(sub_carry, a, b);
    asc::te::reg_tensor<bool> sub_c_carry;
    auto sub_c_low = asc::te::sub_c(sub_c_carry, a, b, sub_carry);

    asc::te::reg_tensor<uint32_t> mull_high;
    auto mull_low = asc::te::mull(mull_high, a, b);

    result.store(asc::te::make_coord(ROW_ADD_LOW, 0), add_low);
    result.store(asc::te::make_coord(ROW_ADD_CARRY, 0), predicate_to_uint32(add_carry));
    result.store(asc::te::make_coord(ROW_ADD_C_LOW, 0), add_c_low);
    result.store(asc::te::make_coord(ROW_ADD_C_CARRY, 0), predicate_to_uint32(add_c_carry));
    result.store(asc::te::make_coord(ROW_SUB_LOW, 0), sub_low);
    result.store(asc::te::make_coord(ROW_SUB_CARRY, 0), predicate_to_uint32(sub_carry));
    result.store(asc::te::make_coord(ROW_SUB_C_LOW, 0), sub_c_low);
    result.store(asc::te::make_coord(ROW_SUB_C_CARRY, 0), predicate_to_uint32(sub_c_carry));
    result.store(asc::te::make_coord(ROW_MULL_LOW, 0), mull_low);
    result.store(asc::te::make_coord(ROW_MULL_HIGH, 0), mull_high);
}

__global__ __vector__ void basic_arithmetic_tensor_api(
    __gm__ float* src_a, __gm__ float* src_b, __gm__ float* slope, __gm__ float* float_output,
    __gm__ uint32_t* uint32_src_a, __gm__ uint32_t* uint32_src_b, __gm__ uint32_t* uint32_output)
{
    constexpr uint32_t float_input_a_offset = 0;
    constexpr uint32_t float_input_b_offset = float_input_a_offset + VECTOR_BYTES;
    constexpr uint32_t slope_offset = float_input_b_offset + VECTOR_BYTES;
    constexpr uint32_t float_output_offset = slope_offset + VECTOR_BYTES;
    constexpr uint32_t uint32_input_a_offset = float_output_offset + FLOAT_RESULT_ROWS * VECTOR_BYTES;
    constexpr uint32_t uint32_input_b_offset = uint32_input_a_offset + VECTOR_BYTES;
    constexpr uint32_t uint32_output_offset = uint32_input_b_offset + VECTOR_BYTES;

    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto float_output_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(FLOAT_RESULT_ROWS, VECTOR_LENGTH);
    auto uint32_output_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(UINT32_RESULT_ROWS, VECTOR_LENGTH);
    auto src_a_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_a), input_layout);
    auto src_b_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_b), input_layout);
    auto slope_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(slope), input_layout);
    auto float_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_output), float_output_layout);
    auto uint32_src_a_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint32_src_a), input_layout);
    auto uint32_src_b_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint32_src_b), input_layout);
    auto uint32_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint32_output), uint32_output_layout);
    auto src_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_a_offset), input_layout);
    auto src_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_b_offset), input_layout);
    auto slope_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(slope_offset), input_layout);
    auto float_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_output_offset), float_output_layout);
    auto uint32_src_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(uint32_input_a_offset), input_layout);
    auto uint32_src_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(uint32_input_b_offset), input_layout);
    auto uint32_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(uint32_output_offset), uint32_output_layout);

    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, src_a_ub, src_a_gm);
    asc::te::copy(copy_in, src_b_ub, src_b_gm);
    asc::te::copy(copy_in, slope_ub, slope_gm);
    asc::te::copy(copy_in, uint32_src_a_ub, uint32_src_a_gm);
    asc::te::copy(copy_in, uint32_src_b_ub, uint32_src_b_gm);
    asc_sync_notify(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);

    compute(src_a_ub.data().get(), src_b_ub.data().get(), slope_ub.data().get(), float_output_ub.data().get());
    compute_uint32(uint32_src_a_ub.data().get(), uint32_src_b_ub.data().get(), uint32_output_ub.data().get());

    asc_sync_notify(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
    asc::te::copy(copy_out, float_output_gm, float_output_ub);
    asc::te::copy(copy_out, uint32_output_gm, uint32_output_ub);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<float> src_a;
    example::buffer<float> src_b;
    example::buffer<float> slope;
    example::buffer<float> float_output;
    example::buffer<uint32_t> uint32_src_a;
    example::buffer<uint32_t> uint32_src_b;
    example::buffer<uint32_t> uint32_output;
    if (!runtime.init() || !src_a.load_to_device("./input/src_a.bin", VECTOR_LENGTH) ||
        !src_b.load_to_device("./input/src_b.bin", VECTOR_LENGTH) ||
        !slope.load_to_device("./input/slope.bin", VECTOR_LENGTH) ||
        !float_output.allocate(FLOAT_RESULT_ROWS * VECTOR_LENGTH) ||
        !uint32_src_a.load_to_device("./input/uint32_src_a.bin", VECTOR_LENGTH) ||
        !uint32_src_b.load_to_device("./input/uint32_src_b.bin", VECTOR_LENGTH) ||
        !uint32_output.allocate(UINT32_RESULT_ROWS * VECTOR_LENGTH)) {
        return 1;
    }

    basic_arithmetic_tensor_api<<<1, 0, runtime.stream()>>>(
        src_a.device(), src_b.device(), slope.device(), float_output.device(),
        uint32_src_a.device(), uint32_src_b.device(), uint32_output.device());
    if (!runtime.synchronize() || !float_output.save_from_device("./output/output.bin") ||
        !uint32_output.save_from_device("./output/uint32_output.bin")) {
        return 1;
    }
    std::cout << "basic_arithmetic_tensor_api executed successfully." << std::endl;
    return 0;
}
