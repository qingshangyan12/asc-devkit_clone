#include <cstdint>
#include <fstream>
#include <iostream>
#include <string>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "tensor_api/tensor.h"

namespace example {

inline bool check_acl(aclError result, const char* api)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << api << " failed, error code: " << result << std::endl;
    return false;
}

class runtime {
public:
    runtime() = default;
    runtime(const runtime&) = delete;
    runtime& operator=(const runtime&) = delete;

    bool init()
    {
        if (!check_acl(aclInit(nullptr), "aclInit")) {
            return false;
        }
        initialized_ = true;
        if (!check_acl(aclrtSetDevice(device_id_), "aclrtSetDevice")) {
            return false;
        }
        device_set_ = true;
        return check_acl(aclrtCreateStream(&stream_), "aclrtCreateStream");
    }

    ~runtime()
    {
        if (stream_ != nullptr) {
            (void)aclrtDestroyStream(stream_);
        }
        if (device_set_) {
            (void)aclrtResetDevice(device_id_);
        }
        if (initialized_) {
            (void)aclFinalize();
        }
    }

    aclrtStream stream() const
    {
        return stream_;
    }

    bool synchronize() const
    {
        return check_acl(aclrtSynchronizeStream(stream_), "aclrtSynchronizeStream");
    }

private:
    int32_t device_id_ = 0;
    bool initialized_ = false;
    bool device_set_ = false;
    aclrtStream stream_ = nullptr;
};

template <typename T>
class buffer {
public:
    buffer() = default;
    buffer(const buffer&) = delete;
    buffer& operator=(const buffer&) = delete;

    bool allocate(size_t count)
    {
        bytes_ = count * sizeof(T);
        if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&host_), bytes_), "aclrtMallocHost")) {
            return false;
        }
        return check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&device_), bytes_, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }

    ~buffer()
    {
        if (device_ != nullptr) {
            (void)aclrtFree(device_);
        }
        if (host_ != nullptr) {
            (void)aclrtFreeHost(host_);
        }
    }

    bool load(const std::string& path)
    {
        std::ifstream file(path, std::ios::binary | std::ios::ate);
        if (!file.is_open() || static_cast<size_t>(file.tellg()) != bytes_) {
            std::cerr << "Unexpected input file: " << path << std::endl;
            return false;
        }
        file.seekg(0);
        return static_cast<bool>(file.read(reinterpret_cast<char*>(host_), bytes_));
    }

    bool save(const std::string& path) const
    {
        std::ofstream file(path, std::ios::binary | std::ios::trunc);
        return file.is_open() && static_cast<bool>(file.write(reinterpret_cast<const char*>(host_), bytes_));
    }

    bool copy_to_device() const
    {
        return check_acl(aclrtMemcpy(device_, bytes_, host_, bytes_, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device");
    }

    bool copy_to_host() const
    {
        return check_acl(aclrtMemcpy(host_, bytes_, device_, bytes_, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host");
    }

    bool load_to_device(const std::string& path, size_t count)
    {
        return allocate(count) && load(path) && copy_to_device();
    }

    bool save_from_device(const std::string& path) const
    {
        return copy_to_host() && save(path);
    }

    T* device() const
    {
        return device_;
    }

private:
    T* host_ = nullptr;
    T* device_ = nullptr;
    size_t bytes_ = 0;
};

} // namespace example

constexpr uint32_t vector_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_abs(InputTensor input, OutputTensor output)
{
    using data_type = typename InputTensor::data_type;

    auto value = input.load(asc::te::make_coord(0, 0))
                     .with_mask(asc::te::make_mask<asc::te::mask_pattern::vl64, data_type>());
    output.store(asc::te::make_coord(0, 0), asc::te::abs(value));
}

__global__ __vector__ void basic_arithmetic_tensor_api(
    __gm__ int8_t* int8_input, __gm__ int16_t* int16_input, __gm__ half* half_input,
    __gm__ int32_t* int32_input, __gm__ float* float_input, __gm__ int8_t* int8_output,
    __gm__ int16_t* int16_output, __gm__ half* half_output, __gm__ int32_t* int32_output,
    __gm__ float* float_output)
{
    constexpr uint32_t int8_bytes = vector_length * sizeof(int8_t);
    constexpr uint32_t int16_bytes = vector_length * sizeof(int16_t);
    constexpr uint32_t half_bytes = vector_length * sizeof(half);
    constexpr uint32_t int32_bytes = vector_length * sizeof(int32_t);
    constexpr uint32_t float_bytes = vector_length * sizeof(float);

    constexpr uint32_t int8_input_offset = 0;
    constexpr uint32_t int8_output_offset = int8_input_offset + int8_bytes;
    constexpr uint32_t int16_input_offset = int8_output_offset + int8_bytes;
    constexpr uint32_t int16_output_offset = int16_input_offset + int16_bytes;
    constexpr uint32_t half_input_offset = int16_output_offset + int16_bytes;
    constexpr uint32_t half_output_offset = half_input_offset + half_bytes;
    constexpr uint32_t int32_input_offset = half_output_offset + half_bytes;
    constexpr uint32_t int32_output_offset = int32_input_offset + int32_bytes;
    constexpr uint32_t float_input_offset = int32_output_offset + int32_bytes;
    constexpr uint32_t float_output_offset = float_input_offset + float_bytes;

    auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto int8_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int8_input), layout);
    auto int16_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int16_input), layout);
    auto half_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input), layout);
    auto int32_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int32_input), layout);
    auto float_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input), layout);
    auto int8_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int8_output), layout);
    auto int16_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int16_output), layout);
    auto half_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_output), layout);
    auto int32_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int32_output), layout);
    auto float_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_output), layout);

    auto int8_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int8_t>(int8_input_offset), layout);
    auto int16_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int16_t>(int16_input_offset), layout);
    auto half_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_offset), layout);
    auto int32_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(int32_input_offset), layout);
    auto float_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_offset), layout);
    auto int8_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int8_t>(int8_output_offset), layout);
    auto int16_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int16_t>(int16_output_offset), layout);
    auto half_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_output_offset), layout);
    auto int32_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(int32_output_offset), layout);
    auto float_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_output_offset), layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, int8_input_ub, int8_input_gm);
    asc::te::copy(copy_in, int16_input_ub, int16_input_gm);
    asc::te::copy(copy_in, half_input_ub, half_input_gm);
    asc::te::copy(copy_in, int32_input_ub, int32_input_gm);
    asc::te::copy(copy_in, float_input_ub, float_input_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_abs(int8_input_ub, int8_output_ub);
    compute_abs(int16_input_ub, int16_output_ub);
    compute_abs(half_input_ub, half_output_ub);
    compute_abs(int32_input_ub, int32_output_ub);
    compute_abs(float_input_ub, float_output_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
    asc::te::copy(copy_out, int8_output_gm, int8_output_ub);
    asc::te::copy(copy_out, int16_output_gm, int16_output_ub);
    asc::te::copy(copy_out, half_output_gm, half_output_ub);
    asc::te::copy(copy_out, int32_output_gm, int32_output_ub);
    asc::te::copy(copy_out, float_output_gm, float_output_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<int8_t> int8_input;
    example::buffer<int16_t> int16_input;
    example::buffer<half> half_input;
    example::buffer<int32_t> int32_input;
    example::buffer<float> float_input;
    example::buffer<int8_t> int8_output;
    example::buffer<int16_t> int16_output;
    example::buffer<half> half_output;
    example::buffer<int32_t> int32_output;
    example::buffer<float> float_output;
    if (!runtime.init() || !int8_input.load_to_device("./input/int8_input.bin", vector_length) ||
        !int16_input.load_to_device("./input/int16_input.bin", vector_length) ||
        !half_input.load_to_device("./input/half_input.bin", vector_length) ||
        !int32_input.load_to_device("./input/int32_input.bin", vector_length) ||
        !float_input.load_to_device("./input/float_input.bin", vector_length) ||
        !int8_output.allocate(vector_length) || !int16_output.allocate(vector_length) ||
        !half_output.allocate(vector_length) || !int32_output.allocate(vector_length) ||
        !float_output.allocate(vector_length)) {
        return 1;
    }

    basic_arithmetic_tensor_api<<<1, 0, runtime.stream()>>>(
        int8_input.device(), int16_input.device(), half_input.device(), int32_input.device(),
        float_input.device(), int8_output.device(), int16_output.device(), half_output.device(),
        int32_output.device(), float_output.device());
    if (!runtime.synchronize() || !int8_output.save_from_device("./output/int8_output.bin") ||
        !int16_output.save_from_device("./output/int16_output.bin") ||
        !half_output.save_from_device("./output/half_output.bin") ||
        !int32_output.save_from_device("./output/int32_output.bin") ||
        !float_output.save_from_device("./output/float_output.bin")) {
        return 1;
    }
    std::cout << "basic_arithmetic_tensor_api executed successfully." << std::endl;
    return 0;
}
