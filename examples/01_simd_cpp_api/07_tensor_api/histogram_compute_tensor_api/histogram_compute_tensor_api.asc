#include <cstdint>
#include <fstream>
#include <iostream>
#include <string>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "tensor_api/tensor.h"

namespace example {

inline bool check_acl(aclError result, const char* api)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << api << " failed, error code: " << result << std::endl;
    return false;
}

class runtime {
public:
    runtime() = default;
    runtime(const runtime&) = delete;
    runtime& operator=(const runtime&) = delete;

    bool init()
    {
        if (!check_acl(aclInit(nullptr), "aclInit")) {
            return false;
        }
        initialized_ = true;
        if (!check_acl(aclrtSetDevice(device_id_), "aclrtSetDevice")) {
            return false;
        }
        device_set_ = true;
        return check_acl(aclrtCreateStream(&stream_), "aclrtCreateStream");
    }

    ~runtime()
    {
        if (stream_ != nullptr) {
            (void)aclrtDestroyStream(stream_);
        }
        if (device_set_) {
            (void)aclrtResetDevice(device_id_);
        }
        if (initialized_) {
            (void)aclFinalize();
        }
    }

    aclrtStream stream() const
    {
        return stream_;
    }

    bool synchronize() const
    {
        return check_acl(aclrtSynchronizeStream(stream_), "aclrtSynchronizeStream");
    }

private:
    int32_t device_id_ = 0;
    bool initialized_ = false;
    bool device_set_ = false;
    aclrtStream stream_ = nullptr;
};

template <typename T>
class buffer {
public:
    buffer() = default;
    buffer(const buffer&) = delete;
    buffer& operator=(const buffer&) = delete;

    bool allocate(size_t count)
    {
        bytes_ = count * sizeof(T);
        if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&host_), bytes_), "aclrtMallocHost")) {
            return false;
        }
        return check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&device_), bytes_, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }

    ~buffer()
    {
        if (device_ != nullptr) {
            (void)aclrtFree(device_);
        }
        if (host_ != nullptr) {
            (void)aclrtFreeHost(host_);
        }
    }

    bool load(const std::string& path)
    {
        std::ifstream file(path, std::ios::binary | std::ios::ate);
        if (!file.is_open() || static_cast<size_t>(file.tellg()) != bytes_) {
            std::cerr << "Unexpected input file: " << path << std::endl;
            return false;
        }
        file.seekg(0);
        return static_cast<bool>(file.read(reinterpret_cast<char*>(host_), bytes_));
    }

    bool save(const std::string& path) const
    {
        std::ofstream file(path, std::ios::binary | std::ios::trunc);
        return file.is_open() && static_cast<bool>(file.write(reinterpret_cast<const char*>(host_), bytes_));
    }

    bool copy_to_device() const
    {
        return check_acl(aclrtMemcpy(device_, bytes_, host_, bytes_, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device");
    }

    bool copy_to_host() const
    {
        return check_acl(aclrtMemcpy(host_, bytes_, device_, bytes_, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host");
    }

    bool load_to_device(const std::string& path, size_t count)
    {
        return allocate(count) && load(path) && copy_to_device();
    }

    bool save_from_device(const std::string& path) const
    {
        return copy_to_host() && save(path);
    }

    T* device() const
    {
        return device_;
    }

private:
    T* host_ = nullptr;
    T* device_ = nullptr;
    size_t bytes_ = 0;
};

} // namespace example

constexpr uint32_t input_length = 256;
constexpr uint32_t bin_length = 128;
constexpr uint16_t initial_value = 3;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_histogram(InputTensor input, OutputTensor output)
{
    auto src = input.load(asc::te::make_coord(0, 0)).with_mask(asc::te::all_mask<uint8_t>());
    asc::te::reg_tensor<uint16_t> initial;
    initial.mask = asc::te::all_mask<uint16_t>().reg;
    asc_duplicate_scalar(initial.reg, initial_value, initial.mask);
    output.store(asc::te::make_coord(0, 0), asc::te::histograms(initial, src));
}

__global__ __vector__ void histogram_compute_tensor_api(__gm__ uint8_t* input, __gm__ uint16_t* output)
{
    constexpr uint32_t input_offset = 0;
    constexpr uint32_t output_offset = input_length;

    auto input_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, input_length);
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, bin_length);
    auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input), input_layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), output_layout);
    auto input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint8_t>(input_offset), input_layout);
    auto output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint16_t>(output_offset), output_layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), input_ub, input_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_histogram(input_ub, output_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<uint8_t> input;
    example::buffer<uint16_t> output;
    if (!runtime.init() || !input.load_to_device("./input/input.bin", input_length) ||
        !output.allocate(bin_length)) {
        return 1;
    }

    histogram_compute_tensor_api<<<1, 0, runtime.stream()>>>(input.device(), output.device());
    if (!runtime.synchronize() || !output.save_from_device("./output/output.bin")) {
        return 1;
    }
    std::cout << "histogram_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
