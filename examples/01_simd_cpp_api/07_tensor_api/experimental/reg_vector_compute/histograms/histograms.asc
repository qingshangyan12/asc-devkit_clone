#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t row_count = 1;
constexpr uint32_t column_count = 256;
constexpr uint32_t input_length = row_count * column_count;
constexpr uint32_t bin_length = 128;
constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint16_t initial_value = 3;
constexpr uint8_t buffer_lock_id = 0;
constexpr asc::te::experimental::histogram_options histogram_config{
    asc::te::experimental::histogram_half::high,
    asc::te::experimental::histogram_mode::cumulative,
};

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_histogram_1d(InputTensor src_tensor, OutputTensor dst_tensor)
{
    constexpr uint32_t offset = 0;
    const auto coord = asc::te::make_coord(offset);
    auto src = asc::te::experimental::load(src_tensor, coord).with_mask(asc::te::experimental::all_mask<uint8_t>());
    asc::te::experimental::reg_tensor<uint16_t> initial;
    initial.mask = asc::te::experimental::all_mask<uint16_t>().reg;
    asc_duplicate_scalar(initial.reg, initial_value, initial.mask);
    auto dst = asc::te::experimental::histograms<histogram_config>(initial, src);
    asc::te::experimental::store(dst_tensor, coord, dst);
}

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_histogram_2d(InputTensor src_tensor, OutputTensor dst_tensor)
{
    const auto coord = asc::te::make_coord(0, 0);
    auto src = asc::te::experimental::load(src_tensor, coord).with_mask(asc::te::experimental::all_mask<uint8_t>());
    asc::te::experimental::reg_tensor<uint16_t> initial;
    initial.mask = asc::te::experimental::all_mask<uint16_t>().reg;
    asc_duplicate_scalar(initial.reg, initial_value, initial.mask);
    auto dst = asc::te::experimental::histograms<histogram_config>(initial, src);
    asc::te::experimental::store(dst_tensor, coord, dst);
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ uint8_t* src, __gm__ uint16_t* dst)
    {
        constexpr uint32_t input_offset = 0;
        constexpr uint32_t output_offset = input_length;

        auto input_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint8_t>(input_offset);
        auto output_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint16_t>(output_offset);
        if constexpr (scenario_num == 1) {
            auto input_layout = asc::te::make_layout(asc::te::make_shape(input_length), asc::te::make_stride(1));
            auto output_layout = asc::te::make_layout(asc::te::make_shape(bin_length), asc::te::make_stride(1));
            auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), input_layout);
            auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), output_layout);
            auto input_ub = asc::te::make_tensor(input_mem, input_layout);
            auto output_ub = asc::te::make_tensor(output_mem, output_layout);

            asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc::te::copy(input_ub, input_gm);
            asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_histogram_1d(input_ub, output_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
            asc::te::copy(output_gm, output_ub);
            asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
        } else {
            auto input_layout =
                asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, asc::te::layout_trait_default<uint8_t>>(
                    row_count, column_count);
            auto output_layout =
                asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, asc::te::layout_trait_default<uint16_t>>(
                    row_count, bin_length);
            auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), input_layout);
            auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), output_layout);
            auto input_ub = asc::te::make_tensor(input_mem, input_layout);
            auto output_ub = asc::te::make_tensor(output_mem, output_layout);

            asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc::te::copy(input_ub, input_gm);
            asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_histogram_2d(input_ub, output_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
            asc::te::copy(output_gm, output_ub);
            asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
        }
    }
};

__global__ __vector__ void histograms(__gm__ uint8_t* src, __gm__ uint16_t* dst)
{
    Kernel kernel;
    kernel.process(src, dst);
}

static bool compare_result(const uint16_t* output, const uint8_t* input)
{
    uint16_t frequency[256] = {};
    for (uint32_t i = 0; i < input_length; ++i) {
        ++frequency[input[i]];
    }
    uint16_t cumulative = initial_value;
    for (uint32_t i = 0; i < bin_length; ++i) {
        cumulative += frequency[i];
    }
    for (uint32_t i = 0; i < bin_length; ++i) {
        cumulative += frequency[i + bin_length];
        if (output[i] != cumulative) {
            printf("test failed at index %u: output is %u, expected is %u\n", i, output[i], cumulative);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

int32_t main()
{
    constexpr size_t input_bytes = input_length * sizeof(uint8_t);
    constexpr size_t output_bytes = bin_length * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* input_host = nullptr;
    uint16_t* output_host = nullptr;
    uint8_t* input_device = nullptr;
    uint16_t* output_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&input_host), input_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (uint32_t i = 0; i < input_length; ++i) {
        input_host[i] = static_cast<uint8_t>(i * 37U + i % 11U);
    }
    aclrtMemcpy(input_device, input_bytes, input_host, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    histograms<<<1, 0, stream>>>(input_device, output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool success = compare_result(output_host, input_host);

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(input_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
