#include <cmath>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t input_length = 64;
constexpr uint32_t output_count = 3;
constexpr uint32_t output_length = input_length * output_count;
constexpr uint32_t sum_output_index = 0;
constexpr uint32_t max_output_index = input_length;
constexpr uint32_t min_output_index = input_length * 2;
constexpr uint8_t buffer_lock_id = 0;

template <typename SrcTensorType, typename DstTensorType>
__simd_vf__ inline void compute_reduction(
    SrcTensorType src_tensor, DstTensorType sum_tensor, DstTensorType max_tensor, DstTensorType min_tensor)
{
    const auto coord = asc::te::make_coord(0);
    auto mask = asc::te::experimental::all_mask<float>();
    auto src = asc::te::experimental::load(src_tensor, coord).with_mask(mask);

    auto sum = asc::te::experimental::reduce_sum<float>(src);
    auto max = asc::te::experimental::reduce_max<float>(src);
    auto min = asc::te::experimental::reduce_min<float>(src);

    asc::te::experimental::store(sum_tensor, coord, sum);
    asc::te::experimental::store(max_tensor, coord, max);
    asc::te::experimental::store(min_tensor, coord, min);
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ float* src, __gm__ float* dst)
    {
        constexpr uint32_t tensor_bytes = input_length * sizeof(float);
        constexpr uint32_t src_offset = 0;
        constexpr uint32_t sum_offset = src_offset + tensor_bytes;
        constexpr uint32_t max_offset = sum_offset + tensor_bytes;
        constexpr uint32_t min_offset = max_offset + tensor_bytes;

        auto src_copy_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, input_length);
        auto dst_copy_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, output_length);
        auto vector_layout = asc::te::make_layout(asc::te::make_shape(input_length));
        auto src_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), src_copy_layout);
        auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), dst_copy_layout);

        auto src_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(src_offset);
        auto sum_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(sum_offset);
        auto max_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(max_offset);
        auto min_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(min_offset);
        auto src_copy_ub = asc::te::make_tensor(src_mem, src_copy_layout);
        auto dst_copy_ub = asc::te::make_tensor(sum_mem, dst_copy_layout);
        auto src_ub = asc::te::make_tensor(src_mem, vector_layout);
        auto sum_ub = asc::te::make_tensor(sum_mem, vector_layout);
        auto max_ub = asc::te::make_tensor(max_mem, vector_layout);
        auto min_ub = asc::te::make_tensor(min_mem, vector_layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc::te::copy(src_copy_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        compute_reduction(src_ub, sum_ub, max_ub, min_ub);
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);

        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        asc::te::copy(dst_gm, dst_copy_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void reduction_compute(__gm__ float* src, __gm__ float* dst)
{
    Kernel kernel;
    kernel.process(src, dst);
}

static bool compare_value(const char* name, float actual, float expected)
{
    constexpr float eps = 1e-4f;
    if (std::fabs(actual - expected) > eps) {
        printf("%s test failed: output is %f, expected is %f\n", name, actual, expected);
        return false;
    }
    return true;
}

static bool compare_result(const float* output, const float* input)
{
    float expected_sum = 0.0f;
    float expected_max = input[0];
    float expected_min = input[0];
    for (uint32_t i = 0; i < input_length; ++i) {
        expected_sum += input[i];
        expected_max = input[i] > expected_max ? input[i] : expected_max;
        expected_min = input[i] < expected_min ? input[i] : expected_min;
    }

    bool success = true;
    success = compare_value("reduce_sum", output[sum_output_index], expected_sum) && success;
    success = compare_value("reduce_max", output[max_output_index], expected_max) && success;
    success = compare_value("reduce_min", output[min_output_index], expected_min) && success;
    printf(success ? "test pass!\n" : "test failed!\n");
    return success;
}

int32_t main()
{
    constexpr size_t input_bytes = input_length * sizeof(float);
    constexpr size_t output_bytes = output_length * sizeof(float);

    aclInit(nullptr);
    constexpr int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* src_host = nullptr;
    float* dst_host = nullptr;
    float* src_device = nullptr;
    float* dst_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&src_host), input_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&dst_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (uint32_t i = 0; i < input_length; ++i) {
        src_host[i] = static_cast<float>(i) * 0.25f - 5.0f;
    }
    aclrtMemcpy(src_device, input_bytes, src_host, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    reduction_compute<<<1, 0, stream>>>(src_device, dst_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dst_host, output_bytes, dst_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool success = compare_result(dst_host, src_host);

    aclrtFree(src_device);
    aclrtFree(dst_device);
    aclrtFreeHost(src_host);
    aclrtFreeHost(dst_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
