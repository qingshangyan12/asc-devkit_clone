#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t total_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename ShiftTensor, typename OutputTensor>
__simd_vf__ inline void compute_shift_left(InputTensor input, ShiftTensor shifts, OutputTensor output)
{
    using asc::te::experimental::operator<<;

    constexpr uint32_t offset = 0;
    const auto coord = asc::te::make_coord(offset);
    auto mask = asc::te::experimental::all_mask<uint32_t>();
    auto src = asc::te::experimental::load(input, coord).with_mask(mask);
    auto shift = asc::te::experimental::load(shifts, coord).with_mask(mask);
    asc::te::experimental::store(output, coord, src << shift);
}

class Kernel {
public:
    __aicore__ inline void process(
        __gm__ uint32_t* input, __gm__ int32_t* shifts, __gm__ uint32_t* output)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(uint32_t);
        constexpr uint32_t input_offset = 0;
        constexpr uint32_t shifts_offset = input_offset + tensor_bytes;
        constexpr uint32_t output_offset = shifts_offset + tensor_bytes;

        auto copy_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, total_length);
        auto vector_layout = asc::te::make_layout(asc::te::make_shape(total_length));
        auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input), copy_layout);
        auto shifts_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(shifts), copy_layout);
        auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), copy_layout);
        auto input_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(input_offset);
        auto shifts_mem = asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(shifts_offset);
        auto output_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(output_offset);
        auto input_copy_ub = asc::te::make_tensor(input_mem, copy_layout);
        auto shifts_copy_ub = asc::te::make_tensor(shifts_mem, copy_layout);
        auto output_copy_ub = asc::te::make_tensor(output_mem, copy_layout);
        auto input_ub = asc::te::make_tensor(input_mem, vector_layout);
        auto shifts_ub = asc::te::make_tensor(shifts_mem, vector_layout);
        auto output_ub = asc::te::make_tensor(output_mem, vector_layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
        asc::te::copy(copy_in, input_copy_ub, input_gm);
        asc::te::copy(copy_in, shifts_copy_ub, shifts_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);

        compute_shift_left(input_ub, shifts_ub, output_ub);

        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_copy_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void shift_left(
    __gm__ uint32_t* input, __gm__ int32_t* shifts, __gm__ uint32_t* output)
{
    Kernel kernel;
    kernel.process(input, shifts, output);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t tensor_bytes = total_length * sizeof(uint32_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint32_t* input_host = nullptr;
    int32_t* shifts_host = nullptr;
    uint32_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    int32_t* shifts_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&input_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&shifts_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&shifts_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/input.bin", file_size, input_host, tensor_bytes);
    ReadFile("./input/shifts.bin", file_size, shifts_host, tensor_bytes);
    aclrtMemcpy(input_device, tensor_bytes, input_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(shifts_device, tensor_bytes, shifts_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    shift_left<<<1, nullptr, stream>>>(input_device, shifts_device, output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, tensor_bytes, output_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", output_host, tensor_bytes);

    aclrtFree(input_device);
    aclrtFree(shifts_device);
    aclrtFree(output_device);
    aclrtFreeHost(input_host);
    aclrtFreeHost(shifts_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "shift_left executed successfully." << std::endl;
    return 0;
}
