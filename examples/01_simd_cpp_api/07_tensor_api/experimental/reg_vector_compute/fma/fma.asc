#include <cmath>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t row_count = 2;
constexpr uint32_t column_count = 64;
constexpr uint32_t total_length = row_count * column_count;
constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint8_t buffer_lock_id = 0;

template <typename Src0TensorType, typename Src1TensorType, typename Src2TensorType, typename DstTensorType>
__simd_vf__ inline void compute_fma_1d(
    Src0TensorType src0_tensor, Src1TensorType src1_tensor, Src2TensorType src2_tensor, DstTensorType dst_tensor)
{
    constexpr uint32_t vector_length = asc_get_vf_len() / sizeof(float);
    constexpr uint32_t repeat_times = total_length / vector_length;
    auto mask = asc::te::experimental::all_mask<float>();
    for (uint32_t repeat = 0; repeat < repeat_times; ++repeat) {
        const auto coord = asc::te::make_coord(repeat * vector_length);
        auto src0 = asc::te::experimental::load(src0_tensor, coord).with_mask(mask);
        auto src1 = asc::te::experimental::load(src1_tensor, coord).with_mask(mask);
        auto src2 = asc::te::experimental::load(src2_tensor, coord).with_mask(mask);
        auto dst = asc::te::experimental::fma(src0, src1, src2);
        asc::te::experimental::store(dst_tensor, coord, dst);
    }
}

template <typename Src0TensorType, typename Src1TensorType, typename Src2TensorType, typename DstTensorType>
__simd_vf__ inline void compute_fma_2d(
    Src0TensorType src0_tensor, Src1TensorType src1_tensor, Src2TensorType src2_tensor, DstTensorType dst_tensor)
{
    auto mask = asc::te::experimental::all_mask<float>();
    for (uint32_t row = 0; row < row_count; ++row) {
        const auto coord = asc::te::make_coord(row, 0);
        auto src0 = asc::te::experimental::load(src0_tensor, coord).with_mask(mask);
        auto src1 = asc::te::experimental::load(src1_tensor, coord).with_mask(mask);
        auto src2 = asc::te::experimental::load(src2_tensor, coord).with_mask(mask);
        auto dst = asc::te::experimental::fma(src0, src1, src2);
        asc::te::experimental::store(dst_tensor, coord, dst);
    }
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ float* src0, __gm__ float* src1, __gm__ float* src2, __gm__ float* dst)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(float);
        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = src0_offset + tensor_bytes;
        constexpr uint32_t src2_offset = src1_offset + tensor_bytes;
        constexpr uint32_t dst_offset = src2_offset + tensor_bytes;

        auto src0_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(src0_offset);
        auto src1_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(src1_offset);
        auto src2_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(src2_offset);
        auto dst_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(dst_offset);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});

        if constexpr (scenario_num == 1) {
            auto layout = asc::te::make_layout(asc::te::make_shape(total_length), asc::te::make_stride(1));
            auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), layout);
            auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), layout);
            auto src2_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src2), layout);
            auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
            auto src0_ub = asc::te::make_tensor(src0_mem, layout);
            auto src1_ub = asc::te::make_tensor(src1_mem, layout);
            auto src2_ub = asc::te::make_tensor(src2_mem, layout);
            auto dst_ub = asc::te::make_tensor(dst_mem, layout);

            asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc::te::copy(copy_in, src0_ub, src0_gm);
            asc::te::copy(copy_in, src1_ub, src1_gm);
            asc::te::copy(copy_in, src2_ub, src2_gm);
            asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_fma_1d(src0_ub, src1_ub, src2_ub, dst_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
            asc::te::copy(copy_out, dst_gm, dst_ub);
            asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
        } else {
            auto layout = asc::te::make_layout(
                asc::te::make_shape(row_count, column_count), asc::te::make_stride(column_count, 1));
            auto copy_shape = asc::te::make_shape(1, column_count);
            auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), layout);
            auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), layout);
            auto src2_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src2), layout);
            auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
            auto src0_ub = asc::te::make_tensor(src0_mem, layout);
            auto src1_ub = asc::te::make_tensor(src1_mem, layout);
            auto src2_ub = asc::te::make_tensor(src2_mem, layout);
            auto dst_ub = asc::te::make_tensor(dst_mem, layout);

            for (uint32_t row = 0; row < row_count; ++row) {
                const auto coord = asc::te::make_coord(row, 0);
                asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
                asc::te::copy(copy_in, src0_ub, src0_gm, coord, coord, copy_shape);
                asc::te::copy(copy_in, src1_ub, src1_gm, coord, coord, copy_shape);
                asc::te::copy(copy_in, src2_ub, src2_gm, coord, coord, copy_shape);
                asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            }
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_fma_2d(src0_ub, src1_ub, src2_ub, dst_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            for (uint32_t row = 0; row < row_count; ++row) {
                const auto coord = asc::te::make_coord(row, 0);
                asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
                asc::te::copy(copy_out, dst_gm, dst_ub, coord, coord, copy_shape);
                asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
            }
        }
    }
};

__global__ __vector__ void fma(__gm__ float* src0, __gm__ float* src1, __gm__ float* src2, __gm__ float* dst)
{
    Kernel kernel;
    kernel.process(src0, src1, src2, dst);
}

static bool compare_result(const float* output, const float* src0, const float* src1, const float* src2)
{
    constexpr float eps = 1e-4f;
    for (uint32_t i = 0; i < total_length; ++i) {
        float expected = src0[i] * src1[i] + src2[i];
        if (std::fabs(output[i] - expected) > eps) {
            printf("test failed at index %u: output is %f, expected is %f\n", i, output[i], expected);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

int32_t main()
{
    constexpr size_t tensor_bytes = total_length * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* src0_host = nullptr;
    float* src1_host = nullptr;
    float* src2_host = nullptr;
    float* dst_host = nullptr;
    float* src0_device = nullptr;
    float* src1_device = nullptr;
    float* src2_device = nullptr;
    float* dst_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&src0_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&src1_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&src2_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&dst_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&src2_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (uint32_t i = 0; i < total_length; ++i) {
        src0_host[i] = static_cast<float>(i) / 32.0f - 1.0f;
        src1_host[i] = static_cast<float>(i) / 64.0f + 0.25f;
        src2_host[i] = static_cast<float>(i) / 64.0f - 0.5f;
    }
    aclrtMemcpy(src0_device, tensor_bytes, src0_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, tensor_bytes, src1_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src2_device, tensor_bytes, src2_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    fma<<<1, 0, stream>>>(src0_device, src1_device, src2_device, dst_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dst_host, tensor_bytes, dst_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool success = compare_result(dst_host, src0_host, src1_host, src2_host);

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(src2_device);
    aclrtFree(dst_device);
    aclrtFreeHost(src0_host);
    aclrtFreeHost(src1_host);
    aclrtFreeHost(src2_host);
    aclrtFreeHost(dst_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
