#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t total_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_fma(InputTensor input_a, InputTensor input_b, InputTensor input_c, OutputTensor output)
{
    constexpr uint32_t offset = 0;
    const auto coord = asc::te::make_coord(offset);
    auto mask = asc::te::experimental::all_mask<float>();
    auto a = asc::te::experimental::load(input_a, coord).with_mask(mask);
    auto b = asc::te::experimental::load(input_b, coord).with_mask(mask);
    auto c = asc::te::experimental::load(input_c, coord).with_mask(mask);
    asc::te::experimental::store(output, coord, asc::te::experimental::fma(a, b, c));
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ float* input_a, __gm__ float* input_b, __gm__ float* input_c,
                                   __gm__ float* output)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(float);
        constexpr uint32_t input_a_offset = 0;
        constexpr uint32_t input_b_offset = input_a_offset + tensor_bytes;
        constexpr uint32_t input_c_offset = input_b_offset + tensor_bytes;
        constexpr uint32_t output_offset = input_c_offset + tensor_bytes;

        auto copy_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, total_length);
        auto vector_layout = asc::te::make_layout(asc::te::make_shape(total_length));
        auto input_a_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input_a), copy_layout);
        auto input_b_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input_b), copy_layout);
        auto input_c_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input_c), copy_layout);
        auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), copy_layout);
        auto input_a_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(input_a_offset);
        auto input_b_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(input_b_offset);
        auto input_c_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(input_c_offset);
        auto output_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(output_offset);
        auto input_a_copy_ub = asc::te::make_tensor(input_a_mem, copy_layout);
        auto input_b_copy_ub = asc::te::make_tensor(input_b_mem, copy_layout);
        auto input_c_copy_ub = asc::te::make_tensor(input_c_mem, copy_layout);
        auto output_copy_ub = asc::te::make_tensor(output_mem, copy_layout);
        auto input_a_ub = asc::te::make_tensor(input_a_mem, vector_layout);
        auto input_b_ub = asc::te::make_tensor(input_b_mem, vector_layout);
        auto input_c_ub = asc::te::make_tensor(input_c_mem, vector_layout);
        auto output_ub = asc::te::make_tensor(output_mem, vector_layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        asc::te::copy(copy_in, input_a_copy_ub, input_a_gm);
        asc::te::copy(copy_in, input_b_copy_ub, input_b_gm);
        asc::te::copy(copy_in, input_c_copy_ub, input_c_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);

        compute_fma(input_a_ub, input_b_ub, input_c_ub, output_ub);

        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});
        asc::te::copy(copy_out, output_gm, output_copy_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void fma(__gm__ float* input_a, __gm__ float* input_b, __gm__ float* input_c,
                               __gm__ float* output)
{
    Kernel kernel;
    kernel.process(input_a, input_b, input_c, output);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t tensor_bytes = total_length * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* input_a_host = nullptr;
    float* input_b_host = nullptr;
    float* input_c_host = nullptr;
    float* output_host = nullptr;
    float* input_a_device = nullptr;
    float* input_b_device = nullptr;
    float* input_c_device = nullptr;
    float* output_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&input_a_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&input_b_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&input_c_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_a_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&input_b_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&input_c_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/input_a.bin", file_size, input_a_host, tensor_bytes);
    ReadFile("./input/input_b.bin", file_size, input_b_host, tensor_bytes);
    ReadFile("./input/input_c.bin", file_size, input_c_host, tensor_bytes);
    aclrtMemcpy(input_a_device, tensor_bytes, input_a_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input_b_device, tensor_bytes, input_b_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(input_c_device, tensor_bytes, input_c_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    fma<<<1, 0, stream>>>(input_a_device, input_b_device, input_c_device, output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, tensor_bytes, output_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", output_host, tensor_bytes);

    aclrtFree(input_a_device);
    aclrtFree(input_b_device);
    aclrtFree(input_c_device);
    aclrtFree(output_device);
    aclrtFreeHost(input_a_host);
    aclrtFreeHost(input_b_host);
    aclrtFreeHost(input_c_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    printf("fma executed successfully.\n");
    return 0;
}
