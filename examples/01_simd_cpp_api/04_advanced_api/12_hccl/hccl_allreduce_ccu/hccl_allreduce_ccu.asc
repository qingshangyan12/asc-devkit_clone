/* !
 * \file hccl_allreduce_ccu.asc
 * \brief Hccl AllReduce sample based on the CCU server type (Ascend 950PR/Ascend 950DT only)
 */

#include <cstddef>
#include <cstdint>
#include <iostream>

#include "acl/acl.h"

#include "kernel_operator.h"

// Number of ranks in the communication group described by the context.
constexpr uint32_t RANK_NUM = 8U;
// Rank id of the current device.
constexpr uint32_t RANK_ID = 0U;
// Number of elements participating in the AllReduce, float => 1024 * 4 = 4096 bytes of communication data.
constexpr uint64_t COUNT = 1024UL;
constexpr size_t DATA_SIZE = COUNT * sizeof(float);

// The Hccl instance carves the communication metadata out of context.workSpace, see HcclImpl::InitInner:
// 512B alignment padding + finish counter + per-handle params + per-handle AlltoAllV params + CCU message extension.
// 2MB is well above what the 64 handles need.
constexpr size_t WORKSPACE_SIZE = 2UL * 1024UL * 1024UL;
// CCU message queue: CCU_MAX_MSG_NUM(64) messages * CCU_MSG_XN_NUM(64) registers * CCU_XN_DATA_SIZE(8) bytes.
constexpr size_t XN_SIZE = 64UL * 64UL * 8UL;
// One commit CKE and one wait CKE per message: 2 * CCU_MAX_MSG_NUM(64) * CCU_CKE_SIZE(8).
constexpr size_t CKE_SIZE = 2UL * 64UL * 8UL;

// Indexes of the values the kernel reports back to the host.
constexpr uint32_t STATUS_HANDLE_ID = 0U;
constexpr uint32_t STATUS_RANK_ID = 1U;
constexpr uint32_t STATUS_RANK_DIM = 2U;
constexpr uint32_t STATUS_WAIT_RET = 3U;
constexpr uint32_t STATUS_NUM = 4U;

// Tiling consumed by Hccl::InitV2/Hccl::SetCcTilingV2. Mc2InitTilingInner must be the first member, because
// SetCcTilingV2 takes the offset of the cc tiling relative to the address passed to InitV2.
struct CcuAllReduceTiling {
    HcclApi::Mc2InitTilingInner mc2InitTiling;
    HcclApi::Mc2CcTilingInner mc2CcTiling;
};

__vector__ __global__ void hccl_allreduce_ccu(
    __gm__ uint8_t* contextGm, __gm__ uint8_t* sendBuf, __gm__ uint8_t* recvBuf, __gm__ uint8_t* tilingGm,
    __gm__ int32_t* statusGm)
{
    AscendC::InitSocState();

    // Ascend 950PR/Ascend 950DT only supports HCCL_SERVER_TYPE_CCU, so the Prepare interfaces of this instance
    // are served by HcclImpl<HCCL_SERVER_TYPE_CCU, config>.
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_CCU> hccl;

    // Step 1: bind the communication context and the init tiling.
    hccl.InitV2(contextGm, reinterpret_cast<const void*>(reinterpret_cast<uint64_t>(tilingGm)));

    // Step 2: register the cc tiling of AllReduce. Its data types and reduce op override the Prepare arguments.
    hccl.SetCcTilingV2(offsetof(CcuAllReduceTiling, mc2CcTiling));

    // Step 3: launch the communication task. AllReduce forwards to HcclImpl<HCCL_SERVER_TYPE_CCU>::CommonPrepareImpl,
    // which validates the communication data size, allocates a handle and fills the CCU message body.
    AscendC::HcclHandle handleId =
        hccl.AllReduce(sendBuf, recvBuf, COUNT, AscendC::HCCL_DATA_TYPE_FP32, AscendC::HCCL_REDUCE_SUM, 1);

    statusGm[STATUS_HANDLE_ID] = handleId;
    statusGm[STATUS_RANK_ID] = static_cast<int32_t>(hccl.GetRankId());
    statusGm[STATUS_RANK_DIM] = static_cast<int32_t>(hccl.GetRankDim());

    // Step 4: notify the CCU to execute the task launched above.
    hccl.Commit(handleId);

#ifdef ASCENDC_CPU_DEBUG
    // Step 5 & 6: Wait polls the CKE written by the CCU, and Finalize tells the CCU that no task follows.
    // Both only return once a real communication group drives the CCU, so they are demonstrated in CPU debug mode.
    statusGm[STATUS_WAIT_RET] = hccl.Wait(handleId);
    hccl.Finalize();
#endif
}

int32_t main(int32_t argc, char* argv[])
{
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    uint8_t* sendDevice = nullptr;
    uint8_t* recvDevice = nullptr;
    uint8_t* scratchDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;
    uint8_t* xnDevice = nullptr;
    uint8_t* ckeDevice = nullptr;
    uint8_t* contextDevice = nullptr;
    uint8_t* tilingDevice = nullptr;
    int32_t* statusDevice = nullptr;

    aclrtMalloc((void**)&sendDevice, DATA_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&recvDevice, DATA_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&scratchDevice, DATA_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&workspaceDevice, WORKSPACE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&xnDevice, XN_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&ckeDevice, CKE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&contextDevice, sizeof(AscendC::HcclCombineOpParam), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tilingDevice, sizeof(CcuAllReduceTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&statusDevice, STATUS_NUM * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);

    float sendHost[COUNT];
    for (uint64_t i = 0; i < COUNT; ++i) {
        sendHost[i] = static_cast<float>(i);
    }
    aclrtMemcpy(sendDevice, DATA_SIZE, sendHost, DATA_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);

    // The communication context describes the group and the CCU message channel. In an aclnn operator it is
    // provided by the framework through GetHcclContext(); a kernel direct-launch sample builds it by hand.
    AscendC::HcclCombineOpParam contextHost{};
    contextHost.workSpace = reinterpret_cast<uint64_t>(workspaceDevice);
    contextHost.workSpaceSize = WORKSPACE_SIZE;
    contextHost.rankId = RANK_ID;
    contextHost.rankNum = RANK_NUM;
    contextHost.windowsOut[0] = reinterpret_cast<uint64_t>(scratchDevice);
    contextHost.xnOffset = reinterpret_cast<GM_ADDR>(reinterpret_cast<uint64_t>(xnDevice));
    contextHost.ckeOffset = reinterpret_cast<GM_ADDR>(reinterpret_cast<uint64_t>(ckeDevice));
    aclrtMemcpy(
        contextDevice, sizeof(contextHost), &contextHost, sizeof(contextHost), ACL_MEMCPY_HOST_TO_DEVICE);

    CcuAllReduceTiling tilingHost{};
    // INIT_TILING_VERSION selects the HcclCombineOpParam context layout used above.
    tilingHost.mc2InitTiling.version = HcclApi::INIT_TILING_VERSION;
    tilingHost.mc2InitTiling.mc2HcommCnt = 1U;
    tilingHost.mc2CcTiling.opType = static_cast<uint32_t>(AscendC::HcclCMDType::HCCL_CMD_ALLREDUCE);
    tilingHost.mc2CcTiling.srcDataType = static_cast<uint8_t>(AscendC::HCCL_DATA_TYPE_FP32);
    tilingHost.mc2CcTiling.dstDataType = static_cast<uint8_t>(AscendC::HCCL_DATA_TYPE_FP32);
    tilingHost.mc2CcTiling.reduceType = static_cast<uint32_t>(AscendC::HCCL_REDUCE_SUM);
    aclrtMemcpy(tilingDevice, sizeof(tilingHost), &tilingHost, sizeof(tilingHost), ACL_MEMCPY_HOST_TO_DEVICE);

    int32_t statusHost[STATUS_NUM] = {-1, -1, -1, -1};
    aclrtMemcpy(statusDevice, sizeof(statusHost), statusHost, sizeof(statusHost), ACL_MEMCPY_HOST_TO_DEVICE);

    // The Prepare interfaces run on a single core, block 0 of the AI Vector core here.
    constexpr uint32_t numBlocks = 1;
    hccl_allreduce_ccu<<<numBlocks, 0, stream>>>(
        contextDevice, sendDevice, recvDevice, tilingDevice, statusDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(statusHost, sizeof(statusHost), statusDevice, sizeof(statusHost), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(sendDevice);
    aclrtFree(recvDevice);
    aclrtFree(scratchDevice);
    aclrtFree(workspaceDevice);
    aclrtFree(xnDevice);
    aclrtFree(ckeDevice);
    aclrtFree(contextDevice);
    aclrtFree(tilingDevice);
    aclrtFree(statusDevice);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    std::cout << "AllReduce handleId: " << statusHost[STATUS_HANDLE_ID] << std::endl;
    std::cout << "rankId: " << statusHost[STATUS_RANK_ID] << ", rankDim: " << statusHost[STATUS_RANK_DIM] << std::endl;
#ifdef ASCENDC_CPU_DEBUG
    std::cout << "Wait return: " << statusHost[STATUS_WAIT_RET] << std::endl;
#endif

    // The first Prepare call of an Hccl instance returns handle 0. Any other value means CommonPrepareImpl rejected
    // the request, for example because the communication data size or the handle id is out of range.
    if (statusHost[STATUS_HANDLE_ID] != 0 || statusHost[STATUS_RANK_ID] != static_cast<int32_t>(RANK_ID) ||
        statusHost[STATUS_RANK_DIM] != static_cast<int32_t>(RANK_NUM)) {
        std::cout << "test failed!" << std::endl;
        return 1;
    }
    std::cout << "test pass!" << std::endl;
    return 0;
}
