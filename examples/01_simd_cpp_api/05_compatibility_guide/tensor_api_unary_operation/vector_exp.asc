/* !
* \file vector_exp.asc
* \brief Vector element-wise exp based on tensor_api Transform<Exp>
*/

#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include <cstdint>
#include <random>
#include <cmath>
#include <cstdio>

// T: data type, U: instruction type
template <typename T, typename U>
__global__ __vector__ void exp_custom(__gm__ T* inputPtr, __gm__ T* resultPtr, uint32_t totalLength)
{
    using namespace AscendC::Te;

    // Create GM tensors (1D layout)
    auto gmInput = MakeTensor(MakeMemPtr(inputPtr), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto gmResult = MakeTensor(MakeMemPtr(resultPtr), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));

    // UB addr offset
    uint32_t ubInputOffset = 0;
    uint32_t ubResultOffset = totalLength * sizeof(T);

    // Create UB tensors
    auto ubInput = MakeTensor(MakeMemPtr<Location::UB, T>(ubInputOffset), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto ubResult = MakeTensor(MakeMemPtr<Location::UB, T>(ubResultOffset), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));

    // Create copy atoms
    auto copyGM2UBAtom = MakeCopy(CopyGM2UB{});
    auto copyUB2GMAtom = MakeCopy(CopyUB2GM{});

    // Copy inputs from GM to UB
    Copy(copyGM2UBAtom, ubInput, gmInput);

    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    // Perform element-wise instruction
    Transform<U>(ubResult, ubInput);

    // Copy result from UB to GM
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    Copy(copyUB2GMAtom, gmResult, ubResult);
}

int32_t main(int32_t argc, char* argv[])
{
    using dataType = float;
    uint32_t totalLength = 256;
    size_t fileSize = totalLength * sizeof(dataType);
    uint32_t numBlocks = 1;

    // Generate random input data and compute golden result
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<float> dis(-50.0f, 50.0f);

    dataType inputHost[totalLength];
    dataType golden[totalLength];
    for (uint32_t i = 0; i < totalLength; ++i) {
        float data = dis(gen);
        inputHost[i] = data;
        golden[i] = std::exp(data);
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    dataType* inputDevice;
    aclrtMalloc((void**)&inputDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(inputDevice, fileSize, inputHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    dataType* resultHost;
    dataType* resultDevice;
    aclrtMallocHost((void**)(&resultHost), fileSize);
    aclrtMalloc((void**)&resultDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    exp_custom<dataType, AscendC::Te::Inst::Exp><<<numBlocks, 0, stream>>>(inputDevice, resultDevice, totalLength);
    aclrtSynchronizeStream(stream);

    // Verify result
    aclrtMemcpy(resultHost, fileSize, resultDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);

    constexpr float EPS = 1e-6f;
    int64_t wrongNum = 0;
    for (uint32_t i = 0; i < totalLength; ++i) {
        dataType output = reinterpret_cast<dataType*>(resultHost)[i];
        dataType expected = golden[i];
        float diff = std::fabs(output - expected) / expected;
        if (diff > EPS) {
            printf("CompareResult failed at index %u: output is %f, golden is %f\n", i, output, expected);
            wrongNum++;
        }
    }

    if (wrongNum == 0) {
        printf("CompareResult passed, all %u elements are correct.\n", totalLength);
    } else {
        printf("CompareResult failed, %ld elements are wrong.\n", wrongNum);
    }

    aclrtFree(inputDevice);
    aclrtFreeHost(inputHost);
    aclrtFree(resultDevice);
    aclrtFreeHost(resultHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}