/* !
* \file vector_exp.asc
* \brief Vector element-wise exp based on tensor_api Transform<Exp>
*/

#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include <cstdint>
#include <random>
#include <cmath>
#include <cstdio>

// T: data type, U: instruction type
template <typename T, typename U>
__global__ __vector__ void mull_custom(__gm__ T* inputXPtr, __gm__ T* inputYPtr, __gm__ T* resultXPtr, __gm__ T* resultYPtr, uint32_t totalLength)
{
    using namespace AscendC::Te;

    // Create GM tensors (1D layout)
    auto gmInputX = MakeTensor(MakeMemPtr(inputXPtr), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto gmInputY = MakeTensor(MakeMemPtr(inputYPtr), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto gmResultX = MakeTensor(MakeMemPtr(resultXPtr), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto gmResultY = MakeTensor(MakeMemPtr(resultYPtr), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));

    // UB addr offset
    uint32_t ubInputXOffset = 0;
    uint32_t ubInputYOffset = totalLength * sizeof(T);
    uint32_t ubResultXOffset = totalLength * sizeof(T) * 2;
    uint32_t ubResultYOffset = totalLength * sizeof(T) * 3;

    // Create UB tensors
    auto ubInputX = MakeTensor(MakeMemPtr<Location::UB, T>(ubInputXOffset), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto ubInputY = MakeTensor(MakeMemPtr<Location::UB, T>(ubInputYOffset), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto ubResultX = MakeTensor(MakeMemPtr<Location::UB, T>(ubResultXOffset), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));
    auto ubResultY = MakeTensor(MakeMemPtr<Location::UB, T>(ubResultYOffset), MakeFrameLayout<NDExtLayoutPtn>(_1{}, totalLength));

    // Create copy atoms
    auto copyGM2UBAtom = MakeCopy(CopyGM2UB{});
    auto copyUB2GMAtom = MakeCopy(CopyUB2GM{});

    // Copy inputs from GM to UB
    Copy(copyGM2UBAtom, ubInputX, gmInputX);
    Copy(copyGM2UBAtom, ubInputY, gmInputY);

    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    // Perform element-wise instruction
    Transform<U>(ubResultX, ubResultY, ubInputX, ubInputY);

    // Copy result from UB to GM
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    Copy(copyUB2GMAtom, gmResultX, ubResultX);
    Copy(copyUB2GMAtom, gmResultY, ubResultY);
}

int32_t main(int32_t argc, char* argv[])
{
    using dataType = uint32_t;
    using resDataType = uint64_t;
    uint32_t totalLength = 256;
    size_t fileSize = totalLength * sizeof(dataType);
    uint32_t numBlocks = 1;

    // Generate random input data and compute golden result
    std::random_device rd;
    std::mt19937 gen(rd());
    //设置一个乘积会导致32位溢出的范围便于观察结果
    std::uniform_int_distribution<dataType> dis(70000, 80000);

    dataType inputXHost[totalLength];
    dataType inputYHost[totalLength];
    resDataType golden[totalLength];
    for (uint32_t i = 0; i < totalLength; ++i) {
        inputXHost[i] = dis(gen);
        inputYHost[i] = dis(gen);
        golden[i] = static_cast<resDataType>(inputXHost[i]) * static_cast<resDataType>(inputYHost[i]);
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    dataType* inputXDevice;
    aclrtMalloc((void**)&inputXDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(inputXDevice, fileSize, inputXHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    dataType* inputYDevice;
    aclrtMalloc((void**)&inputYDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(inputYDevice, fileSize, inputYHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    dataType* resultXHost;
    dataType* resultXDevice;
    aclrtMallocHost((void**)(&resultXHost), fileSize);
    aclrtMalloc((void**)&resultXDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    dataType* resultYHost;
    dataType* resultYDevice;
    aclrtMallocHost((void**)(&resultYHost), fileSize);
    aclrtMalloc((void**)&resultYDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mull_custom<dataType, AscendC::Te::Inst::Mull><<<numBlocks, 0, stream>>>(inputXDevice, inputYDevice, resultXDevice, resultYDevice, totalLength);
    aclrtSynchronizeStream(stream);

    // Verify result
    aclrtMemcpy(resultXHost, fileSize, resultXDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(resultYHost, fileSize, resultYDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 根据接口特性，resultYHost存溢出即高位数据
    constexpr float EPS = 1e-6f;
    int64_t wrongNum = 0;
    for (uint32_t i = 0; i < totalLength; ++i) {
        dataType high = reinterpret_cast<dataType*>(resultYHost)[i];
        dataType low = reinterpret_cast<dataType*>(resultXHost)[i];
        resDataType res = (static_cast<uint64_t>(high) << 32) | low;
        resDataType expected = golden[i];
        if (res != expected) {
            printf("CompareResult failed at index %u: output is %lu, golden is %lu\n", i, res, expected);
            wrongNum++;
        }
    }

    if (wrongNum == 0) {
        printf("CompareResult passed, all %u elements are correct.\n", totalLength);
    } else {
        printf("CompareResult failed, %ld elements are wrong.\n", wrongNum);
    }

    aclrtFree(inputXDevice);
    aclrtFreeHost(inputXHost);
    aclrtFree(inputYDevice);
    aclrtFreeHost(inputYHost);
    aclrtFree(resultXDevice);
    aclrtFreeHost(resultXHost);
    aclrtFree(resultYDevice);
    aclrtFreeHost(resultYHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}