/*!
 * \file shiftleft_scalar.asc
 * \brief Tensor API Ternary Transform 示例 - shiftleft_scalar
 * 
 * 演示使用 Ascend C 基础 API 的 ShiftLeft 实现向量左移操作
 * 数学公式：out = src << scalar
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#if defined(ASCENDC_CPU_DEBUG)
#include "tikicpulib.h"
#endif

constexpr uint32_t TOTAL_LENGTH = 512;

class KernelShiftleftScalar {
public:
    __aicore__ inline KernelShiftleftScalar() {}
    
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, int16_t scalarValue)
    {
        this->scalar = scalarValue;
        srcGlobal.SetGlobalBuffer((__gm__ int16_t*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ int16_t*)dstGm);
        
        pipe.InitBuffer(inQueueSrc, 1, TOTAL_LENGTH * sizeof(int16_t));
        pipe.InitBuffer(outQueueDst, 1, TOTAL_LENGTH * sizeof(int16_t));
    }
    
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<int16_t> srcLocal = inQueueSrc.AllocTensor<int16_t>();
        AscendC::DataCopy(srcLocal, srcGlobal, TOTAL_LENGTH);
        inQueueSrc.EnQue(srcLocal);
    }
    
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<int16_t> srcLocal = inQueueSrc.DeQue<int16_t>();
        AscendC::LocalTensor<int16_t> dstLocal = outQueueDst.AllocTensor<int16_t>();
        
        AscendC::ShiftLeft(dstLocal, srcLocal, scalar, TOTAL_LENGTH);
        
        outQueueDst.EnQue<int16_t>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<int16_t> dstLocal = outQueueDst.DeQue<int16_t>();
        AscendC::DataCopy(dstGlobal, dstLocal, TOTAL_LENGTH);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<int16_t> srcGlobal;
    AscendC::GlobalTensor<int16_t> dstGlobal;
    int16_t scalar;
};

__global__ __vector__ void kernel_shiftleft_scalar(
    __gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, int16_t scalarValue)
{
    KernelShiftleftScalar op;
    op.Init(srcGm, dstGm, scalarValue);
    op.Process();
}

int32_t main(int32_t argc, char *argv[]) {
    uint32_t numBlocks = 1;
    size_t inputByteSize = TOTAL_LENGTH * sizeof(int16_t);
    size_t outputByteSize = TOTAL_LENGTH * sizeof(int16_t);
    int16_t scalarValue = 2;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *outHost;
    uint8_t *xDevice, *outDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&outHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

#if defined(ASCENDC_CPU_DEBUG)
    AscendC::SetKernelMode(KernelMode::AIV_MODE);
    ICPU_RUN_KF(kernel_shiftleft_scalar, numBlocks, xDevice, outDevice, scalarValue);
#else
    kernel_shiftleft_scalar<<<numBlocks, nullptr, stream>>>(
        xDevice, outDevice, scalarValue);
    aclrtSynchronizeStream(stream);
#endif

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
