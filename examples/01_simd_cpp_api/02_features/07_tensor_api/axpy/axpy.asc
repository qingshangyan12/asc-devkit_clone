/*!
 * \file axpy.asc
 * \brief Tensor API Ternary Transform 示例 - axpy
 * 
 * 演示使用 Ascend C 基础 API 的 Axpy 实现向量乘标量后累加操作
 * 数学公式：out = src * scalar + out
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#if defined(ASCENDC_CPU_DEBUG)
#include "tikicpulib.h"
#endif

constexpr uint32_t TOTAL_LENGTH = 512;

class KernelAxpy {
public:
    __aicore__ inline KernelAxpy() {}
    
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, half scalarValue)
    {
        this->scalar = scalarValue;
        srcGlobal.SetGlobalBuffer((__gm__ half*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ half*)dstGm);
        
        pipe.InitBuffer(inQueueSrc, 1, TOTAL_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueDst, 1, TOTAL_LENGTH * sizeof(half));
    }
    
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.AllocTensor<half>();
        AscendC::DataCopy(srcLocal, srcGlobal, TOTAL_LENGTH);
        inQueueSrc.EnQue(srcLocal);
        
        AscendC::LocalTensor<half> dstLocal = inQueueDst.AllocTensor<half>();
        AscendC::DataCopy(dstLocal, dstGlobal, TOTAL_LENGTH);
        inQueueDst.EnQue(dstLocal);
    }
    
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.DeQue<half>();
        AscendC::LocalTensor<half> dstLocal = inQueueDst.DeQue<half>();
        
        // Axpy: dst = src * scalar + dst
        // dstLocal is both input and output, modified in place
        AscendC::Axpy(dstLocal, srcLocal, scalar, TOTAL_LENGTH);
        
        // Re-enqueue to the same queue (inQueueDst) since we modified it in place
        inQueueDst.EnQue<half>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dstLocal = inQueueDst.DeQue<half>();
        AscendC::DataCopy(dstGlobal, dstLocal, TOTAL_LENGTH);
        inQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueDst;
    AscendC::GlobalTensor<half> srcGlobal;
    AscendC::GlobalTensor<half> dstGlobal;
    half scalar;
};

__global__ __vector__ void kernel_axpy(
    __gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, half scalarValue)
{
    KernelAxpy op;
    op.Init(srcGm, dstGm, scalarValue);
    op.Process();
}

int32_t main(int32_t argc, char *argv[]) {
    uint32_t numBlocks = 1;
    size_t inputByteSize = TOTAL_LENGTH * sizeof(half);
    size_t outputByteSize = TOTAL_LENGTH * sizeof(half);
    half scalarValue = 2.0;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *outHost;
    uint8_t *xDevice, *outDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&outHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    
    // Initialize output buffer to zeros (axpy: out = src * scalar + out)
    memset(outHost, 0, outputByteSize);
    aclrtMemcpy(outDevice, outputByteSize, outHost, outputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

#if defined(ASCENDC_CPU_DEBUG)
    AscendC::SetKernelMode(KernelMode::AIV_MODE);
    ICPU_RUN_KF(kernel_axpy, numBlocks, xDevice, outDevice, scalarValue);
#else
    kernel_axpy<<<numBlocks, nullptr, stream>>>(
        xDevice, outDevice, scalarValue);
    aclrtSynchronizeStream(stream);
#endif

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
