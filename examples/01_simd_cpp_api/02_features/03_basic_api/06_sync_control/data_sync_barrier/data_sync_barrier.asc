/* !
 * \file data_sync_barrier.asc
 * \brief 本样例在数据搬运场景下，基于DataSyncBarrier实现核内内存访问完成屏障同步，确保数据从GM搬运到UB完成后才开始后续搬运。
 *        样例实现GM到UB再到GM的纯数据搬运，数据量为8192，数据类型为float。
 *        静态Tensor版本。
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t TOTAL_LENGTH = 8192;

class KernelDataSyncBarrier {
public:
    __aicore__ inline KernelDataSyncBarrier() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x));
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z));
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, TOTAL_LENGTH>();

        Copy(xLocal);
    }

private:
    __aicore__ inline void Copy(AscendC::LocalTensor<float>& xLocal)
    {
        AscendC::DataCopy(xLocal, xGm, TOTAL_LENGTH);

        // AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
        // AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

        AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();

        AscendC::DataCopy(zGm, xLocal, TOTAL_LENGTH);

    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> zGm;
};

extern "C" __global__ __vector__ void kernel_data_sync_barrier(GM_ADDR x, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelDataSyncBarrier op;
    op.Init(x, z);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = TOTAL_LENGTH * sizeof(float);
    size_t outputByteSize = TOTAL_LENGTH * sizeof(float);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_data_sync_barrier<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}