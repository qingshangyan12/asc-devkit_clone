    AscendC::TQue<AscendC::TPosition::VECIN, 1> srcQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> dstQueue;
};

extern "C" __global__ __vector__ void kernel_data_sync_barrier(GM_ADDR srcGm, GM_ADDR tmpGm, GM_ADDR dstGm)
