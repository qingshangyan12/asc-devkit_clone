/* !
 * \file data_sync_barrier.asc
 * \brief 演示DataSyncBarrier接口的使用，在核内阻塞后续指令执行，确保数据写入GM全局可见后再执行后续读取
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t DATA_SIZE = 32;

/**
 * @brief DataSyncBarrier样例Kernel类，演示核内数据写入全局可见的同步机制
 * 
 * 本样例演示DataSyncBarrier确保核内数据写入全局可见的场景：
 * - 先通过DataCopy向GM写入数据
 * - 使用DataSyncBarrier阻塞后续指令，确保写入完成
 * - 然后读取写入的数据进行加法计算，验证数据已全局可见
 */
template <typename T>
class KernelDataSyncBarrier {
public:
    __aicore__ inline KernelDataSyncBarrier() {}
    __aicore__ inline void Init(GM_ADDR srcGm, GM_ADDR tmpGm, GM_ADDR dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;

        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcGm));
        tmpGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(tmpGm));
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGm));

        pipe->InitBuffer(srcQueue, 1, DATA_SIZE * sizeof(T));
        pipe->InitBuffer(dstQueue, 1, DATA_SIZE * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        WriteData();
        AscendC::DataSyncBarrier<AscendC::MemDsbT::DDR>();
        ReadAndCompute();
    }

private:
    __aicore__ inline void WriteData()
    {
        AscendC::LocalTensor<T> srcLocal = srcQueue.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, DATA_SIZE);
        srcQueue.EnQue(srcLocal);

        AscendC::LocalTensor<T> srcData = srcQueue.DeQue<T>();
        AscendC::DataCopy(tmpGlobal, srcData, DATA_SIZE);
        srcQueue.FreeTensor(srcData);
    }

    __aicore__ inline void ReadAndCompute()
    {
        AscendC::LocalTensor<T> tmpLocal = srcQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> srcLocal = dstQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> dstLocal = dstQueue.AllocTensor<T>();

        AscendC::DataCopy(tmpLocal, tmpGlobal, DATA_SIZE);
        AscendC::DataCopy(srcLocal, srcGlobal, DATA_SIZE);
        AscendC::Add(dstLocal, tmpLocal, srcLocal, DATA_SIZE);
        AscendC::DataCopy(dstGlobal, dstLocal, DATA_SIZE);

        srcQueue.FreeTensor(tmpLocal);
        dstQueue.FreeTensor(srcLocal);
        dstQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> tmpGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> srcQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> dstQueue;
};

extern "C" __global__ __vector__ void kernel_data_sync_barrier(GM_ADDR srcGm, GM_ADDR tmpGm, GM_ADDR dstGm)
{
    AscendC::TPipe pipe;
    KernelDataSyncBarrier<float> op;
    op.Init(srcGm, tmpGm, dstGm, &pipe);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_SIZE * sizeof(float);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* srcHost, * tmpHost, * dstHost;
    uint8_t* srcDevice, * tmpDevice, * dstDevice;

    aclrtMallocHost((void**)&srcHost, dataByteSize);
    aclrtMallocHost((void**)&tmpHost, dataByteSize);
    aclrtMallocHost((void**)&dstHost, dataByteSize);
    aclrtMalloc((void**)&srcDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tmpDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t fileSize = 0;
    ReadFile("./input/input_x.bin", fileSize, srcHost, dataByteSize);

    aclrtMemcpy(srcDevice, dataByteSize, srcHost, dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_data_sync_barrier<<<1, nullptr, stream>>>(srcDevice, tmpDevice, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, dataByteSize, dstDevice, dataByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, dataByteSize);

    aclrtFree(srcDevice);
    aclrtFree(tmpDevice);
    aclrtFree(dstDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(tmpHost);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclrtFinalize();

    return 0;
}/**
