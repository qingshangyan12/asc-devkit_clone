}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_SIZE * sizeof(float);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* srcHost, * tmpHost, * dstHost;
    uint8_t* srcDevice, * tmpDevice, * dstDevice;

    aclrtMallocHost((void**)&srcHost, dataByteSize);
    aclrtMallocHost((void**)&tmpHost, dataByteSize);
    aclrtMallocHost((void**)&dstHost, dataByteSize);
    aclrtMalloc((void**)&srcDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tmpDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t fileSize = 0;
    ReadFile("./input/input_x.bin", fileSize, srcHost, dataByteSize);

    aclrtMemcpy(srcDevice, dataByteSize, srcHost, dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_data_sync_barrier<<<1, nullptr, stream>>>(srcDevice, tmpDevice, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, dataByteSize, dstDevice, dataByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, dataByteSize);

    aclrtFree(srcDevice);
    aclrtFree(tmpDevice);
    aclrtFree(dstDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(tmpHost);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
