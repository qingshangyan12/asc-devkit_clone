/* !
 * \file pipeline_sync.asc
 * \brief 基于PipeBarrier和SetFlag/WaitFlag实现核内多流水同步
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t TILE_LENGTH = 256;
constexpr uint32_t TILE_NUM = 3;

/**
 * @brief 场景1（Vector模式）：Add+Mul计算
 */
class KernelPipelineSyncVector {
public:
    __aicore__ inline KernelPipelineSyncVector() = default;
    __aicore__ inline void Init(GM_ADDR src0, GM_ADDR src1, GM_ADDR dst)
    {
        src0Gm.SetGlobalBuffer((__gm__ float *)src0);
        src1Gm.SetGlobalBuffer((__gm__ float *)src1);
        dstGm.SetGlobalBuffer((__gm__ float *)dst);
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> src0Local(AscendC::TPosition::VECCALC, src0Addr, TILE_LENGTH);
        AscendC::LocalTensor<float> src1Local(AscendC::TPosition::VECCALC, src1Addr, TILE_LENGTH);
        AscendC::LocalTensor<float> dstLocal(AscendC::TPosition::VECCALC, dstAddr, TILE_LENGTH);
        AscendC::LocalTensor<float> dst2Local(AscendC::TPosition::VECCALC, dst2Addr, TILE_LENGTH);

        for (uint32_t i = 0; i < TILE_NUM; i++) {
            // V_MTE2事件：等待上一轮计算完成释放输入缓冲区后，才能重新搬入数据
            if (i != 0) {
                // 等待上一轮输入缓冲区释放，避免覆盖未消费数据
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            }

            AscendC::DataCopy(src0Local, src0Gm[i * TILE_LENGTH], TILE_LENGTH);
            AscendC::DataCopy(src1Local, src1Gm[i * TILE_LENGTH], TILE_LENGTH);

            // MTE2_V事件：设置搬入完成标志，计算流水等待数据搬入完成后开始计算
            // 通知计算流水：输入数据已经搬入完成
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            // 等待输入数据就绪后再进入向量计算
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            // MTE3_V事件：等待上一轮搬出完成释放输出缓冲区后，才能写入本轮结果
            if (i != 0) {
                // 等待上一轮输出缓冲区释放，避免覆盖未搬出的结果
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }

            // ===================== Vector计算阶段 (PIPE_V) =====================
            // dst = src0 + src1
            AscendC::Add(dstLocal, src0Local, src1Local, TILE_LENGTH);
            // 阻塞PIPE_V流水，确保Add计算完成后再执行Mul，避免数据依赖问题
            // 阻塞矢量流水，保证Add结果先完成再进入Mul
            AscendC::PipeBarrier<PIPE_V>();
            // dst2 = dst * src0 = (src0 + src1) * src0
            AscendC::Mul(dst2Local, dstLocal, src0Local, TILE_LENGTH);

            // V_MTE2事件：通知下一轮可以开始搬入数据（释放输入缓冲区）
            if (i != (TILE_NUM - 1)) {
                // 通知下一轮可以复用输入缓冲区
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            }

            // V_MTE3事件：设置计算完成标志，搬出流水等待计算完成后数据才有效
            // 通知搬出流水：本轮结果已准备好
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            // 等待搬出阶段可用后再写回GM
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopy(dstGm[i * TILE_LENGTH], dst2Local, TILE_LENGTH);

            // MTE3_V事件：通知下一轮可以开始计算（释放输出缓冲区）
            if (i != (TILE_NUM - 1)) {
                // 通知下一轮计算可以复用输出缓冲区
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
    }

private:
    static constexpr uint32_t src0Addr = 0;
    static constexpr uint32_t src1Addr = TILE_LENGTH * sizeof(float);
    static constexpr uint32_t dstAddr = TILE_LENGTH * sizeof(float) * 2;
    static constexpr uint32_t dst2Addr = TILE_LENGTH * sizeof(float) * 3;
    AscendC::GlobalTensor<float> src0Gm;
    AscendC::GlobalTensor<float> src1Gm;
    AscendC::GlobalTensor<float> dstGm;
};

/**
 * @brief 场景2（Cube模式）：Mmad矩阵乘法计算
 */
class KernelPipelineSyncCube {
public:
    __aicore__ inline KernelPipelineSyncCube() {}
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c)
    {
        aGM.SetGlobalBuffer((__gm__ half*)a);
        bGM.SetGlobalBuffer((__gm__ half*)b);
        cGM.SetGlobalBuffer((__gm__ float*)c);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> a1Local(AscendC::TPosition::A1, a1Addr, baseM * baseK);
        AscendC::LocalTensor<half> a2Local(AscendC::TPosition::A2, a2Addr, baseM * baseK);
        AscendC::LocalTensor<half> b1Local(AscendC::TPosition::B1, b1Addr, baseK * baseN);
        AscendC::LocalTensor<half> b2Local(AscendC::TPosition::B2, b2Addr, baseK * baseN);
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, cAddr, baseM * baseN);

        constexpr uint32_t kLoopCount = singleCoreK / baseK;
        constexpr uint32_t mLoopCount = singleCoreM / baseM;
        constexpr uint32_t nLoopCount = singleCoreN / baseN;
        // 在K轴循环内按搬入、加载、计算、搬出的顺序建立反向同步
        for (uint32_t mIndex = 0; mIndex < mLoopCount; mIndex++) {
            for (uint32_t nIndex = 0; nIndex < nLoopCount; nIndex++) {
                for (uint32_t kIndex = 0; kIndex < kLoopCount; kIndex++) {
                    CopyInA(a1Local, kIndex, mIndex);
                    CopyInB(b1Local, kIndex, nIndex);

                    // A/B搬入完成后，通知L1加载阶段可以读取
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                    // 等待A/B大包数据就绪，再进入L1到L0加载
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

                    DataLoadA(a1Local, a2Local, mIndex);
                    DataLoadB(b1Local, b2Local, nIndex);

                    // L0加载完成后，通知Cube计算阶段可以读取
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    // 等待L0数据准备完成，再执行Mmad计算
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                    // ===================== Cube计算阶段 (PIPE_M) =====================
                    Compute(cLocal, a2Local, b2Local, kIndex, mIndex, nIndex);
                    // 阻塞PIPE_M流水，确保Mmad计算完成后再进行后续操作
                    // 阻塞Cube流水，确保本轮矩阵乘计算结束
                    AscendC::PipeBarrier<PIPE_M>();

                    // 当前计算缓冲区已消费完成，通知下一轮可以复用
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE2>(EVENT_ID0);
                    // 等待下一轮复用条件满足
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE2>(EVENT_ID0);
                }
                // L0结果准备搬出前，先等待搬出通道满足写回条件
                AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                // 等待结果搬出通道就绪后再执行Fixpipe
                AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                CopyOut(cLocal, mIndex, nIndex);
            }
        }
        // 收尾阻塞所有流水，确保当前核内全部阶段完成
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    __aicore__ inline void CopyInA(AscendC::LocalTensor<half> a1Local, uint32_t kIndex, uint32_t mIndex)
    {
        AscendC::Nd2NzParams nd2nzA1Params;
        nd2nzA1Params.ndNum = 1;
        nd2nzA1Params.nValue = baseM;
        nd2nzA1Params.dValue = baseK;
        nd2nzA1Params.srcNdMatrixStride = 0;
        nd2nzA1Params.srcDValue = singleCoreK;
        nd2nzA1Params.dstNzC0Stride = baseM;
        nd2nzA1Params.dstNzNStride = 1;
        nd2nzA1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kIndex * baseK + mIndex * singleCoreK * baseM], nd2nzA1Params);
    }

    __aicore__ inline void CopyInB(AscendC::LocalTensor<half> b1Local, uint32_t kIndex, uint32_t nIndex)
    {
        AscendC::Nd2NzParams nd2nzB1Params;
        nd2nzB1Params.ndNum = 1;
        nd2nzB1Params.nValue = baseK;
        nd2nzB1Params.dValue = baseN;
        nd2nzB1Params.srcNdMatrixStride = 0;
        nd2nzB1Params.srcDValue = singleCoreN;
        nd2nzB1Params.dstNzC0Stride = baseK;
        nd2nzB1Params.dstNzNStride = 1;
        nd2nzB1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1Local, bGM[kIndex * baseK * singleCoreN + nIndex * baseN], nd2nzB1Params);
    }

    __aicore__ inline void DataLoadA(
        AscendC::LocalTensor<half> a1Local, AscendC::LocalTensor<half> a2Local, uint32_t mIndex)
    {
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201 || __NPU_ARCH__ == 2202)
        constexpr uint32_t dstOffset = baseK * CUBE_BLOCK;
        constexpr uint32_t srcOffset = 512 / sizeof(half);
        AscendC::LoadData2DParams loadDataParamsA;
        loadDataParamsA.repeatTimes = baseK / CUBE_BLOCK;
        loadDataParamsA.srcStride = baseM / CUBE_BLOCK;
        loadDataParamsA.dstGap = 0;
        loadDataParamsA.ifTranspose = false;
        for (int i = 0; i < baseM / CUBE_BLOCK; ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParamsA);
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 loadDataParamsA;
        loadDataParamsA.mStartPosition = 0;
        loadDataParamsA.kStartPosition = 0;
        loadDataParamsA.mStep = AscendC::DivCeil(baseM, CUBE_BLOCK);
        loadDataParamsA.kStep = AscendC::DivCeil(baseK * sizeof(half), 32);
        loadDataParamsA.srcStride = AscendC::DivCeil(baseM, CUBE_BLOCK);
        loadDataParamsA.dstStride = AscendC::DivCeil(baseM, CUBE_BLOCK);
        loadDataParamsA.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local, loadDataParamsA);
#endif
    }

    __aicore__ inline void DataLoadB(
        AscendC::LocalTensor<half> b1Local, AscendC::LocalTensor<half> b2Local, uint32_t nIndex)
    {
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201 || __NPU_ARCH__ == 2202)
        constexpr uint32_t dstOffset = baseN * CUBE_BLOCK;
        constexpr uint32_t srcOffset = 512 / sizeof(half);
        AscendC::LoadData2DParams loadDataParamsB;
        loadDataParamsB.repeatTimes = baseN / CUBE_BLOCK;
        loadDataParamsB.srcStride = baseK / CUBE_BLOCK;
        loadDataParamsB.dstGap = 0;
        loadDataParamsB.ifTranspose = true;
        for (int i = 0; i < baseK / CUBE_BLOCK; ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], b1Local[i * srcOffset], loadDataParamsB);
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 loadDataParamsB;
        loadDataParamsB.mStartPosition = 0;
        loadDataParamsB.kStartPosition = 0;
        loadDataParamsB.mStep = AscendC::DivCeil(baseK, CUBE_BLOCK);
        loadDataParamsB.kStep = AscendC::DivCeil(baseN * sizeof(half), 32);
        loadDataParamsB.srcStride = AscendC::DivCeil(baseK, CUBE_BLOCK);
        loadDataParamsB.dstStride = AscendC::DivCeil(baseN, CUBE_BLOCK);
        loadDataParamsB.ifTranspose = true;
        AscendC::LoadData(b2Local, b1Local, loadDataParamsB);
#endif
    }

    __aicore__ inline void Compute(
        AscendC::LocalTensor<float> cLocal, AscendC::LocalTensor<half> a2Local, AscendC::LocalTensor<half> b2Local,
        uint32_t kIndex, uint32_t mIndex, uint32_t nIndex)
    {
        AscendC::MmadParams mmadParams;
        mmadParams.m = baseM;
        mmadParams.n = baseN;
        mmadParams.k = baseK;
        mmadParams.cmatrixInitVal = (kIndex == 0 ? true : false);
        AscendC::Mmad(cLocal, a2Local, b2Local, mmadParams);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float> cLocal, uint32_t mIndex, uint32_t nIndex)
    {
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = baseN;
        fixpipeParams.mSize = baseM;
        fixpipeParams.srcStride = baseM;
        fixpipeParams.dstStride = singleCoreN;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        AscendC::Fixpipe(cGM[mIndex * baseM * singleCoreN + nIndex * baseN], cLocal, fixpipeParams);
    }

private:
    uint64_t a1Addr = 0;
    uint64_t a2Addr = 0;
    // L1 size = 512KB，将L1的地址从中间分开，分别存储A和B矩阵的数据
    uint64_t b1Addr = 256 * 1024;
    uint64_t b2Addr = 0;
    uint64_t cAddr = 0;
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<float> cGM;

    static constexpr uint32_t singleCoreM = 128;
    static constexpr uint32_t singleCoreK = 512;
    static constexpr uint32_t singleCoreN = 128;
    static constexpr uint32_t baseM = 128;
    static constexpr uint32_t baseK = 64;
    static constexpr uint32_t baseN = 128;
    static constexpr uint32_t CUBE_BLOCK = 16;
};

extern "C" __global__ __vector__ void pipeline_sync_vector_custom(GM_ADDR src0, GM_ADDR src1, GM_ADDR dst)
{
    AscendC::InitSocState();
    KernelPipelineSyncVector op;
    op.Init(src0, src1, dst);
    op.Process();
}

extern "C" __global__ __cube__ void pipeline_sync_cube_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::InitSocState();
    KernelPipelineSyncCube op;
    op.Init(a, b, c);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    size_t inputSize, outputSize;

#if defined(SCENARIO_NUM) && (SCENARIO_NUM == 2)
    constexpr uint32_t M = 128, K = 512, N = 128;
    inputSize = M * K * sizeof(half);  // A矩阵
    outputSize = M * N * sizeof(float);  // C矩阵
#else
    constexpr uint32_t TILE_LENGTH = 256, TILE_NUM = 3;
    inputSize = TILE_LENGTH * TILE_NUM * sizeof(float);
    outputSize = TILE_LENGTH * TILE_NUM * sizeof(float);
#endif

    uint8_t *src0Host, *src0Device;
    aclrtMallocHost((void **)&src0Host, inputSize);
    aclrtMalloc((void **)&src0Device, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_src0.bin", inputSize, src0Host, inputSize);
    aclrtMemcpy(src0Device, inputSize, src0Host, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *src1Host, *src1Device;
    aclrtMallocHost((void **)&src1Host, inputSize);
    aclrtMalloc((void **)&src1Device, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_src1.bin", inputSize, src1Host, inputSize);
    aclrtMemcpy(src1Device, inputSize, src1Host, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *dstHost, *dstDevice;
    aclrtMallocHost((void **)&dstHost, outputSize);
    aclrtMalloc((void **)&dstDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

#if defined(SCENARIO_NUM) && (SCENARIO_NUM == 2)
    pipeline_sync_cube_custom<<<1, nullptr, stream>>>(src0Device, src1Device, dstDevice);
#else
    pipeline_sync_vector_custom<<<1, nullptr, stream>>>(src0Device, src1Device, dstDevice);
#endif
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, outputSize, dstDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, outputSize);

    aclrtFree(src0Device);
    aclrtFreeHost(src0Host);
    aclrtFree(src1Device);
    aclrtFreeHost(src1Host);
    aclrtFree(dstDevice);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
