/* !
 * \file get_ub_size.asc
 * \brief GetUBSize样例，展示GetUBSizeInBytes和GetRuntimeUBSize接口使用方法
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t EVENT_ID0 = 0;

template<uint32_t scenario>
class KernelGetUBSize {
public:
    __aicore__ inline KernelGetUBSize() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        if constexpr (scenario == 1) {
            // 场景1：GetUBSizeInBytes，返回编译时常量
            if (totalLength > AscendC::GetUBSizeInBytes() / sizeof(half) / 2) {
                this->tileLength = AscendC::GetUBSizeInBytes() / sizeof(half) / 2;
            } else {
                this->tileLength = this->totalLength;
            }
        } else if constexpr (scenario == 2) {
            // 场景2：GetRuntimeUBSize，返回运行时变量
            this->tileLength = AscendC::GetRuntimeUBSize() / sizeof(half) / 2;
        }
        this->tileNum = this->totalLength / this->tileLength;
        
        xGm.SetGlobalBuffer((__gm__ half *)x);
        zGm.SetGlobalBuffer((__gm__ half *)z);
        
        // 静态地址分配
        xAddr = 0;
        zAddr = xAddr + this->tileLength * sizeof(half);
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> xLocal(AscendC::TPosition::VECIN, xAddr, this->tileLength);
        AscendC::LocalTensor<half> zLocal(AscendC::TPosition::VECOUT, zAddr, this->tileLength);
        
        for (int32_t i = 0; i < this->tileNum; i++) {
            CopyIn(xLocal, i);
            Compute(zLocal, xLocal, i);
            CopyOut(zLocal, i);
        }
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<half>& xLocal, int32_t progress)
    {
        // GM -> UB: MTE2流水搬运
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    }
    __aicore__ inline void Compute(AscendC::LocalTensor<half>& zLocal, AscendC::LocalTensor<half>& xLocal, int32_t progress)
    {
        // Vector计算：Abs取绝对值
        AscendC::Abs(zLocal, xLocal, this->tileLength);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    }
    __aicore__ inline void CopyOut(AscendC::LocalTensor<half>& zLocal, int32_t progress)
    {
        // UB -> GM: MTE3流水搬运
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
    }

private:
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> zGm;
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
    uint64_t xAddr;
    uint64_t zAddr;
};

__global__ __vector__ void get_ub_size_custom(GM_ADDR x, GM_ADDR z)
{
    AscendC::InitSocState();
    
    if constexpr (scenarioNum == 1) {
        // 场景1：GetUBSizeInBytes
        KernelGetUBSize<1> op;
        uint32_t totalLength = 16384;
        op.Init(x, z, totalLength);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        // 场景2：GetRuntimeUBSize
        KernelGetUBSize<2> op;
        uint32_t totalLength = 126976;
        op.Init(x, z, totalLength);
        op.Process();
    } else {
        AscendC::printf("scenarioNum %d is not supported!\n", scenarioNum);
    }
    
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;
    
    if constexpr (scenarioNum == 1) {
        inputByteSize = 16384 * sizeof(half);
        outputByteSize = 16384 * sizeof(half);
    } else if constexpr (scenarioNum == 2) {
        inputByteSize = 126976 * sizeof(half);
        outputByteSize = 126976 * sizeof(half);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    
    get_ub_size_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
