#include <cstdint>
#include <iostream>

#include "basic_api/kernel_operator_block_sync_intf.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/histogram_compute.h"

constexpr uint32_t INPUT_LENGTH = 256;
constexpr uint32_t BIN_LENGTH = 128;
constexpr uint32_t RESULT_ROWS = 4;
constexpr uint32_t INITIAL_VALUE = 3;
constexpr asc::te::histogram_options frequency_high_options {
    asc::te::histogram_half::high, asc::te::histogram_mode::frequency};
constexpr asc::te::histogram_options cumulative_low_options {
    asc::te::histogram_half::low, asc::te::histogram_mode::cumulative};
constexpr asc::te::histogram_options cumulative_high_options {
    asc::te::histogram_half::high, asc::te::histogram_mode::cumulative};

enum result_row : uint32_t {
    ROW_FREQUENCY_LOW,
    ROW_FREQUENCY_HIGH,
    ROW_CUMULATIVE_LOW,
    ROW_CUMULATIVE_HIGH,
};

__simd_vf__ inline void compute(__ubuf__ uint8_t* input, __ubuf__ uint16_t* output)
{
    auto input_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, INPUT_LENGTH);
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, BIN_LENGTH);
    auto input_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(input), input_layout);
    auto result = asc::te::make_tensor(asc::te::make_mem_ptr(output), output_layout);

    auto src = input_tensor.load(asc::te::make_coord(0, 0)).with_mask(asc::te::ones<uint8_t>());
    asc::te::reg_tensor<uint16_t> initial;
    initial.mask = asc::te::ones<uint16_t>().reg;
    asc_duplicate_scalar(initial.reg, static_cast<uint16_t>(INITIAL_VALUE), initial.mask);

    result.store(asc::te::make_coord(ROW_FREQUENCY_LOW, 0), asc::te::histograms(initial, src));
    result.store(asc::te::make_coord(ROW_FREQUENCY_HIGH, 0),
        asc::te::histograms<frequency_high_options>(initial, src));
    result.store(asc::te::make_coord(ROW_CUMULATIVE_LOW, 0),
        asc::te::histograms<cumulative_low_options>(initial, src));
    result.store(asc::te::make_coord(ROW_CUMULATIVE_HIGH, 0),
        asc::te::histograms<cumulative_high_options>(initial, src));
}

__global__ __vector__ void histogram_compute_tensor_api(__gm__ uint8_t* input, __gm__ uint16_t* output)
{
    constexpr uint32_t input_offset = 0;
    constexpr uint32_t output_offset = INPUT_LENGTH;

    auto input_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, INPUT_LENGTH);
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, BIN_LENGTH);
    auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input), input_layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), output_layout);
    auto input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint8_t>(input_offset), input_layout);
    auto output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint16_t>(output_offset), output_layout);

    asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), input_ub, input_gm);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    compute(input_ub.data().get(), output_ub.data().get());

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_ub);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<uint8_t> input;
    example::buffer<uint16_t> output;
    if (!runtime.init() || !input.load_to_device("./input/input.bin", INPUT_LENGTH) ||
        !output.allocate(RESULT_ROWS * BIN_LENGTH)) {
        return 1;
    }

    histogram_compute_tensor_api<<<1, 0, runtime.stream()>>>(input.device(), output.device());
    if (!runtime.synchronize() || !output.save_from_device("./output/output.bin")) {
        return 1;
    }
    std::cout << "histogram_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
