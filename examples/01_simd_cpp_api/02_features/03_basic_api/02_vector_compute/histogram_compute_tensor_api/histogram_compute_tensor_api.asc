#include <cstdint>
#include <iostream>

#include "basic_api/kernel_operator_block_sync_intf.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/histogram_compute.h"

constexpr uint32_t INPUT_LENGTH = 256;
constexpr uint32_t BIN_LENGTH = 128;
constexpr uint32_t RESULT_ROWS = 4;
constexpr uint32_t INITIAL_VALUE = 3;

enum result_row : uint32_t {
    ROW_FREQUENCY_BIN0,
    ROW_FREQUENCY_BIN1,
    ROW_ACCUMULATE_BIN0,
    ROW_ACCUMULATE_BIN1,
};

__simd_vf__ inline void compute(__ubuf__ uint8_t* input, __ubuf__ uint16_t* output)
{
    using namespace AscendC::Te;
    auto input_layout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, INPUT_LENGTH);
    auto output_layout = MakeFrameLayout<NDExtLayoutPtn>(RESULT_ROWS, BIN_LENGTH);
    auto input_tensor = MakeTensor(MakeMemPtr(input), input_layout);
    auto result = MakeTensor(MakeMemPtr(output), output_layout);

    auto src = input_tensor.load(MakeCoord(0, 0)).with_mask(asc::te::ones<uint8_t>());
    asc::te::reg_tensor<uint16_t> initial;
    initial.mask = asc::te::ones<uint16_t>().reg;
    asc_duplicate_scalar(initial.reg, static_cast<uint16_t>(INITIAL_VALUE), initial.mask);

    result.store(MakeCoord(ROW_FREQUENCY_BIN0, 0), asc::te::histograms<
        asc::te::histogram_bin::bin0, asc::te::histogram_type::frequency>(initial, src));
    result.store(MakeCoord(ROW_FREQUENCY_BIN1, 0), asc::te::histograms<
        asc::te::histogram_bin::bin1, asc::te::histogram_type::frequency>(initial, src));
    result.store(MakeCoord(ROW_ACCUMULATE_BIN0, 0), asc::te::histograms<
        asc::te::histogram_bin::bin0, asc::te::histogram_type::accumulate>(initial, src));
    result.store(MakeCoord(ROW_ACCUMULATE_BIN1, 0), asc::te::histograms<
        asc::te::histogram_bin::bin1, asc::te::histogram_type::accumulate>(initial, src));
}

__global__ __vector__ void histogram_compute_tensor_api(__gm__ uint8_t* input, __gm__ uint16_t* output)
{
    using namespace AscendC::Te;
    constexpr uint32_t input_offset = 0;
    constexpr uint32_t output_offset = INPUT_LENGTH;

    auto input_layout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, INPUT_LENGTH);
    auto output_layout = MakeFrameLayout<NDExtLayoutPtn>(RESULT_ROWS, BIN_LENGTH);
    auto input_gm = MakeTensor(MakeMemPtr<Location::GM>(input), input_layout);
    auto output_gm = MakeTensor(MakeMemPtr<Location::GM>(output), output_layout);
    auto input_ub = MakeTensor(MakeMemPtr<Location::UB, uint8_t>(input_offset), input_layout);
    auto output_ub = MakeTensor(MakeMemPtr<Location::UB, uint16_t>(output_offset), output_layout);

    Copy(MakeCopy(CopyGM2UB {}), input_ub, input_gm);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    compute(input_ub.Data().Get(), output_ub.Data().Get());

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    Copy(MakeCopy(CopyUB2GM {}), output_gm, output_ub);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<uint8_t> input;
    example::buffer<uint16_t> output;
    if (!runtime.init() || !input.load_to_device("./input/input.bin", INPUT_LENGTH) ||
        !output.allocate(RESULT_ROWS * BIN_LENGTH)) {
        return 1;
    }

    histogram_compute_tensor_api<<<1, 0, runtime.stream()>>>(input.device(), output.device());
    if (!runtime.synchronize() || !output.save_from_device("./output/output.bin")) {
        return 1;
    }
    std::cout << "histogram_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
