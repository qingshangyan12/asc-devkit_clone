/*!
 * \file reg_compute_tensor_api.asc
 * \brief Return-value-style register basic compute API sample for NPU architecture 3510.
 */

#include <cstdint>
#include <iostream>
#include <string>

#include "acl/acl.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/reg_compute.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(float);

enum FloatResultRow : uint32_t {
    FLOAT_ABS,
    FLOAT_EXP,
    FLOAT_SQRT,
    FLOAT_LOG,
    FLOAT_LOG2,
    FLOAT_LOG10,
    FLOAT_NEG,
    FLOAT_RELU,
    FLOAT_PRELU_REG,
    FLOAT_PRELU_SCALAR,
    FLOAT_PRELU_DEFAULT,
    FLOAT_LEAKY_RELU_SCALAR,
    FLOAT_LEAKY_RELU_DEFAULT,
    FLOAT_ADD_REG,
    FLOAT_ADD_SCALAR_RIGHT,
    FLOAT_ADD_SCALAR_LEFT,
    FLOAT_SUB_REG,
    FLOAT_SUB_SCALAR_RIGHT,
    FLOAT_SUB_SCALAR_LEFT,
    FLOAT_MUL_REG,
    FLOAT_MUL_SCALAR_RIGHT,
    FLOAT_MUL_SCALAR_LEFT,
    FLOAT_DIV_REG,
    FLOAT_DIV_SCALAR_RIGHT,
    FLOAT_DIV_SCALAR_LEFT,
    FLOAT_MAX_REG,
    FLOAT_MAX_SCALAR_RIGHT,
    FLOAT_MAX_SCALAR_LEFT,
    FLOAT_MIN_REG,
    FLOAT_MIN_SCALAR_RIGHT,
    FLOAT_MIN_SCALAR_LEFT,
    FLOAT_COMPARE_EQ,
    FLOAT_COMPARE_NE,
    FLOAT_COMPARE_LT,
    FLOAT_COMPARE_LE,
    FLOAT_COMPARE_GT,
    FLOAT_COMPARE_GE,
    FLOAT_MASKED_ADD,
    FLOAT_RESULT_ROWS,
};

enum IntResultRow : uint32_t {
    INT_LOGICAL_NOT,
    INT_AND_REG,
    INT_AND_SCALAR_RIGHT,
    INT_AND_SCALAR_LEFT,
    INT_OR_REG,
    INT_OR_SCALAR_RIGHT,
    INT_OR_SCALAR_LEFT,
    INT_XOR_REG,
    INT_XOR_SCALAR_RIGHT,
    INT_XOR_SCALAR_LEFT,
    INT_SHIFT_LEFT_REG,
    INT_SHIFT_LEFT_SCALAR,
    INT_SHIFT_RIGHT_REG,
    INT_SHIFT_RIGHT_SCALAR,
    INT_RESULT_ROWS,
};

template <typename OutputTensor>
__simd_callee__ inline void StorePredicate(OutputTensor& output, uint32_t row, asc::te::reg_tensor<float> zero,
    asc::te::reg_tensor<float> one, asc::te::reg_tensor<bool> predicate)
{
    using namespace AscendC::Te;
    output.store(MakeCoord(row, 0), zero);
    output.store(MakeCoord(row, 0), one.with_mask(predicate));
}

__simd_vf__ inline void ComputeFloat(__ubuf__ float* srcA, __ubuf__ float* srcB, __ubuf__ float* slope,
    __ubuf__ float* dst)
{
    using namespace AscendC::Te;
    auto inputLayout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
    auto outputLayout = MakeFrameLayout<NDExtLayoutPtn>(FLOAT_RESULT_ROWS, VECTOR_LENGTH);
    auto srcATensor = MakeTensor(MakeMemPtr(srcA), inputLayout);
    auto srcBTensor = MakeTensor(MakeMemPtr(srcB), inputLayout);
    auto slopeTensor = MakeTensor(MakeMemPtr(slope), inputLayout);
    auto outputTensor = MakeTensor(MakeMemPtr(dst), outputLayout);

    auto fullMask = asc::te::ones<float>();
    auto a = srcATensor.load(MakeCoord(0, 0)).with_mask(fullMask);
    auto b = srcBTensor.load(MakeCoord(0, 0)).with_mask(fullMask);
    auto slopeReg = slopeTensor.load(MakeCoord(0, 0)).with_mask(fullMask);
    auto positive = asc::te::abs(a) + 0.5f;

    outputTensor.store(MakeCoord(FLOAT_ABS, 0), asc::te::abs(a));
    outputTensor.store(MakeCoord(FLOAT_EXP, 0), asc::te::exp(a));
    outputTensor.store(MakeCoord(FLOAT_SQRT, 0), asc::te::sqrt(positive));
    outputTensor.store(MakeCoord(FLOAT_LOG, 0), asc::te::log(positive));
    outputTensor.store(MakeCoord(FLOAT_LOG2, 0), asc::te::log2(positive));
    outputTensor.store(MakeCoord(FLOAT_LOG10, 0), asc::te::log10(positive));
    outputTensor.store(MakeCoord(FLOAT_NEG, 0), -a);
    outputTensor.store(MakeCoord(FLOAT_RELU, 0), asc::te::relu(a));
    outputTensor.store(MakeCoord(FLOAT_PRELU_REG, 0), asc::te::prelu(a, slopeReg));
    outputTensor.store(MakeCoord(FLOAT_PRELU_SCALAR, 0), asc::te::prelu(a, 0.2f));
    outputTensor.store(MakeCoord(FLOAT_PRELU_DEFAULT, 0), asc::te::prelu(a));
    outputTensor.store(MakeCoord(FLOAT_LEAKY_RELU_SCALAR, 0), asc::te::leaky_relu(a, 0.1f));
    outputTensor.store(MakeCoord(FLOAT_LEAKY_RELU_DEFAULT, 0), asc::te::leaky_relu(a));

    outputTensor.store(MakeCoord(FLOAT_ADD_REG, 0), a + b);
    outputTensor.store(MakeCoord(FLOAT_ADD_SCALAR_RIGHT, 0), a + 1.0f);
    outputTensor.store(MakeCoord(FLOAT_ADD_SCALAR_LEFT, 0), 1.0f + a);
    outputTensor.store(MakeCoord(FLOAT_SUB_REG, 0), a - b);
    outputTensor.store(MakeCoord(FLOAT_SUB_SCALAR_RIGHT, 0), a - 1.0f);
    outputTensor.store(MakeCoord(FLOAT_SUB_SCALAR_LEFT, 0), 1.0f - a);
    outputTensor.store(MakeCoord(FLOAT_MUL_REG, 0), a * b);
    outputTensor.store(MakeCoord(FLOAT_MUL_SCALAR_RIGHT, 0), a * 2.0f);
    outputTensor.store(MakeCoord(FLOAT_MUL_SCALAR_LEFT, 0), 2.0f * a);
    outputTensor.store(MakeCoord(FLOAT_DIV_REG, 0), a / b);
    outputTensor.store(MakeCoord(FLOAT_DIV_SCALAR_RIGHT, 0), a / 2.0f);
    outputTensor.store(MakeCoord(FLOAT_DIV_SCALAR_LEFT, 0), 2.0f / positive);
    outputTensor.store(MakeCoord(FLOAT_MAX_REG, 0), asc::te::max(a, b));
    outputTensor.store(MakeCoord(FLOAT_MAX_SCALAR_RIGHT, 0), asc::te::max(a, 0.0f));
    outputTensor.store(MakeCoord(FLOAT_MAX_SCALAR_LEFT, 0), asc::te::max(0.0f, a));
    outputTensor.store(MakeCoord(FLOAT_MIN_REG, 0), asc::te::min(a, b));
    outputTensor.store(MakeCoord(FLOAT_MIN_SCALAR_RIGHT, 0), asc::te::min(a, 0.0f));
    outputTensor.store(MakeCoord(FLOAT_MIN_SCALAR_LEFT, 0), asc::te::min(0.0f, a));

    auto zero = a * 0.0f;
    auto one = zero + 1.0f;
    StorePredicate(outputTensor, FLOAT_COMPARE_EQ, zero, one, a == b);
    StorePredicate(outputTensor, FLOAT_COMPARE_NE, zero, one, a != 0.0f);
    StorePredicate(outputTensor, FLOAT_COMPARE_LT, zero, one, 0.0f < a);
    StorePredicate(outputTensor, FLOAT_COMPARE_LE, zero, one, a <= 0.0f);
    StorePredicate(outputTensor, FLOAT_COMPARE_GT, zero, one, 0.0f > a);
    StorePredicate(outputTensor, FLOAT_COMPARE_GE, zero, one, a >= b);

    auto maskedA = a;
    maskedA = maskedA.with_mask(a > 0.0f);
    outputTensor.store(MakeCoord(FLOAT_MASKED_ADD, 0), zero);
    outputTensor.store(MakeCoord(FLOAT_MASKED_ADD, 0), maskedA + 1.0f);
}

__simd_vf__ inline void ComputeInt(__ubuf__ int32_t* srcA, __ubuf__ int32_t* srcB, __ubuf__ int32_t* shift,
    __ubuf__ int32_t* dst)
{
    using namespace AscendC::Te;
    auto inputLayout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
    auto outputLayout = MakeFrameLayout<NDExtLayoutPtn>(INT_RESULT_ROWS, VECTOR_LENGTH);
    auto srcATensor = MakeTensor(MakeMemPtr(srcA), inputLayout);
    auto srcBTensor = MakeTensor(MakeMemPtr(srcB), inputLayout);
    auto shiftTensor = MakeTensor(MakeMemPtr(shift), inputLayout);
    auto outputTensor = MakeTensor(MakeMemPtr(dst), outputLayout);

    auto fullMask = asc::te::ones<int32_t>();
    auto a = srcATensor.load(MakeCoord(0, 0)).with_mask(fullMask);
    auto b = srcBTensor.load(MakeCoord(0, 0)).with_mask(fullMask);
    auto shiftReg = shiftTensor.load(MakeCoord(0, 0)).with_mask(fullMask);

    outputTensor.store(MakeCoord(INT_LOGICAL_NOT, 0), !a);
    outputTensor.store(MakeCoord(INT_AND_REG, 0), a & b);
    outputTensor.store(MakeCoord(INT_AND_SCALAR_RIGHT, 0), a & 15);
    outputTensor.store(MakeCoord(INT_AND_SCALAR_LEFT, 0), 15 & a);
    outputTensor.store(MakeCoord(INT_OR_REG, 0), a | b);
    outputTensor.store(MakeCoord(INT_OR_SCALAR_RIGHT, 0), a | 16);
    outputTensor.store(MakeCoord(INT_OR_SCALAR_LEFT, 0), 16 | a);
    outputTensor.store(MakeCoord(INT_XOR_REG, 0), a ^ b);
    outputTensor.store(MakeCoord(INT_XOR_SCALAR_RIGHT, 0), a ^ 7);
    outputTensor.store(MakeCoord(INT_XOR_SCALAR_LEFT, 0), 7 ^ a);
    outputTensor.store(MakeCoord(INT_SHIFT_LEFT_REG, 0), a << shiftReg);
    outputTensor.store(MakeCoord(INT_SHIFT_LEFT_SCALAR, 0), a << 2);
    outputTensor.store(MakeCoord(INT_SHIFT_RIGHT_REG, 0), a >> shiftReg);
    outputTensor.store(MakeCoord(INT_SHIFT_RIGHT_SCALAR, 0), a >> 2);
}

class KernelRegCompute {
public:
    __aicore__ inline void Process(__gm__ float* floatA, __gm__ float* floatB, __gm__ float* floatSlope,
        __gm__ int32_t* intA, __gm__ int32_t* intB, __gm__ int32_t* intShift, __gm__ float* floatOutput,
        __gm__ int32_t* intOutput)
    {
        using namespace AscendC::Te;
        constexpr uint32_t floatAOffset = 0;
        constexpr uint32_t floatBOffset = floatAOffset + VECTOR_BYTES;
        constexpr uint32_t floatSlopeOffset = floatBOffset + VECTOR_BYTES;
        constexpr uint32_t floatOutputOffset = floatSlopeOffset + VECTOR_BYTES;
        constexpr uint32_t intAOffset = floatOutputOffset + FLOAT_RESULT_ROWS * VECTOR_BYTES;
        constexpr uint32_t intBOffset = intAOffset + VECTOR_BYTES;
        constexpr uint32_t intShiftOffset = intBOffset + VECTOR_BYTES;
        constexpr uint32_t intOutputOffset = intShiftOffset + VECTOR_BYTES;

        auto inputLayout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
        auto floatOutputLayout = MakeFrameLayout<NDExtLayoutPtn>(FLOAT_RESULT_ROWS, VECTOR_LENGTH);
        auto intOutputLayout = MakeFrameLayout<NDExtLayoutPtn>(INT_RESULT_ROWS, VECTOR_LENGTH);

        auto floatAGm = MakeTensor(MakeMemPtr<Location::GM>(floatA), inputLayout);
        auto floatBGm = MakeTensor(MakeMemPtr<Location::GM>(floatB), inputLayout);
        auto floatSlopeGm = MakeTensor(MakeMemPtr<Location::GM>(floatSlope), inputLayout);
        auto intAGm = MakeTensor(MakeMemPtr<Location::GM>(intA), inputLayout);
        auto intBGm = MakeTensor(MakeMemPtr<Location::GM>(intB), inputLayout);
        auto intShiftGm = MakeTensor(MakeMemPtr<Location::GM>(intShift), inputLayout);
        auto floatOutputGm = MakeTensor(MakeMemPtr<Location::GM>(floatOutput), floatOutputLayout);
        auto intOutputGm = MakeTensor(MakeMemPtr<Location::GM>(intOutput), intOutputLayout);

        auto floatAUb = MakeTensor(MakeMemPtr<Location::UB, float>(floatAOffset), inputLayout);
        auto floatBUb = MakeTensor(MakeMemPtr<Location::UB, float>(floatBOffset), inputLayout);
        auto floatSlopeUb = MakeTensor(MakeMemPtr<Location::UB, float>(floatSlopeOffset), inputLayout);
        auto intAUb = MakeTensor(MakeMemPtr<Location::UB, int32_t>(intAOffset), inputLayout);
        auto intBUb = MakeTensor(MakeMemPtr<Location::UB, int32_t>(intBOffset), inputLayout);
        auto intShiftUb = MakeTensor(MakeMemPtr<Location::UB, int32_t>(intShiftOffset), inputLayout);
        auto floatOutputUb =
            MakeTensor(MakeMemPtr<Location::UB, float>(floatOutputOffset), floatOutputLayout);
        auto intOutputUb = MakeTensor(MakeMemPtr<Location::UB, int32_t>(intOutputOffset), intOutputLayout);

        auto copyIn = MakeCopy(CopyGM2UB {});
        Copy(copyIn, floatAUb, floatAGm);
        Copy(copyIn, floatBUb, floatBGm);
        Copy(copyIn, floatSlopeUb, floatSlopeGm);
        Copy(copyIn, intAUb, intAGm);
        Copy(copyIn, intBUb, intBGm);
        Copy(copyIn, intShiftUb, intShiftGm);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        ComputeFloat(floatAUb.Data().Get(), floatBUb.Data().Get(), floatSlopeUb.Data().Get(),
            floatOutputUb.Data().Get());
        ComputeInt(intAUb.Data().Get(), intBUb.Data().Get(), intShiftUb.Data().Get(), intOutputUb.Data().Get());

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        auto copyOut = MakeCopy(CopyUB2GM {});
        Copy(copyOut, floatOutputGm, floatOutputUb);
        Copy(copyOut, intOutputGm, intOutputUb);
    }
};

__global__ __vector__ void reg_compute_tensor_api(__gm__ float* floatA, __gm__ float* floatB,
    __gm__ float* floatSlope, __gm__ int32_t* intA, __gm__ int32_t* intB, __gm__ int32_t* intShift,
    __gm__ float* floatOutput, __gm__ int32_t* intOutput)
{
    KernelRegCompute op;
    op.Process(floatA, floatB, floatSlope, intA, intB, intShift, floatOutput, intOutput);
}

static bool CheckAcl(aclError result, const char* api)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << api << " failed, error code: " << result << std::endl;
    return false;
}

class AclRuntime {
public:
    AclRuntime() = default;
    AclRuntime(const AclRuntime&) = delete;
    AclRuntime& operator=(const AclRuntime&) = delete;

    bool Init()
    {
        if (!CheckAcl(aclInit(nullptr), "aclInit")) {
            return false;
        }
        initialized_ = true;
        if (!CheckAcl(aclrtSetDevice(deviceId_), "aclrtSetDevice")) {
            return false;
        }
        deviceSet_ = true;
        return CheckAcl(aclrtCreateStream(&stream_), "aclrtCreateStream");
    }

    ~AclRuntime()
    {
        if (stream_ != nullptr) {
            (void)aclrtDestroyStream(stream_);
        }
        if (deviceSet_) {
            (void)aclrtResetDevice(deviceId_);
        }
        if (initialized_) {
            (void)aclFinalize();
        }
    }

    aclrtStream Stream() const
    {
        return stream_;
    }

private:
    int32_t deviceId_ = 0;
    bool initialized_ = false;
    bool deviceSet_ = false;
    aclrtStream stream_ = nullptr;
};

template <typename T>
class AclBuffer {
public:
    AclBuffer() = default;
    AclBuffer(const AclBuffer&) = delete;
    AclBuffer& operator=(const AclBuffer&) = delete;

    bool Allocate(size_t count)
    {
        bytes_ = count * sizeof(T);
        if (!CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&host_), bytes_), "aclrtMallocHost")) {
            return false;
        }
        return CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&device_), bytes_, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc");
    }

    ~AclBuffer()
    {
        if (device_ != nullptr) {
            (void)aclrtFree(device_);
        }
        if (host_ != nullptr) {
            (void)aclrtFreeHost(host_);
        }
    }

    bool Load(const std::string& path)
    {
        size_t fileSize = 0;
        if (!ReadFile(path, fileSize, host_, bytes_) || fileSize != bytes_) {
            std::cerr << "Unexpected input size: " << path << std::endl;
            return false;
        }
        return true;
    }

    bool CopyToDevice() const
    {
        return CheckAcl(aclrtMemcpy(device_, bytes_, host_, bytes_, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy H2D");
    }

    bool CopyToHost() const
    {
        return CheckAcl(aclrtMemcpy(host_, bytes_, device_, bytes_, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy D2H");
    }

    bool Save(const std::string& path) const
    {
        return WriteFile(path, host_, bytes_);
    }

    T* Device() const
    {
        return device_;
    }

private:
    T* host_ = nullptr;
    T* device_ = nullptr;
    size_t bytes_ = 0;
};

int32_t main()
{
    AclRuntime runtime;
    if (!runtime.Init()) {
        return 1;
    }

    AclBuffer<float> floatA;
    AclBuffer<float> floatB;
    AclBuffer<float> floatSlope;
    AclBuffer<int32_t> intA;
    AclBuffer<int32_t> intB;
    AclBuffer<int32_t> intShift;
    AclBuffer<float> floatOutput;
    AclBuffer<int32_t> intOutput;

    bool allocated = floatA.Allocate(VECTOR_LENGTH) && floatB.Allocate(VECTOR_LENGTH) &&
        floatSlope.Allocate(VECTOR_LENGTH) && intA.Allocate(VECTOR_LENGTH) && intB.Allocate(VECTOR_LENGTH) &&
        intShift.Allocate(VECTOR_LENGTH) && floatOutput.Allocate(FLOAT_RESULT_ROWS * VECTOR_LENGTH) &&
        intOutput.Allocate(INT_RESULT_ROWS * VECTOR_LENGTH);
    if (!allocated) {
        return 1;
    }

    bool loaded = floatA.Load("./input/float_a.bin") && floatB.Load("./input/float_b.bin") &&
        floatSlope.Load("./input/float_slope.bin") && intA.Load("./input/int_a.bin") &&
        intB.Load("./input/int_b.bin") && intShift.Load("./input/int_shift.bin");
    if (!loaded) {
        return 1;
    }

    bool copied = floatA.CopyToDevice() && floatB.CopyToDevice() && floatSlope.CopyToDevice() &&
        intA.CopyToDevice() && intB.CopyToDevice() && intShift.CopyToDevice();
    if (!copied) {
        return 1;
    }

    reg_compute_tensor_api<<<1, 0, runtime.Stream()>>>(floatA.Device(), floatB.Device(), floatSlope.Device(),
        intA.Device(), intB.Device(), intShift.Device(), floatOutput.Device(), intOutput.Device());
    if (!CheckAcl(aclrtSynchronizeStream(runtime.Stream()), "aclrtSynchronizeStream")) {
        return 1;
    }
    if (!floatOutput.CopyToHost() || !intOutput.CopyToHost()) {
        return 1;
    }
    if (!floatOutput.Save("./output/float_output.bin") || !intOutput.Save("./output/int_output.bin")) {
        return 1;
    }
    std::cout << "reg_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
