#include <cstdint>
#include <iostream>

#include "c_api/sync/sync.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/basic_arithmetic.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t RESULT_ROWS = 16;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(float);

enum result_row : uint32_t {
    ROW_ABS,
    ROW_EXP,
    ROW_SQRT,
    ROW_LOG,
    ROW_LOG2,
    ROW_LOG10,
    ROW_NEG,
    ROW_RELU,
    ROW_PRELU,
    ROW_LEAKY_RELU,
    ROW_ADD,
    ROW_SUB,
    ROW_MUL,
    ROW_DIV,
    ROW_MAX,
    ROW_MIN,
};

__simd_vf__ inline void compute(
    __ubuf__ float* src_a, __ubuf__ float* src_b, __ubuf__ float* slope, __ubuf__ float* output)
{
    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = asc::te::make_tensor(asc::te::make_mem_ptr(src_a), input_layout);
    auto input_b = asc::te::make_tensor(asc::te::make_mem_ptr(src_b), input_layout);
    auto slope_tensor = asc::te::make_tensor(asc::te::make_mem_ptr(slope), input_layout);
    auto result = asc::te::make_tensor(asc::te::make_mem_ptr(output), output_layout);

    auto mask = asc::te::all_mask<float>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto slope_reg = slope_tensor.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto positive = asc::te::abs(a) + 0.5f;

    result.store(asc::te::make_coord(ROW_ABS, 0), asc::te::abs(a));
    result.store(asc::te::make_coord(ROW_EXP, 0), asc::te::exp(a));
    result.store(asc::te::make_coord(ROW_SQRT, 0), asc::te::sqrt(positive));
    result.store(asc::te::make_coord(ROW_LOG, 0), asc::te::log(positive));
    result.store(asc::te::make_coord(ROW_LOG2, 0), asc::te::log2(positive));
    result.store(asc::te::make_coord(ROW_LOG10, 0), asc::te::log10(positive));
    result.store(asc::te::make_coord(ROW_NEG, 0), -a);
    result.store(asc::te::make_coord(ROW_RELU, 0), asc::te::relu(a));
    result.store(asc::te::make_coord(ROW_PRELU, 0), asc::te::prelu(a, slope_reg));
    result.store(asc::te::make_coord(ROW_LEAKY_RELU, 0), asc::te::leaky_relu(a, 0.1f));
    result.store(asc::te::make_coord(ROW_ADD, 0), a + b);
    result.store(asc::te::make_coord(ROW_SUB, 0), a - b);
    result.store(asc::te::make_coord(ROW_MUL, 0), a * b);
    result.store(asc::te::make_coord(ROW_DIV, 0), a / b);
    result.store(asc::te::make_coord(ROW_MAX, 0), asc::te::max(a, b));
    result.store(asc::te::make_coord(ROW_MIN, 0), asc::te::min(a, b));
}

__global__ __vector__ void basic_arithmetic_tensor_api(
    __gm__ float* src_a, __gm__ float* src_b, __gm__ float* slope, __gm__ float* output)
{
    constexpr uint32_t input_a_offset = 0;
    constexpr uint32_t input_b_offset = input_a_offset + VECTOR_BYTES;
    constexpr uint32_t slope_offset = input_b_offset + VECTOR_BYTES;
    constexpr uint32_t output_offset = slope_offset + VECTOR_BYTES;

    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, VECTOR_LENGTH);
    auto src_a_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_a), input_layout);
    auto src_b_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_b), input_layout);
    auto slope_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(slope), input_layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), output_layout);
    auto src_a_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(input_a_offset), input_layout);
    auto src_b_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(input_b_offset), input_layout);
    auto slope_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(slope_offset), input_layout);
    auto output_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(output_offset), output_layout);

    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, src_a_ub, src_a_gm);
    asc::te::copy(copy_in, src_b_ub, src_b_gm);
    asc::te::copy(copy_in, slope_ub, slope_gm);
    asc_sync_notify(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);

    compute(src_a_ub.data().get(), src_b_ub.data().get(), slope_ub.data().get(), output_ub.data().get());

    asc_sync_notify(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_ub);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<float> src_a;
    example::buffer<float> src_b;
    example::buffer<float> slope;
    example::buffer<float> output;
    if (!runtime.init() || !src_a.load_to_device("./input/src_a.bin", VECTOR_LENGTH) ||
        !src_b.load_to_device("./input/src_b.bin", VECTOR_LENGTH) ||
        !slope.load_to_device("./input/slope.bin", VECTOR_LENGTH) ||
        !output.allocate(RESULT_ROWS * VECTOR_LENGTH)) {
        return 1;
    }

    basic_arithmetic_tensor_api<<<1, 0, runtime.stream()>>>(
        src_a.device(), src_b.device(), slope.device(), output.device());
    if (!runtime.synchronize() || !output.save_from_device("./output/output.bin")) {
        return 1;
    }
    std::cout << "basic_arithmetic_tensor_api executed successfully." << std::endl;
    return 0;
}
