#include <cstdint>
#include <iostream>

#include "basic_api/kernel_operator_block_sync_intf.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/basic_arithmetic.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t RESULT_ROWS = 16;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(float);

enum ResultRow : uint32_t {
    ROW_ABS,
    ROW_EXP,
    ROW_SQRT,
    ROW_LOG,
    ROW_LOG2,
    ROW_LOG10,
    ROW_NEG,
    ROW_RELU,
    ROW_PRELU,
    ROW_LEAKY_RELU,
    ROW_ADD,
    ROW_SUB,
    ROW_MUL,
    ROW_DIV,
    ROW_MAX,
    ROW_MIN,
};

__simd_vf__ inline void Compute(
    __ubuf__ float* src_a, __ubuf__ float* src_b, __ubuf__ float* slope, __ubuf__ float* output)
{
    using namespace AscendC::Te;
    auto input_layout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
    auto output_layout = MakeFrameLayout<NDExtLayoutPtn>(RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = MakeTensor(MakeMemPtr(src_a), input_layout);
    auto input_b = MakeTensor(MakeMemPtr(src_b), input_layout);
    auto slope_tensor = MakeTensor(MakeMemPtr(slope), input_layout);
    auto result = MakeTensor(MakeMemPtr(output), output_layout);

    auto mask = asc::te::ones<float>();
    auto a = input_a.load(MakeCoord(0, 0)).with_mask(mask);
    auto b = input_b.load(MakeCoord(0, 0)).with_mask(mask);
    auto slope_reg = slope_tensor.load(MakeCoord(0, 0)).with_mask(mask);
    auto positive = asc::te::abs(a) + 0.5f;

    result.store(MakeCoord(ROW_ABS, 0), asc::te::abs(a));
    result.store(MakeCoord(ROW_EXP, 0), asc::te::exp(a));
    result.store(MakeCoord(ROW_SQRT, 0), asc::te::sqrt(positive));
    result.store(MakeCoord(ROW_LOG, 0), asc::te::log(positive));
    result.store(MakeCoord(ROW_LOG2, 0), asc::te::log2(positive));
    result.store(MakeCoord(ROW_LOG10, 0), asc::te::log10(positive));
    result.store(MakeCoord(ROW_NEG, 0), -a);
    result.store(MakeCoord(ROW_RELU, 0), asc::te::relu(a));
    result.store(MakeCoord(ROW_PRELU, 0), asc::te::prelu(a, slope_reg));
    result.store(MakeCoord(ROW_LEAKY_RELU, 0), asc::te::leaky_relu(a, 0.1f));
    result.store(MakeCoord(ROW_ADD, 0), a + b);
    result.store(MakeCoord(ROW_SUB, 0), a - b);
    result.store(MakeCoord(ROW_MUL, 0), a * b);
    result.store(MakeCoord(ROW_DIV, 0), a / b);
    result.store(MakeCoord(ROW_MAX, 0), asc::te::max(a, b));
    result.store(MakeCoord(ROW_MIN, 0), asc::te::min(a, b));
}

__global__ __vector__ void basic_arithmetic_tensor_api(
    __gm__ float* src_a, __gm__ float* src_b, __gm__ float* slope, __gm__ float* output)
{
    using namespace AscendC::Te;
    constexpr uint32_t input_a_offset = 0;
    constexpr uint32_t input_b_offset = input_a_offset + VECTOR_BYTES;
    constexpr uint32_t slope_offset = input_b_offset + VECTOR_BYTES;
    constexpr uint32_t output_offset = slope_offset + VECTOR_BYTES;

    auto input_layout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
    auto output_layout = MakeFrameLayout<NDExtLayoutPtn>(RESULT_ROWS, VECTOR_LENGTH);
    auto src_a_gm = MakeTensor(MakeMemPtr<Location::GM>(src_a), input_layout);
    auto src_b_gm = MakeTensor(MakeMemPtr<Location::GM>(src_b), input_layout);
    auto slope_gm = MakeTensor(MakeMemPtr<Location::GM>(slope), input_layout);
    auto output_gm = MakeTensor(MakeMemPtr<Location::GM>(output), output_layout);
    auto src_a_ub = MakeTensor(MakeMemPtr<Location::UB, float>(input_a_offset), input_layout);
    auto src_b_ub = MakeTensor(MakeMemPtr<Location::UB, float>(input_b_offset), input_layout);
    auto slope_ub = MakeTensor(MakeMemPtr<Location::UB, float>(slope_offset), input_layout);
    auto output_ub = MakeTensor(MakeMemPtr<Location::UB, float>(output_offset), output_layout);

    auto copy_in = MakeCopy(CopyGM2UB {});
    Copy(copy_in, src_a_ub, src_a_gm);
    Copy(copy_in, src_b_ub, src_b_gm);
    Copy(copy_in, slope_ub, slope_gm);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    Compute(src_a_ub.Data().Get(), src_b_ub.Data().Get(), slope_ub.Data().Get(), output_ub.Data().Get());

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    Copy(MakeCopy(CopyUB2GM {}), output_gm, output_ub);
}

int32_t main()
{
    example::Runtime runtime;
    example::Buffer<float> src_a;
    example::Buffer<float> src_b;
    example::Buffer<float> slope;
    example::Buffer<float> output;
    if (!runtime.Init() || !src_a.LoadToDevice("./input/src_a.bin", VECTOR_LENGTH) ||
        !src_b.LoadToDevice("./input/src_b.bin", VECTOR_LENGTH) ||
        !slope.LoadToDevice("./input/slope.bin", VECTOR_LENGTH) ||
        !output.Allocate(RESULT_ROWS * VECTOR_LENGTH)) {
        return 1;
    }

    basic_arithmetic_tensor_api<<<1, 0, runtime.Stream()>>>(
        src_a.Device(), src_b.Device(), slope.Device(), output.Device());
    if (!runtime.Synchronize() || !output.SaveFromDevice("./output/output.bin")) {
        return 1;
    }
    std::cout << "basic_arithmetic_tensor_api executed successfully." << std::endl;
    return 0;
}
