#include <cstdint>
#include <iostream>

#include "basic_api/kernel_operator_block_sync_intf.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/logical_compute.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t RESULT_ROWS = 8;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(int32_t);

enum ResultRow : uint32_t {
    ROW_LOGICAL_NOT,
    ROW_BIT_AND,
    ROW_BIT_OR,
    ROW_BIT_XOR,
    ROW_SHIFT_LEFT_REG,
    ROW_SHIFT_LEFT_SCALAR,
    ROW_SHIFT_RIGHT_REG,
    ROW_SHIFT_RIGHT_SCALAR,
};

__simd_vf__ inline void Compute(__ubuf__ int32_t* src_a, __ubuf__ int32_t* src_b,
    __ubuf__ int32_t* shifts, __ubuf__ int32_t* output)
{
    using namespace AscendC::Te;
    auto input_layout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
    auto output_layout = MakeFrameLayout<NDExtLayoutPtn>(RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = MakeTensor(MakeMemPtr(src_a), input_layout);
    auto input_b = MakeTensor(MakeMemPtr(src_b), input_layout);
    auto shift_tensor = MakeTensor(MakeMemPtr(shifts), input_layout);
    auto result = MakeTensor(MakeMemPtr(output), output_layout);

    auto mask = asc::te::ones<int32_t>();
    auto a = input_a.load(MakeCoord(0, 0)).with_mask(mask);
    auto b = input_b.load(MakeCoord(0, 0)).with_mask(mask);
    auto shift = shift_tensor.load(MakeCoord(0, 0)).with_mask(mask);

    result.store(MakeCoord(ROW_LOGICAL_NOT, 0), !a);
    result.store(MakeCoord(ROW_BIT_AND, 0), a & b);
    result.store(MakeCoord(ROW_BIT_OR, 0), a | 16);
    result.store(MakeCoord(ROW_BIT_XOR, 0), 7 ^ a);
    result.store(MakeCoord(ROW_SHIFT_LEFT_REG, 0), a << shift);
    result.store(MakeCoord(ROW_SHIFT_LEFT_SCALAR, 0), a << static_cast<int16_t>(2));
    result.store(MakeCoord(ROW_SHIFT_RIGHT_REG, 0), a >> shift);
    result.store(MakeCoord(ROW_SHIFT_RIGHT_SCALAR, 0), a >> static_cast<int16_t>(2));
}

__global__ __vector__ void logical_compute_tensor_api(__gm__ int32_t* src_a, __gm__ int32_t* src_b,
    __gm__ int32_t* shifts, __gm__ int32_t* output)
{
    using namespace AscendC::Te;
    constexpr uint32_t input_a_offset = 0;
    constexpr uint32_t input_b_offset = input_a_offset + VECTOR_BYTES;
    constexpr uint32_t shift_offset = input_b_offset + VECTOR_BYTES;
    constexpr uint32_t output_offset = shift_offset + VECTOR_BYTES;

    auto input_layout = MakeFrameLayout<NDExtLayoutPtn>(_1 {}, _64 {});
    auto output_layout = MakeFrameLayout<NDExtLayoutPtn>(RESULT_ROWS, VECTOR_LENGTH);
    auto src_a_gm = MakeTensor(MakeMemPtr<Location::GM>(src_a), input_layout);
    auto src_b_gm = MakeTensor(MakeMemPtr<Location::GM>(src_b), input_layout);
    auto shifts_gm = MakeTensor(MakeMemPtr<Location::GM>(shifts), input_layout);
    auto output_gm = MakeTensor(MakeMemPtr<Location::GM>(output), output_layout);
    auto src_a_ub = MakeTensor(MakeMemPtr<Location::UB, int32_t>(input_a_offset), input_layout);
    auto src_b_ub = MakeTensor(MakeMemPtr<Location::UB, int32_t>(input_b_offset), input_layout);
    auto shifts_ub = MakeTensor(MakeMemPtr<Location::UB, int32_t>(shift_offset), input_layout);
    auto output_ub = MakeTensor(MakeMemPtr<Location::UB, int32_t>(output_offset), output_layout);

    auto copy_in = MakeCopy(CopyGM2UB {});
    Copy(copy_in, src_a_ub, src_a_gm);
    Copy(copy_in, src_b_ub, src_b_gm);
    Copy(copy_in, shifts_ub, shifts_gm);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    Compute(src_a_ub.Data().Get(), src_b_ub.Data().Get(), shifts_ub.Data().Get(), output_ub.Data().Get());

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    Copy(MakeCopy(CopyUB2GM {}), output_gm, output_ub);
}

int32_t main()
{
    example::Runtime runtime;
    example::Buffer<int32_t> src_a;
    example::Buffer<int32_t> src_b;
    example::Buffer<int32_t> shifts;
    example::Buffer<int32_t> output;
    if (!runtime.Init() || !src_a.LoadToDevice("./input/src_a.bin", VECTOR_LENGTH) ||
        !src_b.LoadToDevice("./input/src_b.bin", VECTOR_LENGTH) ||
        !shifts.LoadToDevice("./input/shifts.bin", VECTOR_LENGTH) ||
        !output.Allocate(RESULT_ROWS * VECTOR_LENGTH)) {
        return 1;
    }

    logical_compute_tensor_api<<<1, 0, runtime.Stream()>>>(
        src_a.Device(), src_b.Device(), shifts.Device(), output.Device());
    if (!runtime.Synchronize() || !output.SaveFromDevice("./output/output.bin")) {
        return 1;
    }
    std::cout << "logical_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
