#include <array>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"

namespace DynamicRegArray {

constexpr uint16_t LOOP_COUNT = 4;
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t OUTPUT_SIZE = ELEMENT_COUNT * sizeof(float);
constexpr float MIN_VALUE = -3.402823466e+38F;

struct reg_value {
    vector_float reg;
    vector_bool mask;
};

__simd_callee__ inline reg_value full(float value, vector_bool mask)
{
    reg_value result;
    asc_duplicate_scalar(result.reg, value, mask);
    result.mask = mask;
    return result;
}

__simd_callee__ inline reg_value operator+(reg_value src, float value)
{
    reg_value result;
    asc_add_scalar(result.reg, src.reg, value, src.mask);
    result.mask = src.mask;
    return result;
}

__simd_callee__ inline reg_value max(reg_value src0, reg_value src1)
{
    reg_value result;
    asc_max(result.reg, src0.reg, src1.reg, src0.mask);
    result.mask = src0.mask;
    return result;
}

} // namespace DynamicRegArray

__global__ __vector__ void dynamic_reg_array_custom(__gm__ float* output, float initial_value)
{
    using namespace DynamicRegArray;

    vector_bool mask = asc_create_mask_b32(PAT_ALL);
    reg_value src0 = full(initial_value, mask);
    reg_value max0 = full(MIN_VALUE, mask);
    reg_value max1 = full(MIN_VALUE, mask);
    reg_value max2 = full(MIN_VALUE, mask);
    reg_value max3 = full(MIN_VALUE, mask);

    for (uint16_t iter_m = 0; iter_m < LOOP_COUNT; ++iter_m) {
        src0 = src0 + 1.0F;
        max0 = max(max0, src0);
        src0 = src0 + 1.0F;
        max1 = max(max1, src0);
        src0 = src0 + 1.0F;
        max2 = max(max2, src0);
        src0 = src0 + 1.0F;
        max3 = max(max3, src0);
    }

    reg_value result = max(max0, max1);
    __ubuf__ float* output_ub = reinterpret_cast<__ubuf__ float*>(0);
    asc_storealign(output_ub, result.reg, result.mask);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    asc_copy_ub2gm_align_sync(output, output_ub, OUTPUT_SIZE);
}

int32_t main()
{
    using namespace DynamicRegArray;

    constexpr uint32_t WARMUP_COUNT = 20;
    constexpr uint32_t BENCHMARK_COUNT = 1000;
    constexpr float INITIAL_VALUE = 3.25F;
    constexpr float EXPECTED_VALUE = INITIAL_VALUE + 14.0F;
    constexpr float EPSILON = 1e-6F;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    float* output_device = nullptr;
    std::array<float, ELEMENT_COUNT> output_host {};

    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(device_id) != ACL_SUCCESS ||
        aclrtCreateStream(&stream) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&output_device), OUTPUT_SIZE, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        std::printf("ACL initialization failed.\n");
        return 1;
    }

    for (uint32_t i = 0; i < WARMUP_COUNT; ++i) {
        dynamic_reg_array_custom<<<1, 0, stream>>>(output_device, INITIAL_VALUE);
    }
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        std::printf("Warmup failed.\n");
        return 1;
    }

    auto start = std::chrono::steady_clock::now();
    for (uint32_t i = 0; i < BENCHMARK_COUNT; ++i) {
        dynamic_reg_array_custom<<<1, 0, stream>>>(output_device, INITIAL_VALUE);
    }
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        std::printf("Benchmark failed.\n");
        return 1;
    }
    auto end = std::chrono::steady_clock::now();

    if (aclrtMemcpy(output_host.data(), OUTPUT_SIZE, output_device, OUTPUT_SIZE,
        ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        std::printf("Copying the result to host failed.\n");
        return 1;
    }

    uint32_t error_count = 0;
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        if (std::fabs(output_host[i] - EXPECTED_VALUE) > EPSILON) {
            ++error_count;
        }
    }

    const double total_us = std::chrono::duration<double, std::micro>(end - start).count();
    std::printf("four-way explicit: total %.3f us, average %.3f us/kernel\n",
        total_us, total_us / BENCHMARK_COUNT);
    std::printf("result: %s, expected %.1f, first output %.1f\n",
        error_count == 0 ? "PASS" : "FAIL", EXPECTED_VALUE, output_host[0]);

    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return error_count == 0 ? 0 : 1;
}
