#include <array>
#include <chrono>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint16_t LOOP_COUNT = 4;
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t OUTPUT_SIZE = ELEMENT_COUNT * sizeof(float);
constexpr float MIN_VALUE = -3.402823466e+38F;

namespace asc{
namespace te{

__simd_callee__ inline auto full(float value, vector_bool mask)
{
    reg_tensor<float> result;
    asc_duplicate_scalar(result.reg, value, mask);
    result.mask = mask;
    return result;
}

template<typename T>
__simd_callee__ inline auto operator+(T src, float value)
{
    reg_tensor<float> result;
    asc_add_scalar(result.reg, src.reg, value, src.mask);
    result.mask = src.mask;
    return result;
}

template<typename T, typename U>
__simd_callee__ inline auto max(T src0, U src1)
{
    reg_tensor<float> result;
    asc_max(result.reg, src0.reg, src1.reg, src0.mask);
    result.mask = src0.mask;
    return result;
}
}
}

__simd_vf__ inline void DynamicRegArrayCompute(__ubuf__ float* output_ub, float initial_value)
{
    using namespace asc::te;

    vector_bool mask = asc_create_mask_b32(PAT_ALL);
    auto src0 = full(initial_value, mask);
    auto max0 = full(MIN_VALUE, mask);
    auto max1 = full(MIN_VALUE, mask);
    auto max2 = full(MIN_VALUE, mask);
    auto max3 = full(MIN_VALUE, mask);

    for (uint16_t iter_m = 0; iter_m < LOOP_COUNT; ++iter_m) {
        src0 = src0 + 1.0F;
        max0 = max(max0, src0);
        src0 = src0 + 1.0F;
        max1 = max(max1, src0);
        src0 = src0 + 1.0F;
        max2 = max(max2, src0);
        src0 = src0 + 1.0F;
        max3 = max(max3, src0);
    }

    auto result = max(max0, max1);
    asc_storealign(output_ub, result.reg, result.mask);
}

__global__ __vector__ void dynamic_reg_array_custom(__gm__ float* output, float initial_value)
{
    __ubuf__ float* output_ub = reinterpret_cast<__ubuf__ float*>(0);
    DynamicRegArrayCompute(output_ub, initial_value);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    asc_copy_ub2gm_align_sync(output, output_ub, OUTPUT_SIZE);
}

int32_t main()
{
    constexpr uint32_t WARMUP_COUNT = 20;
    constexpr uint32_t BENCHMARK_COUNT = 1000;

    int32_t result = 1;
    int32_t device_id = 0;
    bool acl_initialized = false;
    bool device_set = false;
    aclrtStream stream = nullptr;
    float* output_device = nullptr;
    std::array<float, ELEMENT_COUNT> output_host {};
    float initial_value = 0.0F;
    size_t input_size = sizeof(initial_value);
    std::chrono::steady_clock::time_point start;
    std::chrono::steady_clock::time_point end;
    double total_us = 0.0;

    if (!ReadFile("./input/input.bin", input_size, &initial_value, sizeof(initial_value)) ||
        input_size != sizeof(initial_value)) {
        std::printf("Reading input/input.bin failed.\n");
        return result;
    }

    if (aclInit(nullptr) != ACL_SUCCESS) {
        std::printf("aclInit failed.\n");
        return result;
    }
    acl_initialized = true;

    if (aclrtSetDevice(device_id) != ACL_SUCCESS) {
        std::printf("aclrtSetDevice failed.\n");
        goto cleanup;
    }
    device_set = true;

    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        std::printf("aclrtCreateStream failed.\n");
        goto cleanup;
    }

    if (aclrtMalloc(reinterpret_cast<void**>(&output_device), OUTPUT_SIZE,
        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        std::printf("aclrtMalloc failed.\n");
        goto cleanup;
    }

    for (uint32_t i = 0; i < WARMUP_COUNT; ++i) {
        dynamic_reg_array_custom<<<1, 0, stream>>>(output_device, initial_value);
    }
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        std::printf("Warmup failed.\n");
        goto cleanup;
    }

    start = std::chrono::steady_clock::now();
    for (uint32_t i = 0; i < BENCHMARK_COUNT; ++i) {
        dynamic_reg_array_custom<<<1, 0, stream>>>(output_device, initial_value);
    }
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        std::printf("Benchmark failed.\n");
        goto cleanup;
    }
    end = std::chrono::steady_clock::now();

    if (aclrtMemcpy(output_host.data(), OUTPUT_SIZE, output_device, OUTPUT_SIZE,
        ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        std::printf("Copying the result to host failed.\n");
        goto cleanup;
    }

    if (!WriteFile("./output/output.bin", output_host.data(), OUTPUT_SIZE)) {
        std::printf("Writing output/output.bin failed.\n");
        goto cleanup;
    }

    total_us = std::chrono::duration<double, std::micro>(end - start).count();
    std::printf("four-way explicit: total %.3f us, average %.3f us/kernel\n",
        total_us, total_us / BENCHMARK_COUNT);
    std::printf("initial value %.2f, first output %.2f\n", initial_value, output_host[0]);
    result = 0;

cleanup:
    if (output_device != nullptr) {
        aclrtFree(output_device);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    if (device_set) {
        aclrtResetDevice(device_id);
    }
    if (acl_initialized) {
        aclFinalize();
    }
    return result;
}
