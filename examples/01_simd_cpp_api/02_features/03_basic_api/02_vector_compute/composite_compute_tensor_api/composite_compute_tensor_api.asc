#include <cstdint>
#include <iostream>

#include "c_api/sync/sync.h"
#include "reg_compute_example_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/reg/composite_compute.h"

constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t RESULT_ROWS = 5;
constexpr uint32_t VECTOR_BYTES = VECTOR_LENGTH * sizeof(float);

enum result_row : uint32_t {
    ROW_AXPY,
    ROW_ABSDIFF,
    ROW_EXP_SUB,
    ROW_FMA,
    ROW_MULS_CAST,
};

__simd_vf__ inline void compute(
    __ubuf__ float* src_a, __ubuf__ float* src_b, __ubuf__ float* output)
{
    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, VECTOR_LENGTH);
    auto input_a = asc::te::make_tensor(asc::te::make_mem_ptr(src_a), input_layout);
    auto input_b = asc::te::make_tensor(asc::te::make_mem_ptr(src_b), input_layout);
    auto result = asc::te::make_tensor(asc::te::make_mem_ptr(output), output_layout);

    auto mask = asc::te::all_mask<float>();
    auto a = input_a.load(asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = input_b.load(asc::te::make_coord(0, 0)).with_mask(mask);

    result.store(asc::te::make_coord(ROW_AXPY, 0), asc::te::axpy(b, a, 0.25f));
    result.store(asc::te::make_coord(ROW_ABSDIFF, 0), asc::te::absdiff(a, b));
    result.store(asc::te::make_coord(ROW_EXP_SUB, 0), asc::te::exp_sub(a, b));
    result.store(asc::te::make_coord(ROW_FMA, 0), asc::te::fma(a, b, b));

    auto half_result = asc::te::muls_cast(a, 1.5f);
    asc::te::reg_tensor<float> converted;
    asc_half2float(converted.reg, half_result.reg, half_result.mask);
    converted.mask = half_result.mask;
    result.store(asc::te::make_coord(ROW_MULS_CAST, 0), converted);
}

__global__ __vector__ void composite_compute_tensor_api(
    __gm__ float* src_a, __gm__ float* src_b, __gm__ float* output)
{
    constexpr uint32_t input_a_offset = 0;
    constexpr uint32_t input_b_offset = input_a_offset + VECTOR_BYTES;
    constexpr uint32_t output_offset = input_b_offset + VECTOR_BYTES;

    auto input_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(RESULT_ROWS, VECTOR_LENGTH);
    auto src_a_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_a), input_layout);
    auto src_b_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src_b), input_layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), output_layout);
    auto src_a_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(input_a_offset), input_layout);
    auto src_b_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(input_b_offset), input_layout);
    auto output_ub =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, float>(output_offset), output_layout);

    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, src_a_ub, src_a_gm);
    asc::te::copy(copy_in, src_b_ub, src_b_gm);
    asc_sync_notify(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_MTE2, pipe_t::PIPE_V, event_t::EVENT_ID0);

    compute(src_a_ub.data().get(), src_b_ub.data().get(), output_ub.data().get());

    asc_sync_notify(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_V, pipe_t::PIPE_MTE3, event_t::EVENT_ID0);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_ub);
}

int32_t main()
{
    example::runtime runtime;
    example::buffer<float> src_a;
    example::buffer<float> src_b;
    example::buffer<float> output;
    if (!runtime.init() || !src_a.load_to_device("./input/src_a.bin", VECTOR_LENGTH) ||
        !src_b.load_to_device("./input/src_b.bin", VECTOR_LENGTH) ||
        !output.allocate(RESULT_ROWS * VECTOR_LENGTH)) {
        return 1;
    }

    composite_compute_tensor_api<<<1, 0, runtime.stream()>>>(src_a.device(), src_b.device(), output.device());
    if (!runtime.synchronize() || !output.save_from_device("./output/output.bin")) {
        return 1;
    }
    std::cout << "composite_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
