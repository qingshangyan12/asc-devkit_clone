#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

template <typename SrcT, typename DstT>
__simd_vf__ inline void CastVF(__ubuf__ SrcT* xAddr, __ubuf__ DstT* yAddr,
    uint32_t repeatTimes, uint32_t srcRepeatSize, uint32_t dstRepeatSize)
{
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<SrcT, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::RegTensor<SrcT> xReg;
    AscendC::Reg::RegTensor<DstT> yReg;
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_RINT
    };
    for (uint16_t i = 0; i < repeatTimes; ++i) {
        AscendC::Reg::LoadAlign(xReg, xAddr + i * srcRepeatSize);
        AscendC::Reg::Cast<DstT, SrcT, castTrait>(yReg, xReg, mask);
        AscendC::Reg::StoreAlign(yAddr + i * dstRepeatSize, yReg, mask);
    }
}

template <typename SrcT, typename DstT>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t srcLength, uint32_t dstLength)
    {
        this->srcLength = srcLength;
        this->dstLength = dstLength;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ SrcT*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ DstT*>(y));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<SrcT> xLocal = ubAllocator.Alloc<SrcT, 256>();
        AscendC::LocalTensor<DstT> yLocal = ubAllocator.Alloc<DstT, 256>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, srcLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // Compute: RegBase CastVF y = cast(x[::2])
        __ubuf__ SrcT* xAddr = reinterpret_cast<__ubuf__ SrcT*>(xLocal.GetPhyAddr());
        __ubuf__ DstT* yAddr = reinterpret_cast<__ubuf__ DstT*>(yLocal.GetPhyAddr());
        // 一次repeat计算的数据个数
        constexpr uint32_t srcRepeatSize = AscendC::GetVecLen() / sizeof(SrcT);
        constexpr uint32_t dstRepeatSize = AscendC::GetVecLen() / sizeof(DstT);
        // 总迭代次数
        uint16_t repeatTimes = AscendC::CeilDivision(srcLength, srcRepeatSize);
        CastVF(xAddr, yAddr, repeatTimes, srcRepeatSize, dstRepeatSize);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM
        AscendC::DataCopy(yGm, yLocal, dstLength);
    }

private:
    uint32_t srcLength;
    uint32_t dstLength;
    AscendC::GlobalTensor<SrcT> xGm;
    AscendC::GlobalTensor<DstT> yGm;
};

__global__ __vector__ void cast(GM_ADDR x, GM_ADDR y)
{
    uint32_t srcLength = 256;
    uint32_t dstLength = 128;
    Kernel<half, int32_t> kernel;
    kernel.Init(x, y, srcLength, dstLength);
    kernel.Process();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(int32_t); i++) {
        int32_t a = (reinterpret_cast<const int32_t*>(outputData))[i];
        int32_t b = (reinterpret_cast<const int32_t*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            if (wrongNum < 100) {
                printf("CompareResult golden.bin failed, index is %zu, output is %d, golden is %d\n", i, a, b);
            }
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t srcLength = 256;
    uint32_t dstLength = 128;
    size_t inputByteSize = static_cast<size_t>(1) * srcLength * sizeof(half);
    size_t outputByteSize = static_cast<size_t>(1) * dstLength * sizeof(int32_t);
    uint8_t *xHost, *yHost;
    uint8_t *xDevice, *yDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    cast<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(yHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
