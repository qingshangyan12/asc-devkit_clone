/*!
 * \file reduce_sum_binary.asc
 * \brief 处理尾块后二分累加至一个repeat，最后reduce一次后搬出
 *        case: 20 * (512 + 16) -> 20 * 1
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// 二分规约: 数据二分累加到1个repeat
template <typename T>
__simd_vf__ inline void BinaryHalvingReduce(
    __ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint16_t dimA, uint16_t dimR, uint16_t mainR, uint16_t vlSize, uint16_t needInplaceAdd)
{
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    
    AscendC::Reg::RegTensor<T> vreg0;
    AscendC::Reg::RegTensor<T> vreg1;
    AscendC::Reg::RegTensor<T> vreg2;
    AscendC::Reg::RegTensor<T> vreg3;
    AscendC::Reg::RegTensor<T> vreg4;
    AscendC::Reg::RegTensor<T> vreg5;
    AscendC::Reg::RegTensor<T> vreg6;
    AscendC::Reg::RegTensor<T> vreg7;
    AscendC::Reg::RegTensor<T> vregTail;
    AscendC::Reg::UnalignReg ureg;

    uint32_t tailR = dimR - mainR;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(tailR);

    for (uint16_t loopA = 0; loopA < dimA; loopA++) {
        auto rowAddr = srcAddr + loopA * mainR;
        
        // L0: 加载8个vlSize数据
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg0, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg1, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg2, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg3, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg4, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg5, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg6, rowAddr, vlSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg7, rowAddr, vlSize);

        for (uint16_t i = 0; i < needInplaceAdd; i++) {
            // 2. 将tail块加到第一个元素
            AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_LOAD>();
            AscendC::Reg::LoadAlign(vregTail, srcAddr + loopA * dimR + mainR);
            AscendC::Reg::Add<T, AscendC::Reg::MaskMergeMode::MERGING>(vreg0, vreg0, vregTail, mask);
        }
        // L1: 8 -> 4
        AscendC::Reg::Add(vreg0, vreg0, vreg4, fullMask);
        AscendC::Reg::Add(vreg1, vreg1, vreg5, fullMask);
        AscendC::Reg::Add(vreg2, vreg2, vreg6, fullMask);
        AscendC::Reg::Add(vreg3, vreg3, vreg7, fullMask);
        
        // L2: 4 -> 2
        AscendC::Reg::Add(vreg0, vreg0, vreg2, fullMask);
        AscendC::Reg::Add(vreg1, vreg1, vreg3, fullMask);
        
        // L3: 2 -> 1
        AscendC::Reg::Add(vreg0, vreg0, vreg1, fullMask);

        // reduce: 将vlSize个元素reduce为1个
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM>(vreg1, vreg0, fullMask);
        
        // 存储结果
        AscendC::Reg::StoreUnAlign(dstAddr, vreg1, ureg, 1);
    }
    AscendC::Reg::StoreUnAlignPost(dstAddr, ureg, 0);
    AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_LOAD>();
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t dimA, uint32_t dimR)
    {
        this->dimA = dimA;
        this->dimR = dimR;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }
    
    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        // 输入 + 处理后数据(每行512) + 输出
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, 20 * 528>();
        AscendC::LocalTensor<T> tmpLocal = ubAllocator.Alloc<T, 20 * 512>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, 32>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, dimA * dimR);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        constexpr uint16_t vlSize = AscendC::GetVecLen() / sizeof(T);  // 64
        uint16_t mainR = 512;
        uint16_t tailR = 16;
        
        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* tmpAddr = reinterpret_cast<__ubuf__ T*>(tmpLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        
        // 1. 处理尾块: 将16个tail元素合并到main块
        // 2. 二分规约: 512/64=8个repeat，二分到1个repeat
        uint16_t needInplaceAdd = (tailR == 0) ? 0 : 1;
        AscendC::PipeBarrier<PIPE_ALL>();
        int64_t cycleBefore = AscendC::GetSystemCycle();
        BinaryHalvingReduce<T>(yAddr, tmpAddr, dimA, dimR, mainR, vlSize, needInplaceAdd);
        AscendC::PipeBarrier<PIPE_ALL>();
        int64_t cycleAfter = AscendC::GetSystemCycle();
        AscendC::printf("**********cycle =  %ld**********,\n", cycleAfter - cycleBefore);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM
        uint32_t outCount = 24; // dimA = 20，对齐到32B
        AscendC::DataCopy(yGm, yLocal, outCount);
    }

private:
    uint32_t dimA;
    uint32_t dimR;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void reduce_sum_binary(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    uint32_t dimA = 20;
    uint32_t dimR = 528;  // 512 + 16
    Kernel<float> kernel;
    kernel.Init(x, y, dimA, dimR);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outCount)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outCount * sizeof(float));
    size_t goldenSize = outCount * sizeof(float);
    bool ret = ReadFile("./output/reduce_sum_golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile reduce_sum_golden.bin success!\n");
    } else {
        printf("ReadFile reduce_sum_golden.bin failed!\n");
        return false;
    }
    
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;
    const float* out = reinterpret_cast<const float*>(outputData);
    const float* golden = reinterpret_cast<const float*>(goldenData);
    
    for (uint32_t i = 0; i < outCount; i++) {
        float diff = std::abs(out[i] - golden[i]);
        float relDiff = diff / std::abs(golden[i]);
        if (diff > EPS && relDiff > EPS) {
            printf("CompareResult [%d] failed: output=%f, golden=%f\n", i, out[i], golden[i]);
            wrongNum++;
        }
    }
    
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("CompareResult: %ld elements wrong!\n", wrongNum);
        return false;
    } else {
        printf("CompareResult reduce_sum_golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    
    uint32_t dimA = 20;
    uint32_t dimR = 528;  // 512 + 16
    uint32_t totalLength = dimA * dimR;
    uint32_t outputCount = dimA;
    
    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = outputCount * sizeof(float);
    
    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    
    // 读取输入数据
    ReadFile("./input/reduce_sum_input_x.bin", inputByteSize, xHost, inputByteSize);
    
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    
    reduce_sum_binary<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/reduce_sum_binary_output.bin", zHost, outputByteSize);
    
    bool goldenResult = CompareResult(zHost, outputCount);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
