/* !
 * \file reduce_binary.asc
 * \brief 演示使用Binary Halving实现向量归约求和计算功能
 *        基于二分累加方式，对输入向量所有元素求和并输出标量结果
 *        totalLength = 64 * 16 = 1024
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// 本地定义的ReduceOpInternal命名空间，不依赖adv_api
namespace ReduceOpInternal {
constexpr uint16_t BASE_FOLD = 4;

// 计算fold次数
__aicore__ inline uint16_t CalculateFolds(const uint16_t count)
{
    constexpr uint16_t MAX_OFFSET = 16;
    uint16_t folds = 0;
    uint16_t base = count;
    for (uint16_t i = 1; i < MAX_OFFSET; i++) {
        if ((base >> i) == 0) {
            break;
        }
        folds++;
    }
    return folds;
}
}  // namespace ReduceOpInternal

template <typename T>
__simd_vf__ inline void ReduceBinaryHalvingSum(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint32_t totalLength)
{
    constexpr uint16_t vlSize = AscendC::GetVecLen() / sizeof(T);
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg mask = fullMask;

    // dimA = 1, dimR = totalLength
    uint32_t dimR = totalLength;

    // 计算fold次数
    uint16_t base = dimR / vlSize;  // 1024 / 64 = 16
    uint16_t folds = ReduceOpInternal::CalculateFolds(base);  // log2(16) = 4
    uint16_t avgFolds = ReduceOpInternal::BASE_FOLD;  // 4
    uint16_t mainTimes = folds / avgFolds;  // main loop次数: 1
    uint16_t tailFolds = folds % avgFolds;   // 0

    // 使用临时buffer存储中间结果
    __ubuf__ T* tmpAddr = srcAddr;

    // MainFolds: 二分累加过程
    // 需要16个向量寄存器
    AscendC::Reg::RegTensor<T> vreg0;
    AscendC::Reg::RegTensor<T> vreg1;
    AscendC::Reg::RegTensor<T> vreg2;
    AscendC::Reg::RegTensor<T> vreg3;
    AscendC::Reg::RegTensor<T> vreg4;
    AscendC::Reg::RegTensor<T> vreg5;
    AscendC::Reg::RegTensor<T> vreg6;
    AscendC::Reg::RegTensor<T> vreg7;
    AscendC::Reg::RegTensor<T> vreg8;
    AscendC::Reg::RegTensor<T> vreg9;
    AscendC::Reg::RegTensor<T> vreg10;
    AscendC::Reg::RegTensor<T> vreg11;
    AscendC::Reg::RegTensor<T> vreg12;
    AscendC::Reg::RegTensor<T> vreg13;
    AscendC::Reg::RegTensor<T> vreg14;
    AscendC::Reg::RegTensor<T> vreg15;

    uint16_t loopRNum = base;  // 16

    for (uint16_t loopMain = 0; loopMain < mainTimes; loopMain++) {
        loopRNum = loopRNum >> avgFolds;  // 每次右移4位: 16->1
        uint16_t offsetR = loopRNum * vlSize;

        for (uint16_t loopR = 0; loopR < loopRNum; loopR++) {
            // L0: 加载16组数据
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg0, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg1, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg2, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg3, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg4, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg5, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg6, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg7, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg8, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg9, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg10, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg11, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg12, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg13, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg14, tmpAddr, vlSize);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(vreg15, tmpAddr, vlSize);

            // L1: 16 -> 8 (fold by 8)
            AscendC::Reg::Add(vreg0, vreg0, vreg8, fullMask);
            AscendC::Reg::Add(vreg1, vreg1, vreg9, fullMask);
            AscendC::Reg::Add(vreg2, vreg2, vreg10, fullMask);
            AscendC::Reg::Add(vreg3, vreg3, vreg11, fullMask);
            AscendC::Reg::Add(vreg4, vreg4, vreg12, fullMask);
            AscendC::Reg::Add(vreg5, vreg5, vreg13, fullMask);
            AscendC::Reg::Add(vreg6, vreg6, vreg14, fullMask);
            AscendC::Reg::Add(vreg7, vreg7, vreg15, fullMask);

            // L2: 8 -> 4 (fold by 4)
            AscendC::Reg::Add(vreg0, vreg0, vreg4, fullMask);
            AscendC::Reg::Add(vreg1, vreg1, vreg5, fullMask);
            AscendC::Reg::Add(vreg2, vreg2, vreg6, fullMask);
            AscendC::Reg::Add(vreg3, vreg3, vreg7, fullMask);

            // L3: 4 -> 2 (fold by 2)
            AscendC::Reg::Add(vreg0, vreg0, vreg2, fullMask);
            AscendC::Reg::Add(vreg1, vreg1, vreg3, fullMask);

            // L4: 2 -> 1 (fold by 1)
            AscendC::Reg::Add(vreg0, vreg0, vreg1, fullMask);

            // 存储结果到当前位置
            AscendC::Reg::StoreAlign(tmpAddr + loopR * vlSize, vreg0, fullMask);
        }
        AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_LOAD>();
    }

    // 处理tail folds (当folds % 4 != 0时)
    // tailFolds = 0，无需额外 fold 操作
    if (tailFolds == 1) {
        for (uint16_t loopR = 0; loopR < loopRNum; loopR++) {
            AscendC::Reg::LoadAlign(vreg0, tmpAddr + loopR * vlSize);
            AscendC::Reg::LoadAlign(vreg1, tmpAddr + (loopR + 1) * vlSize);
            AscendC::Reg::Add(vreg0, vreg0, vreg1, fullMask);
            AscendC::Reg::StoreAlign(tmpAddr + loopR * vlSize, vreg0, fullMask);
        }
        loopRNum = loopRNum >> 1;
    }

    // Reduce到1: 使用Reg Reduce操作将vlSize个元素累加为1个
    AscendC::Reg::RegTensor<T> dstReg;
    AscendC::Reg::LoadAlign(vreg0, tmpAddr);
    AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM>(dstReg, vreg0, mask);
    AscendC::Reg::StoreAlign(dstAddr, dstReg, mask);
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, 1024>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, 128>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, totalLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // Compute: Binary Halving ReduceSum
        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        ReduceBinaryHalvingSum(yAddr, xAddr, totalLength);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM (32B对齐，至少8个float)
        constexpr uint32_t outAlignSize = 8;
        AscendC::DataCopy(yGm, yLocal, outAlignSize);
    }

private:
    uint32_t totalLength;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void reduce_binary(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    uint32_t totalLength = 64 * 16;  // 1024
    Kernel<float> kernel;
    kernel.Init(x, y, totalLength);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/reduce_binary_golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile reduce_binary_golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    // Reduce结果在第一个元素
    float a = (reinterpret_cast<const float*>(outputData))[0];
    float b = (reinterpret_cast<const float*>(goldenData))[0];
    float ae = std::abs(a - b);
    float re = ae / std::abs(b);
    if (ae > EPS && re > EPS) {
        printf("CompareResult reduce_binary_golden.bin failed output is %lf, golden is %lf\n", a, b);
        wrongNum++;
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult reduce_binary_golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t totalLength = 64 * 16;  // 1024
    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = 8 * sizeof(float);  // 32B对齐
    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/reduce_binary_input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    reduce_binary<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/reduce_binary_output.bin", zHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(zHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
