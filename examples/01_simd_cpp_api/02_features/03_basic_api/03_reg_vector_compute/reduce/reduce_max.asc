/*!
 * \file reduce_max.asc
 * \brief 演示使用ReduceMaxImpl实现向量归约求最大值计算功能
 *        基于kernel_operator_vec_reduce_impl.h中ReduceMaxImpl的实现
 *        支持带索引的ReduceMaxWithIndex，最值和索引都写在ylocal上
 *        totalLength = 1024
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace ReduceMaxInternal {

// ReduceMax核心实现: 找出一组数据中的最大值
template <typename T>
__simd_vf__ inline void ReduceMaxNoIndex(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, uint32_t count, const int32_t srcRepStride, T initValue)
{
    constexpr uint16_t oneRepSize = AscendC::GetVecLen() / sizeof(T);
    uint16_t repeat = AscendC::CeilDivision(count, oneRepSize);
    uint32_t srcRepOffset = srcRepStride * AscendC::GetDataBlockSizeInBytes() / sizeof(T);
    
    AscendC::Reg::MaskReg preg;
    AscendC::Reg::MaskReg pregFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::RegTensor<T> srcVreg;
    AscendC::Reg::RegTensor<T> dstVreg;
    AscendC::Reg::RegTensor<T> tmpVreg;
    AscendC::Reg::UnalignReg ureg;
    
    // 初始化dstVreg为最小值
    AscendC::Reg::Duplicate(dstVreg, initValue);
    
    for (uint16_t i = 0; i < repeat; ++i) {
        preg = AscendC::Reg::UpdateMask<T>(count);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(srcVreg, srcLocal, srcRepOffset);
        // tmp = max(dst, src)
        AscendC::Reg::Max(tmpVreg, dstVreg, srcVreg, preg);
        // 只保留被mask的位置的新值
        AscendC::Reg::Select(dstVreg, tmpVreg, dstVreg, preg);
    }
    // 向量内归约: 从vlSize个元素归约为1个
    AscendC::Reg::ReduceMax(dstVreg, dstVreg, pregFull);
    AscendC::Reg::StoreUnAlign(dstLocal, dstVreg, ureg, 1);
    AscendC::Reg::StoreUnAlignPost(dstLocal, ureg, 0);
}

template <typename T>
__aicore__ inline void ReduceMaxImpl(__ubuf__ T* dstLocal, __ubuf__ T* srcLocal, __ubuf__ T* workLocal, uint32_t count)
{
    T initValue = AscendC::GetMinValue<T>();  // 使用float的最小值作为初值
    ReduceMaxNoIndex(dstLocal, srcLocal, count, 8, initValue);
}

/* **************************************** 带索引的ReduceMax实现 ****************************************** */

// ReduceMaxWithIndex核心实现: 返回最大值和对应的索引，最值和索引都写入dstLocal
template <typename T, typename IndexT>
__simd_vf__ inline void ReduceMaxIndexTemplate(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, uint32_t count, const int32_t srcRepStride, T initValue)
{
    constexpr uint16_t oneRepSize = AscendC::GetVecLen() / sizeof(T);
    uint16_t repeat = AscendC::CeilDivision(count, oneRepSize);
    uint32_t srcRepOffset = srcRepStride * AscendC::GetDataBlockSizeInBytes() / sizeof(T);
    
    AscendC::Reg::MaskReg preg;
    AscendC::Reg::MaskReg pregCond;
    AscendC::Reg::MaskReg pregIndexFull = AscendC::Reg::CreateMask<IndexT, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg pregFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::UnalignReg ureg;
    
    // Value registers
    AscendC::Reg::RegTensor<T> srcVreg;
    AscendC::Reg::RegTensor<T> dstValueVreg;
    AscendC::Reg::RegTensor<T> tmpValueVreg;
    
    // Index registers
    AscendC::Reg::RegTensor<IndexT> dstIndexVreg;
    AscendC::Reg::RegTensor<IndexT> subIndexVreg;
    AscendC::Reg::RegTensor<IndexT> tmpIndexVreg;
    AscendC::Reg::RegTensor<IndexT> maskIndexVreg;
    
    // 初始化
    AscendC::Reg::Duplicate(subIndexVreg, (IndexT)1);
    AscendC::Reg::Duplicate(maskIndexVreg, (IndexT)0);
    AscendC::Reg::Duplicate(dstValueVreg, initValue);
    
    // 初始化索引寄存器，从1开始递增
    if constexpr (sizeof(IndexT) == 2) {
        AscendC::Reg::Arange((AscendC::Reg::RegTensor<int16_t> &)tmpIndexVreg, 1);
    } else {
        AscendC::Reg::Arange((AscendC::Reg::RegTensor<int32_t> &)tmpIndexVreg, 1);
    }
    dstIndexVreg = tmpIndexVreg;
    
    // Step1: 从 [count] 归约到 [oneRepSize]，维护 value-index 对
    for (uint16_t i = 0; i < repeat; ++i) {
        preg = AscendC::Reg::UpdateMask<T>(count);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(srcVreg, srcLocal, srcRepOffset);
        
        // tmpValue = max(dstValue, srcValue)
        AscendC::Reg::Max(tmpValueVreg, dstValueVreg, srcVreg, preg);
        // 保留被mask位置的新值
        AscendC::Reg::Select(tmpValueVreg, tmpValueVreg, dstValueVreg, preg);
        
        // 如果前后值发生变化，更新索引
        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(pregCond, dstValueVreg, tmpValueVreg, pregFull);
        AscendC::Reg::Select(dstIndexVreg, tmpIndexVreg, dstIndexVreg, pregCond);
        
        // 更新下一轮索引 (当前索引 + oneRepSize)
        AscendC::Reg::Adds(tmpIndexVreg, tmpIndexVreg, (IndexT)oneRepSize, pregFull);
        
        // 更新值
        dstValueVreg = tmpValueVreg;
    }
    
    // Step2: 从 [oneRepSize] 归约为1个值
    AscendC::Reg::ReduceMax(tmpValueVreg, dstValueVreg, pregFull);
    // 存储最大值到ylocal[0]
    AscendC::Reg::StoreUnAlign(dstLocal, tmpValueVreg, ureg, 1);
    
    // 获取最大值的位置mask，挤压dst index
    AscendC::Reg::Duplicate(tmpValueVreg, tmpValueVreg, pregFull);
    AscendC::Reg::Compare<T, AscendC::CMPMODE::EQ>(pregCond, dstValueVreg, tmpValueVreg, pregFull);
    AscendC::Reg::GatherMask<IndexT, AscendC::Reg::GatherMaskMode::NO_STORE_REG>(tmpIndexVreg, dstIndexVreg, pregCond);
    
    // 计算有多少索引具有相同的最大值
    AscendC::Reg::Compare<IndexT, AscendC::CMPMODE::NE>(pregCond, tmpIndexVreg, maskIndexVreg, pregIndexFull);
    AscendC::Reg::ReduceMin(tmpIndexVreg, tmpIndexVreg, pregCond);
    AscendC::Reg::Sub(tmpIndexVreg, tmpIndexVreg, subIndexVreg, pregIndexFull);
    
    // 存储索引到ylocal[1] (最值和索引都写在ylocal上)
    AscendC::Reg::StoreUnAlign((__ubuf__ IndexT *&)dstLocal, tmpIndexVreg, ureg, 1);
    AscendC::Reg::StoreUnAlignPost(dstLocal, ureg, 0);
}

// 带索引的ReduceMax实现
template <typename T, typename IndexT>
__aicore__ inline void ReduceMaxWithIndexImpl(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, __ubuf__ T* workLocal, uint32_t count)
{
    T initValue = AscendC::GetMinValue<float>();
    ReduceMaxIndexTemplate<T, IndexT>(dstLocal, srcLocal, count, 8, initValue);
}

}  // namespace ReduceMaxInternal

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, 1024>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, 128>();
        AscendC::LocalTensor<T> workLocal = ubAllocator.Alloc<T, 128>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, totalLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // Compute: ReduceMaxWithIndexImpl (最值和索引都写入ylocal)
        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        __ubuf__ T* workAddr = reinterpret_cast<__ubuf__ T*>(workLocal.GetPhyAddr());

        ReduceMaxInternal::ReduceMaxWithIndexImpl<T, uint32_t>(yAddr, xAddr, workAddr, totalLength);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM (ylocal包含value和index)
        constexpr uint32_t outAlignSize = 8;  // 32B对齐，包含value和index
        AscendC::DataCopy(yGm, yLocal, outAlignSize);
    }

private:
    uint32_t totalLength;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void reduce_max(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    uint32_t totalLength = 1024
    Kernel<float> kernel;
    kernel.Init(x, y, totalLength);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, const void* indexData)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), 8 * sizeof(float));
    size_t goldenSize = 8 * sizeof(float);
    bool ret = ReadFile("./output/reduce_max_golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile reduce_max_golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    float a = (reinterpret_cast<const float*>(outputData))[0];
    float b = (reinterpret_cast<const float*>(goldenData))[0];
    float diff = std::abs(a - b);
    if (diff > EPS) {
        printf("CompareResult reduce_max_golden.bin failed output is %lf, golden is %lf\n", a, b);
        wrongNum++;
    }
    
    // 验证index
    uint32_t outIdx = (reinterpret_cast<const uint32_t*>(indexData))[0];
    printf("Max value: %f, Max index: %u\n", a, outIdx);
    
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult reduce_max_golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t totalLength = 1024
    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = 8 * sizeof(float); // 32B对齐，包含value和index
    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/reduce_max_input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    reduce_max<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/reduce_max_output.bin", zHost, outputByteSize);
    bool goldenResult = true;
    // zHost[0]是value, zHost[1]是index (以uint32_t解释)
    goldenResult = CompareResult(zHost, zHost + sizeof(float));
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
