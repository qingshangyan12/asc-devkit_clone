/*!
 * \file reduce_iterator.asc
 * \brief 方案3: 每行repeat内reduce，非对齐搬出后repeat间reduce，最后搬出
 *        case: 20 * (512 + 16) -> 20 * 1
 * 
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include <iostream>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace ReduceIteratorInternal {
constexpr uint32_t VEC_LEN = 256 / sizeof(float);  // 64 for float

// 每行repeat内reduce，使用非对齐搬出
template <typename T>
__simd_callee__ inline void RowReduceCounter(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, uint32_t count, int32_t repeat, uint32_t srcRepStride)
{
    AscendC::Reg::MaskReg preg;
    AscendC::Reg::RegTensor<T> srcVreg;
    AscendC::Reg::RegTensor<T> dstVreg;
    AscendC::Reg::UnalignReg ureg;
    
    for (uint16_t i = 0; i < static_cast<uint16_t>(repeat); ++i) {
        preg = AscendC::Reg::UpdateMask<T>(count);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(srcVreg, srcLocal, srcRepStride);
        AscendC::Reg::ReduceSum(dstVreg, srcVreg, preg);
        AscendC::Reg::StoreUnAlign(dstLocal, dstVreg, ureg, 1);
    }
    AscendC::Reg::StoreUnAlignPost(dstLocal, ureg, 0);
}

// ShapeScope=2: 先归约到workLocal，再归约到dst
template <typename T>
__simd_vf__ inline void RowReduceScope2(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, __ubuf__ T* workLocal, uint32_t dimR, uint32_t count2, uint16_t vlSize)
{
    RowReduceCounter(workLocal, srcLocal, dimR, count2, vlSize);
    AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_LOAD>();
    // repeat间reduce: 将count2个结果归约为1个
    RowReduceCounter(dstLocal, workLocal, count2, 1, vlSize);
}
}  // namespace ReduceIteratorInternal

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t dimA, uint32_t dimR)
    {
        this->dimA = dimA;
        this->dimR = dimR;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, 528*20>();
        AscendC::LocalTensor<T> workLocal = ubAllocator.Alloc<T, 1024>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, 256>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, dimA * dimR);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* workAddr = reinterpret_cast<__ubuf__ T*>(workLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        
        // Compute: Iterator ReduceSum
        uint16_t vlSize = AscendC::GetVecLen() / sizeof(T);  // 64
        uint32_t count2 = AscendC::CeilDivision(dimR, vlSize);  // 528/64=9
        for (uint16_t i = 0; i < static_cast<uint16_t>(dimA); ++i) {
            ReduceIteratorInternal::RowReduceScope2<T>(yAddr + i, xAddr + i * dimR, workAddr, dimR, count2, vlSize);
        }        

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM
        uint32_t outCount = 24; // dimA = 20，对齐到32B
        AscendC::DataCopy(yGm, yLocal, outCount);
    }

private:
    uint32_t dimA;
    uint32_t dimR;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void reduce_iterator(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    uint32_t dimA = 20;
    uint32_t dimR = 528;  // 512 + 16
    Kernel<float> kernel;
    int64_t cycleBefore = AscendC::GetSystemCycle();
    kernel.Init(x, y, dimA, dimR);
    kernel.Process();
    int64_t cycleAfter = AscendC::GetSystemCycle();
    AscendC::printf("**********cycle =  %ld**********,\n", cycleAfter - cycleBefore);
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }

    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;
    const float* out = reinterpret_cast<const float*>(outputData);
    const float* golden = reinterpret_cast<const float*>(goldenData);
    
    for (uint32_t i = 0; i < outCount; i++) {
        float diff = std::abs(out[i] - golden[i]);
        float relDiff = diff / std::abs(golden[i]);
        if (diff > EPS && relDiff > EPS) {
            printf("CompareResult [%d] failed: output=%f, golden=%f\n", i, out[i], golden[i]);
            wrongNum++;
        }
    }
    
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("CompareResult: %ld elements wrong!\n", wrongNum);
        return false;
    } else {
        printf("CompareResult reduce_iterator_golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    // uint32_t totalLength = 256;
    // size_t inputByteSize = totalLength * sizeof(float);
    // size_t outputByteSize = 8 * sizeof(float); // 32B对齐，至少8个float
    uint32_t dimA = 20;
    uint32_t dimR = 528;  // 512 + 16
    uint32_t totalLength = dimA * dimR;
    uint32_t outputCount = 24;  //对齐到32B
    
    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = outputCount * sizeof(float);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    
    // 读取输入数据
    ReadFile("./input/reduce_iterator_input_x.bin", inputByteSize, xHost, inputByteSize);
    
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    reduce_iterator<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);
    
    bool goldenResult = CompareResult(zHost, outputCount);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
