/*!
 * \file reduce_iterator.asc
 * \brief 演示使用ReduceSumImpl实现向量归约求和计算功能
 *        基于kernel_operator_vec_reduce_impl.h中ReduceSumImpl的实现
 *        totalLength = 64 * 16 = 1024
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace ReduceSumInternal {
constexpr uint32_t ONE_REPEAT_ELEM_NUM = 128 / sizeof(float);  // for float type

// 获取一个repeat中的元素个数
template <typename T>
__aicore__ inline uint32_t GetOneRepeatSize()
{
    return AscendC::GetVecLen() / sizeof(T);
}

// Counter Mode ReduceSum: 从count个元素归约为1个元素
template <typename T>
__simd_callee__ inline void ReduceSumCounter(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, uint32_t count, int32_t repeat, const int32_t srcRepStride)
{
    uint32_t srcRepOffset = srcRepStride * AscendC::GetDataBlockSizeInBytes() / sizeof(T);
    AscendC::Reg::MaskReg preg;
    AscendC::Reg::RegTensor<T> srcVreg;
    AscendC::Reg::RegTensor<T> dstVreg;
    AscendC::Reg::UnalignReg ureg;
    for (uint16_t i = 0; i < static_cast<uint16_t>(repeat); ++i) {
        preg = AscendC::Reg::UpdateMask<T>(count);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(srcVreg, srcLocal, srcRepOffset);
        AscendC::Reg::ReduceSum(dstVreg, srcVreg, preg);
        AscendC::Reg::StoreUnAlign(dstLocal, dstVreg, ureg, 1);
    }
    AscendC::Reg::StoreUnAlignPost(dstLocal, ureg, 0);
}

// ShapeScope=2: 先归约到workLocal，再归约到dst
template <typename T>
__simd_vf__ inline void ReduceSumCounterModeScope2(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, __ubuf__ T* workLocal, uint32_t count, const int32_t srcRepStride)
{
    constexpr uint32_t oneRepSize = AscendC::GetVecLen() / sizeof(T);
    uint32_t count2 = AscendC::CeilDivision(count, oneRepSize);
    ReduceSumCounter(workLocal, srcLocal, count, count2, srcRepStride);
    AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_LOAD>();
    ReduceSumCounter(dstLocal, workLocal, count2, 1, 8);
}

template <typename T>
__aicore__ inline void ReduceSumImpl(
    __ubuf__ T* dstLocal, __ubuf__ T* srcLocal, __ubuf__ T* workLocal, uint32_t count)
{
    constexpr uint32_t oneRepSize = AscendC::GetVecLen() / sizeof(T);
    if (count <= oneRepSize) {
        // ShapeScope=1: count <= oneRepSize，直接一次归约
        ReduceSumCounter(dstLocal, srcLocal, count, 1, 8);
    } else {
        // ShapeScope=2: count > oneRepSize，需要两次归约
        ReduceSumCounterModeScope2(dstLocal, srcLocal, workLocal, count, 8);
    }
}
}  // namespace ReduceSumInternal

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, 1024>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, 128>();
        AscendC::LocalTensor<T> workLocal = ubAllocator.Alloc<T, 128>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, totalLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // Compute: ReduceSumImpl
        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        __ubuf__ T* workAddr = reinterpret_cast<__ubuf__ T*>(workLocal.GetPhyAddr());

        ReduceSumInternal::ReduceSumImpl(yAddr, xAddr, workAddr, totalLength);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM (DataCopy要求32B对齐，至少8个float)
        constexpr uint32_t outAlignSize = 8;
        AscendC::DataCopy(yGm, yLocal, outAlignSize);
    }

private:
    uint32_t totalLength;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void reduce_iterator(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    uint32_t totalLength = 64 * 16;  // 1024
    Kernel<float> kernel;
    kernel.Init(x, y, totalLength);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/reduce_iterator_golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile reduce_iterator_golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    float a = (reinterpret_cast<const float*>(outputData))[0];
    float b = (reinterpret_cast<const float*>(goldenData))[0];
    float ae = std::abs(a - b);
    float re = ae / std::abs(b);
    if (ae > EPS && re > EPS) {
        printf("CompareResult reduce_iterator_golden.bin failed output is %lf, golden is %lf\n", a, b);
        wrongNum++;
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult reduce_iterator_golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t totalLength = 64 * 16;  // 1024
    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = 8 * sizeof(float); // 32B对齐
    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/reduce_iterator_input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    reduce_iterator<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(zHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
