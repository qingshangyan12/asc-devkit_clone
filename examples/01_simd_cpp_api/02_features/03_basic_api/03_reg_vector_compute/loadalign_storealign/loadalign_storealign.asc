/*
 * \file loadalign_storealign.asc
 * \brief Reg搬入搬出样例：使用Reg::LoadAlign将数据从UB搬入到Reg，再使用Reg::StoreAlign将数据从Reg搬回UB
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

// 单搬入搬出 普通搬运接口
template <typename T>
__simd_vf__ inline void LoadAlignStoreAlignVF1(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr,
    uint32_t dataSize, uint32_t repeatTimes, uint32_t oneRepeatSize)
{
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::MaskReg mask;

    for (uint32_t i = 0; i < repeatTimes; i++) {
        mask = AscendC::Reg::UpdateMask<T>(dataSize);
        AscendC::Reg::LoadAlign(srcReg, srcAddr + i * oneRepeatSize);
        AscendC::Reg::StoreAlign(dstAddr + i * oneRepeatSize, srcReg, mask);
    }
}

// 单搬入搬出 PostUpdate扩展搬运接口
template <typename T>
__simd_vf__ inline void LoadAlignStoreAlignVF2(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr,
    uint32_t dataSize, uint32_t repeatTimes, uint32_t oneRepeatSize)
{
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::MaskReg mask;

    for (uint32_t i = 0; i < repeatTimes; i++) {
        mask = AscendC::Reg::UpdateMask<T>(dataSize);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(srcReg, srcAddr, oneRepeatSize);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(dstAddr, srcReg, oneRepeatSize, mask);
    }
}

// 单搬入搬出 使用AddrReg存储偏移量接口
template <typename T>
__simd_vf__ inline void LoadAlignStoreAlignVF3(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr,
    uint32_t dataSize, uint32_t repeatTimes, uint32_t oneRepeatSize)
{
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::MaskReg mask;
    AscendC::Reg::AddrReg aReg;
    for (uint32_t i = 0; i < repeatTimes; i++) {
        mask = AscendC::Reg::UpdateMask<T>(dataSize);
        aReg = AscendC::Reg::CreateAddrReg<T>(i, oneRepeatSize);
        AscendC::Reg::LoadAlign(srcReg, srcAddr, aReg);
        AscendC::Reg::StoreAlign(dstAddr, srcReg, aReg, mask);
    }
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;

        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, 520>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, 520>();

        // 将数据从GM搬入到UB
        AscendC::DataCopy(xLocal, xGm, totalLength);

        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());

        // 一个迭代中需要搬运的元素个数：256B / 4 = 64
        constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        // 迭代次数：CeilDivision(520, 64) =  9
        uint16_t repeatTimes = AscendC::CeilDivision(totalLength, oneRepeatSize);

        if constexpr (scenarioNum == 1) {
            // 单搬入搬出 普通搬运接口
            LoadAlignStoreAlignVF1(yAddr, xAddr, totalLength, repeatTimes, oneRepeatSize);
        } else if (scenarioNum == 2) {
            // 单搬入搬出 PostUpdate扩展搬运接口
            LoadAlignStoreAlignVF2(yAddr, xAddr, totalLength, repeatTimes, oneRepeatSize);
        } else if (scenarioNum == 3) {
            // 单搬入搬出 PostUpdate扩展搬运接口
            LoadAlignStoreAlignVF3(yAddr, xAddr, totalLength, repeatTimes, oneRepeatSize);
        }

        // 将结果从UB搬出到GM
        AscendC::DataCopy(yGm, yLocal, totalLength);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    uint32_t totalLength;
};

__global__ __vector__ void loadalign_storealign(GM_ADDR x, GM_ADDR y)
{
    uint32_t totalLength = 520;
    Kernel<float> kernel;
    kernel.Init(x, y, totalLength);
    kernel.Process();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;

    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }

    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;
    const float* out = reinterpret_cast<const float*>(outputData);
    const float* golden = reinterpret_cast<const float*>(goldenData);
    uint32_t outCount = outSize / sizeof(float);
    
    for (uint32_t i = 0; i < outCount; i++) {
        float diff = std::abs(out[i] - golden[i]);
        float relDiff = diff / std::abs(golden[i]);
        if (diff > EPS && relDiff > EPS) {
            printf("CompareResult [%d] failed: output=%f, golden=%f\n", i, out[i], golden[i]);
            wrongNum++;
        }
    }
    
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("CompareResult: %ld elements wrong!\n", wrongNum);
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t totalLength = 520;

    size_t inputByteSize = static_cast<size_t>(1) * totalLength * sizeof(float);
    size_t outputByteSize = static_cast<size_t>(1) * totalLength * sizeof(float);

    uint8_t *xHost, *yHost;
    uint8_t *xDevice, *yDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./output/input.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t numBlocks = 1;

    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    loadalign_storealign<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputByteSize);

    bool goldenResult = true;
    goldenResult = CompareResult(yHost, outputByteSize);
    if (!goldenResult) {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);

    aclrtDestroyStream(stream);

    aclrtResetDevice(deviceId);

    return 0;
}
