/* !
 * \file mul.asc
 * \brief 演示使用Mul API实现向量逐元素乘法计算功能，支持单核和4核两种运行模式
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <typename T>
__simd_vf__ inline void MulVF(__ubuf__ T* xAddr, __ubuf__ T* yAddr, __ubuf__ T* zAddr, uint32_t totalCount,
                              uint32_t repeatTimes, uint32_t oneRepeatSize)
{
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<T> yReg;
    AscendC::Reg::RegTensor<T> zReg;
    for (uint16_t i = 0; i < repeatTimes; ++i) {
        AscendC::Reg::LoadAlign(xReg, xAddr + i * oneRepeatSize);
        AscendC::Reg::LoadAlign(yReg, yAddr + i * oneRepeatSize);
        AscendC::Reg::Mul(zReg, yReg, xReg, mask);
        AscendC::Reg::StoreAlign(zAddr + i * oneRepeatSize, zReg, mask);
    }
}

template <typename T, uint32_t perCoreLength>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        this->zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z));
    }
    __aicore__ inline void Process()
    {
        if constexpr (scenarioNum == 1) {
            // 场景1：单核模式，一个核处理全部数据
            ProcessSingleCore();
        } else if constexpr (scenarioNum == 2) {
            // 场景2：4核模式，每个核处理 perCoreLength 个数据，自行计算偏移
            ProcessMultiCore();
        }
    }

private:
    __aicore__ inline void ProcessSingleCore()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, perCoreLength>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, perCoreLength>();
        AscendC::LocalTensor<T> zLocal = ubAllocator.Alloc<T, perCoreLength>();

        // CopyIn: GM -> UB
        AscendC::DataCopy(xLocal, xGm, perCoreLength);
        AscendC::DataCopy(yLocal, yGm, perCoreLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // Compute: RegBase MulVF z = x * y
        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        __ubuf__ T* zAddr = reinterpret_cast<__ubuf__ T*>(zLocal.GetPhyAddr());
        constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        uint16_t repeatTimes = AscendC::CeilDivision(perCoreLength, oneRepeatSize);
        MulVF(xAddr, yAddr, zAddr, perCoreLength, repeatTimes, oneRepeatSize);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM
        AscendC::DataCopy(zGm, zLocal, perCoreLength);
    }

    __aicore__ inline uint32_t GetCoreOffset()
    {
        // 多核模式：通过 GetBlockIdx() 获取当前核号，计算该核在全局数据中的偏移
        return AscendC::GetBlockIdx() * perCoreLength;
    }

    __aicore__ inline void ProcessMultiCore()
    {
        uint32_t coreOffset = GetCoreOffset();

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, perCoreLength>();
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, perCoreLength>();
        AscendC::LocalTensor<T> zLocal = ubAllocator.Alloc<T, perCoreLength>();

        // CopyIn: GM+offset -> UB，每个核从全局内存的对应偏移位置读取数据
        AscendC::DataCopy(xLocal, xGm[coreOffset], perCoreLength);
        AscendC::DataCopy(yLocal, yGm[coreOffset], perCoreLength);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // Compute: RegBase MulVF z = x * y
        __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        __ubuf__ T* zAddr = reinterpret_cast<__ubuf__ T*>(zLocal.GetPhyAddr());
        constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        uint16_t repeatTimes = AscendC::CeilDivision(perCoreLength, oneRepeatSize);
        MulVF(xAddr, yAddr, zAddr, perCoreLength, repeatTimes, oneRepeatSize);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // CopyOut: UB -> GM+offset，每个核将结果写回全局内存的对应偏移位置
        AscendC::DataCopy(zGm[coreOffset], zLocal, perCoreLength);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

constexpr uint32_t totalLength = 1024;

__global__ __vector__ void mul(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    if constexpr (scenarioNum == 1) {
        // 场景1：单核模式，一个核处理全部数据
        constexpr uint32_t perCoreLength = totalLength;
        Kernel<float, perCoreLength> kernel;
        kernel.Init(x, y, z);
        kernel.Process();
    } else if constexpr (scenarioNum == 2) {
        // 场景2：4核模式，每个核处理 perCoreLength 个数据
        constexpr uint32_t perCoreLength = totalLength / 4;
        Kernel<float, perCoreLength> kernel;
        kernel.Init(x, y, z);
        kernel.Process();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks;
    if constexpr (scenarioNum == 1) {
        numBlocks = 1;
    } else {
        numBlocks = 4;
    }
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t totalLength = 1024;
    size_t inputByteSize = static_cast<size_t>(1) * totalLength * sizeof(float);
    size_t outputByteSize = static_cast<size_t>(1) * totalLength * sizeof(float);
    uint8_t *xHost, *yHost, *zHost;
    uint8_t *xDevice, *yDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    mul<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(zHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
