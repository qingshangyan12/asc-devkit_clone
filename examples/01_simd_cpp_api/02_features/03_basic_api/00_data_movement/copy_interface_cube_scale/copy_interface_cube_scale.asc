#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "data_utils.h"

constexpr uint32_t M=32,N=32,K=128,SK=4;
constexpr asc::te::mmad_trait MX_TRAIT{0,false,false,true,asc::te::mmad_type::mx};
struct mx_mmad_trait { using trait_type=asc::te::mmad_trait; static constexpr const trait_type value=MX_TRAIT; };

template<typename Atom,typename Dst,typename Src>
__aicore__ inline void tested_scale_a(const Atom& atom,const Dst& dst,const Src& src)
{
    using namespace asc::te;
    if constexpr(SCENARIO_NUM==0) copy(atom,dst,src,make_coord(0,0),make_coord(0,2),make_shape(32,2));
    else if constexpr(SCENARIO_NUM==1) copy(dst,src);
    else copy(dst,src,make_coord(16,0),make_coord(0,0),make_shape(16,4));
}
template<typename Atom,typename Dst,typename Src>
__aicore__ inline void tested_scale_b(const Atom& atom,const Dst& dst,const Src& src)
{
    using namespace asc::te;
    if constexpr(SCENARIO_NUM==0) copy(atom,dst,src,make_coord(0,0),make_coord(0,16),make_shape(4,16));
    else if constexpr(SCENARIO_NUM==1) copy(dst,src);
    else copy(dst,src,make_coord(2,0),make_coord(0,0),make_shape(2,32));
}

__cube__ __global__ void copy_interface_cube_scale(__gm__ fp4x2_e1m2_t* a,__gm__ fp4x2_e1m2_t* b,
 __gm__ fp8_e8m0_t* base_as,__gm__ fp8_e8m0_t* base_bs,__gm__ fp8_e8m0_t* test_as,__gm__ fp8_e8m0_t* test_bs,__gm__ bfloat16_t* out)
{
    using namespace asc::te;
    __cbuf__ fp4x2_e1m2_t l1a_buf[M*K/2],l1b_buf[K*N/2];
    __cbuf__ fp8_e8m0_t l1_base_as[M*SK],l1_base_bs[SK*N],l1_test_as[M*SK],l1_test_bs[SK*N];
    __ca__ fp4x2_e1m2_t l0a_buf[M*K/2];__cb__ fp4x2_e1m2_t l0b_buf[K*N/2];__cc__ float l0c_buf[M*N];
    auto gm_a=make_tensor(make_mem_ptr(a),make_frame_layout<nd_ext_layout_ptn>(M,K));
    auto gm_b=make_tensor(make_mem_ptr(b),make_frame_layout<dn_ext_layout_ptn>(K,N));
    auto as_gm_layout=make_frame_layout<scalea_nd_layout_ptn>(M,SK);auto bs_gm_layout=make_frame_layout<scaleb_dn_layout_ptn>(SK,N);
    auto gm_base_as=make_tensor(make_mem_ptr(base_as),as_gm_layout);auto gm_base_bs=make_tensor(make_mem_ptr(base_bs),bs_gm_layout);
    auto gm_test_as=make_tensor(make_mem_ptr(test_as),as_gm_layout);auto gm_test_bs=make_tensor(make_mem_ptr(test_bs),bs_gm_layout);
    auto l1a_layout=make_frame_layout<nz_layout_ptn,AscendC::Std::Int<64>>(M,K);auto l1b_layout=make_frame_layout<zn_layout_ptn,AscendC::Std::Int<64>>(K,N);
    auto as_layout=make_frame_layout<zz_layout_ptn,AscendC::Std::Int<2>>(M,SK);auto bs_layout=make_frame_layout<nn_layout_ptn,AscendC::Std::Int<2>>(SK,N);
    auto l1a=make_tensor(make_mem_ptr(l1a_buf),l1a_layout);auto l1b=make_tensor(make_mem_ptr(l1b_buf),l1b_layout);
    auto base_as_t=make_tensor(make_mem_ptr(l1_base_as),as_layout);auto base_bs_t=make_tensor(make_mem_ptr(l1_base_bs),bs_layout);
    auto test_as_t=make_tensor(make_mem_ptr(l1_test_as),as_layout);auto test_bs_t=make_tensor(make_mem_ptr(l1_test_bs),bs_layout);
    auto l0a=make_tensor(make_mem_ptr(l0a_buf),l1a_layout);auto l0b=make_tensor(make_mem_ptr(l0b_buf),l1b_layout);
    auto l0as_ptr=make_mem_ptr<location::l0scalea,fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0a_buf)/16);
    auto l0bs_ptr=make_mem_ptr<location::l0scaleb,fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0b_buf)/16);
    auto l0as=make_tensor(l0as_ptr,as_layout);auto l0bs=make_tensor(l0bs_ptr,bs_layout);
    auto l0c=make_tensor(make_mem_ptr(l0c_buf),make_frame_layout<nz_layout_ptn,AscendC::Std::Int<16>>(M,N));
    auto gm_out=make_tensor(make_mem_ptr(out),make_frame_layout<nd_ext_layout_ptn>(M,N));
    auto gm2l1=make_copy(copy_gm_to_l1{},copy_gm_to_l1_trait_default{});auto l12a=make_copy(copy_l1_to_l0a{},copy_l1_to_l0a_trait_default{});auto l12b=make_copy(copy_l1_to_l0b{},copy_l1_to_l0b_trait_default{});
    auto s2a=make_copy(copy_l1_to_l0scalea{},copy_l1_to_l0scalea_trait_default{});auto s2b=make_copy(copy_l1_to_l0scaleb{},copy_l1_to_l0scaleb_trait_default{});
    auto c2gm=make_copy(copy_l0c_to_gm{},copy_l0c_to_gm_trait_default{});auto mma=make_mmad(mmad_operation{},mx_mmad_trait{});
    copy(gm2l1,l1a,gm_a);copy(gm2l1,l1b,gm_b);copy(gm2l1,base_as_t,gm_base_as);copy(gm2l1,base_bs_t,gm_base_bs);copy(gm2l1,test_as_t,gm_test_as);copy(gm2l1,test_bs_t,gm_test_bs);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    copy(l12a,l0a,l1a);copy(l12b,l0b,l1b);copy(s2a,l0as,base_as_t);copy(s2b,l0bs,base_bs_t);
    // The following tested copy updates the same L0Scale buffer. Serialize the two MTE1 writes so
    // the baseline load cannot retire after the partial-region load and overwrite its result.
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    if constexpr(COPY_ROUTE==0)tested_scale_a(s2a,l0as,test_as_t);else tested_scale_b(s2b,l0bs,test_bs_t);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
    asc::te::mmad(mma.with(mmad_params{M,N,K,0,true}),l0c,l0a,l0b);AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    copy(c2gm,gm_out,l0c);
}

int32_t main(){constexpr size_t ab=M*K/2,as=M*SK,bs=SK*N,ob=M*N*sizeof(uint16_t);aclInit(nullptr);aclrtSetDevice(0);aclrtStream s=nullptr;aclrtCreateStream(&s);
 uint8_t *ah,*bh,*bah,*bbh,*tah,*tbh,*oh,*ad,*bd,*bad,*bbd,*tad,*tbd,*od;size_t sizes[7]={ab,ab,as,bs,as,bs,ob};uint8_t**hs[7]={&ah,&bh,&bah,&bbh,&tah,&tbh,&oh};uint8_t**ds[7]={&ad,&bd,&bad,&bbd,&tad,&tbd,&od};
 for(int i=0;i<7;i++){aclrtMallocHost((void**)hs[i],sizes[i]);aclrtMalloc((void**)ds[i],sizes[i],ACL_MEM_MALLOC_HUGE_FIRST);}const char*files[6]={"input/a.bin","input/b.bin","input/base_as.bin","input/base_bs.bin","input/test_as.bin","input/test_bs.bin"};
 for(int i=0;i<6;i++){if(!read_file(files[i],*hs[i],sizes[i]))return 1;aclrtMemcpy(*ds[i],sizes[i],*hs[i],sizes[i],ACL_MEMCPY_HOST_TO_DEVICE);}copy_interface_cube_scale<<<1,nullptr,s>>>((fp4x2_e1m2_t*)ad,(fp4x2_e1m2_t*)bd,(fp8_e8m0_t*)bad,(fp8_e8m0_t*)bbd,(fp8_e8m0_t*)tad,(fp8_e8m0_t*)tbd,(bfloat16_t*)od);
 aclrtSynchronizeStream(s);aclrtMemcpy(oh,ob,od,ob,ACL_MEMCPY_DEVICE_TO_HOST);write_file("output/output.bin",oh,ob);for(int i=0;i<7;i++){aclrtFree(*ds[i]);aclrtFreeHost(*hs[i]);}aclrtDestroyStream(s);aclrtResetDevice(0);aclFinalize();return 0;}
