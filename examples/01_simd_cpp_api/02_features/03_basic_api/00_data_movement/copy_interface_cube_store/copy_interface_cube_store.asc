#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

constexpr uint32_t DIM=32;
using input_type=typename AscendC::Std::conditional_t<(QUANT_MODE==0),half,int8_t>;
using accum_type=typename AscendC::Std::conditional_t<(QUANT_MODE==0),float,int32_t>;
using output_type=typename AscendC::Std::conditional_t<(COPY_ROUTE==2),half,
    typename AscendC::Std::conditional_t<(QUANT_MODE==0),float,half>>;

template<typename Atom,typename Dst,typename Src>
__aicore__ inline void tested_copy(const Atom& atom,const Dst& dst,const Src& src)
{
    using namespace asc::te;
    if constexpr(SCENARIO_NUM==0) copy(atom,dst,src,make_coord(0,0),make_coord(0,16),make_shape(32,16));
    else if constexpr(SCENARIO_NUM==1) copy(dst,src);
    else copy(dst,src,make_coord(16,0),make_coord(0,0),make_shape(16,32));
}

template<typename Atom,typename Dst,typename Src,typename Quant>
__aicore__ inline void tested_quant_copy(const Atom& atom,const Dst& dst,const Src& src,const Quant& quant)
{
    using namespace asc::te;
    if constexpr(SCENARIO_NUM==0) copy(atom,dst,src,quant,make_coord(0,0),make_coord(0,16),make_shape(32,16));
    else if constexpr(SCENARIO_NUM==1) copy(dst,src,quant);
    else copy(dst,src,quant,make_coord(16,0),make_coord(0,0),make_shape(16,32));
}

__global__ __mix__(1, 1) void copy_interface_cube_store(__gm__ input_type* a,__gm__ input_type* b,
                                                       __gm__ uint64_t* quant,__gm__ output_type* output)
{
    using namespace asc::te;
    __cbuf__ input_type l1a_buf[DIM*DIM]; __cbuf__ input_type l1b_buf[DIM*DIM];
    __cbuf__ uint64_t l1q_buf[DIM]; __cbuf__ output_type l1c_buf[DIM*DIM];
    __ca__ input_type l0a_buf[DIM*DIM]; __cb__ input_type l0b_buf[DIM*DIM];
    __cc__ accum_type l0c_buf[DIM*DIM]; __ubuf__ accum_type ub_buf[DIM*DIM]; __ubuf__ output_type l1_ub_buf[DIM*DIM];
    auto gm_a=make_tensor(make_mem_ptr(a),make_frame_layout<nd_ext_layout_ptn>(DIM,DIM));
    auto gm_b=make_tensor(make_mem_ptr(b),make_frame_layout<dn_ext_layout_ptn>(DIM,DIM));
    auto gm_out=make_tensor(make_mem_ptr(output),make_frame_layout<nd_ext_layout_ptn>(DIM,DIM));
    auto gm_out_nz=make_tensor(make_mem_ptr(output),make_frame_layout<nz_layout_ptn,output_type>(DIM,DIM));
    auto l1a=make_tensor(make_mem_ptr(l1a_buf),make_frame_layout<nz_layout_ptn,input_type>(DIM,DIM));
    auto l1b=make_tensor(make_mem_ptr(l1b_buf),make_frame_layout<zn_layout_ptn,input_type>(DIM,DIM));
    auto l0a=make_tensor(make_mem_ptr(l0a_buf),make_frame_layout<nz_layout_ptn,input_type>(DIM,DIM));
    auto l0b=make_tensor(make_mem_ptr(l0b_buf),make_frame_layout<zn_layout_ptn,input_type>(DIM,DIM));
    auto l0c=make_tensor(make_mem_ptr(l0c_buf),make_frame_layout<nz_layout_ptn,layout_trait_default<accum_type,_16>>(DIM,DIM));
    auto l1c=make_tensor(make_mem_ptr(l1c_buf),make_frame_layout<nz_layout_ptn,output_type>(DIM,DIM));
    auto ub=make_tensor(make_mem_ptr(ub_buf),make_frame_layout<nd_ext_layout_ptn,accum_type>(DIM,DIM));
    auto gm2l1=make_copy(copy_gm_to_l1{},copy_gm_to_l1_trait_default{});
    auto l12a=make_copy(copy_l1_to_l0a{},copy_l1_to_l0a_trait_default{}); auto l12b=make_copy(copy_l1_to_l0b{},copy_l1_to_l0b_trait_default{});
    auto c2gm=make_copy(copy_l0c_to_gm{},copy_l0c_to_gm_trait_default{}); auto c2ub=make_copy(copy_l0c_to_ub{},copy_l0c_to_ub_trait_default{});
    auto c2l1=make_copy(copy_l0c_to_l1{},copy_l0c_to_l1_trait_default{}); auto l12ub=make_copy(copy_l1_to_ub{},copy_l1_to_ub_trait_default{});
    auto gm2ub=make_copy(copy_gm_to_ub{},copy_gm_to_ub_trait_default{}); auto ub2gm=make_copy(copy_ub_to_gm{},copy_ub_to_gm_trait_default{});
    auto mma=make_mmad(mmad_operation{},mmad_trait_default{});
    if ASCEND_IS_AIC {
        if constexpr(COPY_ROUTE==1) asc_sync_block_wait(PIPE_S,0x7);
        copy(gm2l1,l1a,gm_a);copy(gm2l1,l1b,gm_b);
        asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
        copy(l12a,l0a,l1a);copy(l12b,l0b,l1b);asc_sync_notify(PIPE_MTE1,PIPE_M,EVENT_ID0);asc_sync_wait(PIPE_MTE1,PIPE_M,EVENT_ID0);
        asc::te::mmad(mma.with(mmad_params{DIM,DIM,DIM,0,true}),l0c,l0a,l0b);asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID0);asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID0);
        if constexpr(COPY_ROUTE==0){
            if constexpr(QUANT_MODE==0) tested_copy(c2gm,gm_out,l0c);
            else if constexpr(QUANT_MODE==1){uint64_t scalar_quant=0x3f800000ULL;tested_quant_copy(c2gm,gm_out,l0c,scalar_quant);}
            else {
                auto gm_q=make_tensor(make_mem_ptr(quant),make_frame_layout<nd_ext_layout_ptn,uint64_t>(1,DIM));
                auto l1q=make_tensor(make_mem_ptr(l1q_buf),make_frame_layout<nd_ext_layout_ptn,uint64_t>(1,DIM));
                copy(gm2l1,l1q,gm_q);asc_sync_notify(PIPE_MTE2,PIPE_FIX,EVENT_ID1);asc_sync_wait(PIPE_MTE2,PIPE_FIX,EVENT_ID1);
                tested_quant_copy(c2gm,gm_out,l0c,l1q);
            }
        } else if constexpr(COPY_ROUTE==1){
            if constexpr(SCENARIO_NUM==1) {
                auto ub_tile=ub.slice(make_coord(16,0),make_shape(16,32));
                auto l0c_tile=l0c.slice(make_coord(0,0),make_shape(16,32));
                tested_copy(c2ub,ub_tile,l0c_tile);
            } else tested_copy(c2ub,ub,l0c);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc_sync_block_arrive(PIPE_FIX,0x8);asc_sync_block_wait(PIPE_S,0x9);
        } else {
            copy(gm2l1,l1c,gm_out);asc_sync_notify(PIPE_MTE2,PIPE_FIX,EVENT_ID1);asc_sync_wait(PIPE_MTE2,PIPE_FIX,EVENT_ID1);
            tested_copy(c2l1,l1c,l0c);AscendC::PipeBarrier<PIPE_ALL>();
            auto ub_nz=make_tensor(make_mem_ptr(l1_ub_buf),make_frame_layout<nz_layout_ptn,output_type>(DIM,DIM));
            copy(l12ub,ub_nz,l1c);AscendC::PipeBarrier<PIPE_ALL>();
            asc_sync_block_arrive(PIPE_MTE1,0x8);asc_sync_block_wait(PIPE_S,0x9);
        }
    }
    if ASCEND_IS_AIV {
        if constexpr(COPY_ROUTE==1){
            copy(gm2ub,ub,gm_out);AscendC::PipeBarrier<PIPE_ALL>();asc_sync_block_arrive(PIPE_MTE2,0x7);
            asc_sync_block_wait(PIPE_S,0x8);asc_sync_block_arrive(PIPE_MTE3,0x9);
            copy(ub2gm,gm_out,ub);
        } else if constexpr(COPY_ROUTE==2){
            asc_sync_block_wait(PIPE_S,0x8);
            auto ub_nz=make_tensor(make_mem_ptr(l1_ub_buf),make_frame_layout<nz_layout_ptn,output_type>(DIM,DIM));
            copy(ub2gm,gm_out_nz,ub_nz);AscendC::PipeBarrier<PIPE_ALL>();asc_sync_block_arrive(PIPE_MTE3,0x9);
        }
    }
}

int32_t main(){constexpr size_t in_bytes=DIM*DIM*sizeof(input_type),out_bytes=DIM*DIM*sizeof(output_type),q_bytes=DIM*sizeof(uint64_t);
 aclInit(nullptr);aclrtSetDevice(0);aclrtStream s=nullptr;aclrtCreateStream(&s);uint8_t *ah,*bh,*qh,*oh;input_type *ad,*bd;uint64_t*qd;output_type*od;
 aclrtMallocHost((void**)&ah,in_bytes);aclrtMallocHost((void**)&bh,in_bytes);aclrtMallocHost((void**)&qh,q_bytes);aclrtMallocHost((void**)&oh,out_bytes);
 aclrtMalloc((void**)&ad,in_bytes,ACL_MEM_MALLOC_HUGE_FIRST);aclrtMalloc((void**)&bd,in_bytes,ACL_MEM_MALLOC_HUGE_FIRST);aclrtMalloc((void**)&qd,q_bytes,ACL_MEM_MALLOC_HUGE_FIRST);aclrtMalloc((void**)&od,out_bytes,ACL_MEM_MALLOC_HUGE_FIRST);
 if(!read_file("./input/a.bin",ah,in_bytes)||!read_file("./input/b.bin",bh,in_bytes)||!read_file("./input/quant.bin",qh,q_bytes)||!read_file("./input/initial.bin",oh,out_bytes))return 1;
 aclrtMemcpy(ad,in_bytes,ah,in_bytes,ACL_MEMCPY_HOST_TO_DEVICE);aclrtMemcpy(bd,in_bytes,bh,in_bytes,ACL_MEMCPY_HOST_TO_DEVICE);aclrtMemcpy(qd,q_bytes,qh,q_bytes,ACL_MEMCPY_HOST_TO_DEVICE);aclrtMemcpy(od,out_bytes,oh,out_bytes,ACL_MEMCPY_HOST_TO_DEVICE);
 copy_interface_cube_store<<<1,nullptr,s>>>(ad,bd,qd,od);aclrtSynchronizeStream(s);aclrtMemcpy(oh,out_bytes,od,out_bytes,ACL_MEMCPY_DEVICE_TO_HOST);write_file("./output/output.bin",oh,out_bytes);
 aclrtFree(ad);aclrtFree(bd);aclrtFree(qd);aclrtFree(od);aclrtFreeHost(ah);aclrtFreeHost(bh);aclrtFreeHost(qh);aclrtFreeHost(oh);aclrtDestroyStream(s);aclrtResetDevice(0);aclFinalize();return 0;}
