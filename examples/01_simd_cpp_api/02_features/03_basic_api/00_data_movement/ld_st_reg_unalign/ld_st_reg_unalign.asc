/* !
 * \file ld_st_reg_unalign.asc
 * \brief 演示LoadUnAlign和StoreUnAlign接口在多场景下的使用方法
 *        场景1：单核非对齐数据搬运
 *        场景2：多核ReduceDataBlock(MAX)计算，展示LoadUnAlign处理非对齐输入(uint16_t)
 */

#include <vector>
#include <iostream>
#include <iterator>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

// 场景1：单核数据搬运
template <typename T>
__simd_vf__ inline void CopyVF(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint16_t oneRepeatSize)
{
    AscendC::Reg::RegTensor<T> srcReg, dstReg;
    AscendC::Reg::UnalignRegForLoad ureg0;
    AscendC::Reg::UnalignRegForStore ureg1;
    AscendC::Reg::LoadUnAlignPre(ureg0, srcAddr);
    
    __ubuf__ T*& srcAddrRef = srcAddr;
    __ubuf__ T*& dstAddrRef = dstAddr;
    
    for (uint16_t i = 0; i < 2; ++i) {
        AscendC::Reg::LoadUnAlign(srcReg, ureg0, srcAddrRef, oneRepeatSize);
        AscendC::Reg::StoreUnAlign(dstAddrRef, srcReg, ureg1, oneRepeatSize);
    }
    AscendC::Reg::StoreUnAlignPost(dstAddrRef, ureg1, 0);
}

// 场景2：多核ReduceDataBlock MAX
constexpr uint32_t TOTAL_ROWS = 14;
constexpr uint32_t ROW_LENGTH = 255;
constexpr uint32_t CONFIGURED_CORE_NUM = 4;
constexpr uint32_t RESULTS_PER_ROW = 16;

template <typename T>
__simd_vf__ inline void ReduceDataBlockVF(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint32_t rowLength)
{
    AscendC::Reg::RegTensor<T> srcReg, dstReg;
    AscendC::Reg::UnalignRegForLoad uregLoad;
    AscendC::Reg::UnalignRegForStore uregStore;
    AscendC::Reg::MaskReg maskAll = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
    constexpr uint32_t resultsPerRepeat = 8;
    uint16_t repeatTimes = (rowLength + oneRepeatSize - 1) / oneRepeatSize;

    AscendC::Reg::LoadUnAlignPre(uregLoad, srcAddr);

    __ubuf__ T*& srcAddrRef = srcAddr;
    __ubuf__ T*& dstAddrRef = dstAddr;

    AscendC::Reg::LoadUnAlign(srcReg, uregLoad, srcAddrRef, oneRepeatSize);
    AscendC::Reg::ReduceDataBlock<AscendC::Reg::ReduceType::MAX>(dstReg, srcReg, maskAll);
    AscendC::Reg::StoreUnAlign(dstAddrRef, dstReg, uregStore, resultsPerRepeat);

    AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_STORE>();

    uint32_t remaining = rowLength - oneRepeatSize;
    AscendC::Reg::MaskReg maskRemaining = AscendC::Reg::UpdateMask<T>(remaining);
    AscendC::Reg::LoadUnAlign(srcReg, uregLoad, srcAddrRef, oneRepeatSize);
    AscendC::Reg::ReduceDataBlock<AscendC::Reg::ReduceType::MAX>(dstReg, srcReg, maskRemaining);
    AscendC::Reg::StoreUnAlign(dstAddrRef, dstReg, uregStore, resultsPerRepeat);

    AscendC::Reg::StoreUnAlignPost(dstAddrRef, uregStore, repeatTimes * resultsPerRepeat);
}

// 场景1：单核Kernel
template<typename T>
class KernelScenario1 {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t count)
    {
        this->count = count;
        this->xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        this->yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T>(count);
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T>(count);

        AscendC::DataCopy(xLocal, xGm, count);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Duplicate<T>(yLocal, 0, count);

        __ubuf__ T* srcAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* dstAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());
        constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        asc_vf_call<CopyVF<T>>(dstAddr + 1, srcAddr + 1, oneRepeatSize);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        AscendC::DataCopy(yGm, yLocal, count);
    }

private:
    uint32_t count;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

// 场景2：多核Kernel
template<typename T>
class KernelScenario2 {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));

        uint32_t usedCoreNum = (CONFIGURED_CORE_NUM < TOTAL_ROWS) ? CONFIGURED_CORE_NUM : TOTAL_ROWS;
        uint32_t blockIdx = AscendC::GetBlockIdx();

        if (blockIdx >= usedCoreNum) {
            rowsThisCore = 0;
            startRow = 0;
            return;
        }

        formerRowsPerCore = (TOTAL_ROWS + usedCoreNum - 1) / usedCoreNum;
        rowsThisCore = (blockIdx < usedCoreNum - 1) ? formerRowsPerCore :
                       (TOTAL_ROWS - formerRowsPerCore * (usedCoreNum - 1));
        startRow = blockIdx * formerRowsPerCore;
    }

    __aicore__ inline void Process()
    {
        if (rowsThisCore == 0) {
            return;
        }

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;

        constexpr uint32_t BYTE_ALIGN = 32;

        uint32_t totalInputBytes = rowsThisCore * ROW_LENGTH * sizeof(T);
        uint32_t alignedInputBytes = ((totalInputBytes + BYTE_ALIGN - 1) / BYTE_ALIGN) * BYTE_ALIGN;
        uint32_t alignedInputSize = alignedInputBytes / sizeof(T);

        uint32_t totalOutputSize = rowsThisCore * RESULTS_PER_ROW;
        uint32_t alignedOutputBytes = ((totalOutputSize * sizeof(T) + BYTE_ALIGN - 1) / BYTE_ALIGN) * BYTE_ALIGN;
        uint32_t alignedOutputSize = alignedOutputBytes / sizeof(T);

        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T>(alignedInputSize);
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T>(alignedOutputSize);

        uint32_t inputOffset = startRow * ROW_LENGTH;

        AscendC::DataCopyExtParams copyParams = {1, (uint32_t)totalInputBytes, 0, 0, 0};
        uint8_t rpad = (alignedInputBytes - totalInputBytes) / sizeof(T);
        AscendC::DataCopyPadExtParams<T> padParams = {false, 0, rpad, 0};
        AscendC::DataCopyPad<T>(xLocal, xGm[inputOffset], copyParams, padParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        __ubuf__ T* srcAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr());
        __ubuf__ T* dstAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr());

        for (uint32_t row = 0; row < rowsThisCore; ++row) {
            __ubuf__ T* rowSrcAddr = srcAddr + row * ROW_LENGTH;
            __ubuf__ T* rowDstAddr = dstAddr + row * RESULTS_PER_ROW;
            asc_vf_call<ReduceDataBlockVF<T>>(rowDstAddr, rowSrcAddr, ROW_LENGTH);

            AscendC::Reg::LocalMemBar<AscendC::Reg::MemType::VEC_STORE, AscendC::Reg::MemType::VEC_STORE>();
        }

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        uint32_t outputOffset = startRow * RESULTS_PER_ROW;
        AscendC::DataCopy(yGm[outputOffset], yLocal, totalOutputSize);
    }

private:
    uint32_t formerRowsPerCore;
    uint32_t rowsThisCore;
    uint32_t startRow;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void ld_st_reg_unalign_kernel(GM_ADDR x, GM_ADDR y)
{
    AscendC::InitSocState();
    if constexpr (scenarioNum == 1) {
        KernelScenario1<float> kernel;
        kernel.Init(x, y, 1024);
        kernel.Process();
    } else if constexpr (scenarioNum == 2) {
        KernelScenario2<uint16_t> kernel;
        kernel.Init(x, y);
        kernel.Process();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("ReadFile golden.bin failed!\n");
        aclrtFreeHost(goldenData);
        return false;
    }

    constexpr float EPS = 1e-3;
    int64_t wrongNum = 0;

    if constexpr (scenarioNum == 1) {
        const float* output = reinterpret_cast<const float*>(outputData);
        const float* golden = reinterpret_cast<const float*>(goldenData);
        uint32_t totalSize = outSize / sizeof(float);
        
        for (uint32_t i = 0; i < totalSize; ++i) {
            float a = output[i];
            float b = golden[i];
            if (std::abs(a - b) > EPS) {
                if (wrongNum < 5) {
                    printf("Mismatch at index %u: output=%f, golden=%f\n", i, a, b);
                }
                wrongNum++;
            }
        }
    } else if constexpr (scenarioNum == 2) {
        const uint16_t* output = reinterpret_cast<const uint16_t*>(outputData);
        const uint16_t* golden = reinterpret_cast<const uint16_t*>(goldenData);
        uint32_t totalSize = outSize / sizeof(uint16_t);
        
        for (uint32_t i = 0; i < totalSize; ++i) {
            if (output[i] != golden[i]) {
                if (wrongNum < 5) {
                    printf("Mismatch at index %u: output=%u, golden=%u\n", i, (uint32_t)output[i], (uint32_t)golden[i]);
                }
                wrongNum++;
            }
        }
    }

    aclrtFreeHost(goldenData);
    if (wrongNum == 0) {
        printf("test pass!\n");
        return true;
    } else {
        printf("test fail! wrong count: %ld\n", wrongNum);
        return false;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    if constexpr (scenarioNum == 1) {
        size_t inputByteSize = 1024 * sizeof(float);
        size_t outputByteSize = 1024 * sizeof(float);
        
        uint8_t* xHost;
        uint8_t* yHost;
        uint8_t* xDevice;
        uint8_t* yDevice;
        
        aclrtMallocHost((void**)(&xHost), inputByteSize);
        aclrtMallocHost((void**)(&yHost), outputByteSize);
        aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        
        size_t inputSize = inputByteSize;
        ReadFile("./input/input_x.bin", inputSize, xHost, inputByteSize);
        aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
        
        uint32_t numBlocks = 1;
        aclrtStream stream = nullptr;
        aclInit(nullptr);
        int32_t deviceId = 0;
        aclrtSetDevice(deviceId);
        aclrtCreateStream(&stream);
        
        ld_st_reg_unalign_kernel<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
        
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", yHost, outputByteSize);
        
        bool result = CompareResult(yHost, outputByteSize);
        
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        
        return result ? 0 : 1;
        
    } else if constexpr (scenarioNum == 2) {
        size_t inputByteSize = TOTAL_ROWS * ROW_LENGTH * sizeof(uint16_t);
        size_t outputByteSize = TOTAL_ROWS * RESULTS_PER_ROW * sizeof(uint16_t);
        
        uint8_t* xHost;
        uint8_t* yHost;
        uint8_t* xDevice;
        uint8_t* yDevice;
        
        aclrtMallocHost((void**)(&xHost), inputByteSize);
        aclrtMallocHost((void**)(&yHost), outputByteSize);
        aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&yDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        
        size_t inputSize = inputByteSize;
        ReadFile("./input/input_x.bin", inputSize, xHost, inputByteSize);
        aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
        
        uint32_t numBlocks = CONFIGURED_CORE_NUM;
        aclrtStream stream = nullptr;
        aclInit(nullptr);
        int32_t deviceId = 0;
        aclrtSetDevice(deviceId);
        aclrtCreateStream(&stream);
        
        ld_st_reg_unalign_kernel<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
        
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(yHost, outputByteSize, yDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", yHost, outputByteSize);
        
        bool result = CompareResult(yHost, outputByteSize);
        
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFreeHost(xHost);
        aclrtFreeHost(yHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        
        return result ? 0 : 1;
    }
    
    return 0;
}