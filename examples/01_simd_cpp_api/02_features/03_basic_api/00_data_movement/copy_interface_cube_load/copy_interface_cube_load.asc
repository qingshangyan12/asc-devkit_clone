#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

constexpr uint32_t DIM = 32;
constexpr uint32_t MATRIX_ELEMENTS = DIM * DIM;

template <typename Atom, typename Dst, typename Src>
__aicore__ inline void tested_matrix_copy(const Atom& atom, const Dst& dst, const Src& src)
{
    using namespace asc::te;
    if constexpr ((COPY_ROUTE == 3 || COPY_ROUTE == 4) && SCENARIO_NUM == 0) {
        copy(atom, dst, src, make_coord(0, 16), make_coord(0, 0), make_shape(32, 16));
    } else if constexpr ((COPY_ROUTE == 3 || COPY_ROUTE == 4) && SCENARIO_NUM == 2) {
        copy(dst, src, make_coord(16, 0), make_coord(0, 0), make_shape(16, 32));
    } else if constexpr (SCENARIO_NUM == 0) {
        copy(atom, dst, src, make_coord(16, 0), make_coord(0, 0), make_shape(16, 32));
    } else if constexpr (SCENARIO_NUM == 1) {
        copy(dst, src);
    } else {
        copy(dst, src, make_coord(16, 0), make_coord(0, 0), make_shape(16, 32));
    }
}

template <typename Atom, typename Dst, typename Src>
__aicore__ inline void tested_bias_copy(const Atom& atom, const Dst& dst, const Src& src)
{
    using namespace asc::te;
    if constexpr (SCENARIO_NUM == 0) {
        copy(atom, dst, src, make_coord(0, 16), make_coord(0, 8), make_shape(1, 16));
    } else if constexpr (SCENARIO_NUM == 1) {
        copy(dst, src);
    } else {
        copy(dst, src, make_coord(0, 16), make_coord(0, 8), make_shape(1, 16));
    }
}

__global__ __mix__(1, 1) void copy_interface_cube_load(__gm__ half* matrix_src,
                                                       __gm__ half* matrix_initial,
                                                       __gm__ half* identity,
                                                       __gm__ half* zero,
                                                       __gm__ float* bias_src,
                                                       __gm__ float* bias_initial,
                                                       __gm__ uint8_t* output)
{
    using namespace asc::te;
    __cbuf__ half l1_src_buf[MATRIX_ELEMENTS];
    __cbuf__ half l1_initial_buf[MATRIX_ELEMENTS];
    __cbuf__ half l1_aux_buf[MATRIX_ELEMENTS];
    __cbuf__ float l1_bias_src_buf[DIM];
    __cbuf__ float l1_bias_initial_buf[DIM];
    __ubuf__ half ub_buf[MATRIX_ELEMENTS];
    __ca__ half l0a_buf[MATRIX_ELEMENTS];
    __cb__ half l0b_buf[MATRIX_ELEMENTS];
    __biasbuf__ float bt_buf[DIM];
    __cc__ float l0c_buf[MATRIX_ELEMENTS];

    auto nd_half = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<half>>(DIM, DIM);
    auto nz_half = make_frame_layout<nz_layout_ptn, layout_trait_default<half>>(DIM, DIM);
    auto zn_half = make_frame_layout<zn_layout_ptn, layout_trait_default<half>>(DIM, DIM);
    auto nd_float = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<float>>(DIM, DIM);
    auto bias_layout = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<float>>(1, DIM);
    auto gm_src = make_tensor(make_mem_ptr(matrix_src), nd_half);
    auto gm_initial = make_tensor(make_mem_ptr(matrix_initial), nd_half);
    auto gm_identity = make_tensor(make_mem_ptr(identity), nd_half);
    auto gm_zero = make_tensor(make_mem_ptr(zero), nd_half);
    auto gm_bias_src = make_tensor(make_mem_ptr(bias_src), bias_layout);
    auto gm_bias_initial = make_tensor(make_mem_ptr(bias_initial), bias_layout);
    auto gm_out_half_nd = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ half*>(output)), nd_half);
    auto gm_out_half_nz = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ half*>(output)), nz_half);
    auto gm_out_float = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ float*>(output)), nd_float);

    auto gm2l1 = make_copy(copy_gm_to_l1{}, copy_gm_to_l1_trait_default{});
    auto l12ub = make_copy(copy_l1_to_ub{}, copy_l1_to_ub_trait_default{});
    auto ub2gm = make_copy(copy_ub_to_gm{}, copy_ub_to_gm_trait_default{});
    auto l12a = make_copy(copy_l1_to_l0a{}, copy_l1_to_l0a_trait_default{});
    auto l12b = make_copy(copy_l1_to_l0b{}, copy_l1_to_l0b_trait_default{});
    auto l12bt = make_copy(copy_l1_to_biastable{}, copy_l1_to_biastable_trait_default{});
    auto l0c2gm = make_copy(copy_l0c_to_gm{}, copy_l0c_to_gm_trait_default{});
    auto mma = make_mmad(mmad_operation{}, mmad_trait_default{});

    if ASCEND_IS_AIC {
        if constexpr (COPY_ROUTE == 0) {
            auto l1_target = make_tensor(make_mem_ptr(l1_src_buf), nz_half);
            auto ub = make_tensor(make_mem_ptr(ub_buf), nz_half);
            copy(gm2l1, l1_target, gm_initial);
            AscendC::PipeBarrier<PIPE_ALL>();
            tested_matrix_copy(gm2l1, l1_target, gm_src);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l12ub, ub, l1_target);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc_sync_block_arrive(PIPE_MTE1, 0x8);
            asc_sync_block_wait(PIPE_S, 0x9);
        } else if constexpr (COPY_ROUTE == 1) {
            auto l1_src = make_tensor(make_mem_ptr(l1_src_buf), nd_half);
            auto l1_initial = make_tensor(make_mem_ptr(l1_initial_buf), nd_half);
            auto ub = make_tensor(make_mem_ptr(ub_buf), nd_half);
            copy(gm2l1, l1_src, gm_src);
            copy(gm2l1, l1_initial, gm_initial);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l12ub, ub, l1_initial);
            tested_matrix_copy(l12ub, ub, l1_src);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc_sync_block_arrive(PIPE_MTE1, 0x8);
            asc_sync_block_wait(PIPE_S, 0x9);
        } else if constexpr (COPY_ROUTE == 2) {
            auto l1a = make_tensor(make_mem_ptr(l1_src_buf), nz_half);
            auto l1b = make_tensor(make_mem_ptr(l1_aux_buf), zn_half);
            auto l1_bias_src = make_tensor(make_mem_ptr(l1_bias_src_buf), bias_layout);
            auto l1_bias_initial = make_tensor(make_mem_ptr(l1_bias_initial_buf), bias_layout);
            auto l0a = make_tensor(make_mem_ptr(l0a_buf), nz_half);
            auto l0b = make_tensor(make_mem_ptr(l0b_buf), zn_half);
            auto bt = make_tensor(make_mem_ptr(bt_buf), bias_layout);
            auto l0c = make_tensor(make_mem_ptr(l0c_buf), nz_half);
            copy(gm2l1, l1a, gm_zero);
            copy(gm2l1, l1b, gm_zero);
            copy(gm2l1, l1_bias_src, gm_bias_src);
            copy(gm2l1, l1_bias_initial, gm_bias_initial);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l12a, l0a, l1a);
            copy(l12b, l0b, l1b);
            copy(l12bt, bt, l1_bias_initial);
            tested_bias_copy(l12bt, bt, l1_bias_src);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc::te::mmad(mma.with(mmad_params{DIM, DIM, DIM, 0, true}), l0c, l0a, l0b, bt);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l0c2gm, gm_out_float, l0c, make_coord(0, 0), make_coord(0, 0), make_shape(DIM, DIM));
        } else if constexpr (COPY_ROUTE == 3) {
            auto nz_matrix = make_frame_layout<nz_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto nd_matrix = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto zn_probe = make_frame_layout<zn_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto dn_probe = make_frame_layout<dn_ext_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto nz_out = make_frame_layout<nz_layout_ptn, layout_trait_default<float>>(DIM, DIM);
            auto nd_out = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<float>>(DIM, DIM);
            auto l1_src = make_tensor(make_mem_ptr(l1_src_buf), nz_matrix);
            auto l1_initial = make_tensor(make_mem_ptr(l1_initial_buf), nz_matrix);
            auto l1_probe = make_tensor(make_mem_ptr(l1_aux_buf), zn_probe);
            auto l0a = make_tensor(make_mem_ptr(l0a_buf), nz_matrix);
            auto l0b = make_tensor(make_mem_ptr(l0b_buf), zn_probe);
            auto l0c = make_tensor(make_mem_ptr(l0c_buf), nz_out);
            auto gm_probe = make_tensor(make_mem_ptr(identity), dn_probe);
            auto gm_src_matrix = make_tensor(make_mem_ptr(matrix_src), nd_matrix);
            auto gm_initial_matrix = make_tensor(make_mem_ptr(matrix_initial), nd_matrix);
            auto gm_out = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ float*>(output)), nd_out);
            copy(gm2l1, l1_src, gm_src_matrix);
            copy(gm2l1, l1_initial, gm_initial_matrix);
            copy(gm2l1, l1_probe, gm_probe);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l12a, l0a, l1_initial);
            AscendC::PipeBarrier<PIPE_ALL>();
            tested_matrix_copy(l12a, l0a, l1_src);
            copy(l12b, l0b, l1_probe);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc::te::mmad(mma.with(mmad_params{DIM, DIM, DIM, 0, true}), l0c, l0a, l0b);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l0c2gm, gm_out, l0c, make_coord(0, 0), make_coord(0, 0), make_shape(DIM, DIM));
        } else {
            auto zn_matrix = make_frame_layout<zn_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto dn_matrix = make_frame_layout<dn_ext_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto nz_probe = make_frame_layout<nz_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto nd_probe = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<half>>(DIM, DIM);
            auto nz_out = make_frame_layout<nz_layout_ptn, layout_trait_default<float>>(DIM, DIM);
            auto nd_out = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<float>>(DIM, DIM);
            auto l1_src = make_tensor(make_mem_ptr(l1_src_buf), zn_matrix);
            auto l1_initial = make_tensor(make_mem_ptr(l1_initial_buf), zn_matrix);
            auto l1_probe = make_tensor(make_mem_ptr(l1_aux_buf), nz_probe);
            auto l0a = make_tensor(make_mem_ptr(l0a_buf), nz_probe);
            auto l0b = make_tensor(make_mem_ptr(l0b_buf), zn_matrix);
            auto l0c = make_tensor(make_mem_ptr(l0c_buf), nz_out);
            auto gm_probe = make_tensor(make_mem_ptr(identity), nd_probe);
            auto gm_src_matrix = make_tensor(make_mem_ptr(matrix_src), dn_matrix);
            auto gm_initial_matrix = make_tensor(make_mem_ptr(matrix_initial), dn_matrix);
            auto gm_out = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ float*>(output)), nd_out);
            copy(gm2l1, l1_src, gm_src_matrix);
            copy(gm2l1, l1_initial, gm_initial_matrix);
            copy(gm2l1, l1_probe, gm_probe);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l12b, l0b, l1_initial);
            AscendC::PipeBarrier<PIPE_ALL>();
            tested_matrix_copy(l12b, l0b, l1_src);
            copy(l12a, l0a, l1_probe);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc::te::mmad(mma.with(mmad_params{DIM, DIM, DIM, 0, true}), l0c, l0a, l0b);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l0c2gm, gm_out, l0c, make_coord(0, 0), make_coord(0, 0), make_shape(DIM, DIM));
        }
    }

    if ASCEND_IS_AIV {
        if constexpr (COPY_ROUTE <= 1) {
            asc_sync_block_wait(PIPE_S, 0x8);
            asc_sync_block_arrive(PIPE_MTE3, 0x9);
            if constexpr (COPY_ROUTE == 0) {
                auto ub = make_tensor(make_mem_ptr(ub_buf), nz_half);
                copy(ub2gm, gm_out_half_nz, ub);
            } else {
                auto ub = make_tensor(make_mem_ptr(ub_buf), nd_half);
                copy(ub2gm, gm_out_half_nd, ub);
            }
        }
    }
}

int32_t main()
{
    constexpr size_t matrix_bytes = MATRIX_ELEMENTS * sizeof(half);
    constexpr size_t bias_bytes = DIM * sizeof(float);
    constexpr size_t output_bytes = MATRIX_ELEMENTS * sizeof(float);
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t *src_h, *initial_h, *identity_h, *zero_h, *bias_src_h, *bias_initial_h, *out_h;
    half *src_d, *initial_d, *identity_d, *zero_d;
    float *bias_src_d, *bias_initial_d;
    uint8_t* out_d;
    aclrtMallocHost(reinterpret_cast<void**>(&src_h), matrix_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&initial_h), matrix_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&identity_h), matrix_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&zero_h), matrix_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&bias_src_h), bias_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&bias_initial_h), bias_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&out_h), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src_d), matrix_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&initial_d), matrix_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&identity_d), matrix_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&zero_d), matrix_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bias_src_d), bias_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bias_initial_d), bias_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&out_d), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    const char* src_file = COPY_ROUTE == 3 ? "./input/matrix_a_src.bin" :
        (COPY_ROUTE == 4 ? "./input/matrix_b_src.bin" : "./input/matrix_src.bin");
    const char* initial_file = COPY_ROUTE == 3 ? "./input/matrix_a_initial.bin" :
        (COPY_ROUTE == 4 ? "./input/matrix_b_initial.bin" : "./input/matrix_initial.bin");
    if (!read_file(src_file, src_h, matrix_bytes) ||
        !read_file(initial_file, initial_h, matrix_bytes) ||
        !read_file("./input/identity.bin", identity_h, matrix_bytes) ||
        !read_file("./input/zero.bin", zero_h, matrix_bytes) ||
        !read_file("./input/bias_src.bin", bias_src_h, bias_bytes) ||
        !read_file("./input/bias_initial.bin", bias_initial_h, bias_bytes)) return 1;
    aclrtMemcpy(src_d, matrix_bytes, src_h, matrix_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(initial_d, matrix_bytes, initial_h, matrix_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(identity_d, matrix_bytes, identity_h, matrix_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(zero_d, matrix_bytes, zero_h, matrix_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_src_d, bias_bytes, bias_src_h, bias_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_initial_d, bias_bytes, bias_initial_h, bias_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(out_d, output_bytes, 0, output_bytes);
    copy_interface_cube_load<<<1, nullptr, stream>>>(src_d, initial_d, identity_d, zero_d,
                                                     bias_src_d, bias_initial_d, out_d);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(out_h, output_bytes, out_d, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    constexpr size_t written_bytes = COPY_ROUTE <= 1 ? matrix_bytes : output_bytes;
    write_file("./output/output.bin", out_h, written_bytes);
    aclrtFree(src_d); aclrtFree(initial_d); aclrtFree(identity_d); aclrtFree(zero_d);
    aclrtFree(bias_src_d); aclrtFree(bias_initial_d); aclrtFree(out_d);
    aclrtFreeHost(src_h); aclrtFreeHost(initial_h); aclrtFreeHost(identity_h); aclrtFreeHost(zero_h);
    aclrtFreeHost(bias_src_h); aclrtFreeHost(bias_initial_h); aclrtFreeHost(out_h);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
