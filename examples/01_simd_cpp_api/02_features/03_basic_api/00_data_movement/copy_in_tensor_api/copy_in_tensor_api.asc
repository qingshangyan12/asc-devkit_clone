/* !
 * \file copy_in_tensor_api.asc
 * \brief copy_in_tensor_api
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t singleCoreK;
};

struct CoreIterInfo {
    uint32_t mIter;
    uint32_t mIterIdx;
    uint32_t nIterIdx;
    int32_t actualSingleCoreM;
    int32_t actualSingleCoreN;
};

// Copy tiling information from GM to a local struct
__aicore__ inline void CopyTilingFromGM(__gm__ MatmulTiling* srcInfo, MatmulTiling& dstInfo)
{
    auto srcPtr = reinterpret_cast<__gm__ int32_t*>(srcInfo);
    auto dstPtr = reinterpret_cast<int32_t*>(&dstInfo);
    for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
        dstPtr[i] = srcPtr[i];
    }
}

// Calculate iteration information for the current core from tiling parameters and the core index
__aicore__ inline CoreIterInfo CalcCoreIterInfo(const MatmulTiling& tiling)
{
    uint32_t mIter = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    uint32_t mIterIdx = AscendC::GetBlockIdx() % mIter;
    uint32_t nIterIdx = AscendC::GetBlockIdx() / mIter;
    int32_t actualSingleCoreM = tiling.m - mIterIdx * tiling.singleCoreM;
    actualSingleCoreM = actualSingleCoreM < tiling.singleCoreM ? actualSingleCoreM : tiling.singleCoreM;
    int32_t actualSingleCoreN = tiling.n - nIterIdx * tiling.singleCoreN;
    actualSingleCoreN = actualSingleCoreN < tiling.singleCoreN ? actualSingleCoreN : tiling.singleCoreN;
    return {mIter, mIterIdx, nIterIdx, actualSingleCoreM, actualSingleCoreN};
}

template <typename A_TYPE, typename B_TYPE, typename C_TYPE,
          int32_t baseM, int32_t baseN, int32_t baseK, int32_t stepM, int32_t stepN, int32_t stepK>
__cube__ __global__ void copy_in_tensor_api(__gm__ A_TYPE* x, __gm__ B_TYPE* y, __gm__ C_TYPE* z,
                                                  __gm__ MatmulTiling* tilingInfo)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // 1. Copy tiling information from GM
    MatmulTiling tiling;
    CopyTilingFromGM(tilingInfo, tiling);

    // 2. Fixed layout for scenario 0: A non-transposed (GM ND -> L1 NZ), B non-transposed (GM ND -> L1 ZN).
    using AGmLayout = NDExtLayoutPtn;
    using AL1Layout = NZLayoutPtn;
    using BGmLayout = NDExtLayoutPtn;
    using BL1Layout = ZNLayoutPtn;

    // 3. Calculate iteration information for the current core
    CoreIterInfo iterInfo = CalcCoreIterInfo(tiling);

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t singleCoreM = tiling.singleCoreM;
    int32_t singleCoreN = tiling.singleCoreN;
    int32_t singleCoreK = tiling.singleCoreK;

    // 4. Create GM tensors and slices
    auto gmPtrA = MakeMemPtr(x);
    auto gmPtrB = MakeMemPtr(y);
    auto gmPtrC = MakeMemPtr(z);

    auto gmA = MakeTensor(gmPtrA, MakeFrameLayout<AGmLayout>(m, k));
    auto gmB = MakeTensor(gmPtrB, MakeFrameLayout<BGmLayout>(k, n));
    auto gmC = MakeTensor(gmPtrC, MakeFrameLayout<NDExtLayoutPtn>(m, n));

    // Slice the current single-core data block from the complete GM tensors.
    auto globalA = gmA.Slice(MakeCoord(iterInfo.mIterIdx * singleCoreM, 0),
                             MakeShape(iterInfo.actualSingleCoreM, singleCoreK));
    auto globalB = gmB.Slice(MakeCoord(0, iterInfo.nIterIdx * singleCoreN),
                             MakeShape(singleCoreK, iterInfo.actualSingleCoreN));
    auto globalC = gmC.Slice(MakeCoord(iterInfo.mIterIdx * singleCoreM, iterInfo.nIterIdx * singleCoreN),
                             MakeShape(iterInfo.actualSingleCoreM, iterInfo.actualSingleCoreN));

    // 5. Create L1/L0 tensors (Ping/Pong double buffer for A/B; L0C single buffer).
    auto l1ALayout = MakeFrameLayout<AL1Layout, A_TYPE>(baseM * stepM, baseK * stepK);
    auto l1BLayout = MakeFrameLayout<BL1Layout, B_TYPE>(baseK * stepK, baseN * stepN);

    __cbuf__ A_TYPE l1ABufPing[baseM * stepM * baseK * stepK];
    __cbuf__ A_TYPE l1ABufPong[baseM * stepM * baseK * stepK];
    __cbuf__ B_TYPE l1BBufPing[baseK * stepK * baseN * stepN];
    __cbuf__ B_TYPE l1BBufPong[baseK * stepK * baseN * stepN];
    __ca__ A_TYPE l0ABufPing[baseM * baseK];
    __ca__ A_TYPE l0ABufPong[baseM * baseK];
    __cb__ B_TYPE l0BBufPing[baseK * baseN];
    __cb__ B_TYPE l0BBufPong[baseK * baseN];
    __cc__ C_TYPE l0CBuf[baseM * baseN];

    auto l0APtrPing = MakeMemPtr(l0ABufPing);
    auto l0APtrPong = MakeMemPtr(l0ABufPong);
    auto l0BPtrPing = MakeMemPtr(l0BBufPing);
    auto l0BPtrPong = MakeMemPtr(l0BBufPong);
    auto l0CPtr = MakeMemPtr(l0CBuf);

    auto l1ATensorPing = MakeTensor(MakeMemPtr(l1ABufPing), l1ALayout);
    auto l1ATensorPong = MakeTensor(MakeMemPtr(l1ABufPong), l1ALayout);
    auto l1BTensorPing = MakeTensor(MakeMemPtr(l1BBufPing), l1BLayout);
    auto l1BTensorPong = MakeTensor(MakeMemPtr(l1BBufPong), l1BLayout);
    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    // Event-id helpers for A/B double buffering.
    auto dataEventId = [](uint32_t idx) { return (idx == 0) ? EVENT_ID0 : EVENT_ID1; };
    auto l0EventId = [](uint32_t idx) { return (idx == 0) ? EVENT_ID0 : EVENT_ID1; };

    // 6. Calculate loop counts
    uint32_t mLoop = (iterInfo.actualSingleCoreM + baseM - 1) / baseM;
    uint32_t nLoop = (iterInfo.actualSingleCoreN + baseN - 1) / baseN;
    uint32_t kLoop = (singleCoreK + baseK - 1) / baseK;
    uint32_t tileM = (iterInfo.actualSingleCoreM % baseM != 0) ? iterInfo.actualSingleCoreM % baseM : baseM;
    uint32_t tileN = (iterInfo.actualSingleCoreN % baseN != 0) ? iterInfo.actualSingleCoreN % baseN : baseN;
    uint32_t tileK = (singleCoreK % baseK != 0) ? singleCoreK % baseK : baseK;

    // A/B L1 chunk holds stepK baseK blocks; one chunk is one GM->L1 DataCopyIn unit.
    const uint32_t dataChunkStep = stepK;

    // Reverse-sync preset (avoid deadlock on the first WaitFlag):
    //   MTE1_MTE2 ID0/1 -> A/B L1 Ping/Pong writable; M_MTE1 ID0/1 -> A/B L0 Ping/Pong writable.
    //   FIX_M ID0 -> L0C writable before the first L0C->GM.
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);

    uint8_t mte1DBFlag = 0; // L0 double-buffer selector (0=Ping, 1=Pong).

    // 7. Main compute loop (M/N outer + K main loop with L1/L0 double buffering).
    for (uint32_t i = 0; i < mLoop; i++) {
        uint16_t curM = (i + 1 == mLoop) ? tileM : baseM;
        for (uint32_t j = 0; j < nLoop; j++) {
            uint16_t curN = (j + 1 == nLoop) ? tileN : baseN;
            auto l0CLayout = MakeFrameLayout<NZLayoutPtn>(curM, curN);
            auto l0CTensor = MakeTensor(l0CPtr, l0CLayout);

            // DataCopyIn progress for this (i, j) tile.
            uint32_t dataNextKChunkIdx = 0; // K-block index for the next A/B DataCopyIn.
            uint8_t dataCopyInIdx = 0;      // L1 buffer to write next (0=Ping, 1=Pong).

            // ---- Copy in the first A/B chunk ----
            {
                int32_t dataWriteEvent = dataEventId(dataCopyInIdx);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(dataWriteEvent);
                Copy(copyGM2L1Atom, l1ATensorPing, globalA.Slice(
                    MakeCoord(i * baseM, dataNextKChunkIdx * baseK), MakeShape(baseM, baseK * stepK)));
                Copy(copyGM2L1Atom, l1BTensorPing, globalB.Slice(
                    MakeCoord(dataNextKChunkIdx * baseK, j * baseN), MakeShape(baseK * stepK, baseN)));
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(dataWriteEvent);
                dataNextKChunkIdx += dataChunkStep;
                dataCopyInIdx ^= 1;
            }

            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                uint16_t curK = (kIter + 1 == kLoop) ? tileK : baseK;
                // L1 read buffer (Ping/Pong) and offset inside the chunk for this kIter.
                uint32_t dataReadIdx = (kIter / dataChunkStep) % 2;
                uint32_t kOffsetInChunk = kIter % dataChunkStep;

                const auto& l1ReadBufA = (dataReadIdx == 0) ? l1ATensorPing : l1ATensorPong;
                const auto& l1ReadBufB = (dataReadIdx == 0) ? l1BTensorPing : l1BTensorPong;

                // L0 double buffer for this kIter.
                auto l0ALayout = MakeFrameLayout<NZLayoutPtn, A_TYPE>(curM, curK);
                auto l0BLayout = MakeFrameLayout<ZNLayoutPtn, B_TYPE>(curK, curN);
                auto l0ATensorPing = MakeTensor(l0APtrPing, l0ALayout);
                auto l0ATensorPong = MakeTensor(l0APtrPong, l0ALayout);
                auto l0BTensorPing = MakeTensor(l0BPtrPing, l0BLayout);
                auto l0BTensorPong = MakeTensor(l0BPtrPong, l0BLayout);
                const auto& l0ATensor = (mte1DBFlag == 0) ? l0ATensorPing : l0ATensorPong;
                const auto& l0BTensor = (mte1DBFlag == 0) ? l0BTensorPing : l0BTensorPong;

                // ---- Reverse sync: wait until the previous Compute released this L0 buffer ----
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0EventId(mte1DBFlag));
                // ---- Forward sync: wait for the L1 chunk data (only the first block of a chunk waits) ----
                if (kOffsetInChunk == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(dataEventId(dataReadIdx));
                }

                // ---- DataLoad: L1 -> L0 ----
                Copy(copyL12L0AAtom, l0ATensor, l1ReadBufA.Slice(
                    MakeCoord(0, kOffsetInChunk * baseK), MakeShape(curM, curK)));
                Copy(copyL12L0BAtom, l0BTensor, l1ReadBufB.Slice(
                    MakeCoord(kOffsetInChunk * baseK, 0), MakeShape(curK, curN)));

                // ---- Reverse sync: this L1 chunk consumed; notify DataCopyIn it can be overwritten ----
                if (((kOffsetInChunk + 1) == dataChunkStep) || (kIter + 1 == kLoop)) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(dataEventId(dataReadIdx));
                }

                int32_t l0Event = l0EventId(mte1DBFlag);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0Event);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0Event);

                if (kIter == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                }

                // ---- Compute: Mmad (accumulate over K; first K block initializes L0C) ----
                Mmad(mmadAtom.with(MmadParams{curM, curN, curK, 0, kIter == 0}),
                     l0CTensor, l0ATensor, l0BTensor);
                if (kIter == kLoop - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0Event);
                mte1DBFlag ^= 1;

                // ---- Copy in the next L1 chunk so DataCopyIn overlaps with Compute ----
                if (((kIter == 0) || ((kOffsetInChunk + 1) == dataChunkStep)) &&
                    dataNextKChunkIdx < kLoop) {
                    const auto& l1WriteBufA = (dataCopyInIdx == 0) ? l1ATensorPing : l1ATensorPong;
                    const auto& l1WriteBufB = (dataCopyInIdx == 0) ? l1BTensorPing : l1BTensorPong;
                    int32_t dataWriteEvent = dataEventId(dataCopyInIdx);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(dataWriteEvent);
                    Copy(copyGM2L1Atom, l1WriteBufA, globalA.Slice(
                        MakeCoord(i * baseM, dataNextKChunkIdx * baseK), MakeShape(baseM, baseK * stepK)));
                    Copy(copyGM2L1Atom, l1WriteBufB, globalB.Slice(
                        MakeCoord(dataNextKChunkIdx * baseK, j * baseN), MakeShape(baseK * stepK, baseN)));
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(dataWriteEvent);
                    dataNextKChunkIdx += dataChunkStep;
                    dataCopyInIdx ^= 1;
                }
            }

            // L0C -> GM
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            Copy(copyL0C2GMAtom, globalC.Slice(
                MakeCoord(i * baseM, j * baseN), MakeShape(curM, curN)), l0CTensor);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        }
    }

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    // Scenario 0: A/B half, C float.
    using A_TYPE = half;
    using B_TYPE = half;
    using C_TYPE = float;

    // Tiling info filled into struct (dynamic at runtime)
    MatmulTiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.singleCoreM = 256;
    tiling.singleCoreN = 128;
    tiling.singleCoreK = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t BASE_M = 128;
    constexpr int32_t BASE_N = 128;
    constexpr int32_t BASE_K = 64;
    constexpr int32_t STEP_M = 1;
    constexpr int32_t STEP_N = 1;
    constexpr int32_t STEP_K = 4;

    constexpr uint32_t NUM_BLOCKS = 32;

    size_t param1FileSize = tiling.m * tiling.k * sizeof(A_TYPE);
    size_t param2FileSize = tiling.n * tiling.k * sizeof(B_TYPE);
    size_t param3FileSize = tiling.m * tiling.n * sizeof(C_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost;
    A_TYPE *xDevice;
    B_TYPE *yDevice;
    C_TYPE *zDevice;

    aclrtMallocHost((void**)(&xHost), param1FileSize);
    aclrtMallocHost((void**)(&yHost), param2FileSize);
    aclrtMallocHost((void**)(&zHost), param3FileSize);
    aclrtMalloc((void**)&xDevice, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1FileSize, xHost, param1FileSize);
    ReadFile("./input/input_y.bin", param2FileSize, yHost, param2FileSize);

    aclrtMemcpy(xDevice, param1FileSize, xHost, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, param2FileSize, yHost, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    MatmulTiling *tilingHost;
    MatmulTiling *tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tilingDevice, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tilingHost = tiling;
    aclrtMemcpy(tilingDevice, sizeof(MatmulTiling), tilingHost, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    copy_in_tensor_api<A_TYPE, B_TYPE, C_TYPE,
                              BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K>
        <<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, param3FileSize, zDevice, param3FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, param3FileSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
