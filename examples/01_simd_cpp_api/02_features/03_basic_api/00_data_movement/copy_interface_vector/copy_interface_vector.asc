#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

constexpr uint32_t ROWS = 32;
constexpr uint32_t COLS = 64;
constexpr uint32_t PROBE_COLS = COLS;
constexpr uint32_t ELEMENTS = ROWS * COLS;

template <typename Atom, typename Dst, typename Src>
__aicore__ inline void tested_copy(const Atom& atom, const Dst& dst, const Src& src)
{
    using namespace asc::te;
    if constexpr (COPY_ROUTE == 2 && SCENARIO_NUM == 0) {
        copy(atom, dst, src, make_coord(0, 32), make_coord(0, 0), make_shape(32, 32));
    } else if constexpr (COPY_ROUTE == 2 && SCENARIO_NUM == 2) {
        copy(dst, src, make_coord(16, 0), make_coord(0, 0), make_shape(16, 64));
    } else if constexpr (SCENARIO_NUM == 0) {
        copy(atom, dst, src, make_coord(8, 0), make_coord(4, 0), make_shape(8, 32));
    } else if constexpr (SCENARIO_NUM == 1) {
        copy(dst, src);
    } else {
        copy(dst, src, make_coord(8, 0), make_coord(4, 0), make_shape(8, 32));
    }
}

__global__ __mix__(1,1) void copy_interface_vector(__gm__ int8_t* input, __gm__ int8_t* initial,
                                                   __gm__ int8_t* probe, __gm__ uint8_t* output)
{
    using namespace asc::te;
    __ubuf__ int8_t ub_src_buf[ELEMENTS];
    __ubuf__ int8_t ub_dst_buf[ELEMENTS];
    __cbuf__ int8_t l1_buf[ELEMENTS];
    __cbuf__ int8_t l1_probe_buf[COLS * PROBE_COLS];
    __ca__ int8_t l0a_buf[ELEMENTS];
    __cb__ int8_t l0b_buf[COLS * PROBE_COLS];
    __cc__ int32_t l0c_buf[ROWS * PROBE_COLS];

    auto nd = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int8_t>>(ROWS, COLS);
    auto gm_input = make_tensor(make_mem_ptr(input), nd);
    auto gm_initial = make_tensor(make_mem_ptr(initial), nd);
    auto gm_output = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ int8_t*>(output)), nd);
    auto ub_src = make_tensor(make_mem_ptr(ub_src_buf), nd);
    auto ub_dst = make_tensor(make_mem_ptr(ub_dst_buf), nd);
    auto l1_dst = make_tensor(make_mem_ptr(l1_buf), nd);
    auto gm2ub = make_copy(copy_gm_to_ub{}, copy_gm_to_ub_trait_default{});
    auto ub2gm = make_copy(copy_ub_to_gm{}, copy_ub_to_gm_trait_default{});
    auto ub2l1 = make_copy(copy_ub_to_l1{}, copy_ub_to_l1_trait_default{});
    auto ub2ub = make_copy(copy_ub_to_ub{}, copy_ub_to_ub_trait_default{});
    auto gm2l1 = make_copy(copy_gm_to_l1{}, copy_gm_to_l1_trait_default{});
    auto l12a = make_copy(copy_l1_to_l0a{}, copy_l1_to_l0a_trait_default{});
    auto l12b = make_copy(copy_l1_to_l0b{}, copy_l1_to_l0b_trait_default{});
    auto c2gm = make_copy(copy_l0c_to_gm{}, copy_l0c_to_gm_trait_default{});
    auto mma = make_mmad(mmad_operation{}, mmad_trait_default{});

    if ASCEND_IS_AIV {
        if constexpr (COPY_ROUTE == 2) {
            auto nz = make_frame_layout<nz_layout_ptn, layout_trait_default<int8_t>>(ROWS, COLS);
            auto gm_input_nz = make_tensor(make_mem_ptr(input), nz);
            auto gm_initial_nz = make_tensor(make_mem_ptr(initial), nz);
            auto ub_src_nz = make_tensor(make_mem_ptr(ub_src_buf), nz);
            auto ub_dst_nz = make_tensor(make_mem_ptr(ub_dst_buf), nz);
            auto l1_dst_nz = make_tensor(make_mem_ptr(l1_buf), nz);
            copy(gm2ub, ub_src_nz, gm_input_nz);
            copy(gm2ub, ub_dst_nz, gm_initial_nz);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(ub2l1, l1_dst_nz, ub_dst_nz);
            AscendC::PipeBarrier<PIPE_ALL>();
            tested_copy(ub2l1, l1_dst_nz, ub_src_nz);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc_sync_block_arrive(PIPE_MTE3, 0x8);
            asc_sync_block_wait(PIPE_S, 0x9);
            return;
        }

        copy(gm2ub, ub_src, gm_input);
        copy(gm2ub, ub_dst, gm_initial);
        AscendC::PipeBarrier<PIPE_ALL>();
        if constexpr (COPY_ROUTE == 0) {
            tested_copy(gm2ub, ub_dst, gm_input);
        } else if constexpr (COPY_ROUTE == 1) {
            tested_copy(ub2gm, gm_output, ub_src);
            return;
        } else {
            tested_copy(ub2ub, ub_dst, ub_src);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        copy(ub2gm, gm_output, ub_dst);
    }

    if ASCEND_IS_AIC {
        if constexpr (COPY_ROUTE == 2) {
            asc_sync_block_wait(PIPE_S, 0x8);
            auto nz_a = make_frame_layout<nz_layout_ptn, layout_trait_default<int8_t>>(ROWS, COLS);
            auto zn_b = make_frame_layout<zn_layout_ptn, layout_trait_default<int8_t>>(COLS, PROBE_COLS);
            auto dn_b = make_frame_layout<dn_ext_layout_ptn, layout_trait_default<int8_t>>(COLS, PROBE_COLS);
            auto nz_c = make_frame_layout<nz_layout_ptn, layout_trait_default<int32_t>>(ROWS, PROBE_COLS);
            auto nd_c = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int32_t>>(ROWS, PROBE_COLS);
            auto l1_a = make_tensor(make_mem_ptr(l1_buf), nz_a);
            auto l1_b = make_tensor(make_mem_ptr(l1_probe_buf), zn_b);
            auto l0_a = make_tensor(make_mem_ptr(l0a_buf), nz_a);
            auto l0_b = make_tensor(make_mem_ptr(l0b_buf), zn_b);
            auto l0_c = make_tensor(make_mem_ptr(l0c_buf), nz_c);
            auto gm_probe = make_tensor(make_mem_ptr(probe), dn_b);
            auto gm_output_i32 = make_tensor(make_mem_ptr(reinterpret_cast<__gm__ int32_t*>(output)), nd_c);
            copy(gm2l1, l1_b, gm_probe);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(l12a, l0_a, l1_a);
            copy(l12b, l0_b, l1_b);
            AscendC::PipeBarrier<PIPE_ALL>();
            asc_sync_block_arrive(PIPE_MTE1, 0x9);
            asc::te::mmad(mma.with(mmad_params{ROWS, PROBE_COLS, COLS, 0, true}), l0_c, l0_a, l0_b);
            AscendC::PipeBarrier<PIPE_ALL>();
            copy(c2gm, gm_output_i32, l0_c, make_coord(0, 0), make_coord(0, 0),
                 make_shape(ROWS, PROBE_COLS));
        }
    }
}

int32_t main()
{
    constexpr size_t bytes = ELEMENTS * sizeof(int8_t);
    constexpr size_t probe_bytes = COLS * PROBE_COLS * sizeof(int8_t);
    constexpr size_t output_bytes = COPY_ROUTE == 2 ? ROWS * PROBE_COLS * sizeof(int32_t) : bytes;
    aclInit(nullptr); aclrtSetDevice(0); aclrtStream stream = nullptr; aclrtCreateStream(&stream);
    int8_t *input_host, *initial_host, *probe_host, *input_device, *initial_device, *probe_device;
    uint8_t *output_host, *output_device;
    aclrtMallocHost(reinterpret_cast<void**>(&input_host), bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&initial_host), bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&probe_host), probe_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&initial_device), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&probe_device), probe_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    const char* input_file = COPY_ROUTE == 2 ? "./input/input_nz.bin" : "./input/input.bin";
    const char* initial_file = COPY_ROUTE == 2 ? "./input/initial_nz.bin" : "./input/initial.bin";
    if (!read_file(input_file, input_host, bytes) || !read_file(initial_file, initial_host, bytes) ||
        !read_file("./input/probe.bin", probe_host, probe_bytes)) return 1;
    aclrtMemcpy(input_device, bytes, input_host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(initial_device, bytes, initial_host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(probe_device, probe_bytes, probe_host, probe_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(output_device, output_bytes, 0, output_bytes);
    if constexpr (COPY_ROUTE != 2) aclrtMemcpy(output_device, bytes, initial_host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    copy_interface_vector<<<1, nullptr, stream>>>(input_device, initial_device, probe_device, output_device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", output_host, output_bytes);
    aclrtFree(input_device); aclrtFree(initial_device); aclrtFree(probe_device); aclrtFree(output_device);
    aclrtFreeHost(input_host); aclrtFreeHost(initial_host); aclrtFreeHost(probe_host); aclrtFreeHost(output_host);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize(); return 0;
}
