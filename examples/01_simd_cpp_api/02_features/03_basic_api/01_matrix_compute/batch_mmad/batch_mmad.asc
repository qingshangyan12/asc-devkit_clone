/* !
 * \file batch_mmad.asc
 * \brief 本样例介绍了带batch的矩阵乘法。
 */
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

template <class T, class U, class S, uint32_t B, uint32_t M, uint32_t K, uint32_t N>
class KernelMmad {
public:
    __aicore__ inline KernelMmad()
    {
        a1Addr = 0;
        b1Addr = a1Addr + aSizeAlignL1 * sizeof(U);
        c1Addr = b1Addr + bSizeAlignL1 * sizeof(U);
    }
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c)
    {
        aGM.SetGlobalBuffer((__gm__ U *)a);
        bGM.SetGlobalBuffer((__gm__ U *)b);
        cGM.SetGlobalBuffer((__gm__ T *)c);
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<U> a1Local(AscendC::TPosition::A1, a1Addr, aSizeAlignL1);
        AscendC::LocalTensor<U> b1Local(AscendC::TPosition::B1, b1Addr, bSizeAlignL1);
        AscendC::LocalTensor<S> c1Local(AscendC::TPosition::C1, c1Addr, cSizeAlignL0);

        AscendC::LocalTensor<U> a2Local(AscendC::TPosition::A2, 0, aSizeAlignL0);
        AscendC::LocalTensor<U> b2Local(AscendC::TPosition::B2, 0, bSizeAlignL0);
        AscendC::LocalTensor<T> co1Local(AscendC::TPosition::CO1, 0, cSizeAlignL0);

        CopyIn(a1Local, b1Local);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

        for (int32_t batchIndex = 0; batchIndex < B; batchIndex++) {
            SplitA(a1Local[batchIndex * aSizeAlignL0], a2Local);
            SplitBTranspose(b1Local[batchIndex * bSizeAlignL0], b2Local);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

            Compute(batchIndex, a2Local, b2Local, co1Local);
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        CopyOut(co1Local, c1Local);
    }

private:
    static constexpr uint32_t CeilDivision(uint32_t numerator, uint32_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }

    static constexpr uint32_t CeilAlign(uint32_t numerator, uint32_t denominator)
    {
        return CeilDivision(numerator, denominator) * denominator;
    }

    static constexpr uint16_t CUBE_SHAPE_M = 16;
    static constexpr uint16_t CUBE_SHAPE_K = 32 / sizeof(U);
    static constexpr uint16_t CUBE_SIZE = 16 * CUBE_SHAPE_K;

    static constexpr uint16_t aSizeAlignL0 = CeilAlign(M, CUBE_SHAPE_M) * CeilAlign(K, CUBE_SHAPE_K);
    static constexpr uint16_t aSizeAlignL1 = B * CeilAlign(M, CUBE_SHAPE_M) * CeilAlign(K, CUBE_SHAPE_K);
    static constexpr uint16_t bSizeAlignL0 = CeilAlign(K, CUBE_SHAPE_M) * CeilAlign(N, CUBE_SHAPE_K);
    static constexpr uint16_t bSizeAlignL1 = B * CeilAlign(K, CUBE_SHAPE_M) * CeilAlign(N, CUBE_SHAPE_K);
    static constexpr uint16_t cSizeAlignL0 = B * CeilAlign(M, CUBE_SHAPE_M) * CeilAlign(N, CUBE_SHAPE_M);

    __aicore__ inline void CopyIn(AscendC::LocalTensor<U>& a1Local, AscendC::LocalTensor<U>& b1Local)
    {
        AscendC::Nd2NzParams nd2nzA1Params;
        nd2nzA1Params.ndNum = B;
        nd2nzA1Params.nValue = M;
        nd2nzA1Params.dValue = K;
        nd2nzA1Params.srcNdMatrixStride = M * K;
        nd2nzA1Params.srcDValue = K;
        nd2nzA1Params.dstNzC0Stride = CeilAlign(M, CUBE_SHAPE_M);
        nd2nzA1Params.dstNzNStride = 1;
        nd2nzA1Params.dstNzMatrixStride = aSizeAlignL0;
        AscendC::DataCopy(a1Local, aGM, nd2nzA1Params);

        AscendC::Nd2NzParams nd2nzB1Params;
        nd2nzB1Params.ndNum = B;
        nd2nzB1Params.nValue = K;
        nd2nzB1Params.dValue = N;
        nd2nzB1Params.srcNdMatrixStride = K * N;
        nd2nzB1Params.srcDValue = N;
        nd2nzB1Params.dstNzC0Stride = CeilAlign(K, CUBE_SHAPE_M);
        nd2nzB1Params.dstNzNStride = 1;
        nd2nzB1Params.dstNzMatrixStride = bSizeAlignL0;
        AscendC::DataCopy(b1Local, bGM, nd2nzB1Params);
    }

    __aicore__ inline void SplitA(const AscendC::LocalTensor<U>& a1Local, AscendC::LocalTensor<U>& a2Local)
    {
        uint32_t dstOffset = CeilDivision(K, CUBE_SHAPE_K) * CUBE_SIZE;
        uint32_t srcOffset = CUBE_SIZE;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(K, CUBE_SHAPE_K);
        loadDataParams.srcStride = CeilDivision(M, CUBE_SHAPE_M);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        for (int i = 0; i < CeilDivision(M, CUBE_SHAPE_M); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = CeilDivision(M, CUBE_SHAPE_M);
        loadDataParams.kStep = CeilDivision(K, CUBE_SHAPE_K);
        loadDataParams.srcStride = CeilDivision(M, CUBE_SHAPE_M);
        loadDataParams.dstStride = CeilDivision(M, CUBE_SHAPE_M);
        loadDataParams.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local, loadDataParams);
#endif
    }

    __aicore__ inline void SplitBTranspose(const AscendC::LocalTensor<U>& b1Local, AscendC::LocalTensor<U>& b2Local)
    {
        AscendC::LoadData3DParamsV2<U> loadDataParams;
        loadDataParams.l1H = CeilAlign(K, CUBE_SHAPE_M);
        loadDataParams.l1W = 1;
        loadDataParams.channelSize = CeilAlign(N, CUBE_SHAPE_K);
        loadDataParams.kExtension = CeilAlign(N, CUBE_SHAPE_K);
        loadDataParams.mExtension = CeilAlign(K, CUBE_SHAPE_M);
        loadDataParams.strideW = 1;
        loadDataParams.strideH = 1;
        loadDataParams.filterW = 1;
        loadDataParams.filterH = 1;
        loadDataParams.dilationFilterW = 1;
        loadDataParams.dilationFilterH = 1;
        loadDataParams.filterSizeW = false;
        loadDataParams.filterSizeH = false;
        loadDataParams.enTranspose = true;
        loadDataParams.fMatrixCtrl = false;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::SetLoadDataRepeatWithStride({1, 1, 0, CeilDivision(N, CUBE_SHAPE_M)});
        AscendC::LoadDataWithStride(b2Local, b1Local, loadDataParams);
#else
        AscendC::LoadData(b2Local, b1Local, loadDataParams);
#endif
    }

    __aicore__ inline void Compute(int32_t batchIndex, AscendC::LocalTensor<U>& a2Local,
                                   AscendC::LocalTensor<U>& b2Local, AscendC::LocalTensor<T>& co1Local)
    {
        AscendC::MmadParams mmadParams;
        mmadParams.m = M;
        mmadParams.n = N;
        mmadParams.k = K;
        AscendC::Mmad(co1Local[batchIndex * CeilAlign(M, CUBE_SHAPE_M) * CeilAlign(N, CUBE_SHAPE_M)],
                      a2Local, b2Local, mmadParams);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<T>& co1Local, AscendC::LocalTensor<S>& c1Local)
    {
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = N;
        fixpipeParams.mSize = M;
        fixpipeParams.srcStride = CeilAlign(M, CUBE_SHAPE_M);
        fixpipeParams.dstStride = N;
        fixpipeParams.ndNum = B;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        fixpipeParams.srcNdStride = (CeilAlign(M, CUBE_SHAPE_M) * CeilAlign(N, CUBE_SHAPE_M))
                                    / (CUBE_SHAPE_M * CUBE_SHAPE_M);
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        fixpipeParams.srcNdStride = (CeilAlign(M, CUBE_SHAPE_M) * CeilAlign(N, CUBE_SHAPE_M))
                                    / CUBE_SHAPE_M;
#endif
        fixpipeParams.dstNdStride = M * N;
        AscendC::Fixpipe(cGM, co1Local, fixpipeParams);

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        fixpipeParams.quantPre = QuantMode_t::F322F16;
        fixpipeParams.nSize = CeilAlign(N, CUBE_SHAPE_M);
        AscendC::Fixpipe<S, T, AscendC::CFG_NZ>(c1Local, co1Local, fixpipeParams);
        AscendC::printf("C in L1 buffer:\n");
#ifndef ASCENDC_CPU_DEBUG
        AscendC::DumpTensor(c1Local, 1, 10);
#endif
#endif
    }

private:
    AscendC::GlobalTensor<U> aGM;
    AscendC::GlobalTensor<U> bGM;
    AscendC::GlobalTensor<T> cGM;

    uint64_t a1Addr, b1Addr, c1Addr;
};

template <uint32_t B, uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void batch_mmad_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::InitSocState();
    KernelMmad<float, float, half, B, M, K, N> op;                                                        
    op.Init(a, b, c);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t B = 4;
    constexpr uint32_t M = 30;
    constexpr uint32_t K = 40;
    constexpr uint32_t N = 70;

    size_t aFileSize = B * M * K * sizeof(float); 
    size_t bFileSize = B * K * N * sizeof(float); 
    size_t cFileSize = B * M * N * sizeof(float);

    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    batch_mmad_custom<B, M, K, N><<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}