/* !
 * \file copy_in_tensor_api.asc
 * \brief copy_in_tensor_api
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t singleCoreK;
};

struct CoreIterInfo {
    uint32_t mIter;
    uint32_t mIterIdx;
    uint32_t nIterIdx;
    int32_t actualSingleCoreM;
    int32_t actualSingleCoreN;
};

// Copy tiling information from GM to a local struct
__aicore__ inline void CopyTilingFromGM(__gm__ MatmulTiling* srcInfo, MatmulTiling& dstInfo)
{
    auto srcPtr = reinterpret_cast<__gm__ int32_t*>(srcInfo);
    auto dstPtr = reinterpret_cast<int32_t*>(&dstInfo);
    for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
        dstPtr[i] = srcPtr[i];
    }
}

// Calculate iteration information for the current core from tiling parameters and the core index
__aicore__ inline CoreIterInfo CalcCoreIterInfo(const MatmulTiling& tiling)
{
    uint32_t mIter = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    uint32_t mIterIdx = get_block_idx() % mIter;
    uint32_t nIterIdx = get_block_idx() / mIter;
    int32_t actualSingleCoreM = tiling.m - mIterIdx * tiling.singleCoreM;
    actualSingleCoreM = actualSingleCoreM < tiling.singleCoreM ? actualSingleCoreM : tiling.singleCoreM;
    int32_t actualSingleCoreN = tiling.n - nIterIdx * tiling.singleCoreN;
    actualSingleCoreN = actualSingleCoreN < tiling.singleCoreN ? actualSingleCoreN : tiling.singleCoreN;
    return {mIter, mIterIdx, nIterIdx, actualSingleCoreM, actualSingleCoreN};
}

template <typename A_TYPE, typename B_TYPE, typename C_TYPE, typename BIAS_TYPE,
          int32_t baseM, int32_t baseN, int32_t baseK, int32_t stepM, int32_t stepN, int32_t stepK>
__cube__ __global__ void dynamic_matmul_with_bias(__gm__ A_TYPE* x, __gm__ B_TYPE* y, __gm__ C_TYPE* z,
                                                  __gm__ BIAS_TYPE* bias, __gm__ MatmulTiling* tilingInfo)
{
    // 1. Copy tiling information from GM
    MatmulTiling tiling;
    CopyTilingFromGM(tilingInfo, tiling);

    // 2. Select layout and data types based on SCENARIO_NUM
    constexpr uint32_t scenarioNum = SCENARIO_NUM;
    using gmLayout = typename std::conditional_t<(scenarioNum < 2), AscendC::Te::NDExtLayoutPtn, AscendC::Te::DNExtLayoutPtn>;
    using l1Layout = typename std::conditional_t<(scenarioNum < 2), AscendC::Te::NZLayoutPtn, AscendC::Te::ZNLayoutPtn>;

    // 3. Calculate iteration information for the current core
    CoreIterInfo iterInfo = CalcCoreIterInfo(tiling);

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t singleCoreM = tiling.singleCoreM;
    int32_t singleCoreN = tiling.singleCoreN;
    int32_t singleCoreK = tiling.singleCoreK;

    // 4. Create GM tensors and slices
    auto gmPtrA = AscendC::Te::MakeMemPtr(x);
    auto gmPtrB = AscendC::Te::MakeMemPtr(y);
    auto gmPtrC = AscendC::Te::MakeMemPtr(z);
    auto gmPtrBias = AscendC::Te::MakeMemPtr(bias);

    auto gmA = AscendC::Te::MakeTensor(gmPtrA, AscendC::Te::MakeFrameLayout<gmLayout>(m, k));
    auto gmB = AscendC::Te::MakeTensor(gmPtrB, AscendC::Te::MakeFrameLayout<gmLayout>(k, n));
    auto gmC = AscendC::Te::MakeTensor(gmPtrC, AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(m, n));
    auto gmBias = AscendC::Te::MakeTensor(gmPtrBias, AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1, n));

    auto globalA = gmA.Slice(AscendC::Te::MakeCoord(iterInfo.mIterIdx * singleCoreM, 0),
                             AscendC::Te::MakeShape(iterInfo.actualSingleCoreM, singleCoreK));
    auto globalB = gmB.Slice(AscendC::Te::MakeCoord(0, iterInfo.nIterIdx * singleCoreN),
                             AscendC::Te::MakeShape(singleCoreK, iterInfo.actualSingleCoreN));
    auto globalC = gmC.Slice(AscendC::Te::MakeCoord(iterInfo.mIterIdx * singleCoreM, iterInfo.nIterIdx * singleCoreN),
                             AscendC::Te::MakeShape(iterInfo.actualSingleCoreM, iterInfo.actualSingleCoreN));
    auto globalBias = gmBias.Slice(AscendC::Te::MakeCoord(0, iterInfo.nIterIdx * singleCoreN),
                                   AscendC::Te::MakeShape(1, iterInfo.actualSingleCoreN));

    // 5. Create L1 tensors
    auto l1ALayout = AscendC::Te::MakeFrameLayout<l1Layout, AscendC::Te::LayoutTraitDefault<A_TYPE>>(baseM * stepM, baseK * stepK);
    auto l1BLayout = AscendC::Te::MakeFrameLayout<l1Layout, AscendC::Te::LayoutTraitDefault<B_TYPE>>(baseK * stepK, baseN * stepN);
    auto l1BiasLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1, baseN * stepN);

    __cbuf__ A_TYPE l1ABuf[baseM * stepM * baseK * stepK];
    __cbuf__ B_TYPE l1BBuf[baseK * stepK * baseN * stepN];
    __cbuf__ BIAS_TYPE l1BiasBuf[baseN * stepN];
    __ca__ A_TYPE l0ABuf[baseM * baseK];
    __cb__ B_TYPE l0BBuf[baseK * baseN];
    __biasbuf__ BIAS_TYPE l0BiasBuf[baseN];
    __cc__ C_TYPE l0CBuf[baseM * baseN];

    auto l1APtr = AscendC::Te::MakeMemPtr(l1ABuf);
    auto l1BPtr = AscendC::Te::MakeMemPtr(l1BBuf);
    auto l1BiasPtr = AscendC::Te::MakeMemPtr(l1BiasBuf);
    auto l0APtr = AscendC::Te::MakeMemPtr(l0ABuf);
    auto l0BPtr = AscendC::Te::MakeMemPtr(l0BBuf);
    auto l0BiasPtr = AscendC::Te::MakeMemPtr(l0BiasBuf);
    auto l0CPtr = AscendC::Te::MakeMemPtr(l0CBuf);

    auto l1ATensor = AscendC::Te::MakeTensor(l1APtr, l1ALayout);
    auto l1BTensor = AscendC::Te::MakeTensor(l1BPtr, l1BLayout);
    auto l1BiasTensor = AscendC::Te::MakeTensor(l1BiasPtr, l1BiasLayout);

    // 6. Calculate loop counts
    uint32_t mLoop = (iterInfo.actualSingleCoreM + baseM - 1) / baseM;
    uint32_t nLoop = (iterInfo.actualSingleCoreN + baseN - 1) / baseN;
    uint32_t kLoop = (singleCoreK + baseK - 1) / baseK;
    uint32_t tileM = (iterInfo.actualSingleCoreM % baseM != 0) ? iterInfo.actualSingleCoreM % baseM : baseM;
    uint32_t tileN = (iterInfo.actualSingleCoreN % baseN != 0) ? iterInfo.actualSingleCoreN % baseN : baseN;
    uint32_t tileK = (singleCoreK % baseK != 0) ? singleCoreK % baseK : baseK;

    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);

    // 7. Main compute loop
    for (uint32_t i = 0; i < mLoop; i++) {
        uint32_t curM = (i + 1 == mLoop) ? tileM : baseM;
        for (uint32_t j = 0; j < nLoop; j++) {
            uint32_t curN = (j + 1 == nLoop) ? tileN : baseN;
            auto l0CLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NZLayoutPtn>(curM, curN);
            auto l0BiasLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1, curN);
            auto l0CTensor = AscendC::Te::MakeTensor(l0CPtr, l0CLayout);
            auto l0BiasTensor = AscendC::Te::MakeTensor(l0BiasPtr, l0BiasLayout);

            // Move bias along the N dimension once, first from GM to L1
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
            AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyGM2L1, AscendC::Te::CopyGM2L1TraitDefault>>{}, l1BiasTensor, globalBias.Slice(
                AscendC::Te::MakeCoord(0, j * baseN), AscendC::Te::MakeShape(1, curN)));
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
            // Move bias along the N dimension once from L1 to BT for the first Mmad of this N tile
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
            AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyL12BT, AscendC::Te::CopyL12BTTraitDefault>>{}, l0BiasTensor, l1BiasTensor.Slice(
                AscendC::Te::MakeCoord(0, 0), AscendC::Te::MakeShape(1, curN)));
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);

            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                uint32_t curK = (kIter + 1 == kLoop) ? tileK : baseK;
                auto l0ALayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NZLayoutPtn, AscendC::Te::LayoutTraitDefault<A_TYPE>>(curM, curK);
                auto l0BLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::ZNLayoutPtn, AscendC::Te::LayoutTraitDefault<B_TYPE>>(curK, curN);
                auto l0ATensor = AscendC::Te::MakeTensor(l0APtr, l0ALayout);
                auto l0BTensor = AscendC::Te::MakeTensor(l0BPtr, l0BLayout);

                // GM -> L1
                if (kIter % stepK == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                    AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyGM2L1, AscendC::Te::CopyGM2L1TraitDefault>>{}, l1ATensor, globalA.Slice(
                        AscendC::Te::MakeCoord(i * baseM, kIter * baseK * stepK), AscendC::Te::MakeShape(baseM, baseK * stepK)));
                    AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyGM2L1, AscendC::Te::CopyGM2L1TraitDefault>>{}, l1BTensor, globalB.Slice(
                        AscendC::Te::MakeCoord(kIter * baseK * stepK, j * baseN), AscendC::Te::MakeShape(baseK * stepK, baseN)));
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                }

                // L1 -> L0
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyL12L0A, AscendC::Te::CopyL12L0ATraitDefault>>{}, l0ATensor, l1ATensor.Slice(
                    AscendC::Te::MakeCoord(0, kIter % stepK * baseK), AscendC::Te::MakeShape(curM, curK)));
                AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyL12L0B, AscendC::Te::CopyL12L0BTraitDefault>>{}, l0BTensor, l1BTensor.Slice(
                    AscendC::Te::MakeCoord(kIter % stepK * baseK, 0), AscendC::Te::MakeShape(curK, curN)));
                if ((kIter + 1) % stepK == 0) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                if (kIter == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                }

                // Mmad compute
                AscendC::Te::MmadParams para;
                para.m = curM;
                para.n = curN;
                para.k = curK;
                if (kIter == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
                    para.cmatrixInitVal = true;
                    AscendC::Te::Mmad(AscendC::Te::MmadAtom<AscendC::Te::MmadTraits<AscendC::Te::MmadOperation, AscendC::Te::MmadTraitDefault>>{},
                         l0CTensor, l0ATensor, l0BTensor, l0BiasTensor, para);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
                } else {
                    para.cmatrixInitVal = false;
                    AscendC::Te::Mmad(AscendC::Te::MmadAtom<AscendC::Te::MmadTraits<AscendC::Te::MmadOperation, AscendC::Te::MmadTraitDefault>>{},
                         l0CTensor, l0ATensor, l0BTensor, para);
                }
                if (kIter == kLoop - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
            }

            // L0C -> GM
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::Te::Copy(AscendC::Te::CopyAtom<AscendC::Te::CopyTraits<AscendC::Te::CopyL0C2GM, AscendC::Te::CopyL0C2GMTraitDefault>>{}, globalC.Slice(
                AscendC::Te::MakeCoord(i * baseM, j * baseN), AscendC::Te::MakeShape(curM, curN)), l0CTensor);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        }
    }

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t scenarioNum = SCENARIO_NUM;
    using A_TYPE = typename std::conditional_t<(scenarioNum % 2 == 0), half, float>;
    using B_TYPE = typename std::conditional_t<(scenarioNum % 2 == 0), half, float>;
    using C_TYPE = float;
    using BIAS_TYPE = float;

    // Tiling info filled into struct (dynamic at runtime)
    MatmulTiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.singleCoreM = 256;
    tiling.singleCoreN = 128;
    tiling.singleCoreK = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t BASE_M = 128;
    constexpr int32_t BASE_N = 128;
    constexpr int32_t BASE_K = 64;
    constexpr int32_t STEP_M = 1;
    constexpr int32_t STEP_N = 1;
    constexpr int32_t STEP_K = 4;

    constexpr uint32_t NUM_BLOCKS = 32;

    size_t param1FileSize = tiling.m * tiling.k * sizeof(A_TYPE);
    size_t param2FileSize = tiling.n * tiling.k * sizeof(B_TYPE);
    size_t param3FileSize = tiling.m * tiling.n * sizeof(C_TYPE);
    size_t param4FileSize = tiling.n * sizeof(BIAS_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost, *biasHost;
    A_TYPE *xDevice;
    B_TYPE *yDevice;
    C_TYPE *zDevice;
    BIAS_TYPE *biasDevice;

    aclrtMallocHost((void**)(&xHost), param1FileSize);
    aclrtMallocHost((void**)(&yHost), param2FileSize);
    aclrtMallocHost((void**)(&zHost), param3FileSize);
    aclrtMallocHost((void**)(&biasHost), param4FileSize);
    aclrtMalloc((void**)&xDevice, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&biasDevice, param4FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1FileSize, xHost, param1FileSize);
    ReadFile("./input/input_y.bin", param2FileSize, yHost, param2FileSize);
    ReadFile("./input/bias.bin", param4FileSize, biasHost, param4FileSize);

    aclrtMemcpy(xDevice, param1FileSize, xHost, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, param2FileSize, yHost, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(biasDevice, param4FileSize, biasHost, param4FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    MatmulTiling *tilingHost;
    MatmulTiling *tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tilingDevice, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tilingHost = tiling;
    aclrtMemcpy(tilingDevice, sizeof(MatmulTiling), tilingHost, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    dynamic_matmul_with_bias<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE,
                              BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K>
        <<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice, biasDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, param3FileSize, zDevice, param3FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, param3FileSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFree(biasDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(biasHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
