#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include "matmul_common_l1.h"

// 确定输入类型
#ifdef INPUT_TYPE_IS_HALF
using InputT = half;
using L0cT = float;          // half * half -> float
#else
using InputT = int8_t;
using L0cT = int32_t;        // int8 * int8 -> int32
#endif

// 确定输出类型
#ifdef OUTPUT_TYPE_IS_INT8
using OutputT = int8_t;
#else
using OutputT = half;
#endif

// 标量量化/反量化参数
constexpr float quantScalar = 2.0f;

template <typename InputT, typename OutputT, typename L0cT>
class KernelMmad : public MatmulCore<InputT, OutputT, L0cT> {
public:
    using Base = MatmulCore<InputT, OutputT, L0cT>;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR quantAlpha, AscendC::TPipe* pipeIn) {
        Base::Init(a, b, pipeIn);
        cGM.SetGlobalBuffer((__gm__ OutputT*)c);
        quantAlphaGM.SetGlobalBuffer((__gm__ uint64_t*)quantAlpha);

        // 初始化额外内存
        if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
            uint16_t quantAlignSize = CeilAlign(Base::n * sizeof(uint64_t), 128);
            Base::pipe->InitBuffer(inQueueC1, 1, quantAlignSize * sizeof(uint64_t));
            Base::pipe->InitBuffer(inQueueFB, 1, quantAlignSize * sizeof(uint64_t));
        }

        // L1缓冲区，用于存放Fixpipe结果（OutputT类型）
        Base::pipe->InitBuffer(outQueueC1, 1, Base::cSizeAlignL0 * sizeof(OutputT));

        // Tbuf for L0C
        if constexpr (defined(EN_UNIT_FLAG)) {
            Base::pipe->InitBuffer(l0cBuf, Base::cSizeAlignL0 * sizeof(L0cT));
        } else {
            Base::pipe->InitBuffer(Base::outQueueCO1, 1, Base::cSizeAlignL0 * sizeof(L0cT));
        }
    }

    __aicore__ inline void Process() {
        // 获取L0C Tensor
        AscendC::LocalTensor<L0cT> c;
        if constexpr (defined(EN_UNIT_FLAG)) {
            c = l0cBuf.Get<L0cT>();
        } else {
            c = Base::outQueueCO1.AllocTensor<L0cT>();
        }

        // 执行公共计算
        for (uint32_t kIdx = 0; kIdx < kRound; ++kIdx) {
            Base::CopyIn(kIdx);
            Base::SplitA(kIdx);
            Base::SplitB(kIdx);
            Base::Compute(kIdx);
        }

        // 获取量化参数（向量量化模式）
        AscendC::LocalTensor<uint64_t> quantAlphaTensor;
        if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
            quantAlphaTensor = inQueueC1.AllocTensor<uint64_t>();
            CopyQuantAlphaGmToL1(quantAlphaTensor);
        }

        // 两级搬出：L0C -> L1 -> GM
        if constexpr (defined(USE_DATA_COPY)) {
            CopyOutUseDataCopy(c, quantAlphaTensor);
        } else {
            CopyOut(c, quantAlphaTensor);
        }

        // 释放资源
        if constexpr (!defined(EN_UNIT_FLAG)) {
            Base::outQueueCO1.FreeTensor(c);
        }
        if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
            inQueueC1.FreeTensor(quantAlphaTensor);
        }
    }

private:
    using Base::CeilAlign;
    using Base::CeilDivision;
    using Base::m;
    using Base::n;
    using Base::k;
    using Base::cGM;

    __aicore__ inline void CopyQuantAlphaGmToL1(AscendC::LocalTensor<uint64_t>& quantAlphaTensor) {
        event_t eventIDFixToMte2 = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::FIX_MTE2));
        AscendC::SetFlag<AscendC::HardEvent::FIX_MTE2>(eventIDFixToMte2);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE2>(eventIDFixToMte2);
        uint16_t burstLen = CeilAlign(n * sizeof(uint64_t), 128) / 32;
        AscendC::DataCopyParams intriParams{1, burstLen, 0, 0};
        AscendC::DataCopy(quantAlphaTensor, quantAlphaGM, intriParams);
        event_t eventIDMte2ToFix = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_FIX));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_FIX>(eventIDMte2ToFix);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_FIX>(eventIDMte2ToFix);
        inQueueC1.EnQue(quantAlphaTensor);
        inQueueC1.DeQue(); // 等待拷贝完成
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<L0cT>& c, AscendC::LocalTensor<uint64_t>& quantAlphaTensor) {
        if constexpr (!defined(EN_UNIT_FLAG)) {
            c = Base::outQueueCO1.DeQue<L0cT>();
        }

        // 第一步：L0C -> L1，使用Fixpipe
        AscendC::LocalTensor<OutputT> c1Local = outQueueC1.AllocTensor<OutputT>();

        AscendC::FixpipeParamsV220 params;
        params.mSize = m;
        params.srcStride = CeilAlign(m, CUBE_BLOCK);
        // NZ输出，nSize对齐到CUBE_BLOCK，因为输出是NZ格式
        params.nSize = CeilAlign(n, CUBE_BLOCK);
        params.dstStride = m * CUBE_BLOCK * sizeof(OutputT) / AscendC::ONE_BLK_SIZE;

#ifdef EN_UNIT_FLAG
        params.unitFlag = 3;
#endif

        // 量化模式
        if constexpr (defined(PRE_QUANT_MODE_SCALAR)) {
            params.quantPre = GetQuantPreScalar();
            uint64_t deqScalar = static_cast<uint64_t>(*reinterpret_cast<int32_t*>(&quantScalar));
            constexpr bool sign = (AscendC::IsSameType<OutputT, int8_t>::value) ? true : false;
            deqScalar = (deqScalar & ~(static_cast<uint64_t>(1) << 46)) | (static_cast<uint64_t>(sign) << 46);
            params.deqScalar = deqScalar;
        } else if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
            params.quantPre = GetQuantPreVector();
        }

#ifdef PRE_RELU_MODE_ENABLE
        params.reluEn = true;
#endif

        // 执行Fixpipe: L0C -> L1 (NZ->NZ)
        if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
            AscendC::Fixpipe<OutputT, L0cT, AscendC::CFG_NZ>(c1Local, c, quantAlphaTensor, params);
        } else {
            AscendC::Fixpipe<OutputT, L0cT, AscendC::CFG_NZ>(c1Local, c, params);
        }

#ifdef EN_UNIT_FLAG
        bool isUnitFlag = true;
        AscendC::SetFixPipeConfig<L0cT>(c, isUnitFlag);
#endif

        // 第二步：L1 -> GM，使用DataCopy
        event_t eventIDFIXToMTE3 = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::FIX_MTE3));
        AscendC::SetFlag<AscendC::HardEvent::FIX_MTE3>(eventIDFIXToMTE3);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE3>(eventIDFIXToMTE3);

        AscendC::DataCopyParams dataCopyInfo;
        dataCopyInfo.blockCount = 1;
        dataCopyInfo.blockLen = n * m * sizeof(OutputT) / AscendC::ONE_BLK_SIZE;
        AscendC::DataCopy(cGM, c1Local, dataCopyInfo);

        outQueueC1.FreeTensor(c1Local);
    }

    __aicore__ inline void CopyOutUseDataCopy(AscendC::LocalTensor<L0cT>& c, AscendC::LocalTensor<uint64_t>& quantAlphaTensor) {
        if constexpr (!defined(EN_UNIT_FLAG)) {
            c = Base::outQueueCO1.DeQue<L0cT>();
        }

        AscendC::LocalTensor<OutputT> c1Local = outQueueC1.AllocTensor<OutputT>();

        // 第一步：L0C -> L1，使用DataCopy（替代Fixpipe）
        AscendC::DataCopyCO12DstParams intriParams;
        intriParams.mSize = m;
        intriParams.srcStride = CeilAlign(m, CUBE_BLOCK);
        intriParams.nSize = CeilAlign(n, CUBE_BLOCK);
        intriParams.dstStride = m * CUBE_BLOCK * sizeof(OutputT) / AscendC::ONE_BLK_SIZE;

#ifdef EN_UNIT_FLAG
        intriParams.unitFlag = 3;
#endif

        // 量化模式
        if constexpr (defined(PRE_QUANT_MODE_SCALAR)) {
            intriParams.quantPre = GetQuantPreScalar();
            uint64_t deqScalar = static_cast<uint64_t>(*reinterpret_cast<int32_t*>(&quantScalar));
            constexpr bool sign = (AscendC::IsSameType<OutputT, int8_t>::value) ? true : false;
            deqScalar = (deqScalar & ~(static_cast<uint64_t>(1) << 46)) | (static_cast<uint64_t>(sign) << 46);
            AscendC::SetFixpipePreQuantFlag(deqScalar);
        } else if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
            intriParams.quantPre = GetQuantPreVector();
            AscendC::LocalTensor<uint64_t> fbTensor = inQueueFB.AllocTensor<uint64_t>();
            inQueueFB.EnQue<uint64_t>(fbTensor);
            fbTensor = inQueueFB.DeQue<uint64_t>();
            uint16_t burstLen = CeilAlign(n * sizeof(uint64_t), 128) / 128;
            AscendC::DataCopyParams dataCopyParams(1, burstLen, 0, 0);
            AscendC::DataCopy(fbTensor, quantAlphaTensor, dataCopyParams);
            AscendC::SetFixPipeConfig(fbTensor);
            inQueueFB.FreeTensor(fbTensor);
        }

#ifdef PRE_RELU_MODE_ENABLE
        intriParams.reluPre = 1;
#endif

        AscendC::DataCopy(c1Local, c, intriParams);

#ifdef EN_UNIT_FLAG
        bool isUnitFlag = true;
        AscendC::SetFixPipeConfig<L0cT>(c, isUnitFlag);
#endif

        // 第二步：L1 -> GM
        event_t eventIDFIXToMTE3 = static_cast<event_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::FIX_MTE3));
        AscendC::SetFlag<AscendC::HardEvent::FIX_MTE3>(eventIDFIXToMTE3);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE3>(eventIDFIXToMTE3);

        AscendC::DataCopyParams dataCopyInfo;
        dataCopyInfo.blockCount = 1;
        dataCopyInfo.blockLen = n * m * sizeof(OutputT) / AscendC::ONE_BLK_SIZE;
        AscendC::DataCopy(cGM, c1Local, dataCopyInfo);

        outQueueC1.FreeTensor(c1Local);
    }

    __aicore__ inline AscendC::QuantMode_t GetQuantPreScalar() {
        if constexpr (AscendC::IsSameType<OutputT, int8_t>::value) {
            return AscendC::QuantMode_t::QF322B8_PRE;  // half -> int8 量化
        } else if constexpr (AscendC::IsSameType<OutputT, half>::value) {
            return AscendC::QuantMode_t::DEQF16;       // int32 -> half 反量化
        } else {
            return AscendC::QuantMode_t::QF322B8_PRE;
        }
    }

    __aicore__ inline AscendC::QuantMode_t GetQuantPreVector() {
        if constexpr (AscendC::IsSameType<OutputT, int8_t>::value) {
            return AscendC::QuantMode_t::VQF322B8_PRE;
        } else if constexpr (AscendC::IsSameType<OutputT, half>::value) {
            return AscendC::QuantMode_t::VDEQF16;
        } else {
            return AscendC::QuantMode_t::VQF322B8_PRE;
        }
    }

private:
    AscendC::GlobalTensor<OutputT> cGM;
    AscendC::GlobalTensor<uint64_t> quantAlphaGM;

    AscendC::TBuf<AscendC::TPosition::CO1> l0cBuf;
    AscendC::TQue<AscendC::TPosition::C1, 1> inQueueC1;
    AscendC::TQue<AscendC::TPosition::C2PIPE2GM, 1> inQueueFB;
    AscendC::TQue<AscendC::TPosition::C1, 1> outQueueC1;  // L1输出队列
};

extern "C" __global__ __cube__ void fixpipe_co12l1(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR quantAlpha) {
    AscendC::TPipe pipe;
    KernelMmad<InputT, OutputT, L0cT> op;
    op.Init(a, b, c, quantAlpha, &pipe);
    op.Process();
}

int32_t main(int32_t argc, char* argv[]) {
    size_t aFileSize = M * K * sizeof(InputT);
    size_t bFileSize = K * N * sizeof(InputT);
    size_t cFileSize = M * N * sizeof(OutputT);
    size_t quantAlphaSize = 1 * N * sizeof(uint64_t);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* quantAlphaHost = nullptr;
    uint8_t* quantAlphaDevice = nullptr;
    if constexpr (defined(PRE_QUANT_MODE_VECTOR)) {
        aclrtMallocHost((void**)(&quantAlphaHost), quantAlphaSize);
        aclrtMalloc((void**)&quantAlphaDevice, quantAlphaSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/quant_pre.bin", quantAlphaSize, quantAlphaHost, quantAlphaSize);
        aclrtMemcpy(quantAlphaDevice, quantAlphaSize, quantAlphaHost, quantAlphaSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    fixpipe_co12l1<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, quantAlphaDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    if (quantAlphaDevice) {
        aclrtFree(quantAlphaDevice);
        aclrtFreeHost(quantAlphaHost);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}