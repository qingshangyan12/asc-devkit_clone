/* !
 * \file mx_batch_mmad_fp4_tensor_api.asc
 * \brief A Tensor API batch MX Mmad sample that exercises each MX scale GM->L1 pathway.
 *
 * The A/B matrix pathway is fixed (A non-transposed GM ND->L1 NZ, B transposed GM DN->L1 ZN);
 * transpose is expressed by the GM/L1 fractal while L0 is fixed. Only the scale pathway varies.
 * The scale pathway is selected at compile time by the SCENE_ID macro so each build validates one
 * pathway in isolation (run.sh builds all three):
 *   SCENE_ID=0: ScaleA ScaleAND -> L1 ZZ, ScaleB ScaleBND -> L1 NN
 *   SCENE_ID=1: ScaleA ScaleADN -> L1 ZZ, ScaleB ScaleBDN -> L1 NN
 *   SCENE_ID=2: ScaleA ZZ       -> L1 ZZ, ScaleB NN       -> L1 NN
 */

#include "acl/acl.h"
#include "basic_api/kernel_basic_intf.h"
#include "tensor_api/tensor.h"
#include "data_utils.h"

#ifndef SCENE_ID
#define SCENE_ID 0
#endif

constexpr uint32_t BATCH_SIZE = 2;
constexpr uint32_t M_SIZE = 32;
constexpr uint32_t N_SIZE = 48;
constexpr uint32_t K_SIZE = 96;
constexpr uint32_t SCALE_CEIL_NUMBER = 32;
constexpr uint32_t SCALE_ALIGN_NUMBER = 2;
// MX Mmad requires the K dimension aligned to 64. When K is not a multiple of 64 the matrices and
// scale are processed at K_SIZE_ALIGN (the K-tail is zero-padded, so it adds nothing to the result),
// and the scale K count is derived from the aligned K too.
constexpr uint32_t K_ALIGN_NUMBER = 64;
constexpr uint32_t K_SIZE_ALIGN = (K_SIZE + K_ALIGN_NUMBER - 1) / K_ALIGN_NUMBER * K_ALIGN_NUMBER;
constexpr uint32_t SCALE_K_SIZE = ((K_SIZE_ALIGN + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER +
    SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER * SCALE_ALIGN_NUMBER;
constexpr uint32_t C0_ELEMENT_SCALE = 2;
constexpr uint32_t C0_ELEMENT_L0C = 16;
constexpr uint32_t C0_ELEMENT_B4 = 64;
constexpr uint32_t FP4_PACKED_FACTOR = 2;
constexpr uint32_t A_BATCH_ELEMENTS = M_SIZE * K_SIZE_ALIGN / FP4_PACKED_FACTOR;
constexpr uint32_t B_BATCH_ELEMENTS = K_SIZE_ALIGN * N_SIZE / FP4_PACKED_FACTOR;
constexpr uint32_t SCALE_A_BATCH_ELEMENTS = M_SIZE * SCALE_K_SIZE;
constexpr uint32_t SCALE_B_BATCH_ELEMENTS = SCALE_K_SIZE * N_SIZE;
constexpr uint32_t C_BATCH_ELEMENTS = M_SIZE * N_SIZE;

// Select the GM scale layout pattern and input file name per compile-time scene.
#if SCENE_ID == 0
using ScaleAGmPtn = AscendC::Te::ScaleANDLayoutPtn;
using ScaleBGmPtn = AscendC::Te::ScaleBNDLayoutPtn;
#define SCALE_A_INPUT "./input/x1_scale_AND.bin"
#define SCALE_B_INPUT "./input/x2_scale_BND.bin"
#elif SCENE_ID == 1
using ScaleAGmPtn = AscendC::Te::ScaleADNLayoutPtn;
using ScaleBGmPtn = AscendC::Te::ScaleBDNLayoutPtn;
#define SCALE_A_INPUT "./input/x1_scale_ADN.bin"
#define SCALE_B_INPUT "./input/x2_scale_BDN.bin"
#elif SCENE_ID == 2
using ScaleAGmPtn = AscendC::Te::ZZLayoutPtn;
using ScaleBGmPtn = AscendC::Te::NNLayoutPtn;
#define SCALE_A_INPUT "./input/x1_scale_ZZ.bin"
#define SCALE_B_INPUT "./input/x2_scale_NN.bin"
#else
#error "SCENE_ID must be 0, 1 or 2"
#endif

constexpr AscendC::Te::MmadTrait MX_MMAD_TRAIT =
    AscendC::Te::MmadTrait{0, false, false, true, AscendC::Te::MmadType::MX};

struct MmadTraitMX {
    using TraitType = AscendC::Te::MmadTrait;
    static constexpr const TraitType value = MX_MMAD_TRAIT;
};

__global__ __cube__ void mx_batch_mmad_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* scaleA, __gm__ uint8_t* scaleB, __gm__ float* c)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    auto aPtr = reinterpret_cast<__gm__ fp4x2_e1m2_t*>(a);
    auto bPtr = reinterpret_cast<__gm__ fp4x2_e1m2_t*>(b);
    auto scaleAPtr = reinterpret_cast<__gm__ fp8_e8m0_t*>(scaleA);
    auto scaleBPtr = reinterpret_cast<__gm__ fp8_e8m0_t*>(scaleB);

    auto gmATensor = MakeTensor(
        MakeMemPtr(aPtr),
        MakeFrameLayout<NDExtLayoutPtn>(BATCH_SIZE, M_SIZE, K_SIZE_ALIGN)
    );
    auto gmBTensor = MakeTensor(
        MakeMemPtr(bPtr),
        MakeFrameLayout<DNExtLayoutPtn>(BATCH_SIZE, K_SIZE_ALIGN, N_SIZE)
    );
    auto gmCTensor = MakeTensor(
        MakeMemPtr(c),
        MakeFrameLayout<NDExtLayoutPtn>(BATCH_SIZE, M_SIZE, N_SIZE)
    );
    // ScaleA GM (pattern per scene) -> L1 ZZ. C0=2 (fp8 scale) for every pattern, including ZZ/NN
    // whose default trait C0 would otherwise be 16.
    auto gmScaleATensor = MakeTensor(
        MakeMemPtr(scaleAPtr),
        MakeFrameLayout<ScaleAGmPtn, C0_ELEMENT_SCALE>(BATCH_SIZE, M_SIZE, SCALE_K_SIZE)
    );
    // ScaleB GM (pattern per scene) -> L1 NN.
    auto gmScaleBTensor = MakeTensor(
        MakeMemPtr(scaleBPtr),
        MakeFrameLayout<ScaleBGmPtn, C0_ELEMENT_SCALE>(BATCH_SIZE, SCALE_K_SIZE, N_SIZE)
    );

    __cbuf__ fp4x2_e1m2_t l1ABuf[BATCH_SIZE * A_BATCH_ELEMENTS];
    __cbuf__ fp4x2_e1m2_t l1BBuf[BATCH_SIZE * B_BATCH_ELEMENTS];
    __cbuf__ fp8_e8m0_t l1ScaleABuf[BATCH_SIZE * SCALE_A_BATCH_ELEMENTS];
    __cbuf__ fp8_e8m0_t l1ScaleBBuf[BATCH_SIZE * SCALE_B_BATCH_ELEMENTS];
    __ca__ fp4x2_e1m2_t l0ABuf[BATCH_SIZE * A_BATCH_ELEMENTS];
    __cb__ fp4x2_e1m2_t l0BBuf[BATCH_SIZE * B_BATCH_ELEMENTS];
    __cc__ float l0CBuf[BATCH_SIZE * C_BATCH_ELEMENTS];

    auto l1ATensor = MakeTensor(
        MakeMemPtr(l1ABuf),
        MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_B4>(BATCH_SIZE, M_SIZE, K_SIZE_ALIGN)
    );
    auto l1BTensor = MakeTensor(
        MakeMemPtr(l1BBuf),
        MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT_B4>(BATCH_SIZE, K_SIZE_ALIGN, N_SIZE)
    );
    auto l0ATensor = MakeTensor(
        MakeMemPtr(l0ABuf),
        MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_B4>(BATCH_SIZE, M_SIZE, K_SIZE_ALIGN)
    );
    auto l0BTensor = MakeTensor(
        MakeMemPtr(l0BBuf),
        MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT_B4>(BATCH_SIZE, K_SIZE_ALIGN, N_SIZE)
    );

    auto scaleABaseLayout = MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(M_SIZE, SCALE_K_SIZE);
    auto scaleBBaseLayout = MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(SCALE_K_SIZE, N_SIZE);

    // L1 scale stays compact (default batch stride = scale Capacity), matching the GM->L1 copy.
    auto l1ScaleATensor = MakeTensor(
        MakeMemPtr(l1ScaleABuf), MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(BATCH_SIZE, M_SIZE, SCALE_K_SIZE));
    auto l1ScaleBTensor = MakeTensor(
        MakeMemPtr(l1ScaleBBuf), MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(BATCH_SIZE, SCALE_K_SIZE, N_SIZE));
    // L0 scale derives its batch stride from the matrix L0 tensor (matrix batch byte stride >> 4), so
    // each batch lands at the exact address MX Mmad reads its scale from. The L1->L0 scale copy walks
    // the batch dimension internally; the per-batch scale shape stays the compact fractal.
    auto scaleAL0BatchLayout = MakeScaleL0BatchLayout(BATCH_SIZE, l0ATensor, scaleABaseLayout);
    auto scaleBL0BatchLayout = MakeScaleL0BatchLayout(BATCH_SIZE, l0BTensor, scaleBBaseLayout);
    auto l0ScaleATensor = MakeTensor(
        MakeMemPtr<Location::L0ScaleA, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0ABuf) / 16),
        scaleAL0BatchLayout
    );
    auto l0ScaleBTensor = MakeTensor(
        MakeMemPtr<Location::L0ScaleB, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0BBuf) / 16),
        scaleBL0BatchLayout
    );
    auto l0CBatchTensor = MakeTensor(
        MakeMemPtr(l0CBuf),
        MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_L0C>(BATCH_SIZE, M_SIZE, N_SIZE)
    );

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL12L0ScaleAAtom = MakeCopy(CopyL12L0ScaleA{}, CopyL12L0ScaleATraitDefault{});
    auto copyL12L0ScaleBAtom = MakeCopy(CopyL12L0ScaleB{}, CopyL12L0ScaleBTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mxMmadAtom = MakeMmad(MmadOperation{}, MmadTraitMX{});

    constexpr uint32_t L1_EVENT_ID = 0;
    constexpr uint32_t L0_EVENT_ID = 1;
    constexpr uint32_t L0C_EVENT_ID = 2;
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);

    // Move batched FP4 matrices and MX scale data from GM to L1.
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    Copy(copyGM2L1Atom, l1ATensor, gmATensor);
    Copy(copyGM2L1Atom, l1BTensor, gmBTensor);
    Copy(copyGM2L1Atom, l1ScaleATensor, gmScaleATensor);
    Copy(copyGM2L1Atom, l1ScaleBTensor, gmScaleBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);

    // Load batched FP4 matrices and MX scale data to the corresponding L0 locations.
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    Copy(copyL12L0AAtom, l0ATensor, l1ATensor);
    Copy(copyL12L0BAtom, l0BTensor, l1BTensor);
    Copy(copyL12L0ScaleAAtom, l0ScaleATensor, l1ScaleATensor);
    Copy(copyL12L0ScaleBAtom, l0ScaleBTensor, l1ScaleBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);

    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    MmadParams mxMmadParams{M_SIZE, N_SIZE, K_SIZE_ALIGN, 0, true};
    for (uint32_t batchIdx = 0; batchIdx < BATCH_SIZE; ++batchIdx) {
        // Slice the batchIdx-th matrix out of the batched L0 tensors. The slice keeps the batched
        // (batch + fractal) layout shape; Mmad only needs the correctly offset address.
        auto l0ATile = l0ATensor.Slice(MakeCoord(batchIdx, MakeCoord(0, 0)), MakeShape(1, MakeShape(M_SIZE, K_SIZE_ALIGN)));
        auto l0BTile = l0BTensor.Slice(MakeCoord(batchIdx, MakeCoord(0, 0)), MakeShape(1, MakeShape(K_SIZE_ALIGN, N_SIZE)));
        auto l0CTile = l0CBatchTensor.Slice(MakeCoord(batchIdx, MakeCoord(0, 0)), MakeShape(1, MakeShape(M_SIZE, N_SIZE)));
        Mmad(mxMmadAtom.with(mxMmadParams), l0CTile, l0ATile, l0BTile);
    }
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);

    FixpipeParams fixpipeParams;
    Copy(copyL0C2GMAtom.with(fixpipeParams), gmCTensor, l0CBatchTensor);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr size_t aFileSize = BATCH_SIZE * A_BATCH_ELEMENTS * sizeof(uint8_t);
    constexpr size_t bFileSize = BATCH_SIZE * B_BATCH_ELEMENTS * sizeof(uint8_t);
    constexpr size_t scaleAFileSize = BATCH_SIZE * SCALE_A_BATCH_ELEMENTS * sizeof(uint8_t);
    constexpr size_t scaleBFileSize = BATCH_SIZE * SCALE_B_BATCH_ELEMENTS * sizeof(uint8_t);
    constexpr size_t cFileSize = BATCH_SIZE * C_BATCH_ELEMENTS * sizeof(float);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* scaleAHost = nullptr;
    uint8_t* scaleBHost = nullptr;
    float* cHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* scaleADevice = nullptr;
    uint8_t* scaleBDevice = nullptr;
    float* cDevice = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&aHost), aFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&bHost), bFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&scaleAHost), scaleAFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&scaleBHost), scaleBFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&cHost), cFileSize);

    aclrtMalloc(reinterpret_cast<void**>(&aDevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&scaleADevice), scaleAFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&scaleBDevice), scaleBFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&cDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputSize = 0;
    ReadFile("./input/x1_gm.bin", inputSize, aHost, aFileSize);
    ReadFile("./input/x2_gm.bin", inputSize, bHost, bFileSize);
    ReadFile(SCALE_A_INPUT, inputSize, scaleAHost, scaleAFileSize);
    ReadFile(SCALE_B_INPUT, inputSize, scaleBHost, scaleBFileSize);

    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(scaleADevice, scaleAFileSize, scaleAHost, scaleAFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(scaleBDevice, scaleBFileSize, scaleBHost, scaleBFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    mx_batch_mmad_custom<<<1, nullptr, stream>>>(aDevice, bDevice, scaleADevice, scaleBDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    mkdir("./output", S_IRWXU | S_IRWXG | S_IRWXO);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(scaleADevice);
    aclrtFree(scaleBDevice);
    aclrtFree(cDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(scaleAHost);
    aclrtFreeHost(scaleBHost);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
