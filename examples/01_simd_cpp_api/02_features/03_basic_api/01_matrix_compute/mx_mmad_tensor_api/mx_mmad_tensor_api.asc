/* !
 * \file mx_mmad_tensor_api.asc
 * \brief A simple Tensor API MX Mmad sample.
 */

#include "acl/acl.h"
#include "basic_api/kernel_basic_intf.h"
#include "tensor_api/tensor.h"
#include "data_utils.h"

constexpr uint32_t M_SIZE = 128;
constexpr uint32_t N_SIZE = 128;
constexpr uint32_t K_SIZE = 256;
constexpr uint32_t SCALE_CEIL_NUMBER = 32;
constexpr uint32_t SCALE_ALIGN_NUMBER = 2;
constexpr uint32_t SCALE_K_SIZE = ((K_SIZE + SCALE_CEIL_NUMBER - 1) / SCALE_CEIL_NUMBER +
    SCALE_ALIGN_NUMBER - 1) / SCALE_ALIGN_NUMBER * SCALE_ALIGN_NUMBER;
constexpr uint32_t C0_ELEMENT_SCALE = 2;
constexpr uint32_t C0_ELEMENT_L0C = 16;
constexpr uint32_t C0_ELEMENT_B4 = 64;
constexpr uint32_t FP4_PACKED_FACTOR = 2;

constexpr AscendC::Te::MmadTrait MX_MMAD_TRAIT =
    AscendC::Te::MmadTrait{0, false, false, true, AscendC::Te::MmadType::MX};

struct MmadTraitMX {
    using TraitType = AscendC::Te::MmadTrait;
    static constexpr const TraitType value = MX_MMAD_TRAIT;
};

__global__ __cube__ void mx_mmad_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* scaleA, __gm__ uint8_t* scaleB, __gm__ float* c)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    auto aPtr = reinterpret_cast<__gm__ fp4x2_e1m2_t*>(a);
    auto bPtr = reinterpret_cast<__gm__ fp4x2_e1m2_t*>(b);
    auto scaleAPtr = reinterpret_cast<__gm__ fp8_e8m0_t*>(scaleA);
    auto scaleBPtr = reinterpret_cast<__gm__ fp8_e8m0_t*>(scaleB);

    auto gmATensor = MakeTensor(MakeMemPtr(aPtr), MakeFrameLayout<NDExtLayoutPtn>(M_SIZE, K_SIZE));
    auto gmBTensor = MakeTensor(MakeMemPtr(bPtr), MakeFrameLayout<DNExtLayoutPtn>(K_SIZE, N_SIZE));
    auto gmScaleATensor = MakeTensor(MakeMemPtr(scaleAPtr), MakeFrameLayout<ScaleANDLayoutPtn>(M_SIZE, SCALE_K_SIZE));
    auto gmScaleBTensor = MakeTensor(MakeMemPtr(scaleBPtr), MakeFrameLayout<ScaleBDNLayoutPtn>(SCALE_K_SIZE, N_SIZE));
    auto gmCTensor = MakeTensor(MakeMemPtr(c), MakeFrameLayout<NDExtLayoutPtn>(M_SIZE, N_SIZE));

    __cbuf__ fp4x2_e1m2_t l1ABuf[M_SIZE * K_SIZE / FP4_PACKED_FACTOR];
    __cbuf__ fp4x2_e1m2_t l1BBuf[K_SIZE * N_SIZE / FP4_PACKED_FACTOR];
    __cbuf__ fp8_e8m0_t l1ScaleABuf[M_SIZE * SCALE_K_SIZE];
    __cbuf__ fp8_e8m0_t l1ScaleBBuf[SCALE_K_SIZE * N_SIZE];
    __ca__ fp4x2_e1m2_t l0ABuf[M_SIZE * K_SIZE / FP4_PACKED_FACTOR];
    __cb__ fp4x2_e1m2_t l0BBuf[K_SIZE * N_SIZE / FP4_PACKED_FACTOR];
    __cc__ float l0CBuf[M_SIZE * N_SIZE];

    auto l1ATensor = MakeTensor(
        MakeMemPtr(l1ABuf),
        MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_B4>(M_SIZE, K_SIZE)
    );
    auto l1BTensor = MakeTensor(
        MakeMemPtr(l1BBuf),
        MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT_B4>(K_SIZE, N_SIZE)
    );
    auto l1ScaleATensor = MakeTensor(
        MakeMemPtr(l1ScaleABuf),
        MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(M_SIZE, SCALE_K_SIZE)
    );
    auto l1ScaleBTensor = MakeTensor(
        MakeMemPtr(l1ScaleBBuf),
        MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(SCALE_K_SIZE, N_SIZE)
    );
    auto l0ATensor = MakeTensor(
        MakeMemPtr(l0ABuf),
        MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_B4>(M_SIZE, K_SIZE)
    );
    auto l0BTensor = MakeTensor(
        MakeMemPtr(l0BBuf),
        MakeFrameLayout<ZNLayoutPtn, C0_ELEMENT_B4>(K_SIZE, N_SIZE)
    );
    auto l0ScaleATensor = MakeTensor(
        MakeMemPtr<Location::L0ScaleA, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0ABuf) / 16),
        MakeFrameLayout<ZZLayoutPtn, C0_ELEMENT_SCALE>(M_SIZE, SCALE_K_SIZE)
    );
    auto l0ScaleBTensor = MakeTensor(
        MakeMemPtr<Location::L0ScaleB, fp8_e8m0_t>(reinterpret_cast<uint64_t>(l0BBuf) / 16),
        MakeFrameLayout<NNLayoutPtn, C0_ELEMENT_SCALE>(SCALE_K_SIZE, N_SIZE)
    );
    auto l0CTensor = MakeTensor(
        MakeMemPtr(l0CBuf),
        MakeFrameLayout<NZLayoutPtn, C0_ELEMENT_L0C>(M_SIZE, N_SIZE)
    );

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL12L0ScaleAAtom = MakeCopy(CopyL12L0ScaleA{}, CopyL12L0ScaleATraitDefault{});
    auto copyL12L0ScaleBAtom = MakeCopy(CopyL12L0ScaleB{}, CopyL12L0ScaleBTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mxMmadAtom = MakeMmad(MmadOperation{}, MmadTraitMX{});

    constexpr uint32_t L1_EVENT_ID = 0;
    constexpr uint32_t L0_EVENT_ID = 1;
    constexpr uint32_t L0C_EVENT_ID = 2;
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);

    // Move one full tile from GM to L1, including FP4 data and MX scale data.
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    Copy(copyGM2L1Atom, l1ATensor, gmATensor);
    Copy(copyGM2L1Atom, l1BTensor, gmBTensor);
    Copy(copyGM2L1Atom, l1ScaleATensor, gmScaleATensor);
    Copy(copyGM2L1Atom, l1ScaleBTensor, gmScaleBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);

    // Load FP4 data and scale data from L1 to the corresponding L0 locations.
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    Copy(copyL12L0AAtom, l0ATensor, l1ATensor);
    Copy(copyL12L0BAtom, l0BTensor, l1BTensor);
    Copy(copyL12L0ScaleAAtom, l0ScaleATensor, l1ScaleATensor);
    Copy(copyL12L0ScaleBAtom, l0ScaleBTensor, l1ScaleBTensor);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);

    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    MmadParams mxMmadParams{M_SIZE, N_SIZE, K_SIZE, 0, true};
    Mmad(mxMmadAtom.with(mxMmadParams), l0CTensor, l0ATensor, l0BTensor);
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);

    FixpipeParams fixpipeParams;
    Copy(copyL0C2GMAtom.with(fixpipeParams), gmCTensor, l0CTensor);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr size_t aFileSize = M_SIZE * K_SIZE * sizeof(uint8_t) / FP4_PACKED_FACTOR;
    constexpr size_t bFileSize = K_SIZE * N_SIZE * sizeof(uint8_t) / FP4_PACKED_FACTOR;
    constexpr size_t scaleAFileSize = M_SIZE * SCALE_K_SIZE * sizeof(uint8_t);
    constexpr size_t scaleBFileSize = SCALE_K_SIZE * N_SIZE * sizeof(uint8_t);
    constexpr size_t cFileSize = M_SIZE * N_SIZE * sizeof(float);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* scaleAHost = nullptr;
    uint8_t* scaleBHost = nullptr;
    float* cHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* scaleADevice = nullptr;
    uint8_t* scaleBDevice = nullptr;
    float* cDevice = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&aHost), aFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&bHost), bFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&scaleAHost), scaleAFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&scaleBHost), scaleBFileSize);
    aclrtMallocHost(reinterpret_cast<void**>(&cHost), cFileSize);

    aclrtMalloc(reinterpret_cast<void**>(&aDevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&scaleADevice), scaleAFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&scaleBDevice), scaleBFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&cDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputSize = 0;
    ReadFile("./input/x1_gm.bin", inputSize, aHost, aFileSize);
    ReadFile("./input/x2_gm.bin", inputSize, bHost, bFileSize);
    ReadFile("./input/x1_scale_gm.bin", inputSize, scaleAHost, scaleAFileSize);
    ReadFile("./input/x2_scale_gm.bin", inputSize, scaleBHost, scaleBFileSize);

    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(scaleADevice, scaleAFileSize, scaleAHost, scaleAFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(scaleBDevice, scaleBFileSize, scaleBHost, scaleBFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    mx_mmad_custom<<<1, nullptr, stream>>>(aDevice, bDevice, scaleADevice, scaleBDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    mkdir("./output", S_IRWXU | S_IRWXG | S_IRWXO);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(scaleADevice);
    aclrtFree(scaleBDevice);
    aclrtFree(cDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(scaleAHost);
    aclrtFreeHost(scaleBHost);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
