/* !
 * \file batch_matmul_tensor_api_base.asc
 * \brief 本样例介绍基于Tensor API实现带batch的矩阵乘法，并使用baseM/baseN/baseK进行M/N/K分块。
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"


template <typename T, typename BIAS_TYPE, uint32_t B, uint32_t M, uint32_t K, uint32_t N,
          uint32_t L1BatchSize, uint32_t L0BatchSize,
          int32_t baseM, int32_t baseN, int32_t baseK, int32_t stepM, int32_t stepN, int32_t stepK>
__global__ __cube__ void batch_matmul_tensor_api_base(__gm__ T* a, __gm__ T* b, __gm__ T* c,
                                                      __gm__ BIAS_TYPE* bias)
{
    using namespace AscendC::Te;

    auto gmA = MakeTensor(MakeMemPtr(a), MakeFrameLayout<NDExtLayoutPtn>(B, M, K));
    auto gmB = MakeTensor(MakeMemPtr(b), MakeFrameLayout<NDExtLayoutPtn>(B, K, N));
    auto gmC = MakeTensor(MakeMemPtr(c), MakeFrameLayout<NDExtLayoutPtn>(B, M, N));
    auto gmBias = MakeTensor(MakeMemPtr(bias), MakeFrameLayout<NDExtLayoutPtn>(B, 1, N));

    __cbuf__ T l1ABuf[L0BatchSize * baseM * stepM * baseK * stepK];
    __cbuf__ T l1BBuf[L0BatchSize * baseK * stepK * baseN * stepN];
    __cbuf__ BIAS_TYPE l1BiasBuf[L0BatchSize * baseN * stepN];
    __ca__ T l0ABuf[L0BatchSize * baseM * baseK];
    __cb__ T l0BBuf[L0BatchSize * baseK * baseN];
    __biasbuf__ float l0BiasBuf[L0BatchSize * baseN];
    __cc__ float l0CBuf[L0BatchSize * baseM * baseN];

    auto l1APtr = MakeMemPtr(l1ABuf);
    auto l1BPtr = MakeMemPtr(l1BBuf);
    auto l1BiasPtr = MakeMemPtr(l1BiasBuf);
    auto l0APtr = MakeMemPtr(l0ABuf);
    auto l0BPtr = MakeMemPtr(l0BBuf);
    auto l0BiasPtr = MakeMemPtr(l0BiasBuf);
    auto l0CPtr = MakeMemPtr(l0CBuf);

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL12BTAtom = MakeCopy(CopyL12BT{}, CopyL12BTTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    uint32_t mLoop = (M + baseM - 1) / baseM;
    uint32_t nLoop = (N + baseN - 1) / baseN;
    uint32_t kLoop = (K + baseK - 1) / baseK;
    uint16_t tileM = (M % baseM != 0) ? M % baseM : baseM;
    uint16_t tileN = (N % baseN != 0) ? N % baseN : baseN;
    uint16_t tileK = (K % baseK != 0) ? K % baseK : baseK;

    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);

    for (uint32_t l1BatchIndex = 0; l1BatchIndex < B; l1BatchIndex += L1BatchSize) {
        uint32_t l1BatchSize = min(L1BatchSize, B - l1BatchIndex);
        for (uint32_t l0BatchIndex = 0; l0BatchIndex < l1BatchSize; l0BatchIndex += L0BatchSize) {
            uint32_t l0BatchSize = min(L0BatchSize, l1BatchSize - l0BatchIndex);
            uint32_t batchOffset = l1BatchIndex + l0BatchIndex;

            auto l1ATensor = MakeTensor(
                l1APtr,
                MakeFrameLayout<NZLayoutPtn, T>(l0BatchSize, baseM * stepM, baseK * stepK)
            );
            auto l1BTensor = MakeTensor(
                l1BPtr,
                MakeFrameLayout<NZLayoutPtn, T>(l0BatchSize, baseK * stepK, baseN * stepN)
            );
            auto l1BiasTensor = MakeTensor(
                l1BiasPtr,
                MakeFrameLayout<NDExtLayoutPtn>(l0BatchSize, 1, baseN * stepN)
            );

            for (uint32_t i = 0; i < mLoop; i++) {
                uint16_t curM = (i + 1 == mLoop) ? tileM : baseM;
                for (uint32_t j = 0; j < nLoop; j++) {
                    uint16_t curN = (j + 1 == nLoop) ? tileN : baseN;
                    auto l0CTensor = MakeTensor(l0CPtr, MakeFrameLayout<NZLayoutPtn>(l0BatchSize, curM, curN));
                    auto l0BiasTensor = MakeTensor(l0BiasPtr, MakeFrameLayout<NDExtLayoutPtn>(l0BatchSize, 1, (curN+31)/32*32));

                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
                    Copy(copyGM2L1Atom, l1BiasTensor,
                        gmBias.Slice(
                            MakeCoord(batchOffset, MakeCoord(0, j * baseN)),
                            MakeShape(l0BatchSize, MakeShape(1, curN))
                        )
                    );
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
                    Copy(copyL12BTAtom, l0BiasTensor,
                        l1BiasTensor.Slice(MakeCoord(0, MakeCoord(0, 0)), MakeShape(l0BatchSize, MakeShape(1, (curN+31)/32*32)))
                    );
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);

                    for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                        uint16_t curK = (kIter + 1 == kLoop) ? tileK : baseK;
                        auto l0ATensor = MakeTensor(l0APtr, MakeFrameLayout<NZLayoutPtn, T>(l0BatchSize, curM, curK));
                        auto l0BTensor = MakeTensor(l0BPtr, MakeFrameLayout<ZNLayoutPtn, T>(l0BatchSize, curK, curN));

                        if (kIter % stepK == 0) {
                            uint32_t kGroupStart = kIter * baseK;
                            uint32_t copyK = min(static_cast<uint32_t>(baseK * stepK), K - kGroupStart);
                            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                            Copy(copyGM2L1Atom, l1ATensor,
                                gmA.Slice(
                                    MakeCoord(batchOffset, MakeCoord(i * baseM, kGroupStart)),
                                    MakeShape(l0BatchSize, MakeShape(curM, copyK))
                                )
                            );
                            Copy(copyGM2L1Atom, l1BTensor,
                                gmB.Slice(
                                    MakeCoord(batchOffset, MakeCoord(kGroupStart, j * baseN)),
                                    MakeShape(l0BatchSize, MakeShape(copyK, curN))
                                )
                            );
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                        }

                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                        Copy(copyL12L0AAtom, l0ATensor,
                            l1ATensor.Slice(
                                MakeCoord(0, MakeCoord(0, kIter % stepK * baseK)),
                                MakeShape(l0BatchSize, MakeShape(curM, curK))
                            )
                        );
                        Copy(copyL12L0BAtom, l0BTensor,
                            l1BTensor.Slice(
                                MakeCoord(0, MakeCoord(kIter % stepK * baseK, 0)),
                                MakeShape(l0BatchSize, MakeShape(curK, curN))
                            )
                        );
                        if ((kIter + 1) % stepK == 0 || kIter + 1 == kLoop) {
                            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                        }
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                        if (kIter == 0) {
                            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);
                        }

                        for (uint32_t l0CBatchIndex = 0; l0CBatchIndex < l0BatchSize; l0CBatchIndex++) {
                            auto cTile = l0CTensor.Slice(
                                MakeCoord(l0CBatchIndex, MakeCoord(0, 0)),
                                MakeShape(1, MakeShape(curM, curN))
                            );
                            auto aTile = l0ATensor.Slice(
                                MakeCoord(l0CBatchIndex, MakeCoord(0, 0)),
                                MakeShape(1, MakeShape(curM, curK))
                            );
                            auto bTile = l0BTensor.Slice(
                                MakeCoord(l0CBatchIndex, MakeCoord(0, 0)),
                                MakeShape(1, MakeShape(curK, curN))
                            );
                            if (kIter == 0) {
                                auto biasTile = l0BiasTensor.Slice(
                                    MakeCoord(l0CBatchIndex, MakeCoord(0, 0)),
                                    MakeShape(1, MakeShape(1, curN))
                                );
                                Mmad(mmadAtom.with(MmadParams{curM, curN, curK, 0, true}),
                                    cTile, aTile, bTile, biasTile);
                            } else {
                                Mmad(mmadAtom.with(MmadParams{curM, curN, curK, 0, false}),
                                    cTile, aTile, bTile);
                            }
                        }

                        if (kIter == 0) {
                            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
                        }
                        if (kIter + 1 == kLoop) {
                            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                        }
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                    }

                    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                    Copy(copyL0C2GMAtom,
                        gmC.Slice(
                            MakeCoord(batchOffset, MakeCoord(i * baseM, j * baseN)),
                            MakeShape(l0BatchSize, MakeShape(curM, curN))
                        ),
                        l0CTensor
                    );
                    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                }
            }
        }
    }

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
}

int32_t main(int32_t argc, char *argv[])
{
    using TYPE = half;
    using BIAS_TYPE = half;
    constexpr uint32_t B = 32;
    constexpr uint32_t L1BatchSize = 16;
    constexpr uint32_t L0BatchSize = 4;

    constexpr uint32_t M = 128;
    constexpr uint32_t N = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t BASE_M = 64;
    constexpr uint32_t BASE_N = 64;
    constexpr uint32_t BASE_K = 32;
    constexpr uint32_t STEP_M = 1;
    constexpr uint32_t STEP_N = 1;
    constexpr uint32_t STEP_K = 4;

    size_t aFileSize = B * M * K * sizeof(TYPE);
    size_t bFileSize = B * K * N * sizeof(TYPE);
    size_t cFileSize = B * M * N * sizeof(TYPE);
    size_t biasFileSize = B * 1 * N * sizeof(BIAS_TYPE);

    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    TYPE *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    TYPE *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *biasHost;
    BIAS_TYPE *biasDevice;
    aclrtMallocHost((void **)(&biasHost), biasFileSize);
    aclrtMalloc((void **)&biasDevice, biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/bias.bin", biasFileSize, biasHost, biasFileSize);
    aclrtMemcpy(biasDevice, biasFileSize, biasHost, biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    TYPE *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    batch_matmul_tensor_api_base<TYPE, BIAS_TYPE, B, M, K, N, L1BatchSize, L0BatchSize,
                                 BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K>
        <<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice, biasDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtFree(biasDevice);
    aclrtFreeHost(biasHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}