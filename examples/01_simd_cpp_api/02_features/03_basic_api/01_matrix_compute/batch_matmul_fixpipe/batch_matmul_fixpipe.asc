/* !
 * \file batch_matmul_fixpipe.asc
 * \brief Verify batched CopyL0C2GM when only L0C and GM C use batch layouts.
 */

#include "acl/acl.h"
#define INCLUDE_C_API_ASC_SIMD_H
#include "include/c_api/utils/union.h"
#include "include/c_api/cube_compute/cube_compute.h"
#include "include/c_api/cube_datamove/cube_datamove.h"
#include "include/c_api/sys_var/sys_var.h"
#include "include/c_api/sync/sync.h"
#include "include/c_api/vector_datamove/vector_datamove.h"
#include "tensor_api/tensor.h"
#include "data_utils.h"

template <uint32_t Value, uint32_t Align>
struct CeilAlign {
    static constexpr uint32_t value = (Value + Align - 1) / Align * Align;
};

enum class FixpipeQuantKind {
    NONE,
    SCALAR,
    VECTOR,
};

template <typename CType>
struct FixpipeQuantScalar {
    static constexpr uint64_t FLOAT32_ONE_BITS = 0x3F800000ULL;
    static constexpr uint64_t INT8_SIGN_BIT =
        AscendC::Std::is_same_v<CType, int8_t> ? (static_cast<uint64_t>(1) << 46) : 0;
    static constexpr uint64_t value = FLOAT32_ONE_BITS | INT8_SIGN_BIT;
};

template <FixpipeQuantKind QuantKind, typename AType, typename CType, typename DstLayoutPattern, uint32_t B, uint32_t M,
          uint32_t K, uint32_t N>
__global__ __cube__ void batch_matmul_fixpipe(
    __gm__ AType* a, __gm__ AType* b, __gm__ CType* c, __gm__ uint64_t* quant)
{
    using namespace AscendC::Te;

    constexpr uint32_t C0 = 32 / sizeof(AType);
    constexpr uint32_t L1_A_SIZE = CeilAlign<M, 16>::value * CeilAlign<K, C0>::value;
    constexpr uint32_t L1_B_SIZE = CeilAlign<K, 16>::value * CeilAlign<N, C0>::value;
    constexpr uint32_t L0_A_SIZE = L1_A_SIZE;
    constexpr uint32_t L0_B_SIZE = CeilAlign<K, C0>::value * CeilAlign<N, 16>::value;
    constexpr uint32_t L0_C_MATRIX_SIZE = CeilAlign<M, 16>::value * CeilAlign<N, 16>::value;

    __cbuf__ AType l1ABuf[L1_A_SIZE];
    __cbuf__ AType l1BBuf[L1_B_SIZE];
    __ca__ AType l0ABuf[L0_A_SIZE];
    __cb__ AType l0BBuf[L0_B_SIZE];
    __cc__ float l0CBuf[B * L0_C_MATRIX_SIZE];
    __cbuf__ uint64_t l1QuantBuf[N];

    auto l1ATensor = MakeTensor(MakeMemPtr(l1ABuf), MakeFrameLayout<NZLayoutPtn, AType>(M, K));
    auto l1BTensor = MakeTensor(MakeMemPtr(l1BBuf), MakeFrameLayout<NZLayoutPtn, AType>(K, N));
    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, AType>(M, K));
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, AType>(K, N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn>(B, M, N));
    auto gmCTensor = MakeTensor(MakeMemPtr(c), MakeFrameLayout<DstLayoutPattern>(B, M, N));
    auto gmQuantTensor = MakeTensor(MakeMemPtr(quant), MakeFrameLayout<NDExtLayoutPtn>(1, N));
    auto l1QuantTensor = MakeTensor(MakeMemPtr(l1QuantBuf), MakeFrameLayout<NDExtLayoutPtn>(1, N));

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    set_flag(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));
    set_flag(PIPE_M, PIPE_MTE1, static_cast<event_t>(0));
    set_flag(PIPE_FIX, PIPE_M, static_cast<event_t>(0));

    wait_flag(PIPE_FIX, PIPE_M, static_cast<event_t>(0));
    for (uint32_t batchIndex = 0; batchIndex < B; ++batchIndex) {
        auto gmATensor = MakeTensor(MakeMemPtr(a + batchIndex * M * K), MakeFrameLayout<NDExtLayoutPtn>(M, K));
        auto gmBTensor = MakeTensor(MakeMemPtr(b + batchIndex * K * N), MakeFrameLayout<NDExtLayoutPtn>(K, N));

        wait_flag(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));
        Copy(copyGM2L1Atom, l1ATensor, gmATensor);
        Copy(copyGM2L1Atom, l1BTensor, gmBTensor);
        set_flag(PIPE_MTE2, PIPE_MTE1, static_cast<event_t>(0));
        wait_flag(PIPE_MTE2, PIPE_MTE1, static_cast<event_t>(0));

        wait_flag(PIPE_M, PIPE_MTE1, static_cast<event_t>(0));
        Copy(copyL12L0AAtom, l0ATensor, l1ATensor);
        Copy(copyL12L0BAtom, l0BTensor, l1BTensor);
        set_flag(PIPE_MTE1, PIPE_M, static_cast<event_t>(0));
        wait_flag(PIPE_MTE1, PIPE_M, static_cast<event_t>(0));
        set_flag(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));

        auto l0CSingleTensor = MakeTensor(MakeMemPtr(l0CBuf + batchIndex * L0_C_MATRIX_SIZE),
                                          MakeFrameLayout<NZLayoutPtn>(M, N));
        Mmad(mmadAtom.with(MmadParams{static_cast<uint16_t>(M), static_cast<uint16_t>(N),
                                      static_cast<uint16_t>(K), 0, true}),
            l0CSingleTensor, l0ATensor, l0BTensor);
        set_flag(PIPE_M, PIPE_MTE1, static_cast<event_t>(0));
    }

    if constexpr (QuantKind == FixpipeQuantKind::VECTOR) {
        wait_flag(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));
        Copy(copyGM2L1Atom, l1QuantTensor, gmQuantTensor);
        set_flag(PIPE_MTE2, PIPE_FIX, static_cast<event_t>(1));
    }

    set_flag(PIPE_M, PIPE_FIX, static_cast<event_t>(0));
    wait_flag(PIPE_M, PIPE_FIX, static_cast<event_t>(0));
    if constexpr (QuantKind == FixpipeQuantKind::SCALAR) {
        Copy(copyL0C2GMAtom, gmCTensor, l0CTensor, FixpipeQuantScalar<CType>::value);
    } else if constexpr (QuantKind == FixpipeQuantKind::VECTOR) {
        wait_flag(PIPE_MTE2, PIPE_FIX, static_cast<event_t>(1));
        Copy(copyL0C2GMAtom, gmCTensor, l0CTensor, l1QuantTensor);
    } else {
        Copy(copyL0C2GMAtom, gmCTensor, l0CTensor);
    }
    set_flag(PIPE_FIX, PIPE_M, static_cast<event_t>(0));

    wait_flag(PIPE_M, PIPE_MTE1, static_cast<event_t>(0));
    if constexpr (QuantKind != FixpipeQuantKind::VECTOR) {
        wait_flag(PIPE_MTE1, PIPE_MTE2, static_cast<event_t>(0));
    }
    wait_flag(PIPE_FIX, PIPE_M, static_cast<event_t>(0));
}

template <FixpipeQuantKind QuantKind, typename AType, typename CType, typename DstLayoutPattern, uint32_t B, uint32_t M,
          uint32_t K, uint32_t N>
void RunBatchMatmulFixpipeCase(
    aclrtStream stream, const char* x1Path, const char* x2Path, const char* outputPath, const char* quantPath = nullptr)
{
    size_t aFileSize = B * M * K * sizeof(AType);
    size_t bFileSize = B * K * N * sizeof(AType);
    size_t cFileSize = B * M * N * sizeof(CType);

    uint8_t *aHost;
    AType *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile(x1Path, aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    AType *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile(x2Path, bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    CType *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* quantHost = nullptr;
    uint64_t* quantDevice = nullptr;
    if constexpr (QuantKind == FixpipeQuantKind::VECTOR) {
        size_t quantFileSize = N * sizeof(uint64_t);
        aclrtMallocHost((void **)(&quantHost), quantFileSize);
        aclrtMalloc((void **)&quantDevice, quantFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(quantPath, quantFileSize, quantHost, quantFileSize);
        aclrtMemcpy(quantDevice, quantFileSize, quantHost, quantFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    batch_matmul_fixpipe<QuantKind, AType, CType, DstLayoutPattern, B, M, K, N><<<1, nullptr, stream>>>(
        aDevice, bDevice, cDevice, quantDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(outputPath, cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    if constexpr (QuantKind == FixpipeQuantKind::VECTOR) {
        aclrtFree(quantDevice);
        aclrtFreeHost(quantHost);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    RunBatchMatmulFixpipeCase<FixpipeQuantKind::NONE, half, float, AscendC::Te::NDExtLayoutPtn, 3, 56, 80, 64>(
        stream, "./input/case1/x1_gm.bin", "./input/case1/x2_gm.bin", "./output/case1/output.bin");
    RunBatchMatmulFixpipeCase<FixpipeQuantKind::NONE, half, half, AscendC::Te::NDExtLayoutPtn, 3, 64, 64, 64>(
        stream, "./input/case2/x1_gm.bin", "./input/case2/x2_gm.bin", "./output/case2/output.bin");
    RunBatchMatmulFixpipeCase<FixpipeQuantKind::NONE, half, half, AscendC::Te::DNExtLayoutPtn, 3, 56, 80, 64>(
        stream, "./input/case3/x1_gm.bin", "./input/case3/x2_gm.bin", "./output/case3/output.bin");
    RunBatchMatmulFixpipeCase<FixpipeQuantKind::NONE, half, float, AscendC::Te::NDExtLayoutPtn, 2, 52, 72, 40>(
        stream, "./input/case4/x1_gm.bin", "./input/case4/x2_gm.bin", "./output/case4/output.bin");
    RunBatchMatmulFixpipeCase<FixpipeQuantKind::SCALAR, half, int8_t, AscendC::Te::NDExtLayoutPtn, 3, 52, 72, 40>(
        stream, "./input/case5/x1_gm.bin", "./input/case5/x2_gm.bin", "./output/case5/output.bin");
    RunBatchMatmulFixpipeCase<FixpipeQuantKind::VECTOR, half, int8_t, AscendC::Te::NDExtLayoutPtn, 3, 52, 72, 40>(
        stream, "./input/case6/x1_gm.bin", "./input/case6/x2_gm.bin", "./output/case6/output.bin",
        "./input/case6/quant_gm.bin");

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
