/* !
 * \file mmad.asc
 * \brief
 */
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t M = M_SIZE;
constexpr uint32_t N = N_SIZE;
constexpr uint32_t K = K_SIZE;
constexpr bool IS_BIAS = ENABLE_BIAS;

template <class T, class U>
class KernelMmad {
public:
    __aicore__ inline KernelMmad()
    {
        cubeSize = 16;
        // 根据不同输入类型设置c0Size
        if constexpr (AscendC::IsSameType<U, AscendC::int4b_t>::value) {
            c0Size = 64;
        } else if constexpr (AscendC::IsSameType<U, int8_t>::value) {
            c0Size = 32;
        } else if constexpr (AscendC::IsSameType<U, bfloat16_t>::value) {
            c0Size = 16;
        } else {
            c0Size = 8;
        }
        fractalSize = cubeSize * c0Size;

        mAlign = CeilAlign(M, cubeSize);
        kAlign = CeilAlign(K, c0Size);
        nAlign = CeilAlign(N, cubeSize);
    }
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR bias, GM_ADDR c)
    {
        aGM.SetGlobalBuffer((__gm__ U *)a);
        bGM.SetGlobalBuffer((__gm__ U *)b);
        biasGM.SetGlobalBuffer((__gm__ T *)bias);
        cGM.SetGlobalBuffer((__gm__ T *)c);

        pipe.InitBuffer(inQueueA1, 1, mAlign * kAlign * sizeof(U));
        pipe.InitBuffer(inQueueA2, 1, mAlign * kAlign * sizeof(U));
        pipe.InitBuffer(inQueueB1, 1, nAlign * kAlign * sizeof(U));
        pipe.InitBuffer(inQueueB2, 1, nAlign * kAlign * sizeof(U));
        pipe.InitBuffer(inQueueC1, 1, CeilAlign(N * sizeof(T), 64));
        pipe.InitBuffer(outQueueC2, 1, CeilAlign(N * sizeof(T), 64));
        pipe.InitBuffer(outQueueCO1, 1, mAlign * nAlign * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        SplitA();
        SplitB();
        if constexpr (IS_BIAS) {
            SplitBias();
        }
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator) 
    {
        return (numerator + denominator - 1) / denominator;
    }

    __aicore__ inline uint16_t CeilAlign(uint16_t size, uint16_t alignValue) {
        return (size + alignValue - 1) / alignValue * alignValue;
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<U> a1Local = inQueueA1.AllocTensor<U>();
        AscendC::LocalTensor<U> b1Local = inQueueB1.AllocTensor<U>();

        // ND -> NZ
        AscendC::Nd2NzParams nd2nzA1Params;
        nd2nzA1Params.ndNum = 1;
        nd2nzA1Params.nValue = M;
        nd2nzA1Params.dValue = K;
        nd2nzA1Params.srcNdMatrixStride = 0;
        nd2nzA1Params.srcDValue = K;
        nd2nzA1Params.dstNzC0Stride = mAlign;
        nd2nzA1Params.dstNzNStride = 1;
        nd2nzA1Params.dstNzMatrixStride = 0;
        if constexpr (AscendC::IsSameType<U, AscendC::int4b_t>::value) {
            // 两个int4b_t合并成int8_t，进行GM-->L1，nd2nz的搬运
            nd2nzA1Params.dValue = K >> 1;
            nd2nzA1Params.srcDValue = K >> 1;
        }
        AscendC::DataCopy(a1Local, aGM, nd2nzA1Params);

        // DN -> ZN
        AscendC::Nd2NzParams nd2nzB1Params;
        nd2nzB1Params.ndNum = 1;
        nd2nzB1Params.nValue = N;
        nd2nzB1Params.dValue = K;
        nd2nzB1Params.srcNdMatrixStride = 0;
        nd2nzB1Params.srcDValue = K;
        nd2nzB1Params.dstNzC0Stride = nAlign;
        nd2nzB1Params.dstNzNStride = 1;
        nd2nzB1Params.dstNzMatrixStride = 0;
        if constexpr (AscendC::IsSameType<U, AscendC::int4b_t>::value) {
            // 两个int4b_t合并成int8_t，进行GM-->L1，nd2nz的搬运
            nd2nzB1Params.dValue = K >> 1;
            nd2nzB1Params.srcDValue = K >> 1;
        }
        AscendC::DataCopy(b1Local, bGM, nd2nzB1Params);

        inQueueA1.EnQue(a1Local);
        inQueueB1.EnQue(b1Local);
        if constexpr (IS_BIAS) {
            AscendC::LocalTensor<T> bias1Local = inQueueC1.AllocTensor<T>();
            // 由于N可能非32B对齐，‘基础数据搬运’无法处理非对齐数据，且‘DataCopyPad’不支持GM到L1的搬运，
            // 因此，使用‘随路转换ND2NZ搬运’实现Bias的GM到L1搬运，确保搬运到L1数据32B对齐。
            AscendC::Nd2NzParams nd2nzC1Params = {1, 1, N, 0, N, 1, 1, 0};
            AscendC::DataCopy(bias1Local, biasGM, nd2nzC1Params);
            inQueueC1.EnQue(bias1Local);
        }
    }

    __aicore__ inline void SplitA()
    {
        AscendC::LocalTensor<U> a1Local = inQueueA1.DeQue<U>();
        AscendC::LocalTensor<U> a2Local = inQueueA2.AllocTensor<U>();

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        // Nz -> Zz，Atlas A2 / A3 系列产品，A2上的数据排布为：ZZ
        uint32_t dstOffset = CeilDivision(K, c0Size) * fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(K, c0Size);
        loadDataParams.srcStride = CeilDivision(M, cubeSize);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        for (int i = 0; i < CeilDivision(M, cubeSize); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        // Nz -> Nz，Ascend 950PR/Ascend 950DT产品，A2上的数据排布为：NZ
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = CeilDivision(M, cubeSize);
        loadDataParams.kStep = CeilDivision(K, c0Size);
        loadDataParams.srcStride = CeilDivision(M, cubeSize);
        loadDataParams.dstStride = CeilDivision(M, cubeSize);
        loadDataParams.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local, loadDataParams);
#endif
        inQueueA2.EnQue<U>(a2Local);
        inQueueA1.FreeTensor(a1Local);
    }
    __aicore__ inline void SplitB()
    {
        AscendC::LocalTensor<U> b1Local = inQueueB1.DeQue<U>();
        AscendC::LocalTensor<U> b2Local = inQueueB2.AllocTensor<U>();

        // Nz -> Nz，B开启转置，B2上的数据排布为：NZ
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(N, cubeSize) * CeilDivision(K, c0Size);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        AscendC::LoadData(b2Local, b1Local, loadDataParams);

        inQueueB1.FreeTensor(b1Local);
        inQueueB2.EnQue<U>(b2Local);
    }

    __aicore__ inline void SplitBias()
    {
        AscendC::LocalTensor<T> bias1Local = inQueueC1.DeQue<T>();
        AscendC::LocalTensor<T> bias2Local = outQueueC2.AllocTensor<T>();
        AscendC::DataCopyParams c12c2Params;
        c12c2Params.blockCount = 1;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        // Atlas A2 / A3 系列产品，C2要求数据64B对齐
        c12c2Params.blockLen = CeilDivision(N, 64 / sizeof(T));
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        // Ascend 950PR/Ascend 950DT产品，C2要求数据32B对齐，且数据类型为int32_t或float时，blockLen为偶数
        c12c2Params.blockLen = CeilAlign(CeilDivision(N, 32 / sizeof(T)), 2);
#endif
        c12c2Params.srcGap = 0;
        c12c2Params.dstGap = 0;
        AscendC::DataCopy(bias2Local, bias1Local, c12c2Params);

        outQueueC2.EnQue<T>(bias2Local);
        inQueueC1.FreeTensor(bias1Local);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<U> a2Local = inQueueA2.DeQue<U>();
        AscendC::LocalTensor<U> b2Local = inQueueB2.DeQue<U>();
        AscendC::LocalTensor<T> co1Local = outQueueCO1.AllocTensor<T>();
        AscendC::MmadParams mmadParams;
        mmadParams.m = M;
        mmadParams.n = N;
        mmadParams.k = K;
        if constexpr (IS_BIAS) {
            mmadParams.cmatrixInitVal = false;  //带bias场景设为false，即通过bias输入的位置判断C矩阵初始值来源是CO1还是C2
            AscendC::LocalTensor<T> bias2Local = outQueueC2.DeQue<T>();
            AscendC::Mmad(co1Local, a2Local, b2Local, bias2Local, mmadParams);
            outQueueC2.FreeTensor(bias2Local);
        } else {
            AscendC::Mmad(co1Local, a2Local, b2Local, mmadParams);
        }
        outQueueCO1.EnQue<T>(co1Local);
        inQueueA2.FreeTensor(a2Local);
        inQueueB2.FreeTensor(b2Local);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> co1Local = outQueueCO1.DeQue<T>();
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = N;
        fixpipeParams.mSize = M;
        fixpipeParams.srcStride = mAlign;
        fixpipeParams.dstStride = N;

        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        AscendC::Fixpipe(cGM, co1Local, fixpipeParams);
        outQueueCO1.FreeTensor(co1Local);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueA1;
    AscendC::TQue<AscendC::TPosition::A2, 1> inQueueA2;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueB1;
    AscendC::TQue<AscendC::TPosition::B2, 1> inQueueB2;
    AscendC::TQue<AscendC::TPosition::C1, 1> inQueueC1;
    AscendC::TQue<AscendC::TPosition::C2, 1> outQueueC2;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQueueCO1;

    AscendC::GlobalTensor<U> aGM;
    AscendC::GlobalTensor<U> bGM;
    AscendC::GlobalTensor<T> biasGM;
    AscendC::GlobalTensor<T> cGM;
    uint16_t cubeSize, c0Size, fractalSize, fractalNum;
    uint16_t mAlign = M, kAlign = K, nAlign = N;
};

extern "C" __global__ __cube__ void mmad_custom(GM_ADDR a, GM_ADDR b, GM_ADDR bias, GM_ADDR c)
{
    if constexpr (scenarioNum == 1) {
        KernelMmad<int32_t, AscendC::int4b_t> op;
        op.Init(a, b, bias, c);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        KernelMmad<int32_t, int8_t> op;
        op.Init(a, b, bias, c);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        KernelMmad<float, bfloat16_t> op;
        op.Init(a, b, bias, c);
        op.Process();
    } else {
        KernelMmad<float, float> op;
        op.Init(a, b, bias, c);
        op.Process();
    }
}

int32_t main(int32_t argc, char *argv[])
{
    size_t aFileSize = 0;
    size_t bFileSize = 0;
    size_t biasFileSize = 0;
    size_t cFileSize = 0;
    if constexpr (scenarioNum == 1) {
        aFileSize = M * K * sizeof(int8_t) / 2;
        bFileSize = K * N * sizeof(int8_t) / 2;
        biasFileSize = N * sizeof(int32_t);
        cFileSize = M * N * sizeof(int32_t);
    } else if constexpr (scenarioNum == 2) {
        aFileSize = M * K * sizeof(int8_t);
        bFileSize = K * N * sizeof(int8_t);
        biasFileSize = N * sizeof(int32_t);
        cFileSize = M * N * sizeof(int32_t);
    } else if constexpr (scenarioNum == 3) {
        aFileSize = M * K * sizeof(bfloat16_t);
        bFileSize = K * N * sizeof(bfloat16_t);
        biasFileSize = N * sizeof(float);
        cFileSize = M * N * sizeof(float);
    } else {
        aFileSize = M * K * sizeof(float);
        bFileSize = K * N * sizeof(float);
        biasFileSize = N * sizeof(float);
        cFileSize = M * N * sizeof(float);
    }
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *biasHost;
    uint8_t *biasDevice;
    if constexpr (IS_BIAS) {
        aclrtMallocHost((void **)(&biasHost), biasFileSize);
        aclrtMalloc((void **)&biasDevice, biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/bias_gm.bin", biasFileSize, biasHost, biasFileSize);
        aclrtMemcpy(biasDevice, biasFileSize, biasHost, biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_custom<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, biasDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    if constexpr (IS_BIAS) {
        aclrtFree(biasDevice);
        aclrtFreeHost(biasHost);
    }
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}