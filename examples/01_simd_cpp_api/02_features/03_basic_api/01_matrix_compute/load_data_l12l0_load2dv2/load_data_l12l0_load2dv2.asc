/* !
 * \file load_data_l12l0_load2dv2.asc
 * \brief 本样例适用于Ascend 950PR/Ascend 950DT，介绍了在矩阵乘法场景下，使用Load2dV2接口将矩阵数据从L1搬运到L0A/L0B的方法。
 *        Ascend 950PR/Ascend 950DT的L0A数据排布格式为Nz（与Atlas A2/A3系列的Zz不同）。
 *        支持int8_t/half/float三种数据类型，共6种转置场景组合：
 *        - A不转置B转置
 *        - A转置B不转置
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t m = M_SIZE;
constexpr uint32_t n = N_SIZE;
constexpr uint32_t k = K_SIZE;

/*
    Ascend 950PR/Ascend 950DT 特点：
    1. L0A数据排布格式为Nz（分形大小为16 * (32B/sizeof(T))）
    2. L0B数据排布格式为Zn（分形大小为(32B/sizeof(T)) * 16）
    3. L1数据排布格式为Nz
    
    isAtranspose为false，表示GM上输入A矩阵不转置，输入为[m, k]，则L1-->L0A时矩阵A不需要转置
    isAtranspose为true，表示GM上输入A矩阵转置，输入为[k, m]，则L1-->L0A时矩阵A需要转置
    
    isBtranspose为false，表示GM上输入B矩阵不转置，输入为[k, n]，则L1-->L0B时矩阵B需要转置
    isBtranspose为true，表示GM上输入B矩阵转置，输入为[n, k]，则L1-->L0B时矩阵B不需要转置
    
    本样例包含两种场景组合：
    - A不转置B转置：scenarioNum = 1,3,5 (int8_t, half, float)
    - A转置B不转置：scenarioNum = 2,4,6 (int8_t, half, float)
*/

template <class T, class U, bool isAtranspose, bool isBtranspose>
class KernelMmadA5 {
public:
    __aicore__ inline KernelMmadA5()
    {
        fractalShape[0] = 16;
        fractalShape[1] = 32 / sizeof(T);
        fractalSize = fractalShape[0] * fractalShape[1];
        fractalSizeBytes = 16 * 32;
        
        if constexpr (sizeof(T) == 1) {
            fractalNum = 2;
        } else if constexpr (sizeof(T) == 2) {
            fractalNum = 1;
        } else {
            fractalNum = 2;
        }

        if constexpr (!isAtranspose) {
            mAlignL1 = CeilAlign(m, fractalShape[0]);
            kAlignL1 = CeilAlign(k, fractalShape[1]);
            aSizeAlignL1 = mAlignL1 * kAlignL1;
            mAlignL0 = CeilAlign(m, fractalShape[0]);
            kAlignL0 = CeilAlign(k, fractalShape[1]);
            aSizeAlignL0 = mAlignL0 * kAlignL0;
        } else {
            kAlignL1 = CeilAlign(k, fractalShape[0] * fractalNum);
            mAlignL1 = CeilAlign(m, fractalShape[1]);
            aSizeAlignL1 = kAlignL1 * mAlignL1;
            mAlignL0 = CeilAlign(m, fractalShape[0] * fractalNum);
            kAlignL0 = CeilAlign(k, fractalShape[1]);
            aSizeAlignL0 = mAlignL0 * kAlignL0;
        }

        if constexpr (!isBtranspose) {
            kAlignL1 = CeilAlign(k, fractalShape[0] * fractalNum);
            nAlignL1 = CeilAlign(n, fractalShape[1]);
            bSizeAlignL1 = kAlignL1 * nAlignL1;
            kAlignL0 = CeilAlign(k, fractalShape[1]);
            nAlignL0 = CeilAlign(n, fractalShape[0] * fractalNum);
            bSizeAlignL0 = kAlignL0 * nAlignL0;
        } else {
            nAlignL1 = CeilAlign(n, fractalShape[0]);
            kAlignL1 = CeilAlign(k, fractalShape[1]);
            bSizeAlignL1 = nAlignL1 * kAlignL1;
            kAlignL0 = CeilAlign(k, fractalShape[1]);
            nAlignL0 = CeilAlign(n, fractalShape[0]);
            bSizeAlignL0 = kAlignL0 * nAlignL0;
        }

        cSizeAlignL0 = CeilAlign(m, 16) * CeilAlign(n, 16);
    }

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        aGM.SetGlobalBuffer((__gm__ T *)a);
        bGM.SetGlobalBuffer((__gm__ T *)b);
        cGM.SetGlobalBuffer((__gm__ U *)c);
        pipe->InitBuffer(inQueueA1, 1, aSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueA2, 1, aSizeAlignL0 * sizeof(T));
        pipe->InitBuffer(inQueueB1, 1, bSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueB2, 1, bSizeAlignL0 * sizeof(T));
        pipe->InitBuffer(outQueueCO1, 1, cSizeAlignL0 * sizeof(U));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        if constexpr (!isAtranspose) {
            SplitA();
        } else {
            SplitATranspose();
        }
        if constexpr (!isBtranspose) {
            SplitBTranspose();
        } else {
            SplitB();
        }
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }

    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.AllocTensor<T>();
        AscendC::LocalTensor<T> b1Local = inQueueB1.AllocTensor<T>();

        AscendC::Nd2NzParams nd2nzA1Params;
        if constexpr (!isAtranspose) {
            nd2nzA1Params.ndNum = 1;
            nd2nzA1Params.nValue = m;
            nd2nzA1Params.dValue = k;
            nd2nzA1Params.srcNdMatrixStride = 0;
            nd2nzA1Params.srcDValue = k;
            nd2nzA1Params.dstNzC0Stride = mAlignL1;
            nd2nzA1Params.dstNzNStride = 1;
            nd2nzA1Params.dstNzMatrixStride = 0;
        } else {
            nd2nzA1Params.ndNum = 1;
            nd2nzA1Params.nValue = k;
            nd2nzA1Params.dValue = m;
            nd2nzA1Params.srcNdMatrixStride = 0;
            nd2nzA1Params.srcDValue = m;
            nd2nzA1Params.dstNzC0Stride = kAlignL1;
            nd2nzA1Params.dstNzNStride = 1;
            nd2nzA1Params.dstNzMatrixStride = 0;
        }
        AscendC::DataCopy(a1Local, aGM, nd2nzA1Params);

        AscendC::Nd2NzParams nd2nzB1Params;
        if constexpr (!isBtranspose) {
            nd2nzB1Params.ndNum = 1;
            nd2nzB1Params.nValue = k;
            nd2nzB1Params.dValue = n;
            nd2nzB1Params.srcNdMatrixStride = 0;
            nd2nzB1Params.srcDValue = n;
            nd2nzB1Params.dstNzC0Stride = kAlignL1;
            nd2nzB1Params.dstNzNStride = 1;
            nd2nzB1Params.dstNzMatrixStride = 0;
        } else {
            nd2nzB1Params.ndNum = 1;
            nd2nzB1Params.nValue = n;
            nd2nzB1Params.dValue = k;
            nd2nzB1Params.srcNdMatrixStride = 0;
            nd2nzB1Params.srcDValue = k;
            nd2nzB1Params.dstNzC0Stride = nAlignL1;
            nd2nzB1Params.dstNzNStride = 1;
            nd2nzB1Params.dstNzMatrixStride = 0;
        }
        AscendC::DataCopy(b1Local, bGM, nd2nzB1Params);

        inQueueA1.EnQue(a1Local);
        inQueueB1.EnQue(b1Local);
    }

    __aicore__ inline void SplitA()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.DeQue<T>();
        AscendC::LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();

        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = CeilDivision(m, fractalShape[0]);
        loadDataParams.kStep = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = CeilDivision(mAlignL1, fractalShape[0]);
        loadDataParams.dstStride = CeilDivision(mAlignL0, fractalShape[0]);
        loadDataParams.ifTranspose = false;
        loadDataParams.sid = 0;

        AscendC::LoadData(a2Local, a1Local, loadDataParams);

        inQueueA2.EnQue<T>(a2Local);
        inQueueA1.FreeTensor(a1Local);
    }

    __aicore__ inline void SplitATranspose()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.DeQue<T>();
        AscendC::LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();

        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;

        if constexpr (sizeof(T) == 1) {
            loadDataParams.mStep = CeilDivision(m, fractalShape[1]);
            loadDataParams.kStep = CeilDivision(k, fractalShape[0] * fractalNum);
        } else if constexpr (sizeof(T) == 2) {
            loadDataParams.mStep = CeilDivision(m, fractalShape[1]);
            loadDataParams.kStep = CeilDivision(k, fractalShape[0]);
        } else {
            loadDataParams.mStep = CeilDivision(m, fractalShape[1] * fractalNum);
            loadDataParams.kStep = CeilDivision(k, fractalShape[0]);
        }

        loadDataParams.srcStride = CeilDivision(kAlignL1, fractalShape[0]);
        loadDataParams.dstStride = CeilDivision(kAlignL0, fractalShape[1]);
        loadDataParams.ifTranspose = true;
        loadDataParams.sid = 0;

        AscendC::LoadData(a2Local, a1Local, loadDataParams);

        inQueueA2.EnQue<T>(a2Local);
        inQueueA1.FreeTensor(a1Local);
    }

    __aicore__ inline void SplitB()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.DeQue<T>();
        AscendC::LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();

        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = CeilDivision(n, fractalShape[0]);
        loadDataParams.kStep = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = CeilDivision(nAlignL1, fractalShape[0]);
        loadDataParams.dstStride = CeilDivision(nAlignL0, fractalShape[0]);
        loadDataParams.ifTranspose = false;
        loadDataParams.sid = 0;

        AscendC::LoadData(b2Local, b1Local, loadDataParams);

        inQueueB1.FreeTensor(b1Local);
        inQueueB2.EnQue<T>(b2Local);
    }

    __aicore__ inline void SplitBTranspose()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.DeQue<T>();
        AscendC::LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();

        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;

        if constexpr (sizeof(T) == 1) {
            loadDataParams.mStep = CeilDivision(n, fractalShape[0] * fractalNum);
            loadDataParams.kStep = CeilDivision(k, fractalShape[1]);
        } else if constexpr (sizeof(T) == 2) {
            loadDataParams.mStep = CeilDivision(n, fractalShape[0]);
            loadDataParams.kStep = CeilDivision(k, fractalShape[1]);
        } else {
            loadDataParams.mStep = CeilDivision(n, fractalShape[0]);
            loadDataParams.kStep = CeilDivision(k, fractalShape[1] * fractalNum);
        }

        loadDataParams.srcStride = CeilDivision(kAlignL1, fractalShape[0]);
        loadDataParams.dstStride = CeilDivision(kAlignL0, fractalShape[1]);
        loadDataParams.ifTranspose = true;
        loadDataParams.sid = 0;

        AscendC::LoadData(b2Local, b1Local, loadDataParams);

        inQueueB1.FreeTensor(b1Local);
        inQueueB2.EnQue<T>(b2Local);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> a2Local = inQueueA2.DeQue<T>();
        AscendC::LocalTensor<T> b2Local = inQueueB2.DeQue<T>();
        AscendC::LocalTensor<U> c1Local = outQueueCO1.AllocTensor<U>();

        AscendC::MmadParams mmadParams;
        mmadParams.m = m;
        mmadParams.n = n;
        mmadParams.k = k;

        if constexpr (sizeof(T) == 1) {
            if constexpr (!isBtranspose) {
                mmadParams.n = CeilAlign(n, fractalShape[0] * fractalNum);
            }
        }

        AscendC::Mmad(c1Local, a2Local, b2Local, mmadParams);

        outQueueCO1.EnQue<U>(c1Local);
        inQueueA2.FreeTensor(a2Local);
        inQueueB2.FreeTensor(b2Local);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> c1Local = outQueueCO1.DeQue<U>();

        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = n;
        fixpipeParams.mSize = m;
        fixpipeParams.srcStride = CeilAlign(m, fractalShape[0]);
        fixpipeParams.dstStride = n;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;

        AscendC::Fixpipe(cGM, c1Local, fixpipeParams);
        outQueueCO1.FreeTensor(c1Local);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueA1;
    AscendC::TQue<AscendC::TPosition::A2, 1> inQueueA2;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueB1;
    AscendC::TQue<AscendC::TPosition::B2, 1> inQueueB2;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQueueCO1;

    AscendC::GlobalTensor<T> aGM;
    AscendC::GlobalTensor<T> bGM;
    AscendC::GlobalTensor<U> cGM;

    uint32_t mAlignL1 = m, kAlignL1 = k, nAlignL1 = n;
    uint32_t mAlignL0 = m, kAlignL0 = k, nAlignL0 = n;
    uint32_t aSizeAlignL1, bSizeAlignL1;
    uint32_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0;
    uint32_t fractalShape[2] = {0, 0};
    uint32_t fractalSize = 0;
    uint32_t fractalSizeBytes = 0;
    uint32_t fractalNum = 0;
};

extern "C" __cube__ __global__ __aicore__ void KernelLoadDataL12L0A5(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::TPipe pipe;

    if constexpr (scenarioNum == 1) {
        KernelMmadA5<int8_t, int32_t, false, true> op;
        op.Init(a, b, c, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        KernelMmadA5<int8_t, int32_t, true, false> op;
        op.Init(a, b, c, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        KernelMmadA5<half, float, false, true> op;
        op.Init(a, b, c, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        KernelMmadA5<half, float, true, false> op;
        op.Init(a, b, c, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 5) {
        KernelMmadA5<float, float, false, true> op;
        op.Init(a, b, c, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 6) {
        KernelMmadA5<float, float, true, false> op;
        op.Init(a, b, c, &pipe);
        op.Process();
    }
}

int32_t main(int32_t argc, char *argv[])
{
    size_t aFileSize = 0;
    size_t bFileSize = 0;
    size_t cFileSize = 0;

    if constexpr (scenarioNum == 1 || scenarioNum == 2) {
        aFileSize = m * k * sizeof(int8_t);
        bFileSize = n * k * sizeof(int8_t);
        cFileSize = m * n * sizeof(int32_t);
    } else if constexpr (scenarioNum == 3 || scenarioNum == 4) {
        aFileSize = m * k * sizeof(half);
        bFileSize = n * k * sizeof(half);
        cFileSize = m * n * sizeof(float);
    } else {
        aFileSize = m * k * sizeof(float);
        bFileSize = n * k * sizeof(float);
        cFileSize = m * n * sizeof(float);
    }
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    KernelLoadDataL12L0A5<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}