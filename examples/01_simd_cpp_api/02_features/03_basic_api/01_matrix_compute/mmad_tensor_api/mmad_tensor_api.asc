/* !
 * \file mmad_tensor_api.asc
 * \brief
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
#include "include/basic_api/kernel_operator_dump_tensor_intf.h"
#include "include/basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

using namespace AscendC::Te;

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t singleCoreK;
};

template <typename A_TYPE, typename B_TYPE, typename C_TYPE, typename D_TYPE, typename SCALE_TYPE, int32_t baseM, int32_t baseN, int32_t baseK, int32_t stepM, int32_t stepN, int32_t stepK>
__cube__ __global__ void dynamic_matmul_with_quant(__gm__ A_TYPE* x, __gm__ B_TYPE* y, __gm__ D_TYPE* z,
                                                  __gm__ SCALE_TYPE* quant, __gm__ MatmulTiling* tilingInfo)
{
    // Copy tiling info from GM to local
    MatmulTiling tiling;
    {
        auto srcPtr = reinterpret_cast<__gm__ int32_t*>(tilingInfo);
        auto dstPtr = reinterpret_cast<int32_t*>(&tiling);
        for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
            dstPtr[i] = srcPtr[i];
        }
    }
    constexpr uint32_t scenarioNum = SCENARIO_NUM;
    uint32_t mIter = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    uint32_t mIterIdx = get_block_idx() % mIter;
    uint32_t nIterIdx = get_block_idx() / mIter;

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t singleCoreM = tiling.singleCoreM;
    int32_t singleCoreN = tiling.singleCoreN;
    int32_t singleCoreK = tiling.singleCoreK;
    int32_t actualSingleCoreM = m - mIterIdx * singleCoreM;
    actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;

    auto gmA = MakeTensor(
        MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ A_TYPE *>(x)), 
        MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<A_TYPE>>(m, k)
    );
    auto gmB = MakeTensor(
        MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ B_TYPE *>(y)), 
        MakeFrameLayout<DNExtLayoutPtn, LayoutTraitDefault<B_TYPE>>(k, n)
    );
    auto gmC = MakeTensor(
        MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ D_TYPE *>(z)), 
        MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<D_TYPE>>(m, n)
    );
    auto gmQuant = MakeTensor(
        MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ SCALE_TYPE*>(quant)), 
        MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<SCALE_TYPE>>(1, n)
    );

    auto gmATensor = gmA.Slice(
        MakeCoord(mIterIdx * singleCoreM, 0), 
        MakeShape(actualSingleCoreM, singleCoreK)
    );
    auto gmBTensor = gmB.Slice(
        MakeCoord(0, nIterIdx * singleCoreN), 
        MakeShape(singleCoreK, singleCoreN)
    );
    auto gmCTensor = gmC.Slice(
        MakeCoord(mIterIdx * singleCoreM, nIterIdx * singleCoreN), 
        MakeShape(actualSingleCoreM, singleCoreN)
    );
    auto gmQuantTensor = gmQuant.Slice(
        MakeCoord(0, nIterIdx * singleCoreN), 
        MakeShape(1, singleCoreN)
    );

    __cbuf__ A_TYPE l1ABuf[baseM * stepM * baseK * stepK];
    __cbuf__ B_TYPE l1BBuf[baseK * stepK * baseN * stepN];
    __cbuf__ SCALE_TYPE l1QuantBuf[baseN * stepN];
    __ca__ A_TYPE l0ABuf[baseM * baseK];
    __cb__ B_TYPE l0BBuf[baseK * baseN];
    __cc__ C_TYPE l0CBuf[baseM * baseN];

    auto l1QuantPtr = MakeMemPtr<Location::L1>(l1QuantBuf);
    auto l0APtr = MakeMemPtr<Location::L0A>(l0ABuf);
    auto l0BPtr = MakeMemPtr<Location::L0B>(l0BBuf);
    auto l0CPtr = MakeMemPtr<Location::L0C>(l0CBuf);

    auto l1ATensor = MakeTensor(
        MakeMemPtr<Location::L1>(l1ABuf), 
        MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<A_TYPE>>(baseM * stepM, baseK * stepK)
    );
    auto l1BTensor = MakeTensor(
        MakeMemPtr<Location::L1>(l1BBuf), 
        MakeFrameLayout<ZNLayoutPtn, LayoutTraitDefault<B_TYPE>>(baseK * stepK, baseN * stepN)
    );

    uint32_t mLoop = (actualSingleCoreM + baseM - 1) / baseM;
    uint32_t nLoop = (singleCoreN + baseN - 1) / baseN;
    uint32_t kLoop = (singleCoreK + baseK - 1) / baseK;

    static constexpr uint32_t L1_EVENT_ID = 0;
    static constexpr uint32_t L0_EVENT_ID = 1;
    static constexpr uint32_t L0C_EVENT_ID = 2;
    static constexpr uint32_t QUANT_EVENT_ID = 3;
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);

    for (uint32_t i = 0; i < mLoop; i++) {
        uint16_t tileM = (i + 1 == mLoop && actualSingleCoreM % baseM != 0) ? actualSingleCoreM % baseM : baseM;
        for (uint32_t j = 0; j < nLoop; j++) {
            uint16_t tileN = (j + 1 == nLoop && singleCoreN % baseN != 0) ? singleCoreN % baseN : baseN;
            auto l0CLayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<>>(tileM, tileN);
            auto l0CTensor = MakeTensor(l0CPtr, l0CLayout);
            auto copyGM2L1 = CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{};
            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                uint16_t tileK = (kIter + 1 == kLoop && singleCoreK % baseK != 0) ? singleCoreK % baseK : baseK;
                auto l0ALayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<A_TYPE>>(tileM, tileK);
                auto l0BLayout = MakeFrameLayout<ZNLayoutPtn, LayoutTraitDefault<B_TYPE>>(tileK, tileN);
                auto l0ATensor = MakeTensor(l0APtr, l0ALayout);
                auto l0BTensor = MakeTensor(l0BPtr, l0BLayout);
                if (kIter % stepK == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
                    // GM -> L1A
                    auto gmASilce = gmATensor.Slice(
                        MakeCoord(i * baseM, kIter * baseK * stepK), 
                        MakeShape(baseM, baseK * stepK)
                    );
                    Copy(copyGM2L1, l1ATensor, gmASilce);
                    // GM -> L1B
                    auto gmBSilce = gmBTensor.Slice(
                        MakeCoord(kIter * baseK * stepK, j * baseN), 
                        MakeShape(baseK * stepK, baseN)
                    );
                    Copy(copyGM2L1, l1BTensor, gmBSilce);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);
                }
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
                // L1A -> L0A
                auto l1ASlice = l1ATensor.Slice(
                    MakeCoord(0, kIter % stepK * baseK), 
                    MakeShape(tileM, tileK)
                );
                Copy(CopyAtom<CopyTraits<CopyL12L0A, CopyL12L0ATraitDefault>>{}, l0ATensor, l1ASlice);
                // L1B -> L0B
                auto l1BSlice = l1BTensor.Slice(
                    MakeCoord(kIter % stepK * baseK, 0), 
                    MakeShape(tileK, tileN)
                );
                Copy(CopyAtom<CopyTraits<CopyL12L0B, CopyL12L0BTraitDefault>>{}, l0BTensor, l1BSlice);
                if ((kIter + 1) % stepK == 0) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);

                // mmad
                if (kIter == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
                }
                MmadParams para;
                para.m = tileM;
                para.n = tileN;
                para.k = tileK;
                para.cmatrixInitVal = (kIter == 0) ? true : false;
                if constexpr (scenarioNum == 1){
                    para.unitFlag = (kIter == kLoop - 1) ? 3 : 2;
                }
                Mmad(MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}, l0CTensor, l0ATensor, l0BTensor, para);
                if (kIter == kLoop - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);
                }

                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
            }
            // L0C -> GM
            AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);
            auto gmCSilce = gmCTensor.Slice(
                MakeCoord(i * baseM, j * baseN), 
                MakeShape(tileM, tileN)
            );
            auto gmQuantSilce = gmQuantTensor.Slice(
                MakeCoord(0, j * baseN), 
                MakeShape(1, tileN)
            );
            auto l1QuantTensor = MakeTensor(
                l1QuantPtr,
                MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<SCALE_TYPE>>(1, tileN)
            );
            Copy(copyGM2L1, l1QuantTensor, gmQuantSilce);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_FIX>(QUANT_EVENT_ID);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_FIX>(QUANT_EVENT_ID);

            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);
            if constexpr (scenarioNum < 2){
                FixpipeParams params;
                if constexpr (scenarioNum == 1){
                    params.unitFlag = 3;
                }
                Copy(CopyAtom<CopyTraits<CopyL0C2GM, CopyL0C2GMTraitDefault>>{}.with(params), gmCSilce, l0CTensor, l1QuantTensor);
            } else {
                Copy(CopyAtom<CopyTraits<CopyL0C2GM, CopyL0C2GMTraitDefault>>{}, gmCSilce, l0CTensor, l1QuantTensor);
            }

            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
            AscendC::SetFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);
        }
    }

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = int8_t;
    using B_TYPE = int8_t;
    using C_TYPE = int32_t;
    using D_TYPE = half;
    using SCALE_TYPE = uint64_t;

    // Tiling info filled into struct (dynamic at runtime)
    MatmulTiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.singleCoreM = 256;
    tiling.singleCoreN = 128;
    tiling.singleCoreK = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t BASE_M = 256;
    constexpr int32_t BASE_N = 256;
    constexpr int32_t BASE_K = 64;
    constexpr int32_t STEP_M = 1;
    constexpr int32_t STEP_N = 1;
    constexpr int32_t STEP_K = 4;

    constexpr uint32_t NUM_BLOCKS = 32;

    size_t param1FileSize = tiling.m * tiling.k * sizeof(A_TYPE);
    size_t param2FileSize = tiling.n * tiling.k * sizeof(B_TYPE);
    size_t param3FileSize = tiling.m * tiling.n * sizeof(D_TYPE);
    size_t param4FileSize = tiling.n * sizeof(SCALE_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost, *quantHost;
    A_TYPE *xDevice;
    B_TYPE *yDevice;
    D_TYPE* zDevice;
    SCALE_TYPE* quantDevice;

    aclrtMallocHost((void**)(&xHost), param1FileSize);
    aclrtMallocHost((void**)(&yHost), param2FileSize);
    aclrtMallocHost((void**)(&zHost), param3FileSize);
    aclrtMallocHost((void**)(&quantHost), param4FileSize);
    aclrtMalloc((void**)&xDevice, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&quantDevice, param4FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1FileSize, xHost, param1FileSize);
    ReadFile("./input/input_y.bin", param2FileSize, yHost, param2FileSize);
    ReadFile("./input/quant.bin", param4FileSize, quantHost, param4FileSize);

    aclrtMemcpy(xDevice, param1FileSize, xHost, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, param2FileSize, yHost, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(quantDevice, param4FileSize, quantHost, param4FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    MatmulTiling *tilingHost;
    MatmulTiling *tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tilingDevice, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tilingHost = tiling;
    aclrtMemcpy(tilingDevice, sizeof(MatmulTiling), tilingHost, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    dynamic_matmul_with_quant<A_TYPE, B_TYPE, C_TYPE, D_TYPE, SCALE_TYPE, BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K><<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice, quantDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, param3FileSize, zDevice, param3FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, param3FileSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFree(quantDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(quantHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
