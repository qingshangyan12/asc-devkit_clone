/* !
 * \file ctrl_spr.asc
 * \brief CTRL寄存器完整操作流程验证，演示SetCtrlSpr、GetCtrlSpr、ResetCtrlSpr的联合使用
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

template <typename T>
class KernelCtrlSpr {
public:
    __aicore__ inline KernelCtrlSpr() {}
    __aicore__ inline void Init(GM_ADDR dstGm, AscendC::TPipe *pipeIn)
    {
        pipe = pipeIn;
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(dstGm));
        pipe->InitBuffer(outQueue, 1, 8 * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.AllocTensor<T>();

        // SetCtrlSpr: 设置CTRL[8:6]比特位值为1，使能原子操作，数据类型为float
        AscendC::SetCtrlSpr<6, 8>(1);
        int32_t eventId1 = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_MTE3));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(eventId1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(eventId1);
        // GetCtrlSpr: 读取CTRL[8:6]比特位的值，验证设置是否成功
        int64_t valueAfterSet = AscendC::GetCtrlSpr<6, 8>();
        AscendC::Duplicate(dstLocal, valueAfterSet, 4);

        // ResetCtrlSpr: 重置CTRL[8:6]比特位，恢复默认状态
        AscendC::ResetCtrlSpr<6, 8>();
        int32_t eventId2 = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_MTE3));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(eventId2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(eventId2);
        // GetCtrlSpr: 再次读取CTRL[8:6]比特位的值，验证重置是否成功
        int64_t valueAfterReset = AscendC::GetCtrlSpr<6, 8>();
        AscendC::Duplicate(dstLocal[4], valueAfterReset, 4);

        outQueue.EnQue(dstLocal);
        CopyOut();
    }
private:
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, 8);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::GlobalTensor<T> dstGlobal;
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
};

extern "C" __global__ __vector__ void kernel_ctrl_spr(GM_ADDR dstGm)
{
    AscendC::TPipe pipe;
    KernelCtrlSpr<int64_t> op;
    op.Init(dstGm, &pipe);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t NUM_BLOCKS = 1;
    size_t outputByteSize = 8 * sizeof(int64_t);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *zHost;
    uint8_t *zDevice;

    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    kernel_ctrl_spr<<<NUM_BLOCKS, nullptr, stream>>>(zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(zDevice);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}