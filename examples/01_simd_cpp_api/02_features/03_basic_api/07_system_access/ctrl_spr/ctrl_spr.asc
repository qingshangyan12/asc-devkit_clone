/* !
 * \file ctrl_spr.asc
 * \brief CTRL寄存器完整操作流程验证，演示SetCtrlSpr、GetCtrlSpr、ResetCtrlSpr的联合使用，并验证原子累加功能
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

template <typename T, uint32_t DATA_SIZE, uint32_t CTRL_SIZE>
class KernelCtrlSpr {
public:
    __aicore__ inline KernelCtrlSpr() {}
    __aicore__ inline void Init(GM_ADDR srcGm, GM_ADDR dstCtrlGm, GM_ADDR dstAtomicAddGm, AscendC::TPipe *pipeIn)
    {
        pipe = pipeIn;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(srcGm) + blockIdx * DATA_SIZE, DATA_SIZE);
        dstCtrlGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(dstCtrlGm) + blockIdx * CTRL_SIZE, CTRL_SIZE);
        dstAtomicAddGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(dstAtomicAddGm), DATA_SIZE);
        
        pipe->InitBuffer(inQueueSrc, 1, DATA_SIZE * sizeof(T));
        pipe->InitBuffer(outQueueCtrl, 1, CTRL_SIZE * sizeof(int64_t));
    }
    
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }
    
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, DATA_SIZE);
        inQueueSrc.EnQue(srcLocal);
        AscendC::SyncAll(); // 核间同步
    }
    
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<int64_t> ctrlLocal = outQueueCtrl.AllocTensor<int64_t>();
        
        AscendC::SetCtrlSpr<6, 8>(1);
        AscendC::SetCtrlSpr<9, 10>(0);
        
        int64_t valueAfterSet86 = AscendC::GetCtrlSpr<6, 8>();
        AscendC::Duplicate(ctrlLocal, valueAfterSet86, CTRL_SIZE / 2);
        
        outQueueCtrl.EnQue(ctrlLocal);
    }
    
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<int64_t> ctrlLocal = outQueueCtrl.DeQue<int64_t>();
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();

        AscendC::DataCopy(dstAtomicAddGlobal, srcLocal, DATA_SIZE);
        
        // 重置寄存器
        AscendC::ResetCtrlSpr<6, 8>();
        AscendC::ResetCtrlSpr<9, 10>();
        
        int64_t valueAfterReset = AscendC::GetCtrlSpr<6, 8>();
        AscendC::Duplicate(ctrlLocal[CTRL_SIZE / 2], valueAfterReset, CTRL_SIZE / 2);
        
        AscendC::DataCopy(dstCtrlGlobal, ctrlLocal, CTRL_SIZE);
        outQueueCtrl.FreeTensor(ctrlLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueCtrl;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstAtomicAddGlobal;
    AscendC::GlobalTensor<int64_t> dstCtrlGlobal;
};

template <uint32_t DATA_SIZE, uint32_t CTRL_SIZE>
__global__ __vector__ void kernel_ctrl_spr(GM_ADDR srcGm, GM_ADDR dstCtrlGm, GM_ADDR dstAtomicAddGm)
{
    AscendC::TPipe pipe;
    KernelCtrlSpr<float, DATA_SIZE, CTRL_SIZE> op;
    op.Init(srcGm, dstCtrlGm, dstAtomicAddGm, &pipe);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t DATA_SIZE = 256;
    constexpr uint32_t CTRL_SIZE = 8;
    constexpr uint32_t NUM_BLOCKS = 2;
    size_t inputByteSize = NUM_BLOCKS * DATA_SIZE * sizeof(float);
    size_t outputCtrlByteSize = NUM_BLOCKS * CTRL_SIZE * sizeof(int64_t);
    size_t outputAtomicAddByteSize = DATA_SIZE * sizeof(float);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *srcHost, *dstCtrlHost, *dstAtomicAddHost;
    uint8_t *srcDevice, *dstCtrlDevice, *dstAtomicAddDevice;

    aclrtMallocHost((void **)(&srcHost), inputByteSize);
    aclrtMallocHost((void **)(&dstCtrlHost), outputCtrlByteSize);
    aclrtMallocHost((void **)(&dstAtomicAddHost), outputAtomicAddByteSize);
    aclrtMalloc((void **)&srcDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&dstCtrlDevice, outputCtrlByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&dstAtomicAddDevice, outputAtomicAddByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input.bin", inputByteSize, srcHost, inputByteSize);
    aclrtMemcpy(srcDevice, inputByteSize, srcHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/dst_init.bin", outputAtomicAddByteSize, dstAtomicAddHost, outputAtomicAddByteSize);
    aclrtMemcpy(dstAtomicAddDevice, outputAtomicAddByteSize, dstAtomicAddHost, outputAtomicAddByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_ctrl_spr<DATA_SIZE, CTRL_SIZE><<<NUM_BLOCKS, nullptr, stream>>>(srcDevice, dstCtrlDevice, dstAtomicAddDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstCtrlHost, outputCtrlByteSize, dstCtrlDevice, outputCtrlByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dstAtomicAddHost, outputAtomicAddByteSize, dstAtomicAddDevice, outputAtomicAddByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    
    WriteFile("./output/output_ctrl.bin", dstCtrlHost, outputCtrlByteSize);
    WriteFile("./output/output_atomic_add.bin", dstAtomicAddHost, outputAtomicAddByteSize);

    aclrtFree(srcDevice);
    aclrtFree(dstCtrlDevice);
    aclrtFree(dstAtomicAddDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(dstCtrlHost);
    aclrtFreeHost(dstAtomicAddHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}