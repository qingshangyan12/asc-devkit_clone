/*!
 * \file set_atomic_add.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include <cstring>

template <typename T>
class KernelSetAtomicAdd {
public:
    __aicore__ inline KernelSetAtomicAdd() {}
    __aicore__ inline void Init(__gm__ uint8_t* src0Gm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn, bool isSaturation)
    {
        pipe = pipeIn;
        isSat = isSaturation;
        src0Global.SetGlobalBuffer((__gm__ T*)src0Gm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        pipe->InitBuffer(inQueueSrc0, 1, 256 * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, 256 * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn()
    {}
    __aicore__ inline void Compute()
    {}

    template <typename DataType>
    __aicore__ inline void SetSaturationMode()
    {
        if constexpr (std::is_same_v<DataType, float> || std::is_same_v<DataType, half> || std::is_same_v<DataType, bfloat16_t>) {
            if (isSat) {
                set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_48_BIT));
            } else {
                set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_48_BIT));
            }
        } else {
            if (isSat) {
                set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_53_BIT));
            } else {
                set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_53_BIT));
            }
        }
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> src0Local = inQueueSrc0.AllocTensor<T>();
        AscendC::DisableDmaAtomic();
        AscendC::DataCopy(src0Local, src0Global, 256);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(0);
        SetSaturationMode<T>();
        AscendC::SetAtomicAdd<T>();
        AscendC::DataCopy(dstGlobal, src0Local, 256);
        AscendC::DisableDmaAtomic();
        inQueueSrc0.FreeTensor(src0Local);
    }
private:
    AscendC::TPipe* pipe;
    bool isSat;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc0;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> src0Global, dstGlobal;
};

template <typename T>
__global__ __vector__ void set_atomic_add_custom(GM_ADDR x, GM_ADDR z, bool isSaturation) 
{
    AscendC::TPipe pipe;
    KernelSetAtomicAdd<T> op;
    op.Init(x, z, &pipe, isSaturation);
    op.Process();
}

template __global__ __vector__ void set_atomic_add_custom<int8_t>(GM_ADDR x, GM_ADDR z, bool isSaturation);
template __global__ __vector__ void set_atomic_add_custom<int16_t>(GM_ADDR x, GM_ADDR z, bool isSaturation);
template __global__ __vector__ void set_atomic_add_custom<half>(GM_ADDR x, GM_ADDR z, bool isSaturation);
template __global__ __vector__ void set_atomic_add_custom<bfloat16_t>(GM_ADDR x, GM_ADDR z, bool isSaturation);
template __global__ __vector__ void set_atomic_add_custom<int32_t>(GM_ADDR x, GM_ADDR z, bool isSaturation);
template __global__ __vector__ void set_atomic_add_custom<float>(GM_ADDR x, GM_ADDR z, bool isSaturation);

enum class DataType : int32_t {
    INT8 = 0,
    INT16 = 1,
    HALF = 2,
    BFLOAT16 = 3,
    INT32 = 4,
    FLOAT = 5
};

template <typename T>
void RunKernel(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)stream;
    (void)xDevice;
    (void)outDevice;
    (void)dtype;
    (void)isSaturation;
}

template <>
void RunKernel<int8_t>(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)dtype;
    set_atomic_add_custom<int8_t><<<3, nullptr, stream>>>(xDevice, outDevice, isSaturation);
}

template <>
void RunKernel<int16_t>(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)dtype;
    set_atomic_add_custom<int16_t><<<3, nullptr, stream>>>(xDevice, outDevice, isSaturation);
}

template <>
void RunKernel<half>(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)dtype;
    set_atomic_add_custom<half><<<3, nullptr, stream>>>(xDevice, outDevice, isSaturation);
}

template <>
void RunKernel<bfloat16_t>(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)dtype;
    set_atomic_add_custom<bfloat16_t><<<3, nullptr, stream>>>(xDevice, outDevice, isSaturation);
}

template <>
void RunKernel<int32_t>(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)dtype;
    set_atomic_add_custom<int32_t><<<3, nullptr, stream>>>(xDevice, outDevice, isSaturation);
}

template <>
void RunKernel<float>(aclrtStream stream, uint8_t* xDevice, uint8_t* outDevice, DataType dtype, bool isSaturation)
{
    (void)dtype;
    set_atomic_add_custom<float><<<3, nullptr, stream>>>(xDevice, outDevice, isSaturation);
}

size_t GetDataTypeSize(DataType dtype)
{
    switch (dtype) {
        case DataType::INT8:     return sizeof(int8_t);
        case DataType::INT16:    return sizeof(int16_t);
        case DataType::HALF:     return sizeof(half);
        case DataType::BFLOAT16: return sizeof(bfloat16_t);
        case DataType::INT32:    return sizeof(int32_t);
        case DataType::FLOAT:    return sizeof(float);
        default:                 return sizeof(float);
    }
}

const char* GetDataTypeName(DataType dtype)
{
    switch (dtype) {
        case DataType::INT8:     return "int8_t";
        case DataType::INT16:    return "int16_t";
        case DataType::HALF:     return "half";
        case DataType::BFLOAT16: return "bfloat16_t";
        case DataType::INT32:    return "int32_t";
        case DataType::FLOAT:    return "float";
        default:                 return "float";
    }
}

int main(int argc, char* argv[]) 
{
    if (argc < 2) {
        printf("Usage: %s <dtype> [saturation] (0=int8, 1=int16, 2=half, 3=bfloat16, 4=int32, 5=float)\n", argv[0]);
        printf("  saturation: 0=non-saturation, 1=saturation (default: 1)\n");
        return -1;
    }
    
    int dtypeIdx = atoi(argv[1]);
    if (dtypeIdx < 0 || dtypeIdx > 5) {
        printf("Invalid dtype: %d\n", dtypeIdx);
        return -1;
    }
    
    int saturation = 1;
    if (argc >= 3) {
        saturation = atoi(argv[2]);
    }
    
    DataType dtype = static_cast<DataType>(dtypeIdx);
    const char* dtypeName = GetDataTypeName(dtype);
    const char* modeName = saturation ? "saturation" : "non-saturation";
    printf("Running with data type: %s, mode: %s\n", dtypeName, modeName);
    
    uint32_t numBlocks = 3; 
    size_t elemCount = 256;
    size_t dataSize = GetDataTypeSize(dtype);
    size_t inputByteSize = elemCount * dataSize;
    size_t outputByteSize = elemCount * dataSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *outHost;
    uint8_t *xDevice, *outDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&outHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    std::string inputPath = "./input/input_x_" + std::string(dtypeName) + ".bin";
    std::string modePrefix = saturation ? "sat" : "non_sat";
    std::string outputPath = "./output/output_" + modePrefix + "_" + std::string(dtypeName) + ".bin";
    ReadFile(inputPath, inputByteSize, xHost, inputByteSize);
    
    memset(outHost, 0, outputByteSize);
    aclrtMemcpy(outDevice, outputByteSize, outHost, outputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    
    switch (dtype) {
        case DataType::INT8:
            RunKernel<int8_t>(stream, xDevice, outDevice, dtype, saturation == 1);
            break;
        case DataType::INT16:
            RunKernel<int16_t>(stream, xDevice, outDevice, dtype, saturation == 1);
            break;
        case DataType::HALF:
            RunKernel<half>(stream, xDevice, outDevice, dtype, saturation == 1);
            break;
        case DataType::BFLOAT16:
            RunKernel<bfloat16_t>(stream, xDevice, outDevice, dtype, saturation == 1);
            break;
        case DataType::INT32:
            RunKernel<int32_t>(stream, xDevice, outDevice, dtype, saturation == 1);
            break;
        case DataType::FLOAT:
            RunKernel<float>(stream, xDevice, outDevice, dtype, saturation == 1);
            break;
    }
    
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(outputPath, outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}