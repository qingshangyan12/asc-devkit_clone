/* !
 * \file cast.asc
 * \brief Cast样例实现，支持half到int32_t和half到int4b_t两种数据类型转换场景
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr int32_t USE_CORE_NUM = 1; // num of core used
constexpr int32_t TOTAL_LENGTH = USE_CORE_NUM * 512;
constexpr int32_t BLOCK_LENGTH = TOTAL_LENGTH / USE_CORE_NUM;  // length computed of each core
constexpr int32_t TILE_NUM = 1;
constexpr int32_t BUFFER_NUM = 1;
constexpr int32_t TILE_LENGTH = BLOCK_LENGTH / TILE_NUM / BUFFER_NUM;

/**
 * @brief Cast核函数类，实现从类型T到类型U的数据类型转换
 * @tparam T 输入数据类型
 * @tparam U 输出数据类型
 */
template <class T, class U>
class KernelCast {
public:
  __aicore__ inline KernelCast() {}
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR out)
  {
    this->blockLength = BLOCK_LENGTH;
    this->tileNum = TILE_NUM;
    ASSERT(tileNum != 0 && "tile num can not be zero!");
    this->tileLength = TILE_LENGTH;

    xGm.SetGlobalBuffer((__gm__ T *)x +
                            this->blockLength * AscendC::GetBlockIdx(),
                        this->blockLength);
    if constexpr (std::is_same_v<U, AscendC::int4b_t>) {
      outGmInt8.SetGlobalBuffer((__gm__ int8_t *)out +
                                    this->blockLength * AscendC::GetBlockIdx() / 2,
                                this->blockLength / 2);
    } else {
      outGm.SetGlobalBuffer((__gm__ U *)out +
                                this->blockLength * AscendC::GetBlockIdx(),
                            this->blockLength);
    }
  }
  __aicore__ inline void Process()
  {
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, TILE_LENGTH>();
    int32_t loopCount = this->tileNum * BUFFER_NUM;

    if constexpr (std::is_same_v<U, AscendC::int4b_t>) {
      AscendC::LocalTensor<int8_t> outLocal = ubAllocator.Alloc<int8_t, TILE_LENGTH / 2>();
      for (int32_t i = 0; i < loopCount; i++) {
        CopyIn(i, xLocal);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        Compute(xLocal, outLocal);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        CopyOut(i, outLocal);
      }
    } else {
      AscendC::LocalTensor<U> outLocal = ubAllocator.Alloc<U, TILE_LENGTH>();
      for (int32_t i = 0; i < loopCount; i++) {
        CopyIn(i, xLocal);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        Compute(xLocal, outLocal);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        CopyOut(i, outLocal);
      }
    }
  }

private:
  __aicore__ inline void CopyIn(int32_t progress, AscendC::LocalTensor<T>& xLocal)
  {
    AscendC::DataCopy(xLocal, xGm[progress * this->tileLength],
                      this->tileLength);
  }
  __aicore__ inline void Compute(AscendC::LocalTensor<T>& xLocal, AscendC::LocalTensor<int8_t>& outLocal)
  {
    // 使用Cast接口进行数据类型转换
    // 参数说明：
    //   - outLocal/outLocalTmp: 输出Tensor，存储转换结果
    //   - xLocal: 输入Tensor
    //   - RoundMode: 转换时的舍入模式
    //   - mask/tileLength: 计算元素个数
    uint64_t mask = 128;
    outLocal.SetSize(this->tileLength / 2);
    AscendC::LocalTensor<AscendC::int4b_t> outLocalTmp = outLocal.ReinterpretCast<AscendC::int4b_t>();
    AscendC::Cast<AscendC::int4b_t, T>(outLocalTmp, xLocal, AscendC::RoundMode::CAST_CEIL, mask,
                                       static_cast<uint8_t>(this->tileLength / 128), {1, 1, 2, 8});
  }
  __aicore__ inline void Compute(AscendC::LocalTensor<T>& xLocal, AscendC::LocalTensor<U>& outLocal)
  {
    AscendC::Cast(outLocal, xLocal, AscendC::RoundMode::CAST_CEIL, this->tileLength);
  }
  __aicore__ inline void CopyOut(int32_t progress, AscendC::LocalTensor<int8_t>& outLocal)
  {
    AscendC::DataCopy(outGmInt8[progress * this->tileLength / 2], outLocal, this->tileLength / 2);
  }
  __aicore__ inline void CopyOut(int32_t progress, AscendC::LocalTensor<U>& outLocal)
  {
    AscendC::DataCopy(outGm[progress * this->tileLength], outLocal, this->tileLength);
  }

private:
  AscendC::GlobalTensor<T> xGm;
  AscendC::GlobalTensor<U> outGm;
  AscendC::GlobalTensor<int8_t> outGmInt8;
  uint32_t blockLength;
  uint32_t tileNum;
  uint32_t tileLength;
};

__global__ __vector__ void cast_custom(GM_ADDR x, GM_ADDR out)
{
  AscendC::InitSocState();
  if constexpr (SCENARIO == 1) { // half to int32_t
    KernelCast<half, int32_t> op;
    op.Init(x, out);
    op.Process();
  } else {                       // half to int4b_t
    KernelCast<half, AscendC::int4b_t> op;
    op.Init(x, out);
    op.Process();
  }
  AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
  uint32_t numBlocks = USE_CORE_NUM;
  size_t inputByteSize = TOTAL_LENGTH * sizeof(half);
  size_t outputByteSize = 0;
  if constexpr (SCENARIO == 1) {
    outputByteSize = TOTAL_LENGTH * sizeof(int32_t);
  } else {
    outputByteSize = TOTAL_LENGTH * sizeof(int8_t) / 2;
  }

  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);

  uint8_t *xHost, *outHost;
  uint8_t *xDevice, *outDevice;

  aclrtMallocHost((void **)(&xHost), inputByteSize);
  aclrtMallocHost((void **)(&outHost), outputByteSize);
  aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
  aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);
  cast_custom<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
  aclrtSynchronizeStream(stream);

  aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  WriteFile("./output/output.bin", outHost, outputByteSize);

  aclrtFree(xDevice);
  aclrtFree(outDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(outHost);

  aclrtDestroyStream(stream);
  aclrtResetDevice(deviceId);
  aclFinalize();

  return 0;
}
