/* !
 * \file interleave_deinterleave.asc
 * \brief 基于Interleave和DeInterleave实现元素交织和解交织功能
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr size_t COUNT = 512;

class KernelInterleave {
public:
    __aicore__ inline KernelInterleave() {}
    __aicore__ inline void Init(
        __gm__ uint8_t* src0Gm, __gm__ uint8_t* src1Gm, 
        __gm__ uint8_t* dst0Gm, __gm__ uint8_t* dst1Gm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        src0Global.SetGlobalBuffer((__gm__ half*)src0Gm);
        src1Global.SetGlobalBuffer((__gm__ half*)src1Gm);
        dst0Global.SetGlobalBuffer((__gm__ half*)dst0Gm);
        dst1Global.SetGlobalBuffer((__gm__ half*)dst1Gm);
        pipe->InitBuffer(inQueueSrc0, 1, COUNT * sizeof(half));
        pipe->InitBuffer(inQueueSrc1, 1, COUNT * sizeof(half));
        pipe->InitBuffer(outQueueDst0, 1, COUNT * sizeof(half));
        pipe->InitBuffer(outQueueDst1, 1, COUNT * sizeof(half));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> src0Local = inQueueSrc0.AllocTensor<half>();
        AscendC::DataCopy(src0Local, src0Global, COUNT);
        inQueueSrc0.EnQue(src0Local);

        AscendC::LocalTensor<half> src1Local = inQueueSrc1.AllocTensor<half>();
        AscendC::DataCopy(src1Local, src1Global, COUNT);
        inQueueSrc1.EnQue(src1Local);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> src0Local = inQueueSrc0.DeQue<half>();
        AscendC::LocalTensor<half> src1Local = inQueueSrc1.DeQue<half>();
        AscendC::LocalTensor<half> dst0Local = outQueueDst0.AllocTensor<half>();
        AscendC::LocalTensor<half> dst1Local = outQueueDst1.AllocTensor<half>();

        AscendC::Duplicate(dst0Local, (half)0, COUNT);
        AscendC::Duplicate(dst1Local, (half)0, COUNT);

        if constexpr (SCENARIO_NUM == 1) {
            AscendC::Interleave(dst0Local, dst1Local, src0Local, src1Local, COUNT);
        } else if constexpr (SCENARIO_NUM == 2) {
            AscendC::DeInterleave(dst0Local, dst1Local, src0Local, src1Local, COUNT);
        }

        inQueueSrc0.FreeTensor(src0Local);
        inQueueSrc1.FreeTensor(src1Local);
        outQueueDst0.EnQue(dst0Local);
        outQueueDst1.EnQue(dst1Local);
    }
    
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dst0Local = outQueueDst0.DeQue<half>();
        AscendC::LocalTensor<half> dst1Local = outQueueDst1.DeQue<half>();
        AscendC::DataCopy(dst0Global, dst0Local, COUNT);
        AscendC::DataCopy(dst1Global, dst1Local, COUNT);
        outQueueDst0.FreeTensor(dst0Local);
        outQueueDst1.FreeTensor(dst1Local);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc0, inQueueSrc1;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst0, outQueueDst1;
    AscendC::GlobalTensor<half> src0Global, src1Global, dst0Global, dst1Global;
};

__global__ __vector__ void interleave_custom(GM_ADDR src0, GM_ADDR src1, GM_ADDR dst0, GM_ADDR dst1)
{
    AscendC::TPipe pipe;
    KernelInterleave op;
    op.Init(src0, src1, dst0, dst1, &pipe);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr size_t numBlocks = 1;
    size_t inputByteSize = COUNT * sizeof(half);
    size_t outputByteSize = COUNT * sizeof(half);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *src0Host, *src1Host, *dst0Host, *dst1Host;
    uint8_t *src0Device, *src1Device, *dst0Device, *dst1Device;

    aclrtMallocHost((void**)(&src0Host), inputByteSize);
    aclrtMallocHost((void**)(&src1Host), inputByteSize);
    aclrtMallocHost((void**)(&dst0Host), outputByteSize);
    aclrtMallocHost((void**)(&dst1Host), outputByteSize);
    aclrtMalloc((void**)&src0Device, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1Device, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst0Device, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst1Device, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_src0.bin", inputByteSize, src0Host, inputByteSize);
    ReadFile("./input/input_src1.bin", inputByteSize, src1Host, inputByteSize);

    aclrtMemcpy(src0Device, inputByteSize, src0Host, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1Device, inputByteSize, src1Host, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    interleave_custom<<<numBlocks, nullptr, stream>>>(src0Device, src1Device, dst0Device, dst1Device);
    
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dst0Host, outputByteSize, dst0Device, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dst1Host, outputByteSize, dst1Device, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_dst0.bin", dst0Host, outputByteSize);
    WriteFile("./output/output_dst1.bin", dst1Host, outputByteSize);

    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dst0Device);
    aclrtFree(dst1Device);
    aclrtFreeHost(src0Host);
    aclrtFreeHost(src1Host);
    aclrtFreeHost(dst0Host);
    aclrtFreeHost(dst1Host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}