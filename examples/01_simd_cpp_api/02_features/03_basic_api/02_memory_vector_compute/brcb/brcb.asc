/* !
 * \file brcb.asc
 * \brief 演示使用Brcb API实现广播复制功能，将输入张量的数据填充到多个datablock中
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

/**
 * @brief Brcb样例的Kernel类，实现广播复制功能，将输入数据填充到多个datablock中
 */
class KernelBrcb {
public:
    __aicore__ inline KernelBrcb()
    {}
    __aicore__ inline void Init(__gm__ uint8_t *x, __gm__ uint8_t *y)
    {
      x_gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t *>(x));
      y_gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t *>(y));
    }
    __aicore__ inline void Process()
    {
      AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
      AscendC::LocalTensor<uint16_t> x_buf = ubAllocator.Alloc<uint16_t, 16>();
      AscendC::LocalTensor<uint16_t> y_buf = ubAllocator.Alloc<uint16_t, 256>();

      CopyIn(x_buf);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      Compute(x_buf, y_buf);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
      CopyOut(y_buf);
    }
    __aicore__ inline void CopyIn(AscendC::LocalTensor<uint16_t>& x_buf)
    {
      AscendC::DataCopy(x_buf, x_gm, 16);
    }
    __aicore__ inline void Compute(AscendC::LocalTensor<uint16_t>& x_buf, AscendC::LocalTensor<uint16_t>& y_buf)
    {
      /*
      执行广播复制操作参数说明:
      y_buf: 目标张量，用于存储结果
      x_buf: 源张量，要广播的数据
      2: 迭代次数
      {1,8}: 广播参数，1: y_buf迭代内间隔1block，8: y_buf迭代间间隔8block
      */
      AscendC::Brcb(y_buf, x_buf, 2, {1,8});
    }
    __aicore__ inline void CopyOut(AscendC::LocalTensor<uint16_t>& y_buf)
    {
      AscendC::DataCopy(y_gm, y_buf, 256);
    }
private:
    AscendC::GlobalTensor<uint16_t> x_gm;
    AscendC::GlobalTensor<uint16_t> y_gm;
};

__global__ __vector__ void brcb_custom(GM_ADDR x, GM_ADDR y)
{
  AscendC::InitSocState();
  KernelBrcb op;
  op.Init(x, y);
  op.Process();
  AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[]) 
{
  size_t inputByteSize = 16 * sizeof(uint16_t);
  size_t outputByteSize = 256 * sizeof(uint16_t);

  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);

  uint8_t *xHost, *outHost;
  uint8_t *xDevice, *outDevice;

  aclrtMallocHost((void **)(&xHost), inputByteSize);
  aclrtMallocHost((void **)(&outHost), outputByteSize);
  aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
  aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);
  brcb_custom<<<1, nullptr, stream>>>(xDevice, outDevice);
  aclrtSynchronizeStream(stream);

  aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  WriteFile("./output/output.bin", outHost, outputByteSize);

  aclrtFree(xDevice);
  aclrtFree(outDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(outHost);

  aclrtDestroyStream(stream);
  aclrtResetDevice(deviceId);
  aclFinalize();

  return 0;
}
