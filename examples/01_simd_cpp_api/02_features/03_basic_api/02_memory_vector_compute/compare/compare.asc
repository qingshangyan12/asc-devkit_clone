/* !
 * \file compare.asc
 * \brief 基于Compare、Compares接口完成多场景下的数据比较功能，实现逐元素大小比较
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

template <typename T, uint32_t INPUT_SIZE, uint32_t INPUT_Y_SIZE, uint32_t OUTPUT_SIZE>
__global__ __vector__ void compare_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<T> src0Global;
    AscendC::GlobalTensor<T> src1Global;
    AscendC::GlobalTensor<uint8_t> dstGlobal;
    src0Global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), INPUT_SIZE);
    src1Global.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), INPUT_Y_SIZE);
    dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(z), OUTPUT_SIZE);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<T> src0Local = ubAllocator.Alloc<T, INPUT_SIZE>();
    AscendC::LocalTensor<T> src1Local = ubAllocator.Alloc<T, INPUT_Y_SIZE>();
    // GetCmpMask requires at least 128 bytes of UB space, while this sample only copies out OUTPUT_SIZE bytes.
    constexpr uint32_t DST_ALLOC_SIZE = (SCENARIO_NUM == 2) ? 128 : OUTPUT_SIZE;
    AscendC::LocalTensor<uint8_t> dstLocal = ubAllocator.Alloc<uint8_t, DST_ALLOC_SIZE>();

    AscendC::DataCopy(src0Local, src0Global, INPUT_SIZE);
    AscendC::DataCopy(src1Local, src1Global, INPUT_Y_SIZE);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    if constexpr (SCENARIO_NUM == 1) {
        AscendC::Compare(dstLocal, src0Local, src1Local, AscendC::CMPMODE::LT, INPUT_SIZE);
    } else if constexpr (SCENARIO_NUM == 2) {
        AscendC::Duplicate(dstLocal.ReinterpretCast<float>(), static_cast<float>(0), 8);
        AscendC::BinaryRepeatParams repeatParams;
        uint32_t mask = 256 / sizeof(T); // 256为每个迭代处理的字节数
        AscendC::Compare(src0Local, src1Local, AscendC::CMPMODE::LT, mask, repeatParams);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::GetCmpMask(dstLocal);
    } else if constexpr (SCENARIO_NUM == 3) {
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID1);
        T src1Scalar = src1Local.GetValue(0);

        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);

        AscendC::Compares(dstLocal, src0Local, static_cast<T>(src1Scalar), AscendC::CMPMODE::LT, INPUT_SIZE);
    } else if constexpr (SCENARIO_NUM == 4) {
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        // 仅Ascend 950PR/Ascend 950DT产品支持，src0Local和src1Local[0]支持互换位置
        AscendC::Compares(dstLocal, src0Local, src1Local[0], AscendC::CMPMODE::LT, INPUT_SIZE);
#endif
    }

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    if constexpr (SCENARIO_NUM == 2) {
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    } else {
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    }
#else
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
#endif
    AscendC::DataCopy(dstGlobal, dstLocal, OUTPUT_SIZE);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t NUM_BLOCKS = 1;

    constexpr size_t INPUT_SIZE = (SCENARIO_NUM == 2) ? 64 : 256;
    constexpr size_t INPUT_Y_SIZE = (SCENARIO_NUM == 1) ? 256 : ((SCENARIO_NUM == 2) ? 64 : 16);
    constexpr size_t OUTPUT_SIZE = 32;

    size_t inputByteSize, inputYByteSize;
    if constexpr (SCENARIO_NUM == 1) {
        inputByteSize = 256 * sizeof(float);
        inputYByteSize = 256 * sizeof(float);
    } else if constexpr (SCENARIO_NUM == 2) {
        inputByteSize = 64 * sizeof(float);
        inputYByteSize = 64 * sizeof(float);
    } else if constexpr (SCENARIO_NUM == 3 || SCENARIO_NUM == 4) {
        inputByteSize = 256 * sizeof(float);
        inputYByteSize = 16 * sizeof(float);
    }
    size_t outputByteSize = 32 * sizeof(uint8_t);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost;
    uint8_t *xDevice, *yDevice, *zDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), inputYByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, inputYByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("./input/input_y.bin", inputYByteSize, yHost, inputYByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, inputYByteSize, yHost, inputYByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    if constexpr (SCENARIO_NUM == 1) {
        compare_custom<float, 256, 256, 32><<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice);
    } else if constexpr (SCENARIO_NUM == 2) {
        compare_custom<float, 64, 64, 32><<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice);
    } else if constexpr (SCENARIO_NUM == 3 || SCENARIO_NUM == 4) {
        compare_custom<float, 256, 16, 32><<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice);
    }

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
