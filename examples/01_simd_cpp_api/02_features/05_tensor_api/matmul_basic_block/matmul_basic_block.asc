/* !
 * \file matmul.asc
 * \brief
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
// #include "include/basic_api/kernel_operator_dump_tensor_intf.h"
// #include "include/basic_api/kernel_operator_block_sync_intf.h"
#include "kernel_operator.h"
#include "data_utils.h"

template <
    typename A_TYPE, typename B_TYPE, typename C_TYPE, uint32_t m, uint32_t n, uint32_t k, uint32_t singleM,
    uint32_t singleN, uint32_t singleK, uint32_t baseM, uint32_t baseN, uint32_t baseK>
__aicore__ void matmul_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    using namespace AscendC::Te;

    static_assert(m % singleM == 0, "m must be divisible by singleM");
    static_assert(n % singleN == 0, "n must be divisible by singleN");
    static_assert(k == singleK, "k must be equal to singleK");
    static_assert(singleM % baseM == 0, "singleM must be divisible by baseM");
    static_assert(singleN % baseN == 0, "singleN must be divisible by baseN");
    static_assert(singleK % baseK == 0, "singleK must be divisible by baseK");

    auto gmPtrA = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ A_TYPE*>(x));
    auto gmPtrB = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ B_TYPE*>(y));
    auto gmPtrC = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ C_TYPE*>(z));

    auto gmA = MakeTensor(gmPtrA, MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<A_TYPE>>(m, k));
    auto gmB = MakeTensor(gmPtrB, MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<B_TYPE>>(k, n));
    auto gmC = MakeTensor(gmPtrC, MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<C_TYPE>>(m, n));

    uint32_t mIter = m / singleM;
    uint32_t mIterIdx = get_block_idx() % mIter;
    uint32_t nIterIdx = get_block_idx() / mIter;

    auto shapeA = MakeShape(singleM, singleK);
    auto globalA = gmA.Slice(MakeCoord(mIterIdx * singleM, 0), shapeA);

    auto shapeB = MakeShape(singleK, singleN);
    auto globalB = gmB.Slice(MakeCoord(0, nIterIdx * singleN), shapeB);

    auto shapeC = MakeShape(singleM, singleN);
    auto globalC = gmC.Slice(MakeCoord(mIterIdx * singleM, nIterIdx * singleN), shapeC);

    auto l1ALayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<A_TYPE>>(baseM, baseK);
    auto l1BLayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<B_TYPE>>(baseK, baseN);
    auto l0ALayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<A_TYPE>>(baseM, baseK);
    auto l0BLayout = MakeFrameLayout<ZNLayoutPtn, LayoutTraitDefault<B_TYPE>>(baseK, baseN);
    auto l0CLayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<>>(baseM, baseN);

    constexpr size_t baseASize = baseM * baseK;
    constexpr size_t baseBSize = baseK * baseN;
    constexpr size_t baseCSize = baseM * baseN;

    __cbuf__ A_TYPE l1ABuf[baseASize];
    __cbuf__ B_TYPE l1BBuf[baseBSize];
    __ca__ A_TYPE l0ABuf[baseASize];
    __cb__ B_TYPE l0BBuf[baseBSize];
    __cc__ C_TYPE l0CBuf[baseCSize];

    auto l1APtr = MakeMemPtr<Location::L1>(l1ABuf);
    auto l1BPtr = MakeMemPtr<Location::L1>(l1BBuf);
    auto l0APtr = MakeMemPtr<Location::L0A>(l0ABuf);
    auto l0BPtr = MakeMemPtr<Location::L0B>(l0BBuf);
    auto l0CPtr = MakeMemPtr<Location::L0C>(l0CBuf);

    auto l1ATensor = MakeTensor(l1APtr, l1ALayout);
    auto l1BTensor = MakeTensor(l1BPtr, l1BLayout);
    auto l0ATensor = MakeTensor(l0APtr, l0ALayout);
    auto l0BTensor = MakeTensor(l0BPtr, l0BLayout);
    auto l0CTensor = MakeTensor(l0CPtr, l0CLayout);

    constexpr uint32_t mLoop = singleM / baseM;
    constexpr uint32_t nLoop = singleN / baseN;
    constexpr uint32_t kLoop = singleK / baseK;

    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);

    for (uint32_t i = 0; i < mLoop; i++) {
        for (uint32_t j = 0; j < nLoop; j++) {
            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                // GM -> L1A
                Copy(
                    CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{}, l1ATensor,
                    globalA.Slice(MakeCoord(i * baseM, kIter * baseK), MakeShape(baseM, baseK)));
                // GM -> L1B
                Copy(
                    CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{}, l1BTensor,
                    globalB.Slice(MakeCoord(kIter * baseK, j * baseN), MakeShape(baseK, baseN)));
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                // L1A -> L0A
                Copy(
                    CopyAtom<CopyTraits<CopyL12L0A, CopyL12L0ATraitDefault>>{}, l0ATensor,
                    l1ATensor.Slice(MakeCoord(0, kIter * baseK), MakeShape(baseM, baseK)));
                // L1B -> L0B
                Copy(
                    CopyAtom<CopyTraits<CopyL12L0B, CopyL12L0BTraitDefault>>{}, l0BTensor,
                    l1BTensor.Slice(MakeCoord(kIter * baseK, 0), MakeShape(baseK, baseN)));

                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);

                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);

                // mmad
                MmadParams para(baseM, baseN, baseK, 0, false);
                para.cmatrixInitVal = (kIter == 0);

                Mmad(
                    MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}.with(para), l0CTensor, l0ATensor,
                    l0BTensor);
            }

            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);

            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParams fixpipeParams;
            // L0C -> GM
            Copy(
                CopyAtom<CopyTraits<CopyL0C2GM, CopyL0C2GMTraitDefault>>{}.with(fixpipeParams),
                globalC.Slice(MakeCoord(i * baseM, j * baseN), MakeShape(baseM, baseN)), l0CTensor);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        }
    }

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}

template <
    typename A_TYPE, typename B_TYPE, typename C_TYPE, uint32_t m, uint32_t n, uint32_t k, uint32_t singleM,
    uint32_t singleN, uint32_t singleK, uint32_t baseM, uint32_t baseN, uint32_t baseK>
__cube__ __global__ __aicore__ void tensor_api_custom(__gm__ uint8_t* aGM, __gm__ uint8_t* bGM, __gm__ uint8_t* cGM)
{
    matmul_custom<A_TYPE, B_TYPE, C_TYPE, m, n, k, singleM, singleN, singleK, baseM, baseN, baseK>(aGM, bGM, cGM);
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 4) {
        fprintf(stderr, "Error: Invalid number of arguments.\n");
        return -1;
    }
    const char* input_x = argv[1];
    const char* input_y = argv[2];
    const char* output = argv[3];

    constexpr uint32_t m = 64;
    constexpr uint32_t n = 64;
    constexpr uint32_t k = 64;
    constexpr uint32_t singleM = 64;
    constexpr uint32_t singleN = 64;
    constexpr uint32_t singleK = 64;
    constexpr uint32_t baseM = 64;
    constexpr uint32_t baseN = 64;
    constexpr uint32_t baseK = 64;
    using A_TYPE = half;
    using B_TYPE = half;
    using C_TYPE = float;

    size_t aFileSize = m * k * sizeof(A_TYPE);
    size_t bFileSize = k * n * sizeof(B_TYPE);
    size_t cFileSize = m * n * sizeof(C_TYPE);
    constexpr uint32_t blockDim = m / singleM * n / singleN;
    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile(input_x, aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile(input_y, bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    tensor_api_custom<A_TYPE, B_TYPE, C_TYPE, m, n, k, singleM, singleN, singleK, baseM, baseN, baseK>
        <<<blockDim, nullptr, stream>>>(aDevice, bDevice, cDevice);

    aclrtSynchronizeStream(stream);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(output, cHost, cFileSize);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
