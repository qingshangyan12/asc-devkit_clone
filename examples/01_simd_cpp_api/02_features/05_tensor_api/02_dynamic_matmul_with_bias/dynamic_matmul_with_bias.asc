/* !
 * \file dynamic_matmul_with_bias.asc
 * \brief
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "include/tensor_api/tensor.h"
#include "include/basic_api/kernel_operator_dump_tensor_intf.h"
#include "include/basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

using namespace AscendC::Te;

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t singleCoreK;
};

template <typename A_TYPE, typename B_TYPE, typename C_TYPE, typename BIAS_TYPE, int32_t baseM, int32_t baseN, int32_t baseK, int32_t stepM, int32_t stepN, int32_t stepK>
__cube__ __global__ void dynamic_matmul_with_bias(__gm__ A_TYPE* x, __gm__ B_TYPE* y, __gm__ C_TYPE* z,
                                                  __gm__ BIAS_TYPE* bias, __gm__ MatmulTiling* tilingInfo)
{
    // Copy tiling info from GM to local
    MatmulTiling tiling;
    {
        auto srcPtr = reinterpret_cast<__gm__ int32_t*>(tilingInfo);
        auto dstPtr = reinterpret_cast<int32_t*>(&tiling);
        for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
            dstPtr[i] = srcPtr[i];
        }
    }

    uint32_t mIter = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    uint32_t mIterIdx = get_block_idx() % mIter;
    uint32_t nIterIdx = get_block_idx() / mIter;

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t singleCoreM = tiling.singleCoreM;
    int32_t singleCoreN = tiling.singleCoreN;
    int32_t singleCoreK = tiling.singleCoreK;
    int32_t actualSingleCoreM = m - mIterIdx * singleCoreM;
    actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;

    auto gmPtrA = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ A_TYPE *>(x));
    auto gmPtrB = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ B_TYPE *>(y));
    auto gmPtrC = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ C_TYPE *>(z));
    auto gmPtrBias = MakeMemPtr<Location::GM>(reinterpret_cast<__gm__ BIAS_TYPE*>(bias));

    auto gmA = MakeTensor(gmPtrA, MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<A_TYPE>>(m, k));
    auto gmB = MakeTensor(gmPtrB, MakeFrameLayout<DNExtLayoutPtn, LayoutTraitDefault<B_TYPE>>(k, n));
    auto gmC = MakeTensor(gmPtrC, MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<C_TYPE>>(m, n));
    auto gmBias = MakeTensor(gmPtrBias, MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<BIAS_TYPE>>(1, n));

    auto shapeA = MakeShape(actualSingleCoreM, singleCoreK);
    auto globalA = gmA.Slice(MakeCoord(mIterIdx * singleCoreM, 0), shapeA);

    auto shapeB = MakeShape(singleCoreK, singleCoreN);
    auto globalB = gmB.Slice(MakeCoord(0, nIterIdx * singleCoreN), shapeB);

    auto shapeC = MakeShape(actualSingleCoreM, singleCoreN);
    auto globalC = gmC.Slice(MakeCoord(mIterIdx * singleCoreM, nIterIdx * singleCoreN), shapeC);

    auto shapeBias = MakeShape(1, singleCoreN);
    auto globalBias = gmBias.Slice(MakeCoord(0, nIterIdx * singleCoreN), shapeBias);

    auto l1ALayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<A_TYPE>>(baseM * stepM, baseK * stepK);
    auto l1BLayout = MakeFrameLayout<ZNLayoutPtn, LayoutTraitDefault<B_TYPE>>(baseK * stepK, baseN * stepN);
    auto l1BiasLayout = MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<BIAS_TYPE>>(1, baseN * stepN);

    __cbuf__ A_TYPE l1ABuf[baseM * stepM * baseK * stepK];
    __cbuf__ B_TYPE l1BBuf[baseK * stepK * baseN * stepN];
    __cbuf__ BIAS_TYPE l1BiasBuf[baseN * stepN];
    __ca__ A_TYPE l0ABuf[baseM * baseK];
    __cb__ B_TYPE l0BBuf[baseK * baseN];
    __biasbuf__ BIAS_TYPE l0BiasBuf[baseN];
    __cc__ C_TYPE l0CBuf[baseM * baseN];

    auto l1APtr = MakeMemPtr<Location::L1>(l1ABuf);
    auto l1BPtr = MakeMemPtr<Location::L1>(l1BBuf);
    auto l1BiasPtr = MakeMemPtr<Location::L1>(l1BiasBuf);
    auto l0APtr = MakeMemPtr<Location::L0A>(l0ABuf);
    auto l0BPtr = MakeMemPtr<Location::L0B>(l0BBuf);
    auto l0BiasPtr = MakeMemPtr<Location::BIAS>(l0BiasBuf);
    auto l0CPtr = MakeMemPtr<Location::L0C>(l0CBuf);

    auto l1ATensor = MakeTensor(l1APtr, l1ALayout);
    auto l1BTensor = MakeTensor(l1BPtr, l1BLayout);
    auto l1BiasTensor = MakeTensor(l1BiasPtr, l1BiasLayout);

    uint32_t mLoop = (actualSingleCoreM + baseM - 1) / baseM;
    uint32_t nLoop = (singleCoreN + baseN - 1) / baseN;
    uint32_t kLoop = (singleCoreK + baseK - 1) / baseK;

    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);

    for (uint32_t i = 0; i < mLoop; i++) {
        uint16_t tileM = (i + 1 == mLoop && actualSingleCoreM % baseM != 0) ? actualSingleCoreM % baseM : baseM;
        for (uint32_t j = 0; j < nLoop; j++) {
            uint16_t tileN = (j + 1 == nLoop && singleCoreN % baseN != 0) ? singleCoreN % baseN : baseN;
            auto l0CLayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<>>(tileM, tileN);
            auto l0CTensor = MakeTensor(l0CPtr, l0CLayout);
            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                uint16_t tileK = (kIter + 1 == kLoop && singleCoreK % baseK != 0) ? singleCoreK % baseK : baseK;
                auto l0ALayout = MakeFrameLayout<NZLayoutPtn, LayoutTraitDefault<A_TYPE>>(tileM, tileK);
                auto l0BLayout = MakeFrameLayout<ZNLayoutPtn, LayoutTraitDefault<B_TYPE>>(tileK, tileN);
                auto l0BiasLayout = MakeFrameLayout<NDExtLayoutPtn, LayoutTraitDefault<BIAS_TYPE>>(1, tileN);
                auto l0ATensor = MakeTensor(l0APtr, l0ALayout);
                auto l0BTensor = MakeTensor(l0BPtr, l0BLayout);
                auto l0BiasTensor = MakeTensor(l0BiasPtr, l0BiasLayout);
                if (kIter % stepK == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                    // GM -> L1A
                    Copy(CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{}, l1ATensor, globalA.Slice(
                        MakeCoord(i * baseM, kIter * baseK * stepK), MakeShape(baseM, baseK * stepK)));
                    // GM -> L1B
                    Copy(CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{}, l1BTensor, globalB.Slice(
                        MakeCoord(kIter * baseK * stepK, j * baseN), MakeShape(baseK * stepK, baseN)));
                    // GM -> L1Bias
                    Copy(CopyAtom<CopyTraits<CopyGM2L1, CopyGM2L1TraitDefault>>{}, l1BiasTensor, globalBias.Slice(
                        MakeCoord(0, j * baseN), MakeShape(1, baseN)));
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                // L1A -> L0A
                Copy(CopyAtom<CopyTraits<CopyL12L0A, CopyL12L0ATraitDefault>>{}, l0ATensor, l1ATensor.Slice(
                    MakeCoord(0, kIter % stepK * baseK), MakeShape(tileM, tileK)));
                // L1B -> L0B
                Copy(CopyAtom<CopyTraits<CopyL12L0B, CopyL12L0BTraitDefault>>{}, l0BTensor, l1BTensor.Slice(
                    MakeCoord(kIter % stepK * baseK, 0), MakeShape(tileK, tileN)));
                // L1Bias -> Bt
                Copy(CopyAtom<CopyTraits<CopyL12BT, CopyL12BTTraitDefault>>{}, l0BiasTensor, l1BiasTensor.Slice(
                    MakeCoord(0, 0), MakeShape(1, tileN)));
                if ((kIter + 1) % stepK == 0) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                if (kIter % stepK == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                }

                // mmad
                MmadParams para;
                para.m = tileM;
                para.n = tileN;
                para.k = tileK;
                if (kIter == 0) {
                    para.cmatrixInitVal = true;
                    Mmad(MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}, l0CTensor, l0ATensor, l0BTensor, l0BiasTensor, para);
                } else {
                    para.cmatrixInitVal = false;
                    Mmad(MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}, l0CTensor, l0ATensor, l0BTensor, para);
                }
                if (kIter == kLoop - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
            }
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            // L0C -> GM
            Copy(CopyAtom<CopyTraits<CopyL0C2GM, CopyL0C2GMTraitDefault>>{}, globalC.Slice(
                MakeCoord(i * baseM, j * baseN), MakeShape(tileM, tileN)), l0CTensor);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        }
    }

    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = half;
    using B_TYPE = half;
    using C_TYPE = float;
    using BIAS_TYPE = float;

    // Tiling info filled into struct (dynamic at runtime)
    MatmulTiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.singleCoreM = 256;
    tiling.singleCoreN = 128;
    tiling.singleCoreK = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t BASE_M = 256;
    constexpr int32_t BASE_N = 256;
    constexpr int32_t BASE_K = 64;
    constexpr int32_t STEP_M = 1;
    constexpr int32_t STEP_N = 1;
    constexpr int32_t STEP_K = 4;

    constexpr uint32_t NUM_BLOCKS = 32;

    size_t param1FileSize = tiling.m * tiling.k * sizeof(A_TYPE);
    size_t param2FileSize = tiling.n * tiling.k * sizeof(B_TYPE);
    size_t param3FileSize = tiling.m * tiling.n * sizeof(C_TYPE);
    size_t param4FileSize = tiling.n * sizeof(BIAS_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost, *biasHost;
    A_TYPE *xDevice;
    B_TYPE *yDevice;
    C_TYPE* zDevice;
    BIAS_TYPE* biasDevice;

    aclrtMallocHost((void**)(&xHost), param1FileSize);
    aclrtMallocHost((void**)(&yHost), param2FileSize);
    aclrtMallocHost((void**)(&zHost), param3FileSize);
    aclrtMallocHost((void**)(&biasHost), param4FileSize);
    aclrtMalloc((void**)&xDevice, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&biasDevice, param4FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1FileSize, xHost, param1FileSize);
    ReadFile("./input/input_y.bin", param2FileSize, yHost, param2FileSize);
    ReadFile("./input/bias.bin", param4FileSize, biasHost, param4FileSize);

    aclrtMemcpy(xDevice, param1FileSize, xHost, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, param2FileSize, yHost, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(biasDevice, param4FileSize, biasHost, param4FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    MatmulTiling *tilingHost;
    MatmulTiling *tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tilingDevice, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tilingHost = tiling;
    aclrtMemcpy(tilingDevice, sizeof(MatmulTiling), tilingHost, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    dynamic_matmul_with_bias<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K><<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice, biasDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, param3FileSize, zDevice, param3FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, param3FileSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFree(biasDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(biasHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
