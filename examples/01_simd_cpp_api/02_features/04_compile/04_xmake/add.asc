/* !
 * \file add.asc
 * \brief xmake-based Ascend C API Add sample.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

using DTYPE_X = float;
using DTYPE_Y = float;
using DTYPE_Z = float;

constexpr uint32_t BLOCK_NUM = 8;
constexpr uint32_t TOTAL_LENGTH = 1024;
constexpr uint32_t BLOCK_LENGTH = TOTAL_LENGTH / BLOCK_NUM;
constexpr uint32_t BLOCK_BYTES = BLOCK_LENGTH * sizeof(DTYPE_X);
constexpr int32_t DEVICE_ID = 0;

static_assert(TOTAL_LENGTH % BLOCK_NUM == 0, "TOTAL_LENGTH must be divisible by BLOCK_NUM.");
static_assert(BLOCK_BYTES % 32 == 0, "The data size processed by each block must be 32-byte aligned.");

__vector__ __global__ __aicore__ void add_custom(__gm__ DTYPE_X* x, __gm__ DTYPE_Y* y, __gm__ DTYPE_Z* z)
{
    asc_init();

    uint32_t blockLength = TOTAL_LENGTH / asc_get_block_num();
    uint32_t blockIdx = asc_get_block_idx();
    __gm__ DTYPE_X* xGm = x + blockIdx * blockLength;
    __gm__ DTYPE_Y* yGm = y + blockIdx * blockLength;
    __gm__ DTYPE_Z* zGm = z + blockIdx * blockLength;

    __ubuf__ DTYPE_X xLocal[BLOCK_LENGTH];
    __ubuf__ DTYPE_Y yLocal[BLOCK_LENGTH];
    __ubuf__ DTYPE_Z zLocal[BLOCK_LENGTH];

    asc_copy_gm2ub((__ubuf__ void*)xLocal, (__gm__ void*)xGm, blockLength * sizeof(DTYPE_X));
    asc_copy_gm2ub((__ubuf__ void*)yLocal, (__gm__ void*)yGm, blockLength * sizeof(DTYPE_Y));
    asc_sync();

    asc_add(zLocal, xLocal, yLocal, blockLength);
    asc_sync();

    asc_copy_ub2gm((__gm__ void*)zGm, (__ubuf__ void*)zLocal, blockLength * sizeof(DTYPE_Z));
    asc_sync();
}

namespace {
void CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        throw std::runtime_error(std::string(expr) + " failed, ret = " + std::to_string(static_cast<int32_t>(ret)));
    }
}

void InitInput(std::vector<DTYPE_X>& x, std::vector<DTYPE_Y>& y, std::vector<DTYPE_Z>& golden)
{
    std::fill(x.begin(), x.end(), static_cast<DTYPE_X>(1.0F));
    std::fill(y.begin(), y.end(), static_cast<DTYPE_Y>(2.0F));
    std::fill(golden.begin(), golden.end(), static_cast<DTYPE_Z>(3.0F));
}

bool VerifyResult(const std::vector<DTYPE_Z>& output, const std::vector<DTYPE_Z>& golden)
{
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        return true;
    }
    std::cerr << "test failed" << std::endl;
    return false;
}
} // namespace

int32_t main()
{
    // ---- prepare input ----
    std::vector<DTYPE_X> inputX(TOTAL_LENGTH);
    std::vector<DTYPE_Y> inputY(TOTAL_LENGTH);
    std::vector<DTYPE_Z> output(TOTAL_LENGTH, static_cast<DTYPE_Z>(0.0F));
    std::vector<DTYPE_Z> golden(TOTAL_LENGTH);
    InitInput(inputX, inputY, golden);

    // ---- init ACL & alloc device memory ----
    DTYPE_X* inputXDevice = nullptr;
    DTYPE_Y* inputYDevice = nullptr;
    DTYPE_Z* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;

    auto cleanup = [&]() noexcept {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
            stream = nullptr;
        }
        if (inputXDevice != nullptr) {
            (void)aclrtFree(inputXDevice);
            inputXDevice = nullptr;
        }
        if (inputYDevice != nullptr) {
            (void)aclrtFree(inputYDevice);
            inputYDevice = nullptr;
        }
        if (outputDevice != nullptr) {
            (void)aclrtFree(outputDevice);
            outputDevice = nullptr;
        }
        if (deviceSet) {
            (void)aclrtResetDevice(DEVICE_ID);
            deviceSet = false;
        }
        if (aclInitialized) {
            (void)aclFinalize();
            aclInitialized = false;
        }
    };

    try {
        CheckAcl(aclInit(nullptr), "aclInit");
        aclInitialized = true;
        CheckAcl(aclrtSetDevice(DEVICE_ID), "aclrtSetDevice");
        deviceSet = true;
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
        CheckAcl(
            aclrtMalloc(
                reinterpret_cast<void**>(&inputXDevice), TOTAL_LENGTH * sizeof(DTYPE_X), ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc inputX");
        CheckAcl(
            aclrtMalloc(
                reinterpret_cast<void**>(&inputYDevice), TOTAL_LENGTH * sizeof(DTYPE_Y), ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc inputY");
        CheckAcl(
            aclrtMalloc(
                reinterpret_cast<void**>(&outputDevice), TOTAL_LENGTH * sizeof(DTYPE_Z), ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc output");

        // ---- copy input to device ----
        CheckAcl(
            aclrtMemcpy(
                inputXDevice, TOTAL_LENGTH * sizeof(DTYPE_X), inputX.data(), TOTAL_LENGTH * sizeof(DTYPE_X),
                ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy inputX");
        CheckAcl(
            aclrtMemcpy(
                inputYDevice, TOTAL_LENGTH * sizeof(DTYPE_Y), inputY.data(), TOTAL_LENGTH * sizeof(DTYPE_Y),
                ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy inputY");

        // ---- launch kernel ----
        add_custom<<<BLOCK_NUM, nullptr, stream>>>(inputXDevice, inputYDevice, outputDevice);
        CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

        // ---- copy output back ----
        CheckAcl(
            aclrtMemcpy(
                output.data(), TOTAL_LENGTH * sizeof(DTYPE_Z), outputDevice, TOTAL_LENGTH * sizeof(DTYPE_Z),
                ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy output");
    } catch (const std::exception& error) {
        std::cerr << error.what() << std::endl;
        cleanup();
        return 1;
    }

    cleanup();

    // ---- verify ----
    if (!VerifyResult(output, golden)) {
        return 1;
    }

    std::cout << "test pass!" << std::endl;
    return 0;
}
