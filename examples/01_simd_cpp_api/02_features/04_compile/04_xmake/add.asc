/* !
 * \file add.asc
 * \brief xmake-based Ascend C C_API Add sample.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <iterator>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TILE_LENGTH = 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t TOTAL_LENGTH = NUM_BLOCKS * TILE_LENGTH;
constexpr int32_t DEVICE_ID = 0;

__vector__ __global__ __aicore__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    // C_API kernel entry: initialize SIMD runtime state (equivalent to InitSocState in C++ API).
    asc_init();

    __ubuf__ float xLocal[TILE_LENGTH];
    __ubuf__ float yLocal[TILE_LENGTH];
    __ubuf__ float zLocal[TILE_LENGTH];

    // Use builtin block_idx (portable across C_API samples).
    uint32_t blockLength = TOTAL_LENGTH / static_cast<uint32_t>(asc_get_block_num());
    __gm__ float* xGm = x + block_idx * blockLength;
    __gm__ float* yGm = y + block_idx * blockLength;
    __gm__ float* zGm = z + block_idx * blockLength;

    // GM -> UB, compute, then UB -> GM. Sync variants ensure pipeline completion.
    asc_copy_gm2ub_sync(xLocal, xGm, blockLength * sizeof(float));
    asc_copy_gm2ub_sync(yLocal, yGm, blockLength * sizeof(float));
    asc_add_sync(zLocal, xLocal, yLocal, blockLength);
    asc_copy_ub2gm_sync(zGm, zLocal, blockLength * sizeof(float));
}

namespace {
void CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        throw std::runtime_error(std::string(expr) + " failed, ret = " + std::to_string(static_cast<int32_t>(ret)));
    }
}

std::vector<float> KernelAdd(std::vector<float>& x, std::vector<float>& y)
{
    size_t totalByteSize = TOTAL_LENGTH * sizeof(float);
    float* xDevice = nullptr;
    float* yDevice = nullptr;
    float* zDevice = nullptr;
    uint8_t* zHost = nullptr;
    aclrtStream stream = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;

    auto cleanup = [&]() noexcept {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
            stream = nullptr;
        }
        if (xDevice != nullptr) {
            (void)aclrtFree(xDevice);
            xDevice = nullptr;
        }
        if (yDevice != nullptr) {
            (void)aclrtFree(yDevice);
            yDevice = nullptr;
        }
        if (zDevice != nullptr) {
            (void)aclrtFree(zDevice);
            zDevice = nullptr;
        }
        if (zHost != nullptr) {
            (void)aclrtFreeHost(zHost);
            zHost = nullptr;
        }
        if (deviceSet) {
            (void)aclrtResetDevice(DEVICE_ID);
            deviceSet = false;
        }
        if (aclInitialized) {
            (void)aclFinalize();
            aclInitialized = false;
        }
    };

    try {
        CheckAcl(aclInit(nullptr), "aclInit");
        aclInitialized = true;
        CheckAcl(aclrtSetDevice(DEVICE_ID), "aclrtSetDevice");
        deviceSet = true;
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&zHost), totalByteSize), "aclrtMallocHost");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&xDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc xDevice");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&yDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc yDevice");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&zDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc zDevice");

        CheckAcl(
            aclrtMemcpy(xDevice, totalByteSize, x.data(), totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy xDevice");
        CheckAcl(
            aclrtMemcpy(yDevice, totalByteSize, y.data(), totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy yDevice");

        add_custom<<<NUM_BLOCKS, 0, stream>>>(xDevice, yDevice, zDevice);
        CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

        CheckAcl(
            aclrtMemcpy(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy zHost");
    } catch (...) {
        cleanup();
        throw;
    }

    std::vector<float> z(reinterpret_cast<float*>(zHost), reinterpret_cast<float*>(zHost + totalByteSize));
    cleanup();
    return z;
}

uint32_t VerifyResult(std::vector<float>& output, std::vector<float>& golden)
{
    auto printTensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    }
    std::cout << "test failed!" << std::endl;
    return 1;
}
} // namespace

int32_t main()
{
    std::vector<float> x(TOTAL_LENGTH);
    std::vector<float> y(TOTAL_LENGTH);
    for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
        x[i] = static_cast<float>(i) * 0.1F;
        y[i] = static_cast<float>(i) * 0.1F;
    }

    try {
        std::vector<float> output = KernelAdd(x, y);
        std::vector<float> golden(TOTAL_LENGTH);
        for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
            golden[i] = x[i] + y[i];
        }
        return static_cast<int32_t>(VerifyResult(output, golden));
    } catch (const std::exception& error) {
        std::cerr << error.what() << std::endl;
        return 1;
    }
}
