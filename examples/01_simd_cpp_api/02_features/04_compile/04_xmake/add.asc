/* !
 * \file add.asc
 * \brief xmake-based Ascend C Add sample with tiling and double buffering.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"

struct AddCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

constexpr int32_t BUFFER_NUM = 2;
constexpr uint32_t BLOCK_NUM = 8;
constexpr uint32_t TILE_NUM = 8;
constexpr uint32_t TOTAL_LENGTH = 1024;

using DTYPE_X = float;
using DTYPE_Y = float;
using DTYPE_Z = float;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        ascendc_assert(tileNum != 0, "tileNum can not be zero.\n");
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;

        xGm.SetGlobalBuffer((__gm__ DTYPE_X *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ DTYPE_Y *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ DTYPE_Z *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(DTYPE_X));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(DTYPE_Y));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(DTYPE_Z));
    }
    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<DTYPE_X> xLocal = inQueueX.AllocTensor<DTYPE_X>();
        AscendC::LocalTensor<DTYPE_Y> yLocal = inQueueY.AllocTensor<DTYPE_Y>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<DTYPE_X> xLocal = inQueueX.DeQue<DTYPE_X>();
        AscendC::LocalTensor<DTYPE_Y> yLocal = inQueueY.DeQue<DTYPE_Y>();
        AscendC::LocalTensor<DTYPE_Z> zLocal = outQueueZ.AllocTensor<DTYPE_Z>();
        AscendC::Add(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<DTYPE_Z>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<DTYPE_Z> zLocal = outQueueZ.DeQue<DTYPE_Z>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<DTYPE_X> xGm;
    AscendC::GlobalTensor<DTYPE_Y> yGm;
    AscendC::GlobalTensor<DTYPE_Z> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__aicore__ inline void CopyTiling(AddCustomTilingData *tiling, GM_ADDR tilingGM)
{
    uint32_t *ptr = reinterpret_cast<uint32_t *>(tiling);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t *>(tilingGM);
    for (uint32_t i = 0; i < sizeof(AddCustomTilingData) / sizeof(uint32_t); i++, ptr++) {
        *ptr = *(tiling32 + i);
    }
}

extern "C" __global__ __aicore__ void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR workspace, GM_ADDR tiling)
{
    REGISTER_TILING_DEFAULT(AddCustomTilingData);
    AddCustomTilingData tilingData;
    CopyTiling(&tilingData, tiling);
    KernelAdd op;
    op.Init(x, y, z, tilingData.totalLength, tilingData.tileNum);
    op.Process();
}

namespace {
bool CheckAcl(aclError ret, const char *expr)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::cerr << expr << " failed, ret = " << ret << std::endl;
    return false;
}

void InitInput(std::vector<DTYPE_X> &x, std::vector<DTYPE_Y> &y, std::vector<DTYPE_Z> &golden)
{
    std::fill(x.begin(), x.end(), static_cast<DTYPE_X>(1.0F));
    std::fill(y.begin(), y.end(), static_cast<DTYPE_Y>(2.0F));
    std::fill(golden.begin(), golden.end(), static_cast<DTYPE_Z>(3.0F));
}

bool VerifyResult(const std::vector<DTYPE_Z> &output, const std::vector<DTYPE_Z> &golden)
{
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        return true;
    }
    std::cerr << "test failed" << std::endl;
    return false;
}
} // namespace

int32_t main(int32_t argc, char *argv[])
{
    // ---- prepare input ----
    std::vector<DTYPE_X> inputX(TOTAL_LENGTH);
    std::vector<DTYPE_Y> inputY(TOTAL_LENGTH);
    std::vector<DTYPE_Z> output(TOTAL_LENGTH, static_cast<DTYPE_Z>(0.0F));
    std::vector<DTYPE_Z> golden(TOTAL_LENGTH);
    InitInput(inputX, inputY, golden);

    // ---- init ACL & alloc device memory ----
    uint8_t *inputXDevice = nullptr;
    uint8_t *inputYDevice = nullptr;
    uint8_t *outputDevice = nullptr;
    uint8_t *tilingDevice = nullptr;
    aclrtStream stream = nullptr;
    bool ok = true;

    ok = ok && CheckAcl(aclInit(nullptr), "aclInit");
    ok = ok && CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
    ok = ok && CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
    ok = ok && CheckAcl(aclrtMalloc((void **)&inputXDevice, TOTAL_LENGTH * sizeof(DTYPE_X), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc inputX");
    ok = ok && CheckAcl(aclrtMalloc((void **)&inputYDevice, TOTAL_LENGTH * sizeof(DTYPE_Y), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc inputY");
    ok = ok && CheckAcl(aclrtMalloc((void **)&outputDevice, TOTAL_LENGTH * sizeof(DTYPE_Z), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc output");
    ok = ok && CheckAcl(aclrtMalloc((void **)&tilingDevice, sizeof(AddCustomTilingData), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc tiling");

    // ---- copy input to device ----
    ok = ok && CheckAcl(aclrtMemcpy(inputXDevice, TOTAL_LENGTH * sizeof(DTYPE_X), inputX.data(),
        TOTAL_LENGTH * sizeof(DTYPE_X), ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy inputX");
    ok = ok && CheckAcl(aclrtMemcpy(inputYDevice, TOTAL_LENGTH * sizeof(DTYPE_Y), inputY.data(),
        TOTAL_LENGTH * sizeof(DTYPE_Y), ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy inputY");

    // ---- setup tiling & launch kernel ----
    if (ok) {
        AddCustomTilingData tilingData = {TOTAL_LENGTH, TILE_NUM};
        ok = ok && CheckAcl(aclrtMemcpy(tilingDevice, sizeof(AddCustomTilingData), &tilingData,
            sizeof(AddCustomTilingData), ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy tiling");
        if (ok) {
            add_custom<<<BLOCK_NUM, nullptr, stream>>>(inputXDevice, inputYDevice, outputDevice, nullptr, tilingDevice);
            ok = CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
    }

    // ---- copy output back ----
    ok = ok && CheckAcl(aclrtMemcpy(output.data(), TOTAL_LENGTH * sizeof(DTYPE_Z), outputDevice,
        TOTAL_LENGTH * sizeof(DTYPE_Z), ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy output");

    // ---- cleanup ----
    if (stream != nullptr)       { (void)aclrtDestroyStream(stream); }
    if (inputXDevice != nullptr) { (void)aclrtFree(inputXDevice); }
    if (inputYDevice != nullptr) { (void)aclrtFree(inputYDevice); }
    if (outputDevice != nullptr) { (void)aclrtFree(outputDevice); }
    if (tilingDevice != nullptr) { (void)aclrtFree(tilingDevice); }
    (void)aclrtResetDevice(0);
    (void)aclFinalize();

    // ---- verify ----
    if (!ok || !VerifyResult(output, golden)) {
        return 1;
    }

    std::cout << "test pass!" << std::endl;
    return 0;
}
