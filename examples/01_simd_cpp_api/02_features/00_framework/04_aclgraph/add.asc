/* !
 * \file add.asc
 * \brief Add operator ACL graph sample.
 */

#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <iostream>
#include <iterator>
#include <vector>

#include "acl/acl.h"
#include "acl/acl_dump.h"
#include "kernel_operator.h"

enum class CaptureMode : int32_t {
    SINGLE_STREAM = 1,
    DOUBLE_STREAM = 2,
    EXCEPTION_DUMP = 3,
};

constexpr int32_t scenarioNum = SCENARIO_NUM;

template <uint32_t blockLength>
__vector__ __global__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(x + block_idx * blockLength, blockLength);
    yGm.SetGlobalBuffer(y + block_idx * blockLength, blockLength);
    zGm.SetGlobalBuffer(z + block_idx * blockLength, blockLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float, blockLength>();

    AscendC::DataCopy(xLocal, xGm, blockLength);
    AscendC::DataCopy(yLocal, yGm, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Add(zLocal, xLocal, yLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopy(zGm, zLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 场景3专用：计算逻辑与add_custom完全一致，仅在指定block上额外执行trap指令触发AI Core异常。
// trap放在结果写回GM之后，使得异常发生时x、y、z三块GM内存都持有有效数据，便于在异常回调中Dump。
template <uint32_t blockLength, uint32_t faultBlockIdx>
__vector__ __global__ void add_custom_fault(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(x + block_idx * blockLength, blockLength);
    yGm.SetGlobalBuffer(y + block_idx * blockLength, blockLength);
    zGm.SetGlobalBuffer(z + block_idx * blockLength, blockLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float, blockLength>();
    AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float, blockLength>();

    AscendC::DataCopy(xLocal, xGm, blockLength);
    AscendC::DataCopy(yLocal, yGm, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Add(zLocal, xLocal, yLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopy(zGm, zLocal, blockLength);
    AscendC::PipeBarrier<PIPE_ALL>();

    if (block_idx == faultBlockIdx) {
        asm volatile("trap");
    }
}

void ExecuteModelRI(aclmdlRI modelRI, aclrtStream mainStream)
{
    for (int i = 0; i < 5; ++i) {
        aclmdlRIExecuteAsync(modelRI, mainStream);
        aclrtSynchronizeStream(mainStream);
    }
}

template <uint32_t numBlocks, uint32_t blockLength>
void RunSingleStreamCapture(
    float* xDevice, float* yDevice, float* zDevice, uint8_t* xHost, uint8_t* yHost, uint8_t* zHost,
    size_t totalByteSize, aclrtStream mainStream)
{
    aclmdlRI modelRI = nullptr;

    aclmdlRICaptureBegin(mainStream, ACL_MODEL_RI_CAPTURE_MODE_GLOBAL);
    aclrtMemcpyAsync(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE, mainStream);
    aclrtMemcpyAsync(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE, mainStream);
    add_custom<blockLength><<<numBlocks, 0, mainStream>>>(xDevice, yDevice, zDevice);
    aclrtMemcpyAsync(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST, mainStream);
    aclmdlRICaptureEnd(mainStream, &modelRI);
    aclmdlRIDebugJsonPrint(modelRI, "./modelRI_single_stream.json", 0);

    ExecuteModelRI(modelRI, mainStream);
    aclmdlRIDestroy(modelRI);
}

template <uint32_t numBlocks, uint32_t blockLength>
void RunDoubleStreamCapture(
    float* xDevice, float* yDevice, float* zDevice, uint8_t* xHost, uint8_t* yHost, uint8_t* zHost,
    size_t totalByteSize, aclrtStream mainStream)
{
    aclmdlRI modelRI = nullptr;
    aclrtStream computeStream = nullptr;
    aclrtEvent xReadyEvent = nullptr;
    aclrtEvent computeDoneEvent = nullptr;
    aclrtCreateStream(&computeStream);
    aclrtCreateEventExWithFlag(&xReadyEvent, ACL_EVENT_SYNC);
    aclrtCreateEventExWithFlag(&computeDoneEvent, ACL_EVENT_SYNC);

    aclmdlRICaptureBegin(mainStream, ACL_MODEL_RI_CAPTURE_MODE_GLOBAL);
    aclrtMemcpyAsync(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE, mainStream);
    aclrtRecordEvent(xReadyEvent, mainStream);

    aclrtStreamWaitEvent(computeStream, xReadyEvent);
    aclrtMemcpyAsync(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE, computeStream);
    add_custom<blockLength><<<numBlocks, 0, computeStream>>>(xDevice, yDevice, zDevice);
    aclrtRecordEvent(computeDoneEvent, computeStream);

    aclrtStreamWaitEvent(mainStream, computeDoneEvent);
    aclrtMemcpyAsync(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST, mainStream);
    aclmdlRICaptureEnd(mainStream, &modelRI);
    aclmdlRIDebugJsonPrint(modelRI, "./modelRI_double_stream.json", 0);

    ExecuteModelRI(modelRI, mainStream);
    aclmdlRIDestroy(modelRI);
    aclrtDestroyEvent(xReadyEvent);
    aclrtDestroyEvent(computeDoneEvent);
    aclrtDestroyStream(computeStream);
}

namespace {
constexpr uint32_t argNum = 3; // add_custom_fault的形参个数，依次为x、y、z
constexpr uint32_t maxKernelNameLen = 256;
constexpr uint32_t maxUserTagLen = 512;
// acldumpTensorInfo的dataType使用Dump文件的OutputDataType枚举，取值与aclDataType不同，
// float在该枚举中的取值为1。若误填aclDataType::ACL_FLOAT（取值为0），Dump文件中的
// 数据类型会被记录为DT_UNDEFINED。
constexpr int32_t dumpDataTypeFloat = 1;

// 异常回调运行在Runtime内部线程中，无法访问kernel_add的局部变量，
// 因此在捕获开始前把Dump所需的Tensor描述记录到该全局变量中。
struct ExceptionDumpTensorDesc {
    size_t byteSize;
    uint64_t rowNum;
    uint64_t colNum;
};

ExceptionDumpTensorDesc g_dumpTensorDesc = {};

void FillDumpTensor(acldumpTensorInfo& info, acldumpTensorType type, uint64_t deviceAddr)
{
    info = {};
    info.type = type;
    info.tensorSize = g_dumpTensorDesc.byteSize;
    info.format = static_cast<int32_t>(aclFormat::ACL_FORMAT_ND);
    info.dataType = dumpDataTypeFloat;
    // 本接口直接以tensorAddr作为Device上的数据地址读取数据，因此地址类型为裸地址、数据位于Device
    info.tensorAddr = reinterpret_cast<int64_t*>(deviceAddr);
    info.addrType = ACL_DUMP_ADDR_RAW;
    info.placement = ACL_DUMP_PLACEMENT_DEVICE;
    info.argsOffset = 0;
    info.shapeNum = 2;
    info.originShapeNum = 2;
    info.shape[0] = g_dumpTensorDesc.rowNum;
    info.shape[1] = g_dumpTensorDesc.colNum;
    info.originShape[0] = g_dumpTensorDesc.rowNum;
    info.originShape[1] = g_dumpTensorDesc.colNum;
}

// L1异常回调：从异常信息中取出定位信息和核函数args，再用L3接口把Tensor落盘
void ExceptionCallback(aclrtExceptionInfo* exceptionInfo)
{
    const uint32_t streamId = aclrtGetStreamIdFromExceptionInfo(exceptionInfo);
    const uint32_t taskId = aclrtGetTaskIdFromExceptionInfo(exceptionInfo);
    printf(
        "[Exception] deviceId=%u, streamId=%u, taskId=%u, errorCode=%u\n",
        aclrtGetDeviceIdFromExceptionInfo(exceptionInfo), streamId, taskId,
        aclrtGetErrorCodeFromExceptionInfo(exceptionInfo));

    // 查询出错的核函数名
    char kernelName[maxKernelNameLen] = {0};
    aclrtFuncHandle funcHandle = nullptr;
    if (aclrtGetFuncHandleFromExceptionInfo(exceptionInfo, &funcHandle) == ACL_SUCCESS &&
        aclrtGetFunctionName(funcHandle, maxKernelNameLen, kernelName) == ACL_SUCCESS) {
        printf("[Exception] kernel name: %s\n", kernelName);
    }

    // <<<>>>调用的args在Device上按核函数形参顺序打包，依次为x、y、z的GM地址
    void* devArgs = nullptr;
    uint32_t devArgsLen = 0;
    aclError ret = aclrtGetArgsFromExceptionInfo(exceptionInfo, &devArgs, &devArgsLen);
    if (ret != ACL_SUCCESS || devArgsLen < argNum * sizeof(uint64_t)) {
        printf("[Exception] get kernel args failed, ret=%d, argsLen=%u.\n", static_cast<int32_t>(ret), devArgsLen);
        return;
    }
    uint64_t hostArgs[argNum] = {0};
    ret = aclrtMemcpy(hostArgs, sizeof(hostArgs), devArgs, sizeof(hostArgs), ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        printf("[Exception] copy kernel args to host failed, ret=%d.\n", static_cast<int32_t>(ret));
        return;
    }
    printf(
        "[Exception] x=0x%llx, y=0x%llx, z=0x%llx\n", static_cast<unsigned long long>(hostArgs[0]),
        static_cast<unsigned long long>(hostArgs[1]), static_cast<unsigned long long>(hostArgs[2]));

    // acldumpSaveExceptionInfo为弱符号，仅在支持Exception Dump的平台上有实现
    if (acldumpSaveExceptionInfo == nullptr) {
        printf("[Exception] acldumpSaveExceptionInfo is not implemented on this platform.\n");
        return;
    }

    // 把三块Tensor主动落盘到Exception Dump路径下，附加信息通过userTag写入Dump文件头
    acldumpTensorInfo tensors[argNum];
    FillDumpTensor(tensors[0], ACL_DUMP_TENSOR_INPUT, hostArgs[0]);
    FillDumpTensor(tensors[1], ACL_DUMP_TENSOR_INPUT, hostArgs[1]);
    FillDumpTensor(tensors[2], ACL_DUMP_TENSOR_OUTPUT, hostArgs[2]);

    char userTag[maxUserTagLen] = {0};
    snprintf(userTag, sizeof(userTag), "kernel=%s;streamId=%u;taskId=%u", kernelName, streamId, taskId);
    ret = acldumpSaveExceptionInfo("aclgraph_add_exception", userTag, tensors, argNum);
    printf("[Exception] acldumpSaveExceptionInfo ret=%d\n", static_cast<int32_t>(ret));
}
} // namespace

template <uint32_t numBlocks, uint32_t blockLength>
void RunExceptionDumpCapture(
    float* xDevice, float* yDevice, float* zDevice, uint8_t* xHost, uint8_t* yHost, uint8_t* zHost,
    size_t totalByteSize, aclrtStream mainStream)
{
    aclmdlRI modelRI = nullptr;
    constexpr uint32_t faultBlockIdx = numBlocks / 2;

    // 异常回调的注册不是Stream任务，不会被捕获，但必须在图重放前完成
    g_dumpTensorDesc = {totalByteSize, numBlocks, blockLength};
    aclrtExceptionInfoCallbackRegister(ExceptionCallback);
    // 遇错即停，避免后续任务继续下发掩盖异常现场
    aclrtSetStreamFailureMode(mainStream, ACL_STOP_ON_FAILURE);

    // 查询Exception Dump落盘根路径，同时确认acl.json中的Dump配置已生效
    char dumpPath[ACL_DUMP_MAX_FILE_PATH_LENGTH] = {0};
    if (acldumpGetExceptionInfoPath != nullptr &&
        acldumpGetExceptionInfoPath(dumpPath, sizeof(dumpPath)) == ACL_SUCCESS) {
        printf("[Host] exception dump path: %s\n", dumpPath);
    } else {
        printf("[Host] exception dump is not enabled, please check dump_scene in acl.json.\n");
    }

    aclmdlRICaptureBegin(mainStream, ACL_MODEL_RI_CAPTURE_MODE_GLOBAL);
    aclrtMemcpyAsync(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE, mainStream);
    aclrtMemcpyAsync(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE, mainStream);
    add_custom_fault<blockLength, faultBlockIdx><<<numBlocks, 0, mainStream>>>(xDevice, yDevice, zDevice);
    aclrtMemcpyAsync(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST, mainStream);
    aclmdlRICaptureEnd(mainStream, &modelRI);
    aclmdlRIDebugJsonPrint(modelRI, "./modelRI_exception_dump.json", 0);

    // 捕获阶段不执行任务，异常在图重放时才触发，此时异常回调被Runtime内部线程调用
    printf("[Host] executing captured graph, an AI Core exception is expected on block %u.\n", faultBlockIdx);
    aclmdlRIExecuteAsync(modelRI, mainStream);
    aclError ret = aclrtSynchronizeStream(mainStream);
    if (ret != ACL_SUCCESS) {
        const char* errMsg = aclGetRecentErrMsg();
        printf("[Host] aclrtSynchronizeStream failed as expected, ret=%d.\n", static_cast<int32_t>(ret));
        printf("[Host] recent error message: %s\n", errMsg == nullptr ? "<null>" : errMsg);
    } else {
        printf("[Host] no exception was reported, please check whether the trap instruction took effect.\n");
    }

    aclmdlRIDestroy(modelRI);
    aclrtExceptionInfoCallbackUnregister(ExceptionCallback);
}

std::vector<float> kernel_add(std::vector<float>& x, std::vector<float>& y, CaptureMode mode)
{
    constexpr uint32_t numBlocks = 8;
    constexpr uint32_t blockLength = 2048;
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(float);
    int32_t deviceId = 0;
    float* xDevice = nullptr;
    float* yDevice = nullptr;
    float* zDevice = nullptr;
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* zHost = nullptr;

    // 场景3需要通过acl.json使能Exception Dump，其余场景无需Dump配置
    aclInit(mode == CaptureMode::EXCEPTION_DUMP ? "./acl.json" : nullptr);
    aclrtSetDevice(deviceId);

    aclrtStream mainStream = nullptr;
    aclrtCreateStream(&mainStream);

    aclrtMallocHost((void**)&xHost, totalByteSize);
    aclrtMallocHost((void**)&yHost, totalByteSize);
    aclrtMallocHost((void**)&zHost, totalByteSize);
    for (uint32_t i = 0; i < totalLength; ++i) {
        *((float*)xHost + i) = x[i];
        *((float*)yHost + i) = y[i];
    }

    aclrtMalloc((void**)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    if (mode == CaptureMode::SINGLE_STREAM) {
        RunSingleStreamCapture<numBlocks, blockLength>(
            xDevice, yDevice, zDevice, xHost, yHost, zHost, totalByteSize, mainStream);
    } else if (mode == CaptureMode::DOUBLE_STREAM) {
        RunDoubleStreamCapture<numBlocks, blockLength>(
            xDevice, yDevice, zDevice, xHost, yHost, zHost, totalByteSize, mainStream);
    } else {
        RunExceptionDumpCapture<numBlocks, blockLength>(
            xDevice, yDevice, zDevice, xHost, yHost, zHost, totalByteSize, mainStream);
    }

    std::vector<float> z(totalLength);
    z.assign((float*)zHost, (float*)(zHost + totalByteSize));

    aclrtDestroyStream(mainStream);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);

    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

uint32_t VerifyResult(std::vector<float>& output, std::vector<float>& golden)
{
    auto printTensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test failed!" << std::endl;
        return 1;
    }
}

int32_t main()
{
    constexpr uint32_t totalLength = 8 * 2048;
    std::vector<float> x(totalLength);
    std::vector<float> y(totalLength);

    for (uint32_t i = 0; i < totalLength; ++i) {
        x[i] = i * 0.1f;
        y[i] = i * 0.2f;
    }

    std::vector<float> output = kernel_add(x, y, static_cast<CaptureMode>(scenarioNum));

    // 场景3的核函数必定执行失败，其目的是触发异常并落盘，因此不校验计算结果
    if (static_cast<CaptureMode>(scenarioNum) == CaptureMode::EXCEPTION_DUMP) {
        std::cout << "exception dump scenario finished, "
                  << "check the dump files under <dump_path>/extra-info/data-dump/<deviceId>/." << std::endl;
        return 0;
    }

    std::vector<float> golden(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        golden[i] = x[i] + y[i];
    }

    return VerifyResult(output, golden);
}
