/* !
 * \file add_unified_tiling.asc
 * \brief Add tiling selector sample based on one unified tiling struct.
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <string>
#include <vector>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 3
#error "SCENARIO_NUM must be one of 0, 1, 2, 3."
#endif

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLOCK_SIZE = 32;
constexpr uint32_t HALF_SIZE = 2;
constexpr uint32_t ALIGN_NUM = BLOCK_SIZE / HALF_SIZE;
constexpr uint32_t TILE_LENGTH = 3200;

struct UnifiedTilingData {
    uint32_t formerNum;
    uint32_t formerLength;
    uint32_t formerTileNum;
    uint32_t formerTileLength;
    uint32_t formerLastTileLength;
    uint32_t tailLength;
    uint32_t tailTileNum;
    uint32_t tailTileLength;
    uint32_t tailLastTileLength;
};

struct TileInfo {
    uint32_t tileNum;
    uint32_t tileLength;
    uint32_t lastTileLength;
};

uint32_t AlignUp(uint32_t value, uint32_t align)
{
    return ((value + align - 1U) / align) * align;
}

TileInfo CalcTileInfo(uint32_t length)
{
    TileInfo info;
    info.tileNum = length / TILE_LENGTH;
    info.tileLength = (info.tileNum == 0U) ? 0U : TILE_LENGTH;
    info.lastTileLength = length - info.tileNum * TILE_LENGTH;
    return info;
}

constexpr uint32_t GetTotalLengthByScenario()
{
    if constexpr (SCENARIO_NUM == 0) {
        return 256000;
    } else if constexpr (SCENARIO_NUM == 1) {
        return 260096;
    } else if constexpr (SCENARIO_NUM == 2) {
        return 256064;
    } else {
        return 258112;
    }
}

UnifiedTilingData BuildUnifiedTilingData(uint32_t totalLength)
{
    uint32_t totalLengthAligned = AlignUp(totalLength, ALIGN_NUM);
    uint32_t totalBlockNum = totalLengthAligned / ALIGN_NUM;

    if (totalBlockNum % NUM_BLOCKS == 0U) {
        uint32_t blockLength = totalLengthAligned / NUM_BLOCKS;
        TileInfo blockInfo = CalcTileInfo(blockLength);
        return {NUM_BLOCKS, blockLength, blockInfo.tileNum, blockInfo.tileLength, blockInfo.lastTileLength, 0U, 0U, 0U,
                0U};
    }

    uint32_t tailBlockNum = totalBlockNum / NUM_BLOCKS;
    uint32_t formerNum = totalBlockNum % NUM_BLOCKS;
    uint32_t formerLength = (tailBlockNum + 1U) * ALIGN_NUM;
    uint32_t tailLength = tailBlockNum * ALIGN_NUM;
    TileInfo formerInfo = CalcTileInfo(formerLength);
    TileInfo tailInfo = CalcTileInfo(tailLength);

    return {formerNum,
            formerLength,
            formerInfo.tileNum,
            formerInfo.tileLength,
            formerInfo.lastTileLength,
            tailLength,
            tailInfo.tileNum,
            tailInfo.tileLength,
            tailInfo.lastTileLength};
}

class KernelAddUnified {
public:
    __aicore__ inline KernelAddUnified() = default;

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                UnifiedTilingData tiling)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling.formerNum) {
            uint32_t offset = tiling.formerLength * blockIdx;
            InitGm(x, y, z, offset, tiling.formerLength);
            this->tileNum = tiling.formerTileNum;
            this->tileLength = tiling.formerTileLength;
            this->lastTileLength = tiling.formerLastTileLength;
        } else {
            uint32_t offset = tiling.formerLength * tiling.formerNum + tiling.tailLength * (blockIdx - tiling.formerNum);
            InitGm(x, y, z, offset, tiling.tailLength);
            this->tileNum = tiling.tailTileNum;
            this->tileLength = tiling.tailTileLength;
            this->lastTileLength = tiling.tailLastTileLength;
        }
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> xLocal(AscendC::TPosition::VECCALC, xAddr, TILE_LENGTH);
        AscendC::LocalTensor<half> yLocal(AscendC::TPosition::VECCALC, yAddr, TILE_LENGTH);
        AscendC::LocalTensor<half> zLocal(AscendC::TPosition::VECCALC, zAddr, TILE_LENGTH);

        uint32_t totalLoop = this->tileNum + (this->lastTileLength > 0U ? 1U : 0U);
        for (uint32_t loopIdx = 0; loopIdx < totalLoop; loopIdx++) {
            uint32_t curLen = (loopIdx < this->tileNum) ? this->tileLength : this->lastTileLength;
            uint32_t startElement = loopIdx * this->tileLength;

            if (loopIdx != 0U) {
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            }

            AscendC::DataCopy(xLocal, xGm[startElement], curLen);
            AscendC::DataCopy(yLocal, yGm[startElement], curLen);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            if (loopIdx != 0U) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }

            AscendC::Add(zLocal, xLocal, yLocal, curLen);

            if (loopIdx != totalLoop - 1U) {
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            }
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopy(zGm[startElement], zLocal, curLen);

            if (loopIdx != totalLoop - 1U) {
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
    }

private:
    __aicore__ inline void InitGm(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z, uint32_t offset,
                                  uint32_t length)
    {
        xGm.SetGlobalBuffer((__gm__ half*)x + offset, length);
        yGm.SetGlobalBuffer((__gm__ half*)y + offset, length);
        zGm.SetGlobalBuffer((__gm__ half*)z + offset, length);
    }

private:
    static constexpr uint32_t xAddr = 0;
    static constexpr uint32_t yAddr = TILE_LENGTH * HALF_SIZE;
    static constexpr uint32_t zAddr = yAddr + TILE_LENGTH * HALF_SIZE;

    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;
    uint32_t tileNum;
    uint32_t tileLength;
    uint32_t lastTileLength;
};

__vector__ __global__ void add_unified_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                              UnifiedTilingData tiling)
{
    AscendC::InitSocState();
    KernelAddUnified op;
    op.Init(x, y, z, tiling);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

void LaunchAddByUnifiedTiling(uint8_t* xDevice, uint8_t* yDevice, uint8_t* zDevice, uint32_t totalLength,
                              aclrtStream stream)
{
    UnifiedTilingData tiling = BuildUnifiedTilingData(totalLength);
    printf("Unified tiling: formerNum=%u, formerLength=%u, tailLength=%u\n", tiling.formerNum, tiling.formerLength,
           tiling.tailLength);
    add_unified_custom<<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
}

struct ArgInfo {
    std::string fileName;
    size_t length;
};

bool ReadInputToDevice(const ArgInfo& argInfo, uint8_t*& host, uint8_t*& device)
{
    aclrtMallocHost((void**)(&host), argInfo.length);
    aclrtMalloc((void**)(&device), argInfo.length, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t fileSize = argInfo.length;
    if (!ReadFile(argInfo.fileName, fileSize, host, argInfo.length)) {
        return false;
    }
    if (fileSize != argInfo.length) {
        ERROR_LOG("Input file size mismatch. path = %s, expect = %zu, actual = %zu", argInfo.fileName.c_str(),
                  argInfo.length, fileSize);
        return false;
    }

    aclrtMemcpy(device, argInfo.length, host, argInfo.length, ACL_MEMCPY_HOST_TO_DEVICE);
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t dataLen = GetTotalLengthByScenario();
    constexpr size_t dataByteSize = static_cast<size_t>(dataLen) * HALF_SIZE;

    printf("Usage: %s (compile-time SCENARIO_NUM=%u)\n", argv[0], (uint32_t)SCENARIO_NUM);
    printf("Running unified tiling scenario %u, totalLength=%u\n", (uint32_t)SCENARIO_NUM, dataLen);

    std::vector<ArgInfo> inputsInfo = {{"./input/input_x.bin", dataByteSize}, {"./input/input_y.bin", dataByteSize}};
    ArgInfo outputInfo = {"./output/output.bin", dataByteSize};

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    std::vector<uint8_t*> inputHost(inputsInfo.size(), nullptr);
    std::vector<uint8_t*> inputDevice(inputsInfo.size(), nullptr);
    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;

    for (uint32_t i = 0; i < inputsInfo.size(); i++) {
        if (!ReadInputToDevice(inputsInfo[i], inputHost[i], inputDevice[i])) {
            ERROR_LOG("Read input failed.");
            return 1;
        }
    }

    aclrtMallocHost((void**)(&outputHost), outputInfo.length);
    aclrtMalloc((void**)(&outputDevice), outputInfo.length, ACL_MEM_MALLOC_HUGE_FIRST);

    LaunchAddByUnifiedTiling(inputDevice[0], inputDevice[1], outputDevice, dataLen, stream);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputInfo.length, outputDevice, outputInfo.length, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(outputInfo.fileName, outputHost, outputInfo.length);

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);

    for (uint32_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Unified tiling scenario %u completed.\n", (uint32_t)SCENARIO_NUM);
    return 0;
}
