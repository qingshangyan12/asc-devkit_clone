/*!
 * \file tensor_api_ternary.asc
 * \brief Ternary Scalar 操作示例
 * 
 * 演示使用 Ascend C 基础 API 的 Adds 实现向量加标量操作
 * 数学公式：out = src + scalar
 * 
 * 注意：tensor_api 的 Transform<Inst::AddScalar> 是 asc-devkit 仓库中的新功能，
 * 尚未发布到 CANN 包中。本示例使用已发布的基础 API (Adds) 来演示相同的概念。
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#if defined(ASCENDC_CPU_DEBUG)
#include "tikicpulib.h"
#endif

constexpr uint32_t TOTAL_LENGTH = 512;

class KernelAddScalar {
public:
    __aicore__ inline KernelAddScalar() {}
    
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, half scalarValue)
    {
        this->scalar = scalarValue;
        srcGlobal.SetGlobalBuffer((__gm__ half*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ half*)dstGm);
        
        pipe.InitBuffer(inQueueSrc, 1, TOTAL_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueDst, 1, TOTAL_LENGTH * sizeof(half));
    }
    
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.AllocTensor<half>();
        AscendC::DataCopy(srcLocal, srcGlobal, TOTAL_LENGTH);
        inQueueSrc.EnQue(srcLocal);
    }
    
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.DeQue<half>();
        AscendC::LocalTensor<half> dstLocal = outQueueDst.AllocTensor<half>();
        
        // 使用 Adds API 实现向量加标量：dst = src + scalar
        AscendC::Adds(dstLocal, srcLocal, scalar, TOTAL_LENGTH);
        
        outQueueDst.EnQue<half>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dstLocal = outQueueDst.DeQue<half>();
        AscendC::DataCopy(dstGlobal, dstLocal, TOTAL_LENGTH);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<half> srcGlobal, dstGlobal;
    half scalar;
};

__global__ __vector__ void kernel_add_scalar(
    __gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, half scalarValue)
{
    KernelAddScalar op;
    op.Init(srcGm, dstGm, scalarValue);
    op.Process();
}

int32_t main(int32_t argc, char *argv[]) {
    uint32_t numBlocks = 1;
    size_t inputByteSize = TOTAL_LENGTH * sizeof(uint16_t);
    size_t outputByteSize = TOTAL_LENGTH * sizeof(uint16_t);
    half scalarValue = 2.0;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *outHost;
    uint8_t *xDevice, *outDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&outHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

#if defined(ASCENDC_CPU_DEBUG)
    AscendC::SetKernelMode(KernelMode::AIV_MODE);
    ICPU_RUN_KF(kernel_add_scalar, numBlocks, xDevice, outDevice, scalarValue);
#else
    kernel_add_scalar<<<numBlocks, nullptr, stream>>>(
        xDevice, outDevice, scalarValue);
    aclrtSynchronizeStream(stream);
#endif

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
