/* !
 * \file test.asc
 * \brief 用于编译验证文档中的GM到L1连续搬运DataCopy调用示例。
 */

#include "kernel_operator.h"

namespace {
constexpr uint32_t COPY_COUNT = 512;
constexpr uint64_t A1_ADDR = 0;

__aicore__ inline void CopyHalf512GmToA1(GM_ADDR src)
{
    AscendC::GlobalTensor<half> srcGm;
    srcGm.SetGlobalBuffer((__gm__ half *)src, COPY_COUNT);

    AscendC::LocalTensor<half> dstA1(AscendC::TPosition::A1, A1_ADDR, COPY_COUNT);

    AscendC::DataCopy(dstA1, srcGm, COPY_COUNT);
}
} // namespace

__global__ __cube__ void test(GM_ADDR src)
{
    AscendC::InitSocState();
    CopyHalf512GmToA1(src);
}

int32_t main()
{
    return 0;
}
