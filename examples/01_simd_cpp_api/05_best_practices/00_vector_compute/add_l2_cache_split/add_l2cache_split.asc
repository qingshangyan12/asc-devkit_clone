/* !
 * \file add_l2cache_split.asc
 */

#include "data_utils.h"
#include "acl/acl.h"
#include "basic_api/kernel_vec_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "l2_cache_optimizer.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace CustomAddL2Cache {

struct AddProblemShape {
    int64_t totalLen;
};

__aicore__ inline void CopyTiling(AddProblemShape* tiling, __gm__ uint8_t* tilingGM)
{
    int64_t* ptr = reinterpret_cast<int64_t*>(tiling);
    auto tiling64 = reinterpret_cast<__gm__ int64_t*>(tilingGM);
    for (size_t i = 0; i < sizeof(AddProblemShape) / sizeof(int64_t); ++i, ++ptr) {
        *ptr = *(tiling64 + i);
    }
}

class KernelAdd {
public:
    __aicore__ inline KernelAdd() = default;

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z, __gm__ uint8_t* tilingGm)
    {
        AddProblemShape shape;
        CopyTiling(&shape, tilingGm);
        totalLen_ = shape.totalLen;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x), totalLen_);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), totalLen_);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(z), totalLen_);
    }

    __aicore__ inline void Process();

private:
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    static constexpr uint32_t MAX_DATA_COPY_LEN = 21840;
#else
    static constexpr uint32_t MAX_DATA_COPY_LEN = 16384;
#endif

    static constexpr uint32_t X_ADDR = 0;
    static constexpr uint32_t Y_ADDR = X_ADDR + MAX_DATA_COPY_LEN * sizeof(half);
    static constexpr uint32_t Z_ADDR = Y_ADDR + MAX_DATA_COPY_LEN * sizeof(half);

    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;
    int64_t totalLen_;
};

__aicore__ inline void KernelAdd::Process()
{
    int64_t curBlockIdx = AscendC::GetBlockIdx();
    int64_t blockNum = AscendC::GetBlockNum();
    if (curBlockIdx >= blockNum) {
        return;
    }

    AscendC::LocalTensor<half> xLocal(AscendC::TPosition::VECCALC, X_ADDR, MAX_DATA_COPY_LEN);
    AscendC::LocalTensor<half> yLocal(AscendC::TPosition::VECCALC, Y_ADDR, MAX_DATA_COPY_LEN);
    AscendC::LocalTensor<half> zLocal(AscendC::TPosition::VECCALC, Z_ADDR, MAX_DATA_COPY_LEN);

    L2CacheOptimizer l2Opt(totalLen_, blockNum);

    for (int64_t tileIdx = 0; tileIdx < l2Opt.GetTileNum(); tileIdx++) {
        int64_t tileLen = l2Opt.GetBlockLen(tileIdx);
        int64_t tileOffset = l2Opt.GetBlockOffset(tileIdx);

        int64_t perCoreLen = AscendC::Ceil(tileLen, blockNum);
        int64_t coreStart = tileOffset + curBlockIdx * perCoreLen;
        int64_t coreLen = 0;
        if (curBlockIdx * perCoreLen < tileLen) {
            coreLen = (coreStart + perCoreLen > tileOffset + tileLen) ? (tileOffset + tileLen - coreStart) : perCoreLen;
        }

        if (coreLen > 0) {
            int64_t totalBlocks = AscendC::DivCeil(coreLen, MAX_DATA_COPY_LEN);

            for (int64_t i = 0; i < totalBlocks; i++) {
                int64_t start = coreStart + i * MAX_DATA_COPY_LEN;
                int64_t remain = coreLen - i * MAX_DATA_COPY_LEN;
                uint32_t curLen = remain > MAX_DATA_COPY_LEN ? MAX_DATA_COPY_LEN : static_cast<uint32_t>(remain);

                if (i != 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                }

                AscendC::DataCopy(xLocal, xGm[start], curLen);
                AscendC::DataCopy(yLocal, yGm[start], curLen);

                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                if (i != 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }

                AscendC::Add(zLocal, xLocal, yLocal, curLen);

                if (i != (totalBlocks - 1)) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

                AscendC::DataCopy(zGm[start], zLocal, curLen);

                if (i != (totalBlocks - 1)) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
            }
        }

        // All cores sync before next tile (removed PipeBarrier for testing)
    }
}

} // namespace CustomAddL2Cache

__vector__ __global__ void add_l2cache_custom(
    __gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z, __gm__ uint8_t* workspace, __gm__ uint8_t* tilingGm)
{
    AscendC::InitSocState();
    CustomAddL2Cache::KernelAdd op;
    op.Init(x, y, z, tilingGm);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr int64_t TOTAL_LEN = 40000000;
    size_t inputByteSize = static_cast<size_t>(TOTAL_LEN) * sizeof(uint16_t);

#ifdef ASCENDC_CPU_DEBUG
#if (__NPU_ARCH__ == 2201)
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910B1");
#elif (__NPU_ARCH__ == 3510)
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend950PR_9589");
#else
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
#endif
#else
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
#endif

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtContext context = nullptr;
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), inputByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&xDevice), inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* yHost;
    uint8_t* yDevice;
    aclrtMallocHost(reinterpret_cast<void**>(&yHost), inputByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&yDevice), inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* zHost;
    uint8_t* zDevice;
    aclrtMallocHost(reinterpret_cast<void**>(&zHost), inputByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&zDevice), inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* workspaceDevice;
    size_t workspaceSize = 0;
    aclrtMalloc(reinterpret_cast<void**>(&workspaceDevice), workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);

    CustomAddL2Cache::AddProblemShape shape{TOTAL_LEN};
    size_t tilingFileSize = sizeof(shape);
    uint8_t* tilingHost;
    uint8_t* tilingDevice;
    aclrtMallocHost(reinterpret_cast<void**>(&tilingHost), tilingFileSize);
    aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), tilingFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingHost, tilingFileSize, &shape, tilingFileSize, ACL_MEMCPY_HOST_TO_HOST);
    aclrtMemcpy(tilingDevice, tilingFileSize, tilingHost, tilingFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t numBlocks = ascendcPlatform->GetCoreNumAic();
    add_l2cache_custom<<<numBlocks, 0, stream>>>(xDevice, yDevice, zDevice, workspaceDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, inputByteSize, zDevice, inputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, inputByteSize);

    aclrtFree(xDevice);
    aclrtFreeHost(xHost);
    aclrtFree(yDevice);
    aclrtFreeHost(yHost);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
