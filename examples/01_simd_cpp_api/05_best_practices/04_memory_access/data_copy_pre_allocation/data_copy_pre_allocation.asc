/* !
 * \file data_copy_pre_allocation.asc
 * \brief MTE2 Pre-Allocation样例：double buffer（ping/pong）的DataCopy搬运场景下，
 *        两块UB buffer轮换承担MTE2搬入与MTE3搬出。同一块buffer被复用时，下一轮MTE2需等待前一轮MTE3
 *        完成（MTE3→MTE2屏障）。通过编译选项ENABLE_PRE_ALLOCATION对比是否使能Pre-Allocation特性，
 *        使能时MTE2提前发出GM读请求，数据暂存总线，待屏障解除后再写入UB，隐藏GM读取延迟。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

constexpr uint32_t TILE_LENGTH = 1024;
constexpr uint32_t TILE_NUM = 8;
constexpr uint32_t TOTAL_LENGTH = TILE_LENGTH * TILE_NUM;

template <typename T, bool enablePreAlloc>
class KernelPreAllocDataCopy {
public:
    __aicore__ inline KernelPreAllocDataCopy() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
    }

    __aicore__ inline void Process()
    {
        // double buffer：两块UB buffer（ping/pong）轮换复用，每块同时承担MTE2搬入与MTE3搬出。
        // 同一块buffer被复用时（跨一轮），下一轮MTE2需等待前一轮MTE3搬出完成，形成MTE3->MTE2屏障。
        AscendC::LocalTensor<T> bufPing(AscendC::TPosition::VECCALC, bufPingAddr, TILE_LENGTH);
        AscendC::LocalTensor<T> bufPong(AscendC::TPosition::VECCALC, bufPongAddr, TILE_LENGTH);

        // 预置两个MTE3_MTE2事件，使两块buffer首次MTE2都不会因无前序MTE3而永久阻塞。
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);

        for (uint32_t i = 0; i < TILE_NUM; i++) {
            // 偶数轮用bufPing+EVENT_ID0，奇数轮用bufPong+EVENT_ID1。
            int32_t eventID = (i % 2 == 0) ? EVENT_ID0 : EVENT_ID1;
            AscendC::LocalTensor<T>& buf = (i % 2 == 0) ? bufPing : bufPong;

            // 等待前一轮同buffer的MTE3搬出完成，释放该块UB供本轮MTE2覆写。
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
            // CopyIn：GM->UB，MTE2搬运。enablePreAlloc为true时使能Pre-Allocation，
            // MTE2提前发出GM读请求，跳过MTE3_MTE2屏障等待，数据暂存总线待屏障解除后写入UB。
            AscendC::DataCopy(buf, xGm[i * TILE_LENGTH], TILE_LENGTH, enablePreAlloc);

            // 等待本轮MTE2搬入完成，再执行MTE3搬出，保证同一块buffer上的读后写顺序。
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(eventID);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(eventID);
            // CopyOut：UB->GM，MTE3搬运。
            AscendC::DataCopy(yGm[i * TILE_LENGTH], buf, TILE_LENGTH);

            // 通知下一轮同buffer的MTE2：本轮MTE3搬出已完成，UB可被覆写。
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(eventID);
        }
        // 排空两块buffer最后一次MTE3_MTE2事件。
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    static constexpr uint32_t bufPingAddr = 0x0;
    static constexpr uint32_t bufPongAddr = TILE_LENGTH * sizeof(half);
};

__global__ __vector__ void data_copy_pre_allocation(GM_ADDR x, GM_ADDR y)
{
    AscendC::TPipe pipe;
#if defined(ENABLE_PRE_ALLOCATION) && (ENABLE_PRE_ALLOCATION == 1)
    KernelPreAllocDataCopy<half, true> kernel;
#else
    KernelPreAllocDataCopy<half, false> kernel;
#endif
    kernel.Init(x, y);
    kernel.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    size_t byteSize = static_cast<size_t>(TOTAL_LENGTH) * sizeof(half);
    uint8_t* xHost;
    uint8_t* yHost;
    uint8_t* xDevice;
    uint8_t* yDevice;
    aclrtMallocHost((void**)(&xHost), byteSize);
    aclrtMallocHost((void**)(&yHost), byteSize);
    aclrtMalloc((void**)&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input.bin", byteSize, xHost, byteSize);
    aclrtMemcpy(xDevice, byteSize, xHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    data_copy_pre_allocation<<<numBlocks, nullptr, stream>>>(xDevice, yDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, byteSize, yDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, byteSize);
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
