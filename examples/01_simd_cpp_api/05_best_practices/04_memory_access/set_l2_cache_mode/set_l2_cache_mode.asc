/* !
 * \file set_l2_cache_mode.asc
 * \brief L2 Cache mode best practices – kernel invocation and main
 *
 * 本样例通过 7 个 Case 展示 L2 Cache Mode 配置对不同数据访问模式下的性能影响：
 *   Case 1-3 抽取自 data_copy 样例（GM→UB 重复搬运）
 *   Case 4-5 抽取自 add_high_performance 样例（矩阵加法）
 *   Case 6-7 新增：合并 Repeat+Add 到一个 kernel 中顺序执行
 */

#include "set_l2_cache_mode.h"
#include "data_utils.h"
#include "acl/acl.h"
#include <vector>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

// ---------------------------------------------------------------------------
// 架构相关常量
// NPU_ARCH_ID 在 CMakeLists.txt 中定义：dav-2201 对应 2201，dav-3510 对应 3510
// ---------------------------------------------------------------------------
#if NPU_ARCH_ID == 3510
    // Ascend 950PR / Ascend 950DT
    constexpr uint32_t AIV_CORE_NUM = 64;
#else
    // Atlas A2/A3 系列
    constexpr uint32_t AIV_CORE_NUM = 48;
#endif

// ====================================================================
// Case 1-3: DataCopy 重复搬运 Kernel（抽取自 data_copy.asc）
// 矩阵 shape 为 [12288, 12288]，half 类型
// ====================================================================

// 场景配置模板（抽取自 data_copy.asc 的 ScenarioConfig）
template <uint32_t mValue, uint32_t nValue, uint32_t numBlocksValue, uint32_t tileMValue, uint32_t tileNValue>
struct ScenarioConfig {
    static constexpr uint32_t M = mValue;
    static constexpr uint32_t N = nValue;
    static constexpr uint32_t NUM_BLOCKS = numBlocksValue;
    static constexpr uint32_t SINGLE_CORE_M = M / NUM_BLOCKS;
    static constexpr uint32_t TILE_M = tileMValue;
    static constexpr uint32_t TILE_N = tileNValue;
};

// UB 重复搬运场景（抽取自 data_copy.asc 的 UbScenario）
// Case 1 对应原样例场景 6：N 方向切 4 份，每份重复搬 4 次，L2 默认开启
// Case 2 同 Case 1，但关闭 L2 Cache
// Case 3 对应原样例场景 5：整块矩阵连续重复搬 4 次，L2 默认开启
template <uint32_t scenario>
struct UbScenario;

template <>
struct UbScenario<1> : ScenarioConfig<12288, 12288, AIV_CORE_NUM, 64, 1024> {};
template <>
struct UbScenario<2> : ScenarioConfig<12288, 12288, AIV_CORE_NUM, 64, 1024> {};
template <>
struct UbScenario<3> : ScenarioConfig<12288, 12288, AIV_CORE_NUM, 64, 1024> {};

using CurrentScenario = UbScenario<scenarioNum>;
constexpr uint32_t REPEAT_M = CurrentScenario::M;
constexpr uint32_t REPEAT_N = CurrentScenario::N;
constexpr uint32_t REPEAT_NUM_BLOCKS = CurrentScenario::NUM_BLOCKS;
constexpr uint32_t REPEAT_SINGLE_CORE_M = CurrentScenario::SINGLE_CORE_M;
constexpr uint32_t REPEAT_TILE_M = CurrentScenario::TILE_M;
constexpr uint32_t REPEAT_TILE_N = CurrentScenario::TILE_N;

// DataCopy 重复搬运 kernel（抽取自 data_copy.asc 的 kernel_data_copy_pad_gm2ub）
template <uint32_t mValue, uint32_t nValue, uint32_t numBlocksValue, uint32_t singleCoreMValue,
    uint32_t tileMValue, uint32_t tileNValue>
__global__ __vector__ void kernel_data_copy_repeat(GM_ADDR src)
{
    AscendC::InitSocState();
    KernelDataCopyPadGm2Ub<mValue, nValue, numBlocksValue, singleCoreMValue, tileMValue, tileNValue> op;
    op.Init(reinterpret_cast<__gm__ half*>(src));
    if constexpr (scenarioNum == 1) {
        op.ProcessSplitFourAndRepeat4Times();
    } else if constexpr (scenarioNum == 2) {
        op.ProcessSplitFourAndRepeat4TimesL2Disable();
    } else {
        op.ProcessRepeatWhole4Times();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}


// ====================================================================
// Case 4-5: Add Kernel（抽取自 add.asc）
// 矩阵 shape 为 [8192, 8192]，half 类型
// ====================================================================

#if NPU_ARCH_ID == 3510
    constexpr uint32_t ADD_LARGE_DATA_COPY_LEN = 21760;
    constexpr uint32_t ADD_MULTI_CORE_M = 64;
#else
    constexpr uint32_t ADD_LARGE_DATA_COPY_LEN = 16384;
    constexpr uint32_t ADD_MULTI_CORE_M = 48;
#endif

constexpr uint32_t ADD_M = 8192;
constexpr uint32_t ADD_N = 8192;

// Add kernel（抽取自 add.asc 的 add_custom，仅路由到 Case 4/5 对应的方法）
template <uint32_t totalM, uint32_t totalN, uint32_t splitM, uint32_t splitN, uint32_t dataCopyLen>
__global__ __vector__ void kernel_add(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelAdd<totalM, totalN, splitM, splitN, dataCopyLen> op;
    op.Init(reinterpret_cast<__gm__ uint8_t*>(x), reinterpret_cast<__gm__ uint8_t*>(y),
        reinterpret_cast<__gm__ uint8_t*>(z));
    if constexpr (scenarioNum == 4) {
        op.ProcessDoubleBuffer();
    } else {
        op.ProcessDoubleBufferL2Bypass();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}


// ====================================================================
// Case 6-7: 合并 Repeat + Add Kernel（新增）
// Add 矩阵：[8192, 8192]（与 Case 4/5 一致）
// Repeat 矩阵：[12288, 12288]（与 Case 1 一致）
//
// Phase 1: Add 双缓冲（addL2Bypass 控制 L2 Cache 配置）
// Phase 2: Repeat N 方向切 4 份，每份连续重复搬运 4 次
// ====================================================================

constexpr uint32_t COMBINED_ADD_M = 8192;
constexpr uint32_t COMBINED_ADD_N = 8192;
constexpr uint32_t COMBINED_REPEAT_M = 12288;
constexpr uint32_t COMBINED_REPEAT_N = 12288;

#if NPU_ARCH_ID == 3510
    constexpr uint32_t COMBINED_DATA_COPY_LEN = 21840;
#else
    constexpr uint32_t COMBINED_DATA_COPY_LEN = 16384;
#endif

constexpr uint32_t COMBINED_TILE_M = 64;
constexpr uint32_t COMBINED_TILE_N = 1024;

// 合并 kernel：Add 矩阵 [8192,8192]，Repeat 矩阵 [12288,12288]
// addL2Bypass=false → Case 6，addL2Bypass=true → Case 7
template <bool addL2Bypass>
__global__ __vector__ void kernel_repeat_and_add(GM_ADDR addX, GM_ADDR addY, GM_ADDR repeatSrc, GM_ADDR addZ)
{
    AscendC::InitSocState();
    KernelRepeatAndAdd<COMBINED_ADD_M, COMBINED_ADD_N, COMBINED_REPEAT_M, COMBINED_REPEAT_N,
        AIV_CORE_NUM, COMBINED_DATA_COPY_LEN, COMBINED_TILE_M, COMBINED_TILE_N, addL2Bypass> op;
    op.Init(reinterpret_cast<__gm__ uint8_t*>(addX), reinterpret_cast<__gm__ uint8_t*>(addY),
        reinterpret_cast<__gm__ uint8_t*>(repeatSrc), reinterpret_cast<__gm__ uint8_t*>(addZ));
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}


// ====================================================================
// main 函数
// ====================================================================
int32_t main(int32_t argc, char* argv[])
{
    printf("========================================\n");
    printf("L2 Cache Mode Best Practices - Case %u\n", (uint32_t)scenarioNum);
    printf("========================================\n");

    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    // -------------------------------------------------------------------
    // Case 1-3: DataCopy 重复搬运场景（抽取自 data_copy.asc 的 main）
    //   单输入矩阵，无输出（纯搬运性能采集）
    // -------------------------------------------------------------------
    if constexpr (scenarioNum <= 3) {
        constexpr size_t FILE_SIZE = REPEAT_M * REPEAT_N * sizeof(half);
        size_t fileSize = FILE_SIZE;

        uint8_t* inputHost;
        uint8_t* inputDevice;
        aclrtMallocHost((void**)(&inputHost), fileSize);
        aclrtMalloc((void**)&inputDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/input.bin", fileSize, inputHost, fileSize);
        aclrtMemcpy(inputDevice, fileSize, inputHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

        kernel_data_copy_repeat<REPEAT_M, REPEAT_N, REPEAT_NUM_BLOCKS, REPEAT_SINGLE_CORE_M, REPEAT_TILE_M, REPEAT_TILE_N>
            <<<REPEAT_NUM_BLOCKS, nullptr, stream>>>(inputDevice);

        aclrtSynchronizeStream(stream);

        aclrtFree(inputDevice);
        aclrtFreeHost(inputHost);
    }
    // -------------------------------------------------------------------
    // Case 4-5: Add 算子场景（抽取自 add.asc 的 main）
    //   两个输入矩阵 + 一个输出矩阵
    // -------------------------------------------------------------------
    else if constexpr (scenarioNum <= 5) {
        constexpr uint32_t dataLen = ADD_M * ADD_N;
        size_t inputByteSize = dataLen * sizeof(uint16_t);
        size_t outputByteSize = dataLen * sizeof(uint16_t);

        std::vector<uint8_t*> inputHost(2);
        std::vector<uint8_t*> inputDevice(2);
        std::vector<uint8_t*> outputHost(1);
        std::vector<uint8_t*> outputDevice(1);

        for (uint32_t i = 0; i < 2; i++) {
            aclrtMallocHost((void**)(&inputHost[i]), inputByteSize);
            aclrtMalloc((void**)(&inputDevice[i]), inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        }
        for (uint32_t i = 0; i < 1; i++) {
            aclrtMallocHost((void**)(&outputHost[i]), outputByteSize);
            aclrtMalloc((void**)(&outputDevice[i]), outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        }

        // 读取输入数据
        const char* inputFiles[] = {"./input/input_x.bin", "./input/input_y.bin"};
        for (uint32_t i = 0; i < 2; i++) {
            size_t fileSize = 0;
            ReadFile(inputFiles[i], fileSize, inputHost[i], inputByteSize);
            aclrtMemcpy(inputDevice[i], inputByteSize, inputHost[i], inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
        }

        constexpr uint32_t splitM = ADD_MULTI_CORE_M;
        constexpr uint32_t splitN = 1;
        constexpr uint32_t numBlocks = splitM * splitN;
        kernel_add<ADD_M, ADD_N, splitM, splitN, ADD_LARGE_DATA_COPY_LEN>
            <<<numBlocks, nullptr, stream>>>(inputDevice[0], inputDevice[1], outputDevice[0]);
        aclrtSynchronizeStream(stream);

        // 写出输出结果
        for (uint32_t i = 0; i < 1; i++) {
            aclrtMemcpy(outputHost[i], outputByteSize, outputDevice[i], outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
            WriteFile("./output/output.bin", outputHost[i], outputByteSize);
            aclrtFree(outputDevice[i]);
            aclrtFreeHost(outputHost[i]);
        }

        for (uint32_t i = 0; i < 2; i++) {
            aclrtFree(inputDevice[i]);
            aclrtFreeHost(inputHost[i]);
        }
    }
    // -------------------------------------------------------------------
    // Case 6-7: 合并 Repeat + Add Kernel（新增）
    //   Add 矩阵 [8192, 8192]，Repeat 矩阵 [12288, 12288]
    //   Case 6: Add 阶段 L2 默认开启 → 流式数据污染 L2 → Repeat 命中受损
    //   Case 7: Add 阶段 L2 bypass     → 流式数据不污染 L2 → Repeat 命中正常
    // -------------------------------------------------------------------
    else {
        constexpr size_t ADD_FILE_SIZE = static_cast<size_t>(COMBINED_ADD_M) * COMBINED_ADD_N * sizeof(uint16_t);
        constexpr size_t REPEAT_FILE_SIZE = static_cast<size_t>(COMBINED_REPEAT_M) * COMBINED_REPEAT_N * sizeof(uint16_t);

        // Add 输入/输出矩阵 [8192,8192]，Repeat 输入矩阵 [12288,12288]
        uint8_t* addXHost = nullptr;
        uint8_t* addXDevice = nullptr;
        uint8_t* addYHost = nullptr;
        uint8_t* addYDevice = nullptr;
        uint8_t* repeatInputHost = nullptr;
        uint8_t* repeatInputDevice = nullptr;
        uint8_t* addZHost = nullptr;
        uint8_t* addZDevice = nullptr;

        aclrtMallocHost((void**)(&addXHost), ADD_FILE_SIZE);
        aclrtMalloc((void**)&addXDevice, ADD_FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMallocHost((void**)(&addYHost), ADD_FILE_SIZE);
        aclrtMalloc((void**)&addYDevice, ADD_FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMallocHost((void**)(&repeatInputHost), REPEAT_FILE_SIZE);
        aclrtMalloc((void**)&repeatInputDevice, REPEAT_FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMallocHost((void**)(&addZHost), ADD_FILE_SIZE);
        aclrtMalloc((void**)&addZDevice, ADD_FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

        // 读取 Add 输入 [8192, 8192]
        size_t fileSize = 0;
        ReadFile("./input/input_x.bin", fileSize, addXHost, ADD_FILE_SIZE);
        aclrtMemcpy(addXDevice, ADD_FILE_SIZE, addXHost, ADD_FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);
        ReadFile("./input/input_y.bin", fileSize, addYHost, ADD_FILE_SIZE);
        aclrtMemcpy(addYDevice, ADD_FILE_SIZE, addYHost, ADD_FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);
        // 读取 Repeat 输入 [12288, 12288]（与 Add 不同的矩阵）
        ReadFile("./input/repeat_input.bin", fileSize, repeatInputHost, REPEAT_FILE_SIZE);
        aclrtMemcpy(repeatInputDevice, REPEAT_FILE_SIZE, repeatInputHost, REPEAT_FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);

        if constexpr (scenarioNum == 6) {
            kernel_repeat_and_add<false><<<AIV_CORE_NUM, nullptr, stream>>>(
                addXDevice, addYDevice, repeatInputDevice, addZDevice);
        } else {
            kernel_repeat_and_add<true><<<AIV_CORE_NUM, nullptr, stream>>>(
                addXDevice, addYDevice, repeatInputDevice, addZDevice);
        }
        aclrtSynchronizeStream(stream);

        // 写出 Add 输出
        aclrtMemcpy(addZHost, ADD_FILE_SIZE, addZDevice, ADD_FILE_SIZE, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", addZHost, ADD_FILE_SIZE);

        aclrtFree(addXDevice);
        aclrtFreeHost(addXHost);
        aclrtFree(addYDevice);
        aclrtFreeHost(addYHost);
        aclrtFree(repeatInputDevice);
        aclrtFreeHost(repeatInputHost);
        aclrtFree(addZDevice);
        aclrtFreeHost(addZHost);
    }

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Case %u completed.\n", (uint32_t)scenarioNum);
    return 0;
}
