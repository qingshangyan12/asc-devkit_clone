/* !
 * \file pipeline_consistency_c_api.asc
 * \brief Verifies intra-core pipeline synchronization cases.
 */

#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t ONE_BLOCK = 1;
constexpr uint32_t VECTOR_LENGTH = 64;
constexpr uint32_t SAME_PIPELINE_STRESS_ITERS = 256;
constexpr uint32_t IDX_OVERLAP_NEG_STRESS_DST = 640;
constexpr uint32_t DATA_COUNT = IDX_OVERLAP_NEG_STRESS_DST + SAME_PIPELINE_STRESS_ITERS * VECTOR_LENGTH;
constexpr uint32_t RESULT_COUNT = 10;
constexpr uint32_t RESULT_STRIDE = 32;
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;

constexpr uint32_t IDX_PIPE_SRC = 0;
constexpr uint32_t IDX_PIPE_DST = 64;
constexpr uint32_t IDX_OVERLAP_SRC0 = 128;
constexpr uint32_t IDX_OVERLAP_SRC1 = 192;
constexpr uint32_t IDX_OVERLAP_DST = 256;
constexpr uint32_t IDX_PIPE_NEG_SRC = 320;
constexpr uint32_t IDX_PIPE_NEG_DST = 384;
constexpr uint32_t IDX_OVERLAP_NEG_SRC0 = 448;
constexpr uint32_t IDX_OVERLAP_NEG_SRC1 = 512;
constexpr uint32_t IDX_OVERLAP_NEG_DST = 576;

constexpr uint32_t RES_CROSS_PIPELINE = 0;
constexpr uint32_t RES_SAME_PIPELINE = 1;
constexpr uint32_t RES_CROSS_PIPELINE_NEG = 2;
constexpr uint32_t RES_SAME_PIPELINE_NEG = 3;
constexpr uint32_t RES_PROGRESS = 4;
constexpr uint32_t RES_SAME_PIPELINE_NEG_STRESS_TOTAL = 5;
constexpr uint32_t RES_SAME_PIPELINE_NEG_STRESS_EXPECTED = 6;
constexpr uint32_t RES_SAME_PIPELINE_NEG_STRESS_MISMATCH = 7;
constexpr uint32_t RES_SAME_PIPELINE_NEG_STRESS_FIRST_BAD_INDEX = 8;
constexpr uint32_t RES_SAME_PIPELINE_NEG_STRESS_FIRST_BAD_VALUE = 9;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

__aicore__ inline void DsbGm()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

__aicore__ inline void WriteBypass(__gm__ int32_t* ptr, int32_t value)
{
    AscendC::WriteGmByPassDCache<int32_t>(ptr, value);
    DsbGm();
}

__aicore__ inline int32_t ReadBypass(__gm__ int32_t* ptr)
{
    return AscendC::ReadGmByPassDCache<int32_t>(ptr);
}

__aicore__ inline void WriteResult(__gm__ int32_t* results, uint32_t index, int32_t value)
{
    WriteBypass(results + index * RESULT_STRIDE, value);
}

extern "C" __global__ __vector__ void cross_pipeline_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    // MTE2生产UB数据。
    asc_copy_gm2ub(local, data + IDX_PIPE_SRC, VECTOR_LENGTH * sizeof(int32_t));

    // MTE3消费UB数据前，需要等待MTE2写UB完成。
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(data + IDX_PIPE_DST, local, VECTOR_LENGTH * sizeof(int32_t));

    // Scalar观测MTE3写GM结果前，等待MTE3完成。
    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
    WriteResult(results, RES_CROSS_PIPELINE, ReadBypass(data + IDX_PIPE_DST));
    WriteResult(results, RES_PROGRESS, 1);
}

extern "C" __global__ __vector__ void same_pipeline_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    // 两次MTE2写同一块UB。第二次写入前用asc_sync_pipe等待第一次MTE2写完成。
    asc_copy_gm2ub(local, data + IDX_OVERLAP_SRC0, VECTOR_LENGTH * sizeof(int32_t));
    asc_sync_pipe(PIPE_MTE2);
    asc_copy_gm2ub(local, data + IDX_OVERLAP_SRC1, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(data + IDX_OVERLAP_DST, local, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
    WriteResult(results, RES_SAME_PIPELINE, ReadBypass(data + IDX_OVERLAP_DST));
    WriteResult(results, RES_PROGRESS, 2);
}

extern "C" __global__ __vector__ void cross_pipeline_no_sync_kernel(
    __gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    // 反例：MTE3不等待MTE2写UB完成，直接消费同一块UB。
    // 结果只作为观察，可能是旧值、未完成值，也可能碰巧正确。
    asc_copy_gm2ub(local, data + IDX_PIPE_NEG_SRC, VECTOR_LENGTH * sizeof(int32_t));
    asc_copy_ub2gm(data + IDX_PIPE_NEG_DST, local, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
    WriteResult(results, RES_CROSS_PIPELINE_NEG, ReadBypass(data + IDX_PIPE_NEG_DST));
    WriteResult(results, RES_PROGRESS, 3);
}

extern "C" __global__ __vector__ void same_pipeline_no_sync_kernel(
    __gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    // 反例：两次MTE2写同一块UB，中间不插入asc_sync_pipe。
    // 结果只作为观察，不代表硬件保证以后一次写入为准。
    asc_copy_gm2ub(local, data + IDX_OVERLAP_NEG_SRC0, VECTOR_LENGTH * sizeof(int32_t));
    asc_copy_gm2ub(local, data + IDX_OVERLAP_NEG_SRC1, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(data + IDX_OVERLAP_NEG_DST, local, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
    WriteResult(results, RES_SAME_PIPELINE_NEG, ReadBypass(data + IDX_OVERLAP_NEG_DST));
    WriteResult(results, RES_PROGRESS, 4);
}

extern "C" __global__ __vector__ void same_pipeline_no_sync_stress_kernel(
    __gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    int32_t expectedSliceCount = 0;
    int32_t mismatchSliceCount = 0;
    int32_t firstMismatchIndex = -1;
    int32_t firstMismatchValue = -777;

    for (uint32_t i = 0; i < SAME_PIPELINE_STRESS_ITERS; ++i) {
        __gm__ int32_t* dst = data + IDX_OVERLAP_NEG_STRESS_DST + i * VECTOR_LENGTH;

        // 压力观察：每轮都故意省略两次MTE2重叠写之间的asc_sync_pipe。
        // 每轮使用独立的64元素输出片段，检查整片地址是否都来自第二次写入。
        asc_copy_gm2ub(local, data + IDX_OVERLAP_NEG_SRC0, VECTOR_LENGTH * sizeof(int32_t));
        asc_copy_gm2ub(local, data + IDX_OVERLAP_NEG_SRC1, VECTOR_LENGTH * sizeof(int32_t));

        asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(dst, local, VECTOR_LENGTH * sizeof(int32_t));

        asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
        asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);

        bool allExpected = true;
        for (uint32_t j = 0; j < VECTOR_LENGTH; ++j) {
            int32_t observed = ReadBypass(dst + j);
            if (observed != 99) {
                allExpected = false;
                if (firstMismatchIndex < 0) {
                    firstMismatchIndex = static_cast<int32_t>(i * VECTOR_LENGTH + j);
                    firstMismatchValue = observed;
                }
            }
        }
        if (allExpected) {
            ++expectedSliceCount;
        } else {
            ++mismatchSliceCount;
        }
    }

    WriteResult(results, RES_SAME_PIPELINE_NEG_STRESS_TOTAL, SAME_PIPELINE_STRESS_ITERS);
    WriteResult(results, RES_SAME_PIPELINE_NEG_STRESS_EXPECTED, expectedSliceCount);
    WriteResult(results, RES_SAME_PIPELINE_NEG_STRESS_MISMATCH, mismatchSliceCount);
    WriteResult(results, RES_SAME_PIPELINE_NEG_STRESS_FIRST_BAD_INDEX, firstMismatchIndex);
    WriteResult(results, RES_SAME_PIPELINE_NEG_STRESS_FIRST_BAD_VALUE, firstMismatchValue);
    WriteResult(results, RES_PROGRESS, 5);
}

void FillRange(std::vector<int32_t>& data, uint32_t start, uint32_t length, int32_t value)
{
    for (uint32_t i = 0; i < length; ++i) {
        data[start + i] = value;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_COUNT * sizeof(int32_t);
    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);

    std::vector<int32_t> data(DATA_COUNT, 0);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);
    FillRange(data, IDX_PIPE_SRC, VECTOR_LENGTH, 42);
    FillRange(data, IDX_OVERLAP_SRC0, VECTOR_LENGTH, 55);
    FillRange(data, IDX_OVERLAP_SRC1, VECTOR_LENGTH, 66);
    FillRange(data, IDX_PIPE_NEG_SRC, VECTOR_LENGTH, 77);
    FillRange(data, IDX_PIPE_NEG_DST, VECTOR_LENGTH, 0);
    FillRange(data, IDX_OVERLAP_NEG_SRC0, VECTOR_LENGTH, 88);
    FillRange(data, IDX_OVERLAP_NEG_SRC1, VECTOR_LENGTH, 99);
    FillRange(data, IDX_OVERLAP_NEG_DST, VECTOR_LENGTH, 0);
    FillRange(data, IDX_OVERLAP_NEG_STRESS_DST, SAME_PIPELINE_STRESS_ITERS * VECTOR_LENGTH, 0);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    uint8_t* resultDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(result)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(resultDevice, resultByteSize, results.data(), resultByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(result H2D)")) {
        return 1;
    }

    cross_pipeline_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);
    same_pipeline_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);
    cross_pipeline_no_sync_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);
    same_pipeline_no_sync_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);
    same_pipeline_no_sync_stress_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);

    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(results.data(), resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(result D2H)")) {
        return 1;
    }

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/pipeline_output.bin", results.data(), resultByteSize);

    std::cout << "intra-core pipeline observations:" << std::endl;
    std::cout << "[0] MTE2 -> MTE3 notify/wait result = " << results[RES_CROSS_PIPELINE * RESULT_STRIDE]
              << std::endl;
    std::cout << "[1] same MTE2 pipeline sync_pipe result = " << results[RES_SAME_PIPELINE * RESULT_STRIDE]
              << std::endl;
    std::cout << "[2] no MTE2 -> MTE3 sync observed result = "
              << results[RES_CROSS_PIPELINE_NEG * RESULT_STRIDE] << std::endl;
    std::cout << "[3] no same-MTE2 sync_pipe observed result = "
              << results[RES_SAME_PIPELINE_NEG * RESULT_STRIDE] << std::endl;
    std::cout << "[4] progress marker = " << results[RES_PROGRESS * RESULT_STRIDE] << std::endl;
    std::cout << "[5] no same-MTE2 sync_pipe stress total = "
              << results[RES_SAME_PIPELINE_NEG_STRESS_TOTAL * RESULT_STRIDE] << std::endl;
    std::cout << "[6] no same-MTE2 sync_pipe stress all-expected-slice-count = "
              << results[RES_SAME_PIPELINE_NEG_STRESS_EXPECTED * RESULT_STRIDE] << std::endl;
    std::cout << "[7] no same-MTE2 sync_pipe stress mismatch-slice-count = "
              << results[RES_SAME_PIPELINE_NEG_STRESS_MISMATCH * RESULT_STRIDE] << std::endl;
    std::cout << "[8] no same-MTE2 sync_pipe stress first-mismatch-index = "
              << results[RES_SAME_PIPELINE_NEG_STRESS_FIRST_BAD_INDEX * RESULT_STRIDE] << std::endl;
    std::cout << "[9] no same-MTE2 sync_pipe stress first-mismatch-value = "
              << results[RES_SAME_PIPELINE_NEG_STRESS_FIRST_BAD_VALUE * RESULT_STRIDE] << std::endl;
    std::cout << "observed output written to output/pipeline_output.bin" << std::endl;

    aclrtFree(dataDevice);
    aclrtFree(resultDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
