/* !
 * \file host_stream_consistency_c_api.asc
 * \brief Verifies Host-Device and cross-Stream memory-order cases.
 */

#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t ONE_BLOCK = 1;
constexpr uint32_t DATA_COUNT = 128;
constexpr uint32_t RESULT_COUNT = 6;
constexpr uint32_t RESULT_STRIDE = 32;
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;

constexpr uint32_t IDX_SAME_STREAM = 0;
constexpr uint32_t IDX_CROSS_STREAM_EVENT = 16;
constexpr uint32_t IDX_SYNC_EVENT = 32;
constexpr uint32_t IDX_SYNC_DEVICE = 48;
constexpr uint32_t IDX_ASYNC_COPY = 64;

constexpr uint32_t RES_SAME_STREAM = 0;
constexpr uint32_t RES_CROSS_STREAM_EVENT = 1;
constexpr uint32_t RES_SYNC_EVENT = 2;
constexpr uint32_t RES_SYNC_DEVICE = 3;
constexpr uint32_t RES_ASYNC_COPY = 4;
constexpr uint32_t RES_PROGRESS = 5;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

__aicore__ inline void DsbGm()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

__aicore__ inline void WriteBypass(__gm__ int32_t* ptr, int32_t value)
{
    // 绕过DCache写GM，避免Host-Device/Stream顺序验证被DCache副本干扰。
    AscendC::WriteGmByPassDCache<int32_t>(ptr, value);
    DsbGm();
}

__aicore__ inline int32_t ReadBypass(__gm__ int32_t* ptr)
{
    // C API目录中未找到适合A2/A3的等价绕过DCache读接口，保留基础API作为观测通道。
    return AscendC::ReadGmByPassDCache<int32_t>(ptr);
}

__aicore__ inline void WriteResult(__gm__ int32_t* results, uint32_t index, int32_t value)
{
    WriteBypass(results + index * RESULT_STRIDE, value);
}

extern "C" __global__ __vector__ void gm_write_kernel(__gm__ uint8_t* dataGm, int32_t index, int32_t value)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    WriteBypass(data + index, value);
}

extern "C" __global__ __vector__ void gm_read_kernel(
    __gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm, int32_t index, int32_t resultIndex)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    WriteResult(results, static_cast<uint32_t>(resultIndex), ReadBypass(data + index));
    WriteResult(results, RES_PROGRESS, resultIndex + 1);
}

int32_t ReadDeviceInt32(uint8_t* dataDevice, uint32_t index)
{
    int32_t value = -777;
    aclError ret = aclrtMemcpy(&value, sizeof(int32_t), dataDevice + index * sizeof(int32_t), sizeof(int32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMemcpy(ReadDeviceInt32) failed, ret=" << ret << std::endl;
    }
    return value;
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_COUNT * sizeof(int32_t);
    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);

    std::vector<int32_t> data(DATA_COUNT, 0);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }

    aclrtStream stream0 = nullptr;
    aclrtStream stream1 = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream0), "aclrtCreateStream(stream0)")) {
        return 1;
    }
    if (CheckAcl(aclrtCreateStream(&stream1), "aclrtCreateStream(stream1)")) {
        return 1;
    }

    aclrtEvent eventCross = nullptr;
    aclrtEvent eventHost = nullptr;
    if (CheckAcl(aclrtCreateEventExWithFlag(&eventCross, ACL_EVENT_SYNC), "aclrtCreateEventExWithFlag(eventCross)")) {
        return 1;
    }
    if (CheckAcl(aclrtCreateEventExWithFlag(&eventHost, ACL_EVENT_SYNC), "aclrtCreateEventExWithFlag(eventHost)")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    uint8_t* resultDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(result)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(resultDevice, resultByteSize, results.data(), resultByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(result H2D)")) {
        return 1;
    }

    // 用例0：同一Stream内，后下发的读Kernel等待前序写Kernel完成。
    gm_write_kernel<<<ONE_BLOCK, nullptr, stream0>>>(dataDevice, IDX_SAME_STREAM, 11);
    gm_read_kernel<<<ONE_BLOCK, nullptr, stream0>>>(dataDevice, resultDevice, IDX_SAME_STREAM, RES_SAME_STREAM);

    // 用例1：跨Stream通过Event建立任务级依赖。
    gm_write_kernel<<<ONE_BLOCK, nullptr, stream0>>>(dataDevice, IDX_CROSS_STREAM_EVENT, 22);
    if (CheckAcl(aclrtRecordEvent(eventCross, stream0), "aclrtRecordEvent(eventCross)")) {
        return 1;
    }
    if (CheckAcl(aclrtStreamWaitEvent(stream1, eventCross), "aclrtStreamWaitEvent(eventCross)")) {
        return 1;
    }
    gm_read_kernel<<<ONE_BLOCK, nullptr, stream1>>>(
        dataDevice, resultDevice, IDX_CROSS_STREAM_EVENT, RES_CROSS_STREAM_EVENT);

    // 用例2：Host等待某个Event后读取该Event之前的Device结果。
    gm_write_kernel<<<ONE_BLOCK, nullptr, stream0>>>(dataDevice, IDX_SYNC_EVENT, 33);
    if (CheckAcl(aclrtRecordEvent(eventHost, stream0), "aclrtRecordEvent(eventHost)")) {
        return 1;
    }
    if (CheckAcl(aclrtSynchronizeEvent(eventHost), "aclrtSynchronizeEvent(eventHost)")) {
        return 1;
    }
    results[RES_SYNC_EVENT * RESULT_STRIDE] = ReadDeviceInt32(dataDevice, IDX_SYNC_EVENT);

    // 用例3：Host等待整个Device后读取另一个Stream上的Device结果。
    gm_write_kernel<<<ONE_BLOCK, nullptr, stream1>>>(dataDevice, IDX_SYNC_DEVICE, 44);
    if (CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice")) {
        return 1;
    }
    results[RES_SYNC_DEVICE * RESULT_STRIDE] = ReadDeviceInt32(dataDevice, IDX_SYNC_DEVICE);

    // 用例4：同一Stream中，异步H2D拷贝先于后续Kernel完成。
    int32_t asyncValue = 55;
    if (CheckAcl(aclrtMemcpyAsync(dataDevice + IDX_ASYNC_COPY * sizeof(int32_t), sizeof(int32_t), &asyncValue,
            sizeof(int32_t), ACL_MEMCPY_HOST_TO_DEVICE, stream0), "aclrtMemcpyAsync(H2D)")) {
        return 1;
    }
    gm_read_kernel<<<ONE_BLOCK, nullptr, stream0>>>(dataDevice, resultDevice, IDX_ASYNC_COPY, RES_ASYNC_COPY);

    if (CheckAcl(aclrtSynchronizeStream(stream0), "aclrtSynchronizeStream(stream0)")) {
        return 1;
    }
    if (CheckAcl(aclrtSynchronizeStream(stream1), "aclrtSynchronizeStream(stream1)")) {
        return 1;
    }

    if (CheckAcl(aclrtMemcpy(results.data(), resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(result D2H)")) {
        return 1;
    }
    results[RES_SYNC_EVENT * RESULT_STRIDE] = ReadDeviceInt32(dataDevice, IDX_SYNC_EVENT);
    results[RES_SYNC_DEVICE * RESULT_STRIDE] = ReadDeviceInt32(dataDevice, IDX_SYNC_DEVICE);

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/host_stream_output.bin", results.data(), resultByteSize);

    std::cout << "Host-Device and Stream observations:" << std::endl;
    std::cout << "[0] same Stream write then read = " << results[RES_SAME_STREAM * RESULT_STRIDE] << std::endl;
    std::cout << "[1] cross Stream Event wait then read = " << results[RES_CROSS_STREAM_EVENT * RESULT_STRIDE]
              << std::endl;
    std::cout << "[2] aclrtSynchronizeEvent then Host read = " << results[RES_SYNC_EVENT * RESULT_STRIDE]
              << std::endl;
    std::cout << "[3] aclrtSynchronizeDevice then Host read = " << results[RES_SYNC_DEVICE * RESULT_STRIDE]
              << std::endl;
    std::cout << "[4] same Stream async H2D then kernel read = " << results[RES_ASYNC_COPY * RESULT_STRIDE]
              << std::endl;
    std::cout << "[5] progress marker = " << results[RES_PROGRESS * RESULT_STRIDE] << std::endl;
    std::cout << "observed output written to output/host_stream_output.bin" << std::endl;

    aclrtFree(dataDevice);
    aclrtFree(resultDevice);
    aclrtDestroyEvent(eventCross);
    aclrtDestroyEvent(eventHost);
    aclrtDestroyStream(stream0);
    aclrtDestroyStream(stream1);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
