/* !
 * \file pipeline_consistency_c_api.asc
 * \brief Verifies intra-core pipeline synchronization cases.
 */

#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t ONE_BLOCK = 1;
constexpr uint32_t DATA_COUNT = 256;
constexpr uint32_t RESULT_COUNT = 3;
constexpr uint32_t RESULT_STRIDE = 32;
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;
constexpr uint32_t VECTOR_LENGTH = 64;

constexpr uint32_t IDX_PIPE_SRC = 0;
constexpr uint32_t IDX_PIPE_DST = 64;
constexpr uint32_t IDX_OVERLAP_SRC0 = 128;
constexpr uint32_t IDX_OVERLAP_SRC1 = 192;
constexpr uint32_t IDX_OVERLAP_DST = 0;

constexpr uint32_t RES_CROSS_PIPELINE = 0;
constexpr uint32_t RES_SAME_PIPELINE = 1;
constexpr uint32_t RES_PROGRESS = 2;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

__aicore__ inline void DsbGm()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

__aicore__ inline void WriteBypass(__gm__ int32_t* ptr, int32_t value)
{
    AscendC::WriteGmByPassDCache<int32_t>(ptr, value);
    DsbGm();
}

__aicore__ inline int32_t ReadBypass(__gm__ int32_t* ptr)
{
    return AscendC::ReadGmByPassDCache<int32_t>(ptr);
}

__aicore__ inline void WriteResult(__gm__ int32_t* results, uint32_t index, int32_t value)
{
    WriteBypass(results + index * RESULT_STRIDE, value);
}

extern "C" __global__ __vector__ void cross_pipeline_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    // MTE2生产UB数据。
    asc_copy_gm2ub(local, data + IDX_PIPE_SRC, VECTOR_LENGTH * sizeof(int32_t));

    // MTE3消费UB数据前，需要等待MTE2写UB完成。
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(data + IDX_PIPE_DST, local, VECTOR_LENGTH * sizeof(int32_t));

    // Scalar观测MTE3写GM结果前，等待MTE3完成。
    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
    WriteResult(results, RES_CROSS_PIPELINE, ReadBypass(data + IDX_PIPE_DST));
    WriteResult(results, RES_PROGRESS, 1);
}

extern "C" __global__ __vector__ void same_pipeline_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);
    __ubuf__ int32_t local[VECTOR_LENGTH];

    // 两次MTE2写同一块UB。第二次写入前用asc_sync_pipe等待第一次MTE2写完成。
    asc_copy_gm2ub(local, data + IDX_OVERLAP_SRC0, VECTOR_LENGTH * sizeof(int32_t));
    asc_sync_pipe(PIPE_MTE2);
    asc_copy_gm2ub(local, data + IDX_OVERLAP_SRC1, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(data + IDX_OVERLAP_DST, local, VECTOR_LENGTH * sizeof(int32_t));

    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
    WriteResult(results, RES_SAME_PIPELINE, ReadBypass(data + IDX_OVERLAP_DST));
    WriteResult(results, RES_PROGRESS, 2);
}

void FillRange(std::vector<int32_t>& data, uint32_t start, uint32_t length, int32_t value)
{
    for (uint32_t i = 0; i < length; ++i) {
        data[start + i] = value;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_COUNT * sizeof(int32_t);
    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);

    std::vector<int32_t> data(DATA_COUNT, 0);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);
    FillRange(data, IDX_PIPE_SRC, VECTOR_LENGTH, 42);
    FillRange(data, IDX_OVERLAP_SRC0, VECTOR_LENGTH, 55);
    FillRange(data, IDX_OVERLAP_SRC1, VECTOR_LENGTH, 66);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    uint8_t* resultDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(result)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(resultDevice, resultByteSize, results.data(), resultByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(result H2D)")) {
        return 1;
    }

    cross_pipeline_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);
    same_pipeline_kernel<<<ONE_BLOCK, nullptr, stream>>>(dataDevice, resultDevice);

    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(results.data(), resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(result D2H)")) {
        return 1;
    }

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/pipeline_output.bin", results.data(), resultByteSize);

    std::cout << "intra-core pipeline observations:" << std::endl;
    std::cout << "[0] MTE2 -> MTE3 notify/wait result = " << results[RES_CROSS_PIPELINE * RESULT_STRIDE]
              << std::endl;
    std::cout << "[1] same MTE2 pipeline sync_pipe result = " << results[RES_SAME_PIPELINE * RESULT_STRIDE]
              << std::endl;
    std::cout << "[2] progress marker = " << results[RES_PROGRESS * RESULT_STRIDE] << std::endl;
    std::cout << "observed output written to output/pipeline_output.bin" << std::endl;

    aclrtFree(dataDevice);
    aclrtFree(resultDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
