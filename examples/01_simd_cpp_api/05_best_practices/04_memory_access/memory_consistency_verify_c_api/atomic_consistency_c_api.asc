/* !
 * \file atomic_consistency_c_api.asc
 * \brief Verifies multi-core same-address atomic add.
 */

#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t TWO_BLOCKS = 2;
constexpr uint32_t DATA_COUNT = 64;
constexpr uint32_t RESULT_COUNT = 1;
constexpr uint32_t RESULT_STRIDE = 32;
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;
constexpr uint32_t ATOMIC_LENGTH = 8;

constexpr uint32_t IDX_ATOMIC_SRC0 = 0;
constexpr uint32_t IDX_ATOMIC_SRC1 = 16;
constexpr uint32_t IDX_ATOMIC_DST = 32;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

extern "C" __global__ __vector__ void dma_atomic_add_kernel(__gm__ uint8_t* dataGm)
{
    asc_init();

    uint32_t blockIdx = asc_get_block_idx();
    if (blockIdx >= TWO_BLOCKS) {
        return;
    }

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __ubuf__ int32_t local[ATOMIC_LENGTH];
    uint32_t srcIndex = (blockIdx == 0) ? IDX_ATOMIC_SRC0 : IDX_ATOMIC_SRC1;

    // 每个核搬入自己的加数，然后通过MTE3随路atomic add累加到同一个GM地址。
    asc_copy_gm2ub(local, data + srcIndex, ATOMIC_LENGTH * sizeof(int32_t));
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);

    asc_set_atomic_none();
    asc_set_atomic_add_int();
    asc_copy_ub2gm(data + IDX_ATOMIC_DST, local, ATOMIC_LENGTH * sizeof(int32_t));
    asc_set_atomic_none();
}

void FillRange(std::vector<int32_t>& data, uint32_t start, uint32_t length, int32_t value)
{
    for (uint32_t i = 0; i < length; ++i) {
        data[start + i] = value;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_COUNT * sizeof(int32_t);
    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);

    std::vector<int32_t> data(DATA_COUNT, 0);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);
    FillRange(data, IDX_ATOMIC_SRC0, ATOMIC_LENGTH, 1);
    FillRange(data, IDX_ATOMIC_SRC1, ATOMIC_LENGTH, 1);
    FillRange(data, IDX_ATOMIC_DST, ATOMIC_LENGTH, 0);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }

    dma_atomic_add_kernel<<<TWO_BLOCKS, nullptr, stream>>>(dataDevice);
    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        return 1;
    }
    if (CheckAcl(aclrtMemcpy(data.data(), dataByteSize, dataDevice, dataByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(data D2H)")) {
        return 1;
    }
    results[0] = data[IDX_ATOMIC_DST];

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/atomic_output.bin", results.data(), resultByteSize);

    std::cout << "atomic observations:" << std::endl;
    std::cout << "[0] two-core DMA atomic add result = " << results[0] << std::endl;
    std::cout << "observed output written to output/atomic_output.bin" << std::endl;

    aclrtFree(dataDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
