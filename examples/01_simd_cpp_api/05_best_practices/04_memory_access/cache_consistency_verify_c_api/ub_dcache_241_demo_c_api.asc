/* !
 * \file ub_dcache_241_demo.asc
 * \brief Observes the Scalar DCache mode UB access cases described in section 2.4.1.
 */

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t UB_COUNT = 128;
constexpr uint32_t RESULT_COUNT = 12;
constexpr uint32_t RESULT_STRIDE = 32;
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;
constexpr uint64_t CTRL_49_MASK = static_cast<uint64_t>(1) << 49;

// 结果槽位说明：
// [0] 记录默认CTRL[49]。0表示Scalar默认直接读UB。
// [1] 确认显式设置CTRL[49]=0后读回生效。
// [2] CTRL[49]=0时，Scalar直接读UB初始值。
// [3] CTRL[49]=0时，Vector更新UB后，Scalar不做UB DCCI也能读到新值。
// [4] 确认显式设置CTRL[49]=1后读回生效。
// [5] CTRL[49]=1时，Scalar通过DCache读UB初始值，并形成旧Cache副本。
// [6] 旧副本反例：Vector更新UB后，Scalar可能继续命中旧DCache数据。
// [7] 正例：UB DCCI使旧DCache副本失效，Scalar读到UB新值。
// [8] 标记UB DCCI路径已执行。
// [9]/[10] 记录CTRL[49]=0/1两个测试地址的64B对齐元素偏移。
// [11] UB DCCI后切回CTRL[49]=0直接读UB，也应能看到Vector写入的新值。
constexpr uint32_t RES_DEFAULT_CTRL49 = 0;
constexpr uint32_t RES_CTRL0_AFTER_SET = 1;
constexpr uint32_t RES_CTRL0_WARM_READ = 2;
constexpr uint32_t RES_CTRL0_AFTER_VECTOR_WRITE = 3;
constexpr uint32_t RES_CTRL1_AFTER_SET = 4;
constexpr uint32_t RES_CTRL1_WARM_READ = 5;
constexpr uint32_t RES_CTRL1_AFTER_VECTOR_WRITE_NO_DCCI = 6;
constexpr uint32_t RES_CTRL1_AFTER_UB_DCCI = 7;
constexpr uint32_t RES_UB_DCCI_MODE = 8;
constexpr uint32_t RES_CTRL0_ALIGN_OFFSET = 9;
constexpr uint32_t RES_CTRL1_ALIGN_OFFSET = 10;
constexpr uint32_t RES_CTRL1_DIRECT_UB_AFTER_DCCI = 11;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

__aicore__ inline void DsbAll()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
}

__aicore__ inline void DsbUb()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_UB);
}

__aicore__ inline void SyncVToS()
{
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
}

__aicore__ inline void SyncSToV()
{
    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
}

__aicore__ inline void WriteResult(__gm__ int32_t* results, uint32_t index, int32_t value)
{
    // 结果写入保留基础API绕过DCache，避免结果记录自身受Scalar DCache影响。
    // C API目录中未找到适合A2/A3的绕过DCache读接口，asc_store_dev也不支持A2/A3。
    AscendC::WriteGmByPassDCache<int32_t>(results + index * RESULT_STRIDE, value);
    DsbAll();
}

__aicore__ inline int32_t ReadCtrl49()
{
    return static_cast<int32_t>((static_cast<uint64_t>(asc_get_ctrl()) & CTRL_49_MASK) != 0);
}

__aicore__ inline void SetCtrl49(uint64_t originalCtrl, bool enable)
{
    uint64_t config = enable ? (originalCtrl | CTRL_49_MASK) : (originalCtrl & ~CTRL_49_MASK);
    asc_set_ctrl(config);
}

__aicore__ inline uint32_t Get64BAlignedElementOffset(AscendC::LocalTensor<int32_t>& local)
{
    uint64_t phyAddr = static_cast<uint64_t>(local.GetPhyAddr());
    return static_cast<uint32_t>(((64 - (phyAddr & 63)) & 63) / sizeof(int32_t));
}

__aicore__ inline int32_t ScalarLoadUb(AscendC::LocalTensor<int32_t>& local, uint32_t offset)
{
    __ubuf__ int32_t* ptr = reinterpret_cast<__ubuf__ int32_t*>(local.GetPhyAddr()) + offset;
    volatile __ubuf__ int32_t* volatilePtr = ptr;
    return *volatilePtr;
}

__aicore__ inline void InitUb(AscendC::LocalTensor<int32_t>& local, int32_t value)
{
    // 这里需要Vector流水写UB来验证V->S顺序与Scalar读UB的一致性。
    // C API的asc_duplicate寄存器接口不支持A2/A3，因此保留基础API Duplicate。
    AscendC::Duplicate(local, value, UB_COUNT);
    SyncVToS();
}

__aicore__ inline void DcciUb(AscendC::LocalTensor<int32_t>& local, uint32_t offset)
{
    (void)local;
    (void)offset;
    // 使用全UB DCCI，避免依赖具体UB分配地址；该操作用于清理Scalar DCache里的UB旧副本。
    asc_dcci_entire_ub();
    // UB相关DCCI后使用DSB_UB等待前序UB访问完成。
    DsbUb();
    asc_sync_pipe(PIPE_ALL);
}

extern "C" __global__ __vector__ void ub_dcache_241_kernel(__gm__ uint8_t* resultGm, int32_t mode)
{
    asc_init();

    __gm__ int32_t* results = AsInt32Gm(resultGm);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<int32_t> ctrl0Local = ubAllocator.Alloc<int32_t, UB_COUNT>();
    AscendC::LocalTensor<int32_t> ctrl1Local = ubAllocator.Alloc<int32_t, UB_COUNT>();

    uint64_t originalCtrl = static_cast<uint64_t>(asc_get_ctrl());
    WriteResult(results, RES_DEFAULT_CTRL49, ReadCtrl49());

    if (mode == 1) {
        // 模式1只检查CTRL[49]能否设置并读回。
        SetCtrl49(originalCtrl, false);
        WriteResult(results, RES_CTRL0_AFTER_SET, ReadCtrl49());
        SetCtrl49(originalCtrl, true);
        WriteResult(results, RES_CTRL1_AFTER_SET, ReadCtrl49());
        asc_set_ctrl(originalCtrl);
        return;
    }

    uint32_t ctrl0Offset = Get64BAlignedElementOffset(ctrl0Local);
    WriteResult(results, RES_CTRL0_ALIGN_OFFSET, static_cast<int32_t>(ctrl0Offset));
    InitUb(ctrl0Local, 0);
    if (mode == 2) {
        // 模式2只检查当前选择的UB DCCI操作能否运行。
        SetCtrl49(originalCtrl, true);
        DcciUb(ctrl0Local, ctrl0Offset);
        WriteResult(results, RES_CTRL0_AFTER_SET, 123);
        WriteResult(results, RES_UB_DCCI_MODE, 1);
        asc_set_ctrl(originalCtrl);
        return;
    }

    // CTRL[49]=0：Scalar直接读UB。Vector写UB=1并建立V->S顺序后，不做UB DCCI也应读到新值。
    SetCtrl49(originalCtrl, false);
    WriteResult(results, RES_CTRL0_AFTER_SET, ReadCtrl49());
    WriteResult(results, RES_CTRL0_WARM_READ, ScalarLoadUb(ctrl0Local, ctrl0Offset));
    SyncSToV();
    // Vector流水写UB仍保留基础API Duplicate，原因见InitUb中的说明。
    AscendC::Duplicate(ctrl0Local, 1, UB_COUNT);
    SyncVToS();
    WriteResult(results, RES_CTRL0_AFTER_VECTOR_WRITE, ScalarLoadUb(ctrl0Local, ctrl0Offset));

    uint32_t ctrl1Offset = Get64BAlignedElementOffset(ctrl1Local);
    WriteResult(results, RES_CTRL1_ALIGN_OFFSET, static_cast<int32_t>(ctrl1Offset));
    InitUb(ctrl1Local, 0);

    // CTRL[49]=1：Scalar通过DCache读UB。第一次Scalar读会缓存UB=0；
    // 后续Vector写UB=1后，V->S只保证流水顺序，不会让旧DCache副本失效。
    SetCtrl49(originalCtrl, true);
    if (mode != 3) {
        DcciUb(ctrl1Local, ctrl1Offset);
    }
    WriteResult(results, RES_CTRL1_AFTER_SET, ReadCtrl49());
    WriteResult(results, RES_CTRL1_WARM_READ, ScalarLoadUb(ctrl1Local, ctrl1Offset));
    SyncSToV();
    // Vector流水写UB仍保留基础API Duplicate，原因见InitUb中的说明。
    AscendC::Duplicate(ctrl1Local, 1, UB_COUNT);
    SyncVToS();
    asc_sync_pipe(PIPE_ALL);
    WriteResult(results, RES_CTRL1_AFTER_VECTOR_WRITE_NO_DCCI, ScalarLoadUb(ctrl1Local, ctrl1Offset));
    if (mode != 3) {
        // UB DCCI清理Scalar DCache旧副本，后续Scalar读应能拿到Vector写入的新值。
        DcciUb(ctrl1Local, ctrl1Offset);
        WriteResult(results, RES_CTRL1_AFTER_UB_DCCI, ScalarLoadUb(ctrl1Local, ctrl1Offset));
        SetCtrl49(originalCtrl, false);
        WriteResult(results, RES_CTRL1_DIRECT_UB_AFTER_DCCI, ScalarLoadUb(ctrl1Local, ctrl1Offset));
        SetCtrl49(originalCtrl, true);
        WriteResult(results, RES_UB_DCCI_MODE, 1);
    }

    asc_set_ctrl(originalCtrl);
    asc_sync_pipe(PIPE_ALL);
}

void PrintResult(const char* label, int32_t value)
{
    std::cout << label << " = " << value << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    int32_t mode = 0;
    if (argc > 1) {
        mode = std::atoi(argv[1]);
    }

    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* resultDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(results)")) {
        return 1;
    }
    if (CheckAcl(
            aclrtMemcpy(resultDevice, resultByteSize, results.data(), resultByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(results H2D)")) {
        return 1;
    }

    ub_dcache_241_kernel<<<NUM_BLOCKS, 0, stream>>>(resultDevice, mode);
    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        return 1;
    }

    if (CheckAcl(
            aclrtMemcpy(results.data(), resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(results D2H)")) {
        return 1;
    }

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/ub_dcache_241_output.bin", results.data(), resultByteSize);

    std::cout << "section 2.4.1 Scalar UB DCache observations:" << std::endl;
    PrintResult("[0] default CTRL[49]", results[RES_DEFAULT_CTRL49 * RESULT_STRIDE]);
    PrintResult("[1] CTRL[49] after setting 0", results[RES_CTRL0_AFTER_SET * RESULT_STRIDE]);
    PrintResult("[2] CTRL[49]=0, first Scalar.LD from UB", results[RES_CTRL0_WARM_READ * RESULT_STRIDE]);
    PrintResult("[3] CTRL[49]=0, Vector.ST UB then Scalar.LD", results[RES_CTRL0_AFTER_VECTOR_WRITE * RESULT_STRIDE]);
    PrintResult("[4] CTRL[49] after setting 1", results[RES_CTRL1_AFTER_SET * RESULT_STRIDE]);
    PrintResult("[5] CTRL[49]=1, first Scalar.LD from UB", results[RES_CTRL1_WARM_READ * RESULT_STRIDE]);
    PrintResult("[6] CTRL[49]=1, Vector.ST UB then Scalar.LD without UB DCCI",
        results[RES_CTRL1_AFTER_VECTOR_WRITE_NO_DCCI * RESULT_STRIDE]);
    PrintResult("[7] CTRL[49]=1, asc_dcci_entire_ub then Scalar.LD",
        results[RES_CTRL1_AFTER_UB_DCCI * RESULT_STRIDE]);
    PrintResult("[8] UB DCCI mode, 1 means asc_dcci_entire_ub",
        results[RES_UB_DCCI_MODE * RESULT_STRIDE]);
    PrintResult("[9] CTRL[49]=0 case 64B aligned element offset", results[RES_CTRL0_ALIGN_OFFSET * RESULT_STRIDE]);
    PrintResult("[10] CTRL[49]=1 case 64B aligned element offset", results[RES_CTRL1_ALIGN_OFFSET * RESULT_STRIDE]);
    PrintResult("[11] after asc_dcci_entire_ub, CTRL[49]=0 direct UB Scalar.LD",
        results[RES_CTRL1_DIRECT_UB_AFTER_DCCI * RESULT_STRIDE]);
    std::cout << "observed output written to output/ub_dcache_241_output.bin" << std::endl;

    aclrtFree(resultDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
