/* !
 * \file multi_core_cacheline_overwrite.asc
 * \brief Verifies overwrite risk when multiple AI Cores update different elements in the same DCache Cache Line.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t ELEMENTS_PER_CACHE_LINE = 8; // 8个uint64_t等于64B。
constexpr uint32_t ITERATIONS = 128;
constexpr uint32_t CACHE_LINE_BYTES = ELEMENTS_PER_CACHE_LINE * sizeof(uint64_t);

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

extern "C" __global__ __vector__ void multi_core_cacheline_overwrite_kernel(__gm__ uint8_t* lineGm)
{
    asc_init();

    uint32_t blockIdx = asc_get_block_idx();
    if (blockIdx >= ELEMENTS_PER_CACHE_LINE) {
        return;
    }

    __gm__ uint64_t* line = reinterpret_cast<__gm__ uint64_t*>(lineGm);

    // 每个核只写同一条64B Cache Line中的一个uint64_t元素。
    // 直接写__gm__地址会走普通Scalar DCache路径，每个核会形成各自的Cache Line副本。
    volatile __gm__ uint64_t* volatileLine = line;
    volatileLine[blockIdx] = static_cast<uint64_t>(blockIdx + 1);

    // DCCI按Cache Line粒度写回。多个核写回同一条Cache Line时，后写回的旧副本可能覆盖其他核字段。
    asc_dcci_single(reinterpret_cast<__gm__ void*>(line + blockIdx));
    // GM相关DCCI后使用DSB_DDR等待前序GM访问完成。
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);

    asc_sync_pipe(PIPE_ALL);
}

bool IsExpectedLine(const std::vector<uint64_t>& data, uint32_t iter)
{
    uint32_t base = iter * ELEMENTS_PER_CACHE_LINE;
    for (uint32_t i = 0; i < ELEMENTS_PER_CACHE_LINE; ++i) {
        if (data[base + i] != static_cast<uint64_t>(i + 1)) {
            return false;
        }
    }
    return true;
}

void PrintLine(const std::vector<uint64_t>& data, uint32_t iter, const char* prefix)
{
    uint32_t base = iter * ELEMENTS_PER_CACHE_LINE;
    std::cout << prefix;
    for (uint32_t i = 0; i < ELEMENTS_PER_CACHE_LINE; ++i) {
        std::cout << " " << data[base + i];
    }
    std::cout << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = ITERATIONS * CACHE_LINE_BYTES;
    std::vector<uint64_t> data(ITERATIONS * ELEMENTS_PER_CACHE_LINE, 0);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(
            aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }

    for (uint32_t iter = 0; iter < ITERATIONS; ++iter) {
        multi_core_cacheline_overwrite_kernel<<<NUM_BLOCKS, 0, stream>>>(dataDevice + iter * CACHE_LINE_BYTES);
        if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
            return 1;
        }
    }

    if (CheckAcl(
            aclrtMemcpy(data.data(), dataByteSize, dataDevice, dataByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(data D2H)")) {
        return 1;
    }

    uint32_t mismatchCount = 0;
    uint32_t firstMismatch = ITERATIONS;
    for (uint32_t iter = 0; iter < ITERATIONS; ++iter) {
        if (!IsExpectedLine(data, iter)) {
            if (firstMismatch == ITERATIONS) {
                firstMismatch = iter;
            }
            ++mismatchCount;
        }
    }

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/cacheline_overwrite_output.bin", data.data(), dataByteSize);

    std::cout << "same Cache Line multi-core overwrite mismatches: " << mismatchCount << "/" << ITERATIONS
              << std::endl;
    if (firstMismatch != ITERATIONS) {
        PrintLine(data, firstMismatch, "first mismatched line:");
        std::cout << "expected line: 1 2 3 4 5 6 7 8" << std::endl;
    }
    std::cout << "observed output written to output/cacheline_overwrite_output.bin" << std::endl;

    aclrtFree(dataDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
