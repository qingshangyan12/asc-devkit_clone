/* !
 * \file scalar_gm_211_demo.asc
 * \brief Observes the Scalar GM cache consistency cases described in section 2.1.1.
 */

#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t NUM_BLOCKS = 2;
constexpr uint32_t ITEM_COUNT = 64;
constexpr uint32_t DATA_STRIDE = 32; // 观测元素之间间隔128B，避免共享同一条DCache Cache Line。
constexpr uint32_t CASE_DIRTY_NO_DCCI_BASE = 0;
constexpr uint32_t CASE_DIRTY_WITH_DCCI_BASE = CASE_DIRTY_NO_DCCI_BASE + ITEM_COUNT * DATA_STRIDE;
constexpr uint32_t CASE_STALE_READER_BASE = CASE_DIRTY_WITH_DCCI_BASE + ITEM_COUNT * DATA_STRIDE;
constexpr uint32_t DATA_COUNT = CASE_STALE_READER_BASE + ITEM_COUNT * DATA_STRIDE;

constexpr uint32_t RESULT_COUNT = 16;
constexpr uint32_t RESULT_STRIDE = 32;
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;

constexpr uint32_t RES_NO_DCCI_ZERO = 0;
constexpr uint32_t RES_NO_DCCI_ONE = 1;
constexpr uint32_t RES_WITH_DCCI_ZERO = 2;
constexpr uint32_t RES_WITH_DCCI_ONE = 3;
constexpr uint32_t RES_STALE_WARM_ZERO = 4;
constexpr uint32_t RES_STALE_NO_DCCI_ZERO = 5;
constexpr uint32_t RES_STALE_NO_DCCI_ONE = 6;
constexpr uint32_t RES_STALE_AFTER_DCCI_ZERO = 7;
constexpr uint32_t RES_STALE_AFTER_DCCI_ONE = 8;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

__aicore__ inline int32_t ReadScalarCache(__gm__ int32_t* ptr)
{
    volatile __gm__ int32_t* volatilePtr = ptr;
    return *volatilePtr;
}

__aicore__ inline void WriteScalarCache(__gm__ int32_t* ptr, int32_t value)
{
    // 直接写__gm__地址，走普通Scalar DCache路径，用于构造生产者Dirty副本。
    volatile __gm__ int32_t* volatilePtr = ptr;
    *volatilePtr = value;
}

__aicore__ inline void DsbAll()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
}

__aicore__ inline void DsbGm()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

__aicore__ inline void WriteResult(__gm__ int32_t* results, uint32_t index, int32_t value)
{
    // C API目录中没有找到适合A2/A3的绕过DCache读接口；结果写入也保留基础API的绕过写，
    // 避免结果记录本身被Scalar DCache影响。
    AscendC::WriteGmByPassDCache<int32_t>(results + index * RESULT_STRIDE, value);
    DsbAll();
}

__aicore__ inline void DcciOutGm(__gm__ int32_t* data, uint32_t index)
{
    // C API单Cache Line DCCI，处理data[index]所在的DCache Cache Line。
    asc_dcci_single(reinterpret_cast<__gm__ void*>(data + index));
    // GM相关DCCI后使用DSB_DDR等待前序GM访问完成。
    DsbGm();
}

__aicore__ inline void DelayCycles(int64_t cycles)
{
    int64_t begin = asc_get_system_cycle();
    while (asc_get_system_cycle() - begin < cycles) {
    }
}

extern "C" __global__ __vector__ void scalar_dirty_without_dcci_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);

    uint32_t blockIdx = asc_get_block_idx();
    if (blockIdx == 0) {
        // 生产者只做Scalar带Cache写，不做DCCI，Dirty数据可能仍停留在本核DCache。
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            WriteScalarCache(data + CASE_DIRTY_NO_DCCI_BASE + i * DATA_STRIDE, 1);
        }
        DsbAll();
        DelayCycles(500000);
    } else if (blockIdx == 1) {
        DelayCycles(100000);
        int32_t zeroCount = 0;
        int32_t oneCount = 0;
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            int32_t value = ReadScalarCache(data + CASE_DIRTY_NO_DCCI_BASE + i * DATA_STRIDE);
            if (value == 0) {
                ++zeroCount;
            } else if (value == 1) {
                ++oneCount;
            }
        }
        WriteResult(results, RES_NO_DCCI_ZERO, zeroCount);
        WriteResult(results, RES_NO_DCCI_ONE, oneCount);
    }

    asc_sync_pipe(PIPE_ALL);
}

extern "C" __global__ __vector__ void scalar_dirty_with_dcci_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);

    uint32_t blockIdx = asc_get_block_idx();
    if (blockIdx == 0) {
        // 生产者每写一个观测点就执行DCCI+DSB，把Dirty Cache Line发布到GM。
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            uint32_t index = CASE_DIRTY_WITH_DCCI_BASE + i * DATA_STRIDE;
            WriteScalarCache(data + index, 1);
            DcciOutGm(data, index);
        }
    } else if (blockIdx == 1) {
        DelayCycles(800000);
        int32_t zeroCount = 0;
        int32_t oneCount = 0;
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            int32_t value = ReadScalarCache(data + CASE_DIRTY_WITH_DCCI_BASE + i * DATA_STRIDE);
            if (value == 0) {
                ++zeroCount;
            } else if (value == 1) {
                ++oneCount;
            }
        }
        WriteResult(results, RES_WITH_DCCI_ZERO, zeroCount);
        WriteResult(results, RES_WITH_DCCI_ONE, oneCount);
    }

    asc_sync_pipe(PIPE_ALL);
}

extern "C" __global__ __vector__ void scalar_stale_reader_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);

    uint32_t blockIdx = asc_get_block_idx();
    if (blockIdx == 0) {
        DelayCycles(120000);
        // 生产者写新值并发布到GM，用于验证消费者本核旧DCache副本问题。
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            uint32_t index = CASE_STALE_READER_BASE + i * DATA_STRIDE;
            WriteScalarCache(data + index, 1);
            DcciOutGm(data, index);
        }
    } else if (blockIdx == 1) {
        // 消费者先读一次旧值，主动在本核DCache中形成旧副本。
        int32_t warmZeroCount = 0;
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            int32_t value = ReadScalarCache(data + CASE_STALE_READER_BASE + i * DATA_STRIDE);
            if (value == 0) {
                ++warmZeroCount;
            }
        }
        WriteResult(results, RES_STALE_WARM_ZERO, warmZeroCount);

        DelayCycles(1000000);
        int32_t staleZeroCount = 0;
        int32_t staleOneCount = 0;
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            int32_t value = ReadScalarCache(data + CASE_STALE_READER_BASE + i * DATA_STRIDE);
            if (value == 0) {
                ++staleZeroCount;
            } else if (value == 1) {
                ++staleOneCount;
            }
        }
        WriteResult(results, RES_STALE_NO_DCCI_ZERO, staleZeroCount);
        WriteResult(results, RES_STALE_NO_DCCI_ONE, staleOneCount);

        int32_t freshZeroCount = 0;
        int32_t freshOneCount = 0;
        for (uint32_t i = 0; i < ITEM_COUNT; ++i) {
            uint32_t index = CASE_STALE_READER_BASE + i * DATA_STRIDE;
            // 读端DCCI使消费者本核旧DCache副本失效，再读应能看到GM新值。
            DcciOutGm(data, index);
            int32_t value = ReadScalarCache(data + index);
            if (value == 0) {
                ++freshZeroCount;
            } else if (value == 1) {
                ++freshOneCount;
            }
        }
        WriteResult(results, RES_STALE_AFTER_DCCI_ZERO, freshZeroCount);
        WriteResult(results, RES_STALE_AFTER_DCCI_ONE, freshOneCount);
    }

    asc_sync_pipe(PIPE_ALL);
}

void PrintCount(const char* label, int32_t zeroCount, int32_t oneCount)
{
    std::cout << label << ": read 0 = " << zeroCount << ", read 1 = " << oneCount << "/" << ITEM_COUNT
              << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_COUNT * sizeof(int32_t);
    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);

    std::vector<int32_t> data(DATA_COUNT, 0);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    uint8_t* resultDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(results)")) {
        return 1;
    }

    if (CheckAcl(
            aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }
    if (CheckAcl(
            aclrtMemcpy(resultDevice, resultByteSize, results.data(), resultByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(results H2D)")) {
        return 1;
    }

    scalar_dirty_without_dcci_kernel<<<NUM_BLOCKS, 0, stream>>>(dataDevice, resultDevice);
    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(no dcci)")) {
        return 1;
    }

    scalar_dirty_with_dcci_kernel<<<NUM_BLOCKS, 0, stream>>>(dataDevice, resultDevice);
    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(with dcci)")) {
        return 1;
    }

    scalar_stale_reader_kernel<<<NUM_BLOCKS, 0, stream>>>(dataDevice, resultDevice);
    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(stale reader)")) {
        return 1;
    }

    if (CheckAcl(
            aclrtMemcpy(results.data(), resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(results D2H)")) {
        return 1;
    }

    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/scalar_gm_211_output.bin", results.data(), resultByteSize);

    std::cout << "section 2.1.1 Scalar GM cache observations:" << std::endl;
    PrintCount(
        "[0] producer Scalar.ST without DCCI, consumer Scalar.LD",
        results[RES_NO_DCCI_ZERO * RESULT_STRIDE],
        results[RES_NO_DCCI_ONE * RESULT_STRIDE]);
    PrintCount(
        "[1] producer Scalar.ST + DCCI + DSB, consumer Scalar.LD",
        results[RES_WITH_DCCI_ZERO * RESULT_STRIDE],
        results[RES_WITH_DCCI_ONE * RESULT_STRIDE]);
    std::cout << "[2] consumer warm Scalar.LD old value count = "
              << results[RES_STALE_WARM_ZERO * RESULT_STRIDE] << "/" << ITEM_COUNT << std::endl;
    PrintCount(
        "[3] producer published GM, consumer Scalar.LD without read-side DCCI",
        results[RES_STALE_NO_DCCI_ZERO * RESULT_STRIDE],
        results[RES_STALE_NO_DCCI_ONE * RESULT_STRIDE]);
    PrintCount(
        "[4] consumer DCCI before Scalar.LD",
        results[RES_STALE_AFTER_DCCI_ZERO * RESULT_STRIDE],
        results[RES_STALE_AFTER_DCCI_ONE * RESULT_STRIDE]);
    std::cout << "observed output written to output/scalar_gm_211_output.bin" << std::endl;

    aclrtFree(dataDevice);
    aclrtFree(resultDevice);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
