/* !
 * \file cache_consistency_verify.asc
 * \brief Cache consistency verification cases for Scalar DCache, bypass GM access, and DMA atomic transfer.
 */

#include <cstdint>
#include <iostream>
#include <sys/stat.h>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t DATA_COUNT = 512;
constexpr uint32_t RESULT_COUNT = 16;
constexpr uint32_t RESULT_STRIDE = 32; // 每个结果间隔128B，避免共享同一条DCache Cache Line。
constexpr uint32_t RESULT_STORAGE_COUNT = RESULT_COUNT * RESULT_STRIDE;
constexpr uint32_t ATOMIC_LENGTH = 8; // 8个int32_t等于32B，满足搬运粒度要求。

constexpr uint32_t IDX_RAW_NEG = 0;
constexpr uint32_t IDX_RAW_POS = 32;
constexpr uint32_t IDX_STALE_NEG = 64;
constexpr uint32_t IDX_STALE_POS = 96;
constexpr uint32_t IDX_WAW_NEG = 128;
constexpr uint32_t IDX_WAW_POS = 160;
constexpr uint32_t IDX_BYPASS = 192;
constexpr uint32_t IDX_ATOMIC_DST_NEG = 224;
constexpr uint32_t IDX_ATOMIC_SRC_NEG = 256;
constexpr uint32_t IDX_ATOMIC_DST_POS = 288;
constexpr uint32_t IDX_ATOMIC_SRC_POS = 320;

constexpr uint32_t RES_RAW_NEG = 0;
constexpr uint32_t RES_RAW_POS = 1;
constexpr uint32_t RES_STALE_NEG = 2;
constexpr uint32_t RES_STALE_POS = 3;
constexpr uint32_t RES_WAW_NEG_A = 4;
constexpr uint32_t RES_WAW_NEG_B = 5;
constexpr uint32_t RES_WAW_POS_A = 6;
constexpr uint32_t RES_WAW_POS_B = 7;
constexpr uint32_t RES_BYPASS = 8;
constexpr uint32_t RES_ATOMIC_NEG = 9;
constexpr uint32_t RES_ATOMIC_POS = 10;
constexpr uint32_t RES_PROGRESS = 15;

int32_t CheckAcl(aclError ret, const char* expr)
{
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] " << expr << " failed, ret=" << ret << std::endl;
        return 1;
    }
    return 0;
}

__aicore__ inline __gm__ int32_t* AsInt32Gm(__gm__ uint8_t* ptr)
{
    return reinterpret_cast<__gm__ int32_t*>(ptr);
}

__aicore__ inline void WriteBypass(__gm__ int32_t* ptr, int32_t value)
{
    // C API目录中没有适合A2/A3的绕过DCache读接口；绕过写的asc_store_dev也不支持A2/A3。
    // 这里保留基础API，用于构造“直接访问GM、不经过Scalar DCache”的对照路径。
    AscendC::WriteGmByPassDCache<int32_t>(ptr, value);
}

__aicore__ inline int32_t ReadBypass(__gm__ int32_t* ptr)
{
    // 保留基础API：C API目录中未找到ReadGmByPassDCache的等价接口。
    return AscendC::ReadGmByPassDCache<int32_t>(ptr);
}

__aicore__ inline int32_t ReadScalarCache(__gm__ int32_t* ptr)
{
    volatile __gm__ int32_t* volatilePtr = ptr;
    return *volatilePtr;
}

__aicore__ inline void WriteScalarCache(__gm__ int32_t* ptr, int32_t value)
{
    // 直接写__gm__地址，走普通Scalar DCache路径，用来构造Dirty副本。
    volatile __gm__ int32_t* volatilePtr = ptr;
    *volatilePtr = value;
}

__aicore__ inline void DsbAll()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
}

__aicore__ inline void DsbGm()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
}

__aicore__ inline void WriteResult(__gm__ int32_t* results, uint32_t index, int32_t value)
{
    WriteBypass(results + index * RESULT_STRIDE, value);
    DsbAll();
}

__aicore__ inline void DcciOutGm(__gm__ int32_t* data, uint32_t index)
{
    // C API版本的单Cache Line DCCI，处理data[index]所在的DCache Cache Line。
    asc_dcci_single(reinterpret_cast<__gm__ void*>(data + index));
    // GM相关DCCI后使用DSB_DDR等待前序GM访问完成。
    DsbGm();
}

__aicore__ inline void AtomicAddFromGm(__gm__ int32_t* src, __gm__ int32_t* dst)
{
    __ubuf__ int32_t srcLocal[ATOMIC_LENGTH];

    // MTE2: GM -> UB，使用C API搬入源数据。
    asc_copy_gm2ub(srcLocal, src, ATOMIC_LENGTH * sizeof(int32_t));
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);

    // MTE3随路原子：开启atomic add后，后续UB -> GM搬运对目的GM执行累加。
    asc_set_atomic_none();
    asc_set_atomic_add_int();
    asc_copy_ub2gm(dst, srcLocal, ATOMIC_LENGTH * sizeof(int32_t));
    asc_set_atomic_none();

    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
}

extern "C" __global__ __vector__ void cache_consistency_verify_kernel(__gm__ uint8_t* dataGm, __gm__ uint8_t* resultGm)
{
    asc_init();

    __gm__ int32_t* data = AsInt32Gm(dataGm);
    __gm__ int32_t* results = AsInt32Gm(resultGm);

    // RAW反例：Scalar带Cache写后，不做DCCI，绕过DCache读GM可能看不到新值。
    WriteScalarCache(data + IDX_RAW_NEG, 1);
    WriteResult(results, RES_RAW_NEG, ReadBypass(data + IDX_RAW_NEG));
    WriteResult(results, RES_PROGRESS, 1);

    // RAW正例：DCCI+DSB把Scalar Dirty Cache Line写回GM。
    WriteScalarCache(data + IDX_RAW_POS, 1);
    DcciOutGm(data, IDX_RAW_POS);
    WriteResult(results, RES_RAW_POS, ReadBypass(data + IDX_RAW_POS));
    WriteResult(results, RES_PROGRESS, 2);

    // 读端旧副本反例：GM被绕过DCache路径更新后，Scalar可能继续命中旧DCache副本。
    (void)ReadScalarCache(data + IDX_STALE_NEG);
    WriteBypass(data + IDX_STALE_NEG, 1);
    DsbAll();
    WriteResult(results, RES_STALE_NEG, ReadScalarCache(data + IDX_STALE_NEG));
    WriteResult(results, RES_PROGRESS, 3);

    // 读端旧副本正例：读前DCCI使旧DCache副本失效。
    (void)ReadScalarCache(data + IDX_STALE_POS);
    WriteBypass(data + IDX_STALE_POS, 1);
    DsbAll();
    DcciOutGm(data, IDX_STALE_POS);
    WriteResult(results, RES_STALE_POS, ReadScalarCache(data + IDX_STALE_POS));
    WriteResult(results, RES_PROGRESS, 4);

    // WAW反例：后写已经发生后，再写回前序Scalar Dirty副本，可能覆盖后写。
    WriteScalarCache(data + IDX_WAW_NEG, 1);
    WriteBypass(data + IDX_WAW_NEG + 1, 2);
    DsbAll();
    DcciOutGm(data, IDX_WAW_NEG);
    WriteResult(results, RES_WAW_NEG_A, ReadBypass(data + IDX_WAW_NEG));
    WriteResult(results, RES_WAW_NEG_B, ReadBypass(data + IDX_WAW_NEG + 1));
    WriteResult(results, RES_PROGRESS, 5);

    // WAW正例：先写回前序Scalar Dirty副本，再执行后写。
    WriteScalarCache(data + IDX_WAW_POS, 1);
    DcciOutGm(data, IDX_WAW_POS);
    WriteBypass(data + IDX_WAW_POS + 1, 2);
    DsbAll();
    WriteResult(results, RES_WAW_POS_A, ReadBypass(data + IDX_WAW_POS));
    WriteResult(results, RES_WAW_POS_B, ReadBypass(data + IDX_WAW_POS + 1));
    WriteResult(results, RES_PROGRESS, 6);

    // 绕过DCache路径：写和读都不依赖Scalar DCache副本。
    WriteBypass(data + IDX_BYPASS, 1);
    DsbAll();
    WriteResult(results, RES_BYPASS, ReadBypass(data + IDX_BYPASS));
    WriteResult(results, RES_PROGRESS, 7);

    // Atomic反例：原子前不写回Scalar Dirty初值，MTE3随路原子可能基于GM旧值累加。
    WriteScalarCache(data + IDX_ATOMIC_DST_NEG, 10);
    AtomicAddFromGm(data + IDX_ATOMIC_SRC_NEG, data + IDX_ATOMIC_DST_NEG);
    WriteResult(results, RES_ATOMIC_NEG, ReadBypass(data + IDX_ATOMIC_DST_NEG));
    WriteResult(results, RES_PROGRESS, 8);

    // Atomic正例：原子前先DCCI+DSB发布Scalar Dirty初值。
    WriteScalarCache(data + IDX_ATOMIC_DST_POS, 10);
    DcciOutGm(data, IDX_ATOMIC_DST_POS);
    AtomicAddFromGm(data + IDX_ATOMIC_SRC_POS, data + IDX_ATOMIC_DST_POS);
    WriteResult(results, RES_ATOMIC_POS, ReadBypass(data + IDX_ATOMIC_DST_POS));
    WriteResult(results, RES_PROGRESS, 9);

    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t dataByteSize = DATA_COUNT * sizeof(int32_t);
    size_t resultByteSize = RESULT_STORAGE_COUNT * sizeof(int32_t);

    std::vector<int32_t> data(DATA_COUNT, 0);
    std::vector<int32_t> results(RESULT_STORAGE_COUNT, -777);

    for (uint32_t i = 0; i < ATOMIC_LENGTH; ++i) {
        data[IDX_ATOMIC_SRC_NEG + i] = 5;
        data[IDX_ATOMIC_SRC_POS + i] = 5;
    }

    if (CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    int32_t deviceId = 0;
    if (CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        return 1;
    }
    aclrtStream stream = nullptr;
    if (CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        return 1;
    }

    uint8_t* dataDevice = nullptr;
    uint8_t* resultDevice = nullptr;
    if (CheckAcl(aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(data)")) {
        return 1;
    }
    if (CheckAcl(aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(results)")) {
        return 1;
    }

    if (CheckAcl(
            aclrtMemcpy(dataDevice, dataByteSize, data.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(data H2D)")) {
        return 1;
    }
    if (CheckAcl(
            aclrtMemcpy(resultDevice, resultByteSize, results.data(), resultByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(results H2D)")) {
        return 1;
    }

    cache_consistency_verify_kernel<<<NUM_BLOCKS, 0, stream>>>(dataDevice, resultDevice);
    if (CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        return 1;
    }

    if (CheckAcl(
            aclrtMemcpy(results.data(), resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(results D2H)")) {
        return 1;
    }
    mkdir("./output", S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH);
    WriteFile("./output/output.bin", results.data(), resultByteSize);

    std::cout << "observed output written to output/output.bin" << std::endl;
    std::cout << "run scripts/verify_result.py to check positive cases" << std::endl;

    aclrtFree(dataDevice);
    aclrtFree(resultDevice);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
