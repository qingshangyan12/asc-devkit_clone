/* !
 * \file hash_table_mte_value_move.asc
 * \brief HashTable insert_or_assign benchmark.
 *        SCENARIO_NUM=0: SIMT group probes the table and stores value elements directly.
 *        SCENARIO_NUM=1: SIMT probes the table, then a second MTE kernel writes value vectors.
 *        SCENARIO_NUM=2: SIMT probes the table, then an in-kernel MTE task queue writes value vectors.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <utility>
#include <vector>

constexpr uint32_t scenarioNum = SCENARIO_NUM;

namespace {
constexpr uint32_t THREAD_COUNT = 512;
constexpr uint32_t GROUP_SIZE = 32;
constexpr uint32_t KEY_NUM = 128 * 1024;
constexpr uint32_t HASH_TABLE_CAPACITY = 256 * 1024;
constexpr uint32_t BLOCK_DIM = 64;
constexpr uint32_t PROFILE_REPEAT_TIMES = 30;
constexpr uint32_t MTE_BATCH_SIZE = 32;
constexpr uint32_t MTE_LOCAL_VALUE_COUNT = MTE_BATCH_SIZE * 256;
constexpr uint32_t MTE_COPY_BUFFER_DEPTH = 2;
constexpr uint32_t MTE_TASK_RING_CAPACITY = 128;
constexpr uint32_t MTE_TASK_RING_MASK = MTE_TASK_RING_CAPACITY - 1;
constexpr uint32_t MTE_TASK_RING_PRIME_LIMIT = MTE_TASK_RING_CAPACITY - MTE_BATCH_SIZE;
constexpr uint32_t UB_ALIGN_SIZE = 32;
constexpr uint32_t INVALID_BUCKET = 0xffffffffU;
constexpr int64_t EMPTY_KEY = 0;
constexpr int64_t LOCKED_KEY = -1;
constexpr uint32_t TEST_DIMS[] = {16, 32, 64, 128, 256};
} // namespace

#define CHECK_ACL(expr)                                                                                               \
    do {                                                                                                             \
        aclError ret = (expr);                                                                                       \
        if (ret != ACL_SUCCESS) {                                                                                    \
            std::cerr << "ACL call failed: " #expr << ", ret=" << static_cast<int32_t>(ret) << std::endl;           \
            std::exit(1);                                                                                            \
        }                                                                                                            \
    } while (0)

inline uint64_t hash_key_host(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

__simt_callee__ inline uint64_t hash_key_device(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

__simt_callee__ inline int64_t wait_until_unlocked(__gm__ const int64_t* keyAddr)
{
    int64_t currentKey = *keyAddr;
    while (currentKey == LOCKED_KEY) {
        currentKey = *keyAddr;
    }
    return currentKey;
}

// Minimal device-side vector wrapper used by the host sample code.
template <typename T>
class device_vector {
public:
    using value_type = T;
    using size_type = size_t;

    explicit device_vector(size_type count) : count_(count)
    {
        if (count_ == 0) {
            return;
        }
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&data_), bytes(), ACL_MEM_MALLOC_HUGE_FIRST));
    }

    ~device_vector()
    {
        if (data_ != nullptr) {
            aclError ret = aclrtFree(data_);
            if (ret != ACL_SUCCESS) {
                std::cerr << "ACL call failed: aclrtFree, ret=" << static_cast<int32_t>(ret) << std::endl;
            }
        }
    }

    device_vector(const device_vector&) = delete;
    device_vector& operator=(const device_vector&) = delete;

    T* data()
    {
        return data_;
    }

    const T* data() const
    {
        return data_;
    }

    size_type size() const
    {
        return count_;
    }

    size_type bytes() const
    {
        return count_ * sizeof(T);
    }

    void copy_to(std::vector<T>& host) const
    {
        CHECK_ACL(aclrtMemcpy(host.data(), bytes(), data_, bytes(), ACL_MEMCPY_DEVICE_TO_HOST));
    }

    void fill_zero()
    {
        CHECK_ACL(aclrtMemset(data_, bytes(), 0, bytes()));
    }

private:
    T* data_ = nullptr;
    size_type count_ = 0;
};

// Fixed-capacity open-addressing map used by this benchmark.
// It exposes a small STL-like surface while keeping storage on device memory.
class unordered_map {
public:
    using key_type = int64_t;
    using mapped_type = float;
    using value_type = std::pair<key_type, mapped_type*>;
    using size_type = uint32_t;
    using insert_return_type = std::pair<size_type, bool>;

    // The key field is also the slot state:
    // EMPTY_KEY means unused, LOCKED_KEY means a writer owns the slot, and any other value is a published key.
    struct alignas(32) bucket_type {
        key_type key;
        key_type padding[3];
    };

    unordered_map(size_type bucketCount, size_type mappedDim, aclrtStream stream);
    ~unordered_map() = default;

    unordered_map(const unordered_map&) = delete;
    unordered_map& operator=(const unordered_map&) = delete;

    // Reset all buckets and values to the empty table state.
    void clear();

    // Insert or update a contiguous key/value range. The benchmark uses a fixed KEY_NUM input size.
    // Kernels publish a real key only after the mapped value vector has been fully written.
    insert_return_type insert_or_assign(
        const key_type* firstKey, const key_type* lastKey, const mapped_type* firstMapped);

    // Copy device table storage back to host for full-result verification.
    void copy_to(std::vector<bucket_type>& buckets, std::vector<mapped_type>& values) const;

    size_type size() const
    {
        return size_;
    }

    size_type bucket_count() const
    {
        return bucketCount_;
    }

    size_type mapped_dim() const
    {
        return mappedDim_;
    }

    double load_factor() const
    {
        return static_cast<double>(size_) / bucketCount_;
    }

private:
    size_type bucketCount_ = 0;
    size_type mappedDim_ = 0;
    size_type size_ = 0;
    aclrtStream stream_ = nullptr;
    device_vector<bucket_type> buckets_;
    device_vector<mapped_type> values_;
    device_vector<size_type> bucketIndices_;
    device_vector<uint32_t> findMismatchCount_;
};

using Bucket = unordered_map::bucket_type;

__simt_vf__ inline void insert_or_assign_group_store_vf(__gm__ Bucket* table,
    __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum,
    uint32_t capacity, uint32_t dim, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t tid = static_cast<uint32_t>(threadIdx.x);
    const uint32_t laneId = tid % GROUP_SIZE;
    const uint32_t groupIdInBlock = tid / GROUP_SIZE;
    const uint32_t groupsPerBlock = static_cast<uint32_t>(blockDim.x) / GROUP_SIZE;
    const uint32_t globalGroupId = blockIndex * groupsPerBlock + groupIdInBlock;
    const uint32_t totalGroups = blockNum * groupsPerBlock;

    for (uint32_t idx = globalGroupId; idx < keyNum; idx += totalGroups) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = 0;
        int32_t success = 0;

        if (laneId == 0) {
            bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
            for (uint32_t probe = 0; probe < capacity; ++probe) {
                __gm__ int64_t* keyAddr = &table[bucketIdx].key;
                int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
                if (oldKey == LOCKED_KEY) {
                    oldKey = wait_until_unlocked(keyAddr);
                }
                if (oldKey == EMPTY_KEY) {
                    success = 1;
                    break;
                }
                if (oldKey == key) {
                    oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                    if (oldKey == key) {
                        success = 1;
                        break;
                    }
                    continue;
                }
                bucketIdx = (bucketIdx + 1) & (capacity - 1);
            }
        }

        success = asc_shfl(success, 0, GROUP_SIZE);
        bucketIdx = asc_shfl(bucketIdx, 0, GROUP_SIZE);
        if (success == 1) {
            uint32_t dstBase = bucketIdx * dim;
            uint32_t srcBase = idx * dim;
            for (uint32_t j = laneId; j < dim; j += GROUP_SIZE) {
                tableValues[dstBase + j] = values[srcBase + j];
            }
            asc_threadfence();
            if (laneId == 0) {
                (void)asc_atomic_exch(&table[bucketIdx].key, key);
            }
        }
    }
}

__global__ __vector__ void insert_or_assign_group_store_kernel(__gm__ Bucket* table,
    __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum,
    uint32_t capacity, uint32_t dim)
{
    asc_vf_call<insert_or_assign_group_store_vf>(
        dim3(THREAD_COUNT), table, tableValues, keys, values, keyNum, capacity, dim, block_idx, BLOCK_DIM);
}

__simt_vf__ inline void insert_or_assign_probe_vf(__gm__ Bucket* table, __gm__ const int64_t* keys,
    __gm__ uint32_t* bucketIndices, uint32_t keyNum, uint32_t capacity, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t threadAll = static_cast<uint32_t>(blockDim.x) * blockNum;
    for (uint32_t idx = blockIndex * static_cast<uint32_t>(blockDim.x) + static_cast<uint32_t>(threadIdx.x);
         idx < keyNum; idx += threadAll) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t result = INVALID_BUCKET;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            __gm__ int64_t* keyAddr = &table[bucketIdx].key;
            int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
            if (oldKey == LOCKED_KEY) {
                oldKey = wait_until_unlocked(keyAddr);
            }
            if (oldKey == EMPTY_KEY) {
                result = bucketIdx;
                break;
            }
            if (oldKey == key) {
                oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                if (oldKey == key) {
                    result = bucketIdx;
                    break;
                }
                continue;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        bucketIndices[idx] = result;
    }
}

__global__ __vector__ void insert_or_assign_probe_kernel(
    __gm__ Bucket* table, __gm__ const int64_t* keys, __gm__ uint32_t* bucketIndices, uint32_t keyNum, uint32_t capacity)
{
    asc_vf_call<insert_or_assign_probe_vf>(
        dim3(THREAD_COUNT), table, keys, bucketIndices, keyNum, capacity, block_idx, BLOCK_DIM);
}

__global__ __vector__ void write_values_mte_queue_kernel(
    __gm__ Bucket* table, __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values,
    __gm__ const uint32_t* bucketIndices, uint32_t dim)
{
    asc_init();

    const uint32_t coreIdx = static_cast<uint32_t>(block_idx);
    const uint32_t coreNum = BLOCK_DIM;
    const uint32_t rowsPerCore = (KEY_NUM + coreNum - 1) / coreNum;
    const uint32_t coreStart = coreIdx * rowsPerCore;
    const uint32_t coreEnd = (coreStart + rowsPerCore < KEY_NUM) ? (coreStart + rowsPerCore) : KEY_NUM;

    __ubuf__ float valueLocal[MTE_LOCAL_VALUE_COUNT];
    const uint8_t valuesCacheMode = static_cast<uint8_t>((reinterpret_cast<uint64_t>(values)) >> 60);
    const uint8_t tableValuesCacheMode = static_cast<uint8_t>((reinterpret_cast<uint64_t>(tableValues)) >> 60);

    for (uint32_t baseRow = coreStart; baseRow < coreEnd; baseRow += MTE_BATCH_SIZE) {
        uint32_t remain = coreEnd - baseRow;
        uint32_t batchCount = (MTE_BATCH_SIZE < remain) ? MTE_BATCH_SIZE : remain;
        uint32_t copyInBytes = batchCount * dim * sizeof(float);
        asc_copy_gm2ub_align(
            valueLocal, const_cast<__gm__ float*>(values + baseRow * dim), 1, copyInBytes, 0, 0, true,
            valuesCacheMode, 0, 0);
        asc_sync_pipe(pipe_t::PIPE_ALL);

        uint32_t copyOutBytes = dim * sizeof(float);
        for (uint32_t i = 0; i < batchCount; ++i) {
            uint32_t bucketIdx = bucketIndices[baseRow + i];
            if (bucketIdx == INVALID_BUCKET) {
                continue;
            }
            asc_copy_ub2gm_align(
                tableValues + bucketIdx * dim, valueLocal + i * dim, 1, copyOutBytes, tableValuesCacheMode, 0, 0);
        }
        asc_sync_pipe(pipe_t::PIPE_ALL);
        asc_sync_data_barrier(mem_dsb_t::DSB_ALL);

        for (uint32_t i = 0; i < batchCount; ++i) {
            uint32_t bucketIdx = bucketIndices[baseRow + i];
            if (bucketIdx == INVALID_BUCKET) {
                continue;
            }
            (void)asc_atomic_exch(&table[bucketIdx].key, keys[baseRow + i]);
        }
    }
}

// SIMT producer: probe the hash table, lock a bucket, and write one task per input key into the UB ring.
__simt_vf__ inline void insert_or_assign_task_queue_probe_vf(__gm__ Bucket* table, __gm__ const int64_t* keys,
    __ubuf__ uint32_t* taskKeyIndices, __ubuf__ uint32_t* taskBucketIndices, __ubuf__ int64_t* taskKeys,
    uint32_t keyStart, uint32_t keyCount, uint32_t capacity, uint32_t taskStart)
{
    for (uint32_t localIdx = static_cast<uint32_t>(threadIdx.x); localIdx < keyCount;
         localIdx += static_cast<uint32_t>(blockDim.x)) {
        uint32_t keyIdx = keyStart + localIdx;
        int64_t key = keys[keyIdx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t result = INVALID_BUCKET;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            __gm__ int64_t* keyAddr = &table[bucketIdx].key;
            int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
            if (oldKey == LOCKED_KEY) {
                oldKey = wait_until_unlocked(keyAddr);
            }
            if (oldKey == EMPTY_KEY) {
                result = bucketIdx;
                break;
            }
            if (oldKey == key) {
                oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                if (oldKey == key) {
                    result = bucketIdx;
                    break;
                }
                continue;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        uint32_t taskSlot = (taskStart + localIdx) & MTE_TASK_RING_MASK;
        taskKeyIndices[taskSlot] = keyIdx;
        taskBucketIndices[taskSlot] = result;
        taskKeys[taskSlot] = key;
    }
}

class MTETaskQueue {
public:
    // Bind the GM table/value buffers and UB task/value buffers used by the producer-consumer pipeline.
    __aicore__ inline void Init(__gm__ Bucket* table, __gm__ float* tableValues, __gm__ const int64_t* keys,
        __gm__ const float* values, __ubuf__ float* valueLocal, __ubuf__ uint32_t* taskKeyIndices,
        __ubuf__ uint32_t* taskBucketIndices, __ubuf__ int64_t* taskKeys, uint32_t dim)
    {
        table_ = table;
        tableValues_ = tableValues;
        keys_ = keys;
        values_ = values;
        valueLocal_ = valueLocal;
        taskKeyIndices_ = taskKeyIndices;
        taskBucketIndices_ = taskBucketIndices;
        taskKeys_ = taskKeys;
        dim_ = dim;
        valuesCacheMode_ = static_cast<uint8_t>((reinterpret_cast<uint64_t>(values)) >> 60);
        tableValuesCacheMode_ = static_cast<uint8_t>((reinterpret_cast<uint64_t>(tableValues)) >> 60);
    }

    // Decide how many value vectors can be staged in the UB value buffer for one MTE consume step.
    __aicore__ inline uint32_t MaxProcTaskCount() const
    {
        uint32_t valueBytes = dim_ * sizeof(float);
        uint32_t valueBytesAligned = ((valueBytes + UB_ALIGN_SIZE - 1) / UB_ALIGN_SIZE) * UB_ALIGN_SIZE;
        uint32_t maxByUb = MTE_LOCAL_VALUE_COUNT * sizeof(float) / valueBytesAligned;
        if (maxByUb == 0) {
            return 1;
        }
        return (maxByUb < MTE_BATCH_SIZE) ? maxByUb : MTE_BATCH_SIZE;
    }

    // Produce a contiguous run of ring tasks. The contiguous limit prevents a single VF call from wrapping the ring.
    __aicore__ inline uint32_t ProduceTasks(
        __gm__ Bucket* table, __gm__ const int64_t* keys, uint32_t keyStart, uint32_t keyEnd, uint32_t capacity,
        uint32_t assignId, uint32_t finishId, uint32_t queueLimit)
    {
        uint32_t freeCount = queueLimit - (assignId - finishId);
        uint32_t remainKeys = keyEnd - keyStart;
        uint32_t taskSlot = assignId & MTE_TASK_RING_MASK;
        uint32_t contiguousFree = MTE_TASK_RING_CAPACITY - taskSlot;
        uint32_t produceCount = freeCount;
        if (produceCount > remainKeys) {
            produceCount = remainKeys;
        }
        if (produceCount > contiguousFree) {
            produceCount = contiguousFree;
        }
        if (produceCount == 0) {
            return 0;
        }

        asc_vf_call<insert_or_assign_task_queue_probe_vf>(
            dim3(THREAD_COUNT), table, keys, taskKeyIndices_, taskBucketIndices_, taskKeys_, keyStart, produceCount,
            capacity, assignId);
        asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
        return produceCount;
    }

    // Choose a contiguous task run for the next MTE consume step.
    __aicore__ inline uint32_t CalcProcCount(uint32_t finishId, uint32_t assignId) const
    {
        uint32_t available = assignId - finishId;
        uint32_t taskSlot = finishId & MTE_TASK_RING_MASK;
        uint32_t contiguousTasks = MTE_TASK_RING_CAPACITY - taskSlot;
        uint32_t procCount = MaxProcTaskCount();
        if (procCount > available) {
            procCount = available;
        }
        if (procCount > contiguousTasks) {
            procCount = contiguousTasks;
        }
        return procCount;
    }

    // Start MTE2 copy-in for each task source recorded in the ring.
    __aicore__ inline void StartCopyIn(uint32_t finishId, uint32_t procCount, uint32_t valueSlot)
    {
        uint32_t taskSlot = finishId & MTE_TASK_RING_MASK;
        uint32_t copyInBytes = dim_ * sizeof(float);
        for (uint32_t i = 0; i < procCount; ++i) {
            uint32_t srcKeyIdx = taskKeyIndices_[taskSlot + i];
            asc_copy_gm2ub_align(valueLocal_ + valueSlot * MTE_LOCAL_VALUE_COUNT + i * dim_,
                const_cast<__gm__ float*>(values_ + srcKeyIdx * dim_), 1, copyInBytes, 0, 0, true, valuesCacheMode_, 0,
                0);
        }
    }

    // Wait for the outstanding MTE2 copy before using the UB value slot.
    __aicore__ inline void WaitCopyIn()
    {
        asc_sync_pipe(pipe_t::PIPE_MTE2);
    }

    // Start MTE3 copy-out from the staged UB values to hash-table value slots recorded in the task ring.
    __aicore__ inline void StartCopyOut(uint32_t finishId, uint32_t procCount, uint32_t valueSlot)
    {
        uint32_t copyOutBytes = dim_ * sizeof(float);
        uint32_t taskSlot = finishId & MTE_TASK_RING_MASK;
        for (uint32_t i = 0; i < procCount; ++i) {
            uint32_t bucketIdx = taskBucketIndices_[taskSlot + i];
            if (bucketIdx == INVALID_BUCKET) {
                continue;
            }
            asc_copy_ub2gm_align(tableValues_ + bucketIdx * dim_,
                valueLocal_ + valueSlot * MTE_LOCAL_VALUE_COUNT + i * dim_, 1, copyOutBytes, tableValuesCacheMode_, 0,
                0);
        }
    }

    // Publish real keys only after MTE3 finishes, so find never observes a key before its value is complete.
    __aicore__ inline void WaitCopyOutAndPublish(uint32_t finishId, uint32_t procCount)
    {
        asc_sync_pipe(pipe_t::PIPE_MTE3);
        asc_sync_data_barrier(mem_dsb_t::DSB_ALL);

        uint32_t taskSlot = finishId & MTE_TASK_RING_MASK;
        for (uint32_t i = 0; i < procCount; ++i) {
            uint32_t bucketIdx = taskBucketIndices_[taskSlot + i];
            if (bucketIdx == INVALID_BUCKET) {
                continue;
            }
            (void)asc_atomic_exch(&table_[bucketIdx].key, taskKeys_[taskSlot + i]);
        }
    }

private:
    __gm__ Bucket* table_ = nullptr;
    __gm__ float* tableValues_ = nullptr;
    __gm__ const int64_t* keys_ = nullptr;
    __gm__ const float* values_ = nullptr;
    __ubuf__ float* valueLocal_ = nullptr;
    __ubuf__ uint32_t* taskKeyIndices_ = nullptr;
    __ubuf__ uint32_t* taskBucketIndices_ = nullptr;
    __ubuf__ int64_t* taskKeys_ = nullptr;
    uint32_t dim_ = 0;
    uint8_t valuesCacheMode_ = 0;
    uint8_t tableValuesCacheMode_ = 0;
};

__global__ __vector__ void insert_or_assign_mte_task_queue_kernel(
    __gm__ Bucket* table, __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values,
    uint32_t keyNum, uint32_t capacity, uint32_t dim)
{
    asc_init();

    const uint32_t coreIdx = static_cast<uint32_t>(block_idx);
    const uint32_t coreNum = BLOCK_DIM;
    const uint32_t rowsPerCore = (keyNum + coreNum - 1) / coreNum;
    const uint32_t coreStart = coreIdx * rowsPerCore;
    const uint32_t coreEnd = (coreStart + rowsPerCore < keyNum) ? (coreStart + rowsPerCore) : keyNum;

    __ubuf__ float valueLocal[MTE_COPY_BUFFER_DEPTH * MTE_LOCAL_VALUE_COUNT];
    __ubuf__ uint32_t taskKeyIndices[MTE_TASK_RING_CAPACITY];
    __ubuf__ uint32_t taskBucketIndices[MTE_TASK_RING_CAPACITY];
    __ubuf__ int64_t taskKeys[MTE_TASK_RING_CAPACITY];

    MTETaskQueue taskQueue;
    taskQueue.Init(table, tableValues, keys, values, valueLocal, taskKeyIndices, taskBucketIndices, taskKeys, dim);

    if (coreStart >= coreEnd) {
        return;
    }

    // assignId is advanced by the SIMT producer, finishId by the MTE consumer.
    // Their distance is the number of valid tasks currently stored in the UB ring.
    uint32_t assignId = 0;
    uint32_t finishId = 0;
    uint32_t nextKey = coreStart;

    // Prime the ring before starting the first MTE2 transfer. Keep one consume batch empty so producer can run
    // while the first MTE3 copy-out is in flight.
    while (nextKey < coreEnd && assignId - finishId < MTE_TASK_RING_PRIME_LIMIT) {
        uint32_t produced =
            taskQueue.ProduceTasks(table, keys, nextKey, coreEnd, capacity, assignId, finishId,
                MTE_TASK_RING_PRIME_LIMIT);
        if (produced == 0) {
            break;
        }
        nextKey += produced;
        assignId += produced;
    }

    uint32_t currentValueSlot = 0;
    uint32_t currentFinishId = finishId;
    uint32_t currentProcCount = taskQueue.CalcProcCount(currentFinishId, assignId);
    taskQueue.StartCopyIn(currentFinishId, currentProcCount, currentValueSlot);

    while (finishId < assignId) {
        taskQueue.WaitCopyIn();
        taskQueue.StartCopyOut(currentFinishId, currentProcCount, currentValueSlot);

        // While current MTE3 is in flight, let SIMT fill newly available ring space.
        while (nextKey < coreEnd && assignId - finishId < MTE_TASK_RING_CAPACITY) {
            uint32_t produced =
                taskQueue.ProduceTasks(table, keys, nextKey, coreEnd, capacity, assignId, finishId,
                    MTE_TASK_RING_CAPACITY);
            if (produced == 0) {
                break;
            }
            nextKey += produced;
            assignId += produced;
        }

        uint32_t nextFinishId = currentFinishId + currentProcCount;
        uint32_t nextProcCount = 0;
        uint32_t nextValueSlot = currentValueSlot ^ 1U;
        if (nextFinishId < assignId) {
            // Prefetch only the next consume batch. C API waits are pipe-wide, so issuing more MTE2 batches here
            // would make the next WaitCopyIn wait for unrelated future work as well.
            nextProcCount = taskQueue.CalcProcCount(nextFinishId, assignId);
            taskQueue.StartCopyIn(nextFinishId, nextProcCount, nextValueSlot);
        }

        taskQueue.WaitCopyOutAndPublish(currentFinishId, currentProcCount);
        finishId = nextFinishId;

        if (finishId >= assignId) {
            break;
        }
        currentFinishId = nextFinishId;
        currentProcCount = nextProcCount;
        currentValueSlot = nextValueSlot;
    }
}

__simt_vf__ inline void find_verify_vf(__gm__ const Bucket* table, __gm__ const float* tableValues,
    __gm__ const int64_t* keys, __gm__ const float* expectedValues, __gm__ uint32_t* mismatchCount, uint32_t keyNum,
    uint32_t capacity, uint32_t dim, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t threadAll = static_cast<uint32_t>(blockDim.x) * blockNum;
    for (uint32_t idx = blockIndex * static_cast<uint32_t>(blockDim.x) +
         static_cast<uint32_t>(threadIdx.x);
         idx < keyNum; idx += threadAll) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t matched = 0;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            int64_t currentKey = table[bucketIdx].key;
            if (currentKey == key) {
                uint32_t valueBase = bucketIdx * dim;
                uint32_t srcBase = idx * dim;
                matched = 1;
                for (uint32_t j = 0; j < dim; ++j) {
                    if (tableValues[valueBase + j] != expectedValues[srcBase + j]) {
                        matched = 0;
                        break;
                    }
                }
                break;
            }
            if (currentKey == EMPTY_KEY) {
                break;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        if (matched == 0) {
            (void)asc_atomic_add(mismatchCount, 1U);
        }
    }
}

__global__ __vector__ void find_verify_kernel(__gm__ const Bucket* table, __gm__ const float* tableValues,
    __gm__ const int64_t* keys, __gm__ const float* expectedValues, __gm__ uint32_t* mismatchCount, uint32_t keyNum,
    uint32_t capacity, uint32_t dim)
{
    asc_vf_call<find_verify_vf>(
        dim3(THREAD_COUNT), table, tableValues, keys, expectedValues, mismatchCount, keyNum, capacity, dim, block_idx,
        BLOCK_DIM);
}

void InitHostData(std::vector<int64_t>& keys, std::vector<float>& values, uint32_t dim)
{
    for (uint32_t i = 0; i < KEY_NUM; ++i) {
        uint64_t rawKey = (static_cast<uint64_t>(i) * 11400714819323198485ULL) & (HASH_TABLE_CAPACITY - 1);
        keys[i] = static_cast<int64_t>(rawKey + 1);
        for (uint32_t j = 0; j < dim; ++j) {
            values[i * dim + j] = static_cast<float>(((i * 17 + j) & 0x3ff) * 0.25f);
        }
    }
}

// Host-side linear-probe find used after copying the device table back.
bool FindValueInTable(
    const std::vector<Bucket>& table, const std::vector<float>& tableValues, int64_t key, const float* expected,
    uint32_t dim)
{
    uint32_t bucketIdx = static_cast<uint32_t>(hash_key_host(key)) & (HASH_TABLE_CAPACITY - 1);
    for (uint32_t probe = 0; probe < HASH_TABLE_CAPACITY; ++probe) {
        const Bucket& bucket = table[bucketIdx];
        if (bucket.key == key) {
            uint32_t valueBase = bucketIdx * dim;
            for (uint32_t j = 0; j < dim; ++j) {
                if (std::fabs(tableValues[valueBase + j] - expected[j]) > 1e-6f) {
                    std::cerr << "Mismatch key=" << key << ", elem=" << j << ", expected=" << expected[j]
                              << ", actual=" << tableValues[valueBase + j] << std::endl;
                    return false;
                }
            }
            return true;
        }
        if (bucket.key == EMPTY_KEY) {
            return false;
        }
        bucketIdx = (bucketIdx + 1) & (HASH_TABLE_CAPACITY - 1);
    }
    return false;
}

// Validate both publication state and key/value contents for every inserted row.
bool VerifyResult(const std::vector<int64_t>& keys, const std::vector<float>& values, const std::vector<Bucket>& table,
    const std::vector<float>& tableValues, uint32_t dim)
{
    for (uint32_t bucketIdx = 0; bucketIdx < HASH_TABLE_CAPACITY; ++bucketIdx) {
        const Bucket& bucket = table[bucketIdx];
        if (bucket.key == LOCKED_KEY) {
            std::cerr << "Bucket remains locked, bucket=" << bucketIdx << std::endl;
            return false;
        }
    }

    for (uint32_t row = 0; row < KEY_NUM; ++row) {
        if (!FindValueInTable(table, tableValues, keys[row], values.data() + row * dim, dim)) {
            std::cerr << "Cannot find expected key/value, key=" << keys[row] << std::endl;
            return false;
        }
    }
    return true;
}

// Dispatch the selected benchmark scenario. Case 1 launches two kernels; cases 0 and 2 are single-kernel paths.
void LaunchInsertOrAssign(
    Bucket* buckets, float* mappedValues, const int64_t* keys, const float* values, uint32_t* bucketIndices,
    uint32_t dim, aclrtStream stream)
{
    if constexpr (scenarioNum == 0) {
        insert_or_assign_group_store_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, mappedValues, keys, values, KEY_NUM, HASH_TABLE_CAPACITY, dim);
    } else if constexpr (scenarioNum == 1) {
        insert_or_assign_probe_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, keys, bucketIndices, KEY_NUM, HASH_TABLE_CAPACITY);
        write_values_mte_queue_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, mappedValues, keys, values, bucketIndices, dim);
    } else {
        insert_or_assign_mte_task_queue_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, mappedValues, keys, values, KEY_NUM, HASH_TABLE_CAPACITY, dim);
    }
}

unordered_map::unordered_map(size_type bucketCount, size_type mappedDim, aclrtStream stream)
    : bucketCount_(bucketCount),
      mappedDim_(mappedDim),
      stream_(stream),
      buckets_(bucketCount),
      values_(static_cast<size_t>(bucketCount) * mappedDim),
      bucketIndices_(KEY_NUM),
      findMismatchCount_(1)
{
    clear();
}

void unordered_map::clear()
{
    buckets_.fill_zero();
    values_.fill_zero();
    size_ = 0;
}

unordered_map::insert_return_type unordered_map::insert_or_assign(
    const key_type* firstKey, const key_type* lastKey, const mapped_type* firstMapped)
{
    size_type count = static_cast<size_type>(lastKey - firstKey);
    if (count != KEY_NUM) {
        std::cerr << "Unsupported insert count: " << count << ", expected " << KEY_NUM << std::endl;
        return insert_return_type{0, false};
    }

    device_vector<key_type> keys(count);
    device_vector<mapped_type> mappedValues(static_cast<size_t>(count) * mappedDim_);

    CHECK_ACL(aclrtMemcpy(keys.data(), keys.bytes(), firstKey, keys.bytes(), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        mappedValues.data(), mappedValues.bytes(), firstMapped, mappedValues.bytes(), ACL_MEMCPY_HOST_TO_DEVICE));

    // Repeat the same insert_or_assign workload so msprof op captures the selected insert kernel(s).
    for (uint32_t i = 0; i < PROFILE_REPEAT_TIMES; ++i) {
        LaunchInsertOrAssign(
            buckets_.data(), values_.data(), keys.data(), mappedValues.data(), bucketIndices_.data(), mappedDim_,
            stream_);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream_));

    // Device-side find verification catches publication-order bugs before host copies inspect the table.
    findMismatchCount_.fill_zero();
    find_verify_kernel<<<BLOCK_DIM, 0, stream_>>>(
        buckets_.data(), values_.data(), keys.data(), mappedValues.data(), findMismatchCount_.data(), count,
        bucketCount_, mappedDim_);
    CHECK_ACL(aclrtSynchronizeStream(stream_));
    std::vector<uint32_t> mismatchCount(1);
    findMismatchCount_.copy_to(mismatchCount);
    if (mismatchCount[0] != 0) {
        std::cerr << "Device find verification failed, mismatch_count=" << mismatchCount[0] << std::endl;
        return insert_return_type{0, false};
    }

    size_ = count;
    return insert_return_type{count, true};
}

void unordered_map::copy_to(std::vector<bucket_type>& buckets, std::vector<mapped_type>& values) const
{
    buckets.resize(bucketCount_);
    values.resize(static_cast<size_t>(bucketCount_) * mappedDim_);
    buckets_.copy_to(buckets);
    values_.copy_to(values);
}

bool RunOneDim(uint32_t dim, aclrtStream stream)
{
    std::vector<int64_t> keys(KEY_NUM);
    std::vector<float> values(static_cast<size_t>(KEY_NUM) * dim);
    InitHostData(keys, values, dim);

    unordered_map table(HASH_TABLE_CAPACITY, dim, stream);
    auto insertResult = table.insert_or_assign(keys.data(), keys.data() + keys.size(), values.data());
    if (!insertResult.second) {
        return false;
    }

    std::vector<Bucket> buckets;
    std::vector<float> tableValues;
    table.copy_to(buckets, tableValues);
    bool ok = VerifyResult(keys, values, buckets, tableValues, dim);

    return ok;
}

void PrintHeader()
{
    const char* scenarioName = "MTE task queue insert_or_assign";
    if constexpr (scenarioNum == 0) {
        scenarioName = "SIMT group insert_or_assign";
    } else if constexpr (scenarioNum == 1) {
        scenarioName = "MTE two-stage insert_or_assign";
    }
    std::cout << "\n### HashTable insert_or_assign benchmark\n";
    std::cout << "* scenario = " << scenarioNum << " (" << scenarioName << ")\n";
    std::cout << "* capacity = " << HASH_TABLE_CAPACITY << ", key_num = " << KEY_NUM
              << ", load_factor = " << (static_cast<double>(KEY_NUM) / HASH_TABLE_CAPACITY) << "\n";
    std::cout << "* block_dim = " << BLOCK_DIM << ", thread_count = " << THREAD_COUNT
              << ", group_size = " << GROUP_SIZE << "\n";
    std::cout << "* profile_repeat = " << PROFILE_REPEAT_TIMES << "\n";
    std::cout << "* timing method = msprof op\n\n";
    std::cout << "| Scenario | Dim | Impl | Verify |\n";
    std::cout << "|---:|---:|:---|:---|\n";
}

void PrintResult(uint32_t dim, bool verifyOk)
{
    const char* scenarioName = "MTE task queue insert_or_assign";
    if constexpr (scenarioNum == 0) {
        scenarioName = "SIMT group insert_or_assign";
    } else if constexpr (scenarioNum == 1) {
        scenarioName = "MTE two-stage insert_or_assign";
    }
    std::cout << "| " << scenarioNum << " | " << dim << " | " << scenarioName << " | "
              << (verifyOk ? "PASS" : "FAIL") << " |\n";
}

bool IsSupportedDim(uint32_t dim)
{
    for (uint32_t supportedDim : TEST_DIMS) {
        if (dim == supportedDim) {
            return true;
        }
    }
    return false;
}

std::vector<uint32_t> GetDimsToRun(int32_t argc, char** argv)
{
    std::vector<uint32_t> dims;
    if (argc == 1) {
        for (uint32_t dim : TEST_DIMS) {
            dims.push_back(dim);
        }
        return dims;
    }
    if (argc != 2) {
        std::cerr << "Usage: " << argv[0] << " [dim]" << std::endl;
        return dims;
    }

    char* end = nullptr;
    unsigned long parsed = std::strtoul(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' || parsed == 0 || parsed > UINT32_MAX) {
        std::cerr << "Invalid dim: " << argv[1] << std::endl;
        return dims;
    }

    uint32_t dim = static_cast<uint32_t>(parsed);
    if (!IsSupportedDim(dim)) {
        std::cerr << "Unsupported dim: " << dim << ". Supported dims: ";
        for (uint32_t supportedDim : TEST_DIMS) {
            std::cerr << supportedDim << " ";
        }
        std::cerr << std::endl;
        return dims;
    }
    dims.push_back(dim);
    return dims;
}

int32_t main(int32_t argc, char** argv)
{
    std::vector<uint32_t> dims = GetDimsToRun(argc, argv);
    if (dims.empty()) {
        return 1;
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    PrintHeader();
    bool allOk = true;
    for (uint32_t dim : dims) {
        bool ok = RunOneDim(dim, stream);
        PrintResult(dim, ok);
        allOk = allOk && ok;
    }
    std::cout << (allOk ? "Verification PASSED" : "Verification FAILED") << std::endl;

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());

    return allOk ? 0 : 1;
}
