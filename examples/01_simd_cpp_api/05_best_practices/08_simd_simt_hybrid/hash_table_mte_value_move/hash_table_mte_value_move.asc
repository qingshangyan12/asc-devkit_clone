/* !
 * \file hash_table_mte_value_move.asc
 * \brief HashTable insert_or_assign benchmark.
 *        SCENARIO_NUM=0: SIMT group probes the table and stores value elements directly.
 *        SCENARIO_NUM=1: SIMT probes the table, then an MTE queue writes value vectors.
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <utility>
#include <vector>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

namespace {
constexpr uint32_t THREAD_COUNT = 512;
constexpr uint32_t GROUP_SIZE = 16;
constexpr uint32_t KEY_NUM = 128 * 1024;
constexpr uint32_t HASH_TABLE_CAPACITY = 256 * 1024;
constexpr uint32_t BLOCK_DIM = 64;
constexpr uint32_t PROFILE_REPEAT_TIMES = 30;
constexpr uint32_t VERIFY_SAMPLE_COUNT = 128;
constexpr uint32_t MTE_QUEUE_UB_BYTES = 160 * 1024;
constexpr uint32_t MTE_BATCH_SIZE = 32;
constexpr uint32_t DOUBLE_BUFFER = 2;
constexpr uint32_t INVALID_BUCKET = 0xffffffffU;
constexpr int64_t EMPTY_KEY = 0;
constexpr int64_t LOCKED_KEY = -1;
constexpr uint32_t TEST_DIMS[] = {16, 32, 64, 128, 256};
} // namespace

#define CHECK_ACL(expr)                                                                                               \
    do {                                                                                                             \
        aclError ret = (expr);                                                                                       \
        if (ret != ACL_SUCCESS) {                                                                                    \
            std::cerr << "ACL call failed: " #expr << ", ret=" << static_cast<int32_t>(ret) << std::endl;           \
            std::exit(1);                                                                                            \
        }                                                                                                            \
    } while (0)

inline uint64_t hash_key_host(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

__simt_callee__ inline uint64_t hash_key_device(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

template <typename T>
class device_vector {
public:
    using value_type = T;
    using size_type = size_t;

    explicit device_vector(size_type count) : count_(count)
    {
        if (count_ == 0) {
            return;
        }
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&data_), bytes(), ACL_MEM_MALLOC_HUGE_FIRST));
    }

    ~device_vector()
    {
        if (data_ != nullptr) {
            aclError ret = aclrtFree(data_);
            if (ret != ACL_SUCCESS) {
                std::cerr << "ACL call failed: aclrtFree, ret=" << static_cast<int32_t>(ret) << std::endl;
            }
        }
    }

    device_vector(const device_vector&) = delete;
    device_vector& operator=(const device_vector&) = delete;

    T* data()
    {
        return data_;
    }

    const T* data() const
    {
        return data_;
    }

    size_type size() const
    {
        return count_;
    }

    size_type bytes() const
    {
        return count_ * sizeof(T);
    }

    void copy_to(std::vector<T>& host) const
    {
        CHECK_ACL(aclrtMemcpy(host.data(), bytes(), data_, bytes(), ACL_MEMCPY_DEVICE_TO_HOST));
    }

    void fill_zero()
    {
        CHECK_ACL(aclrtMemset(data_, bytes(), 0, bytes()));
    }

private:
    T* data_ = nullptr;
    size_type count_ = 0;
};

class unordered_map {
public:
    using key_type = int64_t;
    using mapped_type = float;
    using value_type = std::pair<key_type, mapped_type*>;
    using size_type = uint32_t;
    using insert_return_type = std::pair<size_type, bool>;

    struct alignas(32) bucket_type {
        key_type key;
        key_type padding[3];
    };

    unordered_map(size_type bucketCount, size_type mappedDim, aclrtStream stream);
    ~unordered_map() = default;

    unordered_map(const unordered_map&) = delete;
    unordered_map& operator=(const unordered_map&) = delete;

    void clear();
    insert_return_type insert_or_assign(
        const key_type* firstKey, const key_type* lastKey, const mapped_type* firstMapped);
    void copy_to(std::vector<bucket_type>& buckets, std::vector<mapped_type>& values) const;

    size_type size() const
    {
        return size_;
    }

    size_type bucket_count() const
    {
        return bucketCount_;
    }

    size_type mapped_dim() const
    {
        return mappedDim_;
    }

    double load_factor() const
    {
        return static_cast<double>(size_) / bucketCount_;
    }

private:
    size_type bucketCount_ = 0;
    size_type mappedDim_ = 0;
    size_type size_ = 0;
    aclrtStream stream_ = nullptr;
    device_vector<bucket_type> buckets_;
    device_vector<mapped_type> values_;
    device_vector<size_type> bucketIndices_;
};

using Bucket = unordered_map::bucket_type;

__simt_vf__ inline void insert_or_assign_group_store_vf(__gm__ Bucket* table, __gm__ float* tableValues,
    __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum, uint32_t capacity, uint32_t dim,
    uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t tid = static_cast<uint32_t>(threadIdx.x);
    const uint32_t laneId = tid % GROUP_SIZE;
    const uint32_t groupIdInBlock = tid / GROUP_SIZE;
    const uint32_t groupsPerBlock = static_cast<uint32_t>(blockDim.x) / GROUP_SIZE;
    const uint32_t globalGroupId = blockIndex * groupsPerBlock + groupIdInBlock;
    const uint32_t totalGroups = blockNum * groupsPerBlock;

    for (uint32_t idx = globalGroupId; idx < keyNum; idx += totalGroups) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = 0;
        int32_t success = 0;

        if (laneId == 0) {
            bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
            for (uint32_t probe = 0; probe < capacity; ++probe) {
                __gm__ int64_t* keyAddr = &table[bucketIdx].key;
                int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
                if (oldKey == EMPTY_KEY) {
                    success = 1;
                    break;
                }
                if (oldKey == key) {
                    oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                    if (oldKey == key) {
                        success = 1;
                        break;
                    }
                    continue;
                }
                if (oldKey == LOCKED_KEY) {
                    continue;
                }
                bucketIdx = (bucketIdx + 1) & (capacity - 1);
            }
        }

        success = asc_shfl(success, 0, GROUP_SIZE);
        bucketIdx = asc_shfl(bucketIdx, 0, GROUP_SIZE);
        if (success == 1) {
            uint32_t dstBase = bucketIdx * dim;
            uint32_t srcBase = idx * dim;
            for (uint32_t j = laneId; j < dim; j += GROUP_SIZE) {
                tableValues[dstBase + j] = values[srcBase + j];
            }
            asc_threadfence();
            if (laneId == 0) {
                (void)asc_atomic_exch(&table[bucketIdx].key, key);
            }
        }
    }
}

__global__ __vector__ void insert_or_assign_group_store_kernel(__gm__ Bucket* table, __gm__ float* tableValues,
    __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum, uint32_t capacity, uint32_t dim)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if ASCEND_IS_AIV {
        AscendC::Simt::VF_CALL<insert_or_assign_group_store_vf>(AscendC::Simt::Dim3(THREAD_COUNT, 1, 1), table,
            tableValues, keys, values, keyNum, capacity, dim, AscendC::GetBlockIdx(), AscendC::GetBlockNum());
    }
}

__simt_vf__ inline void insert_or_assign_probe_vf(__gm__ Bucket* table, __gm__ const int64_t* keys,
    __gm__ uint32_t* bucketIndices, uint32_t keyNum, uint32_t capacity, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t threadAll = static_cast<uint32_t>(blockDim.x) * blockNum;
    for (uint32_t idx = blockIndex * static_cast<uint32_t>(blockDim.x) + static_cast<uint32_t>(threadIdx.x);
         idx < keyNum; idx += threadAll) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t result = INVALID_BUCKET;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            __gm__ int64_t* keyAddr = &table[bucketIdx].key;
            int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, key);
            if (oldKey == EMPTY_KEY || oldKey == key) {
                result = bucketIdx;
                break;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        bucketIndices[idx] = result;
    }
}

__global__ __vector__ void insert_or_assign_probe_kernel(
    __gm__ Bucket* table, __gm__ const int64_t* keys, __gm__ uint32_t* bucketIndices, uint32_t keyNum, uint32_t capacity)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if ASCEND_IS_AIV {
        AscendC::Simt::VF_CALL<insert_or_assign_probe_vf>(AscendC::Simt::Dim3(THREAD_COUNT, 1, 1), table, keys,
            bucketIndices, keyNum, capacity, AscendC::GetBlockIdx(), AscendC::GetBlockNum());
    }
}

template <typename T, uint32_t BatchSize>
class KernelMteWriteValues {
public:
    __aicore__ inline void Init(
        __gm__ T* tableValues, __gm__ const T* values, __gm__ const uint32_t* bucketIndices, uint32_t dim)
    {
        dim_ = dim;
        tableValuesGm.SetGlobalBuffer(tableValues, HASH_TABLE_CAPACITY * dim);
        valuesGm.SetGlobalBuffer(const_cast<__gm__ T*>(values), KEY_NUM * dim);
        bucketIndicesGm.SetGlobalBuffer(const_cast<__gm__ uint32_t*>(bucketIndices), KEY_NUM);
        pipe.InitBuffer(moveQueue, DOUBLE_BUFFER, BatchSize * dim * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = AscendC::GetBlockIdx();
        const uint32_t coreNum = AscendC::GetBlockNum();
        const uint32_t rowsPerCore = (KEY_NUM + coreNum - 1) / coreNum;
        const uint32_t coreStart = coreIdx * rowsPerCore;
        const uint32_t coreEnd = (coreStart + rowsPerCore < KEY_NUM) ? (coreStart + rowsPerCore) : KEY_NUM;

        AscendC::DataCopyPadExtParams<T> padParams{true, 0, 0, 0};
        for (uint32_t baseRow = coreStart; baseRow < coreEnd; baseRow += BatchSize) {
            uint32_t remain = coreEnd - baseRow;
            uint32_t batchCount = (BatchSize < remain) ? BatchSize : remain;
            AscendC::DataCopyExtParams copyInParams{1, static_cast<uint32_t>(batchCount * dim_ * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyExtParams copyOutParams{1, static_cast<uint32_t>(dim_ * sizeof(T)), 0, 0, 0};

            AscendC::LocalTensor<T> moveLocal;
            moveQueue.AllocTensor<T>(moveLocal);
            AscendC::DataCopyPad(moveLocal, valuesGm[baseRow * dim_], copyInParams, padParams);
            moveQueue.EnQue<T>(moveLocal);

            moveQueue.DeQue<T>(moveLocal);
            for (uint32_t i = 0; i < batchCount; ++i) {
                uint32_t bucketIdx = bucketIndicesGm.GetValue(baseRow + i);
                if (bucketIdx == INVALID_BUCKET) {
                    continue;
                }
                AscendC::DataCopyPad(tableValuesGm[bucketIdx * dim_], moveLocal[i * dim_], copyOutParams);
            }
            moveQueue.FreeTensor(moveLocal);
        }
    }

private:
    uint32_t dim_ = 0;
    AscendC::TPipe pipe;
    AscendC::TQueBind<AscendC::TPosition::VECIN, AscendC::TPosition::VECOUT, 0> moveQueue;
    AscendC::GlobalTensor<T> tableValuesGm;
    AscendC::GlobalTensor<T> valuesGm;
    AscendC::GlobalTensor<uint32_t> bucketIndicesGm;
};

__global__ __vector__ void write_values_mte_queue_kernel(
    __gm__ float* tableValues, __gm__ const float* values, __gm__ const uint32_t* bucketIndices, uint32_t dim)
{
    KernelMteWriteValues<float, MTE_BATCH_SIZE> kernel;
    kernel.Init(tableValues, values, bucketIndices, dim);
    kernel.Process();
}

void InitHostData(std::vector<int64_t>& keys, std::vector<float>& values, uint32_t dim)
{
    for (uint32_t i = 0; i < KEY_NUM; ++i) {
        uint64_t rawKey = (static_cast<uint64_t>(i) * 11400714819323198485ULL) & (HASH_TABLE_CAPACITY - 1);
        keys[i] = static_cast<int64_t>(rawKey + 1);
        for (uint32_t j = 0; j < dim; ++j) {
            values[i * dim + j] = static_cast<float>(((i * 17 + j) & 0x3ff) * 0.25f);
        }
    }
}

bool FindValueInTable(
    const std::vector<Bucket>& table, const std::vector<float>& tableValues, int64_t key, const float* expected,
    uint32_t dim)
{
    uint32_t bucketIdx = static_cast<uint32_t>(hash_key_host(key)) & (HASH_TABLE_CAPACITY - 1);
    for (uint32_t probe = 0; probe < HASH_TABLE_CAPACITY; ++probe) {
        const Bucket& bucket = table[bucketIdx];
        if (bucket.key == key) {
            uint32_t valueBase = bucketIdx * dim;
            for (uint32_t j = 0; j < dim; ++j) {
                if (std::fabs(tableValues[valueBase + j] - expected[j]) > 1e-6f) {
                    std::cerr << "Mismatch key=" << key << ", elem=" << j << ", expected=" << expected[j]
                              << ", actual=" << tableValues[valueBase + j] << std::endl;
                    return false;
                }
            }
            return true;
        }
        if (bucket.key == EMPTY_KEY) {
            return false;
        }
        bucketIdx = (bucketIdx + 1) & (HASH_TABLE_CAPACITY - 1);
    }
    return false;
}

bool VerifyResult(const std::vector<int64_t>& keys, const std::vector<float>& values, const std::vector<Bucket>& table,
    const std::vector<float>& tableValues, uint32_t dim)
{
    for (uint32_t sample = 0; sample < VERIFY_SAMPLE_COUNT; ++sample) {
        uint32_t row = (sample * 7919U) & (KEY_NUM - 1);
        if (!FindValueInTable(table, tableValues, keys[row], values.data() + row * dim, dim)) {
            std::cerr << "Cannot find expected key/value, key=" << keys[row] << std::endl;
            return false;
        }
    }
    return true;
}

void LaunchInsertOrAssign(
    Bucket* buckets, float* mappedValues, const int64_t* keys, const float* values, uint32_t* bucketIndices,
    uint32_t dim, aclrtStream stream)
{
    if constexpr (scenarioNum == 0) {
        insert_or_assign_group_store_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, mappedValues, keys, values, KEY_NUM, HASH_TABLE_CAPACITY, dim);
    } else {
        insert_or_assign_probe_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, keys, bucketIndices, KEY_NUM, HASH_TABLE_CAPACITY);
        write_values_mte_queue_kernel<<<BLOCK_DIM, MTE_QUEUE_UB_BYTES, stream>>>(
            mappedValues, values, bucketIndices, dim);
    }
}

unordered_map::unordered_map(size_type bucketCount, size_type mappedDim, aclrtStream stream)
    : bucketCount_(bucketCount),
      mappedDim_(mappedDim),
      stream_(stream),
      buckets_(bucketCount),
      values_(static_cast<size_t>(bucketCount) * mappedDim),
      bucketIndices_(KEY_NUM)
{
    clear();
}

void unordered_map::clear()
{
    buckets_.fill_zero();
    values_.fill_zero();
    size_ = 0;
}

unordered_map::insert_return_type unordered_map::insert_or_assign(
    const key_type* firstKey, const key_type* lastKey, const mapped_type* firstMapped)
{
    size_type count = static_cast<size_type>(lastKey - firstKey);
    if (count != KEY_NUM) {
        std::cerr << "Unsupported insert count: " << count << ", expected " << KEY_NUM << std::endl;
        return insert_return_type{0, false};
    }

    device_vector<key_type> keys(count);
    device_vector<mapped_type> mappedValues(static_cast<size_t>(count) * mappedDim_);

    CHECK_ACL(aclrtMemcpy(keys.data(), keys.bytes(), firstKey, keys.bytes(), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        mappedValues.data(), mappedValues.bytes(), firstMapped, mappedValues.bytes(), ACL_MEMCPY_HOST_TO_DEVICE));

    for (uint32_t i = 0; i < PROFILE_REPEAT_TIMES; ++i) {
        LaunchInsertOrAssign(
            buckets_.data(), values_.data(), keys.data(), mappedValues.data(), bucketIndices_.data(), mappedDim_,
            stream_);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream_));

    size_ = count;
    return insert_return_type{count, true};
}

void unordered_map::copy_to(std::vector<bucket_type>& buckets, std::vector<mapped_type>& values) const
{
    buckets.resize(bucketCount_);
    values.resize(static_cast<size_t>(bucketCount_) * mappedDim_);
    buckets_.copy_to(buckets);
    values_.copy_to(values);
}

bool RunOneDim(uint32_t dim, aclrtStream stream)
{
    std::vector<int64_t> keys(KEY_NUM);
    std::vector<float> values(static_cast<size_t>(KEY_NUM) * dim);
    InitHostData(keys, values, dim);

    unordered_map table(HASH_TABLE_CAPACITY, dim, stream);
    (void)table.insert_or_assign(keys.data(), keys.data() + keys.size(), values.data());

    std::vector<Bucket> buckets;
    std::vector<float> tableValues;
    table.copy_to(buckets, tableValues);
    bool ok = VerifyResult(keys, values, buckets, tableValues, dim);

    return ok;
}

void PrintHeader()
{
    const char* scenarioName = (scenarioNum == 0) ? "SIMT group insert_or_assign" : "MTE queue insert_or_assign";
    std::cout << "\n### HashTable insert_or_assign benchmark\n";
    std::cout << "* scenario = " << scenarioNum << " (" << scenarioName << ")\n";
    std::cout << "* capacity = " << HASH_TABLE_CAPACITY << ", key_num = " << KEY_NUM
              << ", load_factor = " << (static_cast<double>(KEY_NUM) / HASH_TABLE_CAPACITY) << "\n";
    std::cout << "* block_dim = " << BLOCK_DIM << ", thread_count = " << THREAD_COUNT
              << ", group_size = " << GROUP_SIZE << "\n";
    std::cout << "* profile_repeat = " << PROFILE_REPEAT_TIMES << "\n";
    std::cout << "* timing method = msprof op\n\n";
    std::cout << "| Scenario | Dim | Impl | Verify |\n";
    std::cout << "|---:|---:|:---|:---|\n";
}

void PrintResult(uint32_t dim, bool verifyOk)
{
    const char* scenarioName = (scenarioNum == 0) ? "SIMT group insert_or_assign" : "MTE queue insert_or_assign";
    std::cout << "| " << scenarioNum << " | " << dim << " | " << scenarioName << " | "
              << (verifyOk ? "PASS" : "FAIL") << " |\n";
}

bool IsSupportedDim(uint32_t dim)
{
    for (uint32_t supportedDim : TEST_DIMS) {
        if (dim == supportedDim) {
            return true;
        }
    }
    return false;
}

std::vector<uint32_t> GetDimsToRun(int32_t argc, char** argv)
{
    std::vector<uint32_t> dims;
    if (argc == 1) {
        for (uint32_t dim : TEST_DIMS) {
            dims.push_back(dim);
        }
        return dims;
    }
    if (argc != 2) {
        std::cerr << "Usage: " << argv[0] << " [dim]" << std::endl;
        return dims;
    }

    char* end = nullptr;
    unsigned long parsed = std::strtoul(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' || parsed == 0 || parsed > UINT32_MAX) {
        std::cerr << "Invalid dim: " << argv[1] << std::endl;
        return dims;
    }

    uint32_t dim = static_cast<uint32_t>(parsed);
    if (!IsSupportedDim(dim)) {
        std::cerr << "Unsupported dim: " << dim << ". Supported dims: ";
        for (uint32_t supportedDim : TEST_DIMS) {
            std::cerr << supportedDim << " ";
        }
        std::cerr << std::endl;
        return dims;
    }
    dims.push_back(dim);
    return dims;
}

int32_t main(int32_t argc, char** argv)
{
    std::vector<uint32_t> dims = GetDimsToRun(argc, argv);
    if (dims.empty()) {
        return 1;
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    PrintHeader();
    bool allOk = true;
    for (uint32_t dim : dims) {
        bool ok = RunOneDim(dim, stream);
        PrintResult(dim, ok);
        allOk = allOk && ok;
    }
    std::cout << (allOk ? "Verification PASSED" : "Verification FAILED") << std::endl;

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());

    return allOk ? 0 : 1;
}
