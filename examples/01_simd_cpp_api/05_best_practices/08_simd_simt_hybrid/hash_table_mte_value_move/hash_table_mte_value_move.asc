/* !
 * \file hash_table_mte_value_move.asc
 * \brief HashTable insert_or_assign benchmark.
 *        SCENARIO_NUM=0: SIMT group probes the table and stores value elements directly.
 *        SCENARIO_NUM=1: SIMT probes the table, then an MTE queue writes value vectors.
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <vector>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

namespace {
constexpr uint32_t THREAD_COUNT = 512;
constexpr uint32_t GROUP_SIZE = 16;
constexpr uint32_t VALUE_DIM = 128;
constexpr uint32_t KEY_NUM = 128 * 1024;
constexpr uint32_t HASH_TABLE_CAPACITY = 256 * 1024;
constexpr uint32_t BLOCK_DIM = 64;
constexpr uint32_t WARMUP_TIMES = 5;
constexpr uint32_t REPEAT_TIMES = 30;
constexpr uint32_t VERIFY_SAMPLE_COUNT = 128;
constexpr uint32_t UB_ALIGN_SIZE = 32;
constexpr uint32_t MTE_QUEUE_UB_BYTES = 160 * 1024;
constexpr uint32_t MTE_BATCH_SIZE = 32;
constexpr uint32_t DOUBLE_BUFFER = 2;
constexpr uint32_t INVALID_BUCKET = 0xffffffffU;
constexpr int64_t EMPTY_KEY = 0;
constexpr int64_t LOCKED_KEY = -1;
} // namespace

#define CHECK_ACL(expr)                                                                                               \
    do {                                                                                                             \
        aclError ret = (expr);                                                                                       \
        if (ret != ACL_SUCCESS) {                                                                                    \
            std::cerr << "ACL call failed: " #expr << ", ret=" << static_cast<int32_t>(ret) << std::endl;           \
            std::exit(1);                                                                                            \
        }                                                                                                            \
    } while (0)

struct alignas(32) Bucket {
    int64_t key;
    int64_t padding[3];
    float value[VALUE_DIM];
};

inline uint64_t hash_key_host(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

__simt_callee__ inline uint64_t hash_key_device(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

__simt_vf__ inline void insert_or_assign_group_store_vf(
    __gm__ Bucket* table, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum, uint32_t capacity,
    uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t tid = static_cast<uint32_t>(threadIdx.x);
    const uint32_t laneId = tid % GROUP_SIZE;
    const uint32_t groupIdInBlock = tid / GROUP_SIZE;
    const uint32_t groupsPerBlock = static_cast<uint32_t>(blockDim.x) / GROUP_SIZE;
    const uint32_t globalGroupId = blockIndex * groupsPerBlock + groupIdInBlock;
    const uint32_t totalGroups = blockNum * groupsPerBlock;

    for (uint32_t idx = globalGroupId; idx < keyNum; idx += totalGroups) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = 0;
        int32_t success = 0;

        if (laneId == 0) {
            bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
            for (uint32_t probe = 0; probe < capacity; ++probe) {
                __gm__ int64_t* keyAddr = &table[bucketIdx].key;
                int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
                if (oldKey == EMPTY_KEY) {
                    success = 1;
                    break;
                }
                if (oldKey == key) {
                    oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                    if (oldKey == key) {
                        success = 1;
                        break;
                    }
                    continue;
                }
                if (oldKey == LOCKED_KEY) {
                    continue;
                }
                bucketIdx = (bucketIdx + 1) & (capacity - 1);
            }
        }

        success = asc_shfl(success, 0, GROUP_SIZE);
        bucketIdx = asc_shfl(bucketIdx, 0, GROUP_SIZE);
        if (success == 1) {
            __gm__ Bucket* bucket = &table[bucketIdx];
            for (uint32_t j = laneId; j < VALUE_DIM; j += GROUP_SIZE) {
                bucket->value[j] = values[idx * VALUE_DIM + j];
            }
            asc_threadfence();
            if (laneId == 0) {
                (void)asc_atomic_exch(&bucket->key, key);
            }
        }
    }
}

__global__ __vector__ void insert_or_assign_group_store_kernel(
    __gm__ Bucket* table, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum, uint32_t capacity)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if ASCEND_IS_AIV {
        AscendC::Simt::VF_CALL<insert_or_assign_group_store_vf>(
            AscendC::Simt::Dim3(THREAD_COUNT, 1, 1), table, keys, values, keyNum, capacity, AscendC::GetBlockIdx(),
            AscendC::GetBlockNum());
    }
}

__simt_vf__ inline void insert_or_assign_probe_vf(__gm__ Bucket* table, __gm__ const int64_t* keys,
    __gm__ uint32_t* bucketIndices, uint32_t keyNum, uint32_t capacity, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t threadAll = static_cast<uint32_t>(blockDim.x) * blockNum;
    for (uint32_t idx = blockIndex * static_cast<uint32_t>(blockDim.x) + static_cast<uint32_t>(threadIdx.x);
         idx < keyNum; idx += threadAll) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t result = INVALID_BUCKET;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            __gm__ int64_t* keyAddr = &table[bucketIdx].key;
            int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, key);
            if (oldKey == EMPTY_KEY || oldKey == key) {
                result = bucketIdx;
                break;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        bucketIndices[idx] = result;
    }
}

__global__ __vector__ void insert_or_assign_probe_kernel(
    __gm__ Bucket* table, __gm__ const int64_t* keys, __gm__ uint32_t* bucketIndices, uint32_t keyNum, uint32_t capacity)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if ASCEND_IS_AIV {
        AscendC::Simt::VF_CALL<insert_or_assign_probe_vf>(
            AscendC::Simt::Dim3(THREAD_COUNT, 1, 1), table, keys, bucketIndices, keyNum, capacity,
            AscendC::GetBlockIdx(), AscendC::GetBlockNum());
    }
}

template <typename T, uint32_t BatchSize>
class KernelMteWriteValues {
public:
    __aicore__ inline void Init(__gm__ Bucket* table, __gm__ const T* values, __gm__ const uint32_t* bucketIndices)
    {
        tablePtr = table;
        valuesGm.SetGlobalBuffer(const_cast<__gm__ T*>(values), KEY_NUM * VALUE_DIM);
        bucketIndicesGm.SetGlobalBuffer(const_cast<__gm__ uint32_t*>(bucketIndices), KEY_NUM);
        pipe.InitBuffer(moveQueue, DOUBLE_BUFFER, BatchSize * VALUE_DIM * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t coreIdx = AscendC::GetBlockIdx();
        const uint32_t coreNum = AscendC::GetBlockNum();
        const uint32_t rowsPerCore = (KEY_NUM + coreNum - 1) / coreNum;
        const uint32_t coreStart = coreIdx * rowsPerCore;
        const uint32_t coreEnd = (coreStart + rowsPerCore < KEY_NUM) ? (coreStart + rowsPerCore) : KEY_NUM;

        AscendC::GlobalTensor<T> dstValueGm;
        AscendC::DataCopyPadExtParams<T> padParams{true, 0, 0, 0};
        for (uint32_t baseRow = coreStart; baseRow < coreEnd; baseRow += BatchSize) {
            uint32_t remain = coreEnd - baseRow;
            uint32_t batchCount = (BatchSize < remain) ? BatchSize : remain;
            AscendC::DataCopyExtParams copyInParams{
                1, static_cast<uint32_t>(batchCount * VALUE_DIM * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyExtParams copyOutParams{1, static_cast<uint32_t>(VALUE_DIM * sizeof(T)), 0, 0, 0};

            AscendC::LocalTensor<T> moveLocal;
            moveQueue.AllocTensor<T>(moveLocal);
            AscendC::DataCopyPad(moveLocal, valuesGm[baseRow * VALUE_DIM], copyInParams, padParams);
            moveQueue.EnQue<T>(moveLocal);

            moveQueue.DeQue<T>(moveLocal);
            for (uint32_t i = 0; i < batchCount; ++i) {
                uint32_t bucketIdx = bucketIndicesGm.GetValue(baseRow + i);
                if (bucketIdx == INVALID_BUCKET) {
                    continue;
                }
                dstValueGm.SetGlobalBuffer(tablePtr[bucketIdx].value);
                AscendC::DataCopyPad(dstValueGm, moveLocal[i * VALUE_DIM], copyOutParams);
            }
            moveQueue.FreeTensor(moveLocal);
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQueBind<AscendC::TPosition::VECIN, AscendC::TPosition::VECOUT, 0> moveQueue;
    __gm__ Bucket* tablePtr = nullptr;
    AscendC::GlobalTensor<T> valuesGm;
    AscendC::GlobalTensor<uint32_t> bucketIndicesGm;
};

__global__ __vector__ void write_values_mte_queue_kernel(
    __gm__ Bucket* table, __gm__ const float* values, __gm__ const uint32_t* bucketIndices)
{
    KernelMteWriteValues<float, MTE_BATCH_SIZE> kernel;
    kernel.Init(table, values, bucketIndices);
    kernel.Process();
}

void InitHostData(std::vector<int64_t>& keys, std::vector<float>& values)
{
    for (uint32_t i = 0; i < KEY_NUM; ++i) {
        keys[i] = static_cast<int64_t>(i + 1);
        for (uint32_t j = 0; j < VALUE_DIM; ++j) {
            values[i * VALUE_DIM + j] = static_cast<float>(((i * 17 + j) & 0x3ff) * 0.25f);
        }
    }
}

bool FindValueInTable(const std::vector<Bucket>& table, int64_t key, const float* expected)
{
    uint32_t bucketIdx = static_cast<uint32_t>(hash_key_host(key)) & (HASH_TABLE_CAPACITY - 1);
    for (uint32_t probe = 0; probe < HASH_TABLE_CAPACITY; ++probe) {
        const Bucket& bucket = table[bucketIdx];
        if (bucket.key == key) {
            for (uint32_t j = 0; j < VALUE_DIM; ++j) {
                if (std::fabs(bucket.value[j] - expected[j]) > 1e-6f) {
                    std::cerr << "Mismatch key=" << key << ", elem=" << j << ", expected=" << expected[j]
                              << ", actual=" << bucket.value[j] << std::endl;
                    return false;
                }
            }
            return true;
        }
        if (bucket.key == EMPTY_KEY) {
            return false;
        }
        bucketIdx = (bucketIdx + 1) & (HASH_TABLE_CAPACITY - 1);
    }
    return false;
}

bool VerifyResult(const std::vector<int64_t>& keys, const std::vector<float>& values, const std::vector<Bucket>& table)
{
    for (uint32_t sample = 0; sample < VERIFY_SAMPLE_COUNT; ++sample) {
        uint32_t row = (sample * 7919U) & (KEY_NUM - 1);
        if (!FindValueInTable(table, keys[row], values.data() + row * VALUE_DIM)) {
            std::cerr << "Cannot find expected key/value, key=" << keys[row] << std::endl;
            return false;
        }
    }
    return true;
}

struct BenchmarkResult {
    double avgLatencyUs;
    double throughputMops;
    double effectiveValueBandwidthGBs;
};

BenchmarkResult MakeBenchmarkResult(double avgLatencyUs)
{
    const double valueBytes = static_cast<double>(KEY_NUM) * VALUE_DIM * sizeof(float);
    BenchmarkResult result{};
    result.avgLatencyUs = avgLatencyUs;
    result.throughputMops = static_cast<double>(KEY_NUM) / avgLatencyUs;
    result.effectiveValueBandwidthGBs = valueBytes / avgLatencyUs / 1000.0;
    return result;
}

void PrintBenchmarkResult(const BenchmarkResult& result, bool verifyOk)
{
    const char* scenarioName = (scenarioNum == 0) ? "SIMT group insert_or_assign" : "MTE queue insert_or_assign";
    std::cout << "\n### HashTable insert_or_assign benchmark\n";
    std::cout << "* capacity = " << HASH_TABLE_CAPACITY << ", key_num = " << KEY_NUM
              << ", load_factor = " << (static_cast<double>(KEY_NUM) / HASH_TABLE_CAPACITY) << "\n";
    std::cout << "* value_dim = " << VALUE_DIM << ", bytes_per_value = " << (VALUE_DIM * sizeof(float)) << "\n";
    std::cout << "* block_dim = " << BLOCK_DIM << ", thread_count = " << THREAD_COUNT
              << ", group_size = " << GROUP_SIZE << "\n";
    std::cout << "* warmup = " << WARMUP_TIMES << ", repeat = " << REPEAT_TIMES << "\n\n";
    std::cout << "| Scenario | Impl | Avg Latency(us) | Throughput(Mops/s) | Effective Value BW(GB/s) | Verify |\n";
    std::cout << "|---:|:---|---:|---:|---:|:---|\n";
    std::cout << "| " << scenarioNum << " | " << scenarioName << " | " << std::fixed << std::setprecision(3)
              << result.avgLatencyUs << " | " << result.throughputMops << " | "
              << result.effectiveValueBandwidthGBs << " | " << (verifyOk ? "PASS" : "FAIL") << " |\n";
    std::cout << (verifyOk ? "Verification PASSED" : "Verification FAILED") << std::endl;
}

void LaunchKernel(Bucket* tableDevice, int64_t* keysDevice, float* valuesDevice, uint32_t* bucketIndicesDevice,
    aclrtStream stream)
{
    if constexpr (scenarioNum == 0) {
        insert_or_assign_group_store_kernel<<<BLOCK_DIM, 0, stream>>>(
            tableDevice, keysDevice, valuesDevice, KEY_NUM, HASH_TABLE_CAPACITY);
    } else {
        insert_or_assign_probe_kernel<<<BLOCK_DIM, 0, stream>>>(
            tableDevice, keysDevice, bucketIndicesDevice, KEY_NUM, HASH_TABLE_CAPACITY);
        write_values_mte_queue_kernel<<<BLOCK_DIM, MTE_QUEUE_UB_BYTES, stream>>>(
            tableDevice, valuesDevice, bucketIndicesDevice);
    }
}

int32_t main()
{
    const size_t keysBytes = static_cast<size_t>(KEY_NUM) * sizeof(int64_t);
    const size_t valuesBytes = static_cast<size_t>(KEY_NUM) * VALUE_DIM * sizeof(float);
    const size_t tableBytes = static_cast<size_t>(HASH_TABLE_CAPACITY) * sizeof(Bucket);
    const size_t bucketIndicesBytes = static_cast<size_t>(KEY_NUM) * sizeof(uint32_t);

    std::vector<int64_t> keys(KEY_NUM);
    std::vector<float> values(static_cast<size_t>(KEY_NUM) * VALUE_DIM);
    std::vector<Bucket> table(HASH_TABLE_CAPACITY);
    InitHostData(keys, values);
    std::memset(table.data(), 0, tableBytes);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    int64_t* keysDevice = nullptr;
    float* valuesDevice = nullptr;
    Bucket* tableDevice = nullptr;
    uint32_t* bucketIndicesDevice = nullptr;
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&keysDevice), keysBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&valuesDevice), valuesBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&tableDevice), tableBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&bucketIndicesDevice), bucketIndicesBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(keysDevice, keysBytes, keys.data(), keysBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(valuesDevice, valuesBytes, values.data(), valuesBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(tableDevice, tableBytes, 0, tableBytes));

    LaunchKernel(tableDevice, keysDevice, valuesDevice, bucketIndicesDevice, stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    for (uint32_t i = 0; i < WARMUP_TIMES; ++i) {
        LaunchKernel(tableDevice, keysDevice, valuesDevice, bucketIndicesDevice, stream);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));

    auto start = std::chrono::steady_clock::now();
    for (uint32_t i = 0; i < REPEAT_TIMES; ++i) {
        LaunchKernel(tableDevice, keysDevice, valuesDevice, bucketIndicesDevice, stream);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));
    auto end = std::chrono::steady_clock::now();
    double elapsedUs = std::chrono::duration<double, std::micro>(end - start).count();
    double avgUs = elapsedUs / static_cast<double>(REPEAT_TIMES);

    CHECK_ACL(aclrtMemcpy(table.data(), tableBytes, tableDevice, tableBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    bool ok = VerifyResult(keys, values, table);

    PrintBenchmarkResult(MakeBenchmarkResult(avgUs), ok);

    CHECK_ACL(aclrtFree(keysDevice));
    CHECK_ACL(aclrtFree(valuesDevice));
    CHECK_ACL(aclrtFree(tableDevice));
    CHECK_ACL(aclrtFree(bucketIndicesDevice));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());

    return ok ? 0 : 1;
}
