#include <cstdint>

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t TOTAL_LENGTH = 2048;

__simd_vf__ inline void SwiGLUVf(
    __ubuf__ hifloat8_t* gAddr, __ubuf__ hifloat8_t* uAddr, __ubuf__ hifloat8_t* zAddr, uint32_t count)
{
    constexpr uint32_t ONE_REPEAT_SIZE = AscendC::GetVecLen() / sizeof(float);
    static constexpr AscendC::Reg::CastTrait HIF8_TO_FLOAT_TRAIT = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait FLOAT_TO_HIF8_TRAIT = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::SAT,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_ROUND};

    AscendC::Reg::RegTensor<hifloat8_t> gHif8Reg;
    AscendC::Reg::RegTensor<hifloat8_t> uHif8Reg;
    AscendC::Reg::RegTensor<hifloat8_t> zHif8Reg;
    AscendC::Reg::RegTensor<float> gReg;
    AscendC::Reg::RegTensor<float> uReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::MaskReg mask;
    uint32_t remaining = count;
    const uint16_t repeatTimes = static_cast<uint16_t>(AscendC::Std::ceil_div(count, ONE_REPEAT_SIZE));

    for (uint16_t i = 0; i < repeatTimes; ++i) {
        mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<hifloat8_t, AscendC::Reg::LoadDist::DIST_UNPACK4_B8>(
            gHif8Reg, gAddr + i * ONE_REPEAT_SIZE);
        AscendC::Reg::LoadAlign<hifloat8_t, AscendC::Reg::LoadDist::DIST_UNPACK4_B8>(
            uHif8Reg, uAddr + i * ONE_REPEAT_SIZE);
        AscendC::Reg::Cast<float, hifloat8_t, HIF8_TO_FLOAT_TRAIT>(gReg, gHif8Reg, mask);
        AscendC::Reg::Cast<float, hifloat8_t, HIF8_TO_FLOAT_TRAIT>(uReg, uHif8Reg, mask);

        AscendC::Reg::Muls(tmpReg, gReg, -1.0f, mask);
        AscendC::Reg::Exp(tmpReg, tmpReg, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, 1.0f, mask);
        AscendC::Reg::Div(tmpReg, gReg, tmpReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, uReg, mask);

        AscendC::Reg::Cast<hifloat8_t, float, FLOAT_TO_HIF8_TRAIT>(zHif8Reg, tmpReg, mask);
        AscendC::Reg::StoreAlign<hifloat8_t, AscendC::Reg::StoreDist::DIST_PACK4_B32>(
            zAddr + i * ONE_REPEAT_SIZE, zHif8Reg, mask);
    }
}

class KernelHif8SwiGLU {
public:
    __aicore__ inline KernelHif8SwiGLU() = default;

    __aicore__ inline void Init(__gm__ uint8_t* g, __gm__ uint8_t* u, __gm__ uint8_t* z)
    {
        gGm.SetGlobalBuffer(reinterpret_cast<__gm__ hifloat8_t*>(g), TOTAL_LENGTH);
        uGm.SetGlobalBuffer(reinterpret_cast<__gm__ hifloat8_t*>(u), TOTAL_LENGTH);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ hifloat8_t*>(z), TOTAL_LENGTH);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<hifloat8_t> gLocal(AscendC::TPosition::VECCALC, gAddr, TOTAL_LENGTH);
        AscendC::LocalTensor<hifloat8_t> uLocal(AscendC::TPosition::VECCALC, uAddr, TOTAL_LENGTH);
        AscendC::LocalTensor<hifloat8_t> zLocal(AscendC::TPosition::VECCALC, zAddr, TOTAL_LENGTH);

        AscendC::DataCopy(gLocal, gGm, TOTAL_LENGTH);
        AscendC::DataCopy(uLocal, uGm, TOTAL_LENGTH);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // DQ-Compute-Q: hifloat8_t -> float -> SwiGLU -> hifloat8_t.
        asc_vf_call<SwiGLUVf>(
            reinterpret_cast<__ubuf__ hifloat8_t*>(gLocal.GetPhyAddr()),
            reinterpret_cast<__ubuf__ hifloat8_t*>(uLocal.GetPhyAddr()),
            reinterpret_cast<__ubuf__ hifloat8_t*>(zLocal.GetPhyAddr()), TOTAL_LENGTH);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(zGm, zLocal, TOTAL_LENGTH);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    static constexpr uint32_t gAddr = 0;
    static constexpr uint32_t uAddr = gAddr + TOTAL_LENGTH * sizeof(hifloat8_t);
    static constexpr uint32_t zAddr = uAddr + TOTAL_LENGTH * sizeof(hifloat8_t);

    AscendC::GlobalTensor<hifloat8_t> gGm;
    AscendC::GlobalTensor<hifloat8_t> uGm;
    AscendC::GlobalTensor<hifloat8_t> zGm;
};

extern "C" __global__ __vector__ void hif8_swiglu_custom(
    __gm__ uint8_t* g, __gm__ uint8_t* u, __gm__ uint8_t* z)
{
    KernelHif8SwiGLU op;
    op.Init(g, u, z);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    constexpr size_t byteSize = TOTAL_LENGTH * sizeof(uint8_t);

    if (aclInit(nullptr) != ACL_SUCCESS) {
        return 1;
    }
    const int32_t deviceId = 0;
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        aclFinalize();
        return 1;
    }

    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 1;
    }

    uint8_t* gHost = nullptr;
    uint8_t* uHost = nullptr;
    uint8_t* zHost = nullptr;
    uint8_t* gDevice = nullptr;
    uint8_t* uDevice = nullptr;
    uint8_t* zDevice = nullptr;
    bool success = true;
    success = success && aclrtMallocHost(reinterpret_cast<void**>(&gHost), byteSize) == ACL_SUCCESS;
    success = success && aclrtMallocHost(reinterpret_cast<void**>(&uHost), byteSize) == ACL_SUCCESS;
    success = success && aclrtMallocHost(reinterpret_cast<void**>(&zHost), byteSize) == ACL_SUCCESS;
    success = success && aclrtMalloc(reinterpret_cast<void**>(&gDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    success = success && aclrtMalloc(reinterpret_cast<void**>(&uDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    success = success && aclrtMalloc(reinterpret_cast<void**>(&zDevice), byteSize, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;

    size_t fileSize = 0;
    success = success && ReadFile("./input/g.bin", fileSize, gHost, byteSize) && fileSize == byteSize;
    success = success && ReadFile("./input/u.bin", fileSize, uHost, byteSize) && fileSize == byteSize;
    success = success && aclrtMemcpy(gDevice, byteSize, gHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    success = success && aclrtMemcpy(uDevice, byteSize, uHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    if (success) {
        hif8_swiglu_custom<<<1, 0, stream>>>(gDevice, uDevice, zDevice);
        success = aclrtSynchronizeStream(stream) == ACL_SUCCESS;
    }
    success = success && aclrtMemcpy(zHost, byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    success = success && WriteFile("./output/output.bin", zHost, byteSize);

    if (gDevice != nullptr) aclrtFree(gDevice);
    if (uDevice != nullptr) aclrtFree(uDevice);
    if (zDevice != nullptr) aclrtFree(zDevice);
    if (gHost != nullptr) aclrtFreeHost(gHost);
    if (uHost != nullptr) aclrtFreeHost(uHost);
    if (zHost != nullptr) aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return success ? 0 : 1;
}
