/* !
 * \file l2_cache.asc
 * \brief L2 Cache mode best practices – kernel invocation and main
 */

#include "l2_cache.h"
#include "data_utils.h"
#include "acl/acl.h"
#include <vector>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;

// ---------------------------------------------------------------------------
// 架构相关常量
// NPU_ARCH_ID 在 CMakeLists.txt 中定义：dav-2201 对应 2201，dav-3510 对应 3510
// ---------------------------------------------------------------------------
#if NPU_ARCH_ID == 3510
    // Ascend 950PR / Ascend 950DT
    constexpr uint32_t AIV_CORE_NUM = 64;
    constexpr uint32_t ADD_DATA_COPY_LEN = 21840;
    constexpr uint32_t MAX_DATA_COPY_LEN = 21840;
#else
    // Atlas A2/A3 系列
    constexpr uint32_t AIV_CORE_NUM = 48;
    constexpr uint32_t ADD_DATA_COPY_LEN = 16384;
    constexpr uint32_t MAX_DATA_COPY_LEN = 16384;
#endif

// 矩阵维度：统一使用 [12288, 12288]
constexpr uint32_t M = 12288;
constexpr uint32_t N = 12288;
constexpr uint32_t SINGLE_CORE_M = M / AIV_CORE_NUM;
static_assert(M % AIV_CORE_NUM == 0, "M must be evenly divisible by AIV_CORE_NUM");

// DataCopyRepeat kernel 的 tile 尺寸
constexpr uint32_t REPEAT_TILE_M = 64;
constexpr uint32_t REPEAT_TILE_N = 1024;

// ====================================================================
// Kernel 封装函数
// ====================================================================

// 重复搬运模式：
//   Mode 0: N 方向切 4 份，每份重复 4 次，L2 默认开启（Case 1、Case 6/7 的第二阶段）
//   Mode 1: 同 Mode 0，但关闭 L2 Cache（Case 2）
//   Mode 2: 整块矩阵重复 4 次，L2 默认开启（Case 3）
enum RepeatKernelMode : uint8_t {
    REPEAT_SPLIT_L2_ON = 0,
    REPEAT_SPLIT_L2_OFF = 1,
    REPEAT_WHOLE_L2_ON = 2,
};

template <RepeatKernelMode kMode>
__global__ __vector__ void kernel_repeat(GM_ADDR src)
{
    AscendC::InitSocState();
    KernelDataCopyRepeat<M, N, AIV_CORE_NUM, SINGLE_CORE_M, REPEAT_TILE_M, REPEAT_TILE_N> op;
    op.Init(reinterpret_cast<__gm__ half*>(src));
    if constexpr (kMode == REPEAT_SPLIT_L2_ON) {
        op.ProcessSplitFourAndRepeat4Times();
    } else if constexpr (kMode == REPEAT_SPLIT_L2_OFF) {
        op.ProcessSplitFourAndRepeat4TimesL2Disable();
    } else {
        op.ProcessRepeatWhole4Times();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// Add 双缓冲模式：
//   l2Bypass=false: L2 Cache 默认开启（Case 4、Case 6）
//   l2Bypass=true:  L2 Cache bypass（Case 5、Case 7）
template <bool l2Bypass>
__global__ __vector__ void kernel_add(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();
    KernelAdd<M, N, AIV_CORE_NUM, 1, ADD_DATA_COPY_LEN, MAX_DATA_COPY_LEN> op;
    op.Init(reinterpret_cast<__gm__ uint8_t*>(x), reinterpret_cast<__gm__ uint8_t*>(y),
        reinterpret_cast<__gm__ uint8_t*>(z));
    if constexpr (l2Bypass) {
        op.ProcessDoubleBufferL2Bypass();
    } else {
        op.ProcessDoubleBuffer();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ====================================================================
// main 函数
// ====================================================================
int32_t main(int32_t argc, char* argv[])
{
    printf("========================================\n");
    printf("L2 Cache Best Practices - Case %u\n", (uint32_t)scenarioNum);
    printf("========================================\n");

    constexpr size_t FILE_SIZE = static_cast<size_t>(M) * N * sizeof(uint16_t);

    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    // -------------------------------------------------------------------
    // Case 1-3: 重复搬运场景（单个 kernel，仅需一个输入矩阵）
    // -------------------------------------------------------------------
    if constexpr (scenarioNum <= 3) {
        printf("[Case %u] DataCopy repeat scenario\n", (uint32_t)scenarioNum);

        uint8_t* inputHost;
        uint8_t* inputDevice;
        aclrtMallocHost(reinterpret_cast<void**>(&inputHost), FILE_SIZE);
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

        size_t fileSize = 0;
        ReadFile("./input/repeat_input.bin", fileSize, inputHost, FILE_SIZE);
        aclrtMemcpy(inputDevice, FILE_SIZE, inputHost, FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);

        if constexpr (scenarioNum == 1) {
            kernel_repeat<REPEAT_SPLIT_L2_ON><<<AIV_CORE_NUM, nullptr, stream>>>(inputDevice);
        } else if constexpr (scenarioNum == 2) {
            kernel_repeat<REPEAT_SPLIT_L2_OFF><<<AIV_CORE_NUM, nullptr, stream>>>(inputDevice);
        } else {
            kernel_repeat<REPEAT_WHOLE_L2_ON><<<AIV_CORE_NUM, nullptr, stream>>>(inputDevice);
        }
        aclrtSynchronizeStream(stream);

        aclrtFree(inputDevice);
        aclrtFreeHost(inputHost);
    }
    // -------------------------------------------------------------------
    // Case 4-5: Add 算子场景（单个 kernel，两个输入矩阵 + 一个输出矩阵）
    // -------------------------------------------------------------------
    else if constexpr (scenarioNum <= 5) {
        printf("[Case %u] Add scenario\n", (uint32_t)scenarioNum);

        // 两个配置相同大小的输入和输出
        static constexpr uint32_t kInputCount = 2;
        static constexpr uint32_t kOutputCount = 1;
        uint8_t* inputHost[kInputCount] = {nullptr, nullptr};
        uint8_t* inputDevice[kInputCount] = {nullptr, nullptr};
        uint8_t* outputHost[kOutputCount] = {nullptr};
        uint8_t* outputDevice[kOutputCount] = {nullptr};

        for (uint32_t i = 0; i < kInputCount; i++) {
            aclrtMallocHost(reinterpret_cast<void**>(&inputHost[i]), FILE_SIZE);
            aclrtMalloc(reinterpret_cast<void**>(&inputDevice[i]), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        }
        for (uint32_t i = 0; i < kOutputCount; i++) {
            aclrtMallocHost(reinterpret_cast<void**>(&outputHost[i]), FILE_SIZE);
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice[i]), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        }

        // 读取输入数据
        const char* inputFiles[] = {"./input/add_x.bin", "./input/add_y.bin"};
        for (uint32_t i = 0; i < kInputCount; i++) {
            size_t fileSize = 0;
            ReadFile(inputFiles[i], fileSize, inputHost[i], FILE_SIZE);
            aclrtMemcpy(inputDevice[i], FILE_SIZE, inputHost[i], FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);
        }

        // 启动 kernel
        if constexpr (scenarioNum == 4) {
            kernel_add<false><<<AIV_CORE_NUM, nullptr, stream>>>(inputDevice[0], inputDevice[1], outputDevice[0]);
        } else {
            kernel_add<true><<<AIV_CORE_NUM, nullptr, stream>>>(inputDevice[0], inputDevice[1], outputDevice[0]);
        }
        aclrtSynchronizeStream(stream);

        // 写出输出结果
        aclrtMemcpy(outputHost[0], FILE_SIZE, outputDevice[0], FILE_SIZE, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/add_output.bin", outputHost[0], FILE_SIZE);

        for (uint32_t i = 0; i < kInputCount; i++) {
            aclrtFree(inputDevice[i]);
            aclrtFreeHost(inputHost[i]);
        }
        for (uint32_t i = 0; i < kOutputCount; i++) {
            aclrtFree(outputDevice[i]);
            aclrtFreeHost(outputHost[i]);
        }
    }
    // -------------------------------------------------------------------
    // Case 6-7: 多算子流水线场景（串行）
    //   Case 6: Add(L2 开启, 流式数据污染 L2) → 然后 DataCopyRepeat(分片重复, L2 命中率受损)
    //   Case 7: Add(L2 bypass, 流式数据不占 L2) → 然后 DataCopyRepeat(分片重复, L2 命中率正常)
    //   两个 kernel 顺序执行，读取不同的输入矩阵：
    //     - Add 读取 add_x.bin、add_y.bin，输出 add_z.bin
    //     - Repeat 读取 repeat_input.bin（另一个矩阵）
    // -------------------------------------------------------------------
    else if constexpr (scenarioNum <= 7) {
        printf("[Case %u] Pipeline scenario (Add + DataCopyRepeat, serial)\n", (uint32_t)scenarioNum);
        printf("[Case %u] Step 1: Add kernel...\n", (uint32_t)scenarioNum);

        // Add 算子的输入和输出
        static constexpr uint32_t kAddInputCount = 2;
        uint8_t* addInputHost[kAddInputCount] = {nullptr, nullptr};
        uint8_t* addInputDevice[kAddInputCount] = {nullptr, nullptr};
        uint8_t* addOutputHost = nullptr;
        uint8_t* addOutputDevice = nullptr;

        for (uint32_t i = 0; i < kAddInputCount; i++) {
            aclrtMallocHost(reinterpret_cast<void**>(&addInputHost[i]), FILE_SIZE);
            aclrtMalloc(reinterpret_cast<void**>(&addInputDevice[i]), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        }
        aclrtMallocHost(reinterpret_cast<void**>(&addOutputHost), FILE_SIZE);
        aclrtMalloc(reinterpret_cast<void**>(&addOutputDevice), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

        const char* addInputFiles[] = {"./input/add_x.bin", "./input/add_y.bin"};
        for (uint32_t i = 0; i < kAddInputCount; i++) {
            size_t fileSize = 0;
            ReadFile(addInputFiles[i], fileSize, addInputHost[i], FILE_SIZE);
            aclrtMemcpy(addInputDevice[i], FILE_SIZE, addInputHost[i], FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);
        }

        // 第一个 kernel：Add
        if constexpr (scenarioNum == 6) {
            // L2 默认开启：流式数据写入 L2 Cache，污染缓存空间
            kernel_add<false><<<AIV_CORE_NUM, nullptr, stream>>>(addInputDevice[0], addInputDevice[1], addOutputDevice);
        } else {
            // L2 bypass：流式数据不写入 L2 Cache，保留 L2 空间给后续算子
            kernel_add<true><<<AIV_CORE_NUM, nullptr, stream>>>(addInputDevice[0], addInputDevice[1], addOutputDevice);
        }
        aclrtSynchronizeStream(stream);

        // 写出 Add 输出
        aclrtMemcpy(addOutputHost, FILE_SIZE, addOutputDevice, FILE_SIZE, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/add_output.bin", addOutputHost, FILE_SIZE);

        // 释放 Add 的资源
        for (uint32_t i = 0; i < kAddInputCount; i++) {
            aclrtFree(addInputDevice[i]);
            aclrtFreeHost(addInputHost[i]);
        }
        aclrtFree(addOutputDevice);
        aclrtFreeHost(addOutputHost);

        printf("[Case %u] Step 2: DataCopy Repeat kernel (split-4, each repeat 4 times)...\n", (uint32_t)scenarioNum);

        // 第二个 kernel：DataCopyRepeat
        uint8_t* repeatInputHost = nullptr;
        uint8_t* repeatInputDevice = nullptr;
        aclrtMallocHost(reinterpret_cast<void**>(&repeatInputHost), FILE_SIZE);
        aclrtMalloc(reinterpret_cast<void**>(&repeatInputDevice), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

        size_t repeatFileSize = 0;
        ReadFile("./input/repeat_input.bin", repeatFileSize, repeatInputHost, FILE_SIZE);
        aclrtMemcpy(repeatInputDevice, FILE_SIZE, repeatInputHost, FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);

        // 分片重复搬运：N 方向切 4 份，每份连续搬运 4 次，L2 默认开启
        // Case 6: 由于前面的 Add 污染了 L2，此时 L2 命中率偏低
        // Case 7: 由于 Add 使用了 L2 bypass，L2 空间干净，命中率高
        kernel_repeat<REPEAT_SPLIT_L2_ON><<<AIV_CORE_NUM, nullptr, stream>>>(repeatInputDevice);
        aclrtSynchronizeStream(stream);

        aclrtFree(repeatInputDevice);
        aclrtFreeHost(repeatInputHost);
    }
    // -------------------------------------------------------------------
    // Case 8-9: 多算子并行场景（两个 stream）
    //   Case 8: Add(L2 默认开启) 与 DataCopyRepeat(分片重复) 并行执行
    //           展示并行场景下 Add 流式数据污染 L2 对 Repeat 的影响
    //   Case 9: Add(L2 bypass) 与 DataCopyRepeat(分片重复) 并行执行
    //           与 Case 8 对比，展示并行场景下 L2 bypass 的保护效果
    // -------------------------------------------------------------------
    else if constexpr (scenarioNum == 8) {
        printf("[Case %u] Parallel scenario (Add + DataCopyRepeat, parallel streams, L2 on)\n", (uint32_t)scenarioNum);
        goto parallel_exec;
    } else {
        printf("[Case %u] Parallel scenario (Add + DataCopyRepeat, parallel streams, L2 bypass)\n", (uint32_t)scenarioNum);

    parallel_exec:
        // 创建两个 stream，使两个 kernel 可以并行执行
        aclrtStream streamAdd, streamRepeat;
        aclrtCreateStream(&streamAdd);
        aclrtCreateStream(&streamRepeat);

        // ---------- 准备 Add 算子的输入输出 ----------
        static constexpr uint32_t kAddInputCount = 2;
        uint8_t* addInputHost[kAddInputCount] = {nullptr, nullptr};
        uint8_t* addInputDevice[kAddInputCount] = {nullptr, nullptr};
        uint8_t* addOutputHost = nullptr;
        uint8_t* addOutputDevice = nullptr;

        for (uint32_t i = 0; i < kAddInputCount; i++) {
            aclrtMallocHost(reinterpret_cast<void**>(&addInputHost[i]), FILE_SIZE);
            aclrtMalloc(reinterpret_cast<void**>(&addInputDevice[i]), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);
        }
        aclrtMallocHost(reinterpret_cast<void**>(&addOutputHost), FILE_SIZE);
        aclrtMalloc(reinterpret_cast<void**>(&addOutputDevice), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

        // ---------- 准备 Repeat 算子的输入 ----------
        uint8_t* repeatInputHost = nullptr;
        uint8_t* repeatInputDevice = nullptr;
        aclrtMallocHost(reinterpret_cast<void**>(&repeatInputHost), FILE_SIZE);
        aclrtMalloc(reinterpret_cast<void**>(&repeatInputDevice), FILE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

        // 加载两个算子的输入数据
        const char* addInputFiles[] = {"./input/add_x.bin", "./input/add_y.bin"};
        for (uint32_t i = 0; i < kAddInputCount; i++) {
            size_t fileSize = 0;
            ReadFile(addInputFiles[i], fileSize, addInputHost[i], FILE_SIZE);
            aclrtMemcpy(addInputDevice[i], FILE_SIZE, addInputHost[i], FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);
        }
        size_t repeatFileSize = 0;
        ReadFile("./input/repeat_input.bin", repeatFileSize, repeatInputHost, FILE_SIZE);
        aclrtMemcpy(repeatInputDevice, FILE_SIZE, repeatInputHost, FILE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);

        // Case 8: Add 使用默认 L2 开启，流式数据会污染 L2
        // Case 9: Add 使用 L2 bypass，减少对 Repeat 的 L2 干扰
        if constexpr (scenarioNum == 8) {
            kernel_add<false><<<AIV_CORE_NUM, nullptr, streamAdd>>>(addInputDevice[0], addInputDevice[1], addOutputDevice);
        } else {
            kernel_add<true><<<AIV_CORE_NUM, nullptr, streamAdd>>>(addInputDevice[0], addInputDevice[1], addOutputDevice);
        }
        // Repeat 与 Add 在不同 stream 上并行执行
        kernel_repeat<REPEAT_SPLIT_L2_ON><<<AIV_CORE_NUM, nullptr, streamRepeat>>>(repeatInputDevice);

        // ---------- 等待两个 kernel 都完成 ----------
        aclrtSynchronizeStream(streamAdd);
        aclrtSynchronizeStream(streamRepeat);

        // 写出 Add 输出
        aclrtMemcpy(addOutputHost, FILE_SIZE, addOutputDevice, FILE_SIZE, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/add_output.bin", addOutputHost, FILE_SIZE);

        // 释放资源
        for (uint32_t i = 0; i < kAddInputCount; i++) {
            aclrtFree(addInputDevice[i]);
            aclrtFreeHost(addInputHost[i]);
        }
        aclrtFree(addOutputDevice);
        aclrtFreeHost(addOutputHost);
        aclrtFree(repeatInputDevice);
        aclrtFreeHost(repeatInputHost);

        aclrtDestroyStream(streamAdd);
        aclrtDestroyStream(streamRepeat);
    }

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Case %u completed.\n", (uint32_t)scenarioNum);
    return 0;
}
