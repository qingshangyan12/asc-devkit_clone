/* !
 * \file conv2d_forward_tensor_api.asc
 * \brief Conv2D Forward using Tensor API with multi-core tiling (32 cores, 4x8),
 *        double buffer (L1 + L0 ping-pong), K-tiling, N-tiling, and pipeline sync.
 *        GM input/output: NC1HWC0 format.
 *        Convolution params: N=4, C=512(C1=32,C0=16), COUT=512, H=16, W=96,
 *        KH=KW=3, stride=1, dilation=1, pad=1.
 *        GEMM dims: M=6144, K=4608, N=512.
 *        Tiling: baseM=256, baseK=64, baseN=256, stepKa=3, stepKb=3.
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

// ======================== Convolution Parameters ========================
constexpr uint32_t N_BATCH = 4;
constexpr uint32_t C1 = 32;
constexpr uint32_t C0 = 16;
constexpr uint32_t CIN = C1 * C0;       // 512
constexpr uint32_t COUT = 512;
constexpr uint32_t COUT_C1 = COUT / C0; // 32
constexpr uint32_t H = 16;
constexpr uint32_t W = 96;
constexpr uint32_t KH = 3;
constexpr uint32_t KW = 3;
constexpr uint32_t STRIDE_H = 1;
constexpr uint32_t STRIDE_W = 1;
constexpr uint32_t DILATION_H = 1;
constexpr uint32_t DILATION_W = 1;
constexpr uint32_t PAD_TOP = 1;
constexpr uint32_t PAD_BOTTOM = 1;
constexpr uint32_t PAD_LEFT = 1;
constexpr uint32_t PAD_RIGHT = 1;
constexpr uint32_t PAD_VALUE = 0;

constexpr uint32_t HOUT = (H + PAD_TOP + PAD_BOTTOM - DILATION_H * (KH - 1) - 1) / STRIDE_H + 1; // 16
constexpr uint32_t WOUT = (W + PAD_LEFT + PAD_RIGHT - DILATION_W * (KW - 1) - 1) / STRIDE_W + 1; // 96

// ======================== GEMM Dimensions ========================
constexpr uint32_t M_GEMM = N_BATCH * HOUT * WOUT;  // 6144
constexpr uint32_t K_GEMM = CIN * KH * KW;          // 4608
constexpr uint32_t N_GEMM = COUT;                    // 512

// ======================== Multi-Core Tiling (4 x 8 = 32 cores) ========================
constexpr uint32_t BLOCK_DIM = 32;
constexpr uint32_t M_CORES = 4;
constexpr uint32_t N_CORES = 8;
constexpr uint32_t SINGLE_CORE_M = M_GEMM / M_CORES;  // 1536
constexpr uint32_t SINGLE_CORE_N = N_GEMM / N_CORES;  // 64

// ======================== Base Tile Sizes ========================
constexpr uint32_t BASE_M = 256;
constexpr uint32_t BASE_K = 64;
constexpr uint32_t BASE_N = 256;

// ======================== K-loop Stepping ========================
constexpr uint32_t STEP_KA = 3;  // L1 fmap loads stepKa*baseK K-columns per group
constexpr uint32_t STEP_KB = 3;  // L1 weight loads stepKb*baseK K-columns per group

// ======================== Derived Constants ========================
constexpr uint32_t CHANNEL_SIZE = (STEP_KA * BASE_K + KH * KW - 1) / (KH * KW); // 64
constexpr uint32_t MAX_HIN_COUNT = BASE_M / WOUT + KH;  // 5 (max input rows per M tile)
constexpr uint32_t M_LOOP = SINGLE_CORE_M / BASE_M;     // 6
constexpr uint32_t N_LOOP = (SINGLE_CORE_N + BASE_N - 1) / BASE_N; // ceil(64/256) = 1
constexpr uint32_t K_LOOP = K_GEMM / BASE_K;            // 72
constexpr uint32_t M_OUT_H = (BASE_M + WOUT - 1) / WOUT; // 3 (CeilDiv(256,96))

// ======================== Buffer Sizes ========================
constexpr uint32_t L1_FMAP_BUF_SIZE = CHANNEL_SIZE * W * MAX_HIN_COUNT * C0;  // per buffer
constexpr uint32_t L1_WEIGHT_BUF_SIZE = STEP_KB * BASE_K * BASE_N;           // per buffer

// ======================== Data Sizes ========================
constexpr uint32_t FMAP_TOTAL = N_BATCH * C1 * H * W * C0;
constexpr uint32_t WEIGHT_TOTAL = (K_GEMM / C0) * (COUT / C0) * C0 * C0; // Fractal Z total elements
constexpr uint32_t OUT_TOTAL = N_BATCH * COUT_C1 * HOUT * WOUT * C0;

extern "C" __global__ __cube__ void conv2d_forward_tensor_api(
    __gm__ half* fmap, __gm__ half* weight, __gm__ half* out)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    uint32_t coreIdx = AscendC::GetBlockIdx();
    uint32_t mCoreIdx = coreIdx / N_CORES;  // M direction core index (0..3) = batch index
    uint32_t nCoreIdx = coreIdx % N_CORES;  // N direction core index (0..7)

    // Compute actual per-core sizes (handle tail tiles)
    uint32_t actualCoreM = ((mCoreIdx + 1) * SINGLE_CORE_M <= M_GEMM) ? SINGLE_CORE_M : (M_GEMM - mCoreIdx * SINGLE_CORE_M);
    uint32_t actualCoreN = ((nCoreIdx + 1) * SINGLE_CORE_N <= N_GEMM) ? SINGLE_CORE_N : (N_GEMM - nCoreIdx * SINGLE_CORE_N);

    // GM pointers for this core
    uint64_t fmapOffset = static_cast<uint64_t>(mCoreIdx) * C1 * H * W * C0;
    uint64_t weightOffset = static_cast<uint64_t>(nCoreIdx) * SINGLE_CORE_N * (K_GEMM / C0) * C0;
    __gm__ half* coreFmap = fmap + fmapOffset;
    __gm__ half* coreWeight = weight + weightOffset;

    // ======================== L1 Buffers (double buffer) ========================
    __cbuf__ half l1FmapBuf[2][L1_FMAP_BUF_SIZE];
    __cbuf__ half l1WeightBuf[2][L1_WEIGHT_BUF_SIZE];

    // ======================== L0 Buffers (ping-pong double buffer) ========================
    __ca__ half l0ABuf[2][BASE_M * BASE_K];
    __cb__ half l0BBuf[2][BASE_K * BASE_N];
    __cc__ float l0CBuf[BASE_M * BASE_N];

    // ======================== Copy Atoms ========================
    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyImg2ColAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    // ======================== Img2Col Parameters ========================
    Img2ColParams<half> img2colParams;
    img2colParams.filterW = KW;
    img2colParams.filterH = KH;
    img2colParams.strideW = STRIDE_W;
    img2colParams.strideH = STRIDE_H;
    img2colParams.dilationFilterW = DILATION_W;
    img2colParams.dilationFilterH = DILATION_H;
    img2colParams.padValue = static_cast<half>(PAD_VALUE);

    // ======================== Initialize Sync Flags ========================
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);

    // ======================== M-Loop ========================
    for (uint32_t mIter = 0; mIter < M_LOOP; mIter++) {
        uint32_t mStart = mIter * BASE_M;
        uint32_t mCount = ((mStart + BASE_M) <= actualCoreM) ? BASE_M : (actualCoreM - mStart);
        if (mCount == 0) break;

        // Compute output spatial range for this M tile
        int32_t houtStart = mStart / WOUT;
        int32_t woutStart = mStart % WOUT;
        int32_t houtEnd = (mStart + mCount - 1) / WOUT;

        // Compute input row range
        int32_t hinStart = houtStart * STRIDE_H - PAD_TOP;
        int32_t hinEnd = houtEnd * STRIDE_H - PAD_TOP + (KH - 1);
        int32_t hinStartClamped = (hinStart < 0) ? 0 : hinStart;
        int32_t hinEndClamped = (hinEnd >= static_cast<int32_t>(H)) ? (H - 1) : hinEnd;
        uint32_t hinCount = static_cast<uint32_t>(hinEndClamped - hinStartClamped + 1);

        // Dynamic padding for this M tile
        uint8_t padTop = static_cast<uint8_t>((hinStart < 0) ? (-hinStart) : 0);
        uint8_t padBottom = static_cast<uint8_t>((hinEnd >= static_cast<int32_t>(H))
            ? (hinEnd - static_cast<int32_t>(H) + 1) : 0);

        // ======================== N-Loop ========================
        for (uint32_t nIter = 0; nIter < N_LOOP; nIter++) {
            uint32_t nStart = nIter * BASE_N;
            uint32_t nCount = ((nStart + BASE_N) <= actualCoreN) ? BASE_N : (actualCoreN - nStart);
            if (nCount == 0) break;

            // Initialize L0C accumulator to zero
            auto l0CTensor = MakeTensor(
                MakeMemPtr(l0CBuf),
                MakeFrameLayout<NZLayoutPtn>(BASE_M, nCount));

            // ---- Reset ping-pong flags per (mIter, nIter) ----
            uint8_t mte2BufIdx = 0;
            uint8_t mte1BufIdx = 0;

            // ======================== K-Loop with Pipeline ========================
            for (uint32_t kIter = 0; kIter < K_LOOP; kIter++) {
                uint32_t kStart = kIter * BASE_K;
                uint32_t kModStepKa = kIter % STEP_KA;
                uint32_t kModStepKb = kIter % STEP_KB;

                // ======== MTE2 Stage: GM -> L1 (at start of each stepKa/stepKb group) ========
                if (kModStepKa == 0) {
                    // Wait for MTE1 to finish using the previous L1 fmap buffer
                    if (kIter > 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(mte2BufIdx);
                    }

                    // Load fmap slice to L1
                    uint64_t fmapKOffset = static_cast<uint64_t>(kStart) / (KH * KW * C0) * C1 * H * W * C0;
                    auto gmFmapSlice = MakeTensor(
                        MakeMemPtr(coreFmap + fmapKOffset),
                        MakeFrameLayout<NC1HWC0LayoutPtn>(
                            1, static_cast<int32_t>(CHANNEL_SIZE / C0),
                            static_cast<int32_t>(hinCount + KH - 1),
                            static_cast<int32_t>(W), static_cast<int32_t>(C0)));
                    auto l1FmapTensor = MakeTensor(
                        MakeMemPtr(l1FmapBuf[mte2BufIdx]),
                        MakeFrameLayout<NC1HWC0LayoutPtn>(
                            1, static_cast<int32_t>(CHANNEL_SIZE / C0),
                            static_cast<int32_t>(hinCount),
                            static_cast<int32_t>(W), static_cast<int32_t>(C0)));
                    Copy(copyGM2L1Atom, l1FmapTensor, gmFmapSlice);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                }

                if (kModStepKb == 0) {
                    // Load weight slice to L1
                    uint64_t weightKOffset = static_cast<uint64_t>(kStart / C0) * COUT * C0;
                    auto gmWeightSlice = MakeTensor(
                        MakeMemPtr(coreWeight + weightKOffset),
                        MakeFrameLayout<NDExtLayoutPtn>(
                            static_cast<int32_t>(STEP_KB * BASE_K),
                            static_cast<int32_t>(nCount)));
                    auto l1WeightTensor = MakeTensor(
                        MakeMemPtr(l1WeightBuf[mte2BufIdx]),
                        MakeFrameLayout<ZNLayoutPtn, half>(
                            static_cast<int32_t>(STEP_KB * BASE_K),
                            static_cast<int32_t>(nCount)));
                    Copy(copyGM2L1Atom, l1WeightTensor, gmWeightSlice);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);
                }

                // ======== MTE1 Stage: L1 -> L0 (Img2Col + Copy) ========
                // Wait for MTE2 to finish loading
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID1);

                // Wait for M (cube) to finish using the previous L0 buffers
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(mte1BufIdx);

                // L1 -> L0A: Img2Col
                uint32_t currL1Idx = (mte2BufIdx == 0) ? 1 : 0; // read from the loaded buffer
                auto l1FmapRead = MakeTensor(
                    MakeMemPtr(l1FmapBuf[currL1Idx]),
                    MakeFrameLayout<NC1HWC0LayoutPtn>(
                        1, static_cast<int32_t>(CHANNEL_SIZE / C0),
                        static_cast<int32_t>(hinCount),
                        static_cast<int32_t>(W), static_cast<int32_t>(C0)));

                img2colParams.padList[0] = PAD_LEFT;
                img2colParams.padList[1] = PAD_RIGHT;
                img2colParams.padList[2] = padTop;
                img2colParams.padList[3] = padBottom;

                auto l0ATensor = MakeTensor(
                    MakeMemPtr(l0ABuf[mte1BufIdx]),
                    MakeFrameLayout<NZLayoutPtn, half>(mCount, BASE_K));
                Copy(copyImg2ColAtom.with(img2colParams), l0ATensor, l1FmapRead);

                // L1 -> L0B: Weight
                auto l1WeightRead = MakeTensor(
                    MakeMemPtr(l1WeightBuf[currL1Idx]),
                    MakeFrameLayout<ZNLayoutPtn, half>(
                        static_cast<int32_t>(STEP_KB * BASE_K),
                        static_cast<int32_t>(nCount)));
                // Slice baseK from the stepKb*baseK block
                uint32_t kOffsetInBlock = kModStepKb * BASE_K;
                auto l0BFullTensor = MakeTensor(
                    MakeMemPtr(l1WeightBuf[currL1Idx]),
                    MakeFrameLayout<ZNLayoutPtn, half>(
                        static_cast<int32_t>(STEP_KB * BASE_K),
                        static_cast<int32_t>(nCount)));
                auto l0BSlice = l0BFullTensor.Slice(
                    MakeCoord(static_cast<int32_t>(kOffsetInBlock), 0),
                    MakeShape(static_cast<int32_t>(BASE_K), static_cast<int32_t>(nCount)));
                auto l0BTensor = MakeTensor(
                    MakeMemPtr(l0BBuf[mte1BufIdx]),
                    MakeFrameLayout<ZNLayoutPtn, half>(BASE_K, nCount));
                Copy(copyL12L0BAtom, l0BTensor, l0BSlice);

                // Signal MTE1 -> MTE2: L1 buffer can be reused
                if ((kIter + 1) % STEP_KA == 0) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(mte2BufIdx);
                    mte2BufIdx = (mte2BufIdx == 0) ? 1 : 0;
                }

                // Signal MTE1 -> M: L0 data ready
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(mte1BufIdx);

                // ======== M Stage: Mmad ========
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(mte1BufIdx);

                auto l0ACompute = MakeTensor(
                    MakeMemPtr(l0ABuf[mte1BufIdx]),
                    MakeFrameLayout<NZLayoutPtn, half>(mCount, BASE_K));
                auto l0BCompute = MakeTensor(
                    MakeMemPtr(l0BBuf[mte1BufIdx]),
                    MakeFrameLayout<ZNLayoutPtn, half>(BASE_K, nCount));

                MmadParams mmadParams;
                mmadParams.m = mCount;
                mmadParams.n = nCount;
                mmadParams.k = BASE_K;
                mmadParams.cmatrixInitVal = (kIter == 0); // init on first K, accumulate after
                Mmad(mmadAtom.with(mmadParams), l0CTensor, l0ACompute, l0BCompute);

                // Signal M -> MTE1: L0 buffers can be reused
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(mte1BufIdx);
                mte1BufIdx = (mte1BufIdx == 0) ? 1 : 0;
            } // K-Loop

            // ======== Store Result: L0C -> GM ========
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

            // GM output: NC1HWC0 [N_BATCH, COUT_C1, HOUT, WOUT, C0]
            // This core's output offset: batch=mCoreIdx, channel start=nCoreIdx*SINGLE_CORE_N
            uint32_t outC1Start = nCoreIdx * SINGLE_CORE_N / C0;
            uint64_t outOffset = static_cast<uint64_t>(mCoreIdx) * COUT_C1 * HOUT * WOUT * C0
                               + static_cast<uint64_t>(outC1Start) * HOUT * WOUT * C0
                               + static_cast<uint64_t>(mIter * BASE_M) * C0;

            auto gmOutTensor = MakeTensor(
                MakeMemPtr(out + outOffset),
                MakeFrameLayout<NC1HWC0LayoutPtn>(
                    1, static_cast<int32_t>(nCount / C0),
                    static_cast<int32_t>(M_OUT_H),
                    static_cast<int32_t>(WOUT), static_cast<int32_t>(C0)));
            Copy(copyL0C2GMAtom, gmOutTensor, l0CTensor);

            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        } // N-Loop
    } // M-Loop

    // ======================== Final Sync ========================
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmapFileSize = FMAP_TOTAL * sizeof(half);
    size_t weightFileSize = WEIGHT_TOTAL * sizeof(half);
    size_t outFileSize = OUT_TOTAL * sizeof(half);
    uint32_t numBlocks = BLOCK_DIM;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmapHost;
    half* fmapDevice;
    aclrtMallocHost((void**)(&fmapHost), fmapFileSize);
    aclrtMalloc((void**)&fmapDevice, fmapFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmapFileSize, fmapHost, fmapFileSize);
    aclrtMemcpy(fmapDevice, fmapFileSize, fmapHost, fmapFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weightHost;
    half* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightFileSize);
    aclrtMalloc((void**)&weightDevice, weightFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weightFileSize, weightHost, weightFileSize);
    aclrtMemcpy(weightDevice, weightFileSize, weightHost, weightFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outHost;
    half* outDevice;
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_tensor_api<<<numBlocks, nullptr, stream>>>(fmapDevice, weightDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(fmapDevice);
    aclrtFreeHost(fmapHost);
    aclrtFree(weightDevice);
    aclrtFreeHost(weightHost);
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
