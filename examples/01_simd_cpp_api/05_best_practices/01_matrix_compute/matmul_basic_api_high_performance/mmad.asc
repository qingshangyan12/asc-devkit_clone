/* !
 * \file mmad.asc
 * \brief matmul鍩虹API鏈€浣冲疄璺垫牱渚?
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;
constexpr uint32_t L0_PINGPONG_BYTES = 32 * 1024;
constexpr uint32_t L1_PINGPONG_BYTES = 256 * 1024;
constexpr bool IS_B_TRANSPOSE = true;
constexpr uint32_t scenarioNum = SCENARIO_NUM;


template <uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN,
          uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
          uint32_t stepKa, uint32_t stepKb>
class KernelMmad {

public:
    __aicore__ inline KernelMmad() {}

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
    {
        aGMOri.SetGlobalBuffer((__gm__ half *)a);
        bGMOri.SetGlobalBuffer((__gm__ half *)b);
        cGMOri.SetGlobalBuffer((__gm__ half *)c);
    }

    __aicore__ inline void Process()
    {
        InitComputeParams();

        // ============================================================
        // 1. Buffer 鍒嗛厤锛歀1 / L0 鍙岀紦鍐?Ping-Pong 甯冨眬
        // ============================================================
        // L1: A1 Ping/Pong (0~256KB), B1 Ping/Pong (256~512KB)
        // L0: A2/B2 Ping/Pong (0~32KB / 32KB~64KB)
        uint32_t a1PingpongSize = baseM * baseK * stepKa;
        uint32_t b1PingpongSize = baseK * baseN * stepKb;
        uint32_t a2PingpongSize = baseM * baseK;
        uint32_t b2PingpongSize = baseK * baseN;

        // A1: L1 Ping/Pong
        AscendC::LocalTensor<half> a1LocalPing(AscendC::TPosition::A1, 0, a1PingpongSize);
        AscendC::LocalTensor<half> a1LocalPong(AscendC::TPosition::A1, a1PingpongSize * sizeof(half), a1PingpongSize);
        // A2: L0 Ping/Pong
        AscendC::LocalTensor<half> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        AscendC::LocalTensor<half> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);

        // B1: L1 Ping/Pong
        AscendC::LocalTensor<half> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1PingpongSize);
        AscendC::LocalTensor<half> b1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1PingpongSize * sizeof(half), b1PingpongSize);
        // B2: L0 Ping/Pong
        AscendC::LocalTensor<half> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        AscendC::LocalTensor<half> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);
        // CO1: L0C
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        ProcessLoop(a1LocalPing, a1LocalPong, a2LocalPing, a2LocalPong,
                       b1LocalPing, b1LocalPong, b2LocalPing, b2LocalPong, cLocal);
    }

    // ============================================================
    // L2 Cache 浼樺寲锛氬弻閲嶅灞傚惊鐜紙M 缁村害 + N 缁村害鍒嗘壒锛?
    // ============================================================
    __aicore__ inline void ProcessL2Cache()
    {

        // ---- Step 1: Buffer 鍒嗛厤锛歀1 / L0 鍙岀紦鍐?Ping-Pong 甯冨眬
        uint32_t a1PingpongSize = baseM * baseK * stepKa;
        uint32_t b1PingpongSize = baseK * baseN * stepKb;
        uint32_t a2PingpongSize = baseM * baseK;
        uint32_t b2PingpongSize = baseK * baseN;

        AscendC::LocalTensor<half> a1LocalPing(AscendC::TPosition::A1, 0, a1PingpongSize);
        AscendC::LocalTensor<half> a1LocalPong(AscendC::TPosition::A1, a1PingpongSize * sizeof(half), a1PingpongSize);
        AscendC::LocalTensor<half> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        AscendC::LocalTensor<half> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);

        AscendC::LocalTensor<half> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1PingpongSize);
        AscendC::LocalTensor<half> b1LocalPong(AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1PingpongSize * sizeof(half), b1PingpongSize);
        AscendC::LocalTensor<half> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        AscendC::LocalTensor<half> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        // ---- Step 2: 璁＄畻鍒嗘壒鍙傛暟 ----
        // mIterTotal/nIterTotal: M/N 鏂瑰悜鎬诲叡闇€瑕佸灏戜釜 singleCore 澶у皬鐨勫瓙鍧?
        constexpr uint32_t mIterTotal = AscendC::DivCeil(M, singleCoreM);
        constexpr uint32_t nIterTotal = AscendC::DivCeil(N, singleCoreN);
        // 姣忚疆 numBlocks 鏍歌鐩栫殑 M 浠芥暟
        constexpr uint32_t mIterPerRound = AscendC::DivCeil(M, singleCoreM * 2); // 2 杞?M
        // 澶栧眰寰幆杞暟
        constexpr uint32_t outerMLoopCount = AscendC::DivCeil(mIterTotal, mIterPerRound);

        // ---- Step 3: outerMIdx/outerNIdx 澶栧眰寰幆 ----
        for (uint32_t outerMIdx = 0; outerMIdx < outerMLoopCount; outerMIdx++) {
            //   鏍规嵁鏍哥储寮?blockIdx 璁＄畻褰撳墠鏍稿湪鏈疆璐熻矗鐨勫瓙鍧楀潗鏍?
            //   mIterIdx = blockIdx 鍦?M 鏂瑰悜鐨勫亸绉?+ 鏈疆鐨?M 璧峰鍋忕Щ
            //   nIterIdx = blockIdx 鍦?N 鏂瑰悜鐨勫亸绉?
            uint32_t mIterIdx = AscendC::GetBlockIdx() % mIterPerRound + outerMIdx * mIterPerRound;
            uint32_t nIterIdx = AscendC::GetBlockIdx() / mIterPerRound;

            // 杈圭晫淇濇姢锛氬綋 M/N 涓嶈兘琚暣闄ゆ椂锛屾渶鍚庝竴杞儴鍒嗘牳浼氳秴鍑哄瓙鍧楄寖鍥达紝鐩存帴璺宠繃
            if (mIterIdx >= mIterTotal || nIterIdx >= nIterTotal) continue;

            // 鏍规嵁瀛愬潡鍧愭爣璁＄畻 GM 鍋忕Щ銆佸惊鐜鏁般€佸熬鍧楀弬鏁扮瓑
            InitComputeParamsL2Cache(mIterIdx, nIterIdx);

            // 鎵ц褰撳墠瀛愬潡鐨勫畬鏁?N/M/K 寰幆璁＄畻
            ProcessLoop(a1LocalPing, a1LocalPong, a2LocalPing, a2LocalPong,
                            b1LocalPing, b1LocalPong, b2LocalPing, b2LocalPong, cLocal);

            // 姣忚疆澶栧眰寰幆鍚庨噸缃弻缂撳啿 flag
            mte1DBFlag = 0;
        }
    }

private:
    // N/M/K 涓诲惊鐜細鎵ц褰撳墠鏍哥殑瀹屾暣璁＄畻
    __aicore__ inline void ProcessLoop(
        AscendC::LocalTensor<half> &a1LocalPing, AscendC::LocalTensor<half> &a1LocalPong,
        AscendC::LocalTensor<half> &a2LocalPing, AscendC::LocalTensor<half> &a2LocalPong,
        AscendC::LocalTensor<half> &b1LocalPing, AscendC::LocalTensor<half> &b1LocalPong,
        AscendC::LocalTensor<half> &b2LocalPing, AscendC::LocalTensor<half> &b2LocalPong,
        AscendC::LocalTensor<float> &cLocal)
    {
        // ============================================================
        // 1. DataCopyIn 杩涘害璺熻釜鍙橀噺
        // ============================================================
        uint32_t a1NextKChunkIdx = 0;  // A 涓嬩竴娆?DataCopyIn 瑕佹惉鐨?K 鏂瑰悜澶у寘绱㈠紩
        uint32_t b1NextKChunkIdx = 0;  // B 涓嬩竴娆?DataCopyIn 瑕佹惉鐨?K 鏂瑰悜澶у寘绱㈠紩
        uint8_t a1CopyInIdx = 0;       // A 涓嬩竴娆?DataCopyIn 鍐欏叆鐨?L1 buffer 绱㈠紩 (0=Ping, 1=Pong)
        uint8_t b1CopyInIdx = 0;       // B 涓嬩竴娆?DataCopyIn 鍐欏叆鐨?L1 buffer 绱㈠紩 (0=Ping, 1=Pong)

        // ============================================================
        // 2. 鍚屾鏍囧織鍒濆鍖栵細鍙嶅悜鍚屾闇€棰勭疆锛岄槻姝㈤娆?WaitFlag 姝婚攣
        // ============================================================
        // MTE1_MTE2 (鍙嶅悜): DataCopyIn 鍙鐩栭€氱煡
        //   EVENT_ID0: A1 Ping 鍙啓 | EVENT_ID1: A1 Pong 鍙啓
        //   EVENT_ID2: B1 Ping 鍙啓 | EVENT_ID3: B1 Pong 鍙啓
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        // M_MTE1 (鍙嶅悜): L0 鍙岀紦鍐诧紝DataLoad 鍙鐩栭€氱煡
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);

        // ============================================================
        // 3. N/M 澶栧眰寰幆 + K 涓诲惊鐜?
        // ============================================================
        for (uint32_t nBlockIdx = 0; nBlockIdx < nLoopCount; nBlockIdx++) {
            for (uint32_t mBlockIdx = 0; mBlockIdx < mLoopCount; mBlockIdx++) {
                // 姣忎釜 (mBlockIdx, nBlockIdx) 瀛愬潡閲嶇疆 DataCopyIn 杩涘害
                a1NextKChunkIdx = 0;
                b1NextKChunkIdx = 0;
                a1CopyInIdx = 0;
                b1CopyInIdx = 0;

                // ---- 鎼叆 A1 Ping 鍜?B1 Ping 鐨勯涓ぇ鍖?----
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);  // A1 Ping 鍙啓
                DataCopyInA(a1LocalPing, a1NextKChunkIdx, mBlockIdx);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);   // A1 Ping 鏁版嵁灏辩华
                a1NextKChunkIdx += stepKa;
                a1CopyInIdx ^= 1;  // 涓嬫鍐?Pong

                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);  // B1 Ping 鍙啓
                DataCopyInB(b1LocalPing, b1NextKChunkIdx, nBlockIdx);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2);   // B1 Ping 鏁版嵁灏辩华
                b1NextKChunkIdx += stepKb;
                b1CopyInIdx ^= 1;  // 涓嬫鍐?Pong

                // ---- K 鏂瑰悜涓诲惊鐜?----
                for (uint32_t kBlockIdx = 0; kBlockIdx < kLoopCount; kBlockIdx++) {
                    // 纭畾褰撳墠 kBlockIdx 瀵瑰簲鐨?L1 璇诲彇缂撳啿鍖猴紙Ping/Pong锛?
                    uint32_t a1ReadIdx = (kBlockIdx / stepKa) % 2;
                    uint32_t b1ReadIdx = (kBlockIdx / stepKb) % 2;
                    uint32_t kOffsetInChunkA = kBlockIdx % stepKa;
                    uint32_t kOffsetInChunkB = kBlockIdx % stepKb;

                    AscendC::LocalTensor<half> a1ReadBuf = (a1ReadIdx == 0) ? a1LocalPing : a1LocalPong;
                    AscendC::LocalTensor<half> b1ReadBuf = (b1ReadIdx == 0) ? b1LocalPing : b1LocalPong;
                    int32_t a1ReadEvent = (a1ReadIdx == 0) ? EVENT_ID0 : EVENT_ID1;
                    int32_t b1ReadEvent = (b1ReadIdx == 0) ? EVENT_ID2 : EVENT_ID3;

                    // L0 鍙岀紦鍐查€夋嫨
                    AscendC::LocalTensor<half> a2Local = (mte1DBFlag == 0) ? a2LocalPing : a2LocalPong;
                    AscendC::LocalTensor<half> b2Local = (mte1DBFlag == 0) ? b2LocalPing : b2LocalPong;

                    // ---- 鍙嶅悜鍚屾锛氱瓑寰呬笂涓€杞?Compute 閲婃斁 L0 缂撳啿鍖?----
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag);

                    // ---- 姝ｅ悜鍚屾锛氱瓑寰?L1 澶у寘鏁版嵁灏辩华锛堜粎澶у寘涓鍏冪礌闇€绛夊緟锛?----
                    if (kOffsetInChunkA == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(a1ReadEvent);
                    }
                    if (kOffsetInChunkB == 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(b1ReadEvent);
                    }

                    // ---- DataLoad: L1 鈫?L0 ----
                    DataLoadA(a1ReadBuf, a2Local, mBlockIdx, kOffsetInChunkA);
                    DataLoadB(b1ReadBuf, b2Local, nBlockIdx, kOffsetInChunkB);

                    // ---- 鍙嶅悜鍚屾锛氬綋鍓?L1 澶у寘娑堣垂瀹屾瘯锛岄€氱煡 DataCopyIn 鍙鐩?----
                    if ((kOffsetInChunkA + 1) == stepKa) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(a1ReadEvent);
                    }
                    if ((kOffsetInChunkB + 1) == stepKb) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(b1ReadEvent);
                    }

                    // ---- Compute: Mmad 鐭╅樀涔樼疮鍔?----
                    Compute(cLocal, a2Local, b2Local, kBlockIdx, mBlockIdx, nBlockIdx);

                    // ---- 鎼叆涓嬩竴涓?L1 澶у寘锛屼娇 DataCopyIn 涓?Compute 娴佹按閲嶅彔 ----
                    // 瑙﹀彂鏉′欢锛?
                    //   (1) kBlockIdx == 0锛氶涓?K 鍧楄绠楁椂锛孉1/B1 Pong 灏氭湭浣跨敤锛屽彲鐩存帴鎼叆
                    //   (2) 褰撳墠 L1 澶у寘鏈€鍚庝竴涓?baseK 琚秷璐瑰畬锛岃缂撳啿鍖哄彲琚鐩?
                    if (((kBlockIdx == 0) || ((kOffsetInChunkB + 1) == stepKb)) && b1NextKChunkIdx < kLoopCount) {
                        AscendC::LocalTensor<half> b1WriteBuf = (b1CopyInIdx == 0) ? b1LocalPing : b1LocalPong;
                        int32_t b1WriteEvent = (b1CopyInIdx == 0) ? EVENT_ID2 : EVENT_ID3;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(b1WriteEvent);
                        DataCopyInB(b1WriteBuf, b1NextKChunkIdx, nBlockIdx);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(b1WriteEvent);
                        b1NextKChunkIdx += stepKb;
                        b1CopyInIdx ^= 1;
                    }
                    if (((kBlockIdx == 0) || ((kOffsetInChunkA + 1) == stepKa)) && a1NextKChunkIdx < kLoopCount) {
                        AscendC::LocalTensor<half> a1WriteBuf = (a1CopyInIdx == 0) ? a1LocalPing : a1LocalPong;
                        int32_t a1WriteEvent = (a1CopyInIdx == 0) ? EVENT_ID0 : EVENT_ID1;
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(a1WriteEvent);
                        DataCopyInA(a1WriteBuf, a1NextKChunkIdx, mBlockIdx);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(a1WriteEvent);
                        a1NextKChunkIdx += stepKa;
                        a1CopyInIdx ^= 1;
                    }
                }
                // ---- CopyOut: CO1 鈫?GM ----
                CopyOut(cLocal, mBlockIdx, nBlockIdx);
            }
        }

        // ============================================================
        // 4. 绛夊緟鎵€鏈夊悓姝ュ畬鎴?
        // ============================================================
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
    }

    __aicore__ inline void InitComputeParams()
    {
        // ---- 1. 璁＄畻褰撳墠鏍稿湪 M/N 鏂瑰悜鐨勮凯浠ｇ储寮曪紝纭畾 GM 璧峰鍋忕Щ ----
        constexpr uint32_t mIter = AscendC::DivCeil(M, singleCoreM);
        uint32_t mIterIdx = AscendC::GetBlockIdx() % mIter;
        uint32_t nIterIdx = AscendC::GetBlockIdx() / mIter;

        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        aGM = aGMOri[gmOffsetA];
        bGM = bGMOri[gmOffsetB];
        cGM = cGMOri[gmOffsetC];

        // ---- 2. 璁＄畻褰撳墠鏍稿疄闄呯殑 M/N 缁村害澶у皬锛堟渶鍚庝竴鍧楀彲鑳戒笉婊?singleCore锛?----
        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        // ---- 3. 璁＄畻 K/M/N 涓変釜缁村害鐨勫惊鐜鏁?----
        kLoopCount = AscendC::DivCeil(singleCoreK, baseK);
        mLoopCount = AscendC::DivCeil(actualSingleCoreM, baseM);
        nLoopCount = AscendC::DivCeil(actualSingleCoreN, baseN);

        // ---- 4. 璁＄畻 N 鏂瑰悜鍒嗗潡鍙傛暟锛氬畬鏁?baseN 鍧楁暟 + 灏惧潡澶у皬鍙婂榻?----
        baseNCount = actualSingleCoreN / baseN;
        tailN = actualSingleCoreN % baseN;
        tailNAlign = AscendC::DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;

        // ---- 5. 璁＄畻 M 鏂瑰悜鍒嗗潡鍙傛暟锛氬畬鏁?baseM 鍧楁暟 + 灏惧潡澶у皬鍙婂榻?----
        baseMCount = actualSingleCoreM / baseM;
        tailM = actualSingleCoreM % baseM;
        tailMAlign = AscendC::DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
    }

    // 鏍规嵁瀛愬潡绱㈠紩璁剧疆褰撳墠瀛愬潡鐨勫叏閮ㄨ绠楀弬鏁?
    // mIterIdx: 褰撳墠鏍稿湪 M 鏂瑰悜鐨勫瓙鍧楃储寮?
    // nIterIdx: 褰撳墠鏍稿湪 N 鏂瑰悜鐨勫瓙鍧楃储寮?
    __aicore__ inline void InitComputeParamsL2Cache(uint32_t mIterIdx, uint32_t nIterIdx)
    {
        // ----  璁＄畻褰撳墠瀛愬潡鍦?GM 涓殑璧峰鍋忕Щ ----
        // aGM/bGM/cGM 鎸囧悜褰撳墠瀛愬潡璧峰浣嶇疆锛屽悗缁?DataCopyIn/CopyOut 鍩轰簬璇ュ亸绉诲鍧€
        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        aGM = aGMOri[gmOffsetA];
        bGM = bGMOri[gmOffsetB];
        cGM = cGMOri[gmOffsetC];

        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        kLoopCount = AscendC::DivCeil(singleCoreK, baseK);
        mLoopCount = AscendC::DivCeil(actualSingleCoreM, baseM);
        nLoopCount = AscendC::DivCeil(actualSingleCoreN, baseN);
        baseNCount = actualSingleCoreN / baseN;
        tailN = actualSingleCoreN % baseN;
        tailNAlign = AscendC::DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;

        baseMCount = actualSingleCoreM / baseM;
        tailM = actualSingleCoreM % baseM;
        tailMAlign = AscendC::DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
    }

    // GM 鈫?A1: 灏?A 鐭╅樀鐨勪竴涓ぇ鍖?(stepKa 涓?baseK) 鎼叆 L1
    // kChunkIdx: K 鏂瑰悜澶у寘绱㈠紩锛岀敤浜庤绠?GM 璇诲彇鍋忕Щ
    // mBlockIdx: M 鏂瑰悜 baseM 鍧楃储寮曪紝鐢ㄤ簬璁＄畻 GM 璇诲彇鍋忕Щ鍙婂垽鏂熬鍧?
    __aicore__ inline void DataCopyInA(AscendC::LocalTensor<half> a1Local, uint32_t kChunkIdx, uint32_t mBlockIdx)
    {
        // 灏惧潡浣跨敤 tailM锛屽惁鍒欎娇鐢?baseM
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        AscendC::Nd2NzParams nd2nzParams;
        nd2nzParams.ndNum = 1;
        nd2nzParams.nValue = curM;
        nd2nzParams.dValue = baseK * stepKa;
        nd2nzParams.srcNdMatrixStride = 0;
        nd2nzParams.srcDValue = K;
        nd2nzParams.dstNzC0Stride = baseM;
        nd2nzParams.dstNzNStride = 1;
        nd2nzParams.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kChunkIdx * baseK + mBlockIdx * K * baseM], nd2nzParams);
    }

    // GM 鈫?B1: 灏?B 鐭╅樀鐨勪竴涓ぇ鍖?(stepKb 涓?baseK) 鎼叆 L1
    // kChunkIdx: K 鏂瑰悜澶у寘绱㈠紩锛岀敤浜庤绠?GM 璇诲彇鍋忕Щ
    // nBlockIdx: N 鏂瑰悜 baseN 鍧楃储寮曪紝鐢ㄤ簬璁＄畻 GM 璇诲彇鍋忕Щ鍙婂垽鏂熬鍧?
    __aicore__ inline void DataCopyInB(AscendC::LocalTensor<half> b1Local, uint32_t kChunkIdx, uint32_t nBlockIdx)
    {
        // 灏惧潡浣跨敤 tailN锛屽惁鍒欎娇鐢?baseN
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::Nd2NzParams nd2nzParams;
        if constexpr (!IS_B_TRANSPOSE) {
            // B 闈炶浆缃?
            nd2nzParams.ndNum = 1;
            nd2nzParams.nValue = baseK * stepKb;
            nd2nzParams.dValue = curN;
            nd2nzParams.srcNdMatrixStride = 0;
            nd2nzParams.srcDValue = N;
            nd2nzParams.dstNzC0Stride = baseK * stepKb;
            nd2nzParams.dstNzNStride = 1;
            nd2nzParams.dstNzMatrixStride = 0;
            AscendC::DataCopy(b1Local, bGM[kChunkIdx * baseK * N + nBlockIdx * baseN], nd2nzParams);
        } else {
            // B 杞疆
            nd2nzParams.ndNum = 1;
            nd2nzParams.nValue = curN;
            nd2nzParams.dValue = baseK * stepKb;
            nd2nzParams.srcNdMatrixStride = 0;
            nd2nzParams.srcDValue = K;
            nd2nzParams.dstNzC0Stride = baseN;
            nd2nzParams.dstNzNStride = 1;
            nd2nzParams.dstNzMatrixStride = 0;
            AscendC::DataCopy(b1Local, bGM[kChunkIdx * baseK + nBlockIdx * baseN * K], nd2nzParams);
        }
    }

    // A1 鈫?A2: 灏?L1 涓殑涓€涓?baseM * baseK 鍒囩墖鎼叆 L0
    // mBlockIdx: M 鏂瑰悜 baseM 鍧楃储寮曪紝鐢ㄤ簬鍒ゆ柇灏惧潡瀵归綈
    // kOffsetInChunkA: 褰撳墠 base鍧?鍦ㄥぇ鍖呭唴鐨勫亸绉诲簭鍙?(0 ~ stepKa-1)
    __aicore__ inline void DataLoadA(AscendC::LocalTensor<half> a1Local, AscendC::LocalTensor<half> a2Local,
                                     uint32_t mBlockIdx, uint32_t kOffsetInChunkA)
    {
        uint32_t srcAddr = kOffsetInChunkA * baseK * baseM;
        // 灏惧潡浣跨敤瀵归綈鍚庣殑 tailMAlign锛屼繚璇?LoadData 鍦板潃瀵归綈
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201
        AscendC::LoadData3DParamsV2<half> loadDataParams;
        loadDataParams.l1H = 1;
        loadDataParams.l1W = baseM;
        loadDataParams.channelSize = baseK;
        loadDataParams.kExtension = baseK;
        loadDataParams.mExtension = curMAlign;
        loadDataParams.mStartPt = 0;
        loadDataParams.kStartPt = 0;
        AscendC::LoadData(a2Local, a1Local[srcAddr], loadDataParams);
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0;
        loadDataParams.kStartPosition = 0;
        loadDataParams.mStep = AscendC::DivCeil(curMAlign, CUBE_BLOCK);
        loadDataParams.kStep = AscendC::DivCeil(baseK, CUBE_BLOCK);
        loadDataParams.srcStride = AscendC::DivCeil(baseM, CUBE_BLOCK);
        loadDataParams.dstStride = AscendC::DivCeil(curMAlign, CUBE_BLOCK);
        loadDataParams.sid = 0;
        loadDataParams.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local[srcAddr], loadDataParams);
#endif
    }

    // B1 鈫?B2: 灏?L1 涓殑涓€涓?baseK * baseN 鍒囩墖鎼叆 L0
    // nBlockIdx: N 鏂瑰悜 baseN 鍧楃储寮曪紝鐢ㄤ簬鍒ゆ柇灏惧潡瀵归綈
    // kOffsetInChunkB: 褰撳墠 base鍧?鍦ㄥぇ鍖呭唴鐨勫亸绉诲簭鍙?(0 ~ stepKb-1)
    __aicore__ inline void DataLoadB(AscendC::LocalTensor<half> b1Local, AscendC::LocalTensor<half> b2Local,
                                     uint32_t nBlockIdx, uint32_t kOffsetInChunkB)
    {
        uint32_t srcAddr = kOffsetInChunkB * baseK * (IS_B_TRANSPOSE ? baseN : CUBE_BLOCK);
        // 灏惧潡浣跨敤瀵归綈鍚庣殑 tailNAlign锛屼繚璇?LoadData 鍦板潃瀵归綈
        uint32_t curNAlign = (nBlockIdx != baseNCount) ? baseN : tailNAlign;
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201
        if constexpr (!IS_B_TRANSPOSE) {
            // B 闈炶浆缃? 浣跨敤 LoadData3DV2 瀹屾垚 [K, N] 鈫?[N, K] 杞疆鎼繍
            AscendC::LoadData3DParamsV2<half> loadDataParams;
            loadDataParams.l1H = 1;
            loadDataParams.l1W = baseK * stepKb;
            loadDataParams.channelSize = baseN;
            loadDataParams.kExtension = curNAlign;
            loadDataParams.mExtension = baseK;
            loadDataParams.mStartPt = kOffsetInChunkB * baseK;
            loadDataParams.kStartPt = 0;
            loadDataParams.strideW = 1;
            loadDataParams.strideH = 1;
            loadDataParams.filterW = 1;
            loadDataParams.filterH = 1;
            loadDataParams.dilationFilterW = 1;
            loadDataParams.dilationFilterH = 1;
            loadDataParams.filterSizeW = false;
            loadDataParams.filterSizeH = false;
            loadDataParams.enTranspose = true;
            loadDataParams.fMatrixCtrl = false;
            AscendC::LoadData(b2Local, b1Local, loadDataParams);
        } else {
            // B 杞疆: 鎸?CUBE_BLOCK 绮掑害閫愬潡鎼叆 L0锛屾棤闇€杞疆
            AscendC::LoadData2DParams loadDataParams;
            uint32_t dstOffset = curNAlign * CUBE_BLOCK;
            uint32_t srcOffset = baseN * CUBE_BLOCK;
            loadDataParams.repeatTimes = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.srcStride = 1;
            loadDataParams.dstGap = 0;
            loadDataParams.ifTranspose = false;
            for (int i = 0; i < AscendC::DivCeil(baseK, CUBE_BLOCK); ++i) {
                AscendC::LoadData(b2Local[i * dstOffset], b1Local[srcAddr + i * srcOffset], loadDataParams);
            }
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        if constexpr (!IS_B_TRANSPOSE) {
            // B 闈炶浆缃? 浣跨敤 LoadData2D V2 瀹屾垚 [K, N] 鈫?[N, K] 杞疆鎼繍
            AscendC::LoadData2DParamsV2 loadDataParams;
            loadDataParams.mStartPosition = 0;
            loadDataParams.kStartPosition = 0;
            loadDataParams.mStep = AscendC::DivCeil(baseK, CUBE_BLOCK);
            loadDataParams.kStep = AscendC::DivCeil(curNAlign * sizeof(half), 32);
            loadDataParams.srcStride = AscendC::DivCeil(baseK * stepKb, CUBE_BLOCK);
            loadDataParams.dstStride = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.ifTranspose = true;
            AscendC::LoadData(b2Local, b1Local[srcAddr], loadDataParams);
        } else {
            // B 杞疆: 鏃犻渶杞疆锛岀洿鎺ユ寜鍧楁惉杩?
            AscendC::LoadData2DParamsV2 loadDataParams;
            loadDataParams.mStartPosition = 0;
            loadDataParams.kStartPosition = 0;
            loadDataParams.mStep = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.kStep = AscendC::DivCeil(baseK * sizeof(half), 32);
            loadDataParams.srcStride = AscendC::DivCeil(baseN, CUBE_BLOCK);
            loadDataParams.dstStride = AscendC::DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.ifTranspose = false;
            AscendC::LoadData(b2Local, b1Local[srcAddr], loadDataParams);
        }
#endif
    }

    // A2 * B2 鈫?CO1: 鎵ц涓€娆?Mmad 鐭╅樀涔樼疮鍔?A鐭╅樀澶у皬baseM * baseK,B鐭╅樀baseK * baseN
    // kBlockIdx: K 鏂瑰悜 baseK 鍧楃储寮曪紝鐢ㄤ簬鍒ゆ柇鏄惁棣栨绱姞
    // mBlockIdx/nBlockIdx: M/N 鏂瑰悜鍧楃储寮曪紝鐢ㄤ簬鍒ゆ柇灏惧潡瀹為檯灏哄
    __aicore__ inline void Compute(AscendC::LocalTensor<float> cLocal,
                                   AscendC::LocalTensor<half> a2Local, AscendC::LocalTensor<half> b2Local,
                                   uint32_t kBlockIdx, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // MTE1_M 姝ｅ悜鍚屾锛氱瓑寰?MTE1 瀹屾垚 L1 鈫?L0 鎼繍
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        // 灏惧潡浣跨敤 tailM/tailN锛屽惁鍒欎娇鐢?baseM/baseN
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::MmadParams mmadParams;
        mmadParams.m = curM;
        mmadParams.n = curN;
        mmadParams.k = baseK;
        mmadParams.cmatrixInitVal = (kBlockIdx == 0);
        mmadParams.unitFlag = (kBlockIdx != kLoopCount - 1) ? 2 : 3;    //寮€鍚疷nitFlag
        AscendC::Mmad(cLocal, a2Local, b2Local, mmadParams);
        // M_MTE1 鍙嶅悜鍚屾锛氶€氱煡涓嬩竴杞?DataLoad 鍙互瑕嗙洊 L0 缂撳啿鍖?
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag);
        mte1DBFlag ^= 1;
    }

    // CO1 鈫?GM: 灏嗚绠楃粨鏋滀粠 L0C 鍐欏洖 Global Memory
    // mBlockIdx/nBlockIdx: M/N 鏂瑰悜鍧楃储寮曪紝鐢ㄤ簬璁＄畻 GM 鍐欏叆鍋忕Щ鍙婂垽鏂熬鍧楀昂瀵?
    __aicore__ inline void CopyOut(AscendC::LocalTensor<float> cLocal, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // 灏惧潡浣跨敤瀵归綈鍚庣殑 tailMAlign 浣滀负 srcStride锛屼娇鐢?tailM/tailN 浣滀负瀹為檯琛屽垪鏁?
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = curN;
        fixpipeParams.mSize = curM;
        fixpipeParams.srcStride = curMAlign;
        fixpipeParams.dstStride = N;
        fixpipeParams.quantPre = QuantMode_t::F322F16;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        fixpipeParams.unitFlag = 3;
        AscendC::Fixpipe(cGM[mBlockIdx * baseM * N + nBlockIdx * baseN], cLocal, fixpipeParams);
    }

private:
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<half> cGM;
    AscendC::GlobalTensor<half> aGMOri;
    AscendC::GlobalTensor<half> bGMOri;
    AscendC::GlobalTensor<half> cGMOri;
    uint32_t actualSingleCoreM, actualSingleCoreN;
    uint32_t mLoopCount, nLoopCount, kLoopCount;
    uint32_t baseMCount, baseNCount;
    uint32_t tailM, tailN;
    uint32_t tailMAlign, tailNAlign;
    uint8_t mte1DBFlag = 0;
};

template <uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN,
          uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
          uint32_t stepKa, uint32_t stepKb>
__global__  __cube__ void mmad_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    KernelMmad<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN,
               stepKa, stepKb> op;
    op.Init(a, b, c);
    if constexpr (scenarioNum == 1) {
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        op.ProcessL2Cache();
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t M = 8192;
    constexpr uint32_t K = 8192;
    constexpr uint32_t N = 8192;
    constexpr uint32_t baseK = 64;
    constexpr uint32_t baseN = 256;
    constexpr uint32_t singleCoreK = 8192;
    constexpr uint32_t stepKb = 4;
    constexpr uint32_t singleCoreM = (scenarioNum == 1) ? 2048 : 1024;

#if (NPU_ARCH == 2201)
    constexpr uint32_t baseM = 128;
    constexpr uint32_t stepKa = 8;
    constexpr uint32_t singleCoreN = 1536;
    constexpr uint32_t numBlocks   = 24;
#elif (NPU_ARCH == 3510)
    constexpr uint32_t baseM = 256;
    constexpr uint32_t stepKa = 4;
    constexpr uint32_t singleCoreN = 1024;
    constexpr uint32_t numBlocks   = 32;
#endif
    size_t aFileSize = M * K * sizeof(int16_t);
    size_t bFileSize = K * N * sizeof(int16_t);
    size_t cFileSize = M * N * sizeof(int16_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_custom<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN,
                stepKa, stepKb>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
