/* !
 * \file mmad.asc
 * \brief matmul基础API最佳实践样例
 */

#include "acl/acl.h"          // 引入ACL运行时接口，用于Host侧设备、Stream和内存管理。
#include "kernel_operator.h"  // 引入Ascend C Kernel基础API、Tensor类型及流水同步接口。
#include "data_utils.h"       // 引入样例的二进制输入读取和输出写回工具。

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h" // CPU调试模式下引入Kernel模拟启动支持。
#endif

// 对a/b向上取整；加上b-1后再整除，可将不足一个分块的尾部计为一次循环。
__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

// half类型的Cube基本块在M、N和K方向均以16个元素为硬件对齐粒度。
constexpr uint32_t CUBE_BLOCK = 16;
// 一个16*16 Cube基本块包含256个元素，用于描述基础块容量。
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;
// L0A/L0B各有64KB，Pong从32KB处开始，使Ping和Pong分别占用前后半区。
constexpr uint32_t L0_PINGPONG_BYTES = 32 * 1024;
// L1共512KB，B1从256KB处开始，使A1和B1分别使用L1的前后半区。
constexpr uint32_t L1_PINGPONG_BYTES = 256 * 1024;
// 输入文件中的B按[N, K]转置格式存放，搬运时无需再把[K, N]转换为[N, K]。
constexpr bool IS_B_TRANSPOSE = true;
// 将CMake传入的场景编号转为编译期常量，以便if constexpr裁剪未使用的执行路径。
constexpr uint32_t scenarioNum = SCENARIO_NUM;

// M/K/N为完整矩阵维度，baseM/baseK/baseN为单次Cube基本计算块尺寸。
// singleCoreM/singleCoreK/singleCoreN限定每个核负责的矩阵范围。
// stepKa/stepKb表示A/B每个L1大包沿K方向包含的baseK块数。
template <
    uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN, uint32_t singleCoreM,
    uint32_t singleCoreK, uint32_t singleCoreN, uint32_t stepKa, uint32_t stepKb>
class KernelMmad {
public:
    // Kernel对象不持有Host资源，默认构造即可，运行参数由Init和计算参数初始化函数设置。
    __aicore__ inline KernelMmad() {}

    // 将Kernel入口传入的无类型GM地址绑定为half类型GlobalTensor，便于后续按元素寻址。
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
    {
        aGMOri.SetGlobalBuffer((__gm__ half*)a); // 绑定完整A矩阵的GM首地址，元素类型为half。
        bGMOri.SetGlobalBuffer((__gm__ half*)b); // 绑定完整B矩阵的GM首地址，元素类型为half。
        cGMOri.SetGlobalBuffer((__gm__ half*)c); // 绑定完整C矩阵的GM首地址，输出由float量化为half。
    }

    // Scenario 1入口：每个核只计算一个singleCoreM*singleCoreN子矩阵，不进行L2分轮。
    __aicore__ inline void Process()
    {
        InitComputeParams(); // 根据核索引确定当前核的GM子矩阵、循环次数和尾块尺寸。

        // ============================================================
        // 1. Buffer 分配：L1 / L0 双缓冲 Ping-Pong 布局
        // ============================================================
        // L1: A1 Ping/Pong (0~256KB), B1 Ping/Pong (256~512KB)
        // L0: A2/B2 Ping/Pong (0~32KB / 32KB~64KB)
        // A1每个缓冲区保存stepKa个[baseM, baseK]块，因此元素数为三者乘积。
        uint32_t a1PingpongSize = baseM * baseK * stepKa;
        // B1每个缓冲区保存stepKb个[baseK, baseN]块，因此元素数为三者乘积。
        uint32_t b1PingpongSize = baseK * baseN * stepKb;
        // A2每次只向Cube提供一个[baseM, baseK]基本块。
        uint32_t a2PingpongSize = baseM * baseK;
        // B2每次只向Cube提供一个[baseK, baseN]基本块。
        uint32_t b2PingpongSize = baseK * baseN;

        // A1: L1 Ping/Pong
        // A1 Ping从L1前半区的0字节开始，容量为一个A大包。
        AscendC::LocalTensor<half> a1LocalPing(AscendC::TPosition::A1, 0, a1PingpongSize);
        // A1 Pong紧随Ping之后，偏移需由元素数乘sizeof(half)换算为字节。
        AscendC::LocalTensor<half> a1LocalPong(AscendC::TPosition::A1, a1PingpongSize * sizeof(half), a1PingpongSize);
        // A2: L0 Ping/Pong
        // A2 Ping使用L0A前32KB区域，保存当前Cube计算所需的A基本块。
        AscendC::LocalTensor<half> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        // A2 Pong固定从32KB处开始，避免与Ping地址重叠并支持MTE1/Cube并行。
        AscendC::LocalTensor<half> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);

        // B1: L1 Ping/Pong
        // B1 Ping从L1后半区256KB处开始，避免覆盖位于前半区的A1数据。
        AscendC::LocalTensor<half> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1PingpongSize);
        // B1 Pong紧随B1 Ping，仍限制在L1后半区内。
        AscendC::LocalTensor<half> b1LocalPong(
            AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1PingpongSize * sizeof(half), b1PingpongSize);
        // B2: L0 Ping/Pong
        // B2 Ping使用L0B前32KB区域，保存当前Cube计算所需的B基本块。
        AscendC::LocalTensor<half> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        // B2 Pong固定从32KB处开始，与B2 Ping形成双缓冲。
        AscendC::LocalTensor<half> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);
        // CO1: L0C
        // L0C按float累加一个[baseM, baseN]结果块，避免half连续累加造成精度损失。
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        // 将全部Ping/Pong Tensor交给统一主循环，执行搬入、加载、计算和写回流水。
        ProcessLoop(
            a1LocalPing, a1LocalPong, a2LocalPing, a2LocalPong, b1LocalPing, b1LocalPong, b2LocalPing, b2LocalPong,
            cLocal);
    }

    // ============================================================
    // L2 Cache 优化：双重外层循环（M 维度 + N 维度分批）
    // ============================================================
    // Scenario 2入口：同一批核沿M方向执行两轮，使B数据更容易跨轮保留在共享L2 Cache中。
    __aicore__ inline void ProcessL2Cache()
    {
        // ---- Step 1: Buffer 分配：L1 / L0 双缓冲 Ping-Pong 布局
        uint32_t a1PingpongSize = baseM * baseK * stepKa; // A1每个Ping/Pong大包的half元素数。
        uint32_t b1PingpongSize = baseK * baseN * stepKb; // B1每个Ping/Pong大包的half元素数。
        uint32_t a2PingpongSize = baseM * baseK;          // A2单个Cube基本块的half元素数。
        uint32_t b2PingpongSize = baseK * baseN;          // B2单个Cube基本块的half元素数。

        // L2场景复用与Process相同的L1/L0地址布局，保证两种场景仅调度策略不同。
        AscendC::LocalTensor<half> a1LocalPing(AscendC::TPosition::A1, 0, a1PingpongSize);
        // Pong偏移为一个A1大包的字节数，确保与Ping首尾相接且不重叠。
        AscendC::LocalTensor<half> a1LocalPong(AscendC::TPosition::A1, a1PingpongSize * sizeof(half), a1PingpongSize);
        // A2 Ping从L0A首地址开始。
        AscendC::LocalTensor<half> a2LocalPing(AscendC::TPosition::A2, 0, a2PingpongSize);
        // A2 Pong从L0A的32KB分界处开始。
        AscendC::LocalTensor<half> a2LocalPong(AscendC::TPosition::A2, L0_PINGPONG_BYTES, a2PingpongSize);

        // B1 Ping从L1后半区开始，避免与A1共用地址。
        AscendC::LocalTensor<half> b1LocalPing(AscendC::TPosition::B1, L1_PINGPONG_BYTES, b1PingpongSize);
        // B1 Pong位于B1 Ping之后，偏移同时包含L1前半区和一个B1大包。
        AscendC::LocalTensor<half> b1LocalPong(
            AscendC::TPosition::B1, L1_PINGPONG_BYTES + b1PingpongSize * sizeof(half), b1PingpongSize);
        // B2 Ping使用L0B前半区。
        AscendC::LocalTensor<half> b2LocalPing(AscendC::TPosition::B2, 0, b2PingpongSize);
        // B2 Pong使用L0B后半区。
        AscendC::LocalTensor<half> b2LocalPong(AscendC::TPosition::B2, L0_PINGPONG_BYTES, b2PingpongSize);
        // 每次处理一个[baseM, baseN]输出块，L0C使用float保存累加结果。
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        // ---- Step 2: 计算分批参数 ----
        // mIterTotal/nIterTotal: M/N 方向总共需要多少个 singleCore 大小的子块
        // M除以singleCoreM并向上取整，得到覆盖完整M轴所需的子块总数。
        constexpr uint32_t mIterTotal = DivCeil(M, singleCoreM);
        // N除以singleCoreN并向上取整，得到覆盖完整N轴所需的子块总数。
        constexpr uint32_t nIterTotal = DivCeil(N, singleCoreN);
        // 每轮 numBlocks 核覆盖的 M 份数
        // L2场景计划沿M执行2轮，因此每轮只覆盖约一半M子块；向上取整兼容M不能均分的情况。
        constexpr uint32_t mIterPerRound = DivCeil(M, singleCoreM * 2);
        // 外层循环轮数
        // 用M子块总数除以每轮覆盖数，得到实际外层轮数；当前配置结果为2。
        constexpr uint32_t outerMLoopCount = DivCeil(mIterTotal, mIterPerRound);

        // ---- Step 3: outerMIdx/outerNIdx 外层循环 ----
        // 每轮复用同一组物理核处理下一批M子块，使各轮访问相同N分片对应的B数据。
        for (uint32_t outerMIdx = 0; outerMIdx < outerMLoopCount; outerMIdx++) {
            //   根据核索引 blockIdx 计算当前核在本轮负责的子块坐标
            //   mIterIdx = blockIdx 在 M 方向的偏移 + 本轮的 M 起始偏移
            //   nIterIdx = blockIdx 在 N 方向的偏移
            // 取模得到核在本轮M轴内的位置，再加轮次偏移得到全局M子块索引。
            uint32_t mIterIdx = AscendC::GetBlockIdx() % mIterPerRound + outerMIdx * mIterPerRound;
            // 整除mIterPerRound得到核负责的N分片，使相邻一组核覆盖同一N块的不同M块。
            uint32_t nIterIdx = AscendC::GetBlockIdx() / mIterPerRound;

            // 边界保护：当 M/N 不能被整除时，最后一轮部分核会超出子块范围，直接跳过
            // 向上取整可能产生无效核坐标，越界核必须跳过以防访问矩阵范围之外的GM。
            if (mIterIdx >= mIterTotal || nIterIdx >= nIterTotal)
                continue; // 当前核在本轮无有效子块，不执行任何搬运或计算。

            // 根据子块坐标计算 GM 偏移、循环次数、尾块参数等
            InitComputeParamsL2Cache(mIterIdx, nIterIdx); // 为当前轮重新绑定GM子矩阵并计算尾块参数。

            // 执行当前子块的完整 N/M/K 循环计算
            // 使用当前轮参数执行完整K归约及该核范围内的M/N基本块循环。
            ProcessLoop(
                a1LocalPing, a1LocalPong, a2LocalPing, a2LocalPong, b1LocalPing, b1LocalPong, b2LocalPing, b2LocalPong,
                cLocal);

            // 每轮外层循环后重置双缓冲 flag
            mte1DBFlag = 0; // 下一轮从L0 Ping开始，确保事件ID和缓冲区选择重新对应。
        }
    }

private:
    // N/M/K 主循环：执行当前核的完整计算
    __aicore__ inline void ProcessLoop(
        AscendC::LocalTensor<half>& a1LocalPing, AscendC::LocalTensor<half>& a1LocalPong,
        AscendC::LocalTensor<half>& a2LocalPing, AscendC::LocalTensor<half>& a2LocalPong,
        AscendC::LocalTensor<half>& b1LocalPing, AscendC::LocalTensor<half>& b1LocalPong,
        AscendC::LocalTensor<half>& b2LocalPing, AscendC::LocalTensor<half>& b2LocalPong,
        AscendC::LocalTensor<float>& cLocal)
    {
        // ============================================================
        // 1. DataCopyIn 进度跟踪变量
        // ============================================================
        uint32_t a1NextKChunkIdx = 0; // A下次从第0个baseK开始搬，之后每次增加stepKa。
        uint32_t b1NextKChunkIdx = 0; // B下次从第0个baseK开始搬，之后每次增加stepKb。
        uint8_t a1CopyInIdx = 0;      // A首次写Ping，0/1分别表示Ping/Pong。
        uint8_t b1CopyInIdx = 0;      // B首次写Ping，0/1分别表示Ping/Pong。

        // ============================================================
        // 2. 同步标志初始化：反向同步需预置，防止首次 WaitFlag 死锁
        // ============================================================
        // MTE1_MTE2 (反向): DataCopyIn 可覆盖通知
        //   EVENT_ID0: A1 Ping 可写 | EVENT_ID1: A1 Pong 可写
        //   EVENT_ID2: B1 Ping 可写 | EVENT_ID3: B1 Pong 可写
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0); // 初始允许MTE2写A1 Ping。
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1); // 初始允许MTE2写A1 Pong。
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2); // 初始允许MTE2写B1 Ping。
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3); // 初始允许MTE2写B1 Pong。
        // M_MTE1 (反向): L0 双缓冲，DataLoad 可覆盖通知
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0); // 初始允许MTE1写L0 Ping。
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1); // 初始允许MTE1写L0 Pong。

        // ============================================================
        // 3. N/M 外层循环 + K 主循环
        // ============================================================
        // 先遍历N块，使同一N块的B数据访问在时间上更集中，利于缓存局部性。
        for (uint32_t nBlockIdx = 0; nBlockIdx < nLoopCount; nBlockIdx++) {
            // 再遍历当前核范围内的M块，为每个[M块,N块]完成整个K轴归约。
            for (uint32_t mBlockIdx = 0; mBlockIdx < mLoopCount; mBlockIdx++) {
                // 每个 (mBlockIdx, nBlockIdx) 子块重置 DataCopyIn 进度
                a1NextKChunkIdx = 0; // 新输出块的K归约从A的K=0大包重新开始。
                b1NextKChunkIdx = 0; // 新输出块的K归约从B的K=0大包重新开始。
                a1CopyInIdx = 0;     // 新输出块先向A1 Ping预取首包。
                b1CopyInIdx = 0;     // 新输出块先向B1 Ping预取首包。

                // ---- 搬入 A1 Ping 和 B1 Ping 的首个大包 ----
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0); // A1 Ping 可写
                DataCopyInA(a1LocalPing, a1NextKChunkIdx, mBlockIdx); // 将A的首个K大包从GM搬入A1 Ping。
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0); // A1 Ping 数据就绪
                a1NextKChunkIdx += stepKa; // 首包包含stepKa个baseK，下一包从其后开始。
                a1CopyInIdx ^= 1; // 下次写 Pong

                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2); // B1 Ping 可写
                DataCopyInB(b1LocalPing, b1NextKChunkIdx, nBlockIdx); // 将B的首个K大包从GM搬入B1 Ping。
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2); // B1 Ping 数据就绪
                b1NextKChunkIdx += stepKb; // 首包包含stepKb个baseK，下一包从其后开始。
                b1CopyInIdx ^= 1; // 下次写 Pong

                // ---- K 方向主循环 ----
                // 遍历K轴全部baseK块，并把每次Mmad结果累加到同一个L0C输出块。
                for (uint32_t kBlockIdx = 0; kBlockIdx < kLoopCount; kBlockIdx++) {
                    // 确定当前 kBlockIdx 对应的 L1 读取缓冲区（Ping/Pong）
                    // 每stepKa个K块切换一次A大包，再模2得到当前读取Ping还是Pong。
                    uint32_t a1ReadIdx = (kBlockIdx / stepKa) % 2;
                    // 每stepKb个K块切换一次B大包，再模2得到当前读取Ping还是Pong。
                    uint32_t b1ReadIdx = (kBlockIdx / stepKb) % 2;
                    // 模stepKa得到当前A基本块在A1大包内部的序号，用于计算L1源偏移。
                    uint32_t kOffsetInChunkA = kBlockIdx % stepKa;
                    // 模stepKb得到当前B基本块在B1大包内部的序号，用于计算L1源偏移。
                    uint32_t kOffsetInChunkB = kBlockIdx % stepKb;

                    // 将A的0/1索引映射到实际Ping/Pong Tensor，后续DataLoad无需重复判断。
                    AscendC::LocalTensor<half> a1ReadBuf = (a1ReadIdx == 0) ? a1LocalPing : a1LocalPong;
                    // 将B的0/1索引映射到实际Ping/Pong Tensor。
                    AscendC::LocalTensor<half> b1ReadBuf = (b1ReadIdx == 0) ? b1LocalPing : b1LocalPong;
                    // A1 Ping/Pong固定使用事件0/1，事件号必须和缓冲区一一对应。
                    int32_t a1ReadEvent = (a1ReadIdx == 0) ? EVENT_ID0 : EVENT_ID1;
                    // B1 Ping/Pong固定使用事件2/3，避免与A1事件冲突。
                    int32_t b1ReadEvent = (b1ReadIdx == 0) ? EVENT_ID2 : EVENT_ID3;

                    // L0 双缓冲选择
                    // A2与B2必须使用同一Ping/Pong编号，保证一次Mmad读取配对的A/B基本块。
                    AscendC::LocalTensor<half> a2Local = (mte1DBFlag == 0) ? a2LocalPing : a2LocalPong;
                    AscendC::LocalTensor<half> b2Local = (mte1DBFlag == 0) ? b2LocalPing : b2LocalPong;

                    // ---- 反向同步：等待上一轮 Compute 释放 L0 缓冲区 ----
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag); // 防止MTE1覆盖Cube仍在读取的L0块。

                    // ---- 正向同步：等待 L1 大包数据就绪（仅大包中首元素需等待） ----
                    if (kOffsetInChunkA == 0) {
                        // 只有大包首块需要等待MTE2；同一大包后续块在首块就绪时已经全部搬入L1。
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(a1ReadEvent);
                    }
                    if (kOffsetInChunkB == 0) {
                        // B大包同理，仅首个baseK消费MTE2发出的数据就绪事件。
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(b1ReadEvent);
                    }

                    // ---- DataLoad: L1 → L0 ----
                    DataLoadA(a1ReadBuf, a2Local, mBlockIdx, kOffsetInChunkA); // 将当前A基本块从A1装入A2。
                    DataLoadB(b1ReadBuf, b2Local, nBlockIdx, kOffsetInChunkB); // 将当前B基本块从B1装入B2。

                    // ---- 反向同步：当前 L1 大包消费完毕，通知 DataCopyIn 可覆盖 ----
                    if ((kOffsetInChunkA + 1) == stepKa) {
                        // 当前索引为stepKa-1时A大包已全部送入L0，可允许MTE2覆盖该A1缓冲区。
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(a1ReadEvent);
                    }
                    if ((kOffsetInChunkB + 1) == stepKb) {
                        // 当前索引为stepKb-1时B大包已全部送入L0，可允许MTE2覆盖该B1缓冲区。
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(b1ReadEvent);
                    }

                    // ---- Compute: Mmad 矩阵乘累加 ----
                    // 对当前K块执行A2*B2并累加到cLocal；首个K块负责清零初始化L0C。
                    Compute(cLocal, a2Local, b2Local, kBlockIdx, mBlockIdx, nBlockIdx);

                    // ---- 搬入下一个 L1 大包，使 DataCopyIn 与 Compute 流水重叠 ----
                    // 触发条件：
                    //   (1) kBlockIdx == 0：首个 K 块计算时，A1/B1 Pong 尚未使用，可直接搬入
                    //   (2) 当前 L1 大包最后一个 baseK 被消费完，该缓冲区可被覆盖
                    if (((kBlockIdx == 0) || ((kOffsetInChunkB + 1) == stepKb)) && b1NextKChunkIdx < kLoopCount) {
                        // b1CopyInIdx指向下次可写缓冲区，0选择Ping，1选择Pong。
                        AscendC::LocalTensor<half> b1WriteBuf = (b1CopyInIdx == 0) ? b1LocalPing : b1LocalPong;
                        // B缓冲区使用事件2/3，与读取端的事件映射保持一致。
                        int32_t b1WriteEvent = (b1CopyInIdx == 0) ? EVENT_ID2 : EVENT_ID3;
                        // 等待MTE1确认旧B大包已经消费完，防止MTE2提前覆盖。
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(b1WriteEvent);
                        // 从b1NextKChunkIdx对应的K位置预取下一个B大包。
                        DataCopyInB(b1WriteBuf, b1NextKChunkIdx, nBlockIdx);
                        // MTE2发出正向事件，通知MTE1该B大包可以读取。
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(b1WriteEvent);
                        b1NextKChunkIdx += stepKb; // 下次B预取起点跳过本次搬入的stepKb个K块。
                        b1CopyInIdx ^= 1;          // 异或1在Ping和Pong之间切换下次写入目标。
                    }
                    if (((kBlockIdx == 0) || ((kOffsetInChunkA + 1) == stepKa)) && a1NextKChunkIdx < kLoopCount) {
                        // a1CopyInIdx指向下次可写A缓冲区，0选择Ping，1选择Pong。
                        AscendC::LocalTensor<half> a1WriteBuf = (a1CopyInIdx == 0) ? a1LocalPing : a1LocalPong;
                        // A缓冲区使用事件0/1，与读取端的事件映射保持一致。
                        int32_t a1WriteEvent = (a1CopyInIdx == 0) ? EVENT_ID0 : EVENT_ID1;
                        // 等待MTE1确认旧A大包已经消费完，防止MTE2提前覆盖。
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(a1WriteEvent);
                        // 从a1NextKChunkIdx对应的K位置预取下一个A大包。
                        DataCopyInA(a1WriteBuf, a1NextKChunkIdx, mBlockIdx);
                        // MTE2发出正向事件，通知MTE1该A大包可以读取。
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(a1WriteEvent);
                        a1NextKChunkIdx += stepKa; // 下次A预取起点跳过本次搬入的stepKa个K块。
                        a1CopyInIdx ^= 1;          // 异或1在Ping和Pong之间切换下次写入目标。
                    }
                }
                // ---- CopyOut: CO1 → GM ----
                // 完成当前[M块,N块]的全部K累加后，通过Fixpipe把L0C结果写回GM。
                CopyOut(cLocal, mBlockIdx, nBlockIdx);
            }
        }

        // ============================================================
        // 4. 等待所有同步完成
        // ============================================================
        // 消费L0 Ping/Pong的反向事件，确保最后两路Cube读取均已结束。
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);
        // 消费A1 Ping/Pong的反向事件，确保最后的A数据加载均已结束。
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        // 消费B1 Ping/Pong的反向事件，确保最后的B数据加载均已结束。
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
    }

    // 根据当前核索引初始化非L2分轮场景的GM视图、基本块循环次数和尾块参数。
    __aicore__ inline void InitComputeParams()
    {
        // ---- 1. 计算当前核在 M/N 方向的迭代索引，确定 GM 起始偏移 ----
        // M轴子块数决定一组连续核中有多少个核分别覆盖不同M区间。
        constexpr uint32_t mIter = DivCeil(M, singleCoreM);
        // 核索引对M子块数取模，得到当前核在M轴上的子块坐标。
        uint32_t mIterIdx = AscendC::GetBlockIdx() % mIter;
        // 核索引整除M子块数，得到当前核在N轴上的子块坐标。
        uint32_t nIterIdx = AscendC::GetBlockIdx() / mIter;

        // A按[M,K]行优先存放：跳过mIterIdx*singleCoreM行，每行包含K个元素。
        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        // B转置存储为[N,K]时跳过nIterIdx*singleCoreN行；非转置[K,N]时跳过N轴列偏移。
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        // C按[M,N]行优先存放：M轴行偏移加N轴列偏移得到当前输出子矩阵首元素。
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        aGM = aGMOri[gmOffsetA]; // 把A工作Tensor移动到当前核负责的M子块首地址。
        bGM = bGMOri[gmOffsetB]; // 把B工作Tensor移动到当前核负责的N子块首地址。
        cGM = cGMOri[gmOffsetC]; // 把C工作Tensor移动到当前核输出子块首地址。

        // ---- 2. 计算当前核实际的 M/N 维度大小（最后一块可能不满 singleCore） ----
        // 先计算从当前M起点到矩阵末尾的剩余行数。
        actualSingleCoreM = M - mIterIdx * singleCoreM;
        // 非尾块最多处理singleCoreM行，尾块则保留实际剩余行数。
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        // 先计算从当前N起点到矩阵末尾的剩余列数。
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        // 非尾块最多处理singleCoreN列，尾块则保留实际剩余列数。
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        // ---- 3. 计算 K/M/N 三个维度的循环次数 ----
        kLoopCount = DivCeil(singleCoreK, baseK);       // K轴按baseK分块，向上取整覆盖K尾块。
        mLoopCount = DivCeil(actualSingleCoreM, baseM); // 当前核M范围按baseM分块的循环次数。
        nLoopCount = DivCeil(actualSingleCoreN, baseN); // 当前核N范围按baseN分块的循环次数。

        // ---- 4. 计算 N 方向分块参数：完整 baseN 块数 + 尾块大小及对齐 ----
        baseNCount = actualSingleCoreN / baseN; // 整除结果表示完整baseN块数量，也作为尾块索引。
        tailN = actualSingleCoreN % baseN;      // 取余得到最后一个不足baseN块的有效列数。
        // LoadData要求16元素对齐，将尾块列数向上补齐到最近的Cube基本粒度。
        tailNAlign = DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;

        // ---- 5. 计算 M 方向分块参数：完整 baseM 块数 + 尾块大小及对齐 ----
        baseMCount = actualSingleCoreM / baseM; // 完整baseM块数量，同时用于识别M尾块索引。
        tailM = actualSingleCoreM % baseM;      // 取余得到最后一个不足baseM块的有效行数。
        // LoadData/Fixpipe源布局要求16元素对齐，将M尾块向上补齐到Cube粒度。
        tailMAlign = DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
    }

    // 根据子块索引设置当前子块的全部计算参数
    // mIterIdx: 当前核在 M 方向的子块索引
    // nIterIdx: 当前核在 N 方向的子块索引
    __aicore__ inline void InitComputeParamsL2Cache(uint32_t mIterIdx, uint32_t nIterIdx)
    {
        // ----  计算当前子块在 GM 中的起始偏移 ----
        // aGM/bGM/cGM 指向当前子块起始位置，后续 DataCopyIn/CopyOut 基于该偏移寻址
        // A按[M,K]行优先存储，M子块索引乘singleCoreM*K得到子矩阵首元素偏移。
        uint64_t gmOffsetA = mIterIdx * singleCoreM * K;
        // B转置时按[N,K]选N行，非转置时按[K,N]选择N列起点。
        uint64_t gmOffsetB = IS_B_TRANSPOSE ? nIterIdx * K * singleCoreN : nIterIdx * singleCoreN;
        // C按[M,N]行优先存储，行偏移与列偏移相加得到输出子矩阵首元素。
        uint64_t gmOffsetC = mIterIdx * singleCoreM * N + nIterIdx * singleCoreN;
        aGM = aGMOri[gmOffsetA]; // 本轮A工作Tensor指向对应M子块。
        bGM = bGMOri[gmOffsetB]; // 本轮B工作Tensor指向对应N子块。
        cGM = cGMOri[gmOffsetC]; // 本轮C工作Tensor指向对应[M,N]输出子块。

        actualSingleCoreM = M - mIterIdx * singleCoreM; // 计算当前M起点之后的剩余行数。
        // 完整块限制为singleCoreM，矩阵末尾不足时使用实际剩余行数。
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN; // 计算当前N起点之后的剩余列数。
        // 完整块限制为singleCoreN，矩阵末尾不足时使用实际剩余列数。
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        kLoopCount = DivCeil(singleCoreK, baseK);       // K轴归约所需的baseK块数。
        mLoopCount = DivCeil(actualSingleCoreM, baseM); // 当前M子块所需的baseM循环数。
        nLoopCount = DivCeil(actualSingleCoreN, baseN); // 当前N子块所需的baseN循环数。
        baseNCount = actualSingleCoreN / baseN;         // N轴完整块数，也用于定位N尾块。
        tailN = actualSingleCoreN % baseN;              // N轴尾块的实际有效列数。
        // 将N尾块向上对齐到16元素，满足Cube数据布局要求。
        tailNAlign = DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;

        baseMCount = actualSingleCoreM / baseM; // M轴完整块数，也用于定位M尾块。
        tailM = actualSingleCoreM % baseM;      // M轴尾块的实际有效行数。
        // 将M尾块向上对齐到16元素，满足Cube数据布局要求。
        tailMAlign = DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
    }

    // GM → A1: 将 A 矩阵的一个大包 (stepKa 个 baseK) 搬入 L1
    // kChunkIdx: K 方向大包索引，用于计算 GM 读取偏移
    // mBlockIdx: M 方向 baseM 块索引，用于计算 GM 读取偏移及判断尾块
    __aicore__ inline void DataCopyInA(AscendC::LocalTensor<half> a1Local, uint32_t kChunkIdx, uint32_t mBlockIdx)
    {
        // 尾块使用 tailM，否则使用 baseM
        // mBlockIdx等于完整块数时表示尾块，使用tailM；否则搬入完整baseM行。
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        AscendC::Nd2NzParams nd2nzParams; // 配置A从GM的ND布局搬为L1的NZ布局。
        nd2nzParams.ndNum = 1;            // 本次只搬运一个二维矩阵块。
        nd2nzParams.nValue = curM;        // ND源块行数等于当前M块的实际行数。
        // 每个A大包沿K覆盖stepKa个baseK，因此有效列数为baseK*stepKa。
        nd2nzParams.dValue = baseK * stepKa;
        nd2nzParams.srcNdMatrixStride = 0; // ndNum为1，不存在相邻源矩阵，矩阵间隔设0。
        nd2nzParams.srcDValue = K;         // A在GM中的原始行跨度是完整K维长度。
        nd2nzParams.dstNzC0Stride = baseM; // NZ的C0块跨行按baseM布局，匹配后续LoadData读取。
        nd2nzParams.dstNzNStride = 1;      // 相邻NZ N块连续存放，不额外留空。
        nd2nzParams.dstNzMatrixStride = 0; // 只有一个目标矩阵，矩阵间隔设0。
        // K偏移为kChunkIdx*baseK，M偏移为mBlockIdx*baseM行再乘每行K个元素。
        AscendC::DataCopy(a1Local, aGM[kChunkIdx * baseK + mBlockIdx * K * baseM], nd2nzParams);
    }

    // GM → B1: 将 B 矩阵的一个大包 (stepKb 个 baseK) 搬入 L1
    // kChunkIdx: K 方向大包索引，用于计算 GM 读取偏移
    // nBlockIdx: N 方向 baseN 块索引，用于计算 GM 读取偏移及判断尾块
    __aicore__ inline void DataCopyInB(AscendC::LocalTensor<half> b1Local, uint32_t kChunkIdx, uint32_t nBlockIdx)
    {
        // 尾块使用 tailN，否则使用 baseN
        // nBlockIdx等于完整块数时表示尾块，使用tailN；否则搬入完整baseN列。
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::Nd2NzParams nd2nzParams; // 配置B从GM的ND布局搬为L1的NZ布局。
        if constexpr (!IS_B_TRANSPOSE) {
            // B 非转置
            nd2nzParams.ndNum = 1;                 // 本次只搬运一个B二维大包。
            nd2nzParams.nValue = baseK * stepKb;   // 非转置B大包包含stepKb*baseK行。
            nd2nzParams.dValue = curN;             // 每行只取当前N块的有效列数。
            nd2nzParams.srcNdMatrixStride = 0;     // ndNum为1，源矩阵间隔无效。
            nd2nzParams.srcDValue = N;             // 非转置B在GM中每行跨度为完整N维。
            nd2nzParams.dstNzC0Stride = baseK * stepKb; // NZ C0跨度覆盖整个K大包高度。
            nd2nzParams.dstNzNStride = 1;          // 相邻NZ块连续排列。
            nd2nzParams.dstNzMatrixStride = 0;     // 只有一个目标矩阵，矩阵间隔设0。
            // K行偏移乘N定位大包起始行，再加nBlockIdx*baseN定位N列起点。
            AscendC::DataCopy(b1Local, bGM[kChunkIdx * baseK * N + nBlockIdx * baseN], nd2nzParams);
        } else {
            // B 转置
            nd2nzParams.ndNum = 1;                 // 本次只搬运一个B二维大包。
            nd2nzParams.nValue = curN;             // 转置B按[N,K]存储，源块行数为当前N块列数。
            nd2nzParams.dValue = baseK * stepKb;   // 每行沿K搬入stepKb个baseK。
            nd2nzParams.srcNdMatrixStride = 0;     // ndNum为1，源矩阵间隔无效。
            nd2nzParams.srcDValue = K;             // 转置B每行跨度为完整K维。
            nd2nzParams.dstNzC0Stride = baseN;     // NZ C0跨度按完整baseN预留，尾块也保持统一布局。
            nd2nzParams.dstNzNStride = 1;          // 相邻NZ块连续排列。
            nd2nzParams.dstNzMatrixStride = 0;     // 只有一个目标矩阵，矩阵间隔设0。
            // K列偏移为kChunkIdx*baseK，N行偏移为nBlockIdx*baseN*K。
            AscendC::DataCopy(b1Local, bGM[kChunkIdx * baseK + nBlockIdx * baseN * K], nd2nzParams);
        }
    }

    // A1 → A2: 将 L1 中的一个 baseM * baseK 切片搬入 L0
    // mBlockIdx: M 方向 baseM 块索引，用于判断尾块对齐
    // kOffsetInChunkA: 当前 base块 在大包内的偏移序号 (0 ~ stepKa-1)
    __aicore__ inline void DataLoadA(
        AscendC::LocalTensor<half> a1Local, AscendC::LocalTensor<half> a2Local, uint32_t mBlockIdx,
        uint32_t kOffsetInChunkA)
    {
        // A1大包内每个基本块占baseM*baseK元素，乘大包内序号得到当前块源偏移。
        uint32_t srcAddr = kOffsetInChunkA * baseK * baseM;
        // 尾块使用对齐后的 tailMAlign，保证 LoadData 地址对齐
        // 完整块直接使用baseM，尾块使用向上对齐后的tailMAlign满足Cube装载粒度。
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        // A2/A3使用LoadData3D一次描述完整A基本块，减少MTE1指令条数。
        AscendC::LoadData3DParamsV2<half> loadDataParams;
        loadDataParams.l1H = 1;              // 将A1视为高度为1的特征图。
        loadDataParams.l1W = baseM;          // 特征图宽度对应A块的M维跨度。
        loadDataParams.channelSize = baseK;  // 通道数对应A块的K维长度。
        loadDataParams.kExtension = baseK;   // 本次沿K方向装载完整baseK。
        loadDataParams.mExtension = curMAlign; // 本次沿M方向装载对齐后的实际行数。
        loadDataParams.mStartPt = 0;         // srcAddr已定位当前块，M方向从块内0开始。
        loadDataParams.kStartPt = 0;         // srcAddr已定位当前块，K方向从块内0开始。
        // 把当前A1基本块从L1装入选中的A2 Ping/Pong缓冲区。
        AscendC::LoadData(a2Local, a1Local[srcAddr], loadDataParams);
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        // Ascend 950PR/DT使用LoadData2D V2一次装载完整A基本块。
        AscendC::LoadData2DParamsV2 loadDataParams;
        loadDataParams.mStartPosition = 0; // srcAddr已定位当前块，M方向从0开始。
        loadDataParams.kStartPosition = 0; // srcAddr已定位当前块，K方向从0开始。
        // mStep以16元素Cube块为单位，向上取整覆盖对齐后的M范围。
        loadDataParams.mStep = DivCeil(curMAlign, CUBE_BLOCK);
        // kStep同样以16元素为单位，baseK/16得到K方向装载步数。
        loadDataParams.kStep = DivCeil(baseK, CUBE_BLOCK);
        // A1每个K切片按baseM跨度排列，换算为16元素块作为源步长。
        loadDataParams.srcStride = DivCeil(baseM, CUBE_BLOCK);
        // A2按当前实际M对齐长度紧凑排列，换算为16元素块作为目标步长。
        loadDataParams.dstStride = DivCeil(curMAlign, CUBE_BLOCK);
        loadDataParams.sid = 0;              // 本样例不区分多路SID，使用默认通道0。
        loadDataParams.ifTranspose = false;  // A保持[M,K]计算布局，不执行转置。
        // 把当前A1基本块从L1装入选中的A2 Ping/Pong缓冲区。
        AscendC::LoadData(a2Local, a1Local[srcAddr], loadDataParams);
#endif
    }

    // B1 → B2: 将 L1 中的一个 baseK * baseN 切片搬入 L0
    // nBlockIdx: N 方向 baseN 块索引，用于判断尾块对齐
    // kOffsetInChunkB: 当前 base块 在大包内的偏移序号 (0 ~ stepKb-1)
    __aicore__ inline void DataLoadB(
        AscendC::LocalTensor<half> b1Local, AscendC::LocalTensor<half> b2Local, uint32_t nBlockIdx,
        uint32_t kOffsetInChunkB)
    {
        // 转置B每个K块在B1占baseK*baseN元素；非转置NZ布局按baseK*C0(16)计算块间偏移。
        uint32_t srcAddr = kOffsetInChunkB * baseK * (IS_B_TRANSPOSE ? baseN : CUBE_BLOCK);
        // 尾块使用对齐后的 tailNAlign，保证 LoadData 地址对齐
        // 完整块使用baseN，尾块向上对齐到16元素，满足L0B和Cube输入布局要求。
        uint32_t curNAlign = (nBlockIdx != baseNCount) ? baseN : tailNAlign;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        if constexpr (!IS_B_TRANSPOSE) {
            // B 非转置: 使用 LoadData（卷积数据搬运）v2 完成 [K, N] → [N, K] 转置搬运
            AscendC::LoadData3DParamsV2<half> loadDataParams; // 用3D装载同时完成B转置。
            loadDataParams.l1H = 1;                  // 将B1大包视为高度为1的特征图。
            loadDataParams.l1W = baseK * stepKb;     // 宽度覆盖大包中全部K元素。
            loadDataParams.channelSize = baseN;      // 通道维对应B块的N方向跨度。
            loadDataParams.kExtension = curNAlign;   // 输出K扩展映射到对齐后的N维。
            loadDataParams.mExtension = baseK;       // 输出M扩展覆盖当前baseK。
            // 在包含stepKb个K块的大包内，选择第kOffsetInChunkB个baseK起点。
            loadDataParams.mStartPt = kOffsetInChunkB * baseK;
            loadDataParams.kStartPt = 0;             // N方向从当前块首列开始。
            loadDataParams.strideW = 1;              // 宽方向连续取数，不跳元素。
            loadDataParams.strideH = 1;              // 高度只有1，保持默认连续步长。
            loadDataParams.filterW = 1;              // 1*1过滤窗口不聚合相邻元素。
            loadDataParams.filterH = 1;              // 1*1过滤窗口不跨高度取数。
            loadDataParams.dilationFilterW = 1;      // 宽方向不做空洞扩张。
            loadDataParams.dilationFilterH = 1;      // 高方向不做空洞扩张。
            loadDataParams.filterSizeW = false;      // 不启用额外宽方向过滤尺寸控制。
            loadDataParams.filterSizeH = false;      // 不启用额外高方向过滤尺寸控制。
            loadDataParams.enTranspose = true;       // 将GM中的[K,N]布局转换为Cube需要的[N,K]布局。
            loadDataParams.fMatrixCtrl = false;      // 本样例不使用Feature Map边界填充控制。
            // 一条LoadData将当前B基本块转置并装入B2。
            AscendC::LoadData(b2Local, b1Local, loadDataParams);
        } else {
            // B 转置: 按 CUBE_BLOCK 粒度逐块搬入 L0，无需转置
            AscendC::LoadData2DParams loadDataParams; // B已转置，使用普通2D块搬运。
            // L0B中相邻K方向16行块相隔curNAlign*16个元素。
            uint32_t dstOffset = curNAlign * CUBE_BLOCK;
            // B1按完整baseN布局，相邻K方向16行块相隔baseN*16个元素。
            uint32_t srcOffset = baseN * CUBE_BLOCK;
            // 每次重复搬入N方向一个16元素块，向上取整覆盖N尾块。
            loadDataParams.repeatTimes = DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.srcStride = 1;      // B1中的相邻16*16块连续读取。
            loadDataParams.dstGap = 0;         // B2中的重复块紧密写入，不留间隔。
            loadDataParams.ifTranspose = false; // B已按[N,K]存储，无需硬件转置。
            // baseK每16行为一组，需要循环baseK/16次覆盖完整K维。
            for (int i = 0; i < DivCeil(baseK, CUBE_BLOCK); ++i) {
                // i分别移动到B2和B1的第i个K方向16行块，发射一次2D装载。
                AscendC::LoadData(b2Local[i * dstOffset], b1Local[srcAddr + i * srcOffset], loadDataParams);
            }
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        if constexpr (!IS_B_TRANSPOSE) {
            // B 非转置: 使用 LoadData2D V2 完成 [K, N] → [N, K] 转置搬运
            AscendC::LoadData2DParamsV2 loadDataParams; // V2接口可用一条指令描述完整转置块。
            loadDataParams.mStartPosition = 0;          // srcAddr已定位当前K块，M方向从0开始。
            loadDataParams.kStartPosition = 0;          // 当前N块从块内0位置开始。
            // M方向对应baseK，以16元素Cube粒度换算装载步数。
            loadDataParams.mStep = DivCeil(baseK, CUBE_BLOCK);
            // 转置路径的kStep以32字节为单位，N元素数乘half字节数后向上取整。
            loadDataParams.kStep = DivCeil(curNAlign * sizeof(half), 32);
            // B1大包沿K包含stepKb个baseK，源跨度换算为16元素块。
            loadDataParams.srcStride = DivCeil(baseK * stepKb, CUBE_BLOCK);
            // B2目标布局按对齐后的N维排列，目标跨度换算为16元素块。
            loadDataParams.dstStride = DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.ifTranspose = true; // 把非转置[K,N]输入转为Cube需要的[N,K]布局。
            // 从当前B1基本块装入B2并在搬运过程中完成转置。
            AscendC::LoadData(b2Local, b1Local[srcAddr], loadDataParams);
        } else {
            // B 转置: 无需转置，直接按块搬运
            AscendC::LoadData2DParamsV2 loadDataParams; // B已为[N,K]布局，直接执行2D装载。
            loadDataParams.mStartPosition = 0;          // N方向从当前基本块首行开始。
            loadDataParams.kStartPosition = 0;          // K方向从当前基本块首列开始。
            // M步数对应对齐后的N维，以16元素Cube块为单位。
            loadDataParams.mStep = DivCeil(curNAlign, CUBE_BLOCK);
            // K步数以32字节为单位，baseK个half换算成字节后向上取整。
            loadDataParams.kStep = DivCeil(baseK * sizeof(half), 32);
            // B1始终按完整baseN预留每个K切片的跨度，换算为16元素块。
            loadDataParams.srcStride = DivCeil(baseN, CUBE_BLOCK);
            // B2按当前对齐N长度紧凑排列，换算为16元素块。
            loadDataParams.dstStride = DivCeil(curNAlign, CUBE_BLOCK);
            loadDataParams.ifTranspose = false; // 输入已经转置，不执行重复转置。
            // 把当前B1基本块直接装入选中的B2 Ping/Pong缓冲区。
            AscendC::LoadData(b2Local, b1Local[srcAddr], loadDataParams);
        }
#endif
    }

    // A2 * B2 → CO1: 执行一次 Mmad 矩阵乘累加,A矩阵大小baseM * baseK,B矩阵baseK * baseN
    // kBlockIdx: K 方向 baseK 块索引，用于判断是否首次累加
    // mBlockIdx/nBlockIdx: M/N 方向块索引，用于判断尾块实际尺寸
    __aicore__ inline void Compute(
        AscendC::LocalTensor<float> cLocal, AscendC::LocalTensor<half> a2Local, AscendC::LocalTensor<half> b2Local,
        uint32_t kBlockIdx, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // MTE1完成A2/B2装载后向Cube流水发送当前Ping/Pong数据就绪事件。
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        // Cube消费该事件后才能读取L0，避免Mmad读取尚未完成的数据。
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(mte1DBFlag);
        // 完整M块计算baseM行，尾块只计算tailM个有效行。
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        // 完整N块计算baseN列，尾块只计算tailN个有效列。
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::MmadParams mmadParams; // 配置本次Cube矩阵乘累加的实际M/N/K尺寸。
        mmadParams.m = curM; // M维使用当前块实际有效行数。
        mmadParams.n = curN; // N维使用当前块实际有效列数。
        mmadParams.k = baseK; // 每轮只归约一个baseK宽度，跨轮累加完成完整K。
        // 第0个K块先初始化L0C，后续K块保留原值并继续累加。
        mmadParams.cmatrixInitVal = (kBlockIdx == 0);
        // 中间K块用2保持UnitFlag流水，最后K块用3通知Fixpipe结果已完整。
        mmadParams.unitFlag = (kBlockIdx != kLoopCount - 1) ? 2 : 3;
        // 执行[curM,baseK]*[baseK,curN]并把float累加结果写入cLocal。
        AscendC::Mmad(cLocal, a2Local, b2Local, mmadParams);
        // M_MTE1 反向同步：通知下一轮 DataLoad 可以覆盖 L0 缓冲区
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(mte1DBFlag); // Cube释放当前L0缓冲区供MTE1复用。
        mte1DBFlag ^= 1; // 异或1切换下一轮使用的L0 Ping/Pong及配套事件ID。
    }

    // CO1 → GM: 将计算结果从 L0C 写回 Global Memory
    // mBlockIdx/nBlockIdx: M/N 方向块索引，用于计算 GM 写入偏移及判断尾块尺寸
    __aicore__ inline void CopyOut(AscendC::LocalTensor<float> cLocal, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // L0C源布局按M对齐长度排列，尾块使用tailMAlign而非有效tailM。
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
        // Fixpipe只写回有效M行，避免把尾块填充数据写入GM。
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        // Fixpipe只写回有效N列，避免覆盖相邻输出区域。
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::FixpipeParamsV220 fixpipeParams; // 配置L0C到GM的布局转换和量化参数。
        fixpipeParams.nSize = curN;               // 写回当前输出块的有效列数。
        fixpipeParams.mSize = curM;               // 写回当前输出块的有效行数。
        fixpipeParams.srcStride = curMAlign;       // L0C源块行跨度使用对齐后的M长度。
        fixpipeParams.dstStride = N;               // GM中的C每行跨度为完整矩阵N。
        fixpipeParams.quantPre = QuantMode_t::F322F16; // 将L0C float累加结果转换为输出half。
        fixpipeParams.ndNum = 1;                   // 本次只写回一个二维结果块。
        fixpipeParams.srcNdStride = 0;             // 单个源矩阵无需矩阵间跨度。
        fixpipeParams.dstNdStride = 0;             // 单个目标矩阵无需矩阵间跨度。
        fixpipeParams.unitFlag = 3;                // 消费Mmad最后K块发出的完整结果UnitFlag。
        // M块行偏移为mBlockIdx*baseM*N，N块列偏移为nBlockIdx*baseN。
        AscendC::Fixpipe(cGM[mBlockIdx * baseM * N + nBlockIdx * baseN], cLocal, fixpipeParams);
    }

private:
    AscendC::GlobalTensor<half> aGM;    // 当前核、当前轮使用的A子矩阵视图。
    AscendC::GlobalTensor<half> bGM;    // 当前核、当前轮使用的B子矩阵视图。
    AscendC::GlobalTensor<half> cGM;    // 当前核、当前轮写入的C子矩阵视图。
    AscendC::GlobalTensor<half> aGMOri; // 完整A矩阵首地址，重新分轮时以此为偏移基准。
    AscendC::GlobalTensor<half> bGMOri; // 完整B矩阵首地址，重新分轮时以此为偏移基准。
    AscendC::GlobalTensor<half> cGMOri; // 完整C矩阵首地址，重新分轮时以此为偏移基准。
    uint32_t actualSingleCoreM, actualSingleCoreN; // 当前子块在M/N方向的实际有效尺寸。
    uint32_t mLoopCount, nLoopCount, kLoopCount;   // M/N/K三个维度的基本块循环次数。
    uint32_t baseMCount, baseNCount;               // M/N方向完整基本块数量。
    uint32_t tailM, tailN;                         // M/N方向尾块的实际有效元素数。
    uint32_t tailMAlign, tailNAlign;               // M/N尾块向上对齐到16后的尺寸。
    uint8_t mte1DBFlag = 0;                        // L0 Ping/Pong选择和事件ID，初始从Ping开始。
};

template <
    uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN, uint32_t singleCoreM,
    uint32_t singleCoreK, uint32_t singleCoreN, uint32_t stepKa, uint32_t stepKb>
// Cube Kernel入口；矩阵维度和Tiling参数均为编译期常量，便于编译器常量展开。
__global__ __cube__ void mmad_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState(); // 初始化当前AI Core的SoC状态，使用基础API前必须调用。
    // 用模板参数实例化当前架构和场景对应的Matmul执行对象。
    KernelMmad<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN, stepKa, stepKb> op;
    op.Init(a, b, c); // 把三个Kernel GM参数绑定到GlobalTensor。
    if constexpr (scenarioNum == 1) {
        op.Process(); // Scenario 1采用单轮多核切分，不执行L2分轮调度。
    } else if constexpr (scenarioNum == 2) {
        op.ProcessL2Cache(); // Scenario 2沿M分两轮计算，提高B数据的L2复用机会。
    }
    AscendC::PipeBarrier<PIPE_ALL>(); // Kernel退出前等待所有计算和搬运流水完成。
}

// Host入口负责准备输入、启动Kernel、保存输出并释放ACL资源。
int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 8192; // A和C的行数，固定为8192。
    constexpr uint32_t K = 8192; // A列数/B列数，也是矩阵乘的归约维度。
    constexpr uint32_t N = 8192; // B和C的输出列数，固定为8192。
    constexpr uint32_t baseK = 64; // 每次Mmad沿K归约64个元素，兼顾L0容量和Cube粒度。
    constexpr uint32_t baseN = 256; // 每个输出基本块覆盖256列，使B2单块容量适配L0B。
    constexpr uint32_t singleCoreK = 8192; // 每个核遍历完整K轴才能得到完整输出子块。
    constexpr uint32_t stepKb = 4; // B1每个大包包含4个baseK，减少GM到L1指令次数。
    // Scenario 1一轮覆盖M轴，每核处理2048行；Scenario 2分两轮，每轮每核处理1024行。
    constexpr uint32_t singleCoreM = (scenarioNum == 1) ? 2048 : 1024;

#if (NPU_ARCH == 2201)
    constexpr uint32_t baseM = 128; // A2/A3架构每个A基本块选128行以适配L0A容量。
    constexpr uint32_t stepKa = 8; // 8*[128,64]个half为128KB，适配A1单个Ping/Pong区。
    constexpr uint32_t singleCoreN = 1536; // N轴切分后配合M轴子块使用24个Cube核。
    constexpr uint32_t numBlocks = 24; // A2/A3场景启动24个Cube核并行执行。
#elif (NPU_ARCH == 3510)
    constexpr uint32_t baseM = 256; // Ascend 950增大M块以提高Cube计算粒度。
    constexpr uint32_t stepKa = 4; // 4*[256,64]个half仍为128KB，保持A1容量不变。
    constexpr uint32_t singleCoreN = 1024; // N轴分成8份，与M轴4份组合为32个子块。
    constexpr uint32_t numBlocks = 32; // Ascend 950场景启动32个Cube核。
#endif
    // A包含M*K个half；int16_t与half同为2字节，可用于计算所需字节数。
    size_t aFileSize = M * K * sizeof(int16_t);
    // B即使按转置布局保存，仍包含K*N个half，所需字节数不变。
    size_t bFileSize = K * N * sizeof(int16_t);
    // C包含M*N个half，Fixpipe会把float累加结果转换为该格式。
    size_t cFileSize = M * N * sizeof(int16_t);

    aclInit(nullptr); // 使用默认配置初始化ACL运行时。
    int32_t deviceId = 0; // 本样例固定使用编号0的NPU设备。
    aclrtSetDevice(deviceId); // 将当前Host线程绑定到设备0。
    aclrtStream stream = nullptr; // 先置空Stream句柄，供运行时写入有效对象。
    aclrtCreateStream(&stream); // 创建Kernel异步执行流。

    uint8_t* aHost; // Host侧A输入的页锁定内存指针。
    uint8_t* aDevice; // Device侧A矩阵GM指针。
    aclrtMallocHost((void**)(&aHost), aFileSize); // 分配A对应的页锁定Host内存以提高H2D效率。
    // 优先申请大页Device内存，减少大矩阵地址映射开销。
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize); // 把A输入完整读入Host缓冲区。
    // 将A的M*K个half从Host同步复制到Device GM。
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost; // Host侧B输入的页锁定内存指针。
    uint8_t* bDevice; // Device侧B矩阵GM指针。
    aclrtMallocHost((void**)(&bHost), bFileSize); // 为B输入分配页锁定Host内存。
    // 为B矩阵申请K*N个half大小的大页优先Device内存。
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize); // 读取按[N,K]保存的B输入。
    // 将B的全部数据从Host同步复制到Device GM。
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost; // Host侧接收C结果的页锁定内存指针。
    uint8_t* cDevice; // Device侧保存C输出矩阵的GM指针。
    aclrtMallocHost((void**)(&cHost), cFileSize); // 分配M*N个half大小的Host输出缓冲区。
    // 分配同等大小的Device输出空间，Kernel将覆盖全部有效元素，无需预初始化。
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 模板实参将Tiling固化到Kernel；启动numBlocks个Cube核且不申请动态共享内存。
    mmad_custom<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN, stepKa, stepKb>
        <<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream); // 等待Kernel及其全部流水完成，确保C结果可以读取。

    // 将Device上的M*N个half结果同步复制回Host输出缓冲区。
    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize); // 保存C结果供精度校验脚本读取。

    aclrtFree(aDevice); // 释放A的Device GM空间。
    aclrtFreeHost(aHost); // 释放A的页锁定Host缓冲区。
    aclrtFree(bDevice); // 释放B的Device GM空间。
    aclrtFreeHost(bHost); // 释放B的页锁定Host缓冲区。
    aclrtFree(cDevice); // 释放C的Device GM空间。
    aclrtFreeHost(cHost); // 释放C的页锁定Host缓冲区。

    aclrtDestroyStream(stream); // 销毁已经完成任务的执行流。
    aclrtResetDevice(deviceId); // 复位设备0并释放当前进程占用的设备资源。
    aclFinalize(); // 反初始化ACL运行时，完成Host侧收尾。
    return 0; // 返回0表示样例执行成功。
}
