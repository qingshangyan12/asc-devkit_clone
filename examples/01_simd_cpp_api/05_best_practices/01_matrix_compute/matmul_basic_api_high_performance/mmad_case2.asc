/* !
 * \file     mmad_case2.asc
 * \brief    Matmul基础API高性能实践Case 2：多核基础切分
 *
 * 实现内容：保持M=N=K=8192和Case 1的base块，dav-2201使用24核按2x12切分，
 * dav-3510与高阶API对应，使用32核按2x16切分。
 * 本Case不引入切分对齐优化、Double Buffer、大包搬运、L2Cache或UnitFlag优化。
 * 仅要求在dav-2201和dav-3510两种架构下编译通过；禁止运行样例，不做计算结果验证。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t L1_B_OFFSET_BYTES = 256 * 1024;
constexpr bool IS_B_TRANSPOSE = true;

template <
    uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN, uint32_t singleCoreM,
    uint32_t singleCoreK, uint32_t singleCoreN>
class KernelMmad {
public:
    __aicore__ inline KernelMmad() {}

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
    {
        aGMOri.SetGlobalBuffer((__gm__ half*)a);
        bGMOri.SetGlobalBuffer((__gm__ half*)b);
        cGMOri.SetGlobalBuffer((__gm__ half*)c);
    }

    __aicore__ inline void Process()
    {
        InitComputeParams();

        AscendC::LocalTensor<half> a1Local(AscendC::TPosition::A1, 0, baseM * baseK);
        AscendC::LocalTensor<half> b1Local(AscendC::TPosition::B1, L1_B_OFFSET_BYTES, baseK * baseN);
        AscendC::LocalTensor<half> a2Local(AscendC::TPosition::A2, 0, baseM * baseK);
        AscendC::LocalTensor<half> b2Local(AscendC::TPosition::B2, 0, baseK * baseN);
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

        for (uint32_t nBlockIdx = 0; nBlockIdx < nLoopCount; nBlockIdx++) {
            for (uint32_t mBlockIdx = 0; mBlockIdx < mLoopCount; mBlockIdx++) {
                for (uint32_t kBlockIdx = 0; kBlockIdx < kLoopCount; kBlockIdx++) {
                    DataCopyInA(a1Local, kBlockIdx, mBlockIdx);
                    DataCopyInB(b1Local, kBlockIdx, nBlockIdx);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

                    DataLoadA(a1Local, a2Local, mBlockIdx);
                    DataLoadB(b1Local, b2Local, nBlockIdx);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                    Compute(cLocal, a2Local, b2Local, kBlockIdx, mBlockIdx, nBlockIdx);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
                }
                CopyOut(cLocal, mBlockIdx, nBlockIdx);
            }
        }
    }

private:
    __aicore__ inline void InitComputeParams()
    {
        constexpr uint32_t mIter = DivCeil(M, singleCoreM);
        uint32_t mIterIdx = AscendC::GetBlockIdx() % mIter;
        uint32_t nIterIdx = AscendC::GetBlockIdx() / mIter;

        aGM = aGMOri[mIterIdx * singleCoreM * K];
        bGM = bGMOri[nIterIdx * K * singleCoreN];
        cGM = cGMOri[mIterIdx * singleCoreM * N + nIterIdx * singleCoreN];

        actualSingleCoreM = M - mIterIdx * singleCoreM;
        actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
        actualSingleCoreN = N - nIterIdx * singleCoreN;
        actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

        kLoopCount = DivCeil(singleCoreK, baseK);
        mLoopCount = DivCeil(actualSingleCoreM, baseM);
        nLoopCount = DivCeil(actualSingleCoreN, baseN);

        baseMCount = actualSingleCoreM / baseM;
        tailM = actualSingleCoreM % baseM;
        tailMAlign = DivCeil(tailM, CUBE_BLOCK) * CUBE_BLOCK;
        baseNCount = actualSingleCoreN / baseN;
        tailN = actualSingleCoreN % baseN;
        tailNAlign = DivCeil(tailN, CUBE_BLOCK) * CUBE_BLOCK;
    }

    __aicore__ inline void DataCopyInA(
        AscendC::LocalTensor<half> a1Local, uint32_t kBlockIdx, uint32_t mBlockIdx)
    {
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        AscendC::Nd2NzParams params;
        params.ndNum = 1;
        params.nValue = curM;
        params.dValue = baseK;
        params.srcNdMatrixStride = 0;
        params.srcDValue = K;
        params.dstNzC0Stride = baseM;
        params.dstNzNStride = 1;
        params.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kBlockIdx * baseK + mBlockIdx * K * baseM], params);
    }

    __aicore__ inline void DataCopyInB(
        AscendC::LocalTensor<half> b1Local, uint32_t kBlockIdx, uint32_t nBlockIdx)
    {
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::Nd2NzParams params;
        params.ndNum = 1;
        params.nValue = curN;
        params.dValue = baseK;
        params.srcNdMatrixStride = 0;
        params.srcDValue = K;
        params.dstNzC0Stride = baseN;
        params.dstNzNStride = 1;
        params.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1Local, bGM[kBlockIdx * baseK + nBlockIdx * baseN * K], params);
    }

    __aicore__ inline void DataLoadA(
        AscendC::LocalTensor<half> a1Local, AscendC::LocalTensor<half> a2Local, uint32_t mBlockIdx)
    {
        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        AscendC::LoadData3DParamsV2<half> params;
        params.l1H = 1;
        params.l1W = baseM;
        params.channelSize = baseK;
        params.kExtension = baseK;
        params.mExtension = curMAlign;
        params.mStartPt = 0;
        params.kStartPt = 0;
        AscendC::LoadData(a2Local, a1Local, params);
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 params;
        params.mStartPosition = 0;
        params.kStartPosition = 0;
        params.mStep = DivCeil(curMAlign, CUBE_BLOCK);
        params.kStep = DivCeil(baseK, CUBE_BLOCK);
        params.srcStride = DivCeil(baseM, CUBE_BLOCK);
        params.dstStride = DivCeil(curMAlign, CUBE_BLOCK);
        params.sid = 0;
        params.ifTranspose = false;
        AscendC::LoadData(a2Local, a1Local, params);
#endif
    }

    __aicore__ inline void DataLoadB(
        AscendC::LocalTensor<half> b1Local, AscendC::LocalTensor<half> b2Local, uint32_t nBlockIdx)
    {
        uint32_t curNAlign = (nBlockIdx != baseNCount) ? baseN : tailNAlign;
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        AscendC::LoadData2DParams params;
        uint32_t dstOffset = curNAlign * CUBE_BLOCK;
        uint32_t srcOffset = baseN * CUBE_BLOCK;
        params.repeatTimes = DivCeil(curNAlign, CUBE_BLOCK);
        params.srcStride = 1;
        params.dstGap = 0;
        params.ifTranspose = false;
        for (uint32_t i = 0; i < DivCeil(baseK, CUBE_BLOCK); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], b1Local[i * srcOffset], params);
        }
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        AscendC::LoadData2DParamsV2 params;
        params.mStartPosition = 0;
        params.kStartPosition = 0;
        params.mStep = DivCeil(curNAlign, CUBE_BLOCK);
        params.kStep = DivCeil(baseK * sizeof(half), 32);
        params.srcStride = DivCeil(baseN, CUBE_BLOCK);
        params.dstStride = DivCeil(curNAlign, CUBE_BLOCK);
        params.ifTranspose = false;
        AscendC::LoadData(b2Local, b1Local, params);
#endif
    }

    __aicore__ inline void Compute(
        AscendC::LocalTensor<float> cLocal, AscendC::LocalTensor<half> a2Local, AscendC::LocalTensor<half> b2Local,
        uint32_t kBlockIdx, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::MmadParams params;
        params.m = curM;
        params.n = curN;
        params.k = baseK;
        params.cmatrixInitVal = (kBlockIdx == 0);
        AscendC::Mmad(cLocal, a2Local, b2Local, params);
    }

    __aicore__ inline void CopyOut(
        AscendC::LocalTensor<float> cLocal, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

        uint32_t curMAlign = (mBlockIdx != baseMCount) ? baseM : tailMAlign;
        uint32_t curM = (mBlockIdx != baseMCount) ? baseM : tailM;
        uint32_t curN = (nBlockIdx != baseNCount) ? baseN : tailN;
        AscendC::FixpipeParamsV220 params;
        params.nSize = curN;
        params.mSize = curM;
        params.srcStride = curMAlign;
        params.dstStride = N;
        params.quantPre = QuantMode_t::F322F16;
        params.ndNum = 1;
        params.srcNdStride = 0;
        params.dstNdStride = 0;
        AscendC::Fixpipe(cGM[mBlockIdx * baseM * N + nBlockIdx * baseN], cLocal, params);

        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    }

private:
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<half> cGM;
    AscendC::GlobalTensor<half> aGMOri;
    AscendC::GlobalTensor<half> bGMOri;
    AscendC::GlobalTensor<half> cGMOri;
    uint32_t actualSingleCoreM;
    uint32_t actualSingleCoreN;
    uint32_t mLoopCount;
    uint32_t nLoopCount;
    uint32_t kLoopCount;
    uint32_t baseMCount;
    uint32_t baseNCount;
    uint32_t tailM;
    uint32_t tailN;
    uint32_t tailMAlign;
    uint32_t tailNAlign;
};

template <
    uint32_t M, uint32_t K, uint32_t N, uint32_t baseM, uint32_t baseK, uint32_t baseN, uint32_t singleCoreM,
    uint32_t singleCoreK, uint32_t singleCoreN>
__global__ __cube__ void mmad_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    KernelMmad<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN> op;
    op.Init(a, b, c);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 8192;
    constexpr uint32_t K = 8192;
    constexpr uint32_t N = 8192;
    constexpr uint32_t baseK = 64;
    constexpr uint32_t baseN = 256;
    constexpr uint32_t singleCoreK = K;

#if (NPU_ARCH == 2201)
    constexpr uint32_t baseM = 128;
    constexpr uint32_t singleCoreM = 4096;
    constexpr uint32_t singleCoreN = 683;
    constexpr uint32_t numBlocks = 24;
#elif (NPU_ARCH == 3510)
    constexpr uint32_t baseM = 256;
    constexpr uint32_t singleCoreM = 4096;
    constexpr uint32_t singleCoreN = 512;
    constexpr uint32_t numBlocks = 32;
#endif

    size_t aFileSize = static_cast<size_t>(M) * K * sizeof(half);
    size_t bFileSize = static_cast<size_t>(K) * N * sizeof(half);
    size_t cFileSize = static_cast<size_t>(M) * N * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_custom<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN>
        <<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

