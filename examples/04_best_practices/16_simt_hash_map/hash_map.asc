#include <cstdint>
#include <cstddef>
#include <cstring>
#include <limits>
#include <random>
#include <cstring>
#include <iostream>
#include <array>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t VALUE_DIM = 4;
constexpr uint32_t MAP_CAPACITY = 16 * 1024;
constexpr uint32_t ALIGN_BYTES = 8;
constexpr uint32_t KEY_NUM = 8 * 1024;
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t INT64_TYPE_BYTES = 8;
constexpr int32_t DEFALUT_FLAG = 0;
constexpr int32_t HOLD_FLAG = 0x57277275;
constexpr int32_t WRITE_FLAG = 0x39555593;
constexpr int32_t POSSESSION_FLAG = 16777216;
} // namespace

// Bucket need 8 bytes align
struct Bucket {
    int64_t key;
    // int64_t count;
    int32_t state;
    int32_t flag;
    float value[VALUE_DIM];
};

__simt_callee__ inline uint32_t rotl32(uint32_t x, uint32_t r)
{
    return (x << r) | (x >> (32 - r));
}

__simt_callee__ inline uint32_t murmur_hash_3(int64_t key, uint32_t len, uint32_t seed)
{
    constexpr uint32_t c1 = 0xcc9e2d51;
    constexpr uint32_t c2 = 0x1b873593;
    constexpr uint32_t r1 = 15;
    constexpr uint32_t r2 = 13;
    constexpr uint32_t m = 5;
    constexpr uint32_t n = 0xe6546b64;
    uint32_t hash = seed;
    uint32_t k = 0;
    uint32_t* data = reinterpret_cast<uint32_t*>(&key);

    const uint32_t nblocks = len / 4;
#pragma unroll 2
    for (uint32_t i = 0; i < nblocks; i++) {
        k = data[i];
        k *= c1;
        k = rotl32(k, r1);
        k *= c2;
        hash ^= k;
        hash = rotl32(hash, r2);
        hash = hash * m + n;
    }

    hash ^= len;
    hash ^= hash >> 16;
    hash *= 0x85ebca6b;
    hash ^= hash >> 13;
    hash *= 0xc2b2ae35;
    hash ^= hash >> 16;
    return hash;
}

__simt_callee__ inline void write_value(__gm__ float* values, uint32_t value_dim, __gm__ Bucket* bucket_addr)
{
#pragma unroll 4
    for (uint32_t i = 0; i < value_dim; i++) {
        bucket_addr->value[i] = values[i];
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void hash_map_insert(__gm__ uint8_t* map_addr, uint32_t map_capacity,
                                                                        uint32_t value_dim, __gm__ int64_t* keys,
                                                                        __gm__ float* values, uint32_t key_num,
                                                                        uint32_t bucket_size)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= key_num) {
        return;
    }

    int64_t insert_key = keys[idx];
    uint32_t hash = murmur_hash_3(insert_key, INT64_TYPE_BYTES, 0);
    uint32_t map_idx = hash % map_capacity;
    uint32_t bucket_offset = 0;
    __gm__ Bucket* bucket_addr = nullptr;

    for (uint32_t i = 0; i < map_capacity; i++) {
        bucket_offset = map_idx * bucket_size;
        bucket_addr = reinterpret_cast<__gm__ Bucket*>(map_addr + bucket_offset);
        int32_t old_flag = asc_atomic_cas(&bucket_addr->flag, DEFALUT_FLAG, WRITE_FLAG);
        if (old_flag == DEFALUT_FLAG) {
            bucket_addr->key = insert_key;
            asc_threadfence();
            bucket_addr->state = 1;
            write_value(values + (idx * value_dim), value_dim, bucket_addr);
            asc_threadfence();
            bucket_addr->flag = HOLD_FLAG;
            break;
        } else {
            while (*reinterpret_cast<__gm__ volatile int32_t*>(&bucket_addr->state) != 1) {}
            if (insert_key == *reinterpret_cast<__gm__ volatile int64_t*>(&bucket_addr->key)) {
                old_flag = asc_atomic_cas(&bucket_addr->flag, HOLD_FLAG, WRITE_FLAG);
                if (old_flag == HOLD_FLAG) {
                    write_value(values + (idx * value_dim), value_dim, bucket_addr);
                    asc_threadfence();
                    bucket_addr->flag = HOLD_FLAG;
                }
                break;
            } else {
                if (map_idx == map_capacity - 1) {
                    map_idx = 0;
                } else {
                    map_idx++;
                }
            }
        }
    }
}

__global__ __vector__ void hash_map_kernel(__gm__ uint8_t* map_addr, uint32_t map_capacity, uint32_t value_dim,
                                           __gm__ int64_t* key, __gm__ float* values, uint32_t key_num,
                                           uint32_t bucket_size)
{
    asc_vf_call<hash_map_insert>(dim3(THREAD_COUNT), map_addr, map_capacity, value_dim, key, values, key_num,
                                 bucket_size);
}

int64_t random_key()
{
    static std::random_device rd;
    static std::mt19937_64 gen(rd());
    static std::uniform_int_distribution<int64_t> dist(0, std::numeric_limits<int64_t>::max());
    return dist(gen);
}

float random_value()
{
    static std::random_device rd;
    static std::mt19937_64 gen(rd());
    static std::uniform_real_distribution<float> dist(std::numeric_limits<float>::min(),
                                                      std::numeric_limits<float>::max());
    return dist(gen);
}

void generate_test_data(std::vector<int64_t>& keys, std::vector<std::array<float, VALUE_DIM>>& values, uint32_t num)
{
    for (int32_t i = 0; i < num; i++) {
        keys[i] = random_key();
        values[i] = std::array<float, VALUE_DIM>{random_value(), random_value(), random_value(), random_value()};
    }
}

std::vector<uint8_t> launch_kernel(std::vector<int64_t>& keys, std::vector<std::array<float, VALUE_DIM>>& values)
{
    size_t key_total_byte_size = KEY_NUM * sizeof(int64_t);
    size_t value_total_byte_size = KEY_NUM * sizeof(float) * VALUE_DIM;

    size_t bucket_byte_size = sizeof(Bucket);
    bucket_byte_size = (bucket_byte_size + ALIGN_BYTES - 1) & ~(ALIGN_BYTES - 1);
    size_t hash_map_total_byte_size = bucket_byte_size * MAP_CAPACITY;

    uint32_t num_blocks = (KEY_NUM + THREAD_COUNT - 1) / THREAD_COUNT;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    void* key_host = reinterpret_cast<void*>(keys.data());
    void* key_device = nullptr;
    void* value_host = reinterpret_cast<void*>(values.data());
    void* value_device = nullptr;
    void* hash_map_host = nullptr;
    void* hash_map_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    aclrtMallocHost(&hash_map_host, hash_map_total_byte_size);
    aclrtMalloc(&key_device, key_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&value_device, value_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&hash_map_device, hash_map_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(key_device, key_total_byte_size, key_host, key_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(value_device, value_total_byte_size, value_host, value_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t dyn_ubuf_size = 0; // No need to alloc dynamic memory.
    hash_map_kernel<<<num_blocks, dyn_ubuf_size, stream>>>((uint8_t*)hash_map_device, MAP_CAPACITY, VALUE_DIM,
                                                           (int64_t*)key_device, (float*)value_device, KEY_NUM,
                                                           bucket_byte_size);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(hash_map_host, hash_map_total_byte_size, hash_map_device, hash_map_total_byte_size,
                ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint8_t> output((uint8_t*)hash_map_host, (uint8_t*)hash_map_host + hash_map_total_byte_size);

    aclrtFree(key_device);
    aclrtFree(value_device);
    aclrtFree(hash_map_device);
    aclrtFreeHost(hash_map_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return output;
}

inline uint32_t rotl32_cpu(uint32_t x, uint32_t r)
{
    return (x << r) | (x >> (32 - r));
}

uint32_t murmur_hash_3_cpu(int64_t key, uint32_t len, uint32_t seed)
{
    constexpr uint32_t c1 = 0xcc9e2d51;
    constexpr uint32_t c2 = 0x1b873593;
    constexpr uint32_t r1 = 15;
    constexpr uint32_t r2 = 13;
    constexpr uint32_t m = 5;
    constexpr uint32_t n = 0xe6546b64;
    uint32_t hash = seed;
    uint32_t k = 0;
    uint32_t* data = reinterpret_cast<uint32_t*>(&key);

    const uint32_t nblocks = len / 4;
    for (uint32_t i = 0; i < nblocks; i++) {
        k = data[i];
        k *= c1;
        k = rotl32_cpu(k, r1);
        k *= c2;
        hash ^= k;
        hash = rotl32_cpu(hash, r2);
        hash = hash * m + n;
    }

    hash ^= len;
    hash ^= hash >> 16;
    hash *= 0x85ebca6b;
    hash ^= hash >> 13;
    hash *= 0xc2b2ae35;
    hash ^= hash >> 16;
    return hash;
}

void check_result(std::vector<int64_t>& keys, std::vector<std::array<float, VALUE_DIM>>& values,
                  std::vector<uint8_t>& hash_map)
{
    constexpr float epsilon = 1e-5f;
    size_t bucket_byte_size = sizeof(Bucket);
    bucket_byte_size = (bucket_byte_size + ALIGN_BYTES - 1) & ~(ALIGN_BYTES - 1);
    size_t hash_map_total_byte_size = bucket_byte_size * MAP_CAPACITY;
    const Bucket* bucket_addr = reinterpret_cast<const Bucket*>(hash_map.data());
    Bucket tmp = {0};
    uint32_t count = 0;
    for (int32_t i = 0; i < KEY_NUM; i++) {
        int64_t insert_key = keys[i];
        uint32_t hash = murmur_hash_3_cpu(insert_key, INT64_TYPE_BYTES, 0);
        Bucket tmp = {insert_key, 1, HOLD_FLAG, {values[i][0], values[i][1], values[i][2], values[i][3]}};
        uint32_t pos = hash % MAP_CAPACITY;
        bool result = false;
        for (uint32_t j = 0; j < MAP_CAPACITY; j++) {
            uint32_t idx = (pos + j) % MAP_CAPACITY;
            if (bucket_addr[idx].key == tmp.key) {
                if (bucket_addr[idx].state != tmp.state || bucket_addr[idx].flag != tmp.flag) {
                    std::cout << "check value failed, key: " << bucket_addr[idx].key
                              << ", state: " << bucket_addr[idx].state << ", flag" << bucket_addr[idx].flag
                              << std::endl;
                    std::cout << "expect              key: " << tmp.key << ", state: " << tmp.state << ", flag"
                              << tmp.flag << std::endl;
                    break;
                }
                int32_t k = 0;
                for (; k < VALUE_DIM; k++) {
                    if (std::abs(tmp.value[k] - bucket_addr[idx].value[k]) > epsilon) {
                        std::cout << "check value failed, key: " << tmp.key << ", value: " << bucket_addr[idx].value[0]
                                  << ", " << bucket_addr[idx].value[1] << ", " << bucket_addr[idx].value[2] << ", "
                                  << bucket_addr[idx].value[3] << std::endl;
                        std::cout << "            expect, key: " << tmp.key << ", value: " << tmp.value[0] << ", "
                                  << tmp.value[1] << ", " << tmp.value[2] << ", " << tmp.value[3] << std::endl;
                        break;
                    }
                }
                result = true;
            }
        }
        if (!result) {
            std::cout << "Check key: " << insert_key << " failed" << std::endl;
            count++;
        }
    }
    std::cout << "Check failed total: " << count << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    std::vector<int64_t> keys(KEY_NUM);
    std::vector<std::array<float, VALUE_DIM>> values(KEY_NUM);
    generate_test_data(keys, values, KEY_NUM);
    std::vector<uint8_t> hash_map = launch_kernel(keys, values);
    check_result(keys, values, hash_map);
}
