/* !
 * \file mmad_double_buffer.asc
 * \brief MMAD single-buffer baseline and L1/L0 double-buffer optimization sample.
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t MATRIX_M = 1024;
constexpr uint32_t MATRIX_K = 1024;
constexpr uint32_t MATRIX_N = 1024;

constexpr uint32_t TILE_M = 128;
constexpr uint32_t TILE_K = 64;
constexpr uint32_t TILE_N = 128;

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t K_ROUNDS = MATRIX_K / TILE_K;
constexpr uint32_t M_TILES = MATRIX_M / TILE_M;
constexpr uint32_t N_TILES = MATRIX_N / TILE_N;
constexpr uint32_t NUM_BLOCKS = M_TILES * N_TILES;

constexpr uint32_t A_TILE_ELEMENTS = TILE_M * TILE_K;
constexpr uint32_t B_TILE_ELEMENTS = TILE_N * TILE_K;
constexpr uint32_t C_TILE_ELEMENTS = TILE_M * TILE_N;

constexpr uint8_t L2_CACHE_NORMAL = 0;
constexpr uint8_t UNIT_FLAG_DISABLE = 0;

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

constexpr uint64_t make_nd2nz_config(uint16_t c0_stride)
{
    constexpr uint16_t loop4_dst_stride = 0;
    constexpr uint16_t n_stride = 1;
    constexpr uint16_t matrix_count = 1;
    return (static_cast<uint64_t>(loop4_dst_stride) << 48) |
           (static_cast<uint64_t>(c0_stride) << 32) |
           (static_cast<uint64_t>(n_stride) << 16) | matrix_count;
}

constexpr uint64_t A_ND2NZ_CONFIG = make_nd2nz_config(TILE_M);
constexpr uint64_t B_ND2NZ_CONFIG = make_nd2nz_config(TILE_N);

__aicore__ inline void copy_a_to_l1(
    __cbuf__ half* dst, __gm__ half* src, uint32_t m_tile_idx, uint32_t k_tile_idx)
{
    __gm__ half* tile_src = src + m_tile_idx * TILE_M * MATRIX_K + k_tile_idx * TILE_K;
    asc_set_gm2l1_nz_para(A_ND2NZ_CONFIG);
    asc_copy_gm2l1_nd2nz(
        dst, tile_src, MATRIX_K * sizeof(half), L2_CACHE_NORMAL, TILE_M, TILE_K, 0, false);
}

__aicore__ inline void copy_b_to_l1(
    __cbuf__ half* dst, __gm__ half* src, uint32_t n_tile_idx, uint32_t k_tile_idx)
{
    // B is stored as [N, K] in GM, so the K dimension is contiguous.
    __gm__ half* tile_src = src + n_tile_idx * TILE_N * MATRIX_K + k_tile_idx * TILE_K;
    asc_set_gm2l1_nz_para(B_ND2NZ_CONFIG);
    asc_copy_gm2l1_nd2nz(
        dst, tile_src, MATRIX_K * sizeof(half), L2_CACHE_NORMAL, TILE_N, TILE_K, 0, false);
}

__aicore__ inline void copy_a_to_l0(__ca__ half* dst, __cbuf__ half* src)
{
    asc_copy_l12l0a(
        dst, src, 0, 0, TILE_M / CUBE_BLOCK, TILE_K / CUBE_BLOCK, TILE_M / CUBE_BLOCK,
        TILE_M / CUBE_BLOCK);
}

__aicore__ inline void copy_b_to_l0(__cb__ half* dst, __cbuf__ half* src)
{
    // The transposed B input is already in the layout expected by regular L1-to-L0B movement.
    asc_copy_l12l0b(
        dst, src, 0, 0, TILE_N / CUBE_BLOCK, TILE_K / CUBE_BLOCK, TILE_N / CUBE_BLOCK,
        TILE_N / CUBE_BLOCK);
}

__aicore__ inline void copy_c_to_gm(__gm__ float* dst, __cc__ float* src)
{
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(
        dst, src, TILE_N, TILE_M, MATRIX_N, TILE_M, L2_CACHE_NORMAL, 0, UNIT_FLAG_DISABLE, 0, 0, false, true,
        0, 0, false, 0, false, false, false, false);
}

__global__ __cube__ void mmad_baseline(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();

    int64_t core_idx = block_idx;
    uint32_t m_tile_idx = static_cast<uint32_t>(core_idx) % M_TILES;
    uint32_t n_tile_idx = static_cast<uint32_t>(core_idx) / M_TILES;

    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* c_gm = reinterpret_cast<__gm__ float*>(c);

    __cbuf__ half a_l1[A_TILE_ELEMENTS];
    __cbuf__ half b_l1[B_TILE_ELEMENTS];
    __ca__ half a_l0[A_TILE_ELEMENTS];
    __cb__ half b_l0[B_TILE_ELEMENTS];
    __cc__ float c_l0[C_TILE_ELEMENTS];

    for (uint32_t k_tile_idx = 0; k_tile_idx < K_ROUNDS; ++k_tile_idx) {
        copy_a_to_l1(a_l1, a_gm, m_tile_idx, k_tile_idx);
        copy_b_to_l1(b_l1, b_gm, n_tile_idx, k_tile_idx);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

        copy_a_to_l0(a_l0, a_l1);
        copy_b_to_l0(b_l0, b_l1);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

        asc_mmad(
            c_l0, a_l0, b_l0, TILE_M, TILE_K, TILE_N, UNIT_FLAG_DISABLE, false, false, k_tile_idx == 0);
        // The next K tile reuses L1 and L0, so the current MMAD must finish first.
        asc_sync_pipe(PIPE_ALL);
    }

    __gm__ float* c_tile = c_gm + m_tile_idx * TILE_M * MATRIX_N + n_tile_idx * TILE_N;
    copy_c_to_gm(c_tile, c_l0);
    asc_sync_pipe(PIPE_ALL);
}

__global__ __cube__ void mmad_double_buffer(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();

    int64_t core_idx = block_idx;
    uint32_t m_tile_idx = static_cast<uint32_t>(core_idx) % M_TILES;
    uint32_t n_tile_idx = static_cast<uint32_t>(core_idx) / M_TILES;

    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* c_gm = reinterpret_cast<__gm__ float*>(c);

    // L1 Ping/Pong: MTE2 fills one group while MTE1 consumes the other group.
    __cbuf__ half a_l1_ping[A_TILE_ELEMENTS];
    __cbuf__ half a_l1_pong[A_TILE_ELEMENTS];
    __cbuf__ half b_l1_ping[B_TILE_ELEMENTS];
    __cbuf__ half b_l1_pong[B_TILE_ELEMENTS];

    // L0 Ping/Pong: MTE1 fills one group while the M pipeline consumes the other group.
    __ca__ half a_l0_ping[A_TILE_ELEMENTS];
    __ca__ half a_l0_pong[A_TILE_ELEMENTS];
    __cb__ half b_l0_ping[B_TILE_ELEMENTS];
    __cb__ half b_l0_pong[B_TILE_ELEMENTS];
    __cc__ float c_l0[C_TILE_ELEMENTS];

    // Reverse events mark both Ping/Pong groups as initially writable.
    asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
    asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
    asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
    asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);

    for (uint32_t k_tile_idx = 0; k_tile_idx < K_ROUNDS; ++k_tile_idx) {
        int32_t event_id = (k_tile_idx & 1) == 0 ? EVENT_ID0 : EVENT_ID1;
        __cbuf__ half* a_l1 = (k_tile_idx & 1) == 0 ? a_l1_ping : a_l1_pong;
        __cbuf__ half* b_l1 = (k_tile_idx & 1) == 0 ? b_l1_ping : b_l1_pong;
        __ca__ half* a_l0 = (k_tile_idx & 1) == 0 ? a_l0_ping : a_l0_pong;
        __cb__ half* b_l0 = (k_tile_idx & 1) == 0 ? b_l0_ping : b_l0_pong;

        // Wait until MTE1 has released this L1 group, then prefetch the next K tile.
        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, event_id);
        copy_a_to_l1(a_l1, a_gm, m_tile_idx, k_tile_idx);
        copy_b_to_l1(b_l1, b_gm, n_tile_idx, k_tile_idx);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, event_id);

        // Load the completed L1 group into the matching free L0 group.
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, event_id);
        asc_sync_wait(PIPE_M, PIPE_MTE1, event_id);
        copy_a_to_l0(a_l0, a_l1);
        copy_b_to_l0(b_l0, b_l1);
        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, event_id);
        asc_sync_notify(PIPE_MTE1, PIPE_M, event_id);

        // MMAD accumulates all K tiles into one L0C tile. UnitFlag is intentionally disabled.
        asc_sync_wait(PIPE_MTE1, PIPE_M, event_id);
        asc_mmad(
            c_l0, a_l0, b_l0, TILE_M, TILE_K, TILE_N, UNIT_FLAG_DISABLE, false, false, k_tile_idx == 0);
        asc_sync_notify(PIPE_M, PIPE_MTE1, event_id);
    }

    // Consume the final reverse events so every notify/wait pair is balanced.
    asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
    asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID2);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID2);
    __gm__ float* c_tile = c_gm + m_tile_idx * TILE_M * MATRIX_N + n_tile_idx * TILE_N;
    copy_c_to_gm(c_tile, c_l0);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    size_t a_file_size = MATRIX_M * MATRIX_K * sizeof(uint16_t);
    size_t b_file_size = MATRIX_K * MATRIX_N * sizeof(uint16_t);
    size_t c_file_size = MATRIX_M * MATRIX_N * sizeof(float);

    aclInit(nullptr);
    constexpr int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size)) {
        return 1;
    }
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size)) {
        return 1;
    }
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    if constexpr (SCENARIO_NUM == 0) {
        mmad_baseline<<<NUM_BLOCKS, 0, stream>>>(a_device, b_device, c_device);
    } else {
        mmad_double_buffer<<<NUM_BLOCKS, 0, stream>>>(a_device, b_device, c_device);
    }
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    if (!WriteFile("./output/output.bin", c_host, c_file_size)) {
        return 1;
    }

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
