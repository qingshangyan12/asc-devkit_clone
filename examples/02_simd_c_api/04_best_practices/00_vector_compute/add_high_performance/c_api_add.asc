/* !
 * \file c_api_add.asc
 * \brief Add operator single-buffer baseline and double-buffer optimization sample
 */

#include <cstdio>
#include <cstdint>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_M = 8192;
constexpr uint32_t TOTAL_N = 8192;
constexpr uint32_t NUM_CORES = 64;
constexpr uint32_t DATA_COPY_LENGTH = 21760;
constexpr uint32_t MAX_DATA_COPY_LENGTH = 21840;
constexpr uint32_t VF_LENGTH = 256;
constexpr uint16_t BURST_NUM = 1;
constexpr asc_load_l2_cache_mode LOAD_L2_CACHE_MODE = asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM;
constexpr asc_store_l2_cache_mode STORE_L2_CACHE_MODE = asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM;

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

__simd_vf__ inline void add_vf(__ubuf__ half* z_local, __ubuf__ half* x_local, __ubuf__ half* y_local,
    uint32_t element_count, uint32_t elements_per_vf, uint16_t repeat_times)
{
    vector_half x_reg;
    vector_half y_reg;
    vector_half z_reg;
    vector_bool mask;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b16(element_count);
        asc_loadalign(x_reg, x_local + i * elements_per_vf);
        asc_loadalign(y_reg, y_local + i * elements_per_vf);
        asc_add(z_reg, x_reg, y_reg, mask);
        asc_storealign(z_local + i * elements_per_vf, z_reg, mask);
    }
}

__vector__ __global__ void add_baseline(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    asc_init();

    int64_t core_num = asc_get_block_num();
    int64_t core_idx = block_idx;
    int64_t base_core_m = TOTAL_M / core_num;
    int64_t start_m = core_idx * base_core_m;
    int64_t single_core_m = core_idx == core_num - 1 ? TOTAL_M - start_m : base_core_m;
    int64_t total_elements_per_core = single_core_m * TOTAL_N;

    __gm__ half* x_gm = reinterpret_cast<__gm__ half*>(x) + start_m * TOTAL_N;
    __gm__ half* y_gm = reinterpret_cast<__gm__ half*>(y) + start_m * TOTAL_N;
    __gm__ half* z_gm = reinterpret_cast<__gm__ half*>(z) + start_m * TOTAL_N;

    extern __ubuf__ half ub_buffer[];
    __ubuf__ half* x_local = ub_buffer;
    __ubuf__ half* y_local = ub_buffer + MAX_DATA_COPY_LENGTH;
    __ubuf__ half* z_local = ub_buffer + MAX_DATA_COPY_LENGTH * 2;

    uint32_t total_blocks = static_cast<uint32_t>(
        (total_elements_per_core + DATA_COPY_LENGTH - 1) / DATA_COPY_LENGTH);

    for (uint32_t loop_idx = 0; loop_idx < total_blocks; ++loop_idx) {
        uint32_t start_element = loop_idx * DATA_COPY_LENGTH;
        int64_t remain_elements = total_elements_per_core - start_element;
        uint32_t current_length = remain_elements > DATA_COPY_LENGTH ?
                                      DATA_COPY_LENGTH : static_cast<uint32_t>(remain_elements);
        uint32_t burst_length = current_length * sizeof(half);
        uint64_t gm_stride = 0;
        uint32_t ub_stride = 0;

        asc_copy_gm2ub_align(x_local, x_gm + start_element, BURST_NUM, burst_length, 0, 0, true,
            LOAD_L2_CACHE_MODE, gm_stride, ub_stride);
        asc_copy_gm2ub_align(y_local, y_gm + start_element, BURST_NUM, burst_length, 0, 0, true,
            LOAD_L2_CACHE_MODE, gm_stride, ub_stride);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        constexpr uint32_t elements_per_vf = VF_LENGTH / sizeof(half);
        uint16_t repeat_times = static_cast<uint16_t>(
            (current_length + elements_per_vf - 1) / elements_per_vf);
        add_vf(z_local, x_local, y_local, current_length, elements_per_vf, repeat_times);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

        asc_copy_ub2gm_align(z_gm + start_element, z_local, BURST_NUM, burst_length,
            STORE_L2_CACHE_MODE, gm_stride, ub_stride);
        // The next tile reuses the same UB addresses, so all stages must finish first.
        asc_sync_pipe(PIPE_ALL);
    }
}

__vector__ __global__ void add_double_buffer(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    asc_init();

    int64_t core_num = asc_get_block_num();
    int64_t core_idx = block_idx;
    int64_t base_core_m = TOTAL_M / core_num;
    int64_t start_m = core_idx * base_core_m;
    int64_t single_core_m = core_idx == core_num - 1 ? TOTAL_M - start_m : base_core_m;
    int64_t total_elements_per_core = single_core_m * TOTAL_N;

    __gm__ half* x_gm = reinterpret_cast<__gm__ half*>(x) + start_m * TOTAL_N;
    __gm__ half* y_gm = reinterpret_cast<__gm__ half*>(y) + start_m * TOTAL_N;
    __gm__ half* z_gm = reinterpret_cast<__gm__ half*>(z) + start_m * TOTAL_N;

    extern __ubuf__ half ub_buffer[];
    __ubuf__ half* x_ping = ub_buffer;
    __ubuf__ half* y_ping = ub_buffer + MAX_DATA_COPY_LENGTH;
    __ubuf__ half* z_ping = ub_buffer + MAX_DATA_COPY_LENGTH * 2;
    __ubuf__ half* x_pong = ub_buffer + MAX_DATA_COPY_LENGTH * 3;
    __ubuf__ half* y_pong = ub_buffer + MAX_DATA_COPY_LENGTH * 4;
    __ubuf__ half* z_pong = ub_buffer + MAX_DATA_COPY_LENGTH * 5;

    uint32_t total_blocks = static_cast<uint32_t>(
        (total_elements_per_core + DATA_COPY_LENGTH - 1) / DATA_COPY_LENGTH);

    // Initialize the two Ping-Pong event groups as available.
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID1);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID1);

    for (uint32_t loop_idx = 0; loop_idx < total_blocks; ++loop_idx) {
        uint32_t start_element = loop_idx * DATA_COPY_LENGTH;
        int64_t remain_elements = total_elements_per_core - start_element;
        uint32_t current_length = remain_elements > DATA_COPY_LENGTH ?
                                      DATA_COPY_LENGTH : static_cast<uint32_t>(remain_elements);

        int32_t event_id = (loop_idx & 1) == 0 ? EVENT_ID0 : EVENT_ID1;
        __ubuf__ half* x_local = (loop_idx & 1) == 0 ? x_ping : x_pong;
        __ubuf__ half* y_local = (loop_idx & 1) == 0 ? y_ping : y_pong;
        __ubuf__ half* z_local = (loop_idx & 1) == 0 ? z_ping : z_pong;
        uint32_t burst_length = current_length * sizeof(half);
        uint64_t gm_stride = 0;
        uint32_t ub_stride = 0;

        asc_sync_wait(PIPE_V, PIPE_MTE2, event_id);
        asc_copy_gm2ub_align(x_local, x_gm + start_element, BURST_NUM, burst_length, 0, 0, true,
            LOAD_L2_CACHE_MODE, gm_stride, ub_stride);
        asc_copy_gm2ub_align(y_local, y_gm + start_element, BURST_NUM, burst_length, 0, 0, true,
            LOAD_L2_CACHE_MODE, gm_stride, ub_stride);

        asc_sync_notify(PIPE_MTE2, PIPE_V, event_id);
        asc_sync_wait(PIPE_MTE2, PIPE_V, event_id);
        asc_sync_wait(PIPE_MTE3, PIPE_V, event_id);

        constexpr uint32_t elements_per_vf = VF_LENGTH / sizeof(half);
        uint16_t repeat_times = static_cast<uint16_t>(
            (current_length + elements_per_vf - 1) / elements_per_vf);
        add_vf(z_local, x_local, y_local, current_length, elements_per_vf, repeat_times);
        asc_sync_notify(PIPE_V, PIPE_MTE2, event_id);

        asc_sync_notify(PIPE_V, PIPE_MTE3, event_id);
        asc_sync_wait(PIPE_V, PIPE_MTE3, event_id);
        asc_copy_ub2gm_align(z_gm + start_element, z_local, BURST_NUM, burst_length,
            STORE_L2_CACHE_MODE, gm_stride, ub_stride);
        asc_sync_notify(PIPE_MTE3, PIPE_V, event_id);
    }

    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID1);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID1);
    asc_sync_pipe(PIPE_ALL);
}

struct ArgInfo {
    std::string file_name;
    size_t length;
};

int32_t main(int32_t argc, char* argv[])
{
    printf("Usage: %s (C API add performance sample, scenario %d)\n", argv[0], SCENARIO_NUM);
    constexpr uint32_t data_length = TOTAL_M * TOTAL_N;
    constexpr size_t data_byte_size = data_length * sizeof(uint16_t);

    std::vector<ArgInfo> inputs_info = {
        {"./input/input_x.bin", data_byte_size},
        {"./input/input_y.bin", data_byte_size},
    };
    std::vector<ArgInfo> outputs_info = {{"./output/output.bin", data_byte_size}};

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    std::vector<uint8_t*> input_host(inputs_info.size());
    std::vector<uint8_t*> input_device(inputs_info.size());
    std::vector<uint8_t*> output_host(outputs_info.size());
    std::vector<uint8_t*> output_device(outputs_info.size());

    for (uint32_t i = 0; i < inputs_info.size(); ++i) {
        aclrtMallocHost(reinterpret_cast<void**>(&input_host[i]), inputs_info[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&input_device[i]), inputs_info[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputs_info[i].file_name, inputs_info[i].length, input_host[i], inputs_info[i].length);
        aclrtMemcpy(input_device[i], inputs_info[i].length, input_host[i], inputs_info[i].length,
            ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (uint32_t i = 0; i < outputs_info.size(); ++i) {
        aclrtMallocHost(reinterpret_cast<void**>(&output_host[i]), outputs_info[i].length);
        aclrtMalloc(reinterpret_cast<void**>(&output_device[i]), outputs_info[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    if constexpr (SCENARIO_NUM == 0) {
        add_baseline<<<NUM_CORES, 0, stream>>>(input_device[0], input_device[1], output_device[0]);
    } else {
        add_double_buffer<<<NUM_CORES, 0, stream>>>(input_device[0], input_device[1], output_device[0]);
    }
    aclrtSynchronizeStream(stream);

    for (uint32_t i = 0; i < outputs_info.size(); ++i) {
        aclrtMemcpy(output_host[i], outputs_info[i].length, output_device[i], outputs_info[i].length,
            ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputs_info[i].file_name, output_host[i], outputs_info[i].length);
        aclrtFree(output_device[i]);
        aclrtFreeHost(output_host[i]);
    }

    for (uint32_t i = 0; i < inputs_info.size(); ++i) {
        aclrtFree(input_device[i]);
        aclrtFreeHost(input_host[i]);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    printf("C API Add performance sample completed.\n");
    return 0;
}
