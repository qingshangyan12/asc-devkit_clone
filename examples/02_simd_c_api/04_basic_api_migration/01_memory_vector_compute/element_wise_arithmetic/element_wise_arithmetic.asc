/*!
 * \file element_wise_arithmetic.asc
 * \brief C API array-allocation migration of the basic-API LeakyReLU sample.
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEMENT_COUNT = 512;
constexpr uint32_t DATA_BYTES = ELEMENT_COUNT * sizeof(half);

__global__ __vector__ void element_wise_arithmetic_c_api(__gm__ half* src, __gm__ half* dst)
{
    asc_init();

    // C API local-memory allocation uses address-space-qualified arrays.
    __ubuf__ half src_ub[ELEMENT_COUNT];
    __ubuf__ half dst_ub[ELEMENT_COUNT];

    // DATA_BYTES is 1024, satisfying the documented 32-byte alignment rule.
    asc_copy_gm2ub(src_ub, src, DATA_BYTES);
    // The scalar loop reads src_ub after MTE2 completes the GM-to-UB copy.
    asc_sync_notify(PIPE_MTE2, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_S, EVENT_ID0);

    // Do not use asc_leakyrelu here: its C API document does not support the
    // target product. This is the documented algorithm-level fallback.
    const half alpha = static_cast<half>(0.01f);
    for (uint32_t index = 0; index < ELEMENT_COUNT; ++index) {
        dst_ub[index] = src_ub[index] > static_cast<half>(0) ? src_ub[index] : src_ub[index] * alpha;
    }

    // MTE3 reads dst_ub only after the scalar loop has produced every element.
    asc_sync_notify(PIPE_S, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(dst, dst_ub, DATA_BYTES);
    asc_sync_pipe(PIPE_MTE3);
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    half* src_host = nullptr;
    half* dst_host = nullptr;
    half* src_device = nullptr;
    half* dst_device = nullptr;
    aclrtStream stream = nullptr;
    int32_t result = 1;

    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(device_id) != ACL_SUCCESS ||
        aclrtCreateStream(&stream) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&src_host), DATA_BYTES) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&dst_host), DATA_BYTES) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&src_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dst_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        goto cleanup;
    }

    for (uint32_t index = 0; index < ELEMENT_COUNT; ++index) {
        src_host[index] = static_cast<half>(static_cast<int32_t>(index) - 256);
    }
    if (aclrtMemcpy(src_device, DATA_BYTES, src_host, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        goto cleanup;
    }

    element_wise_arithmetic_c_api<<<1, 0, stream>>>(src_device, dst_device);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS ||
        aclrtMemcpy(dst_host, DATA_BYTES, dst_device, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    if (src_device != nullptr) {
        (void)aclrtFree(src_device);
    }
    if (dst_host != nullptr) {
        (void)aclrtFreeHost(dst_host);
    }
    if (src_host != nullptr) {
        (void)aclrtFreeHost(src_host);
    }
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return result;
}
