#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEMENT_COUNT = 512;
constexpr uint32_t DATA_BYTES = ELEMENT_COUNT * sizeof(half);
constexpr uint16_t DATA_BLOCK_BYTES = 32;
constexpr uint16_t DATA_BLOCK_COUNT = DATA_BYTES / DATA_BLOCK_BYTES;

// asc_copy_l12ub crosses Cube and Vector cores, so this entry intentionally
// has no __cube__ or __vector__ execution-space modifier.
__global__ void data_copy_gm2l1_c_api(__gm__ half* src, __gm__ half* dst)
{
    asc_init();
    __cbuf__ half l1_buffer[ELEMENT_COUNT];
    __ubuf__ half ub_buffer[ELEMENT_COUNT];

    asc_copy_gm2l1_sync(
        reinterpret_cast<__cbuf__ void*>(l1_buffer), reinterpret_cast<__gm__ void*>(src), DATA_BYTES);
    asc_copy_l12ub_sync(
        reinterpret_cast<__ubuf__ void*>(ub_buffer), reinterpret_cast<__cbuf__ void*>(l1_buffer), false, 1,
        DATA_BLOCK_COUNT, 0, 0);
    asc_copy_ub2gm_sync(dst, ub_buffer, DATA_BYTES);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    half* src_host = nullptr;
    half* dst_host = nullptr;
    half* src_device = nullptr;
    half* dst_device = nullptr;
    aclrtStream stream = nullptr;
    int32_t result = 1;

    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(device_id) != ACL_SUCCESS ||
        aclrtCreateStream(&stream) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&src_host), DATA_BYTES) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&dst_host), DATA_BYTES) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&src_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dst_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        goto cleanup;
    }
    for (uint32_t index = 0; index < ELEMENT_COUNT; ++index) src_host[index] = static_cast<half>(index);
    if (aclrtMemcpy(src_device, DATA_BYTES, src_host, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        goto cleanup;
    }
    data_copy_gm2l1_c_api<<<1, 0, stream>>>(src_device, dst_device);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS ||
        aclrtMemcpy(dst_host, DATA_BYTES, dst_device, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (dst_device != nullptr) (void)aclrtFree(dst_device);
    if (src_device != nullptr) (void)aclrtFree(src_device);
    if (dst_host != nullptr) (void)aclrtFreeHost(dst_host);
    if (src_host != nullptr) (void)aclrtFreeHost(src_host);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return result;
}
