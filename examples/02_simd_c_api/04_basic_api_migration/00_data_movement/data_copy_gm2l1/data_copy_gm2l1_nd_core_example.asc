/* !
 * \file data_copy_gm2l1_nd_core_example.asc
 * \brief Core C API call sequence for data_copy_gm2l1 scenario 2 (ND input).
 *
 * This is a device-side invocation example only. It deliberately omits host-side
 * allocation, kernel launch, data generation, and result verification. A and B
 * are row-major half matrices of shape [128, 128] and [128, 256]; C is a
 * row-major float matrix of shape [128, 256].
 */

#include <cstdint>

#include "c_api/asc_simd.h"

constexpr uint16_t M = 128;
constexpr uint16_t K = 128;
constexpr uint16_t N = 256;
constexpr uint16_t CUBE_BLOCK = 16;
constexpr uint16_t C0_ELEMENTS = 16;
constexpr uint64_t L2_CACHE_NORMAL = 0;

// [15:0]: matrix number; [31:16]: N stride; [47:32]: C0 stride; [63:48]: loop4 stride.
constexpr uint64_t A_ND2NZ_PARA = (static_cast<uint64_t>(M) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
constexpr uint64_t B_ND2NZ_PARA = (static_cast<uint64_t>(K) << 32) | (static_cast<uint64_t>(1) << 16) | 1;

__global__ __cube__ void data_copy_gm2l1_nd_core_example(__gm__ half* a_gm, __gm__ half* b_gm, __gm__ float* c_gm)
{
    asc_init();

    // C API uses address-space-qualified arrays to allocate on-chip memory.
    __cbuf__ half a_l1[M * K];
    __cbuf__ half b_l1[K * N];
    __ca__ half a_l0[M * K];
    __cb__ half b_l0[K * N];
    __cc__ float c_l0[M * N];

    // 1. GM ND -> L1 Nz.
    asc_set_gm2l1_nz_para(A_ND2NZ_PARA);
    asc_copy_gm2l1_nd2nz(a_l1, a_gm, K * sizeof(half), L2_CACHE_NORMAL, M, K, 0, false);
    asc_set_gm2l1_nz_para(B_ND2NZ_PARA);
    asc_copy_gm2l1_nd2nz(b_l1, b_gm, N * sizeof(half), L2_CACHE_NORMAL, K, N, 0, false);

    // 2. L1 Nz -> L0A/L0B. MTE1 waits for MTE2 before consuming L1.
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_copy_l12l0a(a_l0, a_l1, 0, 0, M / CUBE_BLOCK, K / C0_ELEMENTS, M / CUBE_BLOCK, M / CUBE_BLOCK);
    asc_copy_l12l0b_transpose(
        b_l0, b_l1, 0, 0, K / CUBE_BLOCK, N / C0_ELEMENTS, K / CUBE_BLOCK, N / CUBE_BLOCK);

    // 3. L0A x L0B -> L0C. M waits for the L0 input transfers.
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_mmad(c_l0, a_l0, b_l0, M, K, N, 0, false, false, true);

    // 4. L0C Nz -> GM ND. Fixpipe waits for the matrix result.
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(
        c_gm, c_l0, N, M, N, M, L2_CACHE_NORMAL, 0, 0, static_cast<uint64_t>(QuantMode_t::NoQuant), 0, false,
        true, static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, 0, false, false, false, false);
    asc_sync_pipe(PIPE_ALL);
}
