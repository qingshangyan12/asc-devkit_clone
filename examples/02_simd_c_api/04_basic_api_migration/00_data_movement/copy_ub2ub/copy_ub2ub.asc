#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

constexpr uint32_t ROWS = 18;
constexpr uint32_t SOURCE_COLS = 64;
constexpr uint32_t SELECTED_COLS = 8;
constexpr uint32_t CONTIGUOUS_ELEMENTS = 512;
constexpr uint32_t SOURCE_ELEMENTS = ROWS * SOURCE_COLS;
constexpr uint32_t OUTPUT_ELEMENTS = SCENARIO_NUM == 1 ? CONTIGUOUS_ELEMENTS : ROWS * SELECTED_COLS;
constexpr uint32_t INPUT_ELEMENTS = SCENARIO_NUM == 1 ? CONTIGUOUS_ELEMENTS : SOURCE_ELEMENTS;
constexpr uint32_t INPUT_BYTES = INPUT_ELEMENTS * sizeof(int32_t);
constexpr uint32_t OUTPUT_BYTES = OUTPUT_ELEMENTS * sizeof(int32_t);

__global__ __vector__ void copy_ub2ub_c_api(__gm__ int32_t* src, __gm__ int32_t* dst)
{
    asc_init();

    __ubuf__ int32_t src_ub[INPUT_ELEMENTS];
    __ubuf__ int32_t dst_ub[OUTPUT_ELEMENTS];
    asc_copy_gm2ub_sync(src_ub, src, INPUT_BYTES);

    if constexpr (SCENARIO_NUM == 1) {
        asc_copy_ub2ub_sync(dst_ub, src_ub, OUTPUT_BYTES);
    } else {
        // 8 int32_t values are one 32-byte DataBlock. The source gap skips
        // the remaining seven blocks in each 64-element source row.
        asc_copy_ub2ub(dst_ub, src_ub, ROWS, 1, 7, 0);
        asc_sync_pipe(PIPE_V);
    }

    asc_copy_ub2gm_sync(dst, dst_ub, OUTPUT_BYTES);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    int32_t* src_host = nullptr;
    int32_t* dst_host = nullptr;
    int32_t* src_device = nullptr;
    int32_t* dst_device = nullptr;
    aclrtStream stream = nullptr;
    int32_t result = 1;

    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(device_id) != ACL_SUCCESS ||
        aclrtCreateStream(&stream) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&src_host), INPUT_BYTES) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&dst_host), OUTPUT_BYTES) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&src_device), INPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dst_device), OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        goto cleanup;
    }
    for (uint32_t index = 0; index < INPUT_ELEMENTS; ++index) {
        src_host[index] = static_cast<int32_t>(index);
    }
    if (aclrtMemcpy(src_device, INPUT_BYTES, src_host, INPUT_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        goto cleanup;
    }
    copy_ub2ub_c_api<<<1, 0, stream>>>(src_device, dst_device);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS ||
        aclrtMemcpy(dst_host, OUTPUT_BYTES, dst_device, OUTPUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (dst_device != nullptr) (void)aclrtFree(dst_device);
    if (src_device != nullptr) (void)aclrtFree(src_device);
    if (dst_host != nullptr) (void)aclrtFreeHost(dst_host);
    if (src_host != nullptr) (void)aclrtFreeHost(src_host);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return result;
}
