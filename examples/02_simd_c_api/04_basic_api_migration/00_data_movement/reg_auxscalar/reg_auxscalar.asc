#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_ELEMENTS = 512;
constexpr uint32_t SCALAR_STORAGE_ELEMENTS = 16;
constexpr uint32_t X_BYTES = TOTAL_ELEMENTS * sizeof(half);
constexpr uint32_t SCALAR_BYTES = SCALAR_STORAGE_ELEMENTS * sizeof(half);

__simd_vf__ inline void add_aux_scalars(
    __ubuf__ half* x_ub, __ubuf__ half* scalar_ub, __ubuf__ half* z_ub)
{
    constexpr uint32_t VL_ELEMENTS = static_cast<uint32_t>(asc_get_vf_len() / sizeof(half));
    constexpr uint32_t REPEAT_TIMES = TOTAL_ELEMENTS / VL_ELEMENTS;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);

    for (uint32_t repeat = 0; repeat < REPEAT_TIMES; ++repeat) {
        vector_half x_reg;
        vector_half z_reg;
        asc_load(x_reg, x_ub + repeat * VL_ELEMENTS);
        asc_add_scalar(z_reg, x_reg, scalar_ub[repeat], mask);
        asc_store(z_ub + repeat * VL_ELEMENTS, z_reg);
    }
}

__global__ __vector__ void reg_auxscalar_c_api(__gm__ half* x, __gm__ half* scalar, __gm__ half* z)
{
    asc_init();
    __ubuf__ half x_ub[TOTAL_ELEMENTS];
    __ubuf__ half scalar_ub[SCALAR_STORAGE_ELEMENTS];
    __ubuf__ half z_ub[TOTAL_ELEMENTS];

    asc_copy_gm2ub(x_ub, x, X_BYTES);
    asc_copy_gm2ub(scalar_ub, scalar, SCALAR_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    add_aux_scalars(x_ub, scalar_ub, z_ub);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z, z_ub, X_BYTES);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    half* x_host = nullptr;
    half* scalar_host = nullptr;
    half* z_host = nullptr;
    half* x_device = nullptr;
    half* scalar_device = nullptr;
    half* z_device = nullptr;
    aclrtStream stream = nullptr;
    int32_t result = 1;

    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(device_id) != ACL_SUCCESS ||
        aclrtCreateStream(&stream) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&x_host), X_BYTES) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&scalar_host), SCALAR_BYTES) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&z_host), X_BYTES) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&x_device), X_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&scalar_device), SCALAR_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&z_device), X_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        goto cleanup;
    }
    for (uint32_t index = 0; index < TOTAL_ELEMENTS; ++index) x_host[index] = static_cast<half>(index);
    for (uint32_t index = 0; index < SCALAR_STORAGE_ELEMENTS; ++index) scalar_host[index] = static_cast<half>(index);
    if (aclrtMemcpy(x_device, X_BYTES, x_host, X_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
        aclrtMemcpy(scalar_device, SCALAR_BYTES, scalar_host, SCALAR_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        goto cleanup;
    }
    reg_auxscalar_c_api<<<1, 0, stream>>>(x_device, scalar_device, z_device);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS ||
        aclrtMemcpy(z_host, X_BYTES, z_device, X_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (z_device != nullptr) (void)aclrtFree(z_device);
    if (scalar_device != nullptr) (void)aclrtFree(scalar_device);
    if (x_device != nullptr) (void)aclrtFree(x_device);
    if (z_host != nullptr) (void)aclrtFreeHost(z_host);
    if (scalar_host != nullptr) (void)aclrtFreeHost(scalar_host);
    if (x_host != nullptr) (void)aclrtFreeHost(x_host);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return result;
}
