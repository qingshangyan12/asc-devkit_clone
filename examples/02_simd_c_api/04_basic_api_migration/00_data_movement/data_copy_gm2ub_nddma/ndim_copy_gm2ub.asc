#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t SOURCE_ROWS = 3;
constexpr uint32_t SOURCE_COLS = 4;
constexpr uint32_t DEST_ROWS = 9;
constexpr uint32_t DEST_COLS = 6;
constexpr uint32_t SOURCE_BYTES = SOURCE_ROWS * SOURCE_COLS * sizeof(float);
constexpr uint32_t DEST_BYTES = DEST_ROWS * DEST_COLS * sizeof(float);

__global__ __vector__ void ndim_copy_gm2ub_c_api(__gm__ float* src, __gm__ float* dst)
{
    asc_init();
    __ubuf__ float dst_ub[DEST_ROWS * DEST_COLS];

    // 2D layout, from the documented asc_ndim_copy_gm2ub Padding example.
    asc_set_ndim_loop0_stride(1, 1);
    asc_set_ndim_loop1_stride(DEST_COLS, SOURCE_COLS);
    asc_set_ndim_loop2_stride(0, 0);
    asc_set_ndim_loop3_stride(0, 0);
    asc_set_ndim_loop4_stride(0, 0);
    asc_set_ndim_pad_value(88.0f);

    asc_ndim_pad_count_config pad_count_config{};
    pad_count_config.loop1_lp_count = 2;
    pad_count_config.loop1_rp_count = 3;
    asc_set_ndim_pad_count(pad_count_config);

    asc_ndim_copy_gm2ub(
        dst_ub, src, SOURCE_ROWS, SOURCE_COLS, 1, 1, 1, 2, 1, true,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
    // The output DMA must not consume the UB array before the multidimensional
    // MTE2 transfer has completed.
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_sync(dst, dst_ub, DEST_BYTES);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    float* src_host = nullptr;
    float* dst_host = nullptr;
    float* src_device = nullptr;
    float* dst_device = nullptr;
    aclrtStream stream = nullptr;
    int32_t result = 1;

    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(device_id) != ACL_SUCCESS ||
        aclrtCreateStream(&stream) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&src_host), SOURCE_BYTES) != ACL_SUCCESS ||
        aclrtMallocHost(reinterpret_cast<void**>(&dst_host), DEST_BYTES) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&src_device), SOURCE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dst_device), DEST_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        goto cleanup;
    }
    for (uint32_t index = 0; index < SOURCE_ROWS * SOURCE_COLS; ++index) {
        src_host[index] = static_cast<float>(index);
    }
    if (aclrtMemcpy(src_device, SOURCE_BYTES, src_host, SOURCE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        goto cleanup;
    }
    ndim_copy_gm2ub_c_api<<<1, 0, stream>>>(src_device, dst_device);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS ||
        aclrtMemcpy(dst_host, DEST_BYTES, dst_device, DEST_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (dst_device != nullptr) (void)aclrtFree(dst_device);
    if (src_device != nullptr) (void)aclrtFree(src_device);
    if (dst_host != nullptr) (void)aclrtFreeHost(dst_host);
    if (src_host != nullptr) (void)aclrtFreeHost(src_host);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return result;
}
