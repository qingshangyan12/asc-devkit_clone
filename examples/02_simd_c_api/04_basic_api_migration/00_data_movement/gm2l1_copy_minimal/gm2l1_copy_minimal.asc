/* !
 * \file gm2l1_copy_minimal.asc
 * \brief Minimal GM-to-L1 C API copy example with an observable GM output.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t DATA_COUNT = 256;
constexpr uint32_t DATA_BYTES = DATA_COUNT * sizeof(uint16_t);
constexpr uint16_t DATA_BLOCK_COUNT = DATA_BYTES / 32;
constexpr uint32_t PRINT_COUNT = 8;
constexpr int64_t CROSS_CORE_FLAG_ID = 0;

__global__ __mix__(1, 1) void gm2l1_copy_minimal(__gm__ uint16_t* input_gm, __gm__ uint16_t* output_gm)
{
    asc_init();

    // C API allocates on-chip memory through address-space-qualified arrays.
    __cbuf__ uint16_t l1_buffer[DATA_COUNT];
    __ubuf__ uint16_t ub_buffer[DATA_COUNT];

    if ASC_IS_AIC {
        // 1. Copy 512 B from GM to L1 without padding or layout conversion.
        asc_copy_gm2l1(
            (__cbuf__ void*)l1_buffer, (__gm__ void*)input_gm, 1, DATA_BLOCK_COUNT, 0, 0, 0);

        // 2. L1-to-UB is used as the supported observable exit path on dav-3510.
        //    MTE1 must not read L1 until the GM-to-L1 MTE2 transfer has finished.
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12ub(
            (__ubuf__ void*)ub_buffer, (__cbuf__ void*)l1_buffer, false, 1, DATA_BLOCK_COUNT, 0, 0);

        // L1-to-UB runs on AIC, while UB-to-GM runs on AIV. Notify the AIV
        // through the cross-core flag instead of the unsupported MTE1-to-MTE3
        // set_flag pair.
        asc_sync_block_arrive(PIPE_MTE1, CROSS_CORE_FLAG_ID);
    }

    if ASC_IS_AIV {
        asc_sync_block_wait(PIPE_S, CROSS_CORE_FLAG_ID);

        // 3. Copy the unchanged data from UB back to GM so the host can print it.
        asc_copy_ub2gm((__gm__ void*)output_gm, (__ubuf__ void*)ub_buffer, DATA_BYTES);
    }
    asc_sync_pipe(PIPE_ALL);
}

bool CheckAclStatus(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int32_t>(status));
    return false;
}

void PrintSample(const char* label, const uint16_t* data)
{
    std::printf("%s (first %u):", label, PRINT_COUNT);
    for (uint32_t index = 0; index < PRINT_COUNT; ++index) {
        std::printf(" 0x%04x", static_cast<unsigned int>(data[index]));
    }
    std::printf("\n");
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    uint16_t* input_host = nullptr;
    uint16_t* output_host = nullptr;
    uint16_t* input_device = nullptr;
    uint16_t* output_device = nullptr;
    aclrtStream stream = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool succeeded = CheckAclStatus(aclInit(nullptr), "aclInit");
    acl_initialized = succeeded;
    if (succeeded) {
        succeeded = CheckAclStatus(aclrtSetDevice(device_id), "aclrtSetDevice");
        device_set = succeeded;
    }
    if (succeeded) {
        succeeded = CheckAclStatus(aclrtCreateStream(&stream), "aclrtCreateStream") &&
                    CheckAclStatus(
                        aclrtMallocHost(reinterpret_cast<void**>(&input_host), DATA_BYTES), "aclrtMallocHost(input)") &&
                    CheckAclStatus(
                        aclrtMallocHost(reinterpret_cast<void**>(&output_host), DATA_BYTES), "aclrtMallocHost(output)") &&
                    CheckAclStatus(
                        aclrtMalloc(reinterpret_cast<void**>(&input_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST),
                        "aclrtMalloc(input)") &&
                    CheckAclStatus(
                        aclrtMalloc(reinterpret_cast<void**>(&output_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST),
                        "aclrtMalloc(output)");
    }
    if (succeeded) {
        for (uint32_t index = 0; index < DATA_COUNT; ++index) {
            input_host[index] = static_cast<uint16_t>(index * 3 + 1);
            output_host[index] = 0;
        }
        succeeded = CheckAclStatus(
            aclrtMemcpy(input_device, DATA_BYTES, input_host, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(input)");
    }
    if (succeeded) {
        gm2l1_copy_minimal<<<1, 0, stream>>>(input_device, output_device);
        succeeded = CheckAclStatus(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") &&
                    CheckAclStatus(
                        aclrtMemcpy(output_host, DATA_BYTES, output_device, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST),
                        "aclrtMemcpy(output)");
    }
    if (succeeded) {
        PrintSample("input", input_host);
        PrintSample("output", output_host);
    }

    if (output_device != nullptr) (void)aclrtFree(output_device);
    if (input_device != nullptr) (void)aclrtFree(input_device);
    if (output_host != nullptr) (void)aclrtFreeHost(output_host);
    if (input_host != nullptr) (void)aclrtFreeHost(input_host);
    if (stream != nullptr) (void)aclrtDestroyStream(stream);
    if (device_set) (void)aclrtResetDevice(device_id);
    if (acl_initialized) (void)aclFinalize();
    return succeeded ? 0 : 1;
}
