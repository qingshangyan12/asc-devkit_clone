/* !
 * \file gm2l1_copy_minimal.asc
 * \brief Minimal GM-to-L1 C API copy example with an observable GM output.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t DATA_COUNT = 256;
constexpr uint32_t DATA_BYTES = DATA_COUNT * sizeof(uint16_t);
constexpr uint16_t DATA_BLOCK_COUNT = DATA_BYTES / 32;
constexpr uint32_t PRINT_COUNT = 8;
constexpr int64_t CROSS_CORE_FLAG_ID = 0;
constexpr int64_t TARGET_SUB_BLOCK_ID = 0;

__global__ __mix__(1, 2) void gm2l1_copy_minimal(__gm__ uint16_t* input_gm, __gm__ uint16_t* output_gm)
{
    asc_init();

    // C API allocates on-chip memory through address-space-qualified arrays.
    __cbuf__ uint16_t l1_buffer[DATA_COUNT];
    __ubuf__ uint16_t ub_buffer[DATA_COUNT];

    if ASC_IS_AIC {
        // 1. Copy 512 B from GM to L1 without padding or layout conversion.
        asc_copy_gm2l1(
            (__cbuf__ void*)l1_buffer, (__gm__ void*)input_gm, 1, DATA_BLOCK_COUNT, 0, 0, 0);

        // 2. L1-to-UB is used as the supported observable exit path on dav-3510.
        //    MTE1 must not read L1 until the GM-to-L1 MTE2 transfer has finished.
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12ub(
            (__ubuf__ void*)ub_buffer, (__cbuf__ void*)l1_buffer, static_cast<bool>(TARGET_SUB_BLOCK_ID), 1,
            DATA_BLOCK_COUNT, 0, 0);

        // L1-to-UB runs on AIC, while UB-to-GM runs on AIV. Notify the AIV
        // through the cross-core flag instead of the unsupported MTE1-to-MTE3
        // set_flag pair.
        asc_sync_block_arrive(PIPE_MTE1, CROSS_CORE_FLAG_ID);
    }

    if ASC_IS_AIV {
        // asc_copy_l12ub targets AIV0. Only AIV0 consumes the single cross-core
        // notification and writes the output; AIV1 remains idle.
        if (asc_get_sub_block_id() == TARGET_SUB_BLOCK_ID) {
            asc_sync_block_wait(PIPE_S, CROSS_CORE_FLAG_ID);

            // 3. Copy the unchanged data from UB back to GM so the host can print it.
            asc_copy_ub2gm((__gm__ void*)output_gm, (__ubuf__ void*)ub_buffer, DATA_BYTES);
        }
    }
    asc_sync_pipe(PIPE_ALL);
}

void PrintSample(const char* label, const uint16_t* data)
{
    std::printf("%s (first %u):", label, PRINT_COUNT);
    for (uint32_t index = 0; index < PRINT_COUNT; ++index) {
        std::printf(" 0x%04x", static_cast<unsigned int>(data[index]));
    }
    std::printf("\n");
}

int32_t main()
{
    constexpr int32_t device_id = 0;
    uint16_t* input_host;
    uint16_t* output_host;
    uint16_t* input_device;
    uint16_t* output_device;
    aclrtStream stream;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&input_host), DATA_BYTES);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), DATA_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    for (uint32_t index = 0; index < DATA_COUNT; ++index) {
        input_host[index] = static_cast<uint16_t>(index * 3 + 1);
        output_host[index] = 0;
    }
    aclrtMemcpy(input_device, DATA_BYTES, input_host, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    gm2l1_copy_minimal<<<1, 0, stream>>>(input_device, output_device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host, DATA_BYTES, output_device, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    PrintSample("input", input_host);
    PrintSample("output", output_host);

    aclrtFree(output_device);
    aclrtFree(input_device);
    aclrtFreeHost(output_host);
    aclrtFreeHost(input_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
