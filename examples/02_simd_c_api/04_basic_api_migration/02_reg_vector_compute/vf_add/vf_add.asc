/* !
 * \file vf_add.asc
 * \brief C API migration of tensor_allocation scenario 4: float32 VF vector addition.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <fstream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 1024;
constexpr size_t DATA_BYTES = TOTAL_LENGTH * sizeof(float);

#define ERROR_LOG(fmt, args...) std::fprintf(stdout, "[ERROR] " fmt "\n", ##args)

bool CheckAclStatus(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

bool ReadFile(const char* path, void* buffer, size_t size)
{
    std::ifstream file(path, std::ios::binary);
    if (!file.is_open()) {
        ERROR_LOG("failed to open %s", path);
        return false;
    }
    file.read(static_cast<char*>(buffer), static_cast<std::streamsize>(size));
    if (file.gcount() != static_cast<std::streamsize>(size)) {
        ERROR_LOG("failed to read %s", path);
        return false;
    }
    return true;
}

bool WriteFile(const char* path, const void* buffer, size_t size)
{
    std::ofstream file(path, std::ios::binary);
    if (!file.is_open()) {
        ERROR_LOG("failed to open %s", path);
        return false;
    }
    file.write(static_cast<const char*>(buffer), static_cast<std::streamsize>(size));
    if (!file.good()) {
        ERROR_LOG("failed to write %s", path);
        return false;
    }
    return true;
}

// Equivalent to the Basic API AddVF body. The fixed 1024-element sample is
// an integer number of float VLs, so every iteration can use PAT_ALL.
__simd_vf__ inline void AddVfCapi(__ubuf__ float* x_ub, __ubuf__ float* y_ub, __ubuf__ float* z_ub)
{
    constexpr uint32_t vf_elements = static_cast<uint32_t>(asc_get_vf_len() / sizeof(float));
    vector_bool mask = asc_create_mask_b32(PAT_ALL);
    vector_float x_reg;
    vector_float y_reg;
    vector_float z_reg;

    for (uint32_t offset = 0; offset < TOTAL_LENGTH; offset += vf_elements) {
        asc_load(x_reg, x_ub + offset);
        asc_load(y_reg, y_ub + offset);
        asc_add(z_reg, x_reg, y_reg, mask);
        asc_store(z_ub + offset, z_reg);
    }
}

__vector__ __global__ void vf_add(__gm__ float* x_gm, __gm__ float* y_gm, __gm__ float* z_gm)
{
    asc_init();

    // C API allocates UB with address-space-qualified arrays instead of LocalTensor.
    __ubuf__ float x_ub[TOTAL_LENGTH];
    __ubuf__ float y_ub[TOTAL_LENGTH];
    __ubuf__ float z_ub[TOTAL_LENGTH];

    // The synchronous transfers provide the GM->UB and UB->GM pipeline waits.
    asc_copy_gm2ub_sync(x_ub, x_gm, DATA_BYTES);
    asc_copy_gm2ub_sync(y_ub, y_gm, DATA_BYTES);
    AddVfCapi(x_ub, y_ub, z_ub);
    asc_copy_ub2gm_sync(z_gm, z_ub, DATA_BYTES);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr int32_t device_id = 0;
    uint8_t* x_host = nullptr;
    uint8_t* y_host = nullptr;
    uint8_t* z_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    float* z_device = nullptr;
    aclrtStream stream = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
    int32_t result = 1;

    if (!CheckAclStatus(aclInit(nullptr), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = true;
    if (!CheckAclStatus(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    if (!CheckAclStatus(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    stream_created = true;

    if (!CheckAclStatus(aclrtMallocHost(reinterpret_cast<void**>(&x_host), DATA_BYTES), "aclrtMallocHost(x_host)") ||
        !CheckAclStatus(aclrtMallocHost(reinterpret_cast<void**>(&y_host), DATA_BYTES), "aclrtMallocHost(y_host)") ||
        !CheckAclStatus(aclrtMallocHost(reinterpret_cast<void**>(&z_host), DATA_BYTES), "aclrtMallocHost(z_host)") ||
        !CheckAclStatus(
            aclrtMalloc(reinterpret_cast<void**>(&x_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(x_device)") ||
        !CheckAclStatus(
            aclrtMalloc(reinterpret_cast<void**>(&y_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(y_device)") ||
        !CheckAclStatus(aclrtMalloc(reinterpret_cast<void**>(&z_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(z_device)") ||
        !ReadFile("./input/x.bin", x_host, DATA_BYTES) || !ReadFile("./input/y.bin", y_host, DATA_BYTES) ||
        !CheckAclStatus(aclrtMemcpy(x_device, DATA_BYTES, x_host, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(x_device)") ||
        !CheckAclStatus(aclrtMemcpy(y_device, DATA_BYTES, y_host, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(y_device)")) {
        goto cleanup;
    }

    vf_add<<<1, 0, stream>>>(x_device, y_device, z_device);
    if (!CheckAclStatus(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !CheckAclStatus(aclrtMemcpy(z_host, DATA_BYTES, z_device, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy(z_host)") ||
        !WriteFile("./output/output.bin", z_host, DATA_BYTES)) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (z_device != nullptr && !CheckAclStatus(aclrtFree(z_device), "aclrtFree(z_device)")) {
        result = 1;
    }
    if (y_device != nullptr && !CheckAclStatus(aclrtFree(y_device), "aclrtFree(y_device)")) {
        result = 1;
    }
    if (x_device != nullptr && !CheckAclStatus(aclrtFree(x_device), "aclrtFree(x_device)")) {
        result = 1;
    }
    if (z_host != nullptr && !CheckAclStatus(aclrtFreeHost(z_host), "aclrtFreeHost(z_host)")) {
        result = 1;
    }
    if (y_host != nullptr && !CheckAclStatus(aclrtFreeHost(y_host), "aclrtFreeHost(y_host)")) {
        result = 1;
    }
    if (x_host != nullptr && !CheckAclStatus(aclrtFreeHost(x_host), "aclrtFreeHost(x_host)")) {
        result = 1;
    }
    if (stream_created && !CheckAclStatus(aclrtDestroyStream(stream), "aclrtDestroyStream")) {
        result = 1;
    }
    if (device_set && !CheckAclStatus(aclrtResetDevice(device_id), "aclrtResetDevice")) {
        result = 1;
    }
    if (acl_initialized && !CheckAclStatus(aclFinalize(), "aclFinalize")) {
        result = 1;
    }
    return result;
}
