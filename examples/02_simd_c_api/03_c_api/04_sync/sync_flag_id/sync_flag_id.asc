#include <cstdint>
#include <cstdio>
#include <string_view>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t SUBBLOCK_NUM = 2;
constexpr uint32_t LOGICAL_BLOCK_NUM = 2;
constexpr uint32_t RESULT_NUM = LOGICAL_BLOCK_NUM * (SUBBLOCK_NUM + 1);
constexpr uint32_t RESULT_BYTES = RESULT_NUM * sizeof(uint32_t);
constexpr uint32_t STORAGE_BYTES = RESULT_BYTES * 2;
__aicore__ inline void SubmitMte3Work(__gm__ uint32_t* result)
{
    __ubuf__ uint32_t local[RESULT_NUM];
    __gm__ uint32_t* scratch = result + RESULT_NUM;
    asc_copy_gm2ub_align(local, scratch, RESULT_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(scratch, local, RESULT_BYTES);
}

__global__ __mix__(1, 2) void sync_block_kernel(__gm__ uint32_t* result)
{
    asc_init();
    int64_t arrive_flag_id = 65537;
    uint16_t wait_flag_id = 1;

    if ASC_IS_AIV {
        SubmitMte3Work(result);
        asc_sync_block_arrive(PIPE_MTE3, arrive_flag_id);
        result[block_idx * (SUBBLOCK_NUM + 1) + asc_get_sub_block_id() + 1] = 1;
    }
    if ASC_IS_AIC {
        asc_sync_block_wait(PIPE_MTE1, wait_flag_id);
        result[block_idx * (SUBBLOCK_NUM + 1)] = 1;
    }
    asc_sync_pipe(PIPE_ALL);
}

__global__ __mix__(1, 2) void sync_subblock_kernel(__gm__ uint32_t* result)
{
    asc_init();
    int64_t arrive_flag_id = 65538;
    uint16_t wait_flag_id = 2;

    if ASC_IS_AIV {
        SubmitMte3Work(result);
        asc_sync_subblock_arrive(PIPE_MTE3, arrive_flag_id);
        asc_sync_subblock_wait(PIPE_MTE3, wait_flag_id);
        result[block_idx * SUBBLOCK_NUM + asc_get_sub_block_id()] = 1;
    }
    asc_sync_pipe(PIPE_ALL);
}

__global__ __mix__(1, 2) void sync_inter_kernel(__gm__ uint32_t* result)
{
    asc_init();
    int64_t arrive_flag_id = 65544;
    uint16_t wait_flag_id = 8;

    if ASC_IS_AIV {
        SubmitMte3Work(result);
        asc_sync_inter_arrive(PIPE_MTE3, arrive_flag_id);
        asc_sync_inter_wait(PIPE_MTE3, wait_flag_id);
        result[block_idx * SUBBLOCK_NUM + asc_get_sub_block_id()] = 1;
    }
    asc_sync_pipe(PIPE_ALL);
}

#if __NPU_ARCH__ == 3510
__global__ __mix__(1, 2) void sync_intra_kernel(__gm__ uint32_t* result)
{
    asc_init();
    int64_t arrive_flag_id = 65539;
    uint16_t wait_flag_id = 3;
    if ASC_IS_AIV {
        if (asc_get_sub_block_id() == 0) {
            asc_sync_intra_arrive(PIPE_V, arrive_flag_id);
            result[1] = 1;
        }
    }
    if ASC_IS_AIC {
        asc_sync_intra_wait(PIPE_M, wait_flag_id);
        result[0] = 1;
    }
    asc_sync_pipe(PIPE_ALL);
}
#endif

bool CheckAcl(aclError result, const char* expression, const char* file, int32_t line)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", expression, file, line, result);
    return false;
}

#define CHECK_ACL(expression)                                  \
    do {                                                       \
        if (!CheckAcl((expression), #expression, __FILE__, __LINE__)) { \
            return 1;                                          \
        }                                                      \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    constexpr int32_t DEVICE_ID = 0;
    if (argc != 2) {
        std::fprintf(stderr, "Usage: %s block|subblock|inter|intra\n", argv[0]);
        return 2;
    }
    const std::string_view mode(argv[1]);
    std::vector<uint32_t> result(RESULT_NUM, 0);
    uint32_t* result_device = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&result_device), STORAGE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(result_device, STORAGE_BYTES, 0, STORAGE_BYTES));

    auto verify_result = [&]() {
        if (!CheckAcl(aclrtMemcpy(result.data(), RESULT_BYTES, result_device, RESULT_BYTES,
                                 ACL_MEMCPY_DEVICE_TO_HOST),
                      "aclrtMemcpy", __FILE__, __LINE__)) {
            return false;
        }
        for (uint32_t value : result) {
            if (value == 1) {
                return true;
            }
        }
        std::fprintf(stderr, "[ERROR] no core wrote a completion marker\n");
        return false;
    };

    if (mode == "block") {
        sync_block_kernel<<<LOGICAL_BLOCK_NUM, 0, stream>>>(result_device);
    } else if (mode == "subblock") {
        sync_subblock_kernel<<<LOGICAL_BLOCK_NUM, 0, stream>>>(result_device);
    } else if (mode == "inter") {
        sync_inter_kernel<<<LOGICAL_BLOCK_NUM, 0, stream>>>(result_device);
#if __NPU_ARCH__ == 3510
    } else if (mode == "intra") {
        sync_intra_kernel<<<LOGICAL_BLOCK_NUM, 0, stream>>>(result_device);
#endif
    } else {
        std::fprintf(stderr, "Unsupported sync mode: %s\n", argv[1]);
        return 2;
    }

    CHECK_ACL(aclrtSynchronizeStream(stream));
    if (!verify_result()) {
        return 1;
    }
    std::fprintf(stderr, "%s sync pass\n", argv[1]);

    CHECK_ACL(aclrtFree(result_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());
    std::printf("sync flag_id test pass\n");
    return 0;
}
