/* !
 * \file matmul.asc
 * \brief Single-core Cube MatMul implemented with Ascend C C APIs.
 *        C[30, 70] = A[30, 40] * B[40, 70] + Bias[1, 70], all tensors are float.
 */

#include "acl/acl.h"
#include "c_api/cube_compute/cube_compute.h"
#include "c_api/cube_datamove/cube_datamove.h"
#include "c_api/misc/misc.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"
#include "data_utils.h"

#ifndef ceil_div
#define ceil_div(a, b) (((a) + (b) - 1) / (b))
#define ceil_align(a, b) (ceil_div(a, b) * (b))
#endif

constexpr uint32_t M = 30;
constexpr uint32_t K = 40;
constexpr uint32_t N = 70;

constexpr uint32_t BLOCK_CUBE = 16;
constexpr uint32_t C0_SIZE = 8; // One 32-byte block contains eight float values.
constexpr uint32_t FRACTAL_NUM = 2; // Two 16 x 8 fractals form a 16 x 16 square for transpose.

constexpr uint32_t M_ALIGN = ceil_align(M, BLOCK_CUBE);
constexpr uint32_t K_ALIGN_A = ceil_align(K, C0_SIZE);
constexpr uint32_t K_ALIGN_B = ceil_align(K, BLOCK_CUBE);
constexpr uint32_t N_ALIGN = ceil_align(N, C0_SIZE * FRACTAL_NUM);

constexpr uint32_t A_L1_SIZE = M_ALIGN * K_ALIGN_A;
constexpr uint32_t A_L0_SIZE = M_ALIGN * K_ALIGN_A;
constexpr uint32_t B_L1_SIZE = K_ALIGN_B * N_ALIGN;
constexpr uint32_t B_L0_SIZE = K_ALIGN_B * N_ALIGN;
constexpr uint32_t C_L0_SIZE = M_ALIGN * ceil_align(N, BLOCK_CUBE);

// C1 -> C2 on Ascend 950 requires a 32-byte block count that is even for b32 data.
constexpr uint32_t BIAS_BYTES = ceil_align(ceil_div(N * sizeof(float), 32), 2) * 32;
constexpr uint32_t BIAS_ELEMS = BIAS_BYTES / sizeof(float);

__aicore__ inline void copy_matrix_a_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    uint64_t config = (static_cast<uint64_t>(0) << 48) | (static_cast<uint64_t>(M_ALIGN) << 32) |
                      (static_cast<uint64_t>(1) << 16) | static_cast<uint64_t>(1);
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, K * sizeof(float), 0, M, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
}

__aicore__ inline void copy_matrix_b_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    uint64_t config = (static_cast<uint64_t>(0) << 48) | (static_cast<uint64_t>(K_ALIGN_B) << 32) |
                      (static_cast<uint64_t>(1) << 16) | static_cast<uint64_t>(1);
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, K, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
}

__aicore__ inline void copy_bias_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    uint64_t config = (static_cast<uint64_t>(0) << 48) | (static_cast<uint64_t>(1) << 32) |
                      (static_cast<uint64_t>(1) << 16) | static_cast<uint64_t>(1);
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, 1, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
}

__aicore__ inline void copy_matrix_a_to_l0a(__ca__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    constexpr uint16_t m_start_position = 0;
    constexpr uint16_t k_start_position = 0;
    constexpr uint8_t m_step = ceil_div(M_ALIGN, BLOCK_CUBE);
    constexpr uint8_t k_step = ceil_div(K_ALIGN_A, C0_SIZE);
    constexpr int16_t src_stride = ceil_div(M_ALIGN, BLOCK_CUBE);
    constexpr uint16_t dst_stride = ceil_div(M_ALIGN, BLOCK_CUBE);

    asc_copy_l12l0a(dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
}

__aicore__ inline void copy_matrix_b_to_l0b(__cb__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);

    // B is [K, N] in GM/L1. Load2Dv2 transposes the small fractals while writing the Zn layout required by L0B.
    constexpr uint16_t m_start_position = 0;
    constexpr uint16_t k_start_position = 0;
    constexpr uint8_t m_step = ceil_div(K_ALIGN_B, BLOCK_CUBE);
    constexpr uint8_t k_step = ceil_div(N_ALIGN, C0_SIZE);
    constexpr int16_t src_stride = ceil_div(K_ALIGN_B, BLOCK_CUBE);
    constexpr uint16_t dst_stride = ceil_div(N_ALIGN, BLOCK_CUBE);

    static_assert(k_step % FRACTAL_NUM == 0, "float transpose requires k_step to be even");
    asc_copy_l12l0b_transpose(
        dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
}

__aicore__ inline void copy_bias_to_bt(__cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
    asc_copy_l12bt(0, src, BIAS_BYTES);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID2);
}

__aicore__ inline void compute_matmul(__cc__ float* dst, __ca__ float* a, __cb__ float* b)
{
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID2);

    constexpr uint8_t unit_flag = 0;
    constexpr bool disable_gemv = true;
    constexpr bool c_matrix_source = true; // Initialize C from BiasTable Buffer.
    constexpr bool c_matrix_init_val = false;

    // HF32 is intentionally not enabled: the task requests FLOAT behavior and has no performance requirement.
    asc_mmad(
        dst, a, b, M, K, N, unit_flag, disable_gemv, c_matrix_source, c_matrix_init_val);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
}

__aicore__ inline void copy_result_to_gm(__gm__ float* dst, __cc__ float* src)
{
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);

    asc_copy_l0c2gm(
        dst, src, N, M, N, M_ALIGN, 0, 0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false, false);
}

__global__ __cube__ void matmul_custom(
    __gm__ float* src0, __gm__ float* src1, __gm__ float* weight, __gm__ float* dst)
{
    asc_init();

    __cbuf__ float a_l1[A_L1_SIZE];
    __cbuf__ float b_l1[B_L1_SIZE];
    __cbuf__ float bias_l1[BIAS_ELEMS];
    __ca__ float a_l0[A_L0_SIZE];
    __cb__ float b_l0[B_L0_SIZE];
    __cc__ float c_l0[C_L0_SIZE];

    copy_matrix_a_to_l1(a_l1, src0);
    copy_matrix_b_to_l1(b_l1, src1);
    copy_bias_to_l1(bias_l1, weight);

    copy_matrix_a_to_l0a(a_l0, a_l1);
    copy_matrix_b_to_l0b(b_l0, b_l1);
    copy_bias_to_bt(bias_l1);

    compute_matmul(c_l0, a_l0, b_l0);
    copy_result_to_gm(dst, c_l0);
    asc_sync_pipe(PIPE_ALL);
}

inline bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t a_file_size = M * K * sizeof(float);
    constexpr size_t b_file_size = K * N * sizeof(float);
    constexpr size_t bias_file_size = N * sizeof(float);
    constexpr size_t c_file_size = M * N * sizeof(float);
    constexpr int32_t device_id = 0;

    float* a_host = nullptr;
    float* b_host = nullptr;
    float* bias_host = nullptr;
    float* c_host = nullptr;
    float* a_device = nullptr;
    float* b_device = nullptr;
    float* bias_device = nullptr;
    float* c_device = nullptr;
    aclrtStream stream = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
    int32_t result = 1;

    if (!check_acl_status(aclInit(nullptr), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = true;
    if (!check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    if (!check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    stream_created = true;

    if (!check_acl_status(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size), "aclrtMallocHost(A)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(A)") ||
        !ReadFile("./input/src0.bin", a_host, a_file_size) ||
        !check_acl_status(
            aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(A)")) {
        goto cleanup;
    }

    if (!check_acl_status(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size), "aclrtMallocHost(B)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(B)") ||
        !ReadFile("./input/src1.bin", b_host, b_file_size) ||
        !check_acl_status(
            aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(B)")) {
        goto cleanup;
    }

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&bias_host), bias_file_size), "aclrtMallocHost(Bias)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(Bias)") ||
        !ReadFile("./input/weight.bin", bias_host, bias_file_size) ||
        !check_acl_status(
            aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(Bias)")) {
        goto cleanup;
    }

    if (!check_acl_status(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size), "aclrtMallocHost(C)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(C)")) {
        goto cleanup;
    }

    matmul_custom<<<1, 0, stream>>>(a_device, b_device, bias_device, c_device);
    if (!check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl_status(
            aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(C)") ||
        !WriteFile("./output/output.bin", c_host, c_file_size)) {
        goto cleanup;
    }

    result = 0;

cleanup:
    if (c_device != nullptr && !check_acl_status(aclrtFree(c_device), "aclrtFree(C)")) {
        result = 1;
    }
    if (c_host != nullptr && !check_acl_status(aclrtFreeHost(c_host), "aclrtFreeHost(C)")) {
        result = 1;
    }
    if (bias_device != nullptr && !check_acl_status(aclrtFree(bias_device), "aclrtFree(Bias)")) {
        result = 1;
    }
    if (bias_host != nullptr && !check_acl_status(aclrtFreeHost(bias_host), "aclrtFreeHost(Bias)")) {
        result = 1;
    }
    if (b_device != nullptr && !check_acl_status(aclrtFree(b_device), "aclrtFree(B)")) {
        result = 1;
    }
    if (b_host != nullptr && !check_acl_status(aclrtFreeHost(b_host), "aclrtFreeHost(B)")) {
        result = 1;
    }
    if (a_device != nullptr && !check_acl_status(aclrtFree(a_device), "aclrtFree(A)")) {
        result = 1;
    }
    if (a_host != nullptr && !check_acl_status(aclrtFreeHost(a_host), "aclrtFreeHost(A)")) {
        result = 1;
    }
    if (stream_created && !check_acl_status(aclrtDestroyStream(stream), "aclrtDestroyStream")) {
        result = 1;
    }
    if (device_set && !check_acl_status(aclrtResetDevice(device_id), "aclrtResetDevice")) {
        result = 1;
    }
    if (acl_initialized && !check_acl_status(aclFinalize(), "aclFinalize")) {
        result = 1;
    }
    return result;
}
