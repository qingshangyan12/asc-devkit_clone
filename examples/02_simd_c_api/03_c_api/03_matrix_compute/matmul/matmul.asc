/* !
 * \file matmul.asc
 * \brief Single-Cube-Core FP32 matrix multiplication: C[30, 70] = A[30, 40] * B[40, 70] + bias[70].
 */

#include "c_api/asc_simd.h"
#include "acl/acl.h"
#include "data_utils.h"

constexpr uint32_t M = 30;
constexpr uint32_t K = 40;
constexpr uint32_t N = 70;
constexpr uint32_t BLOCK_CUBE = 16;
constexpr uint32_t FP32_K0 = 8;
constexpr uint32_t FP32_FRACTAL_NUM = 2;

#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))
#define CEIL_ALIGN(a, b) (CEIL_DIV(a, b) * (b))

constexpr uint32_t A_L1_ELEMENTS = CEIL_ALIGN(M, BLOCK_CUBE) * CEIL_ALIGN(K, FP32_K0);
constexpr uint32_t B_L1_ELEMENTS = CEIL_ALIGN(K, BLOCK_CUBE* FP32_FRACTAL_NUM) * CEIL_ALIGN(N, FP32_K0);
constexpr uint32_t A_L0_ELEMENTS = CEIL_ALIGN(M, BLOCK_CUBE) * CEIL_ALIGN(K, FP32_K0);
constexpr uint32_t B_L0_ELEMENTS = CEIL_ALIGN(K, FP32_K0) * CEIL_ALIGN(N, BLOCK_CUBE* FP32_FRACTAL_NUM);
constexpr uint32_t C_L0_ELEMENTS = CEIL_ALIGN(M, BLOCK_CUBE) * CEIL_ALIGN(N, BLOCK_CUBE);
// C1 -> BiasTable requires an even number of 32-byte blocks for b32 on dav-3510.
constexpr uint32_t BIAS_BYTES = CEIL_ALIGN(CEIL_DIV(N * sizeof(float), 32), 2) * 32;
constexpr uint32_t BIAS_ELEMENTS = BIAS_BYTES / sizeof(float);

__aicore__ inline void copy_a_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config =
        (static_cast<uint64_t>(CEIL_ALIGN(M, BLOCK_CUBE)) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, K * sizeof(float), 0, M, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
}

__aicore__ inline void copy_b_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(CEIL_ALIGN(K, BLOCK_CUBE * FP32_FRACTAL_NUM)) << 32) |
                            (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, K, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
}

__aicore__ inline void copy_bias_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(1) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, 1, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
}

__aicore__ inline void copy_a_l1_to_l0a(__ca__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    const uint8_t mStep = CEIL_DIV(M, BLOCK_CUBE);
    const uint8_t kStep = CEIL_DIV(K, FP32_K0);
    asc_copy_l12l0a(dst, src, 0, 0, mStep, kStep, mStep, mStep);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
}

__aicore__ inline void copy_b_l1_to_l0b(__cb__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);

    const uint8_t mStep = CEIL_DIV(K, BLOCK_CUBE);
    const uint8_t kStep = CEIL_ALIGN(CEIL_DIV(N, FP32_K0), 2);
    const int16_t srcStride = CEIL_DIV(CEIL_ALIGN(K, BLOCK_CUBE * FP32_FRACTAL_NUM), BLOCK_CUBE);
    const uint16_t dstStride = CEIL_DIV(N, FP32_K0 * FP32_FRACTAL_NUM);
    asc_copy_l12l0b_transpose(dst, src, 0, 0, mStep, kStep, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
}

__aicore__ inline void copy_bias_l1_to_bt(__cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
    asc_copy_l12bt(0, src, 0, 1, BIAS_BYTES / 32, 0, 0);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID2);
}

__aicore__ inline void compute_matmul(__cc__ float* dst, __ca__ float* lhs, __cb__ float* rhs)
{
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID2);

    // Keep FP32 operands in FP32 mode instead of enabling HF32 conversion.
    asc_set_fp32_mode();
    asc_mmad(dst, lhs, rhs, M, K, CEIL_ALIGN(N, BLOCK_CUBE), 0, false, true, false);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
}

__aicore__ inline void copy_c_l0c_to_gm(__gm__ float* dst, __cc__ float* src)
{
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(
        dst, src, N, M, N, CEIL_ALIGN(M, BLOCK_CUBE), 0, 0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false,
        false);
}

__global__ __cube__ void matmul_custom(__gm__ float* src0, __gm__ float* src1, __gm__ float* weight, __gm__ float* dst)
{
    asc_init();

    __cbuf__ float aL1[A_L1_ELEMENTS];
    __cbuf__ float bL1[B_L1_ELEMENTS];
    __cbuf__ float biasL1[BIAS_ELEMENTS];
    copy_a_gm_to_l1(aL1, src0);
    copy_b_gm_to_l1(bL1, src1);
    copy_bias_gm_to_l1(biasL1, weight);

    __ca__ float aL0[A_L0_ELEMENTS];
    __cb__ float bL0[B_L0_ELEMENTS];
    copy_a_l1_to_l0a(aL0, aL1);
    copy_b_l1_to_l0b(bL0, bL1);
    copy_bias_l1_to_bt(biasL1);

    __cc__ float cL0[C_L0_ELEMENTS];
    compute_matmul(cL0, aL0, bL0);
    copy_c_l0c_to_gm(dst, cL0);

    asc_sync_pipe(PIPE_ALL);
}

inline bool CheckAcl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    ERROR_LOG("%s failed, error code %d", operation, static_cast<int32_t>(status));
    return false;
}

int32_t main()
{
    constexpr size_t aBytes = M * K * sizeof(float);
    constexpr size_t bBytes = K * N * sizeof(float);
    constexpr size_t biasBytes = N * sizeof(float);
    constexpr size_t cBytes = M * N * sizeof(float);

    float* aHost = nullptr;
    float* bHost = nullptr;
    float* biasHost = nullptr;
    float* cHost = nullptr;
    float* aDevice = nullptr;
    float* bDevice = nullptr;
    float* biasDevice = nullptr;
    float* cDevice = nullptr;
    aclrtStream stream = nullptr;
    int32_t result = 1;

    if (!CheckAcl(aclInit(nullptr), "aclInit") || !CheckAcl(aclrtSetDevice(0), "aclrtSetDevice") ||
        !CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&aHost), aBytes), "aclrtMallocHost(src0)") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&bHost), bBytes), "aclrtMallocHost(src1)") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&biasHost), biasBytes), "aclrtMallocHost(weight)") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&cHost), cBytes), "aclrtMallocHost(dst)") ||
        !CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&aDevice), aBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(src0)") ||
        !CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&bDevice), bBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(src1)") ||
        !CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&biasDevice), biasBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(weight)") ||
        !CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&cDevice), cBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(dst)")) {
        goto cleanup;
    }

    if (!ReadFile("./input/src0.bin", aHost, aBytes) || !ReadFile("./input/src1.bin", bHost, bBytes) ||
        !ReadFile("./input/weight.bin", biasHost, biasBytes)) {
        goto cleanup;
    }
    if (!CheckAcl(aclrtMemcpy(aDevice, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy src0 H2D") ||
        !CheckAcl(aclrtMemcpy(bDevice, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy src1 H2D") ||
        !CheckAcl(
            aclrtMemcpy(biasDevice, biasBytes, biasHost, biasBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy weight H2D")) {
        goto cleanup;
    }

    matmul_custom<<<1, 0, stream>>>(aDevice, bDevice, biasDevice, cDevice);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !CheckAcl(aclrtMemcpy(cHost, cBytes, cDevice, cBytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy dst D2H") ||
        !WriteFile("./output/output.bin", cHost, cBytes)) {
        goto cleanup;
    }
    result = 0;

cleanup:
    if (aDevice != nullptr)
        aclrtFree(aDevice);
    if (bDevice != nullptr)
        aclrtFree(bDevice);
    if (biasDevice != nullptr)
        aclrtFree(biasDevice);
    if (cDevice != nullptr)
        aclrtFree(cDevice);
    if (aHost != nullptr)
        aclrtFreeHost(aHost);
    if (bHost != nullptr)
        aclrtFreeHost(bHost);
    if (biasHost != nullptr)
        aclrtFreeHost(biasHost);
    if (cHost != nullptr)
        aclrtFreeHost(cHost);
    if (stream != nullptr)
        aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return result;
}
