/* !
 * \file matmul.asc
 * \brief Single-Cube FP32 MatMul: C[30,70] = A[30,40] * B[40,70] + bias[70].
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

#include <cerrno>
#include <cstdio>
#include <sys/stat.h>

constexpr uint32_t M = 30;
constexpr uint32_t K = 40;
constexpr uint32_t N = 70;
constexpr uint32_t BLOCK_CUBE = 16;
constexpr uint32_t C0_SIZE = 8;

constexpr uint32_t A_L1_SIZE = 1280;
constexpr uint32_t A_L0_SIZE = 1280;
constexpr uint32_t B_L1_SIZE = 3200;
constexpr uint32_t B_L0_SIZE = 3200;
constexpr uint32_t C_L0_SIZE = 2560;
constexpr uint32_t BIAS_BYTES = 320;
constexpr uint32_t BIAS_ELEMENTS = BIAS_BYTES / sizeof(float);
constexpr uint32_t L1_BYTES = (A_L1_SIZE + B_L1_SIZE + BIAS_ELEMENTS) * sizeof(float);
constexpr uint32_t L0A_BYTES = A_L0_SIZE * sizeof(float);
constexpr uint32_t L0B_BYTES = B_L0_SIZE * sizeof(float);
constexpr uint32_t L0C_BYTES = C_L0_SIZE * sizeof(float);

constexpr uint32_t L1_CAPACITY_BYTES = 512 * 1024;
constexpr uint32_t L0A_CAPACITY_BYTES = 64 * 1024;
constexpr uint32_t L0B_CAPACITY_BYTES = 64 * 1024;
constexpr uint32_t L0C_CAPACITY_BYTES = 256 * 1024;
constexpr uint32_t BIAS_TABLE_CAPACITY_BYTES = 4 * 1024;

static_assert(A_L1_SIZE * sizeof(float) == 5120);
static_assert(B_L1_SIZE * sizeof(float) == 12800);
static_assert(B_L0_SIZE * sizeof(float) == 12800);
static_assert(C_L0_SIZE * sizeof(float) == 10240);
static_assert(BIAS_ELEMENTS == 80);
static_assert(L1_BYTES == 18240);
static_assert(L1_BYTES <= L1_CAPACITY_BYTES);
static_assert(L0A_BYTES <= L0A_CAPACITY_BYTES);
static_assert(L0B_BYTES <= L0B_CAPACITY_BYTES);
static_assert(L0C_BYTES <= L0C_CAPACITY_BYTES);
static_assert(BIAS_BYTES <= BIAS_TABLE_CAPACITY_BYTES);

__aicore__ inline void copy_a_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(32) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, K * sizeof(float), 0, M, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
}

__aicore__ inline void copy_b_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(80) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_dn2nz(dst, src, N * sizeof(float), 0, N, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
}

__aicore__ inline void copy_bias_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(1) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, 1, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
}

__aicore__ inline void copy_a_l1_to_l0a(__ca__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_copy_l12l0a(dst, src, 0, 0, 2, 5, 2, 2);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
}

__aicore__ inline void copy_b_l1_to_l0b(__cb__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
    asc_copy_l12l0b(dst, src, 0, 0, 5, 5, 5, 5);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
}

__aicore__ inline void copy_bias_l1_to_bt(__cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
    asc_copy_l12bt(0, src, 0, 1, BIAS_BYTES / 32, 0, 0);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID2);
}

__aicore__ inline void compute_mmad(
    __cc__ float* cMatrix, __ca__ float* aMatrix, __cb__ float* bMatrix)
{
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID2);

    asc_mmad(cMatrix, aMatrix, bMatrix, M, K, N, 0, true, true, false);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
}

__aicore__ inline void copy_c_l0c_to_gm(__gm__ float* dst, __cc__ float* src)
{
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(
        dst, src, N, M, N, 32, 0, 0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false, false);
}

__global__ __cube__ void matmul_custom(
    __gm__ float* src0, __gm__ float* src1, __gm__ float* weight, __gm__ float* dst)
{
    asc_init();

    __cbuf__ float aL1[A_L1_SIZE];
    __cbuf__ float bL1[B_L1_SIZE];
    __cbuf__ float biasL1[BIAS_ELEMENTS];
    __ca__ float aL0[A_L0_SIZE];
    __cb__ float bL0[B_L0_SIZE];
    __cc__ float cL0[C_L0_SIZE];

    copy_a_gm_to_l1(aL1, src0);
    copy_b_gm_to_l1(bL1, src1);
    copy_bias_gm_to_l1(biasL1, weight);
    copy_a_l1_to_l0a(aL0, aL1);
    copy_b_l1_to_l0b(bL0, bL1);
    copy_bias_l1_to_bt(biasL1);
    compute_mmad(cL0, aL0, bL0);
    copy_c_l0c_to_gm(dst, cL0);

    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(call)                                                                                              \
    do {                                                                                                             \
        const aclError aclResult = (call);                                                                           \
        if (aclResult != ACL_SUCCESS) {                                                                               \
            std::fprintf(stderr, "[ERROR] %s failed with %d\n", #call, static_cast<int>(aclResult));                \
            status = 1;                                                                                               \
            goto cleanup;                                                                                             \
        }                                                                                                             \
    } while (0)

#define CHECK_ACL_CLEANUP(call)                                                                                      \
    do {                                                                                                             \
        const aclError aclResult = (call);                                                                           \
        if (aclResult != ACL_SUCCESS) {                                                                               \
            std::fprintf(stderr, "[ERROR] cleanup %s failed with %d\n", #call, static_cast<int>(aclResult));        \
            status = 1;                                                                                               \
        }                                                                                                             \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t aBytes = M * K * sizeof(float);
    constexpr size_t bBytes = K * N * sizeof(float);
    constexpr size_t biasBytes = N * sizeof(float);
    constexpr size_t cBytes = M * N * sizeof(float);
    uint32_t num_blocks = 1;
    int32_t status = 0;
    int32_t deviceId = 0;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    float* aHost = nullptr;
    float* bHost = nullptr;
    float* biasHost = nullptr;
    float* cHost = nullptr;
    float* aDevice = nullptr;
    float* bDevice = nullptr;
    float* biasDevice = nullptr;
    float* cDevice = nullptr;

    CHECK_ACL(aclInit(nullptr));
    aclInitialized = true;
    CHECK_ACL(aclrtSetDevice(deviceId));
    deviceSet = true;
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&aHost), aBytes));
    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&bHost), bBytes));
    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&biasHost), biasBytes));
    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&cHost), cBytes));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&aDevice), aBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&bDevice), bBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&biasDevice), biasBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&cDevice), cBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    if (!ReadFileExact("./input/x1_gm.bin", aHost, aBytes) ||
        !ReadFileExact("./input/x2_gm.bin", bHost, bBytes) ||
        !ReadFileExact("./input/bias_gm.bin", biasHost, biasBytes)) {
        status = 1;
        goto cleanup;
    }

    CHECK_ACL(aclrtMemcpy(aDevice, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(bDevice, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(biasDevice, biasBytes, biasHost, biasBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    matmul_custom<<<num_blocks, 0, stream>>>(aDevice, bDevice, biasDevice, cDevice);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(cHost, cBytes, cDevice, cBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    if (mkdir("./output", S_IRWXU) != 0 && errno != EEXIST) {
        std::fprintf(stderr, "[ERROR] failed to create output directory\n");
        status = 1;
        goto cleanup;
    }
    if (!WriteFileExact("./output/output.bin", cHost, cBytes)) {
        status = 1;
    }

cleanup:
    if (cDevice != nullptr) CHECK_ACL_CLEANUP(aclrtFree(cDevice));
    if (biasDevice != nullptr) CHECK_ACL_CLEANUP(aclrtFree(biasDevice));
    if (bDevice != nullptr) CHECK_ACL_CLEANUP(aclrtFree(bDevice));
    if (aDevice != nullptr) CHECK_ACL_CLEANUP(aclrtFree(aDevice));
    if (cHost != nullptr) CHECK_ACL_CLEANUP(aclrtFreeHost(cHost));
    if (biasHost != nullptr) CHECK_ACL_CLEANUP(aclrtFreeHost(biasHost));
    if (bHost != nullptr) CHECK_ACL_CLEANUP(aclrtFreeHost(bHost));
    if (aHost != nullptr) CHECK_ACL_CLEANUP(aclrtFreeHost(aHost));
    if (stream != nullptr) CHECK_ACL_CLEANUP(aclrtDestroyStream(stream));
    if (deviceSet) CHECK_ACL_CLEANUP(aclrtResetDevice(deviceId));
    if (aclInitialized) CHECK_ACL_CLEANUP(aclFinalize());
    return status;
}
