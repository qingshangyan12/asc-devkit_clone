/* !
 * \file matmul.asc
 * \brief C API 矩阵乘法样例：float 输入输出、A/B 均不转置、带 Bias
 *        C[30, 70] = A[30, 40] * B[40, 70] + bias[70]
 */

#include <cstring>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

#ifndef CEIL_DIV
#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))
#define CEIL_ALIGN(a, b) (CEIL_DIV((a), (b)) * (b))
#endif

// ========== 矩阵维度 ==========
// 修改这三个值即可换算例，本文件内所有分形参数、步长与 Buffer 大小均由它们推导；
// 需同步修改 scripts/gen_data.py 中的 m/k/n，并确认各级 Buffer 未超出硬件容量。
constexpr uint32_t M = 30;
constexpr uint32_t K = 40;
constexpr uint32_t N = 70;

// ========== 常量与各级 Buffer 大小 ==========
constexpr uint32_t BLOCK_CUBE = 16;         // 分形在行方向的元素个数
constexpr uint32_t DATA_BLOCK_BYTES = 32;   // 一个 DataBlock 的字节数
constexpr uint32_t BT_ALIGN_BYTES = 64;     // BiasTable Buffer 的对齐要求
constexpr uint32_t C0_SIZE = DATA_BLOCK_BYTES / sizeof(float); // 分形的 C0 长度

// Nz 排布下各轴的对齐长度：M / N 轴按 BLOCK_CUBE 对齐，K 轴按 C0 对齐
constexpr uint32_t M_ALIGN = CEIL_ALIGN(M, BLOCK_CUBE);
constexpr uint32_t N_ALIGN = CEIL_ALIGN(N, BLOCK_CUBE);
constexpr uint32_t K_ALIGN = CEIL_ALIGN(K, C0_SIZE);

// L1 与 L0 两级的对齐规则在本例中恰好一致，换数据类型后会分叉，因此分别写全
constexpr uint32_t A_L1_SIZE = M_ALIGN * K_ALIGN;
constexpr uint32_t A_L0_SIZE = M_ALIGN * K_ALIGN;
constexpr uint32_t B_L1_SIZE = K_ALIGN * N_ALIGN;
constexpr uint32_t B_L0_SIZE = K_ALIGN * N_ALIGN;
constexpr uint32_t C_L0_SIZE = M_ALIGN * N_ALIGN;
// 搬入 BiasTable 的数据量需满足 64B 对齐，且整个区间都会被读取，
// 故 bias 在 GM 侧就补零到该大小，避免把未初始化的 L1 数据带进 BT。
constexpr uint32_t BIAS_BYTES = CEIL_ALIGN(N * sizeof(float), BT_ALIGN_BYTES);
constexpr uint32_t BIAS_ELEMS = BIAS_BYTES / sizeof(float);

// ========== 阶段1：GM → L1 ==========

// nd2nz / dn2nz 只在 L1 最内层（K 方向）补零，M / N 方向的对齐补齐行不会被写入，
// 却会随 L0A / L0B 的整块搬运进入 Cube，故显式清零。一个 C0 分形行即一个 32B DataBlock。
__aicore__ inline void fill_padding_rows_in_l1(__cbuf__ float* dst, uint32_t valid_rows, uint32_t align_rows)
{
    asc_fill_value_config config;
    config.repeat = K_ALIGN / C0_SIZE;        // C0 列的个数
    config.blk_num = align_rows - valid_rows; // 每个 C0 列尾部的补齐行数
    config.dst_gap = valid_rows;              // 跳过该 C0 列中已写入的行

    asc_fill_l1(dst + valid_rows * C0_SIZE, 0U, config);
}

__aicore__ inline void copy_matrix_a_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    // bit 47:32 为目的 Nz 矩阵的 C0 列高度，A 的行数按 BLOCK_CUBE 对齐
    uint64_t config = (static_cast<uint64_t>(M_ALIGN) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);

    uint64_t loop1_src_stride = K * sizeof(float);
    uint8_t l2_cache_ctl = 0;
    uint16_t n_value = M;
    uint32_t d_value = K;
    uint64_t loop4_src_stride = 0;
    bool smallc0_en = false;

    asc_copy_gm2l1_nd2nz(dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, smallc0_en);
    fill_padding_rows_in_l1(dst, M, M_ALIGN); // 与拷贝同属 PIPE_MTE2，按序执行

    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
}

__aicore__ inline void copy_matrix_b_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    // B 走 dn2nz，N 轴充当 Nz 的行方向，按 BLOCK_CUBE 对齐
    uint64_t config = (static_cast<uint64_t>(N_ALIGN) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);

    uint64_t loop1_src_stride = N * sizeof(float);
    uint8_t l2_cache_ctl = 0;
    uint16_t n_value = N;
    uint32_t d_value = K;
    uint64_t loop4_src_stride = 0;
    bool smallc0_en = false;

    asc_copy_gm2l1_dn2nz(dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, smallc0_en);
    fill_padding_rows_in_l1(dst, N, N_ALIGN);

    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
}

__aicore__ inline void copy_bias_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    // bias 只有一行，C0 列高度为 1，各 C0 分块首尾相接
    uint64_t config = (static_cast<uint64_t>(1) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);

    uint64_t loop1_src_stride = BIAS_ELEMS * sizeof(float);
    uint8_t l2_cache_ctl = 0;
    uint16_t n_value = 1;
    // 搬运补零后的全部元素，保证后续 BT 读取的 L1 区间已被完整写入
    uint32_t d_value = BIAS_ELEMS;
    uint64_t loop4_src_stride = 0;
    bool smallc0_en = false;

    asc_copy_gm2l1_nd2nz(dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, smallc0_en);

    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
}

// ========== 阶段2：L1 → L0A / L0B / BT ==========

__aicore__ inline void split_matrix_a_to_l0a(__ca__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    uint16_t m_start_position = 0;
    uint16_t k_start_position = 0;
    uint8_t m_step = M_ALIGN / BLOCK_CUBE;
    uint8_t k_step = K_ALIGN / C0_SIZE;
    // K 方向相邻分形的间隔：L1 上一个 C0 列包含 M_ALIGN / BLOCK_CUBE 个分形
    int16_t src_stride = M_ALIGN / BLOCK_CUBE;
    uint16_t dst_stride = M_ALIGN / BLOCK_CUBE;

    asc_copy_l12l0a(dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride);

    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
}

__aicore__ inline void split_matrix_b_to_l0b(__cb__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);

    uint16_t m_start_position = 0;
    uint16_t k_start_position = 0;
    // 对 B 而言，指令中的 "M 轴" 即 N 轴
    uint8_t m_step = N_ALIGN / BLOCK_CUBE;
    uint8_t k_step = K_ALIGN / C0_SIZE;
    int16_t src_stride = N_ALIGN / BLOCK_CUBE;
    uint16_t dst_stride = N_ALIGN / BLOCK_CUBE;

    asc_copy_l12l0b(dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride);

    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
}

__aicore__ inline void split_bias_to_bt(__cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);

    uint64_t dst = 0;
    uint16_t conv_control = 0;
    uint16_t n_burst = 1;
    uint16_t len_burst = static_cast<uint16_t>(BIAS_BYTES / DATA_BLOCK_BYTES);
    uint16_t source_gap = 0;
    uint16_t dst_gap = 0;

    asc_copy_l12bt(dst, src, conv_control, n_burst, len_burst, source_gap, dst_gap);

    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID2);
}

// ========== 阶段3：矩阵乘加 ==========

__aicore__ inline void compute_mmad(__cc__ float* c_matrix, __ca__ float* a_matrix, __cb__ float* b_matrix)
{
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID2);

    // CTRL[46]（HF32 模式位）在核间是常驻的，若上一个核开启过 HF32，本例的 fp32
    // 数据会在 Mmad 前被舍入到 HF32 精度。这里显式关闭，保证样例自洽。
    asc_set_fp32_mode();

    uint16_t left_height = M;
    uint16_t n_dim = K;
    uint16_t right_width = N;
    uint8_t unit_flag = 0;
    bool disable_gemv = true;
    bool c_matrix_source = true;
    bool c_matrix_init_val = false;

    asc_mmad(
        c_matrix, a_matrix, b_matrix, left_height, n_dim, right_width, unit_flag, disable_gemv, c_matrix_source,
        c_matrix_init_val);

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
}

// ========== 阶段4：L0C → GM ==========

__aicore__ inline void copy_result_to_gm(__gm__ float* dst, __cc__ float* src)
{
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

    // dst_nd_stride 为目的相邻 ND 矩阵的偏移（单位为元素），取值范围 [1, 2^32-1]，不能写 0
    uint64_t nd_num = 1;
    uint64_t src_nd_stride = 0;
    uint64_t dst_nd_stride = M * N;

    asc_set_l0c2gm_nz2nd(nd_num, src_nd_stride, dst_nd_stride);

    uint16_t n_size = N;
    uint16_t m_size = M;
    uint32_t loop_dst_stride = N;
    // 源 Nz 矩阵中相邻 Z 排布的起始地址偏移，等于 L0C 上按 BLOCK_CUBE 对齐后的行数
    uint16_t loop_src_stride = M_ALIGN;
    uint8_t l2_cache_ctl = 0;
    uint8_t clip_relu_pre = 0;
    uint8_t unit_flag_ctl = 0;
    uint64_t quant_pre = 0;
    uint8_t relu_pre = 0;
    bool split_en = false;
    bool nz2nd_en = true;
    uint64_t quant_post = 0;
    uint8_t relu_post = 0;
    bool clip_relu_post = false;
    uint8_t eltwise_op = 0;
    bool eltwise_antq_en = false;
    bool c0_pad_en = false;
    bool broadcast_en = false;
    bool nz2dn_en = false;

    asc_copy_l0c2gm(
        dst, src, n_size, m_size, loop_dst_stride, loop_src_stride, l2_cache_ctl, clip_relu_pre, unit_flag_ctl,
        quant_pre, relu_pre, split_en, nz2nd_en, quant_post, relu_post, clip_relu_post, eltwise_op, eltwise_antq_en,
        c0_pad_en, broadcast_en, nz2dn_en);
}

// ==================================================================
// 核函数入口
// ==================================================================
__global__ __cube__ void matmul_custom(__gm__ float* a, __gm__ float* b, __gm__ float* bias, __gm__ float* c)
{
    asc_init();

    __cbuf__ float a_l1[A_L1_SIZE];
    __cbuf__ float b_l1[B_L1_SIZE];
    __cbuf__ float bias_l1[BIAS_ELEMS];

    copy_matrix_a_to_l1(a_l1, a);
    copy_matrix_b_to_l1(b_l1, b);
    copy_bias_to_l1(bias_l1, bias);

    __ca__ float a_l0[A_L0_SIZE];
    __cb__ float b_l0[B_L0_SIZE];

    split_matrix_a_to_l0a(a_l0, a_l1);
    split_matrix_b_to_l0b(b_l0, b_l1);
    split_bias_to_bt(bias_l1);

    __cc__ float c_l0[C_L0_SIZE];

    compute_mmad(c_l0, a_l0, b_l0);
    copy_result_to_gm(c, c_l0);

    asc_sync_pipe(PIPE_ALL);
}

// ==================================================================
// Host 端主函数
// ==================================================================
int32_t main(int32_t argc, char* argv[])
{
    size_t a_file_size = M * K * sizeof(float);
    size_t b_file_size = K * N * sizeof(float);
    size_t bias_file_size = N * sizeof(float);
    size_t bias_buf_size = BIAS_BYTES; // bias 补零到 BiasTable 要求的对齐大小
    size_t c_file_size = M * N * sizeof(float);

    uint32_t num_blocks = 1;

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* a_host;
    float* b_host;
    float* bias_host;
    float* c_host;
    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMallocHost((void**)(&bias_host), bias_buf_size);
    aclrtMallocHost((void**)(&c_host), c_file_size);

    // bias 尾部补零，避免未初始化数据经 L1 进入 BiasTable
    memset(bias_host, 0, bias_buf_size);

    // ReadFile 只拒绝过大的文件，过小的文件会让缓冲区尾部保持未初始化并被送上 Device，
    // 因此这里同时校验返回值和实际读入的字节数
    size_t a_read_size = 0;
    size_t b_read_size = 0;
    size_t bias_read_size = 0;
    if (!ReadFile("./input/x1_gm.bin", a_read_size, a_host, a_file_size) || a_read_size != a_file_size ||
        !ReadFile("./input/x2_gm.bin", b_read_size, b_host, b_file_size) || b_read_size != b_file_size ||
        !ReadFile("./input/bias_gm.bin", bias_read_size, bias_host, bias_buf_size) ||
        bias_read_size != bias_file_size) {
        ERROR_LOG("Read input failed, please run gen_data.py with m / k / n = %u / %u / %u", M, K, N);
        aclrtFreeHost(a_host);
        aclrtFreeHost(b_host);
        aclrtFreeHost(bias_host);
        aclrtFreeHost(c_host);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device_id);
        aclFinalize();
        return 1;
    }

    float* a_device;
    float* b_device;
    float* bias_device;
    float* c_device;
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bias_device, bias_buf_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, bias_buf_size, bias_host, bias_buf_size, ACL_MEMCPY_HOST_TO_DEVICE);

    matmul_custom<<<num_blocks, 0, stream>>>(a_device, b_device, bias_device, c_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);

    int32_t ret = 0;
    if (!WriteFile("./output/output.bin", c_host, c_file_size)) {
        ERROR_LOG("Write ./output/output.bin failed");
        ret = 1;
    }

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(bias_device);
    aclrtFreeHost(bias_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return ret;
}
