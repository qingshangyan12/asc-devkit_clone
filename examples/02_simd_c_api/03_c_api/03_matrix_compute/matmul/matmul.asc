/* !
 * \file matmul.asc
 * \brief Single-Cube FP32 MatMul: C[30,70] = A[30,40] * B[40,70] + bias[70].
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

#include <cerrno>
#include <cstdio>
#include <sys/stat.h>

constexpr uint32_t M = 30;
constexpr uint32_t K = 40;
constexpr uint32_t N = 70;
constexpr uint32_t BLOCK_CUBE = 16;
constexpr uint32_t C0_SIZE = 8;

constexpr uint32_t A_L1_SIZE = 1280;
constexpr uint32_t A_L0_SIZE = 1280;
constexpr uint32_t B_L1_SIZE = 3200;
constexpr uint32_t B_L0_SIZE = 3200;
constexpr uint32_t C_L0_SIZE = 2560;
constexpr uint32_t BIAS_BYTES = 320;
constexpr uint32_t BIAS_ELEMENTS = BIAS_BYTES / sizeof(float);
constexpr uint32_t L1_BYTES = (A_L1_SIZE + B_L1_SIZE + BIAS_ELEMENTS) * sizeof(float);
constexpr uint32_t L0A_BYTES = A_L0_SIZE * sizeof(float);
constexpr uint32_t L0B_BYTES = B_L0_SIZE * sizeof(float);
constexpr uint32_t L0C_BYTES = C_L0_SIZE * sizeof(float);

constexpr uint32_t L1_CAPACITY_BYTES = 512 * 1024;
constexpr uint32_t L0A_CAPACITY_BYTES = 64 * 1024;
constexpr uint32_t L0B_CAPACITY_BYTES = 64 * 1024;
constexpr uint32_t L0C_CAPACITY_BYTES = 256 * 1024;
constexpr uint32_t BIAS_TABLE_CAPACITY_BYTES = 4 * 1024;

static_assert(A_L1_SIZE * sizeof(float) == 5120);
static_assert(B_L1_SIZE * sizeof(float) == 12800);
static_assert(B_L0_SIZE * sizeof(float) == 12800);
static_assert(C_L0_SIZE * sizeof(float) == 10240);
static_assert(BIAS_ELEMENTS == 80);
static_assert(L1_BYTES == 18240);
static_assert(L1_BYTES <= L1_CAPACITY_BYTES);
static_assert(L0A_BYTES <= L0A_CAPACITY_BYTES);
static_assert(L0B_BYTES <= L0B_CAPACITY_BYTES);
static_assert(L0C_BYTES <= L0C_CAPACITY_BYTES);
static_assert(BIAS_BYTES <= BIAS_TABLE_CAPACITY_BYTES);

__aicore__ inline void copy_a_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(32) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, K * sizeof(float), 0, M, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
}

__aicore__ inline void copy_b_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(80) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_dn2nz(dst, src, N * sizeof(float), 0, N, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
}

__aicore__ inline void copy_bias_gm_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    const uint64_t config = (static_cast<uint64_t>(1) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, 1, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
}

__aicore__ inline void copy_a_l1_to_l0a(__ca__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_copy_l12l0a(dst, src, 0, 0, 2, 5, 2, 2);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
}

__aicore__ inline void copy_b_l1_to_l0b(__cb__ float* dst, __cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
    asc_copy_l12l0b(dst, src, 0, 0, 5, 5, 5, 5);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
}

__aicore__ inline void copy_bias_l1_to_bt(__cbuf__ float* src)
{
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
    asc_copy_l12bt(0, src, 0, 1, BIAS_BYTES / 32, 0, 0);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID2);
}

__aicore__ inline void compute_mmad(__cc__ float* c_matrix, __ca__ float* a_matrix, __cb__ float* b_matrix)
{
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID2);

    asc_mmad(c_matrix, a_matrix, b_matrix, M, K, N, 0, true, true, false);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
}

__aicore__ inline void copy_c_l0c_to_gm(__gm__ float* dst, __cc__ float* src)
{
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(dst, src, N, M, N, 32, 0, 0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false, false);
}

__global__ __cube__ void matmul_custom(__gm__ float* src0, __gm__ float* src1, __gm__ float* weight, __gm__ float* dst)
{
    asc_init();

    __cbuf__ float a_l1[A_L1_SIZE];
    __cbuf__ float b_l1[B_L1_SIZE];
    __cbuf__ float bias_l1[BIAS_ELEMENTS];
    __ca__ float a_l0[A_L0_SIZE];
    __cb__ float b_l0[B_L0_SIZE];
    __cc__ float c_l0[C_L0_SIZE];

    copy_a_gm_to_l1(a_l1, src0);
    copy_b_gm_to_l1(b_l1, src1);
    copy_bias_gm_to_l1(bias_l1, weight);
    copy_a_l1_to_l0a(a_l0, a_l1);
    copy_b_l1_to_l0b(b_l0, b_l1);
    copy_bias_l1_to_bt(bias_l1);
    compute_mmad(c_l0, a_l0, b_l0);
    copy_c_l0c_to_gm(dst, c_l0);

    asc_sync_pipe(PIPE_ALL);
}

struct HostResources {
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_synchronized = false;
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    float* a_host = nullptr;
    float* b_host = nullptr;
    float* bias_host = nullptr;
    float* c_host = nullptr;
    float* a_device = nullptr;
    float* b_device = nullptr;
    float* bias_device = nullptr;
    float* c_device = nullptr;
};

bool check_acl_result(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed with %d\n", operation, static_cast<int>(result));
    return false;
}

void record_cleanup_result(aclError result, const char* operation, int32_t& status)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(stderr, "[ERROR] cleanup %s failed with %d\n", operation, static_cast<int>(result));
        status = 1;
    }
}

int32_t release_resources(HostResources& resources)
{
    int32_t status = 0;
    bool stream_destroyed = resources.stream == nullptr;
    if (resources.stream != nullptr) {
        bool force_destroy = false;
        if (!resources.stream_synchronized) {
            const aclError synchronize_result = aclrtSynchronizeStream(resources.stream);
            if (synchronize_result == ACL_SUCCESS) {
                resources.stream_synchronized = true;
            } else {
                record_cleanup_result(synchronize_result, "aclrtSynchronizeStream", status);
                force_destroy = true;
            }
        }
        const aclError result =
            force_destroy ? aclrtDestroyStreamForce(resources.stream) : aclrtDestroyStream(resources.stream);
        record_cleanup_result(result, force_destroy ? "aclrtDestroyStreamForce" : "aclrtDestroyStream", status);
        stream_destroyed = result == ACL_SUCCESS;
        if (stream_destroyed) {
            resources.stream = nullptr;
        }
    }

    if (stream_destroyed) {
        if (resources.c_device != nullptr) {
            record_cleanup_result(aclrtFree(resources.c_device), "aclrtFree(c_device)", status);
        }
        if (resources.bias_device != nullptr) {
            record_cleanup_result(aclrtFree(resources.bias_device), "aclrtFree(bias_device)", status);
        }
        if (resources.b_device != nullptr) {
            record_cleanup_result(aclrtFree(resources.b_device), "aclrtFree(b_device)", status);
        }
        if (resources.a_device != nullptr) {
            record_cleanup_result(aclrtFree(resources.a_device), "aclrtFree(a_device)", status);
        }
    }

    if (resources.c_host != nullptr) {
        record_cleanup_result(aclrtFreeHost(resources.c_host), "aclrtFreeHost(c_host)", status);
    }
    if (resources.bias_host != nullptr) {
        record_cleanup_result(aclrtFreeHost(resources.bias_host), "aclrtFreeHost(bias_host)", status);
    }
    if (resources.b_host != nullptr) {
        record_cleanup_result(aclrtFreeHost(resources.b_host), "aclrtFreeHost(b_host)", status);
    }
    if (resources.a_host != nullptr) {
        record_cleanup_result(aclrtFreeHost(resources.a_host), "aclrtFreeHost(a_host)", status);
    }
    if (resources.device_set) {
        record_cleanup_result(aclrtResetDevice(resources.device_id), "aclrtResetDevice", status);
    }
    if (resources.acl_initialized) {
        record_cleanup_result(aclFinalize(), "aclFinalize", status);
    }
    return status;
}

int32_t run_sample(HostResources& resources)
{
    constexpr size_t a_bytes = M * K * sizeof(float);
    constexpr size_t b_bytes = K * N * sizeof(float);
    constexpr size_t bias_bytes = N * sizeof(float);
    constexpr size_t c_bytes = M * N * sizeof(float);
    constexpr uint32_t num_blocks = 1;

    if (!check_acl_result(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    resources.acl_initialized = true;
    if (!check_acl_result(aclrtSetDevice(resources.device_id), "aclrtSetDevice")) {
        return 1;
    }
    resources.device_set = true;
    if (!check_acl_result(aclrtCreateStream(&resources.stream), "aclrtCreateStream")) {
        return 1;
    }

    if (!check_acl_result(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.a_host), a_bytes), "aclrtMallocHost(a_host)") ||
        !check_acl_result(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.b_host), b_bytes), "aclrtMallocHost(b_host)") ||
        !check_acl_result(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.bias_host), bias_bytes),
            "aclrtMallocHost(bias_host)") ||
        !check_acl_result(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.c_host), c_bytes), "aclrtMallocHost(c_host)")) {
        return 1;
    }
    if (!check_acl_result(
            aclrtMalloc(reinterpret_cast<void**>(&resources.a_device), a_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(a_device)") ||
        !check_acl_result(
            aclrtMalloc(reinterpret_cast<void**>(&resources.b_device), b_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(b_device)") ||
        !check_acl_result(
            aclrtMalloc(reinterpret_cast<void**>(&resources.bias_device), bias_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(bias_device)") ||
        !check_acl_result(
            aclrtMalloc(reinterpret_cast<void**>(&resources.c_device), c_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(c_device)")) {
        return 1;
    }

    if (!ReadFileExact("./input/x1_gm.bin", resources.a_host, a_bytes) ||
        !ReadFileExact("./input/x2_gm.bin", resources.b_host, b_bytes) ||
        !ReadFileExact("./input/bias_gm.bin", resources.bias_host, bias_bytes)) {
        return 1;
    }
    if (!check_acl_result(
            aclrtMemcpy(resources.a_device, a_bytes, resources.a_host, a_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(a_device)") ||
        !check_acl_result(
            aclrtMemcpy(resources.b_device, b_bytes, resources.b_host, b_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(b_device)") ||
        !check_acl_result(
            aclrtMemcpy(resources.bias_device, bias_bytes, resources.bias_host, bias_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(bias_device)")) {
        return 1;
    }

    matmul_custom<<<num_blocks, 0, resources.stream>>>(
        resources.a_device, resources.b_device, resources.bias_device, resources.c_device);
    if (!check_acl_result(aclrtSynchronizeStream(resources.stream), "aclrtSynchronizeStream")) {
        return 1;
    }
    resources.stream_synchronized = true;
    if (!check_acl_result(
            aclrtMemcpy(resources.c_host, c_bytes, resources.c_device, c_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(c_host)")) {
        return 1;
    }

    if (mkdir("./output", S_IRWXU) != 0 && errno != EEXIST) {
        std::fprintf(stderr, "[ERROR] failed to create output directory\n");
        return 1;
    }
    return WriteFileExact("./output/output.bin", resources.c_host, c_bytes) ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    HostResources resources;
    const int32_t run_status = run_sample(resources);
    const int32_t cleanup_status = release_resources(resources);
    return run_status == 0 && cleanup_status == 0 ? 0 : 1;
}
