/* !
 * \file asc_copy_l0c2ub.asc
 * \brief 本样例介绍如何使用asc_copy_l0c2ub将矩阵乘的结果从L0C Buffer搬出到UB（Unified Buffer）
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

// half格式, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

constexpr int64_t OUTPUT_READY_FLAG = 0x8;

__aicore__ inline uint16_t ceil_align(uint16_t numerator, uint16_t denominator)
{
    return static_cast<uint16_t>(AscendC::Std::ceil_div(numerator, denominator) * denominator);
}

template <class inputType, uint32_t baseM, uint32_t baseK>
__aicore__ inline void split_a(__cbuf__ inputType* a1Local, __ca__ inputType* a2Local)
{
    asc_copy_l12l0a(
        a2Local, a1Local, 0, 0, AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
        AscendC::Std::ceil_div(baseK, C0_SIZE / sizeof(inputType)), AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
        AscendC::Std::ceil_div(baseM, CUBE_BLOCK));
}

template <class inputType, uint32_t baseK, uint32_t baseN>
__aicore__ inline void split_b(__cbuf__ inputType* b1Local, __cb__ inputType* b2Local)
{
    constexpr uint32_t c0Elements = C0_SIZE / sizeof(inputType);
    constexpr uint32_t dstOffset = AscendC::Std::ceil_div(baseN, c0Elements) * CUBE_BLOCK_SIZE;
    constexpr uint32_t srcOffset = CUBE_BLOCK_SIZE;
    constexpr uint8_t repeat = static_cast<uint8_t>(AscendC::Std::ceil_div(baseN, c0Elements));
    constexpr uint16_t srcStride = static_cast<uint16_t>(AscendC::Std::ceil_div(baseK, CUBE_BLOCK));
    for (uint32_t i = 0; i < AscendC::Std::ceil_div(baseN, c0Elements); ++i) {
        asc_copy_l12l0b_trans(
            b2Local + i * dstOffset, b1Local + i * srcOffset, static_cast<uint16_t>(0), repeat, srcStride,
            static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
    }
}

template <class outputType, uint32_t baseM, uint32_t baseN>
__aicore__ inline void copy_aiv_result_to_gm(__gm__ outputType* cGM, __ubuf__ outputType* cUB)
{
    if constexpr (SCENARIO_NUM == 1 || SCENARIO_NUM == 2) {
        asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
        if (asc_get_sub_block_id() != 0) {
            return;
        }
        asc_copy_ub2gm_align((__gm__ uint8_t*)cGM, (__ubuf__ uint8_t*)cUB, baseM * baseN * sizeof(outputType));
    } else if constexpr (SCENARIO_NUM == 3) {
        asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
        constexpr uint32_t offset = baseM / 2 * baseN;
        asc_copy_ub2gm_align(
            (__gm__ uint8_t*)(cGM + asc_get_sub_block_id() * offset), (__ubuf__ uint8_t*)cUB,
            baseM / 2 * baseN * sizeof(outputType));
    } else if constexpr (SCENARIO_NUM == 4) {
        asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
        constexpr uint16_t blockCount = static_cast<uint16_t>(baseM);
        constexpr uint16_t blockLen = static_cast<uint16_t>(baseN / 2 * sizeof(outputType));
        constexpr uint16_t dstStride = static_cast<uint16_t>(baseN * sizeof(outputType));
        constexpr uint16_t srcStride = blockLen;
        constexpr uint32_t offset = baseN / 2;
        asc_copy_ub2gm(
            (__gm__ void*)(cGM + asc_get_sub_block_id() * offset), (__ubuf__ void*)cUB, blockCount, blockLen, dstStride,
            srcStride);
    }
}

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __mix__(1, 2) void asc_copy_l0c2ub(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();
    constexpr uint32_t baseM = M;
    constexpr uint32_t baseK = K / K_ROUND;
    constexpr uint32_t baseN = N;
    __gm__ half* aGM = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* bGM = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* cGM = reinterpret_cast<__gm__ float*>(c);
    __ubuf__ float* cUB = reinterpret_cast<__ubuf__ float*>(0);

    if ASC_IS_AIC {
        __cbuf__ half a1Local[baseM * baseK];
        __ca__ half a2Local[baseM * baseK];
        __cbuf__ half b1Local[baseK * baseN];
        __cb__ half b2Local[baseK * baseN];
        __cc__ float cLocal[baseM * baseN];
        for (uint32_t kIndex = 0; kIndex < K_ROUND; ++kIndex) {
            constexpr uint16_t matrixNum = 1;
            constexpr uint16_t dstNzNStride = 1;
            constexpr uint16_t dstNzMatrixStride = 0;
            uint16_t dstNzC0Stride = ceil_align(baseM, CUBE_BLOCK);
            asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
            asc_copy_gm2l1_nd2nz(
                a1Local, aGM + kIndex * baseM * baseK, baseK * sizeof(half),
                asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseM, baseK, 0, false);

            dstNzC0Stride = ceil_align(baseK, CUBE_BLOCK);
            asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
            asc_copy_gm2l1_nd2nz(
                b1Local, bGM + kIndex * baseK * baseN, baseN * sizeof(half),
                asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseK, baseN, 0, false);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            split_a<half, baseM, baseK>(a1Local, a2Local);
            split_b<half, baseK, baseN>(b1Local, b2Local);
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
            bool cmatrixInitVal = kIndex == 0;
            asc_mmad(
                cLocal, a2Local, b2Local, baseM, baseK, ceil_align(baseN, C0_SIZE), asc_unit_flag_mode::DISABLE, false,
                false, cmatrixInitVal);
            if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
                asc_sync_pipe(PIPE_M);
            }
            asc_sync_notify(PIPE_M, PIPE_MTE2, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_MTE2, EVENT_ID0);
        }
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        constexpr auto unitFlagMode = asc_unit_flag_mode::DISABLE;
        constexpr auto quantMode = QuantMode_t::NoQuant;
        constexpr auto reluMode = asc_relu_pre_mode::NONE;
        if constexpr (SCENARIO_NUM == 1) {
            constexpr uint16_t c0Size = 16;
            asc_copy_l0c2ub(
                cUB, cLocal, ceil_align(baseN, c0Size), baseM, baseM * c0Size, ceil_align(baseM, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_DISABLE, unitFlagMode, quantMode, reluMode, false, false, false, false);
        } else if constexpr (SCENARIO_NUM == 2) {
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                cUB, cLocal, baseN, baseM, baseN, ceil_align(baseM, CUBE_BLOCK), 0, asc_dual_dst_mode::DUAL_DST_DISABLE,
                unitFlagMode, quantMode, reluMode, false, true, false, false);
        } else if constexpr (SCENARIO_NUM == 3) {
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                cUB, cLocal, baseN, ceil_align(baseM, 2), baseN, ceil_align(baseM, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_SPLIT_M, unitFlagMode, quantMode, reluMode, false, true, false, false);
        } else if constexpr (SCENARIO_NUM == 4) {
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                cUB, cLocal, ceil_align(baseN, 32), baseM, baseN / 2, ceil_align(baseM, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_SPLIT_N, unitFlagMode, quantMode, reluMode, false, true, false, false);
        }
        asc_sync_block_arrive(PIPE_FIX, OUTPUT_READY_FLAG);
    }
    if ASC_IS_AIV {
        copy_aiv_result_to_gm<float, baseM, baseN>(cGM, cUB);
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    // A No Trans, B No Trans
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 256;
    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize = M * N * sizeof(float);
    uint32_t numBlocks = 1;

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* aHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* cHost = nullptr;
    uint8_t* cDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    auto check_acl = [](aclError result, const char* operation) {
        if (result != ACL_SUCCESS) {
            ERROR_LOG("%s failed, ret = %d", operation, static_cast<int32_t>(result));
            return false;
        }
        return true;
    };
    auto cleanup = [&]() {
        if (cDevice != nullptr) {
            aclrtFree(cDevice);
        }
        if (cHost != nullptr) {
            aclrtFreeHost(cHost);
        }
        if (bDevice != nullptr) {
            aclrtFree(bDevice);
        }
        if (bHost != nullptr) {
            aclrtFreeHost(bHost);
        }
        if (aDevice != nullptr) {
            aclrtFree(aDevice);
        }
        if (aHost != nullptr) {
            aclrtFreeHost(aHost);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            aclrtResetDevice(deviceId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    };

    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    aclInitialized = true;
    if (!check_acl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        cleanup();
        return 1;
    }
    deviceSet = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&aHost), aFileSize), "aclrtMallocHost(aHost)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&aDevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(aDevice)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize)) {
        cleanup();
        return 1;
    }
    if (!check_acl(
            aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(aDevice)")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&bHost), bFileSize), "aclrtMallocHost(bHost)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&bDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(bDevice)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize)) {
        cleanup();
        return 1;
    }
    if (!check_acl(
            aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(bDevice)")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&cHost), cFileSize), "aclrtMallocHost(cHost)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&cDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(cDevice)")) {
        cleanup();
        return 1;
    }

    asc_copy_l0c2ub<M, K, N><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        cleanup();
        return 1;
    }

    if (!check_acl(
            aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy(cHost)")) {
        cleanup();
        return 1;
    }
    bool writeSuccess = WriteFile("./output/output.bin", cHost, cFileSize);

    cleanup();
    return writeSuccess ? 0 : 1;
}
