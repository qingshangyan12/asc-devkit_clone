/* !
 * \file fixpipe_l0c2ub.asc
 * \brief 本样例介绍如何使用asc_copy_l0c2ub将矩阵乘的结果从L0C Buffer搬出到UB（Unified Buffer）
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// half格式, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

constexpr int64_t OUTPUT_READY_FLAG = 0x8;

template <class inputType, class outputType, class l0cType, uint32_t baseM, uint32_t baseK, uint32_t baseN>
class KernelFixpipe {
public:
    __aicore__ inline KernelFixpipe()
    {
        asc_init();
        aSingleSize = baseM * baseK;
        bSingleSize = baseK * baseN;
        cSingleSize = baseM * baseN;

        // A 不转置
        aSizeAlignL1 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        aSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        // B 不转置
        bSizeAlignL1 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        bSizeAlignL0 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        // C矩阵无视数据类型和a、b是否转置，m,n都向16对齐
        cSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
    }

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
    {
        aGM = (__gm__ inputType*)a;
        bGM = (__gm__ inputType*)b;
        cGM = (__gm__ outputType*)c;
        cUB = reinterpret_cast<__ubuf__ outputType*>(0);
    }

    __aicore__ inline void Process()
    {
        if ASC_IS_AIC {
            uint32_t chunkSize = K_ROUND;
            __cbuf__ inputType a1Local[baseM * baseK];
            __ca__ inputType a2Local[baseM * baseK];
            __cbuf__ inputType b1Local[baseK * baseN];
            __cb__ inputType b2Local[baseK * baseN];
            __cc__ l0cType c[baseM * baseN];
            for (uint32_t kIndex = 0; kIndex < chunkSize; kIndex++) {
                CopyIn(kIndex, a1Local, b1Local);
                asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
                asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
                SplitA(a1Local, a2Local);
                SplitB(b1Local, b2Local);
                asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
                asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
                Compute(kIndex, c, a2Local, b2Local);
                asc_sync_notify(PIPE_M, PIPE_MTE2, EVENT_ID0);
                asc_sync_wait(PIPE_M, PIPE_MTE2, EVENT_ID0);
            }

            asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
            CopyOut(c);
            asc_sync_block_arrive(PIPE_FIX, OUTPUT_READY_FLAG);
        }
        if ASC_IS_AIV {
            if constexpr (SCENARIO_NUM == 1 || SCENARIO_NUM == 2) {
                if (asc_get_sub_block_id() != 0) {
                    return;
                }
                asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
                asc_copy_ub2gm((__gm__ void*)cGM, (__ubuf__ void*)cUB, baseM * baseN * sizeof(outputType));
            } else if constexpr (SCENARIO_NUM == 3) {
                asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
                uint32_t offset = baseM / 2 * baseN;
                asc_copy_ub2gm(
                    (__gm__ void*)(cGM + asc_get_sub_block_id() * offset), (__ubuf__ void*)cUB,
                    baseM / 2 * baseN * sizeof(outputType));
            } else if constexpr (SCENARIO_NUM == 4) {
                asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
                uint16_t blockCount = baseM;
                uint16_t blockLen = baseN / 2 * sizeof(outputType);
                uint16_t dstStride = baseN * sizeof(outputType);
                uint16_t srcStride = blockLen;
                uint32_t offset = baseN / 2;
                asc_copy_ub2gm(
                    (__gm__ void*)(cGM + asc_get_sub_block_id() * offset), (__ubuf__ void*)cUB, blockCount, blockLen,
                    dstStride, srcStride);
            }
        }
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }

    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void CopyIn(uint32_t kIndex, __cbuf__ inputType* a1Local, __cbuf__ inputType* b1Local)
    {
        // 传输ND矩阵的数目
        uint16_t matrixNum = 1;
        uint16_t dstNzNStride = 1;
        uint16_t dstNzMatrixStride = 0;
        // 目的NZ矩阵中，来自源操作数同一行的多行数据相邻行起始地址间的偏移。
        // 取值范围：dstNzC0Stride∈[1, 16384]，单位：C0_SIZE（32B）。
        uint16_t dstNzC0Stride = CeilAlign(baseM, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
        asc_copy_gm2l1_nd2nz(
            a1Local, aGM + kIndex * aSingleSize, baseK * sizeof(inputType), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
            baseM, baseK, 0, false);

        dstNzC0Stride = CeilAlign(baseK, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
        asc_copy_gm2l1_nd2nz(
            b1Local, bGM + kIndex * bSingleSize, baseN * sizeof(inputType), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
            baseK, baseN, 0, false);
    }

    __aicore__ inline void SplitA(__cbuf__ inputType* a1Local, __ca__ inputType* a2Local)
    {
        asc_copy_l12l0a(
            a2Local, a1Local, 0, 0, CeilDivision(baseM, CUBE_BLOCK), CeilDivision(baseK, C0_SIZE / sizeof(inputType)),
            CeilDivision(baseM, CUBE_BLOCK), CeilDivision(baseM, CUBE_BLOCK));
    }

    __aicore__ inline void SplitB(__cbuf__ inputType* b1Local, __cb__ inputType* b2Local)
    {
        // Nz -> Zn
        asc_copy_l12l0b_transpose(
            b2Local, b1Local, 0, 0, CeilDivision(baseK, CUBE_BLOCK), CeilDivision(baseN, C0_SIZE / sizeof(inputType)),
            CeilDivision(baseK, CUBE_BLOCK), CeilDivision(baseN, CUBE_BLOCK));
    }

    __aicore__ inline void Compute(uint32_t kIndex, __cc__ l0cType* c, __ca__ inputType* a, __cb__ inputType* b)
    {
        bool cmatrixInitVal = kIndex == 0;
        asc_mmad(
            c, a, b, baseM, baseK, CeilAlign(baseN, C0_SIZE), asc_unit_flag_mode::DISABLE, false, false,
            cmatrixInitVal);
        if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
            asc_sync_pipe(PIPE_M);
        }
    }

    __aicore__ inline void CopyOut(__cc__ l0cType* c)
    {
        constexpr auto unitFlagMode = asc_unit_flag_mode::DISABLE;
        constexpr auto quantMode = QuantMode_t::NoQuant;
        constexpr auto reluMode = asc_relu_pre_mode::NONE;
        if constexpr (SCENARIO_NUM == 1) {
            // 场景1：输出格式NZ，输出数据类型float
            uint16_t c0Size = 16;
            asc_copy_l0c2ub(
                cUB, c, CeilAlign(baseN, c0Size), baseM, baseM * c0Size, CeilAlign(baseM, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_DISABLE, unitFlagMode, quantMode, reluMode, false, false, false, false);

        } else if constexpr (SCENARIO_NUM == 2) {
            // 场景2：输出格式ND，输出数据类型float
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                cUB, c, baseN, baseM, baseN, CeilAlign(baseM, CUBE_BLOCK), 0, asc_dual_dst_mode::DUAL_DST_DISABLE,
                unitFlagMode, quantMode, reluMode, false, true, false, false);

        } else if constexpr (SCENARIO_NUM == 3) {
            // 场景3：输出格式ND，输出数据类型float，使能双目标模式，按M维度拆分
            // 按M维度拆分，M必须为2的倍数
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                cUB, c, baseN, CeilAlign(baseM, 2), baseN, CeilAlign(baseM, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_SPLIT_M, unitFlagMode, quantMode, reluMode, false, true, false, false);

        } else if constexpr (SCENARIO_NUM == 4) {
            // 场景4：输出格式ND，输出数据类型float，使能双目标模式，按N维度拆分
            // 按N维度拆分，N必须为32的倍数
            // dstStride减半后输出数据才能连续排列
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                cUB, c, CeilAlign(baseN, 32), baseM, baseN / 2, CeilAlign(baseM, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_SPLIT_N, unitFlagMode, quantMode, reluMode, false, true, false, false);
        }
    }

private:
    __gm__ inputType* aGM;
    __gm__ inputType* bGM;
    __gm__ outputType* cGM;

    __ubuf__ outputType* cUB;

    uint32_t aSingleSize, bSingleSize, cSingleSize;

    uint32_t aSizeAlignL1, bSizeAlignL1;
    uint32_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0;
};

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __mix__(1, 2) void fixpipe_l0c2ub(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    KernelFixpipe<half, float, float, M, K / K_ROUND, N> op;
    op.Init(a, b, c);
    op.Process();
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    // A No Trans, B No Trans
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 256;
    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize = M * N * sizeof(float);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    fixpipe_l0c2ub<M, K, N><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
