/* !
 * \file asc_copy_l0c2gm.asc
 * \brief 本样例介绍如何使用asc_copy_l0c2gm将矩阵乘的结果从L0C Buffer搬出到GM（Global Memory）
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

__aicore__ inline uint16_t ceil_align(uint16_t numerator, uint16_t denominator)
{
    return static_cast<uint16_t>(AscendC::Std::ceil_div(numerator, denominator) * denominator);
}

template <uint32_t baseN>
__aicore__ inline void copy_quant_alpha_gm_to_l1(
    __gm__ uint64_t* quantAlphaGM, __cbuf__ uint64_t* quantAlphaTensor, __fbuf__ uint64_t* quantAlphaFbuf)
{
        asc_sync_notify(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        uint16_t burstLen = ceil_align(baseN * sizeof(uint64_t), 128) / 32;
    asc_copy_gm2l1((__cbuf__ void*)quantAlphaTensor, (__gm__ void*)quantAlphaGM, 1, burstLen, 0, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_copy_l12fb(
            (__fbuf__ void*)quantAlphaFbuf, (__cbuf__ void*)quantAlphaTensor, 1,
            ceil_align(baseN * sizeof(uint64_t), 128) / 64, 0, 0);
        uint64_t quantAlphaFbufAddr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quantAlphaFbuf)) / 128;
        asc_set_l0c_copy_config(0, quantAlphaFbufAddr, false);
    asc_sync_pipe(PIPE_FIX);
}

template <class inputType, uint32_t baseM, uint32_t baseK>
__aicore__ inline void split_a(__cbuf__ inputType* a1Local, __ca__ inputType* a2Local)
{
    asc_copy_l12l0a(
        a2Local, a1Local, 0, 0, AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
        AscendC::Std::ceil_div(baseK, C0_SIZE / sizeof(inputType)), AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
        AscendC::Std::ceil_div(baseM, CUBE_BLOCK));
}

template <class inputType, uint32_t baseK, uint32_t baseN>
__aicore__ inline void split_b(__cbuf__ inputType* b1Local, __cb__ inputType* b2Local)
{
    asc_copy_l12l0b_transpose(
        b2Local, b1Local, 0, 0, AscendC::Std::ceil_div(baseK, CUBE_BLOCK),
        AscendC::Std::ceil_div(baseN, C0_SIZE / sizeof(inputType)), AscendC::Std::ceil_div(baseK, CUBE_BLOCK),
        AscendC::Std::ceil_div(baseN, CUBE_BLOCK));
}

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void asc_copy_l0c2gm(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* quantAlpha)
{
    asc_init();
    constexpr uint32_t baseM = M;
    constexpr uint32_t baseK = K / K_ROUND;
    constexpr uint32_t baseN = N;
    __gm__ half* aGM = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* bGM = reinterpret_cast<__gm__ half*>(b);
    __cc__ float cLocal[baseM * baseN];
    __cbuf__ half a1Local[baseM * baseK];
    __ca__ half a2Local[baseM * baseK];
    __cbuf__ half b1Local[baseK * baseN];
    __cb__ half b2Local[baseK * baseN];
    for (uint32_t kIndex = 0; kIndex < K_ROUND; ++kIndex) {
        uint16_t dstNzC0Stride = ceil_align(baseM, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(1, 1, dstNzC0Stride, 0);
        asc_copy_gm2l1_nd2nz(
            a1Local, aGM + kIndex * baseM * baseK, baseK * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
            baseM, baseK, 0, false);
        dstNzC0Stride = ceil_align(baseK, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(1, 1, dstNzC0Stride, 0);
        asc_copy_gm2l1_nd2nz(
            b1Local, bGM + kIndex * baseK * baseN, baseN * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
            baseK, baseN, 0, false);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        split_a<half, baseM, baseK>(a1Local, a2Local);
        split_b<half, baseK, baseN>(b1Local, b2Local);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_mmad(
            cLocal, a2Local, b2Local, baseM, baseK, ceil_align(baseN, C0_SIZE), asc_unit_flag_mode::DISABLE, false,
            false, kIndex == 0);
        if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
            asc_sync_pipe(PIPE_M);
        }
        asc_sync_notify(PIPE_M, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_MTE2, EVENT_ID0);
    }
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    constexpr auto l2CacheMode = asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM;
    constexpr auto unitFlagMode = asc_unit_flag_mode::DISABLE;
    constexpr auto noQuant = QuantMode_t::NoQuant;
    constexpr auto noRelu = asc_relu_pre_mode::NONE;
    if constexpr (SCENARIO_NUM == 1 || SCENARIO_NUM == 7) {
        constexpr uint16_t c0Size = SCENARIO_NUM == 1 ? 16 : 8;
        asc_copy_l0c2gm(
            reinterpret_cast<__gm__ float*>(c), cLocal, ceil_align(baseN, c0Size), baseM, baseM * c0Size,
            ceil_align(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, noQuant, noRelu, SCENARIO_NUM == 7, false, false,
            false);
    } else if constexpr (SCENARIO_NUM == 2) {
        asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(reinterpret_cast<__gm__ float*>(c), cLocal, baseN, baseM, baseN, ceil_align(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, noQuant, noRelu, false, true, false, false);
    } else if constexpr (SCENARIO_NUM == 3) {
        asc_set_l0c_copy_channel_para(1); asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(reinterpret_cast<__gm__ float*>(c), cLocal, baseN, baseM, baseM, ceil_align(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, noQuant, noRelu, false, false, true, false);
    } else if constexpr (SCENARIO_NUM == 4 || SCENARIO_NUM == 5) {
        if constexpr (SCENARIO_NUM == 4) {
            asc_set_l0c_copy_prequant(2.0F, 0, true);
        } else {
            __cbuf__ uint64_t quantAlphaTensor[baseN]; __fbuf__ uint64_t quantAlphaFbuf[baseN];
            copy_quant_alpha_gm_to_l1<baseN>(reinterpret_cast<__gm__ uint64_t*>(quantAlpha), quantAlphaTensor, quantAlphaFbuf);
        }
        asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(reinterpret_cast<__gm__ int8_t*>(c), cLocal, baseN, baseM, baseN, ceil_align(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, SCENARIO_NUM == 4 ? QuantMode_t::QF322B8_PRE : QuantMode_t::VQF322B8_PRE, noRelu, false, true, false, false);
    } else if constexpr (SCENARIO_NUM == 6) {
        asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(reinterpret_cast<__gm__ float*>(c), cLocal, baseN, baseM, baseN, ceil_align(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, noQuant, asc_relu_pre_mode::NORMAL, false, true, false, false);
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    // A No Trans, B No Trans
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 256;
    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize;
    if constexpr (SCENARIO_NUM == 4 || SCENARIO_NUM == 5) {
        cFileSize = M * N * sizeof(int8_t);
    } else {
        cFileSize = M * N * sizeof(float);
    }
    size_t quantAlphaSize = 1 * N * sizeof(uint64_t);
    uint32_t numBlocks = 1;

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* aHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* cHost = nullptr;
    uint8_t* cDevice = nullptr;
    uint8_t* quantAlphaHost = nullptr;
    uint8_t* quantAlphaDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    auto check_acl = [](aclError result, const char* operation) {
        if (result != ACL_SUCCESS) {
            ERROR_LOG("%s failed, ret = %d", operation, static_cast<int32_t>(result));
            return false;
        }
        return true;
    };
    auto cleanup = [&]() {
        if (quantAlphaDevice != nullptr) {
            aclrtFree(quantAlphaDevice);
        }
        if (quantAlphaHost != nullptr) {
            aclrtFreeHost(quantAlphaHost);
        }
        if (cDevice != nullptr) {
            aclrtFree(cDevice);
        }
        if (cHost != nullptr) {
            aclrtFreeHost(cHost);
        }
        if (bDevice != nullptr) {
            aclrtFree(bDevice);
        }
        if (bHost != nullptr) {
            aclrtFreeHost(bHost);
        }
        if (aDevice != nullptr) {
            aclrtFree(aDevice);
        }
        if (aHost != nullptr) {
            aclrtFreeHost(aHost);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            aclrtResetDevice(deviceId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    };

    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    aclInitialized = true;
    if (!check_acl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        cleanup();
        return 1;
    }
    deviceSet = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&aHost), aFileSize), "aclrtMallocHost(aHost)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&aDevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(aDevice)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize)) {
        cleanup();
        return 1;
    }
    if (!check_acl(
            aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(aDevice)")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&bHost), bFileSize), "aclrtMallocHost(bHost)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&bDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(bDevice)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize)) {
        cleanup();
        return 1;
    }
    if (!check_acl(
            aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(bDevice)")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&cHost), cFileSize), "aclrtMallocHost(cHost)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&cDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(cDevice)")) {
        cleanup();
        return 1;
    }

    // vector quant mode
    if constexpr (SCENARIO_NUM == 5) {
        if (!check_acl(
                aclrtMallocHost(reinterpret_cast<void**>(&quantAlphaHost), quantAlphaSize),
                "aclrtMallocHost(quantAlphaHost)") ||
            !check_acl(
                aclrtMalloc(reinterpret_cast<void**>(&quantAlphaDevice), quantAlphaSize, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(quantAlphaDevice)")) {
            cleanup();
            return 1;
        }
        if (!ReadFile("./input/quant_pre.bin", quantAlphaSize, quantAlphaHost, quantAlphaSize)) {
            cleanup();
            return 1;
        }
        if (!check_acl(
                aclrtMemcpy(
                    quantAlphaDevice, quantAlphaSize, quantAlphaHost, quantAlphaSize, ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(quantAlphaDevice)")) {
            cleanup();
            return 1;
        }
    }

    asc_copy_l0c2gm<M, K, N><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice, quantAlphaDevice);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        cleanup();
        return 1;
    }

    if (!check_acl(
            aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy(cHost)")) {
        cleanup();
        return 1;
    }
    bool writeSuccess = WriteFile("./output/output.bin", cHost, cFileSize);

    cleanup();
    return writeSuccess ? 0 : 1;
}
