/* !
 * \file fixpipe_l0c2gm.asc
 * \brief 本样例介绍如何使用asc_copy_l0c2gm将矩阵乘的结果从L0C Buffer搬出到GM（Global Memory）
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

template <class inputType, class outputType, class l0cType, uint32_t baseM, uint32_t baseK, uint32_t baseN>
class KernelFixpipe {
public:
    __aicore__ inline KernelFixpipe()
    {
        asc_init();
        aSingleSize = baseM * baseK;
        bSingleSize = baseK * baseN;
        cSingleSize = baseM * baseN;

        // A 不转置
        aSizeAlignL1 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        aSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        // B 不转置
        bSizeAlignL1 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        bSizeAlignL0 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        // C矩阵无视数据类型和a、b是否转置，m,n都向16对齐
        cSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
    }

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* quantAlpha)
    {
        aGM = (__gm__ inputType*)a;
        bGM = (__gm__ inputType*)b;
        cGM = (__gm__ outputType*)c;
        quantAlphaGM = (__gm__ uint64_t*)quantAlpha;
    }

    __aicore__ inline void Process()
    {
        uint32_t chunkSize = K_ROUND;
        __cbuf__ inputType a1Local[baseM * baseK];
        __ca__ inputType a2Local[baseM * baseK];
        __cbuf__ inputType b1Local[baseK * baseN];
        __cb__ inputType b2Local[baseK * baseN];
        __cc__ l0cType c[baseM * baseN];
        for (uint32_t kIndex = 0; kIndex < chunkSize; kIndex++) {
            CopyIn(kIndex, a1Local, b1Local);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            SplitA(kIndex, a1Local, a2Local);
            SplitB(kIndex, b1Local, b2Local);
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
            Compute(kIndex, c, a2Local, b2Local);
            asc_sync_notify(PIPE_M, PIPE_MTE2, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_MTE2, EVENT_ID0);
        }

        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        CopyOut(c);
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }

    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void CopyQuantAlphaGmToL1(
        __cbuf__ uint64_t* quantAlphaTensor, __fbuf__ uint64_t* quantAlphaFbuf)
    {
        asc_sync_notify(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        uint16_t burstLen = CeilAlign(baseN * sizeof(uint64_t), 128) / 32;
        asc_copy_gm2l1((__cbuf__ void*)quantAlphaTensor, (__gm__ void*)quantAlphaGM, 1, burstLen, 0, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_copy_l12fb((__fbuf__ void*)quantAlphaFbuf, (__cbuf__ void*)quantAlphaTensor, 1,
            CeilAlign(baseN * sizeof(uint64_t), 128) / 64, 0, 0);
        uint64_t quantAlphaFbufAddr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quantAlphaFbuf)) / 128;
        asc_set_l0c_copy_config(0, quantAlphaFbufAddr, false);
        asc_sync_pipe(PIPE_FIX);
    }

    __aicore__ inline void CopyIn(uint32_t kIndex, __cbuf__ inputType* a1Local, __cbuf__ inputType* b1Local)
    {
        // 传输ND矩阵的数目
        uint16_t matrixNum = 1;
        // 目的NZ矩阵中，Z型矩阵相邻行起始地址之间的偏移。单位：C0_SIZE（32B）。
        uint16_t dstNzNStride = 1;
        // 目的NZ矩阵中，相邻NZ矩阵起始地址间的偏移，单位为C0_SIZE（32B）。
        uint16_t dstNzMatrixStride = 0;
        // 目的NZ矩阵中，来自源操作数同一行的多行数据相邻行起始地址间的偏移。
        // 取值范围：dstNzC0Stride∈[1, 16384]，单位：C0_SIZE（32B）。
        uint16_t dstNzC0Stride = CeilAlign(baseM, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
        asc_copy_gm2l1_nd2nz(a1Local, aGM + kIndex * aSingleSize, baseK * sizeof(inputType),
            asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseM, baseK, 0, false);

        dstNzC0Stride = CeilAlign(baseK, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
        asc_copy_gm2l1_nd2nz(b1Local, bGM + kIndex * bSingleSize, baseN * sizeof(inputType),
            asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseK, baseN, 0, false);
    }

    __aicore__ inline void SplitA(
        uint32_t kIndex, __cbuf__ inputType* a1Local, __ca__ inputType* a2Local)
    {
        // Nz -> Nz
        asc_copy_l12l0a(a2Local, a1Local, 0, 0, CeilDivision(baseM, CUBE_BLOCK),
            CeilDivision(baseK, C0_SIZE / sizeof(inputType)), CeilDivision(baseM, CUBE_BLOCK),
            CeilDivision(baseM, CUBE_BLOCK));
    }

    __aicore__ inline void SplitB(
        uint32_t kIndex, __cbuf__ inputType* b1Local, __cb__ inputType* b2Local)
    {
        // Nz -> Zn
        asc_copy_l12l0b_transpose(b2Local, b1Local, 0, 0, CeilDivision(baseK, CUBE_BLOCK),
            CeilDivision(baseN, C0_SIZE / sizeof(inputType)), CeilDivision(baseK, CUBE_BLOCK),
            CeilDivision(baseN, CUBE_BLOCK));
    }

    __aicore__ inline void Compute(
        uint32_t kIndex, __cc__ l0cType* c, __ca__ inputType* a, __cb__ inputType* b)
    {
        bool cmatrixInitVal = kIndex == 0;
        asc_mmad(c, a, b, baseM, baseK, CeilAlign(baseN, C0_SIZE), asc_unit_flag_mode::DISABLE, false, false,
            cmatrixInitVal);
        if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
            asc_sync_pipe(PIPE_M);
        }
    }

    __aicore__ inline void CopyOut(__cc__ l0cType* c)
    {
        // 不同场景用于展示asc_copy_l0c2gm的NZ输出、NZ2ND输出、relu、量化等能力，参数差异集中在这里配置。
        constexpr auto l2CacheMode = asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM;
        constexpr auto unitFlagMode = asc_unit_flag_mode::DISABLE;
        constexpr auto noQuant = QuantMode_t::NoQuant;
        constexpr auto noRelu = asc_relu_pre_mode::NONE;
        if constexpr (SCENARIO_NUM == 1) {
            // 场景1：输出格式NZ，输出数据类型float
            uint16_t c0Size = 16;
            // NZ2NZ场景，dstStride单位为元素个数
            uint32_t dstStride = baseM * c0Size;
            asc_copy_l0c2gm(cGM, c, CeilAlign(baseN, c0Size), baseM, dstStride,
                CeilAlign(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, noQuant, noRelu, false, false, false, false);

        } else if constexpr (SCENARIO_NUM == 2) {
            // 场景2：输出格式ND，输出数据类型float
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2gm(cGM, c, baseN, baseM, baseN, CeilAlign(baseM, CUBE_BLOCK), l2CacheMode,
                unitFlagMode, noQuant, noRelu, false, true, false, false);

        } else if constexpr (SCENARIO_NUM == 3) {
            // 场景3：输出格式DN，输出数据类型float
            asc_set_l0c_copy_channel_para(1);
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2gm(cGM, c, baseN, baseM, baseM, CeilAlign(baseM, CUBE_BLOCK), l2CacheMode,
                unitFlagMode, noQuant, noRelu, false, false, true, false);

        } else if constexpr (SCENARIO_NUM == 4) {
            // 场景4：输出格式ND，输出数据类型int8_t，使能Scalar量化
            asc_set_l0c_copy_prequant(quantScalar, 0, true);
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2gm(cGM, c, baseN, baseM, baseN, CeilAlign(baseM, CUBE_BLOCK), l2CacheMode,
                unitFlagMode, QuantMode_t::QF322B8_PRE, noRelu, false, true, false, false);

        } else if constexpr (SCENARIO_NUM == 5) {
            // 场景5：输出格式ND，输出数据类型int8_t，使能Vector量化
            __cbuf__ uint64_t quantAlphaTensor[baseN];
            __fbuf__ uint64_t quantAlphaFbuf[baseN];
            CopyQuantAlphaGmToL1(quantAlphaTensor, quantAlphaFbuf);
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2gm(cGM, c, baseN, baseM, baseN, CeilAlign(baseM, CUBE_BLOCK), l2CacheMode,
                unitFlagMode, QuantMode_t::VQF322B8_PRE, noRelu, false, true, false, false);

        } else if constexpr (SCENARIO_NUM == 6) {
            // 场景6：输出格式ND，输出数据类型float，使能relu
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2gm(cGM, c, baseN, baseM, baseN, CeilAlign(baseM, CUBE_BLOCK), l2CacheMode,
                unitFlagMode, noQuant, asc_relu_pre_mode::NORMAL, false, true, false, false);

        } else if constexpr (SCENARIO_NUM == 7) {
            // 场景7：输出格式NZ，输出数据类型float，使能ChannelSplit
            // fp32 cube block: [16, 8]
            uint16_t c0Size = 8;
            // NZ2NZ场景，dstStride单位为元素个数
            uint32_t dstStride = baseM * c0Size;
            asc_copy_l0c2gm(cGM, c, CeilAlign(baseN, c0Size), baseM, dstStride,
                CeilAlign(baseM, CUBE_BLOCK), l2CacheMode, unitFlagMode, noQuant, noRelu, true, false, false, false);
        }
    }

private:
    __gm__ inputType* aGM;
    __gm__ inputType* bGM;
    __gm__ outputType* cGM;
    __gm__ uint64_t* quantAlphaGM;

    float quantScalar = 2.0;
    // 注意沿着K轴切分
    uint32_t aSingleSize, bSingleSize, cSingleSize;

    uint32_t aSizeAlignL1, bSizeAlignL1;
    uint32_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0;
};

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void fixpipe_l0c2gm(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* quantAlpha)
{
    if constexpr (SCENARIO_NUM == 4 || SCENARIO_NUM == 5) {
        KernelFixpipe<half, int8_t, float, M, K / K_ROUND, N> op;
        op.Init(a, b, c, quantAlpha);
        op.Process();
    } else {
        KernelFixpipe<half, float, float, M, K / K_ROUND, N> op;
        op.Init(a, b, c, quantAlpha);
        op.Process();
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    // A No Trans, B No Trans
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 256;
    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize;
    if constexpr (SCENARIO_NUM == 4 || SCENARIO_NUM == 5) {
        cFileSize = M * N * sizeof(int8_t);
    } else {
        cFileSize = M * N * sizeof(float);
    }
    size_t quantAlphaSize = 1 * N * sizeof(uint64_t);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* quantAlphaHost;
    uint8_t* quantAlphaDevice;
    aclrtMallocHost((void**)(&quantAlphaHost), quantAlphaSize);
    aclrtMalloc((void**)&quantAlphaDevice, quantAlphaSize, ACL_MEM_MALLOC_HUGE_FIRST);
    // vector quant mode
    if constexpr (SCENARIO_NUM == 5) {
        ReadFile("./input/quant_pre.bin", quantAlphaSize, quantAlphaHost, quantAlphaSize);
    }
    aclrtMemcpy(quantAlphaDevice, quantAlphaSize, quantAlphaHost, quantAlphaSize, ACL_MEMCPY_HOST_TO_DEVICE);

    fixpipe_l0c2gm<M, K, N><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice, quantAlphaDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtFree(quantAlphaDevice);
    aclrtFreeHost(quantAlphaHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
