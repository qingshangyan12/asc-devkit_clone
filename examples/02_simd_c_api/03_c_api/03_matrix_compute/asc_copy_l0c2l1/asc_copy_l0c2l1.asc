/* !
 * \file asc_copy_l0c2l1.asc
 * \brief 本样例介绍如何使用asc_copy_l0c2l1将矩阵乘的结果从L0C（L0C Buffer）搬出到L1（L1 Buffer）
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

// 沿着K轴切分为K_ROUND块
constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

template <
    class inputType, class outputType, class l0cType, class gmOutputType3510, uint32_t baseM, uint32_t baseK,
    uint32_t baseN>
class KernelAscCopyL0C2L1 {
public:
    __aicore__ inline KernelAscCopyL0C2L1()
    {
        asc_init();
        aSingleSize = baseM * baseK;
        bSingleSize = baseK * baseN;
        cSingleSize = baseM * baseN;
        // A 不转置
        aSizeAlignL1 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        aSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseK, C0_SIZE);
        // B 不转置
        bSizeAlignL1 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        bSizeAlignL0 = CeilAlign(baseK, C0_SIZE) * CeilAlign(baseN, C0_SIZE);
        // C矩阵无视数据类型和a、b是否转置，m,n都向16对齐
        cSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
        cSizeAlignL1 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
        // D 不转置
        dSizeAlignL0 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
        dSizeAlignL1 = CeilAlign(baseM, CUBE_BLOCK) * CeilAlign(baseN, CUBE_BLOCK);
    }

    __aicore__ inline void Init(
        __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* d, __gm__ uint8_t* quantAlpha)
    {
        aGM = (__gm__ inputType*)a;
        bGM = (__gm__ inputType*)b;
        cGM = (__gm__ gmOutputType3510*)c;
        dGM = (__gm__ outputType*)d;
        quantAlphaGM = (__gm__ uint64_t*)quantAlpha;
    }

    __aicore__ inline void Process()
    {
        uint32_t chunkSize = K_ROUND;
        __cbuf__ inputType a1Local[baseM * baseK];
        __ca__ inputType a2Local[baseM * baseK];
        __cbuf__ inputType b1Local[baseK * baseN];
        __cb__ inputType b2Local[baseK * baseN];
        __cc__ l0cType c[baseM * baseN];
        __cbuf__ outputType c1Local[baseM * baseN];
        for (uint32_t kIndex = 0; kIndex < chunkSize; kIndex++) {
            CopyIn(kIndex, a1Local, b1Local);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            SplitA(kIndex, a1Local, a2Local);
            SplitB(kIndex, b1Local, b2Local);
            asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
            Compute(kIndex, c, a2Local, b2Local);
            asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
        }

        __cbuf__ uint64_t quantAlphaTensor[baseN];
        __fbuf__ uint64_t quantAlphaFbuf[baseN];
        // vector quant mode
        if constexpr (SCENARIO_NUM == 3) {
            CopyQuantAlphaGmToL1(quantAlphaTensor, quantAlphaFbuf);
        }

        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        CopyOut(c1Local, c);

        // 针对__NPU_ARCH__为3510的场景，L1上的数据无法直接搬运到GM上，因此通过再次矩阵计算并直接输出到GM进行结果校验
        __ca__ outputType c2Local[baseM * baseN];
        __cbuf__ outputType d1Local[baseN * baseN];
        __cb__ outputType d2Local[baseN * baseN];
        __cc__ gmOutputType3510 eCO1Local[baseM * baseN];
        CopyInD(d1Local);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        SplitD(d1Local, d2Local);
        asc_sync_notify(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
        SplitC(c1Local, c2Local);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        ComputeE(eCO1Local, c2Local, d2Local);
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        CopyOutE(eCO1Local);
    }

private:
    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return static_cast<uint16_t>(AscendC::Std::ceil_div(numerator, denominator) * denominator);
    }

    __aicore__ inline void CopyQuantAlphaGmToL1(__cbuf__ uint64_t* quantAlphaTensor, __fbuf__ uint64_t* quantAlphaFbuf)
    {
        asc_sync_notify(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        uint16_t burstLen = CeilAlign(baseN * sizeof(uint64_t), 128) / 32;
        asc_copy_gm2l1((__cbuf__ void*)quantAlphaTensor, (__gm__ void*)quantAlphaGM, 1, burstLen, 0, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_copy_l12fb(
            (__fbuf__ void*)quantAlphaFbuf, (__cbuf__ void*)quantAlphaTensor, 1,
            CeilAlign(baseN * sizeof(uint64_t), 128) / 64, 0, 0);
        uint64_t quantAlphaFbufAddr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quantAlphaFbuf)) / 128;
        asc_set_l0c_copy_config(0, quantAlphaFbufAddr, false);
        asc_sync_pipe(PIPE_FIX);
    }

    __aicore__ inline void CopyIn(uint32_t kIndex, __cbuf__ inputType* a1Local, __cbuf__ inputType* b1Local)
    {
        // 传输ND矩阵的数目
        uint16_t matrixNum = 1;
        uint16_t dstNzNStride = 1;
        uint16_t dstNzMatrixStride = 0;
        // 目的NZ矩阵中，来自源操作数同一行的多行数据相邻行起始地址间的偏移。
        // 取值范围：dstNzC0Stride∈[1, 16384]，单位：C0_SIZE（32B）。
        uint16_t dstNzC0Stride = CeilAlign(baseM, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
        asc_copy_gm2l1_nd2nz(
            a1Local, aGM + kIndex * aSingleSize, baseK * sizeof(inputType), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
            baseM, baseK, 0, false);

        dstNzC0Stride = CeilAlign(baseK, CUBE_BLOCK);
        asc_set_gm2l1_nz_para(matrixNum, dstNzNStride, dstNzC0Stride, dstNzMatrixStride);
        asc_copy_gm2l1_nd2nz(
            b1Local, bGM + kIndex * bSingleSize, baseN * sizeof(inputType), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
            baseK, baseN, 0, false);
    }

    __aicore__ inline void SplitA(uint32_t kIndex, __cbuf__ inputType* a1Local, __ca__ inputType* a2Local)
    {
        // Nz -> Nz
        asc_copy_l12l0a(
            a2Local, a1Local, 0, 0, AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseK, C0_SIZE / sizeof(inputType)), AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseM, CUBE_BLOCK));
    }

    __aicore__ inline void SplitB(uint32_t kIndex, __cbuf__ inputType* b1Local, __cb__ inputType* b2Local)
    {
        // Nz -> Zn
        asc_copy_l12l0b_transpose(
            b2Local, b1Local, 0, 0, AscendC::Std::ceil_div(baseK, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseN, C0_SIZE / sizeof(inputType)), AscendC::Std::ceil_div(baseK, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseN, CUBE_BLOCK));
    }

    __aicore__ inline void Compute(uint32_t kIndex, __cc__ l0cType* c, __ca__ inputType* a, __cb__ inputType* b)
    {
        bool cmatrixInitVal = kIndex == 0;
        asc_mmad(
            c, a, b, baseM, baseK, CeilAlign(baseN, C0_SIZE), asc_unit_flag_mode::DISABLE, false, false,
            cmatrixInitVal);
        if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
            asc_sync_pipe(PIPE_M);
        }
    }

    __aicore__ inline void CopyOut(__cbuf__ outputType* c1Local, __cc__ l0cType* c)
    {
        constexpr uint16_t c0Size = C0_SIZE / sizeof(outputType);
        // NZ2NZ场景，dstStride单位为元素个数
        uint32_t dstStride = baseM * c0Size;
        if constexpr (SCENARIO_NUM == 1) {
            // 场景1：输出格式Nz，输出到L1的数据类型为half
            asc_copy_l0c2l1(
                c1Local, c, CeilAlign(baseN, c0Size), baseM, dstStride, CeilAlign(baseM, CUBE_BLOCK),
                asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NONE, false, false, false, false);

        } else if constexpr (SCENARIO_NUM == 2) {
            // 场景2：输出格式Nz，输出到L1的数据类型为int8_t，使能Scalar量化
            asc_set_l0c_copy_prequant(quantScalar, 0, true);
            asc_copy_l0c2l1(
                c1Local, c, baseN, baseM, dstStride, CeilAlign(baseM, CUBE_BLOCK), asc_unit_flag_mode::DISABLE,
                QuantMode_t::QF322B8_PRE, asc_relu_pre_mode::NONE, false, false, false, false);

        } else if constexpr (SCENARIO_NUM == 3) {
            // 场景3：输出格式Nz，输出到L1的数据类型为int8_t，使能Vector量化
            asc_copy_l0c2l1(
                c1Local, c, baseN, baseM, dstStride, CeilAlign(baseM, CUBE_BLOCK), asc_unit_flag_mode::DISABLE,
                QuantMode_t::VQF322B8_PRE, asc_relu_pre_mode::NONE, false, false, false, false);

        } else if constexpr (SCENARIO_NUM == 4) {
            // 场景4：输出格式Nz，输出到L1的数据类型为half，使能relu
            asc_copy_l0c2l1(
                c1Local, c, CeilAlign(baseN, c0Size), baseM, dstStride, CeilAlign(baseM, CUBE_BLOCK),
                asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NORMAL, false, false, false,
                false);
        }
    }

    // 将第二次矩阵计算所需的右矩阵D从GM搬运到L1上
    __aicore__ inline void CopyInD(__cbuf__ outputType* d1Local)
    {
        asc_set_gm2l1_nz_para(1, 1, CeilAlign(baseM, CUBE_BLOCK), 0);
        asc_copy_gm2l1_nd2nz(
            d1Local, dGM, baseN * sizeof(outputType), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseM, baseN, 0,
            false);
    }

    // 将L1上第一次矩阵计算得到的结果矩阵C作为第二次矩阵计算的左矩阵搬运到L0A上
    __aicore__ inline void SplitC(__cbuf__ outputType* c1Local, __ca__ outputType* c2Local)
    {
        asc_copy_l12l0a(
            c2Local, c1Local, 0, 0, AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseN, C0_SIZE / sizeof(outputType)), AscendC::Std::ceil_div(baseM, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseM, CUBE_BLOCK));
    }

    // 将L1的右矩阵D搬运到L0B上
    __aicore__ inline void SplitD(__cbuf__ outputType* d1Local, __cb__ outputType* d2Local)
    {
        asc_copy_l12l0b_transpose(
            d2Local, d1Local, 0, 0, AscendC::Std::ceil_div(baseN, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseN, C0_SIZE / sizeof(outputType)), AscendC::Std::ceil_div(baseN, CUBE_BLOCK),
            AscendC::Std::ceil_div(baseN, CUBE_BLOCK));
    }

    __aicore__ inline void ComputeE(__cc__ gmOutputType3510* e, __ca__ outputType* c, __cb__ outputType* d)
    {
        asc_mmad(e, c, d, baseM, baseN, CeilAlign(baseN, C0_SIZE), asc_unit_flag_mode::DISABLE, false, false, true);
        if ((baseM / ALIGN_NUM) * (baseN / ALIGN_NUM) < LIMIT_MNSIZE) {
            asc_sync_pipe(PIPE_M);
        }
    }

    __aicore__ inline void CopyOutE(__cc__ gmOutputType3510* e)
    {
        // L0C搬运到GM，输出格式为ND
        asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(
            cGM, e, baseN, baseM, baseN, CeilAlign(baseM, CUBE_BLOCK), asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
            asc_unit_flag_mode::DISABLE, QuantMode_t::NoQuant, asc_relu_pre_mode::NONE, false, true, false, false);
    }

private:
    __gm__ inputType* aGM;
    __gm__ inputType* bGM;
    __gm__ outputType* dGM;
    __gm__ gmOutputType3510* cGM;
    __gm__ uint64_t* quantAlphaGM;

    float quantScalar = 2.0;
    uint32_t aSingleSize, bSingleSize, cSingleSize;
    uint32_t aSizeAlignL1, bSizeAlignL1, cSizeAlignL1, dSizeAlignL1;
    uint32_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0, dSizeAlignL0;
};

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void asc_copy_l0c2l1(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* d, __gm__ uint8_t* quantAlpha)
{
    if constexpr (SCENARIO_NUM == 2 || SCENARIO_NUM == 3) {
        KernelAscCopyL0C2L1<half, int8_t, float, int32_t, M, K / K_ROUND, N> op;
        op.Init(a, b, c, d, quantAlpha);
        op.Process();
    } else {
        KernelAscCopyL0C2L1<half, half, float, float, M, K / K_ROUND, N> op;
        op.Init(a, b, c, d, quantAlpha);
        op.Process();
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 128;
    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);

    size_t dFileSize;
    if constexpr (SCENARIO_NUM == 2 || SCENARIO_NUM == 3) {
        dFileSize = M * N * sizeof(int8_t);
    } else {
        dFileSize = M * N * sizeof(half);
    }

    size_t cFileSize;
    if constexpr (SCENARIO_NUM == 2 || SCENARIO_NUM == 3) {
        cFileSize = M * N * sizeof(int32_t);
    } else {
        cFileSize = M * N * sizeof(float);
    }

    size_t quantAlphaSize = 1 * N * sizeof(uint64_t);
    uint32_t numBlocks = 1;

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* aHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* dHost = nullptr;
    uint8_t* dDevice = nullptr;
    uint8_t* cHost = nullptr;
    uint8_t* cDevice = nullptr;
    uint8_t* quantAlphaHost = nullptr;
    uint8_t* quantAlphaDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    auto checkAcl = [](aclError result, const char* operation) {
        if (result != ACL_SUCCESS) {
            ERROR_LOG("%s failed, ret = %d", operation, static_cast<int32_t>(result));
            return false;
        }
        return true;
    };
    auto cleanup = [&]() {
        if (quantAlphaDevice != nullptr) {
            aclrtFree(quantAlphaDevice);
        }
        if (quantAlphaHost != nullptr) {
            aclrtFreeHost(quantAlphaHost);
        }
        if (cDevice != nullptr) {
            aclrtFree(cDevice);
        }
        if (cHost != nullptr) {
            aclrtFreeHost(cHost);
        }
        if (dDevice != nullptr) {
            aclrtFree(dDevice);
        }
        if (dHost != nullptr) {
            aclrtFreeHost(dHost);
        }
        if (bDevice != nullptr) {
            aclrtFree(bDevice);
        }
        if (bHost != nullptr) {
            aclrtFreeHost(bHost);
        }
        if (aDevice != nullptr) {
            aclrtFree(aDevice);
        }
        if (aHost != nullptr) {
            aclrtFreeHost(aHost);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            aclrtResetDevice(deviceId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    };

    if (!checkAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    aclInitialized = true;
    if (!checkAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        cleanup();
        return 1;
    }
    deviceSet = true;
    if (!checkAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        cleanup();
        return 1;
    }

    if (!checkAcl(aclrtMallocHost(reinterpret_cast<void**>(&aHost), aFileSize), "aclrtMallocHost(aHost)") ||
        !checkAcl(
            aclrtMalloc(reinterpret_cast<void**>(&aDevice), aFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(aDevice)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize)) {
        cleanup();
        return 1;
    }
    if (!checkAcl(
            aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(aDevice)")) {
        cleanup();
        return 1;
    }

    if (!checkAcl(aclrtMallocHost(reinterpret_cast<void**>(&bHost), bFileSize), "aclrtMallocHost(bHost)") ||
        !checkAcl(
            aclrtMalloc(reinterpret_cast<void**>(&bDevice), bFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(bDevice)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize)) {
        cleanup();
        return 1;
    }
    if (!checkAcl(
            aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(bDevice)")) {
        cleanup();
        return 1;
    }

    if (!checkAcl(aclrtMallocHost(reinterpret_cast<void**>(&dHost), dFileSize), "aclrtMallocHost(dHost)") ||
        !checkAcl(
            aclrtMalloc(reinterpret_cast<void**>(&dDevice), dFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(dDevice)")) {
        cleanup();
        return 1;
    }
    if constexpr (SCENARIO_NUM == 2 || SCENARIO_NUM == 3) {
        if (!ReadFile("./input/x3_gm_int8.bin", dFileSize, dHost, dFileSize)) {
            cleanup();
            return 1;
        }
    } else {
        if (!ReadFile("./input/x3_gm_half.bin", dFileSize, dHost, dFileSize)) {
            cleanup();
            return 1;
        }
    }
    if (!checkAcl(
            aclrtMemcpy(dDevice, dFileSize, dHost, dFileSize, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(dDevice)")) {
        cleanup();
        return 1;
    }

    if (!checkAcl(aclrtMallocHost(reinterpret_cast<void**>(&cHost), cFileSize), "aclrtMallocHost(cHost)") ||
        !checkAcl(
            aclrtMalloc(reinterpret_cast<void**>(&cDevice), cFileSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(cDevice)")) {
        cleanup();
        return 1;
    }

    // vector quant mode
    if constexpr (SCENARIO_NUM == 3) {
        if (!checkAcl(
                aclrtMallocHost(reinterpret_cast<void**>(&quantAlphaHost), quantAlphaSize),
                "aclrtMallocHost(quantAlphaHost)") ||
            !checkAcl(
                aclrtMalloc(reinterpret_cast<void**>(&quantAlphaDevice), quantAlphaSize, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(quantAlphaDevice)")) {
            cleanup();
            return 1;
        }
        if (!ReadFile("./input/quant_pre.bin", quantAlphaSize, quantAlphaHost, quantAlphaSize)) {
            cleanup();
            return 1;
        }
        if (!checkAcl(
                aclrtMemcpy(
                    quantAlphaDevice, quantAlphaSize, quantAlphaHost, quantAlphaSize, ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(quantAlphaDevice)")) {
            cleanup();
            return 1;
        }
    }

    asc_copy_l0c2l1<M, K, N><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice, dDevice, quantAlphaDevice);
    if (!checkAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        cleanup();
        return 1;
    }

    if (!checkAcl(aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy(cHost)")) {
        cleanup();
        return 1;
    }
    bool writeSuccess = WriteFile("./output/output.bin", cHost, cFileSize);

    cleanup();
    return writeSuccess ? 0 : 1;
}
