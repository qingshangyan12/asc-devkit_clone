/* !
 * \file mmad.asc
 * \brief C API 矩阵乘法样例（场景 1 / 场景 2 / 场景 3）
 *        场景1：int8_t  输入、int32_t 输出、A/B 均不转置、带 Bias
 *        场景2：bfloat16 输入、float   输出、A 不转置 B 转置、无 Bias（两次 Mmad 累加）
 *        场景3：float     输入、float   输出、A/B 转置、显式传入 Bias 地址
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"

// The C API include chain does not currently provide this compatibility macro required by cmath.h.
#ifndef ASCENDC_HOST_AICORE
#if defined(__CCE__) && __CCE__
#define ASCENDC_HOST_AICORE __host_aicore__
#else
#define ASCENDC_HOST_AICORE
#endif
#endif
#include "utils/std/cmath.h"

#include "data_utils.h"

// ========== 编译期场景配置 ==========
constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr bool HAS_BIAS_TENSOR = (SCENARIO_NUM == 1 || SCENARIO_NUM == 3);

// ========== 共享架构常量 ==========
constexpr uint32_t BLOCK_CUBE = 16;

// ========== 矩阵维度 ==========
constexpr uint32_t M = 30;
constexpr uint32_t N = 40;
constexpr uint32_t K = 70;

ASCENDC_HOST_AICORE inline constexpr uint32_t ceil_align(uint32_t value, uint32_t alignment)
{
    return static_cast<uint32_t>(AscendC::Std::ceil_div(value, alignment) * alignment);
}

// ========== 各场景的常量与流水线函数 ==========
#include "mmad_s1.h"
#include "mmad_s2.h"
#include "mmad_s3.h"

// ==================================================================
// 核函数入口：按场景分发四阶段流水线
// ==================================================================
__global__ __cube__ void mmad_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* bias, __gm__ uint8_t* c)
{
    asc_init();

    if constexpr (scenario_num == 1) {
        // === 场景 1：int8_t，带 Bias ===
        __cbuf__ int8_t a_l1[S1_A_L1_SIZE];
        __cbuf__ int8_t b_l1[S1_B_L1_SIZE];
        __cbuf__ int32_t bias_l1[S1_BIAS_ELEMS];

        s1_copy_matrix_a_to_l1(a_l1, (__gm__ int8_t*)a);
        s1_copy_matrix_b_to_l1(b_l1, (__gm__ int8_t*)b);
        s1_copy_bias_to_l1(bias_l1, (__gm__ int32_t*)bias);

        __ca__ int8_t a_l0[S1_A_L0_SIZE];
        __cb__ int8_t b_l0[S1_B_L0_SIZE];

        s1_split_matrix_a_to_l0a(a_l0, a_l1);
        s1_split_matrix_b_to_l0b_trans(b_l0, b_l1);
        s1_split_bias_to_bt(bias_l1);

        __cc__ int32_t c_l0[S1_C_L0_SIZE];

        s1_compute_mmad(c_l0, a_l0, b_l0);
        s1_copy_result_to_gm((__gm__ int32_t*)c, c_l0);

    } else if constexpr (scenario_num == 2) {
        // === 场景 2：bfloat16，无 Bias，两次 Mmad 累加 ===
        __cbuf__ bfloat16_t a_l1[S2_A_L1_SIZE];
        __cbuf__ bfloat16_t b_l1[S2_B_L1_SIZE];

        s2_copy_matrix_a_to_l1(a_l1, (__gm__ bfloat16_t*)a);
        s2_copy_matrix_b_to_l1(b_l1, (__gm__ bfloat16_t*)b);

        __ca__ bfloat16_t a_l0[S2_A_L0_SIZE];
        __cb__ bfloat16_t b_l0[S2_B_L0_SIZE];

        s2_split_matrix_a_to_l0a(a_l0, a_l1);
        s2_split_matrix_b_to_l0b(b_l0, b_l1);

        __cc__ float c_l0[S2_C_L0_SIZE];

        s2_compute_mmad(c_l0, a_l0, b_l0);
        s2_copy_result_to_gm((__gm__ float*)c, c_l0);

    } else if constexpr (scenario_num == 3) {
        __cbuf__ float a_l1[S3_A_L1_SIZE];
        __cbuf__ float b_l1[S3_B_L1_SIZE];
        __cbuf__ float bias_l1[S3_BIAS_ELEMS];
        __ca__ float a_l0[S3_A_L0_SIZE];
        __cb__ float b_l0[S3_B_L0_SIZE];
        __cc__ float c_l0[S3_C_L0_SIZE];

        s3_copy_matrix_a_to_l1(a_l1, (__gm__ float*)a);
        s3_copy_matrix_b_to_l1(b_l1, (__gm__ float*)b);
        s3_copy_bias_to_l1(bias_l1, (__gm__ float*)bias);
        s3_split_matrix_a_to_l0a_transpose(a_l0, a_l1);
        s3_split_matrix_b_to_l0b(b_l0, b_l1);
        s3_split_bias_to_bt(bias_l1);
        s3_compute_mmad(c_l0, a_l0, b_l0);
        s3_copy_result_to_gm((__gm__ float*)c, c_l0);
    }

    asc_sync_pipe(PIPE_ALL);
}

// ==================================================================
// Host 端主函数
// ==================================================================
int32_t main(int32_t argc, char* argv[])
{
    size_t a_file_size = 0;
    size_t b_file_size = 0;
    size_t bias_file_size = 0;
    size_t c_file_size = 0;

    if constexpr (scenario_num == 1) {
        a_file_size = M * K * sizeof(int8_t);
        b_file_size = K * N * sizeof(int8_t);
        bias_file_size = N * sizeof(int32_t);
        c_file_size = M * N * sizeof(int32_t);
    } else if constexpr (scenario_num == 2) {
        a_file_size = M * K * sizeof(bfloat16_t);
        b_file_size = K * N * sizeof(bfloat16_t);
        bias_file_size = N * sizeof(float);
        c_file_size = M * N * sizeof(float);
    } else if constexpr (scenario_num == 3) {
        a_file_size = M * K * sizeof(float);
        b_file_size = K * N * sizeof(float);
        bias_file_size = N * sizeof(float);
        c_file_size = M * N * sizeof(float);
    }

    uint32_t num_blocks = 1;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    uint8_t* bias_host = nullptr;
    uint8_t* bias_device = nullptr;
    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    auto check_acl = [](aclError result, const char* operation) {
        if (result != ACL_SUCCESS) {
            ERROR_LOG("%s failed, ret = %d", operation, static_cast<int32_t>(result));
            return false;
        }
        return true;
    };
    auto cleanup = [&]() {
        if (c_device != nullptr) {
            aclrtFree(c_device);
        }
        if (c_host != nullptr) {
            aclrtFreeHost(c_host);
        }
        if (bias_device != nullptr) {
            aclrtFree(bias_device);
        }
        if (bias_host != nullptr) {
            aclrtFreeHost(bias_host);
        }
        if (b_device != nullptr) {
            aclrtFree(b_device);
        }
        if (b_host != nullptr) {
            aclrtFreeHost(b_host);
        }
        if (a_device != nullptr) {
            aclrtFree(a_device);
        }
        if (a_host != nullptr) {
            aclrtFreeHost(a_host);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (device_set) {
            aclrtResetDevice(device_id);
        }
        if (acl_initialized) {
            aclFinalize();
        }
    };

    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    acl_initialized = true;
    if (!check_acl(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        cleanup();
        return 1;
    }
    device_set = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size), "aclrtMallocHost(a_host)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(a_device)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size)) {
        cleanup();
        return 1;
    }
    if (!check_acl(
            aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(a_device)")) {
        cleanup();
        return 1;
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size), "aclrtMallocHost(b_host)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(b_device)")) {
        cleanup();
        return 1;
    }
    if (!ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size)) {
        cleanup();
        return 1;
    }
    if (!check_acl(
            aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(b_device)")) {
        cleanup();
        return 1;
    }

    if constexpr (HAS_BIAS_TENSOR) {
        if (!check_acl(
                aclrtMallocHost(reinterpret_cast<void**>(&bias_host), bias_file_size), "aclrtMallocHost(bias_host)") ||
            !check_acl(
                aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(bias_device)")) {
            cleanup();
            return 1;
        }
        if (!ReadFile("./input/bias_gm.bin", bias_file_size, bias_host, bias_file_size)) {
            cleanup();
            return 1;
        }
        if (!check_acl(
                aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(bias_device)")) {
            cleanup();
            return 1;
        }
    }

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size), "aclrtMallocHost(c_host)") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(c_device)")) {
        cleanup();
        return 1;
    }

    mmad_custom<<<num_blocks, 0, stream>>>(a_device, b_device, bias_device, c_device);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        cleanup();
        return 1;
    }

    if (!check_acl(
            aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(c_host)")) {
        cleanup();
        return 1;
    }
    bool write_success = WriteFile("./output/output.bin", c_host, c_file_size);

    cleanup();
    return write_success ? 0 : 1;
}
