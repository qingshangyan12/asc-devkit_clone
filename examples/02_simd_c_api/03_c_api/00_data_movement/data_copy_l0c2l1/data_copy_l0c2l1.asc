/* !
 * \file data_copy_l0c2l1.asc
 * \brief Demonstrates L0C-to-L1 matrix movement with inline quantization using the Ascend C C API.
 *
 * On dav-3510, L1 Buffer data cannot be moved directly to GM. After asc_copy_l0c2l1 writes the
 * quantized result to L1, a second Mmad (C * identity_D) moves the data through L1->L0A->L0C->GM
 * so that the host side can verify the result.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_BYTES = 32;
constexpr uint32_t K_ROUND = 2;
constexpr uint32_t FIXPIPE_QUANT_ADDR_GRANULARITY = 128;
constexpr uint32_t FIXPIPE_L1_TO_FB_BURST_BYTES = 64;

constexpr uint32_t M = 128;
constexpr uint32_t K = 128;
constexpr uint32_t N = 128;
constexpr uint32_t K_CHUNK = K / K_ROUND;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__aicore__ constexpr uint32_t ceil_align(uint32_t numerator, uint32_t denominator)
{
    return ceil_division(numerator, denominator) * denominator;
}

// --- Scenario configuration ---
//   1: half→int8,  scalar QF322B8_PRE
//   2: half→int8,  vector VQF322B8_PRE
//   3: int8→int8,  scalar REQ8
//   4: int8→int8,  vector VREQ8
//   5: half→half,  cast  F322F16
//   6: half→half,  vector VQF322F16_PRE
//   7: int8→half,  scalar DEQF16
//   8: int8→half,  vector VDEQF16
//   9: half→bf16,  cast  F322BF16
//  10: half→bf16,  vector VQF322BF16_PRE
//  11: int8→int4b, vector VREQ4
//  12: int8→bf16,  vector VQS322BF16_PRE
//  13: half→int4b, vector VQF322S4_PRE
//  14: half→fp8,   vector VQF322FP8_PRE
//  15: half→hif8,  vector VQF322HIF8_PRE
//  16: half→hif8,  vector VQF322HIF8_PRE_HYBRID
//  17: half→float, vector VQF322F32_PRE
constexpr bool IS_INT8_INPUT =
    SCENARIO_NUM == 3 || SCENARIO_NUM == 4 || SCENARIO_NUM == 7 || SCENARIO_NUM == 8 ||
    SCENARIO_NUM == 11 || SCENARIO_NUM == 12;
constexpr bool IS_INT8_OUTPUT = SCENARIO_NUM <= 4;
constexpr bool IS_INT4B_OUTPUT = SCENARIO_NUM == 11 || SCENARIO_NUM == 13;
constexpr bool IS_BF16_OUTPUT = SCENARIO_NUM == 9 || SCENARIO_NUM == 10 || SCENARIO_NUM == 12;
constexpr bool IS_FP8_OUTPUT = SCENARIO_NUM == 14;
constexpr bool IS_HIF8_OUTPUT = SCENARIO_NUM == 15 || SCENARIO_NUM == 16;
constexpr bool IS_FLOAT_OUTPUT = SCENARIO_NUM == 17;
constexpr bool IS_HALF_OUTPUT = !IS_INT8_OUTPUT && !IS_INT4B_OUTPUT && !IS_BF16_OUTPUT &&
                               !IS_FP8_OUTPUT && !IS_HIF8_OUTPUT && !IS_FLOAT_OUTPUT;
constexpr bool IS_VECTOR_QUANT =
    SCENARIO_NUM == 2 || SCENARIO_NUM == 4 || SCENARIO_NUM == 6 || SCENARIO_NUM == 8 ||
    SCENARIO_NUM == 10 || SCENARIO_NUM == 11 || SCENARIO_NUM == 12 || SCENARIO_NUM == 13 ||
    SCENARIO_NUM == 14 || SCENARIO_NUM == 15 || SCENARIO_NUM == 16 || SCENARIO_NUM == 17;
// --- CANN overload availability for dav-3510 ---
// These overloads are declared in CANN headers but not all are implemented
// for dav-3510 in CANN 9.2.0. Toggle these macros when upgrading CANN.
#ifndef ASC_HAS_L0C2L1_BF16_INT32
#define ASC_HAS_L0C2L1_BF16_INT32 0
#endif
#ifndef ASC_HAS_L0C2L1_FP8
#define ASC_HAS_L0C2L1_FP8 0
#endif
#ifndef ASC_HAS_L0C2L1_HIF8
#define ASC_HAS_L0C2L1_HIF8 0
#endif
#ifndef ASC_HAS_MMAD_S4_3510
#define ASC_HAS_MMAD_S4_3510 0
#endif

constexpr bool IS_RELU_ENABLED = false;
constexpr bool L0C_IS_INT32 = IS_INT8_OUTPUT || IS_INT4B_OUTPUT;

// --- Type-dependent constants ---
constexpr uint32_t INT8_C0_ELEMENTS = C0_BYTES / sizeof(int8_t);
constexpr uint32_t HALF_C0_ELEMENTS = C0_BYTES / sizeof(half);
constexpr uint32_t BF16_C0_ELEMENTS = C0_BYTES / sizeof(bfloat16_t);
constexpr uint32_t FLOAT_C0_ELEMENTS = C0_BYTES / sizeof(float);
// int4b_t: sizeof=1 but bit-width=4, so C0 elements = 64 (2 values per byte)
constexpr uint32_t INT4B_C0_ELEMENTS = C0_BYTES * 2;

constexpr uint32_t OUTPUT_C0_ELEMENTS =
    IS_INT8_OUTPUT ? INT8_C0_ELEMENTS :
    IS_INT4B_OUTPUT ? INT4B_C0_ELEMENTS :
    IS_BF16_OUTPUT ? BF16_C0_ELEMENTS :
    IS_FP8_OUTPUT ? INT8_C0_ELEMENTS :
    IS_HIF8_OUTPUT ? INT8_C0_ELEMENTS :
    IS_FLOAT_OUTPUT ? FLOAT_C0_ELEMENTS :
    HALF_C0_ELEMENTS;

constexpr uint32_t L0C_ELEMENT_SIZE = IS_INT8_INPUT ? sizeof(int32_t) : sizeof(float);
constexpr uint32_t OUTPUT_ELEMENT_SIZE =
    IS_INT8_OUTPUT ? sizeof(int8_t) :
    IS_INT4B_OUTPUT ? sizeof(int4b_t) :
    IS_BF16_OUTPUT ? sizeof(bfloat16_t) :
    IS_FP8_OUTPUT ? sizeof(fp8_e4m3fn_t) :
    IS_HIF8_OUTPUT ? sizeof(hifloat8_t) :
    IS_FLOAT_OUTPUT ? sizeof(float) :
    sizeof(half);
constexpr uint32_t D_ELEMENT_SIZE = OUTPUT_ELEMENT_SIZE;

constexpr uint32_t A_SINGLE_SIZE = M * K_CHUNK;
constexpr uint32_t B_SINGLE_SIZE = K_CHUNK * N;
constexpr uint32_t QUANT_TRANSFER_BYTES = ceil_align(N * sizeof(uint64_t), FIXPIPE_QUANT_ADDR_GRANULARITY);

// L0 workspace sizes
constexpr uint32_t A_L0_BYTES = ceil_align(M, CUBE_BLOCK) * ceil_align(K_CHUNK, HALF_C0_ELEMENTS) * sizeof(half);
constexpr uint32_t B_L0_BYTES = ceil_align(K_CHUNK, HALF_C0_ELEMENTS) * ceil_align(N, HALF_C0_ELEMENTS) * sizeof(half);
constexpr uint32_t C_L0_BYTES = ceil_align(M, CUBE_BLOCK) * ceil_align(N, CUBE_BLOCK) * L0C_ELEMENT_SIZE;
constexpr uint32_t C_L0A_BYTES = ceil_align(M, CUBE_BLOCK) * ceil_align(N, HALF_C0_ELEMENTS) * OUTPUT_ELEMENT_SIZE;
constexpr uint32_t D_L0B_BYTES = ceil_align(N, CUBE_BLOCK) * ceil_align(N, HALF_C0_ELEMENTS) * D_ELEMENT_SIZE;

// L1 workspace layout
constexpr uint32_t A1_OFFSET_BYTES = 0;
constexpr uint32_t B1_OFFSET_BYTES = 64 * 1024;
constexpr uint32_t D1_OFFSET_BYTES = 128 * 1024;
constexpr uint32_t QUANT_OFFSET_BYTES = 192 * 1024;
constexpr uint32_t CBUF_WORKSPACE_BYTES = QUANT_OFFSET_BYTES + QUANT_TRANSFER_BYTES;

constexpr uint8_t L2_CACHE_NORMAL = 0;
constexpr uint8_t UNIT_FLAG_DISABLE = 0;
constexpr uint16_t MTE2_NZ_MATRIX_NUM = 1;
constexpr uint16_t MTE2_NZ_N_STRIDE = 1;
constexpr uint16_t MTE2_NZ_LOOP4_DST_STRIDE = 0;

constexpr uint16_t A_MTE2_NZ_C0_STRIDE =
    static_cast<uint16_t>(IS_INT8_INPUT ? ceil_align(M, INT8_C0_ELEMENTS) : ceil_align(M, HALF_C0_ELEMENTS));
constexpr uint16_t B_MTE2_NZ_C0_STRIDE = static_cast<uint16_t>(
    IS_INT8_INPUT ? ceil_align(K_CHUNK, INT8_C0_ELEMENTS) : ceil_align(K_CHUNK, HALF_C0_ELEMENTS));
constexpr uint16_t D_MTE2_NZ_C0_STRIDE = static_cast<uint16_t>(ceil_align(N, OUTPUT_C0_ELEMENTS));
constexpr uint64_t A_MTE2_NZ_PARA = (static_cast<uint64_t>(MTE2_NZ_LOOP4_DST_STRIDE) << 48) |
                                    (static_cast<uint64_t>(A_MTE2_NZ_C0_STRIDE) << 32) |
                                    (static_cast<uint64_t>(MTE2_NZ_N_STRIDE) << 16) | MTE2_NZ_MATRIX_NUM;
constexpr uint64_t B_MTE2_NZ_PARA = (static_cast<uint64_t>(MTE2_NZ_LOOP4_DST_STRIDE) << 48) |
                                    (static_cast<uint64_t>(B_MTE2_NZ_C0_STRIDE) << 32) |
                                    (static_cast<uint64_t>(MTE2_NZ_N_STRIDE) << 16) | MTE2_NZ_MATRIX_NUM;
constexpr uint64_t D_MTE2_NZ_PARA = (static_cast<uint64_t>(MTE2_NZ_LOOP4_DST_STRIDE) << 48) |
                                    (static_cast<uint64_t>(D_MTE2_NZ_C0_STRIDE) << 32) |
                                    (static_cast<uint64_t>(MTE2_NZ_N_STRIDE) << 16) | MTE2_NZ_MATRIX_NUM;

constexpr uint64_t SCALAR_QUANT_HALF = 0x40000000ULL;
constexpr uint64_t SCALAR_QUANT_INT8 = SCALAR_QUANT_HALF | (1ULL << 46);

// NZ dst stride for asc_copy_l0c2l1
constexpr uint32_t NZ_DST_STRIDE_HALF = M * C0_BYTES / sizeof(half);
constexpr uint32_t NZ_DST_STRIDE_INT8 = M * C0_BYTES / sizeof(int8_t);
constexpr uint32_t NZ_DST_STRIDE_BF16 = M * C0_BYTES / sizeof(bfloat16_t);
constexpr uint32_t NZ_DST_STRIDE_INT4 = M * C0_BYTES * 2;
constexpr uint32_t NZ_DST_STRIDE_FP8 = M * C0_BYTES / sizeof(fp8_e4m3fn_t);
constexpr uint32_t NZ_DST_STRIDE_HIF8 = M * C0_BYTES / sizeof(hifloat8_t);
constexpr uint32_t NZ_DST_STRIDE_F32 = M * CUBE_BLOCK;

// D matrix byte stride for asc_copy_gm2l1_nd2nz (per row in ND format)
constexpr uint32_t D_SRC_STRIDE = N * OUTPUT_ELEMENT_SIZE;
// C output file size: int32 for int8/int4b Mmad, float otherwise
constexpr uint32_t C_FILE_ELEMENT_SIZE = L0C_IS_INT32 ? sizeof(int32_t) : sizeof(float);

__global__ __cube__ void data_copy_l0c2l1(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ void* c, __gm__ uint8_t* d, __gm__ uint64_t* quant_pre)
{
    asc_init();

    __cbuf__ uint8_t cbuf_workspace[CBUF_WORKSPACE_BYTES];
    __ca__ uint8_t a_l0_workspace[A_L0_BYTES > C_L0A_BYTES ? A_L0_BYTES : C_L0A_BYTES];
    __cb__ uint8_t b_l0_workspace[B_L0_BYTES > D_L0B_BYTES ? B_L0_BYTES : D_L0B_BYTES];
    __cc__ uint8_t c_l0_workspace[C_L0_BYTES];

    __cbuf__ uint8_t* c_l1 = cbuf_workspace + A1_OFFSET_BYTES;
    __cbuf__ uint8_t* d_l1 = cbuf_workspace + D1_OFFSET_BYTES;

    if constexpr (IS_INT8_INPUT) {
        __cbuf__ int8_t* a_l1 = reinterpret_cast<__cbuf__ int8_t*>(cbuf_workspace + A1_OFFSET_BYTES);
        __cbuf__ int8_t* b_l1 = reinterpret_cast<__cbuf__ int8_t*>(cbuf_workspace + B1_OFFSET_BYTES);
        __ca__ int8_t* a_l0 = reinterpret_cast<__ca__ int8_t*>(a_l0_workspace);
        __cb__ int8_t* b_l0 = reinterpret_cast<__cb__ int8_t*>(b_l0_workspace);
        __cc__ int32_t* c_l0 = reinterpret_cast<__cc__ int32_t*>(c_l0_workspace);

        for (uint32_t k_index = 0; k_index < K_ROUND; ++k_index) {
            asc_set_gm2l1_nz_para(A_MTE2_NZ_PARA);
            asc_copy_gm2l1_nd2nz(
                a_l1, reinterpret_cast<__gm__ int8_t*>(a) + k_index * A_SINGLE_SIZE, K_CHUNK * sizeof(int8_t),
                L2_CACHE_NORMAL, M, K_CHUNK, 0, false);
            asc_set_gm2l1_nz_para(B_MTE2_NZ_PARA);
            asc_copy_gm2l1_nd2nz(
                b_l1, reinterpret_cast<__gm__ int8_t*>(b) + k_index * B_SINGLE_SIZE, N * sizeof(int8_t),
                L2_CACHE_NORMAL, K_CHUNK, N, 0, false);

            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_copy_l12l0a(
                a_l0, a_l1, 0, 0, ceil_division(M, CUBE_BLOCK), ceil_division(K_CHUNK, INT8_C0_ELEMENTS),
                ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
            const uint32_t dst_offset = ceil_division(N, INT8_C0_ELEMENTS) * 512 * 2;
            const uint32_t src_offset = 512 * 2;
            for (uint32_t i = 0; i < ceil_division(K_CHUNK, INT8_C0_ELEMENTS); ++i) {
                asc_copy_l12l0b_trans(
                    b_l0 + i * dst_offset, b_l1 + i * src_offset, static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, INT8_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(K_CHUNK, INT8_C0_ELEMENTS) * 2), static_cast<uint16_t>(1),
                    static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            }
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
            asc_mmad(
                c_l0, a_l0, b_l0, M, K_CHUNK, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false,
                k_index == 0);
            asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
        }

        if constexpr (IS_VECTOR_QUANT) {
            __cbuf__ uint64_t* quant_l1 =
                reinterpret_cast<__cbuf__ uint64_t*>(cbuf_workspace + QUANT_OFFSET_BYTES);
            __fbuf__ uint64_t quant_fb[QUANT_TRANSFER_BYTES / sizeof(uint64_t)];
            asc_copy_gm2l1(
                reinterpret_cast<__cbuf__ void*>(quant_l1), reinterpret_cast<__gm__ void*>(quant_pre), 1,
                QUANT_TRANSFER_BYTES / C0_BYTES, 0, 0, 0);
            asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
            asc_copy_l12fb(
                reinterpret_cast<__fbuf__ void*>(quant_fb), reinterpret_cast<__cbuf__ void*>(quant_l1), 1,
                QUANT_TRANSFER_BYTES / FIXPIPE_L1_TO_FB_BURST_BYTES, 0, 0);
            const uint64_t quant_fb_addr =
                static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quant_fb)) / FIXPIPE_QUANT_ADDR_GRANULARITY;
            asc_set_l0c2gm_config(0, quant_fb_addr, false);
            asc_sync_pipe(PIPE_FIX);
        }

        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

        // Set CTRL[48] for floating-point saturation mode before quantization output.
        // SATURATION_MODE=1 (default): CTRL[48]=0, inf→±MAX, nan→0 (saturation)
        // SATURATION_MODE=0:           CTRL[48]=1, inf/nan preserved (non-saturation)
        // Integer types always use saturation regardless of this setting.
#ifndef SATURATION_MODE
#define SATURATION_MODE 1
#endif
        asc_set_ctrl(SATURATION_MODE ? (asc_get_ctrl() & ~(1ULL << 48))
                                     : (asc_get_ctrl() | (1ULL << 48)));

        if constexpr (SCENARIO_NUM == 3) {
            asc_set_l0c_copy_prequant(SCALAR_QUANT_INT8);
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ int8_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_INT8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::REQ8), IS_RELU_ENABLED, false, false,
                0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 4) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ int8_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_INT8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VREQ8), IS_RELU_ENABLED, false, false,
                0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 7) {
            asc_set_l0c_copy_prequant(SCALAR_QUANT_HALF);
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ half*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_HALF, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::DEQF16), IS_RELU_ENABLED, false,
                false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 8) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ half*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_HALF, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VDEQF16), IS_RELU_ENABLED, false,
                false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 11) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ int4b_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_INT4, ceil_align(M, CUBE_BLOCK),
                L2_CACHE_NORMAL, 0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VREQ4),
                IS_RELU_ENABLED, false, false, 0, 0, false, 0, false, false, false, false);
        } else if constexpr (SCENARIO_NUM == 12) {
#if ASC_HAS_L0C2L1_BF16_INT32
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ bfloat16_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_BF16, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQS322BF16_PRE), IS_RELU_ENABLED,
                false, false, 0, 0, false, 0, 0, false);
#endif
        }
    } else {
        __cbuf__ half* a_l1 = reinterpret_cast<__cbuf__ half*>(cbuf_workspace + A1_OFFSET_BYTES);
        __cbuf__ half* b_l1 = reinterpret_cast<__cbuf__ half*>(cbuf_workspace + B1_OFFSET_BYTES);
        __ca__ half* a_l0 = reinterpret_cast<__ca__ half*>(a_l0_workspace);
        __cb__ half* b_l0 = reinterpret_cast<__cb__ half*>(b_l0_workspace);
        __cc__ float* c_l0 = reinterpret_cast<__cc__ float*>(c_l0_workspace);

        for (uint32_t k_index = 0; k_index < K_ROUND; ++k_index) {
            asc_set_gm2l1_nz_para(A_MTE2_NZ_PARA);
            asc_copy_gm2l1_nd2nz(
                a_l1, reinterpret_cast<__gm__ half*>(a) + k_index * A_SINGLE_SIZE, K_CHUNK * sizeof(half),
                L2_CACHE_NORMAL, M, K_CHUNK, 0, false);
            asc_set_gm2l1_nz_para(B_MTE2_NZ_PARA);
            asc_copy_gm2l1_nd2nz(
                b_l1, reinterpret_cast<__gm__ half*>(b) + k_index * B_SINGLE_SIZE, N * sizeof(half),
                L2_CACHE_NORMAL, K_CHUNK, N, 0, false);

            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_copy_l12l0a(
                a_l0, a_l1, 0, 0, ceil_division(M, CUBE_BLOCK), ceil_division(K_CHUNK, HALF_C0_ELEMENTS),
                ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
            const uint32_t dst_offset = ceil_division(N, HALF_C0_ELEMENTS) * 256;
            const uint32_t src_offset = 256;
            for (uint32_t i = 0; i < ceil_division(K_CHUNK, HALF_C0_ELEMENTS); ++i) {
                asc_copy_l12l0b_trans(
                    b_l0 + i * dst_offset, b_l1 + i * src_offset, static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, HALF_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(K_CHUNK, HALF_C0_ELEMENTS)), static_cast<uint16_t>(0),
                    static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            }
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
            asc_mmad(
                c_l0, a_l0, b_l0, M, K_CHUNK, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false,
                k_index == 0);
            asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
        }

        if constexpr (IS_VECTOR_QUANT) {
            __cbuf__ uint64_t* quant_l1 =
                reinterpret_cast<__cbuf__ uint64_t*>(cbuf_workspace + QUANT_OFFSET_BYTES);
            __fbuf__ uint64_t quant_fb[QUANT_TRANSFER_BYTES / sizeof(uint64_t)];
            asc_copy_gm2l1(
                reinterpret_cast<__cbuf__ void*>(quant_l1), reinterpret_cast<__gm__ void*>(quant_pre), 1,
                QUANT_TRANSFER_BYTES / C0_BYTES, 0, 0, 0);
            asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
            asc_copy_l12fb(
                reinterpret_cast<__fbuf__ void*>(quant_fb), reinterpret_cast<__cbuf__ void*>(quant_l1), 1,
                QUANT_TRANSFER_BYTES / FIXPIPE_L1_TO_FB_BURST_BYTES, 0, 0);
            const uint64_t quant_fb_addr =
                static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quant_fb)) / FIXPIPE_QUANT_ADDR_GRANULARITY;
            asc_set_l0c2gm_config(0, quant_fb_addr, false);
            asc_sync_pipe(PIPE_FIX);
        }

        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

        // Set CTRL[48] for floating-point saturation mode before quantization output.
        // SATURATION_MODE=1 (default): CTRL[48]=0, inf→±MAX, nan→0 (saturation)
        // SATURATION_MODE=0:           CTRL[48]=1, inf/nan preserved (non-saturation)
        // Integer types always use saturation regardless of this setting.
        // Note: CTRL[48] only affects half/bfloat16/hifloat8/fp8 precision conversions, not float.
        asc_set_ctrl(SATURATION_MODE ? (asc_get_ctrl() & ~(1ULL << 48))
                                     : (asc_get_ctrl() | (1ULL << 48)));

        if constexpr (SCENARIO_NUM == 1) {
            asc_set_l0c_copy_prequant(SCALAR_QUANT_INT8);
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ int8_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_INT8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::QF322B8_PRE), IS_RELU_ENABLED, false,
                false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 2) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ int8_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_INT8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322B8_PRE), IS_RELU_ENABLED, false,
                false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 5) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ half*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_HALF, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::F322F16), IS_RELU_ENABLED, false,
                false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 6) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ half*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_HALF, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322F16_PRE), IS_RELU_ENABLED,
                false, false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 9) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ bfloat16_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_BF16, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::F322BF16), IS_RELU_ENABLED, false,
                false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 10) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ bfloat16_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_BF16, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322BF16_PRE), IS_RELU_ENABLED,
                false, false, 0, 0, false, 0, 0, false);
        } else if constexpr (SCENARIO_NUM == 13) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ int4b_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_INT4, ceil_align(M, CUBE_BLOCK),
                L2_CACHE_NORMAL, 0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322S4_PRE),
                IS_RELU_ENABLED, false, false, 0, 0, false, 0, false, false, false, false);
        } else if constexpr (SCENARIO_NUM == 14) {
#if ASC_HAS_L0C2L1_FP8
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ fp8_e4m3fn_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_FP8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322FP8_PRE), IS_RELU_ENABLED,
                false, false, 0, 0, false, 0, 0, false);
#endif
        } else if constexpr (SCENARIO_NUM == 15) {
#if ASC_HAS_L0C2L1_HIF8
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ hifloat8_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_HIF8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322HIF8_PRE), IS_RELU_ENABLED,
                false, false, 0, 0, false, 0, 0, false);
#endif
        } else if constexpr (SCENARIO_NUM == 16) {
#if ASC_HAS_L0C2L1_HIF8
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ hifloat8_t*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_HIF8, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322HIF8_PRE_HYBRID),
                IS_RELU_ENABLED, false, false, 0, 0, false, 0, 0, false);
#endif
        } else if constexpr (SCENARIO_NUM == 17) {
            asc_copy_l0c2l1(
                reinterpret_cast<__cbuf__ float*>(c_l1), c_l0, ceil_align(N, CUBE_BLOCK), M,
                NZ_DST_STRIDE_F32, ceil_align(M, CUBE_BLOCK),
                0, UNIT_FLAG_DISABLE, static_cast<uint64_t>(QuantMode_t::VQF322F32_PRE), IS_RELU_ENABLED,
                false, false, 0, 0, false, 0, 0, false);
        }
    }

    // ========================================================================
    // Shared second Mmad: E = C × D (identity), moves L1 data to L0C→GM
    // ========================================================================

    // L1 → L0A: load quantized C back
    asc_sync_notify(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_FIX, PIPE_MTE1, EVENT_ID0);

    if constexpr (IS_INT8_OUTPUT) {
        __ca__ int8_t* c_l0a = reinterpret_cast<__ca__ int8_t*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ int8_t*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, INT8_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    } else if constexpr (IS_INT4B_OUTPUT) {
        __ca__ int4b_t* c_l0a = reinterpret_cast<__ca__ int4b_t*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ int4b_t*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, INT4B_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    } else if constexpr (IS_BF16_OUTPUT) {
        __ca__ bfloat16_t* c_l0a = reinterpret_cast<__ca__ bfloat16_t*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ bfloat16_t*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, BF16_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    } else if constexpr (IS_FP8_OUTPUT) {
        __ca__ int8_t* c_l0a = reinterpret_cast<__ca__ int8_t*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ int8_t*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, INT8_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    } else if constexpr (IS_HIF8_OUTPUT) {
        __ca__ int8_t* c_l0a = reinterpret_cast<__ca__ int8_t*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ int8_t*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, INT8_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    } else if constexpr (IS_FLOAT_OUTPUT) {
        __ca__ float* c_l0a = reinterpret_cast<__ca__ float*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ float*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, FLOAT_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    } else {
        __ca__ half* c_l0a = reinterpret_cast<__ca__ half*>(a_l0_workspace);
        asc_copy_l12l0a(
            c_l0a, reinterpret_cast<__cbuf__ half*>(c_l1), 0, 0,
            ceil_division(M, CUBE_BLOCK), ceil_division(N, HALF_C0_ELEMENTS),
            ceil_division(M, CUBE_BLOCK), ceil_division(M, CUBE_BLOCK));
    }

    // GM → L1: load D (identity matrix)
    asc_set_gm2l1_nz_para(D_MTE2_NZ_PARA);
    if constexpr (IS_INT8_OUTPUT) {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ int8_t*>(d_l1), reinterpret_cast<__gm__ int8_t*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    } else if constexpr (IS_INT4B_OUTPUT) {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ int8_t*>(d_l1), reinterpret_cast<__gm__ int8_t*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    } else if constexpr (IS_BF16_OUTPUT) {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ bfloat16_t*>(d_l1), reinterpret_cast<__gm__ bfloat16_t*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    } else if constexpr (IS_FP8_OUTPUT) {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ fp8_e4m3fn_t*>(d_l1), reinterpret_cast<__gm__ fp8_e4m3fn_t*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    } else if constexpr (IS_HIF8_OUTPUT) {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ hifloat8_t*>(d_l1), reinterpret_cast<__gm__ hifloat8_t*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    } else if constexpr (IS_FLOAT_OUTPUT) {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ float*>(d_l1), reinterpret_cast<__gm__ float*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    } else {
        asc_copy_gm2l1_nd2nz(
            reinterpret_cast<__cbuf__ half*>(d_l1), reinterpret_cast<__gm__ half*>(d),
            D_SRC_STRIDE, L2_CACHE_NORMAL, N, N, 0, false);
    }

    // L1 → L0B: load D (transposed)
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    // sizeof=2 types (half, bfloat16): use half pattern
    // sizeof=1 types (int8, int4b, fp8, hifloat8): use int8 pattern
    // sizeof=4 types (float): use float pattern
    if constexpr (IS_INT8_OUTPUT || IS_INT4B_OUTPUT || IS_FP8_OUTPUT || IS_HIF8_OUTPUT) {
        const uint32_t d_dst_offset = ceil_division(N, OUTPUT_C0_ELEMENTS) * 512 * 2;
        const uint32_t d_src_offset = 512 * 2;
        for (uint32_t i = 0; i < ceil_division(N, OUTPUT_C0_ELEMENTS); ++i) {
            if constexpr (IS_INT8_OUTPUT) {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ int8_t*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ int8_t*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS) * 2),
                    static_cast<uint16_t>(1), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            } else if constexpr (IS_INT4B_OUTPUT) {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ int8_t*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ int8_t*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS) * 2),
                    static_cast<uint16_t>(1), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            } else if constexpr (IS_FP8_OUTPUT) {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ int8_t*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ int8_t*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS) * 2),
                    static_cast<uint16_t>(1), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            } else {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ int8_t*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ int8_t*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS) * 2),
                    static_cast<uint16_t>(1), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            }
        }
    } else {
        const uint32_t d_dst_offset = ceil_division(N, OUTPUT_C0_ELEMENTS) * (C0_BYTES / OUTPUT_ELEMENT_SIZE) * CUBE_BLOCK;
        const uint32_t d_src_offset = (C0_BYTES / OUTPUT_ELEMENT_SIZE) * CUBE_BLOCK;
        for (uint32_t i = 0; i < ceil_division(N, OUTPUT_C0_ELEMENTS); ++i) {
            if constexpr (IS_BF16_OUTPUT) {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ bfloat16_t*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ bfloat16_t*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            } else if constexpr (IS_FLOAT_OUTPUT) {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ float*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ float*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            } else {
                asc_copy_l12l0b_trans(
                    reinterpret_cast<__cb__ half*>(b_l0_workspace) + i * d_dst_offset,
                    reinterpret_cast<__cbuf__ half*>(d_l1) + i * d_src_offset,
                    static_cast<uint16_t>(0),
                    static_cast<uint8_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(ceil_division(N, OUTPUT_C0_ELEMENTS)),
                    static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
            }
        }
    }

    // Mmad: E = C × D (= C × I = C)
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

    if constexpr (IS_INT8_OUTPUT) {
        asc_mmad(
            reinterpret_cast<__cc__ int32_t*>(c_l0_workspace),
            reinterpret_cast<__ca__ int8_t*>(a_l0_workspace),
            reinterpret_cast<__cb__ int8_t*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
    } else if constexpr (IS_INT4B_OUTPUT) {
#if ASC_HAS_MMAD_S4_3510
        asc_mmad_s4(
            reinterpret_cast<__cc__ int32_t*>(c_l0_workspace),
            reinterpret_cast<__ca__ int4b_t*>(a_l0_workspace),
            reinterpret_cast<__cb__ int4b_t*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
#endif
    } else if constexpr (IS_BF16_OUTPUT) {
        asc_mmad(
            reinterpret_cast<__cc__ float*>(c_l0_workspace),
            reinterpret_cast<__ca__ bfloat16_t*>(a_l0_workspace),
            reinterpret_cast<__cb__ bfloat16_t*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
    } else if constexpr (IS_FP8_OUTPUT) {
        asc_mmad(
            reinterpret_cast<__cc__ float*>(c_l0_workspace),
            reinterpret_cast<__ca__ fp8_e4m3fn_t*>(a_l0_workspace),
            reinterpret_cast<__cb__ fp8_e4m3fn_t*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
    } else if constexpr (IS_HIF8_OUTPUT) {
        asc_mmad(
            reinterpret_cast<__cc__ float*>(c_l0_workspace),
            reinterpret_cast<__ca__ hifloat8_t*>(a_l0_workspace),
            reinterpret_cast<__cb__ hifloat8_t*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
    } else if constexpr (IS_FLOAT_OUTPUT) {
        asc_mmad(
            reinterpret_cast<__cc__ float*>(c_l0_workspace),
            reinterpret_cast<__ca__ float*>(a_l0_workspace),
            reinterpret_cast<__cb__ float*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
    } else {
        asc_mmad(
            reinterpret_cast<__cc__ float*>(c_l0_workspace),
            reinterpret_cast<__ca__ half*>(a_l0_workspace),
            reinterpret_cast<__cb__ half*>(b_l0_workspace),
            M, N, ceil_align(N, CUBE_BLOCK), UNIT_FLAG_DISABLE, false, false, true);
    }

    // L0C → GM
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    if constexpr (L0C_IS_INT32) {
        asc_copy_l0c2gm(
            reinterpret_cast<__gm__ int32_t*>(c), reinterpret_cast<__cc__ int32_t*>(c_l0_workspace),
            N, M, N, ceil_align(M, CUBE_BLOCK), L2_CACHE_NORMAL, 0, UNIT_FLAG_DISABLE,
            static_cast<uint64_t>(QuantMode_t::NoQuant), 0, false, true,
            static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, 0, false, false, false, false);
    } else {
        asc_copy_l0c2gm(
            reinterpret_cast<__gm__ float*>(c), reinterpret_cast<__cc__ float*>(c_l0_workspace),
            N, M, N, ceil_align(M, CUBE_BLOCK), L2_CACHE_NORMAL, 0, UNIT_FLAG_DISABLE,
            static_cast<uint64_t>(QuantMode_t::NoQuant), 0, false, true,
            static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, 0, false, false, false, false);
    }

    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t input_element_size = IS_INT8_INPUT ? sizeof(int8_t) : sizeof(half);
    constexpr size_t a_file_size = M * K * input_element_size;
    constexpr size_t b_file_size = K * N * input_element_size;
    constexpr size_t d_file_size = N * N * OUTPUT_ELEMENT_SIZE;
    constexpr size_t c_file_size = M * N * C_FILE_ELEMENT_SIZE;
    constexpr int32_t device_id = 0;

    uint8_t* a_host = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* c_host = nullptr;
    uint8_t* d_host = nullptr;
    uint8_t* a_device = nullptr;
    uint8_t* b_device = nullptr;
    void* c_device = nullptr;
    uint8_t* d_device = nullptr;
    uint8_t* quant_host = nullptr;
    uint64_t* quant_device = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadFile("./input/x1_gm.bin", a_host, a_file_size);
    CHECK_ACL(aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadFile("./input/x2_gm.bin", b_host, b_file_size);
    CHECK_ACL(aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&d_host), d_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&d_device), d_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadFile("./input/x3_gm.bin", d_host, d_file_size);
    CHECK_ACL(aclrtMemcpy(d_device, d_file_size, d_host, d_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size));
    CHECK_ACL(aclrtMalloc(&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST));

    if constexpr (IS_VECTOR_QUANT) {
        CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&quant_host), QUANT_TRANSFER_BYTES));
        CHECK_ACL(
            aclrtMalloc(reinterpret_cast<void**>(&quant_device), QUANT_TRANSFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        ReadFile("./input/quant_pre.bin", quant_host, QUANT_TRANSFER_BYTES);
        CHECK_ACL(aclrtMemcpy(
            quant_device, QUANT_TRANSFER_BYTES, quant_host, QUANT_TRANSFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    data_copy_l0c2l1<<<1, 0, stream>>>(a_device, b_device, c_device, d_device, quant_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST));
    WriteFile("./output/output.bin", c_host, c_file_size);

    if constexpr (IS_VECTOR_QUANT) {
        CHECK_ACL(aclrtFree(quant_device));
        CHECK_ACL(aclrtFreeHost(quant_host));
    }
    CHECK_ACL(aclrtFree(c_device));
    CHECK_ACL(aclrtFreeHost(c_host));
    CHECK_ACL(aclrtFree(d_device));
    CHECK_ACL(aclrtFreeHost(d_host));
    CHECK_ACL(aclrtFree(b_device));
    CHECK_ACL(aclrtFreeHost(b_host));
    CHECK_ACL(aclrtFree(a_device));
    CHECK_ACL(aclrtFreeHost(a_host));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return 0;
}
