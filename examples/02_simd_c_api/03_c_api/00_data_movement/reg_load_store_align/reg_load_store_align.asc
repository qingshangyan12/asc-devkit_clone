/* !
 * \file reg_load_store_align.asc
 * \brief Demonstrates register load and store modes for aligned UB data.
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t INPUT_LENGTH = 1024;
constexpr uint32_t HALF_ELEMENTS_PER_DATABLOCK = 32 / sizeof(half);
constexpr uint32_t SCENARIO1_LENGTH = INPUT_LENGTH - 3;
constexpr uint32_t SCENARIO4_OUTPUT_LENGTH = INPUT_LENGTH / 2;
constexpr uint32_t SCENARIO6_OUTPUT_LENGTH = INPUT_LENGTH * 2;

__simd_vf__ inline void clear_half_buffer(
    __ubuf__ half* dst, uint32_t one_repeat_size, uint32_t repeat_times)
{
    vector_half zero_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    asc_duplicate_scalar(zero_reg, static_cast<half>(0), mask);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_storealign(dst + i * one_repeat_size, zero_reg, mask);
    }
}

__simd_vf__ inline void add_with_offset(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint32_t repeat_times,
    uint32_t element_count)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    uint32_t remaining_count = element_count;
    for (uint32_t i = 0; i < repeat_times; ++i) {
        if (remaining_count == 0) {
            break;
        }
        vector_bool mask = asc_update_mask_b16(remaining_count);
        asc_loadalign(src0_reg, src0 + i * one_repeat_size);
        asc_loadalign(src1_reg, src1 + i * one_repeat_size);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__simd_vf__ inline void add_with_postupdate(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint32_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    __ubuf__ half* dst_ptr = dst;
    __ubuf__ half* src0_ptr = src0;
    __ubuf__ half* src1_ptr = src1;
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_postupdate(src0_reg, src0_ptr, one_repeat_size);
        asc_loadalign_postupdate(src1_reg, src1_ptr, one_repeat_size);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign_postupdate(dst_ptr, dst_reg, one_repeat_size, mask);
    }
}

__simd_vf__ inline void add_with_addr_reg(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint32_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        addr_reg offset = asc_update_addr_reg_b16(i * one_repeat_size);
        asc_loadalign(src0_reg, src0, offset);
        asc_loadalign(src1_reg, src1, offset);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst, dst_reg, offset, mask);
    }
}

__simd_vf__ inline void add_with_datablock(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint32_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    __ubuf__ half* src0_ptr = src0;
    __ubuf__ half* src1_ptr = src1;
    __ubuf__ half* dst_ptr = dst;
    constexpr uint16_t src_block_stride = 2;
    const uint16_t blocks_per_vector = one_repeat_size / HALF_ELEMENTS_PER_DATABLOCK;
    const uint16_t src_repeat_stride = src_block_stride * blocks_per_vector;
    constexpr uint16_t dst_block_stride = 1;
    const uint16_t dst_repeat_stride = dst_block_stride * blocks_per_vector;
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_postupdate(src0_reg, src0_ptr, src_block_stride, src_repeat_stride, mask);
        asc_loadalign_postupdate(src1_reg, src1_ptr, src_block_stride, src_repeat_stride, mask);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign_postupdate(dst_ptr, dst_reg, dst_block_stride, dst_repeat_stride, mask);
    }
}

__simd_vf__ inline void add_with_broadcast(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint32_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_brc(src0_reg, src0 + i * one_repeat_size);
        asc_loadalign_brc(src1_reg, src1 + i * one_repeat_size);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__simd_vf__ inline void add_with_upsample(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint32_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_upsample(src0_reg, src0 + i * one_repeat_size / 2);
        asc_loadalign_upsample(src1_reg, src1 + i * one_repeat_size / 2);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__global__ __vector__ void reg_load_store_align(__gm__ half* src0, __gm__ half* src1, __gm__ half* dst)
{
    asc_init();

    __ubuf__ half src0_ub[INPUT_LENGTH];
    __ubuf__ half src1_ub[INPUT_LENGTH];
    constexpr uint32_t output_length = scenarioNum == 4 ? SCENARIO4_OUTPUT_LENGTH
                                       : scenarioNum == 6 ? SCENARIO6_OUTPUT_LENGTH
                                                          : INPUT_LENGTH;
    __ubuf__ half dst_ub[output_length];

    asc_copy_gm2ub(src0_ub, src0, INPUT_LENGTH * sizeof(half));
    asc_copy_gm2ub(src1_ub, src1, INPUT_LENGTH * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    constexpr uint32_t half_vector_length = asc_get_vf_len() / sizeof(half);
    constexpr uint32_t input_repeat_times = (INPUT_LENGTH + half_vector_length - 1) / half_vector_length;

    if constexpr (scenarioNum == 1) {
        asc_vf_call<clear_half_buffer>(dst_ub, half_vector_length, input_repeat_times);
        asc_vf_call<add_with_offset>(
            dst_ub, src0_ub, src1_ub, half_vector_length, input_repeat_times, SCENARIO1_LENGTH);
    } else if constexpr (scenarioNum == 2) {
        asc_vf_call<add_with_postupdate>(dst_ub, src0_ub, src1_ub, half_vector_length, input_repeat_times);
    } else if constexpr (scenarioNum == 3) {
        asc_vf_call<add_with_addr_reg>(dst_ub, src0_ub, src1_ub, half_vector_length, input_repeat_times);
    } else if constexpr (scenarioNum == 4) {
        asc_vf_call<add_with_datablock>(
            dst_ub, src0_ub, src1_ub, half_vector_length, input_repeat_times / 2);
    } else if constexpr (scenarioNum == 5) {
        asc_vf_call<add_with_broadcast>(dst_ub, src0_ub, src1_ub, half_vector_length, input_repeat_times);
    } else {
        asc_vf_call<add_with_upsample>(dst_ub, src0_ub, src1_ub, half_vector_length, input_repeat_times * 2);
    }

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(dst, dst_ub, output_length * sizeof(half));
    asc_sync_pipe(PIPE_ALL);
}

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t input_size = INPUT_LENGTH * sizeof(half);
    constexpr uint32_t output_length = scenarioNum == 4 ? SCENARIO4_OUTPUT_LENGTH
                                       : scenarioNum == 6 ? SCENARIO6_OUTPUT_LENGTH
                                                          : INPUT_LENGTH;
    constexpr size_t output_size = output_length * sizeof(half);
    constexpr int32_t device_id = 0;

    aclrtStream stream = nullptr;
    half* src0_host = nullptr;
    half* src1_host = nullptr;
    half* dst_host = nullptr;
    half* src0_device = nullptr;
    half* src1_device = nullptr;
    half* dst_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
    int32_t result = 1;

    if (!check_acl_status(aclInit(nullptr), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = true;
    if (!check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    if (!check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    stream_created = true;

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&src0_host), input_size), "aclrtMallocHost(src0_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&src0_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(src0_device)") ||
        !ReadFile("./input/input_x.bin", src0_host, input_size) ||
        !check_acl_status(
            aclrtMemcpy(src0_device, input_size, src0_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(src0_device)")) {
        goto cleanup;
    }

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&src1_host), input_size), "aclrtMallocHost(src1_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&src1_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(src1_device)") ||
        !ReadFile("./input/input_y.bin", src1_host, input_size) ||
        !check_acl_status(
            aclrtMemcpy(src1_device, input_size, src1_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(src1_device)")) {
        goto cleanup;
    }

    if (!check_acl_status(aclrtMallocHost(reinterpret_cast<void**>(&dst_host), output_size), "aclrtMallocHost(dst_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(dst_device)")) {
        goto cleanup;
    }

    reg_load_store_align<<<1, 0, stream>>>(src0_device, src1_device, dst_device);
    if (!check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl_status(
            aclrtMemcpy(dst_host, output_size, dst_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(dst_host)") ||
        !WriteFile("./output/output.bin", dst_host, output_size)) {
        goto cleanup;
    }

    result = 0;

cleanup:
    if (dst_device != nullptr) {
        if (!check_acl_status(aclrtFree(dst_device), "aclrtFree(dst_device)")) {
            result = 1;
        }
    }
    if (src1_device != nullptr) {
        if (!check_acl_status(aclrtFree(src1_device), "aclrtFree(src1_device)")) {
            result = 1;
        }
    }
    if (src0_device != nullptr) {
        if (!check_acl_status(aclrtFree(src0_device), "aclrtFree(src0_device)")) {
            result = 1;
        }
    }
    if (dst_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(dst_host), "aclrtFreeHost(dst_host)")) {
            result = 1;
        }
    }
    if (src1_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(src1_host), "aclrtFreeHost(src1_host)")) {
            result = 1;
        }
    }
    if (src0_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(src0_host), "aclrtFreeHost(src0_host)")) {
            result = 1;
        }
    }
    if (stream_created) {
        if (!check_acl_status(aclrtDestroyStream(stream), "aclrtDestroyStream")) {
            result = 1;
        }
    }
    if (device_set) {
        if (!check_acl_status(aclrtResetDevice(device_id), "aclrtResetDevice")) {
            result = 1;
        }
    }
    if (acl_initialized) {
        if (!check_acl_status(aclFinalize(), "aclFinalize")) {
            result = 1;
        }
    }
    return result;
}
