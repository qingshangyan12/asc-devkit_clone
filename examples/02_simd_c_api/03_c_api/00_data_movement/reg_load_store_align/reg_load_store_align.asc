/* !
 * \file reg_load_store_align.asc
 * \brief Demonstrates register load and store modes for aligned UB data.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstring>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t INPUT_LENGTH = 1024;
constexpr uint32_t HALF_VECTOR_LENGTH = 256 / sizeof(half);
constexpr uint32_t INPUT_REPEAT_TIMES = INPUT_LENGTH / HALF_VECTOR_LENGTH;
constexpr uint32_t DATABLOCK_REPEAT_TIMES = INPUT_REPEAT_TIMES / 2;
constexpr uint32_t SCENARIO1_LENGTH = INPUT_LENGTH - 3;
constexpr uint32_t SCENARIO4_OUTPUT_LENGTH = INPUT_LENGTH / 2;
constexpr uint32_t SCENARIO6_OUTPUT_LENGTH = INPUT_LENGTH * 2;

__simd_callee__ inline void clear_half_buffer(__ubuf__ half* dst, uint32_t repeat_times)
{
    vector_half zero_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    asc_duplicate_scalar(zero_reg, static_cast<half>(0), mask);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_storealign(dst + i * HALF_VECTOR_LENGTH, zero_reg, mask);
    }
}

__simd_callee__ inline void add_with_offset(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t element_count)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    uint32_t remaining_count = element_count;
    for (uint32_t i = 0; i < INPUT_REPEAT_TIMES; ++i) {
        if (remaining_count == 0) {
            break;
        }
        vector_bool mask = asc_update_mask_b16(remaining_count);
        asc_loadalign(src0_reg, src0 + i * HALF_VECTOR_LENGTH);
        asc_loadalign(src1_reg, src1 + i * HALF_VECTOR_LENGTH);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * HALF_VECTOR_LENGTH, dst_reg, mask);
    }
}

__simd_callee__ inline void add_with_postupdate(__ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    __ubuf__ half* dst_ptr = dst;
    __ubuf__ half* src0_ptr = src0;
    __ubuf__ half* src1_ptr = src1;
    for (uint32_t i = 0; i < INPUT_REPEAT_TIMES; ++i) {
        asc_loadalign_postupdate(src0_reg, src0_ptr, HALF_VECTOR_LENGTH);
        asc_loadalign_postupdate(src1_reg, src1_ptr, HALF_VECTOR_LENGTH);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign_postupdate(dst_ptr, dst_reg, HALF_VECTOR_LENGTH, mask);
    }
}

__simd_callee__ inline void add_with_addr_reg(__ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint32_t i = 0; i < INPUT_REPEAT_TIMES; ++i) {
        addr_reg offset = asc_update_addr_reg_b16(i * HALF_VECTOR_LENGTH);
        asc_loadalign(src0_reg, src0, offset);
        asc_loadalign(src1_reg, src1, offset);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst, dst_reg, offset, mask);
    }
}

__simd_callee__ inline void add_with_datablock(__ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    __ubuf__ half* src0_ptr = src0;
    __ubuf__ half* src1_ptr = src1;
    __ubuf__ half* dst_ptr = dst;
    constexpr uint16_t src_block_stride = 2;
    constexpr uint16_t blocks_per_vector = 8;
    constexpr uint16_t src_repeat_stride = src_block_stride * blocks_per_vector;
    constexpr uint16_t dst_block_stride = 1;
    constexpr uint16_t dst_repeat_stride = dst_block_stride * blocks_per_vector;
    for (uint32_t i = 0; i < DATABLOCK_REPEAT_TIMES; ++i) {
        asc_loadalign_postupdate(src0_reg, src0_ptr, src_block_stride, src_repeat_stride, mask);
        asc_loadalign_postupdate(src1_reg, src1_ptr, src_block_stride, src_repeat_stride, mask);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign_postupdate(dst_ptr, dst_reg, dst_block_stride, dst_repeat_stride, mask);
    }
}

__simd_callee__ inline void add_with_broadcast(__ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint32_t i = 0; i < INPUT_REPEAT_TIMES; ++i) {
        asc_loadalign_brc(src0_reg, src0 + i * HALF_VECTOR_LENGTH);
        asc_loadalign_brc(src1_reg, src1 + i * HALF_VECTOR_LENGTH);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * HALF_VECTOR_LENGTH, dst_reg, mask);
    }
}

__simd_callee__ inline void add_with_upsample(__ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint32_t i = 0; i < INPUT_REPEAT_TIMES * 2; ++i) {
        asc_loadalign_upsample(src0_reg, src0 + i * HALF_VECTOR_LENGTH / 2);
        asc_loadalign_upsample(src1_reg, src1 + i * HALF_VECTOR_LENGTH / 2);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * HALF_VECTOR_LENGTH, dst_reg, mask);
    }
}

__global__ __vector__ void reg_load_store_align(__gm__ half* src0, __gm__ half* src1, __gm__ half* dst)
{
    asc_init();

    __ubuf__ half src0_ub[INPUT_LENGTH];
    __ubuf__ half src1_ub[INPUT_LENGTH];
    constexpr uint32_t output_length = scenarioNum == 4 ? SCENARIO4_OUTPUT_LENGTH
                                       : scenarioNum == 6 ? SCENARIO6_OUTPUT_LENGTH
                                                          : INPUT_LENGTH;
    __ubuf__ half dst_ub[output_length];

    asc_copy_gm2ub(src0_ub, src0, INPUT_LENGTH * sizeof(half));
    asc_copy_gm2ub(src1_ub, src1, INPUT_LENGTH * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    if constexpr (scenarioNum == 1) {
        clear_half_buffer(dst_ub, INPUT_REPEAT_TIMES);
        add_with_offset(dst_ub, src0_ub, src1_ub, SCENARIO1_LENGTH);
    } else if constexpr (scenarioNum == 2) {
        add_with_postupdate(dst_ub, src0_ub, src1_ub);
    } else if constexpr (scenarioNum == 3) {
        add_with_addr_reg(dst_ub, src0_ub, src1_ub);
    } else if constexpr (scenarioNum == 4) {
        add_with_datablock(dst_ub, src0_ub, src1_ub);
    } else if constexpr (scenarioNum == 5) {
        add_with_broadcast(dst_ub, src0_ub, src1_ub);
    } else {
        add_with_upsample(dst_ub, src0_ub, src1_ub);
    }

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(dst, dst_ub, output_length * sizeof(half));
}

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

bool allocate_host(void** buffer, size_t size, const char* operation)
{
    return check_acl_status(aclrtMallocHost(buffer, size), operation);
}

bool allocate_device(void** buffer, size_t size, const char* operation)
{
    return check_acl_status(aclrtMalloc(buffer, size, ACL_MEM_MALLOC_HUGE_FIRST), operation);
}

bool copy_host_to_device(void* dst, const void* src, size_t size, const char* operation)
{
    return check_acl_status(aclrtMemcpy(dst, size, src, size, ACL_MEMCPY_HOST_TO_DEVICE), operation);
}

bool copy_device_to_host(void* dst, const void* src, size_t size, const char* operation)
{
    return check_acl_status(aclrtMemcpy(dst, size, src, size, ACL_MEMCPY_DEVICE_TO_HOST), operation);
}

bool compare_output(const void* output, const void* golden, size_t size)
{
    if (std::memcmp(output, golden, size) == 0) {
        return true;
    }
    ERROR_LOG("output does not match golden data");
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t input_size = INPUT_LENGTH * sizeof(half);
    constexpr uint32_t output_length = scenarioNum == 4 ? SCENARIO4_OUTPUT_LENGTH
                                       : scenarioNum == 6 ? SCENARIO6_OUTPUT_LENGTH
                                                          : INPUT_LENGTH;
    constexpr size_t output_size = output_length * sizeof(half);
    constexpr int32_t device_id = 0;

    if (!check_acl_status(aclInit(nullptr), "aclInit") ||
        !check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        return 1;
    }

    aclrtStream stream = nullptr;
    half* src0_host = nullptr;
    half* src1_host = nullptr;
    half* dst_host = nullptr;
    half* golden_host = nullptr;
    half* src0_device = nullptr;
    half* src1_device = nullptr;
    half* dst_device = nullptr;

    bool success = check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream");
    success = success && allocate_host(reinterpret_cast<void**>(&src0_host), input_size, "aclrtMallocHost(src0)");
    success = success && allocate_host(reinterpret_cast<void**>(&src1_host), input_size, "aclrtMallocHost(src1)");
    success = success && allocate_host(reinterpret_cast<void**>(&dst_host), output_size, "aclrtMallocHost(dst)");
    success = success && allocate_host(reinterpret_cast<void**>(&golden_host), output_size, "aclrtMallocHost(golden)");
    success = success && read_file("./input/input_x.bin", src0_host, input_size);
    success = success && read_file("./input/input_y.bin", src1_host, input_size);
    success = success && read_file("./output/golden.bin", golden_host, output_size);
    success = success && allocate_device(reinterpret_cast<void**>(&src0_device), input_size, "aclrtMalloc(src0)");
    success = success && allocate_device(reinterpret_cast<void**>(&src1_device), input_size, "aclrtMalloc(src1)");
    success = success && allocate_device(reinterpret_cast<void**>(&dst_device), output_size, "aclrtMalloc(dst)");
    success = success && copy_host_to_device(src0_device, src0_host, input_size, "aclrtMemcpy(src0)");
    success = success && copy_host_to_device(src1_device, src1_host, input_size, "aclrtMemcpy(src1)");

    if (success) {
        reg_load_store_align<<<1, 0, stream>>>(src0_device, src1_device, dst_device);
        success = check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        success = success && copy_device_to_host(dst_host, dst_device, output_size, "aclrtMemcpy(dst)");
        success = success && write_file("./output/output.bin", dst_host, output_size);
        success = success && compare_output(dst_host, golden_host, output_size);
    }

    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    if (src1_device != nullptr) {
        (void)aclrtFree(src1_device);
    }
    if (src0_device != nullptr) {
        (void)aclrtFree(src0_device);
    }
    if (golden_host != nullptr) {
        (void)aclrtFreeHost(golden_host);
    }
    if (dst_host != nullptr) {
        (void)aclrtFreeHost(dst_host);
    }
    if (src1_host != nullptr) {
        (void)aclrtFreeHost(src1_host);
    }
    if (src0_host != nullptr) {
        (void)aclrtFreeHost(src0_host);
    }
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();

    std::printf(success ? "test pass!\n" : "test failed!\n");
    return success ? 0 : 1;
}
