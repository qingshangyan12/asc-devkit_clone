/* !
 * \file reg_load_store_mask.asc
 * \brief Demonstrates MaskReg load, store, and selection operations.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstring>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t BYTE_LENGTH = 1024;
constexpr uint32_t FLOAT_LENGTH = 256;
constexpr uint32_t MASK_LENGTH = 128;
constexpr uint32_t BYTE_VECTOR_LENGTH = 256 / sizeof(uint8_t);
constexpr uint32_t FLOAT_VECTOR_LENGTH = 256 / sizeof(float);

__simd_callee__ inline void fill_byte_buffer(__ubuf__ uint8_t* dst)
{
    vector_uint8_t zero_reg;
    vector_bool mask = asc_create_mask_b8(PAT_ALL);
    asc_duplicate_scalar(zero_reg, static_cast<uint8_t>(0), mask);
    for (uint32_t i = 0; i < BYTE_LENGTH / BYTE_VECTOR_LENGTH; ++i) {
        asc_storealign(dst + i * BYTE_VECTOR_LENGTH, zero_reg, mask);
    }
}

__simd_callee__ inline void load_store_mask_register(__ubuf__ uint8_t* dst, __ubuf__ uint8_t* src)
{
    vector_bool input_mask;
    vector_uint8_t result_reg;
    vector_bool all_mask = asc_create_mask_b8(PAT_ALL);
    asc_loadalign(input_mask, reinterpret_cast<__ubuf__ uint32_t*>(src));
    asc_duplicate_scalar(result_reg, static_cast<uint8_t>(2), input_mask);
    asc_storealign(dst, result_reg, input_mask);
    asc_storealign(dst + BYTE_VECTOR_LENGTH, all_mask);
}

__simd_callee__ inline void select_with_mask_register(
    __ubuf__ float* dst, __ubuf__ float* src0, __ubuf__ float* src1, __ubuf__ uint8_t* mask)
{
    vector_float src0_reg;
    vector_float src1_reg;
    vector_float dst_reg;
    vector_bool select_mask;
    vector_bool store_mask = asc_create_mask_b32(PAT_ALL);
    __ubuf__ float* dst_ptr = dst;
    __ubuf__ float* src0_ptr = src0;
    __ubuf__ float* src1_ptr = src1;
    __ubuf__ uint32_t* mask_ptr = reinterpret_cast<__ubuf__ uint32_t*>(mask);
    for (uint32_t i = 0; i < FLOAT_LENGTH / FLOAT_VECTOR_LENGTH; ++i) {
        asc_loadalign_postupdate(src0_reg, src0_ptr, FLOAT_VECTOR_LENGTH);
        asc_loadalign_postupdate(src1_reg, src1_ptr, FLOAT_VECTOR_LENGTH);
        asc_loadalign_postupdate(select_mask, mask_ptr);
        asc_select(dst_reg, src0_reg, src1_reg, select_mask);
        asc_storealign_postupdate(dst_ptr, dst_reg, FLOAT_VECTOR_LENGTH, store_mask);
    }
}

__global__ __vector__ void reg_load_store_mask(
    __gm__ void* src0, __gm__ void* src1, __gm__ void* mask, __gm__ void* dst)
{
    asc_init();

    if constexpr (scenarioNum == 1) {
        __ubuf__ uint8_t src_ub[BYTE_LENGTH];
        __ubuf__ uint8_t dst_ub[BYTE_LENGTH];
        asc_copy_gm2ub(src_ub, reinterpret_cast<__gm__ uint8_t*>(src0), BYTE_LENGTH * sizeof(uint8_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        fill_byte_buffer(dst_ub);
        load_store_mask_register(dst_ub, src_ub);

        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(reinterpret_cast<__gm__ uint8_t*>(dst), dst_ub, BYTE_LENGTH * sizeof(uint8_t));
    } else {
        __ubuf__ float src0_ub[FLOAT_LENGTH];
        __ubuf__ float src1_ub[FLOAT_LENGTH];
        __ubuf__ uint8_t mask_ub[MASK_LENGTH];
        __ubuf__ float dst_ub[FLOAT_LENGTH];
        asc_copy_gm2ub(src0_ub, reinterpret_cast<__gm__ float*>(src0), FLOAT_LENGTH * sizeof(float));
        asc_copy_gm2ub(src1_ub, reinterpret_cast<__gm__ float*>(src1), FLOAT_LENGTH * sizeof(float));
        asc_copy_gm2ub(mask_ub, reinterpret_cast<__gm__ uint8_t*>(mask), MASK_LENGTH * sizeof(uint8_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        select_with_mask_register(dst_ub, src0_ub, src1_ub, mask_ub);

        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(reinterpret_cast<__gm__ float*>(dst), dst_ub, FLOAT_LENGTH * sizeof(float));
    }
}

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

bool allocate_host(void** buffer, size_t size, const char* operation)
{
    return check_acl_status(aclrtMallocHost(buffer, size), operation);
}

bool allocate_device(void** buffer, size_t size, const char* operation)
{
    return check_acl_status(aclrtMalloc(buffer, size, ACL_MEM_MALLOC_HUGE_FIRST), operation);
}

bool copy_host_to_device(void* dst, const void* src, size_t size, const char* operation)
{
    return check_acl_status(aclrtMemcpy(dst, size, src, size, ACL_MEMCPY_HOST_TO_DEVICE), operation);
}

bool copy_device_to_host(void* dst, const void* src, size_t size, const char* operation)
{
    return check_acl_status(aclrtMemcpy(dst, size, src, size, ACL_MEMCPY_DEVICE_TO_HOST), operation);
}

bool compare_output(const void* output, const void* golden, size_t size)
{
    if (std::memcmp(output, golden, size) == 0) {
        return true;
    }
    ERROR_LOG("output does not match golden data");
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr bool is_scenario1 = scenarioNum == 1;
    constexpr size_t src0_size = is_scenario1 ? BYTE_LENGTH * sizeof(uint8_t) : FLOAT_LENGTH * sizeof(float);
    constexpr size_t src1_size = is_scenario1 ? 0 : FLOAT_LENGTH * sizeof(float);
    constexpr size_t mask_size = is_scenario1 ? 0 : MASK_LENGTH * sizeof(uint8_t);
    constexpr size_t output_size = is_scenario1 ? BYTE_LENGTH * sizeof(uint8_t) : FLOAT_LENGTH * sizeof(float);
    constexpr int32_t device_id = 0;

    if (!check_acl_status(aclInit(nullptr), "aclInit") ||
        !check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        return 1;
    }

    aclrtStream stream = nullptr;
    uint8_t* src0_host = nullptr;
    uint8_t* src1_host = nullptr;
    uint8_t* mask_host = nullptr;
    uint8_t* dst_host = nullptr;
    uint8_t* golden_host = nullptr;
    uint8_t* src0_device = nullptr;
    uint8_t* src1_device = nullptr;
    uint8_t* mask_device = nullptr;
    uint8_t* dst_device = nullptr;

    bool success = check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream");
    success = success && allocate_host(reinterpret_cast<void**>(&src0_host), src0_size, "aclrtMallocHost(src0)");
    success = success && allocate_host(reinterpret_cast<void**>(&dst_host), output_size, "aclrtMallocHost(dst)");
    success = success && allocate_host(reinterpret_cast<void**>(&golden_host), output_size, "aclrtMallocHost(golden)");
    success = success && read_file(
                             is_scenario1 ? "./input/input.bin" : "./input/input_x.bin", src0_host, src0_size);
    success = success && read_file("./output/golden.bin", golden_host, output_size);
    success = success && allocate_device(reinterpret_cast<void**>(&src0_device), src0_size, "aclrtMalloc(src0)");
    success = success && allocate_device(reinterpret_cast<void**>(&dst_device), output_size, "aclrtMalloc(dst)");
    success = success && copy_host_to_device(src0_device, src0_host, src0_size, "aclrtMemcpy(src0)");

    if (success && !is_scenario1) {
        success = success && allocate_host(reinterpret_cast<void**>(&src1_host), src1_size, "aclrtMallocHost(src1)");
        success = success && allocate_host(reinterpret_cast<void**>(&mask_host), mask_size, "aclrtMallocHost(mask)");
        success = success && read_file("./input/input_y.bin", src1_host, src1_size);
        success = success && read_file("./input/input_mask.bin", mask_host, mask_size);
        success = success && allocate_device(reinterpret_cast<void**>(&src1_device), src1_size, "aclrtMalloc(src1)");
        success = success && allocate_device(reinterpret_cast<void**>(&mask_device), mask_size, "aclrtMalloc(mask)");
        success = success && copy_host_to_device(src1_device, src1_host, src1_size, "aclrtMemcpy(src1)");
        success = success && copy_host_to_device(mask_device, mask_host, mask_size, "aclrtMemcpy(mask)");
    }

    if (success) {
        reg_load_store_mask<<<1, 0, stream>>>(src0_device, src1_device, mask_device, dst_device);
        success = check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        success = success && copy_device_to_host(dst_host, dst_device, output_size, "aclrtMemcpy(dst)");
        success = success && write_file("./output/output.bin", dst_host, output_size);
        success = success && compare_output(dst_host, golden_host, output_size);
    }

    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    if (mask_device != nullptr) {
        (void)aclrtFree(mask_device);
    }
    if (src1_device != nullptr) {
        (void)aclrtFree(src1_device);
    }
    if (src0_device != nullptr) {
        (void)aclrtFree(src0_device);
    }
    if (golden_host != nullptr) {
        (void)aclrtFreeHost(golden_host);
    }
    if (dst_host != nullptr) {
        (void)aclrtFreeHost(dst_host);
    }
    if (mask_host != nullptr) {
        (void)aclrtFreeHost(mask_host);
    }
    if (src1_host != nullptr) {
        (void)aclrtFreeHost(src1_host);
    }
    if (src0_host != nullptr) {
        (void)aclrtFreeHost(src0_host);
    }
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();

    std::printf(success ? "test pass!\n" : "test failed!\n");
    return success ? 0 : 1;
}
