/* !
 * \file reg_storealign_mask_preserve.asc
 * \brief Verifies that masked-off half elements retain their original UB values after asc_storealign.
 */

#include <algorithm>
#include <array>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

namespace {
constexpr uint32_t ELEMENT_COUNT = 128;
constexpr uint32_t VECTOR_BYTES = ELEMENT_COUNT * sizeof(half);
constexpr uint32_t MASK_BYTES = VECTOR_BYTES / 8;
constexpr uint16_t SOURCE_VALUE_BITS = 0x4000; // half 2.0
constexpr uint16_t INITIAL_VALUE_BITS = 0xbc00; // half -1.0
constexpr uint8_t EVEN_ELEMENT_MASK = 0x11;

__simd_vf__ inline void store_even_elements(
    __ubuf__ half* dst, __ubuf__ half* src, __ubuf__ uint32_t* mask_data)
{
    vector_half src_reg;
    vector_bool even_mask;
    asc_loadalign(src_reg, src);
    asc_loadalign(even_mask, mask_data);
    asc_storealign(dst, src_reg, even_mask);
}

__global__ __vector__ void reg_storealign_mask_preserve(
    __gm__ half* src, __gm__ half* initial, __gm__ uint32_t* mask, __gm__ half* dst)
{
    asc_init();
    __ubuf__ half src_ub[ELEMENT_COUNT];
    __ubuf__ half dst_ub[ELEMENT_COUNT];
    __ubuf__ uint32_t mask_ub[MASK_BYTES / sizeof(uint32_t)];

    asc_copy_gm2ub(src_ub, src, VECTOR_BYTES);
    asc_copy_gm2ub(dst_ub, initial, VECTOR_BYTES);
    asc_copy_gm2ub(mask_ub, mask, MASK_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    asc_vf_call<store_even_elements>(dst_ub, src_ub, mask_ub);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(dst, dst_ub, VECTOR_BYTES);
    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        const aclError acl_ret = (expr);                                                                \
        if (acl_ret != ACL_SUCCESS) {                                                                   \
            std::fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__,    \
                static_cast<int32_t>(acl_ret));                                                         \
            return 1;                                                                                   \
        }                                                                                               \
    } while (0)
} // namespace

int32_t main()
{
    std::array<uint16_t, ELEMENT_COUNT> source;
    std::array<uint16_t, ELEMENT_COUNT> initial;
    std::array<uint16_t, ELEMENT_COUNT> output{};
    std::array<uint16_t, ELEMENT_COUNT> expected;
    std::array<uint8_t, MASK_BYTES> mask;
    source.fill(SOURCE_VALUE_BITS);
    initial.fill(INITIAL_VALUE_BITS);
    mask.fill(EVEN_ELEMENT_MASK);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        expected[i] = (i % 2 == 0) ? SOURCE_VALUE_BITS : INITIAL_VALUE_BITS;
    }

    constexpr int32_t device_id = 0;
    aclrtStream stream = nullptr;
    half* source_device = nullptr;
    half* initial_device = nullptr;
    uint32_t* mask_device = nullptr;
    half* output_device = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&source_device), VECTOR_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&initial_device), VECTOR_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&mask_device), MASK_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&output_device), VECTOR_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        source_device, VECTOR_BYTES, source.data(), VECTOR_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        initial_device, VECTOR_BYTES, initial.data(), VECTOR_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(mask_device, MASK_BYTES, mask.data(), MASK_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));

    reg_storealign_mask_preserve<<<1, 0, stream>>>(source_device, initial_device, mask_device, output_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(
        output.data(), VECTOR_BYTES, output_device, VECTOR_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));

    std::printf("output[0..15]:");
    for (uint32_t i = 0; i < 16; ++i) {
        std::printf(" %s", output[i] == SOURCE_VALUE_BITS ? "2.0" : "-1.0");
    }
    std::printf("\n");

    const bool passed = std::equal(output.begin(), output.end(), expected.begin());
    if (!passed) {
        for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
            if (output[i] != expected[i]) {
                std::fprintf(stderr, "mismatch at index %u: expected=0x%04x, actual=0x%04x\n", i,
                    static_cast<uint32_t>(expected[i]), static_cast<uint32_t>(output[i]));
                break;
            }
        }
    }

    CHECK_ACL(aclrtFree(output_device));
    CHECK_ACL(aclrtFree(mask_device));
    CHECK_ACL(aclrtFree(initial_device));
    CHECK_ACL(aclrtFree(source_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    std::printf("%s\n", passed ? "test pass!" : "test fail!");
    return passed ? 0 : 1;
}
