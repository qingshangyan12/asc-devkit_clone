/* !
 * \file reg_load_gather.asc
 * \brief Demonstrates indexed element and DataBlock loads from UB to vector registers.
 */

#include <cstddef>
#include <cstdint>
#include <cstring>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t TOTAL_LENGTH = 128;
constexpr uint32_t SRC_LENGTH = 1024;
constexpr uint32_t HALF_VECTOR_LENGTH = 256 / sizeof(half);
constexpr uint32_t HALF_ELEMENTS_PER_BLOCK = 32 / sizeof(half);
constexpr uint32_t DATABLOCK_INDEX_LENGTH = TOTAL_LENGTH / HALF_ELEMENTS_PER_BLOCK;

__simd_callee__ inline void gather_elements(
    __ubuf__ half* dst, __ubuf__ half* src, __ubuf__ uint16_t* index, uint32_t count)
{
    vector_half dst_reg;
    vector_uint16_t index_reg;
    vector_bool mask = asc_update_mask_b16(count);
    asc_loadalign(index_reg, index);
    asc_gather(dst_reg, src, index_reg, mask);
    asc_storealign(dst, dst_reg, mask);
}

__simd_callee__ inline void gather_datablocks(
    __ubuf__ half* dst, __ubuf__ half* src, __ubuf__ uint32_t* index)
{
    vector_half dst_reg;
    vector_uint32_t index_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    asc_loadalign(index_reg, index);
    asc_gather_datablock(dst_reg, src, index_reg, mask);
    asc_storealign(dst, dst_reg, mask);
}

__global__ __vector__ void reg_load_gather(__gm__ half* src, __gm__ void* index, __gm__ half* dst)
{
    asc_init();

    if constexpr (scenarioNum == 1) {
        __ubuf__ half src_ub[SRC_LENGTH];
        __ubuf__ uint16_t index_ub[TOTAL_LENGTH];
        __ubuf__ half dst_ub[TOTAL_LENGTH];

        asc_copy_gm2ub(src_ub, src, SRC_LENGTH * sizeof(half));
        asc_copy_gm2ub(index_ub, reinterpret_cast<__gm__ uint16_t*>(index), TOTAL_LENGTH * sizeof(uint16_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        gather_elements(dst_ub, src_ub, index_ub, TOTAL_LENGTH);

        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(dst, dst_ub, TOTAL_LENGTH * sizeof(half));
    } else {
        __ubuf__ half src_ub[SRC_LENGTH];
        __ubuf__ uint32_t index_ub[DATABLOCK_INDEX_LENGTH];
        __ubuf__ half dst_ub[TOTAL_LENGTH];

        asc_copy_gm2ub(src_ub, src, SRC_LENGTH * sizeof(half));
        asc_copy_gm2ub(
            index_ub, reinterpret_cast<__gm__ uint32_t*>(index), DATABLOCK_INDEX_LENGTH * sizeof(uint32_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        gather_datablocks(dst_ub, src_ub, index_ub);

        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(dst, dst_ub, TOTAL_LENGTH * sizeof(half));
    }
}

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

bool allocate_host(void** buffer, size_t size, const char* operation)
{
    return check_acl_status(aclrtMallocHost(buffer, size), operation);
}

bool allocate_device(void** buffer, size_t size, const char* operation)
{
    return check_acl_status(aclrtMalloc(buffer, size, ACL_MEM_MALLOC_HUGE_FIRST), operation);
}

bool copy_host_to_device(void* dst, const void* src, size_t size, const char* operation)
{
    return check_acl_status(aclrtMemcpy(dst, size, src, size, ACL_MEMCPY_HOST_TO_DEVICE), operation);
}

bool copy_device_to_host(void* dst, const void* src, size_t size, const char* operation)
{
    return check_acl_status(aclrtMemcpy(dst, size, src, size, ACL_MEMCPY_DEVICE_TO_HOST), operation);
}

bool compare_output(const void* output, const void* golden, size_t size)
{
    if (std::memcmp(output, golden, size) == 0) {
        return true;
    }
    ERROR_LOG("output does not match golden data");
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t src_size = SRC_LENGTH * sizeof(half);
    constexpr size_t dst_size = TOTAL_LENGTH * sizeof(half);
    constexpr size_t index_size = scenarioNum == 1 ? TOTAL_LENGTH * sizeof(uint16_t)
                                                    : DATABLOCK_INDEX_LENGTH * sizeof(uint32_t);
    constexpr int32_t device_id = 0;

    if (!check_acl_status(aclInit(nullptr), "aclInit") ||
        !check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        return 1;
    }

    aclrtStream stream = nullptr;
    half* src_host = nullptr;
    uint8_t* index_host = nullptr;
    half* dst_host = nullptr;
    half* golden_host = nullptr;
    half* src_device = nullptr;
    uint8_t* index_device = nullptr;
    half* dst_device = nullptr;

    bool success = check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream");
    success = success && allocate_host(reinterpret_cast<void**>(&src_host), src_size, "aclrtMallocHost(src)");
    success = success && allocate_host(reinterpret_cast<void**>(&index_host), index_size, "aclrtMallocHost(index)");
    success = success && allocate_host(reinterpret_cast<void**>(&dst_host), dst_size, "aclrtMallocHost(dst)");
    success = success && allocate_host(reinterpret_cast<void**>(&golden_host), dst_size, "aclrtMallocHost(golden)");
    success = success && read_file("./input/input_x.bin", src_host, src_size);
    success = success && read_file("./input/input_y.bin", index_host, index_size);
    success = success && read_file("./output/golden.bin", golden_host, dst_size);
    success = success && allocate_device(reinterpret_cast<void**>(&src_device), src_size, "aclrtMalloc(src)");
    success = success && allocate_device(reinterpret_cast<void**>(&index_device), index_size, "aclrtMalloc(index)");
    success = success && allocate_device(reinterpret_cast<void**>(&dst_device), dst_size, "aclrtMalloc(dst)");
    success = success && copy_host_to_device(src_device, src_host, src_size, "aclrtMemcpy(src)");
    success = success && copy_host_to_device(index_device, index_host, index_size, "aclrtMemcpy(index)");

    if (success) {
        reg_load_gather<<<1, 0, stream>>>(src_device, index_device, dst_device);
        success = check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        success = success && copy_device_to_host(dst_host, dst_device, dst_size, "aclrtMemcpy(dst)");
        success = success && write_file("./output/output.bin", dst_host, dst_size);
        success = success && compare_output(dst_host, golden_host, dst_size);
    }

    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    if (index_device != nullptr) {
        (void)aclrtFree(index_device);
    }
    if (src_device != nullptr) {
        (void)aclrtFree(src_device);
    }
    if (golden_host != nullptr) {
        (void)aclrtFreeHost(golden_host);
    }
    if (dst_host != nullptr) {
        (void)aclrtFreeHost(dst_host);
    }
    if (index_host != nullptr) {
        (void)aclrtFreeHost(index_host);
    }
    if (src_host != nullptr) {
        (void)aclrtFreeHost(src_host);
    }
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();

    std::printf(success ? "test pass!\n" : "test failed!\n");
    return success ? 0 : 1;
}
