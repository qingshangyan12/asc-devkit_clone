// Architecture: dav-3510

#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "c_api/cube_compute/cube_compute.h"
#include "c_api/cube_datamove/cube_datamove.h"
#include "c_api/misc/misc.h"
#include "c_api/sync/sync.h"
#include "c_api/sys_var/sys_var.h"
#include "c_api/vector_datamove/vector_datamove.h"
#include "data_utils.h"

namespace {
constexpr uint32_t M = 16, K = 16, N = 64, ELEMENTS = M * N, PACKED_BYTES = M * 32;
constexpr uint64_t SIGNED_SCALE_ONE = 0x3f800000ULL | (1ULL << 46);

__global__ __mix__(1, 2) void AscCopyL0c2l1Kernel(__gm__ uint16_t* a, __gm__ uint16_t* b,
    __gm__ uint8_t* output)
{
    asc_init();
    __cbuf__ half a_l1[ELEMENTS], b_l1[ELEMENTS];
    __ca__ half a_l0[ELEMENTS];
    __cb__ half b_l0[ELEMENTS];
    __cc__ float c_l0[ELEMENTS];
    __cbuf__ uint8_t packed_l1[PACKED_BYTES];
    __ubuf__ uint8_t packed_ub[PACKED_BYTES];
    constexpr uint64_t intra_id = 2;
    if ASC_IS_AIC {
        constexpr uint64_t nz_config = (16ULL << 32) | (1ULL << 16) | 1ULL;
        asc_set_gm2l1_nz_para(nz_config);
        asc_copy_gm2l1_nd2nz(a_l1, reinterpret_cast<__gm__ half*>(a), K * sizeof(half), 0, M, K, 0, false);
        asc_set_gm2l1_nz_para(nz_config);
        asc_copy_gm2l1_nd2nz(b_l1, reinterpret_cast<__gm__ half*>(b), N * sizeof(half), 0, K, N, 0, false);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12l0a(a_l0, a_l1, 0, 0, 1, 1, 1, 1);
        asc_copy_l12l0b_transpose(b_l0, b_l1, 0, 0, N / 16, 1, N / 16, 1);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_mmad(c_l0, a_l0, b_l0, M, K, N, 0, false, false, true);
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_set_l0c_copy_prequant(SIGNED_SCALE_ONE);
        // Quantize the FP32 L0C matrix to packed signed int4 in L1.
        asc_copy_l0c2l1(reinterpret_cast<__cbuf__ int4b_t*>(packed_l1),
            c_l0, N, M, N, M, asc_unit_flag_mode::DISABLE, QuantMode_t::QF322S4_PRE,
            asc_relu_pre_mode::NONE, false, true, false);
        asc_sync_notify(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12ub(packed_ub, packed_l1, false, 1, PACKED_BYTES / 32, 0, 0);
        asc_sync_intra_arrive(PIPE_MTE1, intra_id);
    }
    if ASC_IS_AIV {
        if (asc_get_sub_block_id() == 0) {
            asc_sync_intra_wait(PIPE_MTE3, intra_id);
            asc_copy_ub2gm_align(output,
                reinterpret_cast<__ubuf__ uint8_t*>(packed_ub), PACKED_BYTES);
            asc_sync_mte3(0);
        }
    }
}

} // namespace

int main()
{
    std::vector<uint16_t> a(ELEMENTS), b(ELEMENTS);
    std::vector<uint8_t> output(PACKED_BYTES);
    if (!ReadFile("./input/x1_gm.bin", a.data(), a.size() * sizeof(uint16_t)) ||
        !ReadFile("./input/x2_gm.bin", b.data(), b.size() * sizeof(uint16_t))) {
        return 1;
    }

    uint16_t *a_device = nullptr, *b_device = nullptr;
    uint8_t* output_device = nullptr;

    const bool acl_initialized = aclInit(nullptr) == ACL_SUCCESS;
    const bool device_ready = acl_initialized && aclrtSetDevice(0) == ACL_SUCCESS;
    const auto release_resources = [&]() {
        if (a_device != nullptr) {
            (void)aclrtFree(a_device);
        }
        if (b_device != nullptr) {
            (void)aclrtFree(b_device);
        }
        if (output_device != nullptr) {
            (void)aclrtFree(output_device);
        }
        if (device_ready) {
            (void)aclrtResetDevice(0);
        }
        if (acl_initialized) {
            (void)aclFinalize();
        }
    };
    const bool inputs_ready =
        device_ready &&
        aclrtMalloc(reinterpret_cast<void**>(&a_device), a.size() * sizeof(uint16_t), ACL_MEM_MALLOC_HUGE_FIRST) ==
            ACL_SUCCESS &&
        aclrtMalloc(reinterpret_cast<void**>(&b_device), b.size() * sizeof(uint16_t), ACL_MEM_MALLOC_HUGE_FIRST) ==
            ACL_SUCCESS &&
        aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size(), ACL_MEM_MALLOC_HUGE_FIRST) ==
            ACL_SUCCESS &&
        aclrtMemcpy(
            a_device, a.size() * sizeof(uint16_t), a.data(), a.size() * sizeof(uint16_t), ACL_MEMCPY_HOST_TO_DEVICE) ==
            ACL_SUCCESS &&
        aclrtMemcpy(
            b_device, b.size() * sizeof(uint16_t), b.data(), b.size() * sizeof(uint16_t), ACL_MEMCPY_HOST_TO_DEVICE) ==
            ACL_SUCCESS;
    if (!inputs_ready) {
        std::fprintf(stderr, "[ERROR] failed to initialize ACL resources\n");
        release_resources();
        return 1;
    }

    AscCopyL0c2l1Kernel<<<1, 0>>>(a_device, b_device, output_device);
    const bool succeeded = aclrtSynchronizeDevice() == ACL_SUCCESS &&
                           aclrtMemcpy(output.data(), output.size(), output_device, output.size(),
                               ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS &&
                           WriteFile("./output/output.bin", output.data(), output.size());

    release_resources();
    if (!succeeded) {
        std::fprintf(stderr, "[ERROR] kernel execution or output write failed\n");
        return 1;
    }
    return 0;
}
