/* !
 * \file gather.asc
 * \brief
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_LENGTH = 128;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void gather_vf(
    __ubuf__ half* src_local, __ubuf__ uint16_t* index_local, __ubuf__ half* dst_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(half);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask = asc_create_mask_b32(PAT_ALL);
    vector_half reg_src;
    vector_half reg_dst;
    vector_uint16_t reg_idx;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_load(reg_src, src_local + i * one_rep_size);
        asc_load(reg_idx, index_local + i * one_rep_size);
        asc_gather(reg_dst, reg_src, reg_idx);
        asc_store(dst_local + i * one_rep_size, reg_dst);
    }
}

__vector__ __global__ void gather_custom(__gm__ half* src, __gm__ uint16_t* index, __gm__ half* dst)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ half* src_gm = src + block_idx * block_length;
    __gm__ uint16_t* index_gm = index + block_idx * block_length;
    __gm__ half* dst_gm = dst + block_idx * block_length;

    __ubuf__ half src_local[block_length];
    __ubuf__ uint16_t index_local[block_length];
    __ubuf__ half dst_local[block_length];

    const uint8_t cache_mode0 = static_cast<uint8_t>(((uint64_t)src_gm) >> 60);
    const uint8_t cache_mode1 = static_cast<uint8_t>(((uint64_t)index_gm) >> 60);
    const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t burst_length = block_length * 4;
    uint32_t index_burst_length = block_length * 2;
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align(
        (__ubuf__ half*)src_local, src_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_copy_gm2ub_align((__ubuf__ uint16_t*)index_local, index_gm, BLK_NUM, index_burst_length, 0, 0, true, cache_mode1,
        src_stride, dst_stride);
    asc_sync();

    gather_vf((__ubuf__ half*)src_local, (__ubuf__ uint16_t*)index_local, (__ubuf__ half*)dst_local, block_length);
    asc_sync();

    asc_copy_ub2gm_align(dst_gm, (__ubuf__ half*)dst_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride);
}

std::vector<half> kernel_gather(std::vector<half>& src, std::vector<uint16_t>& index)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src.size();
    size_t src_byte_size = total_length * sizeof(half);
    size_t index_byte_size = total_length * sizeof(uint16_t);
    int32_t device_id = 0;
    uint8_t* src_host = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* index_host = reinterpret_cast<uint8_t*>(index.data());
    uint8_t* dst_host = nullptr;
    half* src_device = nullptr;
    uint16_t* index_device = nullptr;
    half* dst_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_host), src_byte_size);
    aclrtMalloc((void**)&src_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&index_device, index_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src_device, src_byte_size, src_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)index_device, index_byte_size, index_host, index_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    gather_custom<<<num_blocks, 0>>>(src_device, index_device, dst_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_host, src_byte_size, (uint8_t*)dst_device, src_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> dst((half*)dst_host, (half*)(dst_host + src_byte_size));

    aclrtFree(src_device);
    aclrtFree(index_device);
    aclrtFree(dst_device);
    aclrtFreeHost(dst_host);

    aclrtResetDevice(device_id);

    aclFinalize();

    return dst;
}

uint32_t verify_result(std::vector<half>& output, std::vector<half>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<half> src(total_length);
    std::vector<uint16_t> index(total_length);
    std::vector<half> golden(total_length);

    size_t src_file_size = 0;
    size_t index_file_size = 0;
    size_t golden_file_size = 0;
    if (!ReadFile("./input/input_x.bin", src_file_size, src.data(), total_length * sizeof(half))) {
        std::cout << "[Failed] Failed to read input_x data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./input/input_y.bin", index_file_size, index.data(), total_length * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read input_y data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), total_length * sizeof(half))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<half> output = kernel_gather(src, index);
    return verify_result(output, golden);
}
