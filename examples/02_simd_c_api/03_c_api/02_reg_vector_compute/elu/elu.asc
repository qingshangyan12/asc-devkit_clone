/* !
 * \file elu.asc
 * \brief 使用C_API实现ELU（Exponential Linear Unit）算子样例
 *        （纯Vector-Core，寄存器向量计算模式）
 *        ELU(x) = scale*x                          if x > 0
 *               = alpha*scale*(exp(x*inputScale)-1) if x <= 0
 */

#include <cstdint>   // 定长整型
#include <vector>    // Host侧容器
#include <algorithm> // std::min
#include <iterator>  // std::ostream_iterator
#include <cmath>     // std::exp/std::isnan 等
#include <string>    // std::string
#include <iostream>  // std::cout

#include "acl/acl.h"        // AscendCL 运行时（Host侧内存/stream/kernel调用）
#include "c_api/asc_simd.h" // Ascend C C API：asc_*指令、vector_*寄存器、PIPE_*常量
#include "data_utils.h"     // 输入输出数据文件读写工具

// 动态tiling：每段最大元素数（UB容量约束：fp32 2*8192*4=64KB，fp16 2*8192*2=32KB）
constexpr uint32_t MAX_BLOCK_LENGTH = 8192; // 每段最多元素数
constexpr uint32_t NUM_BLOCKS = 8;          // 启动核数上限
constexpr uint32_t BLK_NUM = 1;             // asc_copy_ub2gm_align 块数参数（连续搬出固定1）
constexpr uint32_t VECTOR_LENGTH_BYTES =
    256; // 矢量寄存器长度 VL=256B（950/3510 固定；9.0.0 无 asc_get_vf_len，用常量代替）

// 向上取整除法：count 个元素需循环几次 repeat
__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

// ===== fp32 计算核心：寄存器向量计算，每 repeat 处理 64 个元素 =====
__simd_vf__ inline void elu_vf(
    __ubuf__ float* x_local, // 输入缓冲（UB）
    __ubuf__ float* z_local, // 输出缓冲（UB）
    float alpha,             // 激活系数 α
    float scale,             // 缩放系数
    float input_scale,       // 输入缩放系数
    uint32_t data_len,       // 本段元素个数
    uint16_t one_rep_size,   // 每 repeat 元素数（fp32=64）
    uint16_t repeat_time)    // repeat 次数
{
    vector_bool vmask;         // 主掩码（自动处理尾部）
    vector_bool cmp_mask;      // (x>0) 掩码
    vector_bool small_mask;    // expm1 修正掩码
    vector_float src_reg;      // 输入 x
    vector_float t_reg;        // x*inputScale
    vector_float e_reg;        // exp(t)
    vector_float e_minus1_reg; // e-1
    vector_float series_reg;   // 级数 expm1
    vector_float abs_reg;      // |t|
    vector_float expm1_reg;    // 最终 expm1
    vector_float y_neg_reg;    // α*expm1
    vector_float dst_reg;      // 结果

    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len); // 尾部元素由掩码自动处理
        asc_loadalign(src_reg, x_local + i * one_rep_size);

        // 分支2: y_neg = alpha*expm1(x*inputScale)
        asc_mul_scalar(t_reg, src_reg, input_scale, vmask);
        asc_exp(e_reg, t_reg, vmask);
        asc_add_scalar(e_minus1_reg, e_reg, -1.0f, vmask);

        // expm1 修正：|t|小时用霍纳级数避免 e-1 抵消
        asc_mul_scalar(series_reg, t_reg, 1.0f / 120.0f, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f / 24.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f / 6.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f / 2.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);

        // 计算顺序：先乘 α，Select 后统一乘 scale
        asc_abs(abs_reg, t_reg, vmask);
        asc_lt_scalar(small_mask, abs_reg, 0.1f, vmask);
        asc_select(expm1_reg, series_reg, e_minus1_reg, small_mask);
        asc_mul_scalar(y_neg_reg, expm1_reg, alpha, vmask); // y_neg = expm1 * α

        // selected = (x>0) ? x : y_neg
        asc_gt_scalar(cmp_mask, src_reg, 0.0f, vmask);
        asc_select(dst_reg, src_reg, y_neg_reg, cmp_mask);
        asc_mul_scalar(dst_reg, dst_reg, scale, vmask); // 统一乘 scale

        asc_storealign(z_local + i * one_rep_size, dst_reg, vmask);
    }
}

// ===== fp16 计算核心：fp32 域计算（展开/压缩链路）=====
// fp16 在 fp32 域计算：asc_loadalign_unpack（UNPK_B16 展开）+ asc_half2float 转 fp32，
// 计算后 asc_float2half_rn + asc_storealign_pack（PACK_B16）压缩存储回 half。
// 每 repeat 处理 64 个 half（展开后 128 槽位取偶数位 64 个）。
__simd_vf__ inline void elu_vf(
    __ubuf__ half* x_local, // 输入缓冲（UB）
    __ubuf__ half* z_local, // 输出缓冲（UB）
    float alpha,            // 激活系数 α（FLOAT）
    float scale,            // 缩放系数（FLOAT）
    float input_scale,      // 输入缩放系数（FLOAT）
    uint32_t data_len,      // 本段元素个数
    uint16_t one_rep_size,  // 每 repeat 元素数（fp32 域=64）
    uint16_t repeat_time)   // repeat 次数
{
    vector_bool vmask;         // 主掩码（b32，fp32 域 64 元素）
    vector_bool cmp_mask;      // (x>0) 掩码
    vector_bool small_mask;    // expm1 修正掩码
    vector_half src_half;      // 展开加载的 half（128 槽位，2*N 有效）
    vector_half dst_half;      // 写回的 half（128 槽位，2*N 有效）
    vector_float src_reg;      // 输入 x（fp32）
    vector_float t_reg;        // x*inputScale
    vector_float e_reg;        // exp(t)
    vector_float e_minus1_reg; // e-1
    vector_float series_reg;   // 级数 expm1
    vector_float abs_reg;      // |t|
    vector_float expm1_reg;    // 最终 expm1
    vector_float y_neg_reg;    // α*expm1
    vector_float dst_reg;      // 结果

    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);                      // 尾部元素由掩码自动处理
        asc_loadalign_unpack(src_half, x_local + i * one_rep_size); // 展开加载 64 half → 128 槽位
        asc_half2float(src_reg, src_half, vmask);                   // 读偶数位 64 half → 64 float

        // 分支2: y_neg = alpha*expm1(x*inputScale)
        asc_mul_scalar(t_reg, src_reg, input_scale, vmask);
        asc_exp(e_reg, t_reg, vmask);
        asc_add_scalar(e_minus1_reg, e_reg, -1.0f, vmask);

        // expm1 修正：|t|小时用 4 阶霍纳级数避免 e-1 抵消
        asc_mul_scalar(series_reg, t_reg, 1.0f / 24.0f, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f / 6.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f / 2.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);
        asc_add_scalar(series_reg, series_reg, 1.0f, vmask);
        asc_mul(series_reg, series_reg, t_reg, vmask);

        // 计算顺序：先乘 α，Select 后统一乘 scale
        asc_abs(abs_reg, t_reg, vmask);
        asc_lt_scalar(small_mask, abs_reg, 0.1f, vmask);
        asc_select(expm1_reg, series_reg, e_minus1_reg, small_mask);
        asc_mul_scalar(y_neg_reg, expm1_reg, alpha, vmask); // y_neg = expm1 * α

        // selected = (x>0) ? x : y_neg
        asc_gt_scalar(cmp_mask, src_reg, 0.0f, vmask);
        asc_select(dst_reg, src_reg, y_neg_reg, cmp_mask);
        asc_mul_scalar(dst_reg, dst_reg, scale, vmask); // 统一乘 scale

        // 写回 half 并压缩存储（int32 视图 + PK_B32）
        asc_float2half_rn(dst_half, dst_reg, vmask);
        asc_storealign_pack((__ubuf__ int32_t*)z_local + i * one_rep_size / 2, (vector_int32_t)dst_half, vmask);
    }
}

// ===== fp32 核函数：数据搬运 + 动态tiling + 调度 elu_vf =====
__vector__ __global__ void elu_custom(
    __gm__ float* src, __gm__ float* dst, float alpha, float scale, float input_scale, uint32_t total_length)
{
    asc_init();

    __ubuf__ float x_local[MAX_BLOCK_LENGTH]; // 输入缓冲（UB）
    __ubuf__ float z_local[MAX_BLOCK_LENGTH]; // 输出缓冲（UB）

    uint32_t burst_length = 0;
    uint64_t dst_stride = 0;                                     // 搬出接口 GM 侧 stride（连续数据传 0）
    uint32_t src_stride = 0;                                     // 搬出接口 UB 侧 stride
    uint16_t one_rep_size = VECTOR_LENGTH_BYTES / sizeof(float); // 每 repeat 元素数 = 64

    // 动态tiling：每核按段循环，段间以核数为步长（支持任意 shape，UB 永不超限）
    int64_t block_count = asc_get_block_num();
    for (int64_t seg = block_idx; seg * static_cast<int64_t>(MAX_BLOCK_LENGTH) < static_cast<int64_t>(total_length);
         seg += block_count) {
        uint32_t start = static_cast<uint32_t>(seg * static_cast<int64_t>(MAX_BLOCK_LENGTH)); // 本段起始偏移
        // 本段元素数（末段可能不满；__aicore__ 中不可用 std::min，故用三元表达式）
        uint32_t count = (total_length - start < MAX_BLOCK_LENGTH) ? (total_length - start) : MAX_BLOCK_LENGTH;
        uint16_t repeat_time = ceil_division(count, one_rep_size);

        __gm__ float* x_gm = src + start;
        __gm__ float* z_gm = dst + start;
        burst_length = count * sizeof(float);

        // 搬入：GM→UB（CANN 9.0.0~9.1.0 的 3510 接口为 10 参数版）
        asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, 1, burst_length, 0, 0, false, 0, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0); // 搬入完成 → 通知计算单元
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        elu_vf(
            (__ubuf__ float*)x_local, (__ubuf__ float*)z_local, alpha, scale, input_scale, count, one_rep_size,
            repeat_time);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0); // 计算完成 → 通知搬出单元
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

        asc_copy_ub2gm_align( // 搬出：UB→GM
            z_gm, (__ubuf__ float*)z_local, BLK_NUM, burst_length, 0, dst_stride, src_stride);
        asc_sync(); // 本段搬出完成后才处理下一段
    }
}

// ===== fp16 版核函数：结构同 fp32，仅类型换为 half（标量按 FLOAT 传入，kernel 内转 half）=====
__vector__ __global__ void elu_custom_half(
    __gm__ half* src, __gm__ half* dst, float alpha, float scale, float input_scale, uint32_t total_length)
{
    asc_init();

    __ubuf__ half x_local[MAX_BLOCK_LENGTH]; // 输入缓冲（UB）
    __ubuf__ half z_local[MAX_BLOCK_LENGTH]; // 输出缓冲（UB）

    uint32_t burst_length = 0;
    uint64_t dst_stride = 0;                                     // 搬出接口 GM 侧 stride
    uint32_t src_stride = 0;                                     // 搬出接口 UB 侧 stride
    uint16_t one_rep_size = VECTOR_LENGTH_BYTES / sizeof(float); // fp32 域计算：每 repeat 64 个 half

    int64_t block_count = asc_get_block_num();
    for (int64_t seg = block_idx; seg * static_cast<int64_t>(MAX_BLOCK_LENGTH) < static_cast<int64_t>(total_length);
         seg += block_count) {
        uint32_t start = static_cast<uint32_t>(seg * static_cast<int64_t>(MAX_BLOCK_LENGTH)); // 本段起始偏移
        // 本段元素数（末段可能不满；__aicore__ 中不可用 std::min，故用三元表达式）
        uint32_t count = (total_length - start < MAX_BLOCK_LENGTH) ? (total_length - start) : MAX_BLOCK_LENGTH;
        uint16_t repeat_time = ceil_division(count, one_rep_size);

        __gm__ half* x_gm = src + start;
        __gm__ half* z_gm = dst + start;
        burst_length = count * sizeof(half);

        // 搬入：GM→UB（10 参数版，同 fp32）
        asc_copy_gm2ub_align((__ubuf__ half*)x_local, x_gm, 1, burst_length, 0, 0, false, 0, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        elu_vf(
            (__ubuf__ half*)x_local, (__ubuf__ half*)z_local, alpha, scale, input_scale, count, one_rep_size,
            repeat_time);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

        asc_copy_ub2gm_align( // 搬出：UB→GM
            z_gm, (__ubuf__ half*)z_local, BLK_NUM, burst_length, 0, dst_stride, src_stride);
        asc_sync();
    }
}

// ===== 公共 Host 侧 ACL 执行辅助：初始化/分配/搬入/启动kernel/同步/搬出/清理 =====
// fp32 与 fp16 的 kernel_elu/kernel_elu_half 仅数据类型与 kernel 启动入口不同，
// ACL 生命周期完全一致，故抽取本模板统一管理（评审意见：抽成公共内容）。
template <typename T, typename KernelLauncher>
std::vector<T> RunEluOnDevice(std::vector<T>& x, KernelLauncher&& launchKernel)
{
    uint32_t total_length = x.size();
    // 空 Tensor（shape=0）：直接返回空，避免 0 字节设备内存操作
    if (total_length == 0) {
        return std::vector<T>();
    }
    // 动态核数：每核至多处理 MAX_BLOCK_LENGTH，且不超过 NUM_BLOCKS
    uint32_t num_blocks = (total_length + MAX_BLOCK_LENGTH - 1) / MAX_BLOCK_LENGTH;
    if (num_blocks < 1) {
        num_blocks = 1;
    }
    if (num_blocks > NUM_BLOCKS) {
        num_blocks = NUM_BLOCKS;
    }
    size_t total_byte_size = total_length * sizeof(T);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* z_host = nullptr;
    T* x_device = nullptr;
    T* z_device = nullptr;

    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclInit failed, ret=" << ret << std::endl;
        return std::vector<T>();
    }
    ret = aclrtSetDevice(device_id);
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclrtSetDevice failed, ret=" << ret << std::endl;
        aclFinalize();
        return std::vector<T>();
    }
    ret = aclrtMallocHost((void**)(&z_host), total_byte_size);
    ret = (ret == ACL_SUCCESS) ? aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST) : ret;
    ret = (ret == ACL_SUCCESS) ? aclrtMalloc((void**)&z_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST) : ret;
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclrtMalloc/MallocHost failed, ret=" << ret << std::endl;
        if (x_device != nullptr) {
            aclrtFree(x_device);
        }
        if (z_device != nullptr) {
            aclrtFree(z_device);
        }
        if (z_host != nullptr) {
            aclrtFreeHost(z_host);
        }
        aclrtResetDevice(device_id);
        aclFinalize();
        return std::vector<T>();
    }
    ret = aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclrtMemcpy(H2D) failed, ret=" << ret << std::endl;
        aclrtFree(x_device);
        aclrtFree(z_device);
        aclrtFreeHost(z_host);
        aclrtResetDevice(device_id);
        aclFinalize();
        return std::vector<T>();
    }

    // 创建 stream 并启动 kernel（多核并行，需 stream 同步）
    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclrtCreateStream failed, ret=" << ret << std::endl;
        aclrtFree(x_device);
        aclrtFree(z_device);
        aclrtFreeHost(z_host);
        aclrtResetDevice(device_id);
        aclFinalize();
        return std::vector<T>();
    }
    launchKernel(num_blocks, stream, x_device, z_device);
    ret = aclrtSynchronizeStream(stream);
    aclrtDestroyStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclrtSynchronizeStream failed, ret=" << ret << std::endl;
        aclrtFree(x_device);
        aclrtFree(z_device);
        aclrtFreeHost(z_host);
        aclrtResetDevice(device_id);
        aclFinalize();
        return std::vector<T>();
    }

    ret = aclrtMemcpy(z_host, total_byte_size, (uint8_t*)z_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cout << "[ERROR] aclrtMemcpy(D2H) failed, ret=" << ret << std::endl;
        aclrtFree(x_device);
        aclrtFree(z_device);
        aclrtFreeHost(z_host);
        aclrtResetDevice(device_id);
        aclFinalize();
        return std::vector<T>();
    }
    std::vector<T> z((T*)z_host, (T*)(z_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);
    aclrtResetDevice(device_id);
    aclFinalize();
    return z;
}

// ===== Host 侧封装（fp32）：复用公共 ACL 执行辅助，仅差异为 kernel 启动入口 =====
std::vector<float> kernel_elu(std::vector<float>& x, float alpha, float scale, float input_scale)
{
    return RunEluOnDevice<float>(x, [&](uint32_t num_blocks, aclrtStream stream, float* x_device, float* z_device) {
        elu_custom<<<num_blocks, 0, stream>>>(x_device, z_device, alpha, scale, input_scale, x.size());
    });
}

// ===== Host 侧封装（fp16）：复用公共 ACL 执行辅助，仅差异为 kernel 启动入口 =====
std::vector<half> kernel_elu_half(std::vector<half>& x, float alpha, float scale, float input_scale)
{
    return RunEluOnDevice<half>(x, [&](uint32_t num_blocks, aclrtStream stream, half* x_device, half* z_device) {
        elu_custom_half<<<num_blocks, 0, stream>>>(x_device, z_device, alpha, scale, input_scale, x.size());
    });
}

// ===== fp32 精度验证：按生态算子开源精度标准判定 =====
// |actual-golden| <= atol + rtol*|golden|，且 matched_ratio>=0.99，max_abs_error<=limit
// FLOAT32：rtol=9.77e-4, atol=1.53e-5, max_abs_error_limit=1e-2
uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    if (output.size() != golden.size()) {
        std::cout << "[Failed] output size mismatch: output=" << output.size() << " golden=" << golden.size()
                  << " (kernel execution may have failed)" << std::endl;
        return 1;
    }
    constexpr float atol = 1.53e-5f;
    constexpr float rtol = 9.77e-4f;
    constexpr float required_matched_ratio = 0.99f;
    constexpr float base_limit = 1e-2f; // max_abs_error_limit = 1e-2 or 32*ULP（取更宽松）
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    uint32_t fail_count = 0;
    float max_abs_error = 0.0f;
    float max_abs_error_limit = base_limit;
    for (size_t i = 0; i < golden.size(); ++i) {
        float o = output[i];
        float g = golden[i];
        bool ok = false;
        if (std::isnan(g)) { // golden 为 NaN → 输出必须也是 NaN
            ok = std::isnan(o);
        } else if (std::isinf(g)) { // golden 为 ±Inf → 输出须同号；否则判死
            ok = std::isinf(o) && (std::signbit(o) == std::signbit(g));
            if (!ok) {
                max_abs_error = INFINITY;
            }
        } else { // 普通值 → 混合容差判定
            // golden 有限但输出非有限（NaN/±Inf）→ 明确判错，避免 NaN 被 max 放过
            if (!std::isfinite(o)) {
                ok = false;
                max_abs_error = INFINITY;
            } else {
                float abs_err = std::fabs(o - g);
                max_abs_error = std::max(max_abs_error, abs_err);
                // 32*ULP：对每个 golden 值按 fp32 ULP 动态计算
                float ulp = std::nextafter(g, INFINITY) - g;
                max_abs_error_limit = std::max(max_abs_error_limit, 32.0f * std::fabs(ulp));
                ok = (abs_err <= atol + rtol * std::fabs(g));
            }
        }
        if (!ok) {
            ++fail_count;
            if (fail_count <= 5) {
                std::cout << "Mismatch at [" << i << "]: output=" << o << " golden=" << g << std::endl;
            }
        }
    }
    float matched_ratio =
        golden.empty() ? 1.0f : 1.0f - static_cast<float>(fail_count) / static_cast<float>(golden.size());
    bool pass = (matched_ratio >= required_matched_ratio) && (max_abs_error <= max_abs_error_limit);
    if (pass) {
        std::cout << "test pass!" << std::endl;
        return 0;
    }
    std::cout << "test failed! matched_ratio=" << matched_ratio << " max_abs_error=" << max_abs_error
              << " limit=" << max_abs_error_limit << std::endl;
    return 1;
}

// ===== fp16 精度验证：按生态算子开源精度标准判定 =====
// FLOAT16：rtol=1.95e-3, atol=1.95e-3, max_abs_error_limit=1e-1, matched_ratio>=0.99
uint32_t verify_result_fp16(std::vector<float>& output, std::vector<float>& golden)
{
    if (output.size() != golden.size()) {
        std::cout << "[Failed] fp16 output size mismatch: output=" << output.size() << " golden=" << golden.size()
                  << " (kernel execution may have failed)" << std::endl;
        return 1;
    }
    constexpr float atol = 1.95e-3f;
    constexpr float rtol = 1.95e-3f;
    constexpr float required_matched_ratio = 0.99f;
    constexpr float base_limit = 1e-1f; // max_abs_error_limit = 1e-1 or 32*ULP（取更宽松）
    uint32_t fail_count = 0;
    float max_abs_error = 0.0f;
    float max_abs_error_limit = base_limit;
    for (size_t i = 0; i < golden.size(); ++i) {
        float o = output[i];
        float g = golden[i];
        bool ok = false;
        if (std::isnan(g)) { // NaN 必须匹配
            ok = std::isnan(o);
        } else if (std::isinf(g)) { // ±Inf 必须同号；符号错误直接判死（max_abs_error=INFINITY）
            ok = std::isinf(o) && (std::signbit(o) == std::signbit(g));
            if (!ok) {
                max_abs_error = INFINITY;
            }
        } else { // 普通值 → 混合容差判定
            // golden 有限但输出非有限（NaN/±Inf）→ 明确判错，避免 NaN 被 max 放过
            if (!std::isfinite(o)) {
                ok = false;
                max_abs_error = INFINITY;
            } else {
                float abs_err = std::fabs(o - g);
                max_abs_error = std::max(max_abs_error, abs_err);
                // 32*ULP：输出为 fp16 精度，按 fp16 ULP 动态计算
                float g_half = static_cast<half>(g);
                float ulp = std::nextafter(g_half, INFINITY) - g_half;
                max_abs_error_limit = std::max(max_abs_error_limit, 32.0f * std::fabs(ulp));
                ok = (abs_err <= atol + rtol * std::fabs(g));
            }
        }
        if (!ok) {
            ++fail_count;
            if (fail_count <= 5) {
                std::cout << "Mismatch at [" << i << "]: output=" << o << " golden=" << g << std::endl;
            }
        }
    }
    float matched_ratio =
        golden.empty() ? 1.0f : 1.0f - static_cast<float>(fail_count) / static_cast<float>(golden.size());
    bool pass = (matched_ratio >= required_matched_ratio) && (max_abs_error <= max_abs_error_limit);
    if (pass) {
        std::cout << "test pass!" << std::endl;
        return 0;
    }
    std::cout << "test failed! matched_ratio=" << matched_ratio << " max_abs_error=" << max_abs_error
              << " limit=" << max_abs_error_limit << std::endl;
    return 1;
}

// ===== 边界值与参数组合专项测试：NaN/±Inf/±0 特殊值 + 不同系数组合 + 空Tensor =====
uint32_t test_special_and_params()
{
    uint32_t fail_total = 0;

    // ---- 1) 特殊值：NaN / +Inf / -Inf / +0 / -0 ----
    std::cout << "===== special values (NaN / Inf / 0) =====" << std::endl;
    constexpr uint32_t n = 8;
    const float special_x[n] = {0.0f, -0.0f, 1.0f, -1.0f, INFINITY, -INFINITY, NAN, -100.0f};
    constexpr float sa = 1.0f;
    constexpr float ss = 1.0f;
    constexpr float si = 1.0f;

    std::vector<float> x_special(n);
    std::vector<float> golden_special(n);
    for (uint32_t i = 0; i < n; ++i) {
        float v = special_x[i];
        x_special[i] = v;
        if (std::isnan(v)) {
            golden_special[i] = NAN;
        } else if (v > 0.0f) {
            golden_special[i] = ss * v;
        } else {
            golden_special[i] = sa * ss * (std::exp(v * si) - 1.0f);
        }
    }
    std::vector<float> out_special = kernel_elu(x_special, sa, ss, si);
    fail_total += verify_result(out_special, golden_special);

    // fp16 特殊值（golden 用 kernel 实际收到的量化后输入计算）
    std::vector<half> x_half_special(n);
    for (uint32_t i = 0; i < n; ++i) {
        x_half_special[i] = static_cast<half>(x_special[i]);
    }
    std::vector<float> golden_fp16_special(n);
    for (uint32_t i = 0; i < n; ++i) {
        float v = static_cast<float>(x_half_special[i]); // kernel 实际收到的输入
        if (std::isnan(v)) {
            golden_fp16_special[i] = NAN;
        } else if (v > 0.0f) {
            golden_fp16_special[i] = ss * v;
        } else {
            golden_fp16_special[i] = sa * ss * (std::exp(v * si) - 1.0f);
        }
    }
    std::vector<half> out_half_special = kernel_elu_half(x_half_special, sa, ss, si);
    std::vector<float> out_fp16_special(n);
    for (uint32_t i = 0; i < n; ++i) {
        out_fp16_special[i] = static_cast<float>(out_half_special[i]);
    }
    fail_total += verify_result_fp16(out_fp16_special, golden_fp16_special);

    // ---- 2) 参数组合：覆盖 alpha/scale/input_scale 的多样语义 ----
    constexpr uint32_t n2 = 256;
    std::vector<float> x2(n2);
    for (uint32_t i = 0; i < n2; ++i) { // [-100,100] 均匀分布
        x2[i] = -100.0f + 200.0f * static_cast<float>(i) / static_cast<float>(n2 - 1);
    }
    constexpr uint32_t num_param_cases = 8;
    // 覆盖：非默认系数、负 input_scale、alpha=0、scale=0、负 alpha、input_scale=0、较大系数。
    // 注1：input_scale 大幅负值时 exp(x*inputScale) 在 [-100,100] 会溢出
    //      （设备 asc_exp 约 exp≈2.9e38 溢出），fp16 在 x<-11 即溢出，
    //      属数据范围边界、非 kernel 缺陷，故负 input_scale 取小幅 -0.01。
    // 注2：系数不宜过大——生态标准对 fp16 有 max_abs_error<=0.1 硬上限，
    //      half 输出绝对值过大时固有舍入误差必然超限
    //      （如 scale=10 输出 1000 时误差≈0.47）。
    //      实测 scale=1.5、输出 150 处 fp16 ULP=0.125，随机输入下
    //      max_abs_error 可达 0.125>0.1，故本组取输出 ≤125（ULP=0.0625），
    //      随机输入下 max_abs_error 仍稳低于 0.1 上限。
    // 各组合负半轴 exp 参数均 ≤0，不触发上溢。
    const float params[num_param_cases][3] = {
        {2.0f, 0.5f, 1.5f},   // 非默认系数
        {1.5f, 2.0f, -0.01f}, // 负 input_scale（小幅）
        {0.5f, 1.0f, 1.0f},   // 小 alpha
        {0.0f, 1.0f, 1.0f},   // alpha=0：负半轴恒 0
        {1.0f, 0.0f, 1.0f},   // scale=0：输出恒 0
        {-1.0f, 1.0f, 1.0f},  // 负 alpha：负半轴符号取反
        {1.0f, 1.0f, 0.0f},   // input_scale=0：负半轴恒 0（exp(0)-1=0）
        {2.0f, 1.25f, 1.0f}   // 较大 alpha & scale（输出 ≤125，fp16 ULP=0.0625，误差稳低于 0.1）
    };
    for (uint32_t c = 0; c < num_param_cases; ++c) {
        float pa = params[c][0];
        float ps = params[c][1];
        float pi = params[c][2];
        std::cout << "===== params alpha=" << pa << " scale=" << ps << " input_scale=" << pi << " =====" << std::endl;

        std::vector<float> golden2(n2);
        for (uint32_t i = 0; i < n2; ++i) {
            golden2[i] = (x2[i] > 0.0f) ? ps * x2[i] : pa * ps * (std::exp(x2[i] * pi) - 1.0f);
        }
        std::vector<float> out2 = kernel_elu(x2, pa, ps, pi);
        fail_total += verify_result(out2, golden2);

        // fp16（golden 用 kernel 实际收到的量化后输入计算）
        std::vector<half> x2_half(n2);
        for (uint32_t i = 0; i < n2; ++i) {
            x2_half[i] = static_cast<half>(x2[i]);
        }
        std::vector<float> golden2_fp16(n2);
        for (uint32_t i = 0; i < n2; ++i) {
            float x_ref = static_cast<float>(x2_half[i]); // kernel 实际收到的输入
            golden2_fp16[i] = (x_ref > 0.0f) ? ps * x_ref : pa * ps * (std::exp(x_ref * pi) - 1.0f);
        }
        std::vector<half> out2_half = kernel_elu_half(x2_half, pa, ps, pi);
        std::vector<float> out2_fp16(n2);
        for (uint32_t i = 0; i < n2; ++i) {
            out2_fp16[i] = static_cast<float>(out2_half[i]);
        }
        fail_total += verify_result_fp16(out2_fp16, golden2_fp16);
    }

    // ---- 3) 小x精度测试：x→0 时 exp-1 有灾难性抵消，验证 expm1 修正 ----
    std::cout << "===== tiny x precision (expm1) =====" << std::endl;
    constexpr uint32_t n3 = 8;
    const float tiny_x[n3] = {1e-3f, 1e-4f, 1e-5f, 1e-6f, -1e-3f, -1e-5f, -1e-8f, 0.0f};
    std::vector<float> x_tiny(n3);
    std::vector<float> golden_tiny(n3); // 负分支用 std::expm1 精确计算，避免 exp-1 抵消
    for (uint32_t i = 0; i < n3; ++i) {
        float v = tiny_x[i];
        x_tiny[i] = v;
        golden_tiny[i] = (v > 0.0f) ? ss * v : sa * ss * (std::expm1(v * si));
    }
    std::vector<float> out_tiny = kernel_elu(x_tiny, sa, ss, si);
    fail_total += verify_result(out_tiny, golden_tiny);

    // fp16 小x（golden 用 kernel 实际收到的量化后输入计算）
    std::vector<half> x_tiny_half(n3);
    for (uint32_t i = 0; i < n3; ++i) {
        x_tiny_half[i] = static_cast<half>(x_tiny[i]);
    }
    std::vector<float> golden_tiny_fp16(n3);
    for (uint32_t i = 0; i < n3; ++i) {
        float v = static_cast<float>(x_tiny_half[i]); // kernel 实际收到的输入
        golden_tiny_fp16[i] = (v > 0.0f) ? ss * v : sa * ss * (std::expm1(v * si));
    }
    std::vector<half> out_tiny_half = kernel_elu_half(x_tiny_half, sa, ss, si);
    std::vector<float> out_tiny_fp16(n3);
    for (uint32_t i = 0; i < n3; ++i) {
        out_tiny_fp16[i] = static_cast<float>(out_tiny_half[i]);
    }
    fail_total += verify_result_fp16(out_tiny_fp16, golden_tiny_fp16);

    // ---- 4) 非有限标量参数：alpha/scale/input_scale 为 ±Inf/NaN ----
    // 非有限标量按 IEEE 语义直接参与乘法传播，本测试验证各符号下的输出行为。
    std::cout << "===== non-finite scalar params (alpha/scale/input_scale) =====" << std::endl;
    constexpr uint32_t n4 = 8;
    const float finite_x[n4] = {0.0f, -0.0f, 1.0f, -1.0f, 2.0f, -2.0f, 0.5f, -0.5f};
    struct NonFiniteCase {
        float a, s, i;
    };
    const NonFiniteCase nf_cases[] = {
        {INFINITY, 1.0f, 1.0f},  // alpha=+Inf：x<0 处 expm1*Inf，x=0 处 0*Inf=NaN
        {-INFINITY, 1.0f, 1.0f}, // alpha=-Inf：x<0 处 expm1*(-Inf)，x=0 处 0*(-Inf)=NaN
        {NAN, 1.0f, 1.0f},       // alpha=NaN：x<=0 处全部 NaN
        {1.0f, INFINITY, 1.0f},  // scale=+Inf：x>0 处 x*Inf=+Inf，x=0 处 0*Inf=NaN
        {1.0f, 1.0f, INFINITY},  // input_scale=+Inf：x<0 处 exp(-Inf)-1=-1，x=0 处 Inf*0=NaN
    };
    constexpr uint32_t num_nf_cases = sizeof(nf_cases) / sizeof(nf_cases[0]);
    for (uint32_t c = 0; c < num_nf_cases; ++c) {
        float na = nf_cases[c].a;
        float ns = nf_cases[c].s;
        float ni = nf_cases[c].i;
        std::cout << "===== non-finite params alpha=" << na << " scale=" << ns << " input_scale=" << ni
                  << " =====" << std::endl;

        std::vector<float> x_nf(n4);
        std::vector<float> golden_nf(n4);
        for (uint32_t i = 0; i < n4; ++i) {
            float v = finite_x[i];
            x_nf[i] = v;
            // golden 用直接法 exp(x*inputScale)-1（非 expm1 级数）计算
            golden_nf[i] = (v > 0.0f) ? ns * v : na * ns * (std::exp(v * ni) - 1.0f);
        }
        std::vector<float> out_nf = kernel_elu(x_nf, na, ns, ni);
        fail_total += verify_result(out_nf, golden_nf);

        // fp16（golden 用 kernel 实际收到的量化后输入计算）
        std::vector<half> x_nf_half(n4);
        for (uint32_t i = 0; i < n4; ++i) {
            x_nf_half[i] = static_cast<half>(x_nf[i]);
        }
        std::vector<float> golden_nf_fp16(n4);
        for (uint32_t i = 0; i < n4; ++i) {
            float v = static_cast<float>(x_nf_half[i]); // kernel 实际收到的输入
            golden_nf_fp16[i] = (v > 0.0f) ? ns * v : na * ns * (std::exp(v * ni) - 1.0f);
        }
        std::vector<half> out_nf_half = kernel_elu_half(x_nf_half, na, ns, ni);
        std::vector<float> out_nf_fp16(n4);
        for (uint32_t i = 0; i < n4; ++i) {
            out_nf_fp16[i] = static_cast<float>(out_nf_half[i]);
        }
        fail_total += verify_result_fp16(out_nf_fp16, golden_nf_fp16);
    }

    // ---- 5) 空Tensor（shape=0）----
    std::cout << "===== empty tensor (shape=0) =====" << std::endl;
    std::vector<float> x_empty;
    std::vector<float> out_empty = kernel_elu(x_empty, 1.0f, 1.0f, 1.0f);
    if (out_empty.empty()) {
        std::cout << "[Success] empty tensor handled." << std::endl;
    } else {
        std::cout << "[Failed] empty tensor should return empty." << std::endl;
        ++fail_total;
    }

    return fail_total;
}

// ===== 文件模式验证：读取 scripts/gen_data.py 生成的输入
// 与 golden 比对（与同目录样例一致）=====
uint32_t verify_file_data()
{
    constexpr uint32_t total_length = 256; // 与 gen_data.py 的数据长度一致
    uint32_t fail_total = 0;
    size_t file_size = 0;

    // ---- fp32 ----
    std::cout << "===== file mode (fp32, gen_data.py) =====" << std::endl;
    std::vector<float> x(total_length);
    std::vector<float> golden(total_length);
    if (!ReadFile("./input/input_x.bin", file_size, x.data(), total_length * sizeof(float))) {
        std::cout << "[Failed] Failed to read input_x.bin! please run: python3 ../scripts/gen_data.py" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", file_size, golden.data(), total_length * sizeof(float))) {
        std::cout << "[Failed] Failed to read golden.bin! please run: python3 ../scripts/gen_data.py" << std::endl;
        return 1;
    }
    std::vector<float> output = kernel_elu(x, 1.0f, 1.0f, 1.0f);
    fail_total += static_cast<uint32_t>(verify_result(output, golden));

    // ---- fp16 ----
    std::cout << "===== file mode (fp16, gen_data.py) =====" << std::endl;
    std::vector<half> x_half(total_length);
    std::vector<half> golden_half(total_length);
    if (!ReadFile("./input/input_x_fp16.bin", file_size, x_half.data(), total_length * sizeof(half))) {
        std::cout << "[Failed] Failed to read input_x_fp16.bin! please run: python3 ../scripts/gen_data.py"
                  << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden_fp16.bin", file_size, golden_half.data(), total_length * sizeof(half))) {
        std::cout << "[Failed] Failed to read golden_fp16.bin! please run: python3 ../scripts/gen_data.py" << std::endl;
        return 1;
    }
    std::vector<half> output_half = kernel_elu_half(x_half, 1.0f, 1.0f, 1.0f);
    std::vector<float> output_fp16(total_length);
    std::vector<float> golden_fp16(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        output_fp16[i] = static_cast<float>(output_half[i]);
        golden_fp16[i] = static_cast<float>(golden_half[i]);
    }
    fail_total += static_cast<uint32_t>(verify_result_fp16(output_fp16, golden_fp16));

    return fail_total;
}

// ===== 程序入口 =====
// 默认：文件模式（与同目录样例一致）；传参 --selftest：内置全量自测
// （11组shape × fp32/fp16 + 特殊值/参数/小x/空Tensor）
int32_t main(int32_t argc, char* argv[])
{
    if (argc > 1 && std::string(argv[1]) == "--selftest") {
        // 测试参数：使用 elu 默认值（alpha=1, scale=1, input_scale=1）
        constexpr float alpha = 1.0f;
        constexpr float scale = 1.0f;
        constexpr float input_scale = 1.0f;

        // 泛化 shape：覆盖任务书 1/32/1024/2048、2 的幂与 2 的幂-1、大 shape 验证动态 tiling
        const std::vector<uint32_t> shapes = {1, 31, 32, 1023, 1024, 2047, 2048, 8191, 8 * 2048, 100000, 1048575};

        int32_t fail_total = 0;
        for (uint32_t total_length : shapes) {
            // 数据范围 [-100, 100]，覆盖正负区间
            std::vector<float> x(total_length);
            for (uint32_t i = 0; i < total_length; ++i) { // shape=1 时取 -50
                x[i] = (total_length == 1) ?
                           -50.0f :
                           -100.0f + (200.0f * static_cast<float>(i) / static_cast<float>(total_length - 1));
            }

            // ---- fp32 ----
            std::cout << "===== shape=" << total_length << " (fp32) =====" << std::endl;
            std::vector<float> output = kernel_elu(x, alpha, scale, input_scale);
            // Host 侧仅生成 golden，Device 侧计算全部在 kernel 批量完成
            std::vector<float> golden(total_length);
            for (uint32_t i = 0; i < total_length; ++i) {
                if (x[i] > 0.0f) {
                    golden[i] = scale * x[i];
                } else {
                    golden[i] = alpha * scale * (std::exp(x[i] * input_scale) - 1.0f);
                }
            }
            fail_total += static_cast<int32_t>(verify_result(output, golden));

            // ---- fp16：输入转 half，golden 用 kernel 实际收到的
            // 量化后输入计算（与 Device 输入一致）----
            std::cout << "===== shape=" << total_length << " (fp16) =====" << std::endl;
            std::vector<half> x_half(total_length);
            for (uint32_t i = 0; i < total_length; ++i) {
                x_half[i] = static_cast<half>(x[i]);
            }
            std::vector<float> golden_fp16(total_length);
            for (uint32_t i = 0; i < total_length; ++i) {
                float x_ref = static_cast<float>(x_half[i]); // kernel 实际收到的输入
                if (x_ref > 0.0f) {
                    golden_fp16[i] = scale * x_ref;
                } else {
                    golden_fp16[i] = alpha * scale * (std::exp(x_ref * input_scale) - 1.0f);
                }
            }
            std::vector<half> output_half = kernel_elu_half(x_half, alpha, scale, input_scale);
            std::vector<float> output_fp16(total_length);
            for (uint32_t i = 0; i < total_length; ++i) {
                output_fp16[i] = static_cast<float>(output_half[i]);
            }
            fail_total += static_cast<int32_t>(verify_result_fp16(output_fp16, golden_fp16));
        }

        // ---- 边界值与参数组合专项测试 ----
        fail_total += static_cast<int32_t>(test_special_and_params());

        if (fail_total == 0) {
            std::cout << "\n[Success] All cases verification passed." << std::endl;
            return 0;
        }
        std::cout << "\n[Failed] Some cases verification failed! failed count=" << fail_total << std::endl;
        return 1;
    }

    // ---- 文件模式（默认）----
    uint32_t fail_total = verify_file_data();
    if (fail_total == 0) {
        std::cout << "\n[Success] File mode verification passed." << std::endl;
        return 0;
    }
    std::cout << "\n[Failed] File mode verification failed! failed count=" << fail_total << std::endl;
    return 1;
}
