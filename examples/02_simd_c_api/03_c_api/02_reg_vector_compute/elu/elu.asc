/* !
 * \file elu.asc
 * \brief ELU implemented with the Ascend C register C API for float and float16 tensors.
 */

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iomanip>
#include <iostream>
#include <limits>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"

#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TILE_LENGTH = 2048;
constexpr uint32_t FLOAT_SMALL_INPUT = 256;
constexpr uint32_t HALF_SMALL_INPUT = 1024;
constexpr uint32_t MIN_ELEMENTS_PER_BLOCK = 512;
constexpr uint32_t MAX_BLOCKS = 56;
// Ascend 950 (NPU architecture 3510) has a fixed 256-byte vector length: 64 float lanes per repeat.
constexpr uint16_t FLOAT_ELEMENTS_PER_REPEAT = 64;

__aicore__ constexpr uint32_t CeilDivision(uint32_t numerator, uint32_t denominator)
{
    return numerator / denominator + static_cast<uint32_t>(numerator % denominator != 0);
}

__simd_vf__ inline void EluFloatVf(
    __ubuf__ float* xLocal, __ubuf__ float* yLocal, uint32_t dataLength, uint16_t oneRepeatSize, uint16_t repeatTimes,
    float alpha, float scale, float inputScale)
{
    uint32_t remaining = dataLength;

    vector_bool activeMask;
    vector_bool smallMask;
    vector_bool positiveMask;
    vector_float xReg;
    vector_float zReg;
    vector_float polyReg;
    vector_float normalReg;
    vector_float absReg;
    vector_float expm1Reg;
    vector_float resultReg;

    for (uint16_t i = 0; i < repeatTimes; ++i) {
        activeMask = asc_update_mask_b32(remaining);
        asc_loadalign(xReg, xLocal + i * oneRepeatSize);

        asc_mul_scalar(zReg, xReg, inputScale, activeMask);

        // z * (1 + z * (1/2 + z * (1/6 + z * (1/24 + z/120))))
        asc_mul_scalar(polyReg, zReg, 1.0f / 120.0f, activeMask);
        asc_add_scalar(polyReg, polyReg, 1.0f / 24.0f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);
        asc_add_scalar(polyReg, polyReg, 1.0f / 6.0f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);
        asc_add_scalar(polyReg, polyReg, 0.5f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);
        asc_add_scalar(polyReg, polyReg, 1.0f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);

        asc_exp(normalReg, zReg, activeMask);
        asc_add_scalar(normalReg, normalReg, -1.0f, activeMask);
        asc_abs(absReg, zReg, activeMask);
        asc_lt_scalar(smallMask, absReg, 0.1f, activeMask);
        asc_select(expm1Reg, polyReg, normalReg, smallMask);

        asc_mul_scalar(expm1Reg, expm1Reg, alpha, activeMask);
        asc_gt_scalar(positiveMask, xReg, 0.0f, activeMask);
        asc_select(resultReg, xReg, expm1Reg, positiveMask);
        asc_mul_scalar(resultReg, resultReg, scale, activeMask);
        asc_storealign(yLocal + i * oneRepeatSize, resultReg, activeMask);
    }
}

__simd_vf__ inline void EluHalfVf(
    __ubuf__ half* xLocal, __ubuf__ half* yLocal, uint32_t dataLength, uint16_t oneRepeatSize, uint16_t repeatTimes,
    float alpha, float scale, float inputScale)
{
    // Half values are unpacked into 32-bit lanes, so the logical repeat width follows vector_float.
    uint32_t remaining = dataLength;

    vector_bool activeMask;
    vector_bool smallMask;
    vector_bool positiveMask;
    vector_half xHalfReg;
    vector_half resultHalfReg;
    vector_float xReg;
    vector_float zReg;
    vector_float polyReg;
    vector_float normalReg;
    vector_float absReg;
    vector_float expm1Reg;
    vector_float resultReg;

    for (uint16_t i = 0; i < repeatTimes; ++i) {
        activeMask = asc_update_mask_b32(remaining);
        asc_loadalign_unpack(xHalfReg, xLocal + i * oneRepeatSize);
        asc_half2float(xReg, xHalfReg, activeMask);

        asc_mul_scalar(zReg, xReg, inputScale, activeMask);

        // z * (1 + z * (1/2 + z * (1/6 + z/24)))
        asc_mul_scalar(polyReg, zReg, 1.0f / 24.0f, activeMask);
        asc_add_scalar(polyReg, polyReg, 1.0f / 6.0f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);
        asc_add_scalar(polyReg, polyReg, 0.5f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);
        asc_add_scalar(polyReg, polyReg, 1.0f, activeMask);
        asc_mul(polyReg, polyReg, zReg, activeMask);

        asc_exp(normalReg, zReg, activeMask);
        asc_add_scalar(normalReg, normalReg, -1.0f, activeMask);
        asc_abs(absReg, zReg, activeMask);
        asc_lt_scalar(smallMask, absReg, 0.1f, activeMask);
        asc_select(expm1Reg, polyReg, normalReg, smallMask);

        asc_mul_scalar(expm1Reg, expm1Reg, alpha, activeMask);
        asc_gt_scalar(positiveMask, xReg, 0.0f, activeMask);
        asc_select(resultReg, xReg, expm1Reg, positiveMask);
        asc_mul_scalar(resultReg, resultReg, scale, activeMask);

        asc_float2half_rn(resultHalfReg, resultReg, activeMask);
        asc_storealign_pack(
            (__ubuf__ int32_t*)yLocal + i * oneRepeatSize / 2, (vector_int32_t)resultHalfReg, activeMask);
    }
}

__vector__ __global__ void elu_custom(
    __gm__ float* x, __gm__ float* y, float alpha, float scale, float inputScale, uint32_t totalLength,
    uint32_t blockLength)
{
    asc_init();

    const uint32_t blockStart = block_idx * blockLength;
    const uint32_t remainingLength = totalLength - blockStart;
    const uint32_t currentBlockLength = remainingLength < blockLength ? remainingLength : blockLength;

    __gm__ float* xBlock = x + blockStart;
    __gm__ float* yBlock = y + blockStart;
    __ubuf__ float xLocal[TILE_LENGTH];
    __ubuf__ float yLocal[TILE_LENGTH];
    constexpr uint16_t burstCount = 1;
    constexpr uint8_t zeroU8 = 0;
    constexpr uint32_t zeroU32 = 0;
    constexpr uint64_t zeroU64 = 0;
    constexpr uint16_t oneRepeatSize = FLOAT_ELEMENTS_PER_REPEAT;

    for (uint32_t tileStart = 0; tileStart < currentBlockLength; tileStart += TILE_LENGTH) {
        const uint32_t tileRemaining = currentBlockLength - tileStart;
        const uint32_t tileLength = tileRemaining < TILE_LENGTH ? tileRemaining : TILE_LENGTH;
        const uint32_t tileBytes = tileLength * sizeof(float);

        asc_copy_gm2ub_align(
            xLocal, xBlock + tileStart, burstCount, tileBytes, zeroU8, zeroU8, false, zeroU8, zeroU64, zeroU32);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        const uint16_t repeatTimes = static_cast<uint16_t>(CeilDivision(tileLength, oneRepeatSize));
        EluFloatVf(xLocal, yLocal, tileLength, oneRepeatSize, repeatTimes, alpha, scale, inputScale);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

        asc_copy_ub2gm_align(yBlock + tileStart, yLocal, burstCount, tileBytes, zeroU8, zeroU64, zeroU32);
        asc_sync();
    }
}

__vector__ __global__ void elu_custom_half(
    __gm__ half* x, __gm__ half* y, float alpha, float scale, float inputScale, uint32_t totalLength,
    uint32_t blockLength)
{
    asc_init();

    const uint32_t blockStart = block_idx * blockLength;
    const uint32_t remainingLength = totalLength - blockStart;
    const uint32_t currentBlockLength = remainingLength < blockLength ? remainingLength : blockLength;

    __gm__ half* xBlock = x + blockStart;
    __gm__ half* yBlock = y + blockStart;
    __ubuf__ half xLocal[TILE_LENGTH];
    __ubuf__ half yLocal[TILE_LENGTH];
    constexpr uint16_t burstCount = 1;
    constexpr uint8_t zeroU8 = 0;
    constexpr uint32_t zeroU32 = 0;
    constexpr uint64_t zeroU64 = 0;
    constexpr uint16_t oneRepeatSize = FLOAT_ELEMENTS_PER_REPEAT;

    for (uint32_t tileStart = 0; tileStart < currentBlockLength; tileStart += TILE_LENGTH) {
        const uint32_t tileRemaining = currentBlockLength - tileStart;
        const uint32_t tileLength = tileRemaining < TILE_LENGTH ? tileRemaining : TILE_LENGTH;
        const uint32_t tileBytes = tileLength * sizeof(half);

        asc_copy_gm2ub_align(
            xLocal, xBlock + tileStart, burstCount, tileBytes, zeroU8, zeroU8, false, zeroU8, zeroU64, zeroU32);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        const uint16_t repeatTimes = static_cast<uint16_t>(CeilDivision(tileLength, oneRepeatSize));
        EluHalfVf(xLocal, yLocal, tileLength, oneRepeatSize, repeatTimes, alpha, scale, inputScale);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

        asc_copy_ub2gm_align(yBlock + tileStart, yLocal, burstCount, tileBytes, zeroU8, zeroU64, zeroU32);
        asc_sync();
    }
}

namespace {

void CheckAcl(aclError status, const char* expression, int line)
{
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(
            std::string("ACL call failed at line ") + std::to_string(line) + ": " + expression +
            ", error=" + std::to_string(status));
    }
}

#define ACL_CHECK(expression) CheckAcl((expression), #expression, __LINE__)

class AclSession {
public:
    AclSession()
    {
        ACL_CHECK(aclInit(nullptr));
        initialized_ = true;
        const aclError status = aclrtSetDevice(deviceId_);
        if (status != ACL_SUCCESS) {
            (void)aclFinalize();
            initialized_ = false;
            CheckAcl(status, "aclrtSetDevice(deviceId_)", __LINE__);
        }
        deviceSet_ = true;
    }

    ~AclSession()
    {
        if (deviceSet_) {
            (void)aclrtResetDevice(deviceId_);
        }
        if (initialized_) {
            (void)aclFinalize();
        }
    }

    AclSession(const AclSession&) = delete;
    AclSession& operator=(const AclSession&) = delete;

private:
    int32_t deviceId_ = 0;
    bool initialized_ = false;
    bool deviceSet_ = false;
};

template <typename T>
class DeviceBuffer {
public:
    explicit DeviceBuffer(size_t count)
    {
        if (count != 0) {
            ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&data_), count * sizeof(T), ACL_MEM_MALLOC_HUGE_FIRST));
        }
    }

    ~DeviceBuffer()
    {
        if (data_ != nullptr) {
            (void)aclrtFree(data_);
        }
    }

    DeviceBuffer(const DeviceBuffer&) = delete;
    DeviceBuffer& operator=(const DeviceBuffer&) = delete;

    T* Get() const { return data_; }

private:
    T* data_ = nullptr;
};

struct LaunchPlan {
    uint32_t blockCount;
    uint32_t blockLength;
};

uint32_t CeilDivisionHost(uint32_t numerator, uint32_t denominator)
{
    return numerator / denominator + static_cast<uint32_t>(numerator % denominator != 0);
}

uint32_t AlignUp(uint32_t value, uint32_t alignment)
{
    const uint64_t aligned =
        (static_cast<uint64_t>(value) + alignment - 1) / alignment * static_cast<uint64_t>(alignment);
    if (aligned > std::numeric_limits<uint32_t>::max()) {
        throw std::overflow_error("Aligned block length exceeds uint32_t");
    }
    return static_cast<uint32_t>(aligned);
}

LaunchPlan MakeLaunchPlan(
    uint32_t totalLength, uint32_t smallInputLimit, uint32_t maxBlocks, uint32_t alignmentElements)
{
    uint32_t requestedBlocks = 1;
    if (totalLength > smallInputLimit) {
        requestedBlocks = std::min(maxBlocks, CeilDivisionHost(totalLength, MIN_ELEMENTS_PER_BLOCK));
    }
    const uint32_t blockLength = AlignUp(CeilDivisionHost(totalLength, requestedBlocks), alignmentElements);
    return {CeilDivisionHost(totalLength, blockLength), blockLength};
}

template <typename T>
void CopyInputToDevice(const std::vector<T>& input, DeviceBuffer<T>& deviceInput)
{
    const size_t bytes = input.size() * sizeof(T);
    ACL_CHECK(aclrtMemcpy(deviceInput.Get(), bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
}

template <typename T>
void CopyOutputToHost(const DeviceBuffer<T>& deviceOutput, std::vector<T>& output)
{
    const size_t bytes = output.size() * sizeof(T);
    ACL_CHECK(aclrtMemcpy(output.data(), bytes, deviceOutput.Get(), bytes, ACL_MEMCPY_DEVICE_TO_HOST));
}

float ToFloat(float value) { return value; }

float ToFloat(half value) { return static_cast<float>(value); }

template <typename T>
bool VerifyResult(const std::vector<T>& output, const std::vector<float>& golden, const std::string& dtype)
{
    // This per-element loop belongs to the test verifier; kernel_elu performs no Host-side ELU computation.
    if (output.size() != golden.size()) {
        std::cerr << "[ERROR] Output size does not match golden size" << std::endl;
        return false;
    }
    const double relativeTolerance = dtype == "float32" ? std::ldexp(1.0, -10) : std::ldexp(1.0, -9);
    const double absoluteTolerance = dtype == "float32" ? std::ldexp(1.0, -16) : std::ldexp(1.0, -9);
    const double maxAbsoluteLimit = dtype == "float32" ? 0.01 : 0.1;

    size_t matched = 0;
    double maxAbsoluteError = 0.0;
    for (size_t i = 0; i < output.size(); ++i) {
        const double actual = static_cast<double>(ToFloat(output[i]));
        const double expected = static_cast<double>(golden[i]);

        bool currentMatch = false;
        if (std::isnan(actual) || std::isnan(expected)) {
            currentMatch = std::isnan(actual) && std::isnan(expected);
        } else if (std::isinf(actual) || std::isinf(expected)) {
            currentMatch = actual == expected;
        } else {
            const double absoluteError = std::abs(actual - expected);
            maxAbsoluteError = std::max(maxAbsoluteError, absoluteError);
            currentMatch = absoluteError <= absoluteTolerance + relativeTolerance * std::abs(expected);
        }

        if (currentMatch) {
            ++matched;
        } else if (!std::isfinite(actual) || !std::isfinite(expected)) {
            maxAbsoluteError = std::numeric_limits<double>::infinity();
        }
    }

    const double matchedRatio = output.empty() ? 1.0 : static_cast<double>(matched) / output.size();
    const bool passed = matchedRatio >= 0.99 && maxAbsoluteError <= maxAbsoluteLimit;
    std::cout << std::setprecision(9) << "RESULT dtype=" << dtype << " length=" << output.size()
              << " matched_ratio=" << matchedRatio << " max_abs_error=" << maxAbsoluteError
              << " status=" << (passed ? "PASS" : "FAIL") << std::endl;
    return passed;
}

uint32_t ParseLength(const std::string& text)
{
    if (text.empty() || text.front() == '-') {
        throw std::invalid_argument("length must be a non-negative integer");
    }
    size_t parsedCharacters = 0;
    const unsigned long long value = std::stoull(text, &parsedCharacters);
    if (parsedCharacters != text.size() || value > std::numeric_limits<uint32_t>::max()) {
        throw std::invalid_argument("length must fit in uint32_t");
    }
    return static_cast<uint32_t>(value);
}

float ParseFloat(const std::string& text, const char* name)
{
    size_t parsedCharacters = 0;
    const float value = std::stof(text, &parsedCharacters);
    if (parsedCharacters != text.size()) {
        throw std::invalid_argument(std::string(name) + " is not a valid float");
    }
    return value;
}

void PrintUsage(const char* program)
{
    std::cerr << "Usage: " << program << "\n   or: " << program
              << " <float32|float16> <length> <alpha> <scale> <input_scale> <input.bin> <golden.bin>" << std::endl;
}

} // namespace

std::vector<float> kernel_elu(std::vector<float>& x, float alpha, float scale, float inputScale)
{
    if (x.size() > std::numeric_limits<uint32_t>::max()) {
        throw std::length_error("ELU element count exceeds uint32_t");
    }
    if (x.empty()) {
        return {};
    }

    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    const LaunchPlan plan = MakeLaunchPlan(totalLength, FLOAT_SMALL_INPUT, MAX_BLOCKS, 32 / sizeof(float));
    AclSession session;
    DeviceBuffer<float> xDevice(x.size());
    DeviceBuffer<float> yDevice(x.size());
    CopyInputToDevice(x, xDevice);

    elu_custom<<<plan.blockCount, 0>>>(
        xDevice.Get(), yDevice.Get(), alpha, scale, inputScale, totalLength, plan.blockLength);
    ACL_CHECK(aclrtSynchronizeDevice());

    std::vector<float> y(x.size());
    CopyOutputToHost(yDevice, y);
    return y;
}

std::vector<half> kernel_elu(std::vector<half>& x, float alpha, float scale, float inputScale)
{
    if (x.size() > std::numeric_limits<uint32_t>::max()) {
        throw std::length_error("ELU element count exceeds uint32_t");
    }
    if (x.empty()) {
        return {};
    }

    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    const LaunchPlan plan = MakeLaunchPlan(totalLength, HALF_SMALL_INPUT, MAX_BLOCKS, 32 / sizeof(half));
    AclSession session;
    DeviceBuffer<half> xDevice(x.size());
    DeviceBuffer<half> yDevice(x.size());
    CopyInputToDevice(x, xDevice);

    elu_custom_half<<<plan.blockCount, 0>>>(
        xDevice.Get(), yDevice.Get(), alpha, scale, inputScale, totalLength, plan.blockLength);
    ACL_CHECK(aclrtSynchronizeDevice());

    std::vector<half> y(x.size());
    CopyOutputToHost(yDevice, y);
    return y;
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 1 && argc != 8) {
        PrintUsage(argv[0]);
        return 2;
    }

    try {
        const bool useDefaults = argc == 1;
        std::string dtype = useDefaults ? "float32" : argv[1];
        if (dtype == "float") {
            dtype = "float32";
        } else if (dtype == "half") {
            dtype = "float16";
        }

        const uint32_t totalLength = useDefaults ? 2048 : ParseLength(argv[2]);
        const float alpha = useDefaults ? 1.0f : ParseFloat(argv[3], "alpha");
        const float scale = useDefaults ? 1.0f : ParseFloat(argv[4], "scale");
        const float inputScale = useDefaults ? 1.0f : ParseFloat(argv[5], "input_scale");
        const std::string inputPath = useDefaults ? "input/input_x.bin" : argv[6];
        const std::string goldenPath = useDefaults ? "output/golden.bin" : argv[7];
        std::vector<float> golden(totalLength);
        if (!ReadVectorExact(goldenPath, golden)) {
            return 1;
        }

        if (dtype == "float32") {
            std::vector<float> input(totalLength);
            if (!ReadVectorExact(inputPath, input)) {
                return 1;
            }
            const std::vector<float> output = kernel_elu(input, alpha, scale, inputScale);
            return VerifyResult(output, golden, dtype) ? 0 : 1;
        }
        if (dtype == "float16") {
            std::vector<half> input(totalLength);
            if (!ReadVectorExact(inputPath, input)) {
                return 1;
            }
            const std::vector<half> output = kernel_elu(input, alpha, scale, inputScale);
            return VerifyResult(output, golden, dtype) ? 0 : 1;
        }

        throw std::invalid_argument("dtype must be float32 or float16");
    } catch (const std::exception& error) {
        std::cerr << "[ERROR] " << error.what() << std::endl;
        return 1;
    }
}
