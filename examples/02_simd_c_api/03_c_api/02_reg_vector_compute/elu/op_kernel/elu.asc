/* !
 * \file elu.asc
 * \brief 使用 Ascend C C API 实现 ELU（Exponential Linear Unit）激活函数
 *        数学公式:
 *          ELU(x) = scale * x,                     if x > 0
 *          ELU(x) = alpha * scale * (exp(x * inputScale) - 1),  if x <= 0
 *        架构: dav-3510（Ascend 950PR）
 *        范式: C API 寄存器指令（asc_*）
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <cmath>
#include <limits>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

// TOTAL_LENGTH 为 __ubuf__ 数组编译时最大分配长度
// 实际数据长度由核函数 totalLen 参数从 Host 侧传入，支持动态长度
constexpr uint32_t TOTAL_LENGTH = 256;
constexpr uint32_t MAX_BLOCK_LENGTH = 256;
constexpr uint32_t BLK_NUM = 1;

// 128 字节对齐
constexpr uint32_t HALF_TOTAL_LENGTH = 512;
constexpr uint32_t HALF_MAX_BLOCK_LENGTH = 512;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void elu_vf(
    __ubuf__ float* x_local, __ubuf__ float* y_local,
    float alpha, float scale, float input_scale,
    uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask;
    vector_bool cmp_mask;
    vector_float src_reg;
    vector_float pos_reg;      // scale * x
    vector_float tmp_reg;      // x * inputScale
    vector_float exp_reg;      // exp(x * inputScale)
    vector_float neg_reg;      // alpha * scale * (exp(...) - 1)
    vector_float scaled_reg;   // 独立寄存器，避免别名风险
    vector_float dst_reg;

    // 预计算 alpha * scale
    float alpha_scale = alpha * scale;

    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);

        // 加载源数据
        asc_loadalign(src_reg, x_local + i * one_rep_size);

        // 正值分支：pos = scale * x
        asc_mul_scalar(pos_reg, src_reg, scale, vmask);

        // 负值分支计算链：
        // 1. tmp = x * inputScale
        asc_mul_scalar(tmp_reg, src_reg, input_scale, vmask);
        // 2. exp(tmp)
        asc_exp(exp_reg, tmp_reg, vmask);
        // 3. exp - 1
        asc_add_scalar(neg_reg, exp_reg, -1.0f, vmask);
        // 4. * (alpha * scale)，使用独立寄存器避免别名风险
        asc_mul_scalar(scaled_reg, neg_reg, alpha_scale, vmask);

        // 分支选择：x > 0 选 pos，否则选 neg
        asc_gt_scalar(cmp_mask, src_reg, 0.0f, vmask);
        asc_select(dst_reg, pos_reg, scaled_reg, cmp_mask);

        // 写回结果
        asc_storealign(y_local + i * one_rep_size, dst_reg, vmask);
    }
}

__vector__ __global__ void elu_custom(
    __gm__ float* src, __gm__ float* dst,
    uint32_t totalLen,
    float alpha, float scale, float input_scale)
{
    asc_init();

    uint32_t block_length = totalLen / block_num;
    uint32_t remaining = totalLen - block_idx * block_length;
    block_length = (remaining < block_length) ? remaining : block_length;

    __gm__ float* src_gm = src + block_idx * block_length;
    __gm__ float* dst_gm = dst + block_idx * block_length;

    __ubuf__ float src_local[MAX_BLOCK_LENGTH];
    __ubuf__ float dst_local[MAX_BLOCK_LENGTH];

    uint32_t burst_length = block_length * sizeof(float);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    // 搬运 GM → UB
    asc_copy_gm2ub_align((__ubuf__ float*)src_local, src_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    // 计算
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);
    elu_vf(
        (__ubuf__ float*)src_local, (__ubuf__ float*)dst_local,
        alpha, scale, input_scale,
        block_length, one_rep_size, repeat_time);

    // 同步 V → MTE3
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    // 搬运 UB → GM
    asc_copy_ub2gm_align(
        dst_gm, (__ubuf__ float*)dst_local, BLK_NUM, burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

__simd_vf__ inline void elu_vf_fp16(
    __ubuf__ half* x_local, __ubuf__ half* y_local,
    float alpha, float scale, float input_scale,
    uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask;
    vector_bool cmp_mask;
    vector_half src_reg;
    vector_half pos_reg;
    vector_half tmp_reg;
    vector_half exp_reg;
    vector_half neg_reg;
    vector_half scaled_reg;
    vector_half dst_reg;

    half alpha_scale = (half)(alpha * scale);

    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b16(data_len);

        asc_loadalign(src_reg, x_local + i * one_rep_size);

        // pos = scale * x
        asc_mul_scalar(pos_reg, src_reg, (half)scale, vmask);

        // neg 分支：x * inputScale -> exp() -> -1 -> * alpha_scale
        asc_mul_scalar(tmp_reg, src_reg, (half)input_scale, vmask);
        asc_exp(exp_reg, tmp_reg, vmask);
        asc_add_scalar(neg_reg, exp_reg, (half)(-1.0f), vmask);
        asc_mul_scalar(scaled_reg, neg_reg, alpha_scale, vmask);

        // x > 0 选 pos，否则选 neg
        asc_gt_scalar(cmp_mask, src_reg, (half)(0.0f), vmask);
        asc_select(dst_reg, pos_reg, scaled_reg, cmp_mask);

        asc_storealign(y_local + i * one_rep_size, dst_reg, vmask);
    }
}

__vector__ __global__ void elu_custom_fp16(
    __gm__ half* src, __gm__ half* dst,
    uint32_t totalLen,
    float alpha, float scale, float input_scale)
{
    asc_init();

    uint32_t block_length = totalLen / block_num;
    uint32_t remaining = totalLen - block_idx * block_length;
    block_length = (remaining < block_length) ? remaining : block_length;

    __gm__ half* src_gm = src + block_idx * block_length;
    __gm__ half* dst_gm = dst + block_idx * block_length;

    __ubuf__ half src_local[HALF_MAX_BLOCK_LENGTH];
    __ubuf__ half dst_local[HALF_MAX_BLOCK_LENGTH];

    uint32_t burst_length = block_length * sizeof(half);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    // 搬运 GM → UB
    asc_copy_gm2ub_align((__ubuf__ half*)src_local, src_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    // 计算
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(half);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);
    elu_vf_fp16(
        (__ubuf__ half*)src_local, (__ubuf__ half*)dst_local,
        alpha, scale, input_scale,
        block_length, one_rep_size, repeat_time);

    // 同步 V → MTE3
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    // 搬运 UB → GM
    asc_copy_ub2gm_align(
        dst_gm, (__ubuf__ half*)dst_local, BLK_NUM, burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

std::vector<float> kernel_elu(
    std::vector<float>& x,
    float alpha, float scale, float input_scale)
{
    constexpr uint32_t num_blocks = 1;
    uint32_t total_length = x.size();
    size_t total_byte_size = total_length * sizeof(float);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), total_byte_size);
    aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    elu_custom<<<num_blocks, 0>>>(x_device, y_device, total_length, alpha, scale, input_scale);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, total_byte_size, (uint8_t*)y_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> y((float*)y_host, (float*)(y_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return y;
}

std::vector<half> kernel_elu_fp16(
    std::vector<half>& x,
    float alpha, float scale, float input_scale)
{
    constexpr uint32_t num_blocks = 1;
    uint32_t total_length = x.size();
    size_t total_byte_size = total_length * sizeof(half);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    half* x_device = nullptr;
    half* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), total_byte_size);
    aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    elu_custom_fp16<<<num_blocks, 0>>>(x_device, y_device, total_length, alpha, scale, input_scale);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, total_byte_size, (uint8_t*)y_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> y((half*)y_host, (half*)(y_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return y;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    constexpr float EPS = 1e-4f;
    uint32_t fail_count = 0;
    for (size_t i = 0; i < output.size(); ++i) {
        float a = output[i];
        float b = golden[i];
        // 跳过 NaN（NaN != NaN，但两边都是 NaN 就算通过）
        // 若仅一侧为 NaN 则计为不匹配
        if (std::isnan(a) != std::isnan(b)) { fail_count++; continue; }
        if (std::isnan(a) && std::isnan(b)) continue;
        float abs_err = std::fabs(a - b);
        float rel_err = abs_err / std::fmax(std::fabs(b), 1.0f);
        if (abs_err > EPS && rel_err > EPS) {
            if (fail_count < 5) {
                std::cout << "  Mismatch[" << i << "]: output=" << a << " golden=" << b
                          << " abs_err=" << abs_err << " rel_err=" << rel_err << std::endl;
            }
            fail_count++;
        }
    }
    if (fail_count == 0) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail! " << fail_count << " mismatches" << std::endl;
        return 1;
    }
}

float elu_golden(float x, float alpha, float scale, float input_scale)
{
    if (x > 0.0f) {
        return scale * x;
    } else {
        return alpha * scale * (std::exp(x * input_scale) - 1.0f);
    }
}

half elu_golden_fp16(half x, float alpha, float scale, float input_scale)
{
    if (x > (half)(0.0f)) {
        return scale * x;
    } else {
        return alpha * scale * (std::exp((float)(x * input_scale)) - 1.0f);
    }
}

uint32_t verify_result_fp16(std::vector<half>& output, std::vector<half>& golden)
{
    constexpr float EPS = 1e-2f;
    uint32_t fail_count = 0;
    for (size_t i = 0; i < output.size(); ++i) {
        float a = (float)output[i];
        float b = (float)golden[i];
        if (std::isnan(a) != std::isnan(b)) { fail_count++; continue; }
        if (std::isnan(a) && std::isnan(b)) continue;
        float abs_err = std::fabs(a - b);
        float rel_err = abs_err / std::fmax(std::fabs(b), 1.0f);
        if (abs_err > EPS && rel_err > EPS) {
            if (fail_count < 5) {
                std::cout << "  Mismatch[" << i << "]: output=" << a << " golden=" << b
                          << " abs_err=" << abs_err << " rel_err=" << rel_err << std::endl;
            }
            fail_count++;
        }
    }
    if (fail_count == 0) {
        std::cout << "fp16 test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "fp16 test fail! " << fail_count << " mismatches" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    float alpha = 1.0f;
    float scale = 1.0f;
    float input_scale = 1.0f;

    std::vector<float> x(total_length);
    std::vector<float> golden(total_length);

    // 生成测试数据：[-100, 100] 均匀分布
    for (uint32_t i = 0; i < total_length; ++i) {
        x[i] = -100.0f + (200.0f * i) / (total_length - 1);
        golden[i] = elu_golden(x[i], alpha, scale, input_scale);
    }

    // 追加边界值测试（NaN, Inf, 0）
    x[0] = 0.0f; golden[0] = elu_golden(0.0f, alpha, scale, input_scale);
    x[1] = std::numeric_limits<float>::infinity(); golden[1] = elu_golden(x[1], alpha, scale, input_scale);
    x[2] = -std::numeric_limits<float>::infinity(); golden[2] = elu_golden(x[2], alpha, scale, input_scale);
    x[3] = std::nanf(""); golden[3] = elu_golden(x[3], alpha, scale, input_scale);

    std::vector<float> output = kernel_elu(x, alpha, scale, input_scale);
    uint32_t fp32_fail = verify_result(output, golden);

    // ========== fp16 测试 ==========
    constexpr uint32_t half_total_length = HALF_TOTAL_LENGTH;

    std::vector<half> x_half(half_total_length);
    std::vector<half> golden_half(half_total_length);

    for (uint32_t i = 0; i < half_total_length; ++i) {
        float v = -100.0f + (200.0f * i) / (half_total_length - 1);
        x_half[i] = (half)v;
        golden_half[i] = elu_golden_fp16(x_half[i], alpha, scale, input_scale);
    }

    // 边界值测试
    x_half[0] = (half)0.0f; golden_half[0] = elu_golden_fp16(x_half[0], alpha, scale, input_scale);
    x_half[1] = (half)std::numeric_limits<float>::infinity(); golden_half[1] = elu_golden_fp16(x_half[1], alpha, scale, input_scale);
    x_half[2] = (half)(-std::numeric_limits<float>::infinity()); golden_half[2] = elu_golden_fp16(x_half[2], alpha, scale, input_scale);
    x_half[3] = (half)std::nanf(""); golden_half[3] = elu_golden_fp16(x_half[3], alpha, scale, input_scale);

    std::vector<half> output_half = kernel_elu_fp16(x_half, alpha, scale, input_scale);
    uint32_t fp16_fail = verify_result_fp16(output_half, golden_half);

    return fp32_fail + fp16_fail;
}