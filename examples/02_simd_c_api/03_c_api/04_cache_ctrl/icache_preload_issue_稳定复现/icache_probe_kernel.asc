/* !
 * \file icache_probe_kernel.asc
 * \brief First-stage kernels for the ICache preload issue reproducer.
 */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/utils/sys_var.h"

namespace {
constexpr int64_t INVALID_PREFETCH_LENGTH = 8;
}

extern "C" __global__ __vector__ void icache_probe_without_preload(__gm__ float* x, int64_t n)
{
    for (int64_t i = 0; i < n; ++i) {
        x[i] = x[i] + 1.0F;
    }
}

extern "C" __global__ __vector__ void icache_probe_with_preload(__gm__ float* x, int64_t n)
{
    int64_t pc = asc_get_program_counter() & 0xFFFFFFFFFFFF;
    asc_icache_preload(reinterpret_cast<void*>(pc), INVALID_PREFETCH_LENGTH);
    for (int64_t i = 0; i < n; ++i) {
        x[i] = x[i] + 1.0F;
    }
}

extern "C" void run_icache_probe_without_preload(float* x, int64_t n, aclrtStream stream)
{
    icache_probe_without_preload<<<1, 0, stream>>>(x, n);
}

extern "C" void run_icache_probe_with_preload(float* x, int64_t n, aclrtStream stream)
{
    icache_probe_with_preload<<<1, 0, stream>>>(x, n);
}
