/* !
 * \file unrelated_probe_kernel.asc
 * \brief Independently loaded second-stage kernel for the ICache preload issue reproducer.
 */

#include <cstdint>

#include "acl/acl.h"

extern "C" __global__ __vector__ void unrelated_probe(__gm__ uint8_t* output, int64_t n)
{
    for (int64_t i = 0; i < n; ++i) {
        output[i] = 1;
    }
}

extern "C" void run_unrelated_probe(uint8_t* output, int64_t n, aclrtStream stream)
{
    unrelated_probe<<<1, 0, stream>>>(output, n);
}
