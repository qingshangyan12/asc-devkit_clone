#include <array>
#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/reg_compute/compute/reg_broadcast.h"
#include "c_api/reg_compute/compute/reg_mask.h"
#include "c_api/reg_compute/store/storealign.h"
#include "c_api/scalar_compute/scalar_store.h"
#include "c_api/spr/spr.h"
#include "c_api/sync/sync.h"
#include "c_api/utils/sys_init.h"

constexpr uint32_t ELEMENTS_PER_VECTOR = 64;
constexpr uint32_t SECOND_LINE_OFFSET = 32;
constexpr uint32_t OUTPUT_COUNT = 8;
constexpr uint32_t MODE_COUNT = 2;
constexpr uint32_t TOTAL_OUTPUT_COUNT = MODE_COUNT * OUTPUT_COUNT;
constexpr size_t OUTPUT_BYTES = TOTAL_OUTPUT_COUNT * sizeof(int32_t);
constexpr uint64_t CTRL_UB_DCACHE_MASK = 1ULL << 49;
constexpr int32_t OLD_VALUE = 11;
constexpr int32_t NEW_VALUE = 101;
constexpr int32_t OUTPUT_SENTINEL = -1;
constexpr uint32_t WITHOUT_VOLATILE = 0;
constexpr uint32_t WITH_VOLATILE = 1;

enum OutputIndex : uint32_t {
    ORIGINAL_CTRL_BIT = 0,
    CTRL_BIT,
    WARM_LINE0,
    WARM_LINE1,
    BEFORE_LINE0,
    BEFORE_LINE1,
    AFTER_LINE0,
    AFTER_LINE1
};

__simd_vf__ inline void fill_ub(__ubuf__ int32_t* dst, int32_t value)
{
    vector_int32_t data;
    uint32_t count = ELEMENTS_PER_VECTOR;
    vector_bool mask = asc_update_mask_b32(count);
    asc_duplicate_scalar(data, value, mask);
    asc_storealign(dst, data, mask);
}

/*
 * 本样例用于验证精简写法是否仍能正确测试asc_dcci_entire_ub。与原样例相比，本样例使用
 * 隐式整数转换，并省略输出阶段的两个DSB_ALL；实测这两项不会改变当前验证结果。
 * Host分别传入0和1启动两次Kernel，由useVolatile参数选择普通指针或volatile指针读取路径，
 * 直接对比volatile对重复Scalar读取的影响。该volatile修饰属于测试观测手段，并非调用
 * asc_dcci_entire_ub的一般要求。
 * Vector写UB后的V->S同步和DCCI后的DSB_UB必须保留，分别用于保证跨流水依赖和等待
 * UB范围内的Cache刷新操作完成。
 */
__vector__ __global__ void dcci_entire_ub_simplified_kernel(__gm__ int32_t* output, uint32_t useVolatile)
{
    asc_init();

    __ubuf__ int32_t data[ELEMENTS_PER_VECTOR];
    fill_ub(data, OLD_VALUE);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    // 原样例使用static_cast将asc_get_ctrl返回的int64_t显式转换为uint64_t。
    // 本样例省略该转换，由赋值执行隐式转换；转换后的寄存器位模式不变，
    // 后续可直接进行无符号移位和掩码运算。
    const uint64_t originalCtrl = asc_get_ctrl();
    // 原样例使用static_cast显式缩窄为int32_t。表达式已通过1ULL掩码
    // 限制为0或1，隐式缩窄安全。
    const int32_t originalCtrlBit = (originalCtrl >> 49) & 1ULL;
    const uint64_t cacheableCtrl = originalCtrl | CTRL_UB_DCACHE_MASK;
    asc_set_ctrl(cacheableCtrl);
    // 与originalCtrl相同，此处省略int64_t到uint64_t的显式static_cast，使用等价的隐式转换。
    const uint64_t enabledCtrl = asc_get_ctrl();

    // volatile是编译期类型限定，运行时参数不能动态改变同一个指针的类型。因此同时定义
    // 普通指针和volatile指针，再由useVolatile选择实际读取路径。传入0使用普通指针，
    // 传入1使用volatile指针。这里只增加volatile限定，可使用隐式限定转换，无需
    // reinterpret_cast。
    __ubuf__ int32_t* normalData = data;
    __ubuf__ volatile int32_t* volatileData = data;
    int32_t warm0;
    int32_t warm1;
    if (useVolatile == WITH_VOLATILE) {
        warm0 = volatileData[0];
        warm1 = volatileData[SECOND_LINE_OFFSET];
    } else {
        warm0 = normalData[0];
        warm1 = normalData[SECOND_LINE_OFFSET];
    }

    fill_ub(data, NEW_VALUE);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    int32_t before0;
    int32_t before1;
    if (useVolatile == WITH_VOLATILE) {
        before0 = volatileData[0];
        before1 = volatileData[SECOND_LINE_OFFSET];
    } else {
        before0 = normalData[0];
        before1 = normalData[SECOND_LINE_OFFSET];
    }

    asc_dcci_entire_ub();
    asc_sync_data_barrier(mem_dsb_t::DSB_UB);

    int32_t after0;
    int32_t after1;
    if (useVolatile == WITH_VOLATILE) {
        after0 = volatileData[0];
        after1 = volatileData[SECOND_LINE_OFFSET];
    } else {
        after0 = normalData[0];
        after1 = normalData[SECOND_LINE_OFFSET];
    }
    asc_set_ctrl(originalCtrl);

    // 原样例在此调用第一个DSB_ALL。本样例将其省略，因为前面的
    // DSB_UB已经完成UB访问依赖，
    // 后续操作写入独立的GM输出缓冲区，不依赖此处额外的全范围屏障。
    asc_store_dev(output + ORIGINAL_CTRL_BIT, originalCtrlBit);
    // 原样例使用static_cast将CTRL[49]写出为int32_t。掩码结果仅为0或1，可安全使用隐式转换。
    asc_store_dev(output + CTRL_BIT, (enabledCtrl >> 49) & 1ULL);
    asc_store_dev(output + WARM_LINE0, warm0);
    asc_store_dev(output + WARM_LINE1, warm1);
    asc_store_dev(output + BEFORE_LINE0, before0);
    asc_store_dev(output + BEFORE_LINE1, before1);
    asc_store_dev(output + AFTER_LINE0, after0);
    asc_store_dev(output + AFTER_LINE1, after1);
    // 原样例在此调用第二个DSB_ALL，显式等待上述GM写完成。本样例省略
    // 该屏障，并由Host侧的aclrtSynchronizeDevice等待核函数结束后再回读结果。
    // 该省略只适用于当前验证流程；如果后续Device侧指令依赖这些GM写入结果，
    // 仍需按实际内存依赖使用相应的同步接口。
}

bool check_acl(const char* operation, aclError result)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << operation << " failed, error code: " << result << std::endl;
    return false;
}

int run_kernel(std::array<int32_t, TOTAL_OUTPUT_COUNT>& output)
{
    constexpr int32_t deviceId = 0;
    int32_t* outputDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int result = 0;

    if (!check_acl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    aclInitialized = true;

    if (!check_acl("aclrtSetDevice", aclrtSetDevice(deviceId))) {
        result = 1;
        goto cleanup;
    }
    deviceSet = true;

    if (!check_acl("aclrtMalloc", aclrtMalloc(reinterpret_cast<void**>(&outputDevice), OUTPUT_BYTES,
            ACL_MEM_MALLOC_HUGE_FIRST))) {
        result = 1;
        goto cleanup;
    }

    output.fill(OUTPUT_SENTINEL);
    if (!check_acl("aclrtMemcpy(H2D)", aclrtMemcpy(outputDevice, OUTPUT_BYTES, output.data(), OUTPUT_BYTES,
            ACL_MEMCPY_HOST_TO_DEVICE))) {
        result = 1;
        goto cleanup;
    }

    // 一次程序执行中连续运行两个对照Kernel，并将结果写入不同的GM区域。
    dcci_entire_ub_simplified_kernel<<<1, 0>>>(outputDevice, WITHOUT_VOLATILE);
    dcci_entire_ub_simplified_kernel<<<1, 0>>>(outputDevice + OUTPUT_COUNT, WITH_VOLATILE);
    if (!check_acl("aclrtSynchronizeDevice", aclrtSynchronizeDevice())) {
        const char* message = aclGetRecentErrMsg();
        if (message != nullptr) {
            std::cerr << "recent ACL error: " << message << std::endl;
        }
        result = 1;
        goto cleanup;
    }

    if (!check_acl("aclrtMemcpy(D2H)", aclrtMemcpy(output.data(), OUTPUT_BYTES, outputDevice, OUTPUT_BYTES,
            ACL_MEMCPY_DEVICE_TO_HOST))) {
        result = 1;
    }

cleanup:
    if (outputDevice != nullptr && !check_acl("aclrtFree", aclrtFree(outputDevice))) {
        result = 1;
    }
    if (deviceSet && !check_acl("aclrtResetDevice", aclrtResetDevice(deviceId))) {
        result = 1;
    }
    if (aclInitialized && !check_acl("aclFinalize", aclFinalize())) {
        result = 1;
    }
    return result;
}

int main()
{
    const std::array<const char*, OUTPUT_COUNT> names = {
        "original_ctrl_bit49", "enabled_ctrl_bit49", "warm_line0", "warm_line1", "before_line0", "before_line1",
        "after_line0", "after_line1"
    };
    const std::array<int32_t, TOTAL_OUTPUT_COUNT> expected = {
        0, 1, OLD_VALUE, OLD_VALUE, OLD_VALUE, OLD_VALUE, OLD_VALUE, OLD_VALUE,
        0, 1, OLD_VALUE, OLD_VALUE, OLD_VALUE, OLD_VALUE, NEW_VALUE, NEW_VALUE
    };
    std::array<int32_t, TOTAL_OUTPUT_COUNT> output = {};

    if (run_kernel(output) != 0) {
        std::cout << "test failed!" << std::endl;
        return 1;
    }

    bool passed = true;
    for (uint32_t mode = 0; mode < MODE_COUNT; ++mode) {
        std::cout << "use_volatile=" << mode << std::endl;
        const uint32_t outputOffset = mode * OUTPUT_COUNT;
        for (uint32_t i = 0; i < OUTPUT_COUNT; ++i) {
            const uint32_t index = outputOffset + i;
            std::cout << names[i] << ": actual=" << output[index] << ", expected=" << expected[index] << std::endl;
            passed = passed && (output[index] == expected[index]);
        }
    }

    std::cout << (passed ? "test pass!" : "test failed!") << std::endl;
    return passed ? 0 : 1;
}
