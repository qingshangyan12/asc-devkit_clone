#include <array>
#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/cache_ctrl/cache_ctrl.h"
#include "c_api/reg_compute/compute/reg_broadcast.h"
#include "c_api/reg_compute/compute/reg_mask.h"
#include "c_api/reg_compute/store/storealign.h"
#include "c_api/scalar_compute/scalar_store.h"
#include "c_api/spr/spr.h"
#include "c_api/sync/sync.h"
#include "c_api/utils/sys_init.h"

// 一个b32向量包含64个int32_t元素，因此fill_ub可通过一次Vector操作写入256字节的UB区域。
constexpr uint32_t ELEMENTS_PER_VECTOR = 64;
// 第32个元素与第0个元素相隔128字节，因此两个观测点位于不同的64字节DCache Line中，
// 同时仍处于同一次Vector操作写入的区域内。
constexpr uint32_t SECOND_LINE_OFFSET = 32;
constexpr uint32_t OUTPUT_COUNT = 8;
constexpr size_t OUTPUT_BYTES = OUTPUT_COUNT * sizeof(int32_t);
constexpr uint64_t CTRL_UB_DCACHE_MASK = 1ULL << 49;
constexpr int32_t OLD_VALUE = 11;
constexpr int32_t NEW_VALUE = 101;
constexpr int32_t OUTPUT_SENTINEL = -1;

enum OutputIndex : uint32_t {
    ORIGINAL_CTRL_BIT = 0,
    CTRL_BIT,
    WARM_LINE0,
    WARM_LINE1,
    BEFORE_LINE0,
    BEFORE_LINE1,
    AFTER_LINE0,
    AFTER_LINE1
};

__simd_vf__ inline void fill_ub(__ubuf__ int32_t* dst, int32_t value)
{
    vector_int32_t data;
    uint32_t count = ELEMENTS_PER_VECTOR;
    // 生成完整的b32掩码，将value广播到Vector寄存器，并向UB写入全部256字节。
    vector_bool mask = asc_update_mask_b32(count);
    asc_duplicate_scalar(data, value, mask);
    asc_storealign(dst, data, mask);
}

__vector__ __global__ void dcci_entire_ub_kernel(__gm__ int32_t* output)
{
    // 调用Device侧C API前，先初始化C API运行时状态。
    asc_init();

    __ubuf__ int32_t data[ELEMENTS_PER_VECTOR];
    // 通过Vector流水设置UB初始值。V->S事件保证异步Vector写完成后，才执行后续Scalar读。
    fill_ub(data, OLD_VALUE);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    // asc_get_ctrl返回int64_t，而本样例将CTRL作为64位位域处理。转换为uint64_t后，
    // 右移和掩码运算具有明确的无符号语义，同时保持寄存器位模式不变。
    // 精简对照样例已验证隐式转换同样有效；此处保留static_cast是为了明确表达目标类型，
    // 并非接口调用的强制要求。
    const uint64_t originalCtrl = static_cast<uint64_t>(asc_get_ctrl());
    // 使用1ULL掩码后结果只可能为0或1，因此缩窄为int32_t是安全的。static_cast用于明确表示
    // 这是有意的缩窄转换；改为对应的隐式转换不会改变本样例的验证结果。
    const int32_t originalCtrlBit = static_cast<int32_t>((originalCtrl >> 49) & 1ULL);
    const uint64_t cacheableCtrl = originalCtrl | CTRL_UB_DCACHE_MASK;
    // CTRL[49]=1使后续Scalar UB读经过DCache。此处回读CTRL寄存器，而不是直接假定设置成功，
    // 从而通过输出结果证明Cacheable模式已经实际生效。
    asc_set_ctrl(cacheableCtrl);
    const uint64_t enabledCtrl = static_cast<uint64_t>(asc_get_ctrl());

    // C++ volatile说明：
    // 1. 在“volatile int32_t*”中，volatile修饰指针所指向的int32_t对象，
    //    并不修饰volatileData指针本身。通过该指针进行的每次读取都是volatile访问，
    //    对编译器而言属于可观测副作用。编译器必须保留这些读取，不能使用先前读取后
    //    暂存在寄存器中的值替代后续读取。
    // 2. volatile只约束编译器对volatile限定左值访问的优化。它不能使访问具备原子性，
    //    不能建立C++线程间的happens-before关系，也不能同步Vector与Scalar流水或刷新DCache。
    //    V->S事件、asc_dcci_entire_ub和DSB_UB分别提供本样例所需的硬件流水同步与
    //    Cache管理能力。
    // 3. 本样例需要在Vector流水写入和DCCI操作前后重复读取相同UB地址。
    //    这些变化不是通过volatileData执行的普通Scalar C++写操作。若不使用volatile，
    //    编译器可能复用先前的Scalar读取结果。对照测试中，删除volatile后仍可编译，
    //    但after0和after1始终为11；
    //    恢复volatile后，DCCI后的两次读取才能观测到101。
    // 4. 调用asc_dcci_entire_ub本身不要求使用volatile。本样例使用它，只是为了可靠观测由Scalar
    //    C++数据流以外的机制修改的存储内容。
    // reinterpret_cast用于显式构造带volatile限定的指针。该转换仅给所指向类型
    // 增加volatile限定，
    // 因而也可使用隐式限定转换，精简样例已经验证这种写法有效。
    __ubuf__ volatile int32_t* volatileData = reinterpret_cast<__ubuf__ volatile int32_t*>(data);
    // 通过Scalar读取OLD_VALUE，将两个观测点所在的DCache Line预热。
    const int32_t warm0 = volatileData[0];
    const int32_t warm1 = volatileData[SECOND_LINE_OFFSET];

    // 通过Vector流水将底层UB更新为NEW_VALUE，并等待写入完成后再由Scalar流水观测。
    fill_ub(data, NEW_VALUE);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    // 调用DCCI前，两次Cacheable Scalar读必须仍从DCache读到OLD_VALUE。如果任一读取返回
    // NEW_VALUE，说明样例没有建立Cache旧值场景，无法验证接口功能。
    const int32_t before0 = volatileData[0];
    const int32_t before1 = volatileData[SECOND_LINE_OFFSET];

    // 失效UB对应的DCache条目。根据接口约束，必须调用DSB_UB等待UB范围内的Cache操作完成，
    // 然后才能执行依赖刷新结果的Scalar读。
    asc_dcci_entire_ub();
    asc_sync_data_barrier(mem_dsb_t::DSB_UB);

    // 失效DCache条目后，这两次读取必须发生Cache Miss并从UB取得NEW_VALUE。
    // 随后恢复CTRL的全部位，避免样例退出时保留修改后的控制状态。
    const int32_t after0 = volatileData[0];
    const int32_t after1 = volatileData[SECOND_LINE_OFFSET];
    asc_set_ctrl(originalCtrl);

    // 对当前数据流而言，此处的DSB_ALL较为保守且可以省略：DSB_UB已经完成UB访问依赖，
    // 后续写入的是独立的GM输出缓冲区。精简对照样例删除该屏障后仍能通过验证；
    // 此处保留它，用作Cache观测与结果上报之间的显式边界。
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
    asc_store_dev(output + ORIGINAL_CTRL_BIT, originalCtrlBit);
    // enabledCtrl为uint64_t，而该输出指针对应的asc_store_dev入参为int32_t。
    // 掩码将结果限制为0或1，static_cast用于明确表达安全的缩窄转换；
    // 精简对照样例使用隐式转换也能得到相同结果。
    asc_store_dev(output + CTRL_BIT, static_cast<int32_t>((enabledCtrl >> 49) & 1ULL));
    asc_store_dev(output + WARM_LINE0, warm0);
    asc_store_dev(output + WARM_LINE1, warm1);
    asc_store_dev(output + BEFORE_LINE0, before0);
    asc_store_dev(output + BEFORE_LINE1, before1);
    asc_store_dev(output + AFTER_LINE0, after0);
    asc_store_dev(output + AFTER_LINE1, after1);
    // asc_store_dev发起绕过DCache的Scalar GM写。DSB_ALL在核函数退出前显式等待这些写操作完成。
    // 当Host等待核函数完成后再读取结果时，精简样例删除该屏障也能通过；
    // 但如果后续Device侧指令依赖这些GM写入结果，则不能据此省略所需的同步。
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
}

bool check_acl(const char* operation, aclError result)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << operation << " failed, error code: " << result << std::endl;
    return false;
}

int run_kernel(std::array<int32_t, OUTPUT_COUNT>& output)
{
    constexpr int32_t deviceId = 0;
    int32_t* outputDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;
    int result = 0;

    // 初始化ACL运行时，并为8项观测结果分配一个GM缓冲区。
    if (!check_acl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    aclInitialized = true;

    if (!check_acl("aclrtSetDevice", aclrtSetDevice(deviceId))) {
        result = 1;
        goto cleanup;
    }
    deviceSet = true;

    if (!check_acl("aclrtMalloc", aclrtMalloc(reinterpret_cast<void**>(&outputDevice), OUTPUT_BYTES,
            ACL_MEM_MALLOC_HUGE_FIRST))) {
        result = 1;
        goto cleanup;
    }

    // 使用哨兵值初始化GM，避免Device侧漏写时缓冲区原值恰好满足预期。
    output.fill(OUTPUT_SENTINEL);
    if (!check_acl("aclrtMemcpy(H2D)", aclrtMemcpy(outputDevice, OUTPUT_BYTES, output.data(), OUTPUT_BYTES,
            ACL_MEMCPY_HOST_TO_DEVICE))) {
        result = 1;
        goto cleanup;
    }

    // 本样例验证单核内部的UB与DCache一致性，因此启动一个Vector Core即可。
    dcci_entire_ub_kernel<<<1, 0>>>(outputDevice);
    if (!check_acl("aclrtSynchronizeDevice", aclrtSynchronizeDevice())) {
        const char* message = aclGetRecentErrMsg();
        if (message != nullptr) {
            std::cerr << "recent ACL error: " << message << std::endl;
        }
        result = 1;
        goto cleanup;
    }

    if (!check_acl("aclrtMemcpy(D2H)", aclrtMemcpy(output.data(), OUTPUT_BYTES, outputDevice, OUTPUT_BYTES,
            ACL_MEMCPY_DEVICE_TO_HOST))) {
        result = 1;
    }

cleanup:
    if (outputDevice != nullptr && !check_acl("aclrtFree", aclrtFree(outputDevice))) {
        result = 1;
    }
    if (deviceSet && !check_acl("aclrtResetDevice", aclrtResetDevice(deviceId))) {
        result = 1;
    }
    if (aclInitialized && !check_acl("aclFinalize", aclFinalize())) {
        result = 1;
    }
    return result;
}

int main()
{
    const std::array<const char*, OUTPUT_COUNT> names = {
        "original_ctrl_bit49", "enabled_ctrl_bit49", "warm_line0", "warm_line1", "before_line0", "before_line1",
        "after_line0", "after_line1"
    };
    const std::array<int32_t, OUTPUT_COUNT> expected = {
        0, 1, OLD_VALUE, OLD_VALUE, OLD_VALUE, OLD_VALUE, NEW_VALUE, NEW_VALUE
    };
    std::array<int32_t, OUTPUT_COUNT> output = {};

    if (run_kernel(output) != 0) {
        std::cout << "test failed!" << std::endl;
        return 1;
    }

    bool passed = true;
    for (uint32_t i = 0; i < OUTPUT_COUNT; ++i) {
        std::cout << names[i] << ": actual=" << output[i] << ", expected=" << expected[i] << std::endl;
        passed = passed && (output[i] == expected[i]);
    }

    std::cout << (passed ? "test pass!" : "test failed!") << std::endl;
    return passed ? 0 : 1;
}
