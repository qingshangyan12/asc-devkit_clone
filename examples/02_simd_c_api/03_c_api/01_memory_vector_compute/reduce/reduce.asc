#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
constexpr uint32_t ELEMENT_COUNT = 64;
__global__ __vector__ void reduce_kernel(__gm__ float* output, __gm__ float* input)
{
    asc_init(); __ubuf__ float input_local[ELEMENT_COUNT]; __ubuf__ float output_local[8];
    asc_copy_gm2ub_align(input_local, input, ELEMENT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0); asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_repeat_reduce_sum_sync(output_local, input_local, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0); asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, 32); asc_sync();
}
int main()
{
    std::vector<float> input(ELEMENT_COUNT), output(8); float golden = 0.0F;
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) { input[i] = static_cast<float>(i + 1) / 8.0F; golden += input[i]; }
    aclInit(nullptr); aclrtSetDevice(0); float *input_device = nullptr, *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(float), input.data(), input.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    reduce_kernel<<<1, 0>>>(output_device, input_device); aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(float), output_device, output.size() * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
    const bool passed = std::fabs(output[0] - golden) < 1e-4F;
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    aclrtFree(input_device); aclrtFree(output_device); aclrtResetDevice(0); aclFinalize(); return passed ? 0 : 1;
}
