#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t OUTPUT_BYTES = ELEMENT_COUNT / 8;

__global__ __vector__ void compare_kernel(__gm__ uint8_t* output, __gm__ float* x, __gm__ float* y)
{
    asc_init();
    __ubuf__ float x_local[ELEMENT_COUNT];
    __ubuf__ float y_local[ELEMENT_COUNT];
    __ubuf__ uint8_t output_local[32];
    asc_copy_gm2ub_align(x_local, x, ELEMENT_COUNT * sizeof(float));
    asc_copy_gm2ub_align(y_local, y, ELEMENT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
#if SCENARIO_NUM == 1
    asc_lt_sync(output_local, x_local, y_local, 1, 1, 1, 1, 1, 8, 8);
#elif SCENARIO_NUM == 2
    asc_lt_sync(x_local, y_local, 1, 1, 1, 1, 1, 8, 8);
    asc_get_cmp_mask(output_local);
#elif SCENARIO_NUM == 3
    asc_lt_scalar_sync(output_local, x_local, y_local[0], 1, 1, 1, 1, 8);
#elif SCENARIO_NUM == 4
    asc_gt_scalar_sync(output_local, x_local, y_local[0], 1, 1, 1, 1, 8);
#endif
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, 32);
    asc_sync();
}

int main()
{
    std::vector<float> x(ELEMENT_COUNT), y(ELEMENT_COUNT);
    std::vector<uint8_t> output(32), golden(OUTPUT_BYTES, 0);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) { x[i] = static_cast<float>(i - 32); y[i] = static_cast<float>(i % 9 - 4); }
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
#if SCENARIO_NUM == 4
        const bool match = y[0] < x[i];
#else
        const bool match = SCENARIO_NUM == 3 ? x[i] < y[0] : x[i] < y[i];
#endif
        if (match) golden[i / 8] |= static_cast<uint8_t>(1U << (i % 8));
    }
    aclInit(nullptr); aclrtSetDevice(0);
    float *x_device = nullptr, *y_device = nullptr; uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&x_device), x.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&y_device), y.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(x_device, x.size() * sizeof(float), x.data(), x.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, y.size() * sizeof(float), y.data(), y.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    compare_kernel<<<1, 0>>>(output_device, x_device, y_device); aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size(), output_device, output.size(), ACL_MEMCPY_DEVICE_TO_HOST);
    bool passed = std::equal(golden.begin(), golden.end(), output.begin());
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    aclrtFree(x_device); aclrtFree(y_device); aclrtFree(output_device); aclrtResetDevice(0); aclFinalize();
    return passed ? 0 : 1;
}
