#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEMENT_COUNT = 512;
constexpr half ALPHA = static_cast<half>(0.01F);

__global__ __vector__ void element_wise_arithmetic_kernel(__gm__ half* output, __gm__ half* input)
{
    asc_init();
    __ubuf__ half input_local[ELEMENT_COUNT];
    __ubuf__ half output_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(input_local, input, ELEMENT_COUNT * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_leakyrelu_sync(output_local, input_local, ALPHA, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, ELEMENT_COUNT * sizeof(half));
    asc_sync();
}

int main()
{
    std::vector<half> input(ELEMENT_COUNT), output(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) input[i] = static_cast<half>(static_cast<int32_t>(i % 97) - 48);
    aclInit(nullptr);
    aclrtSetDevice(0);
    half *input_device = nullptr, *output_device = nullptr;
    constexpr size_t bytes = ELEMENT_COUNT * sizeof(half);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    element_wise_arithmetic_kernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), bytes, output_device, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool passed = true;
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        const half expected = input[i] > static_cast<half>(0.0F) ? input[i] : input[i] * ALPHA;
        passed = passed && output[i] == expected;
    }
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    aclrtFree(input_device); aclrtFree(output_device); aclrtResetDevice(0); aclFinalize();
    return passed ? 0 : 1;
}
