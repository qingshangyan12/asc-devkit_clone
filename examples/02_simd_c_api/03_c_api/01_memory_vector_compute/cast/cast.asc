#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
constexpr uint32_t ELEMENT_COUNT = 512;
constexpr uint32_t OUTPUT_BYTES = SCENARIO_NUM == 0 ? ELEMENT_COUNT / 2 : ELEMENT_COUNT * sizeof(int32_t);
__global__ __vector__ void cast_kernel(__gm__ uint8_t* output, __gm__ half* input)
{
    asc_init();
    __ubuf__ half input_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(input_local, input, ELEMENT_COUNT * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0); asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
#if SCENARIO_NUM == 0
    __ubuf__ uint8_t output_local[ELEMENT_COUNT / 2];
    asc_half2int4_ru_sync(reinterpret_cast<__ubuf__ int4b_t*>(output_local), input_local, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0); asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, OUTPUT_BYTES);
#else
    __ubuf__ int32_t output_local[ELEMENT_COUNT];
    asc_half2int32_ru_sync(output_local, input_local, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0); asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(reinterpret_cast<__gm__ int32_t*>(output), output_local, OUTPUT_BYTES);
#endif
    asc_sync();
}
int main()
{
    std::vector<half> input(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) input[i] = static_cast<half>((static_cast<int32_t>(i % 31) - 15) + 0.25F);
    std::vector<uint8_t> output(OUTPUT_BYTES), golden(OUTPUT_BYTES);
#if SCENARIO_NUM == 0
    for (uint32_t i = 0; i < ELEMENT_COUNT; i += 2) {
        const int8_t low = static_cast<int8_t>(std::fmin(7.0F, std::fmax(-8.0F, std::ceil(static_cast<float>(input[i]))))) & 0xF;
        const int8_t high = static_cast<int8_t>(std::fmin(7.0F, std::fmax(-8.0F, std::ceil(static_cast<float>(input[i + 1]))))) & 0xF;
        golden[i / 2] = static_cast<uint8_t>(low | (high << 4));
    }
#else
    auto* expected = reinterpret_cast<int32_t*>(golden.data());
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) expected[i] = static_cast<int32_t>(std::ceil(static_cast<float>(input[i])));
#endif
    aclInit(nullptr); aclrtSetDevice(0); half* input_device = nullptr; uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input.size() * sizeof(half), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(half), input.data(), input.size() * sizeof(half), ACL_MEMCPY_HOST_TO_DEVICE);
    cast_kernel<<<1, 0>>>(output_device, input_device); aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), OUTPUT_BYTES, output_device, OUTPUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    const bool passed = output == golden; std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    aclrtFree(input_device); aclrtFree(output_device); aclrtResetDevice(0); aclFinalize(); return passed ? 0 : 1;
}
