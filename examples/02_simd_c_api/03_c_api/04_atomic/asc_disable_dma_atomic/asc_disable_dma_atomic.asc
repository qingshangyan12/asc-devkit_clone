#include <cstddef>
#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

namespace {
constexpr uint32_t DATA_COUNT = 32;
constexpr size_t DATA_BYTES = DATA_COUNT * sizeof(float);
}

__vector__ __global__ __aicore__ void disable_dma_atomic_kernel(
    __gm__ float* src, __gm__ float* atomic_dst, __gm__ float* normal_dst)
{
    asc_init();
    __ubuf__ float local[DATA_COUNT];

    asc_copy_gm2ub_sync(local, src, DATA_BYTES);
    asc_set_atomic_add_float();
    asc_copy_ub2gm_sync(atomic_dst, local, DATA_BYTES);
    asc_disable_dma_atomic();
    asc_copy_ub2gm_sync(normal_dst, local, DATA_BYTES);
}

int main()
{
    constexpr int32_t deviceId = 0;
    float src[DATA_COUNT] = {};
    float initialValue[DATA_COUNT] = {};
    for (uint32_t index = 0; index < DATA_COUNT; ++index) {
        src[index] = 2.0F;
        initialValue[index] = 1.0F;
    }

    aclInit(nullptr);
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    float* srcDevice = nullptr;
    float* atomicDstDevice = nullptr;
    float* normalDstDevice = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&srcDevice), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&atomicDstDevice), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&normalDstDevice), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(srcDevice, DATA_BYTES, src, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(atomicDstDevice, DATA_BYTES, initialValue, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(normalDstDevice, DATA_BYTES, initialValue, DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    disable_dma_atomic_kernel<<<1, 0, stream>>>(srcDevice, atomicDstDevice, normalDstDevice);
    aclrtSynchronizeStream(stream);

    float atomicResult[DATA_COUNT] = {};
    float normalResult[DATA_COUNT] = {};
    aclrtMemcpy(atomicResult, DATA_BYTES, atomicDstDevice, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(normalResult, DATA_BYTES, normalDstDevice, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);

    bool passed = true;
    for (uint32_t index = 0; index < DATA_COUNT; ++index) {
        passed = passed && atomicResult[index] == 3.0F && normalResult[index] == 2.0F;
    }
    std::cout << (passed ? "[Success] asc_disable_dma_atomic verification passed.\n"
                         : "[Failed] asc_disable_dma_atomic verification failed.\n");

    aclrtFree(srcDevice);
    aclrtFree(atomicDstDevice);
    aclrtFree(normalDstDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return passed ? 0 : 1;
}
