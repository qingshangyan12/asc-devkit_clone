// Build/run (examples/02_simd_c_api/06_pr_5039_validation/scalar_compute/asc_load_dev.asc): "$ASCEND_HOME_PATH/bin/bisheng" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}/include" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/06_pr_5039_validation/scalar_compute/asc_load_dev.asc -lm -o /tmp/pr5039_asc_load_dev && /tmp/pr5039_asc_load_dev
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
constexpr uint32_t INITIAL_VALUE = 11;
constexpr uint32_t DIRECT_VALUE = 123456789;
constexpr uint32_t RESULT_COUNT = 3;

void PrintData(const char* label, const std::vector<uint64_t>& values)
{
    std::cout << label << ":";
    for (uint64_t value : values) std::cout << ' ' << value;
    std::cout << std::endl;
}

__global__ __vector__ void AscLoadDevKernel(__gm__ uint32_t* value, __gm__ uint64_t* result)
{
    asc_init();
    __gm__ volatile uint32_t* cached_addr = value;

    // A normal scalar load fills DataCache with the initial GM value.
    const uint32_t cached_before = *cached_addr;
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);

    // Bypass DataCache and write the 32-bit value directly to GM.
    asc_store_dev(value, DIRECT_VALUE);
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);

    // asc_load_dev bypasses the stale cache line and sees current GM.
    const uint64_t direct_after = asc_load_dev(value);
    // The normal load still sees the clean, stale DataCache line established above.
    const uint32_t cached_after = *cached_addr;

    asc_store_dev(result + 0, static_cast<uint64_t>(cached_before));
    asc_store_dev(result + 1, direct_after);
    asc_store_dev(result + 2, static_cast<uint64_t>(cached_after));
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
}
} // namespace

int main()
{
    uint32_t value = INITIAL_VALUE;
    std::vector<uint64_t> output(RESULT_COUNT, 0);
    const std::vector<uint64_t> golden = {INITIAL_VALUE, DIRECT_VALUE, INITIAL_VALUE};

    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t* value_device = nullptr;
    uint64_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&value_device), sizeof(value), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(value_device, sizeof(value), &value, sizeof(value), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(uint64_t), output.data(), output.size() * sizeof(uint64_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscLoadDevKernel<<<1, 0>>>(value_device, output_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint64_t), output_device, output.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(&value, sizeof(value), value_device, sizeof(value), ACL_MEMCPY_DEVICE_TO_HOST);

    std::cout << "Initial GM value: " << INITIAL_VALUE << std::endl;
    PrintData("Output [cached-before, direct-after, cached-after]", output);
    PrintData("Golden", golden);
    std::cout << "Final GM value observed by Host: " << value << std::endl;
    const bool passed = output == golden && value == DIRECT_VALUE;
    std::cout << (passed ? "[Success] asc_load_dev/asc_store_dev bypass DataCache passed."
                        : "[Failed] asc_load_dev/asc_store_dev bypass DataCache failed.") << std::endl;
    aclrtFree(output_device);
    aclrtFree(value_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
