// Build/run (examples/02_simd_c_api/06_pr_5039_validation/scalar_compute/asc_load_dev_signed_repro.asc, expected FAIL): "$ASCEND_HOME_PATH/bin/bisheng" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}/include" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/06_pr_5039_validation/scalar_compute/asc_load_dev_signed_repro.asc -lm -o /tmp/pr5039_asc_load_dev_signed_repro && /tmp/pr5039_asc_load_dev_signed_repro
// Compile int64_t repro (expected device compilation failure): "$ASCEND_HOME_PATH/bin/bisheng" -DREPRO_INT64_COMPILE_FAILURE -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}/include" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/06_pr_5039_validation/scalar_compute/asc_load_dev_signed_repro.asc -lm -o /tmp/pr5039_asc_load_dev_int64_repro
// Architecture: dav-3510; PR head: e01c7406ed3a604e6aee1760f518fa79127cc388

#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
constexpr uint32_t CASE_COUNT = 6;
constexpr uint32_t SLOT_COUNT = 7;

__global__ __vector__ void AscLoadDevSignedReproKernel(__gm__ uint64_t* input, __gm__ int64_t* output)
{
    asc_init();
    // Negative narrow signed values should be sign-extended to int64_t; PR 5039 zero-extends them instead.
    asc_store_dev(output + 0, asc_load_dev(reinterpret_cast<__gm__ int8_t*>(input + 0)));
    asc_store_dev(output + 1, static_cast<int64_t>(asc_load_dev(reinterpret_cast<__gm__ uint8_t*>(input + 1))));
    asc_store_dev(output + 2, asc_load_dev(reinterpret_cast<__gm__ int16_t*>(input + 2)));
    asc_store_dev(output + 3, static_cast<int64_t>(asc_load_dev(reinterpret_cast<__gm__ uint16_t*>(input + 3))));
    asc_store_dev(output + 4, asc_load_dev(reinterpret_cast<__gm__ int32_t*>(input + 4)));
    asc_store_dev(output + 5, static_cast<int64_t>(asc_load_dev(reinterpret_cast<__gm__ uint32_t*>(input + 5))));
#if defined(REPRO_INT64_COMPILE_FAILURE)
    // PR 5039 passes int64_t* directly to ld_dev; the real compiler has no matching signed-pointer overload.
    asc_store_dev(output + 6, asc_load_dev(reinterpret_cast<__gm__ int64_t*>(input + 6)));
#endif
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
}

void PrintData(const char* label, const std::vector<int64_t>& values)
{
    std::cout << label << ":";
    for (uint32_t i = 0; i < CASE_COUNT; ++i) std::cout << ' ' << values[i];
    std::cout << std::endl;
}
} // namespace

int main()
{
    // Each value occupies an independent aligned slot; ld_dev reads the low 8/16/32 bits for the selected type.
    const std::vector<uint64_t> input = {UINT8_MAX, 1, UINT16_MAX - 1, 2, UINT32_MAX - 2, 3, UINT64_MAX - 3};
    const std::vector<int64_t> golden = {-1, 1, -2, 2, -3, 3};
    std::vector<int64_t> output(SLOT_COUNT, 0);

    aclInit(nullptr);
    aclrtSetDevice(0);
    uint64_t* input_device = nullptr;
    int64_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input.size() * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint64_t), input.data(), input.size() * sizeof(uint64_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(int64_t), output.data(), output.size() * sizeof(int64_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscLoadDevSignedReproKernel<<<1, 0>>>(input_device, output_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(int64_t), output_device, output.size() * sizeof(int64_t),
        ACL_MEMCPY_DEVICE_TO_HOST);

    std::cout << "Cases: int8 uint8 int16 uint16 int32 uint32" << std::endl;
    PrintData("Output", output);
    PrintData("Golden", golden);
    bool passed = true;
    for (uint32_t i = 0; i < CASE_COUNT; ++i) passed = passed && output[i] == golden[i];
    std::cout << (passed ? "[Unexpected] signed asc_load_dev passed."
                        : "[Reproduced] signed asc_load_dev result mismatch.") << std::endl;
    aclrtFree(output_device);
    aclrtFree(input_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
