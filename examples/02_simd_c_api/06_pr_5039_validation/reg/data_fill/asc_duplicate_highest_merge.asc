// Build/run (examples/02_simd_c_api/06_pr_5039_validation/reg/data_fill/asc_duplicate_highest_merge.asc): "$ASCEND_HOME_PATH/bin/bisheng" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}/include" -iquote "${ASC_DEVKIT_PR5039_ROOT:-.}" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/06_pr_5039_validation/reg/data_fill/asc_duplicate_highest_merge.asc -lm -o /tmp/pr5039_asc_duplicate_highest_merge && /tmp/pr5039_asc_duplicate_highest_merge
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t ACTIVE_COUNT = 4;
constexpr float INITIAL_VALUE = -7.0f;

void PrintData(const char* label, const std::vector<float>& values)
{
    std::cout << label << ":";
    for (uint32_t i = 0; i < 8; ++i) std::cout << ' ' << values[i];
    std::cout << " ..." << std::endl;
}

__simd_vf__ inline void DuplicateHighestMerge(__ubuf__ float* dst, __ubuf__ float* src)
{
    vector_float dst_reg;
    vector_float src_reg;
    uint32_t active_count = ACTIVE_COUNT;
    uint32_t full_count = ELEMENT_COUNT;
    vector_bool active_mask = asc_update_mask_b32(active_count);
    vector_bool full_mask = asc_update_mask_b32(full_count);
    asc_loadalign(dst_reg, dst);
    asc_loadalign(src_reg, src);
    // Broadcast src[63] to selected lanes; preserve the other destination lanes.
    asc_duplicate_highest_merge(dst_reg, src_reg, active_mask);
    asc_storealign(dst, dst_reg, full_mask);
}

__global__ __vector__ void AscDuplicateHighestMergeKernel(__gm__ float* dst, __gm__ float* src)
{
    asc_init();
    __ubuf__ float dst_local[ELEMENT_COUNT];
    __ubuf__ float src_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(dst_local, dst, sizeof(dst_local));
    asc_copy_gm2ub_align(src_local, src, sizeof(src_local));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    DuplicateHighestMerge(dst_local, src_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(dst, dst_local, sizeof(dst_local));
    asc_sync_mte3(0);
}
} // namespace

int main()
{
    std::vector<float> input(ELEMENT_COUNT);
    std::vector<float> output(ELEMENT_COUNT, INITIAL_VALUE);
    std::vector<float> golden(ELEMENT_COUNT, INITIAL_VALUE);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) input[i] = static_cast<float>(i + 1);
    for (uint32_t i = 0; i < ACTIVE_COUNT; ++i) golden[i] = input.back();

    aclInit(nullptr);
    aclrtSetDevice(0);
    float *input_device = nullptr, *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(float), input.data(), input.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(float), output.data(), output.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscDuplicateHighestMergeKernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(float), output_device, output.size() * sizeof(float),
        ACL_MEMCPY_DEVICE_TO_HOST);

    std::cout << "Input lowest/highest: " << input.front() << ' ' << input.back() << std::endl;
    PrintData("Output", output);
    PrintData("Golden", golden);
    const bool passed = output == golden;
    std::cout << (passed ? "[Success] asc_duplicate_highest_merge passed."
                        : "[Failed] asc_duplicate_highest_merge failed.") << std::endl;
    aclrtFree(output_device);
    aclrtFree(input_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
