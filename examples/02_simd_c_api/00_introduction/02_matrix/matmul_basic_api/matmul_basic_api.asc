/* !
 * \file matmul_basic_api.asc
 * \brief 使用SIMD C API实现矩阵乘法，展示Cube单元的基本使用方法
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;

template <uint32_t M, uint32_t K, uint32_t N, uint32_t singleCoreM, uint32_t baseM, uint32_t baseK, uint32_t baseN>
__global__ __cube__ void mmad_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();
    uint32_t mIterIdx = asc_get_block_idx() % (M / singleCoreM);
    __gm__ half* aGM = (__gm__ half*)a + mIterIdx * singleCoreM * K;
    __gm__ half* bGM = (__gm__ half*)b;
    __gm__ half* cGM = (__gm__ half*)c + mIterIdx * singleCoreM * N;
    // 使用地址空间限定符声明片上数组，由编译器分配对应位置的片上内存。
    __cbuf__ half a1Local[baseM * baseK];
    __cbuf__ half b1Local[baseK * baseN];
    __ca__ half a2Local[baseM * baseK];
    __cb__ half b2Local[baseK * baseN];
    __cc__ float cLocal[baseM * baseN];
    // A矩阵GM->L1调用asc_set_gm2l1_nz_para接口配置目的Nz排布：
    // {matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride}
    asc_set_gm2l1_nz_para(1, 1, baseM, 0);
    // A矩阵GM->L1调用asc_copy_gm2l1_nd2nz接口：
    // {dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, enable_small_c0}
    asc_copy_gm2l1_nd2nz(
        a1Local, aGM, K * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseM, baseK, 0, false);
    // B矩阵GM->L1调用asc_set_gm2l1_nz_para接口配置目的Nz排布：
    // {matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride}
    asc_set_gm2l1_nz_para(1, 1, baseK, 0);
    // B矩阵GM->L1调用asc_copy_gm2l1_nd2nz接口：
    // {dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, enable_small_c0}
    asc_copy_gm2l1_nd2nz(
        b1Local, bGM, N * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseK, baseN, 0, false);
    // asc_sync_notify用于在生产者流水完成当前任务后写入同步事件，asc_sync_wait用于让消费者流水等待该事件；
    // 前两个参数描述同步方向，EVENT_ID用于区分同类同步事件。
    // GM->L1的asc_copy_gm2l1_nd2nz由MTE2流水完成，后续L1->L0的搬运由MTE1流水读取L1数据；
    // 这里设置MTE2到MTE1事件，使MTE1等待MTE2，避免读取到尚未搬运完成的数据。
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    // A矩阵L1->L0A（Nz->Nz）
    // A矩阵L1->L0A调用asc_copy_l12l0a接口：
    // {dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride}
    asc_copy_l12l0a(
        a2Local, a1Local, 0, 0, baseM / CUBE_BLOCK, baseK / CUBE_BLOCK, baseM / CUBE_BLOCK,
        baseM / CUBE_BLOCK);
    // B矩阵L1->L0B（Nz->Zn）
    // B矩阵L1->L0B调用asc_copy_l12l0b_transpose接口：
    // {dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride}
    asc_copy_l12l0b_transpose(
        b2Local, b1Local, 0, 0, baseK / CUBE_BLOCK, baseN / CUBE_BLOCK, baseK / CUBE_BLOCK,
        baseN / CUBE_BLOCK);
    // L1->L0搬运由MTE1流水完成，后续asc_mmad由M流水读取L0A/L0B数据；
    // 这里设置MTE1到M事件，使M流水等待MTE1，避免asc_mmad读取到尚未搬运完成的数据。
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    // 矩阵乘调用asc_mmad接口：
    // {c_matrix, a_matrix, b_matrix, m, k, n, unit_flag_mode, disable_gemv, c_matrix_source, c_matrix_init_val}
    asc_mmad(
        cLocal, a2Local, b2Local, baseM, baseK, baseN, asc_unit_flag_mode::DISABLE, false, false, true);

    // asc_mmad由M流水完成并写入L0C，后续asc_copy_l0c2gm由FIX流水读取L0C并搬运到GM；
    // 这里设置M到FIX事件，使FIX流水等待M流水，避免asc_copy_l0c2gm读取到尚未计算完成的数据。
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    // L0C->GM搬运调用asc_set_l0c_copy_nz_para接口配置Nz->ND单矩阵搬运：
    // {matrix_num, src_matrix_stride, dst_matrix_stride}
    asc_set_l0c_copy_nz_para(1, 0, 0);
    // L0C->GM搬运调用asc_copy_l0c2gm接口：
    // {dst, src, n_size, m_size, dst_stride, src_stride, l2_cache_mode, unit_flag_mode,
    //  quant_pre_mode, relu_pre_mode, enable_channel_split, enable_nz2nd, enable_nz2dn, enable_clip_relu_pre}
    asc_copy_l0c2gm(
        cGM, cLocal, baseN, baseM, N, baseM, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NONE, false, true, false, false);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    // matmul参数
    constexpr uint32_t M = 256;
    constexpr uint32_t K = 64;
    constexpr uint32_t N = 256;
    // 单核计算量
    constexpr uint32_t singleCoreM = 128;
    // 矩阵乘执行单元Tile参数
    constexpr uint32_t baseM = 128;
    constexpr uint32_t baseK = 64;
    constexpr uint32_t baseN = 256;

    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize = M * N * sizeof(half);
    uint32_t numBlocks = 2;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost;
    uint8_t* aDevice;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost;
    uint8_t* bDevice;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost;
    uint8_t* cDevice;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_custom<M, K, N, singleCoreM, baseM, baseK, baseN><<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
