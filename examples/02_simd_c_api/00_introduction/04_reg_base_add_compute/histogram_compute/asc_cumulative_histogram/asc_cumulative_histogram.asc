#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_cumulative_histogram_vf(__ubuf__ uint16_t* dst, __ubuf__ uint8_t* src, uint32_t data_len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t reps = (data_len + one_rep - 1) / one_rep;
    uint32_t remaining = data_len;
    vector_bool mask; vector_uint8_t rs; vector_uint16_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (remaining > one_rep) ? one_rep : remaining;
        uint32_t mc = n;
        mask = asc_update_mask_b8(mc);
        asc_load(rs, src + i * one_rep);
        asc_cumulative_histogram_bin0(rd, rs, mask);
        asc_store(dst + i * one_rep, rd, n);
        remaining = (remaining > one_rep) ? (remaining - one_rep) : 0;
    }
}

__vector__ __global__ void asc_cumulative_histogram_custom(__gm__ uint8_t* src, __gm__ uint16_t* dst)
{
    asc_init();
    constexpr uint32_t bl = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mtx = 1;
    __gm__ uint8_t* sg = src + block_idx * bl; __gm__ uint16_t* dg = dst + block_idx * bl;
    __ubuf__ uint8_t sl[bl]; __ubuf__ uint16_t dl[bl];
    uint8_t cm0=(uint8_t)(((uint64_t)sg)>>60), cm2=(uint8_t)(((uint64_t)dg)>>60);
    uint32_t sblen=bl*sizeof(uint8_t), dblen=bl*sizeof(uint16_t); uint64_t ss=0; uint32_t ds=0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)sl, sg, BLK_NUM, sblen, 0,0,true,cm0,ss,ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx); asc_cumulative_histogram_vf((__ubuf__ uint16_t*)dl,(__ubuf__ uint8_t*)sl,bl); asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx); asc_copy_ub2gm_align(dg,(__ubuf__ uint16_t*)dl,BLK_NUM,dblen,cm2,ss,ds); asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint16_t> kernel_asc_cumulative_histogram(std::vector<uint8_t>& src)
{
    constexpr uint32_t nb = NUM_BLOCKS; size_t sbs=src.size()*sizeof(uint8_t), dbs=src.size()*sizeof(uint16_t); int32_t did=0;
    uint8_t *sh=(uint8_t*)src.data(), *dh=nullptr; uint8_t *sd=nullptr; uint16_t *dd=nullptr;
    aclInit(nullptr); aclrtSetDevice(did);
    aclrtMallocHost((void**)(&dh),dbs); aclrtMalloc((void**)&sd,sbs,ACL_MEM_MALLOC_HUGE_FIRST); aclrtMalloc((void**)&dd,dbs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)sd,sbs,sh,sbs,ACL_MEMCPY_HOST_TO_DEVICE);
    asc_cumulative_histogram_custom<<<nb,0>>>(sd,dd); aclrtSynchronizeDevice();
    aclrtMemcpy(dh,dbs,(uint8_t*)dd,dbs,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> d((uint16_t*)dh,(uint16_t*)(dh+dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh); aclrtResetDevice(did); aclFinalize(); return d;
}

uint32_t verify_result(std::vector<uint16_t>& output, std::vector<uint16_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<uint8_t> src(total_length);
    for (uint32_t i = 0; i < total_length; ++i) src[i] = (uint8_t)(i % 200);
    auto output = kernel_asc_cumulative_histogram(src);
    std::vector<uint16_t> golden(total_length, 0);
    return verify_result(output, golden);
}