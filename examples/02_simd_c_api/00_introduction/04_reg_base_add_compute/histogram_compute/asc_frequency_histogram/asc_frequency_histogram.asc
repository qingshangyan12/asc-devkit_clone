/* !
 * \file asc_frequency_histogram.asc
 * \brief Sample covering ALL documented overloads of asc_frequency_histogram
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_frequency_histogram_uint8_vf(__ubuf__ uint16_t* d, __ubuf__ uint8_t* s0, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_uint8_t r0; vector_uint16_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b8(n);
        asc_load(r0, s0 + i * one_rep);
        asc_frequency_histogram(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_frequency_histogram_uint8_kernel(__gm__ uint8_t* s0, __gm__ uint16_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint8_t* gs0 = s0 + block_idx * bl;
    __gm__ uint16_t* gd = d + block_idx * bl;
    __ubuf__ uint8_t s0l[bl];
    __ubuf__ uint16_t dl[bl];
    uint32_t blen = bl * sizeof(uint8_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_frequency_histogram_uint8_vf((__ubuf__ uint16_t*)dl, (__ubuf__ uint8_t*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint16_t*)dl, BLK_NUM, bl * sizeof(uint16_t), 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint16_t> run_asc_frequency_histogram_uint8(std::vector<uint8_t>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(uint8_t); size_t bsd = tl * sizeof(uint16_t);
    uint8_t* s0d = nullptr; uint16_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bsd, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bsd);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_frequency_histogram_uint8_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bsd, dd, bsd, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> result((const uint16_t*)dh, (const uint16_t*)(dh + bsd));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // uint8
        std::vector<uint8_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint8_t)(i % 256); }
        auto result = run_asc_frequency_histogram_uint8(s0, stream);
        std::vector<uint16_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_frequency_histogram uint8");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
