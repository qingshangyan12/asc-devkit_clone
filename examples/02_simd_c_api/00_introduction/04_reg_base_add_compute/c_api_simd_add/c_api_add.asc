#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void add_vf(__ubuf__ float* z, __ubuf__ float* x, __ubuf__ float* y, uint32_t data_len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (data_len + one_rep - 1) / one_rep;
    uint32_t remaining = data_len;
    vector_bool mask; vector_float rx, ry, rz;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (remaining > one_rep) ? one_rep : remaining;
        uint32_t mc = n;
        mask = asc_update_mask_b32(mc);
        asc_load(rx, x + i * one_rep); asc_load(ry, y + i * one_rep);
        asc_add(rz, rx, ry, mask);
        asc_store(z + i * one_rep, rz, n);
        remaining = (remaining > one_rep) ? (remaining - one_rep) : 0;
    }
}

__vector__ __global__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();
    constexpr uint32_t bl = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mtx = 1;
    __gm__ float* xg = x + block_idx * bl; __gm__ float* yg = y + block_idx * bl; __gm__ float* zg = z + block_idx * bl;
    __ubuf__ float xl[bl], yl[bl], zl[bl];
    uint8_t cm0 = (uint8_t)(((uint64_t)xg)>>60), cm1 = (uint8_t)(((uint64_t)yg)>>60), cm2 = (uint8_t)(((uint64_t)zg)>>60);
    uint32_t blen = bl*sizeof(float); uint64_t ss=0; uint32_t ds=0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)xl, xg, BLK_NUM, blen, 0,0,true,cm0,ss,ds);
    asc_copy_gm2ub_align((__ubuf__ float*)yl, yg, BLK_NUM, blen, 0,0,true,cm1,ss,ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx); add_vf((__ubuf__ float*)zl,(__ubuf__ float*)xl,(__ubuf__ float*)yl,bl); asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx); asc_copy_ub2gm_align(zg,(__ubuf__ float*)zl,BLK_NUM,blen,cm2,ss,ds); asc_unlock(PIPE_MTE3, mtx);
}

std::vector<float> kernel_add(std::vector<float>& x, std::vector<float>& y)
{
    constexpr uint32_t nb = NUM_BLOCKS; size_t bs = x.size()*sizeof(float); int32_t did=0;
    uint8_t* xh=(uint8_t*)x.data(), *yh=(uint8_t*)y.data(), *zh=nullptr; float *xd=nullptr,*yd=nullptr,*zd=nullptr;
    aclInit(nullptr); aclrtSetDevice(did);
    aclrtMallocHost((void**)(&zh),bs); aclrtMalloc((void**)&xd,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yd,bs,ACL_MEM_MALLOC_HUGE_FIRST); aclrtMalloc((void**)&zd,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)xd,bs,xh,bs,ACL_MEMCPY_HOST_TO_DEVICE); aclrtMemcpy((uint8_t*)yd,bs,yh,bs,ACL_MEMCPY_HOST_TO_DEVICE);
    add_custom<<<nb,0>>>(xd,yd,zd); aclrtSynchronizeDevice();
    aclrtMemcpy(zh,bs,(uint8_t*)zd,bs,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> z((float*)zh,(float*)(zh+bs));
    aclrtFree(xd); aclrtFree(yd); aclrtFree(zd); aclrtFreeHost(zh);
    aclrtResetDevice(did); aclFinalize(); return z;
}

uint32_t verify_result(std::vector<float>& o, std::vector<float>& g)
{
    if(std::equal(g.begin(),g.end(),o.begin())){std::cout<<"[Success] Case accuracy is verification passed."<<std::endl;return 0;}
    else{std::cout<<"[Failed] Case accuracy is verification failed!"<<std::endl;return 1;}
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t tl = TOTAL_LENGTH; std::vector<float> x(tl), y(tl);
    for(uint32_t i=0;i<tl;++i){x[i]=i*0.1f;y[i]=i*0.2f;}
    auto o = kernel_add(x,y); std::vector<float> g(tl);
    for(uint32_t i=0;i<tl;++i) g[i]=x[i]+y[i];
    return verify_result(o,g);
}