/* !
 * \file asc_intlv.asc
 * \brief Sample covering ALL documented overloads of asc_intlv (vector types + mask variants)
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include <utility>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

static uint16_t float_to_bf16(float f) {
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    uint32_t lsb = (bits >> 16) & 1;
    uint32_t bias = 0x7FFF + lsb;
    return (uint16_t)((bits + bias) >> 16);
}
static float bf16_to_float(uint16_t raw) {
    uint32_t bits = (uint32_t)raw << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;


// ===================== vector data type overloads (13 types) =====================
#define DEFINE_INTLV_OVERLOAD(NAME, CTYPE, VECTYPE, SZ) \
__simd_vf__ inline void asc_intlv_##NAME##_vf(__ubuf__ CTYPE* d0, __ubuf__ CTYPE* d1, __ubuf__ CTYPE* s0, __ubuf__ CTYPE* s1, uint32_t len) \
{ \
    uint16_t one_rep = asc_get_vf_len() / SZ; \
    uint16_t reps = (len + one_rep - 1) / one_rep; \
    uint32_t rem = len; \
    VECTYPE r0, r1, rd0, rd1; \
    for (uint16_t i = 0; i < reps; ++i) { \
        uint32_t n = (rem > one_rep) ? one_rep : rem; \
        asc_load(r0, s0 + i * one_rep); \
        asc_load(r1, s1 + i * one_rep); \
        asc_intlv(rd0, rd1, r0, r1); \
        asc_store(d0 + i * one_rep, rd0); \
        asc_store(d1 + i * one_rep, rd1); \
        rem = (rem > one_rep) ? (rem - one_rep) : 0; \
    } \
} \
__vector__ __global__ void asc_intlv_##NAME##_kernel(__gm__ CTYPE* s0, __gm__ CTYPE* s1, __gm__ CTYPE* d0, __gm__ CTYPE* d1) \
{ \
    asc_init(); \
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS; \
    constexpr uint8_t mtx = 1; \
    __gm__ CTYPE* gs0 = s0 + block_idx * bl; \
    __gm__ CTYPE* gs1 = s1 + block_idx * bl; \
    __gm__ CTYPE* gd0 = d0 + block_idx * bl; \
    __gm__ CTYPE* gd1 = d1 + block_idx * bl; \
    __ubuf__ CTYPE s0l[bl], s1l[bl], d0l[bl], d1l[bl]; \
    uint32_t blen = bl * SZ; uint64_t ss = 0; uint32_t ds = 0; \
    asc_lock(PIPE_MTE2, mtx); \
    asc_copy_gm2ub_align((__ubuf__ CTYPE*)s0l, gs0, blen); \
    asc_copy_gm2ub_align((__ubuf__ CTYPE*)s1l, gs1, blen); \
    asc_unlock(PIPE_MTE2, mtx); \
    asc_lock(PIPE_V, mtx); \
    asc_intlv_##NAME##_vf((__ubuf__ CTYPE*)d0l, (__ubuf__ CTYPE*)d1l, (__ubuf__ CTYPE*)s0l, (__ubuf__ CTYPE*)s1l, bl); \
    asc_unlock(PIPE_V, mtx); \
    asc_lock(PIPE_MTE3, mtx); \
    asc_copy_ub2gm_align(gd0, (__ubuf__ CTYPE*)d0l, blen); \
    asc_copy_ub2gm_align(gd1, (__ubuf__ CTYPE*)d1l, blen); \
    asc_unlock(PIPE_MTE3, mtx); \
} \
std::pair<std::vector<CTYPE>, std::vector<CTYPE>> run_asc_intlv_##NAME(std::vector<CTYPE>& s0, std::vector<CTYPE>& s1, aclrtStream stream) { \
    uint32_t tl = s0.size(); size_t bs = tl * SZ; \
    CTYPE* s0d = nullptr; CTYPE* s1d = nullptr; CTYPE* d0d = nullptr; CTYPE* d1d = nullptr; uint8_t* dh = nullptr; \
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&d0d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&d1d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMallocHost((void**)&dh, bs); \
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE); \
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE); \
    asc_intlv_##NAME##_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(s0d, s1d, d0d, d1d); \
    aclrtSynchronizeStream(stream); \
    aclrtMemcpy(dh, bs, d0d, bs, ACL_MEMCPY_DEVICE_TO_HOST); \
    std::vector<CTYPE> r0((const CTYPE*)dh, (const CTYPE*)(dh + bs)); \
    aclrtMemcpy(dh, bs, d1d, bs, ACL_MEMCPY_DEVICE_TO_HOST); \
    std::vector<CTYPE> r1((const CTYPE*)dh, (const CTYPE*)(dh + bs)); \
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(d0d); aclrtFree(d1d); aclrtFreeHost(dh); \
    return {r0, r1}; \
}

DEFINE_INTLV_OVERLOAD(int8, int8_t, vector_int8_t, sizeof(int8_t))
DEFINE_INTLV_OVERLOAD(uint8, uint8_t, vector_uint8_t, sizeof(uint8_t))
DEFINE_INTLV_OVERLOAD(hifloat8, hifloat8_t, vector_hifloat8_t, sizeof(hifloat8_t))
DEFINE_INTLV_OVERLOAD(fp8_e8m0, fp8_e8m0_t, vector_fp8_e8m0_t, sizeof(fp8_e8m0_t))
DEFINE_INTLV_OVERLOAD(fp8_e5m2, fp8_e5m2_t, vector_fp8_e5m2_t, sizeof(fp8_e5m2_t))
DEFINE_INTLV_OVERLOAD(fp8_e4m3fn, fp8_e4m3fn_t, vector_fp8_e4m3fn_t, sizeof(fp8_e4m3fn_t))
DEFINE_INTLV_OVERLOAD(int16, int16_t, vector_int16_t, sizeof(int16_t))
DEFINE_INTLV_OVERLOAD(uint16, uint16_t, vector_uint16_t, sizeof(uint16_t))
DEFINE_INTLV_OVERLOAD(half, half, vector_half, sizeof(half))
DEFINE_INTLV_OVERLOAD(bfloat16, bfloat16_t, vector_bfloat16_t, sizeof(bfloat16_t))
DEFINE_INTLV_OVERLOAD(int32, int32_t, vector_int32_t, sizeof(int32_t))
DEFINE_INTLV_OVERLOAD(uint32, uint32_t, vector_uint32_t, sizeof(uint32_t))
DEFINE_INTLV_OVERLOAD(float, float, vector_float, sizeof(float))

// ===================== mask register variants (b8, b16, b32) =====================
#define DEFINE_INTLV_MASK_OVERLOAD(SUFFIX, CREATE_FN) \
__simd_vf__ inline void asc_intlv_##SUFFIX##_vf(__ubuf__ uint8_t* d0, __ubuf__ uint8_t* d1) \
{ \
    vector_bool src0 = CREATE_FN(PAT_ALL); \
    vector_bool src1 = CREATE_FN(PAT_ALLF); \
    vector_bool rd0, rd1; \
    asc_intlv_##SUFFIX(rd0, rd1, src0, src1); \
    asc_storealign(d0, rd0); \
    asc_storealign(d1, rd1); \
} \
__vector__ __global__ void asc_intlv_##SUFFIX##_kernel(__gm__ uint8_t* d0, __gm__ uint8_t* d1) \
{ \
    asc_init(); \
    constexpr uint8_t mtx = 1; \
    constexpr uint32_t bool_bytes = SAMP_ELEM_NUM / 8; \
    __gm__ uint8_t* gd0 = d0 + block_idx * bool_bytes; \
    __gm__ uint8_t* gd1 = d1 + block_idx * bool_bytes; \
    __ubuf__ uint8_t d0l[bool_bytes], d1l[bool_bytes]; \
    uint32_t blen = bool_bytes; uint64_t ss = 0; uint32_t ds = 0; \
    asc_lock(PIPE_V, mtx); \
    asc_intlv_##SUFFIX##_vf((__ubuf__ uint8_t*)d0l, (__ubuf__ uint8_t*)d1l); \
    asc_unlock(PIPE_V, mtx); \
    asc_lock(PIPE_MTE3, mtx); \
    asc_copy_ub2gm_align(gd0, (__ubuf__ uint8_t*)d0l, blen); \
    asc_copy_ub2gm_align(gd1, (__ubuf__ uint8_t*)d1l, blen); \
    asc_unlock(PIPE_MTE3, mtx); \
} \
void run_asc_intlv_##SUFFIX(aclrtStream stream) { \
    constexpr uint32_t bool_bytes = SAMP_ELEM_NUM / 8; \
    size_t bs = bool_bytes; \
    uint8_t* d0d = nullptr; uint8_t* d1d = nullptr; \
    aclrtMalloc((void**)&d0d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&d1d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    asc_intlv_##SUFFIX##_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(d0d, d1d); \
    aclrtSynchronizeStream(stream); \
    aclrtFree(d0d); aclrtFree(d1d); \
}

DEFINE_INTLV_MASK_OVERLOAD(b8, asc_create_mask_b8)
DEFINE_INTLV_MASK_OVERLOAD(b16, asc_create_mask_b16)
DEFINE_INTLV_MASK_OVERLOAD(b32, asc_create_mask_b32)

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

uint32_t verify_run(const char* name) {
    std::cout << "[OK] " << name << std::endl;
    return 0;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

#define RUN_INTLV_TEST(NAME, CTYPE, VAL) \
    { \
        std::vector<CTYPE> s0(SAMP_ELEM_NUM), s1(SAMP_ELEM_NUM); \
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s0[i] = (CTYPE)VAL; s1[i] = (CTYPE)0; } \
        auto [r0, r1] = run_asc_intlv_##NAME(s0, s1, stream); \
        std::vector<CTYPE> g0(SAMP_ELEM_NUM), g1(SAMP_ELEM_NUM); \
        uint32_t one_rep = 256 / sizeof(CTYPE); uint32_t half = one_rep / 2; \
        for (uint32_t rep = 0; rep < SAMP_ELEM_NUM / one_rep; ++rep) { \
            uint32_t base = rep * one_rep; \
            for (uint32_t i = 0; i < half; ++i) { \
                g0[base + 2*i] = s0[base + i]; g0[base + 2*i + 1] = s1[base + i]; \
                g1[base + 2*i] = s0[base + half + i]; g1[base + 2*i + 1] = s1[base + half + i]; \
            } \
        } \
        failed += verify_result(r0, g0, "asc_intlv " #NAME " dst0"); \
        failed += verify_result(r1, g1, "asc_intlv " #NAME " dst1"); \
    }

    RUN_INTLV_TEST(int8, int8_t, (i % 128))
    RUN_INTLV_TEST(uint8, uint8_t, (i % 128))
    RUN_INTLV_TEST(hifloat8, hifloat8_t, (i % 10))
    RUN_INTLV_TEST(fp8_e8m0, fp8_e8m0_t, (float)(i % 10))
    RUN_INTLV_TEST(fp8_e5m2, fp8_e5m2_t, (float)(i % 10))
    RUN_INTLV_TEST(fp8_e4m3fn, fp8_e4m3fn_t, (float)(i % 10))
    RUN_INTLV_TEST(int16, int16_t, (i % 128))
    RUN_INTLV_TEST(uint16, uint16_t, (i % 128))
    RUN_INTLV_TEST(half, half, (i % 128))
    RUN_INTLV_TEST(bfloat16, bfloat16_t, (i % 128))
    RUN_INTLV_TEST(int32, int32_t, (i % 128))
    RUN_INTLV_TEST(uint32, uint32_t, (i % 128))
    RUN_INTLV_TEST(float, float, (i % 128))

    // mask variants - verify run
    run_asc_intlv_b8(stream); failed += verify_run("asc_intlv_b8");
    run_asc_intlv_b16(stream); failed += verify_run("asc_intlv_b16");
    run_asc_intlv_b32(stream); failed += verify_run("asc_intlv_b32");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
