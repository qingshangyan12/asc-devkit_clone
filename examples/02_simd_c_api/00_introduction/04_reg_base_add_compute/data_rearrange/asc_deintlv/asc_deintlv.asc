#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_deintlv_vf(__ubuf__ float* dst0, __ubuf__ float* dst1, __ubuf__ float* src, uint32_t data_len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (data_len + one_rep - 1) / one_rep;
    uint32_t remaining = data_len;
    vector_bool mask; vector_float rs0, rs1;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (remaining > one_rep) ? one_rep : remaining;
        uint32_t mc = n;
        mask = asc_update_mask_b32(mc);
        asc_load(rs0, src + i * one_rep); asc_load(rs1, src + i * one_rep);
        asc_deintlv(rd0, rd1, rs0, rs1);
        asc_store(dst0 + i * one_rep, rd0, n);
        asc_store(dst1 + i * one_rep, rd1, n);
        remaining = (remaining > one_rep) ? (remaining - one_rep) : 0;
    }
}

__vector__ __global__ void asc_deintlv_custom(__gm__ float* src, __gm__ float* dst0, __gm__ float* dst1)
{
    asc_init();
    constexpr uint32_t bl = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mtx = 1;
    __gm__ float* sg = src + block_idx * bl; __gm__ float* d0g = dst0 + block_idx * bl; __gm__ float* d1g = dst1 + block_idx * bl;
    __ubuf__ float sl[bl], d0l[bl], d1l[bl];
    uint8_t cm0=(uint8_t)(((uint64_t)sg)>>60), cm2=(uint8_t)(((uint64_t)d0g)>>60), cm3=(uint8_t)(((uint64_t)d1g)>>60);
    uint32_t blen=bl*sizeof(float); uint64_t ss=0; uint32_t ds=0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)sl, sg, BLK_NUM, blen, 0,0,true,cm0,ss,ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx); asc_deintlv_vf((__ubuf__ float*)d0l,(__ubuf__ float*)d1l,(__ubuf__ float*)sl,bl); asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(d0g,(__ubuf__ float*)d0l,BLK_NUM,blen,cm2,ss,ds);
    asc_copy_ub2gm_align(d1g,(__ubuf__ float*)d1l,BLK_NUM,blen,cm3,ss,ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<float> kernel_asc_deintlv_0(std::vector<float>& src)
{
    constexpr uint32_t nb = NUM_BLOCKS; size_t bs = src.size()*sizeof(float); int32_t did=0;
    uint8_t *sh=(uint8_t*)src.data(), *d0h=nullptr,*d1h=nullptr; float *sd=nullptr,*d0d=nullptr,*d1d=nullptr;
    aclInit(nullptr); aclrtSetDevice(did);
    aclrtMallocHost((void**)(&d0h),bs); aclrtMallocHost((void**)(&d1h),bs);
    aclrtMalloc((void**)&sd,bs,ACL_MEM_MALLOC_HUGE_FIRST); aclrtMalloc((void**)&d0d,bs,ACL_MEM_MALLOC_HUGE_FIRST); aclrtMalloc((void**)&d1d,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)sd,bs,sh,bs,ACL_MEMCPY_HOST_TO_DEVICE);
    asc_deintlv_custom<<<nb,0>>>(sd,d0d,d1d); aclrtSynchronizeDevice();
    aclrtMemcpy(d0h,bs,(uint8_t*)d0d,bs,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> d0((float*)d0h,(float*)(d0h+bs));
    aclrtFree(sd); aclrtFree(d0d); aclrtFree(d1d); aclrtFreeHost(d0h); aclrtFreeHost(d1h);
    aclrtResetDevice(did); aclFinalize(); return d0;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<float> src(total_length);
    for (uint32_t i = 0; i < total_length; ++i) src[i] = (float)(i * 0.1f);
    auto output = kernel_asc_deintlv_0(src);
    std::vector<float> golden(total_length);
    for (uint32_t i = 0; i < total_length / 2; ++i) { golden[i] = src[2*i]; }
    return verify_result(output, golden);
}