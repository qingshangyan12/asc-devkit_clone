/* !
 * \file c_api_asc_arange.asc
 * \brief
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_arange_vf(
    __ubuf__ int8_t* dst_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(int8_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_int8_t reg_dst;
    uint32_t elem_offset = 0;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_arange(reg_dst, (int8_t)elem_offset);
        asc_store(dst_local + i * one_rep_size, reg_dst);
        elem_offset += one_rep_size;
    }
}

__vector__ __global__ void asc_arange_custom(__gm__ int8_t* dst)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;

    __gm__ int8_t* dst_gm = dst + block_idx * block_length;

    __ubuf__ int8_t dst_local[block_length];

    const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t burst_length = block_length * sizeof(int8_t);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_arange_vf((__ubuf__ int8_t*)dst_local, block_length);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ int8_t*)dst_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<int8_t> kernel_asc_arange(uint32_t total_length)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    size_t dst_byte_size = total_length * sizeof(int8_t);
    int32_t device_id = 0;
    uint8_t* dst_host = nullptr;
    int8_t* dst_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_host), dst_byte_size);
    aclrtMalloc((void**)&dst_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    asc_arange_custom<<<num_blocks, 0>>>(dst_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_host, dst_byte_size, (uint8_t*)dst_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> dst((int8_t*)dst_host, (int8_t*)(dst_host + dst_byte_size));

    aclrtFree(dst_device);
    aclrtFreeHost(dst_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return dst;
}

uint32_t verify_result(std::vector<int8_t>& output, std::vector<int8_t>& golden)
{
    auto print_tensor = [](auto& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<int8_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<int8_t> output = kernel_asc_arange(total_length);
    std::vector<int8_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        golden[i] = static_cast<int8_t>(i);
    }
    return verify_result(output, golden);
}
