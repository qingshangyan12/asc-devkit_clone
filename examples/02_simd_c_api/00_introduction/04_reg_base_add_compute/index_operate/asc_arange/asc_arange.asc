#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_arange_vf(__ubuf__ int8_t* dst, uint32_t data_len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int8_t);
    uint16_t reps = (data_len + one_rep - 1) / one_rep;
    uint32_t remaining = data_len;
    vector_bool mask; vector_int8_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (remaining > one_rep) ? one_rep : remaining;
        uint32_t mc = n;
        mask = asc_update_mask_b8(mc);
        asc_arange(rd, (int8_t)0, mask);
        asc_store(dst + i * one_rep, rd, n);
        remaining = (remaining > one_rep) ? (remaining - one_rep) : 0;
    }
}

__vector__ __global__ void asc_arange_custom(__gm__ int8_t* dst)
{
    asc_init();
    constexpr uint32_t bl = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mtx = 1;
    __gm__ int8_t* dg = dst + block_idx * bl;
    __ubuf__ int8_t dl[bl];
    uint8_t cm2=(uint8_t)(((uint64_t)dg)>>60);
    uint32_t blen=bl*sizeof(int8_t); uint64_t ss=0; uint32_t ds=0;
    asc_lock(PIPE_V, mtx); asc_arange_vf((__ubuf__ int8_t*)dl,bl); asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx); asc_copy_ub2gm_align(dg,(__ubuf__ int8_t*)dl,BLK_NUM,blen,cm2,ss,ds); asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int8_t> kernel_asc_arange()
{
    constexpr uint32_t nb = NUM_BLOCKS; uint32_t tl = TOTAL_LENGTH; size_t bs=tl*sizeof(int8_t); int32_t did=0;
    uint8_t* dh=nullptr; int8_t* dd=nullptr;
    aclInit(nullptr); aclrtSetDevice(did);
    aclrtMallocHost((void**)(&dh),bs); aclrtMalloc((void**)&dd,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    asc_arange_custom<<<nb,0>>>(dd); aclrtSynchronizeDevice();
    aclrtMemcpy(dh,bs,(uint8_t*)dd,bs,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> d((int8_t*)dh,(int8_t*)(dh+bs));
    aclrtFree(dd); aclrtFreeHost(dh); aclrtResetDevice(did); aclFinalize(); return d;
}

uint32_t verify_result(std::vector<int8_t>& output, std::vector<int8_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    auto output = kernel_asc_arange();
    std::vector<int8_t> golden(total_length, (int8_t)0);
    return verify_result(output, golden);
}