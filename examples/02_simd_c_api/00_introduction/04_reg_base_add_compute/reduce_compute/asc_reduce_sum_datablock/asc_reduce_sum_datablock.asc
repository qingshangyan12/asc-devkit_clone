#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLOCK_LENGTH = TOTAL_LENGTH / NUM_BLOCKS;
typedef int8_t TYPE;

__simd_vf__ inline void reduce_sum_datablock_vf(__ubuf__ TYPE* dst_local, __ubuf__ TYPE* src0_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(TYPE);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = data_len;
    vector_bool vmask;
    vector_TYPE reg_src0; vector_TYPE reg_dst; vector_TYPE reg_acc;
    asc_setzero(reg_acc);
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t cur_count = (remaining > one_rep_size) ? one_rep_size : remaining;
        uint32_t mask_cnt = cur_count;
        vmask = asc_update_mask_b8(mask_cnt);
        asc_load(reg_src0, src0_local + i * one_rep_size);
        asc_add(reg_acc, reg_acc, reg_src0, vmask);
        remaining = (remaining > one_rep_size) ? (remaining - one_rep_size) : 0;
    }
    uint32_t db_length = data_len / 2;
    vector_TYPE reg_db;
    asc_reduce_sum_datablock(reg_dst, reg_acc, reg_db, 1, db_length);
    asc_store(dst_local, reg_dst, 1);
}

__vector__ __global__ void reduce_sum_datablock_custom(__gm__ TYPE* src0, __gm__ TYPE* dst)
{
    asc_init();
    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;
    __gm__ TYPE* src0_gm = src0 + asc_get_block_idx() * block_length;
    __gm__ TYPE* dst_gm = dst + asc_get_block_idx();
    __ubuf__ TYPE src0_local[block_length];
    __ubuf__ TYPE dst_local[1];
    uint32_t cache_mode0 = 0; uint32_t cache_mode2 = 0;
    uint32_t src_burst = block_length * sizeof(TYPE);
    uint32_t dst_burst = 1 * sizeof(TYPE);
    uint64_t src_stride = 0; uint32_t dst_stride = 0;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align((__ubuf__ TYPE*)src0_local, src0_gm, BLK_NUM, src_burst, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    reduce_sum_datablock_vf((__ubuf__ TYPE*)dst_local, src0_local, block_length);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ TYPE*)dst_local, BLK_NUM, dst_burst, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<TYPE> kernel_reduce_sum_datablock(std::vector<TYPE>& src0)
{
    constexpr uint32_t numBlocks = NUM_BLOCKS;
    uint32_t totalLength = TOTAL_LENGTH;
    size_t srcByteSize = totalLength * sizeof(TYPE);
    size_t dstByteSize = numBlocks * sizeof(TYPE);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* src0Host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* dstHost = nullptr;
    TYPE* src0Device = nullptr;
    TYPE* dstDevice = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)(&dstHost), dstByteSize);
    aclrtMalloc((void**)&src0Device, srcByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, dstByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)src0Device, srcByteSize, src0Host, srcByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    reduce_sum_datablock_custom<<<numBlocks, 0, stream>>>(src0Device, dstDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstHost, dstByteSize, (uint8_t*)dstDevice, dstByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<TYPE> dst((TYPE*)dstHost, (TYPE*)(dstHost + dstByteSize));
    aclrtFree(src0Device);
    aclrtFree(dstDevice);
    aclrtFreeHost(dstHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return dst;
}

uint32_t VerifyResult(std::vector<TYPE>& output, std::vector<TYPE>& golden)
{
    auto printTensor = [](std::vector<TYPE>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        for (size_t i = 0; i < std::min(tensor.size(), maxPrintSize); ++i) {
            std::cout << (int)tensor[i] << " ";
        }
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalLength = TOTAL_LENGTH;
    constexpr uint32_t numBlocks = NUM_BLOCKS;
    constexpr uint32_t blockLength = totalLength / numBlocks;
    std::vector<TYPE> src0(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        src0[i] = (i % 127) + 1;
    }
    std::vector<TYPE> output = kernel_reduce_sum_datablock(src0);
    std::vector<TYPE> golden(numBlocks);
    for (uint32_t b = 0; b < numBlocks; ++b) {
        TYPE sum = 0;
        for (uint32_t i = b * blockLength; i < (b + 1) * blockLength; ++i) {
            sum += src0[i];
        }
        golden[b] = sum;
    }
    return VerifyResult(output, golden);
}