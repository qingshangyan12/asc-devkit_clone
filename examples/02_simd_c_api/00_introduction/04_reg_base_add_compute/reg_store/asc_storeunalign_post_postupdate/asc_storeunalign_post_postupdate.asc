constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_storeunalign_post_postupdate_vf(
    __ubuf__ float* dst_local, __ubuf__ float* src_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = data_len;

    vector_float reg_src;
    vector_store_unalign ureg;
    __ubuf__ float* dst_ptr = dst_local;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t cur_count = (remaining > one_rep_size) ? one_rep_size : remaining;
        asc_loadalign(reg_src, src_local + i * one_rep_size);
        asc_storeunalign_postupdate(dst_ptr, ureg, reg_src, one_rep_size);
        remaining = (remaining > one_rep_size) ? (remaining - one_rep_size) : 0;
    }
    asc_storeunalign_post_postupdate(dst_ptr, ureg, 0);
}

__vector__ __global__ void asc_storeunalign_post_postupdate_custom(__gm__ float* src, __gm__ float* dst)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;

    __gm__ float* src_gm = src + block_idx * block_length;
    __gm__ float* dst_gm = dst + block_idx * block_length;

    __ubuf__ float src_local[block_length];
    __ubuf__ float dst_local[block_length];

    const uint8_t cache_mode0 = static_cast<uint8_t>(((uint64_t)src_gm) >> 60);
    const uint8_t cache_mode1 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t src_burst_length = block_length * sizeof(float);
    uint32_t dst_burst_length = block_length * sizeof(float);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align(
        (__ubuf__ float*)src_local, src_gm, BLK_NUM, src_burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_storeunalign_post_postupdate_vf((__ubuf__ float*)dst_local, (__ubuf__ float*)src_local, block_length);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ float*)dst_local, BLK_NUM, dst_burst_length, cache_mode1, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<float> kernel_asc_storeunalign_post_postupdate(std::vector<float>& src)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src.size();
    size_t src_byte_size = total_length * sizeof(float);
    size_t dst_byte_size = total_length * sizeof(float);
    int32_t device_id = 0;
    uint8_t* src_host = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dst_host = nullptr;
    float* src_device = nullptr;
    float* dst_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_host), dst_byte_size);
    aclrtMalloc((void**)&src_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src_device, src_byte_size, src_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    asc_storeunalign_post_postupdate_custom<<<num_blocks, 0>>>(src_device, dst_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_host, dst_byte_size, (uint8_t*)dst_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> dst((float*)dst_host, (float*)(dst_host + dst_byte_size));

    aclrtFree(src_device);
    aclrtFree(dst_device);
    aclrtFreeHost(dst_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return dst;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](auto& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<float> src(total_length);

    for (uint32_t i = 0; i < total_length; ++i) {
        src[i] = static_cast<float>(i * 0.1f);
    }
    std::vector<float> output = kernel_asc_storeunalign_post_postupdate(src);
    std::vector<float> golden = src;
    return verify_result(output, golden);
}
