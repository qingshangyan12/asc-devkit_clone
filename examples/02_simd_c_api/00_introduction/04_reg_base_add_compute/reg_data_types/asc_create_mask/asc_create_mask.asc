/* !
 * \file asc_create_mask.asc
 * \brief Sample covering ALL documented overloads of asc_create_mask
 */


#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;


__simd_vf__ inline void asc_create_mask_b8_vf(__ubuf__ uint32_t* d, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / 32;
    uint16_t reps = (len + one_rep - 1) / one_rep;
    vector_bool vmask = asc_create_mask_b8(PAT_ALL);
    vector_bool rd = vmask;
    for (uint16_t i = 0; i < reps; ++i) {
        asc_storealign(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_create_mask_b8_kernel(__gm__ uint32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __ubuf__ uint32_t dl[bl];
    uint32_t blen = bl * sizeof(uint32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, 1);
    asc_create_mask_b8_vf((__ubuf__ uint32_t*)dl, bl);
    asc_unlock(PIPE_V, 1);
    asc_lock(PIPE_MTE3, 1);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, bl * sizeof(uint32_t));
    asc_unlock(PIPE_MTE3, 1);
}


__simd_vf__ inline void asc_create_mask_b16_vf(__ubuf__ uint32_t* d, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / 32;
    uint16_t reps = (len + one_rep - 1) / one_rep;
    vector_bool vmask = asc_create_mask_b16(PAT_ALL);
    vector_bool rd = vmask;
    for (uint16_t i = 0; i < reps; ++i) {
        asc_storealign(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_create_mask_b16_kernel(__gm__ uint32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __ubuf__ uint32_t dl[bl];
    uint32_t blen = bl * sizeof(uint32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, 1);
    asc_create_mask_b16_vf((__ubuf__ uint32_t*)dl, bl);
    asc_unlock(PIPE_V, 1);
    asc_lock(PIPE_MTE3, 1);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, bl * sizeof(uint32_t));
    asc_unlock(PIPE_MTE3, 1);
}


__simd_vf__ inline void asc_create_mask_b32_vf(__ubuf__ uint32_t* d, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / 32;
    uint16_t reps = (len + one_rep - 1) / one_rep;
    vector_bool vmask = asc_create_mask_b32(PAT_ALL);
    vector_bool rd = vmask;
    for (uint16_t i = 0; i < reps; ++i) {
        asc_storealign(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_create_mask_b32_kernel(__gm__ uint32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __ubuf__ uint32_t dl[bl];
    uint32_t blen = bl * sizeof(uint32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, 1);
    asc_create_mask_b32_vf((__ubuf__ uint32_t*)dl, bl);
    asc_unlock(PIPE_V, 1);
    asc_lock(PIPE_MTE3, 1);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, bl * sizeof(uint32_t));
    asc_unlock(PIPE_MTE3, 1);
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}


int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr); aclrtSetDevice(0); aclrtStream stream = nullptr; aclrtCreateStream(&stream);
    uint32_t failed = 0;


    { // b8
        uint32_t tl = SAMP_ELEM_NUM; size_t bs = tl * sizeof(uint32_t);
        uint32_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_create_mask_b8_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bs));
        std::vector<uint32_t> golden(SAMP_ELEM_NUM, 0xFFFFFFFF);
        failed += verify_result(result, golden, "asc_create_mask b8");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b16
        uint32_t tl = SAMP_ELEM_NUM; size_t bs = tl * sizeof(uint32_t);
        uint32_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_create_mask_b16_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bs));
        std::vector<uint32_t> golden(SAMP_ELEM_NUM, 0xFFFFFFFF);
        failed += verify_result(result, golden, "asc_create_mask b16");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b32
        uint32_t tl = SAMP_ELEM_NUM; size_t bs = tl * sizeof(uint32_t);
        uint32_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_create_mask_b32_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bs));
        std::vector<uint32_t> golden(SAMP_ELEM_NUM, 0xFFFFFFFF);
        failed += verify_result(result, golden, "asc_create_mask b32");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
