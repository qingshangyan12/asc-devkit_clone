/* !
 * \file asc_update_addr_reg.asc
 * \brief Sample covering ALL documented overloads of asc_update_addr_reg
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__vector__ __global__ void asc_update_addr_reg_b8_1p_kernel(__gm__ uint8_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    __gm__ uint8_t* gd = d + block_idx * bl;
    __ubuf__ uint8_t dl[bl];
    uint32_t blen = bl; uint64_t ss = 0; uint32_t ds = 0;
    addr_reg ar = asc_update_addr_reg_b8(0);
    vector_uint8_t r0;
    asc_loadalign(r0, (__ubuf__ uint8_t*)dl);
    asc_store(d, r0, bl);
    asc_lock(PIPE_MTE3, 1);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, 1);
}


