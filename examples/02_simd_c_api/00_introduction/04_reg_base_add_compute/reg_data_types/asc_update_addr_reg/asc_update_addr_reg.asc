/* !
 * \file asc_update_addr_reg.asc
 * \brief 演示使用asc_update_addr_reg接口更新地址寄存器，配合loadalign/storealign实现迭代寻址
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void update_addr_reg_vf(__ubuf__ float* dst_local, __ubuf__ float* src_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    vector_bool vmask = asc_create_mask_b32(PAT_ALL);
    vector_float reg_src;
    vector_float reg_dst;
    addr_reg offset;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        offset = asc_update_addr_reg_b32(one_rep_size);
        asc_loadalign(reg_src, src_local, offset);
        asc_add(reg_dst, reg_src, reg_src, vmask);
        asc_storealign(dst_local, reg_dst, offset, vmask);
    }
}

__vector__ __global__ void update_addr_reg_custom(__gm__ float* src, __gm__ float* dst)
{
    asc_init();
        constexpr uint8_t mutex_id = 1;
    __gm__ float* src_gm = src + block_idx * block_length;
    __gm__ float* dst_gm = dst + block_idx * block_length;
    __ubuf__ float src_local[block_length];
    __ubuf__ float dst_local[block_length];
    asc_load_l2_cache_mode cache_mode0 = asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM;
    asc_store_l2_cache_mode cache_mode2 = asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM;
    uint32_t src_burst = block_length * sizeof(float);
    uint32_t dst_burst = block_length * sizeof(float);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align((__ubuf__ float*)src_local, src_gm, BLK_NUM, src_burst, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    update_addr_reg_vf((__ubuf__ float*)dst_local, src_local, block_length);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ float*)dst_local, BLK_NUM, dst_burst, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<float> kernel_update_addr_reg(std::vector<float>& src_data)
{
    constexpr uint32_t numBlocks = NUM_BLOCKS;
    uint32_t totalLength = TOTAL_LENGTH;
    size_t srcByteSize = totalLength * sizeof(float);
    size_t dstByteSize = totalLength * sizeof(float);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src_data.data());
    uint8_t* dstHost = nullptr;
    float* srcDevice = nullptr;
    float* dstDevice = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)(&dstHost), dstByteSize);
    aclrtMalloc((void**)&srcDevice, srcByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, dstByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)srcDevice, srcByteSize, srcHost, srcByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    update_addr_reg_custom<<<numBlocks, 0, stream>>>(srcDevice, dstDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstHost, dstByteSize, (uint8_t*)dstDevice, dstByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> dst((float*)dstHost, (float*)(dstHost + dstByteSize));
    aclrtFree(srcDevice);
    aclrtFree(dstDevice);
    aclrtFreeHost(dstHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return dst;
}

uint32_t VerifyResult(std::vector<float>& output, std::vector<float>& golden)
{
    auto printTensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        for (size_t i = 0; i < std::min(tensor.size(), maxPrintSize); ++i) {
            std::cout << tensor[i] << " ";
        }
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalLength = TOTAL_LENGTH;
    std::vector<float> src(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        src[i] = i * 0.1f;
    }
    std::vector<float> output = kernel_update_addr_reg(src);
    std::vector<float> golden(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        golden[i] = src[i] + src[i];
    }
    return VerifyResult(output, golden);
}
