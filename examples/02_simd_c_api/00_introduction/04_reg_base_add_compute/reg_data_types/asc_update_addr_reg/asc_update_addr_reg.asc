template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}


int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr); aclrtSetDevice(0); aclrtStream stream = nullptr; aclrtCreateStream(&stream);
    uint32_t failed = 0;


    { // b8_1p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b8_1p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b8_1p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b8_2p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b8_2p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b8_2p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b8_3p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b8_3p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b8_3p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b8_4p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b8_4p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b8_4p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b16_1p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b16_1p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b16_1p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b16_2p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b16_2p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b16_2p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b16_3p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b16_3p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b16_3p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b16_4p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b16_4p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b16_4p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b32_1p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b32_1p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b32_1p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b32_2p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
