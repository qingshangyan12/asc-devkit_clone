        aclrtFree(dd); aclrtFreeHost(dh);
    }


    { // b32_4p
        uint32_t tl = ELEM_NUM; size_t bs = tl;
        uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); aclrtMallocHost((void**)&dh, bs);
        asc_update_addr_reg_b32_4p_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        std::vector<uint8_t> golden(ELEM_NUM, 0);
        failed += verify_result(result, golden, "asc_update_addr_reg b32_4p");
        aclrtFree(dd); aclrtFreeHost(dh);
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
