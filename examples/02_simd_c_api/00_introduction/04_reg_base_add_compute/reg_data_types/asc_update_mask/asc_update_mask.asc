#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_update_mask_vf(__ubuf__ float* dst, __ubuf__ float* src0, __ubuf__ float* src1, uint32_t data_len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (data_len + one_rep - 1) / one_rep;
    uint32_t remaining = data_len;
    vector_bool vmask; vector_float rs0, rs1, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (remaining > one_rep) ? one_rep : remaining;
        uint32_t mc = n;
        vmask = asc_update_mask_b32(mc);
        asc_load(rs0, src0 + i * one_rep); asc_load(rs1, src1 + i * one_rep);
        asc_add(rd, rs0, rs1, vmask);
        asc_store(dst + i * one_rep, rd, n);
        remaining = (remaining > one_rep) ? (remaining - one_rep) : 0;
    }
}

__vector__ __global__ void asc_update_mask_custom(__gm__ float* src0, __gm__ float* src1, __gm__ float* dst)
{
    asc_init();
    constexpr uint32_t bl = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mtx = 1;
    __gm__ float* s0g = src0 + block_idx * bl; __gm__ float* s1g = src1 + block_idx * bl; __gm__ float* dg = dst + block_idx * bl;
    __ubuf__ float s0l[bl], s1l[bl], dl[bl];
    uint8_t cm0=(uint8_t)(((uint64_t)s0g)>>60), cm1=(uint8_t)(((uint64_t)s1g)>>60), cm2=(uint8_t)(((uint64_t)dg)>>60);
    uint32_t blen=bl*sizeof(float); uint64_t ss=0; uint32_t ds=0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)s0l,s0g,BLK_NUM,blen,0,0,true,cm0,ss,ds);
    asc_copy_gm2ub_align((__ubuf__ float*)s1l,s1g,BLK_NUM,blen,0,0,true,cm1,ss,ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx); asc_update_mask_vf((__ubuf__ float*)dl,(__ubuf__ float*)s0l,(__ubuf__ float*)s1l,bl); asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx); asc_copy_ub2gm_align(dg,(__ubuf__ float*)dl,BLK_NUM,blen,cm2,ss,ds); asc_unlock(PIPE_MTE3, mtx);
}

std::vector<float> kernel_asc_update_mask(std::vector<float>& src0, std::vector<float>& src1)
{
    constexpr uint32_t nb = NUM_BLOCKS; size_t bs = src0.size()*sizeof(float); int32_t did=0;
    uint8_t *s0h=(uint8_t*)src0.data(), *s1h=(uint8_t*)src1.data(), *dh=nullptr; float *s0d=nullptr,*s1d=nullptr,*dd=nullptr;
    aclInit(nullptr); aclrtSetDevice(did);
    aclrtMallocHost((void**)(&dh),bs); aclrtMalloc((void**)&s0d,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d,bs,ACL_MEM_MALLOC_HUGE_FIRST); aclrtMalloc((void**)&dd,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)s0d,bs,s0h,bs,ACL_MEMCPY_HOST_TO_DEVICE); aclrtMemcpy((uint8_t*)s1d,bs,s1h,bs,ACL_MEMCPY_HOST_TO_DEVICE);
    asc_update_mask_custom<<<nb,0>>>(s0d,s1d,dd); aclrtSynchronizeDevice();
    aclrtMemcpy(dh,bs,(uint8_t*)dd,bs,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> d((float*)dh,(float*)(dh+bs));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dh);
    aclrtResetDevice(did); aclFinalize(); return d;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<float> src0(total_length), src1(total_length);
    for (uint32_t i = 0; i < total_length; ++i) { src0[i] = i * 0.1f; src1[i] = i * 0.1f; }
    auto output = kernel_asc_update_mask(src0, src1);
    std::vector<float> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) golden[i] = src0[i] + src1[i];
    return verify_result(output, golden);
}