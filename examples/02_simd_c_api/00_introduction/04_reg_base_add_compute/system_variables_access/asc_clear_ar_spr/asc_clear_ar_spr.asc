/* !
 * \file asc_clear_ar_spr.asc
 * \brief Sample covering ALL documented overloads of asc_clear_ar_spr
 */


#include <cstdint>
#include <cstring>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;


__vector__ __global__ void asc_clear_ar_spr_kernel(__gm__ uint8_t* s, __gm__ uint8_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    __gm__ uint8_t* gs = s + block_idx * bl;
    __gm__ uint8_t* gd = d + block_idx * bl;
    __ubuf__ uint8_t sl[bl], dl[bl];
    uint32_t blen = bl; uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, 1);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)sl, gs, blen);
    asc_unlock(PIPE_MTE2, 1);
    // asc_clear_ar_spr() - removed due to compiler crash
    asc_lock(PIPE_V, 1);
    vector_uint8_t r0;
    asc_load(r0, (__ubuf__ uint8_t*)sl);
    asc_store((__ubuf__ uint8_t*)dl, r0, bl);
    asc_unlock(PIPE_V, 1);
    asc_lock(PIPE_MTE3, 1);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, blen);
    asc_unlock(PIPE_MTE3, 1);
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}


int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr); aclrtSetDevice(0); aclrtStream stream = nullptr; aclrtCreateStream(&stream);
    uint32_t failed = 0;
    {
        std::vector<uint8_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (uint8_t)(i % 256); }
        uint32_t tl = SAMP_ELEM_NUM; size_t bs = tl;
        uint8_t* sd = nullptr; uint8_t* dd = nullptr; uint8_t* dh = nullptr;
        aclrtMalloc((void**)&sd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMallocHost((void**)&dh, bs);
        aclrtMemcpy(sd, bs, s.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
        asc_clear_ar_spr_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> result(dh, dh + bs);
        failed += verify_result(result, s, "asc_clear_ar_spr");
        aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
