/* !
 * \file c_api_asc_mull.asc
 * \brief
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_mull_vf(
    __ubuf__ int32_t* dst_hi_local, __ubuf__ int32_t* dst_lo_local, __ubuf__ int32_t* src0_local, __ubuf__ int32_t* src1_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(int32_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask;
    vector_int32_t reg_src0;
    vector_int32_t reg_src1;
    vector_int32_t reg_dst_hi;
    vector_int32_t reg_dst_lo;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(reg_src0, src0_local + i * one_rep_size);
        asc_load(reg_src1, src1_local + i * one_rep_size);
        asc_mull(reg_dst_hi, reg_dst_lo, reg_src0, reg_src1, vmask);
        asc_store(dst_hi_local + i * one_rep_size, reg_dst_hi);
        asc_store(dst_lo_local + i * one_rep_size, reg_dst_lo);
    }
}

__vector__ __global__ void asc_mull_custom(__gm__ int32_t* src0, __gm__ int32_t* src1, __gm__ int32_t* dst_hi, __gm__ int32_t* dst_lo)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;

    __gm__ int32_t* src0_gm = src0 + block_idx * block_length;
    __gm__ int32_t* src1_gm = src1 + block_idx * block_length;
    __gm__ int32_t* dst_hi_gm = dst_hi + block_idx * block_length;
    __gm__ int32_t* dst_lo_gm = dst_lo + block_idx * block_length;

    __ubuf__ int32_t src0_local[block_length];
    __ubuf__ int32_t src1_local[block_length];
    __ubuf__ int32_t dst_hi_local[block_length];
    __ubuf__ int32_t dst_lo_local[block_length];

    const uint8_t cache_mode0 = static_cast<uint8_t>(((uint64_t)src0_gm) >> 60);
    const uint8_t cache_mode1 = static_cast<uint8_t>(((uint64_t)src1_gm) >> 60);
    const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dst_hi_gm) >> 60);
    const uint8_t cache_mode3 = static_cast<uint8_t>(((uint64_t)dst_lo_gm) >> 60);
    uint32_t burst_length = block_length * sizeof(int32_t);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align(
        (__ubuf__ int32_t*)src0_local, src0_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_copy_gm2ub_align(
        (__ubuf__ int32_t*)src1_local, src1_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode1, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_mull_vf((__ubuf__ int32_t*)dst_hi_local, (__ubuf__ int32_t*)dst_lo_local, (__ubuf__ int32_t*)src0_local, (__ubuf__ int32_t*)src1_local, block_length);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_hi_gm, (__ubuf__ int32_t*)dst_hi_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride);
    asc_copy_ub2gm_align(dst_lo_gm, (__ubuf__ int32_t*)dst_lo_local, BLK_NUM, burst_length, cache_mode3, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::pair<std::vector<int32_t>, std::vector<int32_t>> kernel_asc_mull(std::vector<int32_t>& src0, std::vector<int32_t>& src1)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src0.size();
    size_t src_byte_size = total_length * sizeof(int32_t);
    size_t dst_byte_size = total_length * sizeof(int32_t);
    int32_t device_id = 0;
    uint8_t* src0_host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* src1_host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* dst_hi_host = nullptr;
    uint8_t* dst_lo_host = nullptr;
    int32_t* src0_device = nullptr;
    int32_t* src1_device = nullptr;
    int32_t* dst_hi_device = nullptr;
    int32_t* dst_lo_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_hi_host), dst_byte_size);
    aclrtMallocHost((void**)(&dst_lo_host), dst_byte_size);
    aclrtMalloc((void**)&src0_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_hi_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_lo_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src0_device, src_byte_size, src0_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)src1_device, src_byte_size, src1_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    asc_mull_custom<<<num_blocks, 0>>>(src0_device, src1_device, dst_hi_device, dst_lo_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_hi_host, dst_byte_size, (uint8_t*)dst_hi_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dst_lo_host, dst_byte_size, (uint8_t*)dst_lo_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> dst_hi((int32_t*)dst_hi_host, (int32_t*)(dst_hi_host + dst_byte_size));
    std::vector<int32_t> dst_lo((int32_t*)dst_lo_host, (int32_t*)(dst_lo_host + dst_byte_size));

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst_hi_device);
    aclrtFree(dst_lo_device);
    aclrtFreeHost(dst_hi_host);
    aclrtFreeHost(dst_lo_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return {dst_hi, dst_lo};
}

uint32_t verify_result(std::vector<int32_t>& output_hi, std::vector<int32_t>& output_lo, std::vector<int64_t>& golden)
{
    auto print_tensor = [](auto& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<int64_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    std::vector<int64_t> result(output_hi.size());
    for (size_t i = 0; i < output_hi.size(); ++i) {
        result[i] = ((int64_t)(output_hi[i]) << 32) | ((int64_t)(output_lo[i]) & 0xFFFFFFFFLL);
    }
    print_tensor(result, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), result.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<int32_t> src0(total_length);
    std::vector<int32_t> src1(total_length);

    for (uint32_t i = 0; i < total_length; ++i) {
        src0[i] = static_cast<int32_t>(i * 0.1f);
        src1[i] = static_cast<int32_t>(i * 0.1f);
    }
    auto [output_hi, output_lo] = kernel_asc_mull(src0, src1);
    std::vector<int64_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        golden[i] = (int64_t)src0[i] * (int64_t)src1[i];
    }
    return verify_result(output_hi, output_lo, golden);
}
