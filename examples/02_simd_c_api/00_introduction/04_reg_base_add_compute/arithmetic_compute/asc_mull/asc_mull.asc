/* !
 * \file c_api_asc_mull.asc
 * \brief 演示 asc_mull 乘法取高低位：dst_lo=src0*src1（低32位），dst_hi=src0*src1（高32位），int32_t
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_mull_vf(
    __ubuf__ int32_t* dst_lo, __ubuf__ int32_t* dst_hi, __ubuf__ int32_t* src0, __ubuf__ int32_t* src1, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(int32_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = data_len;
    vector_bool vmask;
    vector_int32_t reg_src0, reg_src1, reg_dst_lo, reg_dst_hi;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t cur_count = (remaining > one_rep_size) ? one_rep_size : remaining;
        vmask = asc_update_mask_b32(cur_count);
        asc_load(reg_src0, src0 + i * one_rep_size);
        asc_load(reg_src1, src1 + i * one_rep_size);
        asc_mull(reg_dst_hi, reg_dst_lo, reg_src0, reg_src1, vmask);
        asc_store(dst_hi + i * one_rep_size, reg_dst_hi, cur_count);
        asc_store(dst_lo + i * one_rep_size, reg_dst_lo, cur_count);
        remaining = (remaining > one_rep_size) ? (remaining - one_rep_size) : 0;
    }
}

__vector__ __global__ void asc_mull_custom(
    __gm__ int32_t* src0, __gm__ int32_t* src1, __gm__ int32_t* dst_lo, __gm__ int32_t* dst_hi)
{
    asc_init();
    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;
    __gm__ int32_t* src0_gm = src0 + block_idx * block_length;
    __gm__ int32_t* src1_gm = src1 + block_idx * block_length;
    __gm__ int32_t* dst_lo_gm = dst_lo + block_idx * block_length;
    __gm__ int32_t* dst_hi_gm = dst_hi + block_idx * block_length;
    __ubuf__ int32_t src0_local[block_length], src1_local[block_length];
    __ubuf__ int32_t dst_lo_local[block_length], dst_hi_local[block_length];
    const uint8_t cm0 = static_cast<uint8_t>(((uint64_t)src0_gm) >> 60);
    const uint8_t cm1 = static_cast<uint8_t>(((uint64_t)src1_gm) >> 60);
    const uint8_t cm2 = static_cast<uint8_t>(((uint64_t)dst_lo_gm) >> 60);
    const uint8_t cm3 = static_cast<uint8_t>(((uint64_t)dst_hi_gm) >> 60);
    uint32_t blen = block_length * sizeof(int32_t);
    uint64_t src_stride = 0; uint32_t dst_stride = 0;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)src0_local, src0_gm, BLK_NUM, blen, 0, 0, true, cm0, src_stride, dst_stride);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)src1_local, src1_gm, BLK_NUM, blen, 0, 0, true, cm1, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    asc_mull_vf((__ubuf__ int32_t*)dst_lo_local, (__ubuf__ int32_t*)dst_hi_local,
        (__ubuf__ int32_t*)src0_local, (__ubuf__ int32_t*)src1_local, block_length);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_lo_gm, (__ubuf__ int32_t*)dst_lo_local, BLK_NUM, blen, cm2, src_stride, dst_stride);
    asc_copy_ub2gm_align(dst_hi_gm, (__ubuf__ int32_t*)dst_hi_local, BLK_NUM, blen, cm3, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<int32_t> kernel_asc_mull_lo(std::vector<int32_t>& src0, std::vector<int32_t>& src1)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    size_t byte_size = src0.size() * sizeof(int32_t); int32_t device_id = 0;
    uint8_t *s0h = reinterpret_cast<uint8_t*>(src0.data()), *s1h = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t *dl_h = nullptr, *dh_h = nullptr;
    int32_t *s0d = nullptr, *s1d = nullptr, *dl_d = nullptr, *dh_d = nullptr;
    aclInit(nullptr); aclrtSetDevice(device_id);
    aclrtMallocHost((void**)(&dl_h), byte_size); aclrtMallocHost((void**)(&dh_h), byte_size);
    aclrtMalloc((void**)&s0d, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dl_d, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dh_d, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)s0d, byte_size, s0h, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)s1d, byte_size, s1h, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_mull_custom<<<num_blocks, 0>>>(s0d, s1d, dl_d, dh_d); aclrtSynchronizeDevice();
    aclrtMemcpy(dl_h, byte_size, (uint8_t*)dl_d, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> dst_lo((int32_t*)dl_h, (int32_t*)(dl_h + byte_size));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dl_d); aclrtFree(dh_d);
    aclrtFreeHost(dl_h); aclrtFreeHost(dh_h);
    aclrtResetDevice(device_id); aclFinalize();
    return dst_lo;
}

uint32_t verify_result(std::vector<int32_t>& output, std::vector<int32_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<int32_t> src0(total_length), src1(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        src0[i] = static_cast<int32_t>(1000 + (i % 500));
        src1[i] = static_cast<int32_t>(2 + (i % 7));
    }
    std::vector<int32_t> output = kernel_asc_mull_lo(src0, src1);
    std::vector<int32_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) golden[i] = static_cast<int32_t>(src0[i] * src1[i]);
    return verify_result(output, golden);
}