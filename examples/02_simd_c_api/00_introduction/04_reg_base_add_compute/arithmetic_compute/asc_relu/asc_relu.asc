/* !
 * \file asc_relu.asc
 * \brief Sample covering ALL documented overloads of asc_relu
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_relu_half_vf(__ubuf__ half* d, __ubuf__ half* s0, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_half r0, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b16(n);
        asc_load(r0, s0 + i * one_rep);
        asc_relu(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_relu_half_kernel(__gm__ half* s0, __gm__ half* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ half* gs0 = s0 + block_idx * bl;
    __gm__ half* gd = d + block_idx * bl;
    __ubuf__ half s0l[bl], dl[bl];
    uint32_t blen = bl * sizeof(half); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ half*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_relu_half_vf((__ubuf__ half*)dl, (__ubuf__ half*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ half*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<half> run_asc_relu_half(std::vector<half>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(half);
    half* s0d = nullptr; half* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_relu_half_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> result((const half*)dh, (const half*)(dh + bs));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

__simd_vf__ inline void asc_relu_int32_vf(__ubuf__ int32_t* d, __ubuf__ int32_t* s0, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int32_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_int32_t r0, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(n);
        asc_load(r0, s0 + i * one_rep);
        asc_relu(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_relu_int32_kernel(__gm__ int32_t* s0, __gm__ int32_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ int32_t* gs0 = s0 + block_idx * bl;
    __gm__ int32_t* gd = d + block_idx * bl;
    __ubuf__ int32_t s0l[bl], dl[bl];
    uint32_t blen = bl * sizeof(int32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_relu_int32_vf((__ubuf__ int32_t*)dl, (__ubuf__ int32_t*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int32_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int32_t> run_asc_relu_int32(std::vector<int32_t>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(int32_t);
    int32_t* s0d = nullptr; int32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_relu_int32_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + bs));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

__simd_vf__ inline void asc_relu_float_vf(__ubuf__ float* d, __ubuf__ float* s0, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_float r0, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(n);
        asc_load(r0, s0 + i * one_rep);
        asc_relu(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_relu_float_kernel(__gm__ float* s0, __gm__ float* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ float* gs0 = s0 + block_idx * bl;
    __gm__ float* gd = d + block_idx * bl;
    __ubuf__ float s0l[bl], dl[bl];
    uint32_t blen = bl * sizeof(float); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_relu_float_vf((__ubuf__ float*)dl, (__ubuf__ float*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ float*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<float> run_asc_relu_float(std::vector<float>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(float);
    float* s0d = nullptr; float* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_relu_float_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> result((const float*)dh, (const float*)(dh + bs));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // half
        std::vector<half> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (half)((i % 200) - 100); }
        auto result = run_asc_relu_half(s0, stream);
        std::vector<half> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (half)(s0[i] > 0 ? s0[i] : 0); }
        failed += verify_result(result, golden, "asc_relu half");
    }

    { // int32
        std::vector<int32_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int32_t)((i % 200) - 100); }
        auto result = run_asc_relu_int32(s0, stream);
        std::vector<int32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (int32_t)(s0[i] > 0 ? s0[i] : 0); }
        failed += verify_result(result, golden, "asc_relu int32");
    }

    { // float
        std::vector<float> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (float)((i % 200) - 100); }
        auto result = run_asc_relu_float(s0, stream);
        std::vector<float> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (float)(s0[i] > 0 ? s0[i] : 0); }
        failed += verify_result(result, golden, "asc_relu float");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
