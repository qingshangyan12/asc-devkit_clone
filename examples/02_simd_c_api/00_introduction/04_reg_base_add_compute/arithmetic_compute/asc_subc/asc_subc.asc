/* !
 * \file c_api_asc_subc.asc
 * \brief 演示 asc_subc 带借位减法：dst+进位 = src0-src1，uint32_t
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_subc_vf(
    __ubuf__ uint32_t* dst_local, __ubuf__ uint32_t* src0_local, __ubuf__ uint32_t* src1_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(uint32_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = data_len;
    vector_bool vmask, carry_out;
    vector_uint32_t reg_src0, reg_src1, reg_dst;
    vector_bool carry_in = asc_create_mask_b32(PAT_ALLF);
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t cur_count = (remaining > one_rep_size) ? one_rep_size : remaining;
        vmask = asc_update_mask_b32(cur_count);
        asc_load(reg_src0, src0_local + i * one_rep_size);
        asc_load(reg_src1, src1_local + i * one_rep_size);
        asc_subc(carry_out, reg_dst, reg_src0, reg_src1, carry_in, vmask);
        asc_store(dst_local + i * one_rep_size, reg_dst, cur_count);
        remaining = (remaining > one_rep_size) ? (remaining - one_rep_size) : 0;
    }
}

__vector__ __global__ void asc_subc_custom(__gm__ uint32_t* src0, __gm__ uint32_t* src1, __gm__ uint32_t* dst)
{
    asc_init();
    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;
    __gm__ uint32_t* src0_gm = src0 + block_idx * block_length;
    __gm__ uint32_t* src1_gm = src1 + block_idx * block_length;
    __gm__ uint32_t* dst_gm = dst + block_idx * block_length;
    __ubuf__ uint32_t src0_local[block_length], src1_local[block_length], dst_local[block_length];
    const uint8_t cm0 = static_cast<uint8_t>(((uint64_t)src0_gm) >> 60);
    const uint8_t cm1 = static_cast<uint8_t>(((uint64_t)src1_gm) >> 60);
    const uint8_t cm2 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t blen = block_length * sizeof(uint32_t);
    uint64_t src_stride = 0; uint32_t dst_stride = 0;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)src0_local, src0_gm, BLK_NUM, blen, 0, 0, true, cm0, src_stride, dst_stride);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)src1_local, src1_gm, BLK_NUM, blen, 0, 0, true, cm1, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    asc_subc_vf((__ubuf__ uint32_t*)dst_local, (__ubuf__ uint32_t*)src0_local, (__ubuf__ uint32_t*)src1_local, block_length);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ uint32_t*)dst_local, BLK_NUM, blen, cm2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<uint32_t> kernel_asc_subc(std::vector<uint32_t>& src0, std::vector<uint32_t>& src1)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    size_t byte_size = src0.size() * sizeof(uint32_t); int32_t device_id = 0;
    uint8_t *s0h = reinterpret_cast<uint8_t*>(src0.data()), *s1h = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* dst_host = nullptr;
    uint32_t *s0d = nullptr, *s1d = nullptr, *dd = nullptr;
    aclInit(nullptr); aclrtSetDevice(device_id);
    aclrtMallocHost((void**)(&dst_host), byte_size);
    aclrtMalloc((void**)&s0d, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)s0d, byte_size, s0h, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)s1d, byte_size, s1h, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_subc_custom<<<num_blocks, 0>>>(s0d, s1d, dd); aclrtSynchronizeDevice();
    aclrtMemcpy(dst_host, byte_size, (uint8_t*)dd, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> dst((uint32_t*)dst_host, (uint32_t*)(dst_host + byte_size));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dst_host);
    aclrtResetDevice(device_id); aclFinalize(); return dst;
}

uint32_t verify_result(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<uint32_t> src0(total_length), src1(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        src0[i] = static_cast<uint32_t>(i * 10 + 1000);
        src1[i] = static_cast<uint32_t>(i % 500);
    }
    std::vector<uint32_t> output = kernel_asc_subc(src0, src1);
    std::vector<uint32_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) golden[i] = src0[i] - src1[i];
    return verify_result(output, golden);
}