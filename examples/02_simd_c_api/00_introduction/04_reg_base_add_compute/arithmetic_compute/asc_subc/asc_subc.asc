/* !
 * \file asc_subc.asc
 * \brief Sample covering ALL documented overloads of asc_subc
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_subc_uint32_vf(__ubuf__ uint32_t* carry_d, __ubuf__ uint32_t* d, __ubuf__ uint32_t* s0, __ubuf__ uint32_t* s1, __ubuf__ uint32_t* s2, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint32_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask, carry_rd, src2_reg; vector_uint32_t r0, r1, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(rem);
        asc_load(r0, s0 + i * one_rep);
        asc_load(r1, s1 + i * one_rep);
        asc_loadalign(src2_reg, s2 + i * one_rep);
        asc_subc(carry_rd, rd, r0, r1, src2_reg, vmask);
        asc_store(d + i * one_rep, rd);
        asc_storealign(carry_d + i * one_rep, carry_rd, vmask);
    }
}

__vector__ __global__ void asc_subc_uint32_kernel(__gm__ uint32_t* s0, __gm__ uint32_t* s1, __gm__ uint32_t* s2, __gm__ uint32_t* d, __gm__ uint32_t* carry_d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint32_t* gs0 = s0 + block_idx * bl;
    __gm__ uint32_t* gs1 = s1 + block_idx * bl;
    __gm__ uint32_t* gs2 = s2 + block_idx * bl;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __gm__ uint32_t* gcd = carry_d + block_idx * bl;
    __ubuf__ uint32_t s0l[bl], s1l[bl], dl[bl];
    __ubuf__ uint32_t s2l[bl], cdl[bl];
    uint32_t blen = bl * sizeof(uint32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)s1l, gs1, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)s2l, gs2, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_subc_uint32_vf((__ubuf__ uint32_t*)cdl, (__ubuf__ uint32_t*)dl, (__ubuf__ uint32_t*)s0l, (__ubuf__ uint32_t*)s1l, (__ubuf__ uint32_t*)s2l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_copy_ub2gm_align(gcd, (__ubuf__ uint32_t*)cdl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint32_t> run_asc_subc_uint32(std::vector<uint32_t>& s0, std::vector<uint32_t>& s1, std::vector<uint32_t>& s2, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(uint32_t); size_t bsc = tl * sizeof(uint32_t);
    uint32_t* s0d = nullptr; uint32_t* s1d = nullptr; uint32_t* s2d = nullptr; uint32_t* dd = nullptr; uint32_t* cdd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s2d, bsc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cdd, bsc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s2d, bsc, s2.data(), bsc, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_subc_uint32_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, s1d, s2d, dd, cdd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bs));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(s2d); aclrtFree(dd); aclrtFree(cdd); aclrtFreeHost(dh);
    return result;
}

__simd_vf__ inline void asc_subc_int32_vf(__ubuf__ uint32_t* carry_d, __ubuf__ int32_t* d, __ubuf__ int32_t* s0, __ubuf__ int32_t* s1, __ubuf__ uint32_t* s2, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int32_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask, carry_rd, src2_reg; vector_int32_t r0, r1, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(rem);
        asc_load(r0, s0 + i * one_rep);
        asc_load(r1, s1 + i * one_rep);
        asc_loadalign(src2_reg, s2 + i * one_rep);
        asc_subc(carry_rd, rd, r0, r1, src2_reg, vmask);
        asc_store(d + i * one_rep, rd);
        asc_storealign(carry_d + i * one_rep, carry_rd, vmask);
    }
}

__vector__ __global__ void asc_subc_int32_kernel(__gm__ int32_t* s0, __gm__ int32_t* s1, __gm__ uint32_t* s2, __gm__ int32_t* d, __gm__ uint32_t* carry_d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ int32_t* gs0 = s0 + block_idx * bl;
    __gm__ int32_t* gs1 = s1 + block_idx * bl;
    __gm__ uint32_t* gs2 = s2 + block_idx * bl;
    __gm__ int32_t* gd = d + block_idx * bl;
    __gm__ uint32_t* gcd = carry_d + block_idx * bl;
    __ubuf__ int32_t s0l[bl], s1l[bl], dl[bl];
    __ubuf__ uint32_t s2l[bl], cdl[bl];
    uint32_t blen = bl * sizeof(int32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)s1l, gs1, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)s2l, gs2, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_subc_int32_vf((__ubuf__ uint32_t*)cdl, (__ubuf__ int32_t*)dl, (__ubuf__ int32_t*)s0l, (__ubuf__ int32_t*)s1l, (__ubuf__ uint32_t*)s2l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int32_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_copy_ub2gm_align(gcd, (__ubuf__ uint32_t*)cdl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int32_t> run_asc_subc_int32(std::vector<int32_t>& s0, std::vector<int32_t>& s1, std::vector<uint32_t>& s2, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(int32_t); size_t bsc = tl * sizeof(uint32_t);
    int32_t* s0d = nullptr; int32_t* s1d = nullptr; uint32_t* s2d = nullptr; int32_t* dd = nullptr; uint32_t* cdd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s2d, bsc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cdd, bsc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s2d, bsc, s2.data(), bsc, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_subc_int32_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, s1d, s2d, dd, cdd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + bs));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(s2d); aclrtFree(dd); aclrtFree(cdd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // uint32
        std::vector<uint32_t> s0(ELEM_NUM), s1(ELEM_NUM);
        std::vector<uint32_t> s2(ELEM_NUM, 0);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint32_t)(i % 100 + 50); s1[i] = (uint32_t)(i % 100); }
        auto result = run_asc_subc_uint32(s0, s1, s2, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)(s0[i] - s1[i]); }
        failed += verify_result(result, golden, "asc_subc uint32");
    }

    { // int32
        std::vector<int32_t> s0(ELEM_NUM), s1(ELEM_NUM);
        std::vector<uint32_t> s2(ELEM_NUM, 0);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int32_t)(i % 100 + 50); s1[i] = (int32_t)(i % 100); }
        auto result = run_asc_subc_int32(s0, s1, s2, stream);
        std::vector<int32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (int32_t)(s0[i] - s1[i]); }
        failed += verify_result(result, golden, "asc_subc int32");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
