/* !
 * \file c_api_asc_unpack.asc
 * \brief
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t OUTPUT_LENGTH = TOTAL_LENGTH / 2;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_unpack_vf(
    __ubuf__ uint16_t* dst_local, __ubuf__ uint8_t* src_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint16_t dst_chunk = one_rep_size / 2;

    vector_uint8_t reg_src;
    vector_uint16_t reg_dst;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_load(reg_src, src_local + i * one_rep_size);
        asc_unpack_upper(reg_dst, reg_src);
        asc_store(dst_local + i * dst_chunk, reg_dst);
    }
}

__vector__ __global__ void asc_unpack_custom(__gm__ uint8_t* src, __gm__ uint16_t* dst)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;

    __gm__ uint8_t* src_gm = src + block_idx * block_length;
    __gm__ uint16_t* dst_gm = dst + block_idx * block_length / 2;

    __ubuf__ uint8_t src_local[block_length];
    __ubuf__ uint16_t dst_local[block_length / 2];

    const uint8_t cache_mode0 = static_cast<uint8_t>(((uint64_t)src_gm) >> 60);
    const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t burst_length = block_length * sizeof(uint8_t);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align(
        (__ubuf__ uint8_t*)src_local, src_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_unpack_vf((__ubuf__ uint16_t*)dst_local, (__ubuf__ uint8_t*)src_local, block_length);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ uint16_t*)dst_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<uint16_t> kernel_asc_unpack(std::vector<uint8_t>& src)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src.size();
    size_t src_byte_size = total_length * sizeof(uint8_t);
    size_t dst_byte_size = (total_length / 2) * sizeof(uint16_t);
    int32_t device_id = 0;
    uint8_t* src_host = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dst_host = nullptr;
    uint8_t* src_device = nullptr;
    uint16_t* dst_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_host), dst_byte_size);
    aclrtMalloc((void**)&src_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src_device, src_byte_size, src_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    asc_unpack_custom<<<num_blocks, 0>>>(src_device, dst_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_host, dst_byte_size, (uint8_t*)dst_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> dst((uint16_t*)dst_host, (uint16_t*)(dst_host + dst_byte_size));

    aclrtFree(src_device);
    aclrtFree(dst_device);
    aclrtFreeHost(dst_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return dst;
}

uint32_t verify_result(std::vector<uint16_t>& output, std::vector<uint16_t>& golden)
{
    auto print_tensor = [](auto& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<uint16_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    constexpr uint32_t output_length = OUTPUT_LENGTH;
    std::vector<uint8_t> src(total_length);

    for (uint32_t i = 0; i < total_length; ++i) {
        src[i] = static_cast<uint8_t>(i);
    }
    std::vector<uint16_t> output = kernel_asc_unpack(src);
    std::vector<uint16_t> golden(output_length);
    for (uint32_t i = 0; i < output_length; ++i) {
        golden[i] = static_cast<uint16_t>(src[i + output_length]);
    }
    return verify_result(output, golden);
}