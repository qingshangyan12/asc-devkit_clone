/* !
 * \file asc_unpack.asc
 * \brief 演示使用asc_unpack_lower接口实现数据解压缩功能，将uint16_t解压为uint32_t
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void unpack_vf(__ubuf__ uint32_t* dst_local, __ubuf__ uint16_t* src_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(uint32_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    vector_uint16_t reg_src;
    vector_uint32_t reg_dst;
    vector_bool vmask = asc_create_mask_b32(PAT_ALL);
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_load(reg_src, src_local + i * one_rep_size);
        asc_unpack_lower(reg_dst, reg_src);
        asc_store(dst_local + i * one_rep_size, reg_dst, one_rep_size);
    }
}

__vector__ __global__ void unpack_custom(__gm__ uint16_t* src, __gm__ uint32_t* dst)
{
    asc_init();
        constexpr uint8_t mutex_id = 1;
    __gm__ uint16_t* src_gm = src + block_idx * block_length;
    __gm__ uint32_t* dst_gm = dst + block_idx * block_length;
    __ubuf__ uint16_t src_local[block_length];
    __ubuf__ uint32_t dst_local[block_length];
    asc_load_l2_cache_mode cache_mode0 = asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM;
    asc_store_l2_cache_mode cache_mode2 = asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM;
    uint32_t src_burst = block_length * sizeof(uint16_t);
    uint32_t dst_burst = block_length * sizeof(uint32_t);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align((__ubuf__ uint16_t*)src_local, src_gm, BLK_NUM, src_burst, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    unpack_vf((__ubuf__ uint32_t*)dst_local, src_local, block_length);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ uint32_t*)dst_local, BLK_NUM, dst_burst, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<uint32_t> kernel_unpack(std::vector<uint16_t>& src_data)
{
    constexpr uint32_t numBlocks = NUM_BLOCKS;
    uint32_t totalLength = TOTAL_LENGTH;
    size_t srcByteSize = totalLength * sizeof(uint16_t);
    size_t dstByteSize = totalLength * sizeof(uint32_t);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src_data.data());
    uint8_t* dstHost = nullptr;
    uint16_t* srcDevice = nullptr;
    uint32_t* dstDevice = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)(&dstHost), dstByteSize);
    aclrtMalloc((void**)&srcDevice, srcByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, dstByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)srcDevice, srcByteSize, srcHost, srcByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    unpack_custom<<<numBlocks, 0, stream>>>(srcDevice, dstDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstHost, dstByteSize, (uint8_t*)dstDevice, dstByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> dst((uint32_t*)dstHost, (uint32_t*)(dstHost + dstByteSize));
    aclrtFree(srcDevice);
    aclrtFree(dstDevice);
    aclrtFreeHost(dstHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return dst;
}

uint32_t VerifyResult(std::vector<uint32_t>& output, std::vector<uint32_t>& golden)
{
    auto printTensor = [](std::vector<uint32_t>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        for (size_t i = 0; i < std::min(tensor.size(), maxPrintSize); ++i) {
            std::cout << tensor[i] << " ";
        }
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalLength = TOTAL_LENGTH;
    std::vector<uint16_t> src(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        src[i] = i % 65536;
    }
    std::vector<uint32_t> output = kernel_unpack(src);
    std::vector<uint32_t> golden(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        golden[i] = (uint32_t)src[i];
    }
    return VerifyResult(output, golden);
}
