/* !
 * \file asc_unpack.asc
 * \brief Sample covering ALL documented overloads of asc_unpack_lower and asc_unpack_upper
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


// ===================== Non-bool overloads (4 lower + 4 upper = 8) =====================
#define DEFINE_UNPACK_OVERLOAD(OP, SUFFIX, DST_CTYPE, SRC_CTYPE, DST_VECTYPE, SRC_VECTYPE, SRC_SZ) \
__simd_vf__ inline void asc_unpack_##OP##_##SUFFIX##_vf(__ubuf__ DST_CTYPE* d, __ubuf__ SRC_CTYPE* s, uint32_t len) \
{ \
    uint16_t one_rep = asc_get_vf_len() / SRC_SZ; \
    uint16_t reps = (len + one_rep - 1) / one_rep; \
    uint32_t rem = len; \
    SRC_VECTYPE r0; DST_VECTYPE rd; \
    for (uint16_t i = 0; i < reps; ++i) { \
        uint32_t n = (rem > one_rep) ? one_rep : rem; \
        asc_load(r0, s + i * one_rep); \
        asc_unpack_##OP(rd, r0); \
        asc_store(d + i * (one_rep / 2), rd, n / 2); \
        rem = (rem > one_rep) ? (rem - one_rep) : 0; \
    } \
} \
__vector__ __global__ void asc_unpack_##OP##_##SUFFIX##_kernel(__gm__ SRC_CTYPE* s, __gm__ DST_CTYPE* d) \
{ \
    asc_init(); \
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS; \
    constexpr uint8_t mtx = 1; \
    __gm__ SRC_CTYPE* gs = s + block_idx * bl; \
    __gm__ DST_CTYPE* gd = d + block_idx * (bl / 2); \
    __ubuf__ SRC_CTYPE sl[bl]; __ubuf__ DST_CTYPE dl[bl]; \
    uint32_t sblen = bl * sizeof(SRC_CTYPE); uint32_t dblen = (bl / 2) * sizeof(DST_CTYPE); \
    uint64_t ss = 0; uint32_t ds = 0; \
    asc_lock(PIPE_MTE2, mtx); \
    asc_copy_gm2ub_align((__ubuf__ SRC_CTYPE*)sl, gs, BLK_NUM, sblen, 0, 0, true, 0, ss, ds); \
    asc_unlock(PIPE_MTE2, mtx); \
    asc_lock(PIPE_V, mtx); \
    asc_unpack_##OP##_##SUFFIX##_vf((__ubuf__ DST_CTYPE*)dl, (__ubuf__ SRC_CTYPE*)sl, bl); \
    asc_unlock(PIPE_V, mtx); \
    asc_lock(PIPE_MTE3, mtx); \
    asc_copy_ub2gm_align(gd, (__ubuf__ DST_CTYPE*)dl, BLK_NUM, dblen, 0, ss, ds); \
    asc_unlock(PIPE_MTE3, mtx); \
} \
std::vector<DST_CTYPE> run_asc_unpack_##OP##_##SUFFIX(std::vector<SRC_CTYPE>& s, aclrtStream stream) { \
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(SRC_CTYPE); size_t dbs = (tl / 2) * sizeof(DST_CTYPE); \
    SRC_CTYPE* sd = nullptr; DST_CTYPE* dd = nullptr; uint8_t* dh = nullptr; \
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMallocHost((void**)&dh, dbs); \
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE); \
    asc_unpack_##OP##_##SUFFIX##_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd); \
    aclrtSynchronizeStream(stream); \
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST); \
    std::vector<DST_CTYPE> result((const DST_CTYPE*)dh, (const DST_CTYPE*)(dh + dbs)); \
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh); \
    return result; \
}

// Lower variants
DEFINE_UNPACK_OVERLOAD(lower, u8u16, uint16_t, uint8_t, vector_uint16_t, vector_uint8_t, sizeof(uint8_t))
DEFINE_UNPACK_OVERLOAD(lower, i8i16, int16_t, int8_t, vector_int16_t, vector_int8_t, sizeof(int8_t))
DEFINE_UNPACK_OVERLOAD(lower, u16u32, uint32_t, uint16_t, vector_uint32_t, vector_uint16_t, sizeof(uint16_t))
DEFINE_UNPACK_OVERLOAD(lower, i16i32, int32_t, int16_t, vector_int32_t, vector_int16_t, sizeof(int16_t))

// Upper variants
DEFINE_UNPACK_OVERLOAD(upper, u8u16, uint16_t, uint8_t, vector_uint16_t, vector_uint8_t, sizeof(uint8_t))
DEFINE_UNPACK_OVERLOAD(upper, i8i16, int16_t, int8_t, vector_int16_t, vector_int8_t, sizeof(int8_t))
DEFINE_UNPACK_OVERLOAD(upper, u16u32, uint32_t, uint16_t, vector_uint32_t, vector_uint16_t, sizeof(uint16_t))
DEFINE_UNPACK_OVERLOAD(upper, i16i32, int32_t, int16_t, vector_int32_t, vector_int16_t, sizeof(int16_t))

// ===================== Bool overloads (lower + upper) =====================
__simd_vf__ inline void asc_unpack_lower_bool_vf(__ubuf__ uint8_t* d)
{
    vector_bool src = asc_create_mask_b8(PAT_ALL);
    vector_bool rd;
    asc_unpack_lower(rd, src);
    asc_storealign(d, rd);
}

__vector__ __global__ void asc_unpack_lower_bool_kernel(__gm__ uint8_t* d)
{
    asc_init();
    constexpr uint8_t mtx = 1;
    constexpr uint32_t bool_bytes = ELEM_NUM / 8;
    __gm__ uint8_t* gd = d + block_idx * bool_bytes;
    __ubuf__ uint8_t dl[bool_bytes];
    uint32_t blen = bool_bytes; uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, mtx);
    asc_unpack_lower_bool_vf((__ubuf__ uint8_t*)dl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

void run_asc_unpack_lower_bool(aclrtStream stream) {
    constexpr uint32_t bool_bytes = ELEM_NUM / 8;
    size_t bs = bool_bytes;
    uint8_t* dd = nullptr;
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    asc_unpack_lower_bool_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
    aclrtSynchronizeStream(stream);
    aclrtFree(dd);
}

__simd_vf__ inline void asc_unpack_upper_bool_vf(__ubuf__ uint8_t* d)
{
    vector_bool src = asc_create_mask_b8(PAT_ALL);
    vector_bool rd;
    asc_unpack_upper(rd, src);
    asc_storealign(d, rd);
}

__vector__ __global__ void asc_unpack_upper_bool_kernel(__gm__ uint8_t* d)
{
    asc_init();
    constexpr uint8_t mtx = 1;
    constexpr uint32_t bool_bytes = ELEM_NUM / 8;
    __gm__ uint8_t* gd = d + block_idx * bool_bytes;
    __ubuf__ uint8_t dl[bool_bytes];
    uint32_t blen = bool_bytes; uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, mtx);
    asc_unpack_upper_bool_vf((__ubuf__ uint8_t*)dl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

void run_asc_unpack_upper_bool(aclrtStream stream) {
    constexpr uint32_t bool_bytes = ELEM_NUM / 8;
    size_t bs = bool_bytes;
    uint8_t* dd = nullptr;
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    asc_unpack_upper_bool_kernel<<<NUM_BLOCKS, 0, stream>>>(dd);
    aclrtSynchronizeStream(stream);
    aclrtFree(dd);
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

uint32_t verify_run(const char* name) {
    std::cout << "[OK] " << name << std::endl;
    return 0;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // lower u8->u16
        std::vector<uint8_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (uint8_t)(i % 256); }
        auto result = run_asc_unpack_lower_u8u16(s, stream);
        std::vector<uint16_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (uint16_t)s[i]; }
        failed += verify_result(result, golden, "asc_unpack_lower u8->u16");
    }

    { // lower i8->i16
        std::vector<int8_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (int8_t)(i % 128); }
        auto result = run_asc_unpack_lower_i8i16(s, stream);
        std::vector<int16_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (int16_t)s[i]; }
        failed += verify_result(result, golden, "asc_unpack_lower i8->i16");
    }

    { // lower u16->u32
        std::vector<uint16_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (uint16_t)(i % 65536); }
        auto result = run_asc_unpack_lower_u16u32(s, stream);
        std::vector<uint32_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (uint32_t)s[i]; }
        failed += verify_result(result, golden, "asc_unpack_lower u16->u32");
    }

    { // lower i16->i32
        std::vector<int16_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (int16_t)(i % 32768); }
        auto result = run_asc_unpack_lower_i16i32(s, stream);
        std::vector<int32_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (int32_t)s[i]; }
        failed += verify_result(result, golden, "asc_unpack_lower i16->i32");
    }

    { // upper u8->u16
        std::vector<uint8_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (uint8_t)(i % 256); }
        auto result = run_asc_unpack_upper_u8u16(s, stream);
        std::vector<uint16_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (uint16_t)s[ELEM_NUM / 2 + i]; }
        failed += verify_result(result, golden, "asc_unpack_upper u8->u16");
    }

    { // upper i8->i16
        std::vector<int8_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (int8_t)(i % 128); }
        auto result = run_asc_unpack_upper_i8i16(s, stream);
        std::vector<int16_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (int16_t)s[ELEM_NUM / 2 + i]; }
        failed += verify_result(result, golden, "asc_unpack_upper i8->i16");
    }

    { // upper u16->u32
        std::vector<uint16_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (uint16_t)(i % 65536); }
        auto result = run_asc_unpack_upper_u16u32(s, stream);
        std::vector<uint32_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (uint32_t)s[ELEM_NUM / 2 + i]; }
        failed += verify_result(result, golden, "asc_unpack_upper u16->u32");
    }

    { // upper i16->i32
        std::vector<int16_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (int16_t)(i % 32768); }
        auto result = run_asc_unpack_upper_i16i32(s, stream);
        std::vector<int32_t> golden(ELEM_NUM / 2);
        for (uint32_t i = 0; i < ELEM_NUM / 2; ++i) { golden[i] = (int32_t)s[ELEM_NUM / 2 + i]; }
        failed += verify_result(result, golden, "asc_unpack_upper i16->i32");
    }

    { // lower bool (verify run)
        run_asc_unpack_lower_bool(stream);
        failed += verify_run("asc_unpack_lower bool");
    }

    { // upper bool (verify run)
        run_asc_unpack_upper_bool(stream);
        failed += verify_run("asc_unpack_upper bool");
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
