template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // int8
        auto result = run_asc_unsqueeze_int8(stream);
        std::vector<int8_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(int8_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int8_t)(i % one_rep); }
        failed += verify_result(result, golden, "asc_unsqueeze int8");
    }

    { // uint8
        auto result = run_asc_unsqueeze_uint8(stream);
        std::vector<uint8_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint8_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (uint8_t)(i % one_rep); }
        failed += verify_result(result, golden, "asc_unsqueeze uint8");
    }

    { // int16
        auto result = run_asc_unsqueeze_int16(stream);
        std::vector<int16_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(int16_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int16_t)(i % one_rep); }
        failed += verify_result(result, golden, "asc_unsqueeze int16");
    }

    { // uint16
        auto result = run_asc_unsqueeze_uint16(stream);
        std::vector<uint16_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint16_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (uint16_t)(i % one_rep); }
        failed += verify_result(result, golden, "asc_unsqueeze uint16");
    }

    { // int32
        auto result = run_asc_unsqueeze_int32(stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(int32_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(i % one_rep); }
        failed += verify_result(result, golden, "asc_unsqueeze int32");
    }

    { // uint32
        auto result = run_asc_unsqueeze_uint32(stream);
        std::vector<uint32_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint32_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (uint32_t)(i % one_rep); }
        failed += verify_result(result, golden, "asc_unsqueeze uint32");
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
