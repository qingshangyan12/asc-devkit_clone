/* !
 * \file asc_pack_to_low.asc
 * \brief Sample covering ALL documented overloads of asc_pack_to_low
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;


// ===================== Variant 1: vector_uint16_t -> vector_uint8_t =====================
__simd_vf__ inline void asc_pack_to_low_u16u8_vf(__ubuf__ uint8_t* d, __ubuf__ uint16_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint16_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_uint16_t r0; vector_uint8_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        asc_load(r0, s + i * one_rep);
        asc_pack_to_low(rd, r0);
        asc_store(d + i * one_rep, rd);
    }
}

__vector__ __global__ void asc_pack_to_low_u16u8_kernel(__gm__ uint16_t* s, __gm__ uint8_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint16_t* gs = s + block_idx * bl;
    __gm__ uint8_t* gd = d + block_idx * bl;
    __ubuf__ uint16_t sl[bl]; __ubuf__ uint8_t dl[bl];
    uint32_t sblen = bl * sizeof(uint16_t); uint32_t dblen = bl * sizeof(uint8_t);
    uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint16_t*)sl, gs, SAMP_BLK_NUM, sblen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_pack_to_low_u16u8_vf((__ubuf__ uint8_t*)dl, (__ubuf__ uint16_t*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, SAMP_BLK_NUM, dblen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint8_t> run_asc_pack_to_low_u16u8(std::vector<uint16_t>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(uint16_t); size_t dbs = tl * sizeof(uint8_t);
    uint16_t* sd = nullptr; uint8_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_pack_to_low_u16u8_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint8_t> result(dh, dh + dbs);
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

// ===================== Variant 2: vector_uint32_t -> vector_uint16_t =====================
__simd_vf__ inline void asc_pack_to_low_u32u16_vf(__ubuf__ uint16_t* d, __ubuf__ uint32_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint32_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_uint32_t r0; vector_uint16_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        asc_load(r0, s + i * one_rep);
        asc_pack_to_low(rd, r0);
        asc_store(d + i * one_rep, rd);
    }
}

__vector__ __global__ void asc_pack_to_low_u32u16_kernel(__gm__ uint32_t* s, __gm__ uint16_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint32_t* gs = s + block_idx * bl;
    __gm__ uint16_t* gd = d + block_idx * bl;
    __ubuf__ uint32_t sl[bl]; __ubuf__ uint16_t dl[bl];
    uint32_t sblen = bl * sizeof(uint32_t); uint32_t dblen = bl * sizeof(uint16_t);
    uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)sl, gs, SAMP_BLK_NUM, sblen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_pack_to_low_u32u16_vf((__ubuf__ uint16_t*)dl, (__ubuf__ uint32_t*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint16_t*)dl, SAMP_BLK_NUM, dblen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint16_t> run_asc_pack_to_low_u32u16(std::vector<uint32_t>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(uint32_t); size_t dbs = tl * sizeof(uint16_t);
    uint32_t* sd = nullptr; uint16_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_pack_to_low_u32u16_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> result((const uint16_t*)dh, (const uint16_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

// ===================== Variant 3: vector_bool -> vector_bool =====================
__simd_vf__ inline void asc_pack_to_low_bool_vf(__ubuf__ uint8_t* d)
{
    vector_bool src = asc_create_mask_b8(PAT_ALL);
    vector_bool rd;
    asc_pack_to_low(rd, src);
    asc_storealign(d, rd);
}

__vector__ __global__ void asc_pack_to_low_bool_kernel(__gm__ uint8_t* d)
{
    asc_init();
    constexpr uint8_t mtx = 1;
    constexpr uint32_t bool_bytes = SAMP_ELEM_NUM / 8;
    __gm__ uint8_t* gd = d + block_idx * bool_bytes;
    __ubuf__ uint8_t dl[bool_bytes];
    uint32_t blen = bool_bytes; uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, mtx);
    asc_pack_to_low_bool_vf((__ubuf__ uint8_t*)dl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, blen);
    asc_unlock(PIPE_MTE3, mtx);
}

void run_asc_pack_to_low_bool(aclrtStream stream) {
    constexpr uint32_t bool_bytes = SAMP_ELEM_NUM / 8;
    size_t bs = bool_bytes;
    uint8_t* dd = nullptr;
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    asc_pack_to_low_bool_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(dd);
    aclrtSynchronizeStream(stream);
    aclrtFree(dd);
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

uint32_t verify_run(const char* name) {
    std::cout << "[OK] " << name << std::endl;
    return 0;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // uint16 -> uint8
        std::vector<uint16_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (uint16_t)(i * 257); }
        auto result = run_asc_pack_to_low_u16u8(s, stream);
        std::vector<uint8_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (uint8_t)(s[i] & 0xFF); }
        failed += verify_result(result, golden, "asc_pack_to_low u16->u8");
    }

    { // uint32 -> uint16
        std::vector<uint32_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (uint32_t)(i * 65537); }
        auto result = run_asc_pack_to_low_u32u16(s, stream);
        std::vector<uint16_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (uint16_t)(s[i] & 0xFFFF); }
        failed += verify_result(result, golden, "asc_pack_to_low u32->u16");
    }

    { // bool -> bool (verify run)
        run_asc_pack_to_low_bool(stream);
        failed += verify_run("asc_pack_to_low bool->bool");
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
