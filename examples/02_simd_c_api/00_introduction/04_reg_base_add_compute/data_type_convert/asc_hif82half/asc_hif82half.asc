/* !
 * \file asc_hif82half.asc
 * \brief Sample covering ALL documented overloads of asc_hif82half
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_hif82half_vf(__ubuf__ half* d, __ubuf__ uint8_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_uint8_t r0; vector_half rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b8(n);
        asc_load(r0, s + i * one_rep);
        asc_hif82half(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}


__vector__ __global__ void asc_hif82half_kernel(__gm__ uint8_t* s, __gm__ half* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint8_t* gs = s + block_idx * bl;
    __gm__ half* gd = d + block_idx * bl;
    __ubuf__ uint8_t sl[bl];
    __ubuf__ half dl[bl];
    uint32_t sblen = bl * sizeof(uint8_t); uint32_t dblen = bl * sizeof(half); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)sl, gs, BLK_NUM, sblen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_hif82half_vf((__ubuf__ half*)dl, (__ubuf__ uint8_t*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ half*)dl, BLK_NUM, dblen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<half> run_asc_hif82half(std::vector<uint8_t>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(uint8_t); size_t dbs = tl * sizeof(half);
    uint8_t* sd = nullptr; half* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_hif82half_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> result((const half*)dh, (const half*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_hif82half_v2_vf(__ubuf__ half* d, __ubuf__ uint8_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_uint8_t r0; vector_half rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b8(n);
        asc_load(r0, s + i * one_rep);
        asc_hif82half_v2(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}


__vector__ __global__ void asc_hif82half_v2_kernel(__gm__ uint8_t* s, __gm__ half* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint8_t* gs = s + block_idx * bl;
    __gm__ half* gd = d + block_idx * bl;
    __ubuf__ uint8_t sl[bl];
    __ubuf__ half dl[bl];
    uint32_t sblen = bl * sizeof(uint8_t); uint32_t dblen = bl * sizeof(half); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)sl, gs, BLK_NUM, sblen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_hif82half_v2_vf((__ubuf__ half*)dl, (__ubuf__ uint8_t*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ half*)dl, BLK_NUM, dblen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<half> run_asc_hif82half_v2(std::vector<uint8_t>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(uint8_t); size_t dbs = tl * sizeof(half);
    uint8_t* sd = nullptr; half* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_hif82half_v2_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> result((const half*)dh, (const half*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}


int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;


    { // asc_hif82half
        std::vector<uint8_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (uint8_t)(i % 100); }
        auto result = run_asc_hif82half(s, stream);
        std::vector<half> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (half)(s[i]); }
        failed += verify_result(result, golden, "asc_hif82half");
    }


    { // asc_hif82half_v2
        std::vector<uint8_t> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (uint8_t)(i % 100); }
        auto result = run_asc_hif82half_v2(s, stream);
        std::vector<half> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (half)(s[i]); }
        failed += verify_result(result, golden, "asc_hif82half_v2");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
