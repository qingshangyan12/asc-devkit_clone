        std::vector<bfloat16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (bfloat16_t)(s[i]); }
        failed += verify_result(result, golden, "asc_float2bfloat16_rd_sat_v2");
    }


    { // asc_float2bfloat16_rn
        std::vector<float> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (float)(i % 100); }
        auto result = run_asc_float2bfloat16_rn(s, stream);
        std::vector<bfloat16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (bfloat16_t)(s[i]); }
        failed += verify_result(result, golden, "asc_float2bfloat16_rn");
    }


    { // asc_float2bfloat16_rn_sat
        std::vector<float> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (float)(i % 100); }
        auto result = run_asc_float2bfloat16_rn_sat(s, stream);
        std::vector<bfloat16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (bfloat16_t)(s[i]); }
        failed += verify_result(result, golden, "asc_float2bfloat16_rn_sat");
    }


    { // asc_float2bfloat16_rn_v2
        std::vector<float> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (float)(i % 100); }
        auto result = run_asc_float2bfloat16_rn_v2(s, stream);
