template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}


int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;


    { // asc_float2bfloat16_rd
        std::vector<float> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (float)(i % 100); }
        auto result = run_asc_float2bfloat16_rd(s, stream);
        std::vector<bfloat16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (bfloat16_t)(s[i]); }
        failed += verify_result(result, golden, "asc_float2bfloat16_rd");
    }


    { // asc_float2bfloat16_rd_sat
        std::vector<float> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (float)(i % 100); }
        auto result = run_asc_float2bfloat16_rd_sat(s, stream);
        std::vector<bfloat16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (bfloat16_t)(s[i]); }
        failed += verify_result(result, golden, "asc_float2bfloat16_rd_sat");
    }


    { // asc_float2bfloat16_rd_v2
        std::vector<float> s(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (float)(i % 100); }
