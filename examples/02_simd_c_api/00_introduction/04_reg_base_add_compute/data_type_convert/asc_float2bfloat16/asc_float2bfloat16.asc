/* !
 * \file asc_float2bfloat16.asc
 * \brief Sample covering ALL documented overloads of asc_float2bfloat16
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_float2bfloat16_rd_vf(__ubuf__ bfloat16_t* d, __ubuf__ float* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_float r0; vector_bfloat16_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(n);
        asc_load(r0, s + i * one_rep);
        asc_float2bfloat16_rd(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}


__vector__ __global__ void asc_float2bfloat16_rd_kernel(__gm__ float* s, __gm__ bfloat16_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ float* gs = s + block_idx * bl;
    __gm__ bfloat16_t* gd = d + block_idx * bl;
    __ubuf__ float sl[bl];
    __ubuf__ bfloat16_t dl[bl];
    uint32_t sblen = bl * sizeof(float); uint32_t dblen = bl * sizeof(bfloat16_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)sl, gs, BLK_NUM, sblen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_float2bfloat16_rd_vf((__ubuf__ bfloat16_t*)dl, (__ubuf__ float*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ bfloat16_t*)dl, BLK_NUM, dblen, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<bfloat16_t> run_asc_float2bfloat16_rd(std::vector<float>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(float); size_t dbs = tl * sizeof(bfloat16_t);
    float* sd = nullptr; bfloat16_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_float2bfloat16_rd_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<bfloat16_t> result((const bfloat16_t*)dh, (const bfloat16_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_float2bfloat16_rd_sat_vf(__ubuf__ bfloat16_t* d, __ubuf__ float* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_float r0; vector_bfloat16_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(n);
        asc_load(r0, s + i * one_rep);
        asc_float2bfloat16_rd_sat(rd, r0, vmask);
        asc_store(d + i * one_rep, rd, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}


__vector__ __global__ void asc_float2bfloat16_rd_sat_kernel(__gm__ float* s, __gm__ bfloat16_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ float* gs = s + block_idx * bl;
    __gm__ bfloat16_t* gd = d + block_idx * bl;
    __ubuf__ float sl[bl];
    __ubuf__ bfloat16_t dl[bl];
    uint32_t sblen = bl * sizeof(float); uint32_t dblen = bl * sizeof(bfloat16_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)sl, gs, BLK_NUM, sblen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_float2bfloat16_rd_sat_vf((__ubuf__ bfloat16_t*)dl, (__ubuf__ float*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ bfloat16_t*)dl, BLK_NUM, dblen, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<bfloat16_t> run_asc_float2bfloat16_rd_sat(std::vector<float>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(float); size_t dbs = tl * sizeof(bfloat16_t);
    float* sd = nullptr; bfloat16_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_float2bfloat16_rd_sat_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<bfloat16_t> result((const bfloat16_t*)dh, (const bfloat16_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


