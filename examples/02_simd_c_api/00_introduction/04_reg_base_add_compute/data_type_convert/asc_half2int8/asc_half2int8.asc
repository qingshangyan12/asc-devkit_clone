/* !
 * \file asc_half2int8.asc
 * \brief Sample covering ALL documented overloads of asc_half2int8
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_half2int8_rd_vf(__ubuf__ int8_t* d, __ubuf__ half* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_half r0; vector_int8_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b16(rem);
        asc_load(r0, s + i * one_rep);
        asc_half2int8_rd(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_half2int8_rd_kernel(__gm__ half* s, __gm__ int8_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ half* gs = s + block_idx * bl;
    __gm__ int8_t* gd = d + block_idx * bl;
    __ubuf__ half sl[bl];
    __ubuf__ int8_t dl[bl];
    uint32_t sblen = bl * sizeof(half); uint32_t dblen = bl * sizeof(int8_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ half*)sl, gs, BLK_NUM, sblen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_half2int8_rd_vf((__ubuf__ int8_t*)dl, (__ubuf__ half*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int8_t*)dl, BLK_NUM, dblen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<int8_t> run_asc_half2int8_rd(std::vector<half>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(half); size_t dbs = tl * sizeof(int8_t);
    half* sd = nullptr; int8_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_half2int8_rd_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> result((const int8_t*)dh, (const int8_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_half2int8_rd_sat_vf(__ubuf__ int8_t* d, __ubuf__ half* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
