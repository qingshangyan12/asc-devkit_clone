/* !
 * \file c_api_asc_half2hif8.asc
 * \brief
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_half2hif8_vf(
    __ubuf__ hifloat8_t* dst_local, __ubuf__ half* src0_local, __ubuf__ half* src1_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(half);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask;
    vector_half reg_src0;
    vector_half reg_src1;
    vector_hifloat8_t reg_dst;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(reg_src0, src0_local + i * one_rep_size);
        asc_load(reg_src1, src1_local + i * one_rep_size);
        asc_half2hif8(reg_dst, reg_src0, reg_src1, vmask);
        asc_store(dst_local + i * one_rep_size, reg_dst);
    }
}

__vector__ __global__ void asc_half2hif8_custom(__gm__ half* src0, __gm__ half* src1, __gm__ hifloat8_t* dst)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;

    __gm__ half* src0_gm = src0 + block_idx * block_length;
    __gm__ half* src1_gm = src1 + block_idx * block_length;
    __gm__ hifloat8_t* dst_gm = dst + block_idx * block_length;

    __ubuf__ half src0_local[block_length];
    __ubuf__ half src1_local[block_length];
    __ubuf__ hifloat8_t dst_local[block_length];

    const uint8_t cache_mode0 = static_cast<uint8_t>(((uint64_t)src0_gm) >> 60);
    const uint8_t cache_mode1 = static_cast<uint8_t>(((uint64_t)src1_gm) >> 60);
    const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t burst_length = block_length * sizeof(half);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align(
        (__ubuf__ half*)src0_local, src0_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_copy_gm2ub_align(
        (__ubuf__ half*)src1_local, src1_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode1, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_half2hif8_vf((__ubuf__ hifloat8_t*)dst_local, (__ubuf__ half*)src0_local, (__ubuf__ half*)src1_local, block_length);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ hifloat8_t*)dst_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<hifloat8_t> kernel_asc_half2hif8(std::vector<half>& src0, std::vector<half>& src1)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src0.size();
    size_t src_byte_size = total_length * sizeof(half);
    size_t dst_byte_size = total_length * sizeof(hifloat8_t);
    int32_t device_id = 0;
    uint8_t* src0_host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* src1_host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* dst_host = nullptr;
    half* src0_device = nullptr;
    half* src1_device = nullptr;
    hifloat8_t* dst_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_host), dst_byte_size);
    aclrtMalloc((void**)&src0_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src0_device, src_byte_size, src0_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)src1_device, src_byte_size, src1_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    asc_half2hif8_custom<<<num_blocks, 0>>>(src0_device, src1_device, dst_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_host, dst_byte_size, (uint8_t*)dst_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<hifloat8_t> dst((hifloat8_t*)dst_host, (hifloat8_t*)(dst_host + dst_byte_size));

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst_device);
    aclrtFreeHost(dst_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return dst;
}

uint32_t verify_result(std::vector<hifloat8_t>& output, std::vector<hifloat8_t>& golden)
{
    auto print_tensor = [](auto& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<hifloat8_t>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<half> src0(total_length);
    std::vector<half> src1(total_length);

    for (uint32_t i = 0; i < total_length; ++i) {
        src0[i] = static_cast<half>(i * 0.1f);
        src1[i] = static_cast<half>(i * 0.1f);
    }
    std::vector<hifloat8_t> output = kernel_asc_half2hif8(src0, src1);
    std::vector<hifloat8_t> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        golden[i] = static_cast<hifloat8_t>(src0[i] + src1[i]);
    }
    return verify_result(output, golden);
}
