    half* sd = nullptr; int32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_half2int32_ru_v2_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_half2int32_rz_vf(__ubuf__ int32_t* d, __ubuf__ half* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_half r0; vector_int32_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        vmask = asc_update_mask_b16(rem);
        asc_load(r0, s + i * one_rep);
        asc_half2int32_rz(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_half2int32_rz_kernel(__gm__ half* s, __gm__ int32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ half* gs = s + block_idx * bl;
    __gm__ int32_t* gd = d + block_idx * bl;
    __ubuf__ half sl[bl];
    __ubuf__ int32_t dl[bl];
    uint32_t sblen = bl * sizeof(half); uint32_t dblen = bl * sizeof(int32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ half*)sl, gs, sblen);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_half2int32_rz_vf((__ubuf__ int32_t*)dl, (__ubuf__ half*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int32_t*)dl, dblen);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<int32_t> run_asc_half2int32_rz(std::vector<half>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(half); size_t dbs = tl * sizeof(int32_t);
    half* sd = nullptr; int32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_half2int32_rz_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_half2int32_rz_v2_vf(__ubuf__ int32_t* d, __ubuf__ half* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_half r0; vector_int32_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        vmask = asc_update_mask_b16(rem);
        asc_load(r0, s + i * one_rep);
        asc_half2int32_rz_v2(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_half2int32_rz_v2_kernel(__gm__ half* s, __gm__ int32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ half* gs = s + block_idx * bl;
    __gm__ int32_t* gd = d + block_idx * bl;
    __ubuf__ half sl[bl];
    __ubuf__ int32_t dl[bl];
    uint32_t sblen = bl * sizeof(half); uint32_t dblen = bl * sizeof(int32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ half*)sl, gs, sblen);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_half2int32_rz_v2_vf((__ubuf__ int32_t*)dl, (__ubuf__ half*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int32_t*)dl, dblen);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<int32_t> run_asc_half2int32_rz_v2(std::vector<half>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(half); size_t dbs = tl * sizeof(int32_t);
    half* sd = nullptr; int32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_half2int32_rz_v2_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}


int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;


    { // asc_half2int32_rd
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rd(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rd");
    }


    { // asc_half2int32_rd_v2
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rd_v2(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rd_v2");
    }


    { // asc_half2int32_rn
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rn(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rn");
    }


    { // asc_half2int32_rn_v2
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rn_v2(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rn_v2");
    }


    { // asc_half2int32_rna
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rna(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rna");
    }


    { // asc_half2int32_rna_v2
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rna_v2(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rna_v2");
    }


    { // asc_half2int32_ru
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_ru(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_ru");
    }


    { // asc_half2int32_ru_v2
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_ru_v2(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_ru_v2");
    }


    { // asc_half2int32_rz
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rz(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rz");
    }


    { // asc_half2int32_rz_v2
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 100); }
        auto result = run_asc_half2int32_rz_v2(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = (int32_t)(s[i]); }
        failed += verify_result(result, golden, "asc_half2int32_rz_v2");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
