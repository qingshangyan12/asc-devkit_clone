/* !
 * \file asc_half2int32.asc
 * \brief Sample covering ALL documented overloads of asc_half2int32
 */

#include <cstdint>
#include <cstring>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

static uint16_t float_to_bf16(float f) {
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    uint32_t lsb = (bits >> 16) & 1;
    uint32_t bias = 0x7FFF + lsb;
    return (uint16_t)((bits + bias) >> 16);
}
static float bf16_to_float(uint16_t raw) {
    uint32_t bits = (uint32_t)raw << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;

__simd_vf__ inline void asc_half2int32_rd_vf(__ubuf__ int32_t* d, __ubuf__ half* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_half r0; vector_int32_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        vmask = asc_update_mask_b16(rem);
        asc_load(r0, s + i * one_rep);
        asc_half2int32_rd(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}


__vector__ __global__ void asc_half2int32_rd_kernel(__gm__ half* s, __gm__ int32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ half* gs = s + block_idx * bl;
    __gm__ int32_t* gd = d + block_idx * bl;
    __ubuf__ half sl[bl];
    __ubuf__ int32_t dl[bl];
    uint32_t sblen = bl * sizeof(half); uint32_t dblen = bl * sizeof(int32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ half*)sl, gs, sblen);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_half2int32_rd_vf((__ubuf__ int32_t*)dl, (__ubuf__ half*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int32_t*)dl, dblen);
    asc_unlock(PIPE_MTE3, mtx);
}


std::vector<int32_t> run_asc_half2int32_rd(std::vector<half>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t sbs = tl * sizeof(half); size_t dbs = tl * sizeof(int32_t);
    half* sd = nullptr; int32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, sbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, dbs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, dbs);
    aclrtMemcpy(sd, sbs, s.data(), sbs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_half2int32_rd_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, dbs, dd, dbs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + dbs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_half2int32_rd_v2_vf(__ubuf__ int32_t* d, __ubuf__ half* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(half);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_half r0; vector_int32_t rd;
    for (uint16_t i = 0; i < reps; ++i) {
        vmask = asc_update_mask_b16(rem);
        asc_load(r0, s + i * one_rep);
        asc_half2int32_rd_v2(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}


