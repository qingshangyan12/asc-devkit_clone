/* !
 * \file asc_select.asc
 * \brief Sample covering ALL documented overloads of asc_select
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

static uint16_t float_to_bf16(float f) {
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    uint32_t lsb = (bits >> 16) & 1;
    uint32_t bias = 0x7FFF + lsb;
    return (uint16_t)((bits + bias) >> 16);
}
static float bf16_to_float(uint16_t raw) {
    uint32_t bits = (uint32_t)raw << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;


// ===================== vector_bool overload =====================
__simd_vf__ inline void asc_select_bool_vf(__ubuf__ uint8_t* d, uint32_t len)
{
    vector_bool src0 = asc_create_mask_b8(PAT_ALL);
    vector_bool src1 = asc_create_mask_b8(PAT_ALLF);
    vector_bool sel_mask = asc_create_mask_b8(PAT_ALL);
    vector_bool rd;
    asc_select(rd, src0, src1, sel_mask);
    asc_storealign(d, rd);
}

__vector__ __global__ void asc_select_bool_kernel(__gm__ uint8_t* d)
{
    asc_init();
    constexpr uint8_t mtx = 1;
    constexpr uint32_t bool_bytes = SAMP_ELEM_NUM / 8;
    __gm__ uint8_t* gd = d + block_idx * bool_bytes;
    __ubuf__ uint8_t dl[bool_bytes];
    uint32_t blen = bool_bytes; uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_V, mtx);
    asc_select_bool_vf((__ubuf__ uint8_t*)dl, SAMP_ELEM_NUM);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint8_t*)dl, blen);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint8_t> run_asc_select_bool(aclrtStream stream) {
    constexpr uint32_t bool_bytes = SAMP_ELEM_NUM / 8;
    size_t bs = bool_bytes;
    uint8_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    asc_select_bool_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint8_t> result(dh, dh + bs);
    aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

// ===================== vector data type overloads =====================
#define DEFINE_SELECT_OVERLOAD(NAME, CTYPE, VECTYPE, HOST_CTYPE, MASK_FN, SZ) \
__simd_vf__ inline void asc_select_##NAME##_vf(__ubuf__ CTYPE* d, __ubuf__ CTYPE* s0, __ubuf__ CTYPE* s1, uint32_t len) \
{ \
    uint16_t one_rep = asc_get_vf_len() / SZ; \
    uint16_t reps = (len + one_rep - 1) / one_rep; \
    uint32_t rem = len; \
    vector_bool vmask; VECTYPE r0, r1, rd; \
    for (uint16_t i = 0; i < reps; ++i) { \
        uint32_t n = (rem > one_rep) ? one_rep : rem; \
        vmask = MASK_FN(n); \
        asc_load(r0, s0 + i * one_rep); \
        asc_load(r1, s1 + i * one_rep); \
        asc_select(rd, r0, r1, vmask); \
        asc_store(d + i * one_rep, rd); \
        rem = (rem > one_rep) ? (rem - one_rep) : 0; \
    } \
} \
__vector__ __global__ void asc_select_##NAME##_kernel(__gm__ CTYPE* s0, __gm__ CTYPE* s1, __gm__ CTYPE* d) \
{ \
    asc_init(); \
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS; \
    constexpr uint8_t mtx = 1; \
    __gm__ CTYPE* gs0 = s0 + block_idx * bl; \
    __gm__ CTYPE* gs1 = s1 + block_idx * bl; \
    __gm__ CTYPE* gd = d + block_idx * bl; \
    __ubuf__ CTYPE s0l[bl], s1l[bl], dl[bl]; \
    uint32_t blen = bl * SZ; uint64_t ss = 0; uint32_t ds = 0; \
    asc_lock(PIPE_MTE2, mtx); \
    asc_copy_gm2ub_align((__ubuf__ CTYPE*)s0l, gs0, blen); \
    asc_copy_gm2ub_align((__ubuf__ CTYPE*)s1l, gs1, blen); \
    asc_unlock(PIPE_MTE2, mtx); \
    asc_lock(PIPE_V, mtx); \
    asc_select_##NAME##_vf((__ubuf__ CTYPE*)dl, (__ubuf__ CTYPE*)s0l, (__ubuf__ CTYPE*)s1l, bl); \
    asc_unlock(PIPE_V, mtx); \
    asc_lock(PIPE_MTE3, mtx); \
    asc_copy_ub2gm_align(gd, (__ubuf__ CTYPE*)dl, blen); \
    asc_unlock(PIPE_MTE3, mtx); \
} \
std::vector<HOST_CTYPE> run_asc_select_##NAME(std::vector<HOST_CTYPE>& s0, std::vector<HOST_CTYPE>& s1, aclrtStream stream) { \
    uint32_t tl = s0.size(); size_t bs = tl * SZ; \
    HOST_CTYPE* s0d = nullptr; HOST_CTYPE* s1d = nullptr; HOST_CTYPE* dd = nullptr; uint8_t* dh = nullptr; \
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMallocHost((void**)&dh, bs); \
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE); \
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE); \
    asc_select_##NAME##_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(s0d, s1d, dd); \
    aclrtSynchronizeStream(stream); \
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST); \
    std::vector<HOST_CTYPE> result((const HOST_CTYPE*)dh, (const CTYPE*)(dh + bs)); \
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dh); \
    return result; \
}

DEFINE_SELECT_OVERLOAD(uint8, uint8_t, uint8_t, vector_uint8_t, asc_update_mask_b8, sizeof(uint8_t))
DEFINE_SELECT_OVERLOAD(int8, int8_t, int8_t, vector_int8_t, asc_update_mask_b8, sizeof(int8_t))
DEFINE_SELECT_OVERLOAD(fp8_e4m3fn, fp8_e4m3fn_t, fp8_e4m3fn_t, vector_fp8_e4m3fn_t, asc_update_mask_b8, sizeof(fp8_e4m3fn_t))
DEFINE_SELECT_OVERLOAD(hifloat8, hifloat8_t, hifloat8_t, vector_hifloat8_t, asc_update_mask_b8, sizeof(hifloat8_t))
DEFINE_SELECT_OVERLOAD(fp8_e5m2, fp8_e5m2_t, fp8_e5m2_t, vector_fp8_e5m2_t, asc_update_mask_b8, sizeof(fp8_e5m2_t))
DEFINE_SELECT_OVERLOAD(uint16, uint16_t, uint16_t, vector_uint16_t, asc_update_mask_b16, sizeof(uint16_t))
DEFINE_SELECT_OVERLOAD(int16, int16_t, int16_t, vector_int16_t, asc_update_mask_b16, sizeof(int16_t))
DEFINE_SELECT_OVERLOAD(half, half, half, vector_half, asc_update_mask_b16, sizeof(half))
DEFINE_SELECT_OVERLOAD(bfloat16, bfloat16_t, uint16_t, vector_bfloat16_t, asc_update_mask_b16, sizeof(uint16_t))
DEFINE_SELECT_OVERLOAD(uint32, uint32_t, uint32_t, vector_uint32_t, asc_update_mask_b32, sizeof(uint32_t))
DEFINE_SELECT_OVERLOAD(int32, int32_t, int32_t, vector_int32_t, asc_update_mask_b32, sizeof(int32_t))
DEFINE_SELECT_OVERLOAD(float, float, float, vector_float, asc_update_mask_b32, sizeof(float))

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // bool - all 1s selected from src0(PAT_ALL)
        auto result = run_asc_select_bool(stream);
        std::vector<uint8_t> golden(SAMP_ELEM_NUM / 8, 0xFF);
        failed += verify_result(result, golden, "asc_select bool");
    }

#define RUN_SELECT_TEST(NAME, CTYPE, VAL, HOST_CTYPE) \
    { \
        std::vector<HOST_CTYPE> s0(SAMP_ELEM_NUM), s1(SAMP_ELEM_NUM); \
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s0[i] = (CTYPE)VAL; s1[i] = (CTYPE)0; } \
        auto result = run_asc_select_##NAME(s0, s1, stream); \
        std::vector<HOST_CTYPE> golden(SAMP_ELEM_NUM); \
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s0[i]; } \
        failed += verify_result(result, golden, "asc_select " #NAME); \
    }

    RUN_SELECT_TEST(uint8, uint8_t, uint8_t, (i % 128))
    RUN_SELECT_TEST(int8, int8_t, int8_t, (i % 128))
    RUN_SELECT_TEST(fp8_e4m3fn, fp8_e4m3fn_t, fp8_e4m3fn_t, (float)(i % 10))
    RUN_SELECT_TEST(hifloat8, hifloat8_t, hifloat8_t, (i % 10))
    RUN_SELECT_TEST(fp8_e5m2, fp8_e5m2_t, fp8_e5m2_t, (float)(i % 10))
    RUN_SELECT_TEST(uint16, uint16_t, uint16_t, (i % 128))
    RUN_SELECT_TEST(int16, int16_t, int16_t, (i % 128))
    RUN_SELECT_TEST(half, half, half, (i % 128))
    RUN_SELECT_TEST(bfloat16, bfloat16_t, uint16_t, (i % 128))
    RUN_SELECT_TEST(uint32, uint32_t, uint32_t, (i % 128))
    RUN_SELECT_TEST(int32, int32_t, int32_t, (i % 128))
    RUN_SELECT_TEST(float, float, float, (i % 128))

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
