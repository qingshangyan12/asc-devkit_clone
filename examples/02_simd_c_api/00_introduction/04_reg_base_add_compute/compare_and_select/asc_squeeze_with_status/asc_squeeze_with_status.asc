/* !
 * \file asc_squeeze_with_status.asc
 * \brief Sample covering ALL documented overloads of asc_squeeze_with_status
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


#define DEFINE_SQUEEZE_WS_OVERLOAD(NAME, CTYPE, VECTYPE, MASK_FN, SZ) \
__simd_vf__ inline void asc_squeeze_with_status_##NAME##_vf(__ubuf__ CTYPE* d, __ubuf__ CTYPE* s, uint32_t len) \
{ \
    uint16_t one_rep = asc_get_vf_len() / SZ; \
    uint16_t reps = (len + one_rep - 1) / one_rep; \
    uint32_t rem = len; \
    vector_bool vmask; VECTYPE r0, rd; \
    asc_clear_ar_spr(); \
    for (uint16_t i = 0; i < reps; ++i) { \
        uint32_t n = (rem > one_rep) ? one_rep : rem; \
        vmask = MASK_FN(n); \
        asc_load(r0, s + i * one_rep); \
        asc_squeeze_with_status(rd, r0, vmask); \
        asc_store(d + i * one_rep, rd); \
        rem = (rem > one_rep) ? (rem - one_rep) : 0; \
    } \
} \
__vector__ __global__ void asc_squeeze_with_status_##NAME##_kernel(__gm__ CTYPE* s, __gm__ CTYPE* d) \
{ \
    asc_init(); \
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS; \
    constexpr uint8_t mtx = 1; \
    __gm__ CTYPE* gs = s + block_idx * bl; \
    __gm__ CTYPE* gd = d + block_idx * bl; \
    __ubuf__ CTYPE sl[bl], dl[bl]; \
    uint32_t blen = bl * SZ; uint64_t ss = 0; uint32_t ds = 0; \
    asc_lock(PIPE_MTE2, mtx); \
    asc_copy_gm2ub_align((__ubuf__ CTYPE*)sl, gs, BLK_NUM, blen, 0, 0, true, 0, ss, ds); \
    asc_unlock(PIPE_MTE2, mtx); \
    asc_lock(PIPE_V, mtx); \
    asc_squeeze_with_status_##NAME##_vf((__ubuf__ CTYPE*)dl, (__ubuf__ CTYPE*)sl, bl); \
    asc_unlock(PIPE_V, mtx); \
    asc_lock(PIPE_MTE3, mtx); \
    asc_copy_ub2gm_align(gd, (__ubuf__ CTYPE*)dl, BLK_NUM, blen, 0, ss, ds); \
    asc_unlock(PIPE_MTE3, mtx); \
} \
std::vector<CTYPE> run_asc_squeeze_with_status_##NAME(std::vector<CTYPE>& s, aclrtStream stream) { \
    uint32_t tl = s.size(); size_t bs = tl * SZ; \
    CTYPE* sd = nullptr; CTYPE* dd = nullptr; uint8_t* dh = nullptr; \
    aclrtMalloc((void**)&sd, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST); \
    aclrtMallocHost((void**)&dh, bs); \
    aclrtMemcpy(sd, bs, s.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE); \
    asc_squeeze_with_status_##NAME##_kernel<<<NUM_BLOCKS, 0, stream>>>(sd, dd); \
    aclrtSynchronizeStream(stream); \
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST); \
    std::vector<CTYPE> result((const CTYPE*)dh, (const CTYPE*)(dh + bs)); \
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh); \
    return result; \
}

DEFINE_SQUEEZE_WS_OVERLOAD(int8, int8_t, vector_int8_t, asc_update_mask_b8, sizeof(int8_t))
DEFINE_SQUEEZE_WS_OVERLOAD(uint8, uint8_t, vector_uint8_t, asc_update_mask_b8, sizeof(uint8_t))
DEFINE_SQUEEZE_WS_OVERLOAD(hifloat8, hifloat8_t, vector_hifloat8_t, asc_update_mask_b8, sizeof(hifloat8_t))
DEFINE_SQUEEZE_WS_OVERLOAD(fp8_e5m2, fp8_e5m2_t, vector_fp8_e5m2_t, asc_update_mask_b8, sizeof(fp8_e5m2_t))
DEFINE_SQUEEZE_WS_OVERLOAD(fp8_e4m3fn, fp8_e4m3fn_t, vector_fp8_e4m3fn_t, asc_update_mask_b8, sizeof(fp8_e4m3fn_t))
DEFINE_SQUEEZE_WS_OVERLOAD(fp8_e8m0, fp8_e8m0_t, vector_fp8_e8m0_t, asc_update_mask_b8, sizeof(fp8_e8m0_t))
DEFINE_SQUEEZE_WS_OVERLOAD(int16, int16_t, vector_int16_t, asc_update_mask_b16, sizeof(int16_t))
DEFINE_SQUEEZE_WS_OVERLOAD(uint16, uint16_t, vector_uint16_t, asc_update_mask_b16, sizeof(uint16_t))
DEFINE_SQUEEZE_WS_OVERLOAD(half, half, vector_half, asc_update_mask_b16, sizeof(half))
DEFINE_SQUEEZE_WS_OVERLOAD(bfloat16, bfloat16_t, vector_bfloat16_t, asc_update_mask_b16, sizeof(bfloat16_t))
DEFINE_SQUEEZE_WS_OVERLOAD(int32, int32_t, vector_int32_t, asc_update_mask_b32, sizeof(int32_t))
DEFINE_SQUEEZE_WS_OVERLOAD(uint32, uint32_t, vector_uint32_t, asc_update_mask_b32, sizeof(uint32_t))
DEFINE_SQUEEZE_WS_OVERLOAD(float, float, vector_float, asc_update_mask_b32, sizeof(float))

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

#define RUN_SQUEEZE_WS_TEST(NAME, CTYPE, VAL) \
    { \
        std::vector<CTYPE> s(ELEM_NUM); \
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s[i] = (CTYPE)VAL; } \
        auto result = run_asc_squeeze_with_status_##NAME(s, stream); \
        std::vector<CTYPE> golden(s); \
        failed += verify_result(result, golden, "asc_squeeze_with_status " #NAME); \
    }

    RUN_SQUEEZE_WS_TEST(int8, int8_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(uint8, uint8_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(hifloat8, hifloat8_t, (i % 10))
    RUN_SQUEEZE_WS_TEST(fp8_e5m2, fp8_e5m2_t, (float)(i % 10))
    RUN_SQUEEZE_WS_TEST(fp8_e4m3fn, fp8_e4m3fn_t, (float)(i % 10))
    RUN_SQUEEZE_WS_TEST(fp8_e8m0, fp8_e8m0_t, (float)(i % 10))
    RUN_SQUEEZE_WS_TEST(int16, int16_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(uint16, uint16_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(half, half, (i % 128))
    RUN_SQUEEZE_WS_TEST(bfloat16, bfloat16_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(int32, int32_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(uint32, uint32_t, (i % 128))
    RUN_SQUEEZE_WS_TEST(float, float, (i % 128))

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
