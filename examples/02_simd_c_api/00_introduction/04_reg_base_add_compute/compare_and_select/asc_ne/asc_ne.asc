    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bsd, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bsd);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_ne_int32_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, s1d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bsd, dd, bsd, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bsd));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

__simd_vf__ inline void asc_ne_uint32_vf(__ubuf__ uint32_t* d, __ubuf__ uint32_t* s0, __ubuf__ uint32_t* s1, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(uint32_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_uint32_t r0, r1; vector_bool rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(n);
        asc_load(r0, s0 + i * one_rep);
        asc_load(r1, s1 + i * one_rep);
        asc_ne(rd, r0, r1, vmask);
        asc_storealign(d + i * one_rep, rd, vmask);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_ne_uint32_kernel(__gm__ uint32_t* s0, __gm__ uint32_t* s1, __gm__ uint32_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ uint32_t* gs0 = s0 + block_idx * bl;
    __gm__ uint32_t* gs1 = s1 + block_idx * bl;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __ubuf__ uint32_t s0l[bl], s1l[bl];
    __ubuf__ uint32_t dl[bl];
    uint32_t blen = bl * sizeof(uint32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)s1l, gs1, BLK_NUM, blen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_ne_uint32_vf((__ubuf__ uint32_t*)dl, (__ubuf__ uint32_t*)s0l, (__ubuf__ uint32_t*)s1l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, BLK_NUM, blen, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint32_t> run_asc_ne_uint32(std::vector<uint32_t>& s0, std::vector<uint32_t>& s1, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(uint32_t); size_t bsd = tl * sizeof(uint32_t);
    uint32_t* s0d = nullptr; uint32_t* s1d = nullptr; uint32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bsd, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bsd);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_ne_uint32_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, s1d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bsd, dd, bsd, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bsd));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

__simd_vf__ inline void asc_ne_float_vf(__ubuf__ uint32_t* d, __ubuf__ float* s0, __ubuf__ float* s1, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(float);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_float r0, r1; vector_bool rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b32(n);
        asc_load(r0, s0 + i * one_rep);
        asc_load(r1, s1 + i * one_rep);
        asc_ne(rd, r0, r1, vmask);
        asc_storealign(d + i * one_rep, rd, vmask);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_ne_float_kernel(__gm__ float* s0, __gm__ float* s1, __gm__ uint32_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ float* gs0 = s0 + block_idx * bl;
    __gm__ float* gs1 = s1 + block_idx * bl;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __ubuf__ float s0l[bl], s1l[bl];
    __ubuf__ uint32_t dl[bl];
    uint32_t blen = bl * sizeof(float); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)s0l, gs0, BLK_NUM, blen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ float*)s1l, gs1, BLK_NUM, blen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_ne_float_vf((__ubuf__ uint32_t*)dl, (__ubuf__ float*)s0l, (__ubuf__ float*)s1l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, BLK_NUM, blen, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint32_t> run_asc_ne_float(std::vector<float>& s0, std::vector<float>& s1, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(float); size_t bsd = tl * sizeof(uint32_t);
    float* s0d = nullptr; float* s1d = nullptr; uint32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bsd, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bsd);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_ne_float_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, s1d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bsd, dd, bsd, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bsd));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // int8
        std::vector<int8_t> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int8_t)(i % 128); s1[i] = (int8_t)((i + 1) % 128); }
        auto result = run_asc_ne_int8(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne int8");
    }

    { // uint8
        std::vector<uint8_t> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint8_t)(i % 128); s1[i] = (uint8_t)((i + 1) % 128); }
        auto result = run_asc_ne_uint8(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne uint8");
    }

    { // int16
        std::vector<int16_t> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int16_t)(i % 128); s1[i] = (int16_t)((i + 1) % 128); }
        auto result = run_asc_ne_int16(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne int16");
    }

    { // uint16
        std::vector<uint16_t> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint16_t)(i % 128); s1[i] = (uint16_t)((i + 1) % 128); }
        auto result = run_asc_ne_uint16(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne uint16");
    }

    { // half
        std::vector<half> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (half)(i % 128); s1[i] = (half)((i + 1) % 128); }
        auto result = run_asc_ne_half(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne half");
    }

    { // int32
        std::vector<int32_t> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int32_t)(i % 128); s1[i] = (int32_t)((i + 1) % 128); }
        auto result = run_asc_ne_int32(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne int32");
    }

    { // uint32
        std::vector<uint32_t> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint32_t)(i % 128); s1[i] = (uint32_t)((i + 1) % 128); }
        auto result = run_asc_ne_uint32(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne uint32");
    }

    { // float
        std::vector<float> s0(ELEM_NUM), s1(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (float)(i % 128); s1[i] = (float)((i + 1) % 128); }
        auto result = run_asc_ne_float(s0, s1, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)((s0[i] != s1[i]) ? 1 : 0); }
        failed += verify_result(result, golden, "asc_ne float");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
