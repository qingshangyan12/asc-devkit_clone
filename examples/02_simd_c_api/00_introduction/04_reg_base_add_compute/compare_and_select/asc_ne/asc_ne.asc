/* !
 * \file asc_ne.asc
 * \brief Sample covering ALL documented overloads of asc_ne
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_ne_int8_vf(__ubuf__ uint32_t* d, __ubuf__ int8_t* s0, __ubuf__ int8_t* s1, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int8_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_int8_t r0, r1; vector_bool rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b8(n);
        asc_load(r0, s0 + i * one_rep);
        asc_load(r1, s1 + i * one_rep);
        asc_ne(rd, r0, r1, vmask);
        asc_storealign(d + i * one_rep, rd, vmask);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_ne_int8_kernel(__gm__ int8_t* s0, __gm__ int8_t* s1, __gm__ uint32_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ int8_t* gs0 = s0 + block_idx * bl;
    __gm__ int8_t* gs1 = s1 + block_idx * bl;
    __gm__ uint32_t* gd = d + block_idx * bl;
    __ubuf__ int8_t s0l[bl], s1l[bl];
    __ubuf__ uint32_t dl[bl];
    uint32_t blen = bl * sizeof(int8_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int8_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_copy_gm2ub_align((__ubuf__ int8_t*)s1l, gs1, BLK_NUM, blen, 0, 0, true, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_ne_int8_vf((__ubuf__ uint32_t*)dl, (__ubuf__ int8_t*)s0l, (__ubuf__ int8_t*)s1l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ uint32_t*)dl, BLK_NUM, blen, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<uint32_t> run_asc_ne_int8(std::vector<int8_t>& s0, std::vector<int8_t>& s1, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(int8_t); size_t bsd = tl * sizeof(uint32_t);
    int8_t* s0d = nullptr; int8_t* s1d = nullptr; uint32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bsd, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bsd);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(s1d, bs, s1.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_ne_int8_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, s1d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bsd, dd, bsd, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint32_t> result((const uint32_t*)dh, (const uint32_t*)(dh + bsd));
    aclrtFree(s0d); aclrtFree(s1d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

