#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;
typedef uint8_t uint8_t;

__simd_vf__ inline void ne_vf(__ubuf__ uint8_t* dst_local, __ubuf__ uint8_t* src0_local, __ubuf__ uint8_t* src1_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = data_len;
    vector_bool vmask;
    vector_uint8_t reg_src0; vector_uint8_t reg_src1; vector_bool reg_dst;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t cur_count = (remaining > one_rep_size) ? one_rep_size : remaining;
        uint32_t mask_cnt = cur_count;
        vmask = asc_update_mask_b8(mask_cnt);
        asc_load(reg_src0, src0_local + i * one_rep_size);
        asc_load(reg_src1, src1_local + i * one_rep_size);
        asc_ne(reg_dst, reg_src0, reg_src1, vmask);
        asc_store(dst_local + i * one_rep_size, reg_dst, cur_count);
        remaining = (remaining > one_rep_size) ? (remaining - one_rep_size) : 0;
    }
}

__vector__ __global__ void ne_custom(__gm__ uint8_t* src0, __gm__ uint8_t* src1, __gm__ uint8_t* dst)
{
    asc_init();
    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint8_t mutex_id = 1;
    __gm__ uint8_t* src0_gm = src0 + block_idx * block_length;
    __gm__ uint8_t* src1_gm = src1 + block_idx * block_length;
    __gm__ uint8_t* dst_gm = dst + block_idx * block_length;
    __ubuf__ uint8_t src0_local[block_length];
    __ubuf__ uint8_t src1_local[block_length];
    __ubuf__ uint8_t dst_local[block_length];
    uint32_t cache_mode0 = 0; uint32_t cache_mode1 = 0; uint32_t cache_mode2 = 0;
    uint32_t burst_length = block_length * sizeof(uint8_t);
    uint64_t src_stride = 0; uint32_t dst_stride = 0;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)src0_local, src0_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)src1_local, src1_gm, BLK_NUM, burst_length, 0, 0, true, cache_mode1, src_stride, dst_stride);
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    ne_vf((__ubuf__ uint8_t*)dst_local, src0_local, src1_local, block_length);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(dst_gm, (__ubuf__ uint8_t*)dst_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride);
    asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<uint8_t> kernel_ne(std::vector<uint8_t>& src0, std::vector<uint8_t>& src1)
{
    constexpr uint32_t numBlocks = NUM_BLOCKS;
    uint32_t totalLength = TOTAL_LENGTH;
    size_t totalByteSize = totalLength * sizeof(uint8_t);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* src0Host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* src1Host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* dstHost = nullptr;
    uint8_t* src0Device = nullptr;
    uint8_t* src1Device = nullptr;
    uint8_t* dstDevice = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)(&dstHost), totalByteSize);
    aclrtMalloc((void**)&src0Device, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1Device, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)src0Device, totalByteSize, src0Host, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)src1Device, totalByteSize, src1Host, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    ne_custom<<<numBlocks, 0, stream>>>(src0Device, src1Device, dstDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstHost, totalByteSize, (uint8_t*)dstDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint8_t> dst((uint8_t*)dstHost, (uint8_t*)(dstHost + totalByteSize));
    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dstDevice);
    aclrtFreeHost(dstHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return dst;
}

uint32_t VerifyResult(std::vector<uint8_t>& output, std::vector<uint8_t>& golden)
{
    auto printTensor = [](std::vector<uint8_t>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        for (size_t i = 0; i < std::min(tensor.size(), maxPrintSize); ++i) {
            std::cout << (int)tensor[i] << " ";
        }
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalLength = TOTAL_LENGTH;
    std::vector<uint8_t> src0(totalLength);
    std::vector<uint8_t> src1(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        src0[i] = i % 200;
        src1[i] = (i + 50) % 200;
    }
    std::vector<uint8_t> output = kernel_ne(src0, src1);
    std::vector<uint8_t> golden(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        golden[i] = (src0[i] != src1[i]) ? 1 : 0;
    }
    return VerifyResult(output, golden);
}