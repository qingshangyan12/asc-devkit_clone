    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ float* gs0 = s0 + block_idx * bl;
    __gm__ float* gd = d + block_idx * bl;
    __ubuf__ float s0l[bl], dl[bl];
    uint32_t blen = bl * sizeof(float); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_loadalign_brc_elem_postupdate_float_vf((__ubuf__ float*)dl, (__ubuf__ float*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ float*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<float> run_asc_loadalign_brc_elem_postupdate_float(std::vector<float>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(float);
    float* s0d = nullptr; float* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_loadalign_brc_elem_postupdate_float_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> result((const float*)dh, (const float*)(dh + bs));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


__simd_vf__ inline void asc_loadalign_brc_elem_postupdate_bfloat16_vf(__ubuf__ bfloat16_t* d, __ubuf__ bfloat16_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(bfloat16_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_bfloat16_t r0;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b16(n);
        asc_loadalign_brc_elem_postupdate(r0, s + i * one_rep);
        asc_store(d + i * one_rep, r0, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_loadalign_brc_elem_postupdate_bfloat16_kernel(__gm__ bfloat16_t* s0, __gm__ bfloat16_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ bfloat16_t* gs0 = s0 + block_idx * bl;
    __gm__ bfloat16_t* gd = d + block_idx * bl;
    __ubuf__ bfloat16_t s0l[bl], dl[bl];
    uint32_t blen = bl * sizeof(bfloat16_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ bfloat16_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_loadalign_brc_elem_postupdate_bfloat16_vf((__ubuf__ bfloat16_t*)dl, (__ubuf__ bfloat16_t*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ bfloat16_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<bfloat16_t> run_asc_loadalign_brc_elem_postupdate_bfloat16(std::vector<bfloat16_t>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(bfloat16_t);
    bfloat16_t* s0d = nullptr; bfloat16_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_loadalign_brc_elem_postupdate_bfloat16_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<bfloat16_t> result((const bfloat16_t*)dh, (const bfloat16_t*)(dh + bs));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // int8
        std::vector<int8_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int8_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_int8(s0, stream);
        std::vector<int8_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (int8_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate int8");
    }

    { // uint8
        std::vector<uint8_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint8_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_uint8(s0, stream);
        std::vector<uint8_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint8_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate uint8");
    }

    { // int16
        std::vector<int16_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int16_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_int16(s0, stream);
        std::vector<int16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (int16_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate int16");
    }

    { // uint16
        std::vector<uint16_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint16_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_uint16(s0, stream);
        std::vector<uint16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint16_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate uint16");
    }

    { // int32
        std::vector<int32_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (int32_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_int32(s0, stream);
        std::vector<int32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (int32_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate int32");
    }

    { // uint32
        std::vector<uint32_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (uint32_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_uint32(s0, stream);
        std::vector<uint32_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (uint32_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate uint32");
    }

    { // half
        std::vector<half> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (half)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_half(s0, stream);
        std::vector<half> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (half)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate half");
    }

    { // float
        std::vector<float> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (float)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_float(s0, stream);
        std::vector<float> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (float)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate float");
    }

    { // bfloat16
        std::vector<bfloat16_t> s0(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { s0[i] = (bfloat16_t)(i % 128); }
        auto result = run_asc_loadalign_brc_elem_postupdate_bfloat16(s0, stream);
        std::vector<bfloat16_t> golden(ELEM_NUM);
        for (uint32_t i = 0; i < ELEM_NUM; ++i) { golden[i] = (bfloat16_t)(s0[i]); }
        failed += verify_result(result, golden, "asc_loadalign_brc_elem_postupdate bfloat16");
    }


    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
