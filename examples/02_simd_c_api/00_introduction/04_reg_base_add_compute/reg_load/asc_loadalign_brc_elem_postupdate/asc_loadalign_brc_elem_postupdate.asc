#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t ELEM_NUM = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;


__simd_vf__ inline void asc_loadalign_brc_elem_postupdate_int8_vf(__ubuf__ int8_t* d, __ubuf__ int8_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int8_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_int8_t r0;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (rem > one_rep) ? one_rep : rem;
        vmask = asc_update_mask_b8(n);
        asc_loadalign_brc_elem_postupdate(r0, s + i * one_rep);
        asc_store(d + i * one_rep, r0, n);
        rem = (rem > one_rep) ? (rem - one_rep) : 0;
    }
}

__vector__ __global__ void asc_loadalign_brc_elem_postupdate_int8_kernel(__gm__ int8_t* s0, __gm__ int8_t* d)
{
    asc_init();
    constexpr uint32_t bl = ELEM_NUM / NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ int8_t* gs0 = s0 + block_idx * bl;
    __gm__ int8_t* gd = d + block_idx * bl;
    __ubuf__ int8_t s0l[bl], dl[bl];
    uint32_t blen = bl * sizeof(int8_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int8_t*)s0l, gs0, BLK_NUM, blen, 0, 0, true, 0, ss, ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_loadalign_brc_elem_postupdate_int8_vf((__ubuf__ int8_t*)dl, (__ubuf__ int8_t*)s0l, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int8_t*)dl, BLK_NUM, blen, 0, ss, ds);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int8_t> run_asc_loadalign_brc_elem_postupdate_int8(std::vector<int8_t>& s0, aclrtStream stream) {
    uint32_t tl = s0.size(); size_t bs = tl * sizeof(int8_t);
    int8_t* s0d = nullptr; int8_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&s0d, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(s0d, bs, s0.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_loadalign_brc_elem_postupdate_int8_kernel<<<NUM_BLOCKS, 0, stream>>>(s0d, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> result((const int8_t*)dh, (const int8_t*)(dh + bs));
    aclrtFree(s0d); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}


