#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_duplicate_scalar_vf(__ubuf__ half* dst_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(half);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = data_len;
    vector_bool vmask; vector_half reg_dst;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t cur_count = (remaining > one_rep_size) ? one_rep_size : remaining;
        uint32_t mask_cnt = cur_count;
        vmask = asc_update_mask_b16(mask_cnt);
        asc_duplicate_scalar(reg_dst, (half)3.5f, vmask);
        asc_store(dst_local + i * one_rep_size, reg_dst, cur_count);
        remaining = (remaining > one_rep_size) ? (remaining - one_rep_size) : 0;
    }
}

__vector__ __global__ void asc_duplicate_scalar_custom(__gm__ half* dst)
{
    asc_init();
    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mutex_id = 1;
    __gm__ half* dst_gm = dst + block_idx * block_length;
    __ubuf__ half dst_local[block_length];
    const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dst_gm) >> 60);
    uint32_t burst_length = block_length * sizeof(half);
    uint64_t src_stride = 0; uint32_t dst_stride = 0;
    asc_lock(PIPE_V, mutex_id); asc_duplicate_scalar_vf((__ubuf__ half*)dst_local, block_length); asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id); asc_copy_ub2gm_align(dst_gm, (__ubuf__ half*)dst_local, BLK_NUM, burst_length, cache_mode2, src_stride, dst_stride); asc_unlock(PIPE_MTE3, mutex_id);
}

std::vector<half> kernel_asc_duplicate_scalar()
{
    constexpr uint32_t num_blocks = NUM_BLOCKS; uint32_t total_length = TOTAL_LENGTH;
    size_t dst_byte_size = total_length * sizeof(half); int32_t device_id = 0;
    uint8_t* dst_host = nullptr; half* dst_device = nullptr;
    aclInit(nullptr); aclrtSetDevice(device_id);
    aclrtMallocHost((void**)(&dst_host), dst_byte_size);
    aclrtMalloc((void**)&dst_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    asc_duplicate_scalar_custom<<<num_blocks, 0>>>(dst_device); aclrtSynchronizeDevice();
    aclrtMemcpy(dst_host, dst_byte_size, (uint8_t*)dst_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<half> dst((half*)dst_host, (half*)(dst_host + dst_byte_size));
    aclrtFree(dst_device); aclrtFreeHost(dst_host); aclrtResetDevice(device_id); aclFinalize(); return dst;
}

uint32_t verify_result(std::vector<half>& output, std::vector<half>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) { std::cout << "[Success] Case accuracy is verification passed." << std::endl; return 0; }
    else { std::cout << "[Failed] Case accuracy is verification failed!" << std::endl; return 1; }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    auto output = kernel_asc_duplicate_scalar();
    std::vector<half> golden(total_length, (half)3.5f);
    return verify_result(output, golden);
}