std::vector<float> run_asc_duplicate_float(std::vector<float>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t bs = tl * sizeof(float);
    float* sd = nullptr; float* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(sd, bs, s.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_duplicate_float_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> result((const float*)dh, (const float*)(dh + bs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

template<typename T>
uint32_t verify_result(std::vector<T>& output, std::vector<T>& golden, const char* name) {
    bool pass = true;
    for (size_t i = 0; i < output.size() && i < golden.size(); ++i) {
        double a = (double)output[i];
        double b = (double)golden[i];
        if (std::abs(a - b) > 1e-3 + 1e-3 * std::abs(b)) { pass = false; break; }
    }
    if (output.size() != golden.size()) pass = false;
    if (!pass) {
        constexpr size_t maxPrint = 10;
        std::cout << name << " Output: ";
        for (size_t i = 0; i < std::min(output.size(), maxPrint); ++i) std::cout << (double)output[i] << " ";
        std::cout << "\n" << name << " Golden: ";
        for (size_t i = 0; i < std::min(golden.size(), maxPrint); ++i) std::cout << (double)golden[i] << " ";
        std::cout << std::endl;
    }
    std::cout << "[" << (pass ? "OK" : "FAIL") << "] " << name << std::endl;
    return pass ? 0 : 1;
}

int32_t main(int32_t argc, char* argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t failed = 0;

    { // int8
        std::vector<int8_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (int8_t)(i % 128); }
        auto result = run_asc_duplicate_int8(s, stream);
        std::vector<int8_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(int8_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate int8");
    }

    { // uint8
        std::vector<uint8_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (uint8_t)(i % 128); }
        auto result = run_asc_duplicate_uint8(s, stream);
        std::vector<uint8_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint8_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate uint8");
    }

    { // fp8_e5m2
        std::vector<fp8_e5m2_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (fp8_e5m2_t)(float)(i % 10); }
        auto result = run_asc_duplicate_fp8_e5m2(s, stream);
        std::vector<fp8_e5m2_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(fp8_e5m2_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate fp8_e5m2");
    }

    { // fp8_e4m3fn
        std::vector<fp8_e4m3fn_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (fp8_e4m3fn_t)(float)(i % 10); }
        auto result = run_asc_duplicate_fp8_e4m3fn(s, stream);
        std::vector<fp8_e4m3fn_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(fp8_e4m3fn_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate fp8_e4m3fn");
    }

    { // int16
        std::vector<int16_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (int16_t)(i % 128); }
        auto result = run_asc_duplicate_int16(s, stream);
        std::vector<int16_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(int16_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate int16");
    }

    { // uint16
        std::vector<uint16_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (uint16_t)(i % 128); }
        auto result = run_asc_duplicate_uint16(s, stream);
        std::vector<uint16_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint16_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate uint16");
    }

    { // half
        std::vector<half> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (half)(i % 128); }
        auto result = run_asc_duplicate_half(s, stream);
        std::vector<half> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(half);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate half");
    }

    { // bfloat16
        std::vector<uint16_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = float_to_bf16((float)(i % 128)); }
        auto result = run_asc_duplicate_bfloat16(s, stream);
        std::vector<uint16_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint16_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate bfloat16");
    }

    { // int32
        std::vector<int32_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (int32_t)(i % 128); }
        auto result = run_asc_duplicate_int32(s, stream);
        std::vector<int32_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(int32_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate int32");
    }

    { // uint32
        std::vector<uint32_t> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (uint32_t)(i % 128); }
        auto result = run_asc_duplicate_uint32(s, stream);
        std::vector<uint32_t> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(uint32_t);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate uint32");
    }

    { // float
        std::vector<float> s(SAMP_ELEM_NUM);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { s[i] = (float)(i % 128); }
        auto result = run_asc_duplicate_float(s, stream);
        std::vector<float> golden(SAMP_ELEM_NUM);
        uint32_t one_rep = 256 / sizeof(float);
        for (uint32_t i = 0; i < SAMP_ELEM_NUM; ++i) { golden[i] = s[(i / one_rep) * one_rep]; }
        failed += verify_result(result, golden, "asc_duplicate float");
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (failed == 0) {
        std::cout << "[Success] All overloads verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] " << failed << " overload(s) verification failed!" << std::endl;
        return 1;
    }
}
