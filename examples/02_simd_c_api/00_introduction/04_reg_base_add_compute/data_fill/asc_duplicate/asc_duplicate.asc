/* !
 * \file asc_duplicate.asc
 * \brief Sample covering ALL documented overloads of asc_duplicate
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

static uint16_t float_to_bf16(float f) {
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    uint32_t lsb = (bits >> 16) & 1;
    uint32_t bias = 0x7FFF + lsb;
    return (uint16_t)((bits + bias) >> 16);
}
static float bf16_to_float(uint16_t raw) {
    uint32_t bits = (uint32_t)raw << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

constexpr uint32_t SAMP_ELEM_NUM = 256;
constexpr uint32_t SAMP_NUM_BLOCKS = 1;
constexpr uint32_t SAMP_BLK_NUM = 1;


__simd_vf__ inline void asc_duplicate_int8_vf(__ubuf__ int8_t* d, __ubuf__ int8_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int8_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_int8_t r0, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        vmask = asc_update_mask_b8(rem);
        asc_load(r0, s + i * one_rep);
        asc_duplicate(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}

__vector__ __global__ void asc_duplicate_int8_kernel(__gm__ int8_t* s, __gm__ int8_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ int8_t* gs = s + block_idx * bl;
    __gm__ int8_t* gd = d + block_idx * bl;
    __ubuf__ int8_t sl[bl], dl[bl];
    uint32_t blen = bl * sizeof(int8_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int8_t*)sl, gs, blen);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_duplicate_int8_vf((__ubuf__ int8_t*)dl, (__ubuf__ int8_t*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int8_t*)dl, blen);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int8_t> run_asc_duplicate_int8(std::vector<int8_t>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t bs = tl * sizeof(int8_t);
    int8_t* sd = nullptr; int8_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(sd, bs, s.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_duplicate_int8_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> result((const int8_t*)dh, (const int8_t*)(dh + bs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

