#include <cstdint>
#include <vector>
#include <algorithm>
#include <iterator>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void asc_duplicate_vf(__ubuf__ int8_t* dst, __ubuf__ int8_t* src, uint32_t data_len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int8_t);
    uint16_t reps = (data_len + one_rep - 1) / one_rep;
    uint32_t remaining = data_len;
    vector_bool mask; vector_int8_t rs, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        uint32_t n = (remaining > one_rep) ? one_rep : remaining;
        uint32_t mc = n;
        mask = asc_update_mask_b8(mc);
        asc_load(rs, src + i * one_rep);
        asc_duplicate(rd, rs, mask);
        asc_store(dst + i * one_rep, rd, n);
        remaining = (remaining > one_rep) ? (remaining - one_rep) : 0;
    }
}

__vector__ __global__ void asc_duplicate_custom(__gm__ int8_t* src, __gm__ int8_t* dst)
{
    asc_init();
    constexpr uint32_t bl = TOTAL_LENGTH / NUM_BLOCKS; constexpr uint8_t mtx = 1;
    __gm__ int8_t* sg = src + block_idx * bl; __gm__ int8_t* dg = dst + block_idx * bl;
    __ubuf__ int8_t sl[bl], dl[bl];
    uint8_t cm0=(uint8_t)(((uint64_t)sg)>>60), cm2=(uint8_t)(((uint64_t)dg)>>60);
    uint32_t blen=bl*sizeof(int8_t); uint64_t ss=0; uint32_t ds=0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int8_t*)sl,sg,BLK_NUM,blen,0,0,true,cm0,ss,ds);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx); asc_duplicate_vf((__ubuf__ int8_t*)dl,(__ubuf__ int8_t*)sl,bl); asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx); asc_copy_ub2gm_align(dg,(__ubuf__ int8_t*)dl,BLK_NUM,blen,cm2,ss,ds); asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int8_t> kernel_asc_duplicate(std::vector<int8_t>& src)
{
    constexpr uint32_t nb = NUM_BLOCKS; size_t bs = src.size()*sizeof(int8_t); int32_t did=0;
    uint8_t *sh=(uint8_t*)src.data(), *dh=nullptr; int8_t *sd=nullptr,*dd=nullptr;
    aclInit(nullptr); aclrtSetDevice(did);
    aclrtMallocHost((void**)(&dh),bs); aclrtMalloc((void**)&sd,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd,bs,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)sd,bs,sh,bs,ACL_MEMCPY_HOST_TO_DEVICE);
    asc_duplicate_custom<<<nb,0>>>(sd,dd); aclrtSynchronizeDevice();
    aclrtMemcpy(dh,bs,(uint8_t*)dd,bs,ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> d((int8_t*)dh,(int8_t*)(dh+bs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    aclrtResetDevice(did); aclFinalize(); return d;
}

uint32_t verify_result(std::vector<int8_t>& o, std::vector<int8_t>& g)
{
    if(std::equal(g.begin(),g.end(),o.begin())){std::cout<<"[Success] Case accuracy is verification passed."<<std::endl;return 0;}
    else{std::cout<<"[Failed] Case accuracy is verification failed!"<<std::endl;return 1;}
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t tl = TOTAL_LENGTH; std::vector<int8_t> src(tl);
    for(uint32_t i=0;i<tl;++i) src[i] = (int8_t)((i%127)-63);
    auto o = kernel_asc_duplicate(src); std::vector<int8_t> g(tl);
    for(uint32_t i=0;i<tl;++i) g[i] = src[i];
    return verify_result(o,g);
}