    asc_duplicate_bfloat16_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>((bfloat16_t*)sd, (bfloat16_t*)dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> result((const uint16_t*)dh, (const uint16_t*)(dh + bs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

__simd_vf__ inline void asc_duplicate_int32_vf(__ubuf__ int32_t* d, __ubuf__ int32_t* s, uint32_t len)
{
    uint16_t one_rep = asc_get_vf_len() / sizeof(int32_t);
    uint16_t reps = (len + one_rep - 1) / one_rep;
    uint32_t rem = len;
    vector_bool vmask; vector_int32_t r0, rd;
    for (uint16_t i = 0; i < reps; ++i) {
        vmask = asc_update_mask_b32(rem);
        asc_load(r0, s + i * one_rep);
        asc_duplicate(rd, r0, vmask);
        asc_store(d + i * one_rep, rd);
    }
}

__vector__ __global__ void asc_duplicate_int32_kernel(__gm__ int32_t* s, __gm__ int32_t* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ int32_t* gs = s + block_idx * bl;
    __gm__ int32_t* gd = d + block_idx * bl;
    __ubuf__ int32_t sl[bl], dl[bl];
    uint32_t blen = bl * sizeof(int32_t); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)sl, gs, blen);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_duplicate_int32_vf((__ubuf__ int32_t*)dl, (__ubuf__ int32_t*)sl, bl);
    asc_unlock(PIPE_V, mtx);
    asc_lock(PIPE_MTE3, mtx);
    asc_copy_ub2gm_align(gd, (__ubuf__ int32_t*)dl, blen);
    asc_unlock(PIPE_MTE3, mtx);
}

std::vector<int32_t> run_asc_duplicate_int32(std::vector<int32_t>& s, aclrtStream stream) {
    uint32_t tl = s.size(); size_t bs = tl * sizeof(int32_t);
    int32_t* sd = nullptr; int32_t* dd = nullptr; uint8_t* dh = nullptr;
    aclrtMalloc((void**)&sd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dd, bs, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&dh, bs);
    aclrtMemcpy(sd, bs, s.data(), bs, ACL_MEMCPY_HOST_TO_DEVICE);
    asc_duplicate_int32_kernel<<<SAMP_NUM_BLOCKS, 0, stream>>>(sd, dd);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dh, bs, dd, bs, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> result((const int32_t*)dh, (const int32_t*)(dh + bs));
    aclrtFree(sd); aclrtFree(dd); aclrtFreeHost(dh);
    return result;
}

