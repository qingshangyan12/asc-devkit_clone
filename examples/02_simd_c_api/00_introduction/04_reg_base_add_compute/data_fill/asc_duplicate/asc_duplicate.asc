}

__vector__ __global__ void asc_duplicate_float_kernel(__gm__ float* s, __gm__ float* d)
{
    asc_init();
    constexpr uint32_t bl = SAMP_ELEM_NUM / SAMP_NUM_BLOCKS;
    constexpr uint8_t mtx = 1;
    __gm__ float* gs = s + block_idx * bl;
    __gm__ float* gd = d + block_idx * bl;
    __ubuf__ float sl[bl], dl[bl];
    uint32_t blen = bl * sizeof(float); uint64_t ss = 0; uint32_t ds = 0;
    asc_lock(PIPE_MTE2, mtx);
    asc_copy_gm2ub_align((__ubuf__ float*)sl, gs, blen);
    asc_unlock(PIPE_MTE2, mtx);
    asc_lock(PIPE_V, mtx);
    asc_duplicate_float_vf((__ubuf__ float*)dl, (__ubuf__ float*)sl, bl);
    asc_unlock(PIPE_V, mtx);
