// Build/run (CCE vcvt): "$ASCEND_HOME_PATH/bin/bisheng" -DUSE_VCVT_BUILTIN=0 --npu-arch=dav-3510 -O2 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/00_introduction/06_cce_builtin_vcvt_compare/cce_builtin_vcvt_compare.asc -lm -o /tmp/cce_vcvt_compare && timeout --signal=TERM --kill-after=5s 30s /tmp/cce_vcvt_compare
// Build/run (builtin vcvt): "$ASCEND_HOME_PATH/bin/bisheng" -DUSE_VCVT_BUILTIN=1 --npu-arch=dav-3510 -O2 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/00_introduction/06_cce_builtin_vcvt_compare/cce_builtin_vcvt_compare.asc -lm -o /tmp/builtin_vcvt_compare && timeout --signal=TERM --kill-after=5s 30s /tmp/builtin_vcvt_compare
// Architecture: dav-3510 (Ascend 950)

#include <cstdint>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#ifndef USE_VCVT_BUILTIN
#define USE_VCVT_BUILTIN 0
#endif

namespace {
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr float SCALE = 0.5f;
constexpr float POST_BIAS = -0.25f;

__simd_vf__ inline void QuantizePipeline(
    __ubuf__ float* output, __ubuf__ float* source, __ubuf__ float* residual)
{
    vector_float source_reg, residual_reg, scaled_reg, mixed_reg, restored_reg, output_reg;
    vector_half quantized_reg;
    vector_bool mask_b32 = asc_create_mask_b32(PAT_ALL);
    vector_bool mask_b16 = asc_create_mask_b16(PAT_ALL);
    asc_loadalign(source_reg, source);
    asc_loadalign(residual_reg, residual);

    // A runtime data path prevents the conversion from being folded into a constant.
    asc_mul_scalar(scaled_reg, source_reg, SCALE, mask_b32);
    asc_add(mixed_reg, scaled_reg, residual_reg, mask_b32);

#if USE_VCVT_BUILTIN
    // Direct compiler builtin path, selected only for the builtin comparison build.
    quantized_reg = __builtin_cce_vcvtff_f322f16_x(
        mixed_reg, mask_b32, static_cast<unsigned long long>(ROUND_R.value),
        static_cast<unsigned long long>(RS_DISABLE.value), static_cast<unsigned long long>(PART_EVEN.value));
#else
    // CCE intrinsic path: f32 -> f16, RINT, no saturation, destination even lanes, zeroing mode.
    vcvt(quantized_reg, mixed_reg, mask_b32, ROUND_R, RS_DISABLE, PART_EVEN, MODE_ZEROING);
    // Equivalent direct builtin (enable with -DUSE_VCVT_BUILTIN=1):
    // quantized_reg = __builtin_cce_vcvtff_f322f16_x(mixed_reg, mask_b32,
    //     static_cast<unsigned long long>(ROUND_R.value), static_cast<unsigned long long>(RS_DISABLE.value),
    //     static_cast<unsigned long long>(PART_EVEN.value));
#endif

    // Read the even half lanes back to float, then retain a dependent post-conversion operation.
    asc_half2float(restored_reg, quantized_reg, mask_b16);
    asc_add_scalar(output_reg, restored_reg, POST_BIAS, mask_b32);
    asc_storealign(output, output_reg, mask_b32);
}

__global__ __vector__ void CceBuiltinVcvtKernel(
    __gm__ float* output, __gm__ float* source, __gm__ float* residual)
{
    asc_init();
    __ubuf__ float source_local[ELEMENT_COUNT];
    __ubuf__ float residual_local[ELEMENT_COUNT];
    __ubuf__ float output_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(source_local, source, sizeof(source_local));
    asc_copy_gm2ub_align(residual_local, residual, sizeof(residual_local));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    QuantizePipeline(output_local, source_local, residual_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, sizeof(output_local));
    asc_sync();
}

uint32_t FloatBits(float value)
{
    uint32_t bits;
    std::memcpy(&bits, &value, sizeof(bits));
    return bits;
}

float BitsToFloat(uint32_t bits)
{
    float value;
    std::memcpy(&value, &bits, sizeof(value));
    return value;
}

uint16_t FloatToHalfRne(float value)
{
    const uint32_t bits = FloatBits(value);
    const uint32_t sign = (bits >> 16) & 0x8000U;
    const uint32_t exponent = (bits >> 23) & 0xffU;
    const uint32_t fraction = bits & 0x7fffffU;
    if (exponent == 0xffU) {
        if (fraction == 0) return static_cast<uint16_t>(sign | 0x7c00U);
        const uint32_t payload = fraction >> 13;
        return static_cast<uint16_t>(sign | 0x7c00U | (payload == 0 ? 1U : payload));
    }

    const int32_t half_exponent = static_cast<int32_t>(exponent) - 127 + 15;
    if (half_exponent >= 31) return static_cast<uint16_t>(sign | 0x7c00U);
    if (half_exponent <= 0) {
        if (half_exponent < -10) return static_cast<uint16_t>(sign);
        const uint32_t mantissa = fraction | 0x800000U;
        const uint32_t shift = static_cast<uint32_t>(14 - half_exponent);
        uint32_t result = mantissa >> shift;
        const uint32_t remainder = mantissa & ((1U << shift) - 1U);
        const uint32_t halfway = 1U << (shift - 1U);
        if (remainder > halfway || (remainder == halfway && (result & 1U))) ++result;
        return static_cast<uint16_t>(sign | result);
    }

    uint32_t result = sign | (static_cast<uint32_t>(half_exponent) << 10) | (fraction >> 13);
    const uint32_t remainder = fraction & 0x1fffU;
    if (remainder > 0x1000U || (remainder == 0x1000U && (result & 1U))) ++result;
    return static_cast<uint16_t>(result);
}

float HalfToFloat(uint16_t value)
{
    const uint32_t sign = static_cast<uint32_t>(value & 0x8000U) << 16;
    uint32_t exponent = (value >> 10) & 0x1fU;
    uint32_t fraction = value & 0x03ffU;
    uint32_t bits;
    if (exponent == 0) {
        if (fraction == 0) return BitsToFloat(sign);
        int32_t unbiased_exponent = -14;
        while ((fraction & 0x0400U) == 0) {
            fraction <<= 1;
            --unbiased_exponent;
        }
        fraction &= 0x03ffU;
        bits = sign | (static_cast<uint32_t>(unbiased_exponent + 127) << 23) | (fraction << 13);
    } else if (exponent == 0x1fU) {
        bits = sign | 0x7f800000U | (fraction << 13);
    } else {
        bits = sign | ((exponent + 112U) << 23) | (fraction << 13);
    }
    return BitsToFloat(bits);
}

float Golden(float source, float residual)
{
    volatile float scaled = source * SCALE;
    volatile float mixed = scaled + residual;
    volatile float restored = HalfToFloat(FloatToHalfRne(mixed));
    return restored + POST_BIAS;
}

void PrintBits(uint32_t bits)
{
    std::cout << "0x" << std::hex << std::setw(8) << std::setfill('0') << bits
              << std::dec << std::setfill(' ');
}
} // namespace

int main()
{
    const float target_pattern[] = {
        0.0f, -0.0f, 1.00048828125f, 1.00146484375f,
        0.333251953125f, -0.333251953125f, 65504.0f, 65519.0f,
        5.960464477539063e-08f, 2.9802322387695312e-08f, 1.0e-07f, -1.0e-07f,
        123.4567f, -789.1234f, 4095.5f, -4095.5f,
    };
    const float residual_pattern[] = {
        0.0f, -0.0f, 0.25f, -0.25f,
        0.125f, -0.125f, 1.0f, -1.0f,
        0.0f, 0.0f, 0.5f, -0.5f,
        0.25f, -0.25f, 0.5f, -0.5f,
    };
    std::vector<float> source(ELEMENT_COUNT), residual(ELEMENT_COUNT), output(ELEMENT_COUNT, 0.0f);
    std::vector<float> golden(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        const float target = target_pattern[i % 16];
        residual[i] = residual_pattern[i % 16];
        source[i] = 2.0f * (target - residual[i]);
        golden[i] = Golden(source[i], residual[i]);
    }

    float* source_device = nullptr;
    float* residual_device = nullptr;
    float* output_device = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtMalloc(reinterpret_cast<void**>(&source_device), source.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&residual_device), residual.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(source_device, source.size() * sizeof(float), source.data(), source.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(residual_device, residual.size() * sizeof(float), residual.data(), residual.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    CceBuiltinVcvtKernel<<<1, 0>>>(output_device, source_device, residual_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(float), output_device, output.size() * sizeof(float),
        ACL_MEMCPY_DEVICE_TO_HOST);

    std::cout << "Path: " << (USE_VCVT_BUILTIN ? "__builtin_cce_vcvtff_f322f16_x" : "vcvt") << std::endl;
    std::cout << "lane  source      residual    output(bits)   golden(bits)" << std::endl;
    for (uint32_t i = 0; i < 12; ++i) {
        std::cout << std::setw(4) << i << std::setw(12) << source[i] << std::setw(12) << residual[i] << "  ";
        PrintBits(FloatBits(output[i]));
        std::cout << "  ";
        PrintBits(FloatBits(golden[i]));
        std::cout << std::endl;
    }

    bool passed = true;
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        if (FloatBits(output[i]) != FloatBits(golden[i])) {
            std::cout << "Mismatch at lane " << i << ": output=";
            PrintBits(FloatBits(output[i]));
            std::cout << ", golden=";
            PrintBits(FloatBits(golden[i]));
            std::cout << std::endl;
            passed = false;
        }
    }
    std::cout << (passed ? "[Success] vcvt pipeline matches bit-exact f16 round-trip golden."
                        : "[Failed] vcvt pipeline differs from golden.") << std::endl;

    aclrtFree(output_device);
    aclrtFree(residual_device);
    aclrtFree(source_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
