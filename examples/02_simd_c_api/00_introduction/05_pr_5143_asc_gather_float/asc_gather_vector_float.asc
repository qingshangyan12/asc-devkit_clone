// Build/run (examples/02_simd_c_api/00_introduction/05_pr_5143_asc_gather_float/asc_gather_vector_float.asc): "$ASCEND_HOME_PATH/bin/bisheng" -iquote "$ASC_DEVKIT_PR5143_ROOT/include" -iquote "$ASC_DEVKIT_PR5143_ROOT" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/00_introduction/05_pr_5143_asc_gather_float/asc_gather_vector_float.asc -lm -o /tmp/pr5143_asc_gather_vector_float && timeout --signal=TERM --kill-after=5s 30s /tmp/pr5143_asc_gather_vector_float
// Architecture: dav-3510 (Ascend 950)

#include <cstdint>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t OUTPUT_COUNT = ELEMENT_COUNT * 2;

__simd_vf__ inline void GatherVectorFloat(__ubuf__ uint32_t* output, __ubuf__ float* source,
    __ubuf__ uint32_t* index)
{
    vector_float float_source, float_output;
    vector_uint32_t uint_source, uint_output, index_reg;
    vector_bool mask = asc_create_mask_b32(PAT_ALL);
    asc_loadalign(float_source, source);
    asc_loadalign(uint_source, reinterpret_cast<__ubuf__ uint32_t*>(source));
    asc_loadalign(index_reg, index);

    // New PR 5143 overload: gather float register lanes according to uint32 indices.
    asc_gather(float_output, float_source, index_reg);
    // The existing uint32 overload is the bitwise reference for the internal cast path.
    asc_gather(uint_output, uint_source, index_reg);

    asc_storealign(reinterpret_cast<__ubuf__ float*>(output), float_output, mask);
    asc_storealign(output + ELEMENT_COUNT, uint_output, mask);
}

__global__ __vector__ void AscGatherVectorFloatKernel(
    __gm__ uint32_t* output, __gm__ float* source, __gm__ uint32_t* index)
{
    asc_init();
    __ubuf__ float source_local[ELEMENT_COUNT];
    __ubuf__ uint32_t index_local[ELEMENT_COUNT];
    __ubuf__ uint32_t output_local[OUTPUT_COUNT];

    asc_copy_gm2ub_align(source_local, source, sizeof(source_local));
    asc_copy_gm2ub_align(index_local, index, sizeof(index_local));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    GatherVectorFloat(output_local, source_local, index_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, sizeof(output_local));
    asc_sync();
}

float BitsToFloat(uint32_t bits)
{
    float value;
    std::memcpy(&value, &bits, sizeof(value));
    return value;
}

void PrintBits(uint32_t bits)
{
    std::cout << "0x" << std::hex << std::setw(8) << std::setfill('0') << bits
              << std::dec << std::setfill(' ');
}
} // namespace

int main()
{
    std::vector<uint32_t> source_bits(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        const float value = static_cast<float>(i) - 31.25f;
        std::memcpy(&source_bits[i], &value, sizeof(value));
    }
    const uint32_t special_bits[] = {
        0x00000000U, 0x80000000U, 0x3f800000U, 0xbf800000U,
        0x3f000000U, 0xc0200000U, 0x7f800000U, 0xff800000U,
        0x7fc12345U, 0xffc54321U, 0x00000001U, 0x80000001U,
        0x007fffffU, 0x00800000U, 0x7f7fffffU, 0xff7fffffU,
    };
    std::memcpy(source_bits.data(), special_bits, sizeof(special_bits));

    std::vector<float> source(ELEMENT_COUNT);
    std::memcpy(source.data(), source_bits.data(), source_bits.size() * sizeof(uint32_t));
    std::vector<uint32_t> index(ELEMENT_COUNT);
    std::vector<uint32_t> golden(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        const uint32_t source_lane = i < 16 ? i : (i * 17 + 7) % ELEMENT_COUNT;
        index[i] = source_lane + (i % 4) * ELEMENT_COUNT;
        golden[i] = source_bits[index[i] % ELEMENT_COUNT];
    }

    std::vector<uint32_t> output(OUTPUT_COUNT, 0);
    float* source_device = nullptr;
    uint32_t* index_device = nullptr;
    uint32_t* output_device = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtMalloc(reinterpret_cast<void**>(&source_device), source.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&index_device), index.size() * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(source_device, source.size() * sizeof(float), source.data(), source.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(index_device, index.size() * sizeof(uint32_t), index.data(), index.size() * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscGatherVectorFloatKernel<<<1, 0>>>(output_device, source_device, index_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint32_t), output_device,
        output.size() * sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST);

    std::cout << "lane  index  src-lane  input(value/bits)       float-output     uint32-reference  golden" << std::endl;
    for (uint32_t i = 0; i < 16; ++i) {
        const uint32_t source_lane = index[i] % ELEMENT_COUNT;
        std::cout << std::setw(4) << i << std::setw(7) << index[i] << std::setw(10) << source_lane << "  "
                  << std::setw(10) << BitsToFloat(source_bits[source_lane]) << '/';
        PrintBits(source_bits[source_lane]);
        std::cout << "  ";
        PrintBits(output[i]);
        std::cout << "  ";
        PrintBits(output[ELEMENT_COUNT + i]);
        std::cout << "  ";
        PrintBits(golden[i]);
        std::cout << std::endl;
    }

    bool passed = true;
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        if (output[i] != golden[i] || output[ELEMENT_COUNT + i] != golden[i]) {
            std::cout << "Mismatch at lane " << i << ": float=";
            PrintBits(output[i]);
            std::cout << ", uint32=";
            PrintBits(output[ELEMENT_COUNT + i]);
            std::cout << ", golden=";
            PrintBits(golden[i]);
            std::cout << std::endl;
            passed = false;
        }
    }
    std::cout << (passed ? "[Success] vector_float gather is bit-exact with uint32 gather and golden."
                        : "[Failed] vector_float gather differs from uint32 gather or golden.") << std::endl;

    aclrtFree(output_device);
    aclrtFree(index_device);
    aclrtFree(source_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
