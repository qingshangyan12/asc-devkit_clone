/* !
 * \file scalar_cache_mode_perf.asc
 * \brief Verify asc_set_scalar_cache_mode functional effect via msopprof L2Cache metrics
 *
 * 4 cases:
 *   Case 1: Read  NORMAL_PERSISTENT  — repeated read, expect L2 hit on pass 2
 *   Case 2: Read  NOTALLOC_KEEP      — repeated read, expect L2 miss on pass 2
 *   Case 3: Write NORMAL_FIRST_VICTIM — write allocates L2, verify data correctness
 *   Case 4: Write NOTALLOC_CLEAN      — write bypasses L2, verify data correctness
 */

#include "scalar_cache_mode_perf.h"
#include "data_utils.h"
#include "acl/acl.h"
#include <vector>
#include <cmath>

constexpr uint32_t scenarioNum = SCENARIO_NUM;

__vector__ __global__ __aicore__ void kernel_test(__gm__ float* src, __gm__ float* dst)
{
    asc_init();

    if (asc_get_block_idx() != 0) {
        return;
    }

    if constexpr (scenarioNum == 1) {
        ProcessReadPersistent(src, dst);
    } else if constexpr (scenarioNum == 2) {
        ProcessReadStreamNoAlloc(src, dst);
    } else if constexpr (scenarioNum == 3) {
        ProcessWriteNormal(dst);
    } else {
        ProcessWriteNoAlloc(dst);
    }

    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    printf("========================================\n");
    printf("Scalar Cache Mode Performance - Case %u\n", (uint32_t)scenarioNum);
    printf("========================================\n");

    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    constexpr size_t dataLen = WORK_SET_SIZE;
    size_t byteSize = dataLen * sizeof(float);

    uint8_t* inputHost = nullptr;
    uint8_t* inputDevice = nullptr;
    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;

    aclrtMallocHost((void**)(&outputHost), byteSize);
    aclrtMalloc((void**)&outputDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    if constexpr (scenarioNum <= 2) {
        aclrtMallocHost((void**)(&inputHost), byteSize);
        aclrtMalloc((void**)&inputDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

        size_t fileSize = 0;
        ReadFile("./input/input.bin", fileSize, inputHost, byteSize);
        aclrtMemcpy(inputDevice, byteSize, inputHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    kernel_test<<<1, nullptr, stream>>>(reinterpret_cast<__gm__ float*>(inputDevice),
                                        reinterpret_cast<__gm__ float*>(outputDevice));
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, byteSize, outputDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, byteSize);

    if constexpr (scenarioNum <= 2) {
        aclrtFree(inputDevice);
        aclrtFreeHost(inputHost);
    }

    if constexpr (scenarioNum >= 3) {
        size_t goldenSize = 0;
        uint8_t* goldenHost = nullptr;
        aclrtMallocHost((void**)(&goldenHost), byteSize);
        ReadFile("./output/golden.bin", goldenSize, goldenHost, byteSize);

        float* output = reinterpret_cast<float*>(outputHost);
        float* golden = reinterpret_cast<float*>(goldenHost);
        bool success = true;
        for (size_t i = 0; i < dataLen; i++) {
            if (std::fabs(output[i] - golden[i]) > 1e-5f) {
                printf("[Failed] Mismatch at index %zu: output=%f, golden=%f\n", i, output[i], golden[i]);
                success = false;
                break;
            }
        }
        if (success) {
            printf("[Success] Write data correctness verification passed.\n");
        }
        aclrtFreeHost(goldenHost);
    }

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Case %u completed.\ntest pass!\n", (uint32_t)scenarioNum);
    return 0;
}
