/* !
 * \file scalar_cache_mode.asc
 * \brief Verify asc_set_scalar_cache_mode / asc_get_scalar_cache_mode correctness
 *
 * Verification strategy: set-get round-trip + no-op behaviour check.
 *   - Read channel (asc_load_l2_cache_mode):  4 round-trip + 2 no-op = 6 cases (bit 0-5)
 *   - Write channel (asc_store_l2_cache_mode): 4 round-trip           = 4 cases (bit 6-9)
 *   All pass => passMask == 0x3FF.
 */

#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t C_API_ONE_BLOCK_SIZE = 32;
constexpr uint32_t VF_LEN_BYTES = 256;
constexpr uint32_t UB_RESULT_COUNT = VF_LEN_BYTES / sizeof(uint32_t);
constexpr uint32_t EXPECTED_PASS_MASK = 0x3FF;

__simd_vf__ inline void store_scalar_to_ub(__ubuf__ uint32_t* dst, uint32_t value)
{
    vector_uint32_t reg;
    asc_duplicate_scalar(reg, value);
    asc_store(dst, reg);
}

__vector__ __global__ __aicore__ void scalar_cache_mode_test(__gm__ uint32_t* gmResult)
{
    asc_init();

    if (asc_get_block_idx() != 0) {
        return;
    }

    uint32_t passMask = 0;

    // ================================================================
    // Read channel round-trip tests (bit 0-3)
    // ================================================================

    // bit 0: NORMAL_FIRST_VICTIM
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
    {
        asc_load_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM) {
            passMask |= (1u << 0);
        }
    }

    // bit 1: NORMAL_LAST_VICTIM
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NORMAL_LAST_VICTIM);
    {
        asc_load_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_load_l2_cache_mode::NORMAL_LAST_VICTIM) {
            passMask |= (1u << 1);
        }
    }

    // bit 2: NORMAL_PERSISTENT
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NORMAL_PERSISTENT);
    {
        asc_load_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_load_l2_cache_mode::NORMAL_PERSISTENT) {
            passMask |= (1u << 2);
        }
    }

    // bit 3: NOTALLOC_KEEP
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NOTALLOC_KEEP);
    {
        asc_load_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_load_l2_cache_mode::NOTALLOC_KEEP) {
            passMask |= (1u << 3);
        }
    }

    // ================================================================
    // Read channel no-op tests (bit 4-5)
    // NOTALLOC_CLEAN and NOTALLOC_DROP are not supported on read channel;
    // set should be a no-op, leaving the previously written mode unchanged.
    // ================================================================

    // bit 4: NOTALLOC_CLEAN no-op (baseline = NORMAL_LAST_VICTIM)
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NORMAL_LAST_VICTIM);
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NOTALLOC_CLEAN);
    {
        asc_load_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_load_l2_cache_mode::NORMAL_LAST_VICTIM) {
            passMask |= (1u << 4);
        }
    }

    // bit 5: NOTALLOC_DROP no-op (baseline = NORMAL_LAST_VICTIM)
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NORMAL_LAST_VICTIM);
    asc_set_scalar_cache_mode(asc_load_l2_cache_mode::NOTALLOC_DROP);
    {
        asc_load_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_load_l2_cache_mode::NORMAL_LAST_VICTIM) {
            passMask |= (1u << 5);
        }
    }

    // ================================================================
    // Write channel round-trip tests (bit 6-9)
    // ================================================================

    // bit 6: NORMAL_FIRST_VICTIM
    asc_set_scalar_cache_mode(asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM);
    {
        asc_store_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM) {
            passMask |= (1u << 6);
        }
    }

    // bit 7: NORMAL_LAST_VICTIM
    asc_set_scalar_cache_mode(asc_store_l2_cache_mode::NORMAL_LAST_VICTIM);
    {
        asc_store_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_store_l2_cache_mode::NORMAL_LAST_VICTIM) {
            passMask |= (1u << 7);
        }
    }

    // bit 8: NORMAL_PERSISTENT
    asc_set_scalar_cache_mode(asc_store_l2_cache_mode::NORMAL_PERSISTENT);
    {
        asc_store_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_store_l2_cache_mode::NORMAL_PERSISTENT) {
            passMask |= (1u << 8);
        }
    }

    // bit 9: NOTALLOC_CLEAN
    asc_set_scalar_cache_mode(asc_store_l2_cache_mode::NOTALLOC_CLEAN);
    {
        asc_store_l2_cache_mode got;
        asc_get_scalar_cache_mode(got);
        if (got == asc_store_l2_cache_mode::NOTALLOC_CLEAN) {
            passMask |= (1u << 9);
        }
    }

    // ================================================================
    // Transfer passMask from PIPE_S to GM via UB
    // ================================================================
    __ubuf__ uint32_t ubResult[UB_RESULT_COUNT];

    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    store_scalar_to_ub(ubResult, passMask);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(
        gmResult, ubResult, 1, C_API_ONE_BLOCK_SIZE, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);

    asc_sync_pipe(PIPE_ALL);
}

uint32_t run_scalar_cache_mode_test()
{
    constexpr uint32_t numBlocks = 1;
    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint32_t* gmResult = nullptr;
    uint32_t hostResult = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMalloc((void**)&gmResult, C_API_ONE_BLOCK_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

    scalar_cache_mode_test<<<numBlocks, 0, stream>>>(gmResult);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(&hostResult, sizeof(hostResult), gmResult, sizeof(hostResult), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(gmResult);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return hostResult;
}

void verify_and_print(uint32_t passMask)
{
    const char* caseNames[] = {
        "read  NORMAL_FIRST_VICTIM round-trip",
        "read  NORMAL_LAST_VICTIM  round-trip",
        "read  NORMAL_PERSISTENT   round-trip",
        "read  NOTALLOC_KEEP       round-trip",
        "read  NOTALLOC_CLEAN      no-op",
        "read  NOTALLOC_DROP       no-op",
        "write NORMAL_FIRST_VICTIM round-trip",
        "write NORMAL_LAST_VICTIM  round-trip",
        "write NORMAL_PERSISTENT   round-trip",
        "write NOTALLOC_CLEAN      round-trip",
    };

    for (uint32_t i = 0; i < 10; i++) {
        bool passed = (passMask & (1u << i)) != 0;
        std::cout << "[Case " << i << "] " << caseNames[i] << " ... "
                  << (passed ? "PASS" : "FAIL") << std::endl;
    }

    std::cout << "passMask=0x" << std::hex << passMask << std::dec << std::endl;
    if (passMask == EXPECTED_PASS_MASK) {
        std::cout << "[Success] Scalar cache mode verification passed." << std::endl;
    } else {
        std::cout << "[Failed] Scalar cache mode verification failed!" << std::endl;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t passMask = run_scalar_cache_mode_test();
    verify_and_print(passMask);
    return (passMask == EXPECTED_PASS_MASK) ? 0 : 1;
}
