/* !
 * \file saturation_strategy_perf.asc
 * \brief Verify asc_set_saturation_strategy functional effect on saturation control source
 *
 * 4 cases (cross-product of strategy × API variant):
 *   Case 1: USE_API    + non-_sat API → truncation  (-15536)
 *   Case 2: USE_API    + _sat API     → saturation  (32767)
 *   Case 3: USE_GLOBAL + flag=true    → saturation  (32767), flag overrides non-_sat API
 *   Case 4: USE_GLOBAL + flag=false   → truncation  (-15536), flag overrides _sat API
 */

#include "saturation_strategy_perf.h"
#include "data_utils.h"
#include "acl/acl.h"
#include <vector>
#include <cstring>

__vector__ __global__ __aicore__ void kernel_test(__gm__ uint8_t* gmInput, __gm__ uint8_t* gmOutput)
{
    asc_init();

    if (asc_get_block_idx() != 0) {
        return;
    }

    ProcessStrategyTest(gmInput, gmOutput);

    asc_sync_pipe(PIPE_ALL);
}

bool compare_int16_arrays(const int16_t* output, const int16_t* golden, size_t count, const char* label)
{
    for (size_t i = 0; i < count; i++) {
        if (output[i] != golden[i]) {
            printf("[Failed] %s mismatch at index %zu: output=%d, golden=%d\n",
                   label, i, static_cast<int>(output[i]), static_cast<int>(golden[i]));
            return false;
        }
    }
    printf("[PASS] %s\n", label);
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    printf("========================================\n");
    printf("Saturation Strategy Performance Test\n");
    printf("========================================\n");

    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    constexpr size_t inputSize = WORK_SET_SIZE * sizeof(int32_t);
    constexpr size_t outputSize = TOTAL_OUTPUT_SIZE * sizeof(int16_t);

    uint8_t* inputHost = nullptr;
    uint8_t* outputHost = nullptr;
    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    aclrtMallocHost((void**)(&inputHost), inputSize);
    aclrtMallocHost((void**)(&outputHost), outputSize);
    aclrtMalloc((void**)&inputDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t fileSize = 0;
    ReadFile("./input/input.bin", fileSize, inputHost, inputSize);
    aclrtMemcpy(inputDevice, inputSize, inputHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_test<<<1, nullptr, stream>>>(inputDevice, outputDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputSize, outputDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, outputSize);

    size_t goldenSize = 0;
    uint8_t* goldenHost = nullptr;
    aclrtMallocHost((void**)(&goldenHost), outputSize);
    ReadFile("./output/golden.bin", goldenSize, goldenHost, outputSize);

    int16_t* output = reinterpret_cast<int16_t*>(outputHost);
    int16_t* golden = reinterpret_cast<int16_t*>(goldenHost);

    bool success = true;
    success &= compare_int16_arrays(
        output, golden, PACKED_OUTPUT_SIZE,
        "Case 1: USE_API + non-_sat API (expect truncation -15536)");
    success &= compare_int16_arrays(
        output + PACKED_OUTPUT_SIZE, golden + PACKED_OUTPUT_SIZE, PACKED_OUTPUT_SIZE,
        "Case 2: USE_API + _sat API (expect saturation 32767)");
    success &= compare_int16_arrays(
        output + PACKED_OUTPUT_SIZE * 2, golden + PACKED_OUTPUT_SIZE * 2, PACKED_OUTPUT_SIZE,
        "Case 3: USE_GLOBAL + flag=true (expect saturation 32767)");
    success &= compare_int16_arrays(
        output + PACKED_OUTPUT_SIZE * 3, golden + PACKED_OUTPUT_SIZE * 3, PACKED_OUTPUT_SIZE,
        "Case 4: USE_GLOBAL + flag=false (expect truncation -15536)");

    if (success) {
        printf("[Success] Saturation strategy verification passed.\n");
    } else {
        printf("[Failed] Saturation strategy verification failed!\n");
    }

    aclrtFreeHost(goldenHost);
    aclrtFree(inputDevice);
    aclrtFree(outputDevice);
    aclrtFreeHost(inputHost);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return success ? 0 : 1;
}
