/* !
 * \file saturation_flag.asc
 * \brief Verify asc_set_saturation_flag / asc_get_saturation_flag correctness
 *
 * Verification strategy: set-get round-trip consistency.
 *   4 modes (FLOAT/FLOAT8/INT/CAST) × 2 states (true/false) = 8 cases (bit 0-7)
 *   All pass => passMask == 0xFF.
 *
 * Key point: INT mode has inverted bit polarity (enable=true → CTRL[53]=1),
 * while FLOAT/FLOAT8/CAST have normal polarity (enable=true → CTRL bit=0).
 * Round-trip test with both true/false exposes any polarity mishandling.
 */

#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t C_API_ONE_BLOCK_SIZE = 32;
constexpr uint32_t VF_LEN_BYTES = 256;
constexpr uint32_t UB_RESULT_COUNT = VF_LEN_BYTES / sizeof(uint32_t);
constexpr uint32_t EXPECTED_PASS_MASK = 0xFF;

__simd_vf__ inline void store_scalar_to_ub(__ubuf__ uint32_t* dst, uint32_t value)
{
    vector_uint32_t reg;
    asc_duplicate_scalar(reg, value);
    asc_store(dst, reg);
}

__vector__ __global__ __aicore__ void saturation_flag_test(__gm__ uint32_t* gmResult)
{
    asc_init();

    if (asc_get_block_idx() != 0) {
        return;
    }

    uint32_t passMask = 0;

    // ================================================================
    // FLOAT mode (CTRL[48], normal polarity: enable=true→bit=0)
    // ================================================================

    // bit 0: FLOAT enable=true
    asc_set_saturation_flag(asc_saturation_mode::FLOAT, true);
    if (asc_get_saturation_flag(asc_saturation_mode::FLOAT)) {
        passMask |= (1u << 0);
    }

    // bit 1: FLOAT enable=false
    asc_set_saturation_flag(asc_saturation_mode::FLOAT, false);
    if (!asc_get_saturation_flag(asc_saturation_mode::FLOAT)) {
        passMask |= (1u << 1);
    }

    // ================================================================
    // FLOAT8 mode (CTRL[50], normal polarity: enable=true→bit=0)
    // ================================================================

    // bit 2: FLOAT8 enable=true
    asc_set_saturation_flag(asc_saturation_mode::FLOAT8, true);
    if (asc_get_saturation_flag(asc_saturation_mode::FLOAT8)) {
        passMask |= (1u << 2);
    }

    // bit 3: FLOAT8 enable=false
    asc_set_saturation_flag(asc_saturation_mode::FLOAT8, false);
    if (!asc_get_saturation_flag(asc_saturation_mode::FLOAT8)) {
        passMask |= (1u << 3);
    }

    // ================================================================
    // INT mode (CTRL[53], INVERTED polarity: enable=true→bit=1)
    // ================================================================

    // bit 4: INT enable=true (saturation → CTRL[53]=1)
    asc_set_saturation_flag(asc_saturation_mode::INT, true);
    if (asc_get_saturation_flag(asc_saturation_mode::INT)) {
        passMask |= (1u << 4);
    }

    // bit 5: INT enable=false (truncation → CTRL[53]=0)
    asc_set_saturation_flag(asc_saturation_mode::INT, false);
    if (!asc_get_saturation_flag(asc_saturation_mode::INT)) {
        passMask |= (1u << 5);
    }

    // ================================================================
    // CAST mode (CTRL[59], normal polarity: enable=true→bit=0)
    // ================================================================

    // bit 6: CAST enable=true
    asc_set_saturation_flag(asc_saturation_mode::CAST, true);
    if (asc_get_saturation_flag(asc_saturation_mode::CAST)) {
        passMask |= (1u << 6);
    }

    // bit 7: CAST enable=false
    asc_set_saturation_flag(asc_saturation_mode::CAST, false);
    if (!asc_get_saturation_flag(asc_saturation_mode::CAST)) {
        passMask |= (1u << 7);
    }

    // ================================================================
    // Transfer passMask from PIPE_S to GM via UB
    // ================================================================
    __ubuf__ uint32_t ubResult[UB_RESULT_COUNT];

    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    store_scalar_to_ub(ubResult, passMask);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(
        gmResult, ubResult, 1, C_API_ONE_BLOCK_SIZE, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);

    asc_sync_pipe(PIPE_ALL);
}

uint32_t run_saturation_flag_test()
{
    constexpr uint32_t numBlocks = 1;
    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint32_t* gmResult = nullptr;
    uint32_t hostResult = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMalloc((void**)&gmResult, C_API_ONE_BLOCK_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

    saturation_flag_test<<<numBlocks, 0, stream>>>(gmResult);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(&hostResult, sizeof(hostResult), gmResult, sizeof(hostResult), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(gmResult);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return hostResult;
}

void verify_and_print(uint32_t passMask)
{
    const char* caseNames[] = {
        "FLOAT  enable=true  (sat)",
        "FLOAT  enable=false (no-sat)",
        "FLOAT8 enable=true  (sat)",
        "FLOAT8 enable=false (no-sat)",
        "INT    enable=true  (sat)",
        "INT    enable=false (trunc)",
        "CAST   enable=true  (sat)",
        "CAST   enable=false (trunc)",
    };

    for (uint32_t i = 0; i < 8; i++) {
        bool passed = (passMask & (1u << i)) != 0;
        std::cout << "[Case " << i << "] " << caseNames[i] << " ... "
                  << (passed ? "PASS" : "FAIL") << std::endl;
    }

    std::cout << "passMask=0x" << std::hex << passMask << std::dec << std::endl;
    if (passMask == EXPECTED_PASS_MASK) {
        std::cout << "[Success] Saturation flag verification passed." << std::endl;
    } else {
        std::cout << "[Failed] Saturation flag verification failed!" << std::endl;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t passMask = run_saturation_flag_test();
    verify_and_print(passMask);
    return (passMask == EXPECTED_PASS_MASK) ? 0 : 1;
}
