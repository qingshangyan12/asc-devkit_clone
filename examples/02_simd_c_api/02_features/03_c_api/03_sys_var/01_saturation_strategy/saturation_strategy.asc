/* !
 * \file saturation_strategy.asc
 * \brief Verify asc_set_saturation_strategy / asc_get_saturation_strategy correctness
 *
 * Verification strategy: set-get round-trip consistency.
 *   2 strategies (USE_API/USE_GLOBAL) = 2 cases (bit 0-1)
 *   All pass => passMask == 0x3.
 */

#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t C_API_ONE_BLOCK_SIZE = 32;
constexpr uint32_t VF_LEN_BYTES = 256;
constexpr uint32_t UB_RESULT_COUNT = VF_LEN_BYTES / sizeof(uint32_t);
constexpr uint32_t EXPECTED_PASS_MASK = 0x3;

__simd_vf__ inline void store_scalar_to_ub(__ubuf__ uint32_t* dst, uint32_t value)
{
    vector_uint32_t reg;
    asc_duplicate_scalar(reg, value);
    asc_store(dst, reg);
}

__vector__ __global__ __aicore__ void saturation_strategy_test(__gm__ uint32_t* gmResult)
{
    asc_init();

    if (asc_get_block_idx() != 0) {
        return;
    }

    uint32_t passMask = 0;

    // ================================================================
    // Saturation strategy round-trip tests (bit 0-1)
    // CTRL[60]: USE_API → 0, USE_GLOBAL → 1
    // ================================================================

    // bit 0: USE_API
    asc_set_saturation_strategy(asc_override_strategy::USE_API);
    if (asc_get_saturation_strategy() == asc_override_strategy::USE_API) {
        passMask |= (1u << 0);
    }

    // bit 1: USE_GLOBAL
    asc_set_saturation_strategy(asc_override_strategy::USE_GLOBAL);
    if (asc_get_saturation_strategy() == asc_override_strategy::USE_GLOBAL) {
        passMask |= (1u << 1);
    }

    // ================================================================
    // Transfer passMask from PIPE_S to GM via UB
    // ================================================================
    __ubuf__ uint32_t ubResult[UB_RESULT_COUNT];

    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    store_scalar_to_ub(ubResult, passMask);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(
        gmResult, ubResult, 1, C_API_ONE_BLOCK_SIZE, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);

    asc_sync_pipe(PIPE_ALL);
}

uint32_t run_saturation_strategy_test()
{
    constexpr uint32_t numBlocks = 1;
    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint32_t* gmResult = nullptr;
    uint32_t hostResult = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMalloc((void**)&gmResult, C_API_ONE_BLOCK_SIZE, ACL_MEM_MALLOC_HUGE_FIRST);

    saturation_strategy_test<<<numBlocks, 0, stream>>>(gmResult);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(&hostResult, sizeof(hostResult), gmResult, sizeof(hostResult), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(gmResult);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return hostResult;
}

void verify_and_print(uint32_t passMask)
{
    const char* caseNames[] = {
        "USE_API    round-trip",
        "USE_GLOBAL round-trip",
    };

    for (uint32_t i = 0; i < 2; i++) {
        bool passed = (passMask & (1u << i)) != 0;
        std::cout << "[Case " << i << "] " << caseNames[i] << " ... "
                  << (passed ? "PASS" : "FAIL") << std::endl;
    }

    std::cout << "passMask=0x" << std::hex << passMask << std::dec << std::endl;
    if (passMask == EXPECTED_PASS_MASK) {
        std::cout << "[Success] Saturation strategy verification passed." << std::endl;
    } else {
        std::cout << "[Failed] Saturation strategy verification failed!" << std::endl;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t passMask = run_saturation_strategy_test();
    verify_and_print(passMask);
    return (passMask == EXPECTED_PASS_MASK) ? 0 : 1;
}
