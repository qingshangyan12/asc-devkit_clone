/* !
 * \file saturation_flag_perf.asc
 * \brief Verify asc_set_saturation_flag functional effect on computation results
 *
 * 3 cases:
 *   Case 1: FLOAT — half add overflow, sat→65504, nosat→+INF
 *   Case 2: INT   — int16 add overflow, sat→32767, nosat→-5536
 *   Case 3: CAST  — int32→int16 conversion overflow, sat→32767, nosat→-15536
 *
 * Each case runs the same computation twice (saturation ON then OFF),
 * outputs both results to GM, host compares against golden.
 */

#include "saturation_flag_perf.h"
#include "data_utils.h"
#include "acl/acl.h"
#include <vector>
#include <cmath>
#include <cstring>

constexpr uint32_t scenarioNum = SCENARIO_NUM;

__vector__ __global__ __aicore__ void kernel_test(__gm__ uint8_t* gmInput, __gm__ uint8_t* gmOutput)
{
    asc_init();

    if (asc_get_block_idx() != 0) {
        return;
    }

    if constexpr (scenarioNum == 1) {
        ProcessFloatSaturation(gmInput, gmOutput);
    } else if constexpr (scenarioNum == 2) {
        ProcessIntSaturation(gmInput, gmOutput);
    } else {
        ProcessCastSaturation(gmInput, gmOutput);
    }

    asc_sync_pipe(PIPE_ALL);
}

template <typename T>
bool compare_arrays(const T* output, const T* golden, size_t count, const char* label)
{
    for (size_t i = 0; i < count; i++) {
        if (output[i] != golden[i]) {
            printf("[Failed] %s mismatch at index %zu: output=%d, golden=%d\n",
                   label, i, static_cast<int>(output[i]), static_cast<int>(golden[i]));
            return false;
        }
    }
    printf("[PASS] %s\n", label);
    return true;
}

bool compare_half_arrays(const half* output, const half* golden, size_t count, const char* label)
{
    for (size_t i = 0; i < count; i++) {
        float out_f = static_cast<float>(output[i]);
        float gold_f = static_cast<float>(golden[i]);
        bool out_inf = std::isinf(out_f);
        bool gold_inf = std::isinf(gold_f);
        if (out_inf && gold_inf) {
            continue;
        }
        if (out_inf != gold_inf || std::fabs(out_f - gold_f) > 0.5f) {
            printf("[Failed] %s mismatch at index %zu: output=%f, golden=%f\n", label, i, out_f, gold_f);
            return false;
        }
    }
    printf("[PASS] %s\n", label);
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    printf("========================================\n");
    printf("Saturation Flag Performance - Case %u\n", (uint32_t)scenarioNum);
    printf("========================================\n");

    uint32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclrtContext context;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    if constexpr (scenarioNum == 1) {
        constexpr uint32_t N = WORK_SET_SIZE_16;
        constexpr size_t inputSize = N * sizeof(half) * 2;
        constexpr size_t resultSize = N * sizeof(half);
        constexpr size_t outputSize = resultSize * 2;

        uint8_t* inputHost = nullptr;
        uint8_t* outputHost = nullptr;
        uint8_t* inputDevice = nullptr;
        uint8_t* outputDevice = nullptr;

        aclrtMallocHost((void**)(&inputHost), inputSize);
        aclrtMallocHost((void**)(&outputHost), outputSize);
        aclrtMalloc((void**)&inputDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&outputDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

        size_t fileSize = 0;
        ReadFile("./input/input.bin", fileSize, inputHost, inputSize);
        aclrtMemcpy(inputDevice, inputSize, inputHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

        kernel_test<<<1, nullptr, stream>>>(inputDevice, outputDevice);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(outputHost, outputSize, outputDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", outputHost, outputSize);

        size_t goldenSize = 0;
        uint8_t* goldenHost = nullptr;
        aclrtMallocHost((void**)(&goldenHost), outputSize);
        ReadFile("./output/golden.bin", goldenSize, goldenHost, outputSize);

        half* output = reinterpret_cast<half*>(outputHost);
        half* golden = reinterpret_cast<half*>(goldenHost);
        bool success = true;
        success &= compare_half_arrays(output, golden, N, "FLOAT sat-ON  (expect 65504)");
        success &= compare_half_arrays(output + N, golden + N, N, "FLOAT sat-OFF (expect +INF)");

        if (success) {
            printf("[Success] Saturation flag FLOAT verification passed.\n");
        }

        aclrtFreeHost(goldenHost);
        aclrtFree(inputDevice);
        aclrtFree(outputDevice);
        aclrtFreeHost(inputHost);
        aclrtFreeHost(outputHost);
    } else if constexpr (scenarioNum == 2) {
        constexpr uint32_t N = WORK_SET_SIZE_16;
        constexpr size_t inputSize = N * sizeof(int16_t) * 2;
        constexpr size_t resultSize = N * sizeof(int16_t);
        constexpr size_t outputSize = resultSize * 2;

        uint8_t* inputHost = nullptr;
        uint8_t* outputHost = nullptr;
        uint8_t* inputDevice = nullptr;
        uint8_t* outputDevice = nullptr;

        aclrtMallocHost((void**)(&inputHost), inputSize);
        aclrtMallocHost((void**)(&outputHost), outputSize);
        aclrtMalloc((void**)&inputDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&outputDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

        size_t fileSize = 0;
        ReadFile("./input/input.bin", fileSize, inputHost, inputSize);
        aclrtMemcpy(inputDevice, inputSize, inputHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

        kernel_test<<<1, nullptr, stream>>>(inputDevice, outputDevice);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(outputHost, outputSize, outputDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", outputHost, outputSize);

        size_t goldenSize = 0;
        uint8_t* goldenHost = nullptr;
        aclrtMallocHost((void**)(&goldenHost), outputSize);
        ReadFile("./output/golden.bin", goldenSize, goldenHost, outputSize);

        int16_t* output = reinterpret_cast<int16_t*>(outputHost);
        int16_t* golden = reinterpret_cast<int16_t*>(goldenHost);
        bool success = true;
        success &= compare_arrays(output, golden, N, "INT sat-ON  (expect 32767)");
        success &= compare_arrays(output + N, golden + N, N, "INT sat-OFF (expect -5536)");

        if (success) {
            printf("[Success] Saturation flag INT verification passed.\n");
        }

        aclrtFreeHost(goldenHost);
        aclrtFree(inputDevice);
        aclrtFree(outputDevice);
        aclrtFreeHost(inputHost);
        aclrtFreeHost(outputHost);
    } else {
        constexpr uint32_t N = WORK_SET_SIZE_32;
        constexpr size_t inputSize = N * sizeof(int32_t);
        constexpr size_t resultSize = N * sizeof(int16_t) * 2;
        constexpr size_t outputSize = resultSize * 2;

        uint8_t* inputHost = nullptr;
        uint8_t* outputHost = nullptr;
        uint8_t* inputDevice = nullptr;
        uint8_t* outputDevice = nullptr;

        aclrtMallocHost((void**)(&inputHost), inputSize);
        aclrtMallocHost((void**)(&outputHost), outputSize);
        aclrtMalloc((void**)&inputDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&outputDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

        size_t fileSize = 0;
        ReadFile("./input/input.bin", fileSize, inputHost, inputSize);
        aclrtMemcpy(inputDevice, inputSize, inputHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

        kernel_test<<<1, nullptr, stream>>>(inputDevice, outputDevice);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(outputHost, outputSize, outputDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", outputHost, outputSize);

        size_t goldenSize = 0;
        uint8_t* goldenHost = nullptr;
        aclrtMallocHost((void**)(&goldenHost), outputSize);
        ReadFile("./output/golden.bin", goldenSize, goldenHost, outputSize);

        int16_t* output = reinterpret_cast<int16_t*>(outputHost);
        int16_t* golden = reinterpret_cast<int16_t*>(goldenHost);
        bool success = true;
        success &= compare_arrays(output, golden, N * 2, "CAST sat-ON  (expect 32767 at even, 0 at odd)");
        success &= compare_arrays(output + N * 2, golden + N * 2, N * 2, "CAST sat-OFF (expect -15536 at even, 0 at odd)");

        if (success) {
            printf("[Success] Saturation flag CAST verification passed.\n");
        }

        aclrtFreeHost(goldenHost);
        aclrtFree(inputDevice);
        aclrtFree(outputDevice);
        aclrtFreeHost(inputHost);
        aclrtFreeHost(outputHost);
    }

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
