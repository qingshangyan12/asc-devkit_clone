/*!
 * \file asc_copy_gm2l1.asc
 * \brief Demonstrates GM-to-L1 matrix data movement with the Ascend C API.
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

#ifndef SCENARIO_NUM
#error "SCENARIO_NUM must be provided by CMake."
#endif

constexpr uint32_t M = 128;
constexpr uint32_t K = 128;
constexpr uint32_t N = 256;
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_BYTES = 32;
constexpr uint32_t FIXPIPE_QUANT_ADDR_GRANULARITY = 128;

constexpr uint32_t A_L1_ELEMENTS = M * K;
constexpr uint32_t B_L1_ELEMENTS = K * N;
constexpr uint32_t C_L0_ELEMENTS = M * N;
constexpr uint32_t BIAS_ELEMENTS = N;
constexpr uint32_t QUANT_ELEMENTS = N;

constexpr uint8_t L2_CACHE_NORMAL = 0;
constexpr uint8_t UNIT_FLAG_DISABLE = 0;

__global__ __cube__ void asc_copy_gm2l1(
    __gm__ half* a, __gm__ half* b,
#if SCENARIO_NUM == 5
    __gm__ int8_t* c,
#else
    __gm__ float* c,
#endif
    __gm__ float* bias, __gm__ uint64_t* quant_pre)
{
    asc_init();

    __cbuf__ half a_l1[A_L1_ELEMENTS];
    __cbuf__ half b_l1[B_L1_ELEMENTS];
    __ca__ half a_l0[A_L1_ELEMENTS];
    __cb__ half b_l0[B_L1_ELEMENTS];
    __cc__ float c_l0[C_L0_ELEMENTS];
#if SCENARIO_NUM == 4
    __cbuf__ float bias_l1[BIAS_ELEMENTS];
    __biasbuf__ float bias_bt[BIAS_ELEMENTS];
#elif SCENARIO_NUM == 5
    __cbuf__ uint64_t quant_l1[QUANT_ELEMENTS];
    __fbuf__ uint64_t quant_fb[QUANT_ELEMENTS];
#endif

#if SCENARIO_NUM == 1
    // The input is already stored in NZ layout.
    asc_copy_gm2l1_sync(
        (__cbuf__ void*)a_l1, (__gm__ void*)a, 1, A_L1_ELEMENTS * sizeof(half) / C0_BYTES, 0, 0, 0);
    asc_copy_gm2l1_sync(
        (__cbuf__ void*)b_l1, (__gm__ void*)b, 1, B_L1_ELEMENTS * sizeof(half) / C0_BYTES, 0, 0, 0);
#elif SCENARIO_NUM == 2 || SCENARIO_NUM == 4 || SCENARIO_NUM == 5
    // Convert ND input to NZ while moving GM data to L1.
    asc_copy_gm2l1_nd2nz_sync(a_l1, a, K * sizeof(half), L2_CACHE_NORMAL, M, K, 0, false);
    asc_copy_gm2l1_nd2nz_sync(b_l1, b, N * sizeof(half), L2_CACHE_NORMAL, K, N, 0, false);
#elif SCENARIO_NUM == 3
    // Convert DN input to NZ while moving GM data to L1.
    asc_copy_gm2l1_dn2nz_sync(a_l1, a, M * sizeof(half), L2_CACHE_NORMAL, M, K, 0, false);
    asc_copy_gm2l1_dn2nz_sync(b_l1, b, K * sizeof(half), L2_CACHE_NORMAL, K, N, 0, false);
#else
#error "SCENARIO_NUM must be 1, 2, 3, 4, or 5."
#endif

#if SCENARIO_NUM == 4
    // Convert the 1 x N ND bias to NZ in L1, then move it to BiasTable (C2).
    asc_copy_gm2l1_nd2nz_sync(bias_l1, bias, N * sizeof(float), L2_CACHE_NORMAL, 1, N, 0, false);
    const uint64_t bias_bt_addr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(bias_bt)) / CUBE_BLOCK;
    asc_copy_l12bt_sync(bias_bt_addr, bias_l1, BIAS_ELEMENTS * sizeof(float));
#endif

    // Move the NZ data from L1 to L0A/L0B for matrix multiplication.
    asc_copy_l12l0a_sync(
        a_l0, a_l1, 0, 0, M / CUBE_BLOCK, K * sizeof(half) / C0_BYTES, M / CUBE_BLOCK, M / CUBE_BLOCK);
    asc_copy_l12l0b_transpose_sync(
        b_l0, b_l1, 0, 0, K / CUBE_BLOCK, N * sizeof(half) / C0_BYTES, K / CUBE_BLOCK, K / CUBE_BLOCK);

#if SCENARIO_NUM == 4
    // Use the BiasTable (C2) as the initial C matrix value.
    asc_mmad_sync(c_l0, a_l0, b_l0, M, K, N, UNIT_FLAG_DISABLE, true, true, false);
#else
    asc_mmad_sync(c_l0, a_l0, b_l0, M, K, N, UNIT_FLAG_DISABLE, true, false, true);
#endif

#if SCENARIO_NUM == 5
    // Move per-column quantization parameters from L1 to Fixpipe Buffer and configure Fixpipe.
    asc_copy_gm2l1_sync(
        (__cbuf__ void*)quant_l1, (__gm__ void*)quant_pre, 1,
        QUANT_ELEMENTS * sizeof(uint64_t) / C0_BYTES, 0, 0, 0);
    asc_copy_l12fb_sync((__fbuf__ void*)quant_fb, (__cbuf__ void*)quant_l1, QUANT_ELEMENTS * sizeof(uint64_t));
    const uint64_t quant_fb_addr =
        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quant_fb)) / FIXPIPE_QUANT_ADDR_GRANULARITY;
    asc_set_l0c2gm_config(0, quant_fb_addr, false);

    // Convert the NZ result in L0C to row-major int8 data in GM with vector quantization.
    asc_copy_l0c2gm_sync(
        c, c_l0, N, M, N, M, L2_CACHE_NORMAL, 0, 0,
        static_cast<uint64_t>(QuantMode_t::VQF322B8_PRE), 0, false, true,
        static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, 0, false, false, false, false);
#else
    // Convert the NZ result in L0C to a row-major float result in GM.
    asc_copy_l0c2gm_sync(
        c, c_l0, N, M, N, M, L2_CACHE_NORMAL, 0, 0,
        static_cast<uint64_t>(QuantMode_t::NoQuant), 0, false, true,
        static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, 0, false, false, false, false);
#endif
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t a_file_size = M * K * sizeof(half);
    constexpr size_t b_file_size = K * N * sizeof(half);
#if SCENARIO_NUM == 5
    constexpr size_t c_file_size = M * N * sizeof(int8_t);
#else
    constexpr size_t c_file_size = M * N * sizeof(float);
#endif
    constexpr size_t bias_file_size = BIAS_ELEMENTS * sizeof(float);
    constexpr size_t quant_file_size = QUANT_ELEMENTS * sizeof(uint64_t);
    constexpr int32_t device_id = 0;

    uint8_t* a_host = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* c_host = nullptr;
    half* a_device = nullptr;
    half* b_device = nullptr;
#if SCENARIO_NUM == 5
    int8_t* c_device = nullptr;
#else
    float* c_device = nullptr;
#endif
    uint8_t* bias_host = nullptr;
    float* bias_device = nullptr;
    uint8_t* quant_host = nullptr;
    uint64_t* quant_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

#if SCENARIO_NUM == 4
    aclrtMallocHost(reinterpret_cast<void**>(&bias_host), bias_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/bias_gm.bin", bias_file_size, bias_host, bias_file_size);
    aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
#endif

#if SCENARIO_NUM == 5
    aclrtMallocHost(reinterpret_cast<void**>(&quant_host), quant_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&quant_device), quant_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/quant_pre.bin", quant_file_size, quant_host, quant_file_size);
    aclrtMemcpy(quant_device, quant_file_size, quant_host, quant_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
#endif

    asc_copy_gm2l1<<<1, 0, stream>>>(a_device, b_device, c_device, bias_device, quant_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
#if SCENARIO_NUM == 4
    aclrtFree(bias_device);
    aclrtFreeHost(bias_host);
#endif
#if SCENARIO_NUM == 5
    aclrtFree(quant_device);
    aclrtFreeHost(quant_host);
#endif
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
