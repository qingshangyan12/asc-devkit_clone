// Build/run (examples/02_simd_c_api/04_c_api_call_examples/scalar_compute/asc_atomic_inc.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh scalar_compute/asc_atomic_inc
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t ELEMENTS = 8;

__global__ __vector__ void AscAtomicIncKernel(__gm__ int64_t* output)
{
    asc_init();
    __gm__ uint32_t* address = reinterpret_cast<__gm__ uint32_t*>(output);
    const uint32_t old_value = asc_atomic_inc(address, 20U);
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
    output[1] = static_cast<int64_t>(old_value);
    asc_sync();
}
} // namespace

int main()
{
    std::vector<int64_t> input = {10, 0};
    std::vector<int64_t> golden = {11, 10};
    input.resize(ELEMENTS, 0);
    golden.resize(ELEMENTS, 0);
    std::vector<int64_t> output(ELEMENTS, -1);
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<int64_t> output_device(ELEMENTS);
    if (!output_device.Allocate("aclrtMalloc(output)") || !output_device.CopyFrom(input)) return 1;
    AscAtomicIncKernel<<<1, 0>>>(output_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::Compare(output, golden);
    std::cout << (passed ? "[Success] asc_atomic_inc passed." : "[Failed] asc_atomic_inc failed.") << std::endl;
    return passed ? 0 : 1;
}
