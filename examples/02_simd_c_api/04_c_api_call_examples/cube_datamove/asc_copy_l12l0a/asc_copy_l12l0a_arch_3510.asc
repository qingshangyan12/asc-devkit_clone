// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_copy_l12l0a/asc_copy_l12l0a_arch_3510.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_copy_l12l0a/asc_copy_l12l0a_arch_3510.asc -lm -o /tmp/c_api_cube_datamove_asc_copy_l12l0a_asc_copy_l12l0a_arch_3510 && /tmp/c_api_cube_datamove_asc_copy_l12l0a_asc_copy_l12l0a_arch_3510
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t LOCAL_BUFFER_BYTES = 8192;
constexpr uint32_t IO_BYTES = 8192;

__global__ __cube__ void AscCopyL12l0aAscCopyL12l0aArch3510Kernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ca__ uint8_t a_l0_bytes[LOCAL_BUFFER_BYTES];
    __cbuf__ uint8_t l1_bytes[LOCAL_BUFFER_BYTES];
    asc_copy_l12l0a(reinterpret_cast<__ca__ bfloat16_t*>(a_l0_bytes), reinterpret_cast<__cbuf__ bfloat16_t*>(l1_bytes), static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint8_t>(1), static_cast<uint8_t>(1), static_cast<int16_t>(0), static_cast<uint16_t>(0));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_l12l0a_sync(reinterpret_cast<__ca__ bfloat16_t*>(a_l0_bytes), reinterpret_cast<__cbuf__ bfloat16_t*>(l1_bytes), static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint8_t>(1), static_cast<uint8_t>(1), static_cast<int16_t>(0), static_cast<uint16_t>(0));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_l12l0a_transpose(reinterpret_cast<__ca__ bfloat16_t*>(a_l0_bytes), reinterpret_cast<__cbuf__ bfloat16_t*>(l1_bytes), static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint8_t>(1), static_cast<uint8_t>(1), static_cast<int16_t>(0), static_cast<uint16_t>(0));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_l12l0a_transpose_sync(reinterpret_cast<__ca__ bfloat16_t*>(a_l0_bytes), reinterpret_cast<__cbuf__ bfloat16_t*>(l1_bytes), static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint8_t>(1), static_cast<uint8_t>(1), static_cast<int16_t>(0), static_cast<uint16_t>(0));
    asc_sync_pipe(PIPE_ALL);
    output[0] = input[0];
}
} // namespace

int main()
{
    std::vector<uint8_t> input(IO_BYTES, 1), output(IO_BYTES, 0);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (IO_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (IO_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(uint8_t), output.data(), output.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscCopyL12l0aAscCopyL12l0aArch3510Kernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint8_t), output_device, output.size() * sizeof(uint8_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
