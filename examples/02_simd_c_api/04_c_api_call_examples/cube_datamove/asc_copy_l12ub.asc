// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_copy_l12ub.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_copy_l12ub.asc -lm -o /tmp/c_api_cube_datamove_asc_copy_l12ub && /tmp/c_api_cube_datamove_asc_copy_l12ub
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t LOCAL_BUFFER_BYTES = 8192;
constexpr uint32_t IO_BYTES = 8192;

__global__ __mix__(1, 2) void AscCopyL12ubKernel(__gm__ uint8_t* output, __gm__ uint8_t* input, uint32_t mode)
{
    asc_init();
    __ubuf__ uint8_t ub_bytes[LOCAL_BUFFER_BYTES];
    __cbuf__ uint8_t l1_bytes[LOCAL_BUFFER_BYTES];
    if ASC_IS_AIC {
        asc_copy_gm2l1(l1_bytes, input, 1, 2, 0, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        if (mode == 0) asc_copy_l12ub(ub_bytes, l1_bytes, false, 1, 1, 0, 0);
        else asc_copy_l12ub_sync(ub_bytes, l1_bytes, false, 1, 1, 0, 0);
        output[mode] = input[mode];
        asc_dcci_single(output + mode);
    }
}
} // namespace

int main()
{
    std::vector<uint8_t> input(IO_BYTES, 1), output(IO_BYTES, 0);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (IO_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (IO_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(uint8_t), output.data(), output.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    for (uint32_t mode = 0; mode < 2; ++mode) {
        AscCopyL12ubKernel<<<1, 0>>>(output_device, input_device, mode);
        aclrtSynchronizeDevice();
    }
    aclrtMemcpy(output.data(), output.size() * sizeof(uint8_t), output_device, output.size() * sizeof(uint8_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
