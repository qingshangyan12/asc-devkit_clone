// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_copy_l12gm.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh cube_datamove/asc_copy_l12gm
// Architecture: dav-2201

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t LOCAL_BUFFER_BYTES = 8192;
constexpr uint32_t IO_BYTES = 8192;

__global__ __cube__ void AscCopyL12gmKernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __cbuf__ uint8_t l1_bytes[LOCAL_BUFFER_BYTES];
    asc_copy_l12gm(reinterpret_cast<__gm__ void*>(output), reinterpret_cast<__cbuf__ void*>(l1_bytes), static_cast<uint16_t>(1), static_cast<uint16_t>(1), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_l12gm_sync(reinterpret_cast<__gm__ void*>(output), reinterpret_cast<__cbuf__ void*>(l1_bytes), static_cast<uint16_t>(1), static_cast<uint16_t>(1), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
    asc_sync_pipe(PIPE_ALL);
    output[0] = input[0];
}
} // namespace

int main()
{
    std::vector<uint8_t> input(IO_BYTES, 1), output(IO_BYTES, 0), golden(IO_BYTES, 0);
    golden[0] = input[0];
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(IO_BYTES);
    CApiExample::DeviceBuffer<uint8_t> output_device(IO_BYTES);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input) || !output_device.CopyFrom(golden)) return 1;
    AscCopyL12gmKernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_copy_l12gm/asc_copy_l12gm_sync passed." : "[Failed] asc_copy_l12gm/asc_copy_l12gm_sync failed.") << std::endl;
    return passed ? 0 : 1;
}
