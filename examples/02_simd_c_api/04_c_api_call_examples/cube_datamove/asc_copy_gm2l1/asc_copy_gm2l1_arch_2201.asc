    asc_sync_pipe(PIPE_ALL);
    asc_copy_gm2l1_pad4(reinterpret_cast<__cbuf__ void*>(l1_bytes), reinterpret_cast<__gm__ void*>(input), static_cast<uint32_t>(32));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_gm2l1_pad5(reinterpret_cast<__cbuf__ void*>(l1_bytes), reinterpret_cast<__gm__ void*>(input), static_cast<uint32_t>(32));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_gm2l1_pad6(reinterpret_cast<__cbuf__ void*>(l1_bytes), reinterpret_cast<__gm__ void*>(input), static_cast<uint32_t>(32));
