__global__ __cube__ void AscCopyGm2l1AscCopyGm2l1Arch2201Kernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __cbuf__ uint8_t l1_bytes[LOCAL_BUFFER_BYTES];
    asc_copy_gm2l1(reinterpret_cast<__cbuf__ void*>(l1_bytes), reinterpret_cast<__gm__ void*>(input), static_cast<uint32_t>(32));
    asc_sync_pipe(PIPE_ALL);
    asc_copy_gm2l1_pad1(reinterpret_cast<__cbuf__ void*>(l1_bytes), reinterpret_cast<__gm__ void*>(input), static_cast<uint32_t>(32));
