int main()
{
    std::vector<uint8_t> input(IO_BYTES, 1), output(IO_BYTES, 0), golden(IO_BYTES, 0);
    golden[0] = input[0];
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(IO_BYTES);
    CApiExample::DeviceBuffer<uint8_t> output_device(IO_BYTES);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input) || !output_device.CopyFrom(golden)) return 1;
    AscCopyGm2l1AscCopyGm2l1Arch2201Kernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_copy_gm2l1/asc_copy_gm2l1_pad1/asc_copy_gm2l1_pad2/asc_copy_gm2l1_pad3/asc_copy_gm2l1_pad4/asc_copy_gm2l1_pad5/asc_copy_gm2l1_pad6/asc_copy_gm2l1_pad7/asc_copy_gm2l1_pad8/asc_copy_gm2l1_sync/asc_copy_gm2l1_pad1_sync/asc_copy_gm2l1_pad2_sync/asc_copy_gm2l1_pad3_sync/asc_copy_gm2l1_pad4_sync/asc_copy_gm2l1_pad5_sync/asc_copy_gm2l1_pad6_sync/asc_copy_gm2l1_pad7_sync/asc_copy_gm2l1_pad8_sync passed." : "[Failed] asc_copy_gm2l1/asc_copy_gm2l1_pad1/asc_copy_gm2l1_pad2/asc_copy_gm2l1_pad3/asc_copy_gm2l1_pad4/asc_copy_gm2l1_pad5/asc_copy_gm2l1_pad6/asc_copy_gm2l1_pad7/asc_copy_gm2l1_pad8/asc_copy_gm2l1_sync/asc_copy_gm2l1_pad1_sync/asc_copy_gm2l1_pad2_sync/asc_copy_gm2l1_pad3_sync/asc_copy_gm2l1_pad4_sync/asc_copy_gm2l1_pad5_sync/asc_copy_gm2l1_pad6_sync/asc_copy_gm2l1_pad7_sync/asc_copy_gm2l1_pad8_sync failed.") << std::endl;
    return passed ? 0 : 1;
