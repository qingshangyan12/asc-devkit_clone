// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_set_gm2l1_loop_size.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/cube_datamove/asc_set_gm2l1_loop_size.asc -lm -o /tmp/c_api_cube_datamove_asc_set_gm2l1_loop_size && /tmp/c_api_cube_datamove_asc_set_gm2l1_loop_size
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
constexpr uint32_t INPUT_BYTES = 224;
constexpr uint32_t OUTPUT_BYTES = 128;

__global__ __mix__(1, 2) void AscSetGm2l1LoopSizeKernel(__gm__ uint8_t* output, __gm__ uint8_t* input, uint32_t mode)
{
    asc_init();
    __cbuf__ uint8_t l1[256];
    __ubuf__ uint8_t readback[256];
    constexpr uint64_t intra_id = 2;
    if ASC_IS_AIC {
        asc_set_gm2l1_loop_size(2, 2);
        asc_set_gm2l1_loop1_stride(64, 32);
        asc_set_gm2l1_loop2_stride(128, 64);
        asc_copy_gm2l1_align(l1, input, 1, 32, 0, 0, false, 0, 0, 0);
        asc_set_gm2l1_loop_size(1, 1);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12ub(readback, l1, false, 1, OUTPUT_BYTES / 32, 0, 0);
        asc_sync_intra_arrive(PIPE_MTE1, intra_id);
    }
    if ASC_IS_AIV {
        if (asc_get_sub_block_id() == 0) {
            asc_sync_intra_wait(PIPE_MTE3, intra_id);
            asc_copy_ub2gm_align(output + mode * OUTPUT_BYTES, readback, OUTPUT_BYTES);
            asc_sync_mte3(0);
        }
    }
}

void PrintData(const char* label, const std::vector<uint8_t>& data)
{
    std::cout << label << ':';
    for (uint32_t i = 0; i < 16 && i < data.size(); ++i) std::cout << ' ' << +data[i];
    std::cout << " ..." << std::endl;
}
} // namespace

int main()
{
    std::vector<uint8_t> input(INPUT_BYTES), output(OUTPUT_BYTES * 1), golden(output.size());
    for (uint32_t i = 0; i < INPUT_BYTES; ++i) input[i] = static_cast<uint8_t>(i + 1);
    for (uint32_t block = 0; block < 4; ++block) {
        for (uint32_t i = 0; i < 32; ++i) golden[block * 32 + i] = input[block * 64 + i];
    }
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t *input_device = nullptr, *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), INPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, INPUT_BYTES, input.data(), INPUT_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    for (uint32_t mode = 0; mode < 1; ++mode) {
        AscSetGm2l1LoopSizeKernel<<<1, 0>>>(output_device, input_device, mode);
        aclrtSynchronizeDevice();
    }
    aclrtMemcpy(output.data(), output.size(), output_device, output.size(), ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    PrintData("Golden", golden);
    const bool passed = output == golden;
    std::cout << (passed ? "[Success] asc_set_gm2l1_loop_size demonstrated its data layout."
                         : "[Failed] asc_set_gm2l1_loop_size result mismatch.") << std::endl;
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
