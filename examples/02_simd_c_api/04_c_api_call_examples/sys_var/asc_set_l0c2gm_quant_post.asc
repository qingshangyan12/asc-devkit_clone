// Build/run (examples/02_simd_c_api/04_c_api_call_examples/sys_var/asc_set_l0c2gm_quant_post.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/sys_var/asc_set_l0c2gm_quant_post.asc -lm -o /tmp/c_api_sys_var_asc_set_l0c2gm_quant_post && /tmp/c_api_sys_var_asc_set_l0c2gm_quant_post
// Architecture: dav-3510

#include <cstdint>
#include <iomanip>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
constexpr uint32_t ELEMENTS = 8;
// M3=1.0 in [31:13], signed int8 in bit 9, and offset=3 in [8:0].
constexpr uint64_t QUANT_POST_CONFIG =
    (static_cast<uint64_t>(127U << 10) << 13) | (1ULL << 9) | 3ULL;

__global__ __cube__ void AscSetL0c2gmQuantPostKernel(__gm__ uint64_t* output)
{
    asc_init();
    const uint64_t before = asc_get_system_cycle();
    for (uint32_t i = 0; i < 256; ++i) {
        asc_set_l0c2gm_quant_post(QUANT_POST_CONFIG ^ static_cast<uint64_t>(i & 1U));
    }
    asc_set_l0c2gm_quant_post(QUANT_POST_CONFIG);
    const uint64_t after = asc_get_system_cycle();
    output[0] = QUANT_POST_CONFIG;
    output[1] = after - before;
    asc_dcci_single(output);
}
} // namespace

int main()
{
    std::vector<uint64_t> output(ELEMENTS, 0);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint64_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output.size() * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    AscSetL0c2gmQuantPostKernel<<<1, 0>>>(output_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint64_t), output_device, output.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    std::cout << "QUANT_POST config: 0x" << std::hex << output[0] << std::dec << std::endl;
    std::cout << "256 alternating writes plus final write: " << output[1] << " cycles" << std::endl;
    // Current dav-3510 C API documents quant_post on L0C copy APIs as invalid,
    // so no public paired instruction can expose a numeric before/after result.
    const bool passed = output[0] == QUANT_POST_CONFIG && output[1] > 0;
    std::cout << (passed ? "[Success] asc_set_l0c2gm_quant_post passed."
                         : "[Failed] asc_set_l0c2gm_quant_post failed.") << std::endl;
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
