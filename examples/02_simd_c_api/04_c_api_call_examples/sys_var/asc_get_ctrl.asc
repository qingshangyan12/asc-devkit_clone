// Build/run (examples/02_simd_c_api/04_c_api_call_examples/sys_var/asc_get_ctrl.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/sys_var/asc_get_ctrl.asc -lm -o /tmp/c_api_sys_var_asc_get_ctrl && /tmp/c_api_sys_var_asc_get_ctrl
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t ELEMENTS = 8;

__global__ __vector__ void AscGetCtrlKernel(__gm__ uint32_t* output)
{
    asc_init();
    const uint64_t observed = static_cast<uint64_t>(asc_get_ctrl());
    output[0] = 1;
    output[1] = static_cast<uint32_t>(observed);
    output[2] = static_cast<uint32_t>(observed >> 32);
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint32_t> input(ELEMENTS, 0), output(ELEMENTS, 0xffffffffU);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (ELEMENTS) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(output_device, input.size() * sizeof(uint32_t), input.data(), input.size() * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscGetCtrlKernel<<<1, 0>>>(output_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint32_t), output_device, output.size() * sizeof(uint32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output (marker, observed low/high)", output);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
