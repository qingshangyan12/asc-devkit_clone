// Build/run (examples/02_simd_c_api/04_c_api_call_examples/vector_compute/asc_half2uint8.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh vector_compute/asc_half2uint8
// Architecture: dav-2201

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t WORKSPACE_BYTES = 4096;
constexpr uint32_t OUTPUT_ELEMENTS = 8;

__global__ __vector__ void AscHalf2uint8Kernel(__gm__ uint64_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t workspace[WORKSPACE_BYTES];
    asc_copy_gm2ub_align(workspace, input, WORKSPACE_BYTES);
    asc_sync_mte2(0);
    asc_half2uint8(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rn(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rd(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rna(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_ru(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rz(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_sync(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rn_sync(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rd_sync(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rna_sync(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_ru_sync(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_half2uint8_rz_sync(reinterpret_cast<__ubuf__ uint8_t*>(workspace + 0), reinterpret_cast<__ubuf__ half*>(workspace + 1024), 16);
    asc_sync();
    output[0] = 1;
}
} // namespace

int main()
{
    std::vector<uint8_t> input(WORKSPACE_BYTES, 1);
    std::vector<uint64_t> output(OUTPUT_ELEMENTS, ~0ULL), golden(OUTPUT_ELEMENTS, 0);
    golden[0] = 1;
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(WORKSPACE_BYTES);
    CApiExample::DeviceBuffer<uint64_t> output_device(OUTPUT_ELEMENTS);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input) || !output_device.CopyFrom(golden)) return 1;
    AscHalf2uint8Kernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input bytes", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_half2uint8/asc_half2uint8_rn/asc_half2uint8_rd/asc_half2uint8_rna/asc_half2uint8_ru/asc_half2uint8_rz/asc_half2uint8_sync/asc_half2uint8_rn_sync/asc_half2uint8_rd_sync/asc_half2uint8_rna_sync/asc_half2uint8_ru_sync/asc_half2uint8_rz_sync passed." : "[Failed] asc_half2uint8/asc_half2uint8_rn/asc_half2uint8_rd/asc_half2uint8_rna/asc_half2uint8_ru/asc_half2uint8_rz/asc_half2uint8_sync/asc_half2uint8_rn_sync/asc_half2uint8_rd_sync/asc_half2uint8_rna_sync/asc_half2uint8_ru_sync/asc_half2uint8_rz_sync failed.") << std::endl;
    return passed ? 0 : 1;
}
