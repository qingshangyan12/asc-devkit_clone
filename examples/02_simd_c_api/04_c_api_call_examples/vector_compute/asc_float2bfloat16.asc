// Build/run (examples/02_simd_c_api/04_c_api_call_examples/vector_compute/asc_float2bfloat16.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-2201 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/vector_compute/asc_float2bfloat16.asc -lm -o /tmp/c_api_vector_compute_asc_float2bfloat16 && /tmp/c_api_vector_compute_asc_float2bfloat16
// Architecture: dav-2201

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t WORKSPACE_BYTES = 4096;
constexpr uint32_t OUTPUT_ELEMENTS = 8;

__global__ __vector__ void AscFloat2bfloat16Kernel(__gm__ uint64_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t workspace[WORKSPACE_BYTES];
    asc_copy_gm2ub_align(workspace, input, WORKSPACE_BYTES);
    asc_sync_mte2(0);
    asc_float2bfloat16_rn(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rna(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rd(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_ru(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rz(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rn_sync(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rna_sync(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rd_sync(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_ru_sync(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_float2bfloat16_rz_sync(reinterpret_cast<__ubuf__ bfloat16_t*>(workspace + 0), reinterpret_cast<__ubuf__ float*>(workspace + 1024), 16);
    asc_sync();
    output[0] = 1;
}
} // namespace

int main()
{
    std::vector<uint8_t> input(WORKSPACE_BYTES, 1);
    std::vector<uint64_t> output(OUTPUT_ELEMENTS, ~0ULL);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (WORKSPACE_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint64_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (OUTPUT_ELEMENTS) * sizeof(uint64_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(uint64_t), output.data(), output.size() * sizeof(uint64_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscFloat2bfloat16Kernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint64_t), output_device, output.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input bytes", input);
    PrintData("Output", output);
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
