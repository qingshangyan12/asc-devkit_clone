// Build/run (examples/02_simd_c_api/04_c_api_call_examples/sync/asc_sync_intra_wait.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/sync/asc_sync_intra_wait.asc -lm -o /tmp/c_api_sync_asc_sync_intra_wait && /tmp/c_api_sync_asc_sync_intra_wait
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {

constexpr uint32_t ELEMENTS = 64;

__global__ __mix__(1, 2) void AscSyncIntraWaitKernel(__gm__ uint32_t* output, __gm__ uint32_t* input)
{
    asc_init();
    constexpr uint64_t sync_id = 1;
    if ASC_IS_AIV {
        if (asc_get_sub_block_id() == 0) {
            output[0] = input[0];
            asc_dcci_single(output);
            asc_sync_intra_arrive(PIPE_S, sync_id);
        }
    }
    if ASC_IS_AIC {
        asc_sync_intra_wait(PIPE_S, sync_id);
        asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
        asc_dci();
        output[1] = output[0];
        asc_dcci_single(output);
    }
}
} // namespace

int main()
{
    std::vector<uint32_t> input(ELEMENTS, 0), output(ELEMENTS, 0);
    input[0] = 0x12345678U;
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t *input_device = nullptr, *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), ELEMENTS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), ELEMENTS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, ELEMENTS * sizeof(uint32_t), input.data(), ELEMENTS * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscSyncIntraWaitKernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), ELEMENTS * sizeof(uint32_t), output_device, ELEMENTS * sizeof(uint32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    std::cout << "Input: 0x" << std::hex << input[0] << std::dec << std::endl;
    std::cout << "AIV write / AIC read: 0x" << std::hex << output[0] << " / 0x" << output[1]
              << std::dec << std::endl;
    const bool passed = output[0] == input[0] && output[1] == input[0];
    std::cout << (passed ? "[Success] asc_sync_intra_wait passed." : "[Failed] asc_sync_intra_wait failed.") << std::endl;
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
