// Build/run (examples/02_simd_c_api/04_c_api_call_examples/sync/asc_sync_inter_arrive.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/sync/asc_sync_inter_arrive.asc -lm -o /tmp/c_api_sync_asc_sync_inter_arrive && /tmp/c_api_sync_asc_sync_inter_arrive
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {

__global__ __vector__ void AscSyncInterArriveKernel(__gm__ uint32_t* output, __gm__ uint32_t* input)
{
    asc_init();
    const uint32_t core_id = static_cast<uint32_t>(asc_get_block_idx());
    const uint32_t peer_id = 1U - core_id;
    __ubuf__ uint32_t local[8];
    asc_copy_gm2ub_align(local, input + core_id * 8, 32);
    asc_sync_mte2(0);
    asc_copy_ub2gm_align(output + core_id * 8, local, 32);
    asc_sync_mte3(0);
    asc_sync_inter_arrive(PIPE_MTE3, static_cast<int64_t>(1));
    asc_sync_inter_wait(PIPE_MTE2, static_cast<int64_t>(1));
    asc_copy_gm2ub_align(local, output + peer_id * 8, 32);
    asc_sync_mte2(0);
    asc_copy_ub2gm_align(output + 16 + core_id * 8, local, 32);
    asc_sync_mte3(0);
}
} // namespace

int main()
{
    std::vector<uint32_t> input(16), output(32, 0), golden(32);
    for (uint32_t i = 0; i < 16; ++i) input[i] = i + 1;
    for (uint32_t i = 0; i < 16; ++i) {
        golden[i] = input[i];
        golden[16 + i] = input[(i + 8) % 16];
    }
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t *input_device = nullptr, *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), 64, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), 128, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, 64, input.data(), 64, ACL_MEMCPY_HOST_TO_DEVICE);
    AscSyncInterArriveKernel<<<2, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), 128, output_device, 128, ACL_MEMCPY_DEVICE_TO_HOST);
    std::cout << "Input groups: ";
    for (uint32_t i = 0; i < 16; ++i) std::cout << input[i] << (i == 7 ? " | " : " ");
    std::cout << std::endl << "Peer data after sync: ";
    for (uint32_t i = 16; i < 32; ++i) std::cout << output[i] << (i == 23 ? " | " : " ");
    std::cout << std::endl;
    const bool passed = output == golden;
    std::cout << (passed ? "[Success] asc_sync_inter_arrive passed." : "[Failed] asc_sync_inter_arrive failed.") << std::endl;
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
