// Build/run (examples/02_simd_c_api/04_c_api_call_examples/sync/asc_sync_intra_arrive.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/sync/asc_sync_intra_arrive.asc -lm -o /tmp/c_api_sync_asc_sync_intra_arrive && /tmp/c_api_sync_asc_sync_intra_arrive
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t ELEMENTS = 8;

__global__ __mix__(1, 2) void AscSyncIntraArriveKernel(__gm__ uint32_t* output)
{
    asc_init();
    constexpr uint64_t sync_id = 1;
    if ASC_IS_AIV {
        if (asc_get_sub_block_id() == 0) asc_sync_intra_arrive(PIPE_V, sync_id);
    }
    if ASC_IS_AIC {
        asc_sync_intra_wait(PIPE_FIX, sync_id);
        output[0] = 1;
    }
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint32_t> input(ELEMENTS, 0), output(ELEMENTS, 0xffffffffU);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (ELEMENTS) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(output_device, input.size() * sizeof(uint32_t), input.data(), input.size() * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscSyncIntraArriveKernel<<<1, 0>>>(output_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint32_t), output_device, output.size() * sizeof(uint32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
