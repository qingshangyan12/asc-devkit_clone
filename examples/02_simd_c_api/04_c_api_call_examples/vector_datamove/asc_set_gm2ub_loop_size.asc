// Build/run (examples/02_simd_c_api/04_c_api_call_examples/vector_datamove/asc_set_gm2ub_loop_size.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/vector_datamove/asc_set_gm2ub_loop_size.asc -lm -o /tmp/c_api_vector_datamove_asc_set_gm2ub_loop_size && /tmp/c_api_vector_datamove_asc_set_gm2ub_loop_size
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t BYTES = 256;

__global__ __vector__ void AscSetGm2ubLoopSizeKernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    asc_set_gm2ub_loop_size(1, 1);
    output[0] = 1;
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint8_t> input(BYTES), output(BYTES, 0xff);
    for (uint32_t i = 0; i < BYTES; ++i) input[i] = static_cast<uint8_t>(i);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(uint8_t), output.data(), output.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscSetGm2ubLoopSizeKernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint8_t), output_device, output.size() * sizeof(uint8_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
