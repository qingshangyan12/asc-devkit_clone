// Build/run (examples/02_simd_c_api/04_c_api_call_examples/vector_datamove/asc_set_gm2ub_pad_deprecated.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh vector_datamove/asc_set_gm2ub_pad_deprecated
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t BYTES = 256;

__global__ __vector__ void AscSetGm2ubPadDeprecatedKernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    asc_set_gm2ub_pad(0);
    output[0] = 1;
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint8_t> input(BYTES), output(BYTES, 0xff), golden(BYTES, 0);
    for (uint32_t i = 0; i < BYTES; ++i) input[i] = static_cast<uint8_t>(i);
    golden[0] = 1;
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(BYTES), output_device(BYTES);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input) || !output_device.CopyFrom(golden)) return 1;
    AscSetGm2ubPadDeprecatedKernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_set_gm2ub_pad passed." : "[Failed] asc_set_gm2ub_pad failed.") << std::endl;
    return passed ? 0 : 1;
}
