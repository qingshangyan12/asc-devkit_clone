// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cube_compute/asc_mmad.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh cube_compute/asc_mmad
// Architecture: dav-2201

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t LOCAL_BUFFER_BYTES = 4096;
constexpr uint32_t OUTPUT_ELEMENTS = 8;

__global__ __cube__ void AscMmadKernel(__gm__ uint64_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __cc__ uint8_t c_l0_bytes[LOCAL_BUFFER_BYTES];
    __ca__ uint8_t a_l0_bytes[LOCAL_BUFFER_BYTES];
    __cb__ uint8_t b_l0_bytes[LOCAL_BUFFER_BYTES];
    asc_mmad_s4(reinterpret_cast<__cc__ int32_t*>(c_l0_bytes), reinterpret_cast<__ca__ int4b_t*>(a_l0_bytes), reinterpret_cast<__cb__ int4b_t*>(b_l0_bytes), 16, 16, 16, 0, true, false, true);
    asc_mmad(reinterpret_cast<__cc__ int32_t*>(c_l0_bytes), reinterpret_cast<__ca__ int8_t*>(a_l0_bytes), reinterpret_cast<__cb__ int8_t*>(b_l0_bytes), 16, 16, 16, 0, true, false, true);
    asc_mmad_s4_sync(reinterpret_cast<__cc__ int32_t*>(c_l0_bytes), reinterpret_cast<__ca__ int4b_t*>(a_l0_bytes), reinterpret_cast<__cb__ int4b_t*>(b_l0_bytes), 16, 16, 16, 0, true, false, true);
    asc_mmad_sync(reinterpret_cast<__cc__ int32_t*>(c_l0_bytes), reinterpret_cast<__ca__ int8_t*>(a_l0_bytes), reinterpret_cast<__cb__ int8_t*>(b_l0_bytes), 16, 16, 16, 0, true, false, true);
    asc_sync_pipe(PIPE_ALL);
    output[0] = static_cast<uint64_t>(input[0]);
}
} // namespace

int main()
{
    std::vector<uint8_t> input(32, 1);
    std::vector<uint64_t> output(OUTPUT_ELEMENTS, ~0ULL), golden(OUTPUT_ELEMENTS, 0);
    golden[0] = input[0];
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(input.size());
    CApiExample::DeviceBuffer<uint64_t> output_device(OUTPUT_ELEMENTS);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input) || !output_device.CopyFrom(golden)) return 1;
    AscMmadKernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_mmad_s4/asc_mmad/asc_mmad_s4_sync/asc_mmad_sync passed." : "[Failed] asc_mmad_s4/asc_mmad/asc_mmad_s4_sync/asc_mmad_sync failed.") << std::endl;
    return passed ? 0 : 1;
}
