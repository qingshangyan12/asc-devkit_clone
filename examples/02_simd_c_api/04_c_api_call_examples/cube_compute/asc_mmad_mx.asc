// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cube_compute/asc_mmad_mx.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/cube_compute/asc_mmad_mx.asc -lm -o /tmp/c_api_cube_compute_asc_mmad_mx && /tmp/c_api_cube_compute_asc_mmad_mx
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t LOCAL_BUFFER_BYTES = 4096;
constexpr uint32_t OUTPUT_ELEMENTS = 8;

__global__ __cube__ void AscMmadMxKernel(__gm__ uint64_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __cc__ uint8_t c_l0_bytes[LOCAL_BUFFER_BYTES];
    __ca__ uint8_t a_l0_bytes[LOCAL_BUFFER_BYTES];
    __cb__ uint8_t b_l0_bytes[LOCAL_BUFFER_BYTES];
    asc_mmad_mx(reinterpret_cast<__cc__ float*>(c_l0_bytes), reinterpret_cast<__ca__ fp4x2_e1m2_t*>(a_l0_bytes), reinterpret_cast<__cb__ fp4x2_e1m2_t*>(b_l0_bytes), 16, 16, 16, 0, true, false, true);
    asc_mmad_mx_sync(reinterpret_cast<__cc__ float*>(c_l0_bytes), reinterpret_cast<__ca__ fp4x2_e1m2_t*>(a_l0_bytes), reinterpret_cast<__cb__ fp4x2_e1m2_t*>(b_l0_bytes), 16, 16, 16, 0, true, false, true);
    asc_sync_pipe(PIPE_ALL);
    output[0] = static_cast<uint64_t>(input[0]);
}
} // namespace

int main()
{
    std::vector<uint8_t> input(32, 1);
    std::vector<uint64_t> output(OUTPUT_ELEMENTS, ~0ULL);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (input.size()) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint64_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (OUTPUT_ELEMENTS) * sizeof(uint64_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(output_device, output.size() * sizeof(uint64_t), output.data(), output.size() * sizeof(uint64_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscMmadMxKernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint64_t), output_device, output.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
