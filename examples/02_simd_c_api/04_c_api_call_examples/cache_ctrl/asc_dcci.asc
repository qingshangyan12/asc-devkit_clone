// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cache_ctrl/asc_dcci.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/cache_ctrl/asc_dcci.asc -lm -o /tmp/c_api_cache_ctrl_asc_dcci && /tmp/c_api_cache_ctrl_asc_dcci
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t ELEMENTS = 16;

__global__ __vector__ void AscDcciKernel(__gm__ uint64_t* output, uint32_t mode)
{
    asc_init();
    if (mode == 0) {
        output[mode] = 1;
    } else if (mode == 1) {
        asc_dcci_entire_out();
        output[mode] = 1;
    } else if (mode == 2) {
        asc_dcci_entire_all();
        output[mode] = 1;
    } else {
        asc_dcci_entire_atomic();
        output[mode] = 1;
    }
    asc_dcci_single(output + mode);
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint64_t> input(ELEMENTS, 0), output(ELEMENTS, ~0ULL);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint64_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (ELEMENTS) * sizeof(uint64_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(output_device, input.size() * sizeof(uint64_t), input.data(), input.size() * sizeof(uint64_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    for (uint32_t mode = 0; mode < 4; ++mode) {
        AscDcciKernel<<<1, 0>>>(output_device, mode);
        aclrtSynchronizeDevice();
    }
    aclrtMemcpy(output.data(), output.size() * sizeof(uint64_t), output_device, output.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output", output);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
