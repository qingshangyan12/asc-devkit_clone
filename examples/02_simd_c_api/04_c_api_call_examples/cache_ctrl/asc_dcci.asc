// Build/run (examples/02_simd_c_api/04_c_api_call_examples/cache_ctrl/asc_dcci.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh cache_ctrl/asc_dcci
// Architecture: dav-2201

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t ELEMENTS = 16;

__global__ __vector__ void AscDcciKernel(__gm__ uint64_t* output)
{
    asc_init();
    __ubuf__ uint8_t scratch[256];
    asc_dcci_single(output);
    asc_ub_dcci_single(scratch);
    asc_dcci_entire_ub();
    asc_dcci_entire_out();
    asc_dcci_entire_all();
    asc_dcci_entire_atomic();
    output[0] = 1;
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint64_t> input(ELEMENTS, 0), output(ELEMENTS, ~0ULL), golden(ELEMENTS, 0);
    golden[0] = 1;
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint64_t> output_device(ELEMENTS);
    if (!output_device.Allocate("aclrtMalloc(output)") || !output_device.CopyFrom(input)) return 1;
    AscDcciKernel<<<1, 0>>>(output_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_dcci_single/asc_ub_dcci_single/asc_dcci_entire_ub/asc_dcci_entire_out/asc_dcci_entire_all/asc_dcci_entire_atomic passed." : "[Failed] asc_dcci_single/asc_ub_dcci_single/asc_dcci_entire_ub/asc_dcci_entire_out/asc_dcci_entire_all/asc_dcci_entire_atomic failed.") << std::endl;
    return passed ? 0 : 1;
}
