// Build/run (examples/02_simd_c_api/04_c_api_call_examples/simd_atomic/asc_set_store_atomic_config_v2_deprecated.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh simd_atomic/asc_set_store_atomic_config_v2_deprecated
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t ELEMENTS = 8;

__global__ __vector__ void AscSetStoreAtomicConfigV2DeprecatedKernel(__gm__ uint64_t* output)
{
    asc_init();
    asc_set_store_atomic_config_v2(1, 2);
    asc_store_atomic_config config;
    asc_get_store_atomic_config(config);
    output[1] = config.config;
    asc_set_atomic_none();
    output[0] = 1;
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint64_t> input(ELEMENTS, 0), output(ELEMENTS, ~0ULL), golden(ELEMENTS, 0);
    golden[0] = 1;
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint64_t> output_device(ELEMENTS);
    if (!output_device.Allocate("aclrtMalloc(output)") || !output_device.CopyFrom(input)) return 1;
    AscSetStoreAtomicConfigV2DeprecatedKernel<<<1, 0>>>(output_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", input);
    CApiExample::Print("Output (marker, raw config)", output);
    CApiExample::Print("Golden marker", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, 1);
    std::cout << (passed ? "[Success] asc_set_store_atomic_config_v2 passed." : "[Failed] asc_set_store_atomic_config_v2 failed.") << std::endl;
    return passed ? 0 : 1;
}
