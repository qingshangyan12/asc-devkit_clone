// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/sync_control/asc_mem_bar.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/reg/sync_control/asc_mem_bar.asc -lm -o /tmp/c_api_reg_sync_control_asc_mem_bar && /tmp/c_api_reg_sync_control_asc_mem_bar
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}

template <typename T>
bool CompareData(const std::vector<T>& actual, const std::vector<T>& expected, double tolerance = 0.0)
{
    if (actual.size() != expected.size()) return false;
    for (size_t i = 0; i < actual.size(); ++i) {
        if (actual[i] == expected[i]) continue;
        const double diff = static_cast<double>(actual[i]) - static_cast<double>(expected[i]);
        if (diff > tolerance || diff < -tolerance) return false;
    }
    return true;
}




constexpr uint32_t ELEMENT_COUNT = 64;

__simd_vf__ inline void StoreThenLoad(
    __ubuf__ uint32_t* output, __ubuf__ uint32_t* scratch, __ubuf__ uint32_t* input)
{
    vector_uint32_t input_reg;
    vector_uint32_t stored_reg;
    vector_uint32_t loaded_reg;
    uint32_t count = ELEMENT_COUNT;
    vector_bool mask = asc_update_mask_b32(count);
    asc_loadalign(input_reg, input);
    asc_add(stored_reg, input_reg, input_reg, mask);
    asc_storealign(scratch, stored_reg, mask);
    asc_mem_bar(VST_VLD);
    asc_loadalign(loaded_reg, scratch);
    asc_storealign(output, loaded_reg, mask);
}

__global__ __vector__ void AscMemBarKernel(__gm__ uint32_t* output, __gm__ uint32_t* input)
{
    asc_init();
    __ubuf__ uint32_t input_local[ELEMENT_COUNT];
    __ubuf__ uint32_t scratch[ELEMENT_COUNT];
    __ubuf__ uint32_t output_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(input_local, input, ELEMENT_COUNT * sizeof(uint32_t));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    StoreThenLoad(output_local, scratch, input_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, ELEMENT_COUNT * sizeof(uint32_t));
    asc_sync();
}
} // namespace

int main()
{
    std::vector<uint32_t> input(ELEMENT_COUNT), output(ELEMENT_COUNT, 0), golden(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        input[i] = i + 1;
        golden[i] = input[i] * 2;
    }
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (ELEMENT_COUNT) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint32_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (ELEMENT_COUNT) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint32_t), input.data(), input.size() * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscMemBarKernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint32_t), output_device, output.size() * sizeof(uint32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input", input);
    PrintData("Output after store/barrier/load", output);
    PrintData("Golden", golden);
    const bool passed = CompareData(output, golden);
    std::cout << (passed ? "[Success] asc_mem_bar VST_VLD dependency passed."
                         : "[Failed] asc_mem_bar VST_VLD dependency failed.") << std::endl;
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
