// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/data_type_convert/asc_half2int16.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh reg/data_type_convert/asc_half2int16
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"
namespace {
constexpr uint32_t BUFFER_BYTES = 256;
__simd_vf__ inline void Convert(__ubuf__ uint8_t* output, __ubuf__ uint8_t* input)
{
    vector_bool mask = asc_create_mask_b8(PAT_ALL);
    vector_int16_t dst_0;
    vector_half src_0;
    asc_loadalign(dst_0, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_0, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rn(dst_0, src_0, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_0, mask);
    vector_int16_t dst_1;
    vector_half src_1;
    asc_loadalign(dst_1, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_1, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rn_sat(dst_1, src_1, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_1, mask);
    vector_int16_t dst_2;
    vector_half src_2;
    asc_loadalign(dst_2, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_2, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rna(dst_2, src_2, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_2, mask);
    vector_int16_t dst_3;
    vector_half src_3;
    asc_loadalign(dst_3, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_3, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rna_sat(dst_3, src_3, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_3, mask);
    vector_int16_t dst_4;
    vector_half src_4;
    asc_loadalign(dst_4, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_4, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rd(dst_4, src_4, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_4, mask);
    vector_int16_t dst_5;
    vector_half src_5;
    asc_loadalign(dst_5, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_5, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rd_sat(dst_5, src_5, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_5, mask);
    vector_int16_t dst_6;
    vector_half src_6;
    asc_loadalign(dst_6, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_6, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_ru(dst_6, src_6, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_6, mask);
    vector_int16_t dst_7;
    vector_half src_7;
    asc_loadalign(dst_7, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_7, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_ru_sat(dst_7, src_7, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_7, mask);
    vector_int16_t dst_8;
    vector_half src_8;
    asc_loadalign(dst_8, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_8, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rz(dst_8, src_8, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_8, mask);
    vector_int16_t dst_9;
    vector_half src_9;
    asc_loadalign(dst_9, reinterpret_cast<__ubuf__ int16_t*>(output));
    asc_loadalign(src_9, reinterpret_cast<__ubuf__ half*>(input));
    asc_half2int16_rz_sat(dst_9, src_9, mask);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), dst_9, mask);
}
__global__ __vector__ void AscHalf2int16Kernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t output_local[BUFFER_BYTES];
    __ubuf__ uint8_t input_local[BUFFER_BYTES];
    asc_copy_gm2ub_align(input_local, input, BUFFER_BYTES);
    asc_copy_gm2ub_align(output_local, input, BUFFER_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Convert(output_local, input_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, BUFFER_BYTES);
    asc_sync();
}
} // namespace
int main()
{
    std::vector<uint8_t> input(BUFFER_BYTES, 0);
    std::vector<uint8_t> output(BUFFER_BYTES, 0xff);
    std::vector<uint8_t> golden(BUFFER_BYTES, 0);
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(BUFFER_BYTES), output_device(BUFFER_BYTES);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input)) return 1;
    AscHalf2int16Kernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") || !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input bytes", input);
    CApiExample::Print("Output bytes", output);
    CApiExample::Print("Golden bytes", golden);
    const bool passed = CApiExample::Compare(output, golden);
    std::cout << (passed ? "[Success] asc_half2int16_rn/asc_half2int16_rn_sat/asc_half2int16_rna/asc_half2int16_rna_sat/asc_half2int16_rd/asc_half2int16_rd_sat/asc_half2int16_ru/asc_half2int16_ru_sat/asc_half2int16_rz/asc_half2int16_rz_sat passed." : "[Failed] asc_half2int16_rn/asc_half2int16_rn_sat/asc_half2int16_rna/asc_half2int16_rna_sat/asc_half2int16_rd/asc_half2int16_rd_sat/asc_half2int16_ru/asc_half2int16_ru_sat/asc_half2int16_rz/asc_half2int16_rz_sat failed.") << std::endl;
    return passed ? 0 : 1;
}
