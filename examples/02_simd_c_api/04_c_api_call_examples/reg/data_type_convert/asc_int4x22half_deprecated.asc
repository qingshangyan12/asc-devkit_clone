// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/data_type_convert/asc_int4x22half_deprecated.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh reg/data_type_convert/asc_int4x22half_deprecated
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "common/sample_host.h"
namespace {
constexpr uint32_t BUFFER_BYTES = 256;
__simd_vf__ inline void Convert(__ubuf__ uint8_t* output, __ubuf__ uint8_t* input)
{
    vector_bool mask = asc_create_mask_b8(PAT_ALL);
    vector_half dst_0;
    vector_int4x2_t src_0;
    asc_loadalign(dst_0, reinterpret_cast<__ubuf__ half*>(output));
    asc_loadalign(src_0, reinterpret_cast<__ubuf__ int4b_t*>(input));
    asc_int4x22half(dst_0, src_0, mask);
    asc_storealign(reinterpret_cast<__ubuf__ half*>(output), dst_0, mask);
    vector_half dst_1;
    vector_int4x2_t src_1;
    asc_loadalign(dst_1, reinterpret_cast<__ubuf__ half*>(output));
    asc_loadalign(src_1, reinterpret_cast<__ubuf__ int4b_t*>(input));
    asc_int4x22half_v2(dst_1, src_1, mask);
    asc_storealign(reinterpret_cast<__ubuf__ half*>(output), dst_1, mask);
    vector_half dst_2;
    vector_int4x2_t src_2;
    asc_loadalign(dst_2, reinterpret_cast<__ubuf__ half*>(output));
    asc_loadalign(src_2, reinterpret_cast<__ubuf__ int4b_t*>(input));
    asc_int4x22half_v3(dst_2, src_2, mask);
    asc_storealign(reinterpret_cast<__ubuf__ half*>(output), dst_2, mask);
    vector_half dst_3;
    vector_int4x2_t src_3;
    asc_loadalign(dst_3, reinterpret_cast<__ubuf__ half*>(output));
    asc_loadalign(src_3, reinterpret_cast<__ubuf__ int4b_t*>(input));
    asc_int4x22half_v4(dst_3, src_3, mask);
    asc_storealign(reinterpret_cast<__ubuf__ half*>(output), dst_3, mask);
}
__global__ __vector__ void AscInt4x22halfDeprecatedKernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t output_local[BUFFER_BYTES];
    __ubuf__ uint8_t input_local[BUFFER_BYTES];
    asc_copy_gm2ub_align(input_local, input, BUFFER_BYTES);
    asc_copy_gm2ub_align(output_local, input, BUFFER_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Convert(output_local, input_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, BUFFER_BYTES);
    asc_sync();
}
} // namespace
int main()
{
    std::vector<uint8_t> input(BUFFER_BYTES, 0);
    std::vector<uint8_t> output(BUFFER_BYTES, 0xff);
    std::vector<uint8_t> golden(BUFFER_BYTES, 0);
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(BUFFER_BYTES), output_device(BUFFER_BYTES);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input)) return 1;
    AscInt4x22halfDeprecatedKernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") || !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input bytes", input);
    CApiExample::Print("Output bytes", output);
    CApiExample::Print("Golden bytes", golden);
    const bool passed = CApiExample::Compare(output, golden);
    std::cout << (passed ? "[Success] asc_int4x22half/asc_int4x22half_v2/asc_int4x22half_v3/asc_int4x22half_v4 passed." : "[Failed] asc_int4x22half/asc_int4x22half_v2/asc_int4x22half_v3/asc_int4x22half_v4 failed.") << std::endl;
    return passed ? 0 : 1;
}
