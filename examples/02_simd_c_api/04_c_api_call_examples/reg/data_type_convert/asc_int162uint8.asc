// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/data_type_convert/asc_int162uint8.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/reg/data_type_convert/asc_int162uint8.asc -lm -o /tmp/c_api_reg_data_type_convert_asc_int162uint8 && /tmp/c_api_reg_data_type_convert_asc_int162uint8
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"
namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t BUFFER_BYTES = 256;
__simd_vf__ inline void Convert(__ubuf__ uint8_t* output, __ubuf__ uint8_t* input)
{
    vector_bool mask = asc_create_mask_b8(PAT_ALL);
    vector_uint8_t dst_0;
    vector_int16_t src_0;
    asc_loadalign(dst_0, reinterpret_cast<__ubuf__ uint8_t*>(output));
    asc_loadalign(src_0, reinterpret_cast<__ubuf__ int16_t*>(input));
    asc_int162uint8(dst_0, src_0, mask);
    asc_storealign(reinterpret_cast<__ubuf__ uint8_t*>(output), dst_0, mask);
    vector_uint8_t dst_1;
    vector_int16_t src_1;
    asc_loadalign(dst_1, reinterpret_cast<__ubuf__ uint8_t*>(output));
    asc_loadalign(src_1, reinterpret_cast<__ubuf__ int16_t*>(input));
    asc_int162uint8_v2(dst_1, src_1, mask);
    asc_storealign(reinterpret_cast<__ubuf__ uint8_t*>(output), dst_1, mask);
    vector_uint8_t dst_2;
    vector_int16_t src_2;
    asc_loadalign(dst_2, reinterpret_cast<__ubuf__ uint8_t*>(output));
    asc_loadalign(src_2, reinterpret_cast<__ubuf__ int16_t*>(input));
    asc_int162uint8_sat(dst_2, src_2, mask);
    asc_storealign(reinterpret_cast<__ubuf__ uint8_t*>(output), dst_2, mask);
    vector_uint8_t dst_3;
    vector_int16_t src_3;
    asc_loadalign(dst_3, reinterpret_cast<__ubuf__ uint8_t*>(output));
    asc_loadalign(src_3, reinterpret_cast<__ubuf__ int16_t*>(input));
    asc_int162uint8_sat_v2(dst_3, src_3, mask);
    asc_storealign(reinterpret_cast<__ubuf__ uint8_t*>(output), dst_3, mask);
}
__global__ __vector__ void AscInt162uint8Kernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t output_local[BUFFER_BYTES];
    __ubuf__ uint8_t input_local[BUFFER_BYTES];
    asc_copy_gm2ub_align(input_local, input, BUFFER_BYTES);
    asc_copy_gm2ub_align(output_local, input, BUFFER_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Convert(output_local, input_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, BUFFER_BYTES);
    asc_sync();
}
} // namespace
int main()
{
    std::vector<uint8_t> input(BUFFER_BYTES, 0);
    std::vector<uint8_t> output(BUFFER_BYTES, 0xff);

    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (BUFFER_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (BUFFER_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscInt162uint8Kernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint8_t), output_device, output.size() * sizeof(uint8_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input bytes", input);
    PrintData("Output bytes", output);
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
