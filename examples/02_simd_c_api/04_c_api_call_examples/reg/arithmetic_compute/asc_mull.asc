// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/arithmetic_compute/asc_mull.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh reg/arithmetic_compute/asc_mull
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <limits>
#include <vector>

#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {

constexpr uint32_t ELEMENT_COUNT = 64;

__simd_vf__ inline void MultiplyLong(__ubuf__ uint32_t* low, __ubuf__ uint32_t* high,
    __ubuf__ uint32_t* src0, __ubuf__ uint32_t* src1)
{
    vector_uint32_t low_reg;
    vector_uint32_t high_reg;
    vector_uint32_t src0_reg;
    vector_uint32_t src1_reg;
    uint32_t count = ELEMENT_COUNT;
    vector_bool mask = asc_update_mask_b32(count);
    asc_loadalign(src0_reg, src0);
    asc_loadalign(src1_reg, src1);
    asc_mull(low_reg, high_reg, src0_reg, src1_reg, mask);
    asc_storealign(low, low_reg, mask);
    asc_storealign(high, high_reg, mask);
}

__global__ __vector__ void AscMullKernel(__gm__ uint32_t* low, __gm__ uint32_t* high,
    __gm__ uint32_t* src0, __gm__ uint32_t* src1)
{
    asc_init();
    __ubuf__ uint32_t low_local[ELEMENT_COUNT];
    __ubuf__ uint32_t high_local[ELEMENT_COUNT];
    __ubuf__ uint32_t src0_local[ELEMENT_COUNT];
    __ubuf__ uint32_t src1_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(src0_local, src0, ELEMENT_COUNT * sizeof(uint32_t));
    asc_copy_gm2ub_align(src1_local, src1, ELEMENT_COUNT * sizeof(uint32_t));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    MultiplyLong(low_local, high_local, src0_local, src1_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(low, low_local, ELEMENT_COUNT * sizeof(uint32_t));
    asc_copy_ub2gm_align(high, high_local, ELEMENT_COUNT * sizeof(uint32_t));
    asc_sync();
}

} // namespace

int main()
{
    std::vector<uint32_t> src0(ELEMENT_COUNT);
    std::vector<uint32_t> src1(ELEMENT_COUNT);
    std::vector<uint32_t> low(ELEMENT_COUNT, 0);
    std::vector<uint32_t> high(ELEMENT_COUNT, 0);
    std::vector<uint32_t> golden_low(ELEMENT_COUNT);
    std::vector<uint32_t> golden_high(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        src0[i] = std::numeric_limits<uint32_t>::max() - i;
        src1[i] = i + 2;
        const uint64_t product = static_cast<uint64_t>(src0[i]) * src1[i];
        golden_low[i] = static_cast<uint32_t>(product);
        golden_high[i] = static_cast<uint32_t>(product >> 32);
    }

    CApiExample::Runtime runtime;
    if (!runtime.Init()) {
        return 1;
    }
    CApiExample::DeviceBuffer<uint32_t> src0_device(ELEMENT_COUNT);
    CApiExample::DeviceBuffer<uint32_t> src1_device(ELEMENT_COUNT);
    CApiExample::DeviceBuffer<uint32_t> low_device(ELEMENT_COUNT);
    CApiExample::DeviceBuffer<uint32_t> high_device(ELEMENT_COUNT);
    if (!src0_device.Allocate("aclrtMalloc(src0)") || !src1_device.Allocate("aclrtMalloc(src1)") ||
        !low_device.Allocate("aclrtMalloc(low)") || !high_device.Allocate("aclrtMalloc(high)") ||
        !src0_device.CopyFrom(src0) || !src1_device.CopyFrom(src1)) {
        return 1;
    }

    AscMullKernel<<<1, 0>>>(low_device.Get(), high_device.Get(), src0_device.Get(), src1_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !low_device.CopyTo(low) || !high_device.CopyTo(high)) {
        return 1;
    }

    CApiExample::Print("Input 0", src0);
    CApiExample::Print("Input 1", src1);
    CApiExample::Print("Output low", low);
    CApiExample::Print("Golden low", golden_low);
    CApiExample::Print("Output high", high);
    CApiExample::Print("Golden high", golden_high);
    const bool passed = CApiExample::Compare(low, golden_low) && CApiExample::Compare(high, golden_high);
    std::cout << (passed ? "[Success] asc_mull passed." : "[Failed] asc_mull failed.") << std::endl;
    return passed ? 0 : 1;
}
