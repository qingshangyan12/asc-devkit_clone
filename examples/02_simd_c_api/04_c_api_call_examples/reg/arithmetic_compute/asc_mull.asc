// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/arithmetic_compute/asc_mull.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/reg/arithmetic_compute/asc_mull.asc -lm -o /tmp/c_api_reg_arithmetic_compute_asc_mull && /tmp/c_api_reg_arithmetic_compute_asc_mull
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <limits>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}




constexpr uint32_t ELEMENT_COUNT = 64;

__simd_vf__ inline void MultiplyLong(__ubuf__ uint32_t* low, __ubuf__ uint32_t* high,
    __ubuf__ uint32_t* src0, __ubuf__ uint32_t* src1)
{
    vector_uint32_t low_reg;
    vector_uint32_t high_reg;
    vector_uint32_t src0_reg;
    vector_uint32_t src1_reg;
    uint32_t count = ELEMENT_COUNT;
    vector_bool mask = asc_update_mask_b32(count);
    asc_loadalign(src0_reg, src0);
    asc_loadalign(src1_reg, src1);
    asc_mull(low_reg, high_reg, src0_reg, src1_reg, mask);
    asc_storealign(low, low_reg, mask);
    asc_storealign(high, high_reg, mask);
}

__global__ __vector__ void AscMullKernel(__gm__ uint32_t* low, __gm__ uint32_t* high,
    __gm__ uint32_t* src0, __gm__ uint32_t* src1)
{
    asc_init();
    __ubuf__ uint32_t low_local[ELEMENT_COUNT];
    __ubuf__ uint32_t high_local[ELEMENT_COUNT];
    __ubuf__ uint32_t src0_local[ELEMENT_COUNT];
    __ubuf__ uint32_t src1_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(src0_local, src0, ELEMENT_COUNT * sizeof(uint32_t));
    asc_copy_gm2ub_align(src1_local, src1, ELEMENT_COUNT * sizeof(uint32_t));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    MultiplyLong(low_local, high_local, src0_local, src1_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(low, low_local, ELEMENT_COUNT * sizeof(uint32_t));
    asc_copy_ub2gm_align(high, high_local, ELEMENT_COUNT * sizeof(uint32_t));
    asc_sync();
}

} // namespace

int main()
{
    std::vector<uint32_t> src0(ELEMENT_COUNT);
    std::vector<uint32_t> src1(ELEMENT_COUNT);
    std::vector<uint32_t> low(ELEMENT_COUNT, 0);
    std::vector<uint32_t> high(ELEMENT_COUNT, 0);


    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        src0[i] = std::numeric_limits<uint32_t>::max() - i;
        src1[i] = i + 2;
        const uint64_t product = static_cast<uint64_t>(src0[i]) * src1[i];
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    uint32_t* src0_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), (ELEMENT_COUNT) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint32_t* src1_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), (ELEMENT_COUNT) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint32_t* low_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&low_device), (ELEMENT_COUNT) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint32_t* high_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&high_device), (ELEMENT_COUNT) * sizeof(uint32_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(src0_device, src0.size() * sizeof(uint32_t), src0.data(), src0.size() * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, src1.size() * sizeof(uint32_t), src1.data(), src1.size() * sizeof(uint32_t),
        ACL_MEMCPY_HOST_TO_DEVICE);

    AscMullKernel<<<1, 0>>>(low_device, high_device, src0_device, src1_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(low.data(), low.size() * sizeof(uint32_t), low_device, low.size() * sizeof(uint32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(high.data(), high.size() * sizeof(uint32_t), high_device, high.size() * sizeof(uint32_t),
        ACL_MEMCPY_DEVICE_TO_HOST);

    PrintData("Input 0", src0);
    PrintData("Input 1", src1);
    PrintData("Output low", low);
    PrintData("Output high", high);
    aclrtFree(high_device);
    aclrtFree(low_device);
    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
