// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/arithmetic_compute/asc_muls_deprecated.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/reg/arithmetic_compute/asc_muls_deprecated.asc -lm -o /tmp/c_api_reg_arithmetic_compute_asc_muls_deprecated && /tmp/c_api_reg_arithmetic_compute_asc_muls_deprecated
// Architecture: dav-3510

#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}

void PrintHalfData(const char* label, const std::vector<aclFloat16>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << aclFloat16ToFloat(values[i]);
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t INPUT_COUNT = 64;
constexpr uint32_t OUTPUT_COUNT = 128;
constexpr float SCALAR_VALUE = 2.0f;

__simd_vf__ inline void MultiplyToHalf(__ubuf__ half* even, __ubuf__ half* odd, __ubuf__ float* src)
{
    vector_half even_reg;
    vector_half odd_reg;
    vector_float src_reg;
    uint32_t count = OUTPUT_COUNT;
    vector_bool mask = asc_update_mask_b16(count);
    asc_loadalign(src_reg, src);
    asc_muls(even_reg, src_reg, SCALAR_VALUE, mask);
    asc_muls_v2(odd_reg, src_reg, SCALAR_VALUE, mask);
    asc_storealign(even, even_reg, mask);
    asc_storealign(odd, odd_reg, mask);
}

__global__ __vector__ void AscMulsDeprecatedKernel(__gm__ half* even, __gm__ half* odd, __gm__ float* src)
{
    asc_init();
    __ubuf__ half even_local[OUTPUT_COUNT];
    __ubuf__ half odd_local[OUTPUT_COUNT];
    __ubuf__ float src_local[INPUT_COUNT];
    asc_copy_gm2ub_align(src_local, src, INPUT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    MultiplyToHalf(even_local, odd_local, src_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(even, even_local, OUTPUT_COUNT * sizeof(half));
    asc_copy_ub2gm_align(odd, odd_local, OUTPUT_COUNT * sizeof(half));
    asc_sync();
}

} // namespace

int main()
{
    std::vector<float> src(INPUT_COUNT);
    std::vector<aclFloat16> even(OUTPUT_COUNT, aclFloatToFloat16(0.0f));
    std::vector<aclFloat16> odd(OUTPUT_COUNT, aclFloatToFloat16(0.0f));


    for (uint32_t i = 0; i < INPUT_COUNT; ++i) {
        src[i] = (static_cast<int>(i) - 16) * 0.25f;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    float* src_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&src_device), (INPUT_COUNT) * sizeof(float),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclFloat16* even_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&even_device), (OUTPUT_COUNT) * sizeof(aclFloat16),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclFloat16* odd_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&odd_device), (OUTPUT_COUNT) * sizeof(aclFloat16),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(src_device, src.size() * sizeof(float), src.data(), src.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);

    AscMulsDeprecatedKernel<<<1, 0>>>(
        reinterpret_cast<half*>(even_device), reinterpret_cast<half*>(odd_device), src_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(even.data(), even.size() * sizeof(aclFloat16), even_device, even.size() * sizeof(aclFloat16),
        ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(odd.data(), odd.size() * sizeof(aclFloat16), odd_device, odd.size() * sizeof(aclFloat16),
        ACL_MEMCPY_DEVICE_TO_HOST);

    PrintData("Input", src);
    PrintHalfData("asc_muls output", even);
    PrintHalfData("asc_muls_v2 output", odd);
    aclrtFree(even_device);
    aclrtFree(odd_device);
    aclrtFree(src_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
