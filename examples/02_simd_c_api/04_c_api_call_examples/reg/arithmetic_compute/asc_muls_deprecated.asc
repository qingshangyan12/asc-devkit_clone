// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/arithmetic_compute/asc_muls_deprecated.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh reg/arithmetic_compute/asc_muls_deprecated
// Architecture: dav-3510

#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {

constexpr uint32_t INPUT_COUNT = 64;
constexpr uint32_t OUTPUT_COUNT = 128;
constexpr float SCALAR_VALUE = 2.0f;

__simd_vf__ inline void MultiplyToHalf(__ubuf__ half* even, __ubuf__ half* odd, __ubuf__ float* src)
{
    vector_half even_reg;
    vector_half odd_reg;
    vector_float src_reg;
    uint32_t count = OUTPUT_COUNT;
    vector_bool mask = asc_update_mask_b16(count);
    asc_loadalign(src_reg, src);
    asc_muls(even_reg, src_reg, SCALAR_VALUE, mask);
    asc_muls_v2(odd_reg, src_reg, SCALAR_VALUE, mask);
    asc_storealign(even, even_reg, mask);
    asc_storealign(odd, odd_reg, mask);
}

__global__ __vector__ void AscMulsDeprecatedKernel(__gm__ half* even, __gm__ half* odd, __gm__ float* src)
{
    asc_init();
    __ubuf__ half even_local[OUTPUT_COUNT];
    __ubuf__ half odd_local[OUTPUT_COUNT];
    __ubuf__ float src_local[INPUT_COUNT];
    asc_copy_gm2ub_align(src_local, src, INPUT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    MultiplyToHalf(even_local, odd_local, src_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(even, even_local, OUTPUT_COUNT * sizeof(half));
    asc_copy_ub2gm_align(odd, odd_local, OUTPUT_COUNT * sizeof(half));
    asc_sync();
}

} // namespace

int main()
{
    std::vector<float> src(INPUT_COUNT);
    std::vector<aclFloat16> even(OUTPUT_COUNT, aclFloatToFloat16(0.0f));
    std::vector<aclFloat16> odd(OUTPUT_COUNT, aclFloatToFloat16(0.0f));
    std::vector<aclFloat16> golden_even(OUTPUT_COUNT, aclFloatToFloat16(0.0f));
    std::vector<aclFloat16> golden_odd(OUTPUT_COUNT, aclFloatToFloat16(0.0f));
    for (uint32_t i = 0; i < INPUT_COUNT; ++i) {
        src[i] = (static_cast<int>(i) - 16) * 0.25f;
        const aclFloat16 expected = aclFloatToFloat16(src[i] * SCALAR_VALUE);
        golden_even[2 * i] = expected;
        golden_odd[2 * i + 1] = expected;
    }

    CApiExample::Runtime runtime;
    if (!runtime.Init()) {
        return 1;
    }
    CApiExample::DeviceBuffer<float> src_device(INPUT_COUNT);
    CApiExample::DeviceBuffer<aclFloat16> even_device(OUTPUT_COUNT);
    CApiExample::DeviceBuffer<aclFloat16> odd_device(OUTPUT_COUNT);
    if (!src_device.Allocate("aclrtMalloc(src)") || !even_device.Allocate("aclrtMalloc(even)") ||
        !odd_device.Allocate("aclrtMalloc(odd)") || !src_device.CopyFrom(src)) {
        return 1;
    }

    AscMulsDeprecatedKernel<<<1, 0>>>(
        reinterpret_cast<half*>(even_device.Get()), reinterpret_cast<half*>(odd_device.Get()), src_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !even_device.CopyTo(even) || !odd_device.CopyTo(odd)) {
        return 1;
    }

    CApiExample::Print("Input", src);
    CApiExample::PrintHalf("asc_muls output", even);
    CApiExample::PrintHalf("asc_muls Golden", golden_even);
    CApiExample::PrintHalf("asc_muls_v2 output", odd);
    CApiExample::PrintHalf("asc_muls_v2 Golden", golden_odd);
    const bool passed = CApiExample::CompareHalf(even, golden_even, 1e-3f) &&
                        CApiExample::CompareHalf(odd, golden_odd, 1e-3f);
    std::cout << (passed ? "[Success] asc_muls/asc_muls_v2 passed."
                         : "[Failed] asc_muls/asc_muls_v2 failed.") << std::endl;
    return passed ? 0 : 1;
}
