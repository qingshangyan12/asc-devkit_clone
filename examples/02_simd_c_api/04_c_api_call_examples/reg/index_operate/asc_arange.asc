// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/index_operate/asc_arange.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh reg/index_operate/asc_arange
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr int32_t START_VALUE = 10;

__simd_vf__ inline void Arange(__ubuf__ int32_t* ascending, __ubuf__ int32_t* descending)
{
    vector_int32_t ascending_reg;
    vector_int32_t descending_reg;
    uint32_t count = ELEMENT_COUNT;
    vector_bool mask = asc_update_mask_b32(count);
    asc_arange(ascending_reg, START_VALUE);
    asc_arange_descend(descending_reg, START_VALUE);
    asc_storealign(ascending, ascending_reg, mask);
    asc_storealign(descending, descending_reg, mask);
}

__global__ __vector__ void AscArangeKernel(__gm__ int32_t* ascending, __gm__ int32_t* descending)
{
    asc_init();
    __ubuf__ int32_t ascending_local[ELEMENT_COUNT];
    __ubuf__ int32_t descending_local[ELEMENT_COUNT];
    Arange(ascending_local, descending_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(ascending, ascending_local, ELEMENT_COUNT * sizeof(int32_t));
    asc_copy_ub2gm_align(descending, descending_local, ELEMENT_COUNT * sizeof(int32_t));
    asc_sync();
}
} // namespace

int main()
{
    std::vector<int32_t> input = {START_VALUE};
    std::vector<int32_t> ascending(ELEMENT_COUNT, 0), descending(ELEMENT_COUNT, 0);
    std::vector<int32_t> golden_ascending(ELEMENT_COUNT), golden_descending(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        golden_ascending[i] = START_VALUE + i;
        golden_descending[i] = START_VALUE + ELEMENT_COUNT - 1 - i;
    }
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<int32_t> ascending_device(ELEMENT_COUNT), descending_device(ELEMENT_COUNT);
    if (!ascending_device.Allocate("aclrtMalloc(ascending)") ||
        !descending_device.Allocate("aclrtMalloc(descending)")) return 1;
    AscArangeKernel<<<1, 0>>>(ascending_device.Get(), descending_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") ||
        !ascending_device.CopyTo(ascending) || !descending_device.CopyTo(descending)) return 1;
    CApiExample::Print("Input start", input);
    CApiExample::Print("Ascending output", ascending);
    CApiExample::Print("Ascending Golden", golden_ascending);
    CApiExample::Print("Descending output", descending);
    CApiExample::Print("Descending Golden", golden_descending);
    const bool passed = CApiExample::Compare(ascending, golden_ascending) &&
                        CApiExample::Compare(descending, golden_descending);
    std::cout << (passed ? "[Success] asc_arange/asc_arange_descend passed."
                         : "[Failed] asc_arange/asc_arange_descend failed.") << std::endl;
    return passed ? 0 : 1;
}
