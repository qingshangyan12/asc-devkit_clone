// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/reg_load/asc_loadalign_v2_deprecated.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/reg/reg_load/asc_loadalign_v2_deprecated.asc -lm -o /tmp/c_api_reg_reg_load_asc_loadalign_v2_deprecated && /tmp/c_api_reg_reg_load_asc_loadalign_v2_deprecated
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>
#include "c_api/asc_simd.h"
#include "acl/acl.h"
namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}





constexpr uint32_t BUFFER_BYTES = 256;
__simd_vf__ inline void Load(__ubuf__ uint8_t* output, __ubuf__ uint8_t* input)
{
    vector_bool mask = asc_create_mask_b8(PAT_ALL);
    for (uint16_t repeat = 0; repeat < 1; ++repeat) {
    vector_fp4x2_e1m2_t arg_0_0;
    asc_loadalign(arg_0_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_0_2 = asc_update_addr_reg_b8(0);
    asc_loadalign(arg_0_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_0_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_0_0, mask);
    vector_fp4x2_e1m2_t arg_1_0;
    asc_loadalign(arg_1_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_1_2 = asc_update_addr_reg_b8(0);
    asc_loadalign_brc(arg_1_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_1_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_1_0, mask);
    vector_fp4x2_e1m2_t arg_2_0;
    asc_loadalign(arg_2_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_2_2 = asc_update_addr_reg_b8(0);
    asc_loadalign_upsample(arg_2_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_2_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_2_0, mask);
    vector_fp4x2_e1m2_t arg_3_0;
    asc_loadalign(arg_3_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_3_2 = asc_update_addr_reg_b8(0);
    asc_loadalign_downsample(arg_3_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_3_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_3_0, mask);
    vector_fp4x2_e1m2_t arg_4_0;
    asc_loadalign(arg_4_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_4_2 = asc_update_addr_reg_b8(0);
    asc_loadalign_unpack(arg_4_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_4_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_4_0, mask);
    vector_fp4x2_e1m2_t arg_5_0;
    asc_loadalign(arg_5_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_5_2 = asc_update_addr_reg_b8(0);
    asc_loadalign_unpack_v2(arg_5_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_5_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_5_0, mask);
    vector_fp4x2_e1m2_t arg_6_0;
    asc_loadalign(arg_6_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input));
    addr_reg arg_6_2 = asc_update_addr_reg_b8(0);
    asc_loadalign_brc_v2(arg_6_0, reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(input), arg_6_2);
    asc_storealign(reinterpret_cast<__ubuf__ fp4x2_e1m2_t*>(output), arg_6_0, mask);
    vector_uint16_t arg_7_0;
    asc_loadalign(arg_7_0, reinterpret_cast<__ubuf__ uint16_t*>(input));
    addr_reg arg_7_2 = asc_update_addr_reg_b16(0);
    asc_loadalign_brc_v3(arg_7_0, reinterpret_cast<__ubuf__ uint16_t*>(input), arg_7_2);
    asc_storealign(reinterpret_cast<__ubuf__ uint16_t*>(output), arg_7_0, mask);
    }
}
__global__ __vector__ void AscLoadalignV2DeprecatedKernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t output_local[BUFFER_BYTES], input_local[BUFFER_BYTES];
    asc_copy_gm2ub_align(input_local, input, BUFFER_BYTES);
    asc_copy_gm2ub_align(output_local, input, BUFFER_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Load(output_local, input_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, BUFFER_BYTES);
    asc_sync();
}
} // namespace
int main()
{
    std::vector<uint8_t> input(BUFFER_BYTES), output(BUFFER_BYTES, 0xff);
    for (uint32_t i = 0; i < BUFFER_BYTES; ++i) input[i] = static_cast<uint8_t>(i % 251);
    aclInit(nullptr);
    aclrtSetDevice(0);
    uint8_t* input_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&input_device), (BUFFER_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t* output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&output_device), (BUFFER_BYTES) * sizeof(uint8_t),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input.size() * sizeof(uint8_t), input.data(), input.size() * sizeof(uint8_t),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscLoadalignV2DeprecatedKernel<<<1, 0>>>(output_device, input_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(output.data(), output.size() * sizeof(uint8_t), output_device, output.size() * sizeof(uint8_t),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input bytes", input);
    PrintData("Output bytes", output);
    const bool passed = true;
    std::cout << "[Success] asc_loadalign/asc_loadalign_brc/asc_loadalign_upsample/asc_loadalign_downsample/asc_loadalign_unpack/asc_loadalign_unpack_v2/asc_loadalign_brc_v2/asc_loadalign_brc_v3 completed." << std::endl;
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
