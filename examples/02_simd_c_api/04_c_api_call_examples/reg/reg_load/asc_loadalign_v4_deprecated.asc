constexpr uint32_t BUFFER_BYTES = 256;
__simd_vf__ inline void Load(__ubuf__ uint8_t* output, __ubuf__ uint8_t* input)
{
    vector_bool mask = asc_create_mask_b8(PAT_ALL);
    for (uint16_t repeat = 0; repeat < 1; ++repeat) {
    vector_int8_t arg_0_0;
    asc_loadalign(arg_0_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_0_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_postupdate(arg_0_0, arg_0_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_0_0, mask);
    vector_int8_t arg_1_0;
    asc_loadalign(arg_1_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_1_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_brc_postupdate(arg_1_0, arg_1_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_1_0, mask);
    vector_int8_t arg_2_0;
    asc_loadalign(arg_2_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_2_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_upsample_postupdate(arg_2_0, arg_2_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_2_0, mask);
    vector_int8_t arg_3_0;
    asc_loadalign(arg_3_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_3_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_downsample_postupdate(arg_3_0, arg_3_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_3_0, mask);
    vector_int8_t arg_4_0;
    asc_loadalign(arg_4_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_4_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_unpack_postupdate(arg_4_0, arg_4_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_4_0, mask);
    vector_int8_t arg_5_0;
    asc_loadalign(arg_5_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_5_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_unpack_postupdate_v2(arg_5_0, arg_5_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_5_0, mask);
    vector_int8_t arg_6_0;
    asc_loadalign(arg_6_0, reinterpret_cast<__ubuf__ int8_t*>(input));
    __ubuf__ int8_t* arg_6_1 = reinterpret_cast<__ubuf__ int8_t*>(input);
    asc_loadalign_brc_postupdate_v2(arg_6_0, arg_6_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int8_t*>(output), arg_6_0, mask);
    vector_int16_t arg_7_0;
    asc_loadalign(arg_7_0, reinterpret_cast<__ubuf__ int16_t*>(input));
    __ubuf__ int16_t* arg_7_1 = reinterpret_cast<__ubuf__ int16_t*>(input);
    asc_loadalign_brc_postupdate_v3(arg_7_0, arg_7_1, 0);
    asc_storealign(reinterpret_cast<__ubuf__ int16_t*>(output), arg_7_0, mask);
    }
}
__global__ __vector__ void AscLoadalignV4DeprecatedKernel(__gm__ uint8_t* output, __gm__ uint8_t* input)
{
    asc_init();
    __ubuf__ uint8_t output_local[BUFFER_BYTES], input_local[BUFFER_BYTES];
    asc_copy_gm2ub_align(input_local, input, BUFFER_BYTES);
    asc_copy_gm2ub_align(output_local, input, BUFFER_BYTES);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Load(output_local, input_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, BUFFER_BYTES);
    asc_sync();
}
} // namespace
int main()
{
    std::vector<uint8_t> input(BUFFER_BYTES, 0), output(BUFFER_BYTES, 0xff), golden(BUFFER_BYTES, 0);
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<uint8_t> input_device(BUFFER_BYTES), output_device(BUFFER_BYTES);
    if (!input_device.Allocate("aclrtMalloc(input)") || !output_device.Allocate("aclrtMalloc(output)") ||
        !input_device.CopyFrom(input)) return 1;
    AscLoadalignV4DeprecatedKernel<<<1, 0>>>(output_device.Get(), input_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") || !output_device.CopyTo(output)) return 1;
    CApiExample::Print("Input bytes", input);
    CApiExample::Print("Output bytes", output);
    CApiExample::Print("Golden bytes", golden);
    const bool passed = CApiExample::CompareRange(output, golden, 0, BUFFER_BYTES / 2);
    std::cout << (passed ? "[Success] asc_loadalign_postupdate/asc_loadalign_brc_postupdate/asc_loadalign_upsample_postupdate/asc_loadalign_downsample_postupdate/asc_loadalign_unpack_postupdate/asc_loadalign_unpack_postupdate_v2/asc_loadalign_brc_postupdate_v2/asc_loadalign_brc_postupdate_v3 passed." : "[Failed] asc_loadalign_postupdate/asc_loadalign_brc_postupdate/asc_loadalign_upsample_postupdate/asc_loadalign_downsample_postupdate/asc_loadalign_unpack_postupdate/asc_loadalign_unpack_postupdate_v2/asc_loadalign_brc_postupdate_v2/asc_loadalign_brc_postupdate_v3 failed.") << std::endl;
    return passed ? 0 : 1;
