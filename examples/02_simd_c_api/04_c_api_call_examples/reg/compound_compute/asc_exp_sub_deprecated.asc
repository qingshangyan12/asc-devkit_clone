// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/compound_compute/asc_exp_sub_deprecated.asc): "$ASCEND_HOME_PATH/bin/bisheng" --npu-arch=dav-3510 -std=c++17 -Wno-deprecated-declarations --asc-aicore-lang examples/02_simd_c_api/04_c_api_call_examples/reg/compound_compute/asc_exp_sub_deprecated.asc -lm -o /tmp/c_api_reg_compound_compute_asc_exp_sub_deprecated && /tmp/c_api_reg_compound_compute_asc_exp_sub_deprecated
// Architecture: dav-3510

#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "acl/acl.h"

namespace {
template <typename T>
void PrintData(const char* label, const std::vector<T>& values)
{
    std::cout << label << ":";
    const size_t count = values.size() < 8 ? values.size() : 8;
    for (size_t i = 0; i < count; ++i) std::cout << ' ' << +values[i];
    if (values.size() > count) std::cout << " ...";
    std::cout << std::endl;
}



constexpr uint32_t ELEMENT_COUNT = 64;

__simd_vf__ inline void Compute(__ubuf__ float* even, __ubuf__ float* odd,
    __ubuf__ float* src0, __ubuf__ float* src1)
{
    vector_float even_reg;
    vector_float odd_reg;
    vector_float src0_reg;
    vector_float src1_reg;
    uint32_t count = ELEMENT_COUNT;
    vector_bool mask = asc_update_mask_b32(count);
    asc_loadalign(src0_reg, src0);
    asc_loadalign(src1_reg, src1);
    asc_exp_sub(even_reg, src0_reg, src1_reg, mask);
    asc_exp_sub_v2(odd_reg, src0_reg, src1_reg, mask);
    asc_storealign(even, even_reg, mask);
    asc_storealign(odd, odd_reg, mask);
}

__global__ __vector__ void AscExpSubDeprecatedKernel(__gm__ float* even, __gm__ float* odd,
    __gm__ float* src0, __gm__ float* src1)
{
    asc_init();
    __ubuf__ float even_local[ELEMENT_COUNT];
    __ubuf__ float odd_local[ELEMENT_COUNT];
    __ubuf__ float src0_local[ELEMENT_COUNT];
    __ubuf__ float src1_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(src0_local, src0, ELEMENT_COUNT * sizeof(float));
    asc_copy_gm2ub_align(src1_local, src1, ELEMENT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Compute(even_local, odd_local, src0_local, src1_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(even, even_local, ELEMENT_COUNT * sizeof(float));
    asc_copy_ub2gm_align(odd, odd_local, ELEMENT_COUNT * sizeof(float));
    asc_sync();
}
} // namespace

int main()
{
    std::vector<float> src0(ELEMENT_COUNT, 0.5f);
    std::vector<float> src1(ELEMENT_COUNT, 0.25f);
    std::vector<float> even(ELEMENT_COUNT, 0.0f);
    std::vector<float> odd(ELEMENT_COUNT, 0.0f);

    aclInit(nullptr);
    aclrtSetDevice(0);
    float* src0_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), (ELEMENT_COUNT) * sizeof(float),
        ACL_MEM_MALLOC_HUGE_FIRST);
    float* src1_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), (ELEMENT_COUNT) * sizeof(float),
        ACL_MEM_MALLOC_HUGE_FIRST);
    float* even_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&even_device), (ELEMENT_COUNT) * sizeof(float),
        ACL_MEM_MALLOC_HUGE_FIRST);
    float* odd_device = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&odd_device), (ELEMENT_COUNT) * sizeof(float),
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(src0_device, src0.size() * sizeof(float), src0.data(), src0.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, src1.size() * sizeof(float), src1.data(), src1.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE);
    AscExpSubDeprecatedKernel<<<1, 0>>>(
        even_device, odd_device, src0_device, src1_device);
    aclrtSynchronizeDevice();
    aclrtMemcpy(even.data(), even.size() * sizeof(float), even_device, even.size() * sizeof(float),
        ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(odd.data(), odd.size() * sizeof(float), odd_device, odd.size() * sizeof(float),
        ACL_MEMCPY_DEVICE_TO_HOST);
    PrintData("Input 0", src0);
    PrintData("Input 1", src1);
    PrintData("asc_exp_sub output", even);
    PrintData("asc_exp_sub_v2 output", odd);
    aclrtFree(even_device);
    aclrtFree(odd_device);
    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
