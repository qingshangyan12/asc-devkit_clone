// Build/run (examples/02_simd_c_api/04_c_api_call_examples/reg/compare_and_select/asc_le_scalar.asc): bash examples/02_simd_c_api/04_c_api_call_examples/run_example.sh reg/compare_and_select/asc_le_scalar
// Architecture: dav-3510

#include <cstdint>
#include <iostream>
#include <vector>

#include "c_api/asc_simd.h"
#include "common/sample_host.h"

namespace {
constexpr uint32_t ELEMENT_COUNT = 64;
constexpr float COMPARE_VALUE = 3.0f;

__simd_vf__ inline void Compare(__ubuf__ float* dst, __ubuf__ float* src)
{
    vector_float dst_reg;
    vector_float ones;
    vector_float zeros;
    vector_float src_reg;
    vector_bool predicate;
    uint32_t count = ELEMENT_COUNT;
    vector_bool mask = asc_update_mask_b32(count);
    asc_loadalign(src_reg, src);
    asc_le_scalar(predicate, src_reg, COMPARE_VALUE, mask);
    asc_duplicate_scalar(ones, 1.0f, mask);
    asc_duplicate_scalar(zeros, 0.0f, mask);
    asc_select(dst_reg, ones, zeros, predicate);
    asc_storealign(dst, dst_reg, mask);
}

__global__ __vector__ void AscLeScalarKernel(__gm__ float* dst, __gm__ float* src)
{
    asc_init();
    __ubuf__ float dst_local[ELEMENT_COUNT];
    __ubuf__ float src_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(src_local, src, ELEMENT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    Compare(dst_local, src_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(dst, dst_local, ELEMENT_COUNT * sizeof(float));
    asc_sync();
}
} // namespace

int main()
{
    std::vector<float> src(ELEMENT_COUNT);
    std::vector<float> output(ELEMENT_COUNT, 0.0f);
    std::vector<float> golden(ELEMENT_COUNT);
    for (uint32_t i = 0; i < ELEMENT_COUNT; ++i) {
        src[i] = static_cast<float>(i % 8);
        golden[i] = src[i] <= COMPARE_VALUE ? 1.0f : 0.0f;
    }
    CApiExample::Runtime runtime;
    if (!runtime.Init()) return 1;
    CApiExample::DeviceBuffer<float> src_device(ELEMENT_COUNT);
    CApiExample::DeviceBuffer<float> dst_device(ELEMENT_COUNT);
    if (!src_device.Allocate("aclrtMalloc(src)") || !dst_device.Allocate("aclrtMalloc(dst)") || !src_device.CopyFrom(src)) return 1;
    AscLeScalarKernel<<<1, 0>>>(dst_device.Get(), src_device.Get());
    if (!CApiExample::CheckAcl(aclrtSynchronizeDevice(), "aclrtSynchronizeDevice") || !dst_device.CopyTo(output)) return 1;
    CApiExample::Print("Input", src);
    CApiExample::Print("Output", output);
    CApiExample::Print("Golden", golden);
    const bool passed = CApiExample::Compare(output, golden);
    std::cout << (passed ? "[Success] asc_le_scalar passed." : "[Failed] asc_le_scalar failed.") << std::endl;
    return passed ? 0 : 1;
}
