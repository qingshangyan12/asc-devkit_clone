/*!
 * \file msprof.asc
 * \brief 基于Add的msProf profiling样例。
 */

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <iterator>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;

__simd_vf__ inline void add_vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, uint32_t count)
{
    uint16_t repeatElems = asc_get_vf_len() / sizeof(float);
    uint32_t remaining = count;
    vector_bool mask;
    vector_float lhs;
    vector_float rhs;
    vector_float sum;
    for (uint32_t i = 0; i < count; i += repeatElems) {
        mask = asc_update_mask_b32(remaining);
        asc_load(lhs, x + i);
        asc_load(rhs, y + i);
        asc_add(sum, lhs, rhs, mask);
        asc_store(z + i, sum);
    }
}

__global__ __vector__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();
    constexpr uint32_t blockLength = TOTAL_LENGTH / NUM_BLOCKS;
    __ubuf__ float xLocal[blockLength];
    __ubuf__ float yLocal[blockLength];
    __ubuf__ float zLocal[blockLength];
    constexpr uint8_t mutexId = 1;
    asc_lock(PIPE_MTE2, mutexId);
    asc_copy_gm2ub(xLocal, x + block_idx * blockLength, blockLength * sizeof(float));
    asc_copy_gm2ub(yLocal, y + block_idx * blockLength, blockLength * sizeof(float));
    asc_unlock(PIPE_MTE2, mutexId);
    asc_lock(PIPE_V, mutexId);
    add_vf(xLocal, yLocal, zLocal, blockLength);
    asc_unlock(PIPE_V, mutexId);
    asc_lock(PIPE_MTE3, mutexId);
    asc_copy_ub2gm(z + block_idx * blockLength, zLocal, blockLength * sizeof(float));
    asc_unlock(PIPE_MTE3, mutexId);
}

template <typename T>
std::vector<T> kernel_add(std::vector<T>& x, std::vector<T>& y)
{
    constexpr uint32_t numBlocks = 8;
    constexpr uint32_t blockLength = 2048;
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(T);
    int32_t deviceId = 0;
    T* xDevice = nullptr;
    T* yDevice = nullptr;
    T* zDevice = nullptr;
    std::vector<T> z(totalLength);

    aclInit(nullptr);
    aclrtSetDevice(deviceId);

    aclrtMalloc((void**)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice, totalByteSize, x.data(), totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, totalByteSize, y.data(), totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    add_custom<<<numBlocks, 0>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeDevice();

    aclrtMemcpy(z.data(), totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);

    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

template <typename T>
uint32_t VerifyResult(std::vector<T>& output, std::vector<T>& golden)
{
    auto printTensor = [](std::vector<T>& tensor, const char* name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<T>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    for (size_t i = 0; i < golden.size(); ++i) {
        float error = std::abs(static_cast<float>(output[i]) - static_cast<float>(golden[i]));
        float limit = 1e-4f + 1e-5f * std::abs(static_cast<float>(golden[i]));
        if (!(error <= limit)) {
            std::cout << "test failed at " << i << ": output=" << output[i]
                      << ", golden=" << golden[i] << ", error=" << error << std::endl;
            return 1;
        }
    }
    std::cout << "test pass!" << std::endl;
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    using DataType = float;
    constexpr uint32_t totalLength = 8 * 2048;
    std::vector<DataType> x(totalLength);
    std::vector<DataType> y(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        x[i] = static_cast<DataType>(i * 0.1f);
        y[i] = static_cast<DataType>(i * 0.2f);
    }

    std::vector<DataType> output = kernel_add(x, y);

    std::vector<DataType> golden(totalLength);
    for (uint32_t i = 0; i < totalLength; ++i) {
        golden[i] = x[i] + y[i];
    }
    return VerifyResult(output, golden);
}
