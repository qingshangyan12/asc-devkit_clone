/*!
 * \file simd_vf_dump.asc
 * \brief 使用vector编程模式，展示simd_vf侧asc_dump_ubuf/asc_dump/asc_dump_reg接口的基本使用方法
 */

#include "acl/acl.h"
#include "utils/debug/asc_dump.h"
#include "c_api/asc_simd.h"
#include "utils/debug/asc_printf.h"
#include "data_utils.h"

namespace {
constexpr uint32_t DATA_LEN = 32;
constexpr uint32_t REG_COUNT = 32;
} // namespace

// simd_vf dump演示: 使用asc_dump_ubuf打印UB数据
__simd_vf__ inline void DumpUbufData(__ubuf__ float* x)
{
    asc_dump_ubuf<float>(x, 5, 32);
    asc_dump<float>(x, 5, 16);
}

// simd_vf dump演示: 使用asc_dump_reg打印Reg数据
__simd_vf__ inline void DumpRegData(__ubuf__ float* x)
{
    vector_float srcReg;
    vector_bool maskReg;
    uint32_t count = REG_COUNT;
    maskReg = asc_update_mask_b32(count);
    asc_loadalign(srcReg, x);
    asc_duplicate_scalar(srcReg, 3.0f, maskReg);

    asc_dump_reg<float>(srcReg, 5, 32);
    asc_duplicate_scalar(srcReg, 4.0f, maskReg);
    asc_dump<float>(srcReg, 5, 16);
}

// simd_vf dump演示: 使用asc_dump打印UB数据
__simd_vf__ inline void DumpModifiedUbuf(__ubuf__ float* x) { asc_dump<float>(x, 5, 32); }

__global__ __vector__ void simd_vf_dump_kernel(__gm__ uint8_t* x, __gm__ uint8_t* z)
{
    asc_init();
    __ubuf__ float ubInput[DATA_LEN];
    constexpr uint8_t mutexId = 1;
    asc_lock(PIPE_MTE2, mutexId);
    asc_copy_gm2ub(ubInput, (__gm__ float*)x, DATA_LEN * sizeof(float));
    asc_unlock(PIPE_MTE2, mutexId);
    asc_lock(PIPE_V, mutexId);
    printf("[aicore] simd_vf dump demo start ...\n");

    // 1. 调用asc_dump_ubuf接口：打印UB数据
    printf("========== UB data (asc_dump_ubuf + asc_dump) ==========\n");
    asc_vf_call<DumpUbufData>(ubInput);

    // 2. 调用asc_dump_reg接口：从UB加载到Reg后打印Reg数据
    printf("========== Register data (asc_dump_reg + asc_dump) ==========\n");
    asc_vf_call<DumpRegData>(ubInput);

    // 3. 调用asc_dump接口：打印UB数据
    printf("========== UB data (asc_dump) ==========\n");
    asc_vf_call<DumpModifiedUbuf>(ubInput);

    // 4. 执行Adds计算（x + 1.0），将结果写回GM，用于后续校验
    for (uint32_t i = 0; i < DATA_LEN; ++i) {
        ubInput[i] += 1.0f;
    }
    printf("[aicore] simd_vf dump demo end ...\n");
    asc_unlock(PIPE_V, mutexId);
    asc_lock(PIPE_MTE3, mutexId);
    asc_copy_ub2gm((__gm__ float*)z, ubInput, DATA_LEN * sizeof(float));
    asc_unlock(PIPE_MTE3, mutexId);
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr uint32_t xTotalLength = DATA_LEN;
    size_t fileSize = xTotalLength * sizeof(float);

    uint8_t* xHost;
    uint8_t* xDevice;
    aclrtMallocHost((void**)(&xHost), fileSize);
    aclrtMalloc((void**)&xDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x_gm.bin", fileSize, xHost, fileSize);
    aclrtMemcpy(xDevice, fileSize, xHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* zHost;
    uint8_t* zDevice;
    aclrtMallocHost((void**)(&zHost), fileSize);
    aclrtMalloc((void**)&zDevice, fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    constexpr uint32_t numBlocks = 1;
    simd_vf_dump_kernel<<<numBlocks, 0, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, fileSize, zDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, fileSize);

    aclrtFree(xDevice);
    aclrtFreeHost(xHost);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
