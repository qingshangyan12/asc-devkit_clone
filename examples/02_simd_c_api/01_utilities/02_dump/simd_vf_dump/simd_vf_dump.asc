/*!
 * \file simd_vf_dump.asc
 * \brief 使用vector编程模式，展示simd_vf侧asc_dump_ubuf/asc_dump/asc_dump_reg接口的基本使用方法
 */

#include "acl/acl.h"
#include "utils/debug/asc_dump.h"
#include "c_api/asc_simd.h"
#include "utils/debug/asc_printf.h"
#include "data_utils.h"

namespace {
constexpr uint32_t DATA_LEN = 32;
constexpr uint32_t REG_COUNT = 32;
} // namespace

// simd_vf dump演示: 使用asc_dump_ubuf打印UB数据
__simd_vf__ inline void dump_ubuf_data(__ubuf__ float* x)
{
    asc_dump_ubuf<float>(x, 5, 32);
    asc_dump<float>(x, 5, 16);
}

// simd_vf dump演示: 使用asc_dump_reg打印Reg数据
__simd_vf__ inline void dump_reg_data(__ubuf__ float* x)
{
    vector_float src_reg;
    vector_bool mask_reg;
    uint32_t count = REG_COUNT;
    mask_reg = asc_update_mask_b32(count);
    asc_loadalign(src_reg, x);
    asc_duplicate_scalar(src_reg, 3.0f, mask_reg);

    asc_dump_reg<float>(src_reg, 5, 32);
    asc_duplicate_scalar(src_reg, 4.0f, mask_reg);
    asc_dump<float>(src_reg, 5, 16);
}

// simd_vf dump演示: 使用asc_dump打印UB数据
__simd_vf__ inline void dump_modified_ubuf(__ubuf__ float* x) { asc_dump<float>(x, 5, 32); }

__global__ __vector__ void simd_vf_dump_kernel(__gm__ uint8_t* x, __gm__ uint8_t* z)
{
    asc_init();
    __ubuf__ float ub_input[DATA_LEN];
    constexpr uint8_t mutex_id = 1;
    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub(ub_input, (__gm__ float*)x, DATA_LEN * sizeof(float));
    asc_unlock(PIPE_MTE2, mutex_id);
    asc_lock(PIPE_V, mutex_id);
    printf("[aicore] simd_vf dump demo start ...\n");

    // 1. 调用asc_dump_ubuf接口：打印UB数据
    printf("========== UB data (asc_dump_ubuf + asc_dump) ==========\n");
    asc_vf_call<dump_ubuf_data>(ub_input);

    // 2. 调用asc_dump_reg接口：从UB加载到Reg后打印Reg数据
    printf("========== Register data (asc_dump_reg + asc_dump) ==========\n");
    asc_vf_call<dump_reg_data>(ub_input);

    // 3. 执行Adds计算（x + 1.0）
    for (uint32_t i = 0; i < DATA_LEN; ++i) {
        ub_input[i] += 1.0f;
    }
    // 4. 调用asc_dump接口：打印计算后的UB数据
    printf("========== Modified UB data (asc_dump) ==========\n");
    asc_vf_call<dump_modified_ubuf>(ub_input);
    printf("[aicore] simd_vf dump demo end ...\n");
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm((__gm__ float*)z, ub_input, DATA_LEN * sizeof(float));
    asc_unlock(PIPE_MTE3, mutex_id);
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr uint32_t x_total_length = DATA_LEN;
    size_t file_size = x_total_length * sizeof(float);

    uint8_t* x_host;
    uint8_t* x_device;
    aclrtMallocHost((void**)(&x_host), file_size);
    aclrtMalloc((void**)&x_device, file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x_gm.bin", file_size, x_host, file_size);
    aclrtMemcpy(x_device, file_size, x_host, file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* z_host;
    uint8_t* z_device;
    aclrtMallocHost((void**)(&z_host), file_size);
    aclrtMalloc((void**)&z_device, file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    constexpr uint32_t num_blocks = 1;
    simd_vf_dump_kernel<<<num_blocks, 0, stream>>>(x_device, z_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, file_size, z_device, file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", z_host, file_size);

    aclrtFree(x_device);
    aclrtFreeHost(x_host);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
