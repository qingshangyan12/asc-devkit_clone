/*!
 * \file simulator.asc
 * \brief C API MatmulLeakyRelu sample for CAmodel simulation.
 */
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t CUBE_BLOCK = 16;

__simd_vf__ inline void leaky_relu_vf(__ubuf__ half* data)
{
    constexpr uint32_t LANES = 256 / sizeof(half);
    constexpr uint32_t ELEMENTS = 256 * 128 / 2;
    for (uint32_t offset = 0; offset < ELEMENTS; offset += LANES) {
        uint32_t remaining = LANES;
        vector_bool mask = asc_update_mask_b16(remaining);
        vector_half input, negative, output;
        asc_loadalign(input, data + offset);
        asc_mul_scalar(negative, input, (half)0.001, mask);
        vector_bool positive;
        asc_ge_scalar(positive, input, (half)0, mask);
        asc_select(output, input, negative, positive);
        asc_storealign(data + offset, output, mask);
    }
}

template <
    uint32_t M, uint32_t K, uint32_t N, uint32_t singleCoreM, uint32_t singleCoreK, uint32_t singleCoreN,
    uint32_t baseM, uint32_t baseK, uint32_t baseN>
__global__ __mix__(1, 2) void matmul_vec_custom(__gm__ uint8_t* xMatrix, __gm__ uint8_t* yMatrix, __gm__ uint8_t* zMatrix)
{
    asc_init();
    if ASC_IS_AIC {
        __gm__ half* aGM = (__gm__ half*)xMatrix + block_idx * singleCoreM * K;
        __gm__ half* bGM = (__gm__ half*)yMatrix;
        __gm__ half* cGM = (__gm__ half*)zMatrix + block_idx * singleCoreM * N;
        __cbuf__ half a1Local[baseM * baseK];
        __cbuf__ half b1Local[baseK * baseN];
        __ca__ half a2Local[baseM * baseK];
        __cb__ half b2Local[baseK * baseN];
        __cc__ float cLocal[baseM * baseN];
        asc_set_gm2l1_nz_para(1, 1, baseM, 0);
        asc_copy_gm2l1_nd2nz(a1Local, aGM, K * sizeof(half),
                              asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseM, baseK, 0, false);
        asc_set_gm2l1_nz_para(1, 1, baseK, 0);
        asc_copy_gm2l1_nd2nz(b1Local, bGM, N * sizeof(half),
                              asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, baseK, baseN, 0, false);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12l0a(a2Local, a1Local, 0, 0, baseM / CUBE_BLOCK, baseK / CUBE_BLOCK,
                        baseM / CUBE_BLOCK, baseM / CUBE_BLOCK);
        asc_copy_l12l0b_transpose(b2Local, b1Local, 0, 0, baseK / CUBE_BLOCK, baseN / CUBE_BLOCK,
                                  baseK / CUBE_BLOCK, baseN / CUBE_BLOCK);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_mmad(cLocal, a2Local, b2Local, baseM, baseK, baseN,
                 asc_unit_flag_mode::DISABLE, false, false, true);
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_set_l0c_copy_nz_para(1, 0, 0);
        asc_copy_l0c2gm(cGM, cLocal, baseN, baseM, N, baseM, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
                        asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NONE,
                        false, true, false, false);
        asc_sync_block_arrive(PIPE_FIX, 0x8);
    }
    if ASC_IS_AIV {
        constexpr uint32_t tileLen = baseM / 2 * baseN;
        __gm__ half* cGM = (__gm__ half*)zMatrix + block_idx * singleCoreM * N
                        + asc_get_sub_block_id() * tileLen;
        __ubuf__ half vecLocal[tileLen];
        asc_sync_block_wait(PIPE_MTE2, 0x8);
        asc_copy_gm2ub_align(vecLocal, cGM, tileLen * sizeof(half));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_vf_call<leaky_relu_vf>(vecLocal);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm_align(cGM, vecLocal, tileLen * sizeof(half));
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 512;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 128;
    constexpr uint32_t singleCoreM = 256;
    constexpr uint32_t singleCoreK = 128;
    constexpr uint32_t singleCoreN = 128;
    constexpr uint32_t baseM = 256;
    constexpr uint32_t baseK = 128;
    constexpr uint32_t baseN = 128;

    size_t aFileSize = M * K * sizeof(half);
    size_t bFileSize = K * N * sizeof(half);
    size_t cFileSize = M * N * sizeof(half);
    uint32_t numBlocks = (M / singleCoreM) * (N / singleCoreN);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* aHost = nullptr;
    uint8_t* aDevice = nullptr;
    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bHost = nullptr;
    uint8_t* bDevice = nullptr;
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* cHost = nullptr;
    uint8_t* cDevice = nullptr;
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    matmul_vec_custom<M, K, N, singleCoreM, singleCoreK, singleCoreN, baseM, baseK, baseN>
        <<<numBlocks, 0, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
