/* !
 * \file case3_out_of_bounds_result.asc
 * \brief Observes runtime and accuracy results when out-of-bounds UB writes reach different UB regions.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t UB_BYTES = 4 * 1024;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);
constexpr uint32_t VF_RESERVED_BYTES = 6 * 1024;
constexpr uint32_t ASC_RESERVED_BYTES = 2 * 1024;
constexpr uint32_t DCACHE_BYTES = 128 * 1024;
constexpr uint32_t RESERVED_START_BYTES =
    UB_TOTAL_BYTES - DCACHE_BYTES - VF_RESERVED_BYTES - ASC_RESERVED_BYTES;
constexpr uint32_t INPUT_BASE_VALUE = 0xC0030000;
constexpr uint32_t ACCESS_OFFSETS[] = {
    // 静态UB合法范围内的最后一个uint32_t元素。
    UB_BYTES - sizeof(uint32_t),
    // 已申请静态UB之后、预留空间之前的未申请UB范围中部。
    (UB_BYTES + RESERVED_START_BYTES) / 2,
    // 6KB VF预留范围中部。
    RESERVED_START_BYTES + VF_RESERVED_BYTES / 2,
    // 2KB Ascend C API预留范围中部。
    RESERVED_START_BYTES + VF_RESERVED_BYTES + ASC_RESERVED_BYTES / 2,
    // Data Cache起始位置。
    UB_TOTAL_BYTES - DCACHE_BYTES,
};
constexpr uint32_t ACCESS_OFFSET_BYTES = ACCESS_OFFSETS[CASE3_ACCESS_REGION];
static_assert(CASE3_ACCESS_REGION >= 0 && CASE3_ACCESS_REGION <= 4, "Case 3 access region must be in [0, 4]");
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_calibrate_input(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t word_count)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        const uint32_t input_data = input[index];
        output[index] = input_data + (input_data & 0xff);
    }
}

// Case 3通过运行时下标访问不同UB区域，观察静态数组越界后的运行和精度结果。
__global__ __vector__ void ub_out_of_bounds_result_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t access_index)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_calibrate_input>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    // access_index由Host侧按字节偏移换算得到，volatile用于保留这次观察访问。
    __ubuf__ volatile uint32_t* static_ub_ptr = static_ub;
    static_ub_ptr[access_index] = CORRUPTED_VALUE;
    asc_unlock(PIPE_S, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_calibrate_input>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    asc_unlock(PIPE_V, mutex_id);
}

int32_t main()
{
    std::vector<uint32_t> input(BUFFER_WORDS);
    for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
        input[index] = INPUT_BASE_VALUE + index;
    }

    uint32_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), BUFFER_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, BUFFER_BYTES, input.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr const char* REGION_NAMES[] = {"static_ub", "unallocated_ub", "vf_reserved", "asc_reserved", "data_cache"};
    std::cout << "[Case3] region=" << REGION_NAMES[CASE3_ACCESS_REGION] << std::endl;
    ub_out_of_bounds_result_kernel<<<1, 0, stream>>>(
        input_device, output_device, ACCESS_OFFSET_BYTES / sizeof(uint32_t));

    aclError sync_ret = aclrtSynchronizeStream(stream);
    const char* err = aclGetRecentErrMsg();
    bool passed = false;
    if (sync_ret == ACL_SUCCESS && err == nullptr) {
        aclrtMemcpy(output_host, BUFFER_BYTES, output_device, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
        bool accuracy_passed = true;
        // Case3用于观察越界写入不同UB区域后的精度结果，运行完成不说明访问合法。
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t input_data = INPUT_BASE_VALUE + index;
            const uint32_t expected = input_data + (input_data & 0xff);
            if (output_host[index] != expected) {
                accuracy_passed = false;
                break;
            }
        }
        passed = true;
        std::cout << (accuracy_passed ? "test pass!" : "[Failed] Case accuracy verification failed!")
                  << std::endl;
    }
    if (err != nullptr) {
        fprintf(stderr, "[Host] kernel error: %s\n", err);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
