/* !
 * \file case0_ub_out_of_bounds.asc
 * \brief Reproduces a UB out-of-bounds write that causes an output accuracy issue.
 */

#include "ub_usage_limit_common.h"

namespace {
// SIMT场景下，256KB UB扣除8KB预留空间和32KB Data Cache后，可用静态UB为216KB。
constexpr uint32_t UB_BYTES = 216 * 1024;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);
constexpr uint32_t UB_TILE_COUNT = 4;
constexpr uint32_t UB_TILE_WORDS = UB_WORDS / UB_TILE_COUNT;
constexpr uint32_t DATA_TILE_WORDS = 2048; // 每个数据块包含2048个uint32_t元素，即8KB。
constexpr uint32_t BIAS_OFFSET = DATA_TILE_WORDS;
constexpr uint32_t INPUT_WORDS = 10240; // 输入共40KB，对应5个数据块。
constexpr uint32_t DATA_TILE_COUNT = INPUT_WORDS / DATA_TILE_WORDS;
constexpr uint32_t INPUT_BYTES = INPUT_WORDS * sizeof(uint32_t);
constexpr uint32_t INPUT_BASE_VALUE = 0xC0000000;
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_prepare_input_ub(
    __gm__ const uint32_t* input, __ubuf__ uint32_t* static_ub, uint32_t tile_id)
{
    const uint32_t tile_base =
        (tile_id & (UB_TILE_COUNT - 1)) * UB_TILE_WORDS;
    const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
    for (uint32_t index = threadIdx.x; index < DATA_TILE_WORDS; index += blockDim.x) {
        const uint32_t input_data = input[gm_base + index];
        static_ub[tile_base + index] = input_data;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_store_calibrated_output(
    __gm__ const uint32_t* input, __ubuf__ uint32_t* static_ub, __gm__ uint32_t* output,
    uint32_t word_count, uint32_t tile_id)
{
    const uint32_t tile_base =
        (tile_id & (UB_TILE_COUNT - 1)) * UB_TILE_WORDS;
    const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        const uint32_t input_data = input[gm_base + index];
        const uint32_t bias = static_ub[tile_base + BIAS_OFFSET + index];
        output[gm_base + index] = input_data + bias;
    }
}

__aicore__ inline uint32_t calc_ub_tile_id(uint32_t tile_id)
{
    return tile_id & (UB_TILE_COUNT - 1);
}

__aicore__ inline uint32_t calc_bias_base_words(uint32_t ub_tile_id)
{
    return ub_tile_id * UB_TILE_WORDS + BIAS_OFFSET;
}

__aicore__ inline void generate_bias_values(__ubuf__ uint32_t* static_ub, uint32_t ub_tile_id)
{
    const uint32_t tile_base_words = ub_tile_id * UB_TILE_WORDS;
    const uint32_t bias_base_words = calc_bias_base_words(ub_tile_id);
    for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
        const uint32_t input = static_ub[tile_base_words + index];
        static_ub[bias_base_words + index] = input & 0xff;
    }
}

// Case 0当前实现：生成bias时直接使用数据块编号作为静态UB中的UB tile编号。
__global__ __vector__ void static_ub_out_of_bounds_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    for (uint32_t tile_id = 0; tile_id < DATA_TILE_COUNT; ++tile_id) {
        // 按数据块编号选择对应的UB tile，保存输入数据。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_prepare_input_ub>(dim3(THREAD_COUNT), input, static_ub, tile_id);
        asc_unlock(PIPE_V, mutex_id);

        asc_lock(PIPE_S, mutex_id);
        generate_bias_values(static_ub, tile_id);
        asc_unlock(PIPE_S, mutex_id);

        // 后续SIMT阶段读取GM input和UB bias生成输出；如果中间数据写入位置错误，输出精度可能异常。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_store_calibrated_output>(
            dim3(THREAD_COUNT), input, static_ub, output, DATA_TILE_WORDS, tile_id);
        asc_unlock(PIPE_V, mutex_id);
    }
}

// Case 0修复实现：生成bias时使用映射后的静态UB中的UB tile编号。
__global__ __vector__ void static_ub_bias_offset_fixed_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    for (uint32_t tile_id = 0; tile_id < DATA_TILE_COUNT; ++tile_id) {
        // 按数据块编号选择对应的UB tile，保存输入数据。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_prepare_input_ub>(dim3(THREAD_COUNT), input, static_ub, tile_id);
        asc_unlock(PIPE_V, mutex_id);

        asc_lock(PIPE_S, mutex_id);
        const uint32_t ub_tile_id = calc_ub_tile_id(tile_id);
        generate_bias_values(static_ub, ub_tile_id);
        asc_unlock(PIPE_S, mutex_id);

        // 后续SIMT阶段读取GM input和UB bias生成输出。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_store_calibrated_output>(
            dim3(THREAD_COUNT), input, static_ub, output, DATA_TILE_WORDS, tile_id);
        asc_unlock(PIPE_V, mutex_id);
    }
}

uint32_t verify_result(const uint32_t* output)
{
    for (uint32_t tile_id = 0; tile_id < DATA_TILE_COUNT; ++tile_id) {
        const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
        for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
            const uint32_t input_data = INPUT_BASE_VALUE + gm_base + index;
            const uint32_t expected = input_data + (input_data & 0xff);
            if (output[gm_base + index] != expected) {
                printf("[Failed] Case accuracy verification failed!\n");
                return 1;
            }
        }
    }
    printf("test pass!\n");
    return 0;
}

void generate_input_data(std::vector<uint32_t>& input)
{
    for (uint32_t tile_id = 0; tile_id < DATA_TILE_COUNT; ++tile_id) {
        const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
        for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
            input[gm_base + index] = INPUT_BASE_VALUE + gm_base + index;
        }
    }
}

int32_t main()
{
    std::vector<uint32_t> input(INPUT_WORDS);
    generate_input_data(input);

    uint32_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), INPUT_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), INPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), INPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, INPUT_BYTES, input.data(), INPUT_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

#if defined(CASE0_ENABLE_FIX)
    constexpr const char* MODE = "fixed";
    static_ub_bias_offset_fixed_kernel<<<1, 0, stream>>>(
        input_device, output_device);
#else
    constexpr const char* MODE = "baseline";
    static_ub_out_of_bounds_kernel<<<1, 0, stream>>>(
        input_device, output_device);
#endif
    std::cout << "[Case0] mode=" << MODE << std::endl;

    aclError sync_ret = aclrtSynchronizeStream(stream);
    const char* err = aclGetRecentErrMsg();
    uint32_t ret = 1;
    if (sync_ret == ACL_SUCCESS && err == nullptr) {
        aclrtMemcpy(output_host, INPUT_BYTES, output_device, INPUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
        ret = verify_result(output_host);
    }
    if (err != nullptr) {
        fprintf(stderr, "[Host] kernel error: %s\n", err);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ret;
}
