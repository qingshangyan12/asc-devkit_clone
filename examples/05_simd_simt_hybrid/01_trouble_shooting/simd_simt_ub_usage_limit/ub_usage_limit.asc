/* !
 * \file ub_usage_limit.asc
 * \brief Demonstrates UB out-of-bounds analysis and correct UB usage in SIMD and SIMT hybrid programming.
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 4
#error "SCENARIO_NUM must be one of 0, 1, 2, 3, 4."
#endif

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DATA_CACHE_BYTES = 32 * 1024;
constexpr uint32_t USER_UB_BYTES_WITH_SIMT = UB_TOTAL_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DATA_CACHE_BYTES;

constexpr uint32_t RESULT_WORDS_PER_CASE = 8;
constexpr uint32_t RESULT_BYTES_PER_CASE = RESULT_WORDS_PER_CASE * sizeof(uint32_t);

constexpr uint32_t BUFFER_WORDS = THREAD_COUNT;
constexpr uint32_t BUFFER_BYTES = BUFFER_WORDS * sizeof(uint32_t);
constexpr uint32_t CASE0_STATIC_BYTES = 216 * 1024;
constexpr uint32_t CASE0_STATIC_WORDS = CASE0_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE0_DCACHE_BYTES = 32 * 1024;
constexpr uint32_t CASE0_DCACHE_START_WORD = (CASE0_STATIC_BYTES + RESERVED_UB_BYTES) / sizeof(uint32_t);

constexpr uint32_t MIXED_MAIN_STATIC_WORDS = 256;
constexpr uint32_t MIXED_SIMD_STATIC_WORDS = 512;
constexpr uint32_t MIXED_SIMT_STATIC_WORDS = THREAD_COUNT;
constexpr uint32_t MIXED_MAIN_STATIC_BYTES = 3 * RESULT_BYTES_PER_CASE;

constexpr uint32_t CASE0_MARKER = 0xC0000000;
constexpr uint32_t CORRUPTED_VALUE = 0xDEADBEEF;
constexpr uint32_t CASE2_MARKER = 0xC0020000;
constexpr uint32_t CASE3_MARKER = 0xC0030000;

#if SCENARIO_NUM == 4
constexpr uint32_t CASE4_STATIC_BYTES = 4 * 1024;
constexpr uint32_t CASE4_STATIC_WORDS = CASE4_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE4_VF_STACK_BYTES = 6 * 1024;
constexpr uint32_t CASE4_ASC_RESERVED_BYTES = 2 * 1024;
constexpr uint32_t CASE4_DCACHE_BYTES = 128 * 1024;
constexpr uint32_t CASE4_RESERVED_START_BYTES =
    UB_TOTAL_BYTES - CASE4_DCACHE_BYTES - CASE4_VF_STACK_BYTES - CASE4_ASC_RESERVED_BYTES;
constexpr uint32_t CASE4_MARKER = 0xC0040000;
constexpr uint32_t CASE4_ACCESS_OFFSETS[] = {
    CASE4_STATIC_BYTES - sizeof(uint32_t),
    (CASE4_STATIC_BYTES + CASE4_RESERVED_START_BYTES) / 2,
    CASE4_RESERVED_START_BYTES + CASE4_VF_STACK_BYTES / 2,
    CASE4_RESERVED_START_BYTES + CASE4_VF_STACK_BYTES + CASE4_ASC_RESERVED_BYTES / 2,
    UB_TOTAL_BYTES - CASE4_DCACHE_BYTES,
};
constexpr uint32_t CASE4_ACCESS_OFFSET_BYTES = CASE4_ACCESS_OFFSETS[CASE4_ACCESS_REGION];
static_assert(CASE4_ACCESS_REGION >= 0 && CASE4_ACCESS_REGION <= 4, "Case 4 access region must be in [0, 4]");
#endif

#if SCENARIO_NUM == 1
constexpr uint32_t BOUNDARY_STATIC_BYTES = UB_BOUNDARY_STATIC_BYTES;
constexpr uint32_t BOUNDARY_STATIC_WORDS = BOUNDARY_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t BOUNDARY_MARKER = 0xC0FFEE00;
static_assert(BOUNDARY_STATIC_BYTES % sizeof(uint32_t) == 0, "UB boundary size must be a multiple of 4 bytes");
#endif

#if SCENARIO_NUM == 2
constexpr uint32_t CASE2_CONFIGURED_UB_BYTES = CASE2_UB_BYTES;
constexpr uint32_t CASE2_UB_WORDS = CASE2_CONFIGURED_UB_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE2_VF_STACK_RESERVED_BYTES =
#if defined(CASE2_DISABLE_VF_STACK_RESERVED)
    0;
#else
    6 * 1024;
#endif
constexpr uint32_t CASE2_ASC_RESERVED_BYTES =
#if defined(CASE2_DISABLE_ASC_RESERVED)
    0;
#else
    2 * 1024;
#endif
constexpr uint32_t CASE2_UB_ARRAY_LIMIT_BYTES =
    UB_TOTAL_BYTES - CASE2_VF_STACK_RESERVED_BYTES - CASE2_ASC_RESERVED_BYTES - MIN_SIMT_DATA_CACHE_BYTES -
    RESULT_BYTES_PER_CASE;
constexpr uint32_t CASE2_USABLE_UB_BYTES = CASE2_UB_ARRAY_LIMIT_BYTES + RESULT_BYTES_PER_CASE;
static_assert(CASE2_CONFIGURED_UB_BYTES % sizeof(uint32_t) == 0, "Case 2 UB size must be a multiple of 4 bytes");
static_assert(CASE2_UB_WORDS > 0, "Case 2 UB size must be greater than zero");
#endif

#if SCENARIO_NUM == 3
constexpr uint32_t CASE3_CONFIGURED_DYNAMIC_BYTES = CASE3_DYNAMIC_BYTES;
constexpr uint32_t MIXED_DYNAMIC_WORDS = CASE3_CONFIGURED_DYNAMIC_BYTES / sizeof(uint32_t);
constexpr uint32_t MIXED_STATIC_BYTES =
    (MIXED_MAIN_STATIC_WORDS + MIXED_SIMD_STATIC_WORDS + MIXED_SIMT_STATIC_WORDS) * sizeof(uint32_t) +
    MIXED_MAIN_STATIC_BYTES;
constexpr uint32_t CASE3_MAX_DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - MIXED_STATIC_BYTES;
constexpr uint32_t MIXED_USER_UB_BYTES = MIXED_STATIC_BYTES + CASE3_CONFIGURED_DYNAMIC_BYTES;
static_assert(
    CASE3_CONFIGURED_DYNAMIC_BYTES % sizeof(uint32_t) == 0, "Case 3 dynamic UB size must be a multiple of 4 bytes");
static_assert(MIXED_DYNAMIC_WORDS > 0, "Case 3 dynamic UB size must be greater than zero");
#endif
} // namespace

__aicore__ inline void WaitVectorToScalar()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    }
}

__aicore__ inline void WaitScalarToVector()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    }
}

__aicore__ inline void CopyResultToGm(__gm__ uint32_t* output, __ubuf__ uint32_t* result)
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }
    asc_copy_ub2gm_align(output, result, 1, RESULT_BYTES_PER_CASE, 0, 0, 0);
}

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase0AddOne(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t word_count)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        output[index] = input[index] + 1;
    }
}

// Case 0: an invalid static UB access reaches the SIMT Data Cache and corrupts cached GM data.
__global__ __vector__ void Case0StaticUbOobKernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t faulty_index)
{
    __ubuf__ uint32_t static_ub[CASE0_STATIC_WORDS];

    // Populate the SIMT Data Cache before reproducing the invalid UB write.
    asc_vf_call<SimtCase0AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    WaitVectorToScalar();

    __ubuf__ volatile uint32_t* static_data = static_ub;
#if defined(CASE0_ENABLE_FIX)
    if (faulty_index < CASE0_STATIC_WORDS) {
        static_data[faulty_index] = CORRUPTED_VALUE;
    }
#else
    // The invalid index skips the 8 KB reserved region and reaches the first Data Cache word.
    static_data[faulty_index] = CORRUPTED_VALUE;
#endif
    WaitScalarToVector();

    // Read the same GM data again to expose any Data Cache precision corruption.
    asc_vf_call<SimtCase0AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
}
#endif

#if SCENARIO_NUM == 1
__simd_vf__ inline void SimdFillBoundaryUb(__ubuf__ uint32_t* static_ub, uint32_t word_count)
{
    for (uint32_t index = 0; index < word_count; ++index) {
        static_ub[index] = BOUNDARY_MARKER + index;
    }
}

// Case 1 measures the usable UB limit under different SIMD VF configurations.
__global__ __vector__ void Case1StaticUbLimitKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[BOUNDARY_STATIC_WORDS];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

#if defined(UB_BOUNDARY_NO_SIMD_VF)
    for (uint32_t index = 0; index < BOUNDARY_STATIC_WORDS; ++index) {
        static_ub[index] = BOUNDARY_MARKER + index;
    }
#else
    asc_vf_call<SimdFillBoundaryUb>(static_ub, BOUNDARY_STATIC_WORDS);
    WaitVectorToScalar();
#endif

    result[0] = BOUNDARY_MARKER;
    result[1] = BOUNDARY_STATIC_BYTES;
    result[2] = static_ub[0];
    result[3] = static_ub[BOUNDARY_STATIC_WORDS - 1];
    result[4] = BOUNDARY_MARKER;
    result[5] = BOUNDARY_MARKER + BOUNDARY_STATIC_WORDS - 1;
    result[6] = 0;
    result[7] = 0;
    CopyResultToGm(output, result);
}
#endif

#if SCENARIO_NUM == 2
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtFillCase2Ub(
    __ubuf__ uint32_t* ub, uint32_t word_count, uint32_t marker)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        ub[index] = marker + index;
    }
}

// Case 2 measures the usable UB limit with a SIMT VF using either static or dynamic UB.
__global__ __vector__ void SimtUbLimitKernel(__gm__ uint32_t* output)
{
#if defined(CASE2_USE_STATIC_UB)
    __ubuf__ uint32_t case2_ub[CASE2_UB_WORDS];
#else
    extern __ubuf__ uint32_t simt_dynamic_ub[];
    __ubuf__ uint32_t* case2_ub = simt_dynamic_ub;
#endif
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtFillCase2Ub>(dim3(THREAD_COUNT), case2_ub, CASE2_UB_WORDS, CASE2_MARKER);
    WaitVectorToScalar();

    result[0] = CASE2_MARKER;
    result[1] = CASE2_CONFIGURED_UB_BYTES;
    result[2] = CASE2_UB_ARRAY_LIMIT_BYTES;
    result[3] = case2_ub[0];
    result[4] = case2_ub[CASE2_UB_WORDS - 1];
    result[5] = CASE2_MARKER;
    result[6] = CASE2_MARKER + CASE2_UB_WORDS - 1;
    result[7] = CASE2_USABLE_UB_BYTES;
    CopyResultToGm(output, result);
}
#endif

#if SCENARIO_NUM == 3
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase3Ub(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simt_static_ub[MIXED_SIMT_STATIC_WORDS];
    extern __ubuf__ uint32_t simt_dynamic_ub[];
    for (uint32_t index = threadIdx.x; index < MIXED_SIMT_STATIC_WORDS; index += blockDim.x) {
        simt_static_ub[index] = marker + index;
    }
    if (threadIdx.x == 0) {
        result[1] = simt_dynamic_ub[0];
        result[2] = simt_dynamic_ub[MIXED_DYNAMIC_WORDS - 1];
        result[3] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simt_dynamic_ub));
        simt_dynamic_ub[0] = marker + 3;
    }
    if (threadIdx.x == MIXED_SIMT_STATIC_WORDS - 1) {
        result[0] = simt_static_ub[MIXED_SIMT_STATIC_WORDS - 1];
    }
}

__simd_vf__ inline void SimdCase3Ub(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simd_static_ub[MIXED_SIMD_STATIC_WORDS];
    extern __ubuf__ uint32_t simd_dynamic_ub[];
    for (uint32_t index = 0; index < MIXED_SIMD_STATIC_WORDS; ++index) {
        simd_static_ub[index] = marker + index;
    }
    result[0] = simd_static_ub[MIXED_SIMD_STATIC_WORDS - 1];
    result[1] = simd_dynamic_ub[0];
    result[2] = simd_dynamic_ub[MIXED_DYNAMIC_WORDS - 1];
    result[3] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simd_dynamic_ub));
    simd_dynamic_ub[0] = marker + 2;
}

// Case 3: MainScalar, SIMD VF, and SIMT VF static UB share the same pool with dynamic UB.
__global__ __vector__ void MixedUbKernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t main_dynamic_ub[];
    __ubuf__ uint32_t main_static_ub[MIXED_MAIN_STATIC_WORDS];
    __ubuf__ uint32_t simt_result[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t simd_result[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    for (uint32_t index = 0; index < MIXED_MAIN_STATIC_WORDS; ++index) {
        main_static_ub[index] = CASE3_MARKER + index;
    }
    main_dynamic_ub[0] = CASE3_MARKER + 1;
    main_dynamic_ub[MIXED_DYNAMIC_WORDS - 1] = CASE3_MARKER + MIXED_DYNAMIC_WORDS;
    WaitScalarToVector();
    asc_vf_call<SimdCase3Ub>(simd_result, CASE3_MARKER);
    WaitVectorToScalar();
    asc_vf_call<SimtCase3Ub>(dim3(THREAD_COUNT), simt_result, CASE3_MARKER);
    WaitVectorToScalar();

    result[0] = CASE3_MARKER;
    result[1] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(main_dynamic_ub));
    result[2] = simd_result[3];
    result[3] = simt_result[3];
    result[4] = MIXED_STATIC_BYTES;
    result[5] = MIXED_DYNAMIC_WORDS * sizeof(uint32_t);
    result[6] = MIXED_USER_UB_BYTES;
    result[7] = ((result[1] == result[2]) && (result[1] == result[3]) &&
                 (simd_result[1] == CASE3_MARKER + 1) && (simt_result[1] == CASE3_MARKER + 2) &&
                 (main_dynamic_ub[0] == CASE3_MARKER + 3) &&
                 (main_static_ub[MIXED_MAIN_STATIC_WORDS - 1] == CASE3_MARKER + MIXED_MAIN_STATIC_WORDS - 1) &&
                 (main_dynamic_ub[MIXED_DYNAMIC_WORDS - 1] == CASE3_MARKER + MIXED_DYNAMIC_WORDS) &&
                 (simd_result[2] == CASE3_MARKER + MIXED_DYNAMIC_WORDS) &&
                 (simt_result[2] == CASE3_MARKER + MIXED_DYNAMIC_WORDS) &&
                 (simd_result[0] == CASE3_MARKER + MIXED_SIMD_STATIC_WORDS - 1) &&
                 (simt_result[0] == CASE3_MARKER + MIXED_SIMT_STATIC_WORDS - 1)) ?
                    1 :
                    0;
    CopyResultToGm(output, result);
}
#endif

#if SCENARIO_NUM == 4
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase4AddOne(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t word_count)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        output[index] = input[index] + 1;
    }
}

// Case 4 observes writes that cross a small static UB allocation into each following UB region.
__global__ __vector__ void Case4StaticUbOobKernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t access_index)
{
    __ubuf__ uint32_t static_ub[CASE4_STATIC_WORDS];

    asc_vf_call<SimtCase4AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    WaitVectorToScalar();

    __ubuf__ volatile uint32_t* static_data = static_ub;
    static_data[access_index] = CORRUPTED_VALUE;
    WaitScalarToVector();

    asc_vf_call<SimtCase4AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
}
#endif

void LaunchSelectedCase(aclrtStream stream, uint32_t* output_device, const uint32_t* input_device)
{
#if SCENARIO_NUM == 0
#if defined(CASE0_ENABLE_FIX)
    constexpr const char* mode = "fixed";
#else
    constexpr const char* mode = "fault";
#endif
    std::cout << "[Case0] mode=" << mode << ", static_bytes=" << CASE0_STATIC_BYTES << ", dynamic_bytes=0"
              << ", reserved_bytes=" << RESERVED_UB_BYTES << ", dcache_bytes=" << CASE0_DCACHE_BYTES
              << ", faulty_byte_offset=" << CASE0_DCACHE_START_WORD * sizeof(uint32_t) << std::endl;
    Case0StaticUbOobKernel<<<1, 0, stream>>>(input_device, output_device, CASE0_DCACHE_START_WORD);
#elif SCENARIO_NUM == 1
#if defined(UB_BOUNDARY_NO_SIMD_VF)
    constexpr const char* mode = "without SIMD VF";
#else
    constexpr const char* mode = "with SIMD VF";
#endif
    std::cout << "[Case1] mode=" << mode << ", static_bytes=" << BOUNDARY_STATIC_BYTES << std::endl;
    Case1StaticUbLimitKernel<<<1, 0, stream>>>(output_device);
#elif SCENARIO_NUM == 2
#if defined(CASE2_USE_STATIC_UB)
    constexpr const char* ub_type = "static";
    constexpr uint32_t dynamic_ub_bytes = 0;
#else
    constexpr const char* ub_type = "dynamic";
    constexpr uint32_t dynamic_ub_bytes = CASE2_CONFIGURED_UB_BYTES;
#endif
    std::cout << "[Case2] ub_type=" << ub_type << ", ub_array_limit_bytes=" << CASE2_UB_ARRAY_LIMIT_BYTES
              << ", configured_ub_bytes=" << CASE2_CONFIGURED_UB_BYTES << std::endl;
    SimtUbLimitKernel<<<1, dynamic_ub_bytes, stream>>>(output_device);
#elif SCENARIO_NUM == 3
    std::cout << "[Case3] static_total_bytes=" << MIXED_STATIC_BYTES
              << ", max_dynamic_bytes=" << CASE3_MAX_DYNAMIC_BYTES
              << ", configured_dynamic_bytes=" << CASE3_CONFIGURED_DYNAMIC_BYTES << std::endl;
    MixedUbKernel<<<1, CASE3_CONFIGURED_DYNAMIC_BYTES, stream>>>(output_device);
#elif SCENARIO_NUM == 4
    constexpr const char* region_names[] = {
        "static_ub", "unallocated_ub", "vf_stack_6kb", "asc_reserved_2kb", "data_cache"};
    std::cout << "[Case4] region=" << region_names[CASE4_ACCESS_REGION]
              << ", static_bytes=" << CASE4_STATIC_BYTES << ", dynamic_bytes=0"
              << ", access_offset_bytes=" << CASE4_ACCESS_OFFSET_BYTES << std::endl;
    Case4StaticUbOobKernel<<<1, 0, stream>>>(
        input_device, output_device, CASE4_ACCESS_OFFSET_BYTES / sizeof(uint32_t));
#endif
}

bool VerifySelectedCase(const uint32_t* result, aclError launch_ret, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
#if SCENARIO_NUM == 0
        uint32_t mismatch_count = 0;
        uint32_t first_mismatch_index = BUFFER_WORDS;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t expected = CASE0_MARKER + index + 1;
            if (result[index] != expected) {
                if (first_mismatch_index == BUFFER_WORDS) {
                    first_mismatch_index = index;
                }
                ++mismatch_count;
            }
        }
#if defined(CASE0_ENABLE_FIX)
        passed = mismatch_count == 0;
#else
        passed = mismatch_count > 0;
#endif
        std::cout << "[Case0] mismatch_count=" << mismatch_count << std::endl;
        if (first_mismatch_index < BUFFER_WORDS) {
            std::cout << "[Case0] first_mismatch_index=" << first_mismatch_index << ", expected=0x" << std::hex
                      << CASE0_MARKER + first_mismatch_index + 1 << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
#elif SCENARIO_NUM == 1
        passed = result[0] == BOUNDARY_MARKER && result[2] == result[4] && result[3] == result[5];
        std::cout << "[Case1] first=0x" << std::hex << result[2] << ", last=0x" << result[3] << std::dec << std::endl;
#elif SCENARIO_NUM == 2
        passed = result[0] == CASE2_MARKER && result[1] == CASE2_CONFIGURED_UB_BYTES &&
                 result[2] == CASE2_UB_ARRAY_LIMIT_BYTES && result[3] == result[5] && result[4] == result[6] &&
                 result[7] == CASE2_USABLE_UB_BYTES;
#elif SCENARIO_NUM == 3
        passed = result[0] == CASE3_MARKER && result[1] == result[2] && result[1] == result[3] &&
                 result[4] == MIXED_STATIC_BYTES &&
                 result[5] == MIXED_DYNAMIC_WORDS * sizeof(uint32_t) && result[6] == MIXED_USER_UB_BYTES &&
                 result[7] == 1;
        std::cout << "[Case3] main_dynamic_ub=0x" << std::hex << result[1]
                  << ", simd_dynamic_ub=0x" << result[2] << ", simt_dynamic_ub=0x" << result[3] << std::dec
                  << std::endl;
        std::cout << "Case 3 usage: static_total_bytes=" << result[4] << ", dynamic_bytes=" << result[5]
                  << ", same_start_address="
                  << ((result[1] == result[2] && result[1] == result[3]) ? "YES" : "NO")
                  << std::endl;
#elif SCENARIO_NUM == 4
        uint32_t mismatch_count = 0;
        uint32_t first_mismatch_index = BUFFER_WORDS;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t expected = CASE4_MARKER + index + 1;
            if (result[index] != expected) {
                if (first_mismatch_index == BUFFER_WORDS) {
                    first_mismatch_index = index;
                }
                ++mismatch_count;
            }
        }
        passed = sync_ret == ACL_SUCCESS;
        std::cout << "[Case4] mismatch_count=" << mismatch_count << std::endl;
        if (first_mismatch_index < BUFFER_WORDS) {
            std::cout << "[Case4] first_mismatch_index=" << first_mismatch_index << ", expected=0x" << std::hex
                      << CASE4_MARKER + first_mismatch_index + 1 << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
        std::cout << "[Case4] precision_check=" << (mismatch_count == 0 ? "PASSED" : "FAILED") << std::endl;
#endif
    }

#if SCENARIO_NUM == 0
#if defined(CASE0_ENABLE_FIX)
    std::cout << "[Case0] precision_check=" << (passed ? "PASSED (out-of-bounds write blocked)" : "FAILED")
              << std::endl;
#else
    std::cout << "[Case0] precision_check=" << (passed ? "FAILED (fault reproduced)" : "UNEXPECTED") << std::endl;
#endif
#elif SCENARIO_NUM == 1
    std::cout << "[Case1] launch_ret=" << static_cast<int32_t>(launch_ret)
              << ", sync_ret=" << static_cast<int32_t>(sync_ret) << ", result=" << (passed ? "PASSED" : "FAILED")
              << std::endl;
#elif SCENARIO_NUM == 2
    std::cout << "Case 2 (SIMT VF usable UB): " << (passed ? "PASSED" : "FAILED") << std::endl;
#elif SCENARIO_NUM == 3
    std::cout << "Case 3 (mixed UB): " << (passed ? "PASSED" : "FAILED") << std::endl;
#elif SCENARIO_NUM == 4
    std::cout << "[Case4] launch_ret=" << static_cast<int32_t>(launch_ret)
              << ", sync_ret=" << static_cast<int32_t>(sync_ret) << ", observation="
              << (passed ? "COMPLETED" : "RUNTIME_ERROR") << std::endl;
#endif
    return passed;
}

int32_t RunSelectedCase()
{
#if SCENARIO_NUM == 0 || SCENARIO_NUM == 4
    constexpr size_t output_bytes = BUFFER_BYTES;
#else
    constexpr size_t output_bytes = RESULT_BYTES_PER_CASE;
#endif
    uint8_t* output_host = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t* input_device = nullptr;
#if SCENARIO_NUM == 0 || SCENARIO_NUM == 4
    std::vector<uint32_t> input(BUFFER_WORDS);
    for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
#if SCENARIO_NUM == 0
        input[index] = CASE0_MARKER + index;
#else
        input[index] = CASE4_MARKER + index;
#endif
    }
    aclrtMalloc(reinterpret_cast<void**>(&input_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, BUFFER_BYTES, input.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
#endif

    LaunchSelectedCase(stream, output_device, input_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = VerifySelectedCase(reinterpret_cast<uint32_t*>(output_host), launch_ret, sync_ret);

    aclrtFree(output_device);
#if SCENARIO_NUM == 0 || SCENARIO_NUM == 4
    aclrtFree(input_device);
#endif
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main() { return RunSelectedCase(); }
