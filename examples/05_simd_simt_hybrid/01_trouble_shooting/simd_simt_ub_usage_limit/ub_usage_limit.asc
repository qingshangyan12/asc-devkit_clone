/* !
 * \file ub_usage_limit.asc
 * \brief Demonstrates UB out-of-bounds analysis and correct UB usage in SIMD and SIMT hybrid programming.
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 3
#error "SCENARIO_NUM must be one of 0, 1, 2, 3."
#endif

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DATA_CACHE_BYTES = 32 * 1024;
constexpr uint32_t USER_UB_BYTES_WITH_SIMT = UB_TOTAL_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DATA_CACHE_BYTES;

constexpr uint32_t RESULT_WORDS_PER_CASE = 8;
constexpr uint32_t RESULT_BYTES_PER_CASE = RESULT_WORDS_PER_CASE * sizeof(uint32_t);

constexpr uint32_t BUFFER_WORDS = THREAD_COUNT;
constexpr uint32_t BUFFER_BYTES = BUFFER_WORDS * sizeof(uint32_t);
constexpr uint32_t CASE0_STATIC_BYTES = 216 * 1024;
constexpr uint32_t CASE0_STATIC_WORDS = CASE0_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE0_DCACHE_BYTES = 32 * 1024;
constexpr uint32_t CASE0_DCACHE_START_WORD = (CASE0_STATIC_BYTES + RESERVED_UB_BYTES) / sizeof(uint32_t);

constexpr uint32_t MIXED_MAIN_STATIC_WORDS = 256;
constexpr uint32_t MIXED_SIMD_STATIC_WORDS = 512;
constexpr uint32_t MIXED_SIMT_STATIC_WORDS = THREAD_COUNT;

constexpr uint32_t CASE0_MARKER = 0xC0000000;
constexpr uint32_t CORRUPTED_VALUE = 0xDEADBEEF;

#if SCENARIO_NUM == 3
constexpr uint32_t CASE3_STATIC_BYTES = 4 * 1024;
constexpr uint32_t CASE3_STATIC_WORDS = CASE3_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE3_VF_RESERVED_BYTES = 6 * 1024;
constexpr uint32_t CASE3_ASC_RESERVED_BYTES = 2 * 1024;
constexpr uint32_t CASE3_DCACHE_BYTES = 128 * 1024;
constexpr uint32_t CASE3_RESERVED_START_BYTES =
    UB_TOTAL_BYTES - CASE3_DCACHE_BYTES - CASE3_VF_RESERVED_BYTES - CASE3_ASC_RESERVED_BYTES;
constexpr uint32_t CASE3_MARKER = 0xC0030000;
constexpr uint32_t CASE3_ACCESS_OFFSETS[] = {
    CASE3_STATIC_BYTES - sizeof(uint32_t),
    (CASE3_STATIC_BYTES + CASE3_RESERVED_START_BYTES) / 2,
    CASE3_RESERVED_START_BYTES + CASE3_VF_RESERVED_BYTES / 2,
    CASE3_RESERVED_START_BYTES + CASE3_VF_RESERVED_BYTES + CASE3_ASC_RESERVED_BYTES / 2,
    UB_TOTAL_BYTES - CASE3_DCACHE_BYTES,
};
constexpr uint32_t CASE3_ACCESS_OFFSET_BYTES = CASE3_ACCESS_OFFSETS[CASE3_ACCESS_REGION];
static_assert(CASE3_ACCESS_REGION >= 0 && CASE3_ACCESS_REGION <= 4, "Case 3 access region must be in [0, 4]");
#endif

#if SCENARIO_NUM == 1 && !defined(UB_LIMIT_WITH_SIMT_VF)
constexpr uint32_t UB_LIMIT_CONFIGURED_BYTES = UB_LIMIT_BYTES;
constexpr uint32_t UB_LIMIT_WORDS = UB_LIMIT_CONFIGURED_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE1_MARKER = 0xC0010000;
static_assert(UB_LIMIT_CONFIGURED_BYTES % sizeof(uint32_t) == 0, "UB limit size must be a multiple of 4 bytes");
#endif

#if SCENARIO_NUM == 1 && defined(UB_LIMIT_WITH_SIMT_VF)
constexpr uint32_t CASE1_MARKER = 0xC0010000;
constexpr uint32_t UB_LIMIT_CONFIGURED_BYTES = UB_LIMIT_BYTES;
constexpr uint32_t UB_LIMIT_WORDS = UB_LIMIT_CONFIGURED_BYTES / sizeof(uint32_t);
constexpr uint32_t UB_LIMIT_VF_RESERVED_BYTES =
#if defined(UB_LIMIT_DISABLE_VF_RESERVED)
    0;
#else
    6 * 1024;
#endif
constexpr uint32_t UB_LIMIT_ASC_RESERVED_BYTES =
#if defined(UB_LIMIT_DISABLE_ASC_RESERVED)
    0;
#else
    2 * 1024;
#endif
constexpr uint32_t UB_LIMIT_ARRAY_LIMIT_BYTES =
    UB_TOTAL_BYTES - UB_LIMIT_VF_RESERVED_BYTES - UB_LIMIT_ASC_RESERVED_BYTES - MIN_SIMT_DATA_CACHE_BYTES;
static_assert(UB_LIMIT_CONFIGURED_BYTES % sizeof(uint32_t) == 0, "Case 1 UB size must be a multiple of 4 bytes");
static_assert(UB_LIMIT_WORDS > 0, "Case 1 UB size must be greater than zero");
#endif

#if SCENARIO_NUM == 2
constexpr uint32_t CASE2_MARKER = 0xC0020000;
constexpr uint32_t MIXED_STATIC_BYTES =
    (MIXED_MAIN_STATIC_WORDS + MIXED_SIMD_STATIC_WORDS + MIXED_SIMT_STATIC_WORDS) * sizeof(uint32_t);
constexpr uint32_t CASE2_DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - MIXED_STATIC_BYTES;
constexpr uint32_t CASE2_DYNAMIC_WORDS = CASE2_DYNAMIC_BYTES / sizeof(uint32_t);
#endif
}

__aicore__ inline void WaitVectorToScalar()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    }
}

__aicore__ inline void WaitScalarToVector()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    }
}

__aicore__ inline void CopyResultToGm(__gm__ uint32_t* output, __ubuf__ uint32_t* result)
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }
    asc_copy_ub2gm_align(output, result, 1, RESULT_BYTES_PER_CASE, 0, 0, 0);
}

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase0AddOne(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t word_count)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        output[index] = input[index] + 1;
    }
}

// Case 0: an invalid static UB access reaches the SIMT Data Cache and corrupts cached GM data.
__global__ __vector__ void Case0StaticUbOobKernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t faulty_index)
{
    __ubuf__ uint32_t static_ub[CASE0_STATIC_WORDS];

    // Populate the SIMT Data Cache before reproducing the invalid UB write.
    asc_vf_call<SimtCase0AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    WaitVectorToScalar();

    __ubuf__ volatile uint32_t* static_data = static_ub;
#if defined(CASE0_ENABLE_FIX)
    if (faulty_index < CASE0_STATIC_WORDS) {
        static_data[faulty_index] = CORRUPTED_VALUE;
    }
#else
    // The invalid index skips the 8 KB reserved region and reaches the first Data Cache word.
    static_data[faulty_index] = CORRUPTED_VALUE;
#endif
    WaitScalarToVector();

    // Read the same GM data again to expose any Data Cache precision corruption.
    asc_vf_call<SimtCase0AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
}
#endif

#if SCENARIO_NUM == 1 && !defined(UB_LIMIT_WITH_SIMT_VF)
__simd_vf__ inline void SimdFillUbLimit(__ubuf__ uint32_t* ub_buffer, uint32_t word_count)
{
    for (uint32_t index = 0; index < word_count; ++index) {
        ub_buffer[index] = CASE1_MARKER + index;
    }
}

// Case 1 measures the usable UB limit under different SIMD VF configurations.
__global__ __vector__ void Case1UbLimitKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t ub_buffer[UB_LIMIT_WORDS];

#if defined(UB_LIMIT_NO_SIMD_VF)
    for (uint32_t index = 0; index < UB_LIMIT_WORDS; ++index) {
        ub_buffer[index] = CASE1_MARKER + index;
    }
#else
    asc_vf_call<SimdFillUbLimit>(ub_buffer, UB_LIMIT_WORDS);
    WaitVectorToScalar();
#endif

    output[0] = ub_buffer[0];
    output[1] = ub_buffer[UB_LIMIT_WORDS - 1];
}
#endif

#if SCENARIO_NUM == 1 && defined(UB_LIMIT_WITH_SIMT_VF)
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtFillUbLimit(
    __ubuf__ uint32_t* ub, uint32_t word_count, uint32_t marker)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        ub[index] = marker + index;
    }
}

// Case 1 measures the usable UB limit with a SIMT VF.
__global__ __vector__ void SimtUbLimitKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t ub_buffer[UB_LIMIT_WORDS];

    asc_vf_call<SimtFillUbLimit>(dim3(THREAD_COUNT), ub_buffer, UB_LIMIT_WORDS, CASE1_MARKER);
    WaitVectorToScalar();

    output[0] = ub_buffer[0];
    output[1] = ub_buffer[UB_LIMIT_WORDS - 1];
}
#endif

#if SCENARIO_NUM == 2
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase2Ub(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simt_static_ub[MIXED_SIMT_STATIC_WORDS];
    extern __ubuf__ uint32_t simt_dynamic_ub[];
    for (uint32_t index = threadIdx.x; index < MIXED_SIMT_STATIC_WORDS; index += blockDim.x) {
        simt_static_ub[index] = marker + index;
    }
    if (threadIdx.x == 0) {
        simt_dynamic_ub[CASE2_DYNAMIC_WORDS - 1] = marker;
        result[6] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simt_dynamic_ub));
    }
    if (threadIdx.x == MIXED_SIMT_STATIC_WORDS - 1) {
        result[7] = simt_static_ub[MIXED_SIMT_STATIC_WORDS - 1];
    }
}

__simd_vf__ inline void SimdCase2Ub(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simd_static_ub[MIXED_SIMD_STATIC_WORDS];
    extern __ubuf__ uint32_t simd_dynamic_ub[];
    for (uint32_t index = 0; index < MIXED_SIMD_STATIC_WORDS; ++index) {
        simd_static_ub[index] = marker + index;
    }
    simd_dynamic_ub[CASE2_DYNAMIC_WORDS - 1] = marker;
    result[4] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simd_dynamic_ub));
    result[5] = simd_static_ub[MIXED_SIMD_STATIC_WORDS - 1];
}

// Case 2: MainScalar, SIMD VF, and SIMT VF static UB share the same pool with dynamic UB.
__global__ __vector__ void MixedUbKernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t main_dynamic_ub[];
    __ubuf__ uint32_t main_static_ub[MIXED_MAIN_STATIC_WORDS];

    for (uint32_t index = 0; index < MIXED_MAIN_STATIC_WORDS; ++index) {
        main_static_ub[index] = CASE2_MARKER + index;
    }
    main_dynamic_ub[CASE2_DYNAMIC_WORDS - 1] = CASE2_MARKER;
    WaitScalarToVector();
    asc_vf_call<SimdCase2Ub>(main_static_ub, CASE2_MARKER);
    WaitVectorToScalar();
    asc_vf_call<SimtCase2Ub>(dim3(THREAD_COUNT), main_static_ub, CASE2_MARKER);
    WaitVectorToScalar();

    main_static_ub[0] = CASE2_MARKER;
    main_static_ub[1] = MIXED_STATIC_BYTES;
    main_static_ub[2] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(main_dynamic_ub));
    main_static_ub[3] = main_static_ub[MIXED_MAIN_STATIC_WORDS - 1];
    CopyResultToGm(output, main_static_ub);
}
#endif

#if SCENARIO_NUM == 3
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase3AddOne(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t word_count)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        output[index] = input[index] + 1;
    }
}

// Case 3 observes writes that cross a static UB array into each following UB region.
__global__ __vector__ void Case3StaticUbOobKernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t access_index)
{
    __ubuf__ uint32_t static_ub[CASE3_STATIC_WORDS];

    asc_vf_call<SimtCase3AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    WaitVectorToScalar();

    __ubuf__ volatile uint32_t* static_data = static_ub;
    static_data[access_index] = CORRUPTED_VALUE;
    WaitScalarToVector();

    asc_vf_call<SimtCase3AddOne>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
}
#endif

void LaunchSelectedCase(aclrtStream stream, uint32_t* output_device, const uint32_t* input_device)
{
#if SCENARIO_NUM == 0
#if defined(CASE0_ENABLE_FIX)
    constexpr const char* mode = "fixed";
#else
    constexpr const char* mode = "fault";
#endif
    std::cout << "[Case0] mode=" << mode << ", static_bytes=" << CASE0_STATIC_BYTES << ", dynamic_bytes=0"
              << ", reserved_bytes=" << RESERVED_UB_BYTES << ", dcache_bytes=" << CASE0_DCACHE_BYTES
              << ", faulty_byte_offset=" << CASE0_DCACHE_START_WORD * sizeof(uint32_t) << std::endl;
    Case0StaticUbOobKernel<<<1, 0, stream>>>(input_device, output_device, CASE0_DCACHE_START_WORD);
#elif SCENARIO_NUM == 1
#if defined(UB_LIMIT_WITH_SIMT_VF)
    std::cout << "[Case1] mode=with SIMT VF, ub_limit_bytes=" << UB_LIMIT_ARRAY_LIMIT_BYTES
              << ", configured_ub_bytes=" << UB_LIMIT_CONFIGURED_BYTES << std::endl;
    SimtUbLimitKernel<<<1, 0, stream>>>(output_device);
#else
#if defined(UB_LIMIT_NO_SIMD_VF)
    constexpr const char* mode = "without SIMD VF";
#else
    constexpr const char* mode = "with SIMD VF";
#endif
    std::cout << "[Case1] mode=" << mode << ", ub_limit_bytes=" << UB_LIMIT_CONFIGURED_BYTES << std::endl;
    Case1UbLimitKernel<<<1, 0, stream>>>(output_device);
#endif
#elif SCENARIO_NUM == 2
    std::cout << "[Case2] static_total_bytes=" << MIXED_STATIC_BYTES << std::endl;
    MixedUbKernel<<<1, CASE2_DYNAMIC_BYTES, stream>>>(output_device);
#elif SCENARIO_NUM == 3
    constexpr const char* region_names[] = {
        "static_ub", "unallocated_ub", "vf_reserved_6kb", "asc_reserved_2kb", "data_cache"};
    std::cout << "[Case3] region=" << region_names[CASE3_ACCESS_REGION]
              << ", static_bytes=" << CASE3_STATIC_BYTES << ", dynamic_bytes=0"
              << ", access_offset_bytes=" << CASE3_ACCESS_OFFSET_BYTES << std::endl;
    Case3StaticUbOobKernel<<<1, 0, stream>>>(
        input_device, output_device, CASE3_ACCESS_OFFSET_BYTES / sizeof(uint32_t));
#endif
}

bool VerifySelectedCase(const uint32_t* result, aclError launch_ret, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
#if SCENARIO_NUM == 0
        uint32_t mismatch_count = 0;
        uint32_t first_mismatch_index = BUFFER_WORDS;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t expected = CASE0_MARKER + index + 1;
            if (result[index] != expected) {
                if (first_mismatch_index == BUFFER_WORDS) {
                    first_mismatch_index = index;
                }
                ++mismatch_count;
            }
        }
#if defined(CASE0_ENABLE_FIX)
        passed = mismatch_count == 0;
#else
        passed = mismatch_count > 0;
#endif
        std::cout << "[Case0] mismatch_count=" << mismatch_count << std::endl;
        if (first_mismatch_index < BUFFER_WORDS) {
            std::cout << "[Case0] first_mismatch_index=" << first_mismatch_index << ", expected=0x" << std::hex
                      << CASE0_MARKER + first_mismatch_index + 1 << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
#elif SCENARIO_NUM == 1
#if defined(UB_LIMIT_WITH_SIMT_VF)
        passed = result[0] == CASE1_MARKER && result[1] == CASE1_MARKER + UB_LIMIT_WORDS - 1;
#else
        passed = result[0] == CASE1_MARKER && result[1] == CASE1_MARKER + UB_LIMIT_WORDS - 1;
#endif
        std::cout << "[Case1] first=0x" << std::hex << result[0] << ", last=0x" << result[1] << std::dec << std::endl;
#elif SCENARIO_NUM == 2
        const uint32_t static_bytes = result[1];
        const uint32_t main_dynamic_addr = result[2];
        const uint32_t simd_dynamic_addr = result[4];
        const uint32_t simt_dynamic_addr = result[6];
        const bool same_dynamic_addr =
            main_dynamic_addr == simd_dynamic_addr && main_dynamic_addr == simt_dynamic_addr;
        passed = result[0] == CASE2_MARKER && same_dynamic_addr && main_dynamic_addr == MIXED_STATIC_BYTES &&
                 static_bytes == MIXED_STATIC_BYTES;
        std::cout << "[Case2] main_dynamic_ub=0x" << std::hex << main_dynamic_addr
                  << ", simd_dynamic_ub=0x" << simd_dynamic_addr << ", simt_dynamic_ub=0x" << simt_dynamic_addr
                  << std::dec << std::endl;
        std::cout << "Case 2 layout: static_total_bytes=" << static_bytes
                  << ", same_start_address=" << (same_dynamic_addr ? "YES" : "NO")
                  << std::endl;
#elif SCENARIO_NUM == 3
        uint32_t mismatch_count = 0;
        uint32_t first_mismatch_index = BUFFER_WORDS;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t expected = CASE3_MARKER + index + 1;
            if (result[index] != expected) {
                if (first_mismatch_index == BUFFER_WORDS) {
                    first_mismatch_index = index;
                }
                ++mismatch_count;
            }
        }
        passed = sync_ret == ACL_SUCCESS;
        std::cout << "[Case3] mismatch_count=" << mismatch_count << std::endl;
        if (first_mismatch_index < BUFFER_WORDS) {
            std::cout << "[Case3] first_mismatch_index=" << first_mismatch_index << ", expected=0x" << std::hex
                      << CASE3_MARKER + first_mismatch_index + 1 << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
        std::cout << "[Case3] precision_check=" << (mismatch_count == 0 ? "PASSED" : "FAILED") << std::endl;
#endif
    }

#if SCENARIO_NUM == 0
#if defined(CASE0_ENABLE_FIX)
    std::cout << "[Case0] precision_check=" << (passed ? "PASSED (out-of-bounds write blocked)" : "FAILED")
              << std::endl;
#else
    std::cout << "[Case0] precision_check=" << (passed ? "FAILED (fault reproduced)" : "UNEXPECTED") << std::endl;
#endif
#elif SCENARIO_NUM == 1
    std::cout << "[Case1] launch_ret=" << static_cast<int32_t>(launch_ret)
              << ", sync_ret=" << static_cast<int32_t>(sync_ret) << ", result=" << (passed ? "PASSED" : "FAILED")
              << std::endl;
#elif SCENARIO_NUM == 2
    std::cout << "Case 2 (mixed UB): " << (passed ? "PASSED" : "FAILED") << std::endl;
#elif SCENARIO_NUM == 3
    std::cout << "[Case3] launch_ret=" << static_cast<int32_t>(launch_ret)
              << ", sync_ret=" << static_cast<int32_t>(sync_ret) << ", observation="
              << (passed ? "COMPLETED" : "RUNTIME_ERROR") << std::endl;
#endif
    return passed;
}

int32_t RunSelectedCase()
{
#if SCENARIO_NUM == 0 || SCENARIO_NUM == 3
    constexpr size_t output_bytes = BUFFER_BYTES;
#else
    constexpr size_t output_bytes = RESULT_BYTES_PER_CASE;
#endif
    uint8_t* output_host = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t* input_device = nullptr;
#if SCENARIO_NUM == 0 || SCENARIO_NUM == 3
    std::vector<uint32_t> input(BUFFER_WORDS);
    for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
#if SCENARIO_NUM == 0
        input[index] = CASE0_MARKER + index;
#else
        input[index] = CASE3_MARKER + index;
#endif
    }
    aclrtMalloc(reinterpret_cast<void**>(&input_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, BUFFER_BYTES, input.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
#endif

    LaunchSelectedCase(stream, output_device, input_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = VerifySelectedCase(reinterpret_cast<uint32_t*>(output_host), launch_ret, sync_ret);

    aclrtFree(output_device);
#if SCENARIO_NUM == 0 || SCENARIO_NUM == 3
    aclrtFree(input_device);
#endif
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main() { return RunSelectedCase(); }
