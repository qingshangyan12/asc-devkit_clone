/* !
 * \file ub_usage_limit.asc
 * \brief Demonstrates UB capacity calculation and access patterns in SIMD and SIMT hybrid programming.
 */

#include <cstdint>
#include <iostream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"
#include "tiling/platform/platform_ascendc.h"

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DATA_CACHE_BYTES = 32 * 1024;
constexpr uint32_t USER_UB_BYTES_WITHOUT_SIMT = UB_TOTAL_BYTES - RESERVED_UB_BYTES;
constexpr uint32_t USER_UB_BYTES_WITH_SIMT = UB_TOTAL_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DATA_CACHE_BYTES;

constexpr uint32_t RESULT_WORDS_PER_CASE = 8;
constexpr uint32_t CASE_NUM = 4;
constexpr uint32_t RESULT_WORDS = RESULT_WORDS_PER_CASE * CASE_NUM;
constexpr uint32_t RESULT_BYTES_PER_CASE = RESULT_WORDS_PER_CASE * sizeof(uint32_t);

constexpr uint32_t CASE1_STATIC_WORDS = 1024;
constexpr uint32_t CASE2_DYNAMIC_WORDS = THREAD_COUNT;
constexpr uint32_t CASE3_SIMT_STATIC_WORDS = 64;
constexpr uint32_t CASE3_SIMD_STATIC_WORDS = 64;
constexpr uint32_t CASE4_DYNAMIC_WORDS = 2048;

// Case3动态UB上限实测：SIMT VF和SIMD VF各自声明64KB静态UB（共128KB），
// 用于验证"存在SIMT VF时可申请的动态UB上限 = 216KB - 静态1 - 静态2"这一结论。
constexpr uint32_t CASE3_SWEEP_SIMT_STATIC_WORDS = 16 * 1024;
constexpr uint32_t CASE3_SWEEP_SIMD_STATIC_WORDS = 16 * 1024;
constexpr uint32_t CASE3_SWEEP_STATIC_TOTAL_BYTES =
    (CASE3_SWEEP_SIMT_STATIC_WORDS + CASE3_SWEEP_SIMD_STATIC_WORDS) * sizeof(uint32_t);
constexpr uint32_t CASE3_SWEEP_PREDICTED_MAX_DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - CASE3_SWEEP_STATIC_TOTAL_BYTES;

// Case5越界严重程度实测：Host侧固定配置4KB动态UB，SIMT VF实际访问范围可越界到不同程度。
constexpr uint32_t CASE5_CONFIGURED_WORDS = 1024;

constexpr uint32_t CASE1_MARKER = 0xC0010001;
constexpr uint32_t CASE2_MARKER = 0xC0010002;
constexpr uint32_t CASE3_MARKER = 0xC0010003;
constexpr uint32_t CASE4_MARKER = 0xC0010004;

constexpr uint32_t CASE3_SWEEP_MARKER = 0xC0030000;
constexpr uint32_t CASE5_PROBE_MARKER = 0xC0050000;

#if defined(ENABLE_UB_PROBE1)
constexpr uint32_t PROBE1_STATIC_BYTES = UB_PROBE1_STATIC_BYTES;
constexpr uint32_t PROBE1_STATIC_WORDS = PROBE1_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t PROBE1_MARKER = 0xC0FFEE01;
#endif
} // namespace

__aicore__ inline void CopyResultToGm(__gm__ uint32_t* output, __ubuf__ uint32_t* result)
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }
    asc_copy_ub2gm_align(output, result, 1, RESULT_BYTES_PER_CASE, 0, 0, 0);
}

__aicore__ inline void WaitVectorToScalar()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtFillDynamicUb(
    __ubuf__ uint32_t* dynamicUb, uint32_t wordCount, uint32_t marker)
{
    for (uint32_t index = threadIdx.x; index < wordCount; index += blockDim.x) {
        dynamicUb[index] = marker + index;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtStaticUbProbe(__ubuf__ uint32_t* result)
{
    __ubuf__ uint32_t simtStatic[CASE3_SIMT_STATIC_WORDS];
    if (threadIdx.x < CASE3_SIMT_STATIC_WORDS) {
        simtStatic[threadIdx.x] = CASE3_MARKER + threadIdx.x;
        result[threadIdx.x & (RESULT_WORDS_PER_CASE - 1)] = simtStatic[threadIdx.x];
    }
}

__simd_vf__ inline void SimdStaticUbProbe(__ubuf__ uint32_t* result)
{
    __ubuf__ uint32_t simdStatic[CASE3_SIMD_STATIC_WORDS];
    for (uint32_t index = 0; index < CASE3_SIMD_STATIC_WORDS; ++index) {
        simdStatic[index] = CASE3_MARKER + CASE3_SIMT_STATIC_WORDS + index;
    }
    for (uint32_t index = 0; index < RESULT_WORDS_PER_CASE; ++index) {
        result[index] = simdStatic[index];
    }
}

__global__ __vector__ void Case1NoSimtVfKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t staticUb[CASE1_STATIC_WORDS];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    for (uint32_t index = 0; index < CASE1_STATIC_WORDS; ++index) {
        staticUb[index] = CASE1_MARKER + index;
    }

    result[0] = CASE1_MARKER;
    result[1] = CASE1_STATIC_WORDS * sizeof(uint32_t);
    result[2] = USER_UB_BYTES_WITHOUT_SIMT;
    result[3] = staticUb[0];
    result[4] = staticUb[CASE1_STATIC_WORDS - 1];
    result[5] = (CASE1_STATIC_WORDS * sizeof(uint32_t) <= USER_UB_BYTES_WITHOUT_SIMT) ? 1 : 0;
    result[6] = RESERVED_UB_BYTES;
    result[7] = UB_TOTAL_BYTES;

    CopyResultToGm(output, result);
}

__global__ __vector__ void Case2WithSimtVfKernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtFillDynamicUb>(dim3(THREAD_COUNT), dynamicUb, CASE2_DYNAMIC_WORDS, CASE2_MARKER);
    WaitVectorToScalar();

    result[0] = CASE2_MARKER;
    result[1] = CASE2_DYNAMIC_WORDS * sizeof(uint32_t);
    result[2] = USER_UB_BYTES_WITH_SIMT;
    result[3] = dynamicUb[0];
    result[4] = dynamicUb[CASE2_DYNAMIC_WORDS - 1];
    result[5] = (CASE2_DYNAMIC_WORDS * sizeof(uint32_t) <= USER_UB_BYTES_WITH_SIMT) ? 1 : 0;
    result[6] = MIN_SIMT_DATA_CACHE_BYTES;
    result[7] = RESERVED_UB_BYTES;

    CopyResultToGm(output, result);
}

__global__ __vector__ void Case3StaticUbInVfKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t simtResult[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t simdResult[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtStaticUbProbe>(dim3(THREAD_COUNT), simtResult);
    asc_vf_call<SimdStaticUbProbe>(simdResult);
    WaitVectorToScalar();

    result[0] = CASE3_MARKER;
    result[1] = (CASE3_SIMT_STATIC_WORDS + CASE3_SIMD_STATIC_WORDS) * sizeof(uint32_t);
    result[2] = USER_UB_BYTES_WITH_SIMT;
    result[3] = CASE3_SIMT_STATIC_WORDS * sizeof(uint32_t);
    result[4] = CASE3_SIMD_STATIC_WORDS * sizeof(uint32_t);
    result[5] =
        (((CASE3_SIMT_STATIC_WORDS + CASE3_SIMD_STATIC_WORDS) * sizeof(uint32_t)) <= USER_UB_BYTES_WITH_SIMT) ? 1 : 0;
    result[6] = MIN_SIMT_DATA_CACHE_BYTES;
    result[7] = RESERVED_UB_BYTES;

    CopyResultToGm(output, result);
}

__global__ __vector__ void Case4DynamicUbKernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtFillDynamicUb>(dim3(THREAD_COUNT), dynamicUb, CASE4_DYNAMIC_WORDS, CASE4_MARKER);
    WaitVectorToScalar();

    result[0] = CASE4_MARKER;
    result[1] = CASE4_DYNAMIC_WORDS * sizeof(uint32_t);
    result[2] = USER_UB_BYTES_WITH_SIMT;
    result[3] = dynamicUb[0];
    result[4] = dynamicUb[CASE4_DYNAMIC_WORDS - 1];
    result[5] = (CASE4_DYNAMIC_WORDS * sizeof(uint32_t) <= USER_UB_BYTES_WITH_SIMT) ? 1 : 0;
    result[6] = MIN_SIMT_DATA_CACHE_BYTES;
    result[7] = RESERVED_UB_BYTES;

    CopyResultToGm(output, result);
}

// ---------------------------------------------------------------------------------------------
// 以下为实测诊断kernel，用于回答README中三个实测问题，不在默认4-case路径中调用：
//   1. probe1  : 无SIMT VF时，静态UB能否达到256KB（需配合CMake选项ENABLE_UB_PROBE1单独编译）。
//   2. case3_sweep : SIMT VF和SIMD VF均有静态UB时，动态UB可申请上限是否等于 216KB-静态1-静态2。
//   3. case5_probe : 动态UB配置偏小时，实际访问越界到不同程度分别表现为静默通过还是运行时报错。
// ---------------------------------------------------------------------------------------------

#if defined(ENABLE_UB_PROBE1)
__simd_vf__ inline void Probe1FillVF(__ubuf__ uint32_t* staticUb, uint32_t wordCount, uint32_t marker)
{
    for (uint32_t index = 0; index < wordCount; ++index) {
        staticUb[index] = marker + index;
    }
}

__global__ __vector__ void Case1Probe1Kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t staticUb[PROBE1_STATIC_WORDS];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

#if defined(UB_PROBE1_NO_VF)
    // 不调用任何VF函数，纯MainScalar填充：用于验证"完全不出现VF函数调用"时
    // 8KB预留空间是否仍会被扣除。
    for (uint32_t index = 0; index < PROBE1_STATIC_WORDS; ++index) {
        staticUb[index] = PROBE1_MARKER + index;
    }
#else
    // 调用一次SIMD VF：用于验证"kernel中出现VF函数调用"时8KB预留空间的实际扣除情况。
    asc_vf_call<Probe1FillVF>(staticUb, PROBE1_STATIC_WORDS, PROBE1_MARKER);
    WaitVectorToScalar();
#endif

    result[0] = PROBE1_MARKER;
    result[1] = PROBE1_STATIC_BYTES;
    result[2] = staticUb[0];
    result[3] = staticUb[PROBE1_STATIC_WORDS - 1];
    result[4] = 1;
    result[5] = 0;
    result[6] = 0;
    result[7] = 0;

    CopyResultToGm(output, result);
}
#endif

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtStaticUbProbeSweep(__ubuf__ uint32_t* result)
{
    __ubuf__ uint32_t simtStatic[CASE3_SWEEP_SIMT_STATIC_WORDS];
    for (uint32_t index = threadIdx.x; index < CASE3_SWEEP_SIMT_STATIC_WORDS; index += blockDim.x) {
        simtStatic[index] = CASE3_SWEEP_MARKER + index;
    }
    if (threadIdx.x == 0) {
        result[0] = simtStatic[0];
        result[1] = simtStatic[CASE3_SWEEP_SIMT_STATIC_WORDS - 1];
    }
}

__simd_vf__ inline void SimdStaticUbProbeSweep(__ubuf__ uint32_t* result)
{
    __ubuf__ uint32_t simdStatic[CASE3_SWEEP_SIMD_STATIC_WORDS];
    for (uint32_t index = 0; index < CASE3_SWEEP_SIMD_STATIC_WORDS; ++index) {
        simdStatic[index] = CASE3_SWEEP_MARKER + 0x1000 + index;
    }
    result[0] = simdStatic[0];
    result[1] = simdStatic[CASE3_SWEEP_SIMD_STATIC_WORDS - 1];
}

// 用于实测Case3动态UB上限：SIMT VF与SIMD VF各自占用64KB静态UB（共128KB），
// dynamicWordCount由Host侧在多次进程内以不同<<<...>>> dyn_ub_size启动时传入。
__global__ __vector__ void Case3SweepKernel(__gm__ uint32_t* output, uint32_t dynamicWordCount)
{
    __ubuf__ uint32_t simtResult[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t simdResult[RESULT_WORDS_PER_CASE];
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtStaticUbProbeSweep>(dim3(THREAD_COUNT), simtResult);
    asc_vf_call<SimdStaticUbProbeSweep>(simdResult);
    asc_vf_call<SimtFillDynamicUb>(dim3(THREAD_COUNT), dynamicUb, dynamicWordCount, CASE3_SWEEP_MARKER);
    WaitVectorToScalar();

    result[0] = CASE3_SWEEP_MARKER;
    result[1] = dynamicWordCount * sizeof(uint32_t);
    result[2] = CASE3_SWEEP_STATIC_TOTAL_BYTES;
    result[3] = dynamicUb[0];
    result[4] = dynamicUb[dynamicWordCount - 1];
    result[5] = simtResult[0];
    result[6] = simdResult[0];
    result[7] = 1;

    CopyResultToGm(output, result);
}

// 用于实测Case5越界严重程度：Host侧固定配置CASE5_CONFIGURED_WORDS大小的动态UB，
// 但SIMT VF实际按actualAccessWords（可远大于配置值）访问dynamicUb。
__global__ __vector__ void Case5OobProbeKernel(__gm__ uint32_t* output, uint32_t actualAccessWords)
{
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtFillDynamicUb>(dim3(THREAD_COUNT), dynamicUb, actualAccessWords, CASE5_PROBE_MARKER);
    WaitVectorToScalar();

    const uint32_t safeIndex =
        (actualAccessWords < CASE5_CONFIGURED_WORDS) ? (actualAccessWords - 1) : (CASE5_CONFIGURED_WORDS - 1);
    result[0] = CASE5_PROBE_MARKER;
    result[1] = actualAccessWords * sizeof(uint32_t);
    result[2] = CASE5_CONFIGURED_WORDS * sizeof(uint32_t);
    result[3] = dynamicUb[0];
    result[4] = dynamicUb[safeIndex];
    result[5] = 1;
    result[6] = 0;
    result[7] = 0;

    CopyResultToGm(output, result);
}

void RunKernels(uint32_t* outputDevice, aclrtStream stream)
{
    constexpr uint32_t blockNum = 1;
    constexpr uint32_t noDynamicUbBytes = 0;
    constexpr uint32_t case2DynamicUbBytes = CASE2_DYNAMIC_WORDS * sizeof(uint32_t);
    constexpr uint32_t case4DynamicUbBytes = CASE4_DYNAMIC_WORDS * sizeof(uint32_t);

    Case1NoSimtVfKernel<<<blockNum, noDynamicUbBytes, stream>>>(outputDevice);
    Case2WithSimtVfKernel<<<blockNum, case2DynamicUbBytes, stream>>>(outputDevice + RESULT_WORDS_PER_CASE);
    Case3StaticUbInVfKernel<<<blockNum, noDynamicUbBytes, stream>>>(outputDevice + RESULT_WORDS_PER_CASE * 2);
    Case4DynamicUbKernel<<<blockNum, case4DynamicUbBytes, stream>>>(outputDevice + RESULT_WORDS_PER_CASE * 3);
}

bool VerifyCase(const std::vector<uint32_t>& output, uint32_t caseIndex, uint32_t expectedMarker)
{
    const uint32_t offset = caseIndex * RESULT_WORDS_PER_CASE;
    const bool passed = (output[offset] == expectedMarker) && (output[offset + 5] == 1);
    std::cout << "Case " << (caseIndex + 1) << ": marker=0x" << std::hex << output[offset] << std::dec
              << ", used_bytes=" << output[offset + 1] << ", limit_bytes=" << output[offset + 2]
              << ", status=" << (passed ? "PASSED" : "FAILED") << std::endl;
    return passed;
}

int32_t RunDefaultCases()
{
    const size_t outputBytes = RESULT_WORDS * sizeof(uint32_t);
    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    int32_t deviceId = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputBytes);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    RunKernels(outputDevice, stream);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outputHost, outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint32_t> output(
        reinterpret_cast<uint32_t*>(outputHost), reinterpret_cast<uint32_t*>(outputHost + outputBytes));
    bool passed = true;
    passed = VerifyCase(output, 0, CASE1_MARKER) && passed;
    passed = VerifyCase(output, 1, CASE2_MARKER) && passed;
    passed = VerifyCase(output, 2, CASE3_MARKER) && passed;
    passed = VerifyCase(output, 3, CASE4_MARKER) && passed;

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (passed) {
        std::cout << "[Success] All UB usage limit cases are verification passed." << std::endl;
        return 0;
    }
    std::cout << "[Failed] UB usage limit case verification failed." << std::endl;
    return 1;
}

#if defined(ENABLE_UB_PROBE1)
// 实测1：无SIMT VF场景下，静态UB是否能用满256KB整块UB（不扣8KB预留空间）。
// 通过CMake选项ENABLE_UB_PROBE1单独编译，静态数组大小由UB_PROBE1_STATIC_BYTES控制。
int32_t RunProbe1()
{
    const size_t outputBytes = RESULT_BYTES_PER_CASE;
    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    int32_t deviceId = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputBytes);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    std::cout << "[Probe1] static_bytes=" << PROBE1_STATIC_BYTES << std::endl;
    Case1Probe1Kernel<<<1, 0, stream>>>(outputDevice);
    aclError launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError syncRet = (launchRet == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launchRet;
    std::cout << "[Probe1] launch_ret=" << static_cast<int32_t>(launchRet)
              << ", aclrtSynchronizeStream ret=" << static_cast<int32_t>(syncRet) << std::endl;

    int32_t exitCode = 0;
    if (syncRet == ACL_SUCCESS) {
        aclrtMemcpy(outputHost, outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        uint32_t* result = reinterpret_cast<uint32_t*>(outputHost);
        std::cout << "[Probe1] marker=0x" << std::hex << result[0] << std::dec << ", first=0x" << std::hex << result[2]
                  << ", last=0x" << result[3] << std::dec << std::endl;
        std::cout << "[Probe1][Success] kernel executed without runtime error." << std::endl;
    } else {
        std::cout << "[Probe1][Failed] kernel launch/execution reported a runtime error." << std::endl;
        exitCode = 1;
    }

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return exitCode;
}
#endif

// 实测2：SIMT VF和SIMD VF均声明静态UB时，动态UB能否申请到"216KB-静态1-静态2"这一理论上限，
// 以及超出该上限一小段后是否会被运行时拒绝。dynamicWords由命令行参数传入，便于反复取不同值观察。
int32_t RunCase3Sweep(uint32_t dynamicWords)
{
    const size_t outputBytes = RESULT_BYTES_PER_CASE;
    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    int32_t deviceId = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputBytes);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    const uint32_t dynamicBytes = dynamicWords * sizeof(uint32_t);
    std::cout << "[Case3Sweep] static_total_bytes=" << CASE3_SWEEP_STATIC_TOTAL_BYTES
              << ", predicted_max_dynamic_bytes=" << CASE3_SWEEP_PREDICTED_MAX_DYNAMIC_BYTES
              << ", requested_dynamic_bytes=" << dynamicBytes << std::endl;

    Case3SweepKernel<<<1, dynamicBytes, stream>>>(outputDevice, dynamicWords);
    aclError launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError syncRet = (launchRet == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launchRet;
    std::cout << "[Case3Sweep] launch_ret=" << static_cast<int32_t>(launchRet)
              << ", aclrtSynchronizeStream ret=" << static_cast<int32_t>(syncRet) << std::endl;

    int32_t exitCode = 0;
    if (syncRet == ACL_SUCCESS) {
        aclrtMemcpy(outputHost, outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        uint32_t* result = reinterpret_cast<uint32_t*>(outputHost);
        std::cout << "[Case3Sweep] marker=0x" << std::hex << result[0] << std::dec << ", dynamic_first=0x" << std::hex
                  << result[3] << ", dynamic_last=0x" << result[4] << std::dec << ", simt_static_probe=0x" << std::hex
                  << result[5] << ", simd_static_probe=0x" << result[6] << std::dec << std::endl;
        std::cout << "[Case3Sweep][Success] dynamic_bytes=" << dynamicBytes << " executed without runtime error."
                  << std::endl;
    } else {
        std::cout << "[Case3Sweep][Failed] dynamic_bytes=" << dynamicBytes
                  << " triggered a runtime error (Data Cache below 32KB minimum, or other UB overflow)." << std::endl;
        exitCode = 1;
    }

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return exitCode;
}

// 用于实测GetCoreMemSize(CoreMemType::UB, ...)在无VF/有SIMD VF/有SIMT VF场景下返回值是否变化。
// Host侧的平台信息查询与Device侧具体某个kernel是否调用了VF函数无关：GetCoreMemSize读取的是
// 硬件平台的静态规格表（当前SoC的UB物理容量，按需再减去用户通过ReserveLocalMemory主动预留的部分），
// 与某一次kernel launch时是否发生了asc_vf_call没有关联，因此在运行不同case前后查询到的数值应保持一致。
void PrintCoreMemSizeUb(const char* label)
{
    const auto* platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformInfoMgr == nullptr) {
        std::cout << "[PlatformQuery][" << label << "] Get platform info failed, please check device status."
                  << std::endl;
        return;
    }
    uint64_t ubSize = 0;
    platformInfoMgr->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    std::cout << "[PlatformQuery][" << label << "] GetCoreMemSize(CoreMemType::UB) = " << ubSize << " bytes"
              << std::endl;
}

// 依次在：(1)完全不调用VF的kernel、(2)只调用SIMT VF的kernel、(3)同时调用SIMT VF和SIMD VF的kernel
// 运行前后，各查询一次GetCoreMemSize(CoreMemType::UB)，用于实测该接口的返回值是否随kernel里
// VF使用形态变化。
int32_t RunPlatformQuery()
{
    const size_t outputBytes = RESULT_WORDS_PER_CASE * sizeof(uint32_t);
    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    int32_t deviceId = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputBytes);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    PrintCoreMemSizeUb("before_any_kernel");

    Case1NoSimtVfKernel<<<1, 0, stream>>>(outputDevice);
    aclrtSynchronizeStream(stream);
    PrintCoreMemSizeUb("after_no_vf_kernel(Case1NoSimtVfKernel)");

    constexpr uint32_t case2DynamicUbBytes = CASE2_DYNAMIC_WORDS * sizeof(uint32_t);
    Case2WithSimtVfKernel<<<1, case2DynamicUbBytes, stream>>>(outputDevice);
    aclrtSynchronizeStream(stream);
    PrintCoreMemSizeUb("after_simt_vf_kernel(Case2WithSimtVfKernel)");

    Case3StaticUbInVfKernel<<<1, 0, stream>>>(outputDevice);
    aclrtSynchronizeStream(stream);
    PrintCoreMemSizeUb("after_simt_and_simd_vf_kernel(Case3StaticUbInVfKernel)");

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}

// 实测3：Host侧固定配置CASE5_CONFIGURED_WORDS大小动态UB，SIMT VF实际访问范围
// actualAccessWords由命令行参数传入，用于观察越界到不同程度时的现象差异
// （静默数据篡改 / aclrtSynchronizeStream报错 / 进程异常退出）。
int32_t RunCase5Probe(uint32_t actualAccessWords)
{
    const size_t outputBytes = RESULT_BYTES_PER_CASE;
    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;
    int32_t deviceId = 0;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputBytes);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    constexpr uint32_t configuredBytes = CASE5_CONFIGURED_WORDS * sizeof(uint32_t);
    const uint32_t actualBytes = actualAccessWords * sizeof(uint32_t);
    std::cout << "[Case5Probe] configured_bytes=" << configuredBytes << ", actual_access_bytes=" << actualBytes
              << std::endl;

    Case5OobProbeKernel<<<1, configuredBytes, stream>>>(outputDevice, actualAccessWords);
    aclError launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError syncRet = (launchRet == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launchRet;
    std::cout << "[Case5Probe] launch_ret=" << static_cast<int32_t>(launchRet)
              << ", aclrtSynchronizeStream ret=" << static_cast<int32_t>(syncRet) << std::endl;

    int32_t exitCode = 0;
    if (syncRet == ACL_SUCCESS) {
        aclrtMemcpy(outputHost, outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        uint32_t* result = reinterpret_cast<uint32_t*>(outputHost);
        std::cout << "[Case5Probe] marker=0x" << std::hex << result[0] << std::dec << ", written_first=0x" << std::hex
                  << result[3] << ", written_at_configured_boundary=0x" << result[4] << std::dec << std::endl;
        std::cout << "[Case5Probe][NoRuntimeError] kernel executed and returned normally; check whether "
                     "downstream data (Data Cache / adjacent UB) got silently overwritten."
                  << std::endl;
    } else {
        std::cout << "[Case5Probe][RuntimeError] aclrtSynchronizeStream reported a runtime error for this "
                     "access range."
                  << std::endl;
        exitCode = 1;
    }

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return exitCode;
}

int32_t main(int32_t argc, char** argv)
{
    if (argc >= 2) {
        const std::string mode = argv[1];
#if defined(ENABLE_UB_PROBE1)
        if (mode == "probe1") {
            return RunProbe1();
        }
#endif
        if (mode == "case3_sweep" && argc >= 3) {
            return RunCase3Sweep(static_cast<uint32_t>(std::stoul(argv[2])));
        }
        if (mode == "case5_probe" && argc >= 3) {
            return RunCase5Probe(static_cast<uint32_t>(std::stoul(argv[2])));
        }
        if (mode == "platform_query") {
            return RunPlatformQuery();
        }
        std::cout << "Usage: ub_usage_limit [case3_sweep <dynamic_words>|case5_probe <actual_access_words>"
                     "|platform_query]"
                  << std::endl;
        return 1;
    }
    return RunDefaultCases();
}
