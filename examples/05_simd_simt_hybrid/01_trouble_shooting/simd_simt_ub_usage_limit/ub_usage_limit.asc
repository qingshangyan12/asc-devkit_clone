/* !
 * \file ub_usage_limit.asc
 * \brief Demonstrates UB out-of-bounds analysis and correct UB usage in SIMD and SIMT hybrid programming.
 */

#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 4
#error "SCENARIO_NUM must be one of 0, 1, 2, 3, 4."
#endif

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DATA_CACHE_BYTES = 32 * 1024;
constexpr uint32_t USER_UB_BYTES_WITH_SIMT = UB_TOTAL_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DATA_CACHE_BYTES;

constexpr uint32_t RESULT_WORDS_PER_CASE = 8;
constexpr uint32_t RESULT_BYTES_PER_CASE = RESULT_WORDS_PER_CASE * sizeof(uint32_t);

constexpr uint32_t BUFFER_WORDS = THREAD_COUNT;
constexpr uint32_t BUFFER_BYTES = BUFFER_WORDS * sizeof(uint32_t);
constexpr uint32_t VECTOR_ADD_BUFFER_NUM = 3;
constexpr uint32_t VECTOR_ADD_REQUIRED_BYTES = VECTOR_ADD_BUFFER_NUM * BUFFER_BYTES;
constexpr uint32_t CASE0_OVERFLOW_WORDS = 1;

constexpr uint32_t STATIC_WORDS = THREAD_COUNT;
constexpr uint32_t MIXED_MAIN_STATIC_WORDS = 256;
constexpr uint32_t MIXED_SIMD_STATIC_WORDS = 512;
constexpr uint32_t MIXED_SIMT_STATIC_WORDS = THREAD_COUNT;
constexpr uint32_t MIXED_MAIN_STATIC_BYTES = 3 * RESULT_BYTES_PER_CASE;

constexpr uint32_t CASE0_MARKER = 0xC0000000;
constexpr uint32_t CASE0_CORRUPTED_VALUE = 0xDEADBEEF;
constexpr uint32_t CASE1_MARKER = 0xC0010000;
constexpr uint32_t CASE3_MARKER = 0xC0030000;
constexpr uint32_t CASE4_MARKER = 0xC0040000;

#if SCENARIO_NUM == 2
constexpr uint32_t BOUNDARY_STATIC_BYTES = UB_BOUNDARY_STATIC_BYTES;
constexpr uint32_t BOUNDARY_STATIC_WORDS = BOUNDARY_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t BOUNDARY_MARKER = 0xC0FFEE00;
static_assert(BOUNDARY_STATIC_BYTES % sizeof(uint32_t) == 0, "UB boundary size must be a multiple of 4 bytes");
#endif

#if SCENARIO_NUM == 3
constexpr uint32_t CASE3_CONFIGURED_DYNAMIC_BYTES = CASE3_DYNAMIC_BYTES;
constexpr uint32_t CASE3_DYNAMIC_WORDS = CASE3_CONFIGURED_DYNAMIC_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE3_MAX_DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - RESULT_BYTES_PER_CASE;
static_assert(
    CASE3_CONFIGURED_DYNAMIC_BYTES % sizeof(uint32_t) == 0, "Case 3 dynamic UB size must be a multiple of 4 bytes");
static_assert(CASE3_DYNAMIC_WORDS > 0, "Case 3 dynamic UB size must be greater than zero");
#endif

#if SCENARIO_NUM == 4
constexpr uint32_t CASE4_CONFIGURED_DYNAMIC_BYTES = CASE4_DYNAMIC_BYTES;
constexpr uint32_t MIXED_DYNAMIC_WORDS = CASE4_CONFIGURED_DYNAMIC_BYTES / sizeof(uint32_t);
constexpr uint32_t MIXED_STATIC_BYTES =
    (MIXED_MAIN_STATIC_WORDS + MIXED_SIMD_STATIC_WORDS + MIXED_SIMT_STATIC_WORDS) * sizeof(uint32_t) +
    MIXED_MAIN_STATIC_BYTES;
constexpr uint32_t CASE4_MAX_DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - MIXED_STATIC_BYTES;
constexpr uint32_t MIXED_USER_UB_BYTES = MIXED_STATIC_BYTES + CASE4_CONFIGURED_DYNAMIC_BYTES;
static_assert(
    CASE4_CONFIGURED_DYNAMIC_BYTES % sizeof(uint32_t) == 0, "Case 4 dynamic UB size must be a multiple of 4 bytes");
static_assert(MIXED_DYNAMIC_WORDS > 0, "Case 4 dynamic UB size must be greater than zero");
#endif
} // namespace

__aicore__ inline void WaitVectorToScalar()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    }
}

__aicore__ inline void WaitScalarToVector()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    }
}

__aicore__ inline void CopyResultToGm(__gm__ uint32_t* output, __ubuf__ uint32_t* result)
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }
    asc_copy_ub2gm_align(output, result, 1, RESULT_BYTES_PER_CASE, 0, 0, 0);
}

#if SCENARIO_NUM == 3
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtFillCase3DynamicUb(
    __ubuf__ uint32_t* dynamicUb, uint32_t wordCount, uint32_t marker)
{
    for (uint32_t index = threadIdx.x; index < wordCount; index += blockDim.x) {
        dynamicUb[index] = marker + index;
    }
}
#endif

#if SCENARIO_NUM == 0
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtInitVectorAddInputs(
    __ubuf__ uint32_t* lhs, __ubuf__ uint32_t* rhs, uint32_t wordCount, uint32_t marker)
{
    for (uint32_t index = threadIdx.x; index < wordCount; index += blockDim.x) {
        lhs[index] = marker + index;
        rhs[index] = index;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtAddPreparedInputs(
    __ubuf__ uint32_t* lhs, __ubuf__ uint32_t* rhs, __ubuf__ uint32_t* output, uint32_t wordCount)
{
    for (uint32_t index = threadIdx.x; index < wordCount; index += blockDim.x) {
        output[index] = lhs[index] + rhs[index];
    }
}
#endif

#if SCENARIO_NUM == 4
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void SimtCase4Ub(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simtStaticUb[MIXED_SIMT_STATIC_WORDS];
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t* simtDynamicUb = dynamicUb;
    for (uint32_t index = threadIdx.x; index < MIXED_SIMT_STATIC_WORDS; index += blockDim.x) {
        simtStaticUb[index] = marker + index;
    }
    if (threadIdx.x == 0) {
        result[0] = simtStaticUb[MIXED_SIMT_STATIC_WORDS - 1];
        result[1] = simtDynamicUb[0];
        simtDynamicUb[0] = marker + 3;
    }
}

__simd_vf__ inline void SimdCase4Ub(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simdStaticUb[MIXED_SIMD_STATIC_WORDS];
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t* simdDynamicUb = dynamicUb;
    for (uint32_t index = 0; index < MIXED_SIMD_STATIC_WORDS; ++index) {
        simdStaticUb[index] = marker + index;
    }
    result[0] = simdStaticUb[MIXED_SIMD_STATIC_WORDS - 1];
    result[1] = simdDynamicUb[0];
    simdDynamicUb[0] = marker + 2;
}
#endif

#if SCENARIO_NUM == 2
__simd_vf__ inline void SimdFillBoundaryUb(__ubuf__ uint32_t* staticUb, uint32_t wordCount)
{
    for (uint32_t index = 0; index < wordCount; ++index) {
        staticUb[index] = BOUNDARY_MARKER + index;
    }
}

// Case 2 compares static UB boundaries with and without a SIMD VF call.
__global__ __vector__ void Case2StaticUbBoundaryKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t staticUb[BOUNDARY_STATIC_WORDS];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

#if defined(UB_BOUNDARY_NO_SIMD_VF)
    for (uint32_t index = 0; index < BOUNDARY_STATIC_WORDS; ++index) {
        staticUb[index] = BOUNDARY_MARKER + index;
    }
#else
    asc_vf_call<SimdFillBoundaryUb>(staticUb, BOUNDARY_STATIC_WORDS);
    WaitVectorToScalar();
#endif

    result[0] = BOUNDARY_MARKER;
    result[1] = BOUNDARY_STATIC_BYTES;
    result[2] = staticUb[0];
    result[3] = staticUb[BOUNDARY_STATIC_WORDS - 1];
    result[4] = BOUNDARY_MARKER;
    result[5] = BOUNDARY_MARKER + BOUNDARY_STATIC_WORDS - 1;
    result[6] = 0;
    result[7] = 0;
    CopyResultToGm(output, result);
}
#endif

#if SCENARIO_NUM == 0
// Case 0: a static UB write crosses its declared boundary and corrupts the following dynamic UB input.
__global__ __vector__ void Case0StaticUbOobKernel(__gm__ uint32_t* output, uint32_t faultyIndex)
{
    __ubuf__ uint32_t staticUb[STATIC_WORDS];
    extern __ubuf__ uint32_t case0DynamicUb[];
    __ubuf__ uint32_t* lhs = case0DynamicUb;
    __ubuf__ uint32_t* rhs = case0DynamicUb + BUFFER_WORDS;
    __ubuf__ uint32_t* vectorOutput = case0DynamicUb + 2 * BUFFER_WORDS;

    asc_vf_call<SimtInitVectorAddInputs>(dim3(THREAD_COUNT), lhs, rhs, BUFFER_WORDS, CASE0_MARKER);
    WaitVectorToScalar();

    // The faulty runtime index crosses staticUb by 4 bytes and overwrites lhs[0].
    __ubuf__ volatile uint32_t* staticData = staticUb;
    staticData[faultyIndex] = CASE0_CORRUPTED_VALUE;
    WaitScalarToVector();
    asc_vf_call<SimtAddPreparedInputs>(dim3(THREAD_COUNT), lhs, rhs, vectorOutput, BUFFER_WORDS);
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }
    asc_copy_ub2gm_align(output, vectorOutput, 1, BUFFER_BYTES, 0, 0, 0);
}
#endif

#if SCENARIO_NUM == 3
// Case 3: a SIMT VF accesses correctly configured dynamic UB.
__global__ __vector__ void SimtDynamicUbKernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t simtDynamicUb[];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    asc_vf_call<SimtFillCase3DynamicUb>(dim3(THREAD_COUNT), simtDynamicUb, CASE3_DYNAMIC_WORDS, CASE3_MARKER);
    WaitVectorToScalar();

    result[0] = CASE3_MARKER;
    result[1] = CASE3_CONFIGURED_DYNAMIC_BYTES;
    result[2] = CASE3_MAX_DYNAMIC_BYTES;
    result[3] = simtDynamicUb[0];
    result[4] = simtDynamicUb[CASE3_DYNAMIC_WORDS - 1];
    result[5] = CASE3_MARKER;
    result[6] = CASE3_MARKER + CASE3_DYNAMIC_WORDS - 1;
    result[7] = USER_UB_BYTES_WITH_SIMT;
    CopyResultToGm(output, result);
}
#endif

#if SCENARIO_NUM == 1
// Case 1: MainScalar uses a fixed-size static UB array without calling any VF.
__global__ __vector__ void NoVfStaticUbKernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t staticUb[STATIC_WORDS];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    for (uint32_t index = 0; index < STATIC_WORDS; ++index) {
        staticUb[index] = CASE1_MARKER + index;
    }

    result[0] = CASE1_MARKER;
    result[1] = STATIC_WORDS * sizeof(uint32_t);
    result[2] = 0;
    result[3] = staticUb[0];
    result[4] = staticUb[STATIC_WORDS - 1];
    result[5] = CASE1_MARKER;
    result[6] = CASE1_MARKER + STATIC_WORDS - 1;
    result[7] = UB_TOTAL_BYTES;
    CopyResultToGm(output, result);
}
#endif

#if SCENARIO_NUM == 4
// Case 4: MainScalar, SIMD VF, and SIMT VF static UB share the same pool with dynamic UB.
__global__ __vector__ void MixedUbKernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t dynamicUb[];
    __ubuf__ uint32_t* mainDynamicUb = dynamicUb;
    __ubuf__ uint32_t mainStaticUb[MIXED_MAIN_STATIC_WORDS];
    __ubuf__ uint32_t simtResult[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t simdResult[RESULT_WORDS_PER_CASE];
    __ubuf__ uint32_t result[RESULT_WORDS_PER_CASE];

    for (uint32_t index = 0; index < MIXED_MAIN_STATIC_WORDS; ++index) {
        mainStaticUb[index] = CASE4_MARKER + index;
    }
    mainDynamicUb[0] = CASE4_MARKER + 1;
    mainDynamicUb[MIXED_DYNAMIC_WORDS - 1] = CASE4_MARKER + MIXED_DYNAMIC_WORDS;
    WaitScalarToVector();
    asc_vf_call<SimdCase4Ub>(simdResult, CASE4_MARKER);
    WaitVectorToScalar();
    asc_vf_call<SimtCase4Ub>(dim3(THREAD_COUNT), simtResult, CASE4_MARKER);
    WaitVectorToScalar();

    result[0] = CASE4_MARKER;
    result[1] = MIXED_MAIN_STATIC_WORDS * sizeof(uint32_t) + MIXED_MAIN_STATIC_BYTES;
    result[2] = MIXED_SIMD_STATIC_WORDS * sizeof(uint32_t);
    result[3] = MIXED_SIMT_STATIC_WORDS * sizeof(uint32_t);
    result[4] = result[1] + result[2] + result[3];
    result[5] = MIXED_DYNAMIC_WORDS * sizeof(uint32_t);
    result[6] = MIXED_USER_UB_BYTES;
    result[7] = ((simdResult[1] == CASE4_MARKER + 1) && (simtResult[1] == CASE4_MARKER + 2) &&
                 (mainDynamicUb[0] == CASE4_MARKER + 3) &&
                 (mainStaticUb[MIXED_MAIN_STATIC_WORDS - 1] == CASE4_MARKER + MIXED_MAIN_STATIC_WORDS - 1) &&
                 (mainDynamicUb[MIXED_DYNAMIC_WORDS - 1] == CASE4_MARKER + MIXED_DYNAMIC_WORDS) &&
                 (simdResult[0] == CASE4_MARKER + MIXED_SIMD_STATIC_WORDS - 1) &&
                 (simtResult[0] == CASE4_MARKER + MIXED_SIMT_STATIC_WORDS - 1)) ?
                    1 :
                    0;
    CopyResultToGm(output, result);
}
#endif

void LaunchSelectedCase(aclrtStream stream, uint32_t* outputDevice)
{
#if SCENARIO_NUM == 0
    std::cout << "[Case0] static_bytes=" << BUFFER_BYTES << ", dynamic_bytes=" << VECTOR_ADD_REQUIRED_BYTES
              << ", overflow_bytes=" << CASE0_OVERFLOW_WORDS * sizeof(uint32_t) << std::endl;
    Case0StaticUbOobKernel<<<1, VECTOR_ADD_REQUIRED_BYTES, stream>>>(outputDevice, STATIC_WORDS);
#elif SCENARIO_NUM == 1
    NoVfStaticUbKernel<<<1, 0, stream>>>(outputDevice);
#elif SCENARIO_NUM == 2
#if defined(UB_BOUNDARY_NO_SIMD_VF)
    constexpr const char* mode = "without SIMD VF";
#else
    constexpr const char* mode = "with SIMD VF";
#endif
    std::cout << "[Case2] mode=" << mode << ", static_bytes=" << BOUNDARY_STATIC_BYTES << std::endl;
    Case2StaticUbBoundaryKernel<<<1, 0, stream>>>(outputDevice);
#elif SCENARIO_NUM == 3
    std::cout << "[Case3] max_dynamic_bytes=" << CASE3_MAX_DYNAMIC_BYTES
              << ", configured_dynamic_bytes=" << CASE3_CONFIGURED_DYNAMIC_BYTES << std::endl;
    SimtDynamicUbKernel<<<1, CASE3_CONFIGURED_DYNAMIC_BYTES, stream>>>(outputDevice);
#elif SCENARIO_NUM == 4
    std::cout << "[Case4] static_total_bytes=" << MIXED_STATIC_BYTES
              << ", max_dynamic_bytes=" << CASE4_MAX_DYNAMIC_BYTES
              << ", configured_dynamic_bytes=" << CASE4_CONFIGURED_DYNAMIC_BYTES << std::endl;
    MixedUbKernel<<<1, CASE4_CONFIGURED_DYNAMIC_BYTES, stream>>>(outputDevice);
#endif
}

bool VerifySelectedCase(const uint32_t* result, aclError launchRet, aclError syncRet)
{
    bool passed = false;
    if (syncRet == ACL_SUCCESS) {
#if SCENARIO_NUM == 0
        const uint32_t expectedFirst = CASE0_MARKER;
        uint32_t mismatchCount = 0;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t expected = CASE0_MARKER + 2 * index;
            mismatchCount += result[index] == expected ? 0 : 1;
        }
        passed = result[0] == CASE0_CORRUPTED_VALUE && result[0] != expectedFirst && mismatchCount == 1;
        std::cout << "[Case0] golden_first=0x" << std::hex << expectedFirst << ", actual_first=0x" << result[0]
                  << std::dec << std::endl;
        std::cout << "[Case0] mismatch_count=" << mismatchCount << std::endl;
#elif SCENARIO_NUM == 1
        passed = result[0] == CASE1_MARKER && result[1] == BUFFER_BYTES && result[2] == 0 && result[3] == result[5] &&
                 result[4] == result[6];
#elif SCENARIO_NUM == 2
        passed = result[0] == BOUNDARY_MARKER && result[2] == result[4] && result[3] == result[5];
        std::cout << "[Case2] first=0x" << std::hex << result[2] << ", last=0x" << result[3] << std::dec << std::endl;
#elif SCENARIO_NUM == 3
        passed = result[0] == CASE3_MARKER && result[1] == CASE3_CONFIGURED_DYNAMIC_BYTES &&
                 result[2] == CASE3_MAX_DYNAMIC_BYTES && result[3] == result[5] && result[4] == result[6];
#elif SCENARIO_NUM == 4
        const uint32_t expectedMainStaticBytes = MIXED_MAIN_STATIC_WORDS * sizeof(uint32_t) + MIXED_MAIN_STATIC_BYTES;
        const uint32_t expectedStaticTotalBytes = expectedMainStaticBytes + MIXED_SIMD_STATIC_WORDS * sizeof(uint32_t) +
                                                  MIXED_SIMT_STATIC_WORDS * sizeof(uint32_t);
        passed = result[0] == CASE4_MARKER && result[1] == expectedMainStaticBytes &&
                 result[2] == MIXED_SIMD_STATIC_WORDS * sizeof(uint32_t) &&
                 result[3] == MIXED_SIMT_STATIC_WORDS * sizeof(uint32_t) && result[4] == expectedStaticTotalBytes &&
                 result[5] == MIXED_DYNAMIC_WORDS * sizeof(uint32_t) && result[6] == MIXED_USER_UB_BYTES &&
                 result[7] == 1;
        std::cout << "Case 4 usage: static_total_bytes=" << result[4] << ", dynamic_bytes=" << result[5]
                  << ", dynamic_handoff=" << (result[7] == 1 ? "PASSED" : "FAILED") << std::endl;
#endif
    }

#if SCENARIO_NUM == 0
    std::cout << "[Case0] precision_check=" << (passed ? "FAILED (fault reproduced)" : "UNEXPECTED") << std::endl;
#elif SCENARIO_NUM == 1
    std::cout << "Case 1 (no VF static UB): " << (passed ? "PASSED" : "FAILED") << std::endl;
#elif SCENARIO_NUM == 2
    std::cout << "[Case2] launch_ret=" << static_cast<int32_t>(launchRet)
              << ", sync_ret=" << static_cast<int32_t>(syncRet) << ", result=" << (passed ? "PASSED" : "FAILED")
              << std::endl;
#elif SCENARIO_NUM == 3
    std::cout << "Case 3 (SIMT VF dynamic UB): " << (passed ? "PASSED" : "FAILED") << std::endl;
#elif SCENARIO_NUM == 4
    std::cout << "Case 4 (mixed UB): " << (passed ? "PASSED" : "FAILED") << std::endl;
#endif
    return passed;
}

int32_t RunSelectedCase()
{
#if SCENARIO_NUM == 0
    constexpr size_t outputBytes = BUFFER_BYTES;
#else
    constexpr size_t outputBytes = RESULT_BYTES_PER_CASE;
#endif
    uint8_t* outputHost = nullptr;
    uint32_t* outputDevice = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), outputBytes);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    LaunchSelectedCase(stream, outputDevice);
    aclError launchRet = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError syncRet = (launchRet == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launchRet;
    if (syncRet == ACL_SUCCESS) {
        aclrtMemcpy(outputHost, outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = VerifySelectedCase(reinterpret_cast<uint32_t*>(outputHost), launchRet, syncRet);

    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main() { return RunSelectedCase(); }
