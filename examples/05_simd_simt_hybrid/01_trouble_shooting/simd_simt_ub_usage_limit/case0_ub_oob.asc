/* !
 * \file case0_ub_oob.asc
 * \brief Reproduces a UB out-of-bounds write that corrupts SIMT Data Cache.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t CASE0_WORKSPACE_BYTES = USER_UB_BYTES_WITH_SIMT;
constexpr uint32_t CASE0_WORKSPACE_WORDS = CASE0_WORKSPACE_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE0_WORKSPACE_BLOCK_COUNT = 4;
constexpr uint32_t CASE0_WORKSPACE_BLOCK_WORDS = CASE0_WORKSPACE_WORDS / CASE0_WORKSPACE_BLOCK_COUNT;
constexpr uint32_t CASE0_FEATURE_OFFSET = 512;
constexpr uint32_t CASE0_SCORE_OFFSET = 4864;
constexpr uint32_t CASE0_OUTPUT_OFFSET = 9216;
constexpr uint32_t CASE0_FAULT_TILE_ID = 3;
constexpr uint32_t CASE0_FAULT_LANE_ID = 0;
constexpr uint32_t CASE0_MARKER = 0xC0000000;
}

__simt_vf__ __launch_bounds__(256) inline void simt_case0_prepare_tile_workspace(
    __gm__ const uint32_t* feature, __ubuf__ uint32_t* workspace, uint32_t tile_id)
{
    const uint32_t block_base =
        (tile_id & (CASE0_WORKSPACE_BLOCK_COUNT - 1)) * CASE0_WORKSPACE_BLOCK_WORDS;
    for (uint32_t step = 0; step < 4; ++step) {
        const uint32_t lane = threadIdx.x + step * blockDim.x;
        workspace[block_base + CASE0_FEATURE_OFFSET + lane] = feature[lane];
        workspace[block_base + CASE0_SCORE_OFFSET + lane] = feature[lane] & 0xff;
    }
}

__simt_vf__ __launch_bounds__(128) inline void simt_case0_fuse_score(__ubuf__ uint32_t* workspace, uint32_t tile_id)
{
    const uint32_t block_base =
        (tile_id & (CASE0_WORKSPACE_BLOCK_COUNT - 1)) * CASE0_WORKSPACE_BLOCK_WORDS;
    const uint32_t lane = threadIdx.x;
    workspace[block_base + CASE0_OUTPUT_OFFSET + lane] =
        workspace[block_base + CASE0_FEATURE_OFFSET + lane] +
        workspace[block_base + CASE0_SCORE_OFFSET + lane];
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_case0_store_compressed_kv(
    __gm__ const uint32_t* feature, __ubuf__ uint32_t* workspace, __gm__ uint32_t* output,
    uint32_t word_count, uint32_t tile_id)
{
    const uint32_t block_base =
        (tile_id & (CASE0_WORKSPACE_BLOCK_COUNT - 1)) * CASE0_WORKSPACE_BLOCK_WORDS;
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        const uint32_t score = workspace[block_base + CASE0_SCORE_OFFSET + index];
        output[index] = feature[index] + score;
    }
}

__aicore__ inline uint32_t case0_calc_score_word_offset(uint32_t tile_id, uint32_t lane_id)
{
    const uint32_t wrong_block_words =
        (CASE0_WORKSPACE_BYTES + RESERVED_UB_BYTES) / CASE0_WORKSPACE_BLOCK_COUNT / sizeof(uint32_t);
    return (tile_id & (CASE0_WORKSPACE_BLOCK_COUNT - 1)) * wrong_block_words + wrong_block_words + lane_id;
}

// Case 0: an invalid static UB access reaches the SIMT Data Cache and corrupts cached GM data.
__global__ __vector__ void case0_static_ub_oob_kernel(
    __gm__ const uint32_t* feature, __gm__ uint32_t* output, uint32_t tile_id, uint32_t lane_id)
{
    __ubuf__ uint32_t workspace[CASE0_WORKSPACE_WORDS];

    // 压缩预填充场景按tile复用工作区，每个tile分块保存feature、score和压缩KV中间结果。
    asc_vf_call<simt_case0_prepare_tile_workspace>(dim3(256), feature, workspace, tile_id);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    asc_vf_call<simt_case0_fuse_score>(dim3(128), workspace, tile_id);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    const uint32_t score_word_offset = case0_calc_score_word_offset(tile_id, lane_id);
#if defined(CASE0_ENABLE_FIX)
    if (score_word_offset < CASE0_WORKSPACE_WORDS) {
        workspace[score_word_offset] = CORRUPTED_VALUE;
    }
#else
    // 错误偏移计算误把预留空间计入工作区分块大小，最后写到Data Cache起点。
    workspace[score_word_offset] = CORRUPTED_VALUE;
#endif
    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);

    // 后续SIMT阶段读取GM特征和工作区score生成压缩KV输出；如果Data Cache被破坏，输出精度会异常。
    asc_vf_call<simt_case0_store_compressed_kv>(dim3(THREAD_COUNT), feature, workspace, output,
                                                BUFFER_WORDS, tile_id);
}

void launch_case0_kernel(aclrtStream stream, uint32_t* output_device, const uint32_t* input_device)
{
#if defined(CASE0_ENABLE_FIX)
    constexpr const char* MODE = "fixed";
#else
    constexpr const char* MODE = "fault";
#endif
    const uint32_t wrong_block_words =
        (CASE0_WORKSPACE_BYTES + RESERVED_UB_BYTES) / CASE0_WORKSPACE_BLOCK_COUNT / sizeof(uint32_t);
    const uint32_t faulty_word_offset =
        (CASE0_FAULT_TILE_ID & (CASE0_WORKSPACE_BLOCK_COUNT - 1)) * wrong_block_words + wrong_block_words +
        CASE0_FAULT_LANE_ID;
    std::cout << "[Case0] mode=" << MODE
              << ", faulty_byte_offset=" << faulty_word_offset * sizeof(uint32_t) << std::endl;
    case0_static_ub_oob_kernel<<<1, 0, stream>>>(
        input_device, output_device, CASE0_FAULT_TILE_ID, CASE0_FAULT_LANE_ID);
}

bool verify_case0_result(const uint32_t* result, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
        uint32_t first_mismatch_index = BUFFER_WORDS;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t input = CASE0_MARKER + index;
            const uint32_t expected = input + (input & 0xff);
            if (result[index] != expected) {
                first_mismatch_index = index;
                break;
            }
        }
#if defined(CASE0_ENABLE_FIX)
        passed = first_mismatch_index == BUFFER_WORDS;
#else
        passed = first_mismatch_index != BUFFER_WORDS;
#endif
        if (first_mismatch_index < BUFFER_WORDS) {
            const uint32_t input = CASE0_MARKER + first_mismatch_index;
            std::cout << "[Case0] first_mismatch_index=" << first_mismatch_index << ", expected=0x"
                      << std::hex << input + (input & 0xff) << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
    }
#if defined(CASE0_ENABLE_FIX)
    std::cout << "[Case0] precision_check=" << (passed ? "PASSED (out-of-bounds write blocked)" : "FAILED")
              << std::endl;
#else
    std::cout << "[Case0] precision_check=" << (passed ? "FAILED (fault reproduced)" : "UNEXPECTED") << std::endl;
#endif
    return passed;
}

int32_t run_selected_case()
{
    std::vector<uint32_t> input(BUFFER_WORDS);
    for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
        input[index] = CASE0_MARKER + index;
    }

    uint8_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), BUFFER_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, BUFFER_BYTES, input.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    launch_case0_kernel(stream, output_device, input_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, BUFFER_BYTES, output_device, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = verify_case0_result(reinterpret_cast<uint32_t*>(output_host), sync_ret);

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main()
{
    return run_selected_case();
}
