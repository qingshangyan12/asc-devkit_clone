/* !
 * \file case0_ub_oob.asc
 * \brief Reproduces a UB out-of-bounds write that corrupts SIMT Data Cache.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t UB_BYTES = USER_UB_BYTES_WITH_SIMT;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);
constexpr uint32_t TILE_COUNT = 4;
constexpr uint32_t TILE_WORDS = UB_WORDS / TILE_COUNT;
constexpr uint32_t SAMPLE_OFFSET = 512;
constexpr uint32_t BIAS_OFFSET = 4864;
constexpr uint32_t TARGET_TILE_ID = 3;
constexpr uint32_t TARGET_LANE_ID = 0;
constexpr uint32_t INPUT_BASE_VALUE = 0xC0000000;
}

__simt_vf__ __launch_bounds__(256) inline void simt_prepare_static_ub(
    __gm__ const uint32_t* sample, __ubuf__ uint32_t* static_ub, uint32_t tile_id)
{
    const uint32_t tile_base =
        (tile_id & (TILE_COUNT - 1)) * TILE_WORDS;
    for (uint32_t step = 0; step < 4; ++step) {
        const uint32_t lane = threadIdx.x + step * blockDim.x;
        static_ub[tile_base + SAMPLE_OFFSET + lane] = sample[lane];
        static_ub[tile_base + BIAS_OFFSET + lane] = sample[lane] & 0xff;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_store_calibrated_output(
    __gm__ const uint32_t* sample, __ubuf__ uint32_t* static_ub, __gm__ uint32_t* output,
    uint32_t word_count, uint32_t tile_id)
{
    const uint32_t tile_base =
        (tile_id & (TILE_COUNT - 1)) * TILE_WORDS;
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        const uint32_t bias = static_ub[tile_base + BIAS_OFFSET + index];
        output[index] = sample[index] + bias;
    }
}

__aicore__ inline uint32_t calc_bias_word_offset(uint32_t tile_id, uint32_t lane_id)
{
    const uint32_t tile_stride_words =
        (UB_BYTES + RESERVED_UB_BYTES) / TILE_COUNT / sizeof(uint32_t);
    return (tile_id & (TILE_COUNT - 1)) * tile_stride_words + tile_stride_words + lane_id;
}

// Case 0: an invalid static UB access reaches the SIMT Data Cache and corrupts cached GM data.
__global__ __vector__ void static_ub_oob_kernel(
    __gm__ const uint32_t* sample, __gm__ uint32_t* output, uint32_t tile_id, uint32_t lane_id)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    // 按tile_id选择静态UB临时区域，保存原始采样值sample并生成校准增量bias数据。
    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_prepare_static_ub>(dim3(256), sample, static_ub, tile_id);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    const uint32_t bias_word_offset = calc_bias_word_offset(tile_id, lane_id);
#if defined(CASE0_ENABLE_FIX)
    if (bias_word_offset < UB_WORDS) {
        static_ub[bias_word_offset] = CORRUPTED_VALUE;
    }
#else
    static_ub[bias_word_offset] = CORRUPTED_VALUE;
#endif
    asc_unlock(PIPE_S, mutex_id);

    // 后续SIMT阶段读取sample和bias数据生成校准输出；如果Data Cache被破坏，输出精度会异常。
    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_store_calibrated_output>(
        dim3(THREAD_COUNT), sample, static_ub, output, BUFFER_WORDS, tile_id);
    asc_unlock(PIPE_V, mutex_id);
}

void launch_kernel(aclrtStream stream, uint32_t* output_device, const uint32_t* input_device)
{
#if defined(CASE0_ENABLE_FIX)
    constexpr const char* MODE = "fixed";
#else
    constexpr const char* MODE = "baseline";
#endif
    const uint32_t tile_stride_words =
        (UB_BYTES + RESERVED_UB_BYTES) / TILE_COUNT / sizeof(uint32_t);
    const uint32_t access_word_offset =
        (TARGET_TILE_ID & (TILE_COUNT - 1)) * tile_stride_words + tile_stride_words +
        TARGET_LANE_ID;
    std::cout << "[Case0] mode=" << MODE
              << ", access_byte_offset=" << access_word_offset * sizeof(uint32_t) << std::endl;
    static_ub_oob_kernel<<<1, 0, stream>>>(
        input_device, output_device, TARGET_TILE_ID, TARGET_LANE_ID);
}

bool verify_result(const uint32_t* result, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
        uint32_t first_mismatch_index = BUFFER_WORDS;
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t input = INPUT_BASE_VALUE + index;
            const uint32_t expected = input + (input & 0xff);
            if (result[index] != expected) {
                first_mismatch_index = index;
                break;
            }
        }
#if defined(CASE0_ENABLE_FIX)
        passed = first_mismatch_index == BUFFER_WORDS;
#else
        passed = first_mismatch_index != BUFFER_WORDS;
#endif
        if (first_mismatch_index < BUFFER_WORDS) {
            const uint32_t input = INPUT_BASE_VALUE + first_mismatch_index;
            std::cout << "[Case0] corrupted_output: expected=0x"
                      << std::hex << input + (input & 0xff) << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
    }
#if defined(CASE0_ENABLE_FIX)
    std::cout << "[Case0] precision_check=" << (passed ? "PASSED (out-of-bounds write blocked)" : "FAILED")
              << std::endl;
#else
    std::cout << "[Case0] precision_check=" << (passed ? "FAILED (fault reproduced)" : "UNEXPECTED") << std::endl;
#endif
    return passed;
}

int32_t run_selected_case()
{
    std::vector<uint32_t> input(BUFFER_WORDS);
    for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
        input[index] = INPUT_BASE_VALUE + index;
    }

    uint8_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), BUFFER_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, BUFFER_BYTES, input.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    launch_kernel(stream, output_device, input_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, BUFFER_BYTES, output_device, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = verify_result(reinterpret_cast<uint32_t*>(output_host), sync_ret);

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main()
{
    return run_selected_case();
}
