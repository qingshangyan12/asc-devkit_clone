/* !
 * \file case3_oob_result.asc
 * \brief Observes runtime and accuracy results when out-of-bounds UB writes reach different UB regions.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t CASE3_STATIC_BYTES = 4 * 1024;
constexpr uint32_t CASE3_STATIC_WORDS = CASE3_STATIC_BYTES / sizeof(uint32_t);
constexpr uint32_t CASE3_VF_RESERVED_BYTES = 6 * 1024;
constexpr uint32_t CASE3_ASC_RESERVED_BYTES = 2 * 1024;
constexpr uint32_t CASE3_DCACHE_BYTES = 128 * 1024;
constexpr uint32_t CASE3_RESERVED_START_BYTES =
    UB_TOTAL_BYTES - CASE3_DCACHE_BYTES - CASE3_VF_RESERVED_BYTES - CASE3_ASC_RESERVED_BYTES;
constexpr uint32_t CASE3_MARKER = 0xC0030000;
constexpr uint32_t CASE3_ACCESS_OFFSETS[] = {
    // 静态UB合法范围内的最后一个uint32_t元素。
    CASE3_STATIC_BYTES - sizeof(uint32_t),
    // 已申请静态UB之后、预留空间之前的未申请UB范围中部。
    (CASE3_STATIC_BYTES + CASE3_RESERVED_START_BYTES) / 2,
    // 6KB VF预留范围中部。
    CASE3_RESERVED_START_BYTES + CASE3_VF_RESERVED_BYTES / 2,
    // 2KB Ascend C API预留范围中部。
    CASE3_RESERVED_START_BYTES + CASE3_VF_RESERVED_BYTES + CASE3_ASC_RESERVED_BYTES / 2,
    // Data Cache起始位置。
    UB_TOTAL_BYTES - CASE3_DCACHE_BYTES,
};
constexpr uint32_t CASE3_ACCESS_OFFSET_BYTES = CASE3_ACCESS_OFFSETS[CASE3_ACCESS_REGION];
static_assert(CASE3_ACCESS_REGION >= 0 && CASE3_ACCESS_REGION <= 4, "Case 3 access region must be in [0, 4]");
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_case3_add_one(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t word_count)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        output[index] = input[index] + 1;
    }
}

// Case 3通过运行时下标访问不同UB区域，观察静态数组越界后的运行和精度结果。
__global__ __vector__ void case3_static_ub_oob_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t access_index)
{
    __ubuf__ uint32_t static_ub[CASE3_STATIC_WORDS];

    asc_vf_call<simt_case3_add_one>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    // access_index由Host侧按字节偏移换算得到，volatile用于保留这次观察访问。
    __ubuf__ volatile uint32_t* static_data = static_ub;
    static_data[access_index] = CORRUPTED_VALUE;
    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);

    asc_vf_call<simt_case3_add_one>(dim3(THREAD_COUNT), input, output, BUFFER_WORDS);
}

void launch_case3_kernel(aclrtStream stream, uint32_t* output_device, const uint32_t* input_device)
{
    constexpr const char* REGION_NAMES[] = {"static_ub", "unallocated_ub", "vf_reserved", "asc_reserved", "data_cache"};
    std::cout << "[Case3] region=" << REGION_NAMES[CASE3_ACCESS_REGION]
              << ", access_offset_bytes=" << CASE3_ACCESS_OFFSET_BYTES << std::endl;
    case3_static_ub_oob_kernel<<<1, 0, stream>>>(
        input_device, output_device, CASE3_ACCESS_OFFSET_BYTES / sizeof(uint32_t));
}

bool verify_case3_result(const uint32_t* result, aclError launch_ret, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
        uint32_t first_mismatch_index = BUFFER_WORDS;
        // Case3用于观察越界写入不同UB区域后的精度结果，运行完成不代表访问合法。
        for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
            const uint32_t expected = CASE3_MARKER + index + 1;
            if (result[index] != expected) {
                first_mismatch_index = index;
                break;
            }
        }
        passed = sync_ret == ACL_SUCCESS;
        if (first_mismatch_index < BUFFER_WORDS) {
            std::cout << "[Case3] first_mismatch_index=" << first_mismatch_index << ", expected=0x" << std::hex
                      << CASE3_MARKER + first_mismatch_index + 1 << ", actual=0x" << result[first_mismatch_index]
                      << std::dec << std::endl;
        }
        std::cout << "[Case3] precision_check="
                  << (first_mismatch_index == BUFFER_WORDS ? "PASSED" : "FAILED") << std::endl;
    }
    if (!passed) {
        std::cout << "[Case3] launch_ret=" << static_cast<int32_t>(launch_ret)
                  << ", sync_ret=" << static_cast<int32_t>(sync_ret) << std::endl;
    }
    std::cout << "[Case3] runtime_check=" << (passed ? "PASSED" : "FAILED") << std::endl;
    return passed;
}

int32_t run_selected_case()
{
    std::vector<uint32_t> input(BUFFER_WORDS);
    for (uint32_t index = 0; index < BUFFER_WORDS; ++index) {
        input[index] = CASE3_MARKER + index;
    }

    uint8_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), BUFFER_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, BUFFER_BYTES, input.data(), BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    launch_case3_kernel(stream, output_device, input_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, BUFFER_BYTES, output_device, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = verify_case3_result(reinterpret_cast<uint32_t*>(output_host), launch_ret, sync_ret);

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main()
{
    return run_selected_case();
}
