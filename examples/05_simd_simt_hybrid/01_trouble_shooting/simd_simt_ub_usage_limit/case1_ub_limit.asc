/* !
 * \file case1_ub_limit.asc
 * \brief Measures usable UB limits under different VF configurations.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t FILL_VALUE_BASE = 0xC0010000;
constexpr uint32_t UB_BYTES = UB_LIMIT_BYTES;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);

#if defined(UB_LIMIT_WITH_SIMT_VF)
constexpr uint32_t VF_RESERVED_BYTES =
#if defined(UB_LIMIT_DISABLE_VF_RESERVED)
    0;
#else
    6 * 1024;
#endif
constexpr uint32_t ASC_RESERVED_BYTES =
#if defined(UB_LIMIT_DISABLE_ASC_RESERVED)
    0;
#else
    2 * 1024;
#endif
constexpr uint32_t AVAILABLE_BYTES = UB_TOTAL_BYTES - VF_RESERVED_BYTES -
                                           ASC_RESERVED_BYTES -
                                           MIN_SIMT_DATA_CACHE_BYTES;
#endif

static_assert(UB_BYTES % sizeof(uint32_t) == 0, "Case 1 UB size must be a multiple of 4 bytes");
static_assert(UB_WORDS > 0, "Case 1 UB size must be greater than zero");
}

#if !defined(UB_LIMIT_WITH_SIMT_VF)
__simd_vf__ inline void simd_fill_static_ub(__ubuf__ uint32_t* static_ub, uint32_t word_count)
{
    for (uint32_t index = 0; index < word_count; ++index) {
        static_ub[index] = FILL_VALUE_BASE + index;
    }
}

// Case 1 measures the usable UB limit under different SIMD VF configurations.
__global__ __vector__ void ub_limit_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

#if defined(UB_LIMIT_NO_SIMD_VF)
    for (uint32_t index = 0; index < UB_WORDS; ++index) {
        static_ub[index] = FILL_VALUE_BASE + index;
    }
#else
    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simd_fill_static_ub>(static_ub, UB_WORDS);
    asc_unlock(PIPE_V, mutex_id);
    asc_lock(PIPE_S, mutex_id);
#endif

    output[0] = static_ub[0];
    output[1] = static_ub[UB_WORDS - 1];
#if !defined(UB_LIMIT_NO_SIMD_VF)
    asc_unlock(PIPE_S, mutex_id);
#endif
}
#endif

#if defined(UB_LIMIT_WITH_SIMT_VF)
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_fill_static_ub(
    __ubuf__ uint32_t* static_ub, uint32_t word_count, uint32_t value_base)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        static_ub[index] = value_base + index;
    }
}

// Case 1 measures the usable UB limit with a SIMT VF.
__global__ __vector__ void simt_ub_limit_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_fill_static_ub>(dim3(THREAD_COUNT), static_ub, UB_WORDS, FILL_VALUE_BASE);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    output[0] = static_ub[0];
    output[1] = static_ub[UB_WORDS - 1];
    asc_unlock(PIPE_S, mutex_id);
}
#endif

void launch_kernel(aclrtStream stream, uint32_t* output_device)
{
#if defined(UB_LIMIT_WITH_SIMT_VF)
    std::cout << "[Case1] mode=with SIMT VF, ub_limit_bytes=" << AVAILABLE_BYTES;
    if (UB_BYTES != AVAILABLE_BYTES) {
        std::cout << ", configured_ub_bytes=" << UB_BYTES;
    }
    std::cout << std::endl;
    simt_ub_limit_kernel<<<1, 0, stream>>>(output_device);
#else
#if defined(UB_LIMIT_NO_SIMD_VF)
    constexpr const char* MODE = "without SIMD VF";
#else
    constexpr const char* MODE = "with SIMD VF";
#endif
    std::cout << "[Case1] mode=" << MODE << ", ub_limit_bytes=" << UB_BYTES << std::endl;
    ub_limit_kernel<<<1, 0, stream>>>(output_device);
#endif
}

bool verify_result(const uint32_t* result, aclError launch_ret, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
        passed = result[0] == FILL_VALUE_BASE && result[1] == FILL_VALUE_BASE + UB_WORDS - 1;
    }
    if (!passed) {
        std::cout << "[Case1] launch_ret=" << static_cast<int32_t>(launch_ret)
                  << ", sync_ret=" << static_cast<int32_t>(sync_ret) << std::endl;
    }
    std::cout << "[Case1] result=" << (passed ? "PASSED" : "FAILED") << std::endl;
    return passed;
}

int32_t run_selected_case()
{
    uint8_t* output_host = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), RESULT_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), RESULT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    launch_kernel(stream, output_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, RESULT_BYTES, output_device, RESULT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = verify_result(reinterpret_cast<uint32_t*>(output_host), launch_ret, sync_ret);

    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main()
{
    return run_selected_case();
}
