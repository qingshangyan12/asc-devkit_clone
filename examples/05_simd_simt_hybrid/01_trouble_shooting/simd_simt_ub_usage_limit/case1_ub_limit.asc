/* !
 * \file case1_ub_limit.asc
 * \brief Measures usable UB limits under different VF configurations.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t CASE1_MARKER = 0xC0010000;
constexpr uint32_t UB_LIMIT_CONFIGURED_BYTES = UB_LIMIT_BYTES;
constexpr uint32_t UB_LIMIT_WORDS = UB_LIMIT_CONFIGURED_BYTES / sizeof(uint32_t);

#if defined(UB_LIMIT_WITH_SIMT_VF)
constexpr uint32_t UB_LIMIT_VF_RESERVED_BYTES =
#if defined(UB_LIMIT_DISABLE_VF_RESERVED)
    0;
#else
    6 * 1024;
#endif
constexpr uint32_t UB_LIMIT_ASC_RESERVED_BYTES =
#if defined(UB_LIMIT_DISABLE_ASC_RESERVED)
    0;
#else
    2 * 1024;
#endif
constexpr uint32_t UB_LIMIT_ARRAY_LIMIT_BYTES = UB_TOTAL_BYTES - UB_LIMIT_VF_RESERVED_BYTES -
                                                UB_LIMIT_ASC_RESERVED_BYTES -
                                                MIN_SIMT_DATA_CACHE_BYTES;
#endif

static_assert(UB_LIMIT_CONFIGURED_BYTES % sizeof(uint32_t) == 0, "Case 1 UB size must be a multiple of 4 bytes");
static_assert(UB_LIMIT_WORDS > 0, "Case 1 UB size must be greater than zero");
}

#if !defined(UB_LIMIT_WITH_SIMT_VF)
__simd_vf__ inline void simd_fill_ub_limit(__ubuf__ uint32_t* ub_buffer, uint32_t word_count)
{
    for (uint32_t index = 0; index < word_count; ++index) {
        ub_buffer[index] = CASE1_MARKER + index;
    }
}

// Case 1 measures the usable UB limit under different SIMD VF configurations.
__global__ __vector__ void case1_ub_limit_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t ub_buffer[UB_LIMIT_WORDS];

#if defined(UB_LIMIT_NO_SIMD_VF)
    for (uint32_t index = 0; index < UB_LIMIT_WORDS; ++index) {
        ub_buffer[index] = CASE1_MARKER + index;
    }
#else
    asc_vf_call<simd_fill_ub_limit>(ub_buffer, UB_LIMIT_WORDS);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
#endif

    output[0] = ub_buffer[0];
    output[1] = ub_buffer[UB_LIMIT_WORDS - 1];
}
#endif

#if defined(UB_LIMIT_WITH_SIMT_VF)
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_fill_ub_limit(
    __ubuf__ uint32_t* ub, uint32_t word_count, uint32_t marker)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        ub[index] = marker + index;
    }
}

// Case 1 measures the usable UB limit with a SIMT VF.
__global__ __vector__ void simt_ub_limit_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t ub_buffer[UB_LIMIT_WORDS];

    asc_vf_call<simt_fill_ub_limit>(dim3(THREAD_COUNT), ub_buffer, UB_LIMIT_WORDS, CASE1_MARKER);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    output[0] = ub_buffer[0];
    output[1] = ub_buffer[UB_LIMIT_WORDS - 1];
}
#endif

void launch_case1_kernel(aclrtStream stream, uint32_t* output_device)
{
#if defined(UB_LIMIT_WITH_SIMT_VF)
    std::cout << "[Case1] mode=with SIMT VF, ub_limit_bytes=" << UB_LIMIT_ARRAY_LIMIT_BYTES
              << ", configured_ub_bytes=" << UB_LIMIT_CONFIGURED_BYTES << std::endl;
    simt_ub_limit_kernel<<<1, 0, stream>>>(output_device);
#else
#if defined(UB_LIMIT_NO_SIMD_VF)
    constexpr const char* MODE = "without SIMD VF";
#else
    constexpr const char* MODE = "with SIMD VF";
#endif
    std::cout << "[Case1] mode=" << MODE << ", ub_limit_bytes=" << UB_LIMIT_CONFIGURED_BYTES << std::endl;
    case1_ub_limit_kernel<<<1, 0, stream>>>(output_device);
#endif
}

bool verify_case1_result(const uint32_t* result, aclError launch_ret, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
        passed = result[0] == CASE1_MARKER && result[1] == CASE1_MARKER + UB_LIMIT_WORDS - 1;
        std::cout << "[Case1] first=0x" << std::hex << result[0] << ", last=0x" << result[1] << std::dec
                  << std::endl;
    }
    std::cout << "[Case1] launch_ret=" << static_cast<int32_t>(launch_ret)
              << ", sync_ret=" << static_cast<int32_t>(sync_ret) << ", result=" << (passed ? "PASSED" : "FAILED")
              << std::endl;
    return passed;
}

int32_t run_selected_case()
{
    uint8_t* output_host = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), RESULT_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), RESULT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    launch_case1_kernel(stream, output_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, RESULT_BYTES, output_device, RESULT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = verify_case1_result(reinterpret_cast<uint32_t*>(output_host), launch_ret, sync_ret);

    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main()
{
    return run_selected_case();
}
