/* !
 * \file case1_ub_limit.asc
 * \brief Measures usable UB limits under different VF configurations.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t FILL_VALUE_BASE = 0xC0010000;
// CASE1_VF_RESERVED_BYTES为0或6KB；CASE1_ASC_RESERVED_BYTES为0或2KB。
// CASE1_DATA_CACHE_BYTES为0或32KB；CASE1_EXTRA_BYTES用于在上限基础上多申请4B。
constexpr uint32_t UB_BYTES = UB_TOTAL_BYTES - CASE1_VF_RESERVED_BYTES -
                              CASE1_ASC_RESERVED_BYTES - CASE1_DATA_CACHE_BYTES +
                              CASE1_EXTRA_BYTES;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);

static_assert(UB_BYTES % sizeof(uint32_t) == 0, "Case 1 UB size must be a multiple of 4 bytes");
static_assert(UB_WORDS > 0, "Case 1 UB size must be greater than zero");
}

#if defined(CASE1_SIMD_VF) || defined(CASE1_USE_BOTH_VF)
__simd_vf__ inline void simd_fill_static_ub(__ubuf__ uint32_t* static_ub, uint32_t word_count)
{
    for (uint32_t index = 0; index < word_count; ++index) {
        static_ub[index] = FILL_VALUE_BASE + index;
    }
}
#endif

#if defined(CASE1_USE_SIMT_VF) || defined(CASE1_USE_BOTH_VF)
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_fill_static_ub(
    __ubuf__ uint32_t* static_ub, uint32_t word_count, uint32_t value_base)
{
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        static_ub[index] = value_base + index;
    }
}
#endif

#if defined(CASE1_NO_VF)
// Case 1场景1：不调用VF，验证UB最大可用上限。
__global__ __vector__ void ub_limit_main_scalar_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];

    for (uint32_t index = 0; index < UB_WORDS; ++index) {
        static_ub[index] = FILL_VALUE_BASE + index;
    }
    output[0] = static_ub[UB_WORDS - 1];
}
#endif

#if defined(CASE1_SIMD_VF)
// Case 1场景2：仅调用SIMD VF，验证UB最大可用上限。
__global__ __vector__ void ub_limit_simd_vf_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simd_fill_static_ub>(static_ub, UB_WORDS);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    output[0] = static_ub[UB_WORDS - 1];
    asc_unlock(PIPE_S, mutex_id);
}
#endif

#if defined(CASE1_USE_SIMT_VF)
// Case 1场景3：仅调用SIMT VF，验证UB最大可用上限。
__global__ __vector__ void ub_limit_simt_vf_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_fill_static_ub>(dim3(THREAD_COUNT), static_ub, UB_WORDS, FILL_VALUE_BASE);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    output[0] = static_ub[UB_WORDS - 1];
    asc_unlock(PIPE_S, mutex_id);
}
#endif

#if defined(CASE1_USE_BOTH_VF)
// Case 1场景4：同时调用SIMD VF和SIMT VF，验证UB最大可用上限。
__global__ __vector__ void ub_limit_simd_simt_vf_kernel(__gm__ uint32_t* output)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simd_fill_static_ub>(static_ub, UB_WORDS);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_fill_static_ub>(dim3(THREAD_COUNT), static_ub, UB_WORDS, FILL_VALUE_BASE);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    output[0] = static_ub[UB_WORDS - 1];
    asc_unlock(PIPE_S, mutex_id);
}
#endif

int32_t main()
{
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);

#if defined(CASE1_NO_VF)
    ub_limit_main_scalar_kernel<<<1, 0, stream>>>(output_device);
#elif defined(CASE1_SIMD_VF)
    ub_limit_simd_vf_kernel<<<1, 0, stream>>>(output_device);
#elif defined(CASE1_USE_SIMT_VF)
    ub_limit_simt_vf_kernel<<<1, 0, stream>>>(output_device);
#else
    ub_limit_simd_simt_vf_kernel<<<1, 0, stream>>>(output_device);
#endif

    aclError sync_ret = aclrtSynchronizeStream(stream);
    const char* err = aclGetRecentErrMsg();
    bool passed = sync_ret == ACL_SUCCESS && err == nullptr;
    if (err != nullptr) {
        fprintf(stderr, "[Host] kernel error: %s\n", err);
    } else if (passed) {
        std::cout << "[Case1] result=PASSED" << std::endl;
    }

    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
