/* !
 * \file case2_ub_layout.asc
 * \brief Observes static and dynamic UB layout across MainScalar, SIMD VF, and SIMT VF.
 */

#include "ub_usage_limit_common.h"

namespace {
constexpr uint32_t CASE2_MAIN_STATIC_WORDS = 256;
constexpr uint32_t CASE2_SIMD_STATIC_WORDS = 512;
constexpr uint32_t CASE2_SIMT_STATIC_WORDS = THREAD_COUNT;
constexpr uint32_t CASE2_MARKER = 0xC0020000;
constexpr uint32_t CASE2_STATIC_BYTES =
    (CASE2_MAIN_STATIC_WORDS + CASE2_SIMD_STATIC_WORDS + CASE2_SIMT_STATIC_WORDS) * sizeof(uint32_t);
constexpr uint32_t CASE2_MAIN_STATIC_ADDR = 0;
constexpr uint32_t CASE2_SIMD_STATIC_ADDR = CASE2_MAIN_STATIC_WORDS * sizeof(uint32_t);
constexpr uint32_t CASE2_SIMT_STATIC_ADDR =
    (CASE2_MAIN_STATIC_WORDS + CASE2_SIMD_STATIC_WORDS) * sizeof(uint32_t);
constexpr uint32_t CASE2_DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - CASE2_STATIC_BYTES;
constexpr uint32_t CASE2_DYNAMIC_WORDS = CASE2_DYNAMIC_BYTES / sizeof(uint32_t);
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_case2_record_ub_addr(
    __ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simt_static_ub[CASE2_SIMT_STATIC_WORDS];
    extern __ubuf__ uint32_t simt_dynamic_ub[];
    for (uint32_t index = threadIdx.x; index < CASE2_SIMT_STATIC_WORDS; index += blockDim.x) {
        simt_static_ub[index] = marker + index;
    }
    if (threadIdx.x == 0) {
        simt_dynamic_ub[CASE2_DYNAMIC_WORDS - 1] = marker;
        // 读取数组尾部，确保该静态UB声明参与当前Kernel布局。
        const uint32_t tail_check = simt_static_ub[CASE2_SIMT_STATIC_WORDS - 1] -
                                    (marker + CASE2_SIMT_STATIC_WORDS - 1);
        // 写回SIMT VF中的静态UB和动态UB首地址。
        result[6] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simt_static_ub)) + tail_check;
        result[7] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simt_dynamic_ub));
    }
}

__simd_vf__ inline void simd_case2_record_ub_addr(__ubuf__ uint32_t* result, uint32_t marker)
{
    __ubuf__ uint32_t simd_static_ub[CASE2_SIMD_STATIC_WORDS];
    extern __ubuf__ uint32_t simd_dynamic_ub[];
    for (uint32_t index = 0; index < CASE2_SIMD_STATIC_WORDS; ++index) {
        simd_static_ub[index] = marker + index;
    }
    simd_dynamic_ub[CASE2_DYNAMIC_WORDS - 1] = marker;
    // 读取数组尾部，确保该静态UB声明参与当前Kernel布局。
    const uint32_t tail_check = simd_static_ub[CASE2_SIMD_STATIC_WORDS - 1] -
                                (marker + CASE2_SIMD_STATIC_WORDS - 1);
    // 写回SIMD VF中的静态UB和动态UB首地址。
    result[4] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simd_static_ub)) + tail_check;
    result[5] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simd_dynamic_ub));
}

// Case 2: MainScalar, SIMD VF, and SIMT VF static UB share the same pool with dynamic UB.
__global__ __vector__ void case2_ub_layout_kernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t main_dynamic_ub[];
    __ubuf__ uint32_t main_static_ub[CASE2_MAIN_STATIC_WORDS];

    for (uint32_t index = 0; index < CASE2_MAIN_STATIC_WORDS; ++index) {
        main_static_ub[index] = CASE2_MARKER + index;
    }
    main_dynamic_ub[CASE2_DYNAMIC_WORDS - 1] = CASE2_MARKER;
    asc_sync_notify(PIPE_S, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_S, PIPE_V, EVENT_ID0);
    asc_vf_call<simd_case2_record_ub_addr>(main_static_ub, CASE2_MARKER);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);
    asc_vf_call<simt_case2_record_ub_addr>(dim3(THREAD_COUNT), main_static_ub, CASE2_MARKER);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID0);

    main_static_ub[0] = CASE2_MARKER;
    main_static_ub[1] = CASE2_STATIC_BYTES;
    // 读取数组尾部，确保该静态UB声明参与当前Kernel布局。
    const uint32_t tail_check = main_static_ub[CASE2_MAIN_STATIC_WORDS - 1] -
                                (CASE2_MARKER + CASE2_MAIN_STATIC_WORDS - 1);
    // 写回MainScalar中的静态UB和动态UB首地址。
    main_static_ub[2] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(main_static_ub)) + tail_check;
    main_static_ub[3] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(main_dynamic_ub));
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, main_static_ub, 1, RESULT_BYTES, 0, 0, 0);
}

void launch_case2_kernel(aclrtStream stream, uint32_t* output_device)
{
    std::cout << "[Case2] static_total_bytes=" << CASE2_STATIC_BYTES << std::endl;
    case2_ub_layout_kernel<<<1, CASE2_DYNAMIC_BYTES, stream>>>(output_device);
}

bool verify_case2_result(const uint32_t* result, aclError sync_ret)
{
    bool passed = false;
    if (sync_ret == ACL_SUCCESS) {
        const uint32_t static_bytes = result[1];
        const uint32_t main_static_addr = result[2];
        const uint32_t main_dynamic_addr = result[3];
        const uint32_t simd_static_addr = result[4];
        const uint32_t simd_dynamic_addr = result[5];
        const uint32_t simt_static_addr = result[6];
        const uint32_t simt_dynamic_addr = result[7];
        const bool expected_static_addresses = main_static_addr == CASE2_MAIN_STATIC_ADDR &&
                                               simd_static_addr == CASE2_SIMD_STATIC_ADDR &&
                                               simt_static_addr == CASE2_SIMT_STATIC_ADDR;
        const bool same_dynamic_addr =
            main_dynamic_addr == simd_dynamic_addr && main_dynamic_addr == simt_dynamic_addr;
        passed = result[0] == CASE2_MARKER && expected_static_addresses && same_dynamic_addr &&
                 main_dynamic_addr == CASE2_STATIC_BYTES && static_bytes == CASE2_STATIC_BYTES;
        std::cout << "[Case2] main_static_ub=0x" << std::hex << main_static_addr
                  << ", simd_static_ub=0x" << simd_static_addr << ", simt_static_ub=0x" << simt_static_addr
                  << std::dec << std::endl;
        std::cout << "[Case2] main_dynamic_ub=0x" << std::hex << main_dynamic_addr
                  << ", simd_dynamic_ub=0x" << simd_dynamic_addr << ", simt_dynamic_ub=0x" << simt_dynamic_addr
                  << std::dec << std::endl;
    }
    std::cout << "[Case2] result=" << (passed ? "PASSED" : "FAILED") << std::endl;
    return passed;
}

int32_t run_selected_case()
{
    uint8_t* output_host = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), RESULT_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), RESULT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    launch_case2_kernel(stream, output_device);
    aclError launch_ret = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    aclError sync_ret = (launch_ret == ACL_SUCCESS) ? aclrtSynchronizeStream(stream) : launch_ret;
    if (sync_ret == ACL_SUCCESS) {
        aclrtMemcpy(output_host, RESULT_BYTES, output_device, RESULT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    bool passed = verify_case2_result(reinterpret_cast<uint32_t*>(output_host), sync_ret);

    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}

int32_t main()
{
    return run_selected_case();
}
