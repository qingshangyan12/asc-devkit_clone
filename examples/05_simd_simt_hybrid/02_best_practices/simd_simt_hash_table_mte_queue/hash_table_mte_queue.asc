/* !
 * \file hash_table_mte_queue.asc
 * \brief Fixed-capacity educational HashTable insert_or_assign benchmark.
 *        This sample is intentionally scoped to explain the optimization path and does not
 *        attempt to reproduce every production HashTable feature.
 *        SCENARIO_NUM=0: one SIMT warp probes the table and stores value elements directly.
 *        SCENARIO_NUM=1: SIMT probes the table, then an in-kernel MTE task queue writes value vectors.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"

#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <utility>
#include <vector>

#ifndef PROFILE_REPEAT_TIMES
#define PROFILE_REPEAT_TIMES 30
#endif

constexpr uint32_t scenarioNum = SCENARIO_NUM;
static_assert(scenarioNum == 0 || scenarioNum == 1, "SCENARIO_NUM must be 0 or 1");

namespace {
constexpr uint32_t THREAD_COUNT = 512;
constexpr uint32_t WARP_SIZE = 32;
constexpr uint32_t KEY_NUM = 128 * 1024;
constexpr uint32_t HASH_TABLE_CAPACITY = 256 * 1024;
constexpr uint32_t BLOCK_DIM = 64;
constexpr uint32_t PROFILE_REPEAT_TIMES_VALUE = PROFILE_REPEAT_TIMES;
constexpr uint32_t MTE_BATCH_SIZE = 32;
constexpr uint32_t MTE_LOCAL_VALUE_COUNT = MTE_BATCH_SIZE * 256;
constexpr uint32_t MTE_TASK_RING_CAPACITY = 128;
constexpr uint32_t MTE_TASK_RING_MASK = MTE_TASK_RING_CAPACITY - 1;
constexpr uint32_t UB_ALIGN_SIZE = 32;
constexpr uint32_t INVALID_BUCKET = 0xffffffffU;
constexpr int64_t EMPTY_KEY = 0;
constexpr int64_t LOCKED_KEY = -1;
constexpr uint32_t TEST_DIMS[] = {16, 32, 64, 128, 256};
} // namespace

#define CHECK_ACL(expr)                                                                                               \
    do {                                                                                                             \
        aclError ret = (expr);                                                                                       \
        if (ret != ACL_SUCCESS) {                                                                                    \
            std::cerr << "ACL call failed: " #expr << ", ret=" << static_cast<int32_t>(ret) << std::endl;           \
            std::exit(1);                                                                                            \
        }                                                                                                            \
    } while (0)

inline uint64_t hash_key_host(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

__simt_callee__ inline uint64_t hash_key_device(int64_t key)
{
    return static_cast<uint64_t>(key) * 11400714819323198485ULL;
}

// Wait for a temporarily locked slot to be published before probing further.
// This prevents another writer for the same key from skipping the locked slot and creating a duplicate entry.
__simt_callee__ inline int64_t wait_until_unlocked(__gm__ const int64_t* keyAddr)
{
    int64_t currentKey = *keyAddr;
    while (currentKey == LOCKED_KEY) {
        currentKey = *keyAddr;
    }
    return currentKey;
}

// Minimal device-side vector wrapper used by the host sample code.
template <typename T>
class device_vector {
public:
    using value_type = T;
    using size_type = size_t;

    explicit device_vector(size_type count) : count_(count)
    {
        if (count_ == 0) {
            return;
        }
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&data_), bytes(), ACL_MEM_MALLOC_HUGE_FIRST));
    }

    ~device_vector()
    {
        if (data_ != nullptr) {
            aclError ret = aclrtFree(data_);
            if (ret != ACL_SUCCESS) {
                std::cerr << "ACL call failed: aclrtFree, ret=" << static_cast<int32_t>(ret) << std::endl;
            }
        }
    }

    device_vector(const device_vector&) = delete;
    device_vector& operator=(const device_vector&) = delete;

    T* data()
    {
        return data_;
    }

    const T* data() const
    {
        return data_;
    }

    size_type size() const
    {
        return count_;
    }

    size_type bytes() const
    {
        return count_ * sizeof(T);
    }

    void copy_to(std::vector<T>& host) const
    {
        CHECK_ACL(aclrtMemcpy(host.data(), bytes(), data_, bytes(), ACL_MEMCPY_DEVICE_TO_HOST));
    }

    void fill_zero()
    {
        CHECK_ACL(aclrtMemset(data_, bytes(), 0, bytes()));
    }

private:
    T* data_ = nullptr;
    size_type count_ = 0;
};

// Fixed-capacity educational hash table used by this benchmark.
// It exposes a small STL-like surface while keeping storage on device memory,
// but intentionally omits production features that are unrelated to the MTE optimization path.
class unordered_map {
public:
    using key_type = int64_t;
    using mapped_type = float;
    using value_type = std::pair<key_type, mapped_type*>;
    using size_type = uint32_t;
    using insert_return_type = std::pair<size_type, bool>;

    // The key field is also the slot marker:
    // EMPTY_KEY means unused, LOCKED_KEY means a writer owns the slot, and any other value is a published key.
    struct alignas(32) bucket_type {
        key_type key;
        key_type padding[3];
    };

    unordered_map(size_type bucketCount, size_type mappedDim, aclrtStream stream);
    ~unordered_map() = default;

    unordered_map(const unordered_map&) = delete;
    unordered_map& operator=(const unordered_map&) = delete;

    // Reset all buckets and values to the empty-table contents.
    void clear();

    // Insert or update a contiguous key/value range. The benchmark uses a fixed KEY_NUM input size.
    // Kernels publish a real key only after the mapped value vector has been fully written.
    insert_return_type insert_or_assign(
        const key_type* firstKey, const key_type* lastKey, const mapped_type* firstMapped);

    // Copy device table storage back to host for full-result verification.
    void copy_to(std::vector<bucket_type>& buckets, std::vector<mapped_type>& values) const;

    size_type size() const
    {
        return size_;
    }

    size_type bucket_count() const
    {
        return bucketCount_;
    }

    size_type mapped_dim() const
    {
        return mappedDim_;
    }

    double load_factor() const
    {
        return static_cast<double>(size_) / bucketCount_;
    }

private:
    size_type bucketCount_ = 0;
    size_type mappedDim_ = 0;
    size_type size_ = 0;
    aclrtStream stream_ = nullptr;
    device_vector<bucket_type> buckets_;
    device_vector<mapped_type> values_;
    device_vector<uint32_t> findMismatchCount_;
};

using Bucket = unordered_map::bucket_type;

// Baseline path: one warp owns one key. Lane 0 probes/locks the slot, and all lanes shard the value store.
__simt_vf__ inline void insert_or_assign_warp_store_vf(__gm__ Bucket* table,
    __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum,
    uint32_t capacity, uint32_t dim, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t tid = static_cast<uint32_t>(threadIdx.x);
    const uint32_t laneId = tid % WARP_SIZE;
    const uint32_t warpIdInBlock = tid / WARP_SIZE;
    const uint32_t warpsPerBlock = static_cast<uint32_t>(blockDim.x) / WARP_SIZE;
    const uint32_t globalWarpId = blockIndex * warpsPerBlock + warpIdInBlock;
    const uint32_t totalWarps = blockNum * warpsPerBlock;

    for (uint32_t idx = globalWarpId; idx < keyNum; idx += totalWarps) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = 0;
        int32_t success = 0;

        if (laneId == 0) {
            bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
            for (uint32_t probe = 0; probe < capacity; ++probe) {
                __gm__ int64_t* keyAddr = &table[bucketIdx].key;
                int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
                if (oldKey == LOCKED_KEY) {
                    oldKey = wait_until_unlocked(keyAddr);
                }
                if (oldKey == EMPTY_KEY) {
                    success = 1;
                    break;
                }
                if (oldKey == key) {
                    oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                    if (oldKey == key) {
                        success = 1;
                        break;
                    }
                    continue;
                }
                bucketIdx = (bucketIdx + 1) & (capacity - 1);
            }
        }

        success = asc_shfl(success, 0, WARP_SIZE);
        bucketIdx = asc_shfl(bucketIdx, 0, WARP_SIZE);
        if (success == 1) {
            uint32_t dstBase = bucketIdx * dim;
            uint32_t srcBase = idx * dim;
            for (uint32_t j = laneId; j < dim; j += WARP_SIZE) {
                tableValues[dstBase + j] = values[srcBase + j];
            }
            // Publish the key only after the value vector is visible.
            asc_threadfence();
            if (laneId == 0) {
                (void)asc_atomic_exch(&table[bucketIdx].key, key);
            }
        }
    }
}

__global__ __vector__ void insert_or_assign_warp_store_kernel(__gm__ Bucket* table,
    __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum,
    uint32_t capacity, uint32_t dim)
{
    asc_vf_call<insert_or_assign_warp_store_vf>(
        dim3(THREAD_COUNT), table, tableValues, keys, values, keyNum, capacity, dim, block_idx, BLOCK_DIM);
}

class MTETaskQueue {
public:
    // Bind the GM value buffers and UB ring-control storage used by the SIMT producer and MTE consumer.
    __aicore__ inline void Init(__gm__ const float* values, __ubuf__ float* valueLocal,
        __ubuf__ uint64_t* srcAddrs, __ubuf__ uint64_t* dstAddrs, __ubuf__ int64_t* taskKeys,
        __ubuf__ uint64_t* keyAddrs, __ubuf__ uint32_t* globalId, __ubuf__ uint32_t* mteFinishId,
        __ubuf__ uint32_t* simtAssignId, __ubuf__ uint32_t* taskFinishFlag, __ubuf__ uint32_t* keyAssignId,
        __ubuf__ uint32_t* keyFinishId, uint32_t dim)
    {
        valueLocal_ = valueLocal;
        srcAddrs_ = srcAddrs;
        dstAddrs_ = dstAddrs;
        taskKeys_ = taskKeys;
        keyAddrs_ = keyAddrs;
        globalId_ = globalId;
        mteFinishId_ = mteFinishId;
        simtAssignId_ = simtAssignId;
        taskFinishFlag_ = taskFinishFlag;
        keyAssignId_ = keyAssignId;
        keyFinishId_ = keyFinishId;
        dim_ = dim;
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(globalId_) = 0;
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(mteFinishId_) = 0;
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(simtAssignId_) = 0;
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(taskFinishFlag_) = 0;
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(keyAssignId_) = 0;
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(keyFinishId_) = 0;
        valuesCacheMode_ = static_cast<uint8_t>((reinterpret_cast<uint64_t>(values)) >> 60);
    }

    // Reserve a contiguous task-id range for one SIMT warp.
    __simt_callee__ inline uint32_t ApplyId(uint32_t taskCount) const
    {
        return asc_atomic_add(globalId_, taskCount);
    }

    // Fill one ring slot. The task is visible to the MTE consumer only after AssignTask advances simtAssignId_.
    __simt_callee__ inline void FillTaskInfo(
        uint32_t taskId, uint64_t srcAddr, uint64_t dstAddr, int64_t key, uint64_t keyAddr) const
    {
        uint32_t slot = taskId & MTE_TASK_RING_MASK;
        reinterpret_cast<__ubuf__ volatile uint64_t*>(srcAddrs_)[slot] = srcAddr;
        reinterpret_cast<__ubuf__ volatile uint64_t*>(dstAddrs_)[slot] = dstAddr;
        reinterpret_cast<__ubuf__ volatile int64_t*>(taskKeys_)[slot] = key;
        reinterpret_cast<__ubuf__ volatile uint64_t*>(keyAddrs_)[slot] = keyAddr;
    }

    // Publish a contiguous range to the MTE consumer after all ring slots in that range have been filled.
    __simt_callee__ inline void AssignTask(uint32_t taskStartId, uint32_t taskEndId) const
    {
        while (true) {
            if (asc_atomic_cas(simtAssignId_, taskStartId, taskEndId) == taskStartId) {
                return;
            }
        }
    }

    // Tell the MTE consumer that no more tasks will be produced.
    __simt_callee__ inline void AssignmentFinish() const
    {
        *reinterpret_cast<__ubuf__ volatile uint32_t*>(taskFinishFlag_) = 1;
    }

    // Publish keys for tasks whose MTE value copy has already completed. This also frees ring slots.
    template <bool drainAll = false>
    __simt_callee__ inline void Drain(uint32_t newTaskEndId) const
    {
        while (true) {
            uint32_t keyFinishId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(keyFinishId_);
            if constexpr (drainAll) {
                if (newTaskEndId == keyFinishId) {
                    break;
                }
            } else {
                if (newTaskEndId - keyFinishId <= MTE_TASK_RING_CAPACITY) {
                    break;
                }
            }

            uint32_t mteFinishId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(mteFinishId_);
            uint32_t keyAssignId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(keyAssignId_);
            if (keyAssignId >= mteFinishId) {
                continue;
            }

            uint32_t available = mteFinishId - keyAssignId;
            uint32_t publishCount = (available < MTE_BATCH_SIZE) ? available : MTE_BATCH_SIZE;
            uint32_t laneId = static_cast<uint32_t>(laneid());
            uint32_t publishStartId = 0;
            if (laneId == 0) {
                publishStartId = asc_atomic_cas(keyAssignId_, keyAssignId, keyAssignId + publishCount);
            }
            publishStartId = asc_shfl(publishStartId, 0);
            if (publishStartId != keyAssignId) {
                continue;
            }

            if (laneId < publishCount) {
                uint32_t slot = (keyAssignId + laneId) & MTE_TASK_RING_MASK;
                int64_t key = reinterpret_cast<__ubuf__ volatile int64_t*>(taskKeys_)[slot];
                uint64_t keyAddr = reinterpret_cast<__ubuf__ volatile uint64_t*>(keyAddrs_)[slot];
                // The slot is still owned by this insert task, so a release store is enough to publish the key.
                *reinterpret_cast<__gm__ volatile int64_t*>(keyAddr) = key;
            }
            asc_threadfence();
            if (laneId == 0) {
                while (true) {
                    if (asc_atomic_cas(keyFinishId_, publishStartId, keyAssignId + publishCount) == publishStartId) {
                        break;
                    }
                }
            }
        }
    }

    __simt_callee__ inline void DrainAll() const
    {
        uint32_t lastTaskId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(simtAssignId_);
        Drain<true>(lastTaskId);
    }

    // Compact active lanes in a warp into task IDs, wait for ring space, and assign the filled task range.
    __simt_callee__ inline void AssignWarpTask(
        uint64_t srcAddr, uint64_t dstAddr, int64_t key, uint64_t keyAddr, bool needAssign) const
    {
        uint32_t writeMask = asc_ballot(needAssign ? 1 : 0);
        uint32_t warpWriteCount = static_cast<uint32_t>(__popc(writeMask));
        if (warpWriteCount == 0) {
            return;
        }

        uint32_t laneId = static_cast<uint32_t>(laneid());
        uint32_t taskStartId = 0;
        if (laneId == 0) {
            taskStartId = ApplyId(warpWriteCount);
        }
        taskStartId = asc_shfl(taskStartId, 0);
        uint32_t taskEndId = taskStartId + warpWriteCount;

        Drain(taskEndId);

        if (needAssign) {
            uint32_t laneOffset = static_cast<uint32_t>(__popc(writeMask & static_cast<uint32_t>(lanemask_lt())));
            FillTaskInfo(taskStartId + laneOffset, srcAddr, dstAddr, key, keyAddr);
        }
        asc_threadfence();

        if (laneId == 0) {
            AssignTask(taskStartId, taskEndId);
        }
    }

    // Consume assigned tasks with MTE2 + MTE3. Key publication is intentionally left to the SIMT drain path.
    __aicore__ inline void RunTask() const
    {
        uint32_t valueBytes = dim_ * sizeof(float);
        uint32_t valueBytesAligned = ((valueBytes + UB_ALIGN_SIZE - 1) / UB_ALIGN_SIZE) * UB_ALIGN_SIZE;
        uint32_t valueElemsAligned = valueBytesAligned / sizeof(float);
        uint32_t maxProcBatch = MTE_LOCAL_VALUE_COUNT / valueElemsAligned;
        if (maxProcBatch > MTE_BATCH_SIZE) {
            maxProcBatch = MTE_BATCH_SIZE;
        }
        if (maxProcBatch == 0) {
            maxProcBatch = 1;
        }

        uint32_t mteFinishId = 0;
        while (true) {
            uint32_t simtAssignId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(simtAssignId_);
            if (simtAssignId == mteFinishId) {
                if (*reinterpret_cast<__ubuf__ volatile uint32_t*>(taskFinishFlag_) == 1) {
                    return;
                }
                continue;
            }

            uint32_t available = simtAssignId - mteFinishId;
            uint32_t procCount = (available < maxProcBatch) ? available : maxProcBatch;
            for (uint32_t i = 0; i < procCount; ++i) {
                uint32_t slot = (mteFinishId + i) & MTE_TASK_RING_MASK;
                uint64_t srcAddr = reinterpret_cast<__ubuf__ volatile uint64_t*>(srcAddrs_)[slot];
                asc_copy_gm2ub_align(valueLocal_ + i * valueElemsAligned, reinterpret_cast<__gm__ float*>(srcAddr), 1,
                    valueBytes, 0, 0, true, valuesCacheMode_, 0, 0);
            }

            asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);

            for (uint32_t i = 0; i < procCount; ++i) {
                uint32_t slot = (mteFinishId + i) & MTE_TASK_RING_MASK;
                uint64_t dstAddr = reinterpret_cast<__ubuf__ volatile uint64_t*>(dstAddrs_)[slot];
                uint8_t tableValuesCacheMode = static_cast<uint8_t>(dstAddr >> 60);
                asc_copy_ub2gm_align(reinterpret_cast<__gm__ float*>(dstAddr), valueLocal_ + i * valueElemsAligned, 1,
                    valueBytes, tableValuesCacheMode, 0, 0);
            }

            asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
            asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);

            mteFinishId += procCount;
            *reinterpret_cast<__ubuf__ volatile uint32_t*>(mteFinishId_) = mteFinishId;
        }
    }

    // Keep the SIMD side alive until the SIMT drain path has published every completed key.
    __aicore__ inline void WaitPublishDone() const
    {
        while (true) {
            uint32_t finishFlag = *reinterpret_cast<__ubuf__ volatile uint32_t*>(taskFinishFlag_);
            uint32_t simtAssignId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(simtAssignId_);
            uint32_t keyFinishId = *reinterpret_cast<__ubuf__ volatile uint32_t*>(keyFinishId_);
            if (finishFlag == 1 && keyFinishId == simtAssignId) {
                return;
            }
        }
    }

private:
    __ubuf__ float* valueLocal_ = nullptr;
    __ubuf__ uint64_t* srcAddrs_ = nullptr;
    __ubuf__ uint64_t* dstAddrs_ = nullptr;
    __ubuf__ int64_t* taskKeys_ = nullptr;
    __ubuf__ uint64_t* keyAddrs_ = nullptr;
    __ubuf__ uint32_t* globalId_ = nullptr;
    __ubuf__ uint32_t* mteFinishId_ = nullptr;
    __ubuf__ uint32_t* simtAssignId_ = nullptr;
    __ubuf__ uint32_t* taskFinishFlag_ = nullptr;
    __ubuf__ uint32_t* keyAssignId_ = nullptr;
    __ubuf__ uint32_t* keyFinishId_ = nullptr;
    uint32_t dim_ = 0;
    uint8_t valuesCacheMode_ = 0;
};

// SIMT producer: probe and lock a slot, then enqueue the value move and delayed key publication task.
__simt_vf__ inline void insert_or_assign_task_queue_probe_vf(MTETaskQueue taskQueue, __gm__ Bucket* table,
    __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values, uint32_t keyNum,
    uint32_t capacity, uint32_t dim, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t threadAll = static_cast<uint32_t>(blockDim.x) * blockNum;
    for (uint32_t idx = blockIndex * static_cast<uint32_t>(blockDim.x) + static_cast<uint32_t>(threadIdx.x);
         idx < keyNum; idx += threadAll) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t result = INVALID_BUCKET;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            __gm__ int64_t* keyAddr = &table[bucketIdx].key;
            int64_t oldKey = asc_atomic_cas(keyAddr, EMPTY_KEY, LOCKED_KEY);
            if (oldKey == LOCKED_KEY) {
                oldKey = wait_until_unlocked(keyAddr);
            }
            if (oldKey == EMPTY_KEY) {
                result = bucketIdx;
                break;
            }
            if (oldKey == key) {
                oldKey = asc_atomic_cas(keyAddr, key, LOCKED_KEY);
                if (oldKey == key) {
                    result = bucketIdx;
                    break;
                }
                continue;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        bool needAssign = (result != INVALID_BUCKET);
        uint64_t srcAddr = 0;
        uint64_t dstAddr = 0;
        uint64_t keyAddr = 0;
        if (needAssign) {
            srcAddr = reinterpret_cast<uint64_t>(values + idx * dim);
            dstAddr = reinterpret_cast<uint64_t>(tableValues + result * dim);
            keyAddr = reinterpret_cast<uint64_t>(&table[result].key);
        }
        taskQueue.AssignWarpTask(srcAddr, dstAddr, key, keyAddr, needAssign);
    }

    asc_syncthreads();
    if (threadIdx.x == 0) {
        taskQueue.AssignmentFinish();
    }
    taskQueue.DrainAll();
}

__global__ __vector__ void insert_or_assign_mte_task_queue_kernel(
    __gm__ Bucket* table, __gm__ float* tableValues, __gm__ const int64_t* keys, __gm__ const float* values,
    uint32_t keyNum, uint32_t capacity, uint32_t dim)
{
    asc_init();

    const uint32_t coreIdx = static_cast<uint32_t>(block_idx);
    const uint32_t coreNum = BLOCK_DIM;
    const uint32_t rowsPerCore = (keyNum + coreNum - 1) / coreNum;
    const uint32_t coreStart = coreIdx * rowsPerCore;
    const uint32_t coreEnd = (coreStart + rowsPerCore < keyNum) ? (coreStart + rowsPerCore) : keyNum;

    __ubuf__ float valueLocal[MTE_LOCAL_VALUE_COUNT];
    __ubuf__ uint64_t taskSrcAddrs[MTE_TASK_RING_CAPACITY];
    __ubuf__ uint64_t taskDstAddrs[MTE_TASK_RING_CAPACITY];
    __ubuf__ int64_t taskKeys[MTE_TASK_RING_CAPACITY];
    __ubuf__ uint64_t taskKeyAddrs[MTE_TASK_RING_CAPACITY];
    __ubuf__ uint32_t globalId[1];
    __ubuf__ uint32_t mteFinishId[1];
    __ubuf__ uint32_t simtAssignId[1];
    __ubuf__ uint32_t taskFinishFlag[1];
    __ubuf__ uint32_t keyAssignId[1];
    __ubuf__ uint32_t keyFinishId[1];

    MTETaskQueue taskQueue;
    taskQueue.Init(values, valueLocal, taskSrcAddrs, taskDstAddrs, taskKeys, taskKeyAddrs, globalId, mteFinishId,
        simtAssignId, taskFinishFlag, keyAssignId, keyFinishId, dim);

    if (coreStart >= coreEnd) {
        return;
    }

    asc_sync_pipe(pipe_t::PIPE_ALL);
    asc_vf_call<insert_or_assign_task_queue_probe_vf>(
        dim3(THREAD_COUNT), taskQueue, table, tableValues, keys, values, keyNum, capacity, dim, block_idx, BLOCK_DIM);
    taskQueue.RunTask();
    taskQueue.WaitPublishDone();
}

// Device-side find pass used to verify that published keys always point to complete values.
__simt_vf__ inline void find_verify_vf(__gm__ const Bucket* table, __gm__ const float* tableValues,
    __gm__ const int64_t* keys, __gm__ const float* expectedValues, __gm__ uint32_t* mismatchCount, uint32_t keyNum,
    uint32_t capacity, uint32_t dim, uint32_t blockIndex, uint32_t blockNum)
{
    const uint32_t threadAll = static_cast<uint32_t>(blockDim.x) * blockNum;
    for (uint32_t idx = blockIndex * static_cast<uint32_t>(blockDim.x) +
         static_cast<uint32_t>(threadIdx.x);
         idx < keyNum; idx += threadAll) {
        int64_t key = keys[idx];
        uint32_t bucketIdx = static_cast<uint32_t>(hash_key_device(key)) & (capacity - 1);
        uint32_t matched = 0;

        for (uint32_t probe = 0; probe < capacity; ++probe) {
            int64_t currentKey = table[bucketIdx].key;
            if (currentKey == key) {
                uint32_t valueBase = bucketIdx * dim;
                uint32_t srcBase = idx * dim;
                matched = 1;
                for (uint32_t j = 0; j < dim; ++j) {
                    if (tableValues[valueBase + j] != expectedValues[srcBase + j]) {
                        matched = 0;
                        break;
                    }
                }
                break;
            }
            if (currentKey == EMPTY_KEY) {
                break;
            }
            bucketIdx = (bucketIdx + 1) & (capacity - 1);
        }

        if (matched == 0) {
            (void)asc_atomic_add(mismatchCount, 1U);
        }
    }
}

__global__ __vector__ void find_verify_kernel(__gm__ const Bucket* table, __gm__ const float* tableValues,
    __gm__ const int64_t* keys, __gm__ const float* expectedValues, __gm__ uint32_t* mismatchCount, uint32_t keyNum,
    uint32_t capacity, uint32_t dim)
{
    asc_vf_call<find_verify_vf>(
        dim3(THREAD_COUNT), table, tableValues, keys, expectedValues, mismatchCount, keyNum, capacity, dim, block_idx,
        BLOCK_DIM);
}

void InitHostData(std::vector<int64_t>& keys, std::vector<float>& values, uint32_t dim)
{
    for (uint32_t i = 0; i < KEY_NUM; ++i) {
        uint64_t rawKey = (static_cast<uint64_t>(i) * 11400714819323198485ULL) & (HASH_TABLE_CAPACITY - 1);
        keys[i] = static_cast<int64_t>(rawKey + 1);
        for (uint32_t j = 0; j < dim; ++j) {
            values[i * dim + j] = static_cast<float>(((i * 17 + j) & 0x3ff) * 0.25f);
        }
    }
}

// Host-side linear-probe find used after copying the device table back.
bool FindValueInTable(
    const std::vector<Bucket>& table, const std::vector<float>& tableValues, int64_t key, const float* expected,
    uint32_t dim)
{
    uint32_t bucketIdx = static_cast<uint32_t>(hash_key_host(key)) & (HASH_TABLE_CAPACITY - 1);
    for (uint32_t probe = 0; probe < HASH_TABLE_CAPACITY; ++probe) {
        const Bucket& bucket = table[bucketIdx];
        if (bucket.key == key) {
            uint32_t valueBase = bucketIdx * dim;
            for (uint32_t j = 0; j < dim; ++j) {
                if (std::fabs(tableValues[valueBase + j] - expected[j]) > 1e-6f) {
                    std::cerr << "Mismatch key=" << key << ", elem=" << j << ", expected=" << expected[j]
                              << ", actual=" << tableValues[valueBase + j] << std::endl;
                    return false;
                }
            }
            return true;
        }
        if (bucket.key == EMPTY_KEY) {
            return false;
        }
        bucketIdx = (bucketIdx + 1) & (HASH_TABLE_CAPACITY - 1);
    }
    return false;
}

// Validate both publication markers and key/value contents for every inserted row.
bool VerifyResult(const std::vector<int64_t>& keys, const std::vector<float>& values, const std::vector<Bucket>& table,
    const std::vector<float>& tableValues, uint32_t dim)
{
    for (uint32_t bucketIdx = 0; bucketIdx < HASH_TABLE_CAPACITY; ++bucketIdx) {
        const Bucket& bucket = table[bucketIdx];
        if (bucket.key == LOCKED_KEY) {
            std::cerr << "Bucket remains locked, bucket=" << bucketIdx << std::endl;
            return false;
        }
    }

    for (uint32_t row = 0; row < KEY_NUM; ++row) {
        if (!FindValueInTable(table, tableValues, keys[row], values.data() + row * dim, dim)) {
            std::cerr << "Cannot find expected key/value, key=" << keys[row] << std::endl;
            return false;
        }
    }
    return true;
}

// Dispatch the selected benchmark scenario. Both paths are single-kernel insert_or_assign implementations.
void LaunchInsertOrAssign(
    Bucket* buckets, float* mappedValues, const int64_t* keys, const float* values, uint32_t dim, aclrtStream stream)
{
    if constexpr (scenarioNum == 0) {
        insert_or_assign_warp_store_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, mappedValues, keys, values, KEY_NUM, HASH_TABLE_CAPACITY, dim);
    } else {
        insert_or_assign_mte_task_queue_kernel<<<BLOCK_DIM, 0, stream>>>(
            buckets, mappedValues, keys, values, KEY_NUM, HASH_TABLE_CAPACITY, dim);
    }
}

unordered_map::unordered_map(size_type bucketCount, size_type mappedDim, aclrtStream stream)
    : bucketCount_(bucketCount),
      mappedDim_(mappedDim),
      stream_(stream),
      buckets_(bucketCount),
      values_(static_cast<size_t>(bucketCount) * mappedDim),
      findMismatchCount_(1)
{
    clear();
}

void unordered_map::clear()
{
    buckets_.fill_zero();
    values_.fill_zero();
    size_ = 0;
}

unordered_map::insert_return_type unordered_map::insert_or_assign(
    const key_type* firstKey, const key_type* lastKey, const mapped_type* firstMapped)
{
    size_type count = static_cast<size_type>(lastKey - firstKey);
    if (count != KEY_NUM) {
        std::cerr << "Unsupported insert count: " << count << ", expected " << KEY_NUM << std::endl;
        return insert_return_type{0, false};
    }

    device_vector<key_type> keys(count);
    device_vector<mapped_type> mappedValues(static_cast<size_t>(count) * mappedDim_);

    CHECK_ACL(aclrtMemcpy(keys.data(), keys.bytes(), firstKey, keys.bytes(), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(
        mappedValues.data(), mappedValues.bytes(), firstMapped, mappedValues.bytes(), ACL_MEMCPY_HOST_TO_DEVICE));

    // Repeat count is configurable. run.sh uses one workload so msprof captures one complete insert path.
    for (uint32_t i = 0; i < PROFILE_REPEAT_TIMES_VALUE; ++i) {
        LaunchInsertOrAssign(buckets_.data(), values_.data(), keys.data(), mappedValues.data(), mappedDim_, stream_);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream_));

    // Device-side find verification catches publication-order bugs before host copies inspect the table.
    findMismatchCount_.fill_zero();
    find_verify_kernel<<<BLOCK_DIM, 0, stream_>>>(
        buckets_.data(), values_.data(), keys.data(), mappedValues.data(), findMismatchCount_.data(), count,
        bucketCount_, mappedDim_);
    CHECK_ACL(aclrtSynchronizeStream(stream_));
    std::vector<uint32_t> mismatchCount(1);
    findMismatchCount_.copy_to(mismatchCount);
    if (mismatchCount[0] != 0) {
        std::cerr << "Device find verification failed, mismatch_count=" << mismatchCount[0] << std::endl;
        return insert_return_type{0, false};
    }

    size_ = count;
    return insert_return_type{count, true};
}

void unordered_map::copy_to(std::vector<bucket_type>& buckets, std::vector<mapped_type>& values) const
{
    buckets.resize(bucketCount_);
    values.resize(static_cast<size_t>(bucketCount_) * mappedDim_);
    buckets_.copy_to(buckets);
    values_.copy_to(values);
}

bool RunOneDim(uint32_t dim, aclrtStream stream)
{
    std::vector<int64_t> keys(KEY_NUM);
    std::vector<float> values(static_cast<size_t>(KEY_NUM) * dim);
    InitHostData(keys, values, dim);

    unordered_map table(HASH_TABLE_CAPACITY, dim, stream);
    auto insertResult = table.insert_or_assign(keys.data(), keys.data() + keys.size(), values.data());
    if (!insertResult.second) {
        return false;
    }

    std::vector<Bucket> buckets;
    std::vector<float> tableValues;
    table.copy_to(buckets, tableValues);
    bool ok = VerifyResult(keys, values, buckets, tableValues, dim);

    return ok;
}

void PrintHeader()
{
    const char* scenarioName = "MTE task queue insert_or_assign";
    if constexpr (scenarioNum == 0) {
        scenarioName = "SIMT warp insert_or_assign";
    }
    std::cout << "\n### HashTable insert_or_assign benchmark\n";
    std::cout << "* scenario = " << scenarioNum << " (" << scenarioName << ")\n";
    std::cout << "* capacity = " << HASH_TABLE_CAPACITY << ", key_num = " << KEY_NUM
              << ", load_factor = " << (static_cast<double>(KEY_NUM) / HASH_TABLE_CAPACITY) << "\n";
    std::cout << "* block_dim = " << BLOCK_DIM << ", thread_count = " << THREAD_COUNT
              << ", warp_size = " << WARP_SIZE << "\n";
    std::cout << "* profile_repeat = " << PROFILE_REPEAT_TIMES_VALUE << "\n";
    std::cout << "* timing method = msprof op\n\n";
    std::cout << "| Scenario | Dim | Impl | Verify |\n";
    std::cout << "|---:|---:|:---|:---|\n";
}

void PrintResult(uint32_t dim, bool verifyOk)
{
    const char* scenarioName = "MTE task queue insert_or_assign";
    if constexpr (scenarioNum == 0) {
        scenarioName = "SIMT warp insert_or_assign";
    }
    std::cout << "| " << scenarioNum << " | " << dim << " | " << scenarioName << " | "
              << (verifyOk ? "PASS" : "FAIL") << " |\n";
}

bool IsSupportedDim(uint32_t dim)
{
    for (uint32_t supportedDim : TEST_DIMS) {
        if (dim == supportedDim) {
            return true;
        }
    }
    return false;
}

std::vector<uint32_t> GetDimsToRun(int32_t argc, char** argv)
{
    std::vector<uint32_t> dims;
    if (argc == 1) {
        for (uint32_t dim : TEST_DIMS) {
            dims.push_back(dim);
        }
        return dims;
    }
    if (argc != 2) {
        std::cerr << "Usage: " << argv[0] << " [dim]" << std::endl;
        return dims;
    }

    char* end = nullptr;
    unsigned long parsed = std::strtoul(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' || parsed == 0 || parsed > UINT32_MAX) {
        std::cerr << "Invalid dim: " << argv[1] << std::endl;
        return dims;
    }

    uint32_t dim = static_cast<uint32_t>(parsed);
    if (!IsSupportedDim(dim)) {
        std::cerr << "Unsupported dim: " << dim << ". Supported dims: ";
        for (uint32_t supportedDim : TEST_DIMS) {
            std::cerr << supportedDim << " ";
        }
        std::cerr << std::endl;
        return dims;
    }
    dims.push_back(dim);
    return dims;
}

int32_t main(int32_t argc, char** argv)
{
    std::vector<uint32_t> dims = GetDimsToRun(argc, argv);
    if (dims.empty()) {
        return 1;
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    PrintHeader();
    bool allOk = true;
    for (uint32_t dim : dims) {
        bool ok = RunOneDim(dim, stream);
        PrintResult(dim, ok);
        allOk = allOk && ok;
    }
    std::cout << (allOk ? "Verification PASSED" : "Verification FAILED") << std::endl;

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());

    return allOk ? 0 : 1;
}
