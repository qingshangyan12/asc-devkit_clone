/* !
 * \file matrix_transpose.asc
 * \brief Matrix transpose with multiple implementation modes selected by SCENARIO_NUM:
 *        SCENARIO_NUM=0/1: continuous copy baseline through GM->UB->GM MTE movement
 *        SCENARIO_NUM=2: direct SIMT GM transpose
 *        SCENARIO_NUM=3-7: MTE GM->UB tile movement plus SIMT transposed UB access
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 7
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 7
#error "SCENARIO_NUM must be one of 0, 1, 2, 3, 4, 5, 6, 7."
#endif

namespace {
constexpr int TILE_DIM = 32;
constexpr int TILE_PAD = 2;
constexpr int TILE_PAD_STRIDE = TILE_DIM + TILE_PAD;
constexpr uint32_t TILE_ELEMENTS = TILE_DIM * TILE_DIM;
constexpr uint32_t TILE_ROW_BYTES = TILE_DIM * sizeof(float);
constexpr uint32_t COPY_ELEMENTS_PER_BLOCK = 4096;
constexpr uint32_t THREADS_2048 = 2048;
constexpr uint32_t THREADS_1024 = 1024;

#if SCENARIO_NUM == 0
constexpr uint32_t THREADS_PER_BLOCK = THREADS_2048;
#elif SCENARIO_NUM == 1
constexpr uint32_t THREADS_PER_BLOCK = THREADS_1024;
#elif SCENARIO_NUM == 2
constexpr uint32_t THREADS_PER_BLOCK = THREADS_2048;
#elif SCENARIO_NUM == 3
constexpr uint32_t THREADS_PER_BLOCK = THREADS_2048;
constexpr int TILES_PER_BLOCK = 2;
#elif SCENARIO_NUM == 4
constexpr uint32_t THREADS_PER_BLOCK = THREADS_2048;
constexpr int TILES_PER_BLOCK = 2;
#elif SCENARIO_NUM == 5
constexpr uint32_t THREADS_PER_BLOCK = THREADS_1024;
#elif SCENARIO_NUM == 6
constexpr uint32_t THREADS_PER_BLOCK = THREADS_1024;
#else
constexpr uint32_t THREADS_PER_BLOCK = THREADS_1024;
#endif

struct LaunchConfig {
    uint32_t width;
    uint32_t height;
    uint32_t core_num;
    aclrtStream stream;
};

uint32_t verify_result(const std::vector<float> &output, const std::vector<float> &golden, float abs_tolerance = 1e-3f)
{
    if (output.size() != golden.size()) {
        printf("[Failed] Case accuracy verification failed!\n");
        return 1;
    }
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::fabs(output[i] - golden[i]) > abs_tolerance) {
            printf("[Failed] Case accuracy verification failed!\n");
            return 1;
        }
    }
    printf("[Success] Case accuracy verification passed.\n");
    return 0;
}

const char *get_kernel_name(int32_t kernel_kind)
{
    switch (kernel_kind) {
        case 0:
            return "copy_mte_2048";
        case 1:
            return "copy_mte_1024";
        case 2:
            return "transpose_simt_naive";
        case 3:
            return "transpose_mte_ub_2tile_static";
        case 4:
            return "transpose_mte_ub_2tile";
        case 5:
            return "transpose_mte_ub";
        case 6:
            return "transpose_mte_ub_pad";
        case 7:
            return "transpose_mte_ub_pad_db";
        default:
            return "unknown";
    }
}

std::vector<float> compute_golden(const std::vector<float> &input,
                                  const std::vector<uint32_t> &input_shape,
                                  int32_t kernel_kind)
{
    if (input_shape.size() != 2) {
        fprintf(stderr, "Input shape must be 2-D.\n");
        return {};
    }

    const uint32_t height = input_shape[0];
    const uint32_t width = input_shape[1];
    if (input.size() != static_cast<size_t>(height) * width) {
        fprintf(stderr, "Input data size does not match input shape.\n");
        return {};
    }

    if (kernel_kind == 0) {
        return input;
    }

    std::vector<float> output(input.size());
    for (uint32_t row = 0; row < height; ++row) {
        for (uint32_t col = 0; col < width; ++col) {
            output[static_cast<size_t>(col) * height + row] = input[static_cast<size_t>(row) * width + col];
        }
    }
    return output;
}

uint32_t get_vector_core_num(uint32_t device_id)
{
    int64_t core_num = 0;
    aclError ret = aclrtGetDeviceInfo(device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &core_num);
    if (ret != ACL_SUCCESS) {
        return 0;
    }
    return static_cast<uint32_t>(core_num);
}
} // namespace

__aicore__ inline void sync_mte2_to_v()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    }
}

__aicore__ inline void sync_v_to_mte3()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }
}

__aicore__ inline void sync_mte3_to_mte2()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    }
}

__aicore__ inline void sync_v_to_mte2()
{
    if ASC_IS_AIV {
        asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
    }
}

__aicore__ inline void copy_gm_tile_to_ub(__ubuf__ float *dst, __gm__ float *src, uint32_t width,
                                          uint32_t ub_row_bytes = TILE_ROW_BYTES)
{
    asc_set_gm2ub_loop_size(TILE_DIM, 1);
    asc_set_gm2ub_loop1_stride(width * sizeof(float), ub_row_bytes);
    asc_copy_gm2ub_align(dst, src, 1, TILE_ROW_BYTES, 0, 0, false, 0, 0, 0);
    asc_set_gm2ub_loop_size(1, 1);
}

#if SCENARIO_NUM == 0 || SCENARIO_NUM == 1
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_fill_copy_tile(__ubuf__ float *tile,
                                                                                 uint32_t valid_elements)
{
    uint32_t tid = threadIdx.x;
    uint32_t stride = blockDim.x;
    for (uint32_t i = tid; i < COPY_ELEMENTS_PER_BLOCK; i += stride) {
        tile[i] = (i < valid_elements) ? tile[i] : 0.0f;
    }
}

__global__ __vector__ void copy_kernel(__gm__ float *output, __gm__ float *input, uint32_t elements)
{
    __ubuf__ float tile[COPY_ELEMENTS_PER_BLOCK];
    uint32_t block_idx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t block_count = static_cast<uint32_t>(AscendC::GetBlockNum());

    for (uint32_t offset = block_idx * COPY_ELEMENTS_PER_BLOCK; offset < elements;
         offset += block_count * COPY_ELEMENTS_PER_BLOCK) {
        uint32_t remain = elements - offset;
        uint32_t copy_elements = remain < COPY_ELEMENTS_PER_BLOCK ? remain : COPY_ELEMENTS_PER_BLOCK;
        asc_copy_gm2ub_align(tile, input + offset, copy_elements * sizeof(float));
        sync_mte2_to_v();
        asc_vf_call<simt_fill_copy_tile>(dim3(THREADS_PER_BLOCK), tile, copy_elements);
        sync_v_to_mte3();
        asc_copy_ub2gm_align(output + offset, tile, copy_elements * sizeof(float));
        sync_mte3_to_mte2();
    }
}

void launch_case_kernel(float *output, float *input, const LaunchConfig &config)
{
    uint32_t elements = config.width * config.height;
    copy_kernel<<<config.core_num, 0, config.stream>>>(output, input, elements);
}
#endif

#if SCENARIO_NUM == 2
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_transpose_naive(__gm__ float *output,
                                                                                  __gm__ float *input,
                                                                                  uint32_t width, uint32_t height,
                                                                                  uint32_t total)
{
    uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;
    uint32_t stride = gridDim.x * blockDim.x;
    for (uint32_t i = tid; i < total; i += stride) {
        uint32_t row = i / width;
        uint32_t col = i - row * width;
        output[col * height + row] = input[i];
    }
}

__global__ __vector__ void transpose_naive_kernel(__gm__ float *output, __gm__ float *input,
                                                  uint32_t width, uint32_t height)
{
    uint32_t total = width * height;
    asc_vf_call<simt_transpose_naive>(dim3(THREADS_PER_BLOCK), output, input, width, height, total);
}

void launch_case_kernel(float *output, float *input, const LaunchConfig &config)
{
    transpose_naive_kernel<<<config.core_num, 0, config.stream>>>(output, input, config.width, config.height);
}
#endif

#if SCENARIO_NUM == 3 || SCENARIO_NUM == 4
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_store_2tile(__gm__ float *output,
                                                                              __ubuf__ float *tile,
                                                                              uint32_t width, uint32_t height,
                                                                              uint32_t tiles_x,
                                                                              uint32_t tile_base,
                                                                              uint32_t total_tiles)
{
    uint32_t local_tile = threadIdx.y >> 5;
    uint32_t ty = threadIdx.y & (TILE_DIM - 1);
    uint32_t tx = threadIdx.x;
    uint32_t tile_id = tile_base + local_tile;
    if (tile_id >= total_tiles) {
        return;
    }

    uint32_t tile_y = tile_id / tiles_x;
    uint32_t tile_x = tile_id - tile_y * tiles_x;
    uint32_t x_index = tile_y * TILE_DIM + tx;
    uint32_t y_index = tile_x * TILE_DIM + ty;
    output[x_index + y_index * height] = tile[local_tile * TILE_ELEMENTS + tx * TILE_DIM + ty];
}

__global__ __vector__ void transpose_ub_2tile_kernel(__gm__ float *output, __gm__ float *input,
                                                     uint32_t width, uint32_t height, uint32_t total_tiles)
{
    __ubuf__ float tile[TILES_PER_BLOCK][TILE_DIM][TILE_DIM];
    uint32_t tiles_x = width / TILE_DIM;
    uint32_t loop_start = static_cast<uint32_t>(AscendC::GetBlockIdx()) * TILES_PER_BLOCK;
#if SCENARIO_NUM == 3
    uint32_t loop_step = static_cast<uint32_t>(AscendC::GetBlockNum()) * TILES_PER_BLOCK;
    uint32_t loop_end = loop_start + TILES_PER_BLOCK;
#else
    uint32_t loop_step = static_cast<uint32_t>(AscendC::GetBlockNum()) * TILES_PER_BLOCK;
    uint32_t loop_end = total_tiles;
#endif

    for (uint32_t tile_base = loop_start; tile_base < loop_end && tile_base < total_tiles; tile_base += loop_step) {
        for (uint32_t local_tile = 0; local_tile < TILES_PER_BLOCK; ++local_tile) {
            uint32_t tile_id = tile_base + local_tile;
            if (tile_id < total_tiles) {
                uint32_t tile_y = tile_id / tiles_x;
                uint32_t tile_x = tile_id - tile_y * tiles_x;
                uint32_t tile_offset = tile_y * TILE_DIM * width + tile_x * TILE_DIM;
                copy_gm_tile_to_ub(&tile[local_tile][0][0], input + tile_offset, width);
            }
        }
        sync_mte2_to_v();
        asc_vf_call<simt_store_2tile>(dim3(TILE_DIM, TILE_DIM * TILES_PER_BLOCK, 1), output, &tile[0][0][0],
                                      width, height, tiles_x, tile_base, total_tiles);
        sync_v_to_mte2();
    }
}

void launch_case_kernel(float *output, float *input, const LaunchConfig &config)
{
    uint32_t total_tiles = (config.width / TILE_DIM) * (config.height / TILE_DIM);
#if SCENARIO_NUM == 3
    uint32_t bn = (total_tiles + TILES_PER_BLOCK - 1) / TILES_PER_BLOCK;
#else
    uint32_t bn = config.core_num;
#endif
    transpose_ub_2tile_kernel<<<bn, 0, config.stream>>>(output, input, config.width, config.height, total_tiles);
}
#endif

#if SCENARIO_NUM == 5
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_store_tile(__gm__ float *output,
                                                                             __ubuf__ float *tile,
                                                                             uint32_t height, uint32_t tiles_x,
                                                                             uint32_t tile_id)
{
    uint32_t tx = threadIdx.x;
    uint32_t ty = threadIdx.y;
    uint32_t tile_y = tile_id / tiles_x;
    uint32_t tile_x = tile_id - tile_y * tiles_x;
    uint32_t x_index = tile_y * TILE_DIM + tx;
    uint32_t y_index = tile_x * TILE_DIM + ty;
    output[x_index + y_index * height] = tile[tx * TILE_DIM + ty];
}

__global__ __vector__ void transpose_ub_kernel(__gm__ float *output, __gm__ float *input,
                                               uint32_t width, uint32_t height, uint32_t total_tiles)
{
    __ubuf__ float tile[TILE_DIM][TILE_DIM];
    uint32_t tiles_x = width / TILE_DIM;
    uint32_t step = static_cast<uint32_t>(AscendC::GetBlockNum());

    for (uint32_t tile_id = static_cast<uint32_t>(AscendC::GetBlockIdx()); tile_id < total_tiles; tile_id += step) {
        uint32_t tile_y = tile_id / tiles_x;
        uint32_t tile_x = tile_id - tile_y * tiles_x;
        uint32_t tile_offset = tile_y * TILE_DIM * width + tile_x * TILE_DIM;
        copy_gm_tile_to_ub(&tile[0][0], input + tile_offset, width);
        sync_mte2_to_v();
        asc_vf_call<simt_store_tile>(dim3(TILE_DIM, TILE_DIM, 1), output, &tile[0][0], height, tiles_x, tile_id);
        sync_v_to_mte2();
    }
}

void launch_case_kernel(float *output, float *input, const LaunchConfig &config)
{
    uint32_t total_tiles = (config.width / TILE_DIM) * (config.height / TILE_DIM);
    transpose_ub_kernel<<<config.core_num, 0, config.stream>>>(output, input, config.width, config.height, total_tiles);
}
#endif

#if SCENARIO_NUM == 6 || SCENARIO_NUM == 7
__simt_vf__ __launch_bounds__(THREADS_PER_BLOCK) inline void simt_store_pad_tile(__gm__ float *output,
                                                                                 __ubuf__ float *tile,
                                                                                 uint32_t height, uint32_t tiles_x,
                                                                                 uint32_t tile_id)
{
    uint32_t tx = threadIdx.x;
    uint32_t ty = threadIdx.y;
    uint32_t tile_y = tile_id / tiles_x;
    uint32_t tile_x = tile_id - tile_y * tiles_x;
    uint32_t x_index = tile_y * TILE_DIM + tx;
    uint32_t y_index = tile_x * TILE_DIM + ty;
    output[x_index + y_index * height] = tile[tx * TILE_PAD_STRIDE + ty];
}

__global__ __vector__ void transpose_ub_pad_kernel(__gm__ float *output, __gm__ float *input,
                                                   uint32_t width, uint32_t height, uint32_t total_tiles)
{
#if SCENARIO_NUM == 6
    __ubuf__ float tile[TILE_DIM][TILE_PAD_STRIDE];
#else
    __ubuf__ float tile[2][TILE_DIM][TILE_PAD_STRIDE];
    uint32_t cnt = 0;
#endif
    uint32_t tiles_x = width / TILE_DIM;
    uint32_t step = static_cast<uint32_t>(AscendC::GetBlockNum());

    for (uint32_t tile_id = static_cast<uint32_t>(AscendC::GetBlockIdx()); tile_id < total_tiles; tile_id += step) {
        uint32_t tile_y = tile_id / tiles_x;
        uint32_t tile_x = tile_id - tile_y * tiles_x;
        uint32_t tile_offset = tile_y * TILE_DIM * width + tile_x * TILE_DIM;
#if SCENARIO_NUM == 6
        copy_gm_tile_to_ub(&tile[0][0], input + tile_offset, width, TILE_PAD_STRIDE * sizeof(float));
        sync_mte2_to_v();
        asc_vf_call<simt_store_pad_tile>(dim3(TILE_DIM, TILE_DIM, 1), output, &tile[0][0], height, tiles_x, tile_id);
        sync_v_to_mte2();
#else
        copy_gm_tile_to_ub(&tile[cnt][0][0], input + tile_offset, width, TILE_PAD_STRIDE * sizeof(float));
        sync_mte2_to_v();
        asc_vf_call<simt_store_pad_tile>(dim3(TILE_DIM, TILE_DIM, 1), output, &tile[cnt][0][0], height, tiles_x, tile_id);
        sync_v_to_mte2();
        cnt ^= 1;
#endif
    }
}

void launch_case_kernel(float *output, float *input, const LaunchConfig &config)
{
    uint32_t total_tiles = (config.width / TILE_DIM) * (config.height / TILE_DIM);
    transpose_ub_pad_kernel<<<config.core_num, 0, config.stream>>>(output, input, config.width, config.height,
                                                                   total_tiles);
}
#endif

std::vector<float> run_case(const std::vector<float> &input_host,
                            const std::vector<uint32_t> &input_shape)
{
    const size_t tensor_elem_count = input_host.size();
    const size_t tensor_byte_size = tensor_elem_count * sizeof(float);
    std::vector<float> output_host(tensor_elem_count, 0.0f);

    const uint32_t matrix_height = input_shape[0];
    const uint32_t matrix_width = input_shape[1];

    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float *input_device = nullptr;
    float *output_device = nullptr;
    aclrtMalloc(reinterpret_cast<void **>(&input_device), tensor_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&output_device), tensor_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, tensor_byte_size, input_host.data(), tensor_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    LaunchConfig launch_config = {
        matrix_width,
        matrix_height,
        get_vector_core_num(0),
        stream,
    };
    launch_case_kernel(output_device, input_device, launch_config);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(output_host.data(), tensor_byte_size, output_device, tensor_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    const char *err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return output_host;
}

int main(int argc, char **argv)
{
    const uint32_t kernel_kind = static_cast<uint32_t>(SCENARIO_NUM);
    uint32_t matrix_size = 1024;
    if (argc > 1) {
        char *end = nullptr;
        unsigned long value = std::strtoul(argv[1], &end, 10);
        if (end != argv[1] && *end == '\0' && value > 0) {
            matrix_size = static_cast<uint32_t>(value);
        }
    }

    printf("Usage: %s [matrix_size] (compile-time SCENARIO_NUM=%u)\n", argv[0], kernel_kind);
    printf("Running case %u: %s...\n", kernel_kind, get_kernel_name(static_cast<int32_t>(kernel_kind)));
    printf("Threads/Thread Block: %u\n", THREADS_PER_BLOCK);
    printf("Matrix shape: %u x %u\n", matrix_size, matrix_size);

    if (matrix_size - (matrix_size / TILE_DIM) * TILE_DIM != 0) {
        std::fprintf(stderr, "Matrix shape must be multiple of TILE_DIM=%d.\n", TILE_DIM);
        return EXIT_FAILURE;
    }

    const std::vector<uint32_t> input_shape = {matrix_size, matrix_size};
    const size_t tensor_elem_count = static_cast<size_t>(matrix_size) * matrix_size;
    std::vector<float> input(tensor_elem_count);
    for (size_t i = 0; i < tensor_elem_count; ++i) {
        input[i] = static_cast<float>(i * 1.25f);
    }

    const int32_t golden_kind = (kernel_kind <= 1) ? 0 : 1;
    auto golden = compute_golden(input, input_shape, golden_kind);
    auto output = run_case(input, input_shape);

    return verify_result(output, golden);
}
