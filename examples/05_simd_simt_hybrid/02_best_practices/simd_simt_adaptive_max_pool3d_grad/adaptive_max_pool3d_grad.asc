#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"

#include "adaptive_max_pool3d_grad_simd.h"
#include "adaptive_max_pool3d_grad_scalar.h"
#include "adaptive_max_pool3d_grad_hybrid.h"
#include "adaptive_max_pool3d_grad_hybrid_ub.h"

namespace {

enum class Implementation {
    SIMD,
    SCALAR,
    HYBRID,
    HYBRID_UB,
};

bool parse_implementation(const char* value, Implementation& implementation)
{
    if (std::strcmp(value, "simd") == 0) {
        implementation = Implementation::SIMD;
        return true;
    }
    if (std::strcmp(value, "scalar") == 0) {
        implementation = Implementation::SCALAR;
        return true;
    }
    if (std::strcmp(value, "hybrid") == 0) {
        implementation = Implementation::HYBRID;
        return true;
    }
    if (std::strcmp(value, "hybrid_ub") == 0) {
        implementation = Implementation::HYBRID_UB;
        return true;
    }
    return false;
}

bool parse_profile_mode(const char* value, bool& profileMode)
{
    if (std::strcmp(value, "profile") == 0) {
        profileMode = true;
        return true;
    }
    return false;
}

constexpr uint32_t BATCH_SIZE = 1;
constexpr uint32_t CHANNEL_SIZE = 4096;
constexpr uint32_t D_IN = 32;
constexpr uint32_t H_IN = 32;
constexpr uint32_t W_IN = 32;
constexpr uint32_t D_OUT = 8;
constexpr uint32_t H_OUT = 8;
constexpr uint32_t W_OUT = 8;
constexpr uint32_t BLOCK_COUNT = 64;

static_assert(D_IN % D_OUT == 0, "D_IN must be divisible by D_OUT in this sample");
static_assert(H_IN % H_OUT == 0, "H_IN must be divisible by H_OUT in this sample");
static_assert(W_IN % W_OUT == 0, "W_IN must be divisible by W_OUT in this sample");

constexpr uint32_t NC = BATCH_SIZE * CHANNEL_SIZE;
constexpr uint32_t INPUT_SPATIAL = D_IN * H_IN * W_IN;
constexpr uint32_t OUTPUT_SPATIAL = D_OUT * H_OUT * W_OUT;
constexpr uint64_t INPUT_COUNT = static_cast<uint64_t>(NC) * INPUT_SPATIAL;
constexpr uint64_t GRAD_COUNT = static_cast<uint64_t>(NC) * OUTPUT_SPATIAL;
constexpr uint32_t DATA_SEED = 2026;
constexpr uint32_t MAX_DIFF_PRINT_COUNT = 100;
constexpr float VERIFY_ATOL = 1e-5F;

static_assert(OUTPUT_SPATIAL <= hybrid_ub_impl::GRAD_UB_SIZE,
              "hybrid_ub static grad/argmax UB capacity only covers D_OUT/H_OUT/W_OUT up to 16");
static_assert(INPUT_SPATIAL <= hybrid_ub_impl::INPUT_UB_SIZE,
              "hybrid_ub static output UB capacity only covers input shape [1, C, 32, 32, 32]");

uint32_t next_random(uint32_t& state)
{
    state = state * 1664525U + 1013904223U;
    return state;
}

void generate_input_data(std::vector<float>& grad, std::vector<int32_t>& argmax)
{
    uint32_t state = DATA_SEED;
    constexpr uint32_t dTile = D_IN / D_OUT;
    constexpr uint32_t hTile = H_IN / H_OUT;
    constexpr uint32_t wTile = W_IN / W_OUT;

    for (uint64_t ncIndex = 0; ncIndex < NC; ++ncIndex) {
        for (uint32_t od = 0; od < D_OUT; ++od) {
            for (uint32_t oh = 0; oh < H_OUT; ++oh) {
                for (uint32_t ow = 0; ow < W_OUT; ++ow) {
                    const uint64_t outputIndex =
                        (static_cast<uint64_t>(od) * H_OUT + oh) * W_OUT + ow;
                    const uint64_t gradIndex = ncIndex * OUTPUT_SPATIAL + outputIndex;
                    const float unitValue =
                        static_cast<float>(next_random(state) & 0x00FFFFFFU) / 8388608.0F;
                    const uint32_t localD = next_random(state) % dTile;
                    const uint32_t localH = next_random(state) % hTile;
                    const uint32_t localW = next_random(state) % wTile;
                    const uint32_t inputD = od * dTile + localD;
                    const uint32_t inputH = oh * hTile + localH;
                    const uint32_t inputW = ow * wTile + localW;

                    grad[static_cast<size_t>(gradIndex)] = unitValue - 1.0F;
                    argmax[static_cast<size_t>(gradIndex)] =
                        static_cast<int32_t>((inputD * H_IN + inputH) * W_IN + inputW);
                }
            }
        }
    }
}

bool check_argmax_range(const std::vector<int32_t>& argmax)
{
    for (size_t index = 0; index < argmax.size(); ++index) {
        if (argmax[index] < 0 || static_cast<uint32_t>(argmax[index]) >= INPUT_SPATIAL) {
            std::fprintf(stderr, "ERROR! argmax[%zu]=%d is out of input spatial range [0, %u)\n", index,
                         argmax[index], INPUT_SPATIAL);
            return false;
        }
    }
    return true;
}

void generate_golden_data(const std::vector<float>& grad, const std::vector<int32_t>& argmax,
                        std::vector<float>& golden)
{
    std::fill(golden.begin(), golden.end(), 0.0F);
    for (uint64_t gradIndex = 0; gradIndex < GRAD_COUNT; ++gradIndex) {
        const uint64_t ncIndex = gradIndex / OUTPUT_SPATIAL;
        const uint64_t inputIndex =
            ncIndex * INPUT_SPATIAL + static_cast<uint64_t>(argmax[static_cast<size_t>(gradIndex)]);
        golden[static_cast<size_t>(inputIndex)] += grad[static_cast<size_t>(gradIndex)];
    }
}

bool verify_result(const std::vector<float>& output, const std::vector<float>& golden)
{
    if (output.size() != golden.size()) {
        std::fprintf(stderr, "ERROR! output size: %zu, golden size: %zu\n", output.size(), golden.size());
        return false;
    }

    uint64_t diffCount = 0;
    for (size_t index = 0; index < output.size(); ++index) {
        const float diff = output[index] > golden[index] ? output[index] - golden[index] :
            golden[index] - output[index];
        if (diff <= VERIFY_ATOL) {
            continue;
        }
        if (diffCount < MAX_DIFF_PRINT_COUNT) {
            std::fprintf(stderr, "data index: %06zu, expected: %.9f, actual: %.9f\n",
                         index, golden[index], output[index]);
        }
        ++diffCount;
    }

    const double errorRatio = static_cast<double>(diffCount) / static_cast<double>(golden.size());
    std::fprintf(stdout, "error ratio: %.4f\n", errorRatio);
    if (diffCount != 0) {
        std::fprintf(stderr, "ERROR! result error\n");
        return false;
    }
    std::fprintf(stdout, "test pass!\n");
    return true;
}

void print_usage(const char* program)
{
    std::fprintf(stderr, "ERROR! Usage: %s <simd|scalar|hybrid|hybrid_ub> [profile]\n",
                 program);
}

bool check_acl(aclError error, const char* operation)
{
    if (error == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ERROR! %s failed with ACL error %d: %s\n", operation, error, aclGetRecentErrMsg());
    return false;
}

void launch_kernel(Implementation implementation, uint8_t* gradDevice, uint8_t* argmaxDevice,
                  uint8_t* inputDevice, aclrtStream stream)
{
    if (implementation == Implementation::SIMD) {
        adaptive_max_pool3d_grad_simd_kernel<<<BLOCK_COUNT, 0, stream>>>(
            gradDevice, argmaxDevice, inputDevice, NC, D_IN, H_IN, W_IN, D_OUT, H_OUT, W_OUT);
    } else if (implementation == Implementation::SCALAR) {
        adaptive_max_pool3d_grad_scalar_kernel<<<BLOCK_COUNT, 0, stream>>>(
            gradDevice, argmaxDevice, inputDevice, NC, INPUT_SPATIAL, OUTPUT_SPATIAL);
    } else if (implementation == Implementation::HYBRID) {
        adaptive_max_pool3d_grad_hybrid_kernel<<<BLOCK_COUNT, 0, stream>>>(
            gradDevice, argmaxDevice, inputDevice, NC, INPUT_SPATIAL, OUTPUT_SPATIAL);
    } else {
        adaptive_max_pool3d_grad_hybrid_ub_kernel<<<BLOCK_COUNT, 0, stream>>>(
            gradDevice, argmaxDevice, inputDevice, NC, INPUT_SPATIAL, OUTPUT_SPATIAL);
    }
}

} // namespace

int main(int argc, char* argv[])
{
    if (argc < 2) {
        print_usage(argv[0]);
        return 1;
    }

    Implementation implementation = Implementation::SIMD;
    if (!parse_implementation(argv[1], implementation)) {
        print_usage(argv[0]);
        return 1;
    }

    bool profileMode = false;
    if (argc > 3 || (argc == 3 && !parse_profile_mode(argv[2], profileMode))) {
        print_usage(argv[0]);
        return 1;
    }

    const size_t gradBytes = static_cast<size_t>(GRAD_COUNT) * sizeof(float);
    const size_t argmaxBytes = static_cast<size_t>(GRAD_COUNT) * sizeof(int32_t);
    const size_t inputBytes = static_cast<size_t>(INPUT_COUNT) * sizeof(float);
    std::vector<float> gradHost(static_cast<size_t>(GRAD_COUNT));
    std::vector<int32_t> argmaxHost(static_cast<size_t>(GRAD_COUNT));
    std::vector<float> inputHost;
    std::vector<float> goldenHost;

    generate_input_data(gradHost, argmaxHost);
    if (!check_argmax_range(argmaxHost)) {
        return 1;
    }
    if (!profileMode) {
        inputHost.resize(static_cast<size_t>(INPUT_COUNT));
        goldenHost.resize(static_cast<size_t>(INPUT_COUNT));
        generate_golden_data(gradHost, argmaxHost, goldenHost);
    }

    if (!check_acl(aclInit(nullptr), "aclInit") || !check_acl(aclrtSetDevice(0), "aclrtSetDevice")) {
        return 1;
    }

    aclrtStream stream = nullptr;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }

    uint8_t* gradDevice = nullptr;
    uint8_t* argmaxDevice = nullptr;
    uint8_t* inputDevice = nullptr;
    bool ok = check_acl(aclrtMalloc(reinterpret_cast<void**>(&gradDevice), gradBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                       "aclrtMalloc grad") &&
              check_acl(aclrtMalloc(reinterpret_cast<void**>(&argmaxDevice), argmaxBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                       "aclrtMalloc argmax") &&
              check_acl(aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                       "aclrtMalloc input") &&
              check_acl(aclrtMemcpy(gradDevice, gradBytes, gradHost.data(), gradBytes, ACL_MEMCPY_HOST_TO_DEVICE),
                       "copy grad") &&
              check_acl(aclrtMemcpy(argmaxDevice, argmaxBytes, argmaxHost.data(), argmaxBytes,
                                   ACL_MEMCPY_HOST_TO_DEVICE),
                       "copy argmax");

    if (ok) {
        launch_kernel(implementation, gradDevice, argmaxDevice, inputDevice, stream);
    }
    ok = ok && check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
    if (ok && !profileMode) {
        ok = check_acl(aclrtMemcpy(inputHost.data(), inputBytes, inputDevice, inputBytes,
                                  ACL_MEMCPY_DEVICE_TO_HOST),
                      "copy input");
    }

    if (gradDevice != nullptr) {
        aclrtFree(gradDevice);
    }
    if (argmaxDevice != nullptr) {
        aclrtFree(argmaxDevice);
    }
    if (inputDevice != nullptr) {
        aclrtFree(inputDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(0);
    aclFinalize();

    if (!ok) {
        return 1;
    }
    if (profileMode) {
        std::fprintf(stdout, "[Profile] Kernel execution completed; result verification skipped.\n");
        return 0;
    }
    return verify_result(inputHost, goldenHost) ? 0 : 1;
}
