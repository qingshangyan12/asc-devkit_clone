#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"
#include "basic_api/kernel_operator_block_sync_intf.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 4
#endif

static_assert(SCENARIO_NUM >= 0 && SCENARIO_NUM <= 8, "SCENARIO_NUM must be 0..8");

#define REGION_COUNT 8192U
#define BLOCK_COUNT 63U
#define INPUT_COUNT (REGION_COUNT * BLOCK_COUNT)
#if SCENARIO_NUM == 0
#define COMPACTION_COUNT REGION_COUNT
#else
#define COMPACTION_COUNT INPUT_COUNT
#endif
#define THREAD_COUNT 1024U
#define WARP_COUNT 32U
#define TILE_COUNT (REGION_COUNT / THREAD_COUNT)
#define TILE_WARP_COUNT (TILE_COUNT * WARP_COUNT)
#define ITEMS_PER_THREAD 4U
#define TILE_BATCH_COUNT (REGION_COUNT / (THREAD_COUNT * ITEMS_PER_THREAD))
#define TILE_BATCH_WARP_COUNT (TILE_BATCH_COUNT * WARP_COUNT)
#define OUTPUT_SENTINEL INT32_MIN

static_assert(REGION_COUNT % THREAD_COUNT == 0U, "REGION_COUNT must be a multiple of THREAD_COUNT");
static_assert(TILE_COUNT <= WARP_COUNT, "the prescan maps one tile onto one warp of the first TILE_COUNT warps");
static_assert(
    REGION_COUNT % (THREAD_COUNT * ITEMS_PER_THREAD) == 0U,
    "REGION_COUNT must be a multiple of THREAD_COUNT * ITEMS_PER_THREAD for the short-vector batches");

typedef struct {
    int32_t* input;
    int32_t* output;
    uint32_t* selected_count;
    uint32_t* block_counts;
} DeviceBuffers;

static bool check_acl(aclError result, const char* expression, const char* file, int32_t line)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    fprintf(stderr, "ACL call failed: %s, ret=%d, at %s:%d\n", expression, (int32_t)result, file, line);
    return false;
}

static bool is_selected_host(int32_t value) { return (value % 7 == 0) || (value % 11 == 3); }

static void fill_fixed_input(int32_t* input, uint32_t count)
{
    for (uint32_t index = 0; index < count; ++index) {
        input[index] = (int32_t)((index * 37U + 11U) % 10007U) - 5000;
    }
}

static uint32_t build_host_oracle(const int32_t* input, uint32_t count, int32_t* expected)
{
    uint32_t selected_count = 0;
    for (uint32_t index = 0; index < count; ++index) {
        if (is_selected_host(input[index])) {
            expected[selected_count] = input[index];
            ++selected_count;
        }
    }
    return selected_count;
}

static bool verify_selected_count(uint32_t actual, uint32_t expected)
{
    if (actual == expected) {
        return true;
    }
    fprintf(stderr, "Selected count mismatch: expected=%u, actual=%u\n", expected, actual);
    return false;
}

static bool verify_stable_order(const int32_t* actual, const int32_t* expected, uint32_t selected_count)
{
    for (uint32_t rank = 0; rank < selected_count; ++rank) {
        if (actual[rank] != expected[rank]) {
            fprintf(
                stderr, "Stable order mismatch: rank=%u, expected=%d, actual=%d\n", rank, expected[rank], actual[rank]);
            return false;
        }
    }
    return true;
}

static bool verify_untouched_tail(const int32_t* output, uint32_t selected_count, uint32_t capacity)
{
    for (uint32_t index = selected_count; index < capacity; ++index) {
        if (output[index] != OUTPUT_SENTINEL) {
            fprintf(
                stderr, "Output tail was overwritten: index=%u, expected=%d, actual=%d\n", index, OUTPUT_SENTINEL,
                output[index]);
            return false;
        }
    }
    return true;
}

static void reset_device_buffers(DeviceBuffers* buffers)
{
    buffers->input = NULL;
    buffers->output = NULL;
    buffers->selected_count = NULL;
    buffers->block_counts = NULL;
}

static void free_device_buffers(DeviceBuffers* buffers)
{
    if (buffers->block_counts != NULL) {
        (void)aclrtFree(buffers->block_counts);
        buffers->block_counts = NULL;
    }
    if (buffers->selected_count != NULL) {
        (void)aclrtFree(buffers->selected_count);
        buffers->selected_count = NULL;
    }
    if (buffers->output != NULL) {
        (void)aclrtFree(buffers->output);
        buffers->output = NULL;
    }
    if (buffers->input != NULL) {
        (void)aclrtFree(buffers->input);
        buffers->input = NULL;
    }
}

static bool allocate_device_buffers(DeviceBuffers* buffers)
{
    reset_device_buffers(buffers);
    aclError result = aclrtMalloc((void**)&buffers->input, INPUT_COUNT * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(input)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
    result = aclrtMalloc((void**)&buffers->output, INPUT_COUNT * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(output)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
    result = aclrtMalloc((void**)&buffers->selected_count, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(selected_count)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
#if SCENARIO_NUM != 0
    // Cases 1-7 use per-block counts inside the merged kernel.
    result = aclrtMalloc((void**)&buffers->block_counts, BLOCK_COUNT * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(result, "aclrtMalloc(block_counts)", __FILE__, __LINE__)) {
        free_device_buffers(buffers);
        return false;
    }
#endif
    return true;
}

__simt_callee__ inline bool is_selected_device(int32_t value) { return (value % 7 == 0) || (value % 11 == 3); }

__simt_callee__ inline uint32_t count_selected_before(__ubuf__ int32_t* input, uint32_t index)
{
    uint32_t rank = 0;
    for (uint32_t earlier_index = 0; earlier_index < index; ++earlier_index) {
        rank += is_selected_device(input[earlier_index]) ? 1U : 0U;
    }
    return rank;
}

__simt_callee__ inline void initialize_running_offset(
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* running_offset)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t block_index = (uint32_t)blockIdx.x;
    if (thread_index == 0U) {
        uint32_t block_base = 0U;
        for (uint32_t earlier_block = 0; earlier_block < block_index; ++earlier_block) {
            block_base += block_counts[earlier_block];
        }
        running_offset[0] = block_base;
    }
    asc_syncthreads();
}

__simt_callee__ inline void initialize_running_offset_v2(
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* running_offset)
{
    uint32_t block_count = 0U;
    if (threadIdx.x < blockIdx.x) {
        block_count = block_counts[threadIdx.x];
        block_count = asc_reduce_add(block_count);
        if (laneid() == 0U) {
            asc_atomic_add(running_offset, block_count);
        }
    }
    asc_syncthreads();
}

__simt_callee__ inline void compute_warp_exclusive_offsets(
    __ubuf__ uint32_t* warp_selected_counts, __ubuf__ uint32_t* warp_selected_offsets)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    if (thread_index < WARP_COUNT) {
        const uint32_t lane_index = (uint32_t)laneid();
        uint32_t own_count = warp_selected_counts[thread_index];
        uint32_t inclusive = own_count;
        for (uint32_t d = 1; d < warpSize; d <<= 1) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive, d);
            if (lane_index >= d) {
                inclusive += n;
            }
        }
        warp_selected_offsets[thread_index] = inclusive - own_count;
    }
    asc_syncthreads();
}

__simt_callee__ inline void write_selected_count(__gm__ uint32_t* selected_count, __gm__ const uint32_t* block_counts)
{
    if ((uint32_t)threadIdx.x == 0U && (uint32_t)blockIdx.x == 0U) {
        uint32_t total_count = 0U;
        for (uint32_t block = 0U; block < BLOCK_COUNT; ++block) {
            total_count += block_counts[block];
        }
        selected_count[0] = total_count;
    }
}

// count block hit elements
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void cal_block_count_vf(
    __ubuf__ int32_t* input, __gm__ uint32_t* block_counts, __ubuf__ uint32_t* warp_partials, uint32_t region_count)
{
    const uint32_t block_index = (uint32_t)blockIdx.x;
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t warp_index = thread_index / warpSize;

    uint32_t local_count = 0U;
    for (uint32_t offset = thread_index; offset < region_count; offset += THREAD_COUNT) {
        local_count += is_selected_device(input[offset]) ? 1U : 0U;
    }

    local_count = asc_reduce_add(local_count);
    // if (laneid() == 0) {
    //     asc_atomic_add(&block_counts[block_index], local_count);
    // }
    if (laneid() == 0) {
        warp_partials[warp_index] = local_count;
    }
    asc_syncthreads();

    // if (thread_index == 0U) {
    //     uint32_t region_total = 0U;
    //     for (uint32_t warp = 0; warp < WARP_COUNT; ++warp) {
    //         region_total += warp_partials[warp];
    //     }
    //     block_counts[block_index] = region_total;
    // }

    uint32_t block_count = 0U;
    if (warp_index == 0U) {
        uint32_t own = warp_partials[laneid()];
        block_count = asc_reduce_add(own);
    }

    if (thread_index == 0U) {
        block_counts[block_index] = block_count;
    }
}

__aicore__ inline void copy_input_to_ub(__ubuf__ int32_t* input_region, __gm__ int32_t* input, uint32_t count)
{
    const uint32_t copy_bytes = count * sizeof(int32_t);
    asc_copy_gm2ub_align(input_region, input, 1, copy_bytes, 0, 0, false, asc_load_l2_cache_mode::NOTALLOC_KEEP, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_atomic_rank_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, uint32_t input_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t thread_stride = (uint32_t)gridDim.x * blockDim.x;
    const uint32_t grid_offset = (uint32_t)blockIdx.x * blockDim.x + thread_index;

    for (uint32_t input_index = grid_offset; input_index < input_count; input_index += thread_stride) {
        int32_t value = input[input_index];
        if (!is_selected_device(value)) {
            continue;
        }

        asc_atomic_add(selected_count, 1U);
        uint32_t stable_rank = count_selected_before(input, input_index);
        output[stable_rank] = value;
    }
}

// Case 0
__global__ __vector__ void compact_atomic_rank_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, uint32_t input_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    copy_input_to_ub(input_region, input, input_count);
    asc_vf_call<compact_atomic_rank_vf>(dim3(THREAD_COUNT), input_region, output, selected_count, input_count);
}

// Case 6: same cooperative skeleton as Case 1 (per-block counting pass +
// SyncAll + block base), but the in-region rank of each hit still comes from
// an independent rescan, and the total still comes from atomic adds. This
// shows the quadratic/atomic baseline on the full input with the exact data
// layout of the other cases.
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_atomic_rank_full_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* running_offset, uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;

    initialize_running_offset(block_counts, running_offset);
    const uint32_t block_base = running_offset[0];

    for (uint32_t input_index = thread_index; input_index < region_count; input_index += THREAD_COUNT) {
        int32_t value = input[input_index];
        if (!is_selected_device(value)) {
            continue;
        }
        (void)asc_atomic_add(selected_count, 1U);
        uint32_t stable_rank = block_base + count_selected_before(input, input_index);
        output[stable_rank] = value;
    }
}

// Case 6
__global__ __vector__ void compact_atomic_rank_full_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t warp_partials[THREAD_COUNT / warpSize];
    __ubuf__ uint32_t running_offset[1];
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<cal_block_count_vf>(dim3(THREAD_COUNT), input_region, block_counts, warp_partials, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_atomic_rank_full_vf>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, running_offset, region_count);
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_thread_prefix_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* thread_selected_flags,
    __ubuf__ uint32_t* thread_selected_offsets, __ubuf__ uint32_t* running_offset, uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;

    initialize_running_offset(block_counts, running_offset);

    for (uint32_t tile_start = 0; tile_start < region_count; tile_start += THREAD_COUNT) {
        uint32_t input_index = tile_start + thread_index;
        bool valid = input_index < region_count;
        int32_t value = valid ? input[input_index] : 0;
        bool selected = valid && is_selected_device(value);
        thread_selected_flags[thread_index] = selected ? 1U : 0U;
        asc_syncthreads();

        uint32_t thread_prefix = 0U;
        for (uint32_t earlier = 0; earlier < thread_index; ++earlier) {
            thread_prefix += thread_selected_flags[earlier];
        }
        thread_selected_offsets[thread_index] = thread_prefix;
        asc_syncthreads();

        if (selected) {
            uint32_t stable_rank = running_offset[0] + thread_prefix;
            output[stable_rank] = value;
        }
        asc_syncthreads();

        if (thread_index == 0) {
            running_offset[0] += thread_selected_offsets[THREAD_COUNT - 1] + thread_selected_flags[THREAD_COUNT - 1];
        }
        asc_syncthreads();
    }

    write_selected_count(selected_count, block_counts);
}

// case 1
__global__ __vector__ void compact_thread_prefix_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t warp_partials[THREAD_COUNT / warpSize];
    __ubuf__ uint32_t thread_selected_flags[THREAD_COUNT];
    __ubuf__ uint32_t thread_selected_offsets[THREAD_COUNT];
    __ubuf__ uint32_t running_offset[1];
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<cal_block_count_vf>(dim3(THREAD_COUNT), input_region, block_counts, warp_partials, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_thread_prefix_vf>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, thread_selected_flags,
        thread_selected_offsets, running_offset, region_count);
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_warp_shared_flags_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* thread_selected_flags,
    __ubuf__ uint32_t* warp_selected_counts, __ubuf__ uint32_t* warp_selected_offsets,
    __ubuf__ uint32_t* running_offset, uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    initialize_running_offset(block_counts, running_offset);

    for (uint32_t tile_start = 0; tile_start < region_count; tile_start += THREAD_COUNT) {
        uint32_t input_index = tile_start + thread_index;
        bool valid = input_index < region_count;
        int32_t value = valid ? input[input_index] : 0;
        bool selected = valid && is_selected_device(value);
        thread_selected_flags[thread_index] = selected ? 1U : 0U;
        asc_syncthreads();

        uint32_t warp_base = warp_index * warpSize;
        uint32_t lane_offset = 0U;
        uint32_t warp_selected_count = 0U;
        for (uint32_t lane = 0U; lane < warpSize; ++lane) {
            uint32_t flag = thread_selected_flags[warp_base + lane];
            warp_selected_count += flag;
            if (lane < lane_index) {
                lane_offset += flag;
            }
        }
        if (lane_index == 0) {
            warp_selected_counts[warp_index] = warp_selected_count;
        }
        asc_syncthreads();

        compute_warp_exclusive_offsets(warp_selected_counts, warp_selected_offsets);

        if (selected) {
            uint32_t stable_rank = running_offset[0] + warp_selected_offsets[warp_index] + lane_offset;
            output[stable_rank] = value;
        }
        asc_syncthreads();

        if (thread_index == 0) {
            running_offset[0] += warp_selected_offsets[WARP_COUNT - 1] + warp_selected_counts[WARP_COUNT - 1];
        }
        asc_syncthreads();
    }

    write_selected_count(selected_count, block_counts);
}

// Case 2
__global__ __vector__ void compact_warp_shared_flags_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t warp_partials[THREAD_COUNT / warpSize];
    __ubuf__ uint32_t thread_selected_flags[THREAD_COUNT];
    __ubuf__ uint32_t warp_selected_counts[WARP_COUNT];
    __ubuf__ uint32_t warp_selected_offsets[WARP_COUNT];
    __ubuf__ uint32_t running_offset[1];
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<cal_block_count_vf>(dim3(THREAD_COUNT), input_region, block_counts, warp_partials, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_warp_shared_flags_vf>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, thread_selected_flags,
        warp_selected_counts, warp_selected_offsets, running_offset, region_count);
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_warp_ballot_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* warp_selected_counts,
    __ubuf__ uint32_t* warp_selected_offsets, __ubuf__ uint32_t* running_offset, uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    initialize_running_offset(block_counts, running_offset);

    for (uint32_t tile_start = 0; tile_start < region_count; tile_start += THREAD_COUNT) {
        uint32_t input_index = tile_start + thread_index;
        bool valid = input_index < region_count;
        int32_t value = valid ? input[input_index] : 0;
        bool selected = valid && is_selected_device(value);

        uint32_t selected_mask = asc_ballot(selected ? 1 : 0);
        uint32_t warp_selected_count = (uint32_t)__popc(selected_mask);
        uint32_t lane_offset = (uint32_t)__popc(selected_mask & (uint32_t)lanemask_lt());
        if (lane_index == 0) {
            warp_selected_counts[warp_index] = warp_selected_count;
        }
        asc_syncthreads();

        compute_warp_exclusive_offsets(warp_selected_counts, warp_selected_offsets);

        if (selected) {
            uint32_t stable_rank = running_offset[0] + warp_selected_offsets[warp_index] + lane_offset;
            output[stable_rank] = value;
        }
        asc_syncthreads();

        if (thread_index == 0) {
            running_offset[0] += warp_selected_offsets[WARP_COUNT - 1] + warp_selected_counts[WARP_COUNT - 1];
        }
        asc_syncthreads();
    }

    write_selected_count(selected_count, block_counts);
}

// Case 3
__global__ __vector__ void compact_warp_ballot_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t warp_partials[THREAD_COUNT / warpSize];
    __ubuf__ uint32_t warp_selected_counts[WARP_COUNT];
    __ubuf__ uint32_t warp_selected_offsets[WARP_COUNT];
    __ubuf__ uint32_t running_offset[1];
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<cal_block_count_vf>(dim3(THREAD_COUNT), input_region, block_counts, warp_partials, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_warp_ballot_vf>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, warp_selected_counts,
        warp_selected_offsets, running_offset, region_count);
}

// Case 4
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_warp_ballot_batched_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* warp_selected_counts,
    __ubuf__ uint32_t* warp_selected_offsets, __ubuf__ uint32_t* running_offset, uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    initialize_running_offset(block_counts, running_offset);

    for (uint32_t tile_start = 0; tile_start < region_count; tile_start += THREAD_COUNT * ITEMS_PER_THREAD) {
        const uint32_t my_base = tile_start + thread_index * ITEMS_PER_THREAD;
        uint32_t valid_bits = 0U;
        int32_t values[ITEMS_PER_THREAD];
        for (uint32_t k = 0; k < ITEMS_PER_THREAD; ++k) {
            // uint32_t idx = my_base + k;
            // bool valid = idx < region_count;
            // int32_t value = valid ? input[idx] : 0;
            values[k] = input[my_base + k];
            valid_bits |= (is_selected_device(values[k])) ? (1U << k) : 0U;
        }
        uint32_t thread_hits = (uint32_t)__popc(valid_bits);

        // inclusive_prefix = sum of thread_hits over lanes [0, lane_index]
        uint32_t inclusive_prefix = thread_hits;
        for (uint32_t d = 1; d < warpSize; d <<= 1) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive_prefix, d);
            if (lane_index >= d) {
                inclusive_prefix += n;
            }
        }
        uint32_t warp_total = (uint32_t)asc_shfl((int32_t)inclusive_prefix, (int32_t)(warpSize - 1));

        if (lane_index == 0) {
            warp_selected_counts[warp_index] = warp_total;
        }
        asc_syncthreads();

        compute_warp_exclusive_offsets(warp_selected_counts, warp_selected_offsets);

        uint32_t my_base_rank =
            running_offset[0] + warp_selected_offsets[warp_index] + (inclusive_prefix - (uint32_t)__popc(valid_bits));
        for (uint32_t k = 0; k < ITEMS_PER_THREAD; ++k) {
            if ((valid_bits & (1U << k)) != 0U) {
                uint32_t sub_offset = (uint32_t)__popc(valid_bits & ((1U << k) - 1U));
                output[my_base_rank + sub_offset] = values[k];
            }
        }
        asc_syncthreads();

        if (thread_index == 0) {
            running_offset[0] += warp_selected_offsets[WARP_COUNT - 1] + warp_selected_counts[WARP_COUNT - 1];
        }
        asc_syncthreads();
    }

    write_selected_count(selected_count, block_counts);
}

// Case 4
__global__ __vector__ void compact_warp_ballot_batched_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t warp_partials[THREAD_COUNT / warpSize];
    __ubuf__ uint32_t warp_selected_counts[WARP_COUNT];
    __ubuf__ uint32_t warp_selected_offsets[WARP_COUNT];
    __ubuf__ uint32_t running_offset[1];
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<cal_block_count_vf>(dim3(THREAD_COUNT), input_region, block_counts, warp_partials, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_warp_ballot_batched_vf>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, warp_selected_counts,
        warp_selected_offsets, running_offset, region_count);
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_warp_ballot_batched_vf_short_vector(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* warp_selected_counts,
    __ubuf__ uint32_t* warp_selected_offsets, __ubuf__ uint32_t* running_offset, uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;
    // int4 short_vector;
    initialize_running_offset_v2(block_counts, running_offset);

    for (uint32_t tile_start = 0; tile_start < region_count; tile_start += THREAD_COUNT * ITEMS_PER_THREAD) {
        const uint32_t my_base = tile_start + thread_index * ITEMS_PER_THREAD;

        const __ubuf__ int4* short_vector = reinterpret_cast<const __ubuf__ int4*>(&input[my_base]);

        uint32_t valid_bits = 0U;
        valid_bits |= is_selected_device(short_vector[0].x) ? (1U << 0) : 0U;
        valid_bits |= is_selected_device(short_vector[0].y) ? (1U << 1) : 0U;
        valid_bits |= is_selected_device(short_vector[0].z) ? (1U << 2) : 0U;
        valid_bits |= is_selected_device(short_vector[0].w) ? (1U << 3) : 0U;

        // int32_t values[ITEMS_PER_THREAD];
        // for (uint32_t k = 0; k < ITEMS_PER_THREAD; ++k) {
        //     uint32_t idx = my_base + k;
        //     bool valid = idx < region_count;
        //     int32_t value = valid ? input[idx] : 0;
        //     values[k] = value;
        //     valid_bits |= (valid && is_selected_device(value)) ? (1U << k) : 0U;
        // }
        uint32_t thread_hits = (uint32_t)__popc(valid_bits);

        // inclusive_prefix = sum of thread_hits over lanes [0, lane_index]
        uint32_t inclusive_prefix = thread_hits;
        for (uint32_t d = 1; d < warpSize; d <<= 1) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive_prefix, d);
            if (lane_index >= d) {
                inclusive_prefix += n;
            }
        }
        uint32_t warp_total = (uint32_t)asc_shfl((int32_t)inclusive_prefix, (int32_t)(warpSize - 1));

        if (lane_index == 0) {
            warp_selected_counts[warp_index] = warp_total;
        }
        asc_syncthreads();

        compute_warp_exclusive_offsets(warp_selected_counts, warp_selected_offsets);

        uint32_t my_base_rank =
            running_offset[0] + warp_selected_offsets[warp_index] + (inclusive_prefix - (uint32_t)__popc(valid_bits));
        // for (uint32_t k = 0; k < ITEMS_PER_THREAD; ++k) {
        //     if ((valid_bits & (1U << k)) != 0U) {
        //         uint32_t sub_offset = (uint32_t)__popc(valid_bits & ((1U << k) - 1U));
        //         output[my_base_rank + sub_offset] = values[k];
        //     }
        // }

        uint32_t sub_offset;
        if ((valid_bits & (1U << 0)) != 0U) {
            sub_offset = (uint32_t)__popc(valid_bits & ((1U << 0) - 1U));
            output[my_base_rank + sub_offset] = short_vector[0].x;
        }
        if ((valid_bits & (1U << 1)) != 0U) {
            sub_offset = (uint32_t)__popc(valid_bits & ((1U << 1) - 1U));
            output[my_base_rank + sub_offset] = short_vector[0].y;
        }
        if ((valid_bits & (1U << 2)) != 0U) {
            sub_offset = (uint32_t)__popc(valid_bits & ((1U << 2) - 1U));
            output[my_base_rank + sub_offset] = short_vector[0].z;
        }
        if ((valid_bits & (1U << 3)) != 0U) {
            sub_offset = (uint32_t)__popc(valid_bits & ((1U << 3) - 1U));
            output[my_base_rank + sub_offset] = short_vector[0].w;
        }

        asc_syncthreads();

        if (thread_index == 0) {
            running_offset[0] += warp_selected_offsets[WARP_COUNT - 1] + warp_selected_counts[WARP_COUNT - 1];
        }
        asc_syncthreads();
    }

    write_selected_count(selected_count, block_counts);
}

// Case 5
__global__ __vector__ void compact_short_xiangliang(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t warp_partials[THREAD_COUNT / warpSize];
    __ubuf__ uint32_t warp_selected_counts[WARP_COUNT];
    __ubuf__ uint32_t warp_selected_offsets[WARP_COUNT];
    __ubuf__ uint32_t running_offset[1];
    running_offset[0] = 0U;
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<cal_block_count_vf>(dim3(THREAD_COUNT), input_region, block_counts, warp_partials, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_warp_ballot_batched_vf_short_vector>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, warp_selected_counts,
        warp_selected_offsets, running_offset, region_count);
}

// Reuses the counting pass: instead of collapsing each block's hits into a
// single total, the first vf keeps per-(tile, warp) hit counts in UB and
// exclusive-scans that table once, so every (tile, warp) pair already knows
// its output base before the compaction vf starts. The tile loop in the
// second vf then needs no cross-warp scan and no asc_syncthreads at all:
// each warp locates its hits with asc_ballot + lanemask_lt in registers only.
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void count_tile_warp_hits_vf(
    __ubuf__ int32_t* input, __gm__ uint32_t* block_counts, __ubuf__ uint32_t* tile_warp_bases,
    __ubuf__ uint32_t* tile_scratch, uint32_t region_count)
{
    const uint32_t block_index = (uint32_t)blockIdx.x;
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    // Pass 1: per-(tile, warp) hit counts, same element traversal as
    // cal_block_count_vf (thread t touches t, t+THREAD_COUNT, ...). Warp w of
    // the block always owns the slice [tile*THREAD_COUNT + w*warpSize, +32),
    // matching the ownership in the compaction vf below.
    for (uint32_t tile = 0U; tile < TILE_COUNT; ++tile) {
        uint32_t idx = tile * THREAD_COUNT + thread_index;
        bool valid = idx < region_count;
        uint32_t hit = (valid && is_selected_device(input[idx])) ? 1U : 0U;
        uint32_t warp_hits = (uint32_t)asc_reduce_add(hit);
        if (lane_index == 0U) {
            tile_warp_bases[tile * WARP_COUNT + warp_index] = warp_hits;
        }
    }
    asc_syncthreads();

    // Pass 2, level 1: the first TILE_COUNT warps each scan one tile's row
    // (lane = warp within the tile), turning hit counts into offsets between
    // warps of the same tile. The row total goes to tile_scratch[tile]
    // tile_scratch 记录的是每一个tile的命中总数
    // tile_warp_bases记录的是每一个[tile, warp]对应的offset
    if (warp_index < TILE_COUNT) {
        uint32_t own = tile_warp_bases[warp_index * WARP_COUNT + lane_index];
        uint32_t inclusive = own;
        for (uint32_t d = 1U; d < warpSize; d <<= 1U) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive, (int32_t)d);
            if (lane_index >= d) {
                inclusive += n;
            }
        }
        tile_warp_bases[warp_index * WARP_COUNT + lane_index] = inclusive - own;
        uint32_t row_total = (uint32_t)asc_shfl((int32_t)inclusive, (int32_t)(WARP_COUNT - 1U));
        if (lane_index == 0U) {
            tile_scratch[warp_index] = row_total;
        }
    }
    asc_syncthreads();

    // Pass 2, level 2: warp 0 scans the tile totals into offsets between
    // tiles. Its last inclusive value is the block total, written to GM.
    if (thread_index < WARP_COUNT) {
        uint32_t own = (lane_index < TILE_COUNT) ? tile_scratch[lane_index] : 0U;
        uint32_t inclusive = own;
        for (uint32_t d = 1U; d < warpSize; d <<= 1U) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive, (int32_t)d);
            if (lane_index >= d) {
                inclusive += n;
            }
        }
        if (lane_index < TILE_COUNT) {
            tile_scratch[lane_index] = inclusive - own;
        }
        if (lane_index == TILE_COUNT - 1U) {
            block_counts[block_index] = inclusive;
        }
    }
    asc_syncthreads();

    // Pass 2, combine: (tile, warp) base = tile offset + warp offset inside
    // the tile. One entry per thread of the first TILE_WARP_COUNT threads.
    if (thread_index < TILE_WARP_COUNT) {
        uint32_t tile = thread_index / WARP_COUNT;
        tile_warp_bases[thread_index] += tile_scratch[tile];
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_prescanned_ballot_vf(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* tile_warp_bases, __ubuf__ uint32_t* running_offset,
    uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    initialize_running_offset_v2(block_counts, running_offset);
    const uint32_t block_base = running_offset[0];

    for (uint32_t tile = 0U; tile < TILE_COUNT; ++tile) {
        uint32_t idx = tile * THREAD_COUNT + thread_index;
        if (idx >= region_count) {
            break;
        }
        int32_t value = input[idx];
        bool selected = is_selected_device(value);
        uint32_t selected_mask = asc_ballot(selected ? 1 : 0);
        if (selected) {
            uint32_t lane_offset = (uint32_t)__popc(selected_mask & (uint32_t)lanemask_lt());
            output[block_base + tile_warp_bases[tile * WARP_COUNT + warp_index] + lane_offset] = value;
        }
    }

    if ((blockIdx.x == gridDim.x - 1) && threadIdx.x == 0) {
        selected_count[0] = block_base + block_counts[gridDim.x - 1];
    }
    // write_selected_count(selected_count, block_counts);
}

// Case 7
__global__ __vector__ void compact_prescanned_ballot_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t tile_warp_bases[TILE_WARP_COUNT];
    __ubuf__ uint32_t tile_scratch[TILE_COUNT];
    __ubuf__ uint32_t running_offset[1];
    running_offset[0] = 0U;
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<count_tile_warp_hits_vf>(
        dim3(THREAD_COUNT), input_region, block_counts, tile_warp_bases, tile_scratch, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_prescanned_ballot_vf>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, tile_warp_bases, running_offset,
        region_count);
}

// Case 8: short-vector variant of Case 7. Each thread owns ITEMS_PER_THREAD
// consecutive elements loaded as one int4, so both the prescan and the
// compaction vf work on (batch, warp) batches of THREAD_COUNT *
// ITEMS_PER_THREAD elements instead of (tile, warp) tiles of THREAD_COUNT
// elements. Halves the per-thread UB loads (8 scalar -> 2 vector) and loop
// rounds, and shrinks the prescanned base table from TILE_WARP_COUNT to
// TILE_BATCH_WARP_COUNT entries.
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void count_tile_warp_hits_vf_short_vector(
    __ubuf__ int32_t* input, __gm__ uint32_t* block_counts, __ubuf__ uint32_t* tile_warp_bases,
    __ubuf__ uint32_t* tile_scratch, uint32_t region_count)
{
    const uint32_t block_index = (uint32_t)blockIdx.x;
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    // Pass 1: per-(batch, warp) hit counts. Warp w of the block owns the slice
    // [batch * THREAD_COUNT * ITEMS_PER_THREAD + w * warpSize * ITEMS_PER_THREAD, +warpSize *
    // ITEMS_PER_THREAD), matching the ownership in the compaction vf below.
    for (uint32_t batch = 0U; batch < TILE_BATCH_COUNT; ++batch) {
        const uint32_t my_base = batch * THREAD_COUNT * ITEMS_PER_THREAD + thread_index * ITEMS_PER_THREAD;
        const __ubuf__ int4* short_vector = reinterpret_cast<const __ubuf__ int4*>(&input[my_base]);
        uint32_t valid_bits = 0U;
        valid_bits |= is_selected_device(short_vector[0].x) ? (1U << 0) : 0U;
        valid_bits |= is_selected_device(short_vector[0].y) ? (1U << 1) : 0U;
        valid_bits |= is_selected_device(short_vector[0].z) ? (1U << 2) : 0U;
        valid_bits |= is_selected_device(short_vector[0].w) ? (1U << 3) : 0U;
        uint32_t warp_hits = (uint32_t)asc_reduce_add((uint32_t)__popc(valid_bits));
        if (lane_index == 0U) {
            tile_warp_bases[batch * WARP_COUNT + warp_index] = warp_hits;
        }
    }
    asc_syncthreads();

    // Pass 2, level 1: the first TILE_BATCH_COUNT warps each scan one batch's
    // row (lane = warp within the batch), turning hit counts into offsets
    // between warps of the same batch. The row total goes to tile_scratch[batch].
    if (warp_index < TILE_BATCH_COUNT) {
        uint32_t own = tile_warp_bases[warp_index * WARP_COUNT + lane_index];
        uint32_t inclusive = own;
        for (uint32_t d = 1U; d < warpSize; d <<= 1U) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive, (int32_t)d);
            if (lane_index >= d) {
                inclusive += n;
            }
        }
        tile_warp_bases[warp_index * WARP_COUNT + lane_index] = inclusive - own;
        uint32_t row_total = (uint32_t)asc_shfl((int32_t)inclusive, (int32_t)(WARP_COUNT - 1U));
        if (lane_index == 0U) {
            tile_scratch[warp_index] = row_total;
        }
    }
    asc_syncthreads();

    // Pass 2, level 2: warp 0 scans the batch totals into offsets between
    // batches. Its last inclusive value is the block total, written to GM.
    if (thread_index < WARP_COUNT) {
        uint32_t own = (lane_index < TILE_BATCH_COUNT) ? tile_scratch[lane_index] : 0U;
        uint32_t inclusive = own;
        for (uint32_t d = 1U; d < warpSize; d <<= 1U) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive, (int32_t)d);
            if (lane_index >= d) {
                inclusive += n;
            }
        }
        if (lane_index < TILE_BATCH_COUNT) {
            tile_scratch[lane_index] = inclusive - own;
        }
        if (lane_index == TILE_BATCH_COUNT - 1U) {
            block_counts[block_index] = inclusive;
        }
    }
    asc_syncthreads();

    // Pass 2, combine: (batch, warp) base = batch offset + warp offset inside
    // the batch. One entry per thread of the first TILE_BATCH_WARP_COUNT threads.
    if (thread_index < TILE_BATCH_WARP_COUNT) {
        uint32_t batch = thread_index / WARP_COUNT;
        tile_warp_bases[thread_index] += tile_scratch[batch];
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void compact_prescanned_ballot_vf_short_vector(
    __ubuf__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count,
    __gm__ const uint32_t* block_counts, __ubuf__ uint32_t* tile_warp_bases, __ubuf__ uint32_t* running_offset,
    uint32_t region_count)
{
    const uint32_t thread_index = (uint32_t)threadIdx.x;
    const uint32_t lane_index = (uint32_t)laneid();
    const uint32_t warp_index = thread_index / warpSize;

    initialize_running_offset_v2(block_counts, running_offset);
    const uint32_t block_base = running_offset[0];

    for (uint32_t batch = 0U; batch < TILE_BATCH_COUNT; ++batch) {
        const uint32_t my_base = batch * THREAD_COUNT * ITEMS_PER_THREAD + thread_index * ITEMS_PER_THREAD;
        const __ubuf__ int4* short_vector = reinterpret_cast<const __ubuf__ int4*>(&input[my_base]);

        uint32_t valid_bits = 0U;
        valid_bits |= is_selected_device(short_vector[0].x) ? (1U << 0) : 0U;
        valid_bits |= is_selected_device(short_vector[0].y) ? (1U << 1) : 0U;
        valid_bits |= is_selected_device(short_vector[0].z) ? (1U << 2) : 0U;
        valid_bits |= is_selected_device(short_vector[0].w) ? (1U << 3) : 0U;

        // inclusive_prefix = sum of thread_hits over lanes [0, lane_index]
        uint32_t thread_hits = (uint32_t)__popc(valid_bits);
        uint32_t inclusive_prefix = thread_hits;
        for (uint32_t d = 1; d < warpSize; d <<= 1) {
            uint32_t n = (uint32_t)asc_shfl_up((int32_t)inclusive_prefix, d);
            if (lane_index >= d) {
                inclusive_prefix += n;
            }
        }

        uint32_t my_base_rank = block_base + tile_warp_bases[batch * WARP_COUNT + warp_index] +
                                (inclusive_prefix - (uint32_t)__popc(valid_bits));

        if ((valid_bits & (1U << 0)) != 0U) {
            output[my_base_rank + (uint32_t)__popc(valid_bits & ((1U << 0) - 1U))] = short_vector[0].x;
        }
        if ((valid_bits & (1U << 1)) != 0U) {
            output[my_base_rank + (uint32_t)__popc(valid_bits & ((1U << 1) - 1U))] = short_vector[0].y;
        }
        if ((valid_bits & (1U << 2)) != 0U) {
            output[my_base_rank + (uint32_t)__popc(valid_bits & ((1U << 2) - 1U))] = short_vector[0].z;
        }
        if ((valid_bits & (1U << 3)) != 0U) {
            output[my_base_rank + (uint32_t)__popc(valid_bits & ((1U << 3) - 1U))] = short_vector[0].w;
        }
    }

    if ((blockIdx.x == gridDim.x - 1) && threadIdx.x == 0) {
        selected_count[0] = block_base + block_counts[gridDim.x - 1];
    }
}

// Case 8
__global__ __vector__ void compact_prescanned_ballot_short_vector_kernel(
    __gm__ int32_t* input, __gm__ int32_t* output, __gm__ uint32_t* selected_count, __gm__ uint32_t* block_counts,
    uint32_t region_count)
{
    asc_init();
    __ubuf__ int32_t input_region[REGION_COUNT];
    __ubuf__ uint32_t tile_warp_bases[TILE_BATCH_WARP_COUNT];
    __ubuf__ uint32_t tile_scratch[TILE_BATCH_COUNT];
    __ubuf__ uint32_t running_offset[1];
    running_offset[0] = 0U;
    copy_input_to_ub(input_region, input + (uint32_t)block_idx * region_count, region_count);
    asc_vf_call<count_tile_warp_hits_vf_short_vector>(
        dim3(THREAD_COUNT), input_region, block_counts, tile_warp_bases, tile_scratch, region_count);
    AscendC::SyncAll();
    asc_vf_call<compact_prescanned_ballot_vf_short_vector>(
        dim3(THREAD_COUNT), input_region, output, selected_count, block_counts, tile_warp_bases, running_offset,
        region_count);
}

static void launch_compaction(const DeviceBuffers* buffers, aclrtStream stream)
{
#if SCENARIO_NUM == 0
    compact_atomic_rank_kernel<<<(COMPACTION_COUNT + THREAD_COUNT - 1) / THREAD_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, COMPACTION_COUNT);
#else
#if SCENARIO_NUM == 1
    compact_thread_prefix_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#elif SCENARIO_NUM == 2
    compact_warp_shared_flags_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#elif SCENARIO_NUM == 3
    compact_warp_ballot_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#elif SCENARIO_NUM == 4
    compact_warp_ballot_batched_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#elif SCENARIO_NUM == 5
    compact_short_xiangliang<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#elif SCENARIO_NUM == 6
    compact_atomic_rank_full_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#elif SCENARIO_NUM == 7
    compact_prescanned_ballot_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#else
    compact_prescanned_ballot_short_vector_kernel<<<BLOCK_COUNT, 0, stream>>>(
        buffers->input, buffers->output, buffers->selected_count, buffers->block_counts, REGION_COUNT);
#endif
#endif
}

static bool run_compaction(aclrtStream stream)
{
    bool ok = false;
    DeviceBuffers buffers;
    reset_device_buffers(&buffers);

    int32_t* input = (int32_t*)malloc(INPUT_COUNT * sizeof(int32_t));
    int32_t* expected = (int32_t*)malloc(INPUT_COUNT * sizeof(int32_t));
    int32_t* output = (int32_t*)malloc(INPUT_COUNT * sizeof(int32_t));
    uint32_t expected_count = 0;
    uint32_t actual_count = 0;
    if (input == NULL || expected == NULL || output == NULL) {
        fprintf(stderr, "Host allocation failed\n");
        goto cleanup;
    }

    fill_fixed_input(input, INPUT_COUNT);
    expected_count = build_host_oracle(input, COMPACTION_COUNT, expected);
    for (uint32_t index = 0; index < INPUT_COUNT; ++index) {
        output[index] = OUTPUT_SENTINEL;
    }

    if (!allocate_device_buffers(&buffers)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                buffers.input, INPUT_COUNT * sizeof(int32_t), input, INPUT_COUNT * sizeof(int32_t),
                ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(input H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                buffers.output, INPUT_COUNT * sizeof(int32_t), output, INPUT_COUNT * sizeof(int32_t),
                ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(output H2D)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemset(buffers.selected_count, sizeof(uint32_t), 0, sizeof(uint32_t)), "aclrtMemset(selected_count)",
            __FILE__, __LINE__)) {
        goto cleanup;
    }
#if SCENARIO_NUM != 0
    if (!check_acl(
            aclrtMemset(buffers.block_counts, BLOCK_COUNT * sizeof(uint32_t), 0, BLOCK_COUNT * sizeof(uint32_t)),
            "aclrtMemset(block_counts)", __FILE__, __LINE__)) {
        goto cleanup;
    }
#endif

    launch_compaction(&buffers, stream);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream", __FILE__, __LINE__)) {
        goto cleanup;
    }

    if (!check_acl(
            aclrtMemcpy(
                &actual_count, sizeof(uint32_t), buffers.selected_count, sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(count D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }
    if (!check_acl(
            aclrtMemcpy(
                output, INPUT_COUNT * sizeof(int32_t), buffers.output, INPUT_COUNT * sizeof(int32_t),
                ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(output D2H)", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = verify_selected_count(actual_count, expected_count) && verify_stable_order(output, expected, expected_count) &&
         verify_untouched_tail(output, expected_count, INPUT_COUNT);
    printf(
        "scenario=%d input_count=%u selected_count=%u order=stable tail=checked result=%s\n", SCENARIO_NUM, INPUT_COUNT,
        actual_count, ok ? "PASS" : "FAIL");
    if (ok) {
        printf("[Success] Case accuracy verification passed.\n");
    }

cleanup:
    free_device_buffers(&buffers);
    free(output);
    free(expected);
    free(input);
    return ok;
}

int32_t main(int32_t argc, char* argv[])
{
    bool initialized = false;
    bool device_set = false;
    aclrtStream stream = NULL;
    bool ok = false;

    if (!check_acl(aclInit(NULL), "aclInit", __FILE__, __LINE__)) {
        goto cleanup;
    }
    initialized = true;
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice", __FILE__, __LINE__)) {
        goto cleanup;
    }
    device_set = true;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream", __FILE__, __LINE__)) {
        goto cleanup;
    }

    ok = run_compaction(stream);

cleanup:
    if (stream != NULL) {
        (void)aclrtDestroyStream(stream);
    }
    if (device_set) {
        (void)aclrtResetDevice(0);
    }
    if (initialized) {
        (void)aclFinalize();
    }

    printf("%s\n", ok ? "Verification PASSED" : "Verification FAILED");
    return ok ? 0 : 1;
}
