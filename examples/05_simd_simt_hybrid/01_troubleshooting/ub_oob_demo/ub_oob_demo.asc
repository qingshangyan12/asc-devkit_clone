/* !
 * \file ub_oob_demo.asc
 * \brief 演示SIMD与SIMT混合编程下UB访问越界的三级症状：同一个"每warp暂存区尺寸算小了"的
 *        bug，越界距离不同，表现完全不同。
 *        CASE 1 越界仍落在已申请的动态内存内 -> 踩坏相邻缓冲区，结果错但ret=0，无任何报错；
 *        CASE 2 越界不超过动、静态内存边界后8KB -> 落入编译器预留空间，硬件容忍，跑得"很干净"；
 *        CASE 3 越界超过边界后8KB -> 落入Data Cache区，触发
 *               ACL_ERROR_RT_VECTOR_CORE_EXCEPTION(507035)。
 *        由于msSanitizer/msDebug当前不支持SIMT场景，样例同时给出guard band(哨兵)手工检测法。
 */

#include <iostream>
#include <vector>
#include <cmath>
#include <cstdlib>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"
#if BOUND_PRINTF
#include "utils/debug/asc_printf.h"
#endif

#ifndef CASE_NUM
#define CASE_NUM 1
#endif
#if CASE_NUM < 1 || CASE_NUM > 3
#error "CASE_NUM must be 1, 2 or 3."
#endif

#ifndef GUARD_BAND
#define GUARD_BAND 0
#endif
#ifndef BOUND_PRINTF
#define BOUND_PRINTF 0
#endif
#ifndef FIX_OOB
#define FIX_OOB 0
#endif

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t WARP_SIZE = 32;
// 实际启动的warp数=32，暂存区必须能放下32个warp的归约结果。
constexpr uint32_t WARP_COUNT = THREAD_COUNT / WARP_SIZE;

#if FIX_OOB || CASE_NUM != 1
// 正确：按实际warp数申请。CASE 2/3也用正确尺寸，这样归约本身是对的，
// 唯一的越界来自probe_vf的定点写，症状不会和CASE 1混在一起。
constexpr uint32_t SCRATCH_SLOTS = WARP_COUNT;
#else
// BUG：按"每block 256线程=8个warp"的旧假设写死，线程数提到1024后没同步改。
constexpr uint32_t SCRATCH_SLOTS = 8;
#endif

// guard band：紧跟在partial[]之后的哨兵区，写入魔术值，供Host侧检测越界。
#if GUARD_BAND
constexpr uint32_t GUARD_LEN = 64;
#else
constexpr uint32_t GUARD_LEN = 0;
#endif
constexpr float GUARD_MAGIC = -7.5e30f;

// keep[]：一块必须保持完好的相邻缓冲区，代表算子里其它正常数据。
constexpr uint32_t KEEP_LEN = 1024;

// UB预算常量，来自《内存层级》文档。
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t UB_RESERVED_BYTES = 8 * 1024;
constexpr uint32_t UB_DATACACHE_MIN_BYTES = 32 * 1024;

// CASE 2/3：在partial[]之外再定点写一次，用越界距离控制落点。
// CASE 2 落在预留空间(<=8KB)，CASE 3 落在Data Cache(>8KB)。
constexpr uint32_t PROBE_LEN = 64;
#if CASE_NUM == 2
constexpr uint32_t PROBE_OVERFLOW_BYTES = 4 * 1024;
#elif CASE_NUM == 3
constexpr uint32_t PROBE_OVERFLOW_BYTES = 16 * 1024;
#else
constexpr uint32_t PROBE_OVERFLOW_BYTES = 0;
#endif
} // namespace

/* SIMT VF：每warp归约求和，结果写入partial[]，再由tid=0汇总。
 * partial[]容量为scratch_slots，但warp_id取值范围是[0, WARP_COUNT)，
 * scratch_slots < WARP_COUNT时高编号warp写到partial[]之外。
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void reduce_vf(
    __gm__ float* input, __ubuf__ float* partial, __ubuf__ float* guard, __ubuf__ float* keep, __gm__ float* out_sum,
    __gm__ float* out_guard, __gm__ float* out_keep, uint32_t total, uint32_t scratch_slots, uint32_t guard_len,
    uint32_t keep_len)
{
    uint32_t tid = threadIdx.x;
    uint32_t warp_id = tid / warpSize;
    uint32_t lane = laneid();

    // 铺哨兵值：越界写入会把这些魔术值冲掉，Host侧据此判定越界及越界长度。
    for (uint32_t i = tid; i < guard_len; i += THREAD_COUNT) {
        guard[i] = GUARD_MAGIC;
    }
    asc_syncthreads();

    float v = (tid < total) ? input[tid] : 0.0f;
    // warp内归约，asc_reduce_add返回当前warp所有线程v的总和。
    v = asc_reduce_add(v);

#if BOUND_PRINTF
    // 边界打点：只让越界的第一个代表线程打印，避免打印量放大。
    if (lane == 0 && warp_id == scratch_slots) {
        printf("[bound] warp_id=%u writes partial[%u] but capacity is %u -> OOB\n", warp_id, warp_id, scratch_slots);
    }
#endif

    if (lane == 0) {
        // 越界点：warp_id可达WARP_COUNT-1(31)，而partial[]只有scratch_slots项。
        partial[warp_id] = v;
    }
    asc_syncthreads();

    // 后写者：keep[]在归约之后才被填充，会把越界写进来的warp结果再盖掉一次，
    // 于是tid=0汇总时读到的是keep[]的内容，得到一个完全错误的sum。
    for (uint32_t i = tid; i < keep_len; i += THREAD_COUNT) {
        keep[i] = 1000.0f + static_cast<float>(i);
    }
    asc_syncthreads();

    if (tid == 0) {
        float s = 0.0f;
        for (uint32_t w = 0; w < WARP_COUNT; w++) {
            s += partial[w];
        }
        *out_sum = s;
    }
    for (uint32_t i = tid; i < guard_len; i += THREAD_COUNT) {
        out_guard[i] = guard[i];
    }
    for (uint32_t i = tid; i < keep_len; i += THREAD_COUNT) {
        out_keep[i] = keep[i];
    }
}

#if CASE_NUM != 1
/* CASE 2/3：把越界写"瞄准"动、静态内存边界之外的固定偏移。
 * start_elem由Host按 (declared_bytes + overflow_bytes) 算出，
 * overflow<=8KB落在预留空间，>8KB落在Data Cache。
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void probe_vf(
    __ubuf__ float* ub_base, uint32_t start_elem, uint32_t count)
{
    uint32_t tid = threadIdx.x;
    for (uint32_t i = tid; i < count; i += THREAD_COUNT) {
        ub_base[start_elem + i] = 54321.0f + static_cast<float>(i);
    }
}
#endif

/* 核函数：只协调VF调度，使用__global__ __vector__（只启动AIV核）。
 * UB布局（动态内存内）：[partial: scratch_slots][guard: guard_len][keep: keep_len]
 */
__global__ __vector__ void kernel_ub_oob(
    __gm__ float* input, __gm__ float* out_sum, __gm__ float* out_guard, __gm__ float* out_keep, uint32_t total,
    uint32_t scratch_slots, uint32_t guard_len, uint32_t keep_len, uint32_t probe_start_elem, uint32_t probe_len)
{
    asc_init();
    extern __ubuf__ float ub[];
    __ubuf__ float* partial = ub;
    __ubuf__ float* guard = ub + scratch_slots;
    __ubuf__ float* keep = ub + scratch_slots + guard_len;

    asc_vf_call<reduce_vf>(
        dim3(THREAD_COUNT), input, partial, guard, keep, out_sum, out_guard, out_keep, total, scratch_slots, guard_len,
        keep_len);
#if CASE_NUM != 1
    asc_vf_call<probe_vf>(dim3(THREAD_COUNT), ub, probe_start_elem, probe_len);
#endif
}

namespace {
// UB预算自查：把《内存层级》的公式落成代码，上板前先算一遍。
// 静态内存本样例为0，全部使用动态内存。
void audit_ub_budget(uint32_t dyn_ub_size, uint32_t static_ub_size)
{
    uint32_t max_dyn = UB_TOTAL_BYTES - UB_RESERVED_BYTES - UB_DATACACHE_MIN_BYTES - static_ub_size;
    uint32_t left = UB_TOTAL_BYTES - static_ub_size - dyn_ub_size - UB_RESERVED_BYTES;
    uint32_t data_cache = (left < 128 * 1024) ? left : 128 * 1024;
    std::cout << "[UB budget] static=" << static_ub_size << "B dyn=" << dyn_ub_size
              << "B reserved=" << UB_RESERVED_BYTES << "B => DataCache=" << data_cache << "B (min "
              << UB_DATACACHE_MIN_BYTES << "B)" << std::endl;
    std::cout << "[UB budget] max legal dyn_ub_size = " << max_dyn << "B; kernel UB access must stay < "
              << static_ub_size + dyn_ub_size << "B" << std::endl;
    if (dyn_ub_size > max_dyn) {
        std::cout << "[UB budget] WARNING: dyn_ub_size exceeds the legal maximum." << std::endl;
    }
}

const char* case_name()
{
#if CASE_NUM == 1
    return "CASE 1: OOB stays inside declared dynamic UB -> partial[] aliases keep[], wrong result, ret=0";
#elif CASE_NUM == 2
    return "CASE 2: OOB <=8KB past the declared boundary -> lands in the compiler reserved area, runs clean";
#else
    return "CASE 3: OOB >8KB past the declared boundary -> lands in Data Cache -> VECTOR_CORE_EXCEPTION";
#endif
}
} // namespace

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total = THREAD_COUNT;
    // 只按已声明的三块缓冲区申请动态内存，不为越界额外留空间。
    constexpr uint32_t dyn_ub_size = (SCRATCH_SLOTS + GUARD_LEN + KEEP_LEN) * sizeof(float);
    constexpr uint32_t static_ub_size = 0;
    // CASE 2/3的定点越界起始元素：越过已申请边界后再走PROBE_OVERFLOW_BYTES。
    constexpr uint32_t probe_start_elem = (dyn_ub_size + PROBE_OVERFLOW_BYTES) / sizeof(float);
    constexpr uint32_t probe_len = (CASE_NUM == 1) ? 0 : PROBE_LEN;

    std::cout << "### SIMD/SIMT hybrid UB out-of-bounds demo" << std::endl;
    std::cout << case_name() << std::endl;
    std::cout << "threads=" << THREAD_COUNT << " warps=" << WARP_COUNT << " scratch_slots=" << SCRATCH_SLOTS
              << " guard_len=" << GUARD_LEN << " keep_len=" << KEEP_LEN << std::endl;
    audit_ub_budget(dyn_ub_size, static_ub_size);
#if CASE_NUM != 1
    std::cout << "[probe] writing " << probe_len << " floats at UB byte offset " << probe_start_elem * sizeof(float)
              << " (" << PROBE_OVERFLOW_BYTES << "B past the declared " << dyn_ub_size << "B)" << std::endl;
#endif

    std::vector<float> input(total);
    double golden = 0.0;
    for (uint32_t i = 0; i < total; i++) {
        input[i] = static_cast<float>(i % 10) + 1.0f;
        golden += input[i];
    }

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    float* input_dev = nullptr;
    float* sum_dev = nullptr;
    float* guard_dev = nullptr;
    float* keep_dev = nullptr;
    size_t input_bytes = total * sizeof(float);
    size_t guard_bytes = (GUARD_LEN ? GUARD_LEN : 1) * sizeof(float);
    size_t keep_bytes = KEEP_LEN * sizeof(float);
    aclrtMalloc((void**)&input_dev, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&sum_dev, sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&guard_dev, guard_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&keep_dev, keep_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_dev, input_bytes, input.data(), input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(sum_dev, sizeof(float), 0, sizeof(float));

    std::cout << "Launching kernel..." << std::endl;
    kernel_ub_oob<<<1, dyn_ub_size, stream>>>(
        input_dev, sum_dev, guard_dev, keep_dev, total, SCRATCH_SLOTS, GUARD_LEN, KEEP_LEN, probe_start_elem,
        probe_len);

    // 用带超时的流同步，避免异常时host侧无限期等待。
    constexpr int32_t SYNC_TIMEOUT_MS = 10000;
    aclError sync_ret = aclrtSynchronizeStreamWithTimeout(stream, SYNC_TIMEOUT_MS);
    if (sync_ret == ACL_ERROR_RT_VECTOR_CORE_EXCEPTION) {
        std::cerr << "[OOB DETECTED BY HW] aclrtSynchronizeStreamWithTimeout ret=" << static_cast<int32_t>(sync_ret)
                  << " (ACL_ERROR_RT_VECTOR_CORE_EXCEPTION)." << std::endl;
        std::cerr << "Diagnosis: a UB access went more than " << UB_RESERVED_BYTES << "B past the declared static+"
                  << "dynamic boundary and landed in the SIMT Data Cache region." << std::endl;
        std::cerr << "Localization steps:" << std::endl;
        std::cerr << "  1. Sum every UB buffer the kernel declares and compare with dyn_ub_size passed to <<<>>>."
                  << std::endl;
        std::cerr << "  2. Re-check each UB index expression against its buffer capacity -- especially indices"
                  << std::endl;
        std::cerr << "     derived from threadIdx/warp_id whose range changed when the thread count changed."
                  << std::endl;
        std::cerr << "  3. Rebuild with -DBOUND_PRINTF=ON to print the first offending index/capacity pair."
                  << std::endl;
        std::cerr << "  4. Do not reuse this stream/device -- exit the process and reset before retrying." << std::endl;
        return 1;
    }
    if (sync_ret != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStreamWithTimeout failed, ret=" << static_cast<int32_t>(sync_ret) << std::endl;
        return 1;
    }
    std::cout << "Kernel returned ACL_SUCCESS (no hardware error reported)." << std::endl;

    float sum_host = 0.0f;
    std::vector<float> keep_host(KEEP_LEN);
    aclrtMemcpy(&sum_host, sizeof(float), sum_dev, sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(keep_host.data(), keep_bytes, keep_dev, keep_bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    bool sum_ok = std::fabs(static_cast<double>(sum_host) - golden) < 1e-3;
    std::cout << "reduce sum=" << sum_host << " golden=" << golden << (sum_ok ? "  [OK]" : "  [WRONG]") << std::endl;

    bool guard_tripped = false;
    uint32_t keep_bad = 0;
    uint32_t keep_first_bad = 0;
    for (uint32_t i = 0; i < KEEP_LEN; i++) {
        if (std::fabs(keep_host[i] - (1000.0f + static_cast<float>(i))) > 1e-6f) {
            if (keep_bad == 0) {
                keep_first_bad = i;
            }
            keep_bad++;
        }
    }
    std::cout << "neighbour buffer keep[]: corrupted=" << keep_bad << "/" << KEEP_LEN;
    if (keep_bad) {
        std::cout << " first keep[" << keep_first_bad << "]=" << keep_host[keep_first_bad];
    }
    std::cout << std::endl;

#if GUARD_BAND
    // guard band检测：哪些哨兵被冲掉，就等于量出了越界长度和落点。
    std::vector<float> guard_host(GUARD_LEN);
    aclrtMemcpy(guard_host.data(), guard_bytes, guard_dev, guard_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    uint32_t guard_bad = 0;
    uint32_t guard_last_bad = 0;
    for (uint32_t i = 0; i < GUARD_LEN; i++) {
        if (guard_host[i] != GUARD_MAGIC) {
            guard_bad++;
            guard_last_bad = i;
        }
    }
    if (guard_bad) {
        guard_tripped = true;
        std::cout << "[GUARD BAND TRIPPED] " << guard_bad << " of " << GUARD_LEN
                  << " sentinels overwritten; furthest hit at guard[" << guard_last_bad << "] => partial[] overflowed "
                  << "by at least " << guard_last_bad + 1 << " element(s) past its " << SCRATCH_SLOTS
                  << "-slot capacity." << std::endl;
    } else {
        std::cout << "[GUARD BAND CLEAN] no sentinel was overwritten." << std::endl;
    }
#endif

    if (!sum_ok || keep_bad || guard_tripped) {
        std::cout << "---- Diagnosis ----" << std::endl;
        std::cout << "The kernel reported no error, yet a UB write went past its buffer while still inside the"
                  << std::endl;
        std::cout << "declared dynamic memory, so neither the hardware nor the runtime checks it." << std::endl;
        if (sum_ok && guard_tripped) {
            std::cout << "Note: the reduce sum reads OK here only because the guard band absorbed the overflow;"
                      << std::endl;
            std::cout << "with GUARD_BAND=OFF the same write lands in keep[] and the sum comes out wrong." << std::endl;
        }
        std::cout << "Here warp_id reaches " << WARP_COUNT - 1 << " but partial[] holds only " << SCRATCH_SLOTS
                  << " slots, so partial[] runs into keep[]." << std::endl;
        std::cout << "Localization: rebuild with -DGUARD_BAND=ON to measure the overflow, and with" << std::endl;
        std::cout << "-DBOUND_PRINTF=ON to print the first offending index. -DFIX_OOB=ON applies the fix." << std::endl;
        return 1;
    }
#if CASE_NUM == 2
    std::cout << "---- Diagnosis ----" << std::endl;
    std::cout << "Every check passed even though the kernel wrote " << PROBE_OVERFLOW_BYTES
              << "B past the declared UB boundary." << std::endl;
    std::cout << "The write landed in the " << UB_RESERVED_BYTES
              << "B compiler reserved area, which absorbs it silently. This is the most dangerous tier:" << std::endl;
    std::cout << "the same bug faults once the overflow grows past " << UB_RESERVED_BYTES
              << "B (try -DCASE_NUM=3), or once the reserved" << std::endl;
    std::cout << "area is disabled with --cce-disable-vf-stack-reserved-ubuf. Do not treat a clean run as proof"
              << std::endl;
    std::cout << "that UB indexing is correct -- audit the budget instead." << std::endl;
    return 1;
#endif
    std::cout << "All checks passed." << std::endl;
    return 0;
}
