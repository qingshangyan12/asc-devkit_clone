/* !
 * \file sync_hang_demo.asc
 * \brief 演示文档中记录的asc_syncthreads()卡死风险——在分支中调用block
 *        barrier时，若有线程无法到达同步点，其他线程会永久阻塞。
 *        tid >= sync_threshold的线程跳过asc_syncthreads()后，改为在一个永不被置位的GM flag上
 *        自旋而不退出，因此这些线程始终存活且永远不会到达同步点。调用了asc_syncthreads()的线程
 *        会永久阻塞 -> 真实卡死。样例聚焦展示卡死场景下的定位分析手段。
 */

#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"
#if BISECT_PRINTF
#include "utils/debug/asc_printf.h"
#endif

#ifndef BISECT_PRINTF
#define BISECT_PRINTF 0
#endif

// HANG_FOREVER=1时用无超时的aclrtSynchronizeStream替代带超时版本，让进程真正保持卡死状态，
// 以便在msdebug中用CTRL+C手动中断并回显中断位置。详见README"卡死定位流程"中的msdebug中断运行。
#ifndef HANG_FOREVER
#define HANG_FOREVER 0
#endif

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t WARP_SIZE = 32;
constexpr uint32_t WARP_COUNT = THREAD_COUNT / WARP_SIZE;
// Only the first half of the block reaches the barrier; the rest spin forever instead of retiring.
constexpr uint32_t SYNC_THRESHOLD = THREAD_COUNT / 2;
} // namespace

// SIMT VF函数：承载原pure-SIMT核函数中的分支同步逻辑，由外层__vector__核函数通过asc_vf_call调用。
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void sync_hang_demo_vf(
    __gm__ float* input, __gm__ float* output, __gm__ volatile uint32_t* never_set_flag, __ubuf__ float* smem,
    uint32_t input_total_length)
{
    uint32_t tid = threadIdx.x;
    uint32_t lane_id = laneid();
    uint32_t warp_id = tid / warpSize;

    float val = (tid < input_total_length) ? input[tid] : 0.0f;

    // Warp内归约，asc_reduce_add返回当前warp所有线程val的总和
    val = asc_reduce_add(val);
    if (lane_id == 0) {
        smem[warp_id] = val;
    }

#if BISECT_PRINTF
    // Bisection printf: gated to one thread per side of the divergent branch so the print
    // volume stays low (see printf usage notes). SIMT printf flushes to host in real time,
    // so these lines appear even if the kernel as a whole never returns -- the LAST line
    // seen on the host pinpoints how far execution got before the hang.
    if (tid == 0 || tid == SYNC_THRESHOLD) {
        printf("[bisect] tid=%u reached reduce/smem stage\n", tid);
    }
#endif

    // Threads with tid >= SYNC_THRESHOLD skip the barrier and stay live forever instead
    // of retiring, spinning on a GM flag that is never written from the host.
    // The threads with tid < SYNC_THRESHOLD block in asc_syncthreads() waiting for warps
    // that are alive but will never reach the barrier -> real hang.
    if (tid < SYNC_THRESHOLD) {
        asc_syncthreads();
    } else {
        while (*never_set_flag == 0) {
        }
    }

    if (tid == 0) {
        for (uint32_t i = 1; i < WARP_COUNT; i++) {
            val += smem[i];
        }
        *output = val;
    }
}

// 核函数：只需协调VF调度，因此使用__global__ __vector__（只启动AIV核）。
__global__ __vector__ void kernel_sync_hang_demo(
    __gm__ float* input, __gm__ float* output, __gm__ volatile uint32_t* never_set_flag, uint32_t input_total_length)
{
    asc_init();
    __ubuf__ float smem[WARP_COUNT];
    // dim3(THREAD_COUNT)启动1024个SIMT线程，对应单个线程块，与原pure-SIMT版本的单block配置一致。
    asc_vf_call<sync_hang_demo_vf>(dim3(THREAD_COUNT), input, output, never_set_flag, smem, input_total_length);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t input_total_length = THREAD_COUNT;
    uint32_t blocks_per_grid = 1;
    size_t input_total_byte_size = input_total_length * sizeof(float);
    size_t output_total_byte_size = blocks_per_grid * sizeof(float);

    std::vector<float> input(input_total_length);
    for (uint32_t i = 0; i < input_total_length; i++) {
        input[i] = static_cast<float>(i % 10);
    }

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* output_host = nullptr;
    float* input_device = nullptr;
    float* output_device = nullptr;
    uint32_t* never_set_flag_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&output_host, output_total_byte_size);
    aclrtMalloc((void**)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_device, output_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&never_set_flag_device, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, input_total_byte_size, input_host, input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    // Left at 0 on purpose: the tid >= SYNC_THRESHOLD threads spin on this flag forever since the host never sets it.
    aclrtMemset(never_set_flag_device, sizeof(uint32_t), 0, sizeof(uint32_t));

    std::cout << "### SIMD/SIMT hybrid asc_syncthreads() hang demo" << std::endl;
    std::cout << "Launching kernel..." << std::endl;
    kernel_sync_hang_demo<<<blocks_per_grid, 0, stream>>>(
        input_device, output_device, never_set_flag_device, input_total_length);

#if HANG_FOREVER
    // msdebug中断运行场景：故意使用无超时的流同步，让host侧一起停在卡死状态上，
    // 从而有一个"正在卡顿的算子运行程序"可供在msdebug中按CTRL+C手动中断。
    std::cout << "Waiting on aclrtSynchronizeStream (NO timeout) -- process will hang here." << std::endl;
    std::cout << "In msdebug, press CTRL+C now to interrupt and echo the hang location." << std::endl;
    aclError sync_ret = aclrtSynchronizeStream(stream);
    std::cout << "aclrtSynchronizeStream returned ret=" << static_cast<int32_t>(sync_ret) << std::endl;
    return sync_ret == ACL_SUCCESS ? 0 : 1;
#else
    // 卡死定位：用带超时的流同步替代无限期等待的aclrtSynchronizeStream，
    // 把"host侧永久死等"转化为一个有限时间、有明确错误码的可诊断事件。
    constexpr int32_t SYNC_TIMEOUT_MS = 5000;
    std::cout << "Waiting on aclrtSynchronizeStreamWithTimeout (timeout=" << SYNC_TIMEOUT_MS << "ms)..." << std::endl;
    aclError sync_ret = aclrtSynchronizeStreamWithTimeout(stream, SYNC_TIMEOUT_MS);
    if (sync_ret == ACL_ERROR_RT_STREAM_SYNC_TIMEOUT) {
        std::cerr << "[HANG DETECTED] aclrtSynchronizeStreamWithTimeout timed out after " << SYNC_TIMEOUT_MS
                  << "ms, ret=" << static_cast<int32_t>(sync_ret) << " (ACL_ERROR_RT_STREAM_SYNC_TIMEOUT)."
                  << std::endl;
        std::cerr << "Diagnosis: the kernel did not return within the timeout. Some thread(s) skipped" << std::endl;
        std::cerr << "asc_syncthreads() and never retired (e.g. spinning on a GM flag), so the threads that"
                  << std::endl;
        std::cerr << "did call asc_syncthreads() are permanently blocked." << std::endl;
        std::cerr << "Localization steps:" << std::endl;
        std::cerr << "  1. Rebuild with -DBISECT_PRINTF=ON and re-run to bisect with printf directly on this"
                  << std::endl;
        std::cerr << "     hung run -- probes placed before the hang still print even though the kernel never"
                  << std::endl;
        std::cerr << "     returns." << std::endl;
        std::cerr << "  2. Rebuild with -DHANG_FOREVER=ON -O0 -g and run under msdebug, then press CTRL+C once"
                  << std::endl;
        std::cerr << "     the program hangs. The tool interrupts the run and echoes the stop location; use"
                  << std::endl;
        std::cerr << "     'ascend info cores' / 'ascend info threads' to see where each core/thread stopped."
                  << std::endl;
        std::cerr << "  3. Audit every asc_syncthreads() call site for branches where tid-dependent conditions"
                  << std::endl;
        std::cerr << "     could let some threads skip the barrier while staying alive (loops, early spins)."
                  << std::endl;
        std::cerr << "  4. Do not issue further operations on this stream/device -- it may still be stuck."
                  << std::endl;
        std::cerr << "     Exit the process and reset the device before retrying." << std::endl;
        return 1;
    }
    if (sync_ret != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStreamWithTimeout failed, ret=" << static_cast<int32_t>(sync_ret) << std::endl;
        return 1;
    }
    std::cout << "Kernel finished (no hang)." << std::endl;
    return 0;
#endif
}
