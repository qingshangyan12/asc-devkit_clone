/*!
 * \file sobel_warp_shfl.asc
 * \brief Sobel edge detection with ballot-based stream compaction.
 *        ballot + popcount lets the whole warp claim output slots with a single atomicAdd,
 *        instead of one atomic per edge pixel.
 */

#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "tiling/platform/platform_ascendc.h"

namespace {
    constexpr int IMAGE_WIDTH = 1024;
    constexpr int IMAGE_HEIGHT = 1024;
    constexpr uint16_t THRESHOLD = 200;
    constexpr uint32_t WARP_SIZE = 32;
    constexpr uint32_t THREAD_COUNT = 2048;
    constexpr uint32_t MAX_BLOCK_COUNT = 65535;
}

struct EdgePixel {
    uint16_t x, y, strength;
};

__global__ __launch_bounds__(THREAD_COUNT) void sobel_edge_detect(
    EdgePixel *edge_list,
    uint32_t *edge_count,
    const uint8_t *input,
    int width, int height)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    int lane = idx % WARP_SIZE;
    int warp_id = idx / WARP_SIZE;
    int tiles_x = (width + WARP_SIZE - 1) / WARP_SIZE;
    int x = (warp_id % tiles_x) * WARP_SIZE + lane;
    int y = warp_id / tiles_x;

    bool in_image = (x < width && y < height);

    uint16_t strength = 0;
    if (y > 0 && y < height - 1) {
        int top = in_image ? input[(y - 1) * width + x] : 0;
        int mid = in_image ? input[y * width + x]       : 0;
        int bot = in_image ? input[(y + 1) * width + x] : 0;

        int shfl_top_left  = asc_shfl_up(top, 1, WARP_SIZE);
        int shfl_top_right = asc_shfl_down(top, 1, WARP_SIZE);
        int shfl_mid_left  = asc_shfl_up(mid, 1, WARP_SIZE);
        int shfl_mid_right = asc_shfl_down(mid, 1, WARP_SIZE);
        int shfl_bot_left  = asc_shfl_up(bot, 1, WARP_SIZE);
        int shfl_bot_right = asc_shfl_down(bot, 1, WARP_SIZE);

        if (in_image && x > 0 && x < width - 1) {
            int top_left  = (lane == 0)  ? input[(y - 1) * width + (x - 1)] : shfl_top_left;
            int top_right = (lane == 31) ? input[(y - 1) * width + (x + 1)] : shfl_top_right;
            int mid_left  = (lane == 0)  ? input[y * width + (x - 1)]       : shfl_mid_left;
            int mid_right = (lane == 31) ? input[y * width + (x + 1)]       : shfl_mid_right;
            int bot_left  = (lane == 0)  ? input[(y + 1) * width + (x - 1)] : shfl_bot_left;
            int bot_right = (lane == 31) ? input[(y + 1) * width + (x + 1)] : shfl_bot_right;

            int gx = -top_left + top_right - 2 * mid_left + 2 * mid_right - bot_left + bot_right;
            int gy = -top_left - 2 * top - top_right + bot_left + 2 * bot + bot_right;
            strength = static_cast<uint16_t>(abs(gx) + abs(gy));
        }
    }

    // Collect edge flags from all 32 lanes in one warp-level operation.
    // bit i of edge_mask == 1  <=>  lane i has a pixel that exceeds the threshold.
    uint32_t edge_mask = asc_ballot(in_image && (strength >= THRESHOLD));

    // Early exit: if no lane in this warp has an edge, skip the atomicAdd entirely.
    if (edge_mask == 0) return;

    // Lane 0 reserves slots for the entire warp with a single atomicAdd.
    // Without ballot this would be one atomicAdd per edge pixel (up to 32x more contention).
    uint32_t warp_base = 0;
    if (lane == 0) {
        warp_base = asc_atomic_add(edge_count, (uint32_t)__popc(edge_mask));
    }
    // Broadcast warp_base from lane 0 to all lanes.
    warp_base = asc_shfl(warp_base, 0, WARP_SIZE);

    if ((edge_mask >> lane) & 1) {
        // Local slot = number of edge lanes with smaller lane id (no conflicts within warp).
        uint32_t lower_mask = edge_mask & ((1u << lane) - 1);
        int local_idx = __popc(lower_mask);
        edge_list[warp_base + local_idx] = {(uint16_t)x, (uint16_t)y, strength};
    }
}

uint16_t sobel_pixel(const std::vector<uint8_t> &input, int width, int x, int y)
{
    int tl = input[(y-1)*width+(x-1)], t = input[(y-1)*width+x], tr = input[(y-1)*width+(x+1)];
    int ml = input[y*width+(x-1)], mr = input[y*width+(x+1)];
    int bl = input[(y+1)*width+(x-1)], b = input[(y+1)*width+x], br = input[(y+1)*width+(x+1)];
    int gx = -tl + tr - 2*ml + 2*mr - bl + br;
    int gy = -tl - 2*t - tr + bl + 2*b + br;
    return static_cast<uint16_t>(std::abs(gx) + std::abs(gy));
}

std::vector<uint16_t> sobel_ref(const std::vector<uint8_t> &input, int width, int height)
{
    std::vector<uint16_t> out(static_cast<uint64_t>(width) * height, 0);
    for (int y = 1; y < height - 1; ++y)
        for (int x = 1; x < width - 1; ++x) {
            uint16_t s = sobel_pixel(input, width, x, y);
            out[y * width + x] = (s >= THRESHOLD) ? s : 0;
        }
    return out;
}

bool block_split(uint32_t input_total_length, uint32_t &numBlocks, uint32_t &thread_num_per_block)
{
    const auto& platformInfoMgr = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platformInfoMgr == nullptr) {
        std::cout << "[ERROR] Get platform info failed, please check device status." << std::endl;
        return false;
    }
    uint32_t real_core_num = platformInfoMgr->GetCoreNumAiv();
    numBlocks = real_core_num;
    thread_num_per_block = (input_total_length + numBlocks - 1) / numBlocks;
    if (thread_num_per_block > THREAD_COUNT) {
        thread_num_per_block = THREAD_COUNT;
        numBlocks = (input_total_length + thread_num_per_block - 1) / thread_num_per_block;
        if (numBlocks > MAX_BLOCK_COUNT) {
            std::cout << "[ERROR] Image too large to process." << std::endl;
            return false;
        }
    }
    return true;
}

struct CompactResult {
    std::vector<EdgePixel> edge_list;
    uint32_t edge_count;
};

CompactResult launch_sobel(const std::vector<uint8_t> &input, int width, int height)
{
    uint64_t pixels = static_cast<uint64_t>(width) * height;
    size_t input_byte_size = pixels * sizeof(uint8_t);
    size_t list_byte_size  = pixels * sizeof(EdgePixel);
    size_t count_byte_size = sizeof(uint32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t*   input_device = nullptr;
    EdgePixel* list_device  = nullptr;
    uint32_t*  count_device = nullptr;
    EdgePixel* list_host    = nullptr;
    uint32_t   count_host   = 0;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)&list_host, list_byte_size);
    aclrtMalloc((void **)&input_device, input_byte_size,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&list_device,  list_byte_size,   ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&count_device, count_byte_size,  ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(input_device, input_byte_size, input.data(), input_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(count_device, count_byte_size, 0, count_byte_size);

    uint32_t numBlocks = 0, thread_num_per_block = 0;
    if (!block_split((uint32_t)pixels, numBlocks, thread_num_per_block)) {
        return {};
    }
    sobel_edge_detect<<<numBlocks, thread_num_per_block, 0, stream>>>(
        list_device, count_device, input_device, width, height);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(&count_host, count_byte_size, count_device, count_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(list_host, (size_t)count_host * sizeof(EdgePixel),
                list_device, (size_t)count_host * sizeof(EdgePixel), ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<EdgePixel> result(list_host, list_host + count_host);

    aclrtFree(input_device);
    aclrtFree(list_device);
    aclrtFree(count_device);
    aclrtFreeHost(list_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) fprintf(stderr, "%s\n", err);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return {result, count_host};
}

// Verify by reconstructing a dense map from the compact list and comparing to golden.
// Order of entries in edge_list is non-deterministic (warp-completion order), so we
// cannot compare lists directly.
uint32_t verify_result(const std::vector<EdgePixel> &edge_list, uint32_t edge_count,
    const std::vector<uint16_t> &golden, int width, int height)
{
    if (golden.size() != static_cast<uint64_t>(width) * height) {
        printf("[Failed] Case accuracy is verification failed! size mismatch\n");
        return 1;
    }
    std::vector<uint16_t> dense(static_cast<uint64_t>(width) * height, 0);
    for (uint32_t i = 0; i < edge_count; ++i)
        dense[edge_list[i].y * width + edge_list[i].x] = edge_list[i].strength;

    if (std::equal(dense.begin(), dense.end(), golden.begin())) {
        printf("[Success] Case accuracy is verification passed.\n");
        return 0;
    }
    printf("[Failed] Case accuracy is verification failed!\n");
    return 1;
}

void fill_input(std::vector<uint8_t> &input, int width, int height)
{
    for (int y = 0; y < height; ++y)
        for (int x = 0; x < width; ++x)
            input[y * width + x] = static_cast<uint8_t>((x * 3 + y * 5 + (x ^ y) / 8) & 255);
}

void print_compact_result(const std::vector<EdgePixel> &edge_list, uint32_t edge_count,
    int width, int height, int print_n)
{
    uint64_t pixels = static_cast<uint64_t>(width) * height;
    printf("=== compact edge list ===\n");
    printf("total pixels: %llu  edge pixels: %u  ratio: %.1f%%\n",
        (unsigned long long)pixels, edge_count, 100.0 * edge_count / pixels);
    printf("first %d entries (order reflects warp-completion, not pixel position):\n", print_n);
    printf("%-6s %-6s %-10s\n", "x", "y", "strength");
    uint32_t n = (edge_count < (uint32_t)print_n) ? edge_count : (uint32_t)print_n;
    for (uint32_t i = 0; i < n; ++i)
        printf("%-6u %-6u %-10u\n", edge_list[i].x, edge_list[i].y, edge_list[i].strength);
}

int32_t main(int32_t argc, char *argv[])
{
    int width = IMAGE_WIDTH, height = IMAGE_HEIGHT;

    if (argc == 3) {
        width = std::atoi(argv[1]);
        height = std::atoi(argv[2]);
        if (width <= 2 || height <= 2) {
            fprintf(stderr, "Usage: %s [width height]\n", argv[0]);
            return EXIT_FAILURE;
        }
    } else if (argc != 1) {
        fprintf(stderr, "Usage: %s [width height]\n", argv[0]);
        return EXIT_FAILURE;
    }

    printf("Image: %dx%d  threshold: %u\n", width, height, THRESHOLD);

    uint64_t pixels = static_cast<uint64_t>(width) * height;
    std::vector<uint8_t> input(pixels);
    fill_input(input, width, height);

    std::vector<uint16_t> golden = sobel_ref(input, width, height);
    CompactResult result = launch_sobel(input, width, height);

    print_compact_result(result.edge_list, result.edge_count, width, height, 10);

    return verify_result(result.edge_list, result.edge_count, golden, width, height);
}
