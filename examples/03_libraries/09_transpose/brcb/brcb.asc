/* !
 * \file brcb.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template<typename T, bool testPerformance = false>
class KernelBrcb {
public:
    __aicore__ inline KernelBrcb()
    {}
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, AscendC::TPipe* pipeIn)
    {
      pipe = pipeIn;
      x_gm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
      y_gm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
      pipe->InitBuffer(vecIn, 1, 16 * sizeof(T));
      pipe->InitBuffer(vecOut, 1, 256 * sizeof(T));
    }
    __aicore__ inline void Process()
    {
      if constexpr (testPerformance) {
        Compute();
      } else {
        CopyIn();
        Compute();
        CopyOut();
      }
    }
    __aicore__ inline void CopyIn()
    {
      auto x_buf = vecIn.AllocTensor<T>();
      AscendC::DataCopy(x_buf, x_gm, 16);
      vecIn.EnQue(x_buf);
    }
    __aicore__ inline void Compute()
    {
      auto x_buf = vecIn.DeQue<T>();
      auto y_buf = vecOut.AllocTensor<T>();
      if constexpr (scenarioNum == 1) {
        AscendC::Brcb(y_buf, x_buf, 2, {1,8});
      } else if constexpr (scenarioNum == 2) {
        AscendC::Brcb(y_buf, x_buf, 2, {2,16});
      } else if constexpr (scenarioNum == 3) {
        AscendC::Brcb(y_buf, x_buf, 64, {1,8});
      } else if constexpr (scenarioNum == 4) {
        AscendC::Brcb(y_buf, x_buf, 2, {4,32});
      }
      vecOut.EnQue(y_buf);
      vecIn.FreeTensor(x_buf);
    }
    __aicore__ inline void CopyOut()
    {
      auto y_buf = vecOut.DeQue<T>();
      AscendC::DataCopy(y_gm, y_buf, 256);
      vecOut.FreeTensor(y_buf);
    }
private:
    AscendC::GlobalTensor<T> x_gm;
    AscendC::GlobalTensor<T> y_gm;
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> vecIn;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> vecOut;
};

__global__ __vector__ void brcb_custom(GM_ADDR x, GM_ADDR y)
{
  AscendC::TPipe pipe;
  if constexpr (scenarioNum == 1) {
    KernelBrcb<half> op;
    op.Init(x, y, &pipe);
    op.Process();
  } else if constexpr (scenarioNum == 2) {
    KernelBrcb<half> op;
    op.Init(x, y, &pipe);
    op.Process();
  } else if constexpr (scenarioNum == 3) {
    KernelBrcb<half, true> op;
    op.Init(x, y, &pipe);
    op.Process();
  } else if constexpr (scenarioNum == 4) {
    KernelBrcb<half, true> op;
    op.Init(x, y, &pipe);
    op.Process();
  }
}

int32_t main(int32_t argc, char* argv[]) 
{
  size_t inputByteSize = 16 * sizeof(uint16_t);
  size_t outputByteSize = 256 * sizeof(uint16_t);
  if constexpr (scenarioNum == 1) {
    inputByteSize = 16 * sizeof(uint16_t);
    outputByteSize = 256 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 2) {
    inputByteSize = 16 * sizeof(uint16_t);
    outputByteSize = 512 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 3) {
    inputByteSize = 512 * sizeof(uint16_t);
    outputByteSize = 8192 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 4) {
    inputByteSize = 16 * sizeof(uint16_t);
    outputByteSize = 1024 * sizeof(uint16_t);
  }

  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);

  uint8_t* xHost,* outHost;
  uint8_t* xDevice,* outDevice;

  aclrtMallocHost((void**)(&xHost), inputByteSize);
  aclrtMallocHost((void**)(&outHost), outputByteSize);
  aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
  aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);
  brcb_custom<<<1, nullptr, stream>>>(xDevice, outDevice);
  aclrtSynchronizeStream(stream);

  aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  WriteFile("./output/output.bin", outHost, outputByteSize);

  aclrtFree(xDevice);
  aclrtFree(outDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(outHost);

  aclrtDestroyStream(stream);
  aclrtResetDevice(deviceId);
  aclFinalize();

  return 0;
}