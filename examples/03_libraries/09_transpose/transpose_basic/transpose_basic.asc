/* !
 * \file transpose_basic.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 场景和大小常量
constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

// 场景类型枚举
enum class TransposeScenario {
    TRANSPOSE_2D = 1,           // 简单2D矩阵转置 (16x16)
    TRANSPOSE_NCHW2NHWC = 2,    // 4D转置: [N,C,H,W] -> [N,H,W,C]
    TRANSPOSE_NHWC2NCHW = 3     // 4D转置: [N,H,W,C] -> [N,C,H,W]
};

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景1: 简单2D矩阵转置 (固定16x16)
template <typename T>
__aicore__ inline void Transpose2D(GM_ADDR srcGm, GM_ADDR dstGm)
{
    constexpr uint32_t dataSize = 256;  // 16x16
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + dataSize * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, dataSize);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, dataSize);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, dataSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dataSize);

    AscendC::DataCopy(srcLocal, srcGlobal, dataSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Transpose<T>(dstLocal, srcLocal);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
}

// 场景2: 4D转置 NCHW -> NHWC
template <typename T>
__aicore__ inline void TransposeNCHW2NHWC(GM_ADDR srcGm, GM_ADDR dstGm)
{
    // 定义输入尺寸 [N, C, H, W] = [3, 3, 2, 8]
    constexpr uint32_t N = 3;
    constexpr uint32_t C = 3;
    constexpr uint32_t H = 2;
    constexpr uint32_t W = 8;
    constexpr uint32_t inputSize = N * C * H * W;  // 144
    constexpr uint32_t tmpBufferSize = (C + 2) * 16 * 16;  // 5 * 256 = 1280

    // 静态地址分配
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + inputSize * sizeof(T) + 256;
    constexpr uint32_t tmpAddr = dstAddr + inputSize * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, inputSize);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, inputSize);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, inputSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, inputSize);
    AscendC::LocalTensor<uint8_t> tmpBuffer(AscendC::TPosition::VECCALC, tmpAddr, tmpBufferSize * sizeof(T));

    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, inputSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 设置转置参数
    AscendC::TransposeParamsExt transposeParams;
    transposeParams.nSize = N;
    transposeParams.cSize = C;
    transposeParams.hSize = H;
    transposeParams.wSize = W;
    transposeParams.transposeType = AscendC::TransposeType::TRANSPOSE_NCHW2NHWC;

    // 执行转置
    AscendC::Transpose(dstLocal, srcLocal, tmpBuffer, transposeParams);

    // 数据搬出
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, inputSize);
}

// 场景3: 4D转置 NHWC -> NCHW
template <typename T>
__aicore__ inline void TransposeNHWC2NCHW(GM_ADDR srcGm, GM_ADDR dstGm)
{
    // 定义输入尺寸 [N, H, W, C] = [3, 2, 8, 3]
    constexpr uint32_t N = 3;
    constexpr uint32_t H = 2;
    constexpr uint32_t W = 8;
    constexpr uint32_t C = 3;
    constexpr uint32_t inputSize = N * H * W * C;  // 144
    constexpr uint32_t tmpBufferSize = (C + 2) * 16 * 16;  // 5 * 256 = 1280

    // 静态地址分配
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + inputSize * sizeof(T) + 256;
    constexpr uint32_t tmpAddr = dstAddr + inputSize * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, inputSize);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, inputSize);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, inputSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, inputSize);
    AscendC::LocalTensor<uint8_t> tmpBuffer(AscendC::TPosition::VECCALC, tmpAddr, tmpBufferSize * sizeof(T));

    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, inputSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 设置转置参数
    AscendC::TransposeParamsExt transposeParams;
    transposeParams.nSize = N;
    transposeParams.cSize = C;
    transposeParams.hSize = H;
    transposeParams.wSize = W;
    transposeParams.transposeType = AscendC::TransposeType::TRANSPOSE_NHWC2NCHW;

    // 执行转置
    AscendC::Transpose(dstLocal, srcLocal, tmpBuffer, transposeParams);

    // 数据搬出
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, inputSize);
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunTransposeScenario(GM_ADDR x, GM_ADDR y)
{
    if constexpr (N == static_cast<uint32_t>(TransposeScenario::TRANSPOSE_2D)) {
        Transpose2D<half>(x, y);
    } else if constexpr (N == static_cast<uint32_t>(TransposeScenario::TRANSPOSE_NCHW2NHWC)) {
        TransposeNCHW2NHWC<half>(x, y);
    } else if constexpr (N == static_cast<uint32_t>(TransposeScenario::TRANSPOSE_NHWC2NCHW)) {
        TransposeNHWC2NCHW<half>(x, y);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_transpose_basic(GM_ADDR x, GM_ADDR y)
{
    RunTransposeScenario<scenarioNum>(x, y);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 根据场景设置数据大小
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == static_cast<uint32_t>(TransposeScenario::TRANSPOSE_2D)) {
        inputByteSize = 256 * sizeof(half);   // 16x16
        outputByteSize = 256 * sizeof(half);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransposeScenario::TRANSPOSE_NCHW2NHWC) ||
                         scenarioNum == static_cast<uint32_t>(TransposeScenario::TRANSPOSE_NHWC2NCHW)) {
        inputByteSize = 144 * sizeof(half);   // 3*3*2*8
        outputByteSize = 144 * sizeof(half);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* xHost;
    uint8_t* xDevice;
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 读取输入数据
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 执行核函数
    kernel_transpose_basic<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
