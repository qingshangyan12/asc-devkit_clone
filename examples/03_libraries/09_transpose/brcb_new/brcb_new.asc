/* !
 * \file brcb_new.asc
 * \brief Brcb算子样例 - 静态内存版本
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 宏定义
#define RUN(dtype, testPerformance)                                              \
    AscendC::TPipe pipe;                                                         \
    KernelBrcbNew<dtype, testPerformance>(x, y, &pipe);

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景和大小常量 - 支持外部配置
constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;
constexpr uint8_t repeatTime = REPEAT_TIME;
constexpr uint16_t dstBlkStride = DST_BLK_STRIDE;
constexpr uint16_t dstRepStride = DST_REP_STRIDE;

// 计算函数
template <typename T>
__aicore__ inline void ComputeBrcb(AscendC::LocalTensor<T>& srcLocal,
                                    AscendC::LocalTensor<T>& dstLocal,
                                    uint8_t repeatTime, uint16_t dstBlkStride, uint16_t dstRepStride)
{
    AscendC::BrcbRepeatParams params(dstBlkStride, dstRepStride);
    AscendC::Brcb(dstLocal, srcLocal, repeatTime, params);
}

// 性能测试函数
template <typename T>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& srcLocal,
                                        AscendC::LocalTensor<T>& dstLocal,
                                        uint8_t repeatTime, uint16_t dstBlkStride, uint16_t dstRepStride)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeBrcb<T>(srcLocal, dstLocal, repeatTime, dstBlkStride, dstRepStride);
    }
}

// 功能测试函数
template <typename T>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& srcGlobal,
                                          AscendC::GlobalTensor<T>& dstGlobal,
                                          AscendC::LocalTensor<T>& srcLocal,
                                          AscendC::LocalTensor<T>& dstLocal,
                                          uint32_t srcSize, uint32_t dstSize,
                                          uint8_t repeatTime, uint16_t dstBlkStride, uint16_t dstRepStride)
{
    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, srcSize);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 初始化dstLocal为0（非连续写出模式下部分位置不会被写入）
    AscendC::Duplicate(dstLocal, (T)0, dstSize);

    // 执行Brcb计算
    ComputeBrcb<T>(srcLocal, dstLocal, repeatTime, dstBlkStride, dstRepStride);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 数据搬出
    AscendC::DataCopy(dstGlobal, dstLocal, dstSize);
}

// 核函数模板
template <typename T, bool testPerformance = false>
__aicore__ inline void KernelBrcbNew(GM_ADDR x, GM_ADDR y, AscendC::TPipe* pipe)
{
    // 使用外部配置的参数计算srcSize和dstSize
    // Brcb: 一次repeat处理8个元素，每个元素广播到32B块
    constexpr uint32_t srcSize = size;
    constexpr uint32_t dstSize = repeatTime * dstRepStride * (32 / sizeof(T));

    // 定义GlobalTensor
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)x);
    dstGlobal.SetGlobalBuffer((__gm__ T*)y);

    // 设置静态Tensor起始地址（考虑256字节对齐）
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + 64 * 1024;

    // 定义静态LocalTensor
    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, srcSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dstSize);

    // 执行测试
    if constexpr (testPerformance) {
        TestPerformance<T>(srcLocal, dstLocal, repeatTime, dstBlkStride, dstRepStride);
    } else {
        TestFunctionality<T>(srcGlobal, dstGlobal, srcLocal, dstLocal,
                             srcSize, dstSize, repeatTime, dstBlkStride, dstRepStride);
    }
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunBrcbNewScenario(GM_ADDR x, GM_ADDR y)
{
    if constexpr (N == 1) {
        // half 基础测试
        RUN(half, false);
    } else if constexpr (N == 2) {
        // half 大步长测试
        RUN(half, false);
    } else if constexpr (N == 3) {
        // half 大数据量测试
        RUN(half, false);
    } else if constexpr (N == 4) {
        // float 基础测试
        RUN(float, false);
    } else if constexpr (N == 5) {
        // float 大数据量测试
        RUN(float, false);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_brcb_new(GM_ADDR x, GM_ADDR y)
{
    RunBrcbNewScenario<scenarioNum>(x, y);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 使用外部配置的参数计算数据大小
    // Brcb: 一次repeat处理8个元素，每个元素广播到32B块
    size_t xByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum >= 1 && scenarioNum <= 3) {
        // half类型测试
        xByteSize = size * sizeof(half);
        outputByteSize = repeatTime * dstRepStride * (32 / sizeof(half)) * sizeof(half);
    } else if constexpr (scenarioNum >= 4 && scenarioNum <= 5) {
        // float类型测试
        xByteSize = size * sizeof(float);
        outputByteSize = repeatTime * dstRepStride * (32 / sizeof(float)) * sizeof(float);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* xHost;
    uint8_t* outHost;
    uint8_t* xDevice;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 读取输入数据
    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 执行核函数
    kernel_brcb_new<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
