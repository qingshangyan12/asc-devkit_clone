/* !
 * \file saturation_verify.asc
 * \brief Saturation verify operator for exp/mul with different data types
 */

#include <cstdint>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_TENSOR_SIZE = INPUT_SIZE;
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE;
constexpr uint32_t INPUT_API = INPUT_API_ID;

constexpr uint32_t BUFFER_NUM = 2;

#define API_ID_EXP  1
#define API_ID_MUL  2

struct SaturationVerifyTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

template <class T>
class KernelSaturationVerify {
public:
    __aicore__ inline KernelSaturationVerify() {}
    __aicore__ inline void InitSingle(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        pipe->InitBuffer(inQueueSrc, 1, INPUT_TENSOR_SIZE * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, INPUT_TENSOR_SIZE * sizeof(T));
    }
    __aicore__ inline void InitBinary(__gm__ uint8_t* src1Gm, __gm__ uint8_t* src2Gm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        src1Global.SetGlobalBuffer((__gm__ T*)src1Gm);
        src2Global.SetGlobalBuffer((__gm__ T*)src2Gm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        
        this->blockLength = INPUT_TENSOR_SIZE / AscendC::GetBlockNum();
        this->tileNum = 1;
        this->tileLength = this->blockLength / BUFFER_NUM;
        
        pipe->InitBuffer(inQueueSrc1, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe->InitBuffer(inQueueSrc2, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe->InitBuffer(outQueueDst, BUFFER_NUM, this->tileLength * sizeof(T));
    }
    __aicore__ inline void ProcessSingle()
    {
        if constexpr (INPUT_TENSOR_TYPE == 1 || INPUT_TENSOR_TYPE == 2) {
            AscendC::AscendCUtils::SetOverflow(1);
        }
        CopyInSingle();
        ComputeSingle();
        CopyOutSingle();
    }
    __aicore__ inline void ProcessBinary()
    {
        if constexpr (INPUT_TENSOR_TYPE == 1 || INPUT_TENSOR_TYPE == 2) {
            AscendC::AscendCUtils::SetOverflow(0);
        } else if constexpr (INPUT_TENSOR_TYPE == 3 || INPUT_TENSOR_TYPE == 4) {
            set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_53_BIT));
        }
        
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyInBinary(i);
            ComputeBinary(i);
            CopyOutBinary(i);
        }
    }

private:
    __aicore__ inline void CopyInSingle()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, INPUT_TENSOR_SIZE);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void ComputeSingle()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();

        if constexpr (INPUT_API == API_ID_EXP) {
            AscendC::Exp(dstLocal, srcLocal, INPUT_TENSOR_SIZE);
        }

        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOutSingle()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, INPUT_TENSOR_SIZE);
        outQueueDst.FreeTensor(dstLocal);
    }
    __aicore__ inline void CopyInBinary(int32_t progress)
    {
        AscendC::LocalTensor<T> src1Local = inQueueSrc1.AllocTensor<T>();
        AscendC::LocalTensor<T> src2Local = inQueueSrc2.AllocTensor<T>();
        AscendC::DataCopy(src1Local, src1Global[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(src2Local, src2Global[progress * this->tileLength], this->tileLength);
        inQueueSrc1.EnQue(src1Local);
        inQueueSrc2.EnQue(src2Local);
    }
    __aicore__ inline void ComputeBinary(int32_t progress)
    {
        AscendC::LocalTensor<T> src1Local = inQueueSrc1.DeQue<T>();
        AscendC::LocalTensor<T> src2Local = inQueueSrc2.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();

        if constexpr (INPUT_API == API_ID_MUL) {
            AscendC::Mul(dstLocal, src1Local, src2Local, this->tileLength);
        }

        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc1.FreeTensor(src1Local);
        inQueueSrc2.FreeTensor(src2Local);
    }
    __aicore__ inline void CopyOutBinary(int32_t progress)
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal[progress * this->tileLength], dstLocal, this->tileLength);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueSrc1, inQueueSrc2;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> src1Global, src2Global;
    AscendC::GlobalTensor<T> dstGlobal;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __vector__ void saturation_verify_single(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelSaturationVerify<half> op;
        op.InitSingle(x, z, &pipe);
        op.ProcessSingle();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelSaturationVerify<float> op;
        op.InitSingle(x, z, &pipe);
        op.ProcessSingle();
    }
}

__global__ __vector__ void saturation_verify_binary(GM_ADDR x, GM_ADDR y, GM_ADDR z, SaturationVerifyTilingData tiling) 
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelSaturationVerify<half> op;
        op.InitBinary(x, y, z, &pipe);
        op.ProcessBinary();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelSaturationVerify<float> op;
        op.InitBinary(x, y, z, &pipe);
        op.ProcessBinary();
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        KernelSaturationVerify<int16_t> op;
        op.InitBinary(x, y, z, &pipe);
        op.ProcessBinary();
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        KernelSaturationVerify<int32_t> op;
        op.InitBinary(x, y, z, &pipe);
        op.ProcessBinary();
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    uint32_t dataTypeSize = sizeof(half);
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        dataTypeSize = sizeof(float);
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        dataTypeSize = sizeof(int16_t);
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        dataTypeSize = sizeof(int32_t);
    }
    
    size_t inputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;
    size_t outputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost;
    uint8_t *xDevice, *yDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    if constexpr (INPUT_API == API_ID_EXP) {
        saturation_verify_single<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    } else if constexpr (INPUT_API == API_ID_MUL) {
        yHost = (uint8_t*)malloc(inputByteSize);
        aclrtMalloc((void **)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
        aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize,
                    ACL_MEMCPY_HOST_TO_DEVICE);
        
        SaturationVerifyTilingData tiling = {INPUT_TENSOR_SIZE, numBlocks};
        saturation_verify_binary<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    }
    
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    if constexpr (INPUT_API == API_ID_MUL) {
        aclrtFree(yDevice);
        aclrtFreeHost(yHost);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
