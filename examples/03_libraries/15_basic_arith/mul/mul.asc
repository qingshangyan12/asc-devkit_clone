#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_TENSOR_SIZE = INPUT_SIZE; // 输入数据长度
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE; // 输入数据类型
constexpr uint32_t BUFFER_NUM = 2;  // 每个Queue队列中的tensor数量

struct MulCustomTilingData
{
    uint32_t totalLength; // 待处理的数据总大小（本样例是8 * INPUT_TENSOR_SIZE个元素）// TODO 改成2047个的
    uint32_t tileNum;     // 每个核需要计算的数据块个数
};

template <class T>
class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    // 初始化函数，完成内存初始化相关操作
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / AscendC::GetBlockNum();       // 每个核需要计算的数据大小
        this->tileNum = tileNum;                                        // 每个核需要计算的数据块个数
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;    // 每个核内的每个数据块的数据大小
        // AscendC::PRINTF("\nthis->blockLength = %d", this->blockLength);
        // AscendC::PRINTF("\nthis->tileNum = %d", this->tileNum);
        // AscendC::PRINTF("\nthis->tileLength = %d", this->tileLength);
        // 不同核根据各自的block_idx设置数据地址
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        // Queue初始化，单位为字节
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }
    // 核心处理函数，实现算子逻辑，调用私有成员函数CopyIn、Compute、CopyOut完成矢量算子的三级流水操作
    __aicore__ inline void Process()
    {
        // 浮点数设置CTRL[48]=0：饱和模式；设置CTRL[48]=1：非饱和模式。默认值是1？
        // 整数设置CTRL[53]=1：饱和模式；
        if constexpr (INPUT_TENSOR_TYPE == 1 || INPUT_TENSOR_TYPE == 2) {
            AscendC::AscendCUtils::SetOverflow(0);
            // AscendC::PRINTF("\n>>>>>>>>> AscendC::AscendCUtils::SetOverflow(0)");
        } else if constexpr (INPUT_TENSOR_TYPE == 3 || INPUT_TENSOR_TYPE == 4) {
            set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_53_BIT));
            // AscendC::PRINTF("\n>>>>>>>>> set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_53_BIT))");
        }

        // 循环次数是tileNum和BUFFER_NUM乘积
        // 将单核处理数据切分成tileNum块后，每块再切分成BUFFER_NUM块，可开启double buffer，实现流水线之间的并行
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        // AscendC::PRINTF("\nthis->loopCount = %d", loopCount);
        for (int32_t i = 0; i < loopCount; i++) {
            // AscendC::PRINTF("\nthis->i = %d", i);
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    // 搬入函数，从Global Memory搬运数据至Local Memory，被核心Process函数调用
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    // 计算函数，完成两个输入参数相加，得到最终结果，被核心Process函数调用
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // TODO 实现不同的场景计算方式
        AscendC::Mul(zLocal, xLocal, yLocal, this->tileLength);
        // uint32_t array[] = {static_cast<uint32_t>(2), static_cast<uint32_t>(2)};
        // AscendC::ShapeInfo shapeInfo(2, array); // dim为2， shape为(8,8)
        // AscendC::PRINTF("\nxLocal=>>>>>>>>>>>");
        // AscendC::DumpTensor(xLocal, 1, 4, shapeInfo); // dump a1Local的64个元素，且解析按照shapeInfo的(8,8)排列
        // AscendC::PRINTF("\nyLocal=>>>>>>>>>>>");
        // AscendC::DumpTensor(yLocal, 1, 4, shapeInfo); // dump a1Local的64个元素，且解析按照shapeInfo的(8,8)排列
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    // 搬出函数，将最终结果从Local Memory搬运到Global Memory上，被核心Process函数调用
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // uint32_t array[] = {static_cast<uint32_t>(2), static_cast<uint32_t>(2)};
        // AscendC::ShapeInfo shapeInfo(2, array); // dim为2， shape为(8,8)
        // AscendC::PRINTF("\nzLocal=>>>>>>>>>>>");
        // AscendC::DumpTensor(zLocal, 1, 4, shapeInfo); // dump a1Local的64个元素，且解析按照shapeInfo的(8,8)排列
        // AscendC::PRINTF("\nzGm=>>>>>>>>>>>");
        // AscendC::DumpTensor(zGm, 1, 4, shapeInfo); // dump a1Local的64个元素，且解析按照shapeInfo的(8,8)排列
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe; // TPipe内存管理对象
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY; // 输入数据Queue队列管理对象，TPosition为VECIN
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ; // 输出数据Queue队列管理对象，TPosition为VECOUT
    AscendC::GlobalTensor<T> xGm; // 管理输入输出Global Memory内存地址的对象，其中xGm, yGm为输入，zGm为输出
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    uint32_t blockLength; // 每个核的计算数据长度
    uint32_t tileNum; // 每个核需要计算的数据块个数
    uint32_t tileLength; // 每个核内每个数据块的长度
};

extern "C" __global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelMul<half> op;
        op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelMul<float> op;
        op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        KernelMul<int16_t> op;
        op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        KernelMul<int32_t> op;
        op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
        op.Process();
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t numBlocks = 1; // TODO
    uint32_t totalLength = INPUT_TENSOR_SIZE;
    uint32_t dataTypeSize = sizeof(half);
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        dataTypeSize = sizeof(float);
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        dataTypeSize = sizeof(int32_t);
    } 
    size_t totalByteSize = totalLength * dataTypeSize;
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    MulCustomTilingData tiling = {totalLength, numBlocks};
    uint8_t *xHost = nullptr;
    uint8_t *yHost = nullptr;
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    // 初始化
    aclInit(nullptr);
    // 运行管理资源申请
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    // 分配Host内存
    aclrtMallocHost((void **)(&xHost), totalByteSize);
    aclrtMallocHost((void **)(&yHost), totalByteSize);
    aclrtMallocHost((void **)(&zHost), totalByteSize);
    // 分配Device内存
    aclrtMalloc((void **)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    // 将Host上的输入数据拷贝到Device侧
    ReadFile("./input/input_x.bin", totalByteSize, xHost, totalByteSize);
    ReadFile("./input/input_y.bin", totalByteSize, yHost, totalByteSize);
    aclrtMemcpy(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    // 用内核调用符<<<...>>>调用核函数完成指定的运算
    mul_custom<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    aclrtSynchronizeStream(stream);
    // 将Device上的运算结果拷贝回Host
    aclrtMemcpy(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_z.bin", zHost, totalByteSize);

    // 释放申请的资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    // 去初始化
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
