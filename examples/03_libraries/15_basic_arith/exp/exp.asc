/* !
 * \file exp.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_TENSOR_SIZE = INPUT_SIZE; // 输入数据长度
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE; // 输入数据类型
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000; // 指令重复执行次数（用于性能测试）

template <class T>
class KernelExp {
public:
    __aicore__ inline KernelExp() {}
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);

        pipe->InitBuffer(inQueueSrc, 1, INPUT_TENSOR_SIZE * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, INPUT_TENSOR_SIZE * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, INPUT_TENSOR_SIZE);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();

        AscendC::Exp(dstLocal, srcLocal, INPUT_TENSOR_SIZE);

        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, INPUT_TENSOR_SIZE);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal, dstGlobal;
};

__global__ __vector__ void exp_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelExp<half> op;
        op.Init(x, z, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelExp<float> op;
        op.Init(x, z, &pipe);
        op.Process();
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    uint32_t dataTypeSize = sizeof(half);
    if constexpr (INPUT_TENSOR_TYPE == 2) {
        dataTypeSize = sizeof(float);
    }
    size_t inputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;
    size_t outputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    exp_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
