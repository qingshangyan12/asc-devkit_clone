/* !
 * \file exp.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_SIZE_PARAM = INPUT_SIZE;           // 输入数据长度
constexpr uint32_t SCENARIO_NUM_PARAM = SCENARIO_NUM;       // 样例场景
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000;    // 指令重复执行次数（用于性能测试）

class KernelReduce {
public:
    __aicore__ inline KernelReduce() {}
    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ half*)src);
        dstGlobal.SetGlobalBuffer((__gm__ half*)dstGm);

        pipe->InitBuffer(inQueueSrc, 1, INPUT_SIZE_PARAM * sizeof(half));
        pipe->InitBuffer(outQueueDst, 1, INPUT_SIZE_PARAM * sizeof(half));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.AllocTensor<half>();
        AscendC::DataCopy(srcLocal, srcGlobal, INPUT_SIZE_PARAM);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.DeQue<half>();
        AscendC::LocalTensor<half> dstLocal = outQueueDst.AllocTensor<half>();

        if constexpr (SCENARIO_NUM_PARAM == 1) {
            // 场景1：连续计算API + API接口传mask参数 + Counter的mask工作模式
            AscendC::Exp(dstLocal, srcLocal, INPUT_SIZE_PARAM);
        } else if constexpr (SCENARIO_NUM_PARAM == 2) {
            // 场景2：连续计算API + 外部接口设置mask参数 + Counter的mask工作模式
        } else if constexpr (SCENARIO_NUM_PARAM == 3) {
            // 场景3：高维切分计算API + API接口传mask参数 + Normal的mask工作模式
        } else if constexpr (SCENARIO_NUM_PARAM == 4) {
            // 场景4：高维切分计算API + API接口传mask参数 + Counter的mask工作模式
        } else if constexpr (SCENARIO_NUM_PARAM == 5) {
            // 场景5：高维切分计算API + 外部接口设置mask参数 + Normal的mask工作模式
        } else if constexpr (SCENARIO_NUM_PARAM == 6) {
            // 场景6：高维切分计算API + 外部接口设置mask参数 + Counter的mask工作模式
        } else if constexpr (SCENARIO_NUM_PARAM == 7) {
            // 场景7：测试指令的性能
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t systemCycleBefore = AscendC::GetSystemCycle();
            for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXCUTE; ++i) {
                AscendC::Mul(dstLocal, srcLocal, srcLocal, INPUT_SIZE_PARAM);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t systemCycleAfter = AscendC::GetSystemCycle();
            AscendC::PRINTF("[PERFORMANCE_TEST_LOG] systemCycleBefore: %d\n", systemCycleBefore);
            AscendC::PRINTF("[PERFORMANCE_TEST_LOG] systemCycleAfter: %d\n", systemCycleAfter);
            AscendC::PRINTF("[PERFORMANCE_TEST_LOG] Exp instruction has excuted %d times, cost cycles: %d\n",
                REPEAT_TIMES_FOR_INSTR_EXCUTE, (systemCycleAfter - systemCycleBefore));
        } else {
            // 默认当作场景一处理
            AscendC::Exp(dstLocal, srcLocal, INPUT_SIZE_PARAM);
        }

        outQueueDst.EnQue<half>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dstLocal = outQueueDst.DeQue<half>();
        AscendC::DataCopy(dstGlobal, dstLocal, INPUT_SIZE_PARAM);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<half> srcGlobal, dstGlobal;
};

__global__ __vector__ void exp_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;
    KernelReduce op;
    op.Init(x, z, &pipe);
    op.Process();
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = INPUT_SIZE_PARAM * sizeof(half);
    size_t outputByteSize = INPUT_SIZE_PARAM * sizeof(half);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    exp_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
