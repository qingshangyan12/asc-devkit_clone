/* !
 * \file gatherb.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(srcType, testPerformance, mode)                                                                      \
         AscendC::TPipe pipe;                                                                                    \
         KernelGatherb<srcType, testPerformance, mode>(x, y, offset, &pipe);


#define NOT_SUPPORT AscendC::printf("not support!");

constexpr uint32_t scenarioNum = SCENARIO_NUM;

enum class Mode {
    CONTINUOUS_WRITE_MODE = 0,     // 目的操作数连续写出模式
    NON_CONTINUOUS_WRITE_MODE,     // 目的操作数非连续写出模式
    BANK_CONFLICT_MODE            // bank conflict场景
};

template <typename T>
__aicore__ inline void ComputeContinuousWriteMode(AscendC::LocalTensor<T>& srcLocal, 
                                                   AscendC::LocalTensor<uint32_t>& offsetLocal,
                                                   AscendC::LocalTensor<T>& dstLocal,
                                                   uint32_t repeatTime, uint32_t dstRepStride)
{
    AscendC::GatherRepeatParams params{1, 8};
    AscendC::Gatherb<T>(dstLocal, srcLocal, offsetLocal, (uint8_t)repeatTime, params);
}

template <typename T>
__aicore__ inline void ComputeNonContinuousWriteMode(AscendC::LocalTensor<T>& srcLocal,
                                                      AscendC::LocalTensor<uint32_t>& offsetLocal,
                                                      AscendC::LocalTensor<T>& dstLocal,
                                                      uint32_t repeatTime, uint32_t dstBlkStride, uint32_t dstRepStride)
{
    AscendC::GatherRepeatParams params{dstBlkStride, dstRepStride};
    AscendC::Gatherb<T>(dstLocal, srcLocal, offsetLocal, (uint8_t)repeatTime, params);
}

template <typename T, Mode mode>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& srcLocal,
                                        AscendC::LocalTensor<uint32_t>& offsetLocal,
                                        AscendC::LocalTensor<T>& dstLocal,
                                        uint32_t repeatTime, uint32_t dstBlkStride, uint32_t dstRepStride)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeContinuousWriteMode<T>(srcLocal, offsetLocal, dstLocal, repeatTime, dstRepStride);
    }
}

template <typename T, Mode mode>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& srcGlobal,
                                          AscendC::GlobalTensor<uint32_t>& offsetGlobal,
                                          AscendC::GlobalTensor<T>& dstGlobal,
                                          AscendC::LocalTensor<T>& srcLocal,
                                          AscendC::LocalTensor<uint32_t>& offsetLocal,
                                          AscendC::LocalTensor<T>& dstLocal,
                                          uint32_t inSize, uint32_t offsetSize, uint32_t outSize,
                                          uint32_t repeatTime, uint32_t dstBlkStride, uint32_t dstRepStride)
{
    AscendC::DataCopy(srcLocal, srcGlobal, inSize);
    AscendC::DataCopy(offsetLocal, offsetGlobal, offsetSize);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    if constexpr (mode == Mode::CONTINUOUS_WRITE_MODE) {
        ComputeContinuousWriteMode<T>(srcLocal, offsetLocal, dstLocal, repeatTime, dstRepStride);
    } else if constexpr (mode == Mode::NON_CONTINUOUS_WRITE_MODE) {
        ComputeNonContinuousWriteMode<T>(srcLocal, offsetLocal, dstLocal, repeatTime, dstBlkStride, dstRepStride);
    } else {
        ComputeNonContinuousWriteMode<T>(srcLocal, offsetLocal, dstLocal, repeatTime, dstBlkStride, dstRepStride);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGlobal, dstLocal, outSize);
}

template <typename T, bool testPerformance = false, Mode mode = Mode::CONTINUOUS_WRITE_MODE>
__aicore__ inline void KernelGatherb(GM_ADDR x, GM_ADDR y, GM_ADDR offset, AscendC::TPipe* pipe)
{
    // 根据场景设置参数
    uint32_t inSize = 0;
    uint32_t offsetSize = 0;
    uint32_t outSize = 0;
    uint32_t repeatTime = 0;
    uint32_t dstBlkStride = 1;
    uint32_t dstRepStride = 8;

    if constexpr (scenarioNum == 1) {
        inSize = 512;
        offsetSize = 16;
        outSize = 256;
        repeatTime = 2;
        dstBlkStride = 1;
        dstRepStride = 8;
    } else if constexpr (scenarioNum == 2) {
        inSize = 512;
        offsetSize = 16;
        outSize = 512;
        repeatTime = 2;
        dstBlkStride = 2;
        dstRepStride = 16;
    } else if constexpr (scenarioNum == 3) {
        inSize = 1024 * 16 * 2;
        offsetSize = 1024;
        outSize = 1024 * 16;
        repeatTime = 128;
        dstBlkStride = 1;
        dstRepStride = 8;
    } else if constexpr (scenarioNum == 4) {
        inSize = 512;
        offsetSize = 16;
        outSize = 1024;
        repeatTime = 2;
        dstBlkStride = 4;
        dstRepStride = 32;
    } else if constexpr (scenarioNum == 5) {
        inSize = 1024 * 8 * 2;
        offsetSize = 1024;
        outSize = 1024 * 8;
        repeatTime = 128;
        dstBlkStride = 1;
        dstRepStride = 8;
    }

    // 定义GlobalTensor
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<uint32_t> offsetGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)x);
    offsetGlobal.SetGlobalBuffer((__gm__ uint32_t*)offset);
    dstGlobal.SetGlobalBuffer((__gm__ T*)y);

    // 设置静态Tensor起始地址
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t offsetAddr = xAddr + 1024 * 32 * 2 * sizeof(T) + 256;  // 预留足够空间
    constexpr uint32_t yAddr = offsetAddr + 1024 * sizeof(uint32_t) + 256;

    // 定义LocalTensor
    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, xAddr, inSize);
    AscendC::LocalTensor<uint32_t> offsetLocal(AscendC::TPosition::VECCALC, offsetAddr, offsetSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, yAddr, outSize);

    // 执行性能测试&功能测试
    if constexpr (testPerformance) {
        TestPerformance<T, mode>(srcLocal, offsetLocal, dstLocal, repeatTime, dstBlkStride, dstRepStride);
    } else {
        TestFunctionality<T, mode>(srcGlobal, offsetGlobal, dstGlobal, srcLocal, offsetLocal, dstLocal,
                                   inSize, offsetSize, outSize, repeatTime, dstBlkStride, dstRepStride);
    }
}

// 执行不同场景
template <uint32_t N>
__aicore__ inline void RunGatherbScenario(GM_ADDR x, GM_ADDR y, GM_ADDR offset)
{
    if constexpr (N == 1) {
        RUN(half, false, Mode::CONTINUOUS_WRITE_MODE);
    } else if constexpr (N == 2) {
        RUN(half, false, Mode::NON_CONTINUOUS_WRITE_MODE);
    } else if constexpr (N == 3) {
        RUN(half, true, Mode::CONTINUOUS_WRITE_MODE);
    } else if constexpr (N == 4) {
        RUN(half, true, Mode::BANK_CONFLICT_MODE);
    } else if constexpr (N == 5) {
        RUN(float, true, Mode::CONTINUOUS_WRITE_MODE);
    } else {
        NOT_SUPPORT;
    }
}

__global__ __vector__ void kernel_gatherb(GM_ADDR x, GM_ADDR y, GM_ADDR offset)
{
    RunGatherbScenario<scenarioNum>(x, y, offset);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 8;
    size_t xByteSize = 0;
    size_t offsetByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == 1) {
        xByteSize = 512 * sizeof(int16_t);
        offsetByteSize = 16 * sizeof(int32_t);
        outputByteSize = 256 * sizeof(int16_t);
    } else if constexpr (scenarioNum == 2) {
        xByteSize = 512 * sizeof(int16_t);
        offsetByteSize = 16 * sizeof(int32_t);
        outputByteSize = 512 * sizeof(int16_t);
    } else if constexpr (scenarioNum == 3) {
        xByteSize = 1024 * 16 * 2 * sizeof(int16_t);
        offsetByteSize = 1024 * sizeof(int32_t);
        outputByteSize = 1024 * 16 * sizeof(int16_t);
    } else if constexpr (scenarioNum == 4) {
        xByteSize = 512 * sizeof(int16_t);
        offsetByteSize = 16 * sizeof(int32_t);
        outputByteSize = 1024 * sizeof(int16_t);
    } else if constexpr (scenarioNum == 5) {
        xByteSize = 1024 * 8 * 2 * sizeof(int32_t);
        offsetByteSize = 1024 * sizeof(int32_t);
        outputByteSize = 1024 * 8 * sizeof(int32_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *offsetHost, *outHost;
    uint8_t *xDevice, *offsetDevice, *outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&offsetHost), offsetByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);

    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&offsetDevice, offsetByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_y.bin", offsetByteSize, offsetHost, offsetByteSize);
    aclrtMemcpy(offsetDevice, offsetByteSize, offsetHost, offsetByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_gatherb<<<numBlocks, nullptr, stream>>>(xDevice, outDevice, offsetDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(offsetDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(offsetHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
