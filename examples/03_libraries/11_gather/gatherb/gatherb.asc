/* !
 * \file gatherb.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template<typename T, bool testPerformance = false>
class VgatherbCase {
public:
    __aicore__ inline VgatherbCase() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* offset, AscendC::TPipe* pipeIn)
    {
        tpipe = pipeIn;
        x_gm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        y_gm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        offset_gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(offset));

        if constexpr (scenarioNum == 1) {
            in_size = 512;
            offset_size = 16;
            out_size = 256;
        } else if constexpr (scenarioNum == 2) {
            in_size = 512;
            offset_size = 16;
            out_size = 512;
        } else if constexpr (scenarioNum == 3) {
            in_size = 1024 * 16 * 2;
            offset_size = 1024;
            out_size = 1024 * 16;
        } else if constexpr (scenarioNum == 4) {
            in_size = 512;
            offset_size = 16;
            out_size = 1024;
        } else if constexpr (scenarioNum == 5) {
            in_size = 1024 * 8 * 2;
            offset_size = 1024;
            out_size = 1024 * 8;
        }
        tpipe->InitBuffer(vecIn, 1, in_size * sizeof(T));
        tpipe->InitBuffer(vecOffset, 1, offset_size * sizeof(uint32_t));
        tpipe->InitBuffer(vecOut, 1, out_size * sizeof(T));
    }

    __aicore__ inline void CopyIn()
    {
        auto x_buf = vecIn.AllocTensor<T>();
        auto offset_buf = vecOffset.AllocTensor<uint32_t>();
        AscendC::DataCopy(x_buf, x_gm, in_size);
        AscendC::DataCopy(offset_buf, offset_gm, offset_size);
        vecIn.EnQue(x_buf);
        vecOffset.EnQue(offset_buf);
    }

    __aicore__ inline void CopyOut()
    {
        auto y_buf = vecOut.DeQue<T>();
        AscendC::DataCopy(y_gm, y_buf, out_size);
        vecOut.FreeTensor(y_buf);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> x_buf;
        AscendC::LocalTensor<uint32_t> offset_buf;
        AscendC::LocalTensor<T> y_buf = vecOut.AllocTensor<T>();
        if constexpr (testPerformance) {
            x_buf = vecIn.AllocTensor<T>();
            offset_buf = vecOffset.AllocTensor<uint32_t>();
        } else {
            x_buf = vecIn.DeQue<T>();
            offset_buf = vecOffset.DeQue<uint32_t>();
        }
        if constexpr (scenarioNum == 1) {
            AscendC::GatherRepeatParams params{1, 8};
            uint8_t repeatTime = 2;
            AscendC::Gatherb<T>(y_buf, x_buf, offset_buf, repeatTime, params);
        } else if constexpr (scenarioNum == 2) {
            AscendC::GatherRepeatParams params{2, 16};
            uint8_t repeatTime = 2;
            AscendC::Gatherb<T>(y_buf, x_buf, offset_buf, repeatTime, params);
        } else if constexpr (scenarioNum == 3) {
            AscendC::GatherRepeatParams params{1, 8};
            uint8_t repeatTime = 128;
            AscendC::Gatherb<T>(y_buf, x_buf, offset_buf, repeatTime, params);
        } else if constexpr (scenarioNum == 4) {
            AscendC::GatherRepeatParams params{4, 32};
            uint8_t repeatTime = 2;
            AscendC::Gatherb<T>(y_buf, x_buf, offset_buf, repeatTime, params);
        } else if constexpr (scenarioNum == 5) {
            AscendC::GatherRepeatParams params{1, 8};
            uint8_t repeatTime = 128;
            AscendC::Gatherb<T>(y_buf, x_buf, offset_buf, repeatTime, params);
        }
        vecIn.FreeTensor(x_buf);
        vecOffset.FreeTensor(offset_buf);
        if constexpr (testPerformance) {
            vecOut.FreeTensor(y_buf);
        } else {
            vecOut.EnQue(y_buf);
        }
    }

    __aicore__ inline void Process()
    {
        if constexpr (testPerformance) {
            Compute();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }

private:
    AscendC::GlobalTensor<T> x_gm;
    AscendC::GlobalTensor<T> y_gm;
    AscendC::GlobalTensor<uint32_t> offset_gm;

    AscendC::TPipe* tpipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> vecIn;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> vecOffset;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> vecOut;

    uint32_t in_size;
    uint32_t offset_size;
    uint32_t out_size;
};

__global__ __cube__ void vgatherb_core(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* offset)
{
    AscendC::TPipe pipe;
    if constexpr (scenarioNum == 1) {
        VgatherbCase<uint16_t> op;
        op.Init(x, y, offset, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        VgatherbCase<uint16_t> op;
        op.Init(x, y, offset, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        VgatherbCase<uint16_t, true> op;
        op.Init(x, y, offset, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        VgatherbCase<uint16_t, true> op;
        op.Init(x, y, offset, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 5) {
        VgatherbCase<uint32_t, true> op;
        op.Init(x, y, offset, &pipe);
        op.Process();
    }
}

int32_t main(int32_t argc, char* argv[]) {
  uint32_t numBlocks = 8;
  size_t inputByteSize;
  size_t offsetByteSize;
  size_t outputByteSize;
  
  if constexpr (scenarioNum == 1) {
    inputByteSize = 512 * sizeof(uint16_t);
    offsetByteSize = 16 * sizeof(uint32_t);
    outputByteSize = 256 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 2) {
    inputByteSize = 512 * sizeof(uint16_t);
    offsetByteSize = 16 * sizeof(uint32_t);
    outputByteSize = 512 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 3) {
    inputByteSize = 1024 * 16 * 2 * sizeof(uint16_t);
    offsetByteSize = 1024 * sizeof(uint32_t);
    outputByteSize = 1024 * 16 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 4) {
    inputByteSize = 512 * sizeof(uint16_t);
    offsetByteSize = 16 * sizeof(uint32_t);
    outputByteSize = 1024 * sizeof(uint16_t);
  } else if constexpr (scenarioNum == 5) {
    inputByteSize = 1024 * 8 * 2 * sizeof(uint32_t);
    offsetByteSize = 1024 * sizeof(uint32_t);
    outputByteSize = 1024 * 8 * sizeof(uint32_t);
  }

  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);

  uint8_t* xHost;
  uint8_t* yHost;
  uint8_t* outHost;
  uint8_t* xDevice;
  uint8_t* yDevice;
  uint8_t* outDevice;

  aclrtMallocHost((void**)(&xHost), inputByteSize);
  aclrtMallocHost((void**)(&yHost), offsetByteSize);
  aclrtMallocHost((void**)(&outHost), outputByteSize);
  aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void**)&yDevice, offsetByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
  ReadFile("./input/input_y.bin", offsetByteSize, yHost, offsetByteSize);

  aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);
  aclrtMemcpy(yDevice, offsetByteSize, yHost, offsetByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);

  vgatherb_core<<<numBlocks, nullptr, stream>>>(xDevice, outDevice, yDevice);
  aclrtSynchronizeStream(stream);

  aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  WriteFile("./output/output.bin", outHost, outputByteSize);

  aclrtFree(xDevice);
  aclrtFree(yDevice);
  aclrtFree(outDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(yHost);
  aclrtFreeHost(outHost);

  aclrtDestroyStream(stream);
  aclrtResetDevice(deviceId);
  aclFinalize();

  return 0;
}
