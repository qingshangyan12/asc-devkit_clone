/* !
 * \file gather.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;

enum class Mode {
    USE_COUNT_MODE = 0,          // Gather指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // Gather指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // Gather指令使用mask逐比特模式
};

template <typename T, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE>
class GatherTest {
public:
    __aicore__ inline GatherTest() {}
    __aicore__ inline void Init(__gm__ uint8_t* dstGm, __gm__ uint8_t* srcGm,
        __gm__ uint8_t* srcOffsetGm, const uint32_t count, AscendC::TPipe* pipeIn)
    {
        m_pipe = pipeIn;
        m_elementCount = count;
        m_dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        m_srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        m_srcOffsetGlobal.SetGlobalBuffer((__gm__ uint32_t*)srcOffsetGm);
        m_pipe->InitBuffer(m_queIn, 2, m_elementCount * sizeof(uint16_t));
        m_pipe->InitBuffer(m_queOut, 2, m_elementCount * sizeof(uint16_t));
    }
    __aicore__ inline void Process()
    {
        if constexpr (testPerformance) {
            Compute();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = m_queIn.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, m_srcGlobal, m_elementCount + 32);
        m_queIn.EnQue(srcLocal);
        AscendC::LocalTensor<uint32_t> srcOffsetLocal = m_queIn.AllocTensor<uint32_t>();
        AscendC::DataCopy(srcOffsetLocal, m_srcOffsetGlobal, m_elementCount);
        m_queIn.EnQue(srcOffsetLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal;
        AscendC::LocalTensor<uint32_t> srcOffsetLocal;
        if constexpr (testPerformance) {
            srcLocal = m_queIn.AllocTensor<T>();
            srcOffsetLocal = m_queIn.AllocTensor<uint32_t>();
        } else {
            srcLocal = m_queIn.DeQue<T>();
            srcOffsetLocal = m_queIn.DeQue<uint32_t>();
        }
        AscendC::LocalTensor<T> dstLocal = m_queOut.AllocTensor<T>();
        srcLocal.SetSize(m_elementCount);
        if constexpr (testPerformance) {
            AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)0, m_elementCount);
        } else {
            if constexpr (mode == Mode::USE_COUNT_MODE) {
                AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)64, m_elementCount);
            } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
                constexpr uint16_t oneRepSize = 256 / sizeof(T);
                uint16_t repeatTimes = m_elementCount / oneRepSize;
                AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)64, oneRepSize, repeatTimes, 8);
            } else {
                uint64_t mask[2] = {0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF};
                constexpr uint16_t oneRepSize = 256 / sizeof(T);
                uint16_t repeatTimes = m_elementCount / oneRepSize;
                AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)64, mask, repeatTimes, 8);
            }
        }
        m_queIn.FreeTensor(srcLocal);
        m_queIn.FreeTensor(srcOffsetLocal);
        if constexpr (testPerformance) {
            m_queOut.FreeTensor(dstLocal);
        } else {
            m_queOut.EnQue(dstLocal);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = m_queOut.DeQue<T>();
        AscendC::DataCopy(m_dstGlobal, dstLocal, m_elementCount);
        m_queOut.FreeTensor(dstLocal);
    }
private:
    AscendC::TPipe* m_pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> m_queCalc;
    AscendC::GlobalTensor<T> m_valueGlobal;
    uint32_t m_concatRepeatTimes;
    uint32_t m_sortRepeatTimes;
    uint32_t m_extractRepeatTimes;
    uint32_t m_elementCount;
    AscendC::GlobalTensor<uint32_t> m_srcOffsetGlobal;
    AscendC::GlobalTensor<T> m_srcGlobal;
    AscendC::GlobalTensor<T> m_dstGlobal;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> m_queIn;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> m_queOut;
}; // class GatherTest

__global__ __vector__ void kernel_gather(GM_ADDR dstGm, GM_ADDR srcGm, GM_ADDR srcOffsetGm)
{
    AscendC::TPipe pipe;
    if constexpr (scenarioNum == 1) {
        GatherTest<half> op;
        op.Init(dstGm, srcGm, srcOffsetGm, 128, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        GatherTest<half, false, Mode::USE_CONTINUOUS_MODE_OF_MASK> op;
        op.Init(dstGm, srcGm, srcOffsetGm, 128, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        GatherTest<half, false, Mode::USE_BITWISE_MASK_MODE> op;
        op.Init(dstGm, srcGm, srcOffsetGm, 128, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        GatherTest<half, true> op;
        op.Init(dstGm, srcGm, srcOffsetGm, 1024 * 16, &pipe);
        op.Process();
    }
}

int32_t main(int32_t argc, char *argv[]) {
    uint32_t numBlocks = 0;
    size_t inputByteSize = 0;
    size_t offsetByteSize = 0;
    size_t outputByteSize = 0;
    if constexpr (scenarioNum == 1) {
        numBlocks = 8;
        inputByteSize = 160 * sizeof(uint16_t);
        offsetByteSize = 128 * sizeof(uint32_t);
        outputByteSize = 128 * sizeof(uint16_t);
    } else if constexpr (scenarioNum == 2) {
        numBlocks = 8;
        inputByteSize = 160 * sizeof(uint16_t);
        offsetByteSize = 128 * sizeof(uint32_t);
        outputByteSize = 128 * sizeof(uint16_t);
    } else if constexpr (scenarioNum == 3) {
        numBlocks = 8;
        inputByteSize = 160 * sizeof(uint16_t);
        offsetByteSize = 128 * sizeof(uint32_t);
        outputByteSize = 128 * sizeof(uint16_t);
    } else if constexpr (scenarioNum == 4) {
        numBlocks = 8;
        inputByteSize = 1024 * 16 * sizeof(uint16_t);
        offsetByteSize = 1024 * 16 * sizeof(uint32_t);
        outputByteSize = 1024 * 16 * sizeof(uint16_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* yHost;
    uint8_t* outHost;
    uint8_t* xDevice;
    uint8_t* yDevice;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), offsetByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, offsetByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("./input/input_y.bin", offsetByteSize, yHost, offsetByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, offsetByteSize, yHost, offsetByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_gather<<<numBlocks, nullptr, stream>>>(outDevice, xDevice, yDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
