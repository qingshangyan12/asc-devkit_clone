/* !
 * \file gather.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(srcType, offsetType, testPerformance, mode)                                                         \
 	     AscendC::TPipe pipe;                                                                                               \
 	     KernelGather<srcType, offsetType, testPerformance, mode>(x, y, z, &pipe);


#define NOT_SUPPORT AscendC::printf("not support!");

constexpr uint32_t scenarioNum = SCENARIO_NUM;

enum class Mode {
    USE_COUNT_MODE = 0,          // Gather指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // Gather指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // Gather指令使用mask逐比特模式
};

template <typename T, typename U>
__aicore__ inline void ComputeCountMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& srcOffsetLocal,
                                        AscendC::LocalTensor<T>& dstLocal)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(T);
    uint16_t repeatTimes = SIZE / oneRepSize;
    AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)64, m_elementCount);
}

template <typename T, typename U>
__aicore__ inline void ComputeContinuousMaskMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& srcOffsetLocal,
                                                AscendC::LocalTensor<T>& dstLocal)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(T);
    uint16_t repeatTimes = size / oneRepSize;
    AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)64, oneRepSize, repeatTimes, 8);
}

template <typename T, typename U>
__aicore__ inline void ComputeBitwiseMaskMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& srcOffsetLocal,
                                            AscendC::LocalTensor<T>& dstLocal)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(T);
    uint16_t repeatTimes = size / oneRepSize;
    uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
    AscendC::Gather(dstLocal, srcLocal, srcOffsetLocal, (uint32_t)64, mask, repeatTimes, 8);
}

template <typename T, typename U, Mode mode>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& srcOffsetLocal,
                                    AscendC::LocalTensor<T>& dstLocal)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeCountMode(srcLocal, srcOffsetLocal, dstLocal);
    }
}

template <typename T, typename U, Mode mode>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& srcGlobal, AscendC::GlobalTensor<U>& srcOffsetGlobal,
                                        AscendC::GlobalTensor<T>& dstGlobal, AscendC::LocalTensor<T>& srcLocal,
                                        AscendC::LocalTensor<U>& srcOffsetLocal, AscendC::LocalTensor<T>& dstLocal)
{
    AscendC::DataCopy(srcLocal, srcGlobal, size);
    AscendC::DataCopy(srcOffsetLocal, srcOffsetGlobal, size);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    if constexpr (mode == Mode::USE_COUNT_MODE) {
        ComputeCountMode<T, U>(srcLocal, srcOffsetLocal, dstLocal);
    } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
        ComputeContinuousMaskMode<T, U>(srcLocal, srcOffsetLocal, dstLocal);
    } else {
        ComputeBitwiseMaskMode<T, U>(srcLocal, srcOffsetLocal, dstLocal);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGlobal, dstLocal, size);
}

template <typename T, typename U, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE,
        CaseType caseType = CaseType::NORMAL>
__aicore__ inline void KernelGather(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipe)
{
    // 定义GlobalTensor
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U srcOffsetGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)x);
    srcOffsetGlobal.SetGlobalBuffer((__gm__ U*)y);
    dstGlobal.SetGlobalBuffer((__gm__ T*)z);

    // 设置静态Tensor起始地址
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t yAddr = xAddr + size * sizeof(T) + 256;
    constexpr uint32_t zAddr = yAddr + size * sizeof(U);

    // 定义LocalTensor
    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, xAddr, size);
    AscendC::LocalTensor<U> srcOffsetLocal(AscendC::TPosition::VECCALC, yAddr, size);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, zAddr, size);

    // 执行性能测试&功能测试
    if constexpr (testPerformance) {
        TestPerformance<T, U, mode>(srcLocal, srcOffsetLocal, dstLocal);
    } else {
        TestFunctionality<T, U, mode>(srcGlobal, srcOffsetGlobal, dstGlobal, srcLocal, srcOffsetLocal, dstLocal);
    }
}

// 执行不同场景
template <uint32_t N>
__aicore__ inline void RunGatherScenario(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    if constexpr (N == 1) {
        RUN(half, int8_t, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (N == 2) {
        RUN(half, int8_t, false, Mode::USE_BITWISE_MASK_MODE, CaseType::NORMAL);
    } else if constexpr (N == 3) {
        RUN(half, int8_t, false, Mode::USE_CONTINUOUS_MODE_OF_MASK, CaseType::NORMAL);
    } else if constexpr (N == 4) {
        RUN(half, int8_t, false, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (N == 5) {
        RUN(half, int8_t, true, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else {
        NOT_SUPPORT;
    }
}

__global__ __vector__ void kernel_gather(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    RunGatherScenario<scenarioNum>(x, y, z);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t xByteSize = 0;
    size_t yByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum >= 1 && scenarioNum <= 6) {
        xByteSize = SIZE * sizeof(int16_t);
        yByteSize = SIZE * sizeof(int32_t);
        outputByteSize = SIZE * sizeof(int16_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *outHost;
    uint8_t *xDevice, *yDevice, *outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&yHost), yByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);

    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_y.bin", yByteSize, yHost, yByteSize);
    aclrtMemcpy(yDevice, yByteSize, yHost, yByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_gather<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}