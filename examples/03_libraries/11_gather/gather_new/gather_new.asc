/* !
 * \file gather_new.asc
 * \brief Gather算子样例 - 静态内存版本
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 宏定义
#define RUN(srcType, offsetType, testPerformance, mode)                         \
    AscendC::TPipe pipe;                                                         \
    KernelGatherNew<srcType, offsetType, testPerformance, mode>(x, y, z, &pipe);

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景和大小常量 - 支持外部配置
constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;
constexpr uint32_t calcSize = CALC_SIZE;
constexpr uint32_t baseAddr = (SCENARIO_NUM >= 1 && SCENARIO_NUM <=3) ? 32 * sizeof(half) : 0;

// 模式枚举
enum class Mode {
    USE_COUNT_MODE = 0,           // Gather指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK,  // Gather指令使用mask连续模式
    USE_BITWISE_MASK_MODE         // Gather指令使用mask逐比特模式
};

// 计算函数 - Count模式
template <typename T, typename U>
__aicore__ inline void ComputeCountMode(AscendC::LocalTensor<T>& srcLocal,
                                         AscendC::LocalTensor<U>& offsetLocal,
                                         AscendC::LocalTensor<T>& dstLocal,
                                         uint32_t calcSize)
{
    AscendC::Gather(dstLocal, srcLocal, offsetLocal, baseAddr, calcSize);
}

// 计算函数 - 连续Mask模式
template <typename T, typename U>
__aicore__ inline void ComputeContinuousMaskMode(AscendC::LocalTensor<T>& srcLocal,
                                                  AscendC::LocalTensor<U>& offsetLocal,
                                                  AscendC::LocalTensor<T>& dstLocal,
                                                  uint32_t calcSize)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(T);
    uint16_t repeatTimes = calcSize / oneRepSize;
    AscendC::Gather(dstLocal, srcLocal, offsetLocal, baseAddr, oneRepSize, repeatTimes, 8);
}

// 计算函数 - 逐比特Mask模式
template <typename T, typename U>
__aicore__ inline void ComputeBitwiseMaskMode(AscendC::LocalTensor<T>& srcLocal,
                                               AscendC::LocalTensor<U>& offsetLocal,
                                               AscendC::LocalTensor<T>& dstLocal,
                                               uint32_t calcSize)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(T);
    uint16_t repeatTimes = calcSize / oneRepSize;
    uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
    AscendC::Gather(dstLocal, srcLocal, offsetLocal, baseAddr, mask, repeatTimes, 8);
}

// 性能测试函数
template <typename T, typename U, Mode mode>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& srcLocal,
                                        AscendC::LocalTensor<U>& offsetLocal,
                                        AscendC::LocalTensor<T>& dstLocal,
                                        uint32_t calcSize)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeCountMode<T, U>(srcLocal, offsetLocal, dstLocal, calcSize);
    }
}

// 功能测试函数
template <typename T, typename U, Mode mode>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& srcGlobal,
                                          AscendC::GlobalTensor<U>& offsetGlobal,
                                          AscendC::GlobalTensor<T>& dstGlobal,
                                          AscendC::LocalTensor<T>& srcLocal,
                                          AscendC::LocalTensor<U>& offsetLocal,
                                          AscendC::LocalTensor<T>& dstLocal,
                                          uint32_t calcSize)
{
    // 场景1-3需要额外的src_base_addr空间
    uint32_t srcSize = (scenarioNum >= 1 && scenarioNum <= 3) ? (calcSize + 32) : calcSize;
    
    // 数据搬入 - src需要搬入完整数据
    AscendC::DataCopy(srcLocal, srcGlobal, srcSize);
    AscendC::DataCopy(offsetLocal, offsetGlobal, calcSize);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 初始化dstLocal为0
    AscendC::Duplicate(dstLocal, (T)0, dstSize);

    // 根据模式执行计算
    if constexpr (mode == Mode::USE_COUNT_MODE) {
        ComputeCountMode<T, U>(srcLocal, offsetLocal, dstLocal, calcSize);
    } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
        ComputeContinuousMaskMode<T, U>(srcLocal, offsetLocal, dstLocal, calcSize);
    } else {
        ComputeBitwiseMaskMode<T, U>(srcLocal, offsetLocal, dstLocal, calcSize);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 数据搬出
    AscendC::DataCopy(dstGlobal, dstLocal, calcSize);
}

// 核函数模板
template <typename T, typename U, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE>
__aicore__ inline void KernelGatherNew(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipe)
{
    // 定义GlobalTensor
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U> offsetGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)x);
    offsetGlobal.SetGlobalBuffer((__gm__ U*)y);
    dstGlobal.SetGlobalBuffer((__gm__ T*)z);

    // 设置静态Tensor起始地址（考虑256字节对齐）
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t offsetAddr = srcAddr + 64 * 1024;
    constexpr uint32_t dstAddr = offsetAddr + 64 * 1024;

    // 定义静态LocalTensor
    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, size);
    AscendC::LocalTensor<U> offsetLocal(AscendC::TPosition::VECCALC, offsetAddr, size);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, size);

    // 执行测试
    if constexpr (testPerformance) {
        TestPerformance<T, U, mode>(srcLocal, offsetLocal, dstLocal, calcSize);
    } else {
        TestFunctionality<T, U, mode>(srcGlobal, offsetGlobal, dstGlobal,
                                      srcLocal, offsetLocal, dstLocal, calcSize);
    }
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunGatherNewScenario(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    if constexpr (N == 1) {
        // half类型 Count模式
        RUN(half, uint32_t, false, Mode::USE_COUNT_MODE);
    } else if constexpr (N == 2) {
        // half类型 连续Mask模式
        RUN(half, uint32_t, false, Mode::USE_CONTINUOUS_MODE_OF_MASK);
    } else if constexpr (N == 3) {
        // half类型 逐比特Mask模式
        RUN(half, uint32_t, false, Mode::USE_BITWISE_MASK_MODE);
    } else if constexpr (N == 4) {
        // 大数据量测试 half 类型
        RUN(half, uint32_t, false, Mode::USE_COUNT_MODE);
    } else if constexpr (N == 5) {
        // 大数据量测试 float 类型
        RUN(float, uint32_t, false, Mode::USE_COUNT_MODE);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_gather_new(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    RunGatherNewScenario<scenarioNum>(x, y, z);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 使用外部配置的参数计算数据大小
    size_t xByteSize = 0;
    size_t yByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum >= 1 && scenarioNum <= 3) {
        // half类型的Count/Mask模式测试（带src_base_addr）
        xByteSize = (calcSize + 32) * sizeof(half);
        yByteSize = calcSize * sizeof(uint32_t);
        outputByteSize = calcSize * sizeof(half);
    } else if constexpr (scenarioNum == 4) {
        // 大数据量测试 half 类型
        xByteSize = calcSize * sizeof(half);
        yByteSize = calcSize * sizeof(uint32_t);
        outputByteSize = calcSize * sizeof(half);
    } else if constexpr (scenarioNum == 5) {
        // 大数据量测试 float 类型
        xByteSize = calcSize * sizeof(float);
        yByteSize = calcSize * sizeof(uint32_t);
        outputByteSize = calcSize * sizeof(float);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* xHost;
    uint8_t* yHost;
    uint8_t* outHost;
    uint8_t* xDevice;
    uint8_t* yDevice;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&yHost), yByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 读取输入数据
    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_y.bin", yByteSize, yHost, yByteSize);
    aclrtMemcpy(yDevice, yByteSize, yHost, yByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 执行核函数
    kernel_gather_new<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
