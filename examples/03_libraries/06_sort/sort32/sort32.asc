/* !
 * \file sort32.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"


class KernelSort32 {
public:
    __aicore__ inline KernelSort32() {}  // 构造函数
    
    // 初始化函数：设置全局内存指针和pipe
    __aicore__ inline void Init(__gm__ uint8_t* src0Gm, __gm__ uint8_t* src1Gm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;  // 传入的流水线指针
        srcGlobal0.SetGlobalBuffer((__gm__ float*)src0Gm);  // 设置第一个源全局缓冲区（浮点数）
        srcGlobal1.SetGlobalBuffer((__gm__ uint32_t*)src1Gm);  // 设置第二个源全局缓冲区（无符号整数）
        dstGlobal.SetGlobalBuffer((__gm__ float*)dstGm);  // 设置目标全局缓冲区

        repeat = srcDataSize / 32;  // 计算重复次数，每次处理32个元素
        pipe->InitBuffer(inQueueSrc0, 1, srcDataSize * sizeof(float));  // 初始化第一个输入队列缓冲区
        pipe->InitBuffer(inQueueSrc1, 1, srcDataSize * sizeof(uint32_t));  // 初始化第二个输入队列缓冲区
        pipe->InitBuffer(outQueueDst, 1, dstDataSize * sizeof(float));  // 初始化输出队列缓冲区
    }
    
    // 主处理流程
    __aicore__ inline void Process()
    {
        CopyIn();   // 数据搬入
        Compute();  // 计算处理
        CopyOut();  // 数据搬出
    }

private:
    // 数据搬运入函数
    __aicore__ inline void CopyIn()
    {
        // 搬运第一个输入数据（浮点数组）
        AscendC::LocalTensor<float> srcLocal0 = inQueueSrc0.AllocTensor<float>();  // 分配本地浮点张量
        AscendC::DataCopy(srcLocal0, srcGlobal0, srcDataSize);  // 从全局内存拷贝srcDataSize个浮点元素
        inQueueSrc0.EnQue(srcLocal0);  // 第一个输入数据入队
        
        // 搬运第二个输入数据（无符号整数数组）
        AscendC::LocalTensor<uint32_t> srcLocal1 = inQueueSrc1.AllocTensor<uint32_t>();  // 分配本地无符号整数张量
        AscendC::DataCopy(srcLocal1, srcGlobal1, srcDataSize);  // 从全局内存拷贝srcDataSize个无符号整数元素
        inQueueSrc1.EnQue(srcLocal1);  // 第二个输入数据入队
    }
    
    // 计算处理函数：执行32位排序操作
    __aicore__ inline void Compute()
    {
        // 从队列中取出输入数据
        AscendC::LocalTensor<float> srcLocal0 = inQueueSrc0.DeQue<float>();  // 取出第一个源张量
        AscendC::LocalTensor<uint32_t> srcLocal1 = inQueueSrc1.DeQue<uint32_t>();  // 取出第二个源张量
        AscendC::LocalTensor<float> dstLocal = outQueueDst.AllocTensor<float>();  // 分配目标张量

        // 执行32位排序操作
        // 参数说明：dstLocal-输出结果，srcLocal0-待排序的浮点数据，srcLocal1-排序索引，repeat-重复次数
        AscendC::Sort32<float>(dstLocal, srcLocal0, srcLocal1, repeat);

        outQueueDst.EnQue<float>(dstLocal);  // 排序结果入队
        inQueueSrc0.FreeTensor(srcLocal0);  // 释放第一个源张量
        inQueueSrc1.FreeTensor(srcLocal1);  // 释放第二个源张量
    }
    
    // 数据搬运出函数
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<float> dstLocal = outQueueDst.DeQue<float>();  // 从队列中取出排序结果
        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize);  // 从本地内存拷贝dstDataSize个浮点元素到全局内存
        outQueueDst.FreeTensor(dstLocal);  // 释放目标张量
    }

private:
    AscendC::TPipe* pipe;  // 流水线指针
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc0;  // 第一个输入队列
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc1;  // 第二个输入队列
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;  // 输出队列
    AscendC::GlobalTensor<float> srcGlobal0, dstGlobal;  // 第一个源和目标全局张量
    AscendC::GlobalTensor<uint32_t> srcGlobal1;  // 第二个源全局张量
    int srcDataSize = 128;  // 源数据大小：128个元素
    int dstDataSize = 256;  // 目标数据大小：256个元素
    int repeat = 0;  // 重复计算次数
};

// 核函数入口
__global__ __vector__ void sort32_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z) 
{
  AscendC::TPipe pipe;  // 创建流水线对象
  KernelSort32 op;  // 创建排序处理对象
  op.Init(x, y, z, &pipe);  // 初始化内核
  op.Process();  // 执行处理流程
}

// 主函数：负责主机端资源管理和任务调度
int32_t main(int32_t argc, char* argv[]) 
{
  // 配置参数
  uint32_t numBlocks = 1;  // 核函数块数
  size_t inputByteSize = 128 * sizeof(float);  // 输入数据大小：128个浮点数
  size_t outputByteSize = 256 * sizeof(float);  // 输出数据大小：256个浮点数

  // 设备初始化
  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);  // 设置设备
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);  // 创建流

  // 主机和设备内存指针声明
  uint8_t *xHost, *yHost, *zHost;  // 主机端内存指针
  uint8_t *xDevice, *yDevice, *zDevice;  // 设备端内存指针

  // 分配主机端内存
  aclrtMallocHost((void **)(&xHost), inputByteSize);
  aclrtMallocHost((void **)(&yHost), inputByteSize);
  aclrtMallocHost((void **)(&zHost), outputByteSize);
  
  // 分配设备端内存
  aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  // 从文件读取输入数据
  ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
  ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);

  // 数据传输：主机到设备
  aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);
  aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);

  // 启动核函数执行
  sort32_custom<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice);
  
  // 等待流同步
  aclrtSynchronizeStream(stream);

  // 数据传输：设备到主机
  aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  
  // 写入输出文件
  WriteFile("./output/output.bin", zHost, outputByteSize);

  // 释放内存资源
  aclrtFree(xDevice);
  aclrtFree(yDevice);
  aclrtFree(zDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(yHost);
  aclrtFreeHost(zHost);

  // 清理资源
  aclrtDestroyStream(stream);  // 销毁流
  aclrtResetDevice(deviceId);  // 重置设备
  aclFinalize();  // ACL库清理

  return 0;
}