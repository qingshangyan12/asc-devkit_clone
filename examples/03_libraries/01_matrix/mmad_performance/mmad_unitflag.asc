/* !
 * \file mmad_unitflag.asc
 * \brief
 */

#include <iostream>
#include <cstdlib>
#include <cstdint>
#include "acl/acl.h"
#include "acl/acl_base.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr static uint16_t LIMIT_MNSIZE = 10;

template <class T, class U>
class KernelMmad {
public:
    __aicore__ inline KernelMmad(uint16_t mSize, uint16_t nSize, uint16_t kSize, uint32_t repeat) {
        m = mSize;
        n = nSize;
        k = kSize;
        repeatTime = repeat;
        //左矩阵分形的shape
        fractalShape[0] = 16;
        fractalShape[1] = 32 / sizeof(T);
        //右矩阵的shape:[32 / sizeof(T), 16]
        //左、右矩阵分形的size，单位是元素数目
        fractalSize = 16 * fractalShape[1];
        if constexpr (sizeof(T) == 2) {
            fractalNum = 1;
        } else {
            fractalNum = 2;
        }
        if constexpr (IsSameType<T, int8_t>::value && IsSameType<U, int32_t>::value) {
            // L1上，A矩阵的对齐
            // GM上A矩阵的shape为[m,k]
            mAlignL1 = CeilAlign(m, fractalShape[0]); // 高度
            kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
            aSizeAlignL1 = mAlignL1 * kAlignL1;
            // L0上，A矩阵的对齐
            // 由于L0上a矩阵也是Z排布
            mAlignL0 = CeilAlign(m, fractalShape[0]); // 高度
            kAlignL0 = CeilAlign(k, fractalShape[1]); // 宽度
            aSizeAlignL0 = mAlignL0 * kAlignL0;

            // L1上，B矩阵的对齐
            // L1上, b矩阵是Z排布
            nAlignL1 = CeilAlign(n, fractalShape[0]); // 高度
            kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
            bSizeAlignL1 = nAlignL1 * kAlignL1;
            // L0上，B矩阵的对齐
            // L0上, b矩阵是N排布
            kAlignL0 = CeilAlign(k, fractalShape[1]); // 高度
            nAlignL0 = CeilAlign(n, fractalShape[0]); // 宽度
            bSizeAlignL0 = kAlignL0 * nAlignL0;

        } else if constexpr (IsSameType<T, half>::value && IsSameType<U, float>::value) {
            // L1上，A矩阵的对齐
            mAlignL1 = CeilAlign(m, fractalShape[0]); // 高度
            kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
            aSizeAlignL1 = mAlignL1 * kAlignL1;
            // L0上，A矩阵的对齐
            // 由于L0上a矩阵也是Z排布
            mAlignL0 = CeilAlign(m, fractalShape[0]); // 高度
            kAlignL0 = CeilAlign(k, fractalShape[1]); // 宽度
            aSizeAlignL0 = mAlignL0 * kAlignL0;

            // L1上，B矩阵的对齐
            // L1上, b矩阵是Z排布
            // GM上A矩阵的shape为[n,k]
            nAlignL1 = CeilAlign(n, fractalShape[0]); // 高度
            kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
            bSizeAlignL1 = nAlignL1 * kAlignL1;
            // L0上，B矩阵的对齐
            // L0上, b矩阵是N排布
            kAlignL0 = CeilAlign(k, fractalShape[1]); // 高度
            nAlignL0 = CeilAlign(n, fractalShape[0]); // 宽度
            bSizeAlignL0 = kAlignL0 * nAlignL0;
            
        } else if constexpr (IsSameType<T, float>::value && IsSameType<U, float>::value) {
            // L1上，A矩阵的对齐
            mAlignL1 = CeilAlign(m, fractalShape[0]); // 高度
            kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
            aSizeAlignL1 = mAlignL1 * kAlignL1;
            // L0上，A矩阵的对齐
            // 由于L0上a矩阵也是Z排布
            mAlignL0 = CeilAlign(m, fractalShape[0]); // 高度
            kAlignL0 = CeilAlign(k, fractalShape[1]); // 宽度
            aSizeAlignL0 = mAlignL0 * kAlignL0;
        
            // L1上，B矩阵的对齐
            // L1上, b矩阵是Z排布
            nAlignL1 = CeilAlign(n, fractalShape[0]); // 高度
            kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
            bSizeAlignL1 = nAlignL1 * kAlignL1;
            // L0上，B矩阵的对齐
            // L0上, b矩阵是N排布
            kAlignL0 = CeilAlign(k, fractalShape[1]); // 高度
            nAlignL0 = CeilAlign(n, fractalShape[0]); // 宽度
            bSizeAlignL0 = kAlignL0 * nAlignL0;
        }
        // C矩阵无视数据类型和a、b是否转置，m,n都向16对齐
        cSizeAlignL0 = CeilAlign(m, fractalShape[0]) * CeilAlign(n, fractalShape[0]);
    }

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR outTime, TPipe* pipeIn)
    {
        pipe = pipeIn;
        aGM.SetGlobalBuffer((__gm__ T *)a);
        bGM.SetGlobalBuffer((__gm__ T *)b);
        cGM.SetGlobalBuffer((__gm__ U *)c);
        timeGMAddr = (__gm__ uint64_t*)outTime;
        pipe->InitBuffer(inQueueA1, 1, aSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueA2, 1, aSizeAlignL0 * sizeof(T));
        pipe->InitBuffer(inQueueB1, 1, bSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueB2, 1, bSizeAlignL0 * sizeof(T));
        // pipe->InitBuffer(outQueueCO1, 1, cSizeAlignL0 * sizeof(U));
        pipe->InitBuffer(l0cBuf, cSizeAlignL0 * sizeof(U));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<U> c1Local = l0cBuf.Get<U>();
        for (uint32_t i = 0; i < repeatTime; i++) {
            Compute(i, c1Local);
        }
        CopyOut(c1Local);
    }

    __aicore__ inline void FlashTimeRecord()
    {
        GlobalTensor<uint64_t> gm;
        DataCacheCleanAndInvalid<uint64_t, CacheLine::ENTIRE_DATA_CACHE, DcciDst::CACHELINE_OUT>(gm);
    }

private:
    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator) 
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void Compute(uint32_t kIndex, AscendC::LocalTensor<U>& c1local)
    {
        LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();
        LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();

        MmadParams mmadParams;
        mmadParams.m = m;
        mmadParams.n = n;
        mmadParams.k = k;
        if (kIndex == 0) {
            mmadParams.cmatrixInitVal = true;
        } else {
            mmadParams.cmatrixInitVal = false;
        }
        // 使能该功能时，Mmad指令的unitFlag在最后1个分形设置为3、其余分形计算设置为2即可。
        if (kIndex != repeatTime - 1) {
            mmadParams.unitFlag = 2;
        } else {
            mmadParams.unitFlag = 3;
        }

        Mmad(c1local, a2Local, b2Local, mmadParams);

        if ((m / 16) * (n / 16) < LIMIT_MNSIZE) {
            AscendC::PipeBarrier<PIPE_M>();
        }
        inQueueA2.FreeTensor(a2Local);
        inQueueB2.FreeTensor(b2Local);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<U>& c1local)
    {
        FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = n;
        fixpipeParams.mSize = m;
        fixpipeParams.srcStride = CeilAlign(m, fractalShape[0]);
        fixpipeParams.dstStride = n;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        fixpipeParams.unitFlag = 3;

        Fixpipe(cGM, c1local, fixpipeParams);

        // unitFlag清空标志位，类型为bool。如果设为true,L0C中所有内存块的单元标志位都会设为0。
        // 旨在消除之前操作中unitFlag产生的多余影响，该操作属于可选项。
        // bool isUnitFlag = true;
        // AscendC::SetFixPipeConfig<float>(c1local, isUnitFlag);
    }

private:
    TPipe* pipe;
    TQue<TPosition::A1, 1> inQueueA1;
    TQue<TPosition::A2, 1> inQueueA2;
    TQue<TPosition::B1, 1> inQueueB1;
    TQue<TPosition::B2, 1> inQueueB2;
    // 注意，开启unitflag功能时，l0c上的tensor可通过Tbuf获取，不必用TQue
    AscendC::TBuf<AscendC::TPosition::CO1> l0cBuf; 
    GlobalTensor<T> aGM;
    GlobalTensor<T> bGM;
    GlobalTensor<U> cGM;
    __gm__ uint64_t* timeGMAddr;

    uint32_t repeatTime;
    uint16_t m = 0, k = 0, n = 0;
    uint16_t mAlignL1 = 0, kAlignL1 = 0, nAlignL1 = 0;
    uint16_t mAlignL0 = 0, kAlignL0 = 0, nAlignL0 = 0;
    uint16_t aSizeAlignL1, bSizeAlignL1;
    uint16_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0;
    uint16_t fractalShape[2] = {0, 0};
    uint16_t fractalSize = 0;
    uint16_t fractalNum = 0;
    uint64_t startCycle = 0;
    uint64_t endCycle = 0;
};

extern "C" __cube__ __global__ void mmad_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR outTime, uint16_t m, uint16_t n, uint16_t k, uint32_t scenarioNum, uint32_t repeatTime)
{
    TPipe pipe;

    if (scenarioNum == 1) {
        KernelMmad<int8_t, int32_t> op(m, n, k, repeatTime);
        op.Init(a, b, c, outTime, &pipe);
        op.Process();
        op.FlashTimeRecord(); 
    } else if (scenarioNum == 2) {
        KernelMmad<half, float> op(m, n, k, repeatTime);
        op.Init(a, b, c, outTime, &pipe);
        op.Process();
        op.FlashTimeRecord();
    } else if (scenarioNum == 3) {
        KernelMmad<float, float> op(m, n, k, repeatTime);
        op.Init(a, b, c, outTime, &pipe);
        op.Process();
        op.FlashTimeRecord();
    }
    pipe_barrier(PIPE_ALL);
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t REPEAT_TIME = 1000;

    if (argc != 5) {
        std::cerr << "Usage: " << argv[0] << " <scenarioNum> <M> <N> <K>" << std::endl;
        std::cerr << "Example: " << argv[0] << " 6 64 32 128" << std::endl;
        return 1;
    }

    int32_t scenarioNum = 0;
    int32_t M = 0;
    int32_t N = 0;
    int32_t K = 0;

    try {
        scenarioNum = std::atoi(argv[1]);
        M = std::atoi(argv[2]);
        N = std::atoi(argv[3]);
        K = std::atoi(argv[4]);

        if (scenarioNum <= 0 || M <= 0 || N <= 0 || K <= 0) {
            throw std::invalid_argument("参数必须为正整数");
        }
    } catch (const std::exception& e) {
        std::cerr << "fail: " << e.what() << std::endl;
        return 1;
    }
    
    size_t aFileSize = 0;
    size_t bFileSize = 0;
    size_t cFileSize = 0;

    if (scenarioNum <= 4) {
        aFileSize = M * K * sizeof(int8_t);
        bFileSize = K * N * sizeof(int8_t);
        cFileSize = M * N * sizeof(int32_t);
    } else if (scenarioNum <= 8) {
        aFileSize = M * K * sizeof(aclFloat16);
        bFileSize = K * N * sizeof(aclFloat16);
        cFileSize = M * N * sizeof(float);
    } else {
        aFileSize = M * K * sizeof(float);
        bFileSize = K * N * sizeof(float);
        cFileSize = M * N * sizeof(float);
    }
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aDevice;
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t *bDevice;
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t *cDevice;
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t *timeHost;
    uint8_t *timeDevice;
    size_t timeSize = REPEAT_TIME * sizeof(uint64_t);
    aclrtMallocHost((void **)(&timeHost), timeSize);
    aclrtMalloc((void **)&timeDevice, timeSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_custom<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, timeDevice, M, N, K, scenarioNum, REPEAT_TIME);
    aclrtSynchronizeStream(stream);
    mmad_custom<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, timeDevice, M, N, K, scenarioNum, REPEAT_TIME);
    aclrtSynchronizeStream(stream);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFree(timeDevice);
    aclrtFreeHost(timeHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}