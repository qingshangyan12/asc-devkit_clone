/* !
 * \file datacopy_gm2l1_nd2nz.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <typename T>
class KernelDataCopyGm2L1Nd2Nz{
public:
    __aicore__ inline KernelDataCopyGm2L1Nd2Nz()
    {
        //左矩阵分形的shape
        fractalShape[0] = 16;
        fractalShape[1] = 32 / sizeof(T);
    }
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        
        // 根据scenarioNum设置不同的ND2NZ参数
        if constexpr (scenarioNum == 1 || scenarioNum == 2 || scenarioNum == 3) {
            // 32x32矩阵
            intriParams.ndNum = 1;
            intriParams.nValue = 32;
            intriParams.dValue = 32; // dValue对齐到32B
            intriParams.srcNdMatrixStride = 0;
            intriParams.srcDValue = 32;
            intriParams.dstNzC0Stride = 32; 
            intriParams.dstNzNStride = 1;
            intriParams.dstNzMatrixStride = 0;
        } else if constexpr (scenarioNum == 4 || scenarioNum == 5 || scenarioNum == 6) {
            // 32x30矩阵
            intriParams.ndNum = 2; // 2个nd矩阵
            intriParams.nValue = 16;
            intriParams.dValue = 30; // dValue未对齐到32B
            intriParams.srcNdMatrixStride = 32 * 16; // 2个nd矩阵，偏移为nValue * srcDValue，待搬运数据连续。
            intriParams.srcDValue = 32;
            intriParams.dstNzC0Stride = 32;
            intriParams.dstNzNStride = 1;
            intriParams.dstNzMatrixStride = 16 * fractalShape[1]; // 2个nd矩阵，偏移为偏移为nValue * fractalShape[1]，即连续搬搬运。
        }
        

        srcGlobal.SetGlobalBuffer((__gm__ T *)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ T *)dstGm);
        // NZ格式需要列方向按fractalShape[1]对齐
        alignedD = CeilAlign(intriParams.dValue, fractalShape[1]);
        pipe->InitBuffer(inQueueA1, 1, intriParams.ndNum * intriParams.nValue * alignedD * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        // GM -> L1 (ND2NZ)
        AscendC::LocalTensor<T> srcLocal = inQueueA1.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, intriParams);
        
        // 同步，未插同步会有精度问题。
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

        // L1 -> GM (NZ2NZ)
        AscendC::DataCopy(dstGlobal, srcLocal, intriParams.ndNum * intriParams.nValue * alignedD);
        
        inQueueA1.FreeTensor(srcLocal);
    }

private:
    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator) 
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueA1;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    AscendC::Nd2NzParams intriParams;

    uint16_t fractalShape[2] = {0, 0};
    uint16_t alignedD = 0;
};

__global__ __cube__ void datacopy_gm2l1_nd2nz_custom(GM_ADDR srcGm, GM_ADDR dstGm) 
{
    AscendC::TPipe pipe;
    if constexpr (scenarioNum == 1 || scenarioNum == 4) {
        // scenarioNum=1和4使用half类型
        KernelDataCopyGm2L1Nd2Nz<half> op;
        op.Init(srcGm, dstGm, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 2 || scenarioNum == 5) {
        // scenarioNum=2和5使用float类型
        KernelDataCopyGm2L1Nd2Nz<float> op;
        op.Init(srcGm, dstGm, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 3 || scenarioNum == 6) {
        // scenarioNum=3和6使用int8_t类型
        KernelDataCopyGm2L1Nd2Nz<int8_t> op;
        op.Init(srcGm, dstGm, &pipe);
        op.Process();
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    size_t aFileSize = 0;
    size_t bFileSize = 0;
    
    if constexpr (scenarioNum == 1 || scenarioNum == 4) {
        // scenarioNum=1和4使用half类型
        aFileSize = 32 * 32 * sizeof(half);
        bFileSize = 32 * 32 * sizeof(half);
    } else if constexpr (scenarioNum == 2 || scenarioNum == 5) {
        // scenarioNum=2和5使用float类型
        aFileSize = 32 * 32 * sizeof(float);
        bFileSize = 32 * 32 * sizeof(float);
    } else if constexpr (scenarioNum == 3 || scenarioNum == 6) {
        // scenarioNum=3和6使用int8_t类型
        aFileSize = 32 * 32 * sizeof(int8_t);
        bFileSize = 32 * 32 * sizeof(int8_t);
    }
    
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *srcHost;
    uint8_t *srcDevice;
    aclrtMallocHost((void **)(&srcHost), aFileSize);
    aclrtMalloc((void **)&srcDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", aFileSize, srcHost, aFileSize);
    aclrtMemcpy(srcDevice, aFileSize, srcHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *dstHost;
    uint8_t *dstDevice;
    aclrtMallocHost((void **)(&dstHost), bFileSize);
    aclrtMalloc((void **)&dstDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    datacopy_gm2l1_nd2nz_custom<<<numBlocks, nullptr, stream>>>(srcDevice, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, bFileSize, dstDevice, bFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, bFileSize);

    aclrtFree(srcDevice);
    aclrtFreeHost(srcHost);
    aclrtFree(dstDevice);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
