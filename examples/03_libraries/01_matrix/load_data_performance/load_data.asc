#include <iostream>
#include <cstdlib>
#include <cstdint>
#include "acl/acl.h"
#include "acl/acl_base.h"  // 昇腾CANN内置的 float16 类型定义
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t repeatTime = 1;

#define NOT_SUPPORT AscendC::printf("not support!\n")

// 1. 定义枚举类型（对应不同的scenarioNum场景）
enum TestScenario {
    MIN_SCENARIO = 0,
    GM_TO_L1_STRIDE_I_CONTINUE_O = 1,
    GM_TO_L1_CONTINUE_I_CONTINUE_O = 2,
    GM_TO_L1_STRIDE_I_STRIDE_O = 3,
    GM_TO_L1_CONTINUE_I_STRIDE_O = 4,

    GM_TO_L0A = 5,
    GM_TO_L0B = 6,

    L1_TO_L0A = 7,
    L1_TO_L0A_TRANSPOSE = 8,
    L1_TO_L0B = 9,
    L1_TO_L0B_TRANSPOSE = 10,

    MAX_SCENARIO = 99,
};

template <typename T, typename U>
class Kernel {
public:
    __aicore__ inline Kernel(uint16_t mSize, uint16_t nSize, uint16_t kSize, uint32_t scenario, uint32_t repeat)
    {
        m = mSize;
        n = nSize;
        k = kSize;
        scenarioNum = scenario;
        repeatTime = repeat;
        fractalShape[0] = 16;
        fractalShape[1] = 32 / sizeof(T);
        fractalSize = fractalShape[0] * fractalShape[1];
        fractalNum = sizeof(T) == 2 ? 1 : 2;
    }

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR outTime, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        aGM.SetGlobalBuffer((__gm__ T*)a);
        bGM.SetGlobalBuffer((__gm__ T*)b);
        cGM.SetGlobalBuffer((__gm__ U*)c);
        pipe->InitBuffer(inQueueA1, 1, m * k * sizeof(T));
        pipe->InitBuffer(inQueueA2, 1, m * k * sizeof(T));
        pipe->InitBuffer(inQueueB1, 1, k * n * sizeof(T));
        pipe->InitBuffer(inQueueB2, 1, k * n * sizeof(T));
        pipe->InitBuffer(outQueueCO1, 1, m * n * sizeof(U));
    }

    __aicore__ inline void Process()
    {
        switch (scenarioNum) {
            case GM_TO_L1_CONTINUE_I_CONTINUE_O:
                LoadAContinue();
                LoadBContinue();
                break;

            case GM_TO_L1_STRIDE_I_STRIDE_O:
                LoadA();
                LoadB();
                break;
            case GM_TO_L0A:
                LoadGM2L0A();
                break;
            
            case GM_TO_L0B:
                LoadGM2L0B();
                break;
            
            case L1_TO_L0A:
                SplitA();
                break;
            
            case L1_TO_L0A_TRANSPOSE:
                SplitATranspose();
                break;
            
            case L1_TO_L0B:
                SplitB();
                break;
            
            case L1_TO_L0B_TRANSPOSE:
                SplitBTranspose();
                break;
            
            case MAX_SCENARIO:
            default:
                NOT_SUPPORT;
                break;
        }
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }
    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    // ===================================== GM->L1 =======================================
    /**
        GM：为NZ数据排布
        调用Load2D指令完成GM->L1的Nz2Nz搬运
            源地址 跳读，目的地址 跳写
     */
    __aicore__ inline void LoadA()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.AllocTensor<T>();
        uint32_t dstOffset = fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = CeilDivision(m, fractalShape[0]);
        loadDataParams.dstGap = CeilDivision(m, fractalShape[0]) - 1;
        for (uint16_t i = 0; i < CeilDivision(m, fractalShape[0]); ++i) {
            AscendC::LoadData(a1Local[i * dstOffset], aGM[i * srcOffset], loadDataParams);
        }
        inQueueA1.FreeTensor(a1Local);
    }
    __aicore__ inline void LoadB()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.AllocTensor<T>();
        uint32_t dstOffset = fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(n, fractalShape[0]);
        loadDataParams.srcStride = CeilDivision(k, fractalShape[1]);
        loadDataParams.dstGap = CeilDivision(k, fractalShape[1]) - 1;
        for (uint16_t i = 0; i < CeilDivision(k, fractalShape[1]); ++i) {
            AscendC::LoadData(b1Local[i * dstOffset], bGM[i * srcOffset], loadDataParams);
        }
        inQueueB1.FreeTensor(b1Local);
    }
    /**
        GM：为NZ数据排布
        调用Load2D指令完成GM->L1的Nz2Nz搬运
            源地址 连读，目的地址 连写
     */
    __aicore__ inline void LoadAContinue()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.AllocTensor<T>();
        uint32_t dstOffset = fractalSize * CeilDivision(m, fractalShape[0]);
        uint32_t srcOffset = fractalSize * CeilDivision(m, fractalShape[0]);
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(m, fractalShape[0]);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        for (uint16_t i = 0; i < CeilDivision(k, fractalShape[1]); ++i) {
            AscendC::LoadData(a1Local[i * dstOffset], aGM[i * srcOffset], loadDataParams);
        }
        inQueueA1.FreeTensor(a1Local);
    }
    __aicore__ inline void LoadBContinue()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.AllocTensor<T>();
        uint32_t dstOffset = fractalSize * CeilDivision(k, fractalShape[1]);
        uint32_t srcOffset = fractalSize * CeilDivision(k, fractalShape[1]);
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        for (uint16_t i = 0; i < CeilDivision(n, fractalShape[0]); ++i) {
            AscendC::LoadData(b1Local[i * dstOffset], bGM[i * srcOffset], loadDataParams);
        }
        inQueueB1.FreeTensor(b1Local);
    }
    // todo: 如果非连续读写影响大，可以补充以下：
    /**
        GM：为ZZ数据排布
        调用Load2D指令完成GM->L1的ZZ2Nz搬运
            源地址 跳读，目的地址 连写
     */
    /**
        GM：为ZZ数据排布
        调用Load2D指令完成GM->L1的ZZ2Nz搬运
            源地址 连读，目的地址 跳写
     */

    // ===================================== GM->L0A =======================================
    /**
        GM：为NZ数据排布
        调用Load2D指令完成GM->L0A的Nz2Zz搬运
            源地址 跳读，目的地址 连写
     */
    __aicore__ inline void LoadGM2L0A()
    {
        AscendC::LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();
        uint32_t dstOffset = CeilDivision(k, fractalShape[1]) * fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = CeilDivision(m, fractalShape[0]);
        loadDataParams.dstGap = 0;
        for (uint16_t i = 0; i < CeilDivision(m, fractalShape[0]); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], aGM[i * srcOffset], loadDataParams);
        }
        inQueueA2.FreeTensor(a2Local);
    }

    // ===================================== GM->L0B =======================================
    /**
        GM：为ZN数据排布
        调用Load2D指令完成GM->L0B的ZN2ZN搬运
            源地址 连读，目的地址 连写
     */
    __aicore__ inline void LoadGM2L0B()
    {
        AscendC::LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();
        uint32_t dstOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        uint32_t srcOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(n, fractalShape[0]);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        for (uint16_t i = 0; i < CeilDivision(k, fractalShape[1]); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], bGM[i * srcOffset], loadDataParams);
        }
        inQueueB2.FreeTensor(b2Local);
    }

    // ===================================== L1->LOA =======================================
    /**
        L1A：为Nz数据排布
        调用Load2D指令完成L1A->L0A的Nz2Zz搬运
            源地址 跳读，目的地址 连写
     */
    __aicore__ inline void SplitA()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.AllocTensor<T>();
        AscendC::LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();

        uint32_t dstOffset = CeilDivision(k, fractalShape[1]) * fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = CeilDivision(m, fractalShape[0]);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        for (uint16_t i = 0; i < CeilDivision(m, fractalShape[0]); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }
        inQueueA1.FreeTensor(a1Local);
        inQueueA2.FreeTensor(a2Local);
    }
    /**
        L1A：为Nz数据排布
        调用Load2D指令完成L1A->L0A的Nz2Zz搬运
            源地址 连读，目的地址 跳写
     */

    /**
        L1A：为Nz数据排布
        调用Load2D指令完成L1A->L0A的Nz2Zz搬运，且整体转置
            相当于L1A->L0A的Nz2NN搬运,不转置；分型内的转换通过设置ifTranspose做到，分型外无变化；
            源地址 连读，目的地址 连写
        注意：只有B16能调用这个函数，此时为方形，才能使能转置
     */
    __aicore__ inline void SplitATranspose()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.AllocTensor<T>();
        AscendC::LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();

        uint32_t dstOffset = CeilDivision(k, fractalShape[0]) * fractalSize;
        uint32_t srcOffset = CeilDivision(k, fractalShape[0]) * fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, fractalShape[0]);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = true;
        for (uint16_t i = 0; i < CeilDivision(m, fractalShape[1]); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }

        inQueueA1.FreeTensor(a1Local);
        inQueueA2.FreeTensor(a2Local);
    }

    // ===================================== L1->LOB =======================================
    /**
        L1B：[N,k] Nz排布 -> LOB：[k,N] Zn排布
            源地址 连读，目的地址 连写
     */
    __aicore__ inline void SplitB()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.AllocTensor<T>();
        AscendC::LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();
        uint32_t dstOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        uint32_t srcOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(n, fractalShape[0]);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        for (uint16_t i = 0; i < CeilDivision(k, fractalShape[1]); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], b1Local[i * srcOffset], loadDataParams);
        }
        inQueueB1.FreeTensor(b1Local);
        inQueueB2.FreeTensor(b2Local);
    }

    /**
        L1B：[k,N] Nz排布 -> LOB：[k,N] Zn排布
            源地址 跳读，目的地址 连写
        注意：只有B16能调用这个函数，此时为方形，才能使能转置
     */
    __aicore__ inline void SplitBTranspose()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.AllocTensor<T>();
        AscendC::LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();

        uint32_t dstOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(n, fractalShape[0]);
        loadDataParams.srcStride = CeilDivision(k, fractalShape[1]);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = true;
        for (uint16_t i = 0; i < CeilDivision(k, fractalShape[1]); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], b1Local[i * srcOffset], loadDataParams);
        }

        inQueueB1.FreeTensor(b1Local);
        inQueueB2.FreeTensor(b2Local);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> a2Local = inQueueA2.AllocTensor<T>();
        AscendC::LocalTensor<T> b2Local = inQueueB2.AllocTensor<T>();
        AscendC::LocalTensor<U> c1Local = outQueueCO1.AllocTensor<U>();
        AscendC::MmadParams mmadParams;
        mmadParams.m = m;
        mmadParams.n = n;
        mmadParams.k = k;
        AscendC::Mmad(c1Local, a2Local, b2Local, mmadParams);
        inQueueA2.FreeTensor(a2Local);
        inQueueB2.FreeTensor(b2Local);
        outQueueCO1.FreeTensor(c1Local);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> c1Local = outQueueCO1.AllocTensor<U>();
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = n;
        fixpipeParams.mSize = m;
        fixpipeParams.srcStride = CeilAlign(m, fractalShape[0]);
        fixpipeParams.dstStride = n;
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        AscendC::Fixpipe(cGM, c1Local, fixpipeParams);
        outQueueCO1.FreeTensor(c1Local);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueA1;
    AscendC::TQue<AscendC::TPosition::A2, 1> inQueueA2;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueB1;
    AscendC::TQue<AscendC::TPosition::B2, 1> inQueueB2;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQueueCO1;
    AscendC::GlobalTensor<T> aGM, bGM;
    AscendC::GlobalTensor<U> cGM;
    uint16_t m, n, k;
    uint16_t aSize, bSize, cSize;
    uint16_t fractalShape[2] = {0, 0};
    uint16_t fractalSize = 0;
    uint16_t fractalNum = 0;

    uint32_t scenarioNum = 0;
    uint32_t repeatTime = 0;
};

extern "C" __global__ __aicore__ void load_data(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR outTime,  uint16_t m, uint16_t n, uint16_t k, uint32_t scenarioNum, uint32_t repeatTime)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;

    Kernel<half, float> op(m, n, k, scenarioNum, repeatTime);
    op.Init(a, b, c, outTime, &pipe);
    op.Process();

    pipe_barrier(PIPE_ALL);
}

int32_t main(int32_t argc, char *argv[])
{
    if (argc != 5) {
        std::cerr << "Usage: " << argv[0] << " <scenarioNum> <M> <N> <K>" << std::endl;
        std::cerr << "Example: " << argv[0] << " 6 64 32 128" << std::endl;
        return 1;
    }

    int32_t scenarioNum = 0;
    int32_t M = 0;
    int32_t N = 0;
    int32_t K = 0;

    try {
        scenarioNum = std::atoi(argv[1]);
        M = std::atoi(argv[2]);
        N = std::atoi(argv[3]);
        K = std::atoi(argv[4]);

        if (scenarioNum <= 0 || M <= 0 || N <= 0 || K <= 0) {
            throw std::invalid_argument("参数必须为正整数");
        }
    } catch (const std::exception& e) {
        std::cerr << "fail: " << e.what() << std::endl;
        return 1;
    }
    
    size_t aFileSize = 0;
    size_t bFileSize = 0;
    size_t cFileSize = 0;

    if (scenarioNum <= 4) {
        aFileSize = M * K * sizeof(int8_t);
        bFileSize = K * N * sizeof(int8_t);
        cFileSize = M * N * sizeof(int32_t);
    } else if (scenarioNum <= 8) {
        aFileSize = M * K * sizeof(aclFloat16);
        bFileSize = K * N * sizeof(aclFloat16);
        cFileSize = M * N * sizeof(float);
    } else {
        aFileSize = M * K * sizeof(float);
        bFileSize = K * N * sizeof(float);
        cFileSize = M * N * sizeof(float);
    }
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aDevice;
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t *bDevice;
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t *cDevice;
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint64_t *timeHost;
    uint64_t *timeDevice;
    size_t timeSize = repeatTime * sizeof(uint64_t);
    aclrtMallocHost((void **)(&timeHost), timeSize);
    aclrtMalloc((void **)&timeDevice, timeSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 执行
    load_data<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, (uint8_t *)timeDevice, M, N, K, scenarioNum, repeatTime);
    aclrtSynchronizeStream(stream);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFree(timeDevice);
    aclrtFreeHost(timeHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}