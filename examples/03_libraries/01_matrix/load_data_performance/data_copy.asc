#include <iostream>
#include <cstdlib>
#include <cstdint>
#include "acl/acl.h"
#include "acl/acl_base.h"  // 昇腾CANN内置的 float16 类型定义
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t repeatTime = 1;

#define NOT_SUPPORT AscendC::printf("not support!\n")

// DataCopy ND2NZ
template <class T>
class KernelMmad {
public:
    __aicore__ inline KernelMmad(uint16_t mSize, uint16_t nSize, uint16_t kSize)
    {
        m = mSize;
        n = nSize;
        k = kSize;
        //左矩阵分形的shape
        fractalShape[0] = 16;
        fractalShape[1] = 32 / sizeof(T);
        //右矩阵的shape:[32 / sizeof(T), 16]
        //左、右矩阵分形的size，单位是元素数目
        fractalSize = 16 * fractalShape[1];
        
        // L1上，A矩阵的对齐
        // GM上A矩阵的shape为[m,k]
        mAlignL1 = CeilAlign(m, fractalShape[0]); // 高度
        kAlignL1 = CeilAlign(k, fractalShape[1]); // 宽度
        aSizeAlignL1 = mAlignL1 * kAlignL1;

        mAlignL0 = CeilAlign(m, fractalShape[0]); // 高度
        kAlignL0 = CeilAlign(k, fractalShape[1]); // 宽度
        aSizeAlignL0 = mAlignL0 * kAlignL0;

        // GM上B矩阵的shape为[k,n]
        kAlignL1 = CeilAlign(k, fractalShape[1]); // 高度
        nAlignL1 = CeilAlign(n, fractalShape[0]); // 宽度
        bSizeAlignL1 = kAlignL1 * nAlignL1;

        kAlignL0 = CeilAlign(k, fractalShape[1]); // 高度
        nAlignL0 = CeilAlign(n, fractalShape[0]); // 宽度
        bSizeAlignL0 = kAlignL0 * nAlignL0;

        // C矩阵无视数据类型和a、b是否转置，m,n都向16对齐
        cSizeAlignL0 = CeilAlign(m, fractalShape[0]) * CeilAlign(n, fractalShape[0]);
    }

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c,  AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        aGM.SetGlobalBuffer((__gm__ T *)a);
        bGM.SetGlobalBuffer((__gm__ T *)b);
        pipe->InitBuffer(inQueueA1, 1, aSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueA2, 1, aSizeAlignL0 * sizeof(T));
        pipe->InitBuffer(inQueueB1, 1, bSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueB2, 1, bSizeAlignL0 * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyGmToL1A();
        CopyGmToL1B();
    }

private:
    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator) 
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void CopyGmToL1A()
    {
        AscendC::LocalTensor<T> a1Local = inQueueA1.AllocTensor<T>();
        // GM-->L1,搬运A矩阵
        AscendC::Nd2NzParams nd2nzA1Params;
        // 传输ND矩阵的数目
        nd2nzA1Params.ndNum = 1;
        // ND矩阵的行数
        nd2nzA1Params.nValue = m;
        // ND矩阵的列数
        nd2nzA1Params.dValue = k;
        // 只传输了1个ND矩阵，该参数无效
        nd2nzA1Params.srcNdMatrixStride = 0;
        // 源操作数同一ND矩阵的相邻行起始地址间的偏移
        nd2nzA1Params.srcDValue = k;

        // 以下这个参数取A矩阵在L1上，高度方向的对齐后的长度
        // 由于A不转置，因此对于三种数据类型该参数均相同
        nd2nzA1Params.dstNzC0Stride = CeilAlign(m, fractalShape[0]);

        nd2nzA1Params.dstNzNStride = 1;
        nd2nzA1Params.dstNzMatrixStride = 0;

        AscendC::DataCopy(a1Local, aGM, nd2nzA1Params);
        inQueueA1.EnQue(a1Local);
    }

    __aicore__ inline void CopyGmToL1B()
    {
        AscendC::LocalTensor<T> b1Local = inQueueB1.AllocTensor<T>();
        // GM-->L1,搬运B矩阵
        AscendC::Nd2NzParams nd2nzB1Params;
        nd2nzB1Params.ndNum = 1;
        nd2nzB1Params.nValue = k;
        nd2nzB1Params.dValue = n;
        nd2nzB1Params.srcNdMatrixStride = 0;
        nd2nzB1Params.srcDValue = n;

        nd2nzB1Params.dstNzC0Stride = CeilAlign(k, fractalShape[0]);
        nd2nzB1Params.dstNzNStride = 1;
        nd2nzB1Params.dstNzMatrixStride = 0;

        AscendC::DataCopy(b1Local, bGM, nd2nzB1Params);
        inQueueB1.EnQue(b1Local);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueA1;
    AscendC::TQue<AscendC::TPosition::A2, 1> inQueueA2;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueB1;
    AscendC::TQue<AscendC::TPosition::B2, 1> inQueueB2;

    AscendC::GlobalTensor<T> aGM;
    AscendC::GlobalTensor<T> bGM;

    uint16_t m = 0, n = 0, k = 0;

    uint16_t mAlignL1 = 0, kAlignL1 = 0, nAlignL1 = 0;
    uint16_t mAlignL0 = 0, kAlignL0 = 0, nAlignL0 = 0;

    uint16_t aSizeAlignL1, bSizeAlignL1;
    uint16_t aSizeAlignL0, bSizeAlignL0, cSizeAlignL0;
    uint16_t fractalShape[2] = {0, 0};
    uint16_t fractalSize = 0;
};

// DataCopy 如果在GM上已经排布好了，直接连续搬运即可
template <typename T>
class KernelDataCopy {
public:
    __aicore__ inline KernelDataCopy(uint16_t mSize, uint16_t nSize, uint16_t kSize)
    {
        m = mSize;
        n = nSize;
        k = kSize;
        aSizeAlignL1 = m * k;
        bSizeAlignL1 = k * n;
    }

    __aicore__ inline void Init(__gm__ uint8_t* src0Gm, __gm__ uint8_t* src1Gm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        src0Global.SetGlobalBuffer((__gm__ T*)src0Gm);
        src1Global.SetGlobalBuffer((__gm__ T*)src1Gm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        pipe->InitBuffer(inQueueSrc0, 1, aSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueSrc1, 1, bSizeAlignL1 * sizeof(T));
    }

    __aicore__ inline void Process() {
        CopyIn();
    }

private:
    // 改造：所有固定512的地方替换为dataSize_
    __aicore__ inline void CopyIn() {
        AscendC::LocalTensor<T> src0Local = inQueueSrc0.AllocTensor<T>();
        AscendC::LocalTensor<T> src1Local = inQueueSrc1.AllocTensor<T>();
        // 动态数据拷贝
        AscendC::DataCopy(src0Local, src0Global, aSizeAlignL1);
        AscendC::DataCopy(src1Local, src1Global, bSizeAlignL1);

        inQueueSrc0.EnQue(src0Local);
        inQueueSrc1.EnQue(src1Local);
    }

private:
    AscendC::TPipe* pipe;

    uint16_t m = 0, n = 0, k = 0;
    uint16_t aSizeAlignL1, bSizeAlignL1;

    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueSrc0;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueSrc1;

    AscendC::GlobalTensor<T> src0Global, src1Global, dstGlobal;
};

// DataCopy 如果在GM上已经排布好了，直接搬运即可，可以跳读跳写
template <typename T>
class KernelDataCopyRepeatContinue {
public:
    __aicore__ inline KernelDataCopyRepeatContinue(uint16_t mSize, uint16_t nSize, uint16_t kSize)
    {
        m = mSize;
        n = nSize;
        k = kSize;
        aSizeAlignL1 = m * k;
        bSizeAlignL1 = k * n;
    }

    __aicore__ inline void Init(__gm__ uint8_t* src0Gm, __gm__ uint8_t* src1Gm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn) {
        pipe = pipeIn;

        src0Global.SetGlobalBuffer((__gm__ T*)src0Gm);
        src1Global.SetGlobalBuffer((__gm__ T*)src1Gm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        pipe->InitBuffer(inQueueSrc0, 1, aSizeAlignL1 * sizeof(T));
        pipe->InitBuffer(inQueueSrc1, 1, bSizeAlignL1 * sizeof(T));
    }

    __aicore__ inline void Process() {
        CopyIn();
    }

private:
    __aicore__ inline void CopyIn() {
        AscendC::LocalTensor<T> src0Local = inQueueSrc0.AllocTensor<T>();
        AscendC::LocalTensor<T> src1Local = inQueueSrc1.AllocTensor<T>();

        DataCopyParams copyParams;
        copyParams.blockCount = 1;       // 搬运1个连续数据块
        copyParams.blockLen = aSizeAlignL1 * sizeof(T) / 32;   // 32B 
        copyParams.srcStride = 0;        // 源地址连续，步长为0
        copyParams.dstStride = 0;        // 目的地址连续，步长为0
        AscendC::DataCopy(src0Local, src0Global, copyParams);

        DataCopyParams copyParamsB;
        copyParamsB.blockCount = 1;       // 搬运1个连续数据块
        copyParamsB.blockLen = bSizeAlignL1 * sizeof(T) / 32;   // 32B 
        copyParamsB.srcStride = 0;        // 源地址连续，步长为0
        copyParamsB.dstStride = 0;        // 目的地址连续，步长为0
        AscendC::DataCopy(src1Local, src1Global, copyParamsB);

        inQueueSrc0.EnQue(src0Local);
        inQueueSrc1.EnQue(src1Local);
    }

private:
    AscendC::TPipe* pipe;
    uint16_t m = 0, n = 0, k = 0;
    uint16_t aSizeAlignL1, bSizeAlignL1;

    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueSrc0;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueSrc1;

    AscendC::GlobalTensor<T> src0Global, src1Global, dstGlobal;
};


extern "C" __global__ __aicore__ void mmad_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR outTime, uint16_t m, uint16_t n, uint16_t k, uint32_t scenarioNum, uint32_t repeatTime)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe pipe;
    switch (scenarioNum) {
        case 1: {
            KernelMmad<int8_t> op(m, n, k);
            op.Init(a, b, c, &pipe);
            op.Process();
            break;
        }
        case 2: {
            KernelMmad<half> op(m, n, k);
            op.Init(a, b, c, &pipe);
            op.Process();
            break;
        }
        case 3: {
            KernelMmad<float> op(m, n, k);
            op.Init(a, b, c, &pipe);
            op.Process();   
            break;
        }
        case 4: {
            KernelDataCopy<half> op(m, n, k);
            op.Init(a, b, c, &pipe);
            op.Process();
            break;
        }
        case 5: {
            KernelDataCopyRepeatContinue<half> op(m, n, k);
            op.Init(a, b, c, &pipe);
            op.Process();
            break;
        }
    }
    pipe_barrier(PIPE_ALL);
}

int32_t main(int32_t argc, char *argv[])
{
    if (argc != 5) {
        std::cerr << "Usage: " << argv[0] << " <scenarioNum> <M> <N> <K>" << std::endl;
        std::cerr << "Example: " << argv[0] << " 6 64 32 128" << std::endl;
        return 1;
    }

    int32_t scenarioNum = 0;
    int32_t M = 0;
    int32_t N = 0;
    int32_t K = 0;

    try {
        scenarioNum = std::atoi(argv[1]);
        M = std::atoi(argv[2]);
        N = std::atoi(argv[3]);
        K = std::atoi(argv[4]);

        if (scenarioNum <= 0 || M <= 0 || N <= 0 || K <= 0) {
            throw std::invalid_argument("参数必须为正整数");
        }
    } catch (const std::exception& e) {
        std::cerr << "fail: " << e.what() << std::endl;
        return 1;
    }
    
    size_t aFileSize = 0;
    size_t bFileSize = 0;
    size_t cFileSize = 0;

    if (scenarioNum <= 4) {
        aFileSize = M * K * sizeof(int8_t);
        bFileSize = K * N * sizeof(int8_t);
        cFileSize = M * N * sizeof(int32_t);
    } else if (scenarioNum <= 8) {
        aFileSize = M * K * sizeof(aclFloat16);
        bFileSize = K * N * sizeof(aclFloat16);
        cFileSize = M * N * sizeof(float);
    } else {
        aFileSize = M * K * sizeof(float);
        bFileSize = K * N * sizeof(float);
        cFileSize = M * N * sizeof(float);
    }
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aDevice;
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t *bDevice;
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    uint8_t *cDevice;
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint64_t *timeHost;
    uint64_t *timeDevice;
    size_t timeSize = repeatTime * sizeof(uint64_t);
    aclrtMallocHost((void **)(&timeHost), timeSize);
    aclrtMalloc((void **)&timeDevice, timeSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 执行
    mmad_custom<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, (uint8_t *)timeDevice, M, N, K, scenarioNum, repeatTime);
    aclrtSynchronizeStream(stream);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFree(timeDevice);
    aclrtFreeHost(timeHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}