#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(x, y, ...)                                                                                                 \
    AscendC::TPipe pipe;                                                                                               \
    Kernel<__VA_ARGS__>(x, y, &pipe);

#define NOT_SUPPORT AscendC::printf("not support!");

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;
constexpr float scalar = 1.123123;

// 计算模式枚举
enum class ComputeMode {
    COUNT = 0,       // 指令使用count模式
    CONTINUOUS_MASK, // 指令使用mask连续模式
    BITWISE_MASK     // 指令使用mask逐比特模式
};

// 测试类型枚举
enum class TestType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};

// 统一配置结构体
template <typename SrcT, typename DstT, ComputeMode Mode, TestType Type, bool PerfTest = false, float Scalar = 2.0>
struct KernelConfig {
    using SrcType = SrcT;
    using DstType = DstT;
    static constexpr ComputeMode mode = Mode;
    static constexpr TestType testType = Type;
    static constexpr bool testPerformance = PerfTest;
    static constexpr float scalar = Scalar;
};


// 默认配置
using CurrentConfig = KernelConfig<half, half, ComputeMode::COUNT, TestType::NORMAL, false, 1.123123>;


// 掩码生成器 - 编译期计算掩码
template <typename SrcT, typename DstT>
struct MaskGenerator {
    static constexpr uint64_t masks[2] = {UINT64_MAX, 0};

    static constexpr uint64_t* GetMask()
    {
        if constexpr (AscendC::IsSameType<SrcT, half>::value && AscendC::IsSameType<DstT, half>::value) {
            static constexpr uint64_t halfMasks[2] = {UINT64_MAX, UINT64_MAX};
            return const_cast<uint64_t*>(halfMasks);
        } else if constexpr (AscendC::IsSameType<SrcT, float>::value && AscendC::IsSameType<DstT, float>::value) {
            static constexpr uint64_t floatMasks[2] = {UINT64_MAX, 0};
            return const_cast<uint64_t*>(floatMasks);
        }
        return const_cast<uint64_t*>(masks);
    }
};

// 重复次数和块大小计算器
template <typename DstT>
struct BlockCalculator {
    static constexpr uint16_t ONE_REP_SIZE = 256 / sizeof(DstT);

    static uint16_t GetRepeatTimes(uint32_t totalSize)
    {
        return totalSize / ONE_REP_SIZE;
    }

    static constexpr uint16_t GetBlkSize()
    {
        return ONE_REP_SIZE;
    }
};

// 策略基类
template <typename Config>
struct ComputeStrategy {
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    static constexpr bool isSameType = AscendC::IsSameType<SrcT, DstT>::value;
};

// Count模式策略
template <typename Config>
struct CountModeStrategy : public ComputeStrategy<Config> {
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    template <typename T = SrcT, typename U = DstT>
    __aicore__ static void Compute(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
    {
        if constexpr (Config::testType == TestType::SEPARATION) {
            CustomCompute(srcLocal, dstLocal);
        } else if constexpr (Config::testType == TestType::OVERLAP) {
            AscendC::Axpy(dstLocal, dstLocal, (T)Config::alpha, size);
        } else {
            AscendC::Axpy(dstLocal, srcLocal, (T)Config::alpha, size);
        }
    }

    __aicore__ static void CustomCompute(AscendC::LocalTensor<SrcT>& srcLocal, AscendC::LocalTensor<DstT>& dstLocal)
    {
        AscendC::Muls(srcLocal, srcLocal, (SrcT)Config::alpha, size);
        if constexpr (AscendC::IsSameType<SrcT, DstT>::value) {
            AscendC::Add(dstLocal, dstLocal, srcLocal, size);
        } else {
            AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
            pipe->InitBuffer(castBuf, size * sizeof(DstT));
            AscendC::LocalTensor<DstT> tmp = castBuf.Get<DstT>();
            AscendC::Cast(tmp, srcLocal, AscendC::RoundMode::CAST_NONE, size);
            AscendC::Add(dstLocal, dstLocal, tmp, size);
        }
    }
};

// 连续Mask模式策略
template <typename Config>
struct ContinuousMaskStrategy : public ComputeStrategy<Config> {
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    template <typename T = SrcT, typename U = DstT>
    __aicore__ static void Compute(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
    {
        if constexpr (Config::testType == TestType::NORMAL) {
            uint16_t repeatTimes = BlockCalculator<U>::GetRepeatTimes(size);
            constexpr uint16_t blkSize = BlockCalculator<U>::GetBlkSize();

            if constexpr (AscendC::IsSameType<T, U>::value) {
                AscendC::Axpy(dstLocal, srcLocal, (T)Config::alpha, blkSize, repeatTimes, {1, 1, 8, 8});
            } else {
                AscendC::Axpy(dstLocal, srcLocal, (T)Config::alpha, blkSize, repeatTimes, {1, 1, 8, 4});
            }
        } else {
            NOT_SUPPORT;
        }
    }
};

// 位掩码模式策略
template <typename Config>
struct BitwiseMaskStrategy : public ComputeStrategy<Config> {
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    template <typename T = SrcT, typename U = DstT>
    __aicore__ static void Compute(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
    {
        if constexpr (Config::testType == TestType::NORMAL) {
            uint16_t repeatTimes = BlockCalculator<U>::GetRepeatTimes(size);
            constexpr uint16_t blkSize = BlockCalculator<U>::GetBlkSize();
            uint64_t* mask = MaskGenerator<T, U>::GetMask();

            if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, half>::value) {
                AscendC::Axpy(dstLocal, srcLocal, (T)Config::alpha, mask, repeatTimes, {1, 1, 8, 8});
            } else if constexpr (AscendC::IsSameType<T, float>::value && AscendC::IsSameType<U, float>::value) {
                AscendC::Axpy(dstLocal, srcLocal, (T)Config::alpha, mask, repeatTimes, {1, 1, 8, 8});
            } else {
                AscendC::Axpy(dstLocal, srcLocal, (T)Config::alpha, mask, repeatTimes, {1, 1, 8, 4});
            }
        } else {
            NOT_SUPPORT;
        }
    }
};

// 策略分发器
template <typename Config>
struct StrategyDispatcher {
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    __aicore__ static void Compute(AscendC::LocalTensor<SrcT>& srcLocal, AscendC::LocalTensor<DstT>& dstLocal)
    {
        if constexpr (Config::mode == ComputeMode::COUNT) {
            CountModeStrategy<Config>::Compute(srcLocal, dstLocal);
        } else if constexpr (Config::mode == ComputeMode::CONTINUOUS_MASK) {
            ContinuousMaskStrategy<Config>::Compute(srcLocal, dstLocal);
        } else if constexpr (Config::mode == ComputeMode::BITWISE_MASK) {
            BitwiseMaskStrategy<Config>::Compute(srcLocal, dstLocal);
        }
    }
};

// 性能测试
template <typename Config>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<typename Config::SrcType>& srcLocal,
                                       AscendC::LocalTensor<typename Config::DstType>& dstLocal)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        StrategyDispatcher<Config>::Compute(srcLocal, dstLocal);
    }
}

// 功能测试
template <typename Config>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<typename Config::SrcType>& srcGlobal,
                                         AscendC::GlobalTensor<typename Config::DstType>& dstGlobal,
                                         AscendC::LocalTensor<typename Config::SrcType>& srcLocal,
                                         AscendC::LocalTensor<typename Config::DstType>& dstLocal)
{
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    AscendC::DataCopy(srcLocal, srcGlobal, size);
    AscendC::DataCopy(dstLocal, dstGlobal, size);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    StrategyDispatcher<Config>::Compute(srcLocal, dstLocal);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, size);
}

// 主Kernel模板
template <typename Config>
__aicore__ inline void Kernel(GM_ADDR x, GM_ADDR y, AscendC::TPipe* pipe)
{
    using SrcT = typename Config::SrcType;
    using DstT = typename Config::DstType;

    // 定义GlobalTensor
    AscendC::GlobalTensor<SrcT> srcGlobal;
    AscendC::GlobalTensor<DstT> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ SrcT*)x);
    dstGlobal.SetGlobalBuffer((__gm__ DstT*)y);

    // 设置静态Tensor起始地址
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t yAddr = xAddr + size * sizeof(SrcT) + 256;

    // 定义LocalTensor
    AscendC::LocalTensor<SrcT> srcLocal(AscendC::TPosition::VECCALC, xAddr, size);
    AscendC::LocalTensor<DstT> dstLocal(AscendC::TPosition::VECOUT, yAddr, size);

    // 执行性能测试&功能测试
    if constexpr (Config::testPerformance) {
        TestPerformance<Config>(srcLocal, dstLocal);
    } else {
        TestFunctionality<Config>(srcGlobal, dstGlobal, srcLocal, dstLocal);
    }
}

// 导出Kernel函数
__global__ __vector__ void kernel(GM_ADDR x, GM_ADDR y)
{
    RUN(x, y, CurrentConfig);
}

// 主函数保持不变
int32_t main(int32_t argc, char* argv[])
{
    using Config = CurrentConfig;

    uint32_t numBlocks = 1;
    size_t inputByteSize = SIZE * sizeof(typename Config::SrcType);
    size_t outputByteSize = SIZE * sizeof(typename Config::DstType);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}