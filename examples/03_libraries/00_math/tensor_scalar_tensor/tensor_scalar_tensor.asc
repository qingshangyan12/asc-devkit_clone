/* !
 * \file axpy.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(x, y, ...)                                                                                                 \
    AscendC::TPipe pipe;                                                                                               \
    Kernel<__VA_ARGS__>(x, y, &pipe);

#define NOT_SUPPORT AscendC::printf("not support!");

enum class ComputeMode {
    USE_COUNT_MODE = 0,          // 指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // 指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // 指令使用mask逐比特模式
};

enum class CaseType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};

template <ComputeMode Mode, CaseType Type, bool PerfTest = false>
struct KernelConfig {
    static constexpr ComputeMode mode = Mode;
    static constexpr CaseType type = Type;
    static constexpr bool testPerformance = PerfTest;
};

/************************ 用户可自定义配置 ********************** */
constexpr uint32_t size = SIZE;
constexpr float scalar = 2.0;
using srcType = half;
using dstType = float;
using CurrentConfig = KernelConfig<ComputeMode::USE_COUNT_MODE, TestType::NORMAL, false>;
#define TEMPLATE_API Axpy
/************************************************************** */

/*********************** 定制计算，用于与AscendC指令比较性能、精度 *********************/
template <typename T, typename U, typename Config>
__aicore__ inline void CustomCompute(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    AscendC::Muls(srcLocal, srcLocal, (T)scalar, size);
    if constexpr (AscendC::IsSameType<T, U>::value) {
        AscendC::Add(dstLocal, dstLocal, srcLocal, size);
    } else {
        constexpr uint32_t tmpAddr = size * sizeof(T) + size * sizeof(U) + 256;
        AscendC::LocalTensor<U> tmp(AscendC::TPosition::VECCALC, tmpAddr, size);
        AscendC::Cast(tmp, srcLocal, AscendC::RoundMode::CAST_NONE, size);
        AscendC::Add(dstLocal, dstLocal, tmp, size);
    }
}
/**************************************************************************************/

// 使用count模式计算
template <typename T, typename U, typename Config>
__aicore__ inline void ComputeCountMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    if constexpr (Config::type == CaseType::SEPARATION) {
        CustomCompute<T, U, config>(srcLocal, dstLocal);
    } else if constexpr (Config::type == CaseType::OVERLAP) {
        AscendC::TEMPLATE_API(dstLocal, dstLocal, (T)scalar, size);
    } else {
        AscendC::TEMPLATE_API(dstLocal, srcLocal, (T)scalar, size);
    }
}

// 使用mask连续模式计算
template <typename T, typename U, typename Config>
__aicore__ inline void ComputeContinuousMaskMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    if constexpr (Config::type == CaseType::NORMAL) {
        constexpr uint16_t oneRepSize = 256 / sizeof(U);
        uint16_t repeatTimes = size / oneRepSize;
        if constexpr (AscendC::IsSameType<T, U>::value) {
            AscendC::TEMPLATE_API(dstLocal, srcLocal, (T)scalar, oneRepSize, repeatTimes, {1, 1, 8, 8});
        } else {
            AscendC::TEMPLATE_API(dstLocal, srcLocal, (T)scalar, oneRepSize, repeatTimes, {1, 1, 8, 4});
        }
    } else {
        NOT_SUPPORT;
    }
}

// 使用mask逐比特模式计算
template <typename T, typename U, typename Config>
__aicore__ inline void ComputeBitwiseMaskMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    if constexpr (Config::type == CaseType::NORMAL) {
        constexpr uint16_t oneRepSize = 256 / sizeof(U);
        uint16_t repeatTimes = size / oneRepSize;
        if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, half>::value) {
            uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
            AscendC::TEMPLATE_API(dstLocal, srcLocal, (T)scalar, mask, repeatTimes, {1, 1, 8, 8});
        } else if constexpr (AscendC::IsSameType<T, float>::value && AscendC::IsSameType<U, float>::value) {
            uint64_t mask[2] = {UINT64_MAX, 0};
            AscendC::TEMPLATE_API(dstLocal, srcLocal, (T)scalar, mask, repeatTimes, {1, 1, 8, 8});
        } else {
            uint64_t mask[2] = {UINT64_MAX, 0};
            AscendC::TEMPLATE_API(dstLocal, srcLocal, (T)scalar, mask, repeatTimes, {1, 1, 8, 4});
        }
    } else {
        NOT_SUPPORT;
    }
}

// 性能测试函数
template <typename T, typename U, typename Config>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeCountMode<T, U, Config>(srcLocal, dstLocal);
    }
}

// 功能测试函数
template <typename T, typename U, typename Config>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& srcGlobal, AscendC::GlobalTensor<U>& dstGlobal,
                                         AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    AscendC::DataCopy(srcLocal, srcGlobal, size);
    AscendC::DataCopy(dstLocal, dstGlobal, size);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    if constexpr (Config::mode == ComputeMode::USE_COUNT_MODE) {
        ComputeCountMode<T, U, Config>(srcLocal, src1Local, dstLocal);
    } else if constexpr (Config::mode == ComputeMode::USE_CONTINUOUS_MODE_OF_MASK) {
        ComputeContinuousMaskMode<T, U, Config>(srcLocal, src1Local, dstLocal);
    } else {
        ComputeBitwiseMaskMode<T, U, Config>(srcLocal, src1Local, dstLocal);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGlobal, dstLocal, size);
}

template <typename T, typename U, typename Config>
__aicore__ inline void Kernel(GM_ADDR x, GM_ADDR y, AscendC::TPipe* pipe)
{
    // 定义GlobalTensor
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)x);
    dstGlobal.SetGlobalBuffer((__gm__ U*)y);

    // 设置静态Tensor起始地址
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t yAddr = xAddr + size * sizeof(T) + 256;

    // 定义LocalTensor
    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, xAddr, size);
    AscendC::LocalTensor<U> dstLocal(AscendC::TPosition::VECOUT, yAddr, size);

    // 执行性能测试&功能测试
    if constexpr (Config::testPerformance) {
        TestPerformance<T, U, Config>(srcLocal, dstLocal);
    } else {
        TestFunctionality<T, U, Config>(srcGlobal, dstGlobal, srcLocal, dstLocal);
    }
}

__global__ __vector__ void kernel(GM_ADDR x, GM_ADDR y)
{
    RUN(x, y, srcType, dstType, CurrentConfig);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = SIZE * sizeof(srcType);
    size_t outputByteSize = SIZE * sizeof(dstType);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}