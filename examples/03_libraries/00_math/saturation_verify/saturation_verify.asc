/* !
 * \file saturation_verify.asc
 * \brief Saturation verify operator for exp/mul with different data types
 */

#include <cstdint>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_TENSOR_SIZE = INPUT_SIZE;
constexpr uint32_t INPUT_API_ID_VAL = INPUT_API_ID;
constexpr uint32_t INPUT_API_TYPE_VAL = INPUT_API_TYPE;
constexpr uint32_t INPUT_DATA_TYPE_VAL = INPUT_DATA_TYPE;

constexpr uint32_t BUFFER_NUM = 2;

#define API_ID_EXP   1
#define API_ID_MUL   2
#define API_ID_ADDS  3

#define API_TYPE_UNARY  1
#define API_TYPE_BINARY 2
#define API_TYPE_BINARY_SCALAR 3

struct SaturationVerifyTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

template <class T>
class KernelSaturationVerify {
public:
    __aicore__ inline KernelSaturationVerify() {}
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        pipe->InitBuffer(inQueueSrc, 1, INPUT_TENSOR_SIZE * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, INPUT_TENSOR_SIZE * sizeof(T));
    }
    __aicore__ inline void Init(__gm__ uint8_t* src1Gm, __gm__ uint8_t* src2Gm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        src1Global.SetGlobalBuffer((__gm__ T*)src1Gm);
        src2Global.SetGlobalBuffer((__gm__ T*)src2Gm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        
        this->blockLength = INPUT_TENSOR_SIZE / AscendC::GetBlockNum();
        this->tileNum = 1;
        this->tileLength = this->blockLength / BUFFER_NUM;
        
        pipe->InitBuffer(inQueueSrc1, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe->InitBuffer(inQueueSrc2, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe->InitBuffer(outQueueDst, BUFFER_NUM, this->tileLength * sizeof(T));
    }
    __aicore__ inline void SetSatMode(bool isSaturation)
    {
        if constexpr (INPUT_DATA_TYPE_VAL == 1 || INPUT_DATA_TYPE_VAL == 1) {
            // half/float
            if (isSaturation) {
                set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_48_BIT));
            } else {
                set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_48_BIT));
            }
        } else {
            // int16/int32
            if (isSaturation) {
                set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_53_BIT));
            } else {
                set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_53_BIT));
            }
        }
    }
    __aicore__ inline void Process(bool isSaturation)
    {
        SetSatMode(isSaturation);
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        if constexpr (INPUT_API_ID_VAL == API_ID_EXP) {
            AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
            AscendC::DataCopy(srcLocal, srcGlobal, INPUT_TENSOR_SIZE);
            inQueueSrc.EnQue(srcLocal);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_MUL) {
            AscendC::LocalTensor<T> src1Local = inQueueSrc1.AllocTensor<T>();
            AscendC::LocalTensor<T> src2Local = inQueueSrc2.AllocTensor<T>();
            AscendC::DataCopy(src1Local, src1Global, INPUT_TENSOR_SIZE);
            AscendC::DataCopy(src2Local, src2Global, INPUT_TENSOR_SIZE);
            inQueueSrc1.EnQue(src1Local);
            inQueueSrc2.EnQue(src2Local);
        } else if constexpr (INPUT_API_TYPE_VAL == API_ID_ADDS) {
            AscendC::LocalTensor<T> src1Local = inQueueSrc1.AllocTensor<T>();
            AscendC::LocalTensor<T> src2Local = inQueueSrc2.AllocTensor<T>();
            AscendC::DataCopy(src1Local, src1Global, INPUT_TENSOR_SIZE);
            AscendC::DataCopy(src2Local, src2Global, INPUT_TENSOR_SIZE);
            inQueueSrc1.EnQue(src1Local);
            inQueueSrc2.EnQue(src2Local);
        }
    }
    __aicore__ inline void Compute()
    {
        if constexpr (INPUT_API_ID_VAL == API_ID_EXP) {
            AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
            AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
            AscendC::Exp(dstLocal, srcLocal, INPUT_TENSOR_SIZE);
            outQueueDst.EnQue<T>(dstLocal);
            inQueueSrc.FreeTensor(srcLocal);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_MUL) {
            AscendC::LocalTensor<T> src1Local = inQueueSrc1.DeQue<T>();
            AscendC::LocalTensor<T> src2Local = inQueueSrc2.DeQue<T>();
            AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
            AscendC::Mul(dstLocal, src1Local, src2Local, INPUT_TENSOR_SIZE);
            outQueueDst.EnQue<T>(dstLocal);
            inQueueSrc1.FreeTensor(src1Local);
            inQueueSrc2.FreeTensor(src2Local);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_ADDS) {
            // 为方便测试，scalar从输入的src2Local获取
            // INPUT_TENSOR = [MIN, MIN, MIN, MIN, MAX, MAX, ...]
            // INPUT_SCALAR = [MIN, MAX, +0, -0, ...]
            AscendC::LocalTensor<T> src1Local = inQueueSrc1.DeQue<T>();
            AscendC::LocalTensor<T> src2Local = inQueueSrc2.DeQue<T>();
            AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
            AscendC::LocalTensor<T> dstLocalTmp = outQueueDst.AllocTensor<T>();
            
            // 整数类型，MIN/MAX/+0/-0
            int32_t specialValueCnt = 4;
            if constexpr (INPUT_DATA_TYPE_VAL == 1 || INPUT_DATA_TYPE_VAL == 2) {
                // 浮点数类型，MIN/MAX/+0/-0/NaN/INF/-INF
                specialValueCnt = 7;
            }
            for (int i = 0; i < specialValueCnt; ++i) {
                AscendC::Duplicate(dstLocalTmp, T(0), INPUT_TENSOR_SIZE);
                for (int j = 0; j < specialValueCnt; ++j) {
                    // 通过for循环，对tensor用不同的scalar进行计算处理
                    T scalar = src2Local.GetValue(j);
                    AscendC::Adds(dstLocalTmp, src1Local, scalar, INPUT_TENSOR_SIZE);
                    // AscendC::PRINTF("\nidx = %d(i = %d, j = %d), scalar = %d, input1 = %d, input2 = %d, val = %d", j + i * specialValueCnt, i, j, scalar, src1Local.GetValue(i), src1Local.GetValue(i+1), dstLocalTmp.GetValue(i * specialValueCnt));
                    dstLocal.SetValue(j + i * specialValueCnt, dstLocalTmp.GetValue(i * specialValueCnt));
                }
            }
            outQueueDst.EnQue<T>(dstLocal);
            inQueueSrc1.FreeTensor(src1Local);
            inQueueSrc2.FreeTensor(src2Local);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, INPUT_TENSOR_SIZE);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueSrc1, inQueueSrc2;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> src1Global, src2Global;
    AscendC::GlobalTensor<T> dstGlobal;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __vector__ void saturation_verify_kernel_sat(GM_ADDR x, GM_ADDR y, GM_ADDR z, SaturationVerifyTilingData tiling) 
{
    AscendC::TPipe pipe;
    
    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_UNARY) {
        if constexpr (INPUT_DATA_TYPE_VAL == 1) {
            KernelSaturationVerify<half> op;
            op.Init(x, z, &pipe);
            op.Process(true);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
            KernelSaturationVerify<float> op;
            op.Init(x, z, &pipe);
            op.Process(true);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
            KernelSaturationVerify<int16_t> op;
            op.Init(x, z, &pipe);
            op.Process(true);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
            KernelSaturationVerify<int32_t> op;
            op.Init(x, z, &pipe);
            op.Process(true);
        }
    } else if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        if constexpr (INPUT_DATA_TYPE_VAL == 1) {
            KernelSaturationVerify<half> op;
            op.Init(x, y, z, &pipe);
            op.Process(true);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
            KernelSaturationVerify<float> op;
            op.Init(x, y, z, &pipe);
            op.Process(true);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
            KernelSaturationVerify<int16_t> op;
            op.Init(x, y, z, &pipe);
            op.Process(true);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
            KernelSaturationVerify<int32_t> op;
            op.Init(x, y, z, &pipe);
            op.Process(true);
        }
    }
}

__global__ __vector__ void saturation_verify_kernel_non_sat(GM_ADDR x, GM_ADDR y, GM_ADDR z, SaturationVerifyTilingData tiling) 
{
    AscendC::TPipe pipe;
    
    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_UNARY) {
        if constexpr (INPUT_DATA_TYPE_VAL == 1) {
            KernelSaturationVerify<half> op;
            op.Init(x, z, &pipe);
            op.Process(false);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
            KernelSaturationVerify<float> op;
            op.Init(x, z, &pipe);
            op.Process(false);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
            KernelSaturationVerify<int16_t> op;
            op.Init(x, z, &pipe);
            op.Process(false);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
            KernelSaturationVerify<int32_t> op;
            op.Init(x, z, &pipe);
            op.Process(false);
        }
    } else if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        if constexpr (INPUT_DATA_TYPE_VAL == 1) {
            KernelSaturationVerify<half> op;
            op.Init(x, y, z, &pipe);
            op.Process(false);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
            KernelSaturationVerify<float> op;
            op.Init(x, y, z, &pipe);
            op.Process(false);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
            KernelSaturationVerify<int16_t> op;
            op.Init(x, y, z, &pipe);
            op.Process(false);
        } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
            KernelSaturationVerify<int32_t> op;
            op.Init(x, y, z, &pipe);
            op.Process(false);
        }
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    uint32_t dataTypeSize = sizeof(half);
    if constexpr (INPUT_DATA_TYPE_VAL == 1) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
        dataTypeSize = sizeof(float);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
        dataTypeSize = sizeof(int16_t);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
        dataTypeSize = sizeof(int32_t);
    }
    
    size_t inputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;
    size_t outputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHostNonSat, *zHostSat;
    uint8_t *xDevice, *yDevice, *zDeviceNonSat, *zDeviceSat;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHostNonSat), outputByteSize);
    aclrtMallocHost((void **)(&zHostSat), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDeviceNonSat, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDeviceSat, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        yHost = (uint8_t*)malloc(inputByteSize);
        aclrtMalloc((void **)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
        aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }
    
    SaturationVerifyTilingData tiling = {INPUT_TENSOR_SIZE, numBlocks};
    
    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_UNARY) {
        saturation_verify_kernel_sat<<<numBlocks, nullptr, stream>>>(xDevice, nullptr, zDeviceSat, tiling);
        aclrtSynchronizeStream(stream);
        saturation_verify_kernel_non_sat<<<numBlocks, nullptr, stream>>>(xDevice, nullptr, zDeviceNonSat, tiling);
        aclrtSynchronizeStream(stream);
    } else if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        saturation_verify_kernel_sat<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDeviceSat, tiling);
        aclrtSynchronizeStream(stream);
        saturation_verify_kernel_non_sat<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDeviceNonSat, tiling);
        aclrtSynchronizeStream(stream);
    }
    
    aclrtMemcpy(zHostNonSat, outputByteSize, zDeviceNonSat, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(zHostSat, outputByteSize, zDeviceSat, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_non_sat.bin", zHostNonSat, outputByteSize);
    WriteFile("./output/output_sat.bin", zHostSat, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDeviceNonSat);
    aclrtFree(zDeviceSat);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHostNonSat);
    aclrtFreeHost(zHostSat);

    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        aclrtFree(yDevice);
        aclrtFreeHost(yHost);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
