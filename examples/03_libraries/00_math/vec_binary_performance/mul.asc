/* !
 * \file mul.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t TOTAL_LENGTH = INPUT_SIZE;
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE;
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000;

template <class T>
class KernelMul {
public:
    __aicore__ inline KernelMul() = default;
    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR yGm, GM_ADDR zGm, uint32_t totalLength, uint32_t count,
                                AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        xGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), totalLength);
        yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), totalLength);
        zGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(zGm), totalLength);
        pipe->InitBuffer(inQueueX, 1, totalLength * sizeof(T));
        pipe->InitBuffer(inQueueY, 1, totalLength * sizeof(T));
        pipe->InitBuffer(outQueue, 1, totalLength * sizeof(T));
        bufferSize = totalLength;
        this->count = count;
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGlobal, bufferSize);
        AscendC::DataCopy(yLocal, yGlobal, bufferSize);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueue.AllocTensor<T>();

        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleBefore = AscendC::GetSystemCycle();
        for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXCUTE; ++i) {
            AscendC::Mul(zLocal, xLocal, yLocal, TOTAL_LENGTH);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleAfter = AscendC::GetSystemCycle();
        AscendC::PRINTF("[LOG] systemCycleBefore: %d\n", systemCycleBefore);
        AscendC::PRINTF("[LOG] systemCycleAfter: %d\n", systemCycleAfter);
        AscendC::PRINTF("[LOG] Mul instruction has excuted %d times, cost total cycles: %d\n",
            REPEAT_TIMES_FOR_INSTR_EXCUTE, (systemCycleAfter - systemCycleBefore));

        outQueue.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(zGlobal, zLocal, bufferSize);
        outQueue.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> xGlobal;
    AscendC::GlobalTensor<T> yGlobal;
    AscendC::GlobalTensor<T> zGlobal;
    uint32_t bufferSize = 0;
    uint32_t count = 0;
};

__global__ __vector__ void mul_custom(GM_ADDR xGm, GM_ADDR yGm, GM_ADDR zGm)
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelMul<half> op;
        op.Init(xGm, yGm, zGm, TOTAL_LENGTH, TOTAL_LENGTH, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelMul<float> op;
        op.Init(xGm, yGm, zGm, TOTAL_LENGTH, TOTAL_LENGTH, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        KernelMul<int16_t> op;
        op.Init(xGm, yGm, zGm, TOTAL_LENGTH, TOTAL_LENGTH, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        KernelMul<int32_t> op;
        op.Init(xGm, yGm, zGm, TOTAL_LENGTH, TOTAL_LENGTH, &pipe);
        op.Process();
    }
}

template <typename T>
static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(T); i++) {
        T tmpA = (reinterpret_cast<const T*>(outputData))[i];
        T tmpB = (reinterpret_cast<const T*>(goldenData))[i];

        float a = float(tmpA);
        float b = float(tmpB);

        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t dataTypeSize = sizeof(int16_t);
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        dataTypeSize = sizeof(float);
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        dataTypeSize = sizeof(int16_t);
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        dataTypeSize = sizeof(int32_t);
    }
    size_t paramByteSize = TOTAL_LENGTH * dataTypeSize;
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    aclrtMallocHost((void**)(&xHost), paramByteSize);
    aclrtMalloc((void**)&xDevice, paramByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", paramByteSize, xHost, paramByteSize);
    aclrtMemcpy(xDevice, paramByteSize, xHost, paramByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* yHost;
    uint8_t* yDevice;
    aclrtMallocHost((void**)(&yHost), paramByteSize);
    aclrtMalloc((void**)&yDevice, paramByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_y.bin", paramByteSize, yHost, paramByteSize);
    aclrtMemcpy(yDevice, paramByteSize, yHost, paramByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* zHost;
    uint8_t* zDevice;
    aclrtMallocHost((void**)(&zHost), paramByteSize);
    aclrtMalloc((void**)&zDevice, paramByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mul_custom<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);

    aclrtMemcpy(zHost, paramByteSize, zDevice, paramByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_z.bin", zHost, paramByteSize);

    bool goldenResult = true;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        goldenResult = CompareResult<half>(zHost, paramByteSize);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        goldenResult = CompareResult<float>(zHost, paramByteSize);
    } else if constexpr (INPUT_TENSOR_TYPE == 3) {
        goldenResult = CompareResult<int16_t>(zHost, paramByteSize);
    } else if constexpr (INPUT_TENSOR_TYPE == 4) {
        goldenResult = CompareResult<int32_t>(zHost, paramByteSize);
    }
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(zDevice);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
