/* !
 * \file axpy.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

enum Mode {
    USE_COUNT_MODE = 0,             // Axpy指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK,    // Axpy指令使用mask连续模式
    USE_BITWISE_MASK_MODE           // Axpy指令使用mask逐比特模式
};

enum CaseType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};


template<typename T, typename U, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE, CaseType caseType = CaseType::NORMAL>
class KernelAxpy {
public:
    __aicore__ inline KernelAxpy() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        srcGlobal.SetGlobalBuffer((__gm__ T*)x);
        dstGlobal.SetGlobalBuffer((__gm__ U*)y);
        pipe.InitBuffer(inQueue, 1, size * sizeof(T));
        pipe.InitBuffer(outQueue, 1, size * sizeof(U));
    }
    __aicore__ inline void Process()
    {
        if constexpr (testPerformance){
            Compute();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, size);
        inQueue.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal;
        if constexpr (testPerformance){
            srcLocal = inQueue.AllocTensor<T>();
        } else {
            srcLocal = inQueue.DeQue<T>();
        }
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();
        AscendC::Duplicate(dstLocal, (U)0.0f, size);
 
        if constexpr (testPerformance) {
            if constexpr (caseType == CaseType::SEPARATION) {
                if constexpr (AscendC::IsSameType<T, U>::value){
                } else {
                }
            } else if constexpr (caseType == CaseType::OVERLAP) {
                if constexpr (!AscendC::IsSameType<T, U>::value) {
                } else {
                }
            }
        } else {
            if constexpr (mode == Mode::USE_COUNT_MODE){
            } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK){
                constexpr uint16_t oneRepSize = 256 / sizeof(T);
                uint16_t repeatTimes = size / oneRepSize;
            } else {
                uint64_t mask[2] = { 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF };
                constexpr uint16_t oneRepSize = 256 / sizeof(T);
                uint16_t repeatTimes = size / oneRepSize;
            }
        }
 
        inQueue.FreeTensor(srcLocal);
        if constexpr (testPerformance) {
            outQueue.FreeTensor(dstLocal);
        } else {
            outQueue.EnQue<U>(dstLocal);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> dstLocal = outQueue.DeQue<U>();
        AscendC::DataCopy(dstGlobal, dstLocal, size);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U> dstGlobal;
};

__global__ __vector__ void kernel_axpy(GM_ADDR x, GM_ADDR y)
{
    if constexpr (scenarioNum == 1){
        KernelAxpy<half, half> op;
        op.Init(x, y);
        op.Process();
    } else {
        AscendC::printf("not support!");
    }
}

int32_t main(int32_t argc, char *argv[]) {
  uint32_t numBlocks = 1;
  size_t xByteSize = 0;
  size_t yByteSize = 0;
  size_t outputByteSize = 0;

  if constexpr (scenarioNum >= 1 && scenarioNum <= 6){
    xByteSize = SIZE * sizeof(int16_t);
    yByteSize = SIZE * sizeof(int16_t);
    outputByteSize = SIZE * sizeof(int16_t);
  }

  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);

  uint8_t *xHost, *yHost, *outHost;
  uint8_t *xDevice, *yDevice, *outDevice;

  aclrtMallocHost((void **)(&xHost), xByteSize);
  aclrtMallocHost((void **)(&yHost), yByteSize);
  aclrtMallocHost((void **)(&outHost), outputByteSize);

  aclrtMalloc((void **)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&yDevice, yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
  aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);

  ReadFile("./input/input_y.bin", yByteSize, yHost, yByteSize);
  aclrtMemcpy(yDevice, yByteSize, yHost, yByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);

  kernel_axpy<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, outDevice);
  aclrtSynchronizeStream(stream);

  aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  WriteFile("./output/output.bin", outHost, outputByteSize);

  aclrtFree(xDevice);
  aclrtFree(yDevice);
  aclrtFree(outDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(yHost);
  aclrtFreeHost(outHost);

  aclrtDestroyStream(stream);
  aclrtResetDevice(deviceId);
  aclFinalize();

  return 0;
}