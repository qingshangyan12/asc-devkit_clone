/* !
 * \file axpy.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

enum class Mode {
    USE_COUNT_MODE = 0,          // Axpy指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // Axpy指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // Axpy指令使用mask逐比特模式
};

enum class CaseType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};

template <typename T, typename U, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE,
          CaseType caseType = CaseType::NORMAL>
class KernelMulAddDst {
public:
    __aicore__ inline KernelMulAddDst() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipeIn)
    {
        src0Global.SetGlobalBuffer((__gm__ T*)x);
        src1Global.SetGlobalBuffer((__gm__ T*)y);
        dstGlobal.SetGlobalBuffer((__gm__ U*)z);
        pipe.InitBuffer(inQueueX, 1, size * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, size * sizeof(T));
        pipe.InitBuffer(outQueue, 1, size * sizeof(U));
    }
    __aicore__ inline void Process()
    {
        if constexpr (testPerformance) {
            Compute();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> src0Local = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> src1Local = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(src0Local, src0Global, size);
        AscendC::DataCopy(src1Local, src1Global, size);
        inQueueX.EnQue(src0Local);
        inQueueY.EnQue(src1Local);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> src0Local;
        AscendC::LocalTensor<T> src1Local;
        if constexpr (testPerformance) {
            src0Local = inQueueX.AllocTensor<T>();
            src1Local = inQueueY.AllocTensor<T>();
        } else {
            src0Local = inQueueX.DeQue<T>();
            src1Local = inQueueY.DeQue<T>();
        }
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();
        AscendC::Duplicate(dstLocal, (U)0.0f, size);

        if constexpr (testPerformance) {
            if constexpr (caseType == CaseType::SEPARATION) {
                if constexpr (!AscendC::IsSameType<T, U>::value) {
                    AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
                    pipe->InitBuffer(castBuf, size);
                    AscendC::LocalTensor<U> tmp = castBuf.Get<U>();
                    AscendC::Mul(src0Local, src0Local, src1Local, size);
                    AscendC::Cast(tmp, src0Local, AscendC::RoundMode::CAST_CEIL, size);
                    AscendC::Add(dstLocal, dstLocal, tmp, size);
                } else if constexpr {
                    AscendC::Mul(src0Local, src0Local, src1Local, size);
                    AscendC::Add(dstLocal, src0Local, dstLocal, size);
                }
            } else if constexpr (caseType == CaseType::OVERLAP) {
                AscendC::MulAddDst(dstLocal, dstLocal, dstLocal, size);
            } else {
                AscendC::MulAddDst(dstLocal, src0Local, src1Local, size);
            }
        } else {
            constexpr uint16_t oneRepSize = 256 / sizeof(T);
            uint16_t repeatTimes = size / oneRepSize;
            if constexpr (mode == Mode::USE_COUNT_MODE) {
                AscendC::MulAddDst(dstLocal, src0Local, src1Local, size);
            } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
                if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, float>::value) {
                    AscendC::MulAddDst(dstLocal, src0Local, src1Local, oneRepSize, repeatTimes, {1, 1, 1, 8, 4, 4});
                } else {
                    AscendC::MulAddDst(dstLocal, src0Local, src1Local, oneRepSize, repeatTimes, {1, 1, 1, 8, 8, 8});
                }
            } else {
                if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, float>::value) {
                    uint64_t mask[2] = {UINT64_MAX, 0};
                    AscendC::MulAddDst(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 8, 4, 4});
                } else if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, half>::value) {
                    uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
                    AscendC::MulAddDst(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 8, 8, 8});
                } else {
                    uint64_t mask[2] = {UINT64_MAX};
                    AscendC::MulAddDst(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 8, 8, 8});
                }
            }
        }

        inQueue.FreeTensor(srcLocal);
        if constexpr (testPerformance) {
            outQueue.FreeTensor(dstLocal);
        } else {
            outQueue.EnQue<U>(dstLocal);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> dstLocal = outQueue.DeQue<U>();
        AscendC::DataCopy(dstGlobal, dstLocal, size);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> src0Global, src1Global;
    AscendC::GlobalTensor<U> dstGlobal;
};

__global__ __vector__ void kernel_axpy(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    if constexpr (scenarioNum == 1) {
        KernelMulAddDst<half, half> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        KernelMulAddDst<half, half, false, Mode::USE_BITWISE_MASK_MODE> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        KernelMulAddDst<half, half, false, Mode::USE_CONTINUOUS_MODE_OF_MASK> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        KernelMulAddDst<half, half, true> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 5) {
        KernelMulAddDst<half, half, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 6) {
        KernelMulAddDst<half, half, true, Mode::USE_COUNT_MODE, CaseType::OVERLAP> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 7) {
        KernelMulAddDst<float, float> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 8) {
        KernelMulAddDst<float, float, false, Mode::USE_BITWISE_MASK_MODE> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 9) {
        KernelMulAddDst<float, float, false, Mode::USE_CONTINUOUS_MODE_OF_MASK> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 10) {
        KernelMulAddDst<half, float> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 11) {
        KernelMulAddDst<half, float, false, Mode::USE_BITWISE_MASK_MODE> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 12) {
        KernelMulAddDst<half, float, false, Mode::USE_CONTINUOUS_MODE_OF_MASK> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 13) {
        KernelMulAddDst<half, float, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else if constexpr (scenarioNum == 14) {
        KernelMulAddDst<half, float, true, Mode::USE_COUNT_MODE, CaseType::OVERLAP> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else {
        AscendC::printf("not support!");
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t xByteSize = 0;
    size_t yByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum >= 1 && scenarioNum <= 6) {
        xByteSize = SIZE * sizeof(int16_t);
        yByteSize = SIZE * sizeof(int16_t);
        outputByteSize = SIZE * sizeof(int16_t);
    } else if constexpr (scenarioNum >= 7 && scenarioNum <= 9){
        xByteSize = SIZE * sizeof(int32_t);
        yByteSize = SIZE * sizeof(int32_t);
        outputByteSize = SIZE * sizeof(int32_t);
    } else {
        xByteSize = SIZE * sizeof(int16_t);
        yByteSize = SIZE * sizeof(int16_t);
        outputByteSize = SIZE * sizeof(int32_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *outHost;
    uint8_t *xDevice, *yDevice, *outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&yHost), yByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);

    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_y.bin", yByteSize, yHost, yByteSize);
    aclrtMemcpy(yDevice, yByteSize, yHost, yByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_axpy<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}