/* !
 * \file example_cast.asc
 * \brief Cast operator implementation example
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

// 配置舍入算法
constexpr AscendC::RoundMode roundMode = AscendC::RoundMode::CAST_NONE;

template <typename SrcT, typename DstT>
class KernelCast {
public:
    __aicore__ inline KernelCast() {}
    
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        inputGlobal.SetGlobalBuffer((__gm__ SrcT*)input);
        outputGlobal.SetGlobalBuffer((__gm__ DstT*)output);
        
        pipe->InitBuffer(inQueue, 1, size * sizeof(SrcT));
        pipe->InitBuffer(outQueue, 1, size * sizeof(DstT));
    }
    
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<SrcT> inputLocal = inQueue.AllocTensor<SrcT>();
        AscendC::DataCopy(inputLocal, inputGlobal, size);
        inQueue.EnQue(inputLocal);
    }
    
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<SrcT> inputLocal = inQueue.DeQue<SrcT>();
        AscendC::LocalTensor<DstT> outputLocal = outQueue.AllocTensor<DstT>();
        
        AscendC::Cast(outputLocal, inputLocal, roundMode, size);
        
        inQueue.FreeTensor(inputLocal);
        outQueue.EnQue(outputLocal);
    }
    
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<DstT> outputLocal = outQueue.DeQue<DstT>();
        AscendC::DataCopy(outputGlobal, outputLocal, size);
        outQueue.FreeTensor(outputLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<SrcT> inputGlobal;
    AscendC::GlobalTensor<DstT> outputGlobal;
};

template <uint32_t N>
__aicore__ inline void RunScenario(GM_ADDR input, GM_ADDR output) {
    AscendC::TPipe pipe;
    if constexpr (N == 1) {
        KernelCast<float, half> op;
        op.Init(input, output, &pipe);
        op.Process();
    } else if constexpr (N == 2) {
        KernelCast<half, float> op;
        op.Init(input, output, &pipe);
        op.Process();
    } else if constexpr (N == 3) {
        KernelCast<float, bfloat16_t> op;
        op.Init(input, output, &pipe);
        op.Process();
    } else if constexpr (N == 4) {
        KernelCast<bfloat16_t, float> op;
        op.Init(input, output, &pipe);
        op.Process();
    } else if constexpr (N == 5) {
        KernelCast<float, int32_t> op;
        op.Init(input, output, &pipe);
        op.Process();
    } else if constexpr (N == 6) {
        KernelCast<int32_t, float> op;
        op.Init(input, output, &pipe);
        op.Process();
    }
}

__global__ __vector__ void kernel_cast(GM_ADDR input, GM_ADDR output)
{
    RunScenario<scenarioNum>(input, output);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == 1) {
        inputByteSize = size * sizeof(float);
        outputByteSize = size * sizeof(half);
    } else if constexpr (scenarioNum == 2) {
        inputByteSize = size * sizeof(half);
        outputByteSize = size * sizeof(float);
    } else if constexpr (scenarioNum == 3) {
        inputByteSize = size * sizeof(float);
        outputByteSize = size * sizeof(bfloat16_t);
    } else if constexpr (scenarioNum == 4) {
        inputByteSize = size * sizeof(bfloat16_t);
        outputByteSize = size * sizeof(float);
    } else if constexpr (scenarioNum == 5) {
        inputByteSize = size * sizeof(float);
        outputByteSize = size * sizeof(int32_t);
    } else if constexpr (scenarioNum == 6) {
        inputByteSize = size * sizeof(int32_t);
        outputByteSize = size * sizeof(float);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* inputHost;
    uint8_t* inputDevice;
    uint8_t* outputHost;
    uint8_t* outputDevice;

    aclrtMallocHost((void**)(&inputHost), inputByteSize);
    aclrtMallocHost((void**)(&outputHost), outputByteSize);
    aclrtMalloc((void**)&inputDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outputDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input.bin", inputByteSize, inputHost, inputByteSize);
    aclrtMemcpy(inputDevice, inputByteSize, inputHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_cast<<<numBlocks, nullptr, stream>>>(inputDevice, outputDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, outputByteSize);

    aclrtFree(inputDevice);
    aclrtFree(outputDevice);
    aclrtFreeHost(inputHost);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
