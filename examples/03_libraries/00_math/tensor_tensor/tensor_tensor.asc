/* !
 * \file tensor_tensor.asc
 * \brief Tensor-Tensor 算子直调样例，默认使用 CastDequant API
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(x, y, ...)                                                                                              \
    AscendC::TPipe pipe;                                                                                               \
    Kernel<__VA_ARGS__>(x, y, &pipe);

#define NOT_SUPPORT AscendC::printf("not support!");

enum class ComputeMode {
    USE_COUNT_MODE = 0,          // 指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // 指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // 指令使用mask逐比特模式
};

enum class CaseType {
    NORMAL = 0, // 基础场景，调用
    OVERLAP     // 操作数重叠
};

template <ComputeMode Mode, CaseType Type, bool PerfTest = false>
struct KernelConfig {
    static constexpr ComputeMode mode = Mode;
    static constexpr CaseType type = Type;
    static constexpr bool testPerformance = PerfTest;
};

/************************ 用户可自定义配置 ********************** */
constexpr uint32_t size = SIZE;                       // 计算量
constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000; // 性能测试中的循环次数
constexpr bool halfBlock = false;                     // halfBlock参数， CastDequant接口专用
constexpr bool isVecDeq = false;                      // 是否使用向量量化模式，CastDequant接口专用
using srcType = int16_t;                              // 源操作数的数据类型
using dstType = uint8_t;                              // 目的操作数的数据类型
using CurrentConfig = KernelConfig<ComputeMode::USE_COUNT_MODE, CaseType::NORMAL, false>;
#define TEMPLATE_API CastDequant
/************************************************************** */

// 使用count模式计算
template <typename T, typename U, typename Config>
__aicore__ inline void ComputeCountMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    // CastDequant单独逻辑
    AscendC::LocalTensor<uint64_t> tmpBuffer(AscendC::TPosition::VECCALC, size * sizeof(T) + size * sizeof(U) + 256, 128);
    AscendC::Duplicate(tmpBuffer.ReinterpretCast<int32_t>(), static_cast<int32_t>(0), 32);
    AscendC::PipeBarrier<PIPE_V>();
    bool signMode = false;
    if constexpr (AscendC::Std::is_same<U, int8_t>::value) {
        signMode = true;
    }
    if constexpr (isVecDeq) {
        float vdeqScale[16] = { 0 };
        int16_t vdeqOffset[16] = { 0 };
        bool vdeqSignMode[16] = { 0 };
        for (int i = 0; i < 16; i++) {
            vdeqScale[i] = 1.0;
            vdeqOffset[i] = 0;
            vdeqSignMode[i] = signMode;
        }
        AscendC::VdeqInfo vdeqInfo(vdeqScale, vdeqOffset, vdeqSignMode);
        AscendC::SetDeqScale(tmpBuffer, vdeqInfo);
        int32_t eventIDVToS = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_S));
        AscendC::SetFlag<AscendC::HardEvent::V_S>(eventIDVToS);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(eventIDVToS);
        AscendC::TEMPLATE_API<U, T, true, halfBlock>(dstLocal, srcLocal, size);
    } else {
        float scale = 1.0;
        int16_t offset = 0;
        AscendC::SetDeqScale(scale, offset, signMode);
        AscendC::TEMPLATE_API<U, T, false, halfBlock>(dstLocal, srcLocal, size);
    }
}

// 使用mask连续模式计算
template <typename T, typename U, typename Config>
__aicore__ inline void ComputeContinuousMaskMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    NOT_SUPPORT;
}

// 使用mask逐比特模式计算
template <typename T, typename U, typename Config>
__aicore__ inline void ComputeBitwiseMaskMode(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    NOT_SUPPORT;
}

// 性能测试函数
template <typename T, typename U, typename Config>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeCountMode<T, U, Config>(srcLocal, dstLocal);
    }
}

// 功能测试函数
template <typename T, typename U, typename Config>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& srcGlobal, AscendC::GlobalTensor<U>& dstGlobal,
                                          AscendC::LocalTensor<T>& srcLocal, AscendC::LocalTensor<U>& dstLocal)
{
    AscendC::DataCopy(srcLocal, srcGlobal, size);
    
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    if constexpr (Config::mode == ComputeMode::USE_COUNT_MODE) {
        ComputeCountMode<T, U, Config>(srcLocal, dstLocal);
    } else if constexpr (Config::mode == ComputeMode::USE_CONTINUOUS_MODE_OF_MASK) {
        ComputeContinuousMaskMode<T, U, Config>(srcLocal, dstLocal);
    } else {
        ComputeBitwiseMaskMode<T, U, Config>(srcLocal, dstLocal);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGlobal, dstLocal, size * 2);
}

template <typename T, typename U, typename Config>
__aicore__ inline void Kernel(GM_ADDR x, GM_ADDR y, AscendC::TPipe* pipe)
{
    // 定义GlobalTensor
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)x);
    dstGlobal.SetGlobalBuffer((__gm__ U*)y);

    // 设置静态Tensor起始地址
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t yAddr = xAddr + size * sizeof(T) + 256;

    // 定义LocalTensor
    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, xAddr, size);
    AscendC::LocalTensor<U> dstLocal(AscendC::TPosition::VECOUT, yAddr, size * 2);

    // 执行性能测试&功能测试
    if constexpr (Config::testPerformance) {
        TestPerformance<T, U, Config>(srcLocal, dstLocal);
    } else {
        TestFunctionality<T, U, Config>(srcGlobal, dstGlobal, srcLocal, dstLocal);
    }
}

__global__ __vector__ void kernel(GM_ADDR x, GM_ADDR y)
{
    RUN(x, y, srcType, dstType, CurrentConfig);
}

template <typename T>
static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(T); i++) {
        T tmpA = (reinterpret_cast<const T*>(outputData))[i];
        T tmpB = (reinterpret_cast<const T*>(goldenData))[i];

        if (tmpA != tmpB) {
            printf("CompareResult golden.bin failed output is %d, golden is %d\n", tmpA, tmpB);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;

    size_t xByteSize = SIZE * sizeof(srcType);
    size_t outputByteSize = SIZE * 2 * sizeof(dstType);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *outHost;
    uint8_t *xDevice, *outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);

    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    bool goldenResult = true;
    goldenResult = CompareResult<dstType>(outHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
