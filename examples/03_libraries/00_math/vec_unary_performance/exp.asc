#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t TOTAL_LENGTH = INPUT_SIZE; // 输入数据长度
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE; // 输入数据类型
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000; // 指令重复执行次数（用于性能测试）

template <class T>
class KernelExp {
public:
    __aicore__ inline KernelExp() = default;
    __aicore__ inline void Init(GM_ADDR dstGm, GM_ADDR srcGm, uint32_t totalLength, uint32_t count,
                                AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcGm), totalLength);
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGm), totalLength);
        pipe->InitBuffer(inQueueX, 1, totalLength * sizeof(T));
        pipe->InitBuffer(outQueue, 1, totalLength * sizeof(T));
        bufferSize = totalLength;
        this->count = count;
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, bufferSize);
        inQueueX.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.AllocTensor<T>();
        AscendC::LocalTensor<T> srcLocal = inQueueX.DeQue<T>();

        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleBefore = AscendC::GetSystemCycle();
        for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXCUTE; ++i) {
            AscendC::Exp(dstLocal, srcLocal, TOTAL_LENGTH);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleAfter = AscendC::GetSystemCycle();
        AscendC::PRINTF("[LOG] systemCycleBefore: %d\n", systemCycleBefore);
        AscendC::PRINTF("[LOG] systemCycleAfter: %d\n", systemCycleAfter);
        AscendC::PRINTF("[LOG] Exp instruction has excuted %d times, cost total cycles: %d\n",
            REPEAT_TIMES_FOR_INSTR_EXCUTE, (systemCycleAfter - systemCycleBefore));

        // AscendC::Duplicate(dstLocal, (T)0, bufferSize);
        // if constexpr (INPUT_SCENARIO_NUM == 1 || INPUT_SCENARIO_NUM == 4) {
        //     // tensor前n个数据连续计算 (n取数据总长度的一半)
   	    //     AscendC::Exp(dstLocal, srcLocal, this->count / 2);
        // } else if constexpr (INPUT_SCENARIO_NUM == 2 || INPUT_SCENARIO_NUM == 5) {
        //     // tensor高维切分计算-mask连续模式
        //     uint32_t itemsPerIter = 256 / sizeof(T); // 每个迭代处理的元素个数
        //     uint32_t repeatTimes = this->count / itemsPerIter; // 重复多少个迭代
        //     uint64_t mask = 10; // 每个迭代前mask个元素参与计算
        //     AscendC::Exp(dstLocal, srcLocal, mask, repeatTimes, {2, 2, 16, 16});
        // } else if constexpr (INPUT_SCENARIO_NUM == 3 || INPUT_SCENARIO_NUM == 6) {
        //     // tensor高维切分计算-mask逐bit模式
        //     uint32_t itemsPerIter = 256 / sizeof(T);
        //     uint32_t repeatTimes = this->count / itemsPerIter;
        //     uint64_t mask[2] = {0x5555555555555555, 0x5555555555555555}; // 0b01010101...
        //     AscendC::Exp(dstLocal, srcLocal, mask, repeatTimes, {2, 2, 16, 16});
        // }
        outQueue.EnQue<T>(dstLocal);
        inQueueX.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, bufferSize);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    uint32_t bufferSize = 0;
    uint32_t count = 0;
};

__global__ __vector__ void exp_custom(GM_ADDR srcGm, GM_ADDR dstGm)
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelExp<half> op;
        op.Init(dstGm, srcGm, TOTAL_LENGTH, TOTAL_LENGTH, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelExp<float> op;
        op.Init(dstGm, srcGm, TOTAL_LENGTH, TOTAL_LENGTH, &pipe);
        op.Process();
    }
}

template <typename T>
static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(T); i++) {
        T tmpA = (reinterpret_cast<const T*>(outputData))[i];
        T tmpB = (reinterpret_cast<const T*>(goldenData))[i];

        float a = float(tmpA);
        float b = float(tmpB);

        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t dataTypeSize = sizeof(int16_t);
    if constexpr (INPUT_TENSOR_TYPE == 2) {
        dataTypeSize = sizeof(float);
    }
    size_t param1FileSize = TOTAL_LENGTH * dataTypeSize;
    size_t param2FileSize = TOTAL_LENGTH * dataTypeSize;
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* param1Host;
    uint8_t* param1Device;
    aclrtMallocHost((void**)(&param1Host), param1FileSize);
    aclrtMalloc((void**)&param1Device, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_src.bin", param1FileSize, param1Host, param1FileSize);
    aclrtMemcpy(param1Device, param1FileSize, param1Host, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* param2Host;
    uint8_t* param2Device;
    aclrtMallocHost((void**)(&param2Host), param2FileSize);
    aclrtMalloc((void**)&param2Device, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    exp_custom<<<numBlocks, nullptr, stream>>>(param1Device, param2Device);
    aclrtSynchronizeStream(stream);

    aclrtFree(param1Device);
    aclrtFreeHost(param1Host);

    aclrtMemcpy(param2Host, param2FileSize, param2Device, param2FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", param2Host, param2FileSize);

    bool goldenResult = true;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        goldenResult = CompareResult<half>(param2Host, param2FileSize);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        goldenResult = CompareResult<float>(param2Host, param2FileSize);
    }
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(param2Device);
    aclrtFreeHost(param2Host);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
