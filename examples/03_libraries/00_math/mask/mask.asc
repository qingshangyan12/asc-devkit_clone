/* !
 * \file mask.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;

template <typename T>
class KernelMask {
public:
    __aicore__ inline KernelMask() {}
    __aicore__ inline void Init(GM_ADDR srcGm, GM_ADDR dstGm, uint32_t srcSize, uint32_t scenarioIn,
                                AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcGm), srcSize);
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGm), srcSize);

        pipe->InitBuffer(inQueueSrc, 1, srcSize * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, srcSize * sizeof(T));
        bufferSize = srcSize;
        scenario = scenarioIn;
    }
    __aicore__ inline void Process()
    {
        AscendC::AscendCUtils::SetOverflow(1);
        CopyIn();
        Compute();
        CopyOut();
        AscendC::AscendCUtils::SetOverflow(0);
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, bufferSize);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::Duplicate(dstLocal, (T)0.0, bufferSize);
        if (scenario == 0) {
            // Normal 模式下，逐bit计算
            uint64_t mask[2] = {0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF};
            uint8_t repeatTimes = 1;
            AscendC::UnaryRepeatParams repeatParams{1, 1, 8, 8};
            T addsValue = 1.0;
            AscendC::SetMaskNorm();
            AscendC::Adds<T, true>(dstLocal, srcLocal, addsValue, mask, repeatTimes, repeatParams);
        } else if (scenario == 1) {
            // Normal 模式下，连续计算
            uint64_t mask = 128;
            uint8_t repeatTimes = 1;
            AscendC::UnaryRepeatParams repeatParams{1, 1, 8, 8};
            T addsValue = 1.0;
            AscendC::SetMaskNorm();
            AscendC::Adds<T, true>(dstLocal, srcLocal, addsValue, mask, repeatTimes, repeatParams);
        } else if (scenario == 2) {
            // Counter 模式下，前 n 个元素连续计算
            uint32_t count = 128;
            T addsValue = 1.0;
            AscendC::SetMaskCount();
            AscendC::Adds<T, true>(dstLocal, srcLocal, addsValue, count);
        } else if (scenario == 3) {
            // Counter 模式下，高维切分 + 连续计算
            uint64_t mask[2] = {130, 0};
            uint8_t repeatTimes = 1;
            AscendC::UnaryRepeatParams repeatParams{1, 1, 8, 8};
            T addsValue = 1.0;
            AscendC::SetMaskCount();
            AscendC::Adds<T, true>(dstLocal, srcLocal, addsValue, mask, repeatTimes, repeatParams);
            AscendC::SetMaskNorm();
        } else if (scenario == 4) {
            // 外部设置 mask，Normal 模式，逐 bit 模式
            AscendC::SetMaskNorm();
            AscendC::SetVectorMask<T, AscendC::MaskMode::NORMAL>(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF);
            uint8_t repeatTimes = 1;
            AscendC::UnaryRepeatParams repeatParams{2, 2, 16, 16};
            T addsValue = 1.0;
            AscendC::Adds<T, false>(dstLocal, srcLocal, addsValue, AscendC::MASK_PLACEHOLDER, repeatTimes, repeatParams);
            AscendC::ResetMask();
        } else if (scenario == 5) {
            // 外部设置 mask，Normal 模式，连续计算
            AscendC::SetMaskNorm();
            AscendC::SetVectorMask<T, AscendC::MaskMode::NORMAL>(128);
            uint8_t repeatTimes = 1;
            AscendC::UnaryRepeatParams repeatParams{1, 1, 8, 8};
            T addsValue = 1.0;
            AscendC::Adds<T, false>(dstLocal, srcLocal, addsValue, AscendC::MASK_PLACEHOLDER, repeatTimes, repeatParams);
            AscendC::ResetMask();
        } else if (scenario == 6) {
            // 外部设置 mask，Counter 模式，前 n 个元素连续计算
            AscendC::SetMaskCount();
            T addsValue = 1.0;
            AscendC::SetVectorMask<T, AscendC::MaskMode::COUNTER>(128);
            AscendC::Adds<T, false>(dstLocal, srcLocal, addsValue, 1);
            AscendC::SetMaskNorm();
            AscendC::ResetMask();
        } else if (scenario == 7) {
            // 外部设置 mask，Counter 模式，高维切分 + 连续模式
            AscendC::SetMaskCount();
            T addsValue = 1.0;
            AscendC::SetVectorMask<T, AscendC::MaskMode::COUNTER>(128);
            uint8_t repeatTimes = 1;
            AscendC::UnaryRepeatParams repeatParams{2, 2, 16, 16};
            AscendC::Adds<T, false>(dstLocal, srcLocal, addsValue, AscendC::MASK_PLACEHOLDER, repeatTimes, repeatParams);
            AscendC::SetMaskNorm();
            AscendC::ResetMask();
        }

        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, bufferSize);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueueDst;

    uint32_t bufferSize = 0;
    uint32_t scenario = 0;
};

__vector__ __global__ void mask_custom(GM_ADDR srcGm, GM_ADDR dstGm, int32_t scenario)
{
    AscendC::TPipe pipe;
    constexpr uint32_t srcSize = 512;
    KernelMask<half> op;
    op.Init(srcGm, dstGm, srcSize, scenario, &pipe);
    op.Process();
}

template <typename T>
static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(T); i++) {
        T aType = (reinterpret_cast<const T*>(outputData))[i];
        T bType = (reinterpret_cast<const T*>(goldenData))[i];

        float a = float(aType);
        float b = float(bType);

        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t param1FileSize = 512 * sizeof(half);
    size_t param2FileSize = 512 * sizeof(half);
    
    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* param1Host;
    uint8_t* param1Device;
    aclrtMallocHost((void**)(&param1Host), param1FileSize);
    aclrtMalloc((void**)&param1Device, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", param1FileSize, param1Host, param1FileSize);
    aclrtMemcpy(param1Device, param1FileSize, param1Host, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* param2Host;
    uint8_t* param2Device;
    aclrtMallocHost((void**)(&param2Host), param2FileSize);
    aclrtMalloc((void**)&param2Device, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    mask_custom<<<numBlocks, nullptr, stream>>>(param1Device, param2Device, scenarioNum);
    aclrtSynchronizeStream(stream);

    aclrtFree(param1Device);
    aclrtFreeHost(param1Host);

    aclrtMemcpy(param2Host, param2FileSize, param2Device, param2FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", param2Host, param2FileSize);

    bool goldenResult = true;
    goldenResult = CompareResult<half>(param2Host, param2FileSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(param2Device);
    aclrtFreeHost(param2Host);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}