/* !
 * \file mul_cast.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(srcType, dstType, testPerformance, mode, caseType)                                                         \
    AscendC::TPipe pipe;                                                                                               \
    KernelMulCast<srcType, dstType, testPerformance, mode, caseType> op;                                               \
    op.Init(x, y, z, &pipe);                                                                                           \
    op.Process();

#define NOT_SUPPORT AscendC::printf("not support!");

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

enum class Mode {
    USE_COUNT_MODE = 0,          // Axpy指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // Axpy指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // Axpy指令使用mask逐比特模式
};

enum class CaseType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};

template <typename T, typename U, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE,
          CaseType caseType = CaseType::NORMAL>
class KernelMulCast {
public:
    __aicore__ inline KernelMulCast() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        src0Global.SetGlobalBuffer((__gm__ T*)x);
        src1Global.SetGlobalBuffer((__gm__ T*)y);
        dstGlobal.SetGlobalBuffer((__gm__ U*)z);
        pipe->InitBuffer(inQueueX, 1, size * sizeof(T));
        pipe->InitBuffer(inQueueY, 1, size * sizeof(T));
        pipe->InitBuffer(outQueue, 1, size * sizeof(U));
    }
    __aicore__ inline void Process()
    {
        if constexpr (testPerformance) {
            TestPerformance();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }

private:
    __aicore__ inline void TestPerformance()
    {
        AscendC::LocalTensor<T> src0Local = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> src1Local = inQueueY.AllocTensor<T>();
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();

        constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
        for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
            ComputeCountMode(src0Local, src1Local, dstLocal);
        }

        inQueueX.FreeTensor(src0Local);
        inQueueY.FreeTensor(src1Local);
        outQueue.FreeTensor(dstLocal);
    }

    __aicore__ inline void ComputeCountMode(AscendC::LocalTensor<T>& src0Local, AscendC::LocalTensor<T>& src1Local,
                                            AscendC::LocalTensor<U>& dstLocal)
    {
        if constexpr (caseType == CaseType::SEPARATION) {
            AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
            pipe->InitBuffer(castBuf, size);
            AscendC::LocalTensor<T> tmp = castBuf.Get<T>();
            AscendC::Mul(tmp, src0Local, src1Local, size);
            AscendC::Cast(dstLocal, tmp, AscendC::RoundMode::CAST_RINT, size);
        } else if constexpr (caseType == CaseType::OVERLAP) {
            NOT_SUPPORT;
        } else {
            AscendC::MulCast(dstLocal, src0Local, src1Local, size);
        }
    }

    __aicore__ inline void ComputeContinuousMaskMode(AscendC::LocalTensor<T>& src0Local,
                                                     AscendC::LocalTensor<T>& src1Local,
                                                     AscendC::LocalTensor<U>& dstLocal)
    {
        constexpr uint16_t oneRepSize = 256 / sizeof(T);
        uint16_t repeatTimes = size / oneRepSize;
        AscendC::MulCast(dstLocal, src0Local, src1Local, oneRepSize, repeatTimes, {1, 1, 1, 4, 8, 8});
    }

    __aicore__ inline void ComputeBitwiseMaskMode(AscendC::LocalTensor<T>& src0Local,
                                                  AscendC::LocalTensor<T>& src1Local, AscendC::LocalTensor<U>& dstLocal)
    {
        constexpr uint16_t oneRepSize = 256 / sizeof(T);
        uint16_t repeatTimes = size / oneRepSize;
        uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
        AscendC::MulCast(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 4, 8, 8});
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> src0Local = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> src1Local = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(src0Local, src0Global, size);
        AscendC::DataCopy(src1Local, src1Global, size);
        inQueueX.EnQue(src0Local);
        inQueueY.EnQue(src1Local);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> src0Local = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> src1Local = inQueueY.DeQue<T>();
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();

        if constexpr (mode == Mode::USE_COUNT_MODE) {
            ComputeCountMode(src0Local, src1Local, dstLocal);
        } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
            ComputeContinuousMaskMode(src0Local, src1Local, dstLocal);
        } else {
            ComputeBitwiseMaskMode(src0Local, src1Local, dstLocal);
        }

        inQueueX.FreeTensor(src0Local);
        inQueueY.FreeTensor(src1Local);
        outQueue.EnQue<U>(dstLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> dstLocal = outQueue.DeQue<U>();
        AscendC::DataCopy(dstGlobal, dstLocal, size);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> src0Global, src1Global;
    AscendC::GlobalTensor<U> dstGlobal;
};

template <uint32_t N>
__aicore__ inline void RunMulCastScenario(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    if constexpr (N == 1) {
        RUN(half, int8_t, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (N == 2) {
        RUN(half, int8_t, false, Mode::USE_BITWISE_MASK_MODE, CaseType::NORMAL);
    } else if constexpr (N == 3) {
        RUN(half, int8_t, false, Mode::USE_CONTINUOUS_MODE_OF_MASK, CaseType::NORMAL);
    } else if constexpr (N == 4) {
        RUN(half, int8_t, false, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (N == 5) {
        RUN(half, int8_t, true, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (N == 6) {
        RUN(half, int8_t, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (N == 7) {
        RUN(half, uint8_t, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (N == 8) {
        RUN(half, uint8_t, false, Mode::USE_BITWISE_MASK_MODE, CaseType::NORMAL);
    } else if constexpr (N == 9) {
        RUN(half, uint8_t, false, Mode::USE_CONTINUOUS_MODE_OF_MASK, CaseType::NORMAL);
    } else if constexpr (N == 10) {
        RUN(half, uint8_t, false, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (N == 11) {
        RUN(half, uint8_t, true, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (N == 12) {
        RUN(half, uint8_t, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else {
        NOT_SUPPORT;
    }
}

__global__ __vector__ void kernel_mul_cast(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    RunMulCastScenario<scenarioNum>(x, y, z);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t xByteSize = 0;
    size_t yByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum >= 1 && scenarioNum <= 6) {
        xByteSize = SIZE * sizeof(int16_t);
        yByteSize = SIZE * sizeof(int16_t);
        outputByteSize = SIZE * sizeof(int8_t);
    } else {
        xByteSize = SIZE * sizeof(int16_t);
        yByteSize = SIZE * sizeof(int16_t);
        outputByteSize = SIZE * sizeof(uint8_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *outHost;
    uint8_t *xDevice, *yDevice, *outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&yHost), yByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);

    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_y.bin", yByteSize, yHost, yByteSize);
    aclrtMemcpy(yDevice, yByteSize, yHost, yByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_mul_cast<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}