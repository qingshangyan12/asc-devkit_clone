/* !
 * \file performance_verify.asc
 * \brief Performance verify operator for exp/mul/adds/leakyrelu with different data types and input sizes
 */

#include <cstdint>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t TOTAL_LENGTH = INPUT_SIZE;
constexpr uint32_t INPUT_API_ID_VAL = INPUT_API_ID;
constexpr uint32_t INPUT_API_TYPE_VAL = INPUT_API_TYPE;
constexpr uint32_t INPUT_DATA_TYPE_VAL = INPUT_DATA_TYPE;
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXECUTE = 1000;

#if INPUT_DATA_TYPE == 1
    #define DATATYPE_STR "float16"
#elif INPUT_DATA_TYPE == 2
    #define DATATYPE_STR "float32"
#elif INPUT_DATA_TYPE == 3
    #define DATATYPE_STR "int16"
#elif INPUT_DATA_TYPE == 4
    #define DATATYPE_STR "int32"
#else
    #define DATATYPE_STR "unknown"
#endif

#define API_ID_EXP   1
#define API_ID_MUL   2
#define API_ID_ADDS  3
#define API_ID_LEAKYRELU  4

#define API_TYPE_UNARY  1
#define API_TYPE_BINARY 2
#define API_TYPE_BINARY_SCALAR 3

template <class T>
class KernelPerformanceVerify {
public:
    __aicore__ inline KernelPerformanceVerify() = default;
    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR zGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        xGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), TOTAL_LENGTH);
        zGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(zGm), TOTAL_LENGTH);
        pipe->InitBuffer(inQueueX, 1, TOTAL_LENGTH * sizeof(T));
        pipe->InitBuffer(outQueue, 1, TOTAL_LENGTH * sizeof(T));
    }
    __aicore__ inline void Init(GM_ADDR xGm, GM_ADDR yGm, GM_ADDR zGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        xGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xGm), TOTAL_LENGTH);
        yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGm), TOTAL_LENGTH);
        zGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(zGm), TOTAL_LENGTH);
        pipe->InitBuffer(inQueueX, 1, TOTAL_LENGTH * sizeof(T));
        pipe->InitBuffer(inQueueY, 1, TOTAL_LENGTH * sizeof(T));
        pipe->InitBuffer(outQueue, 1, TOTAL_LENGTH * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        if constexpr (INPUT_API_ID_VAL == API_ID_EXP) {
            AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
            AscendC::DataCopy(xLocal, xGlobal, TOTAL_LENGTH);
            inQueueX.EnQue(xLocal);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_MUL || INPUT_API_ID_VAL == API_ID_ADDS ||
                              INPUT_API_ID_VAL == API_ID_LEAKYRELU) {
            AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
            AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
            AscendC::DataCopy(xLocal, xGlobal, TOTAL_LENGTH);
            AscendC::DataCopy(yLocal, yGlobal, TOTAL_LENGTH);
            inQueueX.EnQue(xLocal);
            inQueueY.EnQue(yLocal);
        }
    }
    __aicore__ inline void Compute()
    {
        if constexpr (INPUT_API_ID_VAL == API_ID_EXP) {
            AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
            AscendC::LocalTensor<T> zLocal = outQueue.AllocTensor<T>();
            
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleBegin = AscendC::GetSystemCycle();
            for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXECUTE; ++i) {
                AscendC::Exp(zLocal, xLocal, TOTAL_LENGTH);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleEnd = AscendC::GetSystemCycle();
            
            AscendC::PRINTF("  [LOG] Exp instruction executed %d times, data length: %d, data type: %s, cost total cycles: %d\n",
                REPEAT_TIMES_FOR_INSTR_EXECUTE, TOTAL_LENGTH, DATATYPE_STR, (cycleEnd - cycleBegin));
            
            outQueue.EnQue<T>(zLocal);
            inQueueX.FreeTensor(xLocal);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_MUL) {
            AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
            AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
            AscendC::LocalTensor<T> zLocal = outQueue.AllocTensor<T>();
            
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleBegin = AscendC::GetSystemCycle();
            for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXECUTE; ++i) {
                AscendC::Mul(zLocal, xLocal, yLocal, TOTAL_LENGTH);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleEnd = AscendC::GetSystemCycle();
            
            AscendC::PRINTF("  [LOG] Mul instruction executed %d times, data length: %d, data type: %s, cost total cycles: %d\n",
                REPEAT_TIMES_FOR_INSTR_EXECUTE, TOTAL_LENGTH, DATATYPE_STR, (cycleEnd - cycleBegin));
            
            outQueue.EnQue<T>(zLocal);
            inQueueX.FreeTensor(xLocal);
            inQueueY.FreeTensor(yLocal);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_ADDS) {
            AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
            AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
            AscendC::LocalTensor<T> zLocal = outQueue.AllocTensor<T>();
            
            T scalar = yLocal.GetValue(0);
            
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleBegin = AscendC::GetSystemCycle();
            for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXECUTE; ++i) {
                AscendC::Adds(zLocal, xLocal, scalar, TOTAL_LENGTH);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleEnd = AscendC::GetSystemCycle();
            
            AscendC::PRINTF("  [LOG] Adds instruction executed %d times, data length: %d, data type: %s, cost total cycles: %d\n",
                REPEAT_TIMES_FOR_INSTR_EXECUTE, TOTAL_LENGTH, DATATYPE_STR, (cycleEnd - cycleBegin));
            
            outQueue.EnQue<T>(zLocal);
            inQueueX.FreeTensor(xLocal);
            inQueueY.FreeTensor(yLocal);
        } else if constexpr (INPUT_API_ID_VAL == API_ID_LEAKYRELU) {
            AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
            AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
            AscendC::LocalTensor<T> zLocal = outQueue.AllocTensor<T>();
            
            T scalar = yLocal.GetValue(0);
            
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleBegin = AscendC::GetSystemCycle();
            for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXECUTE; ++i) {
                AscendC::LeakyRelu(zLocal, xLocal, scalar, TOTAL_LENGTH);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            uint64_t cycleEnd = AscendC::GetSystemCycle();
            
            AscendC::PRINTF("  [LOG] LeakyRelu instruction executed %d times, data length: %d, data type: %s, cost total cycles: %d\n",
                REPEAT_TIMES_FOR_INSTR_EXECUTE, TOTAL_LENGTH, DATATYPE_STR, (cycleEnd - cycleBegin));
            
            outQueue.EnQue<T>(zLocal);
            inQueueX.FreeTensor(xLocal);
            inQueueY.FreeTensor(yLocal);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(zGlobal, zLocal, TOTAL_LENGTH);
        outQueue.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> xGlobal;
    AscendC::GlobalTensor<T> yGlobal;
    AscendC::GlobalTensor<T> zGlobal;
};

__global__ __vector__ void performance_verify_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    
    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_UNARY) {
        if constexpr (INPUT_DATA_TYPE_VAL == 1) {
            KernelPerformanceVerify<half> op;
            op.Init(x, z, &pipe);
            op.Process();
        } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
            KernelPerformanceVerify<float> op;
            op.Init(x, z, &pipe);
            op.Process();
        } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
            KernelPerformanceVerify<int16_t> op;
            op.Init(x, z, &pipe);
            op.Process();
        } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
            KernelPerformanceVerify<int32_t> op;
            op.Init(x, z, &pipe);
            op.Process();
        }
    } else if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        if constexpr (INPUT_DATA_TYPE_VAL == 1) {
            KernelPerformanceVerify<half> op;
            op.Init(x, y, z, &pipe);
            op.Process();
        } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
            KernelPerformanceVerify<float> op;
            op.Init(x, y, z, &pipe);
            op.Process();
        } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
            KernelPerformanceVerify<int16_t> op;
            op.Init(x, y, z, &pipe);
            op.Process();
        } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
            KernelPerformanceVerify<int32_t> op;
            op.Init(x, y, z, &pipe);
            op.Process();
        }
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t dataTypeSize = sizeof(int16_t);
    if constexpr (INPUT_DATA_TYPE_VAL == 1) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
        dataTypeSize = sizeof(float);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
        dataTypeSize = sizeof(int16_t);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
        dataTypeSize = sizeof(int32_t);
    }
    size_t paramByteSize = TOTAL_LENGTH * dataTypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    aclrtMallocHost((void**)(&xHost), paramByteSize);
    aclrtMalloc((void**)&xDevice, paramByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", paramByteSize, xHost, paramByteSize);
    aclrtMemcpy(xDevice, paramByteSize, xHost, paramByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* zHost;
    uint8_t* zDevice;
    aclrtMallocHost((void**)(&zHost), paramByteSize);
    aclrtMalloc((void**)&zDevice, paramByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* yHost = nullptr;
    uint8_t* yDevice = nullptr;
    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        aclrtMallocHost((void**)(&yHost), paramByteSize);
        aclrtMalloc((void**)&yDevice, paramByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/input_y.bin", paramByteSize, yHost, paramByteSize);
        aclrtMemcpy(yDevice, paramByteSize, yHost, paramByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_UNARY) {
        performance_verify_kernel<<<1, nullptr, stream>>>(xDevice, 0, zDevice);
    } else {
        performance_verify_kernel<<<1, nullptr, stream>>>(xDevice, yDevice, zDevice);
    }
    aclrtSynchronizeStream(stream);

    aclrtFree(xDevice);
    aclrtFreeHost(xHost);

    aclrtMemcpy(zHost, paramByteSize, zDevice, paramByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, paramByteSize);

    aclrtFree(zDevice);
    aclrtFreeHost(zHost);

    if constexpr (INPUT_API_TYPE_VAL == API_TYPE_BINARY || INPUT_API_TYPE_VAL == API_TYPE_BINARY_SCALAR) {
        aclrtFree(yDevice);
        aclrtFreeHost(yHost);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
