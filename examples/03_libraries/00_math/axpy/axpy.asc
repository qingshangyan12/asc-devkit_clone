/* !
 * \file axpy.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(srcType, dstType, testPerformance, mode, caseType)                                                         \
    AscendC::TPipe pipe;                                                                                               \
    KernelAxpy<srcType, dstType, testPerformance, mode, caseType> op;                                                  \
    op.Init(x, y, &pipe);                                                                                              \
    op.Process();

#define NOT_SUPPORT AscendC::printf("not support!");

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

enum class Mode {
    USE_COUNT_MODE = 0,          // Axpy指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // Axpy指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // Axpy指令使用mask逐比特模式
};

enum class CaseType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};

template <typename T, typename U, bool testPerformance = false, Mode mode = Mode::USE_COUNT_MODE,
          CaseType caseType = CaseType::NORMAL>
class KernelAxpy {
public:
    __aicore__ inline KernelAxpy() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)x);
        dstGlobal.SetGlobalBuffer((__gm__ U*)y);
        pipe->InitBuffer(inQueue, 1, size * sizeof(T));
        pipe->InitBuffer(outQueue, 1, size * sizeof(U));
    }
    __aicore__ inline void Process()
    {
        if constexpr (testPerformance) {
            TestPerformance();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, size);
        inQueue.EnQue(srcLocal);
    }
    __aicore__ inline void TestPerformance()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.AllocTensor<T>();
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();

        // constexpr uint32_t REPEAT_TIMES_FOR_REPEAT_TEST = 1000;
        // AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleBefore = AscendC::GetSystemCycle();

        for (int32_t i = 0; i < REPEAT_TIMES_FOR_REPEAT_TEST; ++i) {
            if constexpr (caseType == CaseType::SEPARATION) {
                AscendC::Muls(srcLocal, srcLocal, (T)2.0, size);
                if constexpr (AscendC::IsSameType<T, U>::value) {
                    AscendC::Add(dstLocal, dstLocal, srcLocal, size);
                } else {
                    AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
                    pipe->InitBuffer(castBuf, size);
                    AscendC::LocalTensor<U> tmp = castBuf.Get<U>();
                    AscendC::Cast(tmp, srcLocal, AscendC::RoundMode::CAST_NONE, size);
                    AscendC::Add(dstLocal, dstLocal, tmp, size);
                }
            } else if constexpr (caseType == CaseType::OVERLAP) {
                AscendC::Axpy(dstLocal, dstLocal, (T)2.0, size);
            } else {
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, size);
            }
        }

        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleAfter = AscendC::GetSystemCycle();
        AscendC::printf("1000次执行耗时: %ld\n", systemCycleAfter - systemCycleBefore);

        inQueue.FreeTensor(srcLocal);
        outQueue.FreeTensor(dstLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.DeQue<T>();
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();
        AscendC::Duplicate(dstLocal, (U)0.0f, size);

        constexpr uint16_t oneRepSize = 256 / sizeof(U);
        uint16_t repeatTimes = size / oneRepSize;

        if constexpr (mode == Mode::USE_COUNT_MODE) {
            if constexpr (caseType == CaseType::NORMAL) {
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, size);
            } else if constexpr (caseType == CaseType::SEPARATION) {
                AscendC::Muls(srcLocal, srcLocal, (T)2.0, size);
                if constexpr (AscendC::IsSameType<T, U>::value) {
                    AscendC::Add(dstLocal, dstLocal, srcLocal, size);
                } else {
                    AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
                    pipe->InitBuffer(castBuf, size);
                    AscendC::LocalTensor<U> tmp = castBuf.Get<U>();
                    AscendC::Cast(tmp, srcLocal, AscendC::RoundMode::CAST_NONE, size);
                    AscendC::Add(dstLocal, dstLocal, tmp, size);
                }
            }
        } else if constexpr (mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
            if constexpr (AscendC::IsSameType<T, U>::value) {
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, oneRepSize, repeatTimes, {1, 1, 8, 8});
            } else {
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, oneRepSize, repeatTimes, {1, 1, 8, 4});
            }
        } else {
            if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, half>::value) {
                uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, mask, repeatTimes, {1, 1, 8, 8});
            } else if constexpr (AscendC::IsSameType<T, float>::value && AscendC::IsSameType<U, float>::value) {
                uint64_t mask[2] = {UINT64_MAX, 0};
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, mask, repeatTimes, {1, 1, 8, 8});
            } else {
                uint64_t mask[2] = {UINT64_MAX, 0};
                AscendC::Axpy(dstLocal, srcLocal, (T)2.0, mask, repeatTimes, {1, 1, 8, 4});
            }
        }

        inQueue.FreeTensor(srcLocal);
        outQueue.EnQue<U>(dstLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> dstLocal = outQueue.DeQue<U>();
        AscendC::DataCopy(dstGlobal, dstLocal, size);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U> dstGlobal;
};

__global__ __vector__ void kernel_axpy(GM_ADDR x, GM_ADDR y)
{
    AscendC::TPipe pipe;
    if constexpr (scenarioNum == 1) {
        RUN(half, half, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 2) {
        RUN(half, half, false, Mode::USE_BITWISE_MASK_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 3) {
        RUN(half, half, false, Mode::USE_CONTINUOUS_MODE_OF_MASK, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 4) {
        RUN(half, half, false, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (scenarioNum == 5) {
        RUN(half, half, true, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 6) {
        RUN(half, half, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (scenarioNum == 7) {
        RUN(half, half, true, Mode::USE_COUNT_MODE, CaseType::OVERLAP);
    } else if constexpr (scenarioNum == 8) {
        RUN(float, float, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 9) {
        RUN(float, float, false, Mode::USE_BITWISE_MASK_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 10) {
        RUN(float, float, false, Mode::USE_CONTINUOUS_MODE_OF_MASK, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 11) {
        RUN(float, float, false, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (scenarioNum == 12) {
        RUN(float, float, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 13) {
        RUN(float, float, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (scenarioNum == 14) {
        RUN(float, float, true, Mode::USE_COUNT_MODE, CaseType::OVERLAP);
    } else if constexpr (scenarioNum == 15) {
        RUN(half, float, false, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 16) {
        RUN(half, float, false, Mode::USE_BITWISE_MASK_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 17) {
        RUN(half, float, false, Mode::USE_CONTINUOUS_MODE_OF_MASK, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 18) {
        RUN(half, float, false, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else if constexpr (scenarioNum == 19) {
        RUN(half, float, true, Mode::USE_COUNT_MODE, CaseType::NORMAL);
    } else if constexpr (scenarioNum == 20) {
        RUN(half, float, true, Mode::USE_COUNT_MODE, CaseType::SEPARATION);
    } else {
        NOT_SUPPORT;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum >= 1 && scenarioNum <= 7) {
        inputByteSize = SIZE * sizeof(int16_t);
        outputByteSize = SIZE * sizeof(int16_t);
    } else if constexpr (scenarioNum >= 8 && scenarioNum <= 14) {
        inputByteSize = SIZE * sizeof(int32_t);
        outputByteSize = SIZE * sizeof(int32_t);
    } else {
        inputByteSize = SIZE * sizeof(int16_t);
        outputByteSize = SIZE * sizeof(int32_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost;
    uint8_t* xDevice;
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_axpy<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}