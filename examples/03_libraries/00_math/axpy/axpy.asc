/* !
 * \file axpy.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

enum Mode {
    USE_COUNT_MODE = 0;
    USE_CONTINUOUS_MODE_OF_MASK;
    USE_BITWISE_MASK_MODE;
};

struct Config {
    bool separation = false;
    bool overlap = false;
    bool testPerformance = false;
    Mode mode = Mode::USE_COUNT_MODE;
};

template<typename T, typename U, Config config>
class KernelAxpy {
public:
    __aicore__ inline KernelAxpy() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        srcGlobal.SetGlobalBuffer((__gm__ T*)x);
        dstGlobal.SetGlobalBuffer((__gm__ U*)y);
        pipe.InitBuffer(inQueue, 1, size * sizeof(T));
        pipe.InitBuffer(outQueue, 1, size * sizeof(U));
    }
    __aicore__ inline void Process()
    {
        if constexpr (config.testPerformance){
            Compute();
        } else {
            CopyIn();
            Compute();
            CopyOut();
        }
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueue.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, size);
        inQueue.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal;
        if constexpr (config.testPerformance){
            srcLocal = inQueue.AllocTensor<T>();
        } else {
            srcLocal = inQueue.DeQue<T>();
        }
        AscendC::LocalTensor<U> dstLocal = outQueue.AllocTensor<U>();
        AscendC::Duplicate(dstLocal, (U)0.0f, size);
 
        if constexpr (config.separation && config.testPerformance) {
            AscendC::Muls(srcLocal, srcLocal, (T)2.0, size);
            if constexpr (AscendC::IsSameType<T, U>::value){
                AscendC::Add(dstLocal, dstLocal, srcLocal, size);
            } else {
                AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
                pipe.InitBuffer(castBuf, size);
                AscendC::LocalTensor<U> tmp = castBuf.Get<U>();
                AscendC::Cast(tmp, srcLocal, AscendC::RoundMode::CAST_CEIL, size);
                AscendC::Add(dstLocal, dstLocal, tmp, size);
            }
        } else if constexpr (config.overlap && config.testPerformance) {
            if constexpr (!AscendC::IsSameType<T, U>::value) {
                AscendC::Axpy(srcLocal, srcLocal, (T)2.0, size);
                AscendC::TBuf<AscendC::TPosition::VECCALC> castBuf;
                pipe.InitBuffer(castBuf, size);
                AscendC::LocalTensor<U> tmp = castBuf.Get<U>();
                AscendC::Cast(tmp, srcLocal, AscendC::RoundMode::CAST_CEIL, size);
                AscendC::DataCopy(dstLocal, tmp, size);
            } else {
                AscendC::Axpy(dstLocal, dstLocal, (T)2.0, size);
            }
        } else {
            AscendC::Axpy(dstLocal, srcLocal, (T)2.0, size);
        }
 
        inQueue.FreeTensor(srcLocal);
        if constexpr (config.testPerformance) {
            outQueue.FreeTensor(dstLocal);
        } else {
            outQueue.EnQue<U>(dstLocal);
        }
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<U> dstLocal = outQueue.DeQue<U>();
        AscendC::DataCopy(dstGlobal, dstLocal, size);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<U> dstGlobal;
};

__global__ __vector__ void kernel_axpy(GM_ADDR x, GM_ADDR y)
{
    if constexpr (scenarioNum == 1){
        Config config;
        KernelAxpy<half, half, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 2){
        Config config;
        config.mode = Mode::USE_CONTINUOUS_MODE_OF_MASK = true;
        KernelAxpy<half, half, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 3){
        Config config;
        config.mode = Mode::USE_BITWISE_MASK_MODE = true;
        KernelAxpy<half, half, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 4){
        Config config;
        config.testPerformance = true;
        KernelAxpy<half, half, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 5){
        Config config;
        config.testPerformance = true;
        config.separation = true;
        KernelAxpy<half, half, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 6){
        Config config;
        config.testPerformance = true;
        config.overlap = true;
        KernelAxpy<half, half, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 7){
        Config config;
        KernelAxpy<float, float, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 8){
        Config config;
        KernelAxpy<half, float, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 9){
        Config config;
        config.testPerformance = true;
        KernelAxpy<half, float, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 10){
        Config config;
        conifg.testPerformance = true;
        config.separation = true;
        KernelAxpy<half, float, config> op;
        op.Init(x, y);
        op.Process();
    } else if constexpr (scenarioNum == 11){
        Config config;
        config.testPerformance = true;
        config.overlap = true;
        KernelAxpy<half, float, conifg> op;
        op.Init(x, y);
        op.Process();
    } else {
        AscendC::printf("not support!");
    }
}

int32_t main(int32_t argc, char *argv[]) {
  uint32_t numBlocks = 1;
  size_t inputByteSize = 0;
  size_t outputByteSize = 0;
  
  if constexpr (scenarioNum >= 1 && scenarioNum <= 6){
    inputByteSize = SIZE * sizeof(int16_t);
    outputByteSize = SIZE * sizeof(int16_t);
  } else if constexpr (scenarioNum == 7){
    inputByteSize = SIZE * sizeof(int32_t);
    outputByteSize = SIZE * sizeof(int32_t);
  } else {
    inputByteSize = SIZE * sizeof(int16_t);
    outputByteSize = SIZE * sizeof(int32_t);
  }

  int32_t deviceId = 0;
  aclrtSetDevice(deviceId);
  aclrtStream stream = nullptr;
  aclrtCreateStream(&stream);

  uint8_t *xHost, *outHost;
  uint8_t *xDevice, *outDevice;

  aclrtMallocHost((void **)(&xHost), inputByteSize);
  aclrtMallocHost((void **)(&outHost), outputByteSize);
  aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
  aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

  ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
  aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
              ACL_MEMCPY_HOST_TO_DEVICE);

  kernel_axpy<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
  aclrtSynchronizeStream(stream);

  aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
              ACL_MEMCPY_DEVICE_TO_HOST);
  WriteFile("./output/output.bin", outHost, outputByteSize);

  aclrtFree(xDevice);
  aclrtFree(outDevice);
  aclrtFreeHost(xHost);
  aclrtFreeHost(outHost);

  aclrtDestroyStream(stream);
  aclrtResetDevice(deviceId);
  aclFinalize();

  return 0;
}