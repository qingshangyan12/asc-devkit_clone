#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t SRC_SIZE = 512;
constexpr uint32_t DST_SIZE = 128;
constexpr uint32_t OFFSET_SIZE = 128;
constexpr uint32_t WEIGHT_SIZE = 128;

template <typename T>
class KernelBilinearInterp {
public:
    __aicore__ inline KernelBilinearInterp() = default;
    __aicore__ inline void Init(GM_ADDR srcGm, GM_ADDR weightGm, GM_ADDR offsetGm, GM_ADDR dstGm,
                                uint32_t srcSize, uint32_t dstSize, uint32_t offsetSize, uint32_t weightSize,
                                AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(srcGm), srcSize);
        weightGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(weightGm), weightSize);
        offsetGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(offsetGm), offsetSize);
        dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGm), dstSize);

        pipe->InitBuffer(inQueueSrc, 1, srcSize * sizeof(T));
        pipe->InitBuffer(inQueueWeight, 1, weightSize * sizeof(T));
        pipe->InitBuffer(inQueueOffset, 1, offsetSize * sizeof(uint32_t));
        pipe->InitBuffer(outQueue, 1, dstSize * sizeof(T));
        pipe->InitBuffer(tmpQueue, 1, srcSize * sizeof(T) * 32 + weightSize * sizeof(T) * 32);

        this->srcSize = srcSize;
        this->dstSize = dstSize;
        this->offsetSize = offsetSize;
        this->weightSize = weightSize;
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::LocalTensor<T> weightLocal = inQueueWeight.AllocTensor<T>();
        AscendC::LocalTensor<uint32_t> offsetLocal = inQueueOffset.AllocTensor<uint32_t>();

        AscendC::DataCopy(srcLocal, srcGlobal, srcSize);
        AscendC::DataCopy(weightLocal, weightGlobal, weightSize);
        AscendC::DataCopy(offsetLocal, offsetGlobal, offsetSize);

        inQueueSrc.EnQue<T>(srcLocal);
        inQueueWeight.EnQue<T>(weightLocal);
        inQueueOffset.EnQue<uint32_t>(offsetLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> weightLocal = inQueueWeight.DeQue<T>();
        AscendC::LocalTensor<uint32_t> offsetLocal = inQueueOffset.DeQue<uint32_t>();
        AscendC::LocalTensor<T> dstLocal = outQueue.AllocTensor<T>();
        AscendC::LocalTensor<uint8_t> tmpLocal = tmpQueue.AllocTensor<uint8_t>();

        AscendC::Duplicate(dstLocal, static_cast<T>(0), dstSize);

        uint64_t mask = 8;
        uint8_t hRepeat = 2;
        bool repeatMode = true;
        uint16_t dstBlkStride = 1;
        uint16_t vROffset = 16;
        uint8_t vRepeat = 8;

        AscendC::BilinearInterpolation(dstLocal, srcLocal, offsetLocal, weightLocal, mask, hRepeat,
                                       repeatMode, dstBlkStride, vROffset, vRepeat, tmpLocal);

        outQueue.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
        inQueueWeight.FreeTensor(weightLocal);
        inQueueOffset.FreeTensor(offsetLocal);
        tmpQueue.FreeTensor(tmpLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dstSize);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueWeight;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueOffset;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::TQue<AscendC::QuePosition::VECCALC, 1> tmpQueue;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> weightGlobal;
    AscendC::GlobalTensor<uint32_t> offsetGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    uint32_t srcSize = 0;
    uint32_t dstSize = 0;
    uint32_t offsetSize = 0;
    uint32_t weightSize = 0;
};

__global__ __vector__ void bilinear_interp_custom(GM_ADDR srcGm, GM_ADDR weightGm, GM_ADDR offsetGm, GM_ADDR dstGm)
{
    AscendC::TPipe pipe;
    KernelBilinearInterp<half> op;
    op.Init(srcGm, weightGm, offsetGm, dstGm, SRC_SIZE, DST_SIZE, OFFSET_SIZE, WEIGHT_SIZE, &pipe);
    op.Process();
}

template <typename T>
static void PrintTensor(const char* name, const T* data, uint32_t size, uint32_t maxPrint = 16)
{
    printf("%s (first %u elements): ", name, maxPrint < size ? maxPrint : size);
    uint32_t count = maxPrint < size ? maxPrint : size;
    for (uint32_t i = 0; i < count; i++) {
        printf("%.4f ", static_cast<float>(data[i]));
    }
    if (maxPrint < size) {
        printf("... (total %u)", size);
    }
    printf("\n");
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t dataTypeSize = sizeof(half);
    constexpr uint32_t srcByteSize = SRC_SIZE * dataTypeSize;
    constexpr uint32_t dstByteSize = DST_SIZE * dataTypeSize;
    constexpr uint32_t offsetByteSize = OFFSET_SIZE * sizeof(uint32_t);
    constexpr uint32_t weightByteSize = WEIGHT_SIZE * dataTypeSize;

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* srcHost;
    uint8_t* srcDevice;
    aclrtMallocHost((void**)(&srcHost), srcByteSize);
    aclrtMalloc((void**)&srcDevice, srcByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t srcFileSize = srcByteSize;
    ReadFile("./input/input_src.bin", srcFileSize, srcHost, srcByteSize);

    uint8_t* weightHost;
    uint8_t* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightByteSize);
    aclrtMalloc((void**)&weightDevice, weightByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t weightFileSize = weightByteSize;
    ReadFile("./input/input_weight.bin", weightFileSize, weightHost, weightByteSize);

    uint8_t* offsetHost;
    uint8_t* offsetDevice;
    aclrtMallocHost((void**)(&offsetHost), offsetByteSize);
    aclrtMalloc((void**)&offsetDevice, offsetByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t offsetFileSize = offsetByteSize;
    ReadFile("./input/input_offset.bin", offsetFileSize, offsetHost, offsetByteSize);

    uint8_t* dstHost;
    uint8_t* dstDevice;
    aclrtMallocHost((void**)(&dstHost), dstByteSize);
    aclrtMalloc((void**)&dstDevice, dstByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDevice, srcByteSize, srcHost, srcByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(weightDevice, weightByteSize, weightHost, weightByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(offsetDevice, offsetByteSize, offsetHost, offsetByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    printf("=== BilinearInterpolation API Test ===\n");
    PrintTensor("src", reinterpret_cast<half*>(srcHost), SRC_SIZE, 16);
    PrintTensor("weight", reinterpret_cast<half*>(weightHost), WEIGHT_SIZE, 16);
    PrintTensor("offset", reinterpret_cast<half*>(offsetHost), OFFSET_SIZE, 16);

    bilinear_interp_custom<<<1, nullptr, stream>>>(srcDevice, weightDevice, offsetDevice, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, dstByteSize, dstDevice, dstByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    PrintTensor("dst", reinterpret_cast<half*>(dstHost), DST_SIZE, 16);

    WriteFile("./output/output_dst.bin", dstHost, dstByteSize);

    printf("=== Test completed ===\n");
    printf("Note: BilinearInterpolation API is designed for deformable convolution/ROI pooling,\n");
    printf("      not for general bilinear interpolation on images.\n");

    aclrtFree(srcDevice);
    aclrtFree(weightDevice);
    aclrtFree(offsetDevice);
    aclrtFree(dstDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(weightHost);
    aclrtFreeHost(offsetHost);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
