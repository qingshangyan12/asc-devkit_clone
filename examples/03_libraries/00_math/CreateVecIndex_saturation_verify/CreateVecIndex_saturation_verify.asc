/* !
 * \file CreateVecIndex_saturation_verify.asc
 * \brief Saturation verify operator for CreateVecIndex API
 */

#include <cstdint>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_TENSOR_SIZE = INPUT_SIZE;
constexpr uint32_t INPUT_DATA_TYPE_VAL = INPUT_DATA_TYPE;
constexpr uint32_t INPUT_FIRST_VALUE_ID_VAL = INPUT_FIRST_VALUE_ID;

constexpr uint32_t BUFFER_NUM = 1;

#define FIRST_VALUE_MIN   1
#define FIRST_VALUE_MAX   2
#define FIRST_VALUE_POS_ZERO   3
#define FIRST_VALUE_NEG_ZERO   4
#define FIRST_VALUE_POS_INF   5
#define FIRST_VALUE_NEG_INF   6
#define FIRST_VALUE_NAN   7

struct CreateVecIndexTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

template <class T>
class KernelCreateVecIndex {
public:
    __aicore__ inline KernelCreateVecIndex() {}
    __aicore__ inline void Init(__gm__ uint8_t* dstGm, __gm__ uint8_t* srcGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        pipe->InitBuffer(inQueueSrc, 1, INPUT_TENSOR_SIZE * sizeof(T));
        pipe->InitBuffer(outQueueDst, BUFFER_NUM, INPUT_TENSOR_SIZE * sizeof(T));
    }

    __aicore__ inline void SetSatMode(bool isSaturation)
    {
        if constexpr (INPUT_DATA_TYPE_VAL == 1 || INPUT_DATA_TYPE_VAL == 2) {
            if (isSaturation) {
                set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_48_BIT));
            } else {
                set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_48_BIT));
            }
        } else {
            if (isSaturation) {
                set_ctrl(sbitset1(get_ctrl(), AscendC::CTRL_53_BIT));
            } else {
                set_ctrl(sbitset0(get_ctrl(), AscendC::CTRL_53_BIT));
            }
        }
    }

    __aicore__ inline void Process(bool isSaturation)
    {
        CopyIn();
        Compute();
        CopyOut();
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, INPUT_TENSOR_SIZE);
        inQueueSrc.EnQue<T>(srcLocal);
        
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
        AscendC::Duplicate(dstLocal, T(0), INPUT_TENSOR_SIZE);
        outQueueDst.EnQue<T>(dstLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        
        T firstValue = srcLocal.GetValue(0);
        AscendC::CreateVecIndex(dstLocal, firstValue, INPUT_TENSOR_SIZE);
        
        inQueueSrc.FreeTensor(srcLocal);
        outQueueDst.EnQue<T>(dstLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, INPUT_TENSOR_SIZE);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
};

__global__ __vector__ void createvecindex_kernel_sat(GM_ADDR x, GM_ADDR z, CreateVecIndexTilingData tiling)
{
    AscendC::TPipe pipe;
    
    if constexpr (INPUT_DATA_TYPE_VAL == 1) {
        KernelCreateVecIndex<half> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(true);
        op.Process(true);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
        KernelCreateVecIndex<float> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(true);
        op.Process(true);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
        KernelCreateVecIndex<int16_t> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(true);
        op.Process(true);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
        KernelCreateVecIndex<int32_t> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(true);
        op.Process(true);
    }
}

__global__ __vector__ void createvecindex_kernel_non_sat(GM_ADDR x, GM_ADDR z, CreateVecIndexTilingData tiling)
{
    AscendC::TPipe pipe;
    
    if constexpr (INPUT_DATA_TYPE_VAL == 1) {
        KernelCreateVecIndex<half> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(false);
        op.Process(false);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
        KernelCreateVecIndex<float> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(false);
        op.Process(false);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
        KernelCreateVecIndex<int16_t> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(false);
        op.Process(false);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
        KernelCreateVecIndex<int32_t> op;
        op.Init(z, x, &pipe);
        op.SetSatMode(false);
        op.Process(false);
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    uint32_t dataTypeSize = sizeof(half);
    if constexpr (INPUT_DATA_TYPE_VAL == 1) {
        dataTypeSize = sizeof(half);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 2) {
        dataTypeSize = sizeof(float);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 3) {
        dataTypeSize = sizeof(int16_t);
    } else if constexpr (INPUT_DATA_TYPE_VAL == 4) {
        dataTypeSize = sizeof(int32_t);
    }
    
    size_t inputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;
    size_t outputByteSize = INPUT_TENSOR_SIZE * dataTypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHostNonSat, *zHostSat;
    uint8_t *xDevice, *zDeviceNonSat, *zDeviceSat;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHostNonSat), outputByteSize);
    aclrtMallocHost((void **)(&zHostSat), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDeviceNonSat, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDeviceSat, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    
    system("mkdir -p ../output");
    
    ReadFile("../input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    
    CreateVecIndexTilingData tiling = {INPUT_TENSOR_SIZE, numBlocks};
    
    createvecindex_kernel_sat<<<numBlocks, nullptr, stream>>>(xDevice, zDeviceSat, tiling);
    aclrtSynchronizeStream(stream);
    createvecindex_kernel_non_sat<<<numBlocks, nullptr, stream>>>(xDevice, zDeviceNonSat, tiling);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(zHostNonSat, outputByteSize, zDeviceNonSat, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(zHostSat, outputByteSize, zDeviceSat, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("../output/output_non_sat.bin", zHostNonSat, outputByteSize);
    WriteFile("../output/output_sat.bin", zHostSat, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDeviceNonSat);
    aclrtFree(zDeviceSat);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHostNonSat);
    aclrtFreeHost(zHostSat);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    return 0;
}