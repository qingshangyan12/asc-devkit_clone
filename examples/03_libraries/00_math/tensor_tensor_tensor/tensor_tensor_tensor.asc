/* !
 * \file mul_add_dst.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#define RUN(x, y, z, ...)                                                                                              \
    AscendC::TPipe pipe;                                                                                               \
    Kernel<__VA_ARGS__>(x, y, z, &pipe);

#define NOT_SUPPORT AscendC::printf("not support!");

enum class Mode {
    USE_COUNT_MODE = 0,          // Axpy指令使用count模式
    USE_CONTINUOUS_MODE_OF_MASK, // Axpy指令使用mask连续模式
    USE_BITWISE_MASK_MODE        // Axpy指令使用mask逐比特模式
};

enum class CaseType {
    NORMAL = 0, // 基础场景，调用
    SEPARATION, // 分解复合指令
    OVERLAP     // 操作数重叠
};

template <ComputeMode Mode, CaseType Type, bool PerfTest = false>
struct KernelConfig {
    static constexpr ComputeMode mode = Mode;
    static constexpr CaseType type = Type;
    static constexpr bool testPerformance = PerfTest;
};

/************************ 用户可自定义配置 ********************** */
constexpr uint32_t size = SIZE;
using srcType = half;
using dstType = half;
using CurrentConfig = KernelConfig<ComputeMode::USE_COUNT_MODE, TestType::NORMAL, false>;
#define TEMPLATE_API TEMPLATE_API
/************************************************************** */

/*********************** 定制计算，用于与AscendC指令比较性能、精度 *********************/
template <typename T, typename U, typename Config>
__aicore__ inline void CustomCompute(AscendC::LocalTensor<T>& src0Local, AscendC::LocalTensor<T>& src1Local,
                                     AscendC::LocalTensor<U>& dstLocal)
{
    // MulAddDst拆分
    if constexpr (!AscendC::IsSameType<T, U>::value) {
        constexpr uint32_t tmp1Addr = size * sizeof(T) * 2 + size * sizeof(U) + 256;
        constexpr uint32_t tmp2Addr = tmp1Addr + size * sizeof(U);
        AscendC::LocalTensor<U> tmp1(AscendC::TPosition::VECVALC, tmp1Addr, size);
        AscendC::LocalTensor<U> tmp2(AscendC::TPosition::VECVALC, tmp2Addr, size);
        AscendC::Cast(tmp1, src0Local, AscendC::RoundMode::CAST_NONE, size);
        AscendC::Cast(tmp2, src1Local, AscendC::RoundMode::CAST_NONE, size);
        AscendC::Mul(tmp1, tmp1, tmp2, size);
        AscendC::Add(dstLocal, dstLocal, tmp1, size);
    } else {
        AscendC::Mul(src0Local, src0Local, src1Local, size);
        AscendC::Add(dstLocal, src0Local, dstLocal, size);
    }

    // MulCast拆分
    // AscendC::Mul(src0Local, src0Local, src1Local, size);
    // AscendC::Cast(dstLocal, src0Local, AscendC::RoundMode::CAST_NONE, size);
}
/**************************************************************************************/

template <typename T, typename U, typename Config>
__aicore__ inline void ComputeCountMode(AscendC::LocalTensor<T>& src0Local, AscendC::LocalTensor<T>& src1Local,
                                        AscendC::LocalTensor<U>& dstLocal)
{
    if constexpr (Config::type == CaseType::SEPARATION) {
        CustomCompute<T, U, Config>(src0Local, src1Local, dstLocal);
    } else if constexpr (Config::type == CaseType::OVERLAP) {
        AscendC::TEMPLATE_API(dstLocal, dstLocal, dstLocal, size);
    } else {
        AscendC::TEMPLATE_API(dstLocal, src0Local, src1Local, size);
    }
}

template <typename T, typename U, typename Config>
__aicore__ inline void ComputeContinuousMaskMode(AscendC::LocalTensor<T>& src0Local, AscendC::LocalTensor<T>& src1Local,
                                                 AscendC::LocalTensor<U>& dstLocal)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(U);
    uint16_t repeatTimes = size / oneRepSize;
    if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, float>::value) {
        AscendC::TEMPLATE_API(dstLocal, src0Local, src1Local, oneRepSize, repeatTimes, {1, 1, 1, 8, 4, 4});
    } else {
        AscendC::TEMPLATE_API(dstLocal, src0Local, src1Local, oneRepSize, repeatTimes, {1, 1, 1, 8, 8, 8});
    }
}

template <typename T, typename U, typename Config>
__aicore__ inline void ComputeBitwiseMaskMode(AscendC::LocalTensor<T>& src0Local, AscendC::LocalTensor<T>& src1Local,
                                              AscendC::LocalTensor<U>& dstLocal)
{
    constexpr uint16_t oneRepSize = 256 / sizeof(U);
    uint16_t repeatTimes = size / oneRepSize;
    if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, float>::value) {
        uint64_t mask[2] = {UINT64_MAX, 0};
        AscendC::TEMPLATE_API(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 8, 4, 4});
    } else if constexpr (AscendC::IsSameType<T, half>::value && AscendC::IsSameType<U, half>::value) {
        uint64_t mask[2] = {UINT64_MAX, UINT64_MAX};
        AscendC::TEMPLATE_API(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 8, 8, 8});
    } else {
        uint64_t mask[2] = {UINT64_MAX};
        AscendC::TEMPLATE_API(dstLocal, src0Local, src1Local, mask, repeatTimes, {1, 1, 1, 8, 8, 8});
    }
}

template <typename T, typename U, typename Config>
__aicore__ inline void TestPerformance(AscendC::LocalTensor<T>& src0Local, AscendC::LocalTensor<T>& src1Local,
                                       AscendC::LocalTensor<U>& dstLocal)
{
    constexpr uint32_t REPEAT_TIMES_FOR_PERF_TEST = 1000;
    for (uint32_t i = 0; i < REPEAT_TIMES_FOR_PERF_TEST; ++i) {
        ComputeCountMode<T, U, Config>(src0Local, src1Local, dstLocal);
    }
}

template <typename T, typename U, typename Config>
__aicore__ inline void TestFunctionality(AscendC::GlobalTensor<T>& src0Global, AscendC::GlobalTensor<T>& src1Global,
                                         AscendC::GlobalTensor<U>& dstGlobal, AscendC::LocalTensor<T>& src0Local,
                                         AscendC::LocalTensor<T>& src1Local, AscendC::LocalTensor<U>& dstLocal)
{
    AscendC::DataCopy(src0Local, src0Global, size);
    AscendC::DataCopy(src1Local, src1Global, size);
    AscendC::DataCopy(dstLocal, dstGlobal, size);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    if constexpr (Config::mode == Mode::USE_COUNT_MODE) {
        ComputeCountMode<T, U, Config>(src0Local, src1Local, dstLocal);
    } else if constexpr (Config::mode == Mode::USE_CONTINUOUS_MODE_OF_MASK) {
        ComputeContinuousMaskMode<T, U, Config>(src0Local, src1Local, dstLocal);
    } else {
        ComputeBitwiseMaskMode<T, U, Config>(src0Local, src1Local, dstLocal);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGlobal, dstLocal, size);
}

template <typename T, typename U, typename Config>
__aicore__ inline void Kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, AscendC::TPipe* pipe)
{
    // 定义GlobalTensor
    AscendC::GlobalTensor<T> src0Global, src1Global;
    AscendC::GlobalTensor<U> dstGlobal;
    src0Global.SetGlobalBuffer((__gm__ T*)x);
    src1Global.SetGlobalBuffer((__gm__ T*)y);
    dstGlobal.SetGlobalBuffer((__gm__ U*)z);

    // 设置静态Tensor起始地址
    constexpr uint32_t xAddr = 0;
    constexpr uint32_t yAddr = xAddr + size * sizeof(T) + 256;
    constexpr uint32_t zAddr = yAddr + size * sizeof(T);

    // 定义LocalTensor
    AscendC::LocalTensor<T> src0Local(AscendC::TPosition::VECCALC, xAddr, size);
    AscendC::LocalTensor<T> src1Local(AscendC::TPosition::VECCALC, yAddr, size);
    AscendC::LocalTensor<U> dstLocal(AscendC::TPosition::VECOUT, zAddr, size);

    // 执行性能测试&功能测试
    if constexpr (testPerformance) {
        TestPerformance<T, U, Config>(src0Local, src1Local, dstLocal);
    } else {
        TestFunctionality<T, U, Config>(src0Global, src1Global, dstGlobal, src0Local, src1Local, dstLocal);
    }
}

__global__ __vector__ void kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    RUN(x, y, z, srcType, dstType, CurrentConfig);
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;

    size_t xByteSize = SIZE * sizeof(srcType);
    size_t yByteSize = SIZE * sizeof(srcType);
    size_t outputByteSize = SIZE * sizeof(dstType);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *outHost;
    uint8_t *xDevice, *yDevice, *outDevice;

    aclrtMallocHost((void**)(&xHost), xByteSize);
    aclrtMallocHost((void**)(&yHost), yByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);

    aclrtMalloc((void**)&xDevice, xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", xByteSize, xHost, xByteSize);
    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    ReadFile("./input/input_y.bin", yByteSize, yHost, yByteSize);
    aclrtMemcpy(yDevice, yByteSize, yHost, yByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}