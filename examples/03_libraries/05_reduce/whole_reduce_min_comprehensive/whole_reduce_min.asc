/* !
 * \file whole_reduce_min.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t srcDataSize = SRC_DATA_SIZE;

enum class Mode {
    USE_CONTINUOUS_MASK_MODE = 0,   // 使用mask连续模式
    USE_BITWISE_MASK_MODE           // 使用mask逐比特模式
};

template <typename T, Mode mode = Mode::USE_CONTINUOUS_MASK_MODE>
class KernelReduce {
public:
    __aicore__ inline KernelReduce() {}
    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* dstGm)
    {
        srcGlobal.SetGlobalBuffer((__gm__ T*)src);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        uint16_t oneRepSize = 256 / sizeof(T);
        repeatTime = srcDataSize / oneRepSize;
        tailMask = srcDataSize % oneRepSize;
        dstDataSize = (tailMask > 0) ? (repeatTime + 1) * 2 : repeatTime * 2;
        uint16_t oneBlockSize = 32 / sizeof(T);
        dstDataSize = ((dstDataSize + oneBlockSize - 1) / oneBlockSize) * oneBlockSize; // 32B对齐
        pipe.InitBuffer(inQueueSrc, 1, srcDataSize * sizeof(T));
        pipe.InitBuffer(outQueueDst, 1, dstDataSize * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, srcDataSize);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
        // 使用默认order, ReduceOrder::ORDER_VALUE_INDEX
        if constexpr (mode == Mode::USE_CONTINUOUS_MASK_MODE) {
            int mask = 256 / sizeof(T);
            AscendC::WholeReduceMin<T>(dstLocal, srcLocal, mask, repeatTime, dstRepStride, srcBlkStride, srcRepStride);
            if (tailMask != 0) {
                uint32_t dstOffset = repeatTime * dstRepStride;
                uint32_t srcOffset = repeatTime * srcRepStride * (32 / sizeof(T));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::WholeReduceMin<T>(dstLocal[dstOffset], srcLocal[srcOffset], tailMask, 1, 1, srcBlkStride, 8);
            }
        } else {
            uint64_t mask[2] = {0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF};
            AscendC::WholeReduceMin<T>(dstLocal, srcLocal, mask, repeatTime, dstRepStride, srcBlkStride, srcRepStride);
            if (tailMask != 0) {
                uint32_t dstOffset = repeatTime * dstRepStride;
                uint32_t srcOffset = repeatTime * srcRepStride * (32 / sizeof(T));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::WholeReduceMin<T>(dstLocal[dstOffset], srcLocal[srcOffset], tailMask, 1, 1, srcBlkStride, 8);
            }
        }
        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize);
        outQueueDst.FreeTensor(dstLocal);
    }
private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal, dstGlobal;
    uint32_t dstDataSize;
    uint16_t repeatTime;
    uint16_t tailMask = 0;
    int dstRepStride = 1;
    int srcBlkStride = 1;
    int srcRepStride = 8;
};
__global__ __vector__ void whole_reduce_min_custom(__gm__ uint8_t* src, __gm__ uint8_t* dstGm)
{
    if constexpr (scenarioNum == 1) {
        KernelReduce<half, Mode::USE_CONTINUOUS_MASK_MODE> op;
        op.Init(src, dstGm);
        op.Process();
    } else if constexpr (scenarioNum == 2) {
        KernelReduce<half, Mode::USE_BITWISE_MASK_MODE> op;
        op.Init(src, dstGm);
        op.Process();
    } else if constexpr (scenarioNum == 3) {
        KernelReduce<float, Mode::USE_CONTINUOUS_MASK_MODE> op;
        op.Init(src, dstGm);
        op.Process();
    } else if constexpr (scenarioNum == 4) {
        KernelReduce<float, Mode::USE_BITWISE_MASK_MODE> op;
        op.Init(src, dstGm);
        op.Process();
    } else {
        AscendC::printf("not support!");
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    uint32_t dtypeSize = 4;
    if constexpr (scenarioNum >= 1 && scenarioNum <= 2) {
        dtypeSize = 2;
    }

    uint16_t oneRepSize = 256 / dtypeSize;
    uint16_t repeatTime = SRC_DATA_SIZE / oneRepSize;
    uint16_t tailMask = SRC_DATA_SIZE % oneRepSize;
    uint32_t dstDataSize = (tailMask > 0) ? (repeatTime + 1) * 2 : repeatTime * 2;
    uint16_t oneBlockSize = 32 / dtypeSize;
    dstDataSize = ((dstDataSize + oneBlockSize - 1) / oneBlockSize) * oneBlockSize; // 32B对齐
    inputByteSize = SRC_DATA_SIZE * dtypeSize;
    outputByteSize = dstDataSize * dtypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    whole_reduce_min_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
