/* !
 * \file block_reduce_max.asc
 * \brief
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"
#include <stdio.h>

constexpr uint32_t srcDataSize = SRC_DATA_SIZE;
constexpr uint32_t dstDataSize = DST_DATA_SIZE;
constexpr uint32_t OUTER_REPEAT = 1000;

template<typename T>
__global__ __aicore__ void block_reduce_max_custom() 
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // init localTensor
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    pipe.InitBuffer(inQueueSrc, 1, srcDataSize * sizeof(T));
    pipe.InitBuffer(outQueueDst, 1, dstDataSize * sizeof(T));
    AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
    AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
    AscendC::printf("srcLocal.GetSize(): %d \n", srcLocal.GetSize());

    int32_t mask = 256 / sizeof(T);
    int innerRepeatTimes = srcDataSize / mask;
    AscendC::PipeBarrier<PIPE_ALL>();
    int64_t startCycle = AscendC::GetSystemCycle();
    for (int i = 0; i < OUTER_REPEAT; i++){
        // AscendC::SetMaskCount();
        // AscendC::SetVectorMask<T, AscendC::MaskMode::COUNTER>(srcDataSize);
        // AscendC::BlockReduceMax<T>(dstLocal, srcLocal, 1, AscendC::MASK_PLACEHOLDER, 1, 1, 8);
        AscendC::BlockReduceMax<T>(dstLocal, srcLocal, innerRepeatTimes, mask, 1, 1, 8);
        // AscendC::SetMaskNorm();
        // AscendC::ResetMask();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    int64_t endCycle = AscendC::GetSystemCycle();
    AscendC::printf("block_reduce_max_custom cost cycle: %ld, in 50 MHz\n", endCycle - startCycle);
    // test performance 需要=》
    // 1. 接口函数：BlockReduceMax，正常使用， 逐渐增大的repeat=》对应的tensor大小
    // 2. pip barrier all + getSystemCycle
    inQueueSrc.FreeTensor(srcLocal);
    outQueueDst.FreeTensor(dstLocal);
    // 4140 cycle
    //  1 / 50 * 1800 / OUTER_REPEAT, 
    // 473 / 50 * 1800 / OUTER_REPEAT, 
    // 473 cycles / 50 = 9.46us => 即OUTER REPEAT次blockreducemax
    // 9.46 * 1800 / OUTER_REPEAT = 17.028 cycle每次blockreducemax的cycle数 =》 
    // 正常：24*1024 *4=》384cycle*1000
    // 
}

int32_t main(int32_t argc, char* argv[]) 
{
    printf("start block reduce performance test, with srcDataSize: %d, dstDataSize: %d, OUTER_REPEAT: %d\n", srcDataSize, dstDataSize, OUTER_REPEAT);
    uint32_t numBlocks = 1;
    
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    printf("warm up!\n");
    block_reduce_max_custom<float><<<numBlocks, nullptr, stream>>>();
    for(int i = 0;i < 20;i++) {
        block_reduce_max_custom<float><<<numBlocks, nullptr, stream>>>();
    }
    aclrtSynchronizeStream(stream);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
