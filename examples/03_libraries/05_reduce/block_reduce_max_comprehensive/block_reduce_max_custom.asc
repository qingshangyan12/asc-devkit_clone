/*!
 * \file block_reduce_max_comprehensive.asc
 * \brief BlockReduceMax comprehensive example with multiple scenarios
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

constexpr uint32_t SCENARIO_NUM_VALUE = SCENARIO_NUM; // 6种场景，T+mask + performance
constexpr uint32_t repeatTime = REPEAT_TIME;
constexpr uint32_t tailMask = TAIL_MASK;
constexpr int32_t srcBlkStride = SRC_BLK_STRIDE;
constexpr int32_t dstRepStride = DST_REP_STRIDE;
constexpr int32_t srcRepStride = SRC_REP_STRIDE;
constexpr uint32_t srcDataSize = SRC_DATA_SIZE;
constexpr uint32_t dstDataSize = DST_DATA_SIZE;

template <typename T, bool EnableCounterMask=false, bool EnablePerformanceTest=false, int loop=1>
class KernelBlockReduceMax {
public:
    __aicore__ inline KernelBlockReduceMax() {};

    __aicore__ inline void Init(GM_ADDR src, GM_ADDR dst) {
        srcGlobal.SetGlobalBuffer((__gm__ T*)src);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dst);

        pipe.InitBuffer(inQueueSrc, 1, srcDataSize * sizeof(T));
        pipe.InitBuffer(outQueueDst, 1, dstDataSize * sizeof(T));
    }

    __aicore__ inline void Process() {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn() {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, srcDataSize);
        inQueueSrc.EnQue(srcLocal);
    }

    __aicore__ inline void Compute() {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
        T zero(0);
        AscendC::Duplicate(dstLocal, zero, dstDataSize);
        if constexpr (EnableCounterMask) {
            AscendC::SetMaskCount();
            AscendC::SetVectorMask<T, AscendC::MaskMode::COUNTER>(tailMask);
            StartPerformTest();
            for (int i = 0;i < loop; i++) {
                AscendC::BlockReduceMax<T, false>(dstLocal, srcLocal,
                                        repeatTime, AscendC::MASK_PLACEHOLDER,
                                        srcBlkStride, dstRepStride,
                                        srcRepStride);
            }
            EndPerformTest();
            AscendC::SetMaskNorm();
            AscendC::ResetMask();
        } else {
            uint32_t dstOffset = repeatTime * dstRepStride * 8;
            uint32_t srcOffset = repeatTime * srcRepStride * (32 / sizeof(T));
            StartPerformTest();
            for (int i = 0;i < loop;i++){
                AscendC::BlockReduceMax<T>(dstLocal, srcLocal,
                                        repeatTime, 256 / sizeof(T),
                                        dstRepStride, srcBlkStride,
                                        srcRepStride);
                if constexpr (tailMask != 0) {
                    AscendC::BlockReduceMax<T>(dstLocal[dstOffset], srcLocal[srcOffset], 1, tailMask,
                        1, srcBlkStride, 1);
                }
            }
            EndPerformTest();
        }
        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }

    __aicore__ inline void StartPerformTest() {
        if constexpr (EnablePerformanceTest) {
            AscendC::PipeBarrier<PIPE_ALL>();
            startCycle = AscendC::GetSystemCycle();
        }
    }

    __aicore__ inline void EndPerformTest() {
        if constexpr (EnablePerformanceTest) {
            AscendC::PipeBarrier<PIPE_ALL>();
            endCycle = AscendC::GetSystemCycle();
            AscendC::printf("%d block_reduce_max cost cycle: %ld, in 50 MHz\n", loop, endCycle - startCycle);
        }
    }

    __aicore__ inline void CopyOut() {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal, dstGlobal;
    int64_t startCycle = 0;
    int64_t endCycle = 0;
};


__global__ __aicore__ void block_reduce_max_comprehensive(GM_ADDR src, GM_ADDR dst) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if constexpr (SCENARIO_NUM_VALUE == 1) {
        // half类型，并使用normal模式设置mask
        KernelBlockReduceMax<half> op;
        op.Init(src, dst);
        op.Process();
    } else if constexpr (SCENARIO_NUM_VALUE == 2) {
        // half类型，并使用counter模式设置mask
        KernelBlockReduceMax<half, true> op;
        op.Init(src, dst);
        op.Process();
    } else if (SCENARIO_NUM_VALUE == 3) {
        // half类型，并使用counter模式设置mask
        KernelBlockReduceMax<half, true, true, 1000> op;
        op.Init(src, dst);
        op.Process();
    } else if constexpr (SCENARIO_NUM_VALUE == 4) {
        // float类型，并使用normal模式设置mask
        KernelBlockReduceMax<float> op;
        op.Init(src, dst);
        op.Process();
    } else if constexpr (SCENARIO_NUM_VALUE == 5) {
        // float类型，并使用counter模式设置mask
        KernelBlockReduceMax<float, true> op;
        op.Init(src, dst);
        op.Process();
    } else if (SCENARIO_NUM_VALUE == 6) {
        // float类型，并使用counter模式设置mask performance
        KernelBlockReduceMax<float, true, true, 1000> op;
        op.Init(src, dst);
        op.Process();
    }
}

int32_t main(int32_t argc, char* argv[]) {
    uint32_t numBlocks = 1;

    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (SCENARIO_NUM_VALUE <= 3) {
        inputByteSize = srcDataSize * sizeof(half);
        outputByteSize = dstDataSize * sizeof(half);
    } else {
        inputByteSize = srcDataSize * sizeof(float);
        outputByteSize = dstDataSize * sizeof(float);
    }
    printf("srcDataSize: %u, dstDataSize: %u\n", srcDataSize, dstDataSize);
    printf("inputByteSize: %zu, outputByteSize: %zu\n", inputByteSize, outputByteSize);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *srcHost, *dstHost;
    uint8_t *srcDevice, *dstDevice;

    aclrtMallocHost((void **)(&srcHost), inputByteSize);
    aclrtMallocHost((void **)(&dstHost), outputByteSize);
    aclrtMalloc((void **)&srcDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&dstDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_src.bin", inputByteSize, srcHost, inputByteSize);

    aclrtMemcpy(srcDevice, inputByteSize, srcHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    block_reduce_max_comprehensive<<<numBlocks, nullptr, stream>>>(srcDevice, dstDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstHost, outputByteSize, dstDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);

    WriteFile("./output/output.bin", dstHost, outputByteSize);

    aclrtFree(srcDevice);
    aclrtFree(dstDevice);
    aclrtFreeHost(srcHost);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
