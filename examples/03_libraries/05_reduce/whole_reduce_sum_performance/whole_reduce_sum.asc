/* !
 * \file whole_reduce_sum.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t TOTAL_LENGTH = INPUT_SIZE;
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE;
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000;

template <typename T>
class KernelReduce {
public:
    __aicore__ inline KernelReduce() {}
    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* dstGm, uint32_t totalLength, 
                                AscendC::TPipe* pipeIn)
 	{
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)src);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);
        uint16_t oneRepSize = 256 / sizeof(T);
        srcDataSize = totalLength;
        dstDataSize = totalLength / oneRepSize;
        repeatTime = totalLength / oneRepSize;
        pipe->InitBuffer(inQueueSrc, 1, srcDataSize * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, dstDataSize * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, srcDataSize);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
    
        int mask = 256 / sizeof(T);

        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleBefore = AscendC::GetSystemCycle();
        for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXCUTE; ++i) {
            AscendC::WholeReduceSum<T>(dstLocal, srcLocal, mask, repeatTime, 1, 1, 8);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleAfter = AscendC::GetSystemCycle();
        AscendC::PRINTF("[LOG] systemCycleBefore: %d\n", systemCycleBefore);
        AscendC::PRINTF("[LOG] systemCycleAfter: %d\n", systemCycleAfter);
        AscendC::PRINTF("[LOG] WholeReduce instruction has excuted %d times, cost total cycles: %d\n",
            REPEAT_TIMES_FOR_INSTR_EXCUTE, (systemCycleAfter - systemCycleBefore));
        
        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize);
        outQueueDst.FreeTensor(dstLocal);
    }
private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal, dstGlobal;
    uint32_t srcDataSize = 0;
    uint32_t dstDataSize = 0;
    uint16_t repeatTime = 0;
};

__global__ __vector__ void whole_reduce_sum_custom(__gm__ uint8_t* src, __gm__ uint8_t* dstGm)
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelReduce<half> op;
        op.Init(src, dstGm, TOTAL_LENGTH, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelReduce<float> op;
        op.Init(src, dstGm, TOTAL_LENGTH, &pipe);
        op.Process();
    } 
}

int32_t main(int32_t argc, char *argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    uint32_t dtypeSize = sizeof(int16_t);
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        dtypeSize = sizeof(half);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        dtypeSize = sizeof(float);
    }

    uint16_t oneRepSize = 256 / dtypeSize;
    uint32_t dstDataSize = TOTAL_LENGTH / oneRepSize;
    inputByteSize = TOTAL_LENGTH * dtypeSize;
    outputByteSize = dstDataSize * dtypeSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *outHost;
    uint8_t *xDevice, *outDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&outHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    whole_reduce_sum_custom<<<numBlocks, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}