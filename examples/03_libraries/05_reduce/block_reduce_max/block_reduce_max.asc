/* !
 * \file block_reduce_max.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
class KernelReduce {
public:
    __aicore__ inline KernelReduce() {}
    //  初始化函数：设置全局内存指针和pipe
    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;  // 传入的流水指针
        srcGlobal.SetGlobalBuffer((__gm__ half*)src);  // 设置源全局缓冲区
        dstGlobal.SetGlobalBuffer((__gm__ half*)dstGm);  // 设置目标全局缓冲区
        pipe->InitBuffer(inQueueSrc, 1, srcDataSize * sizeof(half)); // 初始化输入队列缓冲区
        pipe->InitBuffer(outQueueDst, 1, dstDataSize * sizeof(half)); // 初始化输出队列缓冲区
    }
    // 主处理流程
    __aicore__ inline void Process()
    {
        CopyIn();   // 数据搬运入
        Compute();  // 计算处理
        CopyOut();  // 数据搬运出
    }
private:
    // 数据搬运出
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.AllocTensor<half>(); // 分配本地half张量
        AscendC::DataCopy(srcLocal, srcGlobal, srcDataSize);  // 从全局内存拷贝srcDataSize个half类型元素到本地
        inQueueSrc.EnQue(srcLocal); // 入队处理
    }
    // 计算处理函数
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.DeQue<half>(); // 从队列中取出源数据
        AscendC::LocalTensor<half> dstLocal = outQueueDst.AllocTensor<half>(); // 分配目标张量
        half zero(0);
        AscendC::Duplicate(dstLocal, zero, dstDataSize); // 目标张量元素填充0
        int32_t mask = 256 / sizeof(half);  // 用于控制每次迭代内参与计算的元素，mask连续模式
        int repeat = 1; // 迭代次数

        // repeat = 1, 128 elements one repeat, 128 elements total
        // srcBlkStride = 1, no gap between blocks in one repeat
        // dstRepStride = 1, srcRepStride = 8, no gap between repeats
        AscendC::BlockReduceMax<half>(dstLocal, srcLocal, repeat, mask, 1, 1, 8); // 对每个datablock内所有元素求最大值

        outQueueDst.EnQue<half>(dstLocal); // 拷贝结果入队
        inQueueSrc.FreeTensor(srcLocal); // 释放源张量
    }
    // 数据搬运出函数
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dstLocal = outQueueDst.DeQue<half>(); // 从队列中取出结果
        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize); // 从本地拷贝dstDataSize个half元素到全局内存
        outQueueDst.FreeTensor(dstLocal); // 释放目标张量
    }
private:
    AscendC::TPipe* pipe; // 流水指针
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc; // 输入队列
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst; // 输出队列
    AscendC::GlobalTensor<half> srcGlobal, dstGlobal; // 源和目标的全局张量
    int srcDataSize = 128; // 输入队列元素个数
    int dstDataSize = 64;  // 输出队列元素个数
};
// 核函数入口
__global__ __vector__ void block_reduce_max_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe; // 创建流水对象pipe
    KernelReduce op; // 实例化对象
    op.Init(x, z, &pipe); // 初始化拷贝对象
    op.Process(); // 执行处理流程
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 128 * sizeof(half);
    size_t outputByteSize = 64 * sizeof(half);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    block_reduce_max_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
