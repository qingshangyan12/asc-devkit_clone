/* !
 * \file reduce_sum.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t INPUT_TENSOR_SIZE = INPUT_SIZE; // 输入数据长度
constexpr uint32_t INPUT_TENSOR_TYPE = INPUT_TYPE; // 输入数据类型
constexpr uint32_t REPEAT_TIMES_FOR_INSTR_EXCUTE = 1000; // 指令重复执行次数（用于性能测试）

template <typename T>
class KernelReduce {
public:
    __aicore__ inline KernelReduce() {}
    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ T*)src);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);

        pipe->InitBuffer(inQueueSrc, 1, INPUT_TENSOR_SIZE * sizeof(T));
        // 此处按照公式计算所需的最小work空间为80，也就是160Bytes
        pipe->InitBuffer(workQueue, 1, 80 * sizeof(T));
        pipe->InitBuffer(outQueueDst, 1, dstDataSize * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.AllocTensor<T>();
        AscendC::DataCopy(srcLocal, srcGlobal, INPUT_TENSOR_SIZE);
        inQueueSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> srcLocal = inQueueSrc.DeQue<T>();
        AscendC::LocalTensor<T> dstLocal = outQueueDst.AllocTensor<T>();
        AscendC::LocalTensor<T> sharedTmpBuffer = workQueue.AllocTensor<T>();

        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleBefore = AscendC::GetSystemCycle();
 	    for (int32_t i = 0; i < REPEAT_TIMES_FOR_INSTR_EXCUTE; ++i) {
 	        AscendC::ReduceSum(dstLocal, srcLocal, sharedTmpBuffer, INPUT_TENSOR_SIZE);
 	    }
        AscendC::PipeBarrier<PIPE_ALL>();
        uint64_t systemCycleAfter = AscendC::GetSystemCycle();
        AscendC::PRINTF("[LOG] systemCycleBefore: %d\n", systemCycleBefore);
        AscendC::PRINTF("[LOG] systemCycleAfter: %d\n", systemCycleAfter);
        AscendC::PRINTF("[LOG] ReduceSum API has excuted %d times, cost total cycles: %d\n",
            REPEAT_TIMES_FOR_INSTR_EXCUTE, (systemCycleAfter - systemCycleBefore));

        outQueueDst.EnQue<T>(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
        workQueue.FreeTensor(sharedTmpBuffer);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> dstLocal = outQueueDst.DeQue<T>();
        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize);
        outQueueDst.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> workQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<T> srcGlobal, dstGlobal;
    int dstDataSize = 16;
    int repStride = 8;
};

__global__ __vector__ void reduce_sum_custom(GM_ADDR x, GM_ADDR z)
{
    AscendC::TPipe pipe;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        KernelReduce<half> op;
        op.Init(x, z, &pipe);
        op.Process();
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        KernelReduce<float> op;
        op.Init(x, z, &pipe);
        op.Process();
    }
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;
    if constexpr (INPUT_TENSOR_TYPE == 1) {
        inputByteSize = INPUT_TENSOR_SIZE * sizeof(int16_t);
        outputByteSize = 16 * sizeof(int16_t);
    } else if constexpr (INPUT_TENSOR_TYPE == 2) {
        inputByteSize = INPUT_TENSOR_SIZE * sizeof(int32_t);
        outputByteSize = 16 * sizeof(int32_t);
    }

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    reduce_sum_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
