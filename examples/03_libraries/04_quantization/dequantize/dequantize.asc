/* !
 * \file dequantize.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

template <typename SrcT, typename DstT, uint32_t policy> 
class KernelDequant {
public:
    __aicore__ inline KernelDequant() {}
    __aicore__ inline void Init(GM_ADDR dstGm, GM_ADDR srcGm, GM_ADDR scaleGm, uint32_t mIn, uint32_t n,
        uint32_t calCountIn, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        m = mIn;
        n = nIn;
        calCount = calCountIn;
        elementCountOfInput = mIn * nIn;

        dstGlobal.SetGlobalBuffer((__gm__ DstT*)dstGm);
        srcGlobal.SetGlobalBuffer((__gm__ int32_t*)srcGm);
        scaleGlobal.SetGlobalBuffer((__gm__ SrcT*)scaleGm);

        pipe->InitBuffer(inQueueSrc, 1, elementCountOfInput * sizeof(int32_t));
        pipe->InitBuffer(inQueueScale, 1, nIn * sizeof(SrcT));
        pipe->InitBuffer(outQueue, 1, elementCountOfInput * sizeof(DstT));
        pipe->InitBuffer(tmpQueue, 1, 81920);
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<int32_t> srcLocal = inQueueSrc.AllocTensor<int32_t>();
        AscendC::DataCopy(srcLocal, srcGlobal, elementCountOfInput);
        inQueueSrc.EnQue(srcLocal);

        AscendC::LocalTensor<SrcT> scaleLocal = inQueueScale.AllocTensor<SrcT>();
        AscendC::DataCopy(scaleLocal, scaleGlobal, n);
        inQueueScale.EnQue(scaleLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<int32_t> srcLocal = inQueueSrc.DeQue<int32_t>();
        AscendC::LocalTensor<SrcT> deqscaleLocal = inQueueScale.DeQue<SrcT>();
        AscendC::LocalTensor<DstT> dstLocal = outQueue.AllocTensor<DstT>();
        AscendC::LocalTensor<uint8_t> sharedTmpBuffer = tmpQueue.AllocTensor<uint8_t>();

        DequantizeParams params{m, n, 0};
        if constexpr (policy == 1) {                // PerTensor
            float scale = 1.19;
            static constexpr DequantizeConfig config{DequantizePolicy::PER_TENSOR, false, 0};
            if constexpr (IsSameType<SrcT, bfloat16_t>::value) {
                AscendC::Dequantize<config>(dstLocal, srcLocal, ToBfloat16(scale), ToBfloat16(scale), params);
            } else {
                AscendC::Dequantize<config>(dstLocal, srcLocal, SrcT(scale), SrcT(scale), params);
            }
        } else if constexpr (policy == 0) {         // PerChannel
            static constexpr DequantizeConfig config{DequantizePolicy::PER_CHANNEL, false, 0};
            AscendC::Dequantize<config>(dstLocal, srcLocal, deqscaleLocal, deqscaleLocal, params);
        } else if constexpr (policy == 2) {         // PerToken
            static constexpr DequantizeConfig config{DequantizePolicy::PER_TOKEN, false, 0};
            AscendC::Dequantize<config>(dstLocal, srcLocal, deqscaleLocal, deqscaleLocal, params);
        } else if constexpr (policy == 3) {         // PerGroup
            static constexpr DequantizeConfig config{DequantizePolicy::PER_GROUP, false, 0};
            AscendC::Dequantize<config>(dstLocal, srcLocal, deqscaleLocal, deqscaleLocal, params);
        }

        inQueueSrc.FreeTensor(srcLocal);
        inQueueScale.FreeTensor(deqscaleLocal);
        tmpQueue.FreeTensor(sharedTmpBuffer);
        outQueue.EnQue(dstLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<DstT> dstLocal = outQueue.DeQue<DstT>();
        AscendC::DataCopy(dstGlobal, dstLocal, elementCountOfInput);
        outQueue.FreeTensor(dstLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueueScale;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> tmpQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;

    AscendC::GlobalTensor<DstT> dstGlobal;
    AscendC::GlobalTensor<int32_t> srcGlobal;
    AscendC::GlobalTensor<SrcT> scaleGlobal;

    uint32_t m;
    uint32_t n;
    uint32_t calCount;
    uint32_t elementCountOfInput;
};

__global__ __vector__ void dequantize_custom(GM_ADDR srcGm, GM_ADDR dstGm, GM_ADDR scaleGm, GM_ADDR offsetGm)
{
    AscendC::TPipe pipe;
    constexpr bool hasOffset = true;
    constexpr bool hasTranspose = false;
    constexpr uint32_t mIn = 10;
    constexpr uint32_t nIn = 256;
    constexpr uint32_t calCountIn = 1280;
    KernelReduceAny<int8_t, float. float, hasOffset, hasTranspose> op;
    op.Init(srcGm, dstGm, scaleGm, offsetGm, mIn, n, calCountIn, &pipe);
    op.Process();
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        printf("wrongNum: %ld\n", wrongNum);
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    size_t param1FileSize = 893 * sizeof(float);
    size_t param2FileSize = 893 * sizeof(int32_t);
    size_t param3FileSize = 128 * sizeof(float);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    aclrtContext context;
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* param1Host;
    uint8_t* param1Device;
    aclrtMallocHost((void**)(&param1Host), param1FileSize);
    aclrtMalloc((void**)&param1Device, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* param2Host;
    uint8_t* param2Device;
    aclrtMallocHost((void**)(&param2Host), param2FileSize);
    aclrtMalloc((void**)&param2Device, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_src.bin", param2FileSize, param2Host, param2FileSize);
    aclrtMemcpy(param2Device, param2FileSize, param2Host, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* param3Host;
    uint8_t* param3Device;
    aclrtMallocHost((void**)(&param3Host), param3FileSize);
    aclrtMalloc((void**)&param3Device, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_scale.bin", param3FileSize, param3Host, param3FileSize);
    aclrtMemcpy(param3Device, param3FileSize, param3Host, param3FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    dequantize_custom<<<numBlocks, nullptr, stream>>>(param1Device, param2Device, param3Device);
    aclrtSynchronizeStream(stream);

    aclrtFree(param2Device);
    aclrtFreeHost(param2Host);
    aclrtFree(param3Device);
    aclrtFreeHost(param3Host);

    aclrtMemcpy(param1Host, param1FileSize, param1Device, param1FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", param2Host, param2FileSize);

    bool goldenResult = true;
    goldenResult = CompareResult(param2Host, param2FileSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }

    aclrtFree(param1Device);
    aclrtFreeHost(param1Host);

    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}