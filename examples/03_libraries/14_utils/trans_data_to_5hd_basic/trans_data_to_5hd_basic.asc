/* !
 * \file trans_data_to_5hd_basic.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 场景常量
constexpr uint32_t scenarioNum = SCENARIO_NUM;

// 常量定义
constexpr int32_t NCHW_CONV_ADDR_LIST_SIZE = 16;
constexpr int32_t ONE_BLK_SIZE = 32;

// 场景类型枚举
enum class TransDataScenario {
    TRANS_HALF = 1,           // half类型数据转换
    TRANS_FLOAT = 2,          // float类型数据转换
    TRANS_INT8 = 3,           // int8_t类型数据转换 (需要两次scatter)
    TRANS_NCHW2NC1HWC0 = 4    // NCHW → NC1HWC0 格式转换
};

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景1/2: half/float类型数据转换 (16位/32位数据类型)
// TransDataTo5HD: 将16个块的数据进行格式转换
// dstRepStride: 目标重复步长 (16block转置为0, NCHW2NC1HWC0为16)
// srcRepStride: 源重复步长 (16block转置为0, NCHW2NC1HWC0为1)
template <typename T>
__aicore__ inline void TransDataTo5HDExample(GM_ADDR srcGm, GM_ADDR dstGm, uint32_t repeatTimes,
                                              uint16_t dstRepStride, uint16_t srcRepStride)
{
    // 每个块的大小 (32字节 / sizeof(T))
    constexpr uint32_t blockSize = ONE_BLK_SIZE / sizeof(T);
    // 总数据大小: 16个块 * repeatTimes * blockSize
    constexpr uint32_t totalSize = NCHW_CONV_ADDR_LIST_SIZE * blockSize;
    constexpr uint32_t dataSize = totalSize * 4;  // 预留足够空间

    // 静态地址分配
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + dataSize * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, dataSize);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, dataSize);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, dataSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dataSize);

    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, dataSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 设置转换参数
    AscendC::TransDataTo5HDParams transParams;
    transParams.repeatTimes = repeatTimes;
    transParams.dstRepStride = dstRepStride;
    transParams.srcRepStride = srcRepStride;

    // 设置地址列表 (16个源地址和16个目标地址) - 使用uint64_t存储物理地址
    uint64_t srcList[NCHW_CONV_ADDR_LIST_SIZE];
    uint64_t dstList[NCHW_CONV_ADDR_LIST_SIZE];

    for (int i = 0; i < NCHW_CONV_ADDR_LIST_SIZE; i++) {
        srcList[i] = (uint64_t)srcLocal[i * blockSize].GetPhyAddr();
        dstList[i] = (uint64_t)dstLocal[i * blockSize].GetPhyAddr();
    }

    // 执行格式转换
    AscendC::TransDataTo5HD<T>(dstList, srcList, transParams);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 数据搬出
    AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
}

// 场景3: int8_t类型数据转换 (8位数据类型)
// TransDataTo5HD: 将16个块的数据进行格式转换
// 注意: 8位数据类型需要两次scatter完成完整转置
//   - 第一次: srcHighHalf=false, dstHighHalf=false (处理前半部分)
//   - 第二次: srcHighHalf=true, dstHighHalf=true (处理后半部分)
// dstRepStride: 目标重复步长 (16block转置为0)
// srcRepStride: 源重复步长 (16block转置为0)
template <typename T>
__aicore__ inline void TransDataTo5HDExampleInt8(GM_ADDR srcGm, GM_ADDR dstGm, uint32_t repeatTimes,
                                                  uint16_t dstRepStride, uint16_t srcRepStride)
{
    // 每个块的大小 (32字节 / sizeof(T)) = 32/1 = 32元素
    constexpr uint32_t blockSize = ONE_BLK_SIZE / sizeof(T);
    // 总数据大小: 16个块 * blockSize
    constexpr uint32_t totalSize = NCHW_CONV_ADDR_LIST_SIZE * blockSize;
    constexpr uint32_t dataSize = totalSize * 4;  // 预留足够空间

    // 静态地址分配
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + dataSize * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, dataSize);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, dataSize);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, dataSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dataSize);

    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, totalSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 设置地址列表 - 使用uint64_t存储物理地址
    uint64_t srcList[NCHW_CONV_ADDR_LIST_SIZE];
    uint64_t dstList[NCHW_CONV_ADDR_LIST_SIZE];

    for (int i = 0; i < NCHW_CONV_ADDR_LIST_SIZE; i++) {
        srcList[i] = (uint64_t)srcLocal[i * blockSize].GetPhyAddr();
        dstList[i] = (uint64_t)dstLocal[i * blockSize].GetPhyAddr();
    }

    // 第一次 scatter: 处理前半部分数据
    AscendC::TransDataTo5HDParams transParamsLow;
    transParamsLow.repeatTimes = repeatTimes;
    transParamsLow.dstRepStride = dstRepStride;
    transParamsLow.srcRepStride = srcRepStride;
    transParamsLow.srcHighHalf = false;
    transParamsLow.dstHighHalf = false;
    AscendC::TransDataTo5HD<T>(dstList, srcList, transParamsLow);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 第二次 scatter: 处理后半部分数据
    AscendC::TransDataTo5HDParams transParamsHigh;
    transParamsHigh.repeatTimes = repeatTimes;
    transParamsHigh.dstRepStride = dstRepStride;
    transParamsHigh.srcRepStride = srcRepStride;
    transParamsHigh.srcHighHalf = true;
    transParamsHigh.dstHighHalf = true;
    AscendC::TransDataTo5HD<T>(dstList, srcList, transParamsHigh);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 数据搬出
    AscendC::DataCopy(dstGlobal, dstLocal, totalSize);
}

// 场景4: NCHW → NC1HWC0 格式转换
// 由于一次 TransDataTo5HD 只能处理 16 个 block 的转置，场景4的数据量需要多次调用
// 数据维度: N=2, C=32, H=16, W=16 (half类型)
template <typename T>
__aicore__ inline void TransDataTo5HDExampleNCHW2NC1HWC0(GM_ADDR srcGm, GM_ADDR dstGm)
{
    // 数据维度常量
    constexpr uint32_t N = 2;
    constexpr uint32_t C = 32;
    constexpr uint32_t H = 16;
    constexpr uint32_t W = 16;
    constexpr uint32_t C0 = 16;
    constexpr uint32_t C1 = C / C0;  // 2

    // 总数据量
    constexpr uint32_t totalElements = N * C * H * W;  // 16384

    // 外循环次数
    constexpr uint32_t loopCount = N * C / NCHW_CONV_ADDR_LIST_SIZE;  // 4

    // 静态地址分配
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + totalElements * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, totalElements);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, totalElements);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, totalElements);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, totalElements);

    // 设置转换参数: NCHW → NC1HWC0
    AscendC::TransDataTo5HDParams transParams;
    transParams.repeatTimes = 16;
    transParams.dstRepStride = 16;
    transParams.srcRepStride = 1;

    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, totalElements);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 循环处理数据
    for (uint32_t loop = 0; loop < loopCount; loop++) {
        // 设置地址列表
        uint64_t srcList[NCHW_CONV_ADDR_LIST_SIZE];
        uint64_t dstList[NCHW_CONV_ADDR_LIST_SIZE];

        for (int i = 0; i < NCHW_CONV_ADDR_LIST_SIZE; i++) {
            srcList[i] = (uint64_t)srcLocal[loop * NCHW_CONV_ADDR_LIST_SIZE * H * W + i * H * W].GetPhyAddr();
            dstList[i] = (uint64_t)dstLocal[loop * NCHW_CONV_ADDR_LIST_SIZE * H * W + i * C0].GetPhyAddr();
        }

        // 执行格式转换
        AscendC::TransDataTo5HD<T>(dstList, srcList, transParams);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    }

    // 数据搬出
    AscendC::DataCopy(dstGlobal, dstLocal, totalElements);
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunTransDataTo5HDScenario(GM_ADDR x, GM_ADDR y)
{
    if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_HALF)) {
        // 16block转置: dstRepStride=0, srcRepStride=0
        TransDataTo5HDExample<half>(x, y, 1, 0, 0);
    } else if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_FLOAT)) {
        // 16block转置: dstRepStride=0, srcRepStride=0
        TransDataTo5HDExample<float>(x, y, 1, 0, 0);
    } else if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_INT8)) {
        // 16block转置: dstRepStride=0, srcRepStride=0
        TransDataTo5HDExampleInt8<int8_t>(x, y, 1, 0, 0);
    } else if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_NCHW2NC1HWC0)) {
        // NCHW → NC1HWC0: 使用专用函数处理大数据量
        TransDataTo5HDExampleNCHW2NC1HWC0<half>(x, y);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_trans_data_to_5hd_basic(GM_ADDR x, GM_ADDR y)
{
    RunTransDataTo5HDScenario<scenarioNum>(x, y);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 根据场景设置数据大小
    // TransDataTo5HD 每次处理 16 个块，每块 32 字节
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_HALF)) {
        inputByteSize = 16 * 16 * sizeof(half);   // 16块 * 16元素/块
        outputByteSize = 16 * 16 * sizeof(half);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_FLOAT)) {
        inputByteSize = 16 * 8 * sizeof(float);   // 16块 * 8元素/块
        outputByteSize = 16 * 8 * sizeof(float);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_INT8)) {
        inputByteSize = 16 * 32 * sizeof(int8_t);   // 16块 * 32元素/块
        outputByteSize = 16 * 32 * sizeof(int8_t);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_NCHW2NC1HWC0)) {
        // NCHW → NC1HWC0: N=2, C=32, H=16, W=16
        inputByteSize = 2 * 32 * 16 * 16 * sizeof(half);
        outputByteSize = 2 * 2 * 16 * 16 * 16 * sizeof(half);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* xHost;
    uint8_t* xDevice;
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 读取输入数据
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 执行核函数
    kernel_trans_data_to_5hd_basic<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
