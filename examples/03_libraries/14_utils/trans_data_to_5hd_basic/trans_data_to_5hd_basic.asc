/* !
 * \file trans_data_to_5hd_basic.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 场景和大小常量
constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

// 常量定义
constexpr int32_t NCHW_CONV_ADDR_LIST_SIZE = 16;
constexpr int32_t ONE_BLK_SIZE = 32;

// 场景类型枚举
enum class TransDataScenario {
    TRANS_HALF = 1,       // half类型数据转换
    TRANS_FLOAT = 2,      // float类型数据转换
    TRANS_INT16 = 3,      // int16_t类型数据转换
    TRANS_INT8 = 4        // int8_t类型数据转换
};

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景1/2: half/float类型数据转换
// TransDataTo5HD: 将16个块的数据进行格式转换
template <typename T>
__aicore__ inline void TransDataTo5HDExample(GM_ADDR srcGm, GM_ADDR dstGm, uint32_t repeatTimes)
{
    // 每个块的大小 (32字节 / sizeof(T))
    constexpr uint32_t blockSize = ONE_BLK_SIZE / sizeof(T);
    // 总数据大小: 16个块 * repeatTimes * blockSize
    constexpr uint32_t totalSize = NCHW_CONV_ADDR_LIST_SIZE * blockSize;
    constexpr uint32_t dataSize = totalSize * 4;  // 预留足够空间

    // 静态地址分配
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + dataSize * sizeof(T) + 256;

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, dataSize);
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, dataSize);

    AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, srcAddr, dataSize);
    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dataSize);

    // 数据搬入
    AscendC::DataCopy(srcLocal, srcGlobal, dataSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 设置转换参数
    AscendC::TransDataTo5HDParams transParams;
    transParams.repeatTimes = repeatTimes;
    transParams.dstRepStride = NCHW_CONV_ADDR_LIST_SIZE;  // 目标重复步长
    transParams.srcRepStride = NCHW_CONV_ADDR_LIST_SIZE;  // 源重复步长

    // 设置地址列表 (16个源地址和16个目标地址)
    __ubuf__ T* srcList[NCHW_CONV_ADDR_LIST_SIZE];
    __ubuf__ T* dstList[NCHW_CONV_ADDR_LIST_SIZE];

    for (int i = 0; i < NCHW_CONV_ADDR_LIST_SIZE; i++) {
        srcList[i] = (__ubuf__ T*)srcLocal[i * blockSize].GetPhyAddr();
        dstList[i] = (__ubuf__ T*)dstLocal[i * blockSize].GetPhyAddr();
    }

    // 执行格式转换
    AscendC::TransDataTo5HD<T>(dstList, srcList, transParams);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    // 数据搬出
    AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunTransDataTo5HDScenario(GM_ADDR x, GM_ADDR y)
{
    if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_HALF)) {
        TransDataTo5HDExample<half>(x, y, 1);
    } else if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_FLOAT)) {
        TransDataTo5HDExample<float>(x, y, 1);
    } else if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_INT16)) {
        TransDataTo5HDExample<int16_t>(x, y, 1);
    } else if constexpr (N == static_cast<uint32_t>(TransDataScenario::TRANS_INT8)) {
        TransDataTo5HDExample<int8_t>(x, y, 1);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_trans_data_to_5hd_basic(GM_ADDR x, GM_ADDR y)
{
    RunTransDataTo5HDScenario<scenarioNum>(x, y);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 根据场景设置数据大小
    // TransDataTo5HD 每次处理 16 个块，每块 32 字节
    size_t inputByteSize = 0;
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_HALF)) {
        inputByteSize = 16 * 16 * sizeof(half);   // 16块 * 16元素/块
        outputByteSize = 16 * 16 * sizeof(half);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_FLOAT)) {
        inputByteSize = 16 * 8 * sizeof(float);   // 16块 * 8元素/块
        outputByteSize = 16 * 8 * sizeof(float);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_INT16)) {
        inputByteSize = 16 * 16 * sizeof(int16_t);   // 16块 * 16元素/块
        outputByteSize = 16 * 16 * sizeof(int16_t);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(TransDataScenario::TRANS_INT8)) {
        inputByteSize = 16 * 32 * sizeof(int8_t);   // 16块 * 32元素/块
        outputByteSize = 16 * 32 * sizeof(int8_t);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* xHost;
    uint8_t* xDevice;
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 读取输入数据
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 执行核函数
    kernel_trans_data_to_5hd_basic<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(xDevice);
    aclrtFree(outDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
