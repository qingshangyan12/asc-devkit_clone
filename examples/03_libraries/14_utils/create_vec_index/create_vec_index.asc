/* !
 * \file create_vec_index.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 场景和大小常量
constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

// 场景类型枚举
enum class CreateVecIndexScenario {
    INDEX_HALF = 1,       // half类型，从0开始的等差序列
    INDEX_FLOAT = 2,      // float类型，从0开始的等差序列
    INDEX_INT32 = 3,      // int32_t类型，从指定值开始的等差序列
    INDEX_INT16 = 4       // int16_t类型，从指定值开始的等差序列
};

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景1/2: half/float类型，从0开始的等差序列
template <typename T>
__aicore__ inline void CreateVecIndexFromZero(GM_ADDR dstGm, uint32_t dataSize)
{
    constexpr uint32_t dstAddr = 0;

    AscendC::GlobalTensor<T> dstGlobal;
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, dataSize);

    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dataSize);

    // 创建从0开始的等差序列
    AscendC::CreateVecIndex(dstLocal, (T)0, dataSize);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
}

// 场景3/4: int32_t/int16_t类型，从指定值开始的等差序列
template <typename T>
__aicore__ inline void CreateVecIndexFromValue(GM_ADDR dstGm, T firstValue, uint32_t dataSize)
{
    constexpr uint32_t dstAddr = 0;

    AscendC::GlobalTensor<T> dstGlobal;
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, dataSize);

    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, dataSize);

    // 创建从指定值开始的等差序列
    AscendC::CreateVecIndex(dstLocal, firstValue, dataSize);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, dataSize);
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunCreateVecIndexScenario(GM_ADDR y)
{
    if constexpr (N == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_HALF)) {
        CreateVecIndexFromZero<half>(y, size);
    } else if constexpr (N == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_FLOAT)) {
        CreateVecIndexFromZero<float>(y, size);
    } else if constexpr (N == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_INT32)) {
        CreateVecIndexFromValue<int32_t>(y, (int32_t)10, size);
    } else if constexpr (N == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_INT16)) {
        CreateVecIndexFromValue<int16_t>(y, (int16_t)5, size);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_create_vec_index(GM_ADDR y)
{
    RunCreateVecIndexScenario<scenarioNum>(y);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 根据场景设置数据大小
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_HALF)) {
        outputByteSize = size * sizeof(half);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_FLOAT)) {
        outputByteSize = size * sizeof(float);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_INT32)) {
        outputByteSize = size * sizeof(int32_t);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(CreateVecIndexScenario::INDEX_INT16)) {
        outputByteSize = size * sizeof(int16_t);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 执行核函数
    kernel_create_vec_index<<<USED_CORE_NUM, nullptr, stream>>>(outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
