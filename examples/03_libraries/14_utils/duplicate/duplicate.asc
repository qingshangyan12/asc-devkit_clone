/* !
 * \file duplicate.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 场景和大小常量
constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t size = SIZE;

// 场景类型枚举
enum class DuplicateScenario {
    DUPLICATE_HALF = 1,       // half类型，标量复制
    DUPLICATE_FLOAT = 2,      // float类型，标量复制
    DUPLICATE_INT32 = 3       // int32_t类型，标量复制
};

#define NOT_SUPPORT AscendC::printf("not support!");

// 场景1: half类型标量复制
template <typename T>
__aicore__ inline void DuplicateScalar(GM_ADDR dstGm, T scalarValue)
{
    constexpr uint32_t srcAddr = 0;
    constexpr uint32_t dstAddr = srcAddr + size * sizeof(T) + 256;

    AscendC::GlobalTensor<T> dstGlobal;
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, size);

    AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECOUT, dstAddr, size);

    // 使用Duplicate填充标量值
    AscendC::Duplicate(dstLocal, scalarValue, size);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, size);
}

// 场景分发函数
template <uint32_t N>
__aicore__ inline void RunDuplicateScenario(GM_ADDR y)
{
    if constexpr (N == static_cast<uint32_t>(DuplicateScenario::DUPLICATE_HALF)) {
        DuplicateScalar<half>(y, (half)3.14);
    } else if constexpr (N == static_cast<uint32_t>(DuplicateScenario::DUPLICATE_FLOAT)) {
        DuplicateScalar<float>(y, (float)2.718);
    } else if constexpr (N == static_cast<uint32_t>(DuplicateScenario::DUPLICATE_INT32)) {
        DuplicateScalar<int32_t>(y, (int32_t)42);
    } else {
        NOT_SUPPORT;
    }
}

// 核函数定义
__global__ __vector__ void kernel_duplicate(GM_ADDR y)
{
    RunDuplicateScenario<scenarioNum>(y);
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
}

int32_t main(int32_t argc, char* argv[])
{
    // 根据场景设置数据大小
    size_t outputByteSize = 0;

    if constexpr (scenarioNum == static_cast<uint32_t>(DuplicateScenario::DUPLICATE_HALF)) {
        outputByteSize = size * sizeof(half);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(DuplicateScenario::DUPLICATE_FLOAT)) {
        outputByteSize = size * sizeof(float);
    } else if constexpr (scenarioNum == static_cast<uint32_t>(DuplicateScenario::DUPLICATE_INT32)) {
        outputByteSize = size * sizeof(int32_t);
    }

    // ACL 初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 内存分配
    uint8_t* outHost;
    uint8_t* outDevice;

    aclrtMallocHost((void**)(&outHost), outputByteSize);
    aclrtMalloc((void**)&outDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 执行核函数
    kernel_duplicate<<<USED_CORE_NUM, nullptr, stream>>>(outDevice);
    aclrtSynchronizeStream(stream);

    // 输出结果
    aclrtMemcpy(outHost, outputByteSize, outDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outputByteSize);

    // 清理资源
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
