/* !
 * \file add_custom.asc
 * \brief Add operator based on element-wise addition with double buffer pipeline optimization,
 *        demonstrating triple chevron notation for PyTorch extension integration
 */

#include <torch/extension.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

// Set double buffer to achieve memory access-computation pipeline parallelism
constexpr int32_t BUFFER_NUM = 2;

/**
 * \brief Core of Add operator: Implements element-wise addition for dual-input tensors with double buffer pipeline optimization
 */
class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    /**
     * \brief Initialize the kernel: Set up global memory buffers and queue buffers for pipeline processing
     * \param x Input tensor x global memory address
     * \param y Input tensor y global memory address
     * \param z Output tensor z global memory address
     * \param totalLength Total number of elements in the tensor
     */
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        // Calculate the data length each AI core block needs to process
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = 8;
        // Calculate tile length for each iteration
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;
        // Set global memory buffer with offset based on block index
        xGm.SetGlobalBuffer((__gm__ half *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ half *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ half *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        // Initialize double buffer queues for input and output
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(half));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(half));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(half));
    }
    /**
     * \brief Kernel core process function: Drives the double buffer pipeline to execute the read-compute-write process
     */
    __aicore__ inline void Process()
    {
        // Pipeline loop count = tile number × buffer number
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    /**
     * \brief Data input copy function: Copy data from GM->UB
     */
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // Allocate input tensor
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        // GM→UB data copy by tile length
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    /**
     * \brief Core computation function: Perform element-wise addition of dual-input tensor
     */
    __aicore__ inline void Compute(int32_t progress)
    {
        // Dequeue input tensor from the input queue
        AscendC::LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.DeQue<half>();
        // Allocate output tensor
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        // Perform element-wise addition
        AscendC::Add(zLocal, xLocal, yLocal, this->tileLength);
        // Enqueue the output tensor
        outQueueZ.EnQue<half>(zLocal);
        // Free input tensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    /**
     * \brief Data output copy: Copy the computation results from UB back to GM
     */
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<half> zLocal = outQueueZ.DeQue<half>();
        // UB→GM result copy
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

/**
 * \brief Kernel function: Instantiates and runs the Add operator computation
 */
__global__ __vector__ void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KernelAdd op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

/**
 * \brief PyTorch extension wrapper function: Provides Python-callable interface for the custom operator
 */
namespace ascendc_ops {
at::Tensor ascendc_add(const at::Tensor& x, const at::Tensor& y)
{
    // Get current NPU stream for async execution
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    // Allocate output tensor with same shape and dtype as input
    at::Tensor z = at::empty_like(x);
    uint32_t numBlocks = 8;
    // Calculate total elements from tensor shape
    uint32_t totalLength = 1;
    for (uint32_t size : x.sizes()) {
        totalLength *= size;
    }
    // Launch kernel using triple chevron notation: numBlocks, nullptr (shared memory), stream
    add_custom<<<numBlocks, nullptr, aclStream>>>((uint8_t*)(x.mutable_data_ptr()), (uint8_t*)(y.mutable_data_ptr()), (uint8_t*)(z.mutable_data_ptr()), totalLength);
    return z;
}
} // namespace ascendc_ops

// Register operator definition in TORCH_LIBRARY
TORCH_LIBRARY(ascendc_ops, m)
{
    m.def("ascendc_add(Tensor x, Tensor y) -> Tensor");
}

// Register operator implementation for PrivateUse1 device (NPU)
TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m)
{
    m.impl("ascendc_add", TORCH_FN(ascendc_ops::ascendc_add));
}
