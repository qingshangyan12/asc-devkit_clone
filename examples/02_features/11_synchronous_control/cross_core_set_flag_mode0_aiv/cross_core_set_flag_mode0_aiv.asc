/* !
 * \file cross_core_set_flag_mode0_aiv.asc
 * \brief
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t BLOCK_DIM = 8;     // due to AIC : AIV = 1 : 2, therefore 16 AIV in total

// Main Process:
// 1. Same data moves to each AIV.                   GM -> UB
// 2. Each AIV data multiply with blockIdx value.    UB computation
// 3. Each AIV data move to GM with atomic add.      UB -> GM
// 4. Atomic add result moves to each AIV.           GM -> UB
// 5. Expected dumpTensor result from each AIV to be the same.

class KernelCrossCoreSetFlag {
public:
    __aicore__ inline KernelCrossCoreSetFlag() {}
    __aicore__ inline void Init(GM_ADDR initialData, GM_ADDR atomicResult, uint32_t totalLength)
    {
        this->blockLength = totalLength;
        initialDataGm.SetGlobalBuffer((__gm__ float *)initialData, this->blockLength);
        atomicResultGm.SetGlobalBuffer((__gm__ float *)atomicResult, this->blockLength);
        pipe.InitBuffer(inQueueInit, BUFFER_NUM, this->blockLength * sizeof(float));
        pipe.InitBuffer(outQueueAtomic, BUFFER_NUM, this->blockLength * sizeof(float));
        pipe.InitBuffer(atomicResBuf, this->blockLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        CopyIn();      // 1. Same data moves to each AIV.                               GM -> UB        PIPE_MTE2
        Compute();     // 2. Each AIV data multiply with blockIdx value.                UB computation  PIPE_V
        CopyOut();     // 3. Each AIV data move to GM with atomic add.                  UB -> GM        PIPE_MTE3
        PrintTensor(); // 4. Atomic add result moves to each AIV and check result.      GM -> UB        PIPE_MTE2
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<float> input = inQueueInit.AllocTensor<float>();
        AscendC::DataCopy(input, initialDataGm, this->blockLength);
        inQueueInit.EnQue(input);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<float> input = inQueueInit.DeQue<float>();
        AscendC::LocalTensor<float> output = outQueueAtomic.AllocTensor<float>();
        AscendC::Muls(output, input, float(AscendC::GetBlockIdx()), this->blockLength);

        outQueueAtomic.EnQue<float>(output);
        inQueueInit.FreeTensor(input);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::SetAtomicAdd<float>();

        AscendC::LocalTensor<float> output = outQueueAtomic.DeQue<float>();
        AscendC::DataCopy(atomicResultGm, output, this->blockLength);   // PIPE_MTE3

        AscendC::CrossCoreSetFlag<0, PIPE_MTE3>(0);  // Set flag to notify other aiv that current aiv has finished DataCopy process
        AscendC::CrossCoreWaitFlag(0);               // Block current aiv until all aiv finish DataCopy process

        outQueueAtomic.FreeTensor(output);
        AscendC::SetAtomicNone();
    }

    __aicore__ inline void PrintTensor()
    {
        AscendC::LocalTensor<float> atomicRes = atomicResBuf.Get<float>();
        AscendC::DataCopy(atomicRes, atomicResultGm, this->blockLength);
        AscendC::printf("============== In PrintTensor Process AIV %d ==============", AscendC::GetBlockIdx());
        AscendC::DumpTensor(atomicRes, AscendC::GetBlockIdx(), this->blockLength);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueInit;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueAtomic;
    AscendC::TBuf<AscendC::TPosition::VECIN> atomicResBuf;

    AscendC::GlobalTensor<float> initialDataGm;
    AscendC::GlobalTensor<float> atomicResultGm;

    uint32_t blockLength;
};

__global__ __mix__(1,2) __aicore__ void crosscoresetflag_custom(GM_ADDR x, GM_ADDR z, uint32_t dataLength)
{
    KernelCrossCoreSetFlag op;
    // whole process does not involve AIC
    if ASCEND_IS_AIV {
        op.Init(x, z, dataLength);
        op.Process();
    }
}

std::vector<float> kernel_crosscoresetflag(std::vector<float> &x)
{
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(float);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t *xHost = reinterpret_cast<uint8_t *>(x.data());
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *zDevice = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)(&zHost), totalByteSize);
    aclrtMalloc((void **)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    crosscoresetflag_custom<<<BLOCK_DIM, nullptr, stream>>>(xDevice, zDevice, totalLength);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> z((float *)zHost, (float *)(zHost + totalLength));

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(output.begin(), output.end(), golden.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 32;
    constexpr float valueX = 1.0f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> output = kernel_crosscoresetflag(x);
    std::vector<float> golden(totalLength, valueX * (0 + BLOCK_DIM * 2 -1) * BLOCK_DIM);
    return VerifyResult(output, golden);
}