/* !
 * \file fixpipe_co12c1_quantization_f322s8.asc
 * \brief
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

// A No Trans, B No Trans
constexpr uint32_t M = 128;
constexpr uint32_t K = 128;
constexpr uint32_t N = 256;
constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

template <class inputType, class outputType, class l0cType>
class KernelMmad {
public:
    __aicore__ inline KernelMmad()
    {
        fractalShape[0] = 16;
        fractalShape[1] = 32 / sizeof(inputType);
        fractalSize = fractalShape[0] * fractalShape[1];
        fractalNum = sizeof(inputType) == 2 ? 1 : 2;
    }

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR quantAlpha)
    {
        aGM.SetGlobalBuffer((__gm__ inputType *)a);
        bGM.SetGlobalBuffer((__gm__ inputType *)b);
        cGM.SetGlobalBuffer((__gm__ outputType *)c);
        quantAlphaGM.SetGlobalBuffer((__gm__ uint64_t *)quantAlpha);
    }

    __aicore__ inline void Process()
    {
        // 构造静态tensor
        AscendC::LocalTensor<l0cType> c(AscendC::TPosition::CO1, cAddr, cSingleSize);
        AscendC::LocalTensor<uint64_t> quantAlphaTensor(AscendC::TPosition::C1, quantAlphaTensorAddr, quantAlignSize);
        AscendC::LocalTensor<inputType> a1Local(AscendC::TPosition::A1, a1LocalAddr, aSingleSize);
        AscendC::LocalTensor<inputType> b1Local(AscendC::TPosition::B1, b1LocalAddr, bSingleSize);
        AscendC::LocalTensor<inputType> a2Local(AscendC::TPosition::A2, a2LocalAddr, aSingleSize);
        AscendC::LocalTensor<inputType> b2Local(AscendC::TPosition::B2, b2LocalAddr, bSingleSize);
        AscendC::LocalTensor<outputType> c1Local(AscendC::TPosition::C1, c1LocalAddr, cSingleSize);
        AscendC::LocalTensor<uint64_t> fbTensor(AscendC::TPosition::C2PIPE2GM, fbAddr, quantAlignSize);

        uint32_t chunkSize = K_ROUND;

        for (uint32_t kIndex = 0; kIndex < chunkSize; kIndex++) {
            if constexpr (EN_LOADDATA_GM2L0 == 0) {
                // 数据从GM-->L1-->L0
                CopyIn(kIndex, a1Local, b1Local);
                SplitA(kIndex, a1Local, a2Local);
                SplitB(kIndex, b1Local, b2Local);
            } else {
                // 数据从GM-->L0
                LoadGM2L0A(kIndex, a2Local);
                LoadGM2L0B(kIndex, b2Local);
            }
            Compute(kIndex, a2Local, b2Local, c);
        }        
        CopyOutUseDataCopy(c, quantAlphaTensor, c1Local, fbTensor);
    }

private:
    __aicore__ inline uint16_t CeilDivision(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator;
    }

    __aicore__ inline uint16_t CeilAlign(uint16_t numerator, uint16_t denominator)
    {
        return (numerator + denominator - 1) / denominator * denominator;
    }

    __aicore__ inline void CopyIn(uint32_t kIndex, AscendC::LocalTensor<inputType>& a1Local, AscendC::LocalTensor<inputType>& b1Local)
    {
        // 反向同步
        // MTE1与MTE2流水在L1上存在读后写依赖
        if (kIndex != 0) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        }

        AscendC::Nd2NzParams nd2nzA1Params;
        // 传输ND矩阵的数目
        nd2nzA1Params.ndNum = 1;
        nd2nzA1Params.nValue = m;
        nd2nzA1Params.dValue = k;
        // 源操作数相邻ND矩阵起始地址间的偏移，单位为元素。
        nd2nzA1Params.srcNdMatrixStride = 0;
        nd2nzA1Params.srcDValue = k;
        // 目的NZ矩阵中，来自源操作数同一行的多行数据相邻行起始地址间的偏移，取值范围：dstNzC0Stride∈[1, 16384]，单位：C0_SIZE（32B）。
        nd2nzA1Params.dstNzC0Stride = CeilAlign(m, CUBE_BLOCK);
        // 目的NZ矩阵中，Z型矩阵相邻行起始地址之间的偏移。单位：C0_SIZE（32B）。
        nd2nzA1Params.dstNzNStride = 1;
        // 目的NZ矩阵中，相邻NZ矩阵起始地址间的偏移，单位为元素。
        nd2nzA1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1Local, aGM[kIndex * aSingleSize], nd2nzA1Params);

        AscendC::Nd2NzParams nd2nzB1Params;
        nd2nzB1Params.ndNum = 1;
        nd2nzB1Params.nValue = k;
        nd2nzB1Params.dValue = n;
        nd2nzB1Params.srcNdMatrixStride = 0;
        nd2nzB1Params.srcDValue = n;
        nd2nzB1Params.dstNzC0Stride = CeilAlign(k, CUBE_BLOCK);
        nd2nzB1Params.dstNzNStride = 1;
        nd2nzB1Params.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1Local, bGM[kIndex * bSingleSize], nd2nzB1Params);
    }

    __aicore__ inline void SplitA(uint32_t kIndex, AscendC::LocalTensor<inputType>& a1Local, AscendC::LocalTensor<inputType>& a2Local)
    {
        // MTE2与MTE1流水在L1上存在写后读依赖
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

        // 反向同步
        // MTE1与M流水在L0A上存在读后写依赖
        if (kIndex != 0) {
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
        }

        uint32_t dstOffset = CeilDivision(k, CUBE_BLOCK) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        // Nz -> Zz
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, CUBE_BLOCK);
        loadDataParams.srcStride = CeilDivision(m, CUBE_BLOCK);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        for (int i = 0; i < CeilDivision(m, CUBE_BLOCK); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }
    }

    __aicore__ inline void SplitB(uint32_t kIndex, AscendC::LocalTensor<inputType>& b1Local, AscendC::LocalTensor<inputType>& b2Local)
    {

        // MTE2与MTE1流水在L1上存在写后读依赖
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

        uint32_t dstOffset = CeilDivision(n, CUBE_BLOCK) * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        // Nz -> Zn
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.startIndex = 0;
        loadDataParams.repeatTimes = CeilDivision(n, CUBE_BLOCK);
        loadDataParams.srcStride = CeilDivision(k, CUBE_BLOCK);
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = true;
        for (int i = 0; i < CeilDivision(k, CUBE_BLOCK); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], b1Local[i * srcOffset], loadDataParams);
        }

        // 反向同步
        // MTE1与MTE2流水在L1上存在读后写依赖
        // 通知MTE2, MTE1搬出已完成
        if (kIndex != (K_ROUND - 1)) {
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID0);
        }
    }

    __aicore__ inline void LoadGM2L0A(uint32_t kIndex, AscendC::LocalTensor<inputType>& a2Local)
    {
        // 反向同步
        // M与MTE2流水在L0A、L0B上存在读后写依赖
        if (kIndex != 0) {
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE2>(EVENT_ID0);
        }

        uint32_t dstOffset = CeilDivision(k, fractalShape[1]) * fractalSize;
        uint32_t srcOffset = fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(k, fractalShape[1]);
        loadDataParams.srcStride = CeilDivision(m, fractalShape[0]);
        loadDataParams.dstGap = 0;
        for (uint16_t i = 0; i < CeilDivision(m, fractalShape[0]); ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], aGM[i * srcOffset], loadDataParams);
        }
    }
    __aicore__ inline void LoadGM2L0B(uint32_t kIndex, AscendC::LocalTensor<inputType>& b2Local)
    {
        uint32_t dstOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        uint32_t srcOffset = CeilDivision(n, fractalShape[0]) * fractalSize;
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = CeilDivision(n, fractalShape[0]);
        loadDataParams.srcStride = 1;
        loadDataParams.dstGap = 0;
        for (uint16_t i = 0; i < CeilDivision(k, fractalShape[1]); ++i) {
            AscendC::LoadData(b2Local[i * dstOffset], bGM[i * srcOffset], loadDataParams);
        }
    }
    __aicore__ inline void Compute(uint32_t kIndex, AscendC::LocalTensor<inputType>& a2Local, AscendC::LocalTensor<inputType>& b2Local, AscendC::LocalTensor<l0cType>& c)
    {
        if constexpr (EN_LOADDATA_GM2L0 == 0) {
            // M与MTE1流水在L0A、L0B上存在写后读依赖
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        } else {
            // M与MTE2流水在L0A、L0B上存在写后读依赖
            AscendC::SetFlag<AscendC::HardEvent::MTE2_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_M>(EVENT_ID0);
        }

        AscendC::MmadParams mmadParams;
        mmadParams.m = m;
        // mmad默认n轴向16对齐，但是由于b转置过程n轴向2 * 16对齐，填充了一个全部由无效数据的32 * 16的分形，
        // 如果仍然设置mmadParams.n = n，cube单元会多读入无效数据的分形同时有效数据的分形也未被读入。
        // 此时可以通过设置n向32对齐，让此分形参与计算，搬出时跳过无效分形参与计算的得到的分形即可
        mmadParams.n = CeilAlign(n, C0_SIZE);
        mmadParams.k = k;
        if (kIndex == 0) {
            mmadParams.cmatrixInitVal = true;
        } else {
            mmadParams.cmatrixInitVal = false;
        }
        AscendC::Mmad(c, a2Local, b2Local, mmadParams);
        if ((m / ALIGN_NUM) * (n / ALIGN_NUM) < LIMIT_MNSIZE) {
            AscendC::PipeBarrier<PIPE_M>();
        }

        // 反向同步
        if constexpr (EN_LOADDATA_GM2L0 == 0) {
            // loaddata接口从L1搬运数据到L0（MTE1流水）
            // M与MTE1流水在L0A、L0B上存在读后写依赖
            // 通知MTE1, M搬出已完成
            if (kIndex != (K_ROUND - 1)) {
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
            }
        } else {
            // loaddata接口直接从GM搬运数据到L0（MTE2流水）
            // M与MTE2流水在L0A、L0B上存在读后写依赖
            // 通知MTE2, M搬出已完成
            if (kIndex != (K_ROUND - 1)) {
                AscendC::SetFlag<AscendC::HardEvent::M_MTE2>(EVENT_ID0);
            }
        }

    }

  __aicore__ inline void CopyOutUseDataCopy(AscendC::LocalTensor<l0cType>& c, AscendC::LocalTensor<uint64_t>& quantAlphaTensor, AscendC::LocalTensor<outputType>& c1Local, AscendC::LocalTensor<uint64_t> fbTensor)
    {
        //由于CopyOutUseDataCopy只调用一次，不存在for循环，因此不需要进行反向同步

        // 一. GM-->L1，搬运tensor量化参数
        uint16_t burstLen1 = CeilAlign(n * sizeof(uint64_t), 128) / 32;
        AscendC::DataCopyParams intriParams1{ 1, burstLen1, 0, 0 };
        AscendC::DataCopy(quantAlphaTensor, quantAlphaGM, intriParams1);
    
        // MTE2与FIX流水在fp buffer存在写后读依赖
        AscendC::SetFlag<AscendC::HardEvent::MTE2_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_FIX>(EVENT_ID0);

        // 二. L1-->FP buffer，搬运tensor量化参数
        uint16_t burstLen2 = CeilAlign(n * sizeof(uint64_t), 128) / 128;
        AscendC::DataCopyParams dataCopyParams(1, burstLen2, 0, 0);
        AscendC::DataCopy(fbTensor, quantAlphaTensor, dataCopyParams);
        AscendC::SetFixPipeConfig(fbTensor);

        // quantAlphaTensor和c1Local分配的地址有重叠，
        // 并且两者之间存在读后写依赖关系，由于两个指令都属于PIPE_FIX，
        // 因此需要插入单流水同步指令：PipeBarrier<PIPE_FIX>().
        
        AscendC::PipeBarrier<PIPE_FIX>();

        // 三. L0C-->L1，做随路量化，不使能NZ2ND
        // M与FIX流水在L0C存在写后读依赖
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::DataCopyCO12DstParams intriParams;
        intriParams.nSize = CeilAlign(n, CUBE_BLOCK);
        intriParams.mSize = m;
        intriParams.srcStride = CeilAlign(m, CUBE_BLOCK);
        intriParams.dstStride = m * C0_SIZE * sizeof(outputType) / AscendC::ONE_BLK_SIZE;
        intriParams.quantPre = QuantMode_t::VQF322B8_PRE;
        AscendC::DataCopy(c1Local, c, intriParams);

        // 四.L1-->GM
        // FIX与MTE3流水在L0C存在写后读依赖
        AscendC::SetFlag<AscendC::HardEvent::FIX_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE3>(EVENT_ID0);
        AscendC::DataCopyParams dataCopyInfo;
        dataCopyInfo.blockCount = 1;
        dataCopyInfo.blockLen = n * m * sizeof(outputType) / AscendC::ONE_BLK_SIZE;
        AscendC::DataCopy(cGM, c1Local, dataCopyInfo);
    }

private:
    float quantScalar = 2.0;
    // 注意沿着K轴切分
    static constexpr uint16_t m = M, k = K / K_ROUND, n = N;
    static constexpr uint16_t aSingleSize = m * k;
    static constexpr uint16_t bSingleSize = k * n;
    static constexpr uint16_t cSingleSize = m * n;
    static constexpr uint16_t quantAlignSize = n;

    // 分形的shape
    uint16_t fractalShape[2] = {0, 0};
    // 分形包含的元素数目
    uint16_t fractalSize = 0;
    // 使能转置时，方块中包含的分形数目
    uint16_t fractalNum = 0;

    // 给静态tensor分配合适的起始地址
    // 注意所有地址的单位都是字节而不是元素个数
    // 位于L1上
    // quantAlphaTensor和c1Local分配的地址有重叠
    static constexpr uint32_t quantAlphaTensorAddr = 0;
    static constexpr uint32_t c1LocalAddr = (quantAlignSize * 0.5) * sizeof(uint64_t);

    static constexpr uint32_t b1LocalAddr = quantAlignSize * sizeof(uint64_t) + cSingleSize * sizeof(outputType);
    static constexpr uint32_t a1LocalAddr = quantAlignSize * sizeof(uint64_t) + cSingleSize * sizeof(outputType) + bSingleSize * sizeof(inputType);

    // 位于L0A上
    static constexpr uint32_t a2LocalAddr = 0;

    // 位于L0B上
    static constexpr uint32_t b2LocalAddr = 0;

    // 位于L0C上
    static constexpr uint32_t cAddr = 0;

    // 位于FP buffer上
    static constexpr uint32_t fbAddr = 0;

    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<int8_t> cGM;
    AscendC::GlobalTensor<uint64_t> quantAlphaGM;
};

extern "C" __cube__ __global__ void fixpipe_co12c1_quantization_f322s8(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR quantAlpha)
{
    KernelMmad<half, int8_t, float> op;
    op.Init(a, b, c, quantAlpha);
    op.Process();
}

int32_t main(int32_t argc, char *argv[])
{
    size_t aFileSize = M * K * sizeof(half); 
    size_t bFileSize = K * N * sizeof(half); 
    size_t cFileSize = M * N * sizeof(int8_t);
    size_t quantAlphaSize = 1 * N * sizeof(uint64_t);
    uint32_t numBlocks = 1;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost;
    uint8_t *aDevice;
    aclrtMallocHost((void **)(&aHost), aFileSize);
    aclrtMalloc((void **)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize);
    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *bHost;
    uint8_t *bDevice;
    aclrtMallocHost((void **)(&bHost), bFileSize);
    aclrtMalloc((void **)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t *cHost;
    uint8_t *cDevice;
    aclrtMallocHost((void **)(&cHost), cFileSize);
    aclrtMalloc((void **)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t *quantAlphaHost;
    uint8_t *quantAlphaDevice;
    aclrtMallocHost((void **)(&quantAlphaHost), quantAlphaSize);
    aclrtMalloc((void **)&quantAlphaDevice, quantAlphaSize, ACL_MEM_MALLOC_HUGE_FIRST);
    
    ReadFile("./input/quant_pre.bin", quantAlphaSize, quantAlphaHost, quantAlphaSize);
    aclrtMemcpy(quantAlphaDevice, quantAlphaSize, quantAlphaHost, quantAlphaSize, ACL_MEMCPY_HOST_TO_DEVICE);    

    fixpipe_co12c1_quantization_f322s8<<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, quantAlphaDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFreeHost(aHost);
    aclrtFree(bDevice);
    aclrtFreeHost(bHost);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtFree(quantAlphaDevice);
    aclrtFreeHost(quantAlphaHost);    

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}