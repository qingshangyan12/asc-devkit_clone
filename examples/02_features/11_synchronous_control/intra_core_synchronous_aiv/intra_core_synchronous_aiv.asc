/* !
 * \file intra_core_synchronous_aiv.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
// SCENARIO_NUM取值为0时，代表循环内不对矢量结果最终结果yLocal调用SetValue
// SCENARIO_NUM取值为1时，代表循环内对矢量结果最终结果yLocal调用SetValue
constexpr uint32_t SCENARIO_NUM = 0;
constexpr uint32_t calCount = 4096;
constexpr uint32_t bufferSize = 1024;
constexpr uint32_t loopCount = calCount / bufferSize;
class KernelSyncAiv {
public:
    __aicore__ inline KernelSyncAiv() {}

    __aicore__ inline void Init(GM_ADDR src0Gm, GM_ADDR src1Gm, GM_ADDR dst0Gm)
    {
        src0Global.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(src0Gm), calCount);
        src1Global.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(src1Gm), calCount);
        // 输出tensor dst0Global和dst1Global在GM上分配的地址区间有重叠
        // 为了保证了dst1Global的数据不会覆盖dst0Global在重叠区间的值，必须保证先搬入dst1Global，后搬入dst0Global
        dst0Global.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(dst0Gm), calCount);
        
        // dst0Global的尾部长度为bufferSize的区间与dst1Global的头部长度为bufferSize的区间重叠
        dst1Global.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(dst0Gm) + bufferSize / 2, calCount);
    }

    __aicore__ inline void Process()
    {
        // AIV内部一共存在4个硬件流水：S、V、MTE2、MTE3
        // 支持的多流水同步组合如下：
        // S_V、V_S
        // MTE2_MTE3、MTE3_MTE2
        // MTE2_V、V_MTE2、MTE3_V、V_MTE3
        // MTE2_S、S_MTE2、MTE3_S、S_MTE3

        AscendC::LocalTensor<float> src0Local(AscendC::TPosition::VECCALC, src0Addr, bufferSize);
        AscendC::LocalTensor<float> src1Local(AscendC::TPosition::VECCALC, src1Addr, bufferSize);
        AscendC::LocalTensor<float> dst0Local(AscendC::TPosition::VECOUT, dst0Addr, bufferSize);
        AscendC::LocalTensor<float> dst1Local(AscendC::TPosition::VECOUT, dst1Addr, bufferSize);

        AscendC::LocalTensor<float> tmpTensor1(AscendC::TPosition::VECCALC, tmp1Addr, bufferSize);
        AscendC::LocalTensor<float> tmpTensor2(AscendC::TPosition::VECCALC, tmp2Addr, bufferSize);

        float inputVal = 0.0f;
        float alpha = 0.001;
        float scalar1 = 100;
        float scalar2 = 2;
        float scalar3 = 50;

        for (uint32_t i = 0; i < loopCount; i++) {
            if (i != 0) {
                if(SCENARIO_NUM == 0) {
                    // 循环间依赖：先“DataCopy(PIPE_MTE3)读src1Local”，后 “DataCopy(PIPE_MTE2)写src1Local”
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                } else if(SCENARIO_NUM == 1) {
                    // 循环间依赖：先“SetValue(PIPE_S)写src1Local”，后 “DataCopy(PIPE_MTE2)写src1Local”
                    AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(EVENT_ID0);
                }
            }
            AscendC::DataCopy(src1Local, src1Global[i * bufferSize], bufferSize);

            // src0Local和src1Local在UB上分配的地址产生重叠，需要插入PipeBarrier<PIPE_MTE2>
            AscendC::PipeBarrier<PIPE_MTE2>();
            if (i != 0) {
                if(SCENARIO_NUM == 0) {
                    // 循环间依赖：先“Mins(PIPE_V)读src0Local”，后 “DataCopy(PIPE_MTE2)写src0Local”
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                } else if(SCENARIO_NUM == 1) {
                    // 循环间依赖：先“GetValue(PIPE_S)读src0Local”，后 “DataCopy(PIPE_MTE2)写src0Local”
                    AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(EVENT_ID0);
                }
            }
            AscendC::DataCopy(src0Local, src0Global[i * bufferSize], bufferSize);
            
            // 循环内依赖：先“DataCopy(PIPE_MTE2)写src0Local”，后 “Maxs和Mins（PIPE_V）读src0Local”
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::Maxs(tmpTensor1, src0Local, inputVal, bufferSize);
            AscendC::Mins(tmpTensor2, src0Local, inputVal, bufferSize);
            if (i != (loopCount - 1)) {
                if(SCENARIO_NUM == 0) {
                    // 所有读或写src0Local的指令在此处已经全部结束，因此可以通知下一轮循环可以继续搬入src0Local
                    // 循环间依赖：先“Mins(PIPE_V)读src0Local”，后 “DataCopy(PIPE_MTE2)写src0Local”
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                } else if(SCENARIO_NUM == 1) {
                    // Mins读src0Local，GetValue同样读取src0Local，读与读之间不存在数据依赖关系，不需要插入同步
                    src0Local.GetValue(0);
                    // 所有读或写src0Local的指令在此处已经全部结束，因此可以通知下一轮循环可以继续搬入src0Local
                    // 循环间依赖：先“GetValue(PIPE_S)读src0Local”，后 “DataCopy(PIPE_MTE2)写src0Local”
                    AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(EVENT_ID0);
                }
            }

            // 当两个vector指令之间存在数据依赖关系（例如Muls与Add两个vector指令之间），开发者无需手动插入，由编译器自动插入PipeBarrier<PIPE_V>()
            AscendC::Muls(tmpTensor2, tmpTensor2, alpha, bufferSize);

            if (i != 0) {
                // 循环间依赖：先“DataCopy(PIPE_MTE3)读dst0Local”，后 “Add(PIPE_V)写dst0Local”
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
            AscendC::Add(dst0Local, tmpTensor1, tmpTensor2, bufferSize);
            // 循环内依赖：先“Add(PIPE_V)写dst0Local”，后 “DataCopy(PIPE_MTE3)读dst0Local”
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            if(SCENARIO_NUM == 0) {
                // MTE2_MTE3和MTE3_MTE2这两种同步事件在AIV中的使用场景（数据从GM搬入UB后，不做任何计算直接搬出到GM）并无实际意义，仅作为演示
                // 循环间依赖：先“DataCopy(PIPE_MTE2)写src1Local”，后 “DataCopy(PIPE_MTE3)读src1Local”
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            } else if(SCENARIO_NUM == 1) {
                // 循环间依赖：先“DataCopy(PIPE_MTE2)写src1Local”，后 “SetValue(PIPE_S)写src1Local”
                AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
                src1Local.SetValue(0, scalar1);

                // 循环间依赖：先“SetValue(PIPE_S)写src1Local”，后 “Muls(PIPE_V)读src1Local”
                AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                AscendC::Muls(src1Local, src1Local, scalar2, bufferSize);
                // 循环间依赖：先“Muls(PIPE_V)写src1Local”，后 “SetValue(PIPE_S)写src1Local”
                AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                src1Local.SetValue(1, scalar3);
                // 循环间依赖：先“SetValue(PIPE_S)写src1Local”，后 “DataCopy(PIPE_MTE3)读src1Local”
                AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
            } 

            AscendC::DataCopy(dst1Global[i * bufferSize], src1Local, bufferSize);


            if (i != (loopCount - 1)) {
                if(SCENARIO_NUM == 0) {
                    // 循环间依赖：先“DataCopy(PIPE_MTE3)读src1Local”，后 “DataCopy(PIPE_MTE2)写src1Local”
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                } else if(SCENARIO_NUM == 1) {
                    // 循环内依赖：先“DataCopy(PIPE_MTE3)读src1Local”，后 “SetValue(PIPE_S)写src1Local”
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
                    src1Local.SetValue(2, scalar1 + scalar3);
                    // 循环间依赖：先“SetValue(PIPE_S)写src1Local”，后 “DataCopy(PIPE_MTE2)写src1Local”
                    AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(EVENT_ID0);
                }
            }
            // 每次循环时，两次DataCopy搬出到GM的地址都会产生重叠
            // 此时需要插入PipeBarrier<PIPE_MTE3>，保证dst1Global不会覆盖dst0Global
            AscendC::PipeBarrier<PIPE_MTE3>();
            AscendC::DataCopy(dst0Global[i * bufferSize], dst0Local, bufferSize);
            if (i != (loopCount - 1)) {
                // 循环间依赖：先“DataCopy(PIPE_MTE3)读dst0Local”，后 “Add(PIPE_V)写dst0Local”
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
    }

private:
    // 输入src0和src1在UB上分配的地址区间有重叠
    // 为了保证了src1的数据不会覆盖src0在重叠区间的值，必须保证先搬入src1，后搬入src0
    static constexpr uint32_t src0Addr = 0; // src0起始地址，长度为1024
    static constexpr uint32_t src1Addr = bufferSize * 0.5 * sizeof(float); // src1起始地址，长度为1024
    static constexpr uint32_t dst0Addr = bufferSize * 2 * sizeof(float);
    static constexpr uint32_t dst1Addr = bufferSize * 3 * sizeof(float);
    static constexpr uint32_t tmp1Addr = bufferSize * 4 * sizeof(float);
    static constexpr uint32_t tmp2Addr = bufferSize * 5 * sizeof(float);
    AscendC::GlobalTensor<float> src0Global, src1Global;
    AscendC::GlobalTensor<float> dst0Global, dst1Global;
};

__global__ __vector__ void kernel_intra_core_synchronous_aiv(GM_ADDR src0Gm, GM_ADDR src1Gm, GM_ADDR dst0Gm) 
{
 
    KernelSyncAiv op;
    op.Init(src0Gm, src1Gm, dst0Gm);
    op.Process();
}

int32_t main(int32_t argc, char *argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = calCount * sizeof(float);
    size_t outputByteSize = (calCount + 0.5 * bufferSize) * sizeof(float);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *src0Host, *src1Host, *dstHost;
    uint8_t *src0Device, *src1Device, *dstDevice;

    aclrtMallocHost((void **)(&src0Host), inputByteSize);
    aclrtMallocHost((void **)(&src1Host), inputByteSize);
    aclrtMallocHost((void **)(&dstHost), outputByteSize);
    aclrtMalloc((void **)&src0Device, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&src1Device, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&dstDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_src0.bin", inputByteSize, src0Host, inputByteSize);
    ReadFile("./input/input_src1.bin", inputByteSize, src1Host, inputByteSize);

    aclrtMemcpy(src0Device, inputByteSize, src0Host, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1Device, inputByteSize, src1Host, inputByteSize,
            ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_intra_core_synchronous_aiv<<<numBlocks, nullptr, stream>>>(src0Device, src1Device, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, outputByteSize, dstDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", dstHost, outputByteSize);

    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dstDevice);
    aclrtFreeHost(src0Host);
    aclrtFreeHost(src1Host);
    aclrtFreeHost(dstHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
