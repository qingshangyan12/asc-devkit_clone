/* !
 * \file unsupported_sync_test.asc
 * \brief
 */
#include <random>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
class UnsupportedSyncTest{
public:
    __aicore__ inline UnsupportedSyncTest() {}
    __aicore__ inline void Init(__gm__ uint8_t* src0Gm, __gm__ uint8_t* src1Gm, __gm__ uint8_t* dstGm)
    {
        src0Global.SetGlobalBuffer((__gm__ float*)src0Gm, srcDataSize);
        src1Global.SetGlobalBuffer((__gm__ float*)src1Gm, srcDataSize);
        dstGlobal.SetGlobalBuffer((__gm__ float*)dstGm, dstDataSize);
    }
    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIC {
            if (scenarioNum == 1) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::M_V>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::M_V>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_M to PIPE_V is not supported!\n");
            } else if (scenarioNum == 2) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::V_M>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::V_M>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_M is not supported!\n");
            } else if (scenarioNum == 3) {
                // 调用SetFlag接口。ASC不支持。set_flag(PIPE_V, PIPE_FIX, EVENT_ID1);
                // 调用WaitFlag接口。ASC不支持。wait_flag(PIPE_V, PIPE_FIX, EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_FIX is not supported!\n");
            } else if (scenarioNum == 4) {
                // 调用SetFlag接口。ASC不支持。set_flag(PIPE_FIX, PIPE_V, EVENT_ID1);
                // 调用WaitFlag接口。ASC不支持。wait_flag(PIPE_FIX, PIPE_V, EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_FIX to PIPE_V is not supported!\n");
            } else if (scenarioNum == 5) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::V_MTE1>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::V_MTE1>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_MTE1 is not supported!\n");
            } else if (scenarioNum == 6) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::MTE1_V>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::MTE1_V>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_MTE1 is not supported!\n");
            } 
        }
        if ASCEND_IS_AIV {
            if (scenarioNum == 1) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::M_V>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::M_V>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_M to PIPE_V is not supported!\n");
            } else if (scenarioNum == 2) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::V_M>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::V_M>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_M is not supported!\n");
            } else if (scenarioNum == 3) {
                // 调用SetFlag接口。ASC不支持。set_flag(PIPE_V, PIPE_FIX, EVENT_ID1);
                // 调用WaitFlag接口。ASC不支持。wait_flag(PIPE_V, PIPE_FIX, EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_FIX is not supported!\n");
            } else if (scenarioNum == 4) {
                // 调用SetFlag接口。ASC不支持。set_flag(PIPE_FIX, PIPE_V, EVENT_ID1);
                // 调用WaitFlag接口。ASC不支持。wait_flag(PIPE_FIX, PIPE_V, EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_FIX to PIPE_V is not supported!\n");
            } else if (scenarioNum == 5) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::V_MTE1>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::V_MTE1>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_MTE1 is not supported!\n");
            } else if (scenarioNum == 6) {
                // 调用SetFlag接口。AscendC::SetFlag<AscendC::HardEvent::MTE1_V>(EVENT_ID1);
                // 调用WaitFlag接口。AscendC::WaitFlag<AscendC::HardEvent::MTE1_V>(EVENT_ID1);
                ascendc_assert(false, "SetFlag/WaitFlag From PIPE_V to PIPE_MTE1 is not supported!\n");
            }
        }

        AscendC::LocalTensor<float> src0Local(AscendC::TPosition::VECCALC, src0Addr, srcDataSize);
        AscendC::LocalTensor<float> src1Local(AscendC::TPosition::VECCALC, src1Addr, srcDataSize);
        AscendC::LocalTensor<float> dstLocal(AscendC::TPosition::VECCALC, dstAddr, srcDataSize);

        AscendC::DataCopy(src0Local, src0Global, srcDataSize);
        AscendC::DataCopy(src1Local, src1Global, srcDataSize);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Add(dstLocal, src0Local, src1Local, srcDataSize);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        AscendC::DataCopy(dstGlobal, dstLocal, dstDataSize);
    }
private:
    static constexpr uint32_t src0Addr = 0;
    static constexpr uint32_t src1Addr = 256 * sizeof(float);
    static constexpr uint32_t dstAddr = 256 * 2 * sizeof(float);
    AscendC::GlobalTensor<float> src0Global, src1Global;
    AscendC::GlobalTensor<float> dstGlobal;
    uint32_t srcDataSize = 256;
    uint32_t dstDataSize = srcDataSize;
};

__global__ __mix__(1, 2) void unsupported_sync_test_custom(GM_ADDR src0, GM_ADDR src1, GM_ADDR dst)
{
    AscendC::InitSocState();
    UnsupportedSyncTest op;
    op.Init(src0, src1, dst);
    op.Process();
}

static bool CompareResult(const void* outputData, const void* goldenData, uint32_t outSize)
{
    size_t goldenSize = outSize;
    constexpr float EPS = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > EPS && re > EPS) {
            printf("CompareResult failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    if (wrongNum != 0) {
        return false;
    } else {
        return true;
    }
}

struct GoldenData {
    std::vector<float> src0;
    std::vector<float> src1;
    std::vector<float> golden;
};

GoldenData gen_golden_data()
{
    const int totalLength = 256;
    std::vector<float> src0(totalLength, 1);
    std::vector<float> src1(totalLength, 1);
    std::vector<float> golden(totalLength);
    for (size_t i = 0; i < golden.size(); ++i) {
        golden[i] = src0[i] + src1[i];
    }
    return {src0, src1, golden};
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 256 * sizeof(float);
    size_t outputByteSize = 256 * sizeof(float);

    auto genData = gen_golden_data();
    auto src0 = genData.src0;
    auto src1 = genData.src1;
    auto golden = genData.golden;
    uint8_t* goldenHost = reinterpret_cast<uint8_t*>(golden.data());

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *dstHost;
    uint8_t *src0Device, *src1Device, *dstDevice;

    aclrtMallocHost((void **)(&dstHost), outputByteSize);
    aclrtMalloc((void **)&src0Device, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&src1Device, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&dstDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    uint8_t* src0Host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* src1Host = reinterpret_cast<uint8_t*>(src1.data());

    aclrtMemcpy(src0Device, inputByteSize, src0Host, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1Device, inputByteSize, src1Host, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    unsupported_sync_test_custom<<<numBlocks, nullptr, stream>>>(src0Device, src1Device, dstDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstHost, outputByteSize, dstDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    bool goldenResult = true;
    goldenResult = CompareResult(dstHost, goldenHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dstDevice);
    aclrtFreeHost(src0Host);
    aclrtFreeHost(src1Host);
    aclrtFreeHost(dstHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
