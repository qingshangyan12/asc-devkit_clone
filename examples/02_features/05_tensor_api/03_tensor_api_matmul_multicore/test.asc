template <typename A_TYPE, typename B_TYPE, typename C_TYPE, uint32_t blockDim, 
    uint32_t m, uint32_t n, uint32_t k, uint32_t singleCoreM, uint32_t singleCoreN, uint32_t singleCoreK,
    uint32_t baseM, uint32_t baseN, uint32_t baseK, uint32_t stepM, uint32_t stepN, uint32_t stepK,
    uint32_t isTransposeA, uint32_t isTransposeB>
__aicore__ inline void MatMulKernel(GM_ADDR src0Gm, GM_ADDR src1Gm, GM_ADDR dstGm)
{

    /*
        本样例M/N轴分核（不存在尾核）,核内singleCoreM/singleCoreN/singleCoreK轴切块（不存在尾块）,half类型，GM ND输入输出
        GM                   L1                            L0                    L0C               GM
        A:[m,k]   [k/c0Size,m/16,16,c0Size]    [k/c0Size,m/16,16,c0Size]
        B:[k,n]   [n/c0Size,k/16,16,c0Size]    [k/c0Size,n/16,16,c0Size]
        C:[m,n]                                                            [n/16,m/16,16,16]      [m,n]
        stepM=1，
        stepN=1,
        stepK=singleK//baseK
    */
    // cube core cases, ignore vector core
    if (g_coreType == AscendC::AIV) {
        return;
    }

    // if (get_block_idx() !=0) {
    //     return;
    // }
    // 计算多核偏移
    // 方法1：计算多核偏移，ptr上直接偏移
    int gmOffsetA = 0;
    int gmOffsetB = 0;
    int gmOffsetC = 0;

    InitGMOffsets<C_TYPE, A_TYPE, B_TYPE, m, k, n, singleCoreM, singleCoreK, singleCoreN>(gmOffsetA, gmOffsetB, gmOffsetC);
    // ksks --确认下用那种方式去MakeLayout(连续、不连续)
    // auto singelLayoutA = MakeLayout(MakeShape(singleCoreM, singleCoreK), MakeStride(singleCoreK, 1));
    // // auto singelLayoutA = MakeLayout(MakeShape(MakeShape(AscendC::Std::Int<1>{}, singleCoreM), MakeShape(AscendC::Std::Int<1>{}, singleCoreK)), MakeStride(MakeStride(AscendC::Std::Int<0>{}, singleCoreK), MakeStride(AscendC::Std::Int<0>{}, AscendC::Std::Int<1>{})));
    // auto singelLayoutB = MakeLayout(MakeShape(MakeShape(AscendC::Std::Int<1>{}, singleCoreK), MakeShape(AscendC::Std::Int<1>{}, singleCoreN)), MakeStride(MakeStride(AscendC::Std::Int<0>{}, n), MakeStride(AscendC::Std::Int<0>{}, AscendC::Std::Int<1>{})));
    // auto singelLayoutC = MakeLayout(MakeShape(MakeShape(AscendC::Std::Int<1>{}, singleCoreM), MakeShape(AscendC::Std::Int<1>{}, singleCoreN)), MakeStride(MakeStride(AscendC::Std::Int<0>{}, n), MakeStride(AscendC::Std::Int<0>{}, AscendC::Std::Int<1>{})));

    // auto gmPtrA = MakeGMmemPtr(reinterpret_cast<__gm__ A_TYPE*>(src0Gm) + gmOffsetA);// ksks 临时规避调试，正式使用方式2.2
    // auto gmPtrB = MakeGMmemPtr(reinterpret_cast<__gm__ B_TYPE*>(src1Gm) + gmOffsetB);
    // auto gmPtrC = MakeGMmemPtr(reinterpret_cast<__gm__ C_TYPE*>(dstGm) + gmOffsetC);

    // auto globalA = MakeTensor(gmPtrA, singelLayoutA);
    // auto globalB = MakeTensor(gmPtrB, singelLayoutB);
    // auto globalC = MakeTensor(gmPtrC, singelLayoutC);

    // 方式2.2：==> √
    auto gmPtrA = MakeGMmemPtr(reinterpret_cast<__gm__ A_TYPE*>(src0Gm));// ksks 临时规避调试，正式使用方式2.2
    auto gmPtrB = MakeGMmemPtr(reinterpret_cast<__gm__ B_TYPE*>(src1Gm));
    auto gmPtrC = MakeGMmemPtr(reinterpret_cast<__gm__ C_TYPE*>(dstGm));

    auto gmA = MakeTensor(gmPtrA, MakeLayout(MakeShape(m,k), MakeStride(k, AscendC::Std::Int<1>{})));// ksks当前错误，原因是二维转4维的时候stride信息未传递进去，使用shape构造了stride信息
    auto gmB = MakeTensor(gmPtrB, MakeLayout(MakeShape(k,n), MakeStride(n, AscendC::Std::Int<1>{})));
    auto gmC = MakeTensor(gmPtrC, MakeLayout(MakeShape(m,n), MakeStride(n, AscendC::Std::Int<1>{})));

    // auto gmA = MakeTensor(gmPtrA, MakeLayout(MakeShape(MakeShape(AscendC::Std::Int<1>{}, m), MakeShape(AscendC::Std::Int<1>{}, k)), MakeStride(MakeStride(AscendC::Std::Int<0>{}, k), MakeStride(AscendC::Std::Int<0>{}, AscendC::Std::Int<1>{}))));
    // auto gmB = MakeTensor(gmPtrB, MakeLayout(MakeShape(MakeShape(AscendC::Std::Int<1>{}, k), MakeShape(AscendC::Std::Int<1>{}, n)), MakeStride(MakeStride(AscendC::Std::Int<0>{}, n), MakeStride(AscendC::Std::Int<0>{}, AscendC::Std::Int<1>{}))));
    // auto gmC = MakeTensor(gmPtrC, MakeLayout(MakeShape(MakeShape(AscendC::Std::Int<1>{}, m), MakeShape(AscendC::Std::Int<1>{}, n)), MakeStride(MakeStride(AscendC::Std::Int<0>{}, n), MakeStride(AscendC::Std::Int<0>{}, AscendC::Std::Int<1>{}))));

    // 对于单核的数据
    constexpr uint32_t mIter = m / singleCoreM;
    uint32_t mIterIdx = get_block_idx() % mIter; // get current launch core idx
    uint32_t nIterIdx = get_block_idx() / mIter;

    auto shapeA = MakeShape(singleCoreM, singleCoreK);
    auto globalA = gmA(MakeCoord(mIterIdx * singleCoreM, 0), shapeA);

    auto shapeB = MakeShape(singleCoreK, singleCoreN);
    auto globalB = gmB(MakeCoord(0, nIterIdx * singleCoreN), shapeB);

    auto shapeC = MakeShape(singleCoreM, singleCoreN);
    auto globalC = gmC(MakeCoord(mIterIdx * singleCoreM, nIterIdx * singleCoreN), shapeC);

    auto l1ALayout = MakeNzLayout<A_TYPE>(baseM * stepM, baseK * stepK);// 单核GM->L1每次搬运stepM*stepK个base块
    auto l1BLayout = MakeNzLayout<A_TYPE>(baseK * stepK, baseN * stepN);
    // A: ND:(M, K) DN: (K,M)
    // B: ND:(K, N) DN:(N,K) 
    // scaleK = CeilAlign(K,64) * 2; K=31, scaleK=2
    // scaleA:
        // ND (M, scaleK) : auto l1ScaleALayout = MakeScaleANDLayout<float8_e8m0_t>(M, scaleK);
        // DN (scaleK,M) : auto l1ScaleALayout = MakeScaleADNLayout<float8_e8m0_t>(M, scaleK);
        // Zz (M/16, scaleK/2, 16, 2): auto l1ScaleALayout = MakeZzLayout<float8_e8m0_t>(M, scaleK);
    // scaleB:
        // ND (scaleK，N) : auto l1ScaleBLayout = MakeScaleBNDLayout<float8_e8m0_t>(scaleK, N);
        // DN (N, scaleK) : auto l1ScaleBLayout = MakeScaleBDNLayout<float8_e8m0_t>(scaleK, N);
        // Nn (N/16, scaleK/2, 16, 2): auto l1ScaleBLayout = MakeNnLayout<float8_e8m0_t>(scaleK, N);
    // ND:(scaleK, N) DN:(N,scaleK)
    // auto l1ScaleALayout = MakeScaleANDLayout<float8_e8m0_t>(M, scaleK);// ND:(m,ceil(K/64)*2), DN:(ceil(k/64)*2, m)
    // auto l1ScaleBLayout = MakeScaleBNDLayout<float8_e8m0_t>(scaleK, N);// ND:(ceil(k/64)*2, n), DN:(n, ceil(k/64)*2)
    // mx场景scale输入数据类型是float8_e8m0_t，分形是16*2 (原本B8的分形是16*32);
    // auto l1ScaleALayout = MakeZzLayout<float8_e8m0_t>(...);// 用数据类型float8_e8m0_t特化
    // auto l1ScaleBLayout = MakeNnLayout<float8_e8m0_t>(...);// 用数据类型float8_e8m0_t特化

    auto l0ALayout = MakeNzLayout<B_TYPE>(baseM, baseK);// 单核L1->L0每次搬运1个base块
    auto l0BLayout = MakeZnLayout<B_TYPE>(baseK, baseN);
    auto l0CLayout = MakeL0CLayout(baseM, baseN);// 单核每次计算1个base块

    // __cbuf__ A_TYPE  l1ABuf[baseM * stepM * baseK * stepK];
    // __cbuf__ A_TYPE  l1BBuf[baseK * stepK * baseN * stepN];
    // __ca__   B_TYPE  l0ABuf[baseM * baseK];
    // __cb__   B_TYPE  l0BBuf[baseK * baseN];
    // __cc__   C_TYPE l0CBuf[baseM * baseN];

    __cbuf__ A_TYPE  *l1ABuf = (__cbuf__ A_TYPE  *)0;// ksks 临时规避调试，正式使用[]申请内存
    __cbuf__ A_TYPE  *l1BBuf = (__cbuf__ B_TYPE  *)0 + baseM * stepM * baseK * stepK;
    __ca__   B_TYPE  *l0ABuf = (__ca__ A_TYPE  *)0;
    __cb__   B_TYPE  *l0BBuf = (__cb__ B_TYPE  *)0;
    __cc__   C_TYPE *l0CBuf = (__cc__ C_TYPE  *)0;
    // __cc__   float *l0CBuf = (__cc__ float  *)0;
    

    auto l1APtr = MakeL1memPtr(l1ABuf);// ksks 临时规避调试
    auto l1BPtr = MakeL1memPtr(l1BBuf);
    auto l0APtr = MakeL0AmemPtr(l0ABuf);
    auto l0BPtr = MakeL0BmemPtr(l0BBuf);
    auto l0CPtr = MakeL0CmemPtr(l0CBuf);

    // TODO
    // auto l1APtr = MakeL1memPtrNew<A_TYPE>(0);// ksks正式方案？-->报错
    // auto l1BPtr = MakeL1memPtr<B_TYPE>(baseM * stepM * baseK * stepK);

    auto l1ATensor = MakeTensor(l1APtr, l1ALayout);
    auto l1BTensor = MakeTensor(l1BPtr, l1BLayout);
    auto l0ATensor = MakeTensor(l0APtr, l0ALayout);
    auto l0BTensor = MakeTensor(l0BPtr, l0BLayout);
    auto l0CTensor = MakeTensor(l0CPtr, l0CLayout);

    // 单核计算逻辑
    constexpr uint32_t mLoop = singleCoreM / baseM;
    constexpr uint32_t nLoop = singleCoreN / baseN;
    constexpr uint32_t kLoop = singleCoreK / baseK;

    set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0); // 反向同步，抵消第一次的wait
    set_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);
    set_flag(PIPE_FIX, PIPE_M, EVENT_ID0);

    // 1、globalA如果是slice过后的，globalA的shape表示的是真实搬运的大小，stride是原始的stride
    // 2、用MakeCoord的方式, 会用dst的信息推算slice应该用的shape，再内部调用slice;
    // 3、不slice，不coord，等同于2；
    for (uint32_t i = 0; i < mLoop; i++) {
        for (uint32_t j = 0; j < nLoop; j++) {
            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                // 1、GM->L1--------------------------------------------------------------------
                if (kIter % stepK == 0) {
                    wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);// 等待L1中的缓存使用完，再进行GM->L1的搬运
                    // GM -> L1A
                    Copy(CopyAtom<CopyTraits<CopyGM2L1, DataCopyTraitDefault>>{}, l1ATensor, globalA, MakeCoord(i * stepM * baseM, kIter * baseK));// L1k = 32
                    // GM -> L1B
                    Copy(CopyAtom<CopyTraits<CopyGM2L1, DataCopyTraitDefault>>{}, l1BTensor, globalB, MakeCoord(kIter * baseK, j * stepN * baseN));
                    set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);// 通知Mte1流水，mte2搬完了，可以开始Mte1了
                }
                // 2、L1->L0A/B-----------------------------------------------------------------
                if (kIter % stepK == 0) {
                    wait_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);//等本轮的Mte2结束
                }
                wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);// 等待上一轮的L0中的缓存使用完（M流水结束），再进行L1->L0的搬运
                // L1A -> L0A
                Copy(CopyAtom<CopyTraits<CopyL12L0, LoadDataTraitDefault>>{}, l0ATensor, l1ATensor, MakeCoord(0, kIter % stepK * baseK));// todo: (startm, startk) = (0, kIter % stepK * baseK)
                // // L1B -> L0B
                Copy(CopyAtom<CopyTraits<CopyL12L0, LoadData2BTrait>>{}, l0BTensor, l1BTensor, MakeCoord(kIter % stepK * baseK, 0));// todo:(startk, startn) = (kIter % stepK * baseK, 0)
                if ((kIter + 1) % stepK == 0) {
                    set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);// k全载完，可以进行下一次Mte2搬运
                }
                set_flag(PIPE_MTE1, PIPE_M, EVENT_ID0);// 通知M流水，mte1搬完了，可以开始cube运算了

                // 3、L0A/B->L0C---------------------------------------------------------------
                wait_flag(PIPE_MTE1, PIPE_M, EVENT_ID0);// 等本轮的MTE1结束
                
                if (kIter % stepK == 0) {
                    wait_flag(PIPE_FIX, PIPE_M, EVENT_ID0);// 这里需要等上一轮K轴完全累加计算的结果搬运完之后（FIX流水结束），再进行MMAD运算往L0C写数据
                }

                MmadParams para;
                if (kIter == 0) {
                    para.cmatrixInitVal = true;
                    Mad(MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}, l0CTensor, l0ATensor, l0BTensor, para);
                    // Mad(MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}, l0CTensor, l0ATensor, l0BTensor, uf, gemv, m, n, k);
                } else {
                    para.cmatrixInitVal = false;
                    Mad(MmadAtom<MmadTraits<MmadOperation, MmadTraitDefault>>{}, l0CTensor, l0ATensor, l0BTensor, para);
                }
                if (kIter == kLoop - 1) {
                    set_flag(PIPE_M, PIPE_FIX, EVENT_ID0);// 通知k轴累加cube计算完，可以进行fix搬运
                }
                set_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);// 通知下一轮MTE1流水，cube计算完了，可以开始mte1运算了
            }

            // 4、L0C->GM----------------------------------------------------------------------
            wait_flag(PIPE_M, PIPE_FIX, EVENT_ID0);
            // TILE_OP_INTERNAL_DIRECT_QUANT_MODE
            Copy(CopyAtom<CopyTraits<CopyL0C2GM, FixpipeTraitDefault>>{}, globalC, l0CTensor, MakeCoord(i * baseM, j * baseN));
            set_flag(PIPE_FIX, PIPE_M, EVENT_ID0);
        }
    }

    wait_flag(PIPE_M, PIPE_MTE1, EVENT_ID0);// 抵消最后一次的set
    wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
    wait_flag(PIPE_FIX, PIPE_M, EVENT_ID0);