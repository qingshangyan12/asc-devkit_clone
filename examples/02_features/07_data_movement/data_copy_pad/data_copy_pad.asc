/* !
 * \file data_copy_pad.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

// 数据拷贝与填充处理内核类
class KernelDataCopyPad {
public:
    // 构造函数
    __aicore__ inline KernelDataCopyPad() {}
    
    // 初始化函数：设置全局内存指针和pipe
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;  // 传入的流水线指针
        srcGlobal.SetGlobalBuffer((__gm__ half *)srcGm);  // 设置源全局缓冲区
        dstGlobal.SetGlobalBuffer((__gm__ half *)dstGm);  // 设置目标全局缓冲区
        pipe->InitBuffer(inQueueSrc, 1, 32 * sizeof(half));  // 初始化输入队列缓冲区
        pipe->InitBuffer(outQueueDst, 1, 32 * sizeof(half));  // 初始化输出队列缓冲区
    }
    
    // 主处理流程
    __aicore__ inline void Process()
    {
        CopyIn();   // 数据搬运入核
        Compute();  // 计算处理
        CopyOut();  // 数据搬运出核
    }
    
private:
    // 数据搬运入核函数
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.AllocTensor<half>();  // 分配本地张量
        
        // 配置数据拷贝参数
        // 参数说明：1-搬运模式，20*half大小-数据长度，0-重复搬运次数，0-块间距离，0-保留位
        AscendC::DataCopyExtParams copyParams{1, 20 * sizeof(half), 0, 0, 0}; 
        
        // 配置数据填充参数
        // 参数说明：true-启用填充，0-填充偏移，2-填充块数，0-保留位
        AscendC::DataCopyPadExtParams<half> padParams{true, 0, 2, 0};
        
        // 执行带填充的数据拷贝：从全局内存到本地缓冲区
        AscendC::DataCopyPad(srcLocal, srcGlobal, copyParams, padParams); 
        
        inQueueSrc.EnQue<half>(srcLocal);  // 入队处理
    }
    
    // 计算处理函数
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.DeQue<half>();  // 从队列中取出源数据
        AscendC::LocalTensor<half> dstLocal = outQueueDst.AllocTensor<half>();  // 分配目标张量
        
        // 执行加法运算：dst = src + scalar，处理20个元素
        AscendC::Adds(dstLocal, srcLocal, scalar, 20);
        
        outQueueDst.EnQue(dstLocal);  // 计算结果入队
        inQueueSrc.FreeTensor(srcLocal);  // 释放源张量
    }
    
    // 数据搬运出核函数
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dstLocal = outQueueDst.DeQue<half>();  // 从队列中取出结果
        
        // 配置数据拷贝参数
        AscendC::DataCopyExtParams copyParams{1, 20 * sizeof(half), 0, 0, 0};
        
        // 执行数据拷贝：从本地缓冲区到全局内存
        AscendC::DataCopyPad(dstGlobal, dstLocal, copyParams);
        
        outQueueDst.FreeTensor(dstLocal);  // 释放目标张量
    }
    
private:
    AscendC::TPipe* pipe;  // 流水线指针
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;  // 输入队列
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;  // 输出队列
    AscendC::GlobalTensor<half> srcGlobal;  // 源全局张量
    AscendC::GlobalTensor<half> dstGlobal;  // 目标全局张量
    AscendC::DataCopyPadExtParams<half> padParams;  // 数据填充参数
    AscendC::DataCopyExtParams copyParams;  // 数据拷贝参数
    half scalar = 0;  // 加法标量值
};

// 核函数入口：使用__vector__标记向量化核函数
__global__ __vector__ void data_copy_pad_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;  // 创建流水线对象
    KernelDataCopyPad op;  // 创建内核处理对象
    op.Init(x, z, &pipe);  // 初始化内核
    op.Process();  // 执行处理流程
}

// 主函数：负责主机端资源管理和任务调度
int32_t main(int32_t argc, char* argv[]) 
{
    // 配置参数
    uint32_t numBlocks = 1;  // 核函数块数
    size_t inputByteSize = 32 * sizeof(half);  // 输入数据大小
    size_t outputByteSize = inputByteSize;  // 输出数据大小

    // 设备初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);  // 设置设备
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);  // 创建流

    // 主机和设备内存指针声明
    uint8_t *xHost, *zHost;  // 主机端内存指针
    uint8_t *xDevice, *zDevice;  // 设备端内存指针

    // 分配主机端内存
    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    
    // 分配设备端内存
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 从文件读取输入数据
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    // 数据传输：主机到设备
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    // 启动核函数执行
    data_copy_pad_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    
    // 等待流同步
    aclrtSynchronizeStream(stream);

    // 数据传输：设备到主机
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    
    // 写入输出文件
    WriteFile("./output/output.bin", zHost, outputByteSize);

    // 释放内存资源
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    // 清理资源
    aclrtDestroyStream(stream);  // 销毁流
    aclrtResetDevice(deviceId);  // 重置设备
    aclFinalize();  // ACL库清理

    return 0;
}