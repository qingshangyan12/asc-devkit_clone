/* !
 * \file data_copy_pad.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

class KernelDataCopyPad {
public:
    __aicore__ inline KernelDataCopyPad() {}
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        srcGlobal.SetGlobalBuffer((__gm__ half *)srcGm);
        dstGlobal.SetGlobalBuffer((__gm__ half *)dstGm);
        pipe->InitBuffer(inQueueSrc, 1, 32 * sizeof(half));
        pipe->InitBuffer(outQueueDst, 1, 32 * sizeof(half));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.AllocTensor<half>();
        
        // 配置数据拷贝参数
        // 参数说明：1-数据块个数，20*half-数据长度，0-源数据块的间隔，0-目的数据块的间隔，0-保留位
        AscendC::DataCopyExtParams copyParams{1, 20 * sizeof(half), 0, 0, 0}; 
        
        // 配置数据填充参数
        // 参数说明：true-启用填充，0-数据块左侧填充范围，12-数据块右侧填充范围，1-填充值
        AscendC::DataCopyPadExtParams<half> padParams{true, 0, 12, 1};
        
        // 非32字节对齐数据拷贝：从全局内存到本地缓冲区
        AscendC::DataCopyPad(srcLocal, srcGlobal, copyParams, padParams); 
        
        inQueueSrc.EnQue<half>(srcLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<half> srcLocal = inQueueSrc.DeQue<half>();
        AscendC::LocalTensor<half> dstLocal = outQueueDst.AllocTensor<half>();
        AscendC::Adds(dstLocal, srcLocal, scalar, 20);
        outQueueDst.EnQue(dstLocal);
        inQueueSrc.FreeTensor(srcLocal);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<half> dstLocal = outQueueDst.DeQue<half>();
        AscendC::DataCopyExtParams copyParams{1, 20 * sizeof(half), 0, 0, 0};
        AscendC::DataCopyPad(dstGlobal, dstLocal, copyParams); // 从VECIN->GM搬运40字节
        outQueueDst.FreeTensor(dstLocal);
    }
private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;
    AscendC::GlobalTensor<half> srcGlobal;
    AscendC::GlobalTensor<half> dstGlobal;
    AscendC::DataCopyPadExtParams<half> padParams;
    AscendC::DataCopyExtParams copyParams;
    half scalar = 0;
};

template <typename T>
class KernelSetPadValue {
public:
    __aicore__ inline KernelSetPadValue() {}
    __aicore__ inline void Init(__gm__ uint8_t* dstGm, __gm__ uint8_t* srcGm, uint32_t n1, uint32_t n2, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;
        m_n1 = n1;
        m_n2 = n2;
        m_n2Align = n2 % 32 == 0 ? n2 : (n2 / 32 + 1) * 32;
        m_srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm);
        m_dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);

        pipe->InitBuffer(m_queInSrc, 1, m_n1 * m_n2Align * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> srcLocal = m_queInSrc.AllocTensor<T>();
        AscendC::DataCopyExtParams dataCopyExtParams;
        AscendC::DataCopyPadExtParams<T> padParams;

        dataCopyExtParams.blockCount = m_n1;
        dataCopyExtParams.blockLen = m_n2 * sizeof(T);
        dataCopyExtParams.srcStride = 0;
        dataCopyExtParams.dstStride = 0;

        padParams.isPad = false;
        padParams.leftPadding = 0;
        padParams.rightPadding = 1;

        AscendC::SetPadValue((T)37);
        int32_t eventID = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::S_MTE2));
        AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(eventID);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(eventID);
        AscendC::DataCopyPad(srcLocal, m_srcGlobal, dataCopyExtParams, padParams);
        m_queInSrc.EnQue(srcLocal);
    }
    __aicore__ inline void Compute()
    {

    }
    __aicore__ inline void CopyOut()
    {
        int32_t eventID = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_MTE3));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(eventID);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(eventID);

        AscendC::LocalTensor<T> dstLocal = m_queInSrc.DeQue<T>();
        AscendC::DataCopy(m_dstGlobal, dstLocal, m_n1 * m_n2Align);
        m_queInSrc.FreeTensor(dstLocal);
    }
private:
    AscendC::TPipe* pipe;
    uint32_t m_n1;
    uint32_t m_n2;
    uint32_t m_n2Align;
    AscendC::GlobalTensor<T> m_srcGlobal;
    AscendC::GlobalTensor<T> m_dstGlobal;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> m_queInSrc;
};

__global__ __vector__ void data_copy_pad_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;
    KernelDataCopyPad op;
    op.Init(x, z, &pipe);
    op.Process();
}

__global__ __vector__ void set_pad_value_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;
    KernelSetPadValue<half> op;
    uint32_t n1 =32;
    uint32_t n2 =31;
    op.Init(z, x, n1, n2, &pipe);
    op.Process();
}


int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t numBlocks = 1;
    size_t inputByteSize = 32 * sizeof(half);
    size_t outputByteSize = inputByteSize;

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *zHost;
    uint8_t *xDevice, *zDevice;

    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    data_copy_pad_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    size_t inputByteSize2 = 32 * 32 * sizeof(half);
    size_t outputByteSize2 = inputByteSize2;

    uint8_t *xHost2, *zHost2;
    uint8_t *xDevice2, *zDevice2;

    aclrtMallocHost((void **)(&xHost2), inputByteSize2);
    aclrtMallocHost((void **)(&zHost2), outputByteSize2);
    aclrtMalloc((void **)&xDevice2, inputByteSize2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice2, outputByteSize2, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x_2.bin", inputByteSize2, xHost2, inputByteSize2);

    aclrtMemcpy(xDevice2, inputByteSize2, xHost2, inputByteSize2,
                ACL_MEMCPY_HOST_TO_DEVICE);

    set_pad_value_custom<<<numBlocks, nullptr, stream>>>(xDevice2, zDevice2);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost2, outputByteSize2, zDevice2, outputByteSize2,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_2.bin", zHost2, outputByteSize2);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    aclrtFree(xDevice2);
    aclrtFree(zDevice2);
    aclrtFreeHost(xHost2);
    aclrtFreeHost(zHost2);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
