/* !
 * \file copy.asc
 * \brief
 */

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"


class KernelCopy {
public:
    __aicore__ inline KernelCopy() {}  // 构造函数
    
    // 初始化函数：设置全局内存指针和pipe
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm, AscendC::TPipe* pipeIn)
    {
        pipe = pipeIn;  // 传入的流水指针
        srcGlobal.SetGlobalBuffer((__gm__ int32_t*)srcGm);  // 设置源全局缓冲区
        dstGlobal.SetGlobalBuffer((__gm__ int32_t*)dstGm);  // 设置目标全局缓冲区
        pipe->InitBuffer(inQueueSrc, 1, 512 * sizeof(int32_t));  // 初始化输入队列缓冲区
        pipe->InitBuffer(outQueueDst, 1, 512 * sizeof(int32_t));  // 初始化输出队列缓冲区
    }
    
    // 主处理流程
    __aicore__ inline void Process()
    {
        CopyIn();   // 数据搬运入
        Compute();  // 计算处理
        CopyOut();  // 数据搬运出
    }
    
private:
    // 数据搬运入函数
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<int32_t> srcLocal = inQueueSrc.AllocTensor<int32_t>();  // 分配本地int32张量
        AscendC::DataCopy(srcLocal, srcGlobal, 512);  // 从全局内存拷贝512个int32元素到本地
        inQueueSrc.EnQue(srcLocal);  // 入队处理
    }
    
    // 计算处理函数
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<int32_t> srcLocal = inQueueSrc.DeQue<int32_t>();  // 从队列中取出源数据
        AscendC::LocalTensor<int32_t> dstLocal = outQueueDst.AllocTensor<int32_t>();  // 分配目标张量
        
        uint64_t mask = 64;  // 掩码值，用于控制拷贝操作
        
        // 执行拷贝操作
        // 参数说明：dstLocal-目标张量，srcLocal-源张量，mask-每次迭代内前64个元素参与计算，8-重复次数
        // {1, 1, 8, 8}-块拷贝参数，同一迭代内datablock的地址步长1，相邻迭代间的地址步长8
        AscendC::Copy(dstLocal, srcLocal, mask, 8, { 1, 1, 8, 8 });
        
        outQueueDst.EnQue<int32_t>(dstLocal);  // 拷贝结果入队
        inQueueSrc.FreeTensor(srcLocal);  // 释放源张量
    }
    
    // 数据搬运出函数
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<int32_t> dstLocal = outQueueDst.DeQue<int32_t>();  // 从队列中取出结果
        AscendC::DataCopy(dstGlobal, dstLocal, 512);  // 从本地拷贝512个int32元素到全局内存
        outQueueDst.FreeTensor(dstLocal);  // 释放目标张量
    }
    
private:
    AscendC::TPipe* pipe;  // 流水指针
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSrc;  // 输入队列
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueDst;  // 输出队列
    AscendC::GlobalTensor<int32_t> srcGlobal, dstGlobal;  // 源和目标的全局张量
};

// 核函数入口
__global__ __vector__ void copy_custom(GM_ADDR x, GM_ADDR z) 
{
    AscendC::TPipe pipe;  // 创建流水对象pipe
    KernelCopy op;  // 创建拷贝对象
    op.Init(x, z, &pipe);  // 初始化拷贝对象
    op.Process();  // 执行处理流程
}

// 主函数：负责Host和Device管理和任务调度
int32_t main(int32_t argc, char* argv[]) 
{
    // 配置参数
    uint32_t numBlocks = 1;  // 核函数块数
    size_t inputByteSize = 512 * sizeof(uint32_t);  // 输入数据大小
    size_t outputByteSize = inputByteSize;  // 输出数据大小

    // 设备初始化
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);  // 设置设备
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);  // 创建流

    // 主机和设备内存指针声明
    uint8_t *xHost, *zHost;  // 主机端内存指针
    uint8_t *xDevice, *zDevice;  // 设备端内存指针

    // 分配主机端内存
    aclrtMallocHost((void **)(&xHost), inputByteSize);
    aclrtMallocHost((void **)(&zHost), outputByteSize);
    
    // 分配设备端内存
    aclrtMalloc((void **)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 从文件读取输入数据
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);

    // 数据传输：主机到设备
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE);

    // 启动核函数执行
    copy_custom<<<numBlocks, nullptr, stream>>>(xDevice, zDevice);
    
    // 等待流同步
    aclrtSynchronizeStream(stream);

    // 数据传输：设备到主机
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    
    // 写入输出文件
    WriteFile("./output/output.bin", zHost, outputByteSize);

    // 释放内存资源
    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);

    // 清理资源
    aclrtDestroyStream(stream);  // 销毁流
    aclrtResetDevice(deviceId);  // 重置Device
    aclFinalize();  // ACL库清理

    return 0;
}