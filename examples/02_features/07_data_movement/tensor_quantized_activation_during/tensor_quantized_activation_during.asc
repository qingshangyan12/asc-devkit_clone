/*!
 * \file tensor_quantized_activation_during.asc.asc
 * \brief
 */
#include <cstdint>
#include "data_utils.h"
#include "kernel_operator.h"
#include "acl/acl.h"

using namespace AscendC;


struct MmadInputParams {
    __aicore__ MmadInputParams() {}
    __aicore__ MmadInputParams(const uint16_t c1, const uint16_t height, const uint16_t width, const uint8_t kernelHeight,
        const uint8_t kernelWidth, const uint16_t coutIn, const uint16_t c0In, const uint16_t dilationHeight,
        const uint16_t dilationWidth)
    {
        C1 = c1;
        H = height;
        W = width;
        Kh = kernelHeight;
        Kw = kernelWidth;
        Cout = coutIn;
        C0 = c0In;
        dilation_h = dilationHeight;
        dilation_w = dilationWidth;
        channel_size = C0 * C1;

        cout_blocks = (Cout + 16 - 1) / 16;
        ho = H - dilation_h * (Kh - 1);
        wo = W - dilation_w * (Kw - 1);
        howo = ho * wo;
        howo_round = ((howo + 16 - 1) / 16) * 16;

        feature_map_size = C1 * H * W * C0;     // [C1, H, W, C0]
        weight_size = C1 * Kh * Kw * Cout * C0; // [C1, Kh, Kw, Cout, C0]
        feature_map_l0a_size = howo_round * (C1 * Kh * Kw * C0);
        weight_l0b_size = (C1 * Kh * Kw * C0) * cout_blocks * 16;
        m = howo;
        k = C1 * Kh * Kw * C0;
        n = Cout;
        deq_size = Cout;                    // [Cout]
        dst_size = cout_blocks * howo * 16; // [cout_blocks, howo, 16]
        dst_l0c_size = cout_blocks * howo_round * 16;

        fm_repeat = feature_map_l0a_size / (16 * C0);
        we_repeat = weight_l0b_size / (16 * C0);
    }

    uint16_t C1;
    uint16_t H;
    uint16_t W;
    uint8_t Kh;
    uint8_t Kw;
    uint16_t Cout;
    uint16_t C0;
    uint8_t dilation_h;
    uint8_t dilation_w;
    uint16_t channel_size;

    uint16_t cout_blocks;
    uint16_t ho;
    uint16_t wo;
    uint16_t howo;
    uint16_t howo_round;

    uint32_t feature_map_size;
    uint32_t weight_size;
    uint32_t feature_map_l0a_size;
    uint32_t weight_l0b_size;
    uint16_t m;
    uint16_t k;
    uint16_t n;
    uint32_t deq_size;
    uint32_t dst_size;
    uint32_t dst_l0c_size;

    uint8_t fm_repeat;
    uint8_t we_repeat;
};


template <typename fm_T, typename w_T, typename l1out_T, typename dst_T>
class TestDataCopyL0c2Gm {
public:
    __aicore__ inline void Init(GM_ADDR fmData, GM_ADDR weData, GM_ADDR deqTensor, GM_ADDR elewiseTensor, GM_ADDR tiling, GM_ADDR outputData)
    {
        fm_T_size = sizeof(fm_T);
        w_T_size = sizeof(w_T);
        l1out_T_size = sizeof(l1out_T);
        dst_T_size = sizeof(dst_T);
        tiling_global.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(tiling), 16);
        C1 = (uint16_t)tiling_global.GetValue(0);
        H = (uint16_t)tiling_global.GetValue(1);
        W = (uint16_t)tiling_global.GetValue(2);
        Kh = (uint8_t)tiling_global.GetValue(3);
        Kw = (uint8_t)tiling_global.GetValue(4);
        Cout = (uint16_t)tiling_global.GetValue(5);
        C0 = (uint16_t)tiling_global.GetValue(6);
        dilation_h = (uint8_t)tiling_global.GetValue(7);
        dilation_w = (uint8_t)tiling_global.GetValue(8);
        quant_mode = (uint8_t)tiling_global.GetValue(9);
        en_relu = (bool)tiling_global.GetValue(10);
        en_nz2nd = (bool)tiling_global.GetValue(11);
        en_split = (bool)tiling_global.GetValue(12);
        clip_relu = (uint8_t)tiling_global.GetValue(13);
        elewise_op = (uint8_t)tiling_global.GetValue(14);

        MmadInputParams inputParams(C1, H, W, Kh, Kw, Cout, C0, dilation_h, dilation_w);
        cout_blocks = inputParams.cout_blocks;
        wo = inputParams.wo;
        howo = inputParams.howo;
        howo_round = inputParams.howo_round;
        feature_map_size = inputParams.feature_map_size;
        weight_size = inputParams.weight_size;
        feature_map_l0a_size = inputParams.feature_map_l0a_size;
        weight_l0b_size = inputParams.weight_l0b_size;
        m = inputParams.m;
        k = inputParams.k;
        n = inputParams.n;
        deq_size = inputParams.deq_size;
        dst_size = inputParams.dst_size;
        dst_l0c_size = inputParams.dst_l0c_size;

        fm_repeat = inputParams.fm_repeat;
        we_repeat = inputParams.we_repeat;
        feature_map_gm.SetGlobalBuffer(reinterpret_cast<__gm__ fm_T*>(fmData), feature_map_size);
        weight_gm.SetGlobalBuffer(reinterpret_cast<__gm__ w_T*>(weData), weight_size);
        deq_tensor_gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(deqTensor), deq_size);
        elewise_gm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(elewiseTensor), dst_size);
        output_gm.SetGlobalBuffer(reinterpret_cast<__gm__ dst_T*>(outputData), dst_size);
        pipe.InitBuffer(inQueueFmA1, 1, feature_map_size * sizeof(fm_T));
        pipe.InitBuffer(inQueueFmA2, 1, feature_map_l0a_size * sizeof(fm_T));
        pipe.InitBuffer(inQueueWeB1, 1, weight_size * sizeof(w_T));
        pipe.InitBuffer(inQueueWeB2, 1, weight_l0b_size * sizeof(w_T));
        pipe.InitBuffer(outQueueCO1, 1, dst_l0c_size * sizeof(l1out_T));
    }
    __aicore__ inline void Process()
    {
        CopyIn();
        Split();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<fm_T> featureMapA1 = inQueueFmA1.AllocTensor<fm_T>();
        AscendC::LocalTensor<w_T> weightB1 = inQueueWeB1.AllocTensor<w_T>();
        AscendC::DataCopy(featureMapA1, feature_map_gm, { 1, static_cast<uint16_t>(feature_map_size * sizeof(fm_T) / 32), 0, 0 });
        AscendC::DataCopy(weightB1, weight_gm, { 1, static_cast<uint16_t>(weight_size * sizeof(w_T) / 32), 0, 0 });
        inQueueFmA1.EnQue(featureMapA1);
        inQueueWeB1.EnQue(weightB1);
    }
    __aicore__ inline void Split()
    {
        AscendC::LocalTensor<fm_T> featureMapA1 = inQueueFmA1.DeQue<fm_T>();
        AscendC::LocalTensor<w_T> weightB1 = inQueueWeB1.DeQue<w_T>();
        AscendC::LocalTensor<fm_T> featureMapA2 = inQueueFmA2.AllocTensor<fm_T>();
        AscendC::LocalTensor<w_T> weightB2 = inQueueWeB2.AllocTensor<w_T>();
        uint8_t padList[] = {0, 0, 0, 0};
        // load3dv2
        AscendC::LoadData(featureMapA2, featureMapA1, { padList, H, W, 36, k, howo_round, 0, 0, 1, 1, Kw, 
        Kh, dilation_w, dilation_h, false, false, 0 });
        // load2d
        AscendC::LoadData(weightB2, weightB1, { 0, we_repeat, 1, 0, 0, false, 0 });
        inQueueFmA2.EnQue<fm_T>(featureMapA2);
        inQueueWeB2.EnQue<w_T>(weightB2);
        inQueueFmA1.FreeTensor(featureMapA1);
        inQueueWeB1.FreeTensor(weightB1);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<fm_T> featureMapA2 = inQueueFmA2.DeQue<fm_T>();
        AscendC::LocalTensor<w_T> weightB2 = inQueueWeB2.DeQue<w_T>();
        AscendC::LocalTensor<l1out_T> dst_l0c = outQueueCO1.AllocTensor<l1out_T>();

        Mmad(dst_l0c, featureMapA2, weightB2, { m, n, k, 0, false, true });
        outQueueCO1.EnQue<l1out_T>(dst_l0c);
        inQueueFmA2.FreeTensor(featureMapA2);
        inQueueWeB2.FreeTensor(weightB2);
    }
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<l1out_T> dst_l0c = outQueueCO1.DeQue<l1out_T>();

        LOCAL_TENSOR_REGISTER(cbufWorkspace, uint64_t, C1, feature_map_size* fm_T_size + weight_size * w_T_size, deq_size)
        uint16_t deqDataSize = DivCeil(deq_size * sizeof(uint64_t), 128) * 128;
        float tmp = 0.5;
        uint64_t deqScalar = static_cast<uint64_t>(*reinterpret_cast<int32_t*>(&tmp));
        nSize = cout_blocks * BLOCK_CUBE;
        mSize = m;
        srcStride = DivCeil(m, BLOCK_CUBE) * BLOCK_CUBE;
        dstStride = m * sizeof(dst_T) * BLOCK_CUBE / ONE_BLK_SIZE;
        if (en_split) {
            dstStride = dstStride / 2;
        }
        if (en_nz2nd) {
            SetFixpipeNz2ndFlag(1, 0, 0);
            nSize = n;
            dstStride = nSize;
        }
        if ((QuantMode_t)quant_mode == QuantMode_t::VDEQF16) {
            DataCopy(cbufWorkspace, deq_tensor_gm, { 1, static_cast<uint16_t>(deqDataSize / ONE_BLK_SIZE), 0, 0 });
            set_flag(PIPE_MTE2, PIPE_FIX, EVENT_ID3);
            wait_flag(PIPE_MTE2, PIPE_FIX, EVENT_ID3);
            LOCAL_TENSOR_REGISTER(deqTensorTempBuf, uint64_t, C2PIPE2GM, 0, deqDataSize / sizeof(uint64_t));
            uint16_t fbufBurstLen = deqDataSize / 128;
            DataCopyParams dataCopyParams(1, fbufBurstLen, 0, 0);
            DataCopy(deqTensorTempBuf, cbufWorkspace, dataCopyParams);
            SetFixPipeConfig(deqTensorTempBuf);
            PipeBarrier<PIPE_FIX>();
        } else {
            SetFixpipePreQuantFlag(deqScalar);
            PipeBarrier<PIPE_FIX>();
        }
        DataCopyCO12DstParams intriParams(nSize, mSize, dstStride, srcStride,
            (QuantMode_t)quant_mode, static_cast<uint8_t>(en_relu), en_split, en_nz2nd);
#if __CCE_AICORE__ == 300
        intriParams.eltWiseOp = elewise_op;
        intriParams.clipReluPre = clip_relu;
        LOCAL_TENSOR_REGISTER(elewise_tensor_buffer, half, C1, feature_map_size* fm_T_size + weight_size * w_T_size + deq_size * sizeof(uint64_t), dst_size)
        DataCopy(elewise_tensor_buffer, elewise_gm, { 1, static_cast<uint16_t>(sizeof(half) * dst_size / 32), 0, 0 });
        pipe_barrier(PIPE_ALL);
        SetFixPipeAddr(elewise_tensor_buffer, 1);
        uint64_t clipReluVal = 0x3c00; // value 1, half
        SetFixPipeClipRelu(clipReluVal);
#endif
        DataCopy(output_gm, dst_l0c, intriParams);
        pipe_barrier(PIPE_ALL);
        outQueueCO1.FreeTensor(dst_l0c);
    }
private:
    TPipe pipe;
    // feature map queue
    AscendC::TQue<AscendC::TPosition::A1, 1> inQueueFmA1;
    AscendC::TQue<AscendC::TPosition::A2, 1> inQueueFmA2;
    // weight queue
    AscendC::TQue<AscendC::TPosition::B1, 1> inQueueWeB1;
    AscendC::TQue<AscendC::TPosition::B2, 1> inQueueWeB2;
    // dst queue
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQueueCO1;

    uint16_t C1;
    uint16_t H;
    uint16_t W;
    uint8_t Kh;
    uint8_t Kw;
    uint16_t Cout;
    uint16_t C0;
    uint8_t dilation_h;
    uint8_t dilation_w;
    uint8_t quant_mode;
    bool en_relu;
    bool en_nz2nd;
    bool en_split;
    uint8_t clip_relu;
    uint8_t elewise_op;
    uint16_t cout_blocks;
    uint16_t ho;
    uint16_t wo;
    uint16_t howo;
    uint16_t howo_round;
    uint32_t feature_map_size;
    uint32_t weight_size;
    uint32_t feature_map_l0a_size;
    uint32_t weight_l0b_size;
    uint16_t m;
    uint16_t k;
    uint16_t n;
    uint32_t deq_size;
    uint32_t dst_size;
    uint32_t dst_l0c_size;
    uint16_t nSize;
    uint16_t mSize;
    uint16_t srcStride;
    uint32_t dstStride;
    uint8_t fm_repeat;
    uint8_t we_repeat;
    uint8_t fm_T_size;
    uint8_t w_T_size;
    uint8_t l1out_T_size;
    uint8_t dst_T_size;
    GlobalTensor<fm_T> feature_map_gm;
    GlobalTensor<w_T> weight_gm;
    GlobalTensor<uint64_t> deq_tensor_gm;
    GlobalTensor<half> elewise_gm;
    GlobalTensor<dst_T> output_gm;
    GlobalTensor<uint32_t> tiling_global;
};


__cube__ __global__ void kernel_fixpipe_custom(GM_ADDR fmData, GM_ADDR weData, GM_ADDR deqTensor, 
GM_ADDR elewiseTensor, GM_ADDR tiling, GM_ADDR outputData) 
{
    TestDataCopyL0c2Gm<int8_t, int8_t, int32_t, half> op;
    op.Init(fmData, weData, deqTensor, elewiseTensor, tiling, outputData);
    op.Process();
}

int32_t main(int32_t argc, char* argv[]) 
{
    uint32_t blockDim = 1;
    size_t fmSize = 1 * 4 * 4 * 32 * sizeof(int8_t);
    size_t weSize = 1 * 2 * 2 * 128 * 32 * sizeof(int8_t);
    size_t deqSize = 8 * 16 * sizeof(uint64_t);
    size_t elewiseSize = 8 * 9 * 16 * sizeof(half);
    size_t tilingSize = 16 * sizeof(uint32_t);
    size_t goldenSize = 8 * 9 * 16 * sizeof(half);

    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *fmHost, *weHost, *deqHost, *elewiseHost, *tilingHost, *outHost;
    uint8_t *fmDevice, *weDevice, *deqDevice, *elewiseDevice, *tilingDevice, *outDevice;

    aclrtMallocHost((void **)(&fmHost), fmSize);
    aclrtMallocHost((void **)(&weHost), weSize);
    aclrtMallocHost((void **)(&deqHost), deqSize);
    aclrtMallocHost((void **)(&elewiseHost), elewiseSize);
    aclrtMallocHost((void **)(&tilingHost), tilingSize);
    aclrtMallocHost((void **)(&outHost), goldenSize);

    aclrtMalloc((void **)&fmDevice, fmSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&weDevice, weSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&deqDevice, deqSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&elewiseDevice, elewiseSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&tilingDevice, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&outDevice, goldenSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/fm_data.bin", fmSize, fmHost, fmSize);
    ReadFile("./input/we_data.bin", weSize, weHost, weSize);
    ReadFile("./input/deq_data.bin", deqSize, deqHost, deqSize);
    ReadFile("./input/elewise_data.bin", elewiseSize, elewiseHost, elewiseSize);
    ReadFile("./input/tiling_data.bin", tilingSize, tilingHost, tilingSize);

    aclrtMemcpy(fmDevice, fmSize, fmHost, fmSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(weDevice, weSize, weHost, weSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(deqDevice, deqSize, deqHost, deqSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(elewiseDevice, elewiseSize, elewiseHost, elewiseSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tilingDevice, tilingSize, tilingHost, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_fixpipe_custom<<<blockDim, nullptr, stream>>>(fmDevice, weDevice, deqDevice, elewiseDevice, tilingDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, goldenSize, outDevice, goldenSize,
                ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, goldenSize);

    aclrtFree(fmDevice);
    aclrtFree(weDevice);
    aclrtFree(deqDevice);
    aclrtFree(elewiseDevice);
    aclrtFree(tilingDevice);
    aclrtFree(outDevice);

    aclrtFreeHost(fmHost);
    aclrtFreeHost(weHost);
    aclrtFreeHost(deqHost);
    aclrtFreeHost(elewiseHost);
    aclrtFreeHost(tilingHost);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
