#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TILE_LENGTH = 256;
constexpr uint32_t NUM_BLOCKS = 8;

class KernelAdd{
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(__gm__ float* x, __gm__ float* y, __gm__ float* z)
    {
        totalLength = length;
        mask = vec_mask;

        src0Gm = (__gm__ float*)x;
        src1Gm = (__gm__ float*)y;
        dstGm = (__gm__ float*)z;

        uint64_t offset = 0;
        src0 =(__ubuf__ float*)get_imm(0);
        offset += totalLength * sizeof(float);
        src1 =(__ubuf__ float*)get_imm(offset);
        offset += totalLength * sizeof(float);
        dst =(__ubuf__ float*)get_imm(offset);
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        uint32_t blk_num = 1;
        uint32_t blk_length = totalLength * sizeof(float) / 32;
        const uint8_t cache_mode0 = static_cast<uint8_t>(((uint64_t)src0Gm) >> 60);
        const uint8_t cache_mode1 = static_cast<uint8_t>(((uint64_t)src1Gm) >> 60);
        const uint8_t cache_mode2 = static_cast<uint8_t>(((uint64_t)dstGm) >> 60);
        uint32_t burst_length = blk_length * 32;
        uint64_t src_stride = burst_length;
        uint32_t dst_stride = (burst_length + 31) / 32 * 32;
        copy_gm_to_ubuf_align_v2(src0, src0Gm, 0, blk_num, burst_length, 0, 0, true, cache_mode0, src_stride, dst_stride);
        copy_gm_to_ubuf_align_v2(src1, src1Gm, 0, blk_num, burst_length, 0, 0, true, cache_mode1, src_stride, dst_stride);
        copy_gm_to_ubuf_align_v2(dst, dstGm, 0, blk_num, burst_length, 0, 0, true, cache_mode2, src_stride, dst_stride);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    }

    __simd_vf__ inline void AddVF(uint16_t rep, uint16_t one_rep_size)
    {
        vector_bool vmask;
        vector_float reg_src0;
        vector_float reg_src1;
        vector_float reg_dst;
        uint32_t sreg = (uint32_t)mask;
        vmask = asc_update_mask_b32(sreg);
        for (uint16_t i = 0; i < rep; ++i) {
        asc_loadalign(reg_src0, src0 + i * one_rep_size);
        asc_loadalign(reg_src1, src1 + i * one_rep_size);    
        asc_add(reg_dst, reg_src0, reg_src1, vmask);
        asc_storealign(dst + i * one_rep_size, reg_dst, vmask);
        }
    }

    __aicore__ inline void Compute()
    {
        uint16_t mask_bit_size = 256;
        uint16_t one_rep_size = mask_bit_size / sizeof(float);
        uint16_t rep = totalLength / one_rep_size;
        AddVF(rep, one_rep_size);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    }

    __aicore__ inline void CopyOut()
    {
        uint32_t blk_num = 1;
        uint32_t blk_length = totalLength * sizeof(float) / 32;
        const uint8_t cache_mode = static_cast<uint8_t>(((uint64_t)dstGm) >> 60);
        uint32_t burst_length = blk_length * 32;
        uint64_t src_stride = (burst_length + 31) / 32 * 32;
        uint32_t dst_stride = burst_length;
        copy_ubuf_to_gm_align_v2(dstGm, dst, 0, blk_num,burst_length, cache_mode, dst_stride, src_stride);

    }

private:
    uint32_t length = 1024;
    uint32_t vec_mask = 32;
    uint32_t totalLength = 0;
    uint32_t mask;
    __ubuf__ float* src0;
    __ubuf__ float* src1; 
    __ubuf__ float* dst;
    __gm__ float* src0Gm;
    __gm__ float* src1Gm;
    __gm__ float* dstGm;
};

