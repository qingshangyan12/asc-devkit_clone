/* !
 * \file aicpu_multiprocess_print.aicpu
 * \brief AICPU 多进程注册执行算子样例的内核
 *        每个进程独立注册并下发本内核，内核内执行 printf 输出进程标识信息
 */

#include "aicpu_api.h"
#include "kernel_args.h"

__global__ __aicpu__ uint32_t MultiprocessPrintKernel(KernelInfo::ProcArgs args)
{
    AscendC::printf("MultiprocessPrintKernel start, procId=%u\n", args.procId);

    for (uint32_t i = 0; i < args.printCount; ++i) {
        AscendC::printf("[proc %u] print %u: hello from aicpu\n", args.procId, i);
    }

    AscendC::printf("MultiprocessPrintKernel done, procId=%u\n", args.procId);
    return 0;
}
