/* !
 * \file main.asc
 * \brief 多进程注册执行 AICPU 算子样例的主机端入口
 *        host 侧 fork 多个子进程，每个进程独立 aclInit、注册算子、下发执行
 */

#include <cstdio>
#include <cstring>
#include <unistd.h>
#include <sys/wait.h>
#include "kernel_args.h"
#include "securec.h"
#include "acl/acl.h"

extern __global__ __aicpu__ uint32_t MultiprocessPrintKernel(KernelInfo::ProcArgs);

constexpr uint32_t PROC_NUM = 3U;
constexpr uint32_t PRINTS_PER_PROC = 5U;

void RunChildProcess(uint32_t procId)
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    struct KernelInfo::ProcArgs hostArgs;
    hostArgs.procId = procId;
    hostArgs.printCount = PRINTS_PER_PROC;

    void* argsDevice = nullptr;
    aclrtMalloc((void**)&argsDevice, sizeof(KernelInfo::ProcArgs), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(argsDevice, sizeof(KernelInfo::ProcArgs),
                &hostArgs, sizeof(KernelInfo::ProcArgs),
                ACL_MEMCPY_HOST_TO_DEVICE);

    auto* kernelArgs = (KernelInfo::ProcArgs*)argsDevice;

    MultiprocessPrintKernel<<<1, 0, stream>>>(*kernelArgs);
    aclrtSynchronizeStream(stream);

    aclrtFree(argsDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
}

int32_t main(int argc, char const* argv[])
{
    pid_t pids[PROC_NUM];

    for (uint32_t i = 0; i < PROC_NUM; ++i) {
        pids[i] = fork();
        if (pids[i] == 0) {
            // 子进程
            RunChildProcess(i);
            _exit(0);
        } else if (pids[i] < 0) {
            fprintf(stderr, "fork failed for process %u\n", i);
            return -1;
        }
    }

    // 父进程等待所有子进程结束
    for (uint32_t i = 0; i < PROC_NUM; ++i) {
        int32_t status = 0;
        waitpid(pids[i], &status, 0);
        if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
            fprintf(stderr, "child process %u exited with %d\n", i, WEXITSTATUS(status));
        }
    }

    printf("All %u child processes completed\n", PROC_NUM);
    return 0;
}
