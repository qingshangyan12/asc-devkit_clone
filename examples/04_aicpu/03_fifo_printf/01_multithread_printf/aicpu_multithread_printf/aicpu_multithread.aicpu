/* !
 * \file aicpu_multithread.aicpu
 * \brief AICPU 多线程 printf 样例，演示在 AICPU 内核中创建多个线程并发调用 printf
 */

#include "aicpu_api.h"
#include "kernel_args.h"

#include <thread>
#include <vector>

__global__ __aicpu__ uint32_t MultiThreadPrintfKernel(KernelInfo::KernelArgs args)
{
    AscendC::printf("MultiThreadPrintfKernel start, threadNum=%u\n", args.threadNum);

    std::vector<std::thread> threads;
    threads.reserve(args.threadNum);

    for (uint32_t i = 0; i < args.threadNum; ++i) {
        threads.emplace_back([i, &args]() {
            uint32_t count = args.args[i].printCount;
            for (uint32_t j = 0; j < count; ++j) {
                AscendC::printf("[thread %u] print %u: value=%d str=%s\n",
                                i, j, i * 100 + j, "hello");
            }
        });
    }

    for (auto& t : threads) {
        t.join();
    }

    AscendC::printf("MultiThreadPrintfKernel done, all threads joined\n");
    return 0;
}
