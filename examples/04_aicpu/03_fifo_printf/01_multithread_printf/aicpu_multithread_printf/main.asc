/* !
 * \file main.asc
 * \brief 多线程 printf 样例的主机端入口，在 host 端下发 AICPU 内核
 */

#include <cstdio>
#include "kernel_args.h"
#include "securec.h"
#include "acl/acl.h"

extern __global__ __aicpu__ uint32_t MultiThreadPrintfKernel(KernelInfo::KernelArgs);

int32_t main(int argc, char const* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr uint32_t THREAD_NUM = 4U;
    constexpr uint32_t PRINTS_PER_THREAD = 10U;

    void* argsDevice = nullptr;
    void* argsHost = nullptr;
    aclrtMalloc((void**)&argsDevice, sizeof(KernelInfo::ThreadArgs) * THREAD_NUM, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&argsHost, sizeof(KernelInfo::ThreadArgs) * THREAD_NUM);

    auto* hostArgs = static_cast<KernelInfo::ThreadArgs*>(argsHost);
    for (uint32_t i = 0; i < THREAD_NUM; ++i) {
        hostArgs[i].threadId = i;
        hostArgs[i].printCount = PRINTS_PER_THREAD;
    }
    aclrtMemcpy(argsDevice, sizeof(KernelInfo::ThreadArgs) * THREAD_NUM,
                argsHost, sizeof(KernelInfo::ThreadArgs) * THREAD_NUM,
                ACL_MEMCPY_HOST_TO_DEVICE);

    struct KernelInfo::KernelArgs kernelArgs = {};
    kernelArgs.args = (KernelInfo::ThreadArgs*)argsDevice;
    kernelArgs.threadNum = THREAD_NUM;

    MultiThreadPrintfKernel<<<1, 0, stream>>>(kernelArgs);
    aclrtSynchronizeStream(stream);

    aclrtFree(argsDevice);
    aclrtFreeHost(argsHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
