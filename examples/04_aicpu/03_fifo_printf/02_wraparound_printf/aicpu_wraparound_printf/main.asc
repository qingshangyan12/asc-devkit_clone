/* !
 * \file main.asc
 * \brief 回绕 printf 样例的主机端入口
 */

#include <cstdio>
#include "kernel_args.h"
#include "securec.h"
#include "acl/acl.h"

extern __global__ __aicpu__ uint32_t WraparoundPrintfKernel(KernelInfo::WrapArgs);

int32_t main(int argc, char const* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    void* argsDevice = nullptr;
    aclrtMalloc((void**)&argsDevice, sizeof(KernelInfo::WrapArgs), ACL_MEM_MALLOC_HUGE_FIRST);

    struct KernelInfo::WrapArgs hostArgs;
    hostArgs.totalPrints = 500;   // 500 条 × ~232 字节 ≈ 116KB，远超 32KB ringbuf
    hostArgs.strLen = 200;        // 每条填充字符串 200 字节
    hostArgs.batchSize = 50;     // 每 50 条打印一次 batch 标记

    aclrtMemcpy(argsDevice, sizeof(KernelInfo::WrapArgs),
                &hostArgs, sizeof(KernelInfo::WrapArgs),
                ACL_MEMCPY_HOST_TO_DEVICE);

    auto* kernelArgs = (KernelInfo::WrapArgs*)argsDevice;

    WraparoundPrintfKernel<<<1, 0, stream>>>(*kernelArgs);
    aclrtSynchronizeStream(stream);

    aclrtFree(argsDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
