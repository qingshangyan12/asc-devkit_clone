/* !
 * \file aicpu_multithread_print.aicpu
 * \brief AICPU 多线程执行同一打印算子样例的内核
 *        多个 host 线程同时下发本内核到不同 stream，内核内执行 printf
 */

#include "aicpu_api.h"
#include "kernel_args.h"

__global__ __aicpu__ uint32_t MultiThreadPrintKernel(KernelInfo::KernelArgs args)
{
    AscendC::printf("MultiThreadPrintKernel start, threadNum=%u\n", args.threadNum);

    for (uint32_t i = 0; i < args.threadNum; ++i) {
        uint32_t count = args.args[i].printCount;
        for (uint32_t j = 0; j < count; ++j) {
            AscendC::printf("[thread %u] print %u: hello from aicpu\n", i, j);
        }
    }

    AscendC::printf("MultiThreadPrintKernel done\n");
    return 0;
}
