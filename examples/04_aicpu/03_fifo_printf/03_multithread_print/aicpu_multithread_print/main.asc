/* !
 * \file main.asc
 * \brief 多线程执行同一打印算子样例的主机端入口
 *        host 侧创建多个线程，每个线程下发同一个 AICPU 内核到各自的 stream
 */

#include <cstdio>
#include <thread>
#include <vector>
#include "kernel_args.h"
#include "securec.h"
#include "acl/acl.h"

extern __global__ __aicpu__ uint32_t MultiThreadPrintKernel(KernelInfo::KernelArgs);

constexpr uint32_t THREAD_NUM = 4U;
constexpr uint32_t PRINTS_PER_THREAD = 5U;

void LaunchKernel(int32_t deviceId, uint32_t threadId, KernelInfo::PrintArgs* argsDeviceBase)
{
    aclrtSetDevice(deviceId);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    struct KernelInfo::KernelArgs kernelArgs = {};
    kernelArgs.args = argsDeviceBase;
    kernelArgs.threadNum = THREAD_NUM;

    MultiThreadPrintKernel<<<1, 0, stream>>>(kernelArgs);
    aclrtSynchronizeStream(stream);

    aclrtDestroyStream(stream);
}

int32_t main(int argc, char const* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);

    // 分配 device 侧参数内存
    void* argsDevice = nullptr;
    void* argsHost = nullptr;
    aclrtMalloc((void**)&argsDevice, sizeof(KernelInfo::PrintArgs) * THREAD_NUM,
                ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&argsHost, sizeof(KernelInfo::PrintArgs) * THREAD_NUM);

    auto* hostArgs = static_cast<KernelInfo::PrintArgs*>(argsHost);
    for (uint32_t i = 0; i < THREAD_NUM; ++i) {
        hostArgs[i].threadId = i;
        hostArgs[i].printCount = PRINTS_PER_THREAD;
    }
    aclrtMemcpy(argsDevice, sizeof(KernelInfo::PrintArgs) * THREAD_NUM,
                argsHost, sizeof(KernelInfo::PrintArgs) * THREAD_NUM,
                ACL_MEMCPY_HOST_TO_DEVICE);

    auto* argsDeviceBase = (KernelInfo::PrintArgs*)argsDevice;

    // 多线程同时下发同一个内核
    std::vector<std::thread> threads;
    for (uint32_t i = 0; i < THREAD_NUM; ++i) {
        threads.emplace_back(LaunchKernel, deviceId, i, argsDeviceBase);
    }
    for (auto& t : threads) {
        t.join();
    }

    aclrtFree(argsDevice);
    aclrtFreeHost(argsHost);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
