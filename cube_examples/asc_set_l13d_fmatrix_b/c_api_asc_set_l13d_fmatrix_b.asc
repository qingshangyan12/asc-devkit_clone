/* !
 * \file c_api_asc_set_l13d_fmatrix_b.asc
 * \brief Config Load3D FMatrix B (A3A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_set_l13d_fmatrix_b Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_set_l13d_fmatrix_b()
{
    asc_l13d_fmatrix_config config;
    config.config = 0;
    asc_set_l13d_fmatrix_b(config);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_set_l13d_fmatrix_b<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_set_l13d_fmatrix_b.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_set_l13d_fmatrix_b" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
