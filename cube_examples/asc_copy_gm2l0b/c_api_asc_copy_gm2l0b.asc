/* !
 * \file c_api_asc_copy_gm2l0b.asc
 * \brief GM->L0B direct copy (A3, dav-2201)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_copy_gm2l0b Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_copy_gm2l0b()
{
    __cb__ float* l0b = (__cb__ float*)get_imm(0);
    asc_copy_gm2l0b(l0b, (__gm__ float*)0, 1, 128, 0, 0);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_copy_gm2l0b<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_copy_gm2l0b.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_copy_gm2l0b" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
