/* !
 * \file c_api_asc_copy_l12gm.asc
 * \brief L1->GM data copy (A3, dav-2201)
 *
 * 验证方式: GM→L1 → L1→GM(API), 回环比对原始数据
 * 覆盖场景: 单核, 128 float 元素
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BUF_SIZE = 128;

__cube__ __global__ __aicore__ void kernel_asc_copy_l12gm(
    __gm__ float* gm_in, __gm__ float* gm_out)
{
    asc_init();
    __cbuf__ float l1[BUF_SIZE];

    // 1. GM→L1
    asc_copy_gm2l1_sync(l1, gm_in, 0, 0, 0, 2/*128/16*/, 4/*128B*/, 0, 0);

    // 2. API UNDER TEST: L1→GM
    asc_copy_l12gm(gm_out, l1, 1, 128, 0, 0);
    asc_sync_pipe(PIPE_ALL);
}

std::vector<float> run_kernel(std::vector<float> &input)
{
    size_t bytes = input.size() * sizeof(float);
    aclrtStream s = nullptr; uint8_t *oH = nullptr; float *iD = nullptr, *oD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&oH, bytes);
    aclrtMalloc((void**)&iD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&oD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)iD, bytes, (uint8_t*)input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_copy_l12gm<<<NUM_BLOCKS, nullptr, s>>>(iD, oD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(oH, bytes, (uint8_t*)oD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)oH, (float*)(oH + bytes));
    aclrtFree(iD); aclrtFree(oD); aclrtFreeHost(oH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return out;
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<float> input(BUF_SIZE);
    for (uint32_t i = 0; i < BUF_SIZE; ++i) input[i] = i * 0.1f;

    std::vector<float> output = run_kernel(input);

    float maxError = 0.0f;
    for (size_t i = 0; i < input.size(); ++i) {
        float e = std::abs(output[i] - input[i]);
        if (e > maxError) maxError = e;
    }
    bool passed = maxError < 0.001f;
    std::cout << (passed?"[PASS]":"[FAIL]") << " asc_copy_l12gm max_error=" << maxError << std::endl;

    std::ofstream f("asc_copy_l12gm.csv");
    f << "result\n" << (passed?"PASS":"FAIL") << ",max_error=" << maxError << "\n"; f.close();
    return passed?0:1;
}
