/* !
 * \file c_api_asc_copy_l0c2gm.asc
 * \brief L0C->GM result output (A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_copy_l0c2gm Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_copy_l0c2gm()
{
    __cc__ float* l0c = (__cc__ float*)get_imm(0);
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm((__gm__ float*)0, l0c, 32, 32, 32, 32,
                    0, 0, 0, 0, 0, false, true, 0, 0, 0, 0,
                    false, false, false, false);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_copy_l0c2gm<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_copy_l0c2gm.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_copy_l0c2gm" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
