/* !
 * \file c_api_asc_copy_l12l0a_mx.asc
 * \brief MX scale L1->L0A (A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_copy_l12l0a_mx Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_copy_l12l0a_mx()
{
    __cbuf__ fp8_e8m0_t* l1 = (__cbuf__ fp8_e8m0_t*)get_imm(0);
    asc_copy_l12l0a_mx(reinterpret_cast<uint64_t>(l1), l1, 0, 0, 1, 1, 0, 0);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_copy_l12l0a_mx<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_copy_l12l0a_mx.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_copy_l12l0a_mx" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
