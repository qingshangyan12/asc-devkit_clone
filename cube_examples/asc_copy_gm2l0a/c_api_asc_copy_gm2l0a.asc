/* !
 * \file c_api_asc_copy_gm2l0a.asc
 * \brief GM->L0A direct copy (A3, dav-2201)
 *
 * 验证方式: GM(ref)→L0A(API) + GM→L1→L0B → MMAD → L0C→GM,
 *          与 CPU 计算的 golden (A×B) 逐元素比对
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16;
constexpr uint32_t K_SIZE = 16;
constexpr uint32_t N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE;
constexpr uint32_t TOTAL_B = K_SIZE * N_SIZE;
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;

__cube__ __global__ __aicore__ void kernel_asc_copy_gm2l0a(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();

    __cbuf__ half l1_b[TOTAL_B];
    __ca__ half l0a[TOTAL_A];
    __cb__ half l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    // 1. API UNDER TEST: GM→L0A
    asc_copy_gm2l0a(l0a, gm_a, 1, 128, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    // 2. GM→L1→L0B for B
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 3. MMAD: 2201 uses k_direction_align
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, 0/*k_direction_align*/, false, true);

    // 4. L0C→GM (2201: 9-parameter version, NZ→ND)
    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, M_SIZE,
        0, 0/*NoQuant*/, 0, false, true/*nz2nd_en*/);
}

std::vector<float> run_kernel(std::vector<half> &a, std::vector<half> &b)
{
    size_t ba = a.size() * sizeof(half), bb = b.size() * sizeof(half), bc = TOTAL_C * sizeof(float);
    aclrtStream stream = nullptr; uint8_t *cH = nullptr; half *aD = nullptr, *bD = nullptr; float *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_copy_gm2l0a<<<NUM_BLOCKS, nullptr, stream>>>(aD, bD, cD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
    return c;
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<half> a(TOTAL_A), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k) a[i * K_SIZE + k] = half((i + k) * 0.1f);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j) b[k * N_SIZE + j] = half((k + j) * 0.1f);

    std::vector<float> output = run_kernel(a, b);
    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += float(a[i * K_SIZE + k]) * float(b[k * N_SIZE + j]);
            golden[i * N_SIZE + j] = sum;
        }

    float maxError = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i] - golden[i]);
        if (e > maxError) maxError = e;
    }
    bool passed = maxError < 0.001f;
    std::cout << (passed ? "[PASS]" : "[FAIL]") << " asc_copy_gm2l0a max_error=" << maxError << std::endl;

    std::ofstream f("asc_copy_gm2l0a.csv");
    f << "result\n" << (passed ? "PASS" : "FAIL") << ",max_error=" << maxError << "\n";
    f.close();
    return passed ? 0 : 1;
}
