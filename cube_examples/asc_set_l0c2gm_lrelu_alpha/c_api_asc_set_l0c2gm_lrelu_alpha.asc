/* !
 * \file c_api_asc_set_l0c2gm_lrelu_alpha.asc
 * \brief Config LeakyReLU alpha for L0C→GM (A5, dav-3510)
 *
 * 验证方式: MMAD 生成正负混合数据 → asc_set_l0c2gm_lrelu_alpha(API)→L0C→GM(with relu),
 *          验证负值被 alpha 缩放 (LeakyReLU: y = x if x>=0 else alpha*x)
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL = M_SIZE * K_SIZE;
constexpr float LRELU_ALPHA = 0.25f;  // 测试用 alpha

/* --------------------------------------------------------------------------
 * Kernel: MMAD → L0C → set_lrelu_alpha(API) → L0C→GM (with LReLU)
 * 使用 A=B=ones 生成 C[i][j]=K, 然后使用含负值的特殊矩阵验证 LReLU
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_set_l0c2gm_lrelu_alpha(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();
    __cbuf__ half l1_a[TOTAL], l1_b[TOTAL];
    __ca__ half l0a[TOTAL];
    __cb__ half l0b[TOTAL];
    __cc__ float l0c[TOTAL];

    // 1. GM→L1→L0A/L0B
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 2. MMAD: 生成正负混合结果
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, false, false, true);

    // 3. API UNDER TEST: Set LeakyReLU alpha
    half alpha_val = static_cast<half>(LRELU_ALPHA);
    asc_set_l0c2gm_lrelu_alpha(alpha_val);

    // 4. L0C→GM with relu_pre=1 → 应用 LeakyReLU
    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, M_SIZE, 0,
        0, 0, 0, 1/*relu_pre: LReLU*/, false, true, 0, 0, false, 0, false, false, false, false);
}

std::vector<float> run_kernel(std::vector<half> &a, std::vector<half> &b)
{
    size_t ba = a.size()*2, bb = b.size()*2, bc = TOTAL*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr; half *aD = nullptr, *bD = nullptr; float *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_set_l0c2gm_lrelu_alpha<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH+bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

int32_t main(int32_t argc, char *argv[])
{
    // A: 正负交替值, B: 全1 (使 C 也正负交替)
    std::vector<half> a(TOTAL), b(TOTAL);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = half((k % 2 == 0) ? 1.0f : -1.0f);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = half(1.0f);

    std::vector<float> output = run_kernel(a, b);

    // Golden: C=A×B, then LeakyReLU(x) = x if x>0 else alpha*x
    std::vector<float> golden(TOTAL, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += float(a[i*K_SIZE+k]) * float(b[k*N_SIZE+j]);
            golden[i*N_SIZE+j] = sum > 0 ? sum : LRELU_ALPHA * sum;
        }

    float mx = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i]-golden[i]);
        if (e > mx) mx = e;
    }
    bool ok = mx < 0.01f;  // LReLU 涉及 half 精度, 放宽 epsilon
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_set_l0c2gm_lrelu_alpha max_error=" << mx << std::endl;

    std::ofstream f("asc_set_l0c2gm_lrelu_alpha.csv");
    f << "result\n" << (ok?"PASS":"FAIL") << ",max_error=" << mx << "\n"; f.close();
    return ok?0:1;
}
