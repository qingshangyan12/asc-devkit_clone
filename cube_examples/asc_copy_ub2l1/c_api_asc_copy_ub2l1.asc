/* !
 * \file c_api_asc_copy_ub2l1.asc
 * \brief UB->L1 data copy (A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_copy_ub2l1 Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_copy_ub2l1()
{
    __ubuf__ float* ub = (__ubuf__ float*)get_imm(0);
    __cbuf__ float* l1 = (__cbuf__ float*)get_imm(0);
    asc_copy_ub2l1(l1, ub, 1, 128, 0, 0);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_copy_ub2l1<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_copy_ub2l1.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_copy_ub2l1" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
