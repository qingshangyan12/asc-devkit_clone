/* !
 * \file c_api_asc_copy_l12l0b_trans.asc
 * \brief L1->L0B with transpose (A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_copy_l12l0b_trans Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_copy_l12l0b_trans()
{
    __cbuf__ float* l1 = (__cbuf__ float*)get_imm(0);
    __cb__ float* l0b = (__cb__ float*)get_imm(0);
    asc_copy_l12l0b_trans(l0b, l1, 0, 0, 2, 4, 2, 2);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_copy_l12l0b_trans<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_copy_l12l0b_trans.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_copy_l12l0b_trans" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
