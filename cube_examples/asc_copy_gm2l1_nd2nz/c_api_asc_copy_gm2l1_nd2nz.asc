/* !
 * \file c_api_asc_copy_gm2l1_nd2nz.asc
 * \brief GM->L1 ND→NZ format conversion (A5, dav-3510)
 *
 * 验证方式: 已知数据通过 GM→L1_ND→NZ(API) + GM→L1(标准) → L0A+L0B → MMAD → L0C→GM,
 *          与 CPU 计算的 golden (A×B) 逐元素比对
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16;
constexpr uint32_t K_SIZE = 16;
constexpr uint32_t N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE;
constexpr uint32_t TOTAL_B = K_SIZE * N_SIZE;
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;

/* --------------------------------------------------------------------------
 * Cube核 kernel: GM→L1 ND→NZ 验证 (API under test: asc_copy_gm2l1_nd2nz)
 * 数据流: GM→L1_ND→NZ(API) + GM→L1(标准) → L0A+L0B → MMAD → L0C→GM
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_copy_gm2l1_nd2nz(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();

    __cbuf__ half l1_a[TOTAL_A];
    __cbuf__ half l1_b[TOTAL_B];
    __ca__ half l0a[TOTAL_A];
    __cb__ half l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    constexpr uint8_t l2_cache_ctl = 0;

    // 1. GM→L1 FOR A — API UNDER TEST: ND→NZ 格式转换搬运
    //    config = ndNum | (loop2DstStride << 16) | (loop3DstStride << 32)
    uint64_t config = 1 | (1 << 16) | ((uint64_t)M_SIZE << 32);
    asc_set_gm2l1_nz_para(config);
    asc_copy_gm2l1_nd2nz(l1_a, gm_a,
                          K_SIZE * sizeof(half),  // loop1_src_stride (字节)
                          0,                       // l2_cache_ctl
                          M_SIZE,                  // n_value (M方向元素数)
                          K_SIZE,                  // d_value (K方向元素数)
                          0,                       // loop4_src_stride
                          false);                  // smallc0_en
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    // 2. GM→L1 FOR B — 标准2D搬运
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, l2_cache_ctl);

    // 3. L1→L0A — 标准搬运
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);

    // 4. L1→L0B — 标准搬运
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 5. MMAD: C = A × B
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, false, false, true);

    // 6. L0C→GM (NZ→ND)
    constexpr uint16_t n_size = 16;
    constexpr uint16_t m_size = 16;
    constexpr uint32_t loop_dst_stride = N_SIZE;
    constexpr uint16_t loop_src_stride = M_SIZE;

    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        n_size, m_size,
        loop_dst_stride, loop_src_stride, l2_cache_ctl,
        0, 0, 0, 0,
        false, true, 0, 0,
        false, 0, false, false, false, false);
}

/* --------------------------------------------------------------------------
 * Host 侧调用
 * -------------------------------------------------------------------------- */
std::vector<float> run_kernel(
    std::vector<half> &a, std::vector<half> &b)
{
    size_t byteSizeA = a.size() * sizeof(half);
    size_t byteSizeB = b.size() * sizeof(half);
    size_t byteSizeC = TOTAL_C * sizeof(float);

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    uint8_t *cHost = nullptr;
    half *aDevice = nullptr;
    half *bDevice = nullptr;
    float *cDevice = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)(&cHost), byteSizeC);
    aclrtMalloc((void **)&aDevice, byteSizeA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&bDevice, byteSizeB, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&cDevice, byteSizeC, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)aDevice, byteSizeA, (uint8_t*)a.data(), byteSizeA,
                ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bDevice, byteSizeB, (uint8_t*)b.data(), byteSizeB,
                ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_asc_copy_gm2l1_nd2nz<<<NUM_BLOCKS, nullptr, stream>>>(aDevice, bDevice, cDevice);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cHost, byteSizeC, (uint8_t*)cDevice, byteSizeC,
                ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> c((float *)cHost, (float *)(cHost + byteSizeC));

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return c;
}

/* --------------------------------------------------------------------------
 * 精度验证
 * -------------------------------------------------------------------------- */
bool verify_result(
    std::vector<float> &output,
    std::vector<float> &golden,
    float &maxError)
{
    constexpr size_t maxPrintSize = 16;
    std::cout << "Output: ";
    for (size_t i = 0; i < std::min(output.size(), maxPrintSize); ++i) {
        std::cout << output[i] << " ";
    }
    std::cout << std::endl;

    std::cout << "Golden: ";
    for (size_t i = 0; i < std::min(golden.size(), maxPrintSize); ++i) {
        std::cout << golden[i] << " ";
    }
    std::cout << std::endl;

    maxError = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float error = std::abs(output[i] - golden[i]);
        if (error > maxError) {
            maxError = error;
        }
    }

    constexpr float epsilon = 0.001f;
    if (maxError < epsilon) {
        std::cout << "[PASS] asc_copy_gm2l1_nd2nz max_error=" << maxError << std::endl;
        return true;
    } else {
        std::cout << "[FAIL] asc_copy_gm2l1_nd2nz max_error=" << maxError << std::endl;
        return false;
    }
}

/* --------------------------------------------------------------------------
 * 主函数
 * -------------------------------------------------------------------------- */
int32_t main(int32_t argc, char *argv[])
{
    std::vector<half> a(TOTAL_A);
    std::vector<half> b(TOTAL_B);

    for (uint32_t i = 0; i < M_SIZE; ++i) {
        for (uint32_t k = 0; k < K_SIZE; ++k) {
            a[i * K_SIZE + k] = half((i + k) * 0.1f);
        }
    }
    for (uint32_t k = 0; k < K_SIZE; ++k) {
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            b[k * N_SIZE + j] = half((k + j) * 0.1f);
        }
    }

    std::vector<float> output = run_kernel(a, b);

    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i) {
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k) {
                sum += float(a[i * K_SIZE + k]) * float(b[k * N_SIZE + j]);
            }
            golden[i * N_SIZE + j] = sum;
        }
    }

    float maxError = 0.0f;
    bool passed = verify_result(output, golden, maxError);

    std::ofstream f("asc_copy_gm2l1_nd2nz.csv");
    f << "result\n"
      << (passed ? "PASS" : "FAIL") << ",max_error=" << maxError << "\n";
    f.close();

    return passed ? 0 : 1;
}
