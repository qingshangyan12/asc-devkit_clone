/* !
 * \file c_api_asc_copy_gm2l1_nd2nz.asc
 * \brief GM->L1 ND->NZ format conversion (A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_copy_gm2l1_nd2nz Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_copy_gm2l1_nd2nz()
{
    __cbuf__ float* l1 = (__cbuf__ float*)get_imm(0);
    asc_copy_gm2l1_nd2nz(l1, (__gm__ float*)0, (uint64_t)128, 0, 32, 32, 0, false);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_copy_gm2l1_nd2nz<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_copy_gm2l1_nd2nz.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_copy_gm2l1_nd2nz" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
