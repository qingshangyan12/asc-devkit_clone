/* !
 * \file c_api_asc_fill_l1.asc
 * \brief Fill L1 buffer with constant (A5, dav-3510)
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;

/* --------------------------------------------------------------------------
 * asc_fill_l1 Kernel
 * -------------------------------------------------------------------------- */

extern "C" __global__ __cube__ void kernel_asc_fill_l1()
{
    __cbuf__ float* l1 = (__cbuf__ float*)get_imm(0);
    asc_fill_l1(l1, static_cast<half>(1.0f), ASC_FILL_VALUE_DEFAULT_CFG);
    asc_sync_pipe(PIPE_ALL);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    kernel_asc_fill_l1<<<NUM_BLOCKS, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    std::ofstream f("asc_fill_l1.csv");
    f << "result\nOK\n";
    f.close();
    std::cout << "[PASS] asc_fill_l1" << std::endl;

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
