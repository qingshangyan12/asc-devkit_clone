/* !
 * \file c_api_asc_fill_l1.asc
 * \brief Fill L1 buffer with constant (A5, dav-3510)
 *
 * 验证方式: asc_fill_l1(API) 填充 L1 → L0A → MMAD(ones_B) → L0C→GM,
 *          验证 C[i][j] = K * V (V为填充值)
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16;
constexpr uint32_t K_SIZE = 16;
constexpr uint32_t N_SIZE = 16;
constexpr uint32_t TOTAL_BUF = M_SIZE * K_SIZE;  // 单分形 half

/* --------------------------------------------------------------------------
 * Cube核 kernel: fill_l1 验证 (API under test: asc_fill_l1)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_fill_l1(
    __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();

    __cbuf__ half l1_a[TOTAL_BUF];
    __cbuf__ half l1_b[TOTAL_BUF];
    __ca__ half l0a[TOTAL_BUF];
    __cb__ half l0b[TOTAL_BUF];
    __cc__ float l0c[TOTAL_BUF];

    constexpr uint8_t l2_cache_ctl = 0;
    const half fill_val = static_cast<half>(1.0f);

    // 1. API UNDER TEST: Fill L1 with constant
    asc_fill_l1(l1_a, fill_val, ASC_FILL_VALUE_DEFAULT_CFG);
    asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);

    // 2. GM→L1 for B (全1矩阵)
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, l2_cache_ctl);

    // 3. L1→L0A / L1→L0B
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 4. MMAD: C = fill_val × B_ones
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, false, false, true);

    // 5. L0C→GM (NZ→ND)
    constexpr uint16_t n_size = 16;
    constexpr uint16_t m_size = 16;
    constexpr uint32_t loop_dst_stride = N_SIZE;
    constexpr uint16_t loop_src_stride = M_SIZE;

    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        n_size, m_size, loop_dst_stride, loop_src_stride, l2_cache_ctl,
        0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false, false);
}

/* --------------------------------------------------------------------------
 * Host 侧调用
 * -------------------------------------------------------------------------- */
std::vector<float> run_kernel(std::vector<half> &b)
{
    size_t byteSizeB = b.size() * sizeof(half);
    size_t byteSizeC = TOTAL_BUF * sizeof(float);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t *cHost = nullptr;
    half *bDevice = nullptr;
    float *cDevice = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void **)(&cHost), byteSizeC);
    aclrtMalloc((void **)&bDevice, byteSizeB, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&cDevice, byteSizeC, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)bDevice, byteSizeB, (uint8_t*)b.data(), byteSizeB, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_asc_fill_l1<<<NUM_BLOCKS, nullptr, stream>>>(bDevice, cDevice);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cHost, byteSizeC, (uint8_t*)cDevice, byteSizeC, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float *)cHost, (float *)(cHost + byteSizeC));

    aclrtFree(bDevice); aclrtFree(cDevice); aclrtFreeHost(cHost);
    aclrtDestroyStream(stream); aclrtResetDevice(deviceId); aclFinalize();
    return c;
}

/* --------------------------------------------------------------------------
 * 精度验证: 期望 C[i][j] = K * V (B全1时)
 * -------------------------------------------------------------------------- */
bool verify_result(std::vector<float> &output, float expected, float &maxError)
{
    constexpr size_t maxPrintSize = 16;
    std::cout << "Output (first " << maxPrintSize << "): ";
    for (size_t i = 0; i < std::min(output.size(), maxPrintSize); ++i) std::cout << output[i] << " ";
    std::cout << std::endl;
    std::cout << "Expected: " << expected << std::endl;

    maxError = 0.0f;
    for (size_t i = 0; i < output.size(); ++i) {
        float error = std::abs(output[i] - expected);
        if (error > maxError) maxError = error;
    }

    constexpr float epsilon = 0.001f;
    if (maxError < epsilon) {
        std::cout << "[PASS] asc_fill_l1 max_error=" << maxError << std::endl;
        return true;
    } else {
        std::cout << "[FAIL] asc_fill_l1 max_error=" << maxError << std::endl;
        return false;
    }
}

/* --------------------------------------------------------------------------
 * 主函数
 * -------------------------------------------------------------------------- */
int32_t main(int32_t argc, char *argv[])
{
    // B 矩阵: 全 1
    std::vector<half> b(TOTAL_BUF);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k * N_SIZE + j] = half(1.0f);

    std::vector<float> output = run_kernel(b);

    // 期望: V=1.0, B全1, C[i][j] = K * V = 16 * 1 = 16
    float expected = static_cast<float>(K_SIZE) * 1.0f;

    float maxError = 0.0f;
    bool passed = verify_result(output, expected, maxError);
    std::ofstream f("asc_fill_l1.csv");
    f << "result\n" << (passed ? "PASS" : "FAIL") << ",max_error=" << maxError << "\n";
    f.close();
    return passed ? 0 : 1;
}
