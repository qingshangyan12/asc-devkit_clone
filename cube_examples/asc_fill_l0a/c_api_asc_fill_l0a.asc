/* !
 * \file c_api_asc_fill_l0a.asc
 * \brief Fill L0A buffer with constant (A3, dav-2201)
 *
 * 验证方式: asc_fill_l0a(API) 填充 L0A → MMAD(ones_B) → L0C→GM,
 *          验证 C[i][j] = K * V
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL = M_SIZE * K_SIZE;

__cube__ __global__ __aicore__ void kernel_asc_fill_l0a(
    __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();
    __cbuf__ half l1_b[TOTAL];
    __ca__ half l0a[TOTAL];
    __cb__ half l0b[TOTAL];
    __cc__ float l0c[TOTAL];

    // 1. API UNDER TEST: Fill L0A
    asc_fill_l0a(l0a, static_cast<half>(1.0f), ASC_FILL_VALUE_DEFAULT_CFG);
    asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);

    // 2. GM→L1→L0B for B (ones)
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 3. MMAD (2201): C = fill_val × B
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE, 0, 0, false, true);

    // 4. L0C→GM (2201)
    asc_copy_l0c2gm_sync(
        gm_c, l0c, N_SIZE, M_SIZE, N_SIZE, M_SIZE, 0, 0, 0, false, true);
}

std::vector<float> run_kernel(std::vector<half> &b)
{
    size_t bb = b.size() * 2, bc = TOTAL * 4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr; half *bD = nullptr; float *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_fill_l0a<<<NUM_BLOCKS, nullptr, s>>>(bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH + bc));
    aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<half> b(TOTAL);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j) b[k * N_SIZE + j] = half(1.0f);

    std::vector<float> output = run_kernel(b);
    float expected = static_cast<float>(K_SIZE) * 1.0f;
    float mx = 0.0f;
    for (size_t i = 0; i < output.size(); ++i) { float e = std::abs(output[i]-expected); if(e>mx)mx=e; }
    bool ok = mx < 0.001f;
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_fill_l0a max_error=" << mx << std::endl;
    std::ofstream f("asc_fill_l0a.csv");
    f << "result\n" << (ok?"PASS":"FAIL") << ",max_error=" << mx << "\n"; f.close();
    return ok?0:1;
}
