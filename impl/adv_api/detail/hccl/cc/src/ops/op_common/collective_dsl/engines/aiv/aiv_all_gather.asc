#include "kernel_operator.h"
#include "aiv_program.h"
#include "mailbox_protocol.h"
using namespace AscendC;
using namespace mc2_ops_hccl::dsl;
namespace {
class AivTransport {
public:
    __aicore__ inline void Init(){pipe.InitBuffer(dataBuffer,2048);pipe.InitBuffer(flagBuffer,32);}
    __aicore__ inline void Copy(uint64_t dst,uint64_t src,uint64_t bytes){
        LocalTensor<uint8_t> ub=dataBuffer.Get<uint8_t>();
        for(uint64_t off=0;off<bytes;off+=2048){
            uint32_t len=static_cast<uint32_t>(bytes-off<2048?bytes-off:2048);
            GlobalTensor<uint8_t> in,out;in.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(src+off));
            out.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(dst+off));
            DataCopyExtParams p{1,len,0,0,0};DataCopyPadExtParams<uint8_t> pad{false,0,0,0};
            DataCopyPad(ub,in,p,pad);PipeBarrier<PIPE_ALL>();DataCopyPad(out,ub,p);PipeBarrier<PIPE_ALL>();
        }
    }
    __aicore__ inline void Record(uint64_t address,uint64_t value){
        auto flag=flagBuffer.Get<uint64_t>();flag.SetValue(0,value);
        GlobalTensor<uint64_t> gm;gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(address));
        PipeBarrier<PIPE_ALL>();DataCopy(gm,flag,4);PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline void Wait(uint64_t address,uint64_t value){
        auto flag=flagBuffer.Get<uint64_t>();GlobalTensor<uint64_t> gm;
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(address));
        do{DataCopy(flag,gm,4);PipeBarrier<PIPE_ALL>();}while(flag.GetValue(0)!=value);
    }
private:
    TPipe pipe;TBuf<TPosition::VECCALC> dataBuffer,flagBuffer;
};
}
extern "C" __global__ __aicore__ void DslAivAllGather(GM_ADDR input,GM_ADDR peers,GM_ADDR header,GM_ADDR commands)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if(GetBlockIdx()!=0)return;
    auto h=reinterpret_cast<__gm__ AivProgramHeader*>(header);
    auto table=reinterpret_cast<__gm__ AivPeer*>(peers);
    auto code=reinterpret_cast<__gm__ AivCommand*>(commands);
    AivTransport transport;transport.Init();
    uint32_t i=0;
    while(i<h->commandCount){
        if(code[i].op==AivOp::BARRIER){
            const uint64_t signal=code[i].signal;const uint32_t begin=i;
            while(i<h->commandCount&&code[i].op==AivOp::BARRIER&&code[i].signal==signal){
                uint32_t peer=code[i].peer;
                transport.Record(table[peer].signals+(signal*h->rankSize+h->rank)*32,h->epoch);++i;
            }
            for(uint32_t j=begin;j<i;++j)transport.Wait(table[h->rank].signals+(signal*h->rankSize+code[j].peer)*32,h->epoch);
        }else{
            uint64_t src=code[i].op==AivOp::COPY_INPUT?reinterpret_cast<uint64_t>(input):table[code[i].peer].output;
            transport.Copy(table[h->rank].output+code[i].dstOffset,src+code[i].srcOffset,code[i].bytes);++i;
        }
    }
}
// Host 入口，链接生成的 fat object 后可直接调用；参数必须是设备 GM。
extern "C" void LaunchDslAivAllGather(void* input,void* peers,void* header,void* commands,void* stream)
{DslAivAllGather<<<1,nullptr,stream>>>((GM_ADDR)input,(GM_ADDR)peers,(GM_ADDR)header,(GM_ADDR)commands);}

extern "C" __global__ __aicore__ void DslCcuSubmit(GM_ADDR mailbox,GM_ADDR request,uint64_t sequence,uint32_t capacity)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if(GetBlockIdx()!=0)return;
    if(!sequence||!capacity)return;
    AivTransport transport;transport.Init();const uint64_t base=reinterpret_cast<uint64_t>(mailbox)+((sequence-1)%capacity)*sizeof(CcuMailbox);
    if(sequence>capacity)transport.Wait(base+128,sequence-capacity);
    transport.Copy(base,reinterpret_cast<uint64_t>(request),64);
    transport.Record(base+64,sequence); // 参数写入完成后发布；server 读取相同 seq。
}
extern "C" __global__ __aicore__ void DslCcuWait(GM_ADDR mailbox,uint64_t sequence,uint32_t capacity)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    if(GetBlockIdx()!=0||!sequence||!capacity)return;
    AivTransport transport;transport.Init();
    transport.Wait(reinterpret_cast<uint64_t>(mailbox)+((sequence-1)%capacity)*sizeof(CcuMailbox)+128,sequence);
}
extern "C" void LaunchDslCcuSubmit(void* mailbox,void* request,uint64_t sequence,uint32_t capacity,void* stream)
{DslCcuSubmit<<<1,nullptr,stream>>>((GM_ADDR)mailbox,(GM_ADDR)request,sequence,capacity);}
extern "C" void LaunchDslCcuWait(void* mailbox,uint64_t sequence,uint32_t capacity,void* stream)
{DslCcuWait<<<1,nullptr,stream>>>((GM_ADDR)mailbox,sequence,capacity);}
