/* !
 * \file batch_matmul_tensor_api.asc
 * \brief Batch matmul + per-batch vector quant via Tensor API.
 *
 * Builds on the single-matrix mmad_tensor_api sample (int8 mmad + int32 accum + uint64 quant -> half C)
 * and adds a leading B axis to A/B/C and the quant tensor. The quant tensor is laid out as
 * (B, (1, N)), i.e. one 1xN dequant row per batch, mirroring the layout used by C in the L0C->GM stage.
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

template <uint32_t Value, uint32_t Align>
struct CeilAlign {
    static constexpr uint32_t value = (Value + Align - 1) / Align * Align;
};

template <typename A_TYPE, typename B_TYPE, typename L0C_TYPE, typename C_TYPE,
          uint32_t B, uint32_t M, uint32_t K, uint32_t N, uint32_t L1BatchSize, uint32_t L0BatchSize>
__global__ __cube__ void batch_matmul_quant_tensor_api(__gm__ A_TYPE* a, __gm__ B_TYPE* b, __gm__ C_TYPE* c,
                                                        __gm__ uint64_t* quant)
{
    using namespace AscendC::Te;

    constexpr uint32_t A_C0 = 32 / sizeof(A_TYPE);
    constexpr uint32_t B_C0 = 32 / sizeof(B_TYPE);
    constexpr uint32_t L1_A_SIZE = CeilAlign<M, 16>::value * CeilAlign<K, A_C0>::value;
    constexpr uint32_t L1_B_SIZE = CeilAlign<K, 16>::value * CeilAlign<N, B_C0>::value;
    constexpr uint32_t L0_A_SIZE = L1_A_SIZE;
    constexpr uint32_t L0_B_SIZE = CeilAlign<K, B_C0>::value * CeilAlign<N, 16>::value;
    constexpr uint32_t L0_C_SIZE = CeilAlign<M, 16>::value * CeilAlign<N, 16>::value;

    uint32_t blockIndex = AscendC::GetBlockIdx();
    uint32_t singleCoreB = B / AscendC::GetBlockNum();
    uint32_t singleCoreResB = B % AscendC::GetBlockNum();
    uint32_t actualSingleCoreB = singleCoreB + (singleCoreResB > blockIndex ? 1 : 0);
    uint32_t BIndexStart = singleCoreB * blockIndex + min(blockIndex, singleCoreResB);
    uint32_t BIndexEnd = actualSingleCoreB + BIndexStart;

    auto gmA = MakeTensor(MakeMemPtr(a), MakeFrameLayout<NDExtLayoutPtn>(B, M, K));
    auto gmB = MakeTensor(MakeMemPtr(b), MakeFrameLayout<DNExtLayoutPtn>(B, K, N));
    auto gmC = MakeTensor(MakeMemPtr(c), MakeFrameLayout<NDExtLayoutPtn>(B, M, N));
    auto gmQuant = MakeTensor(MakeMemPtr(quant), MakeFrameLayout<NDExtLayoutPtn>(B, 1, N));

    __cbuf__ A_TYPE l1ABuf[L1BatchSize * L1_A_SIZE];
    __cbuf__ B_TYPE l1BBuf[L1BatchSize * L1_B_SIZE];
    __cbuf__ uint64_t l1QuantBuf[L1BatchSize * N];
    __ca__ A_TYPE l0ABuf[L0BatchSize * L0_A_SIZE];
    __cb__ B_TYPE l0BBuf[L0BatchSize * L0_B_SIZE];
    __cc__ L0C_TYPE l0CBuf[L0BatchSize * L0_C_SIZE];

    auto l1ATensor = MakeTensor(MakeMemPtr(l1ABuf), MakeFrameLayout<NZLayoutPtn, A_TYPE>(L1BatchSize, M, K));
    auto l1BTensor = MakeTensor(MakeMemPtr(l1BBuf), MakeFrameLayout<ZNLayoutPtn, B_TYPE>(L1BatchSize, K, N));
    auto l1QuantTensor =
        MakeTensor(MakeMemPtr(l1QuantBuf), MakeFrameLayout<NDExtLayoutPtn>(L1BatchSize, 1, N));
    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, A_TYPE>(L0BatchSize, M, K));
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, B_TYPE>(L0BatchSize, K, N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn>(L0BatchSize, M, N));

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0AAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    static constexpr uint32_t L1_EVENT_ID = 0;
    static constexpr uint32_t L0_EVENT_ID = 1;
    static constexpr uint32_t L0C_EVENT_ID = 2;
    static constexpr uint32_t QUANT_EVENT_ID = 3;
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::SetFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);

    for (uint32_t l1batchIndex = BIndexStart; l1batchIndex < BIndexEnd; l1batchIndex += L1BatchSize) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);
        uint32_t l1BatchSize = min(L1BatchSize, BIndexEnd - l1batchIndex);
        Copy(copyGM2L1Atom, l1ATensor,
            gmA.Slice(MakeCoord(l1batchIndex, MakeCoord(0, 0)), MakeShape(l1BatchSize, MakeShape(M, K))));
        Copy(copyGM2L1Atom, l1BTensor,
            gmB.Slice(MakeCoord(l1batchIndex, MakeCoord(0, 0)), MakeShape(l1BatchSize, MakeShape(K, N))));
        Copy(copyGM2L1Atom, l1QuantTensor,
            gmQuant.Slice(MakeCoord(l1batchIndex, MakeCoord(0, 0)), MakeShape(l1BatchSize, MakeShape(1, N))));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(L1_EVENT_ID);

        for (uint32_t l0BatchIndex = 0; l0BatchIndex < l1BatchSize; l0BatchIndex += L0BatchSize) {
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
            uint32_t l0BatchSize = min(L0BatchSize, l1BatchSize - l0BatchIndex);
            Copy(copyL12L0AAtom, l0ATensor,
                l1ATensor.Slice(MakeCoord(l0BatchIndex, MakeCoord(0, 0)), MakeShape(l0BatchSize, MakeShape(M, K))));
            Copy(copyL12L0BAtom, l0BTensor,
                l1BTensor.Slice(MakeCoord(l0BatchIndex, MakeCoord(0, 0)), MakeShape(l0BatchSize, MakeShape(K, N))));
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(L0_EVENT_ID);
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);

            for (uint32_t l0CBatchIndex = 0; l0CBatchIndex < l0BatchSize; l0CBatchIndex++) {
                Mmad(mmadAtom.with(MmadParams{static_cast<uint16_t>(M), static_cast<uint16_t>(N),
                                              static_cast<uint16_t>(K), 0, true}),
                    l0CTensor.Slice(MakeCoord(l0CBatchIndex, MakeCoord(0, 0)), MakeShape(1, MakeShape(M, N))),
                    l0ATensor.Slice(MakeCoord(l0CBatchIndex, MakeCoord(0, 0)), MakeShape(1, MakeShape(M, K))),
                    l0BTensor.Slice(MakeCoord(l0CBatchIndex, MakeCoord(0, 0)), MakeShape(1, MakeShape(K, N))));
            }
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(L0C_EVENT_ID);

            // Per-batch vector quant: pass the (l0BatchSize, (1, N)) quant slice as the third arg
            // so DataCopyL0C2GM::Run dispatches into the VectorQuant path, which calls CopyL12FbBatch
            // to land per-batch quant scales on FB before the fixpipe instruction fires.
            auto l1QuantSlice = l1QuantTensor.Slice(MakeCoord(l0BatchIndex, MakeCoord(0, 0)),
                                                    MakeShape(l0BatchSize, MakeShape(1, N)));
            Copy(copyL0C2GMAtom,
                gmC.Slice(MakeCoord(l1batchIndex + l0BatchIndex, MakeCoord(0, 0)),
                          MakeShape(l0BatchSize, MakeShape(M, N))),
                l0CTensor, l1QuantSlice);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
        AscendC::SetFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);
    }
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(L0_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(L1_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(L0C_EVENT_ID);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_MTE2>(QUANT_EVENT_ID);
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = int8_t;
    using B_TYPE = int8_t;
    using L0C_TYPE = int32_t;
    using C_TYPE = half;

    constexpr uint32_t B = 128;
    constexpr uint32_t M = 32;
    constexpr uint32_t K = 32;
    constexpr uint32_t N = 32;
    constexpr uint32_t L1BatchSize = 32;
    constexpr uint32_t L0BatchSize = 4;

    size_t aFileSize = B * M * K * sizeof(A_TYPE);
    size_t bFileSize = B * K * N * sizeof(B_TYPE);
    size_t cFileSize = B * M * N * sizeof(C_TYPE);
    size_t quantFileSize = B * 1 * N * sizeof(uint64_t);

    uint32_t numBlocks = 32;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost, *bHost, *cHost, *quantHost;
    A_TYPE* aDevice;
    B_TYPE* bDevice;
    C_TYPE* cDevice;
    uint64_t* quantDevice;

    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMallocHost((void**)(&cHost), cFileSize);
    aclrtMallocHost((void**)(&quantHost), quantFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&quantDevice, quantFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", aFileSize, aHost, aFileSize);
    ReadFile("./input/input_y.bin", bFileSize, bHost, bFileSize);
    ReadFile("./input/quant.bin", quantFileSize, quantHost, quantFileSize);

    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(quantDevice, quantFileSize, quantHost, quantFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    batch_matmul_quant_tensor_api<A_TYPE, B_TYPE, L0C_TYPE, C_TYPE, B, M, K, N, L1BatchSize, L0BatchSize>
        <<<numBlocks, nullptr, stream>>>(aDevice, bDevice, cDevice, quantDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cFileSize);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFree(quantDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(cHost);
    aclrtFreeHost(quantHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
