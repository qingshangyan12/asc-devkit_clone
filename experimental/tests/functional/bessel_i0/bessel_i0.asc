/**
 * Standalone bessel_i0 test kernel — inline Reg:: implementation (A&S two-region, shift-fold exp).
 *
 * Validates NPU ARITHMETIC before the adv_api file set is wired in. numpy host model predicted
 * max rel err 5.4e-7 vs scipy.special.i0 (function-shaped sampling), 0 fails, ASSUMING a correctly
 * rounded exp. On-silicon region2 accuracy therefore hinges on Reg::Exp precision (see note below).
 *
 * DataCopyPad form: 5-field DataCopyExtParams / 4-arg DataCopyPad — VERIFIED to build on CANN 9.0.1,
 * 9.1.0-beta.3 and GA 9.1.0 (same form the ndtri harness uses). Reg::MulDstAdd (not FusedMulDstAdd).
 *
 * SHIFT-FOLD region2: I0 = exp(a-3.75) * (P2S(3.75/a)/sqrt(a)), P2S = P2*e^3.75 baked into coeffs.
 *   - exp(a-3.75) < I0 in region2 -> never overflows before I0 does (fp32 max 3.4e38 at a~91.9).
 *   - exp error enters ONCE. Host sweep: passes 双万分之一 iff Reg::Exp rel err < ~6e-5. CONFIRM ON SILICON.
 */

#include <stdlib.h>
#include <sys/time.h>

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// All RUNTIME, not -D defines (same rationale as the ndtri harness): size/mode/loops as args = ONE
// build, then instant runs, instead of a full cmake+bisheng rebuild per size per mode.
struct BesselI0CustomTilingData {
    uint32_t totalLength;
    uint32_t testMode;  // 1=precision, 2=copy-only baseline, 3=compute looped perfLoops times
    uint32_t perfLoops;
};

// The .asc is compiled TWICE: device (__NPU_ARCH__=3510, has __simd_vf__/Reg::) and host (neither).
// So the Reg:: body is device-only with an empty host stub, exactly like include/adv_api/math/erf.h.
namespace MyBesselI0 {
using namespace AscendC;

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)

constexpr float BESSEL_I0_BP = 3.75f;
constexpr float BESSEL_I0_INV_BP = 0.26666668f; // fp32(1/3.75)

// region1 (A&S 9.8.1): Horner in t=(a/3.75)^2, highest degree first
constexpr float BESSEL_I0_P1[7] = {0.0045813f, 0.0360768f, 0.2659732f, 1.2067492f,
                                   3.0899424f, 3.5156229f, 1.0f};
// region2 (A&S 9.8.2): Horner in t=3.75/a, highest first, PREMULTIPLIED by e^3.75 (=42.521084)
constexpr float BESSEL_I0_P2S[9] = {1.66842952e-01f,  -7.00591385e-01f, 1.12065899e+00f,
                                    -8.74958873e-01f, 3.89612585e-01f,  -6.69983402e-02f,
                                    9.58080739e-02f,  5.64931691e-01f,  1.69634590e+01f};

// acc = acc*x + c, single rounding. MulDstAdd(dst, a, b) -> dst = dst*a + b
__simd_callee__ inline void FmaStep(
    Reg::RegTensor<float>& acc, Reg::RegTensor<float>& x, const float c, Reg::MaskReg& mask)
{
    Reg::RegTensor<float> cReg;
    Reg::Duplicate(cReg, c, mask);
    Reg::MulDstAdd(acc, x, cReg, mask);
}

__simd_callee__ inline void BesselI0Compute(
    Reg::RegTensor<float>& dstReg, Reg::RegTensor<float>& xReg, Reg::MaskReg& mask)
{
    Reg::RegTensor<float> a, t1, t2, r1, r2, poly, sqa, ea, three75, nanReg;
    Reg::MaskReg mRegion1, mInf;

    Reg::Abs(a, xReg, mask); // I0 is even

    // ---------- region1: I0 = P1((a/3.75)^2)
    Reg::Muls(t1, a, BESSEL_I0_INV_BP, mask);
    Reg::Mul(t1, t1, t1, mask);
    Reg::Duplicate(r1, BESSEL_I0_P1[0], mask);
    FmaStep(r1, t1, BESSEL_I0_P1[1], mask);
    FmaStep(r1, t1, BESSEL_I0_P1[2], mask);
    FmaStep(r1, t1, BESSEL_I0_P1[3], mask);
    FmaStep(r1, t1, BESSEL_I0_P1[4], mask);
    FmaStep(r1, t1, BESSEL_I0_P1[5], mask);
    FmaStep(r1, t1, BESSEL_I0_P1[6], mask);

    // ---------- region2 (shift-fold): I0 = exp(a-3.75) * (P2S(3.75/a)/sqrt(a))
    Reg::Duplicate(three75, BESSEL_I0_BP, mask);
    Reg::Div(t2, three75, a, mask); // 3.75/a
    Reg::Duplicate(poly, BESSEL_I0_P2S[0], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[1], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[2], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[3], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[4], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[5], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[6], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[7], mask);
    FmaStep(poly, t2, BESSEL_I0_P2S[8], mask);

    Reg::Sqrt(sqa, a, mask);
    Reg::Div(poly, poly, sqa, mask);
    Reg::Adds(ea, a, -BESSEL_I0_BP, mask);
    Reg::Exp(ea, ea, mask); // exp(a-3.75)
    Reg::Mul(r2, ea, poly, mask);

    // ---------- combine: lane pick, never an arithmetic blend. x==0 -> region1 =1 and NaN -> NaN natural.
    Reg::Compares<float, CMPMODE::LE>(mRegion1, a, BESSEL_I0_BP, mask);
    Reg::Select(dstReg, r1, r2, mRegion1);

    // |x|==Inf -> NaN, EXPLICIT (robust to Reg::Exp(Inf) clamping to FLT_MAX, which would make the
    // natural Inf*0 path return 0). a=|x| covers both signs. (matches scipy AND torch.i0)
    Reg::Duplicate(nanReg, __builtin_nanf(""), mask);
    Reg::Compares<float, CMPMODE::EQ>(mInf, a, __builtin_inff(), mask);
    Reg::Select(dstReg, nanReg, dstReg, mInf);
}

__simd_vf__ inline void BesselI0CoreImpl(
    __ubuf__ float* dstUb, __ubuf__ float* srcUb, uint32_t calCount, uint16_t repeatTimes)
{
    Reg::MaskReg mask;
    Reg::RegTensor<float> xReg, dstReg;
    for (uint16_t i = 0; i < repeatTimes; ++i) {
        mask = Reg::UpdateMask<float>(calCount);
        Reg::LoadAlign(xReg, srcUb + i * B32_DATA_NUM_PER_REPEAT);
        BesselI0Compute(dstReg, xReg, mask);
        Reg::StoreAlign(dstUb + i * B32_DATA_NUM_PER_REPEAT, dstReg, mask);
    }
}

__aicore__ inline void BesselI0(
    const LocalTensor<float>& dstTensor, const LocalTensor<float>& srcTensor, const uint32_t calCount)
{
    if ASCEND_IS_AIC {
        return;
    }
    __ubuf__ float* dstUb = (__ubuf__ float*)dstTensor.GetPhyAddr();
    __ubuf__ float* srcUb = (__ubuf__ float*)srcTensor.GetPhyAddr();
    uint16_t repeatTimes = CeilDivision(calCount, static_cast<uint32_t>(B32_DATA_NUM_PER_REPEAT));
    BesselI0CoreImpl(dstUb, srcUb, calCount, repeatTimes);
}

#else // host compile pass: empty stub so the call site still type-checks (mirrors erf.h)

__aicore__ inline void BesselI0(
    const LocalTensor<float>& dstTensor, const LocalTensor<float>& srcTensor, const uint32_t calCount)
{
    (void)dstTensor;
    (void)srcTensor;
    (void)calCount;
}

#endif
} // namespace MyBesselI0

namespace MyCustomKernel {
// TILED wrapper + PING-PONG, identical to the ndtri harness. 3510 UB is 248KB; whole-tensor-in-UB
// dies above N=32768, so we tile at TILE_ELEMS and double-buffer to hide MTE2/MTE3 under compute.
constexpr uint32_t TILE_ELEMS = 8192;
constexpr int32_t BUFFER_NUM = 2;

template <typename T>
class KernelBesselI0 {
public:
    __aicore__ inline KernelBesselI0() {}
    __aicore__ inline void Init(
        __gm__ uint8_t* x, __gm__ uint8_t* y, BesselI0CustomTilingData tilingData, AscendC::TPipe* pipeIn)
    {
        this->totalLength = tilingData.totalLength;
        this->testMode = tilingData.testMode;
        this->perfLoops = tilingData.perfLoops;
        this->tileElems = this->totalLength < TILE_ELEMS ? this->totalLength : TILE_ELEMS;
        constexpr uint32_t oneBlkSize = 32 / sizeof(T);
        this->tileAlign = (this->tileElems + oneBlkSize - 1) / oneBlkSize * oneBlkSize;

        xGm.SetGlobalBuffer((__gm__ T*)x, this->totalLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, this->totalLength);

        pipe = pipeIn;
        pipe->InitBuffer(inQueueX, BUFFER_NUM, this->tileAlign * sizeof(T));
        pipe->InitBuffer(outQueueY, BUFFER_NUM, this->tileAlign * sizeof(T));
    }

    // mode 1 = precision, 2 = copy-only baseline, 3 = compute looped perfLoops times.
    __aicore__ inline void Process()
    {
        for (uint32_t off = 0; off < this->totalLength; off += this->tileElems) {
            uint32_t n = this->totalLength - off;
            if (n > this->tileElems) {
                n = this->tileElems;
            }
            CopyIn(off, n);
            if (this->testMode == 2) {
                CopyOutInput(off, n);
            } else {
                Compute(n, this->testMode == 3 ? this->perfLoops : 1);
                CopyOut(off, n);
            }
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t off, uint32_t n)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopyPad(
            xLocal, xGm[off], AscendC::DataCopyExtParams(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0),
            AscendC::DataCopyPadExtParams<T>());
        inQueueX.EnQue(xLocal);
    }
    __aicore__ inline void Compute(uint32_t n, uint32_t loops)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        for (uint32_t j = 0; j < loops; j++) {
            MyBesselI0::BesselI0(yLocal, xLocal, n);
        }
        outQueueY.EnQue<T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void CopyOut(uint32_t off, uint32_t n)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopyPad(
            yGm[off], yLocal, AscendC::DataCopyExtParams(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0));
        outQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOutInput(uint32_t off, uint32_t n)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::DataCopyPad(
            yGm[off], xLocal, AscendC::DataCopyExtParams(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0));
        inQueueX.FreeTensor(xLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueY;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    uint32_t totalLength = 0;
    uint32_t testMode = 1;
    uint32_t perfLoops = 1;
    uint32_t tileElems = 0;
    uint32_t tileAlign = 0;
};
} // namespace MyCustomKernel

__vector__ __global__ void bessel_i0_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, BesselI0CustomTilingData tiling)
{
    if ASCEND_IS_AIC {
        return;
    }
    AscendC::TPipe pipe;
    MyCustomKernel::KernelBesselI0<float> op;
    op.Init(x, y, tiling, &pipe);
    op.Process();
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
} // namespace

static bool CompareResult(const void* outputData, const void* inputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    constexpr float ERR_RATIO = 1e-4;
    int64_t wrongNum = 0;
    int64_t totalNum = outSize / sizeof(float);
    float maxRel = 0.0f;

    // <cmath>'s std::isfinite/isnan are unavailable in the device pass; use arithmetic identities.
    auto isNan = [](float x) { return x != x; };
    auto isFinite = [](float x) { return (x - x) == 0.0f; };

    const float* inX = reinterpret_cast<const float*>(inputData);
    for (size_t i = 0; i < totalNum; i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        // boundary lanes (+-inf / nan golden): require exact match, not a relative error
        if (!isFinite(b)) {
            if (!((isNan(a) && isNan(b)) || a == b)) {
                printf("boundary mismatch at %zu: x=%f out=%f golden=%f\n", i, inX[i], a, b);
                wrongNum++;
            }
            continue;
        }
        float re = (b == 0.0f) ? ((a == 0.0f) ? 0.0f : 1.0f) : std::abs(a - b) / std::abs(b);
        if (re > maxRel) {
            maxRel = re;
        }
        if (re > EPS) {
            // print x too: failures clustered at |x|>3.75 implicate Reg::Exp precision (region1 has no
            // exp and is bulletproof); spread across both regions implicates a coeff/Select/arg-order bug.
            if (wrongNum < 10) {
                printf("mismatch at %zu: x=%.6f out=%.9f golden=%.9f rel=%.3e\n", i, inX[i], a, b, re);
            }
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    float wrongRatio = (totalNum > 0) ? static_cast<float>(wrongNum) / totalNum : 0.0f;
    printf("max rel err = %.3e | wrong = %ld / %ld | error ratio: %.6f, tolerance: %.6f\n", maxRel, wrongNum,
        totalNum, wrongRatio, ERR_RATIO);
    if (wrongRatio > ERR_RATIO) {
        return false;
    }
    printf("CompareResult golden.bin success!\n");
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    // usage: ./demo [size] [testMode 1|2|3] [perfLoops]
    uint32_t totalLength = (argc > 1) ? (uint32_t)strtoul(argv[1], nullptr, 10) : 2048u;
    uint32_t testMode = (argc > 2) ? (uint32_t)strtoul(argv[2], nullptr, 10) : 1u;
    uint32_t perfLoops = (argc > 3) ? (uint32_t)strtoul(argv[3], nullptr, 10) : 1000u;
    size_t inputSize = totalLength * sizeof(uint32_t);
    size_t outputSize = inputSize;
    BesselI0CustomTilingData tiling = {totalLength, testMode, perfLoops};

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost;
    uint8_t *xDevice, *yDevice;
    aclrtMallocHost((void**)(&xHost), inputSize);
    aclrtMallocHost((void**)(&yHost), outputSize);
    aclrtMalloc((void**)&xDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputSize, xHost, inputSize);
    aclrtMemcpy(xDevice, inputSize, xHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Time ONLY launch->sync (excludes aclInit / malloc / file IO / sim model startup).
    struct timeval kv0, kv1;
    gettimeofday(&kv0, nullptr);
    bessel_i0_custom<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, tiling);
    aclrtSynchronizeStream(stream);
    gettimeofday(&kv1, nullptr);
    double kernelUs = (kv1.tv_sec - kv0.tv_sec) * 1e6 + (kv1.tv_usec - kv0.tv_usec);
    printf("kernel time: %.1f us\n", kernelUs);

    aclrtMemcpy(yHost, outputSize, yDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputSize);

    bool goldenResult = true;
    if (testMode == 1) {
        goldenResult = CompareResult(yHost, xHost, outputSize);
    }

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (testMode == 1) {
        printf(goldenResult ? "test pass!\n" : "test failed!\n");
    }
    return goldenResult ? 0 : 1;
}
