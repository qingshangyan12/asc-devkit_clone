#include "kernel_operator.h"
#include "adv_api/math/bessel_i0.h"

using namespace AscendC;

constexpr uint32_t SYMBOL_CHECK_COUNT = 32U;

__vector__ __global__ void bessel_i0_api_symbol(__gm__ uint8_t* dst, __gm__ uint8_t* src)
{
    if ASCEND_IS_AIC {
        return;
    }
    (void)dst;
    (void)src;

    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    pipe.InitBuffer(inputQueue, 1, SYMBOL_CHECK_COUNT * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, SYMBOL_CHECK_COUNT * sizeof(float));

    LocalTensor<float> inputLocal = inputQueue.AllocTensor<float>();
    LocalTensor<float> outputLocal = outputQueue.AllocTensor<float>();

    BesselI0<float, false>(outputLocal, inputLocal, SYMBOL_CHECK_COUNT);
    BesselI0<float, false>(outputLocal, inputLocal);

    outputQueue.FreeTensor(outputLocal);
    inputQueue.FreeTensor(inputLocal);
}
