/**
 * Standalone ndtri test kernel — inline Reg:: implementation (Cephes central + Acklam tail).
 *
 * Validates NPU ARITHMETIC before the adv_api file set exists. numpy model predicted
 * max rel err 5.3e-5; measured 4.5e-5 on the 950PR simulator (CANN 9.0.1), 0 fails.
 *
 * DataCopyPad form: VERIFIED to build on BOTH CANN 9.0.1 and 9.1.0-beta.3 —
 *   DataCopyExtParams(count, len, srcStride, dstStride, rsv)   <- 5 fields
 *   DataCopyPad(LocalTensor dst, GlobalTensor src, params, DataCopyPadExtParams<T>())  <- 4 args
 * NOTE: the official self_test_case harness uses a 4-field / 3-arg form that compiles on NEITHER
 * of those CANN versions. If your GA 9.1 device rejects the 5-field form, switch to the harness form.
 * Reg::MulDstAdd is used (not FusedMulDstAdd) — the latter does not exist in 9.0.1 or 9.1-beta.3.
 */

#include <stdlib.h>
#include <sys/time.h>

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// All RUNTIME, not -D defines. The official harness bakes SIZE/TEST_MODE in at compile time, so
// sweeping sizes means a full cmake+bisheng rebuild per size per mode (~48s for one 1024 perf point,
// while the kernel itself is ~0.6us). Passing them as args = ONE build, then instant runs.
struct NdtriCustomTilingData {
    uint32_t totalLength;
    uint32_t testMode;  // 1=precision, 2=copy-only baseline, 3=compute looped perfLoops times
    uint32_t perfLoops;
};

// The .asc is compiled TWICE: once for device (__NPU_ARCH__=3510, has __simd_vf__/Reg::) and once for
// host (neither exists — __simd_vf__ lives in the compiler's __clang_cce_defines.h, and reg_compute is
// guarded on __NPU_ARCH__). So the Reg:: body must be device-only, with an empty host stub — exactly
// how include/adv_api/math/erf.h does it.
namespace MyNdtri {
using namespace AscendC;

#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)

constexpr float NDTRI_S2PI = 2.5066282746310002f;
// central iff  pLow <= p <= pHigh  <=>  |p-0.5| <= 0.47575
constexpr float NDTRI_HALFWIDTH = 0.47575f;

// Cephes central: numerator P0 (deg 4), denominator Q0 (MONIC deg 8)
constexpr float NDTRI_P0[5] = {-5.99633501014107895267e1f, 9.80010754185999661536e1f,
                               -5.66762857469070293439e1f, 1.39312609387279679503e1f,
                               -1.23916583867381258016e0f};
constexpr float NDTRI_Q0[8] = {1.95448858338141759834e0f,  4.67627912898881538453e0f,
                               8.63602421390890590575e1f,  -2.25462687854119370527e2f,
                               2.00260212380060660359e2f,  -8.20372256168333339912e1f,
                               1.59056225126211695515e1f,  -1.18331621121330003142e0f};
// Acklam tail: C (deg 5) / D (deg 4, then *q + 1)
constexpr float NDTRI_C[6] = {-7.784894002430293e-3f, -3.223964580411365e-1f, -2.400758277161838e0f,
                              -2.549732539343734e0f,  4.374664141464968e0f,   2.938163982698783e0f};
constexpr float NDTRI_D[4] = {7.784695709041462e-3f, 3.224671290700398e-1f, 2.445134137142996e0f,
                              3.754408661907416e0f};

// acc = acc*x + c, single rounding. MulDstAdd(dst, a, b) -> dst = dst*a + b
__simd_callee__ inline void FmaStep(
    Reg::RegTensor<float>& acc, Reg::RegTensor<float>& x, const float c, Reg::MaskReg& mask)
{
    Reg::RegTensor<float> cReg;
    Reg::Duplicate(cReg, c, mask);
    Reg::MulDstAdd(acc, x, cReg, mask);
}

__simd_callee__ inline void NdtriCompute(
    Reg::RegTensor<float>& dstReg, Reg::RegTensor<float>& pReg, Reg::MaskReg& mask)
{
    Reg::RegTensor<float> q, r, num, den, corr, t, zc, zt, tmp, oneReg;
    Reg::MaskReg mCentral, mNeg, mTmp;

    Reg::Adds(q, pReg, -0.5f, mask); // q = p - 0.5   (exact for p>=0.25, Sterbenz)
    Reg::Mul(r, q, q, mask);         // r = q*q

    // ---------- central (Cephes): z = s2pi * q * (1 + r*P0(r)/Q0(r))
    Reg::Duplicate(num, NDTRI_P0[0], mask);
    FmaStep(num, r, NDTRI_P0[1], mask);
    FmaStep(num, r, NDTRI_P0[2], mask);
    FmaStep(num, r, NDTRI_P0[3], mask);
    FmaStep(num, r, NDTRI_P0[4], mask);

    Reg::Adds(den, r, NDTRI_Q0[0], mask); // monic: den = r + q0
    FmaStep(den, r, NDTRI_Q0[1], mask);
    FmaStep(den, r, NDTRI_Q0[2], mask);
    FmaStep(den, r, NDTRI_Q0[3], mask);
    FmaStep(den, r, NDTRI_Q0[4], mask);
    FmaStep(den, r, NDTRI_Q0[5], mask);
    FmaStep(den, r, NDTRI_Q0[6], mask);
    FmaStep(den, r, NDTRI_Q0[7], mask);

    Reg::Mul(num, num, r, mask);      // r*P0(r)
    Reg::Div(corr, num, den, mask);   // corr = r*P0/Q0   in [0, 0.655] -> no cancellation
    Reg::Adds(corr, corr, 1.0f, mask);
    Reg::Mul(zc, q, corr, mask);
    Reg::Muls(zc, zc, NDTRI_S2PI, mask);

    // ---------- tail (Acklam): z = +-C(qt)/D(qt), qt = sqrt(-2 ln t), t = min(p, 1-p)
    Reg::Duplicate(oneReg, 1.0f, mask);
    Reg::Sub(t, oneReg, pReg, mask); // 1-p  (exact for p>=0.5, Sterbenz)
    Reg::Min(t, pReg, t, mask);      // t = min(p, 1-p)  -- NOT 0.5-|q|, that breaks p<0.25
    Reg::Ln(t, t, mask);
    Reg::Muls(t, t, -2.0f, mask);
    Reg::Sqrt(t, t, mask); // t := qt

    Reg::Duplicate(num, NDTRI_C[0], mask);
    FmaStep(num, t, NDTRI_C[1], mask);
    FmaStep(num, t, NDTRI_C[2], mask);
    FmaStep(num, t, NDTRI_C[3], mask);
    FmaStep(num, t, NDTRI_C[4], mask);
    FmaStep(num, t, NDTRI_C[5], mask);

    Reg::Duplicate(den, NDTRI_D[0], mask);
    FmaStep(den, t, NDTRI_D[1], mask);
    FmaStep(den, t, NDTRI_D[2], mask);
    FmaStep(den, t, NDTRI_D[3], mask);
    Reg::Mul(den, den, t, mask);
    Reg::Adds(den, den, 1.0f, mask); // D(q)*q + 1

    Reg::Div(zt, num, den, mask);
    Reg::Neg(tmp, zt, mask);
    Reg::Compares<float, CMPMODE::GT>(mNeg, q, 0.0f, mask); // p>0.5 <=> q>0
    Reg::Select(zt, tmp, zt, mNeg);

    // ---------- combine: lane pick, never an arithmetic blend
    Reg::Abs(tmp, q, mask);
    Reg::Compares<float, CMPMODE::LE>(mCentral, tmp, NDTRI_HALFWIDTH, mask);
    Reg::Select(dstReg, zc, zt, mCentral);

    // ---------- boundary patch. NaN propagates naturally (compares false -> tail lane = NaN).
    Reg::Duplicate(tmp, -__builtin_inff(), mask);
    Reg::Compares<float, CMPMODE::EQ>(mTmp, pReg, 0.0f, mask);
    Reg::Select(dstReg, tmp, dstReg, mTmp); // p==0 -> -inf

    Reg::Duplicate(tmp, __builtin_inff(), mask);
    Reg::Compares<float, CMPMODE::EQ>(mTmp, pReg, 1.0f, mask);
    Reg::Select(dstReg, tmp, dstReg, mTmp); // p==1 -> +inf

    Reg::Duplicate(tmp, __builtin_nanf(""), mask);
    Reg::Compares<float, CMPMODE::LT>(mTmp, pReg, 0.0f, mask);
    Reg::Select(dstReg, tmp, dstReg, mTmp); // p<0 -> nan
    Reg::Compares<float, CMPMODE::GT>(mTmp, pReg, 1.0f, mask);
    Reg::Select(dstReg, tmp, dstReg, mTmp); // p>1 -> nan
}

__simd_vf__ inline void NdtriCoreImpl(
    __ubuf__ float* dstUb, __ubuf__ float* srcUb, uint32_t calCount, uint16_t repeatTimes)
{
    Reg::MaskReg mask;
    Reg::RegTensor<float> pReg, dstReg;
    for (uint16_t i = 0; i < repeatTimes; ++i) {
        mask = Reg::UpdateMask<float>(calCount); // POST_UPDATE: decrements calCount by 64
        Reg::LoadAlign(pReg, srcUb + i * B32_DATA_NUM_PER_REPEAT);
        NdtriCompute(dstReg, pReg, mask);
        Reg::StoreAlign(dstUb + i * B32_DATA_NUM_PER_REPEAT, dstReg, mask);
    }
}

__aicore__ inline void Ndtri(
    const LocalTensor<float>& dstTensor, const LocalTensor<float>& srcTensor, const uint32_t calCount)
{
    if ASCEND_IS_AIC {
        return;
    }
    __ubuf__ float* dstUb = (__ubuf__ float*)dstTensor.GetPhyAddr();
    __ubuf__ float* srcUb = (__ubuf__ float*)srcTensor.GetPhyAddr();
    uint16_t repeatTimes = CeilDivision(calCount, static_cast<uint32_t>(B32_DATA_NUM_PER_REPEAT));
    NdtriCoreImpl(dstUb, srcUb, calCount, repeatTimes);
}

#else // host compile pass: empty stub so the call site still type-checks (mirrors erf.h)

__aicore__ inline void Ndtri(
    const LocalTensor<float>& dstTensor, const LocalTensor<float>& srcTensor, const uint32_t calCount)
{
    (void)dstTensor;
    (void)srcTensor;
    (void)calCount;
}

#endif
} // namespace MyNdtri

namespace MyCustomKernel {
// TILED wrapper. 3510 UB is 248KB; the whole-tensor-in-UB shape the official harness uses needs
// N*4*2 bytes, so it dies above N=32768 (64k -> 512KB). Ndtri itself is compute-only on a LocalTensor;
// data movement is the CALLER's job — so the wrapper tiles. TILE_ELEMS*4*2 = 64KB, comfortably inside UB
// and independent of N, so every perf size (1k..64k and beyond) uses the same footprint.
constexpr uint32_t TILE_ELEMS = 8192;
// PING-PONG. Measured on silicon at N=128k single-pass with BUFFER_NUM=1: total 128,892 cyc =
// MTE2 14,744 + Vector 106,083 + MTE3 8,065 -> V blocked 17.7% of the time -> aiv_vec 82.3%, BELOW
// the 90% bar. Depth-2 lets MTE2 fetch tile N+1 while V computes tile N, hiding the copy under
// compute -> aiv_vec ~100%, ~1.22x wall. UB: 2 queues x 2 buf x 32KB = 128KB, fits the 248KB UB.
// (The PERF_LOOPS=1000 spec metric could never see this: it amortises the copy to 0.1%.)
constexpr int32_t BUFFER_NUM = 2;


template <typename T>
class KernelNdtri {
public:
    __aicore__ inline KernelNdtri() {}
    __aicore__ inline void Init(
        __gm__ uint8_t* x, __gm__ uint8_t* y, NdtriCustomTilingData tilingData, AscendC::TPipe* pipeIn)
    {
        this->totalLength = tilingData.totalLength;
        this->testMode = tilingData.testMode;
        this->perfLoops = tilingData.perfLoops;
        this->tileElems = this->totalLength < TILE_ELEMS ? this->totalLength : TILE_ELEMS;
        constexpr uint32_t oneBlkSize = 32 / sizeof(T);
        this->tileAlign = (this->tileElems + oneBlkSize - 1) / oneBlkSize * oneBlkSize;

        xGm.SetGlobalBuffer((__gm__ T*)x, this->totalLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, this->totalLength);

        pipe = pipeIn;
        pipe->InitBuffer(inQueueX, BUFFER_NUM, this->tileAlign * sizeof(T));
        pipe->InitBuffer(outQueueY, BUFFER_NUM, this->tileAlign * sizeof(T));
    }

    // mode 1 = precision, 2 = copy-only baseline, 3 = compute looped perfLoops times.
    // Runtime dispatch on a scalar, once per tile — negligible, and it buys a single build.
    __aicore__ inline void Process()
    {
        for (uint32_t off = 0; off < this->totalLength; off += this->tileElems) {
            uint32_t n = this->totalLength - off;
            if (n > this->tileElems) {
                n = this->tileElems;
            }
            CopyIn(off, n);
            if (this->testMode == 2) {
                CopyOutInput(off, n); // baseline: move only, no compute
            } else {
                Compute(n, this->testMode == 3 ? this->perfLoops : 1);
                CopyOut(off, n);
            }
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t off, uint32_t n)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopyPad(
            xLocal, xGm[off], AscendC::DataCopyExtParams(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0),
            AscendC::DataCopyPadExtParams<T>());
        inQueueX.EnQue(xLocal);
    }
    __aicore__ inline void Compute(uint32_t n, uint32_t loops)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        for (uint32_t j = 0; j < loops; j++) {
            MyNdtri::Ndtri(yLocal, xLocal, n);
        }
        outQueueY.EnQue<T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void CopyOut(uint32_t off, uint32_t n)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopyPad(
            yGm[off], yLocal, AscendC::DataCopyExtParams(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0));
        outQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOutInput(uint32_t off, uint32_t n)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::DataCopyPad(
            yGm[off], xLocal, AscendC::DataCopyExtParams(1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0));
        inQueueX.FreeTensor(xLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueY;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    uint32_t totalLength = 0;
    uint32_t testMode = 1;
    uint32_t perfLoops = 1;
    uint32_t tileElems = 0;
    uint32_t tileAlign = 0;
};
} // namespace MyCustomKernel

__vector__ __global__ void ndtri_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, NdtriCustomTilingData tiling)
{
    if ASCEND_IS_AIC {
        return;
    }
    AscendC::TPipe pipe;
    MyCustomKernel::KernelNdtri<float> op;
    op.Init(x, y, tiling, &pipe);
    op.Process();
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
} // namespace

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("test failed!\n");
        return false;
    }
    constexpr float EPS = 1e-4;
    constexpr float ERR_RATIO = 1e-4;
    int64_t wrongNum = 0;
    int64_t totalNum = outSize / sizeof(float);
    float maxRel = 0.0f;

    // .asc is compiled for host AND device; <cmath>'s std::isfinite/isnan are not available in the
    // device pass. Use arithmetic identities instead: finite <=> (x-x)==0 ; nan <=> (x!=x).
    auto isNan = [](float x) { return x != x; };
    auto isFinite = [](float x) { return (x - x) == 0.0f; };

    for (size_t i = 0; i < totalNum; i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        // boundary lanes (+-inf / nan golden): require exact match, not a relative error
        if (!isFinite(b)) {
            if (!((isNan(a) && isNan(b)) || a == b)) {
                printf("boundary mismatch at %zu: out=%f golden=%f\n", i, a, b);
                wrongNum++;
            }
            continue;
        }
        float re = (b == 0.0f) ? ((a == 0.0f) ? 0.0f : 1.0f) : std::abs(a - b) / std::abs(b);
        if (re > maxRel) {
            maxRel = re;
        }
        if (re > EPS) {
            if (wrongNum < 10) {
                printf("mismatch at %zu: out=%.9f golden=%.9f rel=%.3e\n", i, a, b, re);
            }
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    float wrongRatio = (totalNum > 0) ? static_cast<float>(wrongNum) / totalNum : 0.0f;
    printf("max rel err = %.3e | wrong = %ld / %ld | error ratio: %.6f, tolerance: %.6f\n", maxRel, wrongNum,
        totalNum, wrongRatio, ERR_RATIO);
    if (wrongRatio > ERR_RATIO) {
        return false;
    }
    printf("CompareResult golden.bin success!\n");
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    // usage: ./demo [size] [testMode 1|2|3] [perfLoops]
    uint32_t totalLength = (argc > 1) ? (uint32_t)strtoul(argv[1], nullptr, 10) : 2048u;
    uint32_t testMode = (argc > 2) ? (uint32_t)strtoul(argv[2], nullptr, 10) : 1u;
    uint32_t perfLoops = (argc > 3) ? (uint32_t)strtoul(argv[3], nullptr, 10) : 1000u;
    size_t inputSize = totalLength * sizeof(uint32_t);
    size_t outputSize = inputSize;
    NdtriCustomTilingData tiling = {totalLength, testMode, perfLoops};

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost;
    uint8_t *xDevice, *yDevice;
    aclrtMallocHost((void**)(&xHost), inputSize);
    aclrtMallocHost((void**)(&yHost), outputSize);
    aclrtMalloc((void**)&xDevice, inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", inputSize, xHost, inputSize);
    aclrtMemcpy(xDevice, inputSize, xHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Time ONLY launch->sync. Excludes aclInit / malloc / file IO / sim model startup, which
    // otherwise dominate (process wall was ~7s at N=1, essentially all startup).
    // gettimeofday, not <chrono>: this file is compiled for the device pass too, where std:: is absent.
    struct timeval kv0, kv1;
    gettimeofday(&kv0, nullptr);
    ndtri_custom<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, tiling);
    aclrtSynchronizeStream(stream);
    gettimeofday(&kv1, nullptr);
    double kernelUs = (kv1.tv_sec - kv0.tv_sec) * 1e6 + (kv1.tv_usec - kv0.tv_usec);
    printf("kernel time: %.1f us\n", kernelUs);

    aclrtMemcpy(yHost, outputSize, yDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, outputSize);

    bool goldenResult = true;
    if (testMode == 1) {
        goldenResult = CompareResult(yHost, outputSize);
    }

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    if (testMode == 1) {
        printf(goldenResult ? "test pass!\n" : "test failed!\n");
    }
    return goldenResult ? 0 : 1;
}
