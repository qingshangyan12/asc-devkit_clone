/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::pair<std::vector<T>, std::vector<T>> launch_intlv(
    std::vector<T>& src0, std::vector<T>& src1, KernelFunc kernel)
{
    uint32_t N = src0.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* s0Host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* s1Host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* d0Host = nullptr;
    uint8_t* d1Host = nullptr;
    T *s0D = nullptr, *s1D = nullptr, *d0D = nullptr, *d1D = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&d0Host, bytes);
    aclrtMallocHost((void**)&d1Host, bytes);
    aclrtMalloc((void**)&s0D, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&s1D, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d0D, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&d1D, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)s0D, bytes, s0Host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)s1D, bytes, s1Host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(s0D, s1D, d0D, d1D);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(d0Host, bytes, (uint8_t*)d0D, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(d1Host, bytes, (uint8_t*)d1D, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> d0((T*)d0Host, (T*)(d0Host + bytes));
    std::vector<T> d1((T*)d1Host, (T*)(d1Host + bytes));
    aclrtFree(s0D); aclrtFree(s1D); aclrtFree(d0D); aclrtFree(d1D);
    aclrtFreeHost(d0Host); aclrtFreeHost(d1Host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return {d0, d1};
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_ilv(const std::vector<T>& s0, const std::vector<T>& s1,
                  const std::vector<T>& d0, const std::vector<T>& d1,
                  const std::vector<T>& g0, const std::vector<T>& g1,
                  const std::string& name)
{
    std::string fname = "intlv_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,src0,src1,dst0,dst1,expected0,expected1\n";
    for (size_t i = 0; i < s0.size(); ++i) {
        f << i << ",";
        print_val(s0[i], f); f << ",";
        print_val(s1[i], f); f << ",";
        print_val(d0[i], f); f << ",";
        print_val(d1[i], f); f << ",";
        print_val(g0[i], f); f << ",";
        print_val(g1[i], f); f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 16;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_intlv(std::vector<T>& d0, std::vector<T>& d1,
                  std::vector<T>& s0, std::vector<T>& s1,
                  const char* name, uint32_t regSize)
{
    size_t N = s0.size();
    size_t numRegs = N / regSize;
    std::vector<T> g0(N), g1(N);
    size_t half = regSize / 2;
    for (size_t r = 0; r < numRegs; ++r) {
        size_t base = r * regSize;
        for (size_t j = 0; j < half; ++j) {
            g0[base + 2 * j] = s0[base + j];
            g0[base + 2 * j + 1] = s1[base + j];
            g1[base + 2 * j] = s0[base + half + j];
            g1[base + 2 * j + 1] = s1[base + half + j];
        }
    }

    print_tensor(s0, "Src0    ");
    print_tensor(s1, "Src1    ");
    print_tensor(d0, "Dst0    ");
    print_tensor(g0, "ExpDst0 ");
    print_tensor(d1, "Dst1    ");
    print_tensor(g1, "ExpDst1 ");

    save_csv_ilv(s0, s1, d0, d1, g0, g1, name);

    bool ok = true;
    std::vector<size_t> err0, err1;
    for (size_t i = 0; i < N; ++i) {
        if (d0[i] != g0[i]) { ok = false; err0.push_back(i); }
        if (d1[i] != g1[i]) { ok = false; err1.push_back(i); }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: dst0=" << err0.size()
                  << "个, dst1=" << err1.size() << "个" << std::endl;
        for (size_t e = 0; e < std::min(err0.size(), size_t(4)); ++e) {
            size_t i = err0[e];
            std::cout << "    dst0[" << i << "] output=";
            print_val(d0[i], std::cout);
            std::cout << " expected=";
            print_val(g0[i], std::cout);
            std::cout << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_intlv 寄存器级矢量交织测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * ILV_INT32_TILE;
        std::vector<int32_t> s0(N), s1(N);
        for (uint32_t i = 0; i < N; ++i) { s0[i] = static_cast<int32_t>(i * 2); s1[i] = static_cast<int32_t>(i * 2 + 1); }
        auto [d0, d1] = launch_intlv<int32_t>(s0, s1, intlv_kernel_int32);
        verify_intlv(d0, d1, s0, s1, "int32_t", 64);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ILV_INT16_TILE;
        std::vector<int16_t> s0(N), s1(N);
        for (uint32_t i = 0; i < N; ++i) { s0[i] = static_cast<int16_t>(i * 2); s1[i] = static_cast<int16_t>(i * 2 + 1); }
        auto [d0, d1] = launch_intlv<int16_t>(s0, s1, intlv_kernel_int16);
        verify_intlv(d0, d1, s0, s1, "int16_t", 128);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ILV_INT8_TILE;
        std::vector<int8_t> s0(N), s1(N);
        for (uint32_t i = 0; i < N; ++i) { s0[i] = static_cast<int8_t>(i * 2); s1[i] = static_cast<int8_t>(i * 2 + 1); }
        auto [d0, d1] = launch_intlv<int8_t>(s0, s1, intlv_kernel_int8);
        verify_intlv(d0, d1, s0, s1, "int8_t", 256);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ILV_HALF_TILE;
        std::vector<half> s0(N), s1(N);
        for (uint32_t i = 0; i < N; ++i) { s0[i] = static_cast<half>(static_cast<float>(i * 2)); s1[i] = static_cast<half>(static_cast<float>(i * 2 + 1)); }
        auto [d0, d1] = launch_intlv<half>(s0, s1, intlv_kernel_half);
        verify_intlv(d0, d1, s0, s1, "half", 128);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ILV_FLOAT_TILE;
        std::vector<float> s0(N), s1(N);
        for (uint32_t i = 0; i < N; ++i) { s0[i] = static_cast<float>(i * 2); s1[i] = static_cast<float>(i * 2 + 1); }
        auto [d0, d1] = launch_intlv<float>(s0, s1, intlv_kernel_float);
        verify_intlv(d0, d1, s0, s1, "float", 64);
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_intlv 示例测试结束。" << std::endl;
    return 0;
}
