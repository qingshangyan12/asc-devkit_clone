/* --------------------------------------------------------------------------
 * int32_t 类型交织 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t ILV_INT32_VL = 64;
constexpr uint32_t ILV_INT32_TILE = ILV_INT32_VL * 4;

__vector__ __global__ __aicore__ void intlv_kernel_int32(
    __gm__ int32_t* src0, __gm__ int32_t* src1,
    __gm__ int32_t* dst0, __gm__ int32_t* dst1)
{
    asc_init();
    uint32_t blockLen = ILV_INT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* s0Gm = src0 + get_block_idx() * blockLen;
    __gm__ int32_t* s1Gm = src1 + get_block_idx() * blockLen;
    __gm__ int32_t* d0Gm = dst0 + get_block_idx() * blockLen;
    __gm__ int32_t* d1Gm = dst1 + get_block_idx() * blockLen;
    __ubuf__ int32_t s0Local[ILV_INT32_TILE];
    __ubuf__ int32_t s1Local[ILV_INT32_TILE];
    __ubuf__ int32_t d0Local[ILV_INT32_TILE];
    __ubuf__ int32_t d1Local[ILV_INT32_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)s0Gm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int32_t*)s0Local, s0Gm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)s1Local, s1Gm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    IntlvVF_int32(s0Local, s1Local, d0Local, d1Local, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(d0Gm, (__ubuf__ int32_t*)d0Local, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
    asc_copy_ub2gm_align(d1Gm, (__ubuf__ int32_t*)d1Local, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

