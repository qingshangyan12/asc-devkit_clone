/* !
 * \file c_api_intlv.asc
 * \brief asc_intlv 寄存器级矢量交织示例
 *
 * 将两个源向量元素交织存入两个目标向量
 * 覆盖数据类型: int32_t, int16_t, int8_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量交织函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void IntlvVF_int32(
    __ubuf__ int32_t* s0, __ubuf__ int32_t* s1,
    __ubuf__ int32_t* d0, __ubuf__ int32_t* d1, uint32_t len)
{
    vector_int32_t vsrc0, vsrc1, vdst0, vdst1;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (len + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = len;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc0, s0 + i * one_rep_size);
        asc_loadalign(vsrc1, s1 + i * one_rep_size);
        asc_intlv(vdst0, vdst1, vsrc0, vsrc1);
        asc_storealign(d0 + i * one_rep_size, vdst0, vmask);
        asc_storealign(d1 + i * one_rep_size, vdst1, vmask);
    }
}

