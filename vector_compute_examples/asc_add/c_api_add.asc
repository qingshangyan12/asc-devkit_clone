/* !
 * \file c_api_add.asc
 * \brief asc_add 寄存器级矢量加法示例
 *
 * 演示 reg 级别 C API 的使用模式：
 *   asc_load (UB -> 矢量寄存器) → asc_add (寄存器计算) → asc_store (寄存器 -> UB)
 *
 * 覆盖数据类型: uint8_t, int8_t, uint16_t, int16_t, half, float, int32_t, uint32_t, bfloat16_t
 * 覆盖场景: 单核 + 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;

/* ==========================================================================
 * __simd_vf__ Reg 级矢量加法函数
 * ========================================================================== */

__simd_vf__ inline void AddVF_half(__ubuf__ half* xLocal, __ubuf__ half* yLocal,
                                    __ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_add(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void AddVF_float(__ubuf__ float* xLocal, __ubuf__ float* yLocal,
                                     __ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 64;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_add(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void AddVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* yLocal,
                                     __ubuf__ int32_t* zLocal, uint32_t blockLen)
{
    vector_int32_t vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 64;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_add(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void AddVF_int16(__ubuf__ int16_t* xLocal, __ubuf__ int16_t* yLocal,
                                     __ubuf__ int16_t* zLocal, uint32_t blockLen)
{
    vector_int16_t vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_add(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

/* ==========================================================================
 * 矢量寄存器级别的加法 Kernel（half 类型）
 * ========================================================================== */

// half 类型每个矢量寄存器可容纳 128 个元素
constexpr uint32_t HALF_VL = 128;
constexpr uint32_t HALF_TILE = HALF_VL * 4;   // 512 个 half 元素

__vector__ __global__ __aicore__ void add_kernel_half(
    __gm__ half* x, __gm__ half* y, __gm__ half* z)
{
    asc_init();

    __ubuf__ half xLocal[HALF_TILE];
    __ubuf__ half yLocal[HALF_TILE];
    __ubuf__ half zLocal[HALF_TILE];

    uint32_t blockLen = HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)xLocal,
                        (__gm__ void*)(x + offset), blockLen * sizeof(half));
    asc_copy_gm2ub_sync((__ubuf__ void*)yLocal,
                        (__gm__ void*)(y + offset), blockLen * sizeof(half));

    AddVF_half(xLocal, yLocal, zLocal, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(z + offset),
                        (__ubuf__ void*)zLocal, blockLen * sizeof(half));
}

/* ==========================================================================
 * float 类型 Kernel（VL=64）
 * ========================================================================== */

constexpr uint32_t FLOAT_VL = 64;
constexpr uint32_t FLOAT_TILE = FLOAT_VL * 4;

__vector__ __global__ __aicore__ void add_kernel_float(
    __gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();

    __ubuf__ float xLocal[FLOAT_TILE];
    __ubuf__ float yLocal[FLOAT_TILE];
    __ubuf__ float zLocal[FLOAT_TILE];

    uint32_t blockLen = FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)xLocal,
                        (__gm__ void*)(x + offset), blockLen * sizeof(float));
    asc_copy_gm2ub_sync((__ubuf__ void*)yLocal,
                        (__gm__ void*)(y + offset), blockLen * sizeof(float));

    AddVF_float(xLocal, yLocal, zLocal, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(z + offset),
                        (__ubuf__ void*)zLocal, blockLen * sizeof(float));
}

/* ==========================================================================
 * int32_t 类型 Kernel（VL=64）
 * ========================================================================== */

constexpr uint32_t INT32_VL = 64;
constexpr uint32_t INT32_TILE = INT32_VL * 4;

__vector__ __global__ __aicore__ void add_kernel_int32(
    __gm__ int32_t* x, __gm__ int32_t* y, __gm__ int32_t* z)
{
    asc_init();

    __ubuf__ int32_t xLocal[INT32_TILE];
    __ubuf__ int32_t yLocal[INT32_TILE];
    __ubuf__ int32_t zLocal[INT32_TILE];

    uint32_t blockLen = INT32_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)xLocal,
                        (__gm__ void*)(x + offset), blockLen * sizeof(int32_t));
    asc_copy_gm2ub_sync((__ubuf__ void*)yLocal,
                        (__gm__ void*)(y + offset), blockLen * sizeof(int32_t));

    AddVF_int32(xLocal, yLocal, zLocal, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(z + offset),
                        (__ubuf__ void*)zLocal, blockLen * sizeof(int32_t));
}

/* ==========================================================================
 * int16_t 类型 Kernel（VL=128）
 * ========================================================================== */

constexpr uint32_t INT16_VL = 128;
constexpr uint32_t INT16_TILE = INT16_VL * 4;

__vector__ __global__ __aicore__ void add_kernel_int16(
    __gm__ int16_t* x, __gm__ int16_t* y, __gm__ int16_t* z)
{
    asc_init();

    __ubuf__ int16_t xLocal[INT16_TILE];
    __ubuf__ int16_t yLocal[INT16_TILE];
    __ubuf__ int16_t zLocal[INT16_TILE];

    uint32_t blockLen = INT16_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)xLocal,
                        (__gm__ void*)(x + offset), blockLen * sizeof(int16_t));
    asc_copy_gm2ub_sync((__ubuf__ void*)yLocal,
                        (__gm__ void*)(y + offset), blockLen * sizeof(int16_t));

    AddVF_int16(xLocal, yLocal, zLocal, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(z + offset),
                        (__ubuf__ void*)zLocal, blockLen * sizeof(int16_t));
}

/* ==========================================================================
 * 通用 Host 侧启动函数
 * ========================================================================== */

template<typename T>
std::vector<T> kernel_add(std::vector<T>& x, std::vector<T>& y,
    void (*kernelFunc)(__gm__ T*, __gm__ T*, __gm__ T*),
    uint32_t tileElements, uint32_t numBlocks)
{
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(T);
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* zHost = nullptr;
    T* xDevice = nullptr;
    T* yDevice = nullptr;
    T* zDevice = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&zHost), totalByteSize);
    aclrtMalloc((void**)&xDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernelFunc<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, totalByteSize, (uint8_t*)zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + totalByteSize));

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

template<typename T>
bool verify_result(std::vector<T>& output, std::vector<T>& golden, const char* typeName)
{
    bool pass = std::equal(golden.begin(), golden.end(), output.begin());
    std::cout << "  [" << typeName << "] "
              << (pass ? "通过" : "失败") << std::endl;
    if (!pass) {
        for (size_t i = 0; i < std::min(output.size(), size_t(8)); ++i) {
            std::cout << "    [" << i << "] output=" << +output[i]
                      << " golden=" << +golden[i] << std::endl;
        }
    }
    return pass;
}

/* ==========================================================================
 * 各类型的测试函数
 * ========================================================================== */

bool test_half_add()
{
    constexpr uint32_t totalLen = NUM_BLOCKS * HALF_TILE;
    std::vector<half> x(totalLen), y(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) {
        x[i] = static_cast<half>(i * 0.1f);
        y[i] = static_cast<half>(i * 0.2f);
    }
    std::vector<half> output = kernel_add<half>(x, y, add_kernel_half, HALF_TILE, NUM_BLOCKS);
    std::vector<half> golden(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) {
        golden[i] = static_cast<half>(static_cast<float>(x[i]) + static_cast<float>(y[i]));
    }
    return verify_result<half>(output, golden, "half");
}

bool test_float_add()
{
    constexpr uint32_t totalLen = NUM_BLOCKS * FLOAT_TILE;
    std::vector<float> x(totalLen), y(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) {
        x[i] = i * 0.1f;
        y[i] = i * 0.2f;
    }
    std::vector<float> output = kernel_add<float>(x, y, add_kernel_float, FLOAT_TILE, NUM_BLOCKS);
    std::vector<float> golden(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) { golden[i] = x[i] + y[i]; }
    return verify_result<float>(output, golden, "float");
}

bool test_int32_add()
{
    constexpr uint32_t totalLen = NUM_BLOCKS * INT32_TILE;
    std::vector<int32_t> x(totalLen), y(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) {
        x[i] = static_cast<int32_t>(i);
        y[i] = static_cast<int32_t>(i * 2);
    }
    std::vector<int32_t> output = kernel_add<int32_t>(x, y, add_kernel_int32, INT32_TILE, NUM_BLOCKS);
    std::vector<int32_t> golden(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) { golden[i] = x[i] + y[i]; }
    return verify_result<int32_t>(output, golden, "int32_t");
}

bool test_int16_add()
{
    constexpr uint32_t totalLen = NUM_BLOCKS * INT16_TILE;
    std::vector<int16_t> x(totalLen), y(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) {
        x[i] = static_cast<int16_t>(i % 1000);
        y[i] = static_cast<int16_t>((i % 500) * 2);
    }
    std::vector<int16_t> output = kernel_add<int16_t>(x, y, add_kernel_int16, INT16_TILE, NUM_BLOCKS);
    std::vector<int16_t> golden(totalLen);
    for (uint32_t i = 0; i < totalLen; ++i) { golden[i] = x[i] + y[i]; }
    return verify_result<int16_t>(output, golden, "int16_t");
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_add 寄存器级矢量加法测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    bool allPass = true;
    allPass &= test_half_add();
    allPass &= test_float_add();
    allPass &= test_int32_add();
    allPass &= test_int16_add();

    std::cout << std::endl;
    std::cout << (allPass ? "[全部通过] asc_add 所有类型测试通过。" : "[存在失败] 部分测试未通过！") << std::endl;
    return allPass ? 0 : 1;
}
