/* !
 * \file c_api_axpy.asc
 * \brief asc_axpy 寄存器级 AXPY 示例 (dst = dst + src * alpha)
 *
 * 覆盖数据类型: half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;
constexpr float AXPY_ALPHA_F = 2.0f;

__simd_vf__ inline void AxpyVF_half(__ubuf__ half* src, __ubuf__ half* dst, uint32_t blockLen)
{
    vector_half vsrc, vdst;
    vector_bool vmask;
    half alpha = static_cast<half>(AXPY_ALPHA_F);
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, src + i * one_rep_size);
        asc_loadalign(vdst, dst + i * one_rep_size);
        asc_axpy(vdst, vsrc, alpha, vmask);
        asc_storealign(dst + i * one_rep_size, vdst, vmask);
    }
}

__simd_vf__ inline void AxpyVF_float(__ubuf__ float* src, __ubuf__ float* dst, uint32_t blockLen)
{
    vector_float vsrc, vdst;
    vector_bool vmask;
    float alpha = AXPY_ALPHA_F;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, src + i * one_rep_size);
        asc_loadalign(vdst, dst + i * one_rep_size);
        asc_axpy(vdst, vsrc, alpha, vmask);
        asc_storealign(dst + i * one_rep_size, vdst, vmask);
    }
}

/* --------------------------------------------------------------------------
 * half Kernel (VL=128)
 * -------------------------------------------------------------------------- */
constexpr uint32_t AXPY_HALF_VL = 128;
constexpr uint32_t AXPY_HALF_TILE = AXPY_HALF_VL * 4;

__vector__ __global__ __aicore__ void axpy_kernel_half(
    __gm__ half* src, __gm__ half* dst)
{
    asc_init();
    uint32_t blockLen = AXPY_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ half* srcGm = src + get_block_idx() * blockLen;
    __gm__ half* dstGm = dst + get_block_idx() * blockLen;
    __ubuf__ half srcLocal[AXPY_HALF_TILE];
    __ubuf__ half dstLocal[AXPY_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)srcGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)srcLocal, srcGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ half*)dstLocal, dstGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    AxpyVF_half(srcLocal, dstLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(dstGm, (__ubuf__ half*)dstLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * float Kernel (VL=64)
 * -------------------------------------------------------------------------- */
constexpr uint32_t AXPY_FLOAT_VL = 64;
constexpr uint32_t AXPY_FLOAT_TILE = AXPY_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void axpy_kernel_float(
    __gm__ float* src, __gm__ float* dst)
{
    asc_init();
    uint32_t blockLen = AXPY_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* srcGm = src + get_block_idx() * blockLen;
    __gm__ float* dstGm = dst + get_block_idx() * blockLen;
    __ubuf__ float srcLocal[AXPY_FLOAT_TILE];
    __ubuf__ float dstLocal[AXPY_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)srcGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)srcLocal, srcGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ float*)dstLocal, dstGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    AxpyVF_float(srcLocal, dstLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(dstGm, (__ubuf__ float*)dstLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_axpy(std::vector<T>& src, std::vector<T>& dst, KernelFunc kernel)
{
    uint32_t N = src.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* outHost = nullptr;
    T *srcD = nullptr, *dstD = nullptr, *outD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&srcD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)srcD, bytes, srcHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)dstD, bytes, dstHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(srcD, dstD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outHost, bytes, (uint8_t*)dstD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));
    aclrtFree(srcD); aclrtFree(dstD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& src, const std::vector<T>& dst_init,
              const std::vector<T>& output, const std::vector<T>& golden,
              const std::string& name)
{
    std::string fname = "axpy_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,src,dst_init,output,expected\n";
    for (size_t i = 0; i < src.size(); ++i) {
        f << i << ",";
        print_val(src[i], f);
        f << ",";
        print_val(dst_init[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
T host_axpy(T src_val, T dst_val, float alpha)
{
    if constexpr (std::is_same_v<T, half>) {
        float s = static_cast<float>(src_val);
        float d = static_cast<float>(dst_val);
        return static_cast<half>(d + s * alpha);
    } else {
        return static_cast<T>(dst_val + src_val * static_cast<T>(alpha));
    }
}

template<typename T>
bool verify_axpy(std::vector<T>& output, std::vector<T>& src,
                 std::vector<T>& dst_init, const char* name)
{
    std::vector<T> g(src.size());
    for (size_t i = 0; i < src.size(); ++i) {
        g[i] = host_axpy(src[i], dst_init[i], AXPY_ALPHA_F);
    }
    print_tensor(src,      "Src     ");
    print_tensor(dst_init, "DstInit ");
    print_tensor(output,   "Output  ");
    print_tensor(g,        "Expected");
    save_csv(src, dst_init, output, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < src.size(); ++i) {
        if (output[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size() << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=";
            print_val(output[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr)
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_axpy 寄存器级 AXPY 测试 (alpha=" << AXPY_ALPHA_F << ") ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "操作: dst = dst + src * alpha" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * AXPY_HALF_TILE;
        std::vector<half> src(N), dst_init(N);
        for (uint32_t i = 0; i < N; ++i) {
            src[i] = static_cast<half>(i * 0.1f);
            dst_init[i] = static_cast<half>(i * 0.5f);
        }
        auto out = launch_axpy<half>(src, dst_init, axpy_kernel_half);
        verify_axpy(out, src, dst_init, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * AXPY_FLOAT_TILE;
        std::vector<float> src(N), dst_init(N);
        for (uint32_t i = 0; i < N; ++i) {
            src[i] = i * 0.1f;
            dst_init[i] = i * 0.5f;
        }
        auto out = launch_axpy<float>(src, dst_init, axpy_kernel_float);
        verify_axpy(out, src, dst_init, "float");
    }
    std::cout << std::endl;
    std::cout << "[完成] asc_axpy 示例测试结束。" << std::endl;
    return 0;
}
