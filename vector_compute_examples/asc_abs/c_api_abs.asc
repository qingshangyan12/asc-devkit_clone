/* --------------------------------------------------------------------------
 * int8_t 类型绝对值 Kernel (VL=256)
 * -------------------------------------------------------------------------- */

constexpr uint32_t ABS_INT8_VL = 256;
constexpr uint32_t ABS_INT8_TILE = ABS_INT8_VL * 4;

__vector__ __global__ __aicore__ void abs_kernel_int8(
    __gm__ int8_t* input, __gm__ int8_t* output)
{
    asc_init();

    __ubuf__ int8_t local[ABS_INT8_TILE];

    uint32_t blockLen = ABS_INT8_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)local, (__gm__ void*)(input + offset),
                        blockLen * sizeof(int8_t));

    AbsVF_int8(local, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(output + offset), (__ubuf__ void*)local,
                        blockLen * sizeof(int8_t));
}

