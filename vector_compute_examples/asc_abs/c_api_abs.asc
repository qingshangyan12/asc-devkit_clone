/* !
 * \file c_api_abs.asc
 * \brief asc_abs 寄存器级绝对值示例
 *
 * 覆盖数据类型: int8_t, int16_t, int32_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级绝对值计算函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void AbsVF_int8(__ubuf__ int8_t* buf, uint32_t blockLen)
{
    vector_int8_t v;
    vector_bool vmask;
    constexpr uint32_t VL = 256;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(v, buf + i);
        asc_abs(v, v, vmask);
        asc_store(buf + i, v, vmask);
    }
}

__simd_vf__ inline void AbsVF_int16(__ubuf__ int16_t* buf, uint32_t blockLen)
{
    vector_int16_t v;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(v, buf + i);
        asc_abs(v, v, vmask);
        asc_store(buf + i, v, vmask);
    }
}

