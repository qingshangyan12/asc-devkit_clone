/* --------------------------------------------------------------------------
 * float 类型绝对值 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t ABS_FLOAT_VL = 64;
constexpr uint32_t ABS_FLOAT_TILE = ABS_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void abs_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();

    __ubuf__ float local[ABS_FLOAT_TILE];

    uint32_t blockLen = ABS_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

