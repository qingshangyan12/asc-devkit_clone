/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T>
std::vector<T> launch_abs(std::vector<T>& in,
    void (*kernel)(__gm__ T*, __gm__ T*), uint32_t numBlocks)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<numBlocks, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
bool verify_abs(std::vector<T>& out, std::vector<T>& in, const char* name)
{
    std::vector<T> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        T val = in[i];
        g[i] = (val < static_cast<T>(0)) ? static_cast<T>(-val) : val;
    }
    bool ok = std::equal(g.begin(), g.end(), out.begin());
    std::cout << "  [" << name << "] " << (ok ? "通过" : "失败") << std::endl;
    return ok;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_abs 寄存器级绝对值测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * ABS_INT8_TILE;
        std::vector<int8_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int8_t>((i % 2 == 0) ? (i % 127) : -(i % 127));
        auto out = launch_abs<int8_t>(in, abs_kernel_int8, NUM_BLOCKS);
        verify_abs(out, in, "int8_t");
    }
    {
        constexpr uint32_t N = NUM_BLOCKS * ABS_INT16_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>((i % 2 == 0) ? (i % 1000) : -(i % 1000));
        auto out = launch_abs<int16_t>(in, abs_kernel_int16, NUM_BLOCKS);
        verify_abs(out, in, "int16_t");
    }
    {
        constexpr uint32_t N = NUM_BLOCKS * ABS_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? static_cast<int32_t>(i * 100) : -static_cast<int32_t>(i * 100);
        auto out = launch_abs<int32_t>(in, abs_kernel_int32, NUM_BLOCKS);
        verify_abs(out, in, "int32_t");
    }
    {
        constexpr uint32_t N = NUM_BLOCKS * ABS_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<half>((i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f));
        auto out = launch_abs<half>(in, abs_kernel_half, NUM_BLOCKS);
        verify_abs(out, in, "half");
    }
    {
        constexpr uint32_t N = NUM_BLOCKS * ABS_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
        auto out = launch_abs<float>(in, abs_kernel_float, NUM_BLOCKS);
        verify_abs(out, in, "float");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_abs 示例测试结束。" << std::endl;
    return 0;
}
