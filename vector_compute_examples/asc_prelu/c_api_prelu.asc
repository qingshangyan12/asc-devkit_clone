/* !
 * \file c_api_prelu.asc
 * \brief asc_prelu 寄存器级 PReLU 激活函数示例
 *        dst = max(src0, 0) + slope * min(src0, 0)
 *        slope 通过 src1 传入 (每元素可不同)
 *
 * 覆盖数据类型: half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void PreluVF_half(__ubuf__ half* srcLocal, __ubuf__ half* slopeLocal,
                                      __ubuf__ half* dstLocal, uint32_t blockLen)
{
    vector_half vsrc, vslope, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_loadalign(vslope, slopeLocal + i * one_rep_size);
        asc_prelu(vdst, vsrc, vslope, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
    }
}

__simd_vf__ inline void PreluVF_float(__ubuf__ float* srcLocal, __ubuf__ float* slopeLocal,
                                       __ubuf__ float* dstLocal, uint32_t blockLen)
{
    vector_float vsrc, vslope, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_loadalign(vslope, slopeLocal + i * one_rep_size);
        asc_prelu(vdst, vsrc, vslope, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
    }
}

constexpr uint32_t PRELU_HALF_VL = 128;
constexpr uint32_t PRELU_HALF_TILE = PRELU_HALF_VL * 4;

__vector__ __global__ __aicore__ void prelu_kernel_half(
    __gm__ half* src, __gm__ half* slope, __gm__ half* dst)
{
    asc_init();
    uint32_t blockLen = PRELU_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ half* srcGm = src + get_block_idx() * blockLen;
    __gm__ half* slopeGm = slope + get_block_idx() * blockLen;
    __gm__ half* dstGm = dst + get_block_idx() * blockLen;
    __ubuf__ half srcLocal[PRELU_HALF_TILE];
    __ubuf__ half slopeLocal[PRELU_HALF_TILE];
    __ubuf__ half dstLocal[PRELU_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)srcGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)srcLocal, srcGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ half*)slopeLocal, slopeGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    PreluVF_half(srcLocal, slopeLocal, dstLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(dstGm, (__ubuf__ half*)dstLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

constexpr uint32_t PRELU_FLOAT_VL = 64;
constexpr uint32_t PRELU_FLOAT_TILE = PRELU_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void prelu_kernel_float(
    __gm__ float* src, __gm__ float* slope, __gm__ float* dst)
{
    asc_init();
    uint32_t blockLen = PRELU_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* srcGm = src + get_block_idx() * blockLen;
    __gm__ float* slopeGm = slope + get_block_idx() * blockLen;
    __gm__ float* dstGm = dst + get_block_idx() * blockLen;
    __ubuf__ float srcLocal[PRELU_FLOAT_TILE];
    __ubuf__ float slopeLocal[PRELU_FLOAT_TILE];
    __ubuf__ float dstLocal[PRELU_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)srcGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)srcLocal, srcGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ float*)slopeLocal, slopeGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    PreluVF_float(srcLocal, slopeLocal, dstLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(dstGm, (__ubuf__ float*)dstLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_prelu(std::vector<T>& src, std::vector<T>& slope, KernelFunc kernel)
{
    uint32_t N = src.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* slopeHost = reinterpret_cast<uint8_t*>(slope.data());
    uint8_t* dstHost = nullptr;
    T *srcD = nullptr, *slopeD = nullptr, *dstD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&dstHost, bytes);
    aclrtMalloc((void**)&srcD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&slopeD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)srcD, bytes, srcHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)slopeD, bytes, slopeHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(srcD, slopeD, dstD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstHost, bytes, (uint8_t*)dstD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> dst((T*)dstHost, (T*)(dstHost + bytes));
    aclrtFree(srcD); aclrtFree(slopeD); aclrtFree(dstD);
    aclrtFreeHost(dstHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return dst;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& src, const std::vector<T>& slope,
              const std::vector<T>& dst, const std::vector<T>& golden,
              const std::string& name)
{
    std::string fname = "prelu_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,src,slope,output,expected\n";
    for (size_t i = 0; i < src.size(); ++i) {
        f << i << ",";
        print_val(src[i], f);
        f << ",";
        print_val(slope[i], f);
        f << ",";
        print_val(dst[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
T host_prelu(T src_val, T slope_val)
{
    if constexpr (std::is_same_v<T, half>) {
        float fsrc = static_cast<float>(src_val);
        float fslope = static_cast<float>(slope_val);
        float r = (fsrc > 0.0f) ? fsrc : (fsrc * fslope);
        return static_cast<half>(r);
    } else {
        return (src_val > static_cast<T>(0)) ? src_val : static_cast<T>(src_val * slope_val);
    }
}

template<typename T>
bool verify_prelu(std::vector<T>& dst, std::vector<T>& src,
                  std::vector<T>& slope, const char* name)
{
    std::vector<T> g(src.size());
    for (size_t i = 0; i < src.size(); ++i) {
        g[i] = host_prelu(src[i], slope[i]);
    }
    print_tensor(src,   "Src    ");
    print_tensor(slope, "Slope  ");
    print_tensor(dst,   "Output ");
    print_tensor(g,     "Expected");
    save_csv(src, slope, dst, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < src.size(); ++i) {
        if constexpr (std::is_same_v<T, half>) {
            float diff = std::abs(static_cast<float>(dst[i]) - static_cast<float>(g[i]));
            if (diff > 1e-3f) {
                ok = false;
                errIdx.push_back(i);
            }
        } else {
            if (dst[i] != g[i]) {
                ok = false;
                errIdx.push_back(i);
            }
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size() << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] src=";
            print_val(src[idx], std::cout);
            std::cout << " slope=";
            print_val(slope[idx], std::cout);
            std::cout << " output=";
            print_val(dst[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr)
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_prelu 寄存器级 PReLU 测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "公式: prelu(x) = max(x,0) + slope * min(x,0)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * PRELU_HALF_TILE;
        std::vector<half> src(N), slope(N);
        for (uint32_t i = 0; i < N; ++i) {
            src[i] = static_cast<half>((i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f));
            slope[i] = static_cast<half>(0.25f + (i % 4) * 0.1f);
        }
        auto dst = launch_prelu<half>(src, slope, prelu_kernel_half);
        verify_prelu(dst, src, slope, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PRELU_FLOAT_TILE;
        std::vector<float> src(N), slope(N);
        for (uint32_t i = 0; i < N; ++i) {
            src[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
            slope[i] = 0.25f + (i % 4) * 0.1f;
        }
        auto dst = launch_prelu<float>(src, slope, prelu_kernel_float);
        verify_prelu(dst, src, slope, "float");
    }
    std::cout << std::endl;
    std::cout << "[完成] asc_prelu 示例测试结束。" << std::endl;
    return 0;
}
