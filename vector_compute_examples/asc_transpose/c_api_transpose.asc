/* !
 * \file c_api_transpose.asc
 * \brief asc_transpose UB级16x16矩阵转置示例
 *
 * 对16x16的二维矩阵进行行列转置。
 * 覆盖数据类型: int16_t, uint16_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

constexpr uint32_t MAT_SIZE = 16;
constexpr uint32_t MAT_ELEMS = MAT_SIZE * MAT_SIZE;
constexpr uint32_t MAT_TILE = MAT_ELEMS * 4;

/* --------------------------------------------------------------------------
 * int16_t 类型转置 Kernel
 * -------------------------------------------------------------------------- */

__vector__ __global__ __aicore__ void transpose_kernel_int16(
    __gm__ int16_t* src, __gm__ int16_t* dst)
{
    asc_init();
    uint32_t blockLen = MAT_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t numMats = blockLen / MAT_ELEMS;

    __gm__ int16_t* sGm = src + get_block_idx() * blockLen;
    __gm__ int16_t* dGm = dst + get_block_idx() * blockLen;

    __ubuf__ int16_t sLocal[MAT_TILE];
    __ubuf__ int16_t dLocal[MAT_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)sGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int16_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ int16_t*)sLocal, sGm, BLK_NUM, burstLength,
                         0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    for (uint32_t m = 0; m < numMats; ++m) {
        asc_transpose(dLocal + m * MAT_ELEMS, sLocal + m * MAT_ELEMS);
    }

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(dGm, (__ubuf__ int16_t*)dLocal, BLK_NUM, burstLength,
                         cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * uint16_t 类型转置 Kernel
 * -------------------------------------------------------------------------- */

__vector__ __global__ __aicore__ void transpose_kernel_uint16(
    __gm__ uint16_t* src, __gm__ uint16_t* dst)
{
    asc_init();
    uint32_t blockLen = MAT_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t numMats = blockLen / MAT_ELEMS;

    __gm__ uint16_t* sGm = src + get_block_idx() * blockLen;
    __gm__ uint16_t* dGm = dst + get_block_idx() * blockLen;

    __ubuf__ uint16_t sLocal[MAT_TILE];
    __ubuf__ uint16_t dLocal[MAT_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)sGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(uint16_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ uint16_t*)sLocal, sGm, BLK_NUM, burstLength,
                         0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    for (uint32_t m = 0; m < numMats; ++m) {
        asc_transpose(dLocal + m * MAT_ELEMS, sLocal + m * MAT_ELEMS);
    }

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(dGm, (__ubuf__ uint16_t*)dLocal, BLK_NUM, burstLength,
                         cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_transpose(std::vector<T>& src, KernelFunc kernel)
{
    uint32_t N = src.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* sHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dHost = nullptr;
    T *sD = nullptr, *dD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&dHost, bytes);
    aclrtMalloc((void**)&sD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)sD, bytes, sHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(sD, dD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dHost, bytes, (uint8_t*)dD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> d((T*)dHost, (T*)(dHost + bytes));
    aclrtFree(sD); aclrtFree(dD);
    aclrtFreeHost(dHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return d;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_tp(const std::vector<T>& src, const std::vector<T>& dst,
                 const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "transpose_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,src,output,expected\n";
    for (size_t i = 0; i < src.size(); ++i) {
        f << i << ",";
        print_val(src[i], f);
        f << ",";
        print_val(dst[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_mat(const std::vector<T>& t, const std::string& name, uint32_t matIdx, uint32_t numMats)
{
    std::cout << "  " << name << " mat[" << matIdx << "]: " << std::endl;
    uint32_t base = matIdx * MAT_ELEMS;
    for (uint32_t r = 0; r < MAT_SIZE; ++r) {
        std::cout << "    ";
        for (uint32_t c = 0; c < MAT_SIZE; ++c) {
            print_val(t[base + r * MAT_SIZE + c], std::cout);
            std::cout << "\t";
        }
        std::cout << std::endl;
    }
}

template<typename T>
bool verify_transpose(std::vector<T>& dst, std::vector<T>& src, const char* name)
{
    size_t N = src.size();
    uint32_t numMats = N / MAT_ELEMS;
    std::vector<T> g(N);

    for (uint32_t m = 0; m < numMats; ++m) {
        uint32_t base = m * MAT_ELEMS;
        for (uint32_t r = 0; r < MAT_SIZE; ++r) {
            for (uint32_t c = 0; c < MAT_SIZE; ++c) {
                g[base + c * MAT_SIZE + r] = src[base + r * MAT_SIZE + c];
            }
        }
    }

    print_mat(src, "Src    ", 0, numMats);
    print_mat(dst, "Output  ", 0, numMats);
    print_mat(g, "Expected", 0, numMats);

    save_csv_tp(src, dst, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < N; ++i) {
        if (dst[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            uint32_t m = idx / MAT_ELEMS;
            uint32_t off = idx % MAT_ELEMS;
            uint32_t r = off / MAT_SIZE;
            uint32_t c = off % MAT_SIZE;
            std::cout << "    mat[" << m << "](" << r << "," << c << ") output=";
            print_val(dst[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_transpose 16x16矩阵转置测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * MAT_TILE;
        std::vector<int16_t> src(N);
        for (uint32_t i = 0; i < N; ++i) {
            src[i] = static_cast<int16_t>(i % 1000);
        }
        auto dst = launch_transpose<int16_t>(src, transpose_kernel_int16);
        verify_transpose(dst, src, "int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MAT_TILE;
        std::vector<uint16_t> src(N);
        for (uint32_t i = 0; i < N; ++i) {
            src[i] = static_cast<uint16_t>(i % 2000);
        }
        auto dst = launch_transpose<uint16_t>(src, transpose_kernel_uint16);
        verify_transpose(dst, src, "uint16_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_transpose 示例测试结束。" << std::endl;
    return 0;
}
