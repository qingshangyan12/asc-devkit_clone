/* !
 * \file c_api_copy.asc
 * \brief asc_copy 寄存器级矢量拷贝示例
 *
 * 覆盖数据类型: half, float, int32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"

struct fp8_e4m3fn_t { unsigned char __val; };
struct fp8_e5m2_t { unsigned char __val; };
struct fp8_e8m0_t { unsigned char __val; };
struct fp4x2_e1m2_t { unsigned char __val; };
struct fp4x2_e2m1_t { unsigned char __val; };
struct int4b_t { unsigned char __val; };
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量拷贝函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void CopyVF_half(__ubuf__ half* xLocal, __ubuf__ half* zLocal,
                                     uint32_t blockLen)
{
    vector_half vx, vz;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_copy(vz, vx, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void CopyVF_float(__ubuf__ float* xLocal, __ubuf__ float* zLocal,
                                      uint32_t blockLen)
{
    vector_float vx, vz;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_copy(vz, vx, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void CopyVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* zLocal,
                                      uint32_t blockLen)
{
    vector_int32_t vx, vz;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_copy(vz, vx, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

/* --------------------------------------------------------------------------
 * half 类型拷贝 Kernel (VL=128)
 * -------------------------------------------------------------------------- */

constexpr uint32_t COPY_HALF_VL = 128;
constexpr uint32_t COPY_HALF_TILE = COPY_HALF_VL * 4;

__vector__ __global__ __aicore__ void copy_kernel_half(
    __gm__ half* x, __gm__ half* z)
{
    asc_init();

    uint32_t blockLen = COPY_HALF_TILE * NUM_BLOCKS / asc_get_block_num();

    __gm__ half* xGm = x + get_block_idx() * blockLen;
    __gm__ half* zGm = z + get_block_idx() * blockLen;

    __ubuf__ half xLocal[COPY_HALF_TILE];
    __ubuf__ half zLocal[COPY_HALF_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0;
    uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ half*)xLocal, xGm, BLK_NUM, burstLength,
                         0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    CopyVF_half(xLocal, zLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(zGm, (__ubuf__ half*)zLocal, BLK_NUM, burstLength,
                         cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * float 类型拷贝 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t COPY_FLOAT_VL = 64;
constexpr uint32_t COPY_FLOAT_TILE = COPY_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void copy_kernel_float(
    __gm__ float* x, __gm__ float* z)
{
    asc_init();

    uint32_t blockLen = COPY_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();

    __gm__ float* xGm = x + get_block_idx() * blockLen;
    __gm__ float* zGm = z + get_block_idx() * blockLen;

    __ubuf__ float xLocal[COPY_FLOAT_TILE];
    __ubuf__ float zLocal[COPY_FLOAT_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0;
    uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ float*)xLocal, xGm, BLK_NUM, burstLength,
                         0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    CopyVF_float(xLocal, zLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(zGm, (__ubuf__ float*)zLocal, BLK_NUM, burstLength,
                         cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * int32_t 类型拷贝 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t COPY_INT32_VL = 64;
constexpr uint32_t COPY_INT32_TILE = COPY_INT32_VL * 4;

__vector__ __global__ __aicore__ void copy_kernel_int32(
    __gm__ int32_t* x, __gm__ int32_t* z)
{
    asc_init();

    uint32_t blockLen = COPY_INT32_TILE * NUM_BLOCKS / asc_get_block_num();

    __gm__ int32_t* xGm = x + get_block_idx() * blockLen;
    __gm__ int32_t* zGm = z + get_block_idx() * blockLen;

    __ubuf__ int32_t xLocal[COPY_INT32_TILE];
    __ubuf__ int32_t zLocal[COPY_INT32_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0;
    uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ int32_t*)xLocal, xGm, BLK_NUM, burstLength,
                         0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    CopyVF_int32(xLocal, zLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(zGm, (__ubuf__ int32_t*)zLocal, BLK_NUM, burstLength,
                         cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_copy(std::vector<T>& x, KernelFunc kernel)
{
    uint32_t N = x.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* zHost = nullptr;
    T *xD = nullptr, *zD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&zHost, bytes);
    aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(xD, zD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + bytes));

    aclrtFree(xD); aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return z;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& x, const std::vector<T>& z,
              const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "copy_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,x,output,expected\n";
    for (size_t i = 0; i < x.size(); ++i) {
        f << i << ",";
        print_val(x[i], f);
        f << ",";
        print_val(z[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_copy(std::vector<T>& x, std::vector<T>& z, const char* name)
{
    std::vector<T> g(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        g[i] = x[i];
    }

    print_tensor(x, "Input   ");
    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");

    save_csv(x, z, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        if (z[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=";
            print_val(z[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_copy 寄存器级矢量拷贝测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * COPY_HALF_TILE;
        std::vector<half> x(N);
        for (uint32_t i = 0; i < N; ++i)
            x[i] = static_cast<half>(i * 0.5f);
        auto z = launch_copy<half>(x, copy_kernel_half);
        verify_copy(x, z, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * COPY_FLOAT_TILE;
        std::vector<float> x(N);
        for (uint32_t i = 0; i < N; ++i)
            x[i] = i * 0.5f;
        auto z = launch_copy<float>(x, copy_kernel_float);
        verify_copy(x, z, "float");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * COPY_INT32_TILE;
        std::vector<int32_t> x(N);
        for (uint32_t i = 0; i < N; ++i)
            x[i] = static_cast<int32_t>(i);
        auto z = launch_copy<int32_t>(x, copy_kernel_int32);
        verify_copy(x, z, "int32_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_copy 示例测试结束。" << std::endl;
    return 0;
}
