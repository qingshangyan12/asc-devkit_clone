/* !
 * \file c_api_relu.asc
 * \brief asc_relu 寄存器级 ReLU 激活函数示例
 *
 * 覆盖数据类型: half, float, int32_t
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级 ReLU 激活函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void ReluVF_half(__ubuf__ half* buf, uint32_t blockLen)
{
    vector_half v;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(v, buf + i);
        asc_relu(v, v, vmask);
        asc_store(buf + i, v, vmask);
    }
}

__simd_vf__ inline void ReluVF_float(__ubuf__ float* buf, uint32_t blockLen)
{
    vector_float v;
    vector_bool vmask;
    constexpr uint32_t VL = 64;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(v, buf + i);
        asc_relu(v, v, vmask);
        asc_store(buf + i, v, vmask);
    }
}

__simd_vf__ inline void ReluVF_int32(__ubuf__ int32_t* buf, uint32_t blockLen)
{
    vector_int32_t v;
    vector_bool vmask;
    constexpr uint32_t VL = 64;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(v, buf + i);
        asc_relu(v, v, vmask);
        asc_store(buf + i, v, vmask);
    }
}

/* --------------------------------------------------------------------------
 * half 类型 ReLU Kernel (单核, VL=128)
 * -------------------------------------------------------------------------- */

constexpr uint32_t RELU_HALF_VL = 128;
constexpr uint32_t RELU_HALF_TILE = RELU_HALF_VL * 8;

__vector__ __global__ __aicore__ void relu_kernel_half(
    __gm__ half* input, __gm__ half* output)
{
    asc_init();

    __ubuf__ half local[RELU_HALF_TILE];

    asc_copy_gm2ub_sync((__ubuf__ void*)local, (__gm__ void*)input,
                        RELU_HALF_TILE * sizeof(half));

    ReluVF_half(local, RELU_HALF_TILE);

    asc_copy_ub2gm_sync((__gm__ void*)output, (__ubuf__ void*)local,
                        RELU_HALF_TILE * sizeof(half));
}

/* --------------------------------------------------------------------------
 * float 类型 ReLU Kernel (单核, VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t RELU_FLOAT_VL = 64;
constexpr uint32_t RELU_FLOAT_TILE = RELU_FLOAT_VL * 8;

__vector__ __global__ __aicore__ void relu_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();

    __ubuf__ float local[RELU_FLOAT_TILE];

    asc_copy_gm2ub_sync((__ubuf__ void*)local, (__gm__ void*)input,
                        RELU_FLOAT_TILE * sizeof(float));

    ReluVF_float(local, RELU_FLOAT_TILE);

    asc_copy_ub2gm_sync((__gm__ void*)output, (__ubuf__ void*)local,
                        RELU_FLOAT_TILE * sizeof(float));
}

/* --------------------------------------------------------------------------
 * int32_t 类型 ReLU Kernel (单核, VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t RELU_INT32_VL = 64;
constexpr uint32_t RELU_INT32_TILE = RELU_INT32_VL * 8;

__vector__ __global__ __aicore__ void relu_kernel_int32(
    __gm__ int32_t* input, __gm__ int32_t* output)
{
    asc_init();

    __ubuf__ int32_t local[RELU_INT32_TILE];

    asc_copy_gm2ub_sync((__ubuf__ void*)local, (__gm__ void*)input,
                        RELU_INT32_TILE * sizeof(int32_t));

    ReluVF_int32(local, RELU_INT32_TILE);

    asc_copy_ub2gm_sync((__gm__ void*)output, (__ubuf__ void*)local,
                        RELU_INT32_TILE * sizeof(int32_t));
}

/* ==========================================================================
 * Host 侧函数
 * ========================================================================== */

template<typename T>
std::vector<T> launch_relu(std::vector<T>& input,
    void (*kernel)(__gm__ T*, __gm__ T*))
{
    uint32_t N = input.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(input.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(inD, outD);  // 单核 launch
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
T relu_golden(T val) { return val > T(0) ? val : T(0); }

template<typename T>
bool check(std::vector<T>& out, std::vector<T>& in, const char* name)
{
    std::vector<T> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) g[i] = relu_golden(in[i]);
    bool ok = std::equal(g.begin(), g.end(), out.begin());
    std::cout << "  [" << name << "] " << (ok ? "通过" : "失败") << std::endl;
    return ok;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_relu 寄存器级 ReLU 激活函数测试 ===" << std::endl;
    std::cout << "模式: 单核" << std::endl;
    std::cout << std::endl;

    // half 类型
    {
        constexpr uint32_t N = RELU_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<half>((i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f));
        auto out = launch_relu<half>(in, relu_kernel_half);
        check(out, in, "half");
    }

    // float 类型
    {
        constexpr uint32_t N = RELU_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
        auto out = launch_relu<float>(in, relu_kernel_float);
        check(out, in, "float");
    }

    // int32_t 类型
    {
        constexpr uint32_t N = RELU_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? static_cast<int32_t>(i) : -static_cast<int32_t>(i);
        auto out = launch_relu<int32_t>(in, relu_kernel_int32);
        check(out, in, "int32_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_relu 示例测试结束。" << std::endl;
    return 0;
}
