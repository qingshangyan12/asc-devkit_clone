/* !
 * \file c_api_reduce_max.asc
 * \brief asc_reduce_max 寄存器级矢量最大值归约示例
 *        使用单寄存器块归约 (TILE=VL), 每个block仅调用一次asc_reduce_max
 *
 * 覆盖数据类型: int16_t, int32_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void ReduceMaxVF_int16(__ubuf__ int16_t* xLocal, __ubuf__ int16_t* zLocal, uint32_t blockLen)
{
    vector_int16_t vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b16(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_max(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b16(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void ReduceMaxVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* zLocal, uint32_t blockLen)
{
    vector_int32_t vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b32(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_max(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b32(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void ReduceMaxVF_half(__ubuf__ half* xLocal, __ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b16(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_max(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b16(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void ReduceMaxVF_float(__ubuf__ float* xLocal, __ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b32(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_max(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b32(store_count);
    asc_storealign(zLocal, vz, vmask);
}

/* --------------------------------------------------------------------------
 * int16_t Kernel (VL=128, one_rep_size=16)
 * -------------------------------------------------------------------------- */
constexpr uint32_t REDUCE_MAX_INT16_VL = 128;
constexpr uint32_t REDUCE_MAX_INT16_TILE = 16;

__vector__ __global__ __aicore__ void reduce_max_kernel_int16(
    __gm__ int16_t* input, __gm__ int16_t* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_MAX_INT16_TILE;
    __gm__ int16_t* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ int16_t* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ int16_t local[REDUCE_MAX_INT16_TILE];
    __ubuf__ int16_t localOut[REDUCE_MAX_INT16_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int16_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int16_t*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceMaxVF_int16(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ int16_t*)localOut, BLK_NUM, blockLen * sizeof(int16_t), cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * int32_t Kernel (VL=64, one_rep_size=8)
 * -------------------------------------------------------------------------- */
constexpr uint32_t REDUCE_MAX_INT32_VL = 64;
constexpr uint32_t REDUCE_MAX_INT32_TILE = 8;

__vector__ __global__ __aicore__ void reduce_max_kernel_int32(
    __gm__ int32_t* input, __gm__ int32_t* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_MAX_INT32_TILE;
    __gm__ int32_t* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ int32_t* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ int32_t local[REDUCE_MAX_INT32_TILE];
    __ubuf__ int32_t localOut[REDUCE_MAX_INT32_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int32_t*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceMaxVF_int32(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ int32_t*)localOut, BLK_NUM, blockLen * sizeof(int32_t), cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * half Kernel (VL=128, one_rep_size=16)
 * -------------------------------------------------------------------------- */
constexpr uint32_t REDUCE_MAX_HALF_VL = 128;
constexpr uint32_t REDUCE_MAX_HALF_TILE = 16;

__vector__ __global__ __aicore__ void reduce_max_kernel_half(
    __gm__ half* input, __gm__ half* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_MAX_HALF_TILE;
    __gm__ half* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ half* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ half local[REDUCE_MAX_HALF_TILE];
    __ubuf__ half localOut[REDUCE_MAX_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceMaxVF_half(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ half*)localOut, BLK_NUM, blockLen * sizeof(half), cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * float Kernel (VL=64, one_rep_size=8)
 * -------------------------------------------------------------------------- */
constexpr uint32_t REDUCE_MAX_FLOAT_VL = 64;
constexpr uint32_t REDUCE_MAX_FLOAT_TILE = 8;

__vector__ __global__ __aicore__ void reduce_max_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_MAX_FLOAT_TILE;
    __gm__ float* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ float* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ float local[REDUCE_MAX_FLOAT_TILE];
    __ubuf__ float localOut[REDUCE_MAX_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceMaxVF_float(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ float*)localOut, BLK_NUM, blockLen * sizeof(float), cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_reduce_max(std::vector<T>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));
    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_reduce(const std::vector<T>& input, const std::vector<T>& output,
                     T golden_max, const std::string& name)
{
    std::string fname = "reduce_max_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    f << "0,max,";
    print_val(output[0], f);
    f << ",";
    print_val(golden_max, f);
    f << "\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << (i + 1) << ",";
        print_val(input[i], f);
        f << ",,\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
T host_max(const std::vector<T>& data)
{
    T m = data[0];
    for (size_t i = 1; i < data.size(); ++i) {
        if (data[i] > m) m = data[i];
    }
    return m;
}

template<typename T>
bool verify_reduce_max(std::vector<T>& out, std::vector<T>& in,
                       const char* name)
{
    T golden = host_max(in);
    print_tensor(in,  "Input   ");
    std::cout << "  Output[0]=";
    print_val(out[0], std::cout);
    std::cout << " Expected=";
    print_val(golden, std::cout);
    std::cout << std::endl;
    save_csv_reduce(in, out, golden, name);
    if (out[0] == golden) {
        std::cout << "  [" << name << "] 通过" << std::endl;
        return true;
    }
    std::cout << "  [" << name << "] 精度错误" << std::endl;
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_reduce_max 寄存器级最大值归约测试 (单寄存器块) ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_MAX_INT16_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            int16_t val = static_cast<int16_t>((i * 7 + 13) % 30000);
            in[i] = (i % 3 == 0) ? static_cast<int16_t>(-val) : val;
        }
        in[5] = 5000;
        auto out = launch_reduce_max<int16_t>(in, reduce_max_kernel_int16);
        verify_reduce_max(out, in, "int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_MAX_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            int32_t val = static_cast<int32_t>(i * 13 + 7);
            in[i] = (i % 3 == 0) ? -val : val;
        }
        in[3] = 50000;
        auto out = launch_reduce_max<int32_t>(in, reduce_max_kernel_int32);
        verify_reduce_max(out, in, "int32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_MAX_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            half val = static_cast<half>(i * 0.01f);
            in[i] = (i % 3 == 0) ? static_cast<half>(-static_cast<float>(val)) : val;
        }
        in[7] = static_cast<half>(100.0f);
        auto out = launch_reduce_max<half>(in, reduce_max_kernel_half);
        verify_reduce_max(out, in, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_MAX_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            float val = i * 0.01f;
            in[i] = (i % 3 == 0) ? -val : val;
        }
        in[3] = 100.0f;
        auto out = launch_reduce_max<float>(in, reduce_max_kernel_float);
        verify_reduce_max(out, in, "float");
    }
    std::cout << std::endl;
    std::cout << "[完成] asc_reduce_max 示例测试结束。" << std::endl;
    return 0;
}
