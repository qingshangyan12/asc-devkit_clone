/* !
 * \file c_api_duplicate_scalar.asc
 * \brief asc_duplicate_scalar 寄存器级矢量标量复制填充示例
 *
 * 将标量值复制填充到整个矢量寄存器
 * 覆盖数据类型: half, float, int32_t, int16_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
struct fp8_e4m3fn_t { unsigned char __val; };
struct fp8_e5m2_t { unsigned char __val; };
struct fp8_e8m0_t { unsigned char __val; };
struct fp4x2_e1m2_t { unsigned char __val; };
struct fp4x2_e2m1_t { unsigned char __val; };
struct int4b_t { unsigned char __val; };
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void DupScalarVF_half(__ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vz;
    vector_bool vmask;
    half scalar = half(3.14f);
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_duplicate_scalar(vz, scalar, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void DupScalarVF_float(__ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vz;
    vector_bool vmask;
    float scalar = 3.14f;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_duplicate_scalar(vz, scalar, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void DupScalarVF_int32(__ubuf__ int32_t* zLocal, uint32_t blockLen)
{
    vector_int32_t vz;
    vector_bool vmask;
    int32_t scalar = int32_t(42);
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_duplicate_scalar(vz, scalar, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
