/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_dups(uint32_t N, KernelFunc kernel)
{
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* zHost = nullptr;
    T* zD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&zHost, bytes);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(zD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + bytes));

    aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return z;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_dups(const std::vector<T>& z, const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "duplicate_scalar_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,output,expected\n";
    for (size_t i = 0; i < z.size(); ++i) {
        f << i << ",";
        print_val(z[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T, typename S>
bool verify_dups(std::vector<T>& z, S scalar, const char* name)
{
    std::vector<T> g(z.size());
    for (size_t i = 0; i < z.size(); ++i) {
        g[i] = static_cast<T>(scalar);
    }

    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");

    save_csv_dups(z, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < z.size(); ++i) {
        if (z[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=";
            print_val(z[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_duplicate_scalar 寄存器级标量填充测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "操作: z = duplicate_scalar(scalar), 所有元素填充标量值" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * DUPS_HALF_TILE;
        auto z = launch_dups<half>(N, dups_kernel_half);
        verify_dups(z, half(3.14f), "half (scalar=3.14)");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * DUPS_FLOAT_TILE;
        auto z = launch_dups<float>(N, dups_kernel_float);
        verify_dups(z, 3.14f, "float (scalar=3.14)");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * DUPS_INT32_TILE;
        auto z = launch_dups<int32_t>(N, dups_kernel_int32);
        verify_dups(z, int32_t(42), "int32_t (scalar=42)");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * DUPS_INT16_TILE;
        auto z = launch_dups<int16_t>(N, dups_kernel_int16);
        verify_dups(z, int16_t(123), "int16_t (scalar=123)");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_duplicate_scalar 示例测试结束。" << std::endl;
    return 0;
}
