/* !
 * \file c_api_squeeze.asc
 * \brief asc_squeeze 寄存器级矢量压缩（按掩码筛选）示例
 *
 * asc_squeeze 根据 bool 掩码从输入矢量中压缩元素
 * 掩码为 1 的元素保持原位，掩码为 0 的元素被跳过
 * 压缩后元素填充到 dst 前段，后段保持不变
 *
 * 覆盖数据类型: int8_t, int16_t, int32_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量 squeeze 函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void SqueezeVF_int8(__ubuf__ int8_t* srcLocal,
                                        __ubuf__ int8_t* dstLocal,
                                        uint32_t blockLen, uint8_t maskByte)
{
    vector_int8_t vsrc, vdst;
    vector_bool vmask, vdataMask;
    uint16_t one_rep_size = 256 / sizeof(int8_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    // Build data mask: repeat maskByte 32 times to fill 256-bit vector_bool
    uint32_t maskWord = maskByte | (maskByte << 8) | (maskByte << 16) | (maskByte << 24);

    for (uint16_t i = 0; i < rep; ++i) {
        vdataMask = asc_update_mask_b8(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        // Use vand with mask to create squeeze mask from data mask
        asc_squeeze(vdst, vsrc, vdataMask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vdataMask);
    }
}

__simd_vf__ inline void SqueezeVF_int16(__ubuf__ int16_t* srcLocal,
                                         __ubuf__ int16_t* dstLocal,
                                         uint32_t blockLen, uint16_t maskPattern)
{
    vector_int16_t vsrc, vdst;
    vector_bool vdataMask;
    uint16_t one_rep_size = 256 / sizeof(int16_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vdataMask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vdst, vsrc, vdataMask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vdataMask);
    }
}

