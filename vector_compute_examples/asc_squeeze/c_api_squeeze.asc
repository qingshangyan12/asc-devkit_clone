                                         __ubuf__ int32_t* dstLocal,
                                         uint32_t blockLen)
{
    vector_int32_t vsrc, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vdst, vsrc, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
    }
}

__simd_vf__ inline void SqueezeVF_half(__ubuf__ half* srcLocal,
                                        __ubuf__ half* dstLocal,
                                        uint32_t blockLen)
{
    vector_half vsrc, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vdst, vsrc, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
    }
}

__simd_vf__ inline void SqueezeVF_float(__ubuf__ float* srcLocal,
                                         __ubuf__ float* dstLocal,
                                         uint32_t blockLen)
{
    vector_float vsrc, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vdst, vsrc, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
    }
}

/* --------------------------------------------------------------------------
 * int8_t squeeze Kernel (VL=256)
 * -------------------------------------------------------------------------- */
constexpr uint32_t SQZ_INT8_VL = 256 / sizeof(int8_t);
constexpr uint32_t SQZ_INT8_TILE = SQZ_INT8_VL * 4;

__vector__ __global__ __aicore__ void squeeze_kernel_int8(
    __gm__ int8_t* input, __gm__ int8_t* output)
{
    asc_init();
    uint32_t blockLen = SQZ_INT8_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int8_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ int8_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int8_t srcLocal[SQZ_INT8_TILE];
    __ubuf__ int8_t dstLocal[SQZ_INT8_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int8_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ int8_t*)srcLocal, inGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    SqueezeVF_int8(srcLocal, dstLocal, blockLen, 0x55);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ int8_t*)dstLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
}

