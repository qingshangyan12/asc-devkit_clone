/* --------------------------------------------------------------------------
 * float squeeze Kernel (VL=64)
 * -------------------------------------------------------------------------- */
constexpr uint32_t SQZ_FLOAT_VL = 256 / sizeof(float);
constexpr uint32_t SQZ_FLOAT_TILE = SQZ_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void squeeze_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();
    uint32_t blockLen = SQZ_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* inGm  = input  + get_block_idx() * blockLen;
    __gm__ float* outGm = output + get_block_idx() * blockLen;
    __ubuf__ float srcLocal[SQZ_FLOAT_TILE];
    __ubuf__ float dstLocal[SQZ_FLOAT_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ float*)srcLocal, inGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    SqueezeVF_float(srcLocal, dstLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ float*)dstLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_squeeze(std::vector<T>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& input, const std::vector<T>& output,
              const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "squeeze_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_squeeze(std::vector<T>& out, std::vector<T>& in, const char* name)
{
    // For squeeze with full mask, output equals input
    std::vector<T> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = in[i];
    }

    print_tensor(in,  "Input   ");
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");

    save_csv(in, out, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] input=";
            print_val(in[idx], std::cout);
            std::cout << " output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_squeeze 寄存器级矢量压缩测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "说明: squeeze 根据更新掩码压缩矢量元素" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * SQZ_INT8_TILE;
        std::vector<int8_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int8_t>((i % 2 == 0) ? (i % 127) : -(i % 127));
        auto out = launch_squeeze<int8_t>(in, squeeze_kernel_int8);
        verify_squeeze(out, in, "int8_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SQZ_INT16_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>((i % 2 == 0) ? (i % 1000) : -(i % 1000));
        auto out = launch_squeeze<int16_t>(in, squeeze_kernel_int16);
        verify_squeeze(out, in, "int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SQZ_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? static_cast<int32_t>(i * 10) : -static_cast<int32_t>(i * 10);
        auto out = launch_squeeze<int32_t>(in, squeeze_kernel_int32);
        verify_squeeze(out, in, "int32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SQZ_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<half>((i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f));
        auto out = launch_squeeze<half>(in, squeeze_kernel_half);
        verify_squeeze(out, in, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SQZ_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
        auto out = launch_squeeze<float>(in, squeeze_kernel_float);
        verify_squeeze(out, in, "float");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_squeeze 示例测试结束。" << std::endl;
    return 0;
}
