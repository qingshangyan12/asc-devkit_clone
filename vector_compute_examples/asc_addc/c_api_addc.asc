/* !
 * \file c_api_addc.asc
 * \brief asc_addc 寄存器级矢量带进位加法示例
 *
 * 计算: {carry_out, sum} = src0 + src1 + carry_in
 * 覆盖数据类型: uint32_t, int32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void AddcVF_uint32(__ubuf__ uint32_t* xLocal, __ubuf__ uint32_t* yLocal,
                                       __ubuf__ uint32_t* cInLocal, __ubuf__ uint32_t* sumLocal,
                                       __ubuf__ uint32_t* cOutLocal, __ubuf__ uint32_t* oneUb,
                                       __ubuf__ uint32_t* zeroUb, uint32_t blockLen)
{
    vector_uint32_t vx, vy, vsum, vcarry_val, vone, vzero;
    vector_bool vcarry_in_bool, vcarry_out_bool, vmask;
    uint16_t one_rep_size = 256 / sizeof(uint32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    asc_loadalign(vone, oneUb);
    asc_loadalign(vzero, zeroUb);

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_loadalign(vcarry_val, cInLocal + i * one_rep_size);

        asc_ne_scalar(vcarry_in_bool, vcarry_val, (uint32_t)0, vmask);

        asc_addc(vcarry_out_bool, vsum, vx, vy, vcarry_in_bool, vmask);

        asc_select(vcarry_val, vone, vzero, vcarry_out_bool);

        asc_storealign(sumLocal + i * one_rep_size, vsum, vmask);
        asc_storealign(cOutLocal + i * one_rep_size, vcarry_val, vmask);
    }
}

__simd_vf__ inline void AddcVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* yLocal,
                                      __ubuf__ int32_t* cInLocal, __ubuf__ int32_t* sumLocal,
                                      __ubuf__ int32_t* cOutLocal, __ubuf__ int32_t* oneUb,
                                      __ubuf__ int32_t* zeroUb, uint32_t blockLen)
{
    vector_int32_t vx, vy, vsum, vcarry_val, vone, vzero;
    vector_bool vcarry_in_bool, vcarry_out_bool, vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    asc_loadalign(vone, oneUb);
    asc_loadalign(vzero, zeroUb);

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_loadalign(vcarry_val, cInLocal + i * one_rep_size);

        asc_ne_scalar(vcarry_in_bool, vcarry_val, (int32_t)0, vmask);

        asc_addc(vcarry_out_bool, vsum, vx, vy, vcarry_in_bool, vmask);

        asc_select(vcarry_val, vone, vzero, vcarry_out_bool);

        asc_storealign(sumLocal + i * one_rep_size, vsum, vmask);
        asc_storealign(cOutLocal + i * one_rep_size, vcarry_val, vmask);
    }
}

constexpr uint32_t ADDC_UINT32_VL = 64;
constexpr uint32_t ADDC_UINT32_TILE = ADDC_UINT32_VL * 4;
constexpr uint32_t ADDC_UINT32_REGSIZE = 256 / sizeof(uint32_t);

__vector__ __global__ __aicore__ void addc_kernel_uint32(
    __gm__ uint32_t* x, __gm__ uint32_t* y, __gm__ uint32_t* carryIn,
    __gm__ uint32_t* sumOut, __gm__ uint32_t* carryOut)
{
    asc_init();
    uint32_t blockLen = ADDC_UINT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ uint32_t* xGm = x + get_block_idx() * blockLen;
    __gm__ uint32_t* yGm = y + get_block_idx() * blockLen;
    __gm__ uint32_t* ciGm = carryIn + get_block_idx() * blockLen;
    __gm__ uint32_t* sGm = sumOut + get_block_idx() * blockLen;
    __gm__ uint32_t* coGm = carryOut + get_block_idx() * blockLen;
    __ubuf__ uint32_t xLocal[ADDC_UINT32_TILE];
    __ubuf__ uint32_t yLocal[ADDC_UINT32_TILE];
    __ubuf__ uint32_t ciLocal[ADDC_UINT32_TILE];
    __ubuf__ uint32_t sLocal[ADDC_UINT32_TILE];
    __ubuf__ uint32_t coLocal[ADDC_UINT32_TILE];
    __ubuf__ uint32_t oneUb[ADDC_UINT32_REGSIZE];
    __ubuf__ uint32_t zeroUb[ADDC_UINT32_REGSIZE];
    for (uint32_t i = 0; i < ADDC_UINT32_REGSIZE; ++i) {
        oneUb[i] = 1;
        zeroUb[i] = 0;
    }
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(uint32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)ciLocal, ciGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    AddcVF_uint32(xLocal, yLocal, ciLocal, sLocal, coLocal, oneUb, zeroUb, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(sGm, (__ubuf__ uint32_t*)sLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
    asc_copy_ub2gm_align(coGm, (__ubuf__ uint32_t*)coLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

constexpr uint32_t ADDC_INT32_VL = 64;
constexpr uint32_t ADDC_INT32_TILE = ADDC_INT32_VL * 4;
constexpr uint32_t ADDC_INT32_REGSIZE = 256 / sizeof(int32_t);

__vector__ __global__ __aicore__ void addc_kernel_int32(
    __gm__ int32_t* x, __gm__ int32_t* y, __gm__ int32_t* carryIn,
    __gm__ int32_t* sumOut, __gm__ int32_t* carryOut)
{
    asc_init();
    uint32_t blockLen = ADDC_INT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* xGm = x + get_block_idx() * blockLen;
    __gm__ int32_t* yGm = y + get_block_idx() * blockLen;
    __gm__ int32_t* ciGm = carryIn + get_block_idx() * blockLen;
    __gm__ int32_t* sGm = sumOut + get_block_idx() * blockLen;
    __gm__ int32_t* coGm = carryOut + get_block_idx() * blockLen;
    __ubuf__ int32_t xLocal[ADDC_INT32_TILE];
    __ubuf__ int32_t yLocal[ADDC_INT32_TILE];
    __ubuf__ int32_t ciLocal[ADDC_INT32_TILE];
    __ubuf__ int32_t sLocal[ADDC_INT32_TILE];
    __ubuf__ int32_t coLocal[ADDC_INT32_TILE];
    __ubuf__ int32_t oneUb[ADDC_INT32_REGSIZE];
    __ubuf__ int32_t zeroUb[ADDC_INT32_REGSIZE];
    for (uint32_t i = 0; i < ADDC_INT32_REGSIZE; ++i) {
        oneUb[i] = 1;
        zeroUb[i] = 0;
    }
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int32_t*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)ciLocal, ciGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    AddcVF_int32(xLocal, yLocal, ciLocal, sLocal, coLocal, oneUb, zeroUb, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(sGm, (__ubuf__ int32_t*)sLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
    asc_copy_ub2gm_align(coGm, (__ubuf__ int32_t*)coLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::pair<std::vector<T>, std::vector<T>> launch_addc(
    std::vector<T>& x, std::vector<T>& y, std::vector<T>& carryIn, KernelFunc kernel)
{
    uint32_t N = x.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* ciHost = reinterpret_cast<uint8_t*>(carryIn.data());
    uint8_t* sHost = nullptr;
    uint8_t* coHost = nullptr;
    T *xD = nullptr, *yD = nullptr, *ciD = nullptr, *sD = nullptr, *coD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&sHost, bytes);
    aclrtMallocHost((void**)&coHost, bytes);
    aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&ciD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&sD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&coD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)yD, bytes, yHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)ciD, bytes, ciHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(xD, yD, ciD, sD, coD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(sHost, bytes, (uint8_t*)sD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(coHost, bytes, (uint8_t*)coD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> sumOut((T*)sHost, (T*)(sHost + bytes));
    std::vector<T> carryOut((T*)coHost, (T*)(coHost + bytes));

    aclrtFree(xD); aclrtFree(yD); aclrtFree(ciD); aclrtFree(sD); aclrtFree(coD);
    aclrtFreeHost(sHost); aclrtFreeHost(coHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return {sumOut, carryOut};
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_addc(const std::vector<T>& x, const std::vector<T>& y,
                   const std::vector<T>& cIn, const std::vector<T>& sumOut,
                   const std::vector<T>& cOut, const std::vector<T>& gSum,
                   const std::vector<T>& gCout, const std::string& name)
{
    std::string fname = "addc_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,x,y,carry_in,sum_out,sum_expected,carry_out,carry_expected\n";
    for (size_t i = 0; i < x.size(); ++i) {
        f << i << ",";
        print_val(x[i], f); f << ",";
        print_val(y[i], f); f << ",";
        print_val(cIn[i], f); f << ",";
        print_val(sumOut[i], f); f << ",";
        print_val(gSum[i], f); f << ",";
        print_val(cOut[i], f); f << ",";
        print_val(gCout[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_addc(std::vector<T>& x, std::vector<T>& y,
                 std::vector<T>& cIn, std::vector<T>& sumOut,
                 std::vector<T>& cOut, const char* name)
{
    std::vector<T> gSum(x.size()), gCout(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        uint64_t sum64 = (uint64_t)x[i] + (uint64_t)y[i] + (uint64_t)(cIn[i] ? 1 : 0);
        gSum[i] = (T)(sum64 & 0xFFFFFFFFull);
        gCout[i] = (T)((sum64 >> 32) & 1);
    }

    print_tensor(x, "X       ");
    print_tensor(y, "Y       ");
    print_tensor(cIn, "CarryIn ");
    print_tensor(sumOut, "SumOut  ");
    print_tensor(gSum, "SumExp  ");
    print_tensor(cOut, "CoutOut ");
    print_tensor(gCout, "CoutExp ");

    save_csv_addc(x, y, cIn, sumOut, cOut, gSum, gCout, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        if (sumOut[i] != gSum[i] || cOut[i] != gCout[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] x=";
            print_val(x[idx], std::cout);
            std::cout << " y=";
            print_val(y[idx], std::cout);
            std::cout << " cin=";
            print_val(cIn[idx], std::cout);
            std::cout << " sum=";
            print_val(sumOut[idx], std::cout);
            std::cout << " sumExp=";
            print_val(gSum[idx], std::cout);
            std::cout << " cout=";
            print_val(cOut[idx], std::cout);
            std::cout << " coutExp=";
            print_val(gCout[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_addc 寄存器级带进位加法测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * ADDC_UINT32_TILE;
        std::vector<uint32_t> x(N), y(N), cIn(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<uint32_t>(0xFFFF0000u + i);
            y[i] = static_cast<uint32_t>(0x0000FFFFu + i * 2);
            cIn[i] = (i % 3 == 0) ? 1u : 0u;
        }
        auto [sumOut, cOut] = launch_addc<uint32_t>(x, y, cIn, addc_kernel_uint32);
        verify_addc(x, y, cIn, sumOut, cOut, "uint32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ADDC_INT32_TILE;
        std::vector<int32_t> x(N), y(N), cIn(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<int32_t>(1000000000 + static_cast<int32_t>(i));
            y[i] = static_cast<int32_t>(1000000000 + static_cast<int32_t>(i * 2));
            cIn[i] = (i % 5 == 0) ? 1 : 0;
        }
        auto [sumOut, cOut] = launch_addc<int32_t>(x, y, cIn, addc_kernel_int32);
        verify_addc(x, y, cIn, sumOut, cOut, "int32_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_addc 示例测试结束。" << std::endl;
    return 0;
}
