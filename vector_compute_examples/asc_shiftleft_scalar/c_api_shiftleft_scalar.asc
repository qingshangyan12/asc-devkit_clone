/* !
 * \file c_api_shiftleft_scalar.asc
 * \brief asc_shiftleft_scalar 寄存器级矢量按标量左移示例
 *
 * 计算: z[i] = x[i] << shiftAmount
 * 覆盖数据类型: int8_t, int16_t, int32_t, uint32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void ShlScalarVF_int8(__ubuf__ int8_t* xLocal, __ubuf__ int8_t* zLocal,
                                          uint32_t blockLen)
{
    vector_int8_t vx, vz;
    vector_bool vmask;
    int16_t shiftAmount = 2;
    uint16_t one_rep_size = 256 / sizeof(int8_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b8(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_shiftleft_scalar(vz, vx, shiftAmount, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void ShlScalarVF_int16(__ubuf__ int16_t* xLocal, __ubuf__ int16_t* zLocal,
                                           uint32_t blockLen)
{
    vector_int16_t vx, vz;
    vector_bool vmask;
    int16_t shiftAmount = 3;
    uint16_t one_rep_size = 256 / sizeof(int16_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_shiftleft_scalar(vz, vx, shiftAmount, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

