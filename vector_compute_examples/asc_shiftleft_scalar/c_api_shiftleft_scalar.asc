}

constexpr uint32_t SHLS_UINT32_VL = 64;
constexpr uint32_t SHLS_UINT32_TILE = SHLS_UINT32_VL * 4;

__vector__ __global__ __aicore__ void shl_scalar_kernel_uint32(__gm__ uint32_t* x, __gm__ uint32_t* z)
{
    asc_init();
    uint32_t blockLen = SHLS_UINT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ uint32_t* xGm = x + get_block_idx() * blockLen;
    __gm__ uint32_t* zGm = z + get_block_idx() * blockLen;
    __ubuf__ uint32_t xLocal[SHLS_UINT32_TILE];
    __ubuf__ uint32_t zLocal[SHLS_UINT32_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(uint32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ShlScalarVF_uint32(xLocal, zLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ uint32_t*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_shiftleft_scalar(std::vector<T>& x, KernelFunc kernel)
{
    uint32_t N = x.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* zHost = nullptr;
    T *xD = nullptr, *zD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&zHost, bytes);
    aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(xD, zD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + bytes));

    aclrtFree(xD); aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return z;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_shls(const std::vector<T>& x, const std::vector<T>& z,
                   const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "shiftleft_scalar_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,x,output,expected\n";
    for (size_t i = 0; i < x.size(); ++i) {
        f << i << ",";
        print_val(x[i], f);
        f << ",";
        print_val(z[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_shiftleft_scalar(std::vector<T>& z, std::vector<T>& x,
                              int16_t shiftAmount, const char* name)
{
    std::vector<T> g(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        g[i] = static_cast<T>(x[i] << shiftAmount);
    }

    print_tensor(x, "X       ");
    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");

    save_csv_shls(x, z, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        if (z[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] x=";
            print_val(x[idx], std::cout);
            std::cout << " shift=" << shiftAmount;
            std::cout << " output=";
            print_val(z[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_shiftleft_scalar 寄存器级矢量标量左移测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "操作: z[i] = x[i] << shiftAmount" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * SHLS_INT8_TILE;
        std::vector<int8_t> x(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<int8_t>((i % 16) + 1);
        }
        auto z = launch_shiftleft_scalar<int8_t>(x, shl_scalar_kernel_int8);
        verify_shiftleft_scalar(z, x, 2, "int8_t (shift=2)");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SHLS_INT16_TILE;
        std::vector<int16_t> x(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<int16_t>((i % 256) + 1);
        }
        auto z = launch_shiftleft_scalar<int16_t>(x, shl_scalar_kernel_int16);
        verify_shiftleft_scalar(z, x, 3, "int16_t (shift=3)");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SHLS_INT32_TILE;
        std::vector<int32_t> x(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<int32_t>((i % 1024) + 1);
        }
        auto z = launch_shiftleft_scalar<int32_t>(x, shl_scalar_kernel_int32);
        verify_shiftleft_scalar(z, x, 5, "int32_t (shift=5)");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * SHLS_UINT32_TILE;
        std::vector<uint32_t> x(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<uint32_t>((i % 1024) + 1);
        }
        auto z = launch_shiftleft_scalar<uint32_t>(x, shl_scalar_kernel_uint32);
        verify_shiftleft_scalar(z, x, 4, "uint32_t (shift=4)");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_shiftleft_scalar 示例测试结束。" << std::endl;
    return 0;
}
