/* !
 * \file c_api_e4m32float.asc
 * \brief asc_e4m32float 寄存器级 fp8_e4m3 → float 类型转换示例
 *
 * 由于 fp8_e4m3fn_t 类型在 Host 侧 C++ 中未定义，本示例演示以下关键技巧：
 *   1. Host 侧: 将 float 数据手动编码为 fp8_e4m3 格式的字节
 *   2. 通过原始字节搬运的方式将 fp8 数据传递到 Device 侧
 *   3. Device 侧: 使用 asc_e4m32float 将 fp8 解码回 float
 *   4. Host 侧: 验证转换精度
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

/* ==========================================================================
 * Host 侧 fp8_e4m3 格式编解码
 *
 * E4M3 格式: 1 sign | 4 exponent (bias=7) | 3 mantissa
 * 可表达范围: ±448, 最小 normal: ±2^-6
 *
 * 注意: 此编解码为软件实现，用于在 Host 侧生成和验证 fp8 数据。
 *       Device 侧使用硬件指令进行转换，精度可能存在微小差异。
 * ========================================================================== */

static uint8_t float_to_fp8_e4m3(float val)
{
    if (std::isnan(val)) return 0x7F;
    if (val == 0.0f) return 0x00;

    uint32_t bits;
    std::memcpy(&bits, &val, sizeof(bits));
    uint8_t sign = (bits >> 31) & 1;
    int32_t exp  = ((bits >> 23) & 0xFF) - 127;
    uint32_t mant = bits & 0x7FFFFF;

    if (exp == 128) return sign ? 0xFF : 0x7F; // inf

    exp += 7; // e4m3 bias

    if (exp <= 0) {
        // subnormal: flush to sign-magnitude zero
        return (sign << 7);
    }
    if (exp >= 15) {
        // overflow: saturate to max
        return (sign << 7) | 0x7E;
    }

    uint8_t m = (mant >> 20) & 0x7;
    // round to nearest even
    uint32_t remainder = mant & 0xFFFFF;
    if (remainder > 0x80000 || (remainder == 0x80000 && (m & 1))) {
        m++;
        if (m > 7) { m = 0; exp++; if (exp >= 15) return (sign << 7) | 0x7E; }
    }

    return (sign << 7) | ((exp & 0xF) << 3) | m;
}

static float fp8_e4m3_to_float(uint8_t fp8)
{
    if (fp8 == 0) return 0.0f;

    uint8_t sign = (fp8 >> 7) & 1;
    int32_t exp  = (fp8 >> 3) & 0xF;
    uint32_t mant = fp8 & 0x7;

    // NaN/inf handling for e4m3
    if (exp == 15) {
        if (mant == 7) return sign ? -INFINITY : INFINITY;
        return NAN; // mant != 7 is NaN in e4m3
    }

    if (exp == 0) {
        // subnormal: treat as 0 for simplicity
        exp = mant ? -6 : -7;
        mant = mant;
    } else {
        // normal
        exp -= 7;
    }

    uint32_t fbits = (sign << 31) | ((exp + 127) << 23) | (mant << 20);
    float result;
    std::memcpy(&result, &fbits, sizeof(result));
    return result;
}

/* ==========================================================================
 * fp8_e5m2 格式编解码（额外支持）
 *
 * E5M2 格式: 1 sign | 5 exponent (bias=15) | 2 mantissa
 * ========================================================================== */

static uint8_t float_to_fp8_e5m2(float val)
{
    if (std::isnan(val)) return 0x7F;
    if (val == 0.0f) return 0x00;

    uint32_t bits;
    std::memcpy(&bits, &val, sizeof(bits));
    uint8_t sign = (bits >> 31) & 1;
    int32_t exp  = ((bits >> 23) & 0xFF) - 127;
    uint32_t mant = bits & 0x7FFFFF;

    if (exp == 128) return sign ? 0xFF : 0x7F;

    exp += 15; // e5m2 bias
    if (exp <= 0) return (sign << 7);
    if (exp >= 31) return (sign << 7) | 0x7B; // max normal

    uint8_t m = (mant >> 21) & 0x3;
    uint32_t remainder = mant & 0x1FFFFF;
    if (remainder > 0x100000 || (remainder == 0x100000 && (m & 1))) {
        m++; if (m > 3) { m = 0; exp++; }
    }
    if (exp >= 31) return (sign << 7) | 0x7B;

    return (sign << 7) | ((exp & 0x1F) << 2) | m;
}

static float fp8_e5m2_to_float(uint8_t fp8)
{
    if (fp8 == 0) return 0.0f;

    uint8_t sign = (fp8 >> 7) & 1;
    int32_t exp  = (fp8 >> 2) & 0x1F;
    uint32_t mant = fp8 & 0x3;

    if (exp == 31) {
        return sign ? -INFINITY : (mant ? NAN : INFINITY);
    }
    if (exp == 0) {
        exp = -14;
    } else {
        exp -= 15;
    }

    uint32_t fbits = (sign << 31) | ((exp + 127) << 23) | (mant << 21);
    float result;
    std::memcpy(&result, &fbits, sizeof(result));
    return result;
}

/* ==========================================================================
 * fp8_e4m3fn_t Kernel: fp8 → float 解码
 *
 * VL: fp8_e4m3fn_t 一个寄存器可容纳 256 字节 / 1 byte = 256 个 fp8 元素
 * Decode 后 float 元素数量相同但 sizeof(float)=4B，因此需要 4 倍的输出空间
 * ========================================================================== */

constexpr uint32_t FP8_VL = 256;
constexpr uint32_t FP8_TILE = FP8_VL * 4;

__simd_vf__ inline void E4m3ToFloatVF(__ubuf__ fp8_e4m3fn_t* ubFp8,
                                       __ubuf__ float* ubFloat, uint32_t blockLen)
{
    vector_fp8_e4m3fn_t vFp8;
    vector_float vFloat;
    vector_bool vmask;
    constexpr uint32_t VL = 256;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vFp8, ubFp8 + i);
        asc_e4m32float(vFloat, vFp8, vmask);
        asc_store(ubFloat + i, vFloat, vmask);
    }
}

__vector__ __global__ __aicore__ void e4m3_to_float_kernel(
    __gm__ fp8_e4m3fn_t* input, __gm__ float* output)
{
    asc_init();

    __ubuf__ fp8_e4m3fn_t ubFp8[FP8_TILE];
    __ubuf__ float ubFloat[FP8_TILE];

    asc_copy_gm2ub_sync((__ubuf__ void*)ubFp8, (__gm__ void*)input,
                        FP8_TILE * sizeof(fp8_e4m3fn_t));

    E4m3ToFloatVF(ubFp8, ubFloat, FP8_TILE);

    asc_copy_ub2gm_sync((__gm__ void*)output, (__ubuf__ void*)ubFloat,
                        FP8_TILE * sizeof(float));
}

/* ==========================================================================
 * Host 侧启动与测试
 * ========================================================================== */

bool test_e4m3_to_float()
{
    constexpr uint32_t N = FP8_TILE;

    // 1. Host 侧: 生成 float 输入并编码为 fp8 字节
    std::vector<float> floatInput(N);
    std::vector<fp8_e4m3fn_t> fp8Input(N);
    for (uint32_t i = 0; i < N; ++i) {
        floatInput[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
        fp8Input[i] = float_to_fp8_e4m3(floatInput[i]);
    }

    // 2. 将 fp8 字节数据搬运到 Device
    size_t fp8Bytes = N * sizeof(fp8_e4m3fn_t);
    size_t floatBytes = N * sizeof(float);

    int32_t devId = 0;
    aclrtStream stream = nullptr;
    fp8_e4m3fn_t* fp8D = nullptr;
    float* outD = nullptr;
    uint8_t* outHost = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, floatBytes);
    aclrtMalloc((void**)&fp8D, fp8Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, floatBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)fp8D, fp8Bytes, (uint8_t*)fp8Input.data(), fp8Bytes,
                ACL_MEMCPY_HOST_TO_DEVICE);

    // 3. 启动 Kernel（单核）
    e4m3_to_float_kernel<<<1, nullptr, stream>>>(fp8D, outD);
    aclrtSynchronizeStream(stream);

    // 4. 读取结果
    aclrtMemcpy(outHost, floatBytes, (uint8_t*)outD, floatBytes,
                ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> outFloat((float*)outHost, (float*)(outHost + floatBytes));

    aclrtFree(fp8D); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    // 5. 验证: 相比于 Host 侧软件解码
    int mismatches = 0;
    float maxErr = 0.0f;
    for (uint32_t i = 0; i < N; ++i) {
        float expected = fp8_e4m3_to_float(fp8Input[i]);
        float diff = std::abs(outFloat[i] - expected);
        if (diff > 0.001f && std::abs(expected) < 100.0f) {
            if (diff > maxErr) maxErr = diff;
            if (mismatches < 5) {
                std::cout << "  [" << i << "] expected=" << expected
                          << " got=" << outFloat[i]
                          << " diff=" << diff << std::endl;
            }
            mismatches++;
        }
    }

    bool pass = (mismatches <= N / 100); // 允许 1% 误差（硬件 vs 软件精度差异）
    std::cout << "  [fp8_e4m3→float] " << (pass ? "通过" : "失败")
              << " (非精确匹配数: " << mismatches << "/" << N
              << ", 最大误差: " << maxErr << ")" << std::endl;

    // 打印前几个值用于验证
    std::cout << "  输入/输出样例 (前 8 个):" << std::endl;
    for (uint32_t i = 0; i < std::min(N, 8u); ++i) {
        std::cout << "    [" << i << "] fp8=0x" << std::hex << (int)fp8Input[i] << std::dec
                  << " ~float=" << floatInput[i]
                  << " → decoded=" << outFloat[i] << std::endl;
    }

    return pass;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_e4m32float fp8_e4m3 → float 转换测试 ===" << std::endl;
    std::cout << "模式: 单核" << std::endl;
    std::cout << std::endl;
    std::cout << "说明: fp8_e4m3fn_t 类型在 Host 侧 C++ 中未原生支持。" << std::endl;
    std::cout << "      Host 侧使用软件编解码将 float 转为 fp8 字节，" << std::endl;
    std::cout << "      通过原始字节搬运方式传递给 Device 侧 Kernel。" << std::endl;
    std::cout << std::endl;

    bool ok = test_e4m3_to_float();

    std::cout << std::endl;
    std::cout << (ok ? "[通过] asc_e4m32float 测试通过。" : "[失败] 测试未通过。") << std::endl;
    return ok ? 0 : 1;
}
