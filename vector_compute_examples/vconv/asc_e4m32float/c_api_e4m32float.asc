/* !
 * \file c_api_e4m32float.asc
 * \brief asc_e4m32float 寄存器级 fp8_e4m3 → float 类型转换示例
 *
 * 由于 fp8_e4m3fn_t 为 struct 类型不能用于 Host 侧 std::vector 也不能用于 UB 数组分配，
 * 示例中用 int8_t (同为 1 字节) 在 Host 侧和 UB 中存储原始数据,
 * 通过强转在寄存器操作处使用 fp8_e4m3fn_t 类型。
 *
 * 覆盖场景: 单核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <cstring>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

/* ==========================================================================
 * Host 侧 fp8_e4m3 格式编解码
 *
 * E4M3 格式: 1 sign | 4 exponent (bias=7) | 3 mantissa
 * 可表达范围: ±448, 最小 normal: ±2^-6
 *
 * 注意: 此编解码为软件实现，用于在 Host 侧生成和验证 fp8 数据。
 *       Device 侧使用硬件指令进行转换，精度可能存在微小差异。
 * ========================================================================== */

static uint8_t float_to_fp8_e4m3(float val)
{
    if (std::isnan(val)) return 0x7F;
    if (val == 0.0f) return 0x00;

    uint32_t bits;
    std::memcpy(&bits, &val, sizeof(bits));
    uint8_t sign = (bits >> 31) & 1;
    int32_t exp  = ((bits >> 23) & 0xFF) - 127;
    uint32_t mant = bits & 0x7FFFFF;

    if (exp == 128) return sign ? 0xFF : 0x7F;

    exp += 7;

    if (exp <= 0) {
        return (sign << 7);
    }
    if (exp >= 15) {
        return (sign << 7) | 0x7E;
    }

    uint8_t m = (mant >> 20) & 0x7;
    uint32_t remainder = mant & 0xFFFFF;
    if (remainder > 0x80000 || (remainder == 0x80000 && (m & 1))) {
        m++;
        if (m > 7) { m = 0; exp++; if (exp >= 15) return (sign << 7) | 0x7E; }
    }

    return (sign << 7) | ((exp & 0xF) << 3) | m;
}

static float fp8_e4m3_to_float(uint8_t fp8)
{
    if (fp8 == 0) return 0.0f;

    uint8_t sign = (fp8 >> 7) & 1;
    int32_t exp  = (fp8 >> 3) & 0xF;
    uint32_t mant = fp8 & 0x7;

    if (exp == 15) {
        if (mant == 7) return sign ? -INFINITY : INFINITY;
        return NAN;
    }

    if (exp == 0) {
        exp = mant ? -6 : -7;
        mant = mant;
    } else {
        exp -= 7;
    }

    uint32_t fbits = (sign << 31) | ((exp + 127) << 23) | (mant << 20);
    float result;
    std::memcpy(&result, &fbits, sizeof(result));
    return result;
}

/* ==========================================================================
 * fp8_e4m3fn_t Kernel: fp8 → float 解码
 *
 * 搬运层面使用 int8_t (同为 1 字节), 寄存器层面使用 fp8_e4m3fn_t。
 *
 * VL: fp8_e4m3fn_t 一个寄存器可容纳 256 字节 / 1 byte = 256 个 fp8 元素
 *
 * 一次处理 256 个 fp8 元素 (1 次 fp8 向量加载),
 * 通过 v1-v4 变体展开为 4 个 float 向量 (各 64 元素)，分别存储。
 *
 * blockLen: fp8 元素数量
 * ========================================================================== */

constexpr uint32_t FP8_VL = 256;
constexpr uint32_t FP8_TILE = FP8_VL * 4;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void E4m3ToFloatVF(__ubuf__ int8_t* ubFp8,
                                       __ubuf__ float* ubFloat, uint32_t blockLen)
{
    vector_fp8_e4m3fn_t vFp8;
    vector_float vF0, vF1, vF2, vF3;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(fp8_e4m3fn_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b8(remaining);
        asc_loadalign(vFp8, (__ubuf__ fp8_e4m3fn_t*)(ubFp8 + i * one_rep_size));
        asc_e4m32float(vF0, vFp8, vmask);
        asc_e4m32float_v2(vF1, vFp8, vmask);
        asc_e4m32float_v3(vF2, vFp8, vmask);
        asc_e4m32float_v4(vF3, vFp8, vmask);
        asc_storealign(ubFloat + i * one_rep_size, vF0, vmask);
        asc_storealign(ubFloat + i * one_rep_size + 64, vF1, vmask);
        asc_storealign(ubFloat + i * one_rep_size + 128, vF2, vmask);
        asc_storealign(ubFloat + i * one_rep_size + 192, vF3, vmask);
    }
}

__vector__ __global__ __aicore__ void e4m3_to_float_kernel(
    __gm__ int8_t* input, __gm__ float* output)
{
    asc_init();

    __ubuf__ int8_t ubFp8[FP8_TILE];
    __ubuf__ float ubFloat[FP8_TILE];

    const uint8_t cacheModeIn = static_cast<uint8_t>(((uint64_t)input) >> 60);
    const uint8_t cacheModeOut = static_cast<uint8_t>(((uint64_t)output) >> 60);
    uint32_t burstLengthFp8 = FP8_TILE * sizeof(int8_t);
    uint32_t burstLengthFloat = FP8_TILE * sizeof(float);

    asc_copy_gm2ub_align(ubFp8, input, BLK_NUM,
                         burstLengthFp8, 0, 0, true, cacheModeIn, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    E4m3ToFloatVF(ubFp8, ubFloat, FP8_TILE);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(output, (__ubuf__ float*)ubFloat, BLK_NUM,
                         burstLengthFloat, cacheModeOut, 0, 0);
}

/* ==========================================================================
 * Host 侧启动与测试
 * ========================================================================== */

bool test_e4m3_to_float()
{
    constexpr uint32_t N = FP8_TILE;

    std::vector<float> floatInput(N);
    std::vector<uint8_t> fp8Input(N);
    for (uint32_t i = 0; i < N; ++i) {
        floatInput[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
        fp8Input[i] = float_to_fp8_e4m3(floatInput[i]);
    }

    size_t fp8Bytes = N * sizeof(uint8_t);
    size_t floatBytes = N * sizeof(float);

    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* fp8D = nullptr;
    float* outD = nullptr;
    uint8_t* outHost = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, floatBytes);
    aclrtMalloc((void**)&fp8D, fp8Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, floatBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(fp8D, fp8Bytes, fp8Input.data(), fp8Bytes,
                ACL_MEMCPY_HOST_TO_DEVICE);

    e4m3_to_float_kernel<<<1, nullptr, stream>>>((int8_t*)fp8D, outD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, floatBytes, (uint8_t*)outD, floatBytes,
                ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> outFloat((float*)outHost, (float*)(outHost + floatBytes));

    aclrtFree(fp8D); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    auto fp8Index = [](uint32_t outIdx) -> uint32_t {
        uint32_t block = outIdx / 256;
        uint32_t offset = outIdx % 256;
        if (offset < 64)       return block * 256 + offset * 4;
        else if (offset < 128) return block * 256 + (offset - 64) * 4 + 1;
        else if (offset < 192) return block * 256 + (offset - 128) * 4 + 2;
        else                   return block * 256 + (offset - 192) * 4 + 3;
    };

    int mismatches = 0;
    float maxErr = 0.0f;
    float sumErr = 0.0f;
    for (uint32_t i = 0; i < N; ++i) {
        float expected = fp8_e4m3_to_float(fp8Input[fp8Index(i)]);
        float diff = std::abs(outFloat[i] - expected);
        sumErr += diff;
        if (diff > 0.001f && std::abs(expected) < 100.0f) {
            if (diff > maxErr) maxErr = diff;
            if (mismatches < 5) {
                std::cout << "  [" << i << "] fp8_idx=" << fp8Index(i)
                          << " expected=" << expected
                          << " got=" << outFloat[i]
                          << " diff=" << diff << std::endl;
            }
            mismatches++;
        }
    }

    float avgErr = (N > 0) ? (sumErr / N) : 0.0f;
    bool pass = (mismatches <= N / 100);
    std::cout << "  [fp8_e4m3→float] " << (pass ? "通过" : "失败")
              << " (非精确匹配数: " << mismatches << "/" << N
              << ", 最大误差: " << maxErr
              << ", 平均误差: " << avgErr << ")" << std::endl;

    std::cout << "  输入/输出样例 (前 8 个):" << std::endl;
    for (uint32_t i = 0; i < std::min(N, 8u); ++i) {
        float expected = fp8_e4m3_to_float(fp8Input[fp8Index(i)]);
        std::cout << "    [" << i << "] fp8_idx=" << fp8Index(i)
                  << " fp8=0x" << std::hex << (int)fp8Input[fp8Index(i)] << std::dec
                  << " ~float=" << floatInput[fp8Index(i)]
                  << " → decoded=" << outFloat[i]
                  << " (expected=" << expected << ")" << std::endl;
    }

    std::ofstream csv("vconv_fp8tofloat.csv");
    csv << "index,fp8_idx,fp8_hex,float_input,decoded,expected,error" << std::endl;
    for (uint32_t i = 0; i < N; ++i) {
        uint32_t fidx = fp8Index(i);
        float expected = fp8_e4m3_to_float(fp8Input[fidx]);
        float diff = std::abs(outFloat[i] - expected);
        csv << i << "," << fidx
            << ",0x" << std::hex << (int)fp8Input[fidx] << std::dec
            << "," << floatInput[fidx]
            << "," << outFloat[i]
            << "," << expected
            << "," << diff << std::endl;
    }
    csv.close();
    std::cout << "  CSV 结果已输出至 vconv_fp8tofloat.csv" << std::endl;

    return pass;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_e4m32float fp8_e4m3 → float 转换测试 ===" << std::endl;
    std::cout << "模式: 单核" << std::endl;
    std::cout << std::endl;
    std::cout << "说明: fp8_e4m3fn_t 类型为 struct，Host/UB 侧用 int8_t 替代。" << std::endl;
    std::cout << "      Host 侧使用软件编解码将 float 转为 fp8 字节，" << std::endl;
    std::cout << "      通过 int8_t 类型搬运传递到 Device 侧 Kernel。" << std::endl;
    std::cout << std::endl;

    bool ok = test_e4m3_to_float();

    std::cout << std::endl;
    std::cout << (ok ? "[通过] asc_e4m32float 测试通过。" : "[失败] 测试未通过。") << std::endl;
    return ok ? 0 : 1;
}
