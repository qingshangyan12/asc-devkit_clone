#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
struct fp8_e4m3fn_t { unsigned char __val; };
struct fp8_e5m2_t { unsigned char __val; };
struct fp8_e8m0_t { unsigned char __val; };
struct fp4x2_e1m2_t { unsigned char __val; };
struct fp4x2_e2m1_t { unsigned char __val; };
struct int4b_t { unsigned char __val; };
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8, BLK_NUM = 1;

__simd_vf__ inline void CeilVF_half(__ubuf__ half* xLocal, __ubuf__ half* zLocal, uint32_t blockLen) {
    vector_half vx, vz; vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_ceil(vz, vx, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void CeilVF_float(__ubuf__ float* xLocal, __ubuf__ float* zLocal, uint32_t blockLen) {
    vector_float vx, vz; vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_ceil(vz, vx, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

#define KERNEL_VF(PT, TYPE, VL, VF) \
constexpr uint32_t PT##_VL = VL, PT##_TILE = PT##_VL * 4; \
__vector__ __global__ __aicore__ void ceil_kernel_##PT(__gm__ TYPE* x, __gm__ TYPE* z) { \
    asc_init(); uint32_t blockLen = PT##_TILE * NUM_BLOCKS / asc_get_block_num(); \
    __gm__ TYPE* xGm = x + get_block_idx() * blockLen; __gm__ TYPE* zGm = z + get_block_idx() * blockLen; \
    __ubuf__ TYPE xLocal[PT##_TILE], zLocal[PT##_TILE]; \
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60); \
    uint32_t burstLength = blockLen * sizeof(TYPE); uint64_t srcStride = 0; uint32_t dstStride = 0; \
    asc_copy_gm2ub_align((__ubuf__ TYPE*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride); \
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0); asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0); \
    VF(xLocal, zLocal, blockLen); \
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0); asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0); \
    asc_copy_ub2gm_align(zGm, (__ubuf__ TYPE*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride); \
}

KERNEL_VF(HALF, half, 128, CeilVF_half)
KERNEL_VF(FLOAT, float, 64, CeilVF_float)
#undef KERNEL_VF

template<typename T, typename K> std::vector<T> launch_ceil(std::vector<T>& x, K kernel) {
    uint32_t N = x.size(); size_t bytes = N * sizeof(T); int32_t d = 0; aclrtStream s = nullptr;
    uint8_t* xH = reinterpret_cast<uint8_t*>(x.data()); uint8_t* zH = nullptr; T *xD = nullptr, *zD = nullptr;
    aclInit(nullptr); aclrtSetDevice(d); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&zH, bytes); aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)xD, bytes, xH, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, s>>>(xD, zD); aclrtSynchronizeStream(s);
    aclrtMemcpy(zH, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zH, (T*)(zH + bytes));
    aclrtFree(xD); aclrtFree(zD); aclrtFreeHost(zH); aclrtDestroyStream(s); aclrtResetDevice(d); aclFinalize();
    return z;
}

template<typename T> void print_val(T v, std::ostream& os) { if constexpr(std::is_same_v<T,half>) os<<static_cast<float>(v); else os<<v; }
template<typename T> void print_tensor(const std::vector<T>& t, const std::string& n) {
    constexpr size_t M=20; std::cout<<"  "<<n<<" ("<<t.size()<<"): ";
    for(size_t i=0;i<std::min(t.size(),M);++i){print_val(t[i],std::cout);std::cout<<" ";}
    if(t.size()>M)std::cout<<"..."; std::cout<<std::endl;
}
template<typename T> void save_csv(const std::vector<T>& x, const std::vector<T>& z, const std::vector<T>& g, const std::string& n) {
    std::string fn="ceil_"+n+".csv"; std::ofstream f(fn); f<<"index,x,output,expected\n";
    for(size_t i=0;i<x.size();++i){f<<i<<",";print_val(x[i],f);f<<",";print_val(z[i],f);f<<",";print_val(g[i],f);f<<"\n";}
    f.close(); std::cout<<"  [CSV] saved to "<<fn<<std::endl;
}

template<typename T> bool verify_ceil(std::vector<T>& z, std::vector<T>& x, const char* name) {
    std::vector<T> g(x.size());
    for(size_t i=0;i<x.size();++i) g[i]=static_cast<T>(std::ceil(static_cast<float>(x[i])));
    print_tensor(x,"X"); print_tensor(z,"Out"); print_tensor(g,"Exp");
    save_csv(x,z,g,name);
    bool ok=true; std::vector<size_t> err;
    for(size_t i=0;i<x.size();++i) if(z[i]!=g[i]){ok=false;err.push_back(i);}
    if(!ok){
        std::cout<<"  ["<<name<<"] precision error: "<<err.size()<<" mismatches\n";
        size_t M=std::min(err.size(),size_t(8));
        for(size_t e=0;e<M;++e){size_t idx=err[e]; std::cout<<"    ["<<idx<<"] x=";print_val(x[idx],std::cout);std::cout<<" out=";print_val(z[idx],std::cout);std::cout<<" exp=";print_val(g[idx],std::cout);std::cout<<"\n";}
        if(err.size()>M)std::cout<<"    ... ("<<(err.size()-M)<<" more)\n";
    }
    else std::cout<<"  ["<<name<<"] PASS\n";
    return ok;
}

int32_t main() {
    std::cout<<"=== asc_ceil test ===\nBlocks: "<<NUM_BLOCKS<<"\n";
    {constexpr uint32_t N=NUM_BLOCKS*HALF_TILE; std::vector<half> x(N);
    for(uint32_t i=0;i<N;++i) x[i]=static_cast<half>((i*0.37f)-5.0f);
    auto z=launch_ceil<half>(x,ceil_kernel_HALF); verify_ceil(z,x,"half");}
    std::cout<<std::endl;
    {constexpr uint32_t N=NUM_BLOCKS*FLOAT_TILE; std::vector<float> x(N);
    for(uint32_t i=0;i<N;++i) x[i]=(i*0.37f)-5.0f;
    auto z=launch_ceil<float>(x,ceil_kernel_FLOAT); verify_ceil(z,x,"float");}
    std::cout<<"\n[Done] asc_ceil test completed.\n"; return 0;
}
