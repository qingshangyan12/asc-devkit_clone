/* !
 * \file c_api_mull.asc
 * \brief asc_mull 寄存器级矢量乘低指令示例
 *
 * asc_mull 将两个 int32_t/uint32_t 矢量相乘，产生 64 位结果
 * dst0 存低 32 位，dst1 存高 32 位
 *
 * 覆盖数据类型: int32_t, uint32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量乘低函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void MullVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* yLocal,
                                     __ubuf__ int32_t* lowLocal, __ubuf__ int32_t* highLocal,
                                     uint32_t blockLen)
{
    vector_int32_t vx, vy, vlow, vhigh;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_mull(vlow, vhigh, vx, vy, vmask);
        asc_storealign(lowLocal + i * one_rep_size, vlow, vmask);
        asc_storealign(highLocal + i * one_rep_size, vhigh, vmask);
    }
}

__simd_vf__ inline void MullVF_uint32(__ubuf__ uint32_t* xLocal, __ubuf__ uint32_t* yLocal,
                                       __ubuf__ uint32_t* lowLocal, __ubuf__ uint32_t* highLocal,
                                       uint32_t blockLen)
{
    vector_uint32_t vx, vy, vlow, vhigh;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(uint32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_mull(vlow, vhigh, vx, vy, vmask);
        asc_storealign(lowLocal + i * one_rep_size, vlow, vmask);
        asc_storealign(highLocal + i * one_rep_size, vhigh, vmask);
    }
}

/* --------------------------------------------------------------------------
 * int32_t 类型乘低 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t MULL_INT32_VL = 256 / sizeof(int32_t);
constexpr uint32_t MULL_INT32_TILE = MULL_INT32_VL * 4;

__vector__ __global__ __aicore__ void mull_kernel_int32(
    __gm__ int32_t* x, __gm__ int32_t* y,
    __gm__ int32_t* low, __gm__ int32_t* high)
{
    asc_init();

    uint32_t blockLen = MULL_INT32_TILE * NUM_BLOCKS / asc_get_block_num();

    __gm__ int32_t* xGm    = x    + get_block_idx() * blockLen;
    __gm__ int32_t* yGm    = y    + get_block_idx() * blockLen;
    __gm__ int32_t* lowGm  = low  + get_block_idx() * blockLen;
    __gm__ int32_t* highGm = high + get_block_idx() * blockLen;

    __ubuf__ int32_t xLocal[MULL_INT32_TILE];
    __ubuf__ int32_t yLocal[MULL_INT32_TILE];
    __ubuf__ int32_t lowLocal[MULL_INT32_TILE];
    __ubuf__ int32_t highLocal[MULL_INT32_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0;
    uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ int32_t*)xLocal, xGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)yLocal, yGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    MullVF_int32(xLocal, yLocal, lowLocal, highLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(lowGm, (__ubuf__ int32_t*)lowLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
    asc_copy_ub2gm_align(highGm, (__ubuf__ int32_t*)highLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * uint32_t 类型乘低 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t MULL_UINT32_VL = 256 / sizeof(uint32_t);
constexpr uint32_t MULL_UINT32_TILE = MULL_UINT32_VL * 4;

__vector__ __global__ __aicore__ void mull_kernel_uint32(
    __gm__ uint32_t* x, __gm__ uint32_t* y,
    __gm__ uint32_t* low, __gm__ uint32_t* high)
{
    asc_init();

    uint32_t blockLen = MULL_UINT32_TILE * NUM_BLOCKS / asc_get_block_num();

    __gm__ uint32_t* xGm    = x    + get_block_idx() * blockLen;
    __gm__ uint32_t* yGm    = y    + get_block_idx() * blockLen;
    __gm__ uint32_t* lowGm  = low  + get_block_idx() * blockLen;
    __gm__ uint32_t* highGm = high + get_block_idx() * blockLen;

    __ubuf__ uint32_t xLocal[MULL_UINT32_TILE];
    __ubuf__ uint32_t yLocal[MULL_UINT32_TILE];
    __ubuf__ uint32_t lowLocal[MULL_UINT32_TILE];
    __ubuf__ uint32_t highLocal[MULL_UINT32_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(uint32_t);
    uint64_t srcStride = 0;
    uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ uint32_t*)xLocal, xGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ uint32_t*)yLocal, yGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    MullVF_uint32(xLocal, yLocal, lowLocal, highLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(lowGm, (__ubuf__ uint32_t*)lowLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
    asc_copy_ub2gm_align(highGm, (__ubuf__ uint32_t*)highLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::pair<std::vector<T>, std::vector<T>> launch_mull(
    std::vector<T>& x, std::vector<T>& y, KernelFunc kernel)
{
    uint32_t N = x.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* lowHost = nullptr;
    uint8_t* highHost = nullptr;
    T *xD = nullptr, *yD = nullptr, *lowD = nullptr, *highD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&lowHost, bytes);
    aclrtMallocHost((void**)&highHost, bytes);
    aclrtMalloc((void**)&xD,     bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yD,     bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&lowD,   bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&highD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)yD, bytes, yHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(xD, yD, lowD, highD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(lowHost, bytes, (uint8_t*)lowD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(highHost, bytes, (uint8_t*)highD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> low((T*)lowHost, (T*)(lowHost + bytes));
    std::vector<T> high((T*)highHost, (T*)(highHost + bytes));

    aclrtFree(xD); aclrtFree(yD); aclrtFree(lowD); aclrtFree(highD);
    aclrtFreeHost(lowHost); aclrtFreeHost(highHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return {low, high};
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    os << val;
}

template<typename T>
void save_csv(const std::vector<T>& x, const std::vector<T>& y,
              const std::vector<T>& lowOut, const std::vector<T>& highOut,
              const std::vector<T>& lowGolden, const std::vector<T>& highGolden,
              const std::string& name)
{
    std::string fname = "mull_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,x,y,output_low,expected_low,output_high,expected_high\n";
    for (size_t i = 0; i < x.size(); ++i) {
        f << i << ",";
        print_val(x[i], f);
        f << ",";
        print_val(y[i], f);
        f << ",";
        print_val(lowOut[i], f);
        f << ",";
        print_val(lowGolden[i], f);
        f << ",";
        print_val(highOut[i], f);
        f << ",";
        print_val(highGolden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 10;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T, typename WideT>
bool verify_mull(std::vector<T>& lowOut, std::vector<T>& highOut,
                 std::vector<T>& x, std::vector<T>& y, const char* name)
{
    std::vector<T> lowGolden(x.size()), highGolden(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        WideT prod = static_cast<WideT>(x[i]) * static_cast<WideT>(y[i]);
        lowGolden[i]  = static_cast<T>(prod & static_cast<WideT>(0xFFFFFFFF));
        highGolden[i] = static_cast<T>((prod >> 32) & static_cast<WideT>(0xFFFFFFFF));
    }

    print_tensor(x,         "Input x    ");
    print_tensor(y,         "Input y    ");
    print_tensor(lowOut,    "Output low ");
    print_tensor(lowGolden, "Expect low ");
    print_tensor(highOut,   "Output high");
    print_tensor(highGolden,"Expect high");

    save_csv(x, y, lowOut, highOut, lowGolden, highGolden, name);

    bool ok = true;
    std::vector<size_t> errIdxLow, errIdxHigh;
    for (size_t i = 0; i < x.size(); ++i) {
        if (lowOut[i] != lowGolden[i]) {
            ok = false;
            errIdxLow.push_back(i);
        }
        if (highOut[i] != highGolden[i]) {
            ok = false;
            errIdxHigh.push_back(i);
        }
    }

    if (!ok) {
        if (!errIdxLow.empty()) {
            std::cout << "  [" << name << "] 精度错误 (低32位): " << errIdxLow.size()
                      << " 个不匹配" << std::endl;
            size_t maxErr = std::min(errIdxLow.size(), size_t(4));
            for (size_t e = 0; e < maxErr; ++e) {
                size_t idx = errIdxLow[e];
                std::cout << "    [" << idx << "] x=" << x[idx] << " y=" << y[idx]
                          << " lowOut=" << lowOut[idx] << " lowExp=" << lowGolden[idx]
                          << std::endl;
            }
        }
        if (!errIdxHigh.empty()) {
            std::cout << "  [" << name << "] 精度错误 (高32位): " << errIdxHigh.size()
                      << " 个不匹配" << std::endl;
            size_t maxErr = std::min(errIdxHigh.size(), size_t(4));
            for (size_t e = 0; e < maxErr; ++e) {
                size_t idx = errIdxHigh[e];
                std::cout << "    [" << idx << "] x=" << x[idx] << " y=" << y[idx]
                          << " highOut=" << highOut[idx] << " highExp=" << highGolden[idx]
                          << std::endl;
            }
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_mull 寄存器级矢量乘低测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * MULL_INT32_TILE;
        std::vector<int32_t> x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<int32_t>(i * 7 + 1);
            y[i] = static_cast<int32_t>(i * 3 + 5);
        }
        auto [low, high] = launch_mull<int32_t>(x, y, mull_kernel_int32);
        verify_mull<int32_t, int64_t>(low, high, x, y, "int32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MULL_UINT32_TILE;
        std::vector<uint32_t> x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<uint32_t>(i * 11 + 3);
            y[i] = static_cast<uint32_t>(i * 5 + 7);
        }
        auto [low, high] = launch_mull<uint32_t>(x, y, mull_kernel_uint32);
        verify_mull<uint32_t, uint64_t>(low, high, x, y, "uint32_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_mull 示例测试结束。" << std::endl;
    return 0;
}
