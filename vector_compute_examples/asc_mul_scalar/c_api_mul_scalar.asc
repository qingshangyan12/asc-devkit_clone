/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_mul_scalar(std::vector<T>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));
    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_muls(const std::vector<T>& input, const std::vector<T>& output,
                   const std::vector<T>& golden, T scalar, const std::string& name)
{
    std::string fname = "mul_scalar_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,scalar,output,expected\n";
    f << "scalar,=,";
    print_val(scalar, f);
    f << ",,\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(scalar, f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_mul_scalar(std::vector<T>& out, std::vector<T>& in,
                       T scalar, const char* name)
{
    std::vector<T> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = in[i] * scalar;
    }
    print_tensor(in,  "Input   ");
    std::cout << "  Scalar  = ";
    print_val(scalar, std::cout);
    std::cout << std::endl;
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");
    save_csv_muls(in, out, g, scalar, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] input=";
            print_val(in[idx], std::cout);
            std::cout << " output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_mul_scalar 寄存器级矢量标量乘法测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * MULS_INT16_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>(i % 1000);
        auto out = launch_mul_scalar<int16_t>(in, mul_scalar_kernel_int16);
        verify_mul_scalar(out, in, static_cast<int16_t>(3), "int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MULS_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int32_t>(i * 7);
        auto out = launch_mul_scalar<int32_t>(in, mul_scalar_kernel_int32);
        verify_mul_scalar(out, in, static_cast<int32_t>(5), "int32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MULS_UINT16_TILE;
        std::vector<uint16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<uint16_t>(i % 2000);
        auto out = launch_mul_scalar<uint16_t>(in, mul_scalar_kernel_uint16);
        verify_mul_scalar(out, in, static_cast<uint16_t>(7), "uint16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MULS_UINT32_TILE;
        std::vector<uint32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<uint32_t>(i * 13);
        auto out = launch_mul_scalar<uint32_t>(in, mul_scalar_kernel_uint32);
        verify_mul_scalar(out, in, static_cast<uint32_t>(11), "uint32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MULS_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<half>(i * 0.1f);
        auto out = launch_mul_scalar<half>(in, mul_scalar_kernel_half);
        verify_mul_scalar(out, in, static_cast<half>(2.5f), "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MULS_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = i * 0.1f;
        auto out = launch_mul_scalar<float>(in, mul_scalar_kernel_float);
        verify_mul_scalar(out, in, 2.5f, "float");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_mul_scalar 示例测试结束。" << std::endl;
    return 0;
}
