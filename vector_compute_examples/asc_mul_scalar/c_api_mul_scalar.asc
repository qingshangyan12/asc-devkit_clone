/* !
 * \file c_api_mul_scalar.asc
 * \brief asc_mul_scalar 寄存器级矢量与标量乘法示例
 *
 * 覆盖数据类型: int16_t, int32_t, uint16_t, uint32_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量标量乘法函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void MulScalarVF_int16(__ubuf__ int16_t* xLocal, __ubuf__ int16_t* zLocal,
                                           int16_t scalar, uint32_t blockLen)
{
    vector_int16_t vx, vz;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int16_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_mul_scalar(vz, vx, scalar, vmask);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void MulScalarVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* zLocal,
                                           int32_t scalar, uint32_t blockLen)
{
    vector_int32_t vx, vz;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
