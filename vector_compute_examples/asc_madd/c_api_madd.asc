/* !
 * \file c_api_madd.asc
 * \brief asc_madd 寄存器级矢量乘加示例
 *        dst = dst * src0 + src1 (vmadd: fused multiply-add)
 *
 * 覆盖数据类型: half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <cmath>
#include <cstring>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void MaddVF_half(__ubuf__ half* accLocal, __ubuf__ half* xLocal,
                                     __ubuf__ half* yLocal, __ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vacc, vx, vy;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vacc, accLocal + i * one_rep_size);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_madd(vacc, vx, vy, vmask);
        asc_storealign(zLocal + i * one_rep_size, vacc, vmask);
    }
}

__simd_vf__ inline void MaddVF_float(__ubuf__ float* accLocal, __ubuf__ float* xLocal,
                                      __ubuf__ float* yLocal, __ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vacc, vx, vy;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vacc, accLocal + i * one_rep_size);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_madd(vacc, vx, vy, vmask);
        asc_storealign(zLocal + i * one_rep_size, vacc, vmask);
    }
}

constexpr uint32_t MADD_HALF_VL = 128;
constexpr uint32_t MADD_HALF_TILE = MADD_HALF_VL * 4;

__vector__ __global__ __aicore__ void madd_kernel_half(
    __gm__ half* acc, __gm__ half* x, __gm__ half* y, __gm__ half* z)
{
    asc_init();
    uint32_t blockLen = MADD_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ half* accGm = acc + get_block_idx() * blockLen;
    __gm__ half* xGm = x + get_block_idx() * blockLen;
    __gm__ half* yGm = y + get_block_idx() * blockLen;
    __gm__ half* zGm = z + get_block_idx() * blockLen;
    __ubuf__ half accLocal[MADD_HALF_TILE];
    __ubuf__ half xLocal[MADD_HALF_TILE];
    __ubuf__ half yLocal[MADD_HALF_TILE];
    __ubuf__ half zLocal[MADD_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)accGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)accLocal, accGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ half*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ half*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    MaddVF_half(accLocal, xLocal, yLocal, zLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ half*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

constexpr uint32_t MADD_FLOAT_VL = 64;
constexpr uint32_t MADD_FLOAT_TILE = MADD_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void madd_kernel_float(
    __gm__ float* acc, __gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();
    uint32_t blockLen = MADD_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* accGm = acc + get_block_idx() * blockLen;
    __gm__ float* xGm = x + get_block_idx() * blockLen;
    __gm__ float* yGm = y + get_block_idx() * blockLen;
    __gm__ float* zGm = z + get_block_idx() * blockLen;
    __ubuf__ float accLocal[MADD_FLOAT_TILE];
    __ubuf__ float xLocal[MADD_FLOAT_TILE];
    __ubuf__ float yLocal[MADD_FLOAT_TILE];
    __ubuf__ float zLocal[MADD_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)accGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)accLocal, accGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ float*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ float*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    MaddVF_float(accLocal, xLocal, yLocal, zLocal, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ float*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_madd(std::vector<T>& acc, std::vector<T>& x,
                           std::vector<T>& y, KernelFunc kernel)
{
    uint32_t N = acc.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* accHost = reinterpret_cast<uint8_t*>(acc.data());
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* zHost = nullptr;
    T *accD = nullptr, *xD = nullptr, *yD = nullptr, *zD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&zHost, bytes);
    aclrtMalloc((void**)&accD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)accD, bytes, accHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)yD, bytes, yHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(accD, xD, yD, zD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + bytes));
    aclrtFree(accD); aclrtFree(xD); aclrtFree(yD); aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return z;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& acc, const std::vector<T>& x,
              const std::vector<T>& y, const std::vector<T>& z,
              const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "madd_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,acc,x,y,output,expected\n";
    for (size_t i = 0; i < acc.size(); ++i) {
        f << i << ",";
        print_val(acc[i], f);
        f << ",";
        print_val(x[i], f);
        f << ",";
        print_val(y[i], f);
        f << ",";
        print_val(z[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
T gt_madd(T acc, T x, T y)
{
    if constexpr (std::is_same_v<T, half>) {
        return static_cast<half>(static_cast<float>(acc) * static_cast<float>(x) + static_cast<float>(y));
    } else {
        return acc * x + y;
    }
}

template<typename T>
bool values_equal(T a, T b)
{
    if constexpr (std::is_same_v<T, float>) {
        if (a == b) return true;
        float diff = std::fabs(a - b);
        float absA = std::fabs(a);
        float absB = std::fabs(b);
        float maxAbs = absA > absB ? absA : absB;
        return diff <= std::max(1e-6f, maxAbs * 1e-5f);
    } else {
        return a == b;
    }
}

template<typename T>
bool verify_madd(std::vector<T>& acc, std::vector<T>& x,
                 std::vector<T>& y, std::vector<T>& z, const char* name)
{
    std::vector<T> g(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        g[i] = gt_madd(acc[i], x[i], y[i]);
    }
    print_tensor(acc, "Acc     ");
    print_tensor(x, "X       ");
    print_tensor(y, "Y       ");
    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");
    save_csv(acc, x, y, z, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        if (!values_equal(z[i], g[i])) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] acc=";
            print_val(acc[idx], std::cout);
            std::cout << " x=";
            print_val(x[idx], std::cout);
            std::cout << " y=";
            print_val(y[idx], std::cout);
            std::cout << " output=";
            print_val(z[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_madd 寄存器级乘加测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "输出: z = acc * x + y (vmadd)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * MADD_HALF_TILE;
        std::vector<half> acc(N), x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            acc[i] = static_cast<half>(0.25f + i * 0.01f);
            x[i] = static_cast<half>(1.0f + (i % 8) * 0.5f);
            y[i] = static_cast<half>(0.5f + ((i / 8) % 4) * 0.25f);
        }
        auto z = launch_madd<half>(acc, x, y, madd_kernel_half);
        verify_madd(acc, x, y, z, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * MADD_FLOAT_TILE;
        std::vector<float> acc(N), x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            acc[i] = 0.25f + i * 0.01f;
            x[i] = 1.0f + (i % 8) * 0.5f;
            y[i] = 0.5f + ((i / 8) % 4) * 0.25f;
        }
        auto z = launch_madd<float>(acc, x, y, madd_kernel_float);
        verify_madd(acc, x, y, z, "float");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_madd 示例测试结束。" << std::endl;
    return 0;
}
