    asc_copy_ub2gm_align(outputGm, (__ubuf__ half*)localOut, BLK_NUM, blockLen * sizeof(half), cacheMode, srcStride, dstStride);
}

constexpr uint32_t REDUCE_SUM_FLOAT_VL = 64;
constexpr uint32_t REDUCE_SUM_FLOAT_TILE = 8;

__vector__ __global__ __aicore__ void reduce_sum_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_SUM_FLOAT_TILE;
    __gm__ float* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ float* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ float local[REDUCE_SUM_FLOAT_TILE];
    __ubuf__ float localOut[REDUCE_SUM_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceSumVF_float(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ float*)localOut, BLK_NUM, blockLen * sizeof(float), cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename TIn, typename TOut, typename KernelFunc>
std::vector<TOut> launch_reduce_sum(std::vector<TIn>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t inBytes = N * sizeof(TIn);
    size_t outBytes = N * sizeof(TOut);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    TIn *inD = nullptr;
    TOut *outD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&outHost, outBytes);
    aclrtMalloc((void**)&inD,  inBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, outBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, inBytes, inHost, inBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outHost, outBytes, (uint8_t*)outD, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<TOut> out((TOut*)outHost, (TOut*)(outHost + outBytes));
    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename TVal>
void print_tensor(const std::vector<TVal>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename TIn, typename TOut>
void save_csv_reduce_sum(const std::vector<TIn>& input, const std::vector<TOut>& output,
                          const std::vector<TOut>& perBlockGolden,
                          const std::string& name, uint32_t blockLen)
{
    std::string fname = "reduce_sum_" + name + ".csv";
    std::ofstream f(fname);
    f << "block_idx,block_sum,expected\n";
    TOut globalSum = static_cast<TOut>(0);
    for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
        f << b << ",";
        print_val(output[b * blockLen], f);
        f << ",";
        print_val(perBlockGolden[b], f);
        f << "\n";
        if constexpr (std::is_same_v<TOut, half>) {
            globalSum = static_cast<half>(static_cast<float>(globalSum) + static_cast<float>(perBlockGolden[b]));
        } else {
            globalSum += perBlockGolden[b];
        }
    }
    f << "\nindex,input\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename TIn, typename TOut>
bool verify_reduce_sum(std::vector<TOut>& out, std::vector<TIn>& in,
                        const char* name, uint32_t blockLen)
{
    print_tensor(in, "Input");
    std::vector<TOut> perBlockGolden(NUM_BLOCKS);
    for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
        float fsum = 0.0f;
        TOut isum = static_cast<TOut>(0);
        for (uint32_t i = b * blockLen; i < (b + 1) * blockLen; ++i) {
            if constexpr (std::is_same_v<TOut, half> || std::is_same_v<TIn, half>) {
                fsum += static_cast<float>(in[i]);
            } else if constexpr (std::is_same_v<TIn, int16_t> && std::is_same_v<TOut, int32_t>) {
                isum += static_cast<int32_t>(in[i]);
            } else {
                isum += static_cast<TOut>(in[i]);
            }
        }
        if constexpr (std::is_same_v<TOut, half>) {
            perBlockGolden[b] = static_cast<half>(fsum);
        } else if constexpr (std::is_same_v<TIn, int16_t> && std::is_same_v<TOut, int32_t>) {
            perBlockGolden[b] = isum;
        } else {
            perBlockGolden[b] = isum;
        }
    }

    bool ok = true;
    for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
        TOut output_val = out[b * blockLen];
        TOut expected = perBlockGolden[b];
        bool blockOk = false;
        if constexpr (std::is_same_v<TOut, half>) {
            float diff = std::abs(static_cast<float>(output_val) - static_cast<float>(expected));
            blockOk = (diff < 1e-1f);
        } else if constexpr (std::is_same_v<TOut, float>) {
            float diff = std::abs(output_val - expected);
            blockOk = (diff < 1e-4f * std::abs(expected) + 1e-6f);
        } else {
            blockOk = (output_val == expected);
        }
        if (!blockOk) {
            ok = false;
            std::cout << "  Block " << b << ": output=";
            print_val(output_val, std::cout);
            std::cout << " expected=";
            print_val(expected, std::cout);
            std::cout << std::endl;
        }
    }

    save_csv_reduce_sum(in, out, perBlockGolden, name, blockLen);

    if (ok) {
        std::cout << "  [" << name << "] 通过" << std::endl;
        return true;
    }
    std::cout << "  [" << name << "] 精度错误" << std::endl;
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_reduce_sum 寄存器级求和归约测试 (单寄存器块) ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks), 每个block独立求和自己分片的和" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_SUM_INT16_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            in[i] = static_cast<int16_t>((i * 7 + 3) % 500);
        }
        auto out = launch_reduce_sum<int16_t, int32_t>(in, reduce_sum_kernel_int16);
        verify_reduce_sum(out, in, "int16_t", REDUCE_SUM_INT16_TILE);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_SUM_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            in[i] = static_cast<int32_t>(i * 13 + 7);
        }
        auto out = launch_reduce_sum<int32_t, int32_t>(in, reduce_sum_kernel_int32);
        verify_reduce_sum(out, in, "int32_t", REDUCE_SUM_INT32_TILE);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_SUM_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            in[i] = static_cast<half>(i * 0.1f);
        }
        auto out = launch_reduce_sum<half, half>(in, reduce_sum_kernel_half);
        verify_reduce_sum(out, in, "half", REDUCE_SUM_HALF_TILE);
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * REDUCE_SUM_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            in[i] = i * 0.1f;
        }
        auto out = launch_reduce_sum<float, float>(in, reduce_sum_kernel_float);
        verify_reduce_sum(out, in, "float", REDUCE_SUM_FLOAT_TILE);
    }
    std::cout << std::endl;
    std::cout << "[完成] asc_reduce_sum 示例测试结束。" << std::endl;
    return 0;
}
