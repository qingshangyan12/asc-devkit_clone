/* !
 * \file c_api_reduce_sum.asc
 * \brief asc_reduce_sum 寄存器级矢量求和归约示例
 *        每个 block 对单寄存器块内元素求和, Host 侧验证每个 block 的结果
 *
 * 覆盖数据类型: int16_t, int32_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void ReduceSumVF_int16(__ubuf__ int16_t* xLocal, __ubuf__ int32_t* zLocal, uint32_t blockLen)
{
    vector_int16_t vx;
    vector_int32_t vz;
    vector_bool vmask;
    vmask = asc_update_mask_b16(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_sum(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b32(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void ReduceSumVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* zLocal, uint32_t blockLen)
{
    vector_int32_t vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b32(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_sum(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b32(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void ReduceSumVF_half(__ubuf__ half* xLocal, __ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b16(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_sum(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b16(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void ReduceSumVF_float(__ubuf__ float* xLocal, __ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b32(blockLen);
    asc_loadalign(vx, xLocal);
    asc_reduce_sum(vz, vx, vmask);
    uint32_t store_count = 1;
    vmask = asc_update_mask_b32(store_count);
    asc_storealign(zLocal, vz, vmask);
}

constexpr uint32_t REDUCE_SUM_INT16_VL = 128;
constexpr uint32_t REDUCE_SUM_INT16_TILE = 16;

__vector__ __global__ __aicore__ void reduce_sum_kernel_int16(
    __gm__ int16_t* input, __gm__ int32_t* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_SUM_INT16_TILE;
    __gm__ int16_t* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ int32_t* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ int16_t local[REDUCE_SUM_INT16_TILE];
    __ubuf__ int32_t localOut[REDUCE_SUM_INT16_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int16_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int16_t*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceSumVF_int16(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ int32_t*)localOut, BLK_NUM, blockLen * sizeof(int32_t), cacheMode, srcStride, dstStride);
}

constexpr uint32_t REDUCE_SUM_INT32_VL = 64;
constexpr uint32_t REDUCE_SUM_INT32_TILE = 8;

__vector__ __global__ __aicore__ void reduce_sum_kernel_int32(
    __gm__ int32_t* input, __gm__ int32_t* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_SUM_INT32_TILE;
    __gm__ int32_t* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ int32_t* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ int32_t local[REDUCE_SUM_INT32_TILE];
    __ubuf__ int32_t localOut[REDUCE_SUM_INT32_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int32_t*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    ReduceSumVF_int32(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ int32_t*)localOut, BLK_NUM, blockLen * sizeof(int32_t), cacheMode, srcStride, dstStride);
}

constexpr uint32_t REDUCE_SUM_HALF_VL = 128;
constexpr uint32_t REDUCE_SUM_HALF_TILE = 16;

__vector__ __global__ __aicore__ void reduce_sum_kernel_half(
    __gm__ half* input, __gm__ half* output)
{
    asc_init();
    uint32_t blockLen = REDUCE_SUM_HALF_TILE;
    __gm__ half* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ half* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ half local[REDUCE_SUM_HALF_TILE];
    __ubuf__ half localOut[REDUCE_SUM_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
