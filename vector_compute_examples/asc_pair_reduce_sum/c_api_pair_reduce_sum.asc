/* !
 * \file c_api_pair_reduce_sum.asc
 * \brief asc_pair_reduce_sum 寄存器级相邻对求和归约示例
 *        vcpadd 将相邻元素两两求和: 结果存放在奇数位置
 *
 * 覆盖数据类型: half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void PairReduceSumVF_half(__ubuf__ half* xLocal, __ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b16(blockLen);
    asc_loadalign(vx, xLocal);
    asc_pair_reduce_sum(vz, vx, vmask);
    uint32_t store_count = blockLen;
    vmask = asc_update_mask_b16(store_count);
    asc_storealign(zLocal, vz, vmask);
}

__simd_vf__ inline void PairReduceSumVF_float(__ubuf__ float* xLocal, __ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vx, vz;
    vector_bool vmask;
    vmask = asc_update_mask_b32(blockLen);
    asc_loadalign(vx, xLocal);
    asc_pair_reduce_sum(vz, vx, vmask);
    uint32_t store_count = blockLen;
    vmask = asc_update_mask_b32(store_count);
    asc_storealign(zLocal, vz, vmask);
}

constexpr uint32_t PAIR_REDUCE_SUM_HALF_VL = 128;
constexpr uint32_t PAIR_REDUCE_SUM_HALF_TILE = 16;

__vector__ __global__ __aicore__ void pair_reduce_sum_kernel_half(
    __gm__ half* input, __gm__ half* output)
{
    asc_init();
    uint32_t blockLen = PAIR_REDUCE_SUM_HALF_TILE;
    __gm__ half* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ half* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ half local[PAIR_REDUCE_SUM_HALF_TILE];
    __ubuf__ half localOut[PAIR_REDUCE_SUM_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    PairReduceSumVF_half(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ half*)localOut, BLK_NUM, blockLen * sizeof(half), cacheMode, srcStride, dstStride);
}

constexpr uint32_t PAIR_REDUCE_SUM_FLOAT_VL = 64;
constexpr uint32_t PAIR_REDUCE_SUM_FLOAT_TILE = 8;

__vector__ __global__ __aicore__ void pair_reduce_sum_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();
    uint32_t blockLen = PAIR_REDUCE_SUM_FLOAT_TILE;
    __gm__ float* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ float* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ float local[PAIR_REDUCE_SUM_FLOAT_TILE];
    __ubuf__ float localOut[PAIR_REDUCE_SUM_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    PairReduceSumVF_float(local, localOut, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ float*)localOut, BLK_NUM, blockLen * sizeof(float), cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_pair_reduce_sum(std::vector<T>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));
    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_pair(const std::vector<T>& in, const std::vector<T>& out,
                    uint32_t blockLen, const std::string& name,
                    const std::vector<size_t>& okPairs,
                    const std::vector<size_t>& errPairs,
                    const std::vector<size_t>& errBlocks)
{
    std::string fname = "pair_reduce_sum_" + name + ".csv";
    std::ofstream f(fname);
    f << "block_idx,position,output,expected\n";
    for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
        for (uint32_t p = 0; p < blockLen; ++p) {
            uint32_t idx = b * blockLen + p;
            T expected = (p < blockLen - 1) ? (in[idx] + in[idx + 1]) : static_cast<T>(0);
            f << b << "," << p << ",";
            print_val(out[idx], f);
            f << ",";
            if (p < blockLen - 1) {
                print_val(expected, f);
            }
            f << "\n";
        }
    }
    f << "\nindex,input\n";
    for (size_t i = 0; i < in.size(); ++i) {
        f << i << ",";
        print_val(in[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 32;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_pair_reduce_sum(std::vector<T>& out, std::vector<T>& in,
                             uint32_t blockLen, const char* name)
{
    print_tensor(in, "Input");
    print_tensor(out, "Output (full register)");

    std::vector<size_t> okPairs, errPairs, errBlocks;
    bool hasNonZero = false;
    for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
        for (uint32_t p = 0; p < blockLen; ++p) {
            uint32_t idx = b * blockLen + p;
            if constexpr (std::is_same_v<T, half>) {
                if (std::abs(static_cast<float>(out[idx])) > 1e-6f) hasNonZero = true;
            } else {
                if (std::abs(out[idx]) > 1e-6f) hasNonZero = true;
            }
        }
    }

    if (!hasNonZero) {
        std::cout << "  [" << name << "] 警告: asc_pair_reduce_sum 在 sim 仿真模式下输出全零" << std::endl;
        std::cout << "           该API依赖 vcpadd 指令, 可能需要在真实硬件上验证" << std::endl;
        save_csv_pair(in, out, blockLen, name, okPairs, errPairs, errBlocks);
        return false;
    }

    std::cout << "  [" << name << "] 输出包含非零值, 需要进一步验证" << std::endl;
    save_csv_pair(in, out, blockLen, name, okPairs, errPairs, errBlocks);
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_pair_reduce_sum 寄存器级相邻对求和归约测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "公式: out[i] = in[2*i] + in[2*i+1] (via vcpadd)" << std::endl;
    std::cout << "注意: vcpadd 在不同平台可能有不同的精确定义" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * PAIR_REDUCE_SUM_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            in[i] = static_cast<half>(i * 0.1f);
        }
        auto out = launch_pair_reduce_sum<half>(in, pair_reduce_sum_kernel_half);
        verify_pair_reduce_sum(out, in, PAIR_REDUCE_SUM_HALF_TILE, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PAIR_REDUCE_SUM_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i) {
            in[i] = i * 0.1f;
        }
        auto out = launch_pair_reduce_sum<float>(in, pair_reduce_sum_kernel_float);
        verify_pair_reduce_sum(out, in, PAIR_REDUCE_SUM_FLOAT_TILE, "float");
    }
    std::cout << std::endl;
    std::cout << "[完成] asc_pair_reduce_sum 示例测试结束。" << std::endl;
    return 0;
}
