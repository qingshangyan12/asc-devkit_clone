/* !
 * \file c_api_gt.asc
 * \brief asc_gt 寄存器级矢量大于比较示例
 *        使用 asc_select 将 bool 结果转换为 1/0 值输出
 *
 * 覆盖数据类型: half, float, int32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <cstring>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void GtVF_half(__ubuf__ half* xLocal, __ubuf__ half* yLocal,
                                   __ubuf__ half* zLocal, __ubuf__ half* oneUb,
                                   __ubuf__ half* zeroUb, uint32_t blockLen)
{
    vector_half vx, vy, vone, vzero, vz;
    vector_bool vcmp, vmask;
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    asc_loadalign(vone, oneUb);
    asc_loadalign(vzero, zeroUb);
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_gt(vcmp, vx, vy, vmask);
        asc_select(vz, vone, vzero, vcmp);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void GtVF_float(__ubuf__ float* xLocal, __ubuf__ float* yLocal,
                                    __ubuf__ float* zLocal, __ubuf__ float* oneUb,
                                    __ubuf__ float* zeroUb, uint32_t blockLen)
{
    vector_float vx, vy, vone, vzero, vz;
    vector_bool vcmp, vmask;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    asc_loadalign(vone, oneUb);
    asc_loadalign(vzero, zeroUb);
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_gt(vcmp, vx, vy, vmask);
        asc_select(vz, vone, vzero, vcmp);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

__simd_vf__ inline void GtVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* yLocal,
                                    __ubuf__ int32_t* zLocal, __ubuf__ int32_t* oneUb,
                                    __ubuf__ int32_t* zeroUb, uint32_t blockLen)
{
    vector_int32_t vx, vy, vone, vzero, vz;
    vector_bool vcmp, vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    asc_loadalign(vone, oneUb);
    asc_loadalign(vzero, zeroUb);
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vx, xLocal + i * one_rep_size);
        asc_loadalign(vy, yLocal + i * one_rep_size);
        asc_gt(vcmp, vx, vy, vmask);
        asc_select(vz, vone, vzero, vcmp);
        asc_storealign(zLocal + i * one_rep_size, vz, vmask);
    }
}

constexpr uint32_t GT_HALF_VL = 128;
constexpr uint32_t GT_HALF_TILE = GT_HALF_VL * 4;

__vector__ __global__ __aicore__ void gt_kernel_half(
    __gm__ half* x, __gm__ half* y, __gm__ half* z)
{
    asc_init();
    constexpr uint32_t regSize = 256 / sizeof(half);
    uint32_t blockLen = GT_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ half* xGm = x + get_block_idx() * blockLen;
    __gm__ half* yGm = y + get_block_idx() * blockLen;
    __gm__ half* zGm = z + get_block_idx() * blockLen;
    __ubuf__ half xLocal[GT_HALF_TILE];
    __ubuf__ half yLocal[GT_HALF_TILE];
    __ubuf__ half zLocal[GT_HALF_TILE];
    __ubuf__ half oneUb[regSize];
    __ubuf__ half zeroUb[regSize];
    for (uint32_t i = 0; i < regSize; ++i) {
        oneUb[i] = half(1.0f);
        zeroUb[i] = half(0.0f);
    }
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ half*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    GtVF_half(xLocal, yLocal, zLocal, oneUb, zeroUb, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ half*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

constexpr uint32_t GT_FLOAT_VL = 64;
constexpr uint32_t GT_FLOAT_TILE = GT_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void gt_kernel_float(
    __gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();
    constexpr uint32_t regSize = 256 / sizeof(float);
    uint32_t blockLen = GT_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* xGm = x + get_block_idx() * blockLen;
    __gm__ float* yGm = y + get_block_idx() * blockLen;
    __gm__ float* zGm = z + get_block_idx() * blockLen;
    __ubuf__ float xLocal[GT_FLOAT_TILE];
    __ubuf__ float yLocal[GT_FLOAT_TILE];
    __ubuf__ float zLocal[GT_FLOAT_TILE];
    __ubuf__ float oneUb[regSize];
    __ubuf__ float zeroUb[regSize];
    for (uint32_t i = 0; i < regSize; ++i) {
        oneUb[i] = 1.0f;
        zeroUb[i] = 0.0f;
    }
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ float*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    GtVF_float(xLocal, yLocal, zLocal, oneUb, zeroUb, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ float*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

constexpr uint32_t GT_INT32_VL = 64;
constexpr uint32_t GT_INT32_TILE = GT_INT32_VL * 4;

__vector__ __global__ __aicore__ void gt_kernel_int32(
    __gm__ int32_t* x, __gm__ int32_t* y, __gm__ int32_t* z)
{
    asc_init();
    constexpr uint32_t regSize = 256 / sizeof(int32_t);
    uint32_t blockLen = GT_INT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* xGm = x + get_block_idx() * blockLen;
    __gm__ int32_t* yGm = y + get_block_idx() * blockLen;
    __gm__ int32_t* zGm = z + get_block_idx() * blockLen;
    __ubuf__ int32_t xLocal[GT_INT32_TILE];
    __ubuf__ int32_t yLocal[GT_INT32_TILE];
    __ubuf__ int32_t zLocal[GT_INT32_TILE];
    __ubuf__ int32_t oneUb[regSize];
    __ubuf__ int32_t zeroUb[regSize];
    for (uint32_t i = 0; i < regSize; ++i) {
        oneUb[i] = 1;
        zeroUb[i] = 0;
    }
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int32_t*)xLocal, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_copy_gm2ub_align((__ubuf__ int32_t*)yLocal, yGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    GtVF_int32(xLocal, yLocal, zLocal, oneUb, zeroUb, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ int32_t*)zLocal, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_gt(std::vector<T>& x, std::vector<T>& y, KernelFunc kernel)
{
    uint32_t N = x.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* zHost = nullptr;
    T *xD = nullptr, *yD = nullptr, *zD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&zHost, bytes);
    aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)yD, bytes, yHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(xD, yD, zD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + bytes));
    aclrtFree(xD); aclrtFree(yD); aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return z;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& x, const std::vector<T>& y,
              const std::vector<T>& z, const std::vector<T>& golden,
              const std::string& name)
{
    std::string fname = "gt_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,x,y,output,expected\n";
    for (size_t i = 0; i < x.size(); ++i) {
        f << i << ",";
        print_val(x[i], f);
        f << ",";
        print_val(y[i], f);
        f << ",";
        print_val(z[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_gt(std::vector<T>& x, std::vector<T>& y,
               std::vector<T>& z, const char* name)
{
    std::vector<T> g(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        g[i] = (x[i] > y[i]) ? static_cast<T>(1) : static_cast<T>(0);
    }
    print_tensor(x, "X       ");
    print_tensor(y, "Y       ");
    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");
    save_csv(x, y, z, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        if (z[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] x=";
            print_val(x[idx], std::cout);
            std::cout << " y=";
            print_val(y[idx], std::cout);
            std::cout << " output=";
            print_val(z[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_gt 寄存器级大于比较测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "输出: (x > y) ? 1 : 0" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * GT_HALF_TILE;
        std::vector<half> x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<half>(i * 0.05f);
            y[i] = static_cast<half>((N - i) * 0.05f);
        }
        auto z = launch_gt<half>(x, y, gt_kernel_half);
        verify_gt(x, y, z, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * GT_FLOAT_TILE;
        std::vector<float> x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = i * 0.05f;
            y[i] = (N - i) * 0.05f;
        }
        auto z = launch_gt<float>(x, y, gt_kernel_float);
        verify_gt(x, y, z, "float");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * GT_INT32_TILE;
        std::vector<int32_t> x(N), y(N);
        for (uint32_t i = 0; i < N; ++i) {
            x[i] = static_cast<int32_t>(i * 2);
            y[i] = static_cast<int32_t>(1000 - static_cast<int32_t>(i));
        }
        auto z = launch_gt<int32_t>(x, y, gt_kernel_int32);
        verify_gt(x, y, z, "int32_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_gt 示例测试结束。" << std::endl;
    return 0;
}
