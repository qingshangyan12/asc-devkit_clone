/* ==========================================================================
 * Host 侧通用启动函数
 * ========================================================================== */

template<typename T>
std::vector<T> launch_mul(std::vector<T>& x, std::vector<T>& y,
    void (*kernel)(__gm__ T*, __gm__ T*, __gm__ T*),
    uint32_t numBlocks)
{
    uint32_t totalLength = x.size();
    size_t byteSize = totalLength * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* zHost = nullptr;
    T *xD = nullptr, *yD = nullptr, *zD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&zHost, byteSize);
    aclrtMalloc((void**)&xD, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yD, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)xD, byteSize, xHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)yD, byteSize, yHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<numBlocks, nullptr, stream>>>(xD, yD, zD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, byteSize, (uint8_t*)zD, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + byteSize));

    aclrtFree(xD); aclrtFree(yD); aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return z;
}

template<typename T>
bool check_mul(std::vector<T>& out, std::vector<T>& golden, const char* name)
{
    bool ok = std::equal(golden.begin(), golden.end(), out.begin());
    std::cout << "  [" << name << "] " << (ok ? "通过" : "失败") << std::endl;
    return ok;
}

/* --------------------------------------------------------------------------
 * 各类型测试
 * -------------------------------------------------------------------------- */

bool test_mul_half()
{
    constexpr uint32_t N = NUM_BLOCKS * MUL_HALF_TILE;
    std::vector<half> x(N), y(N);
    for (uint32_t i = 0; i < N; ++i) {
        x[i] = static_cast<half>(1.0f + i * 0.01f);
        y[i] = static_cast<half>(2.0f);
    }
    auto out = launch_mul<half>(x, y, mul_kernel_half, NUM_BLOCKS);
    std::vector<half> g(N);
    for (uint32_t i = 0; i < N; ++i)
        g[i] = static_cast<half>(static_cast<float>(x[i]) * static_cast<float>(y[i]));
    return check_mul(out, g, "half");
}

bool test_mul_float()
{
    constexpr uint32_t N = NUM_BLOCKS * MUL_FLOAT_TILE;
    std::vector<float> x(N), y(N);
    for (uint32_t i = 0; i < N; ++i) { x[i] = 1.5f + i * 0.01f; y[i] = 3.0f; }
    auto out = launch_mul<float>(x, y, mul_kernel_float, NUM_BLOCKS);
    std::vector<float> g(N);
    for (uint32_t i = 0; i < N; ++i) g[i] = x[i] * y[i];
    return check_mul(out, g, "float");
}

bool test_mul_int32()
{
    constexpr uint32_t N = NUM_BLOCKS * MUL_INT32_TILE;
    std::vector<int32_t> x(N), y(N);
    for (uint32_t i = 0; i < N; ++i) { x[i] = (int32_t)(i + 1); y[i] = 3; }
    auto out = launch_mul<int32_t>(x, y, mul_kernel_int32, NUM_BLOCKS);
    std::vector<int32_t> g(N);
    for (uint32_t i = 0; i < N; ++i) g[i] = x[i] * y[i];
    return check_mul(out, g, "int32_t");
}

bool test_mul_bfloat16()
{
    constexpr uint32_t N = NUM_BLOCKS * MUL_BF16_TILE;
    std::vector<bfloat16_t> x(N), y(N);
    for (uint32_t i = 0; i < N; ++i) {
        x[i] = bfloat16_t(2.0f + i * 0.01f);
        y[i] = bfloat16_t(1.5f);
    }
    auto out = launch_mul<bfloat16_t>(x, y, mul_kernel_bfloat16, NUM_BLOCKS);
    std::vector<bfloat16_t> g(N);
    for (uint32_t i = 0; i < N; ++i)
        g[i] = bfloat16_t(float(x[i]) * float(y[i]));
    return check_mul(out, g, "bfloat16_t");
}

bool test_mul_int16()
{
    constexpr uint32_t N = NUM_BLOCKS * MUL_INT16_TILE;
    std::vector<int16_t> x(N), y(N);
    for (uint32_t i = 0; i < N; ++i) { x[i] = (int16_t)((i % 100) + 1); y[i] = 2; }
    auto out = launch_mul<int16_t>(x, y, mul_kernel_int16, NUM_BLOCKS);
    std::vector<int16_t> g(N);
    for (uint32_t i = 0; i < N; ++i) g[i] = x[i] * y[i];
    return check_mul(out, g, "int16_t");
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_mul 寄存器级矢量乘法测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    bool ok = true;
    ok &= test_mul_half();
    ok &= test_mul_float();
    ok &= test_mul_int32();
    ok &= test_mul_bfloat16();
    ok &= test_mul_int16();

    std::cout << std::endl;
    std::cout << (ok ? "[全部通过] asc_mul 所有类型测试通过。" : "[存在失败] 部分测试未通过！") << std::endl;
    return ok ? 0 : 1;
}
