/* --------------------------------------------------------------------------
 * int16_t 类型乘法 Kernel (VL=128)
 * -------------------------------------------------------------------------- */

constexpr uint32_t MUL_INT16_VL = 128;
constexpr uint32_t MUL_INT16_TILE = MUL_INT16_VL * 4;

__vector__ __global__ __aicore__ void mul_kernel_int16(
    __gm__ int16_t* x, __gm__ int16_t* y, __gm__ int16_t* z)
{
