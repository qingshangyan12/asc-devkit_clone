/* !
 * \file c_api_mul.asc
 * \brief asc_mul 寄存器级矢量乘法示例
 *
 * 覆盖数据类型: half, float, int32_t, uint32_t, int16_t, uint16_t, bfloat16_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量乘法函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void MulVF_half(__ubuf__ half* xLocal, __ubuf__ half* yLocal,
                                    __ubuf__ half* zLocal, uint32_t blockLen)
{
    vector_half vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_mul(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void MulVF_float(__ubuf__ float* xLocal, __ubuf__ float* yLocal,
                                     __ubuf__ float* zLocal, uint32_t blockLen)
{
    vector_float vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 64;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_mul(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void MulVF_int32(__ubuf__ int32_t* xLocal, __ubuf__ int32_t* yLocal,
                                     __ubuf__ int32_t* zLocal, uint32_t blockLen)
{
    vector_int32_t vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 64;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_mul(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void MulVF_bfloat16(__ubuf__ bfloat16_t* xLocal, __ubuf__ bfloat16_t* yLocal,
                                        __ubuf__ bfloat16_t* zLocal, uint32_t blockLen)
{
    vector_bfloat16_t vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_mul(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

__simd_vf__ inline void MulVF_int16(__ubuf__ int16_t* xLocal, __ubuf__ int16_t* yLocal,
                                     __ubuf__ int16_t* zLocal, uint32_t blockLen)
{
    vector_int16_t vx, vy, vz;
    vector_bool vmask;
    constexpr uint32_t VL = 128;
    for (uint32_t i = 0; i < blockLen; i += VL) {
        uint32_t curLen = (i + VL <= blockLen) ? VL : (blockLen - i);
        vmask = asc_update_mask_b32(curLen);
        asc_load(vx, xLocal + i);
        asc_load(vy, yLocal + i);
        asc_mul(vz, vx, vy, vmask);
        asc_store(zLocal + i, vz, vmask);
    }
}

/* --------------------------------------------------------------------------
 * half 类型乘法 Kernel (VL=128)
 * -------------------------------------------------------------------------- */

constexpr uint32_t MUL_HALF_VL = 128;
constexpr uint32_t MUL_HALF_TILE = MUL_HALF_VL * 4;

__vector__ __global__ __aicore__ void mul_kernel_half(
    __gm__ half* x, __gm__ half* y, __gm__ half* z)
{
    asc_init();

    __ubuf__ half xLocal[MUL_HALF_TILE];
    __ubuf__ half yLocal[MUL_HALF_TILE];
    __ubuf__ half zLocal[MUL_HALF_TILE];

    uint32_t blockLen = MUL_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)xLocal, (__gm__ void*)(x + offset), blockLen * sizeof(half));
    asc_copy_gm2ub_sync((__ubuf__ void*)yLocal, (__gm__ void*)(y + offset), blockLen * sizeof(half));

    MulVF_half(xLocal, yLocal, zLocal, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(z + offset), (__ubuf__ void*)zLocal, blockLen * sizeof(half));
}

/* --------------------------------------------------------------------------
 * float 类型乘法 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t MUL_FLOAT_VL = 64;
constexpr uint32_t MUL_FLOAT_TILE = MUL_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void mul_kernel_float(
    __gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();

    __ubuf__ float xLocal[MUL_FLOAT_TILE];
    __ubuf__ float yLocal[MUL_FLOAT_TILE];
    __ubuf__ float zLocal[MUL_FLOAT_TILE];

    uint32_t blockLen = MUL_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    uint32_t offset  = asc_get_block_idx() * blockLen;

    asc_copy_gm2ub_sync((__ubuf__ void*)xLocal, (__gm__ void*)(x + offset), blockLen * sizeof(float));
    asc_copy_gm2ub_sync((__ubuf__ void*)yLocal, (__gm__ void*)(y + offset), blockLen * sizeof(float));

    MulVF_float(xLocal, yLocal, zLocal, blockLen);

    asc_copy_ub2gm_sync((__gm__ void*)(z + offset), (__ubuf__ void*)zLocal, blockLen * sizeof(float));
}

