/* !
 * \file c_api_arange.asc
 * \brief asc_arange 寄存器级范围生成示例
 *
 * asc_arange 用指定起始值填充矢量寄存器为递增序列
 *
 * 覆盖数据类型: int32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级范围生成函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void ArangeVF_int32(__ubuf__ int32_t* buf, int32_t start,
                                        uint32_t blockLen)
{
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        int32_t curStart = start + static_cast<int32_t>(i * one_rep_size);
        vector_bool vmask = asc_update_mask_b32(remaining);
        vector_int32_t vd;
        asc_arange(vd, curStart);
        asc_storealign(buf + i * one_rep_size, vd, vmask);
    }
}

/* --------------------------------------------------------------------------
 * int32_t Kernel (VL=64)
 * -------------------------------------------------------------------------- */
constexpr uint32_t ARANGE_INT32_VL  = 256 / sizeof(int32_t);
constexpr uint32_t ARANGE_INT32_TILE = ARANGE_INT32_VL * 4;

__vector__ __global__ __aicore__ void arange_kernel_int32(
    __gm__ int32_t* output, int32_t start)
{
    asc_init();
    uint32_t blockLen = ARANGE_INT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int32_t local[ARANGE_INT32_TILE];
    int32_t blockStart = start + static_cast<int32_t>(get_block_idx() * blockLen);
    ArangeVF_int32(local, blockStart, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)outGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    asc_copy_ub2gm_align(outGm, (__ubuf__ int32_t*)local, BLK_NUM, burstLength,
                          cacheMode, 0, 0);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_arange(uint32_t N, T start, KernelFunc kernel)
{
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* outHost = nullptr;
    T *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&outD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(outD, start);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));

    aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
void save_csv(const std::vector<T>& output, const std::vector<T>& golden,
              const std::string& name)
{
    std::string fname = "arange_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,output,expected\n";
    for (size_t i = 0; i < output.size(); ++i) {
        f << i << "," << output[i] << "," << golden[i] << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_arange(std::vector<T>& out, T start, bool per_block, const char* name)
{
    std::vector<T> g(out.size());
    if (per_block) {
        uint32_t blockLen = out.size() / NUM_BLOCKS;
        for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
            T blockStart = start + static_cast<T>(b * blockLen);
            for (uint32_t i = 0; i < blockLen; ++i) {
                g[b * blockLen + i] = blockStart + static_cast<T>(i);
            }
        }
    } else {
        for (size_t i = 0; i < out.size(); ++i) {
            g[i] = start + static_cast<T>(i);
        }
    }

    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");

    save_csv(out, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < out.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << out[idx]
                      << " expected=" << g[idx] << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_arange 测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * ARANGE_INT32_TILE;
        int32_t start = 0;
        auto out = launch_arange<int32_t>(N, start, arange_kernel_int32);
        verify_arange(out, start, false, "int32_t_ascend");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_arange 示例测试结束。" << std::endl;
    return 0;
}
