/* --------------------------------------------------------------------------
 * int32_t unsqueeze Kernel (VL=64)
 * -------------------------------------------------------------------------- */
constexpr uint32_t USQ_INT32_VL = 256 / sizeof(int32_t);
constexpr uint32_t USQ_INT32_TILE = USQ_INT32_VL * 4;

__vector__ __global__ __aicore__ void unsqueeze_kernel_int32(
    __gm__ int32_t* input, __gm__ int32_t* output)
{
    asc_init();
    uint32_t blockLen = USQ_INT32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ int32_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int32_t srcLocal[USQ_INT32_TILE];
    __ubuf__ int32_t dstLocal[USQ_INT32_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int32_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ int32_t*)srcLocal, inGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    UnsqueezeVF_int32(srcLocal, dstLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ int32_t*)dstLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_unsqueeze(std::vector<T>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& input, const std::vector<T>& output,
              const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "unsqueeze_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_unsqueeze(std::vector<T>& out, std::vector<T>& in, const char* name)
{
    // Ground truth: squeeze→unsqueeze round-trip with all-1s mask restores original
    std::vector<T> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = in[i];
    }

    print_tensor(in,  "Input   ");
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");

    save_csv(in, out, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] input=";
            print_val(in[idx], std::cout);
            std::cout << " output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_unsqueeze 寄存器级条件展开测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << "说明: 先 squeeze 压缩, 再 unsqueeze 展开, 验证往返结果" << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    {
        constexpr uint32_t N = NUM_BLOCKS * USQ_INT8_TILE;
        std::vector<int8_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int8_t>((i % 2 == 0) ? (i % 127) : -(i % 127));
        auto out = launch_unsqueeze<int8_t>(in, unsqueeze_kernel_int8);
        allPass &= verify_unsqueeze(out, in, "int8_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * USQ_INT16_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>((i % 2 == 0) ? (i % 1000) : -(i % 1000));
        auto out = launch_unsqueeze<int16_t>(in, unsqueeze_kernel_int16);
        allPass &= verify_unsqueeze(out, in, "int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * USQ_INT32_TILE;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? static_cast<int32_t>(i * 10) : -static_cast<int32_t>(i * 10);
        auto out = launch_unsqueeze<int32_t>(in, unsqueeze_kernel_int32);
        allPass &= verify_unsqueeze(out, in, "int32_t");
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[完成] asc_unsqueeze 示例测试全部通过。" << std::endl;
    } else {
        std::cout << "[完成] asc_unsqueeze 示例测试存在失败项。" << std::endl;
    }
    return allPass ? 0 : 1;
}
