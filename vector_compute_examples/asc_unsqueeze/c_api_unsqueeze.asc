/* !
 * \file c_api_unsqueeze.asc
 * \brief asc_unsqueeze 寄存器级条件展开示例
 *
 * asc_unsqueeze 是 squeeze 的逆操作，从内部压缩寄存器中恢复元素
 * asc_unsqueeze(dst, mask) 不接收源矢量, 而是读取前一次 squeeze 写入的压缩状态
 * 本测试通过 squeeze → unsqueeze 往返验证展开结果的正确性
 *
 * 覆盖数据类型: int8_t, int16_t, int32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"

// CANN 9.0.0-beta.2 type stubs
struct fp8_e4m3fn_t { unsigned char __val; };
struct fp8_e5m2_t { unsigned char __val; };
struct fp8_e8m0_t { unsigned char __val; };
struct fp4x2_e1m2_t { unsigned char __val; };
struct fp4x2_e2m1_t { unsigned char __val; };
struct int4b_t { unsigned char __val; };

#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量 squeeze → unsqueeze 往返函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void UnsqueezeVF_int8(__ubuf__ int8_t* srcLocal,
                                          __ubuf__ int8_t* dstLocal,
                                          uint32_t blockLen)
{
    vector_int8_t vsrc, vtmp, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int8_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b8(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vtmp, vsrc, vmask);
        asc_unsqueeze(vdst, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
        remaining = (remaining > one_rep_size) ? remaining - one_rep_size : 0;
    }
}

__simd_vf__ inline void UnsqueezeVF_int16(__ubuf__ int16_t* srcLocal,
                                           __ubuf__ int16_t* dstLocal,
                                           uint32_t blockLen)
{
    vector_int16_t vsrc, vtmp, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int16_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vtmp, vsrc, vmask);
        asc_unsqueeze(vdst, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
        remaining = (remaining > one_rep_size) ? remaining - one_rep_size : 0;
    }
}

__simd_vf__ inline void UnsqueezeVF_int32(__ubuf__ int32_t* srcLocal,
                                           __ubuf__ int32_t* dstLocal,
                                           uint32_t blockLen)
{
    vector_int32_t vsrc, vtmp, vdst;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;

    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, srcLocal + i * one_rep_size);
        asc_squeeze(vtmp, vsrc, vmask);
        asc_unsqueeze(vdst, vmask);
        asc_storealign(dstLocal + i * one_rep_size, vdst, vmask);
        remaining = (remaining > one_rep_size) ? remaining - one_rep_size : 0;
    }
}

/* --------------------------------------------------------------------------
 * int8_t unsqueeze Kernel (VL=256)
 * -------------------------------------------------------------------------- */
constexpr uint32_t USQ_INT8_VL = 256 / sizeof(int8_t);
constexpr uint32_t USQ_INT8_TILE = USQ_INT8_VL * 4;

__vector__ __global__ __aicore__ void unsqueeze_kernel_int8(
    __gm__ int8_t* input, __gm__ int8_t* output)
{
    asc_init();
    uint32_t blockLen = USQ_INT8_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int8_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ int8_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int8_t srcLocal[USQ_INT8_TILE];
    __ubuf__ int8_t dstLocal[USQ_INT8_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int8_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;

    asc_copy_gm2ub_align((__ubuf__ int8_t*)srcLocal, inGm, BLK_NUM, burstLength,
                          0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    UnsqueezeVF_int8(srcLocal, dstLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ int8_t*)dstLocal, BLK_NUM, burstLength,
                          cacheMode, srcStride, dstStride);
}

