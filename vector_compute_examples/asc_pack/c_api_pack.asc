/* !
 * \file c_api_pack.asc
 * \brief asc_pack 寄存器级矢量压缩示例
 *
 * asc_pack 将宽类型元素压缩到窄类型 (取低位)
 * asc_pack_v2 取高位
 *
 * 覆盖数据类型: int16_t->uint8_t, uint16_t->uint8_t, int32_t->uint16_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量压缩函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void PackVF_int16u8(__ubuf__ int16_t* src, __ubuf__ uint8_t* dst,
                                        uint32_t blockLen, bool upper)
{
    vector_int16_t vsrc;
    vector_bool vmask;
    uint16_t src_rep = 256 / sizeof(int16_t); // 128 int16 per rep
    uint16_t rep = (blockLen + src_rep - 1) / src_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, src + i * src_rep);
        vector_uint8_t vdst;
        if (upper) {
            asc_pack_v2(vdst, vsrc);
        } else {
            asc_pack(vdst, vsrc);
        }
        uint32_t out_remaining = src_rep;
        vector_bool vmaskOut = asc_update_mask_b8(out_remaining);
        asc_storealign(dst + i * src_rep, vdst, vmaskOut);
    }
}

__simd_vf__ inline void PackVF_uint16u8(__ubuf__ uint16_t* src, __ubuf__ uint8_t* dst,
                                         uint32_t blockLen, bool upper)
{
    vector_uint16_t vsrc;
    vector_bool vmask;
    uint16_t src_rep = 256 / sizeof(uint16_t);
    uint16_t rep = (blockLen + src_rep - 1) / src_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, src + i * src_rep);
        vector_uint8_t vdst;
        if (upper) {
            asc_pack_v2(vdst, vsrc);
        } else {
            asc_pack(vdst, vsrc);
        }
        uint32_t out_remaining = src_rep;
        vector_bool vmaskOut = asc_update_mask_b8(out_remaining);
        asc_storealign(dst + i * src_rep, vdst, vmaskOut);
    }
}

__simd_vf__ inline void PackVF_int32u16(__ubuf__ int32_t* src, __ubuf__ uint16_t* dst,
                                         uint32_t blockLen, bool upper)
{
    vector_int32_t vsrc;
    vector_bool vmask;
    uint16_t src_rep = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + src_rep - 1) / src_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, src + i * src_rep);
        vector_uint16_t vdst;
        if (upper) {
            asc_pack_v2(vdst, vsrc);
        } else {
            asc_pack(vdst, vsrc);
        }
        uint32_t out_remaining = src_rep;
        vector_bool vmaskOut = asc_update_mask_b16(out_remaining);
        asc_storealign(dst + i * src_rep, vdst, vmaskOut);
    }
}

/* --------------------------------------------------------------------------
 * int16_t -> uint8_t Kernel
 * -------------------------------------------------------------------------- */
constexpr uint32_t PACK_I16_VL = 256 / sizeof(int16_t);
constexpr uint32_t PACK_I16_TILE = PACK_I16_VL * 4;

__vector__ __global__ __aicore__ void pack_kernel_int16u8(
    __gm__ int16_t* input, __gm__ uint8_t* output, int32_t upper_flag)
{
    asc_init();
    uint32_t blockLen = PACK_I16_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int16_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ uint8_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int16_t srcLocal[PACK_I16_TILE];
    __ubuf__ uint8_t dstLocal[PACK_I16_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLengthIn = blockLen * sizeof(int16_t);
    uint32_t burstLengthOut = blockLen * sizeof(uint8_t);

    asc_copy_gm2ub_align((__ubuf__ int16_t*)srcLocal, inGm, BLK_NUM, burstLengthIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    PackVF_int16u8(srcLocal, dstLocal, blockLen, upper_flag != 0);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ uint8_t*)dstLocal, BLK_NUM, burstLengthOut,
                          cacheMode, 0, 0);
}

/* --------------------------------------------------------------------------
 * uint16_t -> uint8_t Kernel
 * -------------------------------------------------------------------------- */
constexpr uint32_t PACK_U16_VL = 256 / sizeof(uint16_t);
constexpr uint32_t PACK_U16_TILE = PACK_U16_VL * 4;

__vector__ __global__ __aicore__ void pack_kernel_uint16u8(
    __gm__ uint16_t* input, __gm__ uint8_t* output, int32_t upper_flag)
{
    asc_init();
    uint32_t blockLen = PACK_U16_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ uint16_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ uint8_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ uint16_t srcLocal[PACK_U16_TILE];
    __ubuf__ uint8_t dstLocal[PACK_U16_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLengthIn = blockLen * sizeof(uint16_t);
    uint32_t burstLengthOut = blockLen * sizeof(uint8_t);

    asc_copy_gm2ub_align((__ubuf__ uint16_t*)srcLocal, inGm, BLK_NUM, burstLengthIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    PackVF_uint16u8(srcLocal, dstLocal, blockLen, upper_flag != 0);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ uint8_t*)dstLocal, BLK_NUM, burstLengthOut,
                          cacheMode, 0, 0);
}

/* --------------------------------------------------------------------------
 * int32_t -> uint16_t Kernel
 * -------------------------------------------------------------------------- */
constexpr uint32_t PACK_I32_VL = 256 / sizeof(int32_t);
constexpr uint32_t PACK_I32_TILE = PACK_I32_VL * 4;

__vector__ __global__ __aicore__ void pack_kernel_int32u16(
    __gm__ int32_t* input, __gm__ uint16_t* output, int32_t upper_flag)
{
    asc_init();
    uint32_t blockLen = PACK_I32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ uint16_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int32_t srcLocal[PACK_I32_TILE];
    __ubuf__ uint16_t dstLocal[PACK_I32_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLengthIn = blockLen * sizeof(int32_t);
    uint32_t burstLengthOut = blockLen * sizeof(uint16_t);

    asc_copy_gm2ub_align((__ubuf__ int32_t*)srcLocal, inGm, BLK_NUM, burstLengthIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    PackVF_int32u16(srcLocal, dstLocal, blockLen, upper_flag != 0);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ uint16_t*)dstLocal, BLK_NUM, burstLengthOut,
                          cacheMode, 0, 0);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename TSrc, typename TDst, typename KernelFunc>
std::vector<TDst> launch_pack(std::vector<TSrc>& in, bool upper, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytesIn = N * sizeof(TSrc);
    size_t bytesOut = N * sizeof(TDst);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    TSrc *inD = nullptr;
    TDst *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytesOut);
    aclrtMalloc((void**)&inD,  bytesIn,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytesOut, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytesIn, inHost, bytesIn, ACL_MEMCPY_HOST_TO_DEVICE);

    int32_t uflag = upper ? 1 : 0;
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD, uflag);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytesOut, (uint8_t*)outD, bytesOut, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<TDst> out((TDst*)outHost, (TDst*)(outHost + bytesOut));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, uint8_t> || std::is_same_v<T, int8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename TSrc, typename TDst>
void save_csv(const std::vector<TSrc>& input, const std::vector<TDst>& output,
              const std::vector<TDst>& golden, const std::string& name)
{
    std::string fname = "pack_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 16;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename TSrc, typename TDst>
bool verify_pack(std::vector<TDst>& out, std::vector<TSrc>& in,
                 bool upper, const char* name)
{
    std::vector<TDst> g(in.size());
    int shiftBits = upper ? (sizeof(TSrc) * 4) : 0;
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = static_cast<TDst>((static_cast<uint64_t>(in[i]) >> shiftBits) & 0xFF);
    }

    print_tensor(in,  "Input   ");
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");

    save_csv(in, out, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] input=";
            print_val(in[idx], std::cout);
            std::cout << " output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_pack / asc_pack_v2 测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I16_VL;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>(i * 7 + 1);
        auto out = launch_pack<int16_t, uint8_t>(in, false, pack_kernel_int16u8);
        verify_pack(in, out, false, "int16_t_lower");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_U16_VL;
        std::vector<uint16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<uint16_t>(i * 13 + 5);
        auto out = launch_pack<uint16_t, uint8_t>(in, false, pack_kernel_uint16u8);
        verify_pack(in, out, false, "uint16_t_lower");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I32_VL;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int32_t>(i * 11 + 3);
        auto out = launch_pack<int32_t, uint16_t>(in, false, pack_kernel_int32u16);
        verify_pack(in, out, false, "int32_t_lower");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I16_VL;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>(i * 7 + 1);
        auto out = launch_pack<int16_t, uint8_t>(in, true, pack_kernel_int16u8);
        verify_pack(in, out, true, "int16_t_higher");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I32_VL;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int32_t>(i * 11 + 3);
        auto out = launch_pack<int32_t, uint16_t>(in, true, pack_kernel_int32u16);
        verify_pack(in, out, true, "int32_t_higher");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_pack 示例测试结束。" << std::endl;
    return 0;
}
