/* !
 * \file c_api_leakyrelu.asc
 * \brief asc_leakyrelu 寄存器级 LeakyReLU 激活函数示例
 *        dst = max(src, src * alpha), alpha = 0.01
 *
 * 覆盖数据类型: half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;
constexpr float LEAKYRELU_ALPHA_F = 0.01f;

__simd_vf__ inline void LeakyReluVF_half(__ubuf__ half* buf, uint32_t blockLen)
{
    vector_half v;
    vector_bool vmask;
    half alpha = static_cast<half>(LEAKYRELU_ALPHA_F);
    uint16_t one_rep_size = 256 / sizeof(half);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(v, buf + i * one_rep_size);
        asc_leakyrelu(v, v, alpha, vmask);
        asc_storealign(buf + i * one_rep_size, v, vmask);
    }
}

__simd_vf__ inline void LeakyReluVF_float(__ubuf__ float* buf, uint32_t blockLen)
{
    vector_float v;
    vector_bool vmask;
    float alpha = LEAKYRELU_ALPHA_F;
    uint16_t one_rep_size = 256 / sizeof(float);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(v, buf + i * one_rep_size);
        asc_leakyrelu(v, v, alpha, vmask);
        asc_storealign(buf + i * one_rep_size, v, vmask);
    }
}

/* --------------------------------------------------------------------------
 * half Kernel (VL=128)
 * -------------------------------------------------------------------------- */
constexpr uint32_t LEAKYRELU_HALF_VL = 128;
constexpr uint32_t LEAKYRELU_HALF_TILE = LEAKYRELU_HALF_VL * 4;

__vector__ __global__ __aicore__ void leakyrelu_kernel_half(
    __gm__ half* input, __gm__ half* output)
{
    asc_init();
    uint32_t blockLen = LEAKYRELU_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ half* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ half* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ half local[LEAKYRELU_HALF_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ half*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    LeakyReluVF_half(local, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ half*)local, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* --------------------------------------------------------------------------
 * float Kernel (VL=64)
 * -------------------------------------------------------------------------- */
constexpr uint32_t LEAKYRELU_FLOAT_VL = 64;
constexpr uint32_t LEAKYRELU_FLOAT_TILE = LEAKYRELU_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void leakyrelu_kernel_float(
    __gm__ float* input, __gm__ float* output)
{
    asc_init();
    uint32_t blockLen = LEAKYRELU_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* inputGm  = input  + get_block_idx() * blockLen;
    __gm__ float* outputGm = output + get_block_idx() * blockLen;
    __ubuf__ float local[LEAKYRELU_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inputGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)local, inputGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    LeakyReluVF_float(local, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(outputGm, (__ubuf__ float*)local, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_leakyrelu(std::vector<T>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    T *inD = nullptr, *outD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&outHost, bytes);
    aclrtMalloc((void**)&inD,  bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)inD, bytes, inHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outHost, bytes, (uint8_t*)outD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> out((T*)outHost, (T*)(outHost + bytes));
    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv(const std::vector<T>& input, const std::vector<T>& output,
              const std::vector<T>& golden, const std::string& name)
{
    std::string fname = "leakyrelu_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
T host_leakyrelu(T val, float alpha)
{
    if constexpr (std::is_same_v<T, half>) {
        float fv = static_cast<float>(val);
        float r = (fv > 0.0f) ? fv : (fv * alpha);
        return static_cast<half>(r);
    } else {
        return (val > static_cast<T>(0)) ? val : static_cast<T>(val * alpha);
    }
}

template<typename T>
bool verify_leakyrelu(std::vector<T>& out, std::vector<T>& in, const char* name)
{
    std::vector<T> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = host_leakyrelu(in[i], LEAKYRELU_ALPHA_F);
    }
    print_tensor(in,  "Input   ");
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");
    save_csv(in, out, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if constexpr (std::is_same_v<T, half>) {
            float diff = std::abs(static_cast<float>(out[i]) - static_cast<float>(g[i]));
            if (diff > 1e-3f) {
                ok = false;
                errIdx.push_back(i);
            }
        } else {
            if (out[i] != g[i]) {
                ok = false;
                errIdx.push_back(i);
            }
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size() << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr)
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr) << " 个错误)" << std::endl;
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_leakyrelu 寄存器级 LeakyReLU 测试 (alpha=" << LEAKYRELU_ALPHA_F << ") ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * LEAKYRELU_HALF_TILE;
        std::vector<half> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<half>((i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f));
        auto out = launch_leakyrelu<half>(in, leakyrelu_kernel_half);
        verify_leakyrelu(out, in, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * LEAKYRELU_FLOAT_TILE;
        std::vector<float> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = (i % 2 == 0) ? (i * 0.01f) : -(i * 0.01f);
        auto out = launch_leakyrelu<float>(in, leakyrelu_kernel_float);
        verify_leakyrelu(out, in, "float");
    }
    std::cout << std::endl;
    std::cout << "[完成] asc_leakyrelu 示例测试结束。" << std::endl;
    return 0;
}
