/* !
 * \file error.asc
 * \brief 汇总 C API 测试中遇到的典型错误场景
 *
 * 场景 1: __simd_vf__ 中使用 C++ 模板  -> 编译错误
 *         "simd_vf function can only call simd_callee function"
 *
 * 场景 2: asc_arange 测试 half/float 类型 -> 后端崩溃
 *         "fatal error: error in backend: Unsupported Inst must be hoisted"
 *
 * 场景 3: asc_pack 精度错误 -> 编译通过但输出错误
 *         vpack LOWER/HIGHER 与 asc_storealign 掩码交互导致
 *         输出值未截断, 或缓冲越界覆盖
 *
 * 文件编译后可运行场景 3 验证精度错误。场景 1/2 用 #if 0 保护,
 * 仅作参考文档。
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* ==========================================================================
 * 场景 1: __simd_vf__ 中使用 C++ 模板  (编译错误)
 *
 * 错误信息:
 *   error: no matching function for call to 'ArangeVF'
 *   note: candidate function not viable:
 *         simd_vf function can only call simd_callee function
 *
 * 原因: __simd_vf__ 标记的函数只能调用 __simd_callee__ 标记的函数
 *       (即底层 intrinsic), 不允许调用其他 __simd_vf__ 函数,
 *       也不允许使用 C++ 模板在 __simd_vf__ 上下文中产生多态。
 *
 * 下面的代码会触发该错误:
 * ========================================================================== */

#if 0
// --- 错误写法: __simd_vf__ 模板函数 ---
template<typename T>
__simd_vf__ inline void ArangeVF(__ubuf__ T* buf, T start,
                                  uint32_t blockLen, bool descend)
{
    uint16_t one_rep_size = 256 / sizeof(T);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        T curStart = descend ? static_cast<T>(start - static_cast<T>(i * one_rep_size))
                             : static_cast<T>(start + static_cast<T>(i * one_rep_size));
        vector_bool vmask = asc_update_mask_b32(remaining);

        // if constexpr 在 __simd_vf__ 中展开会触发多个函数调用路径,
        // 编译器报错 "simd_vf function can only call simd_callee function"
        if constexpr (sizeof(T) == 1) {
            vector_int8_t vd;
            if (descend) {
                asc_arange_descend(vd, static_cast<int8_t>(curStart));
            } else {
                asc_arange(vd, static_cast<int8_t>(curStart));
            }
            asc_storealign(buf + i * one_rep_size, vd, vmask);
        } else if constexpr (sizeof(T) == 2) {
            if constexpr (std::is_same_v<T, half>) {
                vector_half vd;
                if (descend) {
                    asc_arange_descend(vd, curStart);
                } else {
                    asc_arange(vd, curStart);
                }
                asc_storealign(buf + i * one_rep_size, vd, vmask);
            } else {
                vector_int16_t vd;
                if (descend) {
                    asc_arange_descend(vd, static_cast<int16_t>(curStart));
                } else {
                    asc_arange(vd, static_cast<int16_t>(curStart));
                }
                asc_storealign(buf + i * one_rep_size, vd, vmask);
            }
        } else if constexpr (sizeof(T) == 4) {
            if constexpr (std::is_same_v<T, float>) {
                vector_float vd;
                if (descend) {
                    asc_arange_descend(vd, curStart);
                } else {
                    asc_arange(vd, curStart);
                }
                asc_storealign(buf + i * one_rep_size, vd, vmask);
            } else {
                vector_int32_t vd;
                if (descend) {
                    asc_arange_descend(vd, static_cast<int32_t>(curStart));
                } else {
                    asc_arange(vd, static_cast<int32_t>(curStart));
                }
                asc_storealign(buf + i * one_rep_size, vd, vmask);
            }
        }
    }
}

// --- 正确写法: 为每种类型编写独立 per-type VF 函数 ---
__simd_vf__ inline void ArangeVF_int32(__ubuf__ int32_t* buf, int32_t start,
                                        uint32_t blockLen)
{
    uint16_t one_rep_size = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        int32_t curStart = start + static_cast<int32_t>(i * one_rep_size);
        vector_bool vmask = asc_update_mask_b32(remaining);
        vector_int32_t vd;
        asc_arange(vd, curStart);
        asc_storealign(buf + i * one_rep_size, vd, vmask);
    }
}
#endif


/* ==========================================================================
 * 场景 2: asc_arange 测试 half/float 类型 (后端崩溃)
 *
 * 错误信息:
 *   fatal error: error in backend: Unsupported Inst must be hoisted.
 *   c_api_arange.asc:0:0 in ArangeVF_half / arange_kernel_half
 *
 * 原因: 在 dav-3510 sim 仿真模式下, vci (vector constant initialize)
 *       指令对 half/float 类型的支持不完整, bisheng 编译器后端崩溃。
 *       int8_t/int16_t/int32_t 类型的 arange 可正常编译运行。
 *
 * 下面的 VF 函数和 kernel 会触发该崩溃:
 * ========================================================================== */

#if 0
// --- 触发后端崩溃的 half arange VF ---
__simd_vf__ inline void ArangeVF_half(__ubuf__ half* buf, half start,
                                       uint32_t blockLen)
{
    uint16_t one_rep_size = 256 / sizeof(half);  // 128
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        half curStart = start + static_cast<half>(i * one_rep_size);
        vector_bool vmask = asc_update_mask_b16(remaining);
        vector_half vd;
        asc_arange(vd, curStart);    // <-- 后端崩溃点
        asc_storealign(buf + i * one_rep_size, vd, vmask);
    }
}

// --- 触发后端崩溃的 float arange VF ---
__simd_vf__ inline void ArangeVF_float(__ubuf__ float* buf, float start,
                                        uint32_t blockLen)
{
    uint16_t one_rep_size = 256 / sizeof(float);  // 64
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        float curStart = start + static_cast<float>(i * one_rep_size);
        vector_bool vmask = asc_update_mask_b32(remaining);
        vector_float vd;
        asc_arange(vd, curStart);    // <-- 后端崩溃点
        asc_storealign(buf + i * one_rep_size, vd, vmask);
    }
}

// --- 触发崩溃的 kernel ---
constexpr uint32_t ARANGE_HALF_VL  = 256 / sizeof(half);
constexpr uint32_t ARANGE_HALF_TILE = ARANGE_HALF_VL * 4;

__vector__ __global__ __aicore__ void arange_kernel_half(
    __gm__ half* output, half start)
{
    asc_init();
    uint32_t blockLen = ARANGE_HALF_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ half* outGm = output + get_block_idx() * blockLen;
    __ubuf__ half local[ARANGE_HALF_TILE];
    ArangeVF_half(local, start, blockLen);
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)outGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(half);
    asc_copy_ub2gm_align(outGm, (__ubuf__ half*)local, BLK_NUM, burstLength,
                          cacheMode, 0, 0);
}
#endif


/* ==========================================================================
 * 场景 3: asc_pack 精度错误 (编译通过, 运行输出错误)
 *
 * 现象:
 *   - asc_pack(vdst, vsrc) 从 vector_int16_t 压缩到 vector_uint8_t 时,
 *     预期结果取每个 int16 的低 8 位, 但实际输出值等于输入值 (未截断).
 *   - asc_pack_v2(HIGHER) 测试中输出全为零 (实际应为高 8 位).
 *     疑似 asc_storealign 掩码与 vector_uint8_t 寄存器写入粒度不匹配,
 *     导致缓冲越界覆盖.
 *
 * 下面的代码编译通过, 但运行后精度验证失败:
 * ========================================================================== */

/* ---------- VF 函数 ---------- */

__simd_vf__ inline void PackVF_int16u8(__ubuf__ int16_t* src, __ubuf__ uint8_t* dst,
                                        uint32_t blockLen, bool upper)
{
    vector_int16_t vsrc;
    vector_bool vmask;
    uint16_t src_rep = 256 / sizeof(int16_t);  // 128 int16 per rep
    uint16_t rep = (blockLen + src_rep - 1) / src_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, src + i * src_rep);
        vector_uint8_t vdst;
        if (upper) {
            asc_pack_v2(vdst, vsrc);
        } else {
            asc_pack(vdst, vsrc);
        }
        // NOTE: 此处的掩码切换是疑点 —
        // asc_update_mask_b16 生成 128 个 16 位元素掩码 (控制 256B 的 int16 寄存器),
        // asc_update_mask_b8  生成 128 个  8 位元素掩码 (控制 128B 的 uint8 寄存器),
        // 两者覆盖的数据量不同, 可能导致 asc_storealign 写多/写少
        uint32_t out_remaining = src_rep;
        vector_bool vmaskOut = asc_update_mask_b8(out_remaining);
        asc_storealign(dst + i * src_rep, vdst, vmaskOut);
    }
}

__simd_vf__ inline void PackVF_int32u16(__ubuf__ int32_t* src, __ubuf__ uint16_t* dst,
                                         uint32_t blockLen, bool upper)
{
    vector_int32_t vsrc;
    vector_bool vmask;
    uint16_t src_rep = 256 / sizeof(int32_t);  // 64 int32 per rep
    uint16_t rep = (blockLen + src_rep - 1) / src_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign(vsrc, src + i * src_rep);
        vector_uint16_t vdst;
        if (upper) {
            asc_pack_v2(vdst, vsrc);
        } else {
            asc_pack(vdst, vsrc);
        }
        uint32_t out_remaining = src_rep;
        vector_bool vmaskOut = asc_update_mask_b16(out_remaining);
        asc_storealign(dst + i * src_rep, vdst, vmaskOut);
    }
}

/* ---------- Kernel ---------- */

constexpr uint32_t PACK_I16_VL = 256 / sizeof(int16_t);   // 128
constexpr uint32_t PACK_I16_TILE = PACK_I16_VL * 4;       // 512
constexpr uint32_t PACK_I32_VL = 256 / sizeof(int32_t);   // 64
constexpr uint32_t PACK_I32_TILE = PACK_I32_VL * 4;       // 256

__vector__ __global__ __aicore__ void pack_kernel_int16u8(
    __gm__ int16_t* input, __gm__ uint8_t* output, int32_t upper_flag)
{
    asc_init();
    uint32_t blockLen = PACK_I16_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int16_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ uint8_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int16_t srcLocal[PACK_I16_TILE];
    __ubuf__ uint8_t dstLocal[PACK_I16_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstIn  = blockLen * sizeof(int16_t);
    uint32_t burstOut = blockLen * sizeof(uint8_t);

    asc_copy_gm2ub_align((__ubuf__ int16_t*)srcLocal, inGm, BLK_NUM, burstIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    PackVF_int16u8(srcLocal, dstLocal, blockLen, upper_flag != 0);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ uint8_t*)dstLocal, BLK_NUM, burstOut,
                          cacheMode, 0, 0);
}

__vector__ __global__ __aicore__ void pack_kernel_int32u16(
    __gm__ int32_t* input, __gm__ uint16_t* output, int32_t upper_flag)
{
    asc_init();
    uint32_t blockLen = PACK_I32_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int32_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ uint16_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int32_t srcLocal[PACK_I32_TILE];
    __ubuf__ uint16_t dstLocal[PACK_I32_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstIn  = blockLen * sizeof(int32_t);
    uint32_t burstOut = blockLen * sizeof(uint16_t);

    asc_copy_gm2ub_align((__ubuf__ int32_t*)srcLocal, inGm, BLK_NUM, burstIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    PackVF_int32u16(srcLocal, dstLocal, blockLen, upper_flag != 0);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ uint16_t*)dstLocal, BLK_NUM, burstOut,
                          cacheMode, 0, 0);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename TSrc, typename TDst, typename KernelFunc>
std::vector<TDst> launch_pack(std::vector<TSrc>& in, bool upper, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytesIn = N * sizeof(TSrc);
    size_t bytesOut = N * sizeof(TDst);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    TSrc *inD = nullptr;
    TDst *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytesOut);
    aclrtMalloc((void**)&inD,  bytesIn,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytesOut, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytesIn, inHost, bytesIn, ACL_MEMCPY_HOST_TO_DEVICE);

    int32_t uflag = upper ? 1 : 0;
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD, uflag);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytesOut, (uint8_t*)outD, bytesOut, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<TDst> out((TDst*)outHost, (TDst*)(outHost + bytesOut));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, uint8_t> || std::is_same_v<T, int8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename TSrc, typename TDst>
void save_csv(const std::vector<TSrc>& input, const std::vector<TDst>& output,
              const std::vector<TDst>& golden, const std::string& name)
{
    std::string fname = "error_pack_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 16;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename TSrc, typename TDst>
bool verify_pack_error(std::vector<TDst>& out, std::vector<TSrc>& in,
                       bool upper, const char* name)
{
    int shiftBits = upper ? (sizeof(TSrc) * 4) : 0;
    std::vector<TDst> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = static_cast<TDst>((static_cast<uint64_t>(in[i]) >> shiftBits) & 0xFF);
    }

    print_tensor(in,  "Input   ");
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");

    save_csv(in, out, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] input=";
            print_val(in[idx], std::cout);
            std::cout << " output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "========================================================" << std::endl;
    std::cout << "  C API Error Cases — 精度错误场景复现" << std::endl;
    std::cout << "========================================================" << std::endl;
    std::cout << std::endl;
    std::cout << "本文件汇总以下错误场景:" << std::endl;
    std::cout << std::endl;
    std::cout << "  场景 1: __simd_vf__ 中使用 C++ 模板" << std::endl;
    std::cout << "    -> 编译错误 (代码用 #if 0 保护, 见文件头部)" << std::endl;
    std::cout << std::endl;
    std::cout << "  场景 2: asc_arange 使用 half/float 类型" << std::endl;
    std::cout << "    -> 后端崩溃 'Unsupported Inst must be hoisted'" << std::endl;
    std::cout << "    -> (代码用 #if 0 保护, 见文件中段)" << std::endl;
    std::cout << std::endl;
    std::cout << "  场景 3: asc_pack 精度错误 (可运行)" << std::endl;
    std::cout << "    -> 编译通过但输出值未正确截断到窄类型" << std::endl;
    std::cout << std::endl;
    std::cout << "========================================================" << std::endl;
    std::cout << std::endl;

    std::cout << ">>> 场景 3: asc_pack int16_t->uint8_t (LOWER) <<<" << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I16_VL;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>(i * 7 + 1);
        auto out = launch_pack<int16_t, uint8_t>(in, false, pack_kernel_int16u8);
        verify_pack_error(in, out, false, "int16u8_lower");
    }

    std::cout << std::endl;
    std::cout << ">>> 场景 3: asc_pack int32_t->uint16_t (LOWER) <<<" << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I32_VL;
        std::vector<int32_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int32_t>(i * 11 + 3);
        auto out = launch_pack<int32_t, uint16_t>(in, false, pack_kernel_int32u16);
        verify_pack_error(in, out, false, "int32u16_lower");
    }

    std::cout << std::endl;
    std::cout << ">>> 场景 3: asc_pack_v2 int16_t->uint8_t (HIGHER) <<<" << std::endl;
    std::cout << "  (注意: 高 8 位均为 0, 预期全零; 若输出非零则有缓冲污染)" << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * PACK_I16_VL;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>(i * 7 + 1);
        auto out = launch_pack<int16_t, uint8_t>(in, true, pack_kernel_int16u8);
        verify_pack_error(in, out, true, "int16u8_higher");
    }

    std::cout << std::endl;
    std::cout << "[完成] error_cases 运行结束。" << std::endl;
    return 0;
}
