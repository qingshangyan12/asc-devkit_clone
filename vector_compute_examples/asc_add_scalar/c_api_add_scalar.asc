/* --------------------------------------------------------------------------
 * int8_t 类型标量加法 Kernel (VL=256)
 * -------------------------------------------------------------------------- */

constexpr uint32_t ADS_INT8_VL = 256;
constexpr uint32_t ADS_INT8_TILE = ADS_INT8_VL * 4;

__vector__ __global__ __aicore__ void addscalar_kernel_int8(__gm__ int8_t* x, __gm__ int8_t* z)
{
    asc_init();
    int8_t value = static_cast<int8_t>(10);
    uint32_t blockLen = ADS_INT8_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int8_t* xGm = x + get_block_idx() * blockLen;
    __gm__ int8_t* zGm = z + get_block_idx() * blockLen;
    __ubuf__ int8_t buf[ADS_INT8_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(int8_t);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ int8_t*)buf, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    AddScalarVF_int8(buf, value, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ int8_t*)buf, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

