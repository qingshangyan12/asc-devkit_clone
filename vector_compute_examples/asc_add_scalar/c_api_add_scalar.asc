/* --------------------------------------------------------------------------
 * float 类型标量加法 Kernel (VL=64)
 * -------------------------------------------------------------------------- */

constexpr uint32_t ADS_FLOAT_VL = 64;
constexpr uint32_t ADS_FLOAT_TILE = ADS_FLOAT_VL * 4;

__vector__ __global__ __aicore__ void addscalar_kernel_float(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    float value = 0.5f;
    uint32_t blockLen = ADS_FLOAT_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ float* xGm = x + get_block_idx() * blockLen;
    __gm__ float* zGm = z + get_block_idx() * blockLen;
    __ubuf__ float buf[ADS_FLOAT_TILE];
    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)xGm) >> 60);
    uint32_t burstLength = blockLen * sizeof(float);
    uint64_t srcStride = 0; uint32_t dstStride = 0;
    asc_copy_gm2ub_align((__ubuf__ float*)buf, xGm, BLK_NUM, burstLength, 0, 0, true, cacheMode, srcStride, dstStride);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    AddScalarVF_float(buf, value, blockLen);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(zGm, (__ubuf__ float*)buf, BLK_NUM, burstLength, cacheMode, srcStride, dstStride);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename T, typename KernelFunc>
std::vector<T> launch_addscalar(std::vector<T>& x, KernelFunc kernel)
{
    uint32_t N = x.size();
    size_t bytes = N * sizeof(T);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* zHost = nullptr;
    T *xD = nullptr, *zD = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&zHost, bytes);
    aclrtMalloc((void**)&xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)xD, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<NUM_BLOCKS, nullptr, stream>>>(xD, zD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, bytes, (uint8_t*)zD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<T> z((T*)zHost, (T*)(zHost + bytes));
    aclrtFree(xD); aclrtFree(zD);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();
    return z;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename T>
void save_csv_ads(const std::vector<T>& x, const std::vector<T>& z,
                  const std::vector<T>& g, const std::string& name)
{
    std::string fname = "add_scalar_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,x,output,expected\n";
    for (size_t i = 0; i < x.size(); ++i) {
        f << i << ",";
        print_val(x[i], f);
        f << ",";
        print_val(z[i], f);
        f << ",";
        print_val(g[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename T>
bool verify_addscalar_int(std::vector<T>& z, std::vector<T>& x, T value, const char* name)
{
    std::vector<T> g(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        g[i] = static_cast<T>(x[i] + value);
    }
    print_tensor(x, "Input   ");
    std::cout << "  Value: " << static_cast<int>(value) << std::endl;
    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");
    save_csv_ads(x, z, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        if (z[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << static_cast<int>(z[idx])
                      << " expected=" << static_cast<int>(g[idx]) << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

template<typename T>
bool verify_addscalar_float(std::vector<T>& z, std::vector<T>& x,
                             float value, const char* name, float rtol = 1e-3f)
{
    std::vector<T> g(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        g[i] = static_cast<T>(static_cast<float>(x[i]) + value);
    }
    print_tensor(x, "Input   ");
    std::cout << "  Value: " << value << std::endl;
    print_tensor(z, "Output  ");
    print_tensor(g, "Expected");
    save_csv_ads(x, z, g, name);
    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < x.size(); ++i) {
        float diff = std::fabs(static_cast<float>(z[i]) - static_cast<float>(g[i]));
        if (diff > rtol) {
            ok = false;
            errIdx.push_back(i);
        }
    }
    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << static_cast<float>(z[idx])
                      << " expected=" << static_cast<float>(g[idx]) << std::endl;
        }
        return false;
    }
    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_add_scalar 寄存器级标量加法测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * ADS_INT8_TILE;
        std::vector<int8_t> x(N);
        for (uint32_t i = 0; i < N; ++i) x[i] = static_cast<int8_t>(i % 50);
        auto z = launch_addscalar<int8_t>(x, addscalar_kernel_int8);
        verify_addscalar_int(z, x, static_cast<int8_t>(10), "int8_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ADS_INT16_TILE;
        std::vector<int16_t> x(N);
        for (uint32_t i = 0; i < N; ++i) x[i] = static_cast<int16_t>(i % 500);
        auto z = launch_addscalar<int16_t>(x, addscalar_kernel_int16);
        verify_addscalar_int(z, x, static_cast<int16_t>(100), "int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ADS_INT32_TILE;
        std::vector<int32_t> x(N);
        for (uint32_t i = 0; i < N; ++i) x[i] = static_cast<int32_t>(i % 5000);
        auto z = launch_addscalar<int32_t>(x, addscalar_kernel_int32);
        verify_addscalar_int(z, x, static_cast<int32_t>(1000), "int32_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ADS_HALF_TILE;
        std::vector<half> x(N);
        for (uint32_t i = 0; i < N; ++i) x[i] = static_cast<half>(static_cast<float>(i) * 0.1f);
        auto z = launch_addscalar<half>(x, addscalar_kernel_half);
        verify_addscalar_float(z, x, 0.5f, "half");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * ADS_FLOAT_TILE;
        std::vector<float> x(N);
        for (uint32_t i = 0; i < N; ++i) x[i] = static_cast<float>(i) * 0.01f;
        auto z = launch_addscalar<float>(x, addscalar_kernel_float);
        verify_addscalar_float(z, x, 0.5f, "float");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_add_scalar 示例测试结束。" << std::endl;
    return 0;
}
