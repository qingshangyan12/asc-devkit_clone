/* !
 * \file c_api_add_scalar.asc
 * \brief asc_add_scalar 寄存器级标量加法示例
 *
 * 对向量每个元素加上标量值: dst[i] = src[i] + value
 * 覆盖数据类型: int8_t, int16_t, int32_t, half, float
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级标量加法函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void AddScalarVF_int8(__ubuf__ int8_t* buf, int8_t value, uint32_t blockLen)
{
    vector_int8_t v;
    vector_bool vmask;
    uint16_t one_rep_size = 256 / sizeof(int8_t);
    uint16_t rep = (blockLen + one_rep_size - 1) / one_rep_size;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b8(remaining);
        asc_loadalign(v, buf + i * one_rep_size);
        asc_add_scalar(v, v, value, vmask);
        asc_storealign(buf + i * one_rep_size, v, vmask);
    }
}

__simd_vf__ inline void AddScalarVF_int16(__ubuf__ int16_t* buf, int16_t value, uint32_t blockLen)
{
    vector_int16_t v;
    vector_bool vmask;
