/* !
 * \file c_api_unpack_lower.asc
 * \brief asc_unpack_lower 寄存器级矢量解压缩示例
 *
 * asc_unpack_lower 将窄类型元素解压为宽类型 (取 low 半区)
 * asc_unpack_upper 取 high 半区
 *
 * 覆盖数据类型: int8_t->int16_t, uint8_t->uint16_t, int16_t->int32_t
 * 覆盖场景: 多核
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

/* --------------------------------------------------------------------------
 * __simd_vf__ Reg 级矢量解压缩函数
 * -------------------------------------------------------------------------- */

__simd_vf__ inline void UnpackVF_int8_full(__ubuf__ int8_t* src, __ubuf__ int16_t* dst,
                                            uint32_t blockLen)
{
    vector_int8_t vsrc;
    vector_bool vmask;
    uint16_t src_per_rep = 256 / sizeof(int8_t);
    uint16_t dst_per_rep = 256 / sizeof(int16_t);
    uint16_t rep = (blockLen + src_per_rep - 1) / src_per_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b8(remaining);
        asc_loadalign(vsrc, src + i * src_per_rep);
        vector_int16_t vlow, vhigh;
        asc_unpack_lower(vlow, vsrc);
        asc_unpack_upper(vhigh, vsrc);
        uint32_t off_low = i * 2 * dst_per_rep;
        uint32_t off_high = off_low + dst_per_rep;

        uint32_t low_remaining = dst_per_rep;
        uint32_t high_remaining = dst_per_rep;
        vector_bool vmaskLow  = asc_update_mask_b16(low_remaining);
        vector_bool vmaskHigh = asc_update_mask_b16(high_remaining);
        asc_storealign(dst + off_low, vlow, vmaskLow);
        asc_storealign(dst + off_high, vhigh, vmaskHigh);
    }
}

__simd_vf__ inline void UnpackVF_uint8_full(__ubuf__ uint8_t* src, __ubuf__ uint16_t* dst,
                                             uint32_t blockLen)
{
    vector_uint8_t vsrc;
    vector_bool vmask;
    uint16_t src_per_rep = 256 / sizeof(uint8_t);
    uint16_t dst_per_rep = 256 / sizeof(uint16_t);
    uint16_t rep = (blockLen + src_per_rep - 1) / src_per_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b8(remaining);
        asc_loadalign(vsrc, src + i * src_per_rep);
        vector_uint16_t vlow, vhigh;
        asc_unpack_lower(vlow, vsrc);
        asc_unpack_upper(vhigh, vsrc);
        uint32_t off_low = i * 2 * dst_per_rep;
        uint32_t off_high = off_low + dst_per_rep;

        uint32_t low_remaining = dst_per_rep;
        uint32_t high_remaining = dst_per_rep;
        vector_bool vmaskLow  = asc_update_mask_b16(low_remaining);
        vector_bool vmaskHigh = asc_update_mask_b16(high_remaining);
        asc_storealign(dst + off_low, vlow, vmaskLow);
        asc_storealign(dst + off_high, vhigh, vmaskHigh);
    }
}

__simd_vf__ inline void UnpackVF_int16_full(__ubuf__ int16_t* src, __ubuf__ int32_t* dst,
                                             uint32_t blockLen)
{
    vector_int16_t vsrc;
    vector_bool vmask;
    uint16_t src_per_rep = 256 / sizeof(int16_t);
    uint16_t dst_per_rep = 256 / sizeof(int32_t);
    uint16_t rep = (blockLen + src_per_rep - 1) / src_per_rep;
    uint32_t remaining = blockLen;
    for (uint16_t i = 0; i < rep; ++i) {
        vmask = asc_update_mask_b16(remaining);
        asc_loadalign(vsrc, src + i * src_per_rep);
        vector_int32_t vlow, vhigh;
        asc_unpack_lower(vlow, vsrc);
        asc_unpack_upper(vhigh, vsrc);
        uint32_t off_low = i * 2 * dst_per_rep;
        uint32_t off_high = off_low + dst_per_rep;

        uint32_t low_remaining = dst_per_rep;
        uint32_t high_remaining = dst_per_rep;
        vector_bool vmaskLow  = asc_update_mask_b32(low_remaining);
        vector_bool vmaskHigh = asc_update_mask_b32(high_remaining);
        asc_storealign(dst + off_low, vlow, vmaskLow);
        asc_storealign(dst + off_high, vhigh, vmaskHigh);
    }
}

/* --------------------------------------------------------------------------
 * int8_t -> int16_t Kernel
 * -------------------------------------------------------------------------- */
constexpr uint32_t UNPACK_I8_SRC_VL = 256 / sizeof(int8_t);
constexpr uint32_t UNPACK_I8_SRC_TILE = UNPACK_I8_SRC_VL * 4;
constexpr uint32_t UNPACK_I8_DST_TILE = UNPACK_I8_SRC_TILE;

__vector__ __global__ __aicore__ void unpack_kernel_int8(
    __gm__ int8_t* input, __gm__ int16_t* output)
{
    asc_init();
    uint32_t blockLen = UNPACK_I8_SRC_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int8_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ int16_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int8_t srcLocal[UNPACK_I8_SRC_TILE];
    __ubuf__ int16_t dstLocal[UNPACK_I8_DST_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLengthIn = blockLen * sizeof(int8_t);
    uint32_t burstLengthOut = blockLen * sizeof(int16_t);

    asc_copy_gm2ub_align((__ubuf__ int8_t*)srcLocal, inGm, BLK_NUM, burstLengthIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    UnpackVF_int8_full(srcLocal, dstLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ int16_t*)dstLocal, BLK_NUM, burstLengthOut,
                          cacheMode, 0, 0);
}

/* --------------------------------------------------------------------------
 * uint8_t -> uint16_t Kernel
 * -------------------------------------------------------------------------- */
constexpr uint32_t UNPACK_U8_SRC_VL = 256 / sizeof(uint8_t);
constexpr uint32_t UNPACK_U8_SRC_TILE = UNPACK_U8_SRC_VL * 4;
constexpr uint32_t UNPACK_U8_DST_TILE = UNPACK_U8_SRC_TILE;

__vector__ __global__ __aicore__ void unpack_kernel_uint8(
    __gm__ uint8_t* input, __gm__ uint16_t* output)
{
    asc_init();
    uint32_t blockLen = UNPACK_U8_SRC_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ uint8_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ uint16_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ uint8_t srcLocal[UNPACK_U8_SRC_TILE];
    __ubuf__ uint16_t dstLocal[UNPACK_U8_DST_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLengthIn = blockLen * sizeof(uint8_t);
    uint32_t burstLengthOut = blockLen * sizeof(uint16_t);

    asc_copy_gm2ub_align((__ubuf__ uint8_t*)srcLocal, inGm, BLK_NUM, burstLengthIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    UnpackVF_uint8_full(srcLocal, dstLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ uint16_t*)dstLocal, BLK_NUM, burstLengthOut,
                          cacheMode, 0, 0);
}

/* --------------------------------------------------------------------------
 * int16_t -> int32_t Kernel
 * -------------------------------------------------------------------------- */
constexpr uint32_t UNPACK_I16_SRC_VL = 256 / sizeof(int16_t);
constexpr uint32_t UNPACK_I16_SRC_TILE = UNPACK_I16_SRC_VL * 4;
constexpr uint32_t UNPACK_I16_DST_TILE = UNPACK_I16_SRC_TILE;

__vector__ __global__ __aicore__ void unpack_kernel_int16(
    __gm__ int16_t* input, __gm__ int32_t* output)
{
    asc_init();
    uint32_t blockLen = UNPACK_I16_SRC_TILE * NUM_BLOCKS / asc_get_block_num();
    __gm__ int16_t* inGm  = input  + get_block_idx() * blockLen;
    __gm__ int32_t* outGm = output + get_block_idx() * blockLen;
    __ubuf__ int16_t srcLocal[UNPACK_I16_SRC_TILE];
    __ubuf__ int32_t dstLocal[UNPACK_I16_DST_TILE];

    const uint8_t cacheMode = static_cast<uint8_t>(((uint64_t)inGm) >> 60);
    uint32_t burstLengthIn = blockLen * sizeof(int16_t);
    uint32_t burstLengthOut = blockLen * sizeof(int32_t);

    asc_copy_gm2ub_align((__ubuf__ int16_t*)srcLocal, inGm, BLK_NUM, burstLengthIn,
                          0, 0, true, cacheMode, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    UnpackVF_int16_full(srcLocal, dstLocal, blockLen);

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(outGm, (__ubuf__ int32_t*)dstLocal, BLK_NUM, burstLengthOut,
                          cacheMode, 0, 0);
}

/* ==========================================================================
 * Host 侧
 * ========================================================================== */

template<typename TSrc, typename TDst, typename KernelFunc>
std::vector<TDst> launch_unpack(std::vector<TSrc>& in, KernelFunc kernel)
{
    uint32_t N = in.size();
    size_t bytesIn = N * sizeof(TSrc);
    size_t bytesOut = N * sizeof(TDst);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t* inHost = reinterpret_cast<uint8_t*>(in.data());
    uint8_t* outHost = nullptr;
    TSrc *inD = nullptr;
    TDst *outD = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&outHost, bytesOut);
    aclrtMalloc((void**)&inD,  bytesIn,  ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outD, bytesOut, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)inD, bytesIn, inHost, bytesIn, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<NUM_BLOCKS, nullptr, stream>>>(inD, outD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, bytesOut, (uint8_t*)outD, bytesOut, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<TDst> out((TDst*)outHost, (TDst*)(outHost + bytesOut));

    aclrtFree(inD); aclrtFree(outD);
    aclrtFreeHost(outHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

template<typename T>
void print_val(T val, std::ostream& os)
{
    if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else {
        os << val;
    }
}

template<typename TSrc, typename TDst>
void save_csv(const std::vector<TSrc>& input, const std::vector<TDst>& output,
              const std::vector<TDst>& golden, const std::string& name)
{
    std::string fname = "unpack_lower_" + name + ".csv";
    std::ofstream f(fname);
    f << "index,input,output,expected\n";
    for (size_t i = 0; i < input.size(); ++i) {
        f << i << ",";
        print_val(input[i], f);
        f << ",";
        print_val(output[i], f);
        f << ",";
        print_val(golden[i], f);
        f << "\n";
    }
    f.close();
    std::cout << "  [CSV] 已保存到 " << fname << std::endl;
}

template<typename T>
void print_tensor(const std::vector<T>& t, const std::string& name)
{
    constexpr size_t maxPrint = 16;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        print_val(t[i], std::cout);
        std::cout << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

template<typename TSrc, typename TDst>
bool verify_unpack(std::vector<TDst>& out, std::vector<TSrc>& in, const char* name)
{
    std::vector<TDst> g(in.size());
    for (size_t i = 0; i < in.size(); ++i) {
        g[i] = static_cast<TDst>(in[i]);
    }

    print_tensor(in,  "Input   ");
    print_tensor(out, "Output  ");
    print_tensor(g,   "Expected");

    save_csv(in, out, g, name);

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < in.size(); ++i) {
        if (out[i] != g[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] 精度错误: " << errIdx.size()
                  << " 个元素不匹配" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] input=";
            print_val(in[idx], std::cout);
            std::cout << " output=";
            print_val(out[idx], std::cout);
            std::cout << " expected=";
            print_val(g[idx], std::cout);
            std::cout << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (还有 " << (errIdx.size() - maxErr)
                      << " 个错误)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] 通过" << std::endl;
    return true;
}

/* ==========================================================================
 * main
 * ========================================================================== */

int32_t main(int32_t argc, char* argv[])
{
    std::cout << "=== asc_unpack_lower / asc_unpack_upper 测试 ===" << std::endl;
    std::cout << "模式: 多核 (" << NUM_BLOCKS << " blocks)" << std::endl;
    std::cout << std::endl;

    {
        constexpr uint32_t N = NUM_BLOCKS * UNPACK_I8_SRC_TILE;
        std::vector<int8_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int8_t>((i % 2 == 0) ? (i % 127) : -(i % 127));
        auto out = launch_unpack<int8_t, int16_t>(in, unpack_kernel_int8);
        verify_unpack(in, out, "int8_t->int16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * UNPACK_U8_SRC_TILE;
        std::vector<uint8_t> in(N);
        for (uint32_t i = 0; i < N; ++i) in[i] = static_cast<uint8_t>(i % 256);
        auto out = launch_unpack<uint8_t, uint16_t>(in, unpack_kernel_uint8);
        verify_unpack(in, out, "uint8_t->uint16_t");
    }
    std::cout << std::endl;
    {
        constexpr uint32_t N = NUM_BLOCKS * UNPACK_I16_SRC_TILE;
        std::vector<int16_t> in(N);
        for (uint32_t i = 0; i < N; ++i)
            in[i] = static_cast<int16_t>((i % 2 == 0) ? (i % 1000) : -(i % 1000));
        auto out = launch_unpack<int16_t, int32_t>(in, unpack_kernel_int16);
        verify_unpack(in, out, "int16_t->int32_t");
    }

    std::cout << std::endl;
    std::cout << "[完成] asc_unpack_lower 示例测试结束。" << std::endl;
    return 0;
}
