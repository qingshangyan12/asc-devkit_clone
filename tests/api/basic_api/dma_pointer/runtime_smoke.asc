#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "acl/acl.h"

#include <cerrno>
#include <climits>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace {
constexpr uint32_t INPUT_WORDS = 2080;
constexpr uint32_t OUTPUT_WORDS = 4160;
constexpr uint32_t INNER_OFFSET = 8;
constexpr uint32_t RESULT_OFFSET = INPUT_WORDS + 8;
constexpr uint32_t LENGTHS[] = {1, 5, 8, 16, 20, 31, 32, 59, 1024, 2048};
constexpr uint32_t CANARY = 0x5a36c97b;
constexpr uint32_t PAD_VALUE = 0x3f1279ab;

template <typename D, typename S>
__aicore__ inline void CopyInput(D&& dst, S&& src, uint32_t length, bool padded)
{
    if (padded) {
        const AscendC::DataCopyExtParams params{1, length * static_cast<uint32_t>(sizeof(uint32_t)), 0, 0, 0};
        const AscendC::DataCopyPadExtParams<uint32_t> pad{
            true, 0, static_cast<uint8_t>((8 - length % 8) % 8), PAD_VALUE};
        AscendC::DataCopyPad(dst, src, params, pad);
    } else {
        AscendC::DataCopy(dst, src, length);
    }
}

template <typename D, typename S>
__aicore__ inline void CopyOutput(D&& dst, S&& src, uint32_t length, bool padded)
{
    if (padded) {
        const AscendC::DataCopyExtParams params{1, length * static_cast<uint32_t>(sizeof(uint32_t)), 0, 0, 0};
        AscendC::DataCopyPad(dst, src, params);
    } else {
        AscendC::DataCopy(dst, src, length);
    }
}
} // namespace

__global__ __aicore__ void DmaPointerRuntime(
    __gm__ uint32_t* input, __gm__ uint32_t* guards, __gm__ uint32_t* output, uint32_t length, uint32_t form,
    bool padded)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::InitSocState();
    __ubuf__ uint32_t storage[INPUT_WORDS];
    AscendC::LocalTensor<uint32_t> local(
        AscendC::TPosition::VECIN, static_cast<uint32_t>(reinterpret_cast<uint64_t>(storage)), INPUT_WORDS);
    AscendC::GlobalTensor<uint32_t> inputTensor;
    AscendC::GlobalTensor<uint32_t> guardTensor;
    AscendC::GlobalTensor<uint32_t> outputTensor;
    inputTensor.SetGlobalBuffer(input, INPUT_WORDS);
    guardTensor.SetGlobalBuffer(guards, INPUT_WORDS);
    outputTensor.SetGlobalBuffer(output, OUTPUT_WORDS);
    AscendC::DataCopy(local, guardTensor, INPUT_WORDS);
    // Guard initialization and the input transfer write overlapping UB regions.
    AscendC::PipeBarrier<PIPE_MTE2>();
    auto inner = local[INNER_OFFSET];
    auto outputInner = outputTensor[RESULT_OFFSET];
    if (form == 0) {
        CopyInput(inner, inputTensor, length, padded);
    } else if (form == 1) {
        CopyInput(storage + INNER_OFFSET, input, length, padded);
    } else if (form == 2) {
        CopyInput(inner, input, length, padded);
    } else {
        CopyInput(storage + INNER_OFFSET, inputTensor, length, padded);
    }
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(0);
    AscendC::DataCopy(outputTensor, local, INPUT_WORDS);
    if (form == 0) {
        CopyOutput(outputInner, inner, length, padded);
    } else if (form == 1) {
        CopyOutput(output + RESULT_OFFSET, storage + INNER_OFFSET, length, padded);
    } else if (form == 2) {
        CopyOutput(outputInner, storage + INNER_OFFSET, length, padded);
    } else {
        CopyOutput(output + RESULT_OFFSET, inner, length, padded);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

namespace {
bool CheckAcl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL_FAILURE operation=%s code=%d\n", operation, result);
    return false;
}

struct Runtime {
    aclrtStream stream = nullptr;
    uint32_t* input = nullptr;
    uint32_t* guards = nullptr;
    uint32_t* output = nullptr;
    int32_t device = 0;
    bool initialized = false;
    bool deviceSet = false;

    bool Open(int32_t selectedDevice)
    {
        device = selectedDevice;
        initialized = CheckAcl(aclInit(nullptr), "aclInit");
        if (!initialized) {
            return false;
        }
        deviceSet = CheckAcl(aclrtSetDevice(device), "aclrtSetDevice");
        return deviceSet && CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") &&
               CheckAcl(
                   aclrtMalloc(
                       reinterpret_cast<void**>(&input), INPUT_WORDS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST),
                   "aclrtMalloc(input)") &&
               CheckAcl(
                   aclrtMalloc(
                       reinterpret_cast<void**>(&guards), INPUT_WORDS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST),
                   "aclrtMalloc(guards)") &&
               CheckAcl(
                   aclrtMalloc(
                       reinterpret_cast<void**>(&output), OUTPUT_WORDS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST),
                   "aclrtMalloc(output)");
    }

    bool Close()
    {
        bool ok = true;
        if (stream != nullptr) {
            ok = CheckAcl(aclrtSynchronizeStream(stream), "cleanup synchronize") && ok;
        }
        if (output != nullptr) {
            ok = CheckAcl(aclrtFree(output), "aclrtFree(output)") && ok;
        }
        if (guards != nullptr) {
            ok = CheckAcl(aclrtFree(guards), "aclrtFree(guards)") && ok;
        }
        if (input != nullptr) {
            ok = CheckAcl(aclrtFree(input), "aclrtFree(input)") && ok;
        }
        if (stream != nullptr) {
            ok = CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream") && ok;
        }
        if (deviceSet) {
            ok = CheckAcl(aclrtResetDevice(device), "aclrtResetDevice") && ok;
        }
        if (initialized) {
            ok = CheckAcl(aclFinalize(), "aclFinalize") && ok;
        }
        return ok;
    }
};

void BuildExpected(const uint32_t* inputs, uint32_t* expected, uint32_t length, bool padded)
{
    for (uint32_t i = 0; i < OUTPUT_WORDS; ++i) {
        expected[i] = CANARY;
    }
    const uint32_t copied = padded ? length : (length / 8) * 8;
    for (uint32_t i = 0; i < copied; ++i) {
        expected[INNER_OFFSET + i] = inputs[i];
        expected[RESULT_OFFSET + i] = inputs[i];
    }
    if (padded) {
        const uint32_t right = (8 - length % 8) % 8;
        for (uint32_t i = 0; i < right; ++i) {
            expected[INNER_OFFSET + length + i] = PAD_VALUE;
        }
    }
}

bool RunOne(
    Runtime& runtime, const uint32_t* expected, uint32_t* baseline, uint32_t round, uint32_t length, bool padded,
    uint32_t form)
{
    uint32_t outputs[OUTPUT_WORDS];
    for (uint32_t i = 0; i < OUTPUT_WORDS; ++i) {
        outputs[i] = CANARY;
    }
    if (!CheckAcl(
            aclrtMemcpy(runtime.output, sizeof(outputs), outputs, sizeof(outputs), ACL_MEMCPY_HOST_TO_DEVICE),
            "initialize output")) {
        return false;
    }
    DmaPointerRuntime<<<1, nullptr, runtime.stream>>>(
        runtime.input, runtime.guards, runtime.output, length, form, padded);
    if (!CheckAcl(aclrtSynchronizeStream(runtime.stream), "kernel synchronize") ||
        !CheckAcl(
            aclrtMemcpy(outputs, sizeof(outputs), runtime.output, sizeof(outputs), ACL_MEMCPY_DEVICE_TO_HOST),
            "read output")) {
        return false;
    }
    for (uint32_t i = 0; i < OUTPUT_WORDS; ++i) {
        if (outputs[i] != expected[i] || (form != 0 && outputs[i] != baseline[i])) {
            std::fprintf(
                stderr, "FAIL round=%u length=%u pad=%u form=%u index=%u expected=%08x actual=%08x\n", round, length,
                static_cast<uint32_t>(padded), form, i, expected[i], outputs[i]);
            return false;
        }
        if (form == 0) {
            baseline[i] = outputs[i];
        }
    }
    std::printf(
        "PASS round=%u length=%u pad=%u form=%u words=%u\n", round, length, static_cast<uint32_t>(padded), form,
        OUTPUT_WORDS);
    return true;
}

bool RunCases(Runtime& runtime)
{
    uint32_t inputs[INPUT_WORDS];
    uint32_t guards[INPUT_WORDS];
    uint32_t expected[OUTPUT_WORDS];
    uint32_t baseline[OUTPUT_WORDS];
    for (uint32_t round = 0; round < 3; ++round) {
        for (uint32_t i = 0; i < INPUT_WORDS; ++i) {
            inputs[i] = (round + 1) * 0x10203u + i * 37u;
            guards[i] = CANARY;
        }
        if (!CheckAcl(
                aclrtMemcpy(runtime.input, sizeof(inputs), inputs, sizeof(inputs), ACL_MEMCPY_HOST_TO_DEVICE),
                "copy input") ||
            !CheckAcl(
                aclrtMemcpy(runtime.guards, sizeof(guards), guards, sizeof(guards), ACL_MEMCPY_HOST_TO_DEVICE),
                "copy guards")) {
            return false;
        }
        for (uint32_t length : LENGTHS) {
            for (uint32_t padded = 0; padded < 2; ++padded) {
                BuildExpected(inputs, expected, length, padded != 0);
                for (uint32_t form = 0; form < 4; ++form) {
                    if (!RunOne(runtime, expected, baseline, round, length, padded != 0, form)) {
                        return false;
                    }
                }
            }
        }
    }
    return true;
}
} // namespace

int main(int argc, char** argv)
{
    if (argc != 3 || std::strcmp(argv[1], "--device") != 0) {
        std::fprintf(stderr, "Usage: %s --device DEVICE_ID\n", argv[0]);
        return 2;
    }
    char* end = nullptr;
    errno = 0;
    const long device = std::strtol(argv[2], &end, 10);
    if (errno != 0 || end == argv[2] || *end != '\0' || device < 0 || device > INT_MAX) {
        std::fprintf(stderr, "Invalid device ID\n");
        return 2;
    }
    Runtime runtime;
    const bool passed = runtime.Open(static_cast<int32_t>(device)) && RunCases(runtime);
    const bool clean = runtime.Close();
    if (!passed || !clean) {
        return 1;
    }
    std::printf("ALL_PASS cases=240 comparison=exact_u32_with_canaries_and_tensor_diff\n");
    return 0;
}
