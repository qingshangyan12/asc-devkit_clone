#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_cache_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "acl/acl.h"

#include <cerrno>
#include <climits>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace {
constexpr uint32_t INPUT_WORDS = 16;
constexpr uint32_t OUTPUT_WORDS = 24;
constexpr uint64_t CANARY = 0x5a36c97b2854a10full;

template <AscendC::CacheLine line>
__aicore__ inline void CacheOperation(
    __gm__ uint64_t* input, __gm__ uint64_t* output, uint32_t family, bool pointer, uint32_t variant)
{
    AscendC::GlobalTensor<uint64_t> source;
    AscendC::GlobalTensor<uint64_t> target;
    source.SetGlobalBuffer(input, INPUT_WORDS);
    target.SetGlobalBuffer(output + 8, 8);
    // Discard preceding-launch input cache state before consuming changed host input.
    AscendC::DataCacheCleanAndInvalid<uint64_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(source);
    AscendC::DataCacheCleanAndInvalid<uint64_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(source[8]);
    __ubuf__ uint64_t storage[8] __attribute__((aligned(64)));
    AscendC::LocalTensor<uint64_t> local(
        AscendC::TPosition::VECIN, static_cast<uint32_t>(reinterpret_cast<uint64_t>(storage)), 8);
    if (family == 0 || family == 2) {
        for (uint32_t i = 0; i < 8; ++i) {
            target.SetValue(i, source.GetValue(i));
        }
        if (family == 0) {
            if (pointer) {
                AscendC::DataCacheCleanAndInvalid<uint64_t, line, AscendC::DcciDst::CACHELINE_OUT>(output + 8);
            } else {
                AscendC::DataCacheCleanAndInvalid<uint64_t, line, AscendC::DcciDst::CACHELINE_OUT>(target);
            }
        } else if (pointer) {
            AscendC::DataCacheCleanAndInvalid<uint64_t, line>(output + 8);
        } else {
            AscendC::DataCacheCleanAndInvalid<uint64_t, line>(target);
        }
    } else {
        if (family == 3) {
            if (variant == 0) {
                if (pointer) {
                    AscendC::DataCachePreload<int16_t>(input, int16_t(0));
                } else {
                    AscendC::DataCachePreload<int16_t>(source, int16_t(0));
                }
            } else if (pointer) {
                AscendC::DataCachePreload<int64_t>(input, int64_t(64));
            } else {
                AscendC::DataCachePreload<int64_t>(source, int64_t(64));
            }
        }
        const uint32_t offset = family == 3 ? variant * 8 : 0;
        if (family == 1) {
            // A stale UB payload must not make a missing cache writeback look correct.
            AscendC::DataCopy(local, source[8], uint32_t(8));
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
        }
        for (uint32_t i = 0; i < 8; ++i) {
            local.SetValue(i, source.GetValue(offset + i));
        }
        if (family == 1 && pointer) {
            AscendC::DataCacheCleanAndInvalid<uint64_t, line, AscendC::DcciDst::CACHELINE_UB>(storage);
        } else {
            AscendC::DataCacheCleanAndInvalid<uint64_t, line, AscendC::DcciDst::CACHELINE_UB>(local);
        }
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);
        AscendC::DataCopy(target, local, uint32_t(8));
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}
} // namespace

__global__ __vector__ void DmaCacheRuntime(
    __gm__ uint64_t* input, __gm__ uint64_t* output, uint32_t family, bool pointer, uint32_t variant)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::InitSocState();
    if (variant == 0) {
        CacheOperation<AscendC::CacheLine::SINGLE_CACHE_LINE>(input, output, family, pointer, variant);
    } else {
        CacheOperation<AscendC::CacheLine::ENTIRE_DATA_CACHE>(input, output, family, pointer, variant);
    }
}

namespace {
bool CheckAcl(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ACL_FAILURE operation=%s code=%d\n", operation, result);
    return false;
}

struct Runtime {
    aclrtStream stream = nullptr;
    uint64_t* input = nullptr;
    uint64_t* output = nullptr;
    int32_t device = 0;
    bool initialized = false;
    bool deviceSet = false;

    bool Open(int32_t selectedDevice)
    {
        device = selectedDevice;
        initialized = CheckAcl(aclInit(nullptr), "aclInit");
        if (!initialized) {
            return false;
        }
        deviceSet = CheckAcl(aclrtSetDevice(device), "aclrtSetDevice");
        return deviceSet && CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") &&
               CheckAcl(
                   aclrtMalloc(
                       reinterpret_cast<void**>(&input), INPUT_WORDS * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST),
                   "aclrtMalloc(input)") &&
               CheckAcl(
                   aclrtMalloc(
                       reinterpret_cast<void**>(&output), OUTPUT_WORDS * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST),
                   "aclrtMalloc(output)");
    }

    bool Close()
    {
        bool ok = true;
        if (stream != nullptr) {
            ok = CheckAcl(aclrtSynchronizeStream(stream), "cleanup synchronize") && ok;
        }
        if (output != nullptr) {
            ok = CheckAcl(aclrtFree(output), "aclrtFree(output)") && ok;
        }
        if (input != nullptr) {
            ok = CheckAcl(aclrtFree(input), "aclrtFree(input)") && ok;
        }
        if (stream != nullptr) {
            ok = CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream") && ok;
        }
        if (deviceSet) {
            ok = CheckAcl(aclrtResetDevice(device), "aclrtResetDevice") && ok;
        }
        if (initialized) {
            ok = CheckAcl(aclFinalize(), "aclFinalize") && ok;
        }
        return ok;
    }
};

bool RunCases(Runtime& runtime)
{
    if (reinterpret_cast<uintptr_t>(runtime.input) % 64 != 0 || reinterpret_cast<uintptr_t>(runtime.output) % 64 != 0) {
        std::fprintf(stderr, "FAIL device allocations must be 64B aligned\n");
        return false;
    }
    uint64_t inputs[INPUT_WORDS];
    uint64_t outputs[OUTPUT_WORDS];
    uint64_t baseline[OUTPUT_WORDS];
    for (uint32_t round = 0; round < 3; ++round) {
        for (uint32_t i = 0; i < INPUT_WORDS; ++i) {
            inputs[i] = uint64_t(round + 1) * 0x102030405ull + i * 37ull;
        }
        if (!CheckAcl(
                aclrtMemcpy(runtime.input, sizeof(inputs), inputs, sizeof(inputs), ACL_MEMCPY_HOST_TO_DEVICE),
                "copy input")) {
            return false;
        }
        for (uint32_t family = 0; family < 4; ++family) {
            for (uint32_t variant = 0; variant < 2; ++variant) {
                for (uint32_t form = 0; form < 2; ++form) {
                    for (uint32_t i = 0; i < OUTPUT_WORDS; ++i) {
                        outputs[i] = CANARY;
                    }
                    if (!CheckAcl(
                            aclrtMemcpy(
                                runtime.output, sizeof(outputs), outputs, sizeof(outputs), ACL_MEMCPY_HOST_TO_DEVICE),
                            "initialize output")) {
                        return false;
                    }
                    DmaCacheRuntime<<<1, nullptr, runtime.stream>>>(
                        runtime.input, runtime.output, family, form != 0, variant);
                    if (!CheckAcl(aclrtSynchronizeStream(runtime.stream), "kernel synchronize") ||
                        !CheckAcl(
                            aclrtMemcpy(
                                outputs, sizeof(outputs), runtime.output, sizeof(outputs), ACL_MEMCPY_DEVICE_TO_HOST),
                            "read output")) {
                        return false;
                    }
                    for (uint32_t i = 0; i < OUTPUT_WORDS; ++i) {
                        const uint64_t expected =
                            i >= 8 && i < 16 ? inputs[i - 8 + (family == 3 ? variant * 8 : 0)] : CANARY;
                        if (outputs[i] != expected || (form != 0 && outputs[i] != baseline[i])) {
                            std::fprintf(
                                stderr,
                                "FAIL round=%u family=%u variant=%u form=%u index=%u expected=%016llx actual=%016llx\n",
                                round, family, variant, form, i, static_cast<unsigned long long>(expected),
                                static_cast<unsigned long long>(outputs[i]));
                            return false;
                        }
                        if (form == 0) {
                            baseline[i] = outputs[i];
                        }
                    }
                    std::printf(
                        "PASS round=%u family=%u variant=%u form=%u words=%u\n", round, family, variant, form,
                        OUTPUT_WORDS);
                    std::fflush(stdout);
                }
            }
        }
    }
    return true;
}
} // namespace

int main(int argc, char** argv)
{
    if (argc != 3 || std::strcmp(argv[1], "--device") != 0) {
        std::fprintf(stderr, "Usage: %s --device DEVICE_ID\n", argv[0]);
        return 2;
    }
    char* end = nullptr;
    errno = 0;
    const long device = std::strtol(argv[2], &end, 10);
    if (errno != 0 || end == argv[2] || *end != '\0' || device < 0 || device > INT_MAX) {
        std::fprintf(stderr, "Invalid device ID\n");
        return 2;
    }
    Runtime runtime;
    const bool passed = runtime.Open(static_cast<int32_t>(device)) && RunCases(runtime);
    const bool clean = runtime.Close();
    if (!passed || !clean) {
        return 1;
    }
    std::printf("ALL_PASS cases=48 comparison=exact_u64_cache_visibility\n");
    return 0;
}
