#include "basic_api/kernel_operator_data_copy_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "basic_api/kernel_operator_common_intf.h"
#include "acl/acl.h"

#include <cerrno>
#include <climits>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace {
constexpr uint32_t WORDS = 32;
constexpr uint32_t INPUT_WORDS = 2 * WORDS;
constexpr uint32_t PREFIX = 8;
constexpr uint32_t SLOT_WORDS = 48;
constexpr uint32_t OUTPUT_WORDS = 2 * SLOT_WORDS;
constexpr uint32_t CANARY = 0x5a36c97b;
constexpr uint16_t READY_FLAG = 11;

template <uint8_t subBlock, typename D, typename S>
__aicore__ inline void TransferL1(D&& dst, S&& src, bool strided)
{
    if (strided) {
        const AscendC::DataCopyParams params{2, 1, 1, 1};
        AscendC::DataCopyL1ToUB<uint32_t, subBlock>(dst, src, params);
    } else {
        AscendC::DataCopyL1ToUB<uint32_t, subBlock>(dst, src, WORDS);
    }
}

template <uint8_t subBlock>
__aicore__ inline void ProduceL1(__gm__ uint32_t* input, __cbuf__ uint32_t* l1, uint32_t form, bool strided)
{
    __ubuf__ uint32_t* ub = reinterpret_cast<__ubuf__ uint32_t*>(0);
    AscendC::LocalTensor<uint32_t> source(
        AscendC::TPosition::A1, static_cast<uint32_t>(reinterpret_cast<uint64_t>(l1)), INPUT_WORDS);
    AscendC::LocalTensor<uint32_t> destination(AscendC::TPosition::VECIN, 0, WORDS);
    AscendC::GlobalTensor<uint32_t> global;
    global.SetGlobalBuffer(input, INPUT_WORDS);
    AscendC::DataCopy(source, global, INPUT_WORDS);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
    // Poison the peer UB before every candidate call so stale data cannot hide a no-op.
    AscendC::DataCopyL1ToUB<uint32_t, subBlock>(destination, source[WORDS], WORDS);
    AscendC::PipeBarrier<PIPE_MTE1>();
    if (form == 0) {
        TransferL1<subBlock>(destination, source, strided);
    } else if (form == 1) {
        TransferL1<subBlock>(ub, l1, strided);
    } else if (form == 2) {
        TransferL1<subBlock>(destination, l1, strided);
    } else {
        TransferL1<subBlock>(ub, source, strided);
    }
    AscendC::PipeBarrier<PIPE_MTE1>();
    AscendC::CrossCoreSetFlag<2, PIPE_MTE1>(READY_FLAG);
}

__aicore__ inline void ConsumeUb(__gm__ uint32_t* output, uint32_t selected)
{
    AscendC::CrossCoreWaitFlag<2, PIPE_MTE3>(READY_FLAG);
    if (AscendC::GetSubBlockIdx() != selected) {
        return;
    }
    AscendC::LocalTensor<uint32_t> local(AscendC::TPosition::VECIN, 0, WORDS);
    AscendC::GlobalTensor<uint32_t> global;
    global.SetGlobalBuffer(output + selected * SLOT_WORDS + PREFIX, WORDS);
    AscendC::DataCopy(global, local, WORDS);
}
} // namespace

__global__ __mix__(1, 2) void DmaL1ToUbRuntime(
    __gm__ uint32_t* input, __gm__ uint32_t* output, uint32_t selected, uint32_t form, bool strided)
{
    AscendC::InitSocState();
    __cbuf__ uint32_t l1[INPUT_WORDS];
    if ASCEND_IS_AIC {
        if (selected == 0) {
            ProduceL1<0>(input, l1, form, strided);
        } else {
            ProduceL1<1>(input, l1, form, strided);
        }
    }
    if ASCEND_IS_AIV {
        ConsumeUb(output, selected);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

namespace {
bool CheckAcl(aclError error, const char* operation)
{
    if (error == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(error));
    return false;
}

bool CheckOutput(
    const uint32_t* input, const uint32_t* output, uint32_t selected, uint32_t form, bool strided, uint32_t round)
{
    for (uint32_t i = 0; i < OUTPUT_WORDS; ++i) {
        const uint32_t slot = i / SLOT_WORDS;
        const uint32_t position = i % SLOT_WORDS;
        uint32_t expected = CANARY;
        if (slot == selected && position >= PREFIX && position < PREFIX + WORDS) {
            const uint32_t index = position - PREFIX;
            if (!strided || index < 8 || (index >= 16 && index < 24)) {
                expected = input[index];
            }
        }
        if (output[i] != expected) {
            std::fprintf(
                stderr, "FAIL round=%u sub=%u form=%u strided=%u word=%u actual=%08x expected=%08x\n", round, selected,
                form, static_cast<unsigned>(strided), i, output[i], expected);
            return false;
        }
    }
    return true;
}

bool RunCase(
    aclrtStream stream, uint32_t* deviceInput, uint32_t* deviceOutput, uint32_t selected, uint32_t form, bool strided,
    uint32_t round)
{
    uint32_t input[INPUT_WORDS];
    uint32_t output[OUTPUT_WORDS];
    for (uint32_t i = 0; i < WORDS; ++i) {
        input[i] = 0x10203040u ^ ((i + 1) * 0x010107u) ^ ((round + 1) * 0x13579bu);
        input[WORDS + i] = CANARY;
    }
    for (uint32_t& value : output) {
        value = CANARY;
    }
    if (!CheckAcl(
            aclrtMemcpy(deviceInput, sizeof(input), input, sizeof(input), ACL_MEMCPY_HOST_TO_DEVICE), "input copy") ||
        !CheckAcl(
            aclrtMemcpy(deviceOutput, sizeof(output), output, sizeof(output), ACL_MEMCPY_HOST_TO_DEVICE),
            "guard copy")) {
        return false;
    }
    DmaL1ToUbRuntime<<<1, nullptr, stream>>>(deviceInput, deviceOutput, selected, form, strided);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "kernel synchronize") ||
        !CheckAcl(
            aclrtMemcpy(output, sizeof(output), deviceOutput, sizeof(output), ACL_MEMCPY_DEVICE_TO_HOST),
            "output copy")) {
        return false;
    }
    return CheckOutput(input, output, selected, form, strided, round);
}

bool RunMatrix(aclrtStream stream, uint32_t* input, uint32_t* output)
{
    uint32_t passed = 0;
    for (uint32_t round = 0; round < 3; ++round) {
        for (uint32_t selected = 0; selected < 2; ++selected) {
            for (uint32_t strided = 0; strided < 2; ++strided) {
                for (uint32_t form = 0; form < 4; ++form) {
                    if (!RunCase(stream, input, output, selected, form, strided != 0, round)) {
                        return false;
                    }
                    ++passed;
                    std::printf("PASS L1ToUB round=%u sub=%u form=%u strided=%u\n", round, selected, form, strided);
                }
            }
        }
    }
    std::printf("L1TOUB_RUNTIME_PASS cases=%u\n", passed);
    return passed == 48;
}
int ParseDevice(int argc, char** argv)
{
    int device = 0;
    if (argc == 3 && std::strcmp(argv[1], "--device") == 0) {
        errno = 0;
        char* end = nullptr;
        const long parsed = std::strtol(argv[2], &end, 10);
        if (errno != 0 || end == argv[2] || *end != '\0' || parsed < 0 || parsed > INT_MAX) {
            return -1;
        }
        device = static_cast<int>(parsed);
    } else if (argc != 1) {
        std::fprintf(stderr, "Usage: %s [--device ID]\n", argv[0]);
        return -1;
    }
    return device;
}

bool Cleanup(aclrtStream stream, uint32_t* input, uint32_t* output, int device, bool selected)
{
    bool ok = true;
    if (stream != nullptr) {
        ok = CheckAcl(aclrtSynchronizeStream(stream), "cleanup synchronize") && ok;
    }
    if (output != nullptr) {
        ok = CheckAcl(aclrtFree(output), "output free") && ok;
    }
    if (input != nullptr) {
        ok = CheckAcl(aclrtFree(input), "input free") && ok;
    }
    if (stream != nullptr) {
        ok = CheckAcl(aclrtDestroyStream(stream), "stream destroy") && ok;
    }
    if (selected) {
        ok = CheckAcl(aclrtResetDevice(device), "device reset") && ok;
    }
    return CheckAcl(aclFinalize(), "aclFinalize") && ok;
}
} // namespace

int main(int argc, char** argv)
{
    const int device = ParseDevice(argc, argv);
    if (device < 0) {
        return 2;
    }
    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    const bool selected = CheckAcl(aclrtSetDevice(device), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    uint32_t* input = nullptr;
    uint32_t* output = nullptr;
    bool ok = selected && CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
    if (ok) {
        ok = CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&input), INPUT_WORDS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST),
            "input malloc");
    }
    if (ok) {
        ok = CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&output), OUTPUT_WORDS * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST),
            "output malloc");
    }
    if (ok) {
        ok = RunMatrix(stream, input, output);
    }
    ok = Cleanup(stream, input, output, device, selected) && ok;
    return ok ? 0 : 1;
}
