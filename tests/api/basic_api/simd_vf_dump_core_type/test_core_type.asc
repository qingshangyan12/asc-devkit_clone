#include "acl/acl.h"
#include "utils/debug/asc_dump.h"
#include "utils/debug/asc_printf.h"
#include "kernel_operator.h"
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <stdexcept>
#include <string>
#include <vector>

// Device compilation checks the standard GM header ABI used by the runtime.
using DebugHead = __asc_aicore::DebugBlockHeadInfo;
static_assert(sizeof(DebugHead) == 56 && alignof(DebugHead) == 8);
static_assert(offsetof(DebugHead, flag) == 18);
static_assert(offsetof(DebugHead, ringBufLen) == 12);
static_assert(offsetof(DebugHead, ringBufAddr) == 24);
static_assert(offsetof(DebugHead, debugBusAddr) == 32);
static_assert(offsetof(DebugHead, resvMem) == 40);

// Separate cores' scalar GM observation stores across cache lines.
constexpr uint32_t RESULT_STRIDE = 128 / sizeof(uint32_t);

// Test-only observation: the production getter sets flag and would mask the regression.
__aicore__ inline __gm__ volatile DebugHead* ObserveDebugHead()
{
    const uint32_t coreIdx = __asc_aicore::asc_debug_get_core_idx_impl();
    auto* firstHead = reinterpret_cast<__gm__ volatile DebugHead*>(g_sysPrintFifoSpace);
    return reinterpret_cast<__gm__ volatile DebugHead*>(g_sysPrintFifoSpace + firstHead->length * coreIdx);
}

__simd_vf__ void DumpValues(__ubuf__ float* input)
{
    AscendC::Reg::RegTensor<float> reg;
    AscendC::Reg::LoadAlign(reg, input);
    asc_dump<float>(reg, 100, 8);
    asc_dump_ubuf<float>(input, 101, 8);
}

__global__ __vector__ void TestCoreType(__gm__ float* input, __gm__ uint32_t* result,
                                     uint32_t control, uint32_t repeats)
{
    AscendC::InitSocState();
    uint32_t block = AscendC::GetBlockIdx();
    auto* output = result + block * RESULT_STRIDE;
    auto* head = ObserveDebugHead();
    output[0] = head->flag;
    output[3] = 0;
    if ASCEND_IS_AIV { output[3] = 1; }
    if (control != 0) {
        __asc_aicore::printf_impl("CORE_TYPE_CONTROL\n");
    }
    output[1] = head->flag;
    AscendC::GlobalTensor<float> gm;
    gm.SetGlobalBuffer(input, 64);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto local = allocator.Alloc<float, 64>();
    AscendC::DataCopy(local, gm, 64);
    AscendC::PipeBarrier<PIPE_ALL>();
    for (uint32_t i = 0; i < repeats; ++i) {
        asc_vf_call<DumpValues>((__ubuf__ float*)local.GetPhyAddr());
    }
    output[2] = head->flag;
    AscendC::PipeBarrier<PIPE_ALL>();
}

void Check(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + " failed: " + std::to_string(status));
    }
}

int main(int argc, char** argv)
{
    if (argc != 5) {
        std::fprintf(stderr, "usage: demo acl.json control(0|1) blocks(1|2) repeats(1|2)\n");
        return 2;
    }
    const std::string controlArg = argv[2], blocksArg = argv[3], repeatsArg = argv[4];
    if ((controlArg != "0" && controlArg != "1") || (blocksArg != "1" && blocksArg != "2") ||
        (repeatsArg != "1" && repeatsArg != "2")) { return 2; }
    const uint32_t control = std::stoul(controlArg), blocks = std::stoul(blocksArg), repeats = std::stoul(repeatsArg);
    void* input = nullptr;
    void* output = nullptr;
    aclrtStream stream = nullptr;
    bool initialized = false, deviceSet = false;
    int status = 0;
    try {
        Check(aclInit(argv[1]), "aclInit"); initialized = true;
        Check(aclrtSetDevice(0), "aclrtSetDevice"); deviceSet = true;
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        float values[64];
        for (uint32_t i = 0; i < 64; ++i) { values[i] = i * 1.1f; }
        std::vector<uint32_t> flags(blocks * RESULT_STRIDE, 99);
        Check(aclrtMalloc(&input, sizeof(values), ACL_MEM_MALLOC_HUGE_FIRST), "input malloc");
        Check(aclrtMalloc(&output, flags.size() * 4, ACL_MEM_MALLOC_HUGE_FIRST), "output malloc");
        Check(aclrtMemcpy(input, sizeof(values), values, sizeof(values), ACL_MEMCPY_HOST_TO_DEVICE), "input H2D");
        Check(aclrtMemcpy(output, flags.size() * 4, flags.data(), flags.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE), "output H2D");
        TestCoreType<<<blocks, 0, stream>>>((float*)input, (uint32_t*)output, control, repeats);
        Check(aclrtSynchronizeStream(stream), "synchronize");
        Check(aclrtMemcpy(flags.data(), flags.size() * 4, output, flags.size() * 4, ACL_MEMCPY_DEVICE_TO_HOST), "D2H");
        for (uint32_t b = 0; b < blocks; ++b) {
            std::printf("CORE_FLAGS block=%u initial=%u before=%u after=%u actual_aiv=%u\n",
                b, flags[b*RESULT_STRIDE], flags[b*RESULT_STRIDE+1], flags[b*RESULT_STRIDE+2], flags[b*RESULT_STRIDE+3]);
        }
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what()); status = 1;
    }
    auto cleanup = [&status](aclError result, const char* operation) {
        if (result != ACL_SUCCESS) { std::fprintf(stderr, "%s failed: %d\n", operation, int(result)); status = 1; }
    };
    if (stream) { cleanup(aclrtSynchronizeStream(stream), "cleanup sync"); }
    if (input) { cleanup(aclrtFree(input), "input free"); }
    if (output) { cleanup(aclrtFree(output), "output free"); }
    if (stream) { cleanup(aclrtDestroyStream(stream), "destroy stream"); }
    if (deviceSet) { cleanup(aclrtResetDevice(0), "reset device"); }
    if (initialized) { cleanup(aclFinalize(), "finalize"); }
    return status;
}
