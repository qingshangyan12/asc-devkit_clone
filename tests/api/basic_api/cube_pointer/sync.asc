#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdio>
#include <cstdlib>
using namespace AscendC;
template<int Mode>
__global__ __vector__ void sync_probe(__gm__ int32_t* workspace)
{
    InitSocState();
    TPipe pipe;
    GlobalTensor<int32_t> gm;
    gm.SetGlobalBuffer(workspace);
    LocalTensor<int32_t> ub(TPosition::VECCALC, 0, 64);
    // Every launched AIV participates in exactly two matching barriers.
    for (int round = 0; round < 2; ++round) {
        if constexpr (Mode == 0) SyncAll<true>(gm, ub, 2);
        else if constexpr (Mode == 1) SyncAll<true>(workspace, (__ubuf__ int32_t*)0, 2);
        else SyncAll<true>(gm, (__ubuf__ int32_t*)0, 2);
    }
    // One producer and one consumer agree on the workspace event slot.
    if (GetBlockIdx() == 0) {
        if constexpr (Mode == 0) IBSet<true>(gm, ub, 1, 1);
        else if constexpr (Mode == 1) IBSet<true>(workspace, (__ubuf__ int32_t*)0, 1, 1);
        else IBSet<true>(gm, (__ubuf__ int32_t*)0, 1, 1);
    } else {
        if constexpr (Mode == 0) IBWait<true>(gm, ub, 1, 1);
        else if constexpr (Mode == 1) IBWait<true>(workspace, (__ubuf__ int32_t*)0, 1, 1);
        else IBWait<true>(gm, (__ubuf__ int32_t*)0, 1, 1);
    }
    PipeBarrier<PIPE_ALL>();
}
#define CHECK(x) do { auto r=(x); if(r) { std::fprintf(stderr,"%s: %d\n",#x,int(r)); std::exit(2); }} while(0)
int main()
{
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0));
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    int32_t* gm; CHECK(aclrtMalloc((void**)&gm, 256, ACL_MEM_MALLOC_HUGE_FIRST));
    for(int mode=0;mode<3;++mode) {
        CHECK(aclrtMemset(gm,256,0,256));
        if(mode==0) sync_probe<0><<<2,0,stream>>>(gm);
        if(mode==1) sync_probe<1><<<2,0,stream>>>(gm);
        if(mode==2) sync_probe<2><<<2,0,stream>>>(gm);
        CHECK(aclrtSynchronizeStream(stream));
        int32_t host[64]; CHECK(aclrtMemcpy(host,256,gm,256,ACL_MEMCPY_DEVICE_TO_HOST));
        if(host[0]!=2 || host[8]!=2) { std::fprintf(stderr,"bad counters %d %d\n",host[0],host[8]); return 1; }
        std::printf("PASS SyncAll mode=%d cores=2 rounds=2 counters=2,2\n",mode);
    }
    CHECK(aclrtFree(gm)); CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(0)); CHECK(aclFinalize());
}
