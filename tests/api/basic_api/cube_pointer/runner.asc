#include "acl/acl.h"
#include "basic_api/kernel_cube_intf.h"
#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

using namespace AscendC;
#ifdef CUBE_BFLOAT16
using Input = bfloat16_t;
constexpr const char* INPUT_NAME = "bf16";
#else
using Input = half;
constexpr const char* INPUT_NAME = "fp16";
#endif
#ifndef CUBE_SIDE
#define CUBE_SIDE 16
#endif
constexpr int SIDE = CUBE_SIDE;
constexpr int COUNT = SIDE * SIDE;
static_assert(SIDE % 16 == 0 && SIDE <= 128, "Test tile must fit L0 memory");
#ifndef CUBE_POINTER_MODE
#define CUBE_POINTER_MODE 0
#endif

__global__ __cube__ void tensor_baseline(__gm__ Input* a, __gm__ Input* b, __gm__ float* c)
{
    InitSocState();
    GlobalTensor<Input> ag, bg;
    GlobalTensor<float> cg;
    ag.SetGlobalBuffer(a); bg.SetGlobalBuffer(b); cg.SetGlobalBuffer(c);
    LocalTensor<Input> a1(TPosition::A1, 0, COUNT);
    LocalTensor<Input> b1(TPosition::B1, COUNT * sizeof(Input), COUNT);
    LocalTensor<Input> a2(TPosition::A2, 0, COUNT);
    LocalTensor<Input> b2(TPosition::B2, 0, COUNT);
    LocalTensor<float> co(TPosition::CO1, 0, COUNT);
    Nd2NzParams nd{1, SIDE, SIDE, 0, SIDE, SIDE, 1, 0};
    DataCopy(a1, ag, nd);
    DataCopy(b1, bg, nd);
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    LoadData2DParamsV2 la;
    la.mStartPosition = 0; la.kStartPosition = 0;
    la.mStep = SIDE / 16; la.kStep = SIDE / 16;
    la.srcStride = SIDE / 16; la.dstStride = SIDE / 16;
    la.ifTranspose = false;
    if constexpr (CUBE_POINTER_MODE == 1) {
        LoadData((__ca__ Input*)0, (__cbuf__ Input*)0, la);
    } else if constexpr (CUBE_POINTER_MODE == 2) {
        LoadData((__ca__ Input*)0, a1, la);
    } else {
        LoadData(a2, a1, la);
    }
    LoadData2DParams lb;
    lb.startIndex = 0; lb.repeatTimes = COUNT / 256; lb.srcStride = 1;
    lb.dstGap = 0; lb.ifTranspose = false;
    if constexpr (CUBE_POINTER_MODE == 1) {
        LoadData((__cb__ Input*)0, (__cbuf__ Input*)(COUNT * sizeof(Input)), lb);
    } else if constexpr (CUBE_POINTER_MODE == 2) {
        LoadData(b2, (__cbuf__ Input*)(COUNT * sizeof(Input)), lb);
    } else {
        LoadData(b2, b1, lb);
    }
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
    WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
    MmadParams mm;
    mm.m = SIDE; mm.n = SIDE; mm.k = SIDE; mm.cmatrixInitVal = true;
    if constexpr (CUBE_POINTER_MODE == 1) {
        Mmad((__cc__ float*)0, (__ca__ Input*)0, (__cb__ Input*)0, mm);
    } else if constexpr (CUBE_POINTER_MODE == 2) {
        Mmad(co, (__ca__ Input*)0, b2, mm);
    } else {
        Mmad(co, a2, b2, mm);
    }
    SetFlag<HardEvent::M_FIX>(EVENT_ID0);
    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    fp.mSize = SIDE; fp.nSize = SIDE; fp.srcStride = SIDE; fp.dstStride = SIDE;
    if constexpr (CUBE_POINTER_MODE == 1) {
        Fixpipe(c, (__cc__ float*)0, fp);
    } else if constexpr (CUBE_POINTER_MODE == 2) {
        Fixpipe(cg, (__cc__ float*)0, fp);
    } else {
        Fixpipe(cg, co, fp);
    }
    PipeBarrier<PIPE_ALL>();
}

#define ACL_CHECK(call) do { const auto err = (call); if (err != ACL_SUCCESS) { \
    std::fprintf(stderr, "%s failed: %d\n", #call, int(err)); std::exit(2); } } while (0)

int main()
{
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream;
    ACL_CHECK(aclrtCreateStream(&stream));
    Input *a, *b;
    float* c;
    ACL_CHECK(aclrtMalloc((void**)&a, COUNT * sizeof(Input), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&b, COUNT * sizeof(Input), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&c, COUNT * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<uint16_t> ah(COUNT), bh(COUNT);
    std::vector<float> af(COUNT), bf(COUNT);
    std::vector<float> actual(COUNT);
    std::vector<double> golden(COUNT);
    for (int i = 0; i < COUNT; ++i) {
        af[i] = float((i * 7) % 17 - 8) / 8;
        bf[i] = float((i * 11) % 19 - 9) / 8;
#ifdef CUBE_BFLOAT16
        uint32_t abits, bbits;
        std::memcpy(&abits, &af[i], sizeof(abits));
        std::memcpy(&bbits, &bf[i], sizeof(bbits));
        ah[i] = abits >> 16; bh[i] = bbits >> 16;
#else
        half av = half(af[i]), bv = half(bf[i]);
        std::memcpy(&ah[i], &av, sizeof(av));
        std::memcpy(&bh[i], &bv, sizeof(bv));
#endif
    }
    // B is supplied as N x K, as required by the non-transposing L0B load.
    for (int m = 0; m < SIDE; ++m) for (int n = 0; n < SIDE; ++n)
        for (int k = 0; k < SIDE; ++k) golden[m * SIDE + n] += double(af[m * SIDE + k]) * double(bf[n * SIDE + k]);
    ACL_CHECK(aclrtMemcpy(a, COUNT * sizeof(Input), ah.data(), COUNT * sizeof(Input), ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(b, COUNT * sizeof(Input), bh.data(), COUNT * sizeof(Input), ACL_MEMCPY_HOST_TO_DEVICE));
    for (int i = 0; i < 10; ++i) tensor_baseline<<<1, 0, stream>>>(a, b, c);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    aclrtEvent start, stop;
    ACL_CHECK(aclrtCreateEvent(&start)); ACL_CHECK(aclrtCreateEvent(&stop));
    std::vector<float> times;
    for (int i = 0; i < 100; ++i) {
        ACL_CHECK(aclrtRecordEvent(start, stream));
        for (int batch = 0; batch < 20; ++batch) tensor_baseline<<<1, 0, stream>>>(a, b, c);
        ACL_CHECK(aclrtRecordEvent(stop, stream));
        ACL_CHECK(aclrtSynchronizeEvent(stop));
        float ms;
        ACL_CHECK(aclrtEventElapsedTime(&ms, start, stop));
        times.push_back(ms * 1000 / 20);
    }
    ACL_CHECK(aclrtMemcpy(actual.data(), COUNT * sizeof(float), c, COUNT * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST));
    float maxError = 0; int matched = 0;
    for (int i = 0; i < COUNT; ++i) {
        float error = std::abs(actual[i] - golden[i]);
        maxError = std::max(maxError, error);
        matched += std::isfinite(actual[i]) && error <= 0x1p-16f + 0x1p-10f * std::abs(golden[i]);
    }
    std::sort(times.begin(), times.end());
    bool pass = matched == COUNT && maxError <= 0.01f;
    std::printf("{\"mode\":%d,\"input_dtype\":\"%s\",\"shape\":[%d,%d,%d],\"matched\":%d,\"total\":%d,\"max_abs_error\":%.9g,\"median_us\":%.6g,\"p95_us\":%.6g,\"pass\":%s}\n",
        CUBE_POINTER_MODE, INPUT_NAME, SIDE, SIDE, SIDE, matched, COUNT, maxError, times[50], times[94], pass ? "true" : "false");
    ACL_CHECK(aclrtDestroyEvent(start)); ACL_CHECK(aclrtDestroyEvent(stop));
    ACL_CHECK(aclrtFree(a)); ACL_CHECK(aclrtFree(b)); ACL_CHECK(aclrtFree(c));
    ACL_CHECK(aclrtDestroyStream(stream)); ACL_CHECK(aclrtResetDevice(0)); ACL_CHECK(aclFinalize());
    return pass ? 0 : 1;
}
