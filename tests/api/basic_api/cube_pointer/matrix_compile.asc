#include "kernel_operator.h"
using namespace AscendC;

__global__ __cube__ void matrix_compile_probe()
{
    auto a = (__ca__ half*)0;
    auto b = (__cb__ half*)0;
    auto c = (__cc__ float*)0;
    auto l1 = (__cbuf__ half*)0;
    auto gm = (__gm__ half*)0;
    auto cGm = (__gm__ float*)0;
    auto workspace = (__cbuf__ uint64_t*)0;
    LoadData2DParams v1;
    LoadData2DParamsV2 v2;
    LoadData(a, l1, v1);
    LoadData(b, l1, v2);
    LoadData<half>(a, l1, v2);
    LoadData(l1, gm, v1);
    LoadData(l1, gm, v2);
    MmadParams m;
    MmadBitModeParams bit;
    Mmad(c, a, b, m);
    Mmad<float, half, half>(c, a, b, m);
    Mmad(c, (__ca__ const half*)a, (__cb__ const half*)b, m);
    Mmad(c, a, b, (__biasbuf__ float*)0, m);
    Mmad(c, a, b, bit);
    Mmad(c, a, b, (__biasbuf__ float*)0, bit);
    auto mxA = (__ca__ fp8_e4m3fn_t*)0;
    auto mxB = (__cb__ fp8_e4m3fn_t*)0;
    MmadMx(c, mxA, mxB, m);
    MmadMx(c, mxA, mxB, bit);
    MmadMx(c, mxA, mxB, (__biasbuf__ float*)0, m);
    MmadMx(c, mxA, mxB, (__biasbuf__ float*)0, bit);
    LoadData2DMxParams mx;
    LoadData(mxA, (__cbuf__ fp8_e4m3fn_t*)0, (__cbuf__ fp8_e8m0_t*)0, v2, mx);
    Load2DBitModeParam loadBit;
    Load3DBitModeParam load3Bit;
    LoadData<TPosition::A2, TPosition::A1>(a, l1, loadBit);
    LoadData<TPosition::B2, TPosition::B1>(b, l1, load3Bit);
    LoadData3DParamsV2<half> three;
    LoadData(a, l1, three);
    LoadDataWithStride(a, l1, three);
    LoadData3DParamsV2Pro threePro;
    LoadData(a, l1, threePro);
    LoadData2dTransposeParams transposeV1;
    LoadData2dTransposeParamsV2 transpose;
    LoadDataWithTranspose(b, l1, transposeV1);
    LoadDataWithTranspose(b, l1, transpose);
    InitConstValueParams<half> initParams;
    InitConstValue(l1, initParams);
    LoadImageToLocalParams image;
    LoadImageToLocal(l1, image);
    LocalTensor<half> localA, localB, localL1;
    LocalTensor<float> localC;
    LoadData(localA, l1, v2);
    LoadData(a, localL1, v2);
    Mmad(localC, a, localB, m);
    Mmad(c, localA, b, m);
    Mmad(localC, localA, b, m);
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    Fixpipe(cGm, c, fp);
    Fixpipe(cGm, c, workspace, fp);
    FixpipeParamsV220 v220;
    Fixpipe(cGm, c, v220);
    SetFixPipeConfig((__fbuf__ half*)0, false);
    SetFixPipeConfig((__fbuf__ half*)0, (__fbuf__ half*)0, false);
    DumpTensor(cGm, 0, 16);
    DumpTensor(l1, 1, 16);
    ShapeInfo shapeInfo;
    DumpTensor(cGm, 2, 16, shapeInfo);
    DumpAccChkPoint(cGm, 0, 0, 16);
    DumpAccChkPoint(l1, 0, 0, 16);
    localA.SetAddrWithOffset(l1, 0, TPosition::A1, 32);
}

__global__ __vector__ void sync_compile_probe()
{
    auto gmSync = (__gm__ int32_t*)0;
    auto ubSync = (__ubuf__ int32_t*)0;
    SyncAll(gmSync, ubSync, 1);
    IBSet(gmSync, ubSync, 0, 0);
    IBWait(gmSync, ubSync, 0, 0);
    InitDetermineComputeWorkspace(gmSync, ubSync);
    WaitPreBlock(gmSync, ubSync);
    NotifyNextBlock(gmSync, ubSync);
    __ubuf__ half* popped = nullptr;
    (void)PopStackBuffer(popped);
    DumpTensor((__ubuf__ half*)0, 3, 16);
    DumpAccChkPoint((__ubuf__ half*)0, 0, 0, 16);
}

int main()
{
    return 0;
}
