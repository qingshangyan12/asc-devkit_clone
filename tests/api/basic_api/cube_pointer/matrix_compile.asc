#include "basic_api/kernel_cube_intf.h"
using namespace AscendC;

__global__ __aicore__ void matrix_compile_probe()
{
    auto a = (__ca__ half*)0;
    auto b = (__cb__ half*)0;
    auto c = (__cc__ float*)0;
    auto l1 = (__cbuf__ half*)0;
    LoadData2DParams v1;
    LoadData2DParamsV2 v2;
    LoadData(a, l1, v1);
    LoadData(b, l1, v2);
    LoadData<half>(a, l1, v2);
    MmadParams m;
    MmadBitModeParams bit;
    Mmad(c, a, b, m);
    Mmad<float, half, half>(c, a, b, m);
    Mmad(c, (__ca__ const half*)a, (__cb__ const half*)b, m);
    Mmad(c, a, b, (__biasbuf__ float*)0, m);
    Mmad(c, a, b, bit);
    Mmad(c, a, b, (__biasbuf__ float*)0, bit);
    auto mxA = (__ca__ fp8_e4m3fn_t*)0;
    auto mxB = (__cb__ fp8_e4m3fn_t*)0;
    MmadMx(c, mxA, mxB, m);
    MmadMx(c, mxA, mxB, bit);
    MmadMx(c, mxA, mxB, (__biasbuf__ float*)0, m);
    MmadMx(c, mxA, mxB, (__biasbuf__ float*)0, bit);
    LoadData2DMxParams mx;
    LoadData(mxA, (__cbuf__ fp8_e4m3fn_t*)0, (__cbuf__ fp8_e8m0_t*)0, v2, mx);
    Load2DBitModeParam loadBit;
    Load3DBitModeParam load3Bit;
    LoadData<TPosition::A2, TPosition::A1>(a, l1, loadBit);
    LoadData<TPosition::B2, TPosition::B1>(b, l1, load3Bit);
    LoadData3DParamsV2<half> three;
    LoadData(a, l1, three);
    LoadData2dTransposeParamsV2 transpose;
    LoadDataWithTranspose(b, l1, transpose);
    LocalTensor<half> localA, localB, localL1;
    LocalTensor<float> localC;
    LoadData(localA, l1, v2);
    LoadData(a, localL1, v2);
    Mmad(localC, a, localB, m);
    Mmad(c, localA, b, m);
    Mmad(localC, localA, b, m);
}
