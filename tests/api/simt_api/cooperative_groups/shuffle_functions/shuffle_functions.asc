}

std::vector<int32_t> run_coalesced_shfl_test(const std::vector<int32_t>& input)
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(int32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    int32_t* input_dev = nullptr;
    int32_t* output_shfl = nullptr;
    int32_t* output_shfl_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_shfl_host, total_byte_size);
    aclrtMalloc((void**)&input_dev, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    aclrtMemcpy(input_dev, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    
    uint32_t dyn_ubuf_size = 0;
    coalesced_shfl_test<<<block_num, thread_num, dyn_ubuf_size, stream>>>(input_dev, output_shfl);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_shfl_host, total_byte_size, output_shfl, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<int32_t> result(output_shfl_host, output_shfl_host + total_length);
    
    aclrtFree(input_dev);
    aclrtFree(output_shfl);
    aclrtFreeHost(output_shfl_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

uint32_t verify_int_result(std::vector<int32_t>& result, const std::vector<int32_t>& input,
                           uint32_t TileSize, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        uint32_t tile_rank = local_thread_idx % TileSize;
        uint32_t tile_base = local_thread_idx - tile_rank;
        
        int32_t expected_shfl = input[i - tile_rank];
        
        if (tile_rank == 0) {
            int32_t expected_shfl_up = input[i];
        } else {
            int32_t expected_shfl_up = input[i - 1];
        }
        
        if (tile_rank == TileSize - 1) {
            int32_t expected_shfl_down = input[i];
        } else {
            int32_t expected_shfl_down = input[i + 1];
        }
        
        uint32_t xor_rank = tile_rank ^ 1;
        int32_t expected_shfl_xor = input[i - tile_rank + xor_rank];
        
        if (result[i] != expected_shfl) {
            std::cout << "[Failed] shfl mismatch at " << i << ": got " << result[i] 
                      << ", expected " << expected_shfl << std::endl;
            failed++;
        }
        
        int32_t expected_up = (tile_rank == 0) ? input[i] : input[i - 1];
        if (result[total_length + i] != expected_up) {
            std::cout << "[Failed] shfl_up mismatch at " << i << ": got " << result[total_length + i] 
                      << ", expected " << expected_up << std::endl;
            failed++;
        }
        
        int32_t expected_down = (tile_rank == TileSize - 1) ? input[i] : input[i + 1];
        if (result[2 * total_length + i] != expected_down) {
            std::cout << "[Failed] shfl_down mismatch at " << i << ": got " << result[2 * total_length + i] 
                      << ", expected " << expected_down << std::endl;
            failed++;
        }
        
        if (result[3 * total_length + i] != expected_shfl_xor) {
            std::cout << "[Failed] shfl_xor mismatch at " << i << ": got " << result[3 * total_length + i] 
                      << ", expected " << expected_shfl_xor << std::endl;
            failed++;
        }
    }
    
    return failed;
}

uint32_t verify_float_result(std::vector<float>& result, const std::vector<float>& input,
                             uint32_t TileSize, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        uint32_t tile_rank = local_thread_idx % TileSize;
        
        float expected_shfl = input[i - tile_rank];
        
        float expected_up = (tile_rank == 0) ? input[i] : input[i - 1];
        float expected_down = (tile_rank == TileSize - 1) ? input[i] : input[i + 1];
        
        uint32_t xor_rank = tile_rank ^ 1;
        float expected_shfl_xor = input[i - tile_rank + xor_rank];
        
        if (std::abs(result[i] - expected_shfl) > 0.001f) {
            std::cout << "[Failed] float shfl mismatch at " << i << ": got " << result[i] 
                      << ", expected " << expected_shfl << std::endl;
            failed++;
        }
        if (std::abs(result[total_length + i] - expected_up) > 0.001f) {
            std::cout << "[Failed] float shfl_up mismatch at " << i << ": got " << result[total_length + i] 
                      << ", expected " << expected_up << std::endl;
            failed++;
        }
        if (std::abs(result[2 * total_length + i] - expected_down) > 0.001f) {
            std::cout << "[Failed] float shfl_down mismatch at " << i << ": got " << result[2 * total_length + i] 
                      << ", expected " << expected_down << std::endl;
            failed++;
        }
        if (std::abs(result[3 * total_length + i] - expected_shfl_xor) > 0.001f) {
            std::cout << "[Failed] float shfl_xor mismatch at " << i << ": got " << result[3 * total_length + i] 
                      << ", expected " << expected_shfl_xor << std::endl;
            failed++;
        }
    }
    
    return failed;
}

uint32_t verify_coalesced_result(std::vector<int32_t>& result, const std::vector<int32_t>& input,
                                 uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        if ((local_thread_idx % 2) == 0) {
            uint32_t group_rank = local_thread_idx / 2;
            uint32_t first_active_idx = i - local_thread_idx + 0;
            int32_t expected_shfl = input[first_active_idx];
            
            if (result[i] != expected_shfl) {
                std::cout << "[Failed] coalesced shfl mismatch at " << i << ": got " << result[i] 
                          << ", expected " << expected_shfl << std::endl;
                failed++;
            }
        }
    }
    
    return failed;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t TileSize = 4;
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    uint32_t total_failed = 0;
    
    std::cout << "Testing shuffle functions with int32_t..." << std::endl;
    std::vector<int32_t> input_int(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input_int[i] = static_cast<int32_t>(i);
    }
    std::vector<int32_t> result_int = run_shfl_test_int<int32_t>(input_int);
    total_failed += verify_int_result(result_int, input_int, TileSize, block_num, thread_num);
    
    std::cout << "Testing shuffle functions with float..." << std::endl;
    std::vector<float> input_float(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input_float[i] = static_cast<float>(i) * 1.5f;
    }
    std::vector<float> result_float = run_shfl_test_float<float>(input_float);
    total_failed += verify_float_result(result_float, input_float, TileSize, block_num, thread_num);
    
    std::cout << "Testing shfl on coalesced_group..." << std::endl;
    std::vector<int32_t> coalesced_result = run_coalesced_shfl_test(input_int);
    total_failed += verify_coalesced_result(coalesced_result, input_int, block_num, thread_num);
    
    if (total_failed == 0) {
        std::cout << "[Success] All shuffle function tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] shuffle function tests failed with " << total_failed << " total errors." << std::endl;
        return 1;
    }
}