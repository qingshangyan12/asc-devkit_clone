/* !
 * \file thread_block.asc
 * \brief Test thread_block class: this_thread_block(), sync(), thread_rank(), 
 *        group_index(), thread_index(), dim_threads(), num_threads(), size(), group_dim()
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"
#include "simt_api/cooperative_groups.h"

using namespace cooperative_groups;

__global__ void thread_block_test(uint32_t* output_rank, uint32_t* output_size,
                                   uint32_t* output_group_idx, uint32_t* output_thread_idx,
                                   uint32_t* output_dim, uint32_t* output_sync_result)
{
    thread_block g = this_thread_block();
    
    uint32_t rank = static_cast<uint32_t>(g.thread_rank());
    uint32_t size = static_cast<uint32_t>(g.size());
    
    dim3 group_idx = g.group_index();
    dim3 thread_idx = g.thread_index();
    dim3 dim = g.dim_threads();
    
    uint32_t num = g.num_threads();
    uint32_t group_dim_val = g.group_dim().x * g.group_dim().y * g.group_dim().z;
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < blockDim.x * gridDim.x) {
        output_rank[global_idx] = rank;
        output_size[global_idx] = size;
        output_group_idx[global_idx] = group_idx.x;
        output_thread_idx[global_idx] = thread_idx.x;
        output_dim[global_idx] = dim.x;
    }
    
    g.sync();
    
    if (threadIdx.x == 0) {
        output_sync_result[blockIdx.x] = 1;
    }
}

std::vector<uint32_t> run_test(uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_rank = nullptr;
    uint32_t* output_size = nullptr;
    uint32_t* output_group_idx = nullptr;
    uint32_t* output_thread_idx = nullptr;
    uint32_t* output_dim = nullptr;
    uint32_t* output_sync_result = nullptr;
    
    uint32_t* output_rank_host = nullptr;
    uint32_t* output_size_host = nullptr;
    uint32_t* output_group_idx_host = nullptr;
    uint32_t* output_thread_idx_host = nullptr;
    uint32_t* output_dim_host = nullptr;
    uint32_t* output_sync_result_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_group_idx_host, total_byte_size);
    aclrtMallocHost((void**)&output_thread_idx_host, total_byte_size);
    aclrtMallocHost((void**)&output_dim_host, total_byte_size);
    aclrtMallocHost((void**)&output_sync_result_host, block_num * sizeof(uint32_t));
    
    aclrtMalloc((void**)&output_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_group_idx, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_thread_idx, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_dim, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_sync_result, block_num * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    thread_block_test<<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_rank, output_size, output_group_idx, output_thread_idx, output_dim, output_sync_result);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_group_idx_host, total_byte_size, output_group_idx, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_thread_idx_host, total_byte_size, output_thread_idx, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_dim_host, total_byte_size, output_dim, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_sync_result_host, block_num * sizeof(uint32_t), output_sync_result, block_num * sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_group_idx_host, output_group_idx_host + total_length);
    result.insert(result.end(), output_thread_idx_host, output_thread_idx_host + total_length);
    result.insert(result.end(), output_dim_host, output_dim_host + total_length);
    result.insert(result.end(), output_sync_result_host, output_sync_result_host + block_num);
    
    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_group_idx);
    aclrtFree(output_thread_idx);
    aclrtFree(output_dim);
    aclrtFree(output_sync_result);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_group_idx_host);
    aclrtFreeHost(output_thread_idx_host);
    aclrtFreeHost(output_dim_host);
    aclrtFreeHost(output_sync_result_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

uint32_t verify_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected_rank = i % thread_num;
        uint32_t expected_size = thread_num;
        uint32_t expected_group_idx = i / thread_num;
        uint32_t expected_thread_idx = i % thread_num;
        uint32_t expected_dim = thread_num;
        
        if (result[i] != expected_rank) {
            std::cout << "[Failed] thread_rank mismatch at " << i << ": got " << result[i] 
                      << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] size mismatch at " << i << ": got " << result[total_length + i] 
                      << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_group_idx) {
            std::cout << "[Failed] group_index mismatch at " << i << ": got " << result[2 * total_length + i] 
                      << ", expected " << expected_group_idx << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_thread_idx) {
            std::cout << "[Failed] thread_index mismatch at " << i << ": got " << result[3 * total_length + i] 
                      << ", expected " << expected_thread_idx << std::endl;
            failed++;
        }
        if (result[4 * total_length + i] != expected_dim) {
            std::cout << "[Failed] dim_threads mismatch at " << i << ": got " << result[4 * total_length + i] 
                      << ", expected " << expected_dim << std::endl;
            failed++;
        }
    }
    
    for (uint32_t i = 0; i < block_num; i++) {
        if (result[5 * total_length + i] != 1) {
            std::cout << "[Failed] sync result mismatch at block " << i << std::endl;
            failed++;
        }
    }
    
    if (failed == 0) {
        std::cout << "[Success] thread_block test passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] thread_block test failed with " << failed << " errors." << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 4;
    constexpr uint32_t thread_num = 32;
    
    std::vector<uint32_t> result = run_test(block_num, thread_num);
    
    return verify_result(result, block_num, thread_num);
}
