    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t dyn_ubuf_size = 0;
    binary_partition_tile_test<TileSize><<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_rank, output_size, output_meta_rank, output_meta_size);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);

    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return result;
}

uint32_t verify_coalesced_binary_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        bool pred = (local_thread_idx % 2) == 0;
        uint32_t expected_rank = local_thread_idx / 2;
        uint32_t expected_size = thread_num / 2;
        uint32_t expected_meta_rank = pred ? 1u : 0u;
        uint32_t expected_meta_size = 2u;

        if (result[i] != expected_rank) {
            std::cout << "[Failed] coalesced thread_rank mismatch at " << i
                      << ": got " << result[i] << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] coalesced num_threads mismatch at " << i
                      << ": got " << result[total_length + i] << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] coalesced meta_group_rank mismatch at " << i
                      << ": got " << result[2 * total_length + i] << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] coalesced meta_group_size mismatch at " << i
                      << ": got " << result[3 * total_length + i] << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }

    return failed;
}

uint32_t verify_all_same_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;

    for (uint32_t i = 0; i < total_length; i++) {
        if (result[i] != 0) {
            std::cout << "[Failed] all-true meta_group_rank mismatch at " << i
                      << ": got " << result[i] << ", expected 0" << std::endl;
            failed++;
        }
        if (result[total_length + i] != 1) {
            std::cout << "[Failed] all-false meta_group_size mismatch at " << i
                      << ": got " << result[total_length + i] << ", expected 1" << std::endl;
            failed++;
        }
    }

    return failed;
}

template <unsigned int TileSize>
uint32_t verify_tile_binary_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        uint32_t tile_rank = local_thread_idx % TileSize;
        bool pred = (tile_rank % 2) == 0;
        uint32_t expected_rank = tile_rank / 2;
        uint32_t expected_size = TileSize / 2;
        uint32_t expected_meta_rank = pred ? 1u : 0u;
        uint32_t expected_meta_size = 2u;

        if (result[i] != expected_rank) {
            std::cout << "[Failed] tile thread_rank mismatch at " << i << " (TileSize=" << TileSize
                      << "): got " << result[i] << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] tile num_threads mismatch at " << i << " (TileSize=" << TileSize
                      << "): got " << result[total_length + i] << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] tile meta_group_rank mismatch at " << i << " (TileSize=" << TileSize
                      << "): got " << result[2 * total_length + i] << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] tile meta_group_size mismatch at " << i << " (TileSize=" << TileSize
                      << "): got " << result[3 * total_length + i] << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }

    return failed;
}

__global__ void binary_partition_partial_mask_test(uint32_t* output_rank, uint32_t* output_size,
                                                   uint32_t* output_meta_rank, uint32_t* output_meta_size)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    coalesced_group g = coalesced_threads();
    bool pred = (threadIdx.x < 4);
    coalesced_group partitioned = binary_partition(g, pred);

    output_rank[global_idx] = static_cast<uint32_t>(partitioned.thread_rank());
    output_size[global_idx] = static_cast<uint32_t>(partitioned.num_threads());
    output_meta_rank[global_idx] = static_cast<uint32_t>(partitioned.meta_group_rank());
    output_meta_size[global_idx] = static_cast<uint32_t>(partitioned.meta_group_size());
}

__global__ void binary_partition_uneven_split_test(uint32_t* output_rank, uint32_t* output_size,
                                                    uint32_t* output_meta_rank, uint32_t* output_meta_size)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    coalesced_group g = coalesced_threads();
    bool pred = (threadIdx.x == 0);
    coalesced_group partitioned = binary_partition(g, pred);

    output_rank[global_idx] = static_cast<uint32_t>(partitioned.thread_rank());
    output_size[global_idx] = static_cast<uint32_t>(partitioned.num_threads());
    output_meta_rank[global_idx] = static_cast<uint32_t>(partitioned.meta_group_rank());
    output_meta_size[global_idx] = static_cast<uint32_t>(partitioned.meta_group_size());
}

template <unsigned int TileSize>
__global__ void binary_partition_tile_all_same_test(uint32_t* output_meta_rank, uint32_t* output_meta_size)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);

    coalesced_group partitioned_true = binary_partition(tile, true);
    coalesced_group partitioned_false = binary_partition(tile, false);

    output_meta_rank[global_idx] = static_cast<uint32_t>(partitioned_true.meta_group_rank());
    output_meta_size[global_idx] = static_cast<uint32_t>(partitioned_false.meta_group_size());
}

std::vector<uint32_t> run_partial_mask_test()
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 16;
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint32_t* output_rank = nullptr;
    uint32_t* output_size = nullptr;
    uint32_t* output_meta_rank = nullptr;
    uint32_t* output_meta_size = nullptr;

    uint32_t* output_rank_host = nullptr;
    uint32_t* output_size_host = nullptr;
    uint32_t* output_meta_rank_host = nullptr;
    uint32_t* output_meta_size_host = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&output_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_size_host, total_byte_size);

    aclrtMalloc((void**)&output_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t dyn_ubuf_size = 0;
    binary_partition_partial_mask_test<<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_rank, output_size, output_meta_rank, output_meta_size);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);

    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return result;
}

