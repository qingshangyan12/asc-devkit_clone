    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);

    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return result;
}

template <unsigned int TileSize>
std::vector<uint32_t> run_tile_all_same_test()
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint32_t* output_meta_rank = nullptr;
    uint32_t* output_meta_size = nullptr;
    uint32_t* output_meta_rank_host = nullptr;
    uint32_t* output_meta_size_host = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&output_meta_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_size_host, total_byte_size);

    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t dyn_ubuf_size = 0;
    binary_partition_tile_all_same_test<TileSize><<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_meta_rank, output_meta_size);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<uint32_t> result;
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);

    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return result;
}

uint32_t verify_partial_mask_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        bool pred = (local_thread_idx < 4);
        uint32_t expected_rank = pred ? local_thread_idx : local_thread_idx - 4;
        uint32_t expected_size = pred ? 4u : thread_num - 4;
        uint32_t expected_meta_rank = pred ? 1u : 0u;
        uint32_t expected_meta_size = 2u;

        if (result[i] != expected_rank) {
            std::cout << "[Failed] partial mask thread_rank mismatch at " << i
                      << ": got " << result[i] << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] partial mask num_threads mismatch at " << i
                      << ": got " << result[total_length + i] << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] partial mask meta_group_rank mismatch at " << i
                      << ": got " << result[2 * total_length + i] << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] partial mask meta_group_size mismatch at " << i
                      << ": got " << result[3 * total_length + i] << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }

    return failed;
}

uint32_t verify_uneven_split_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;

    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        bool pred = (local_thread_idx == 0);
        uint32_t expected_rank = pred ? 0u : local_thread_idx - 1;
        uint32_t expected_size = pred ? 1u : thread_num - 1;
        uint32_t expected_meta_rank = pred ? 1u : 0u;
        uint32_t expected_meta_size = 2u;

        if (result[i] != expected_rank) {
            std::cout << "[Failed] uneven split thread_rank mismatch at " << i
                      << ": got " << result[i] << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] uneven split num_threads mismatch at " << i
                      << ": got " << result[total_length + i] << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] uneven split meta_group_rank mismatch at " << i
                      << ": got " << result[2 * total_length + i] << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] uneven split meta_group_size mismatch at " << i
                      << ": got " << result[3 * total_length + i] << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }

    return failed;
}

uint32_t verify_tile_all_same_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;

    for (uint32_t i = 0; i < total_length; i++) {
        if (result[i] != 0) {
            std::cout << "[Failed] tile all-true meta_group_rank mismatch at " << i
                      << ": got " << result[i] << ", expected 0" << std::endl;
            failed++;
        }
        if (result[total_length + i] != 1) {
            std::cout << "[Failed] tile all-false meta_group_size mismatch at " << i
                      << ": got " << result[total_length + i] << ", expected 1" << std::endl;
            failed++;
        }
    }

    return failed;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_failed = 0;

    std::cout << "Testing binary_partition(coalesced_group, mixed pred 32 threads)..." << std::endl;
    std::vector<uint32_t> coalesced_result = run_coalesced_group_binary_test();
    total_failed += verify_coalesced_binary_result(coalesced_result, block_num, thread_num);

    std::cout << "Testing binary_partition(coalesced_group, all same pred)..." << std::endl;
    std::vector<uint32_t> all_same_result = run_all_same_test();
    total_failed += verify_all_same_result(all_same_result, block_num, thread_num);

    std::cout << "Testing binary_partition(coalesced_group, partial mask 16 threads 4 pred true)..." << std::endl;
    std::vector<uint32_t> partial_result = run_partial_mask_test();
    total_failed += verify_partial_mask_result(partial_result, block_num, 16);

    std::cout << "Testing binary_partition(coalesced_group, uneven split 1 vs 15)..." << std::endl;
    std::vector<uint32_t> uneven_result = run_uneven_split_test();
    total_failed += verify_uneven_split_result(uneven_result, block_num, 16);

    std::cout << "Testing binary_partition(thread_block_tile<2>, mixed pred)..." << std::endl;
    std::vector<uint32_t> result2 = run_tile_binary_test<2>();
    total_failed += verify_tile_binary_result<2>(result2, block_num, thread_num);

    std::cout << "Testing binary_partition(thread_block_tile<4>, mixed pred)..." << std::endl;
    std::vector<uint32_t> result4 = run_tile_binary_test<4>();
    total_failed += verify_tile_binary_result<4>(result4, block_num, thread_num);

    std::cout << "Testing binary_partition(thread_block_tile<8>, mixed pred)..." << std::endl;
    std::vector<uint32_t> result8 = run_tile_binary_test<8>();
    total_failed += verify_tile_binary_result<8>(result8, block_num, thread_num);

    std::cout << "Testing binary_partition(thread_block_tile<16>, mixed pred)..." << std::endl;
    std::vector<uint32_t> result16 = run_tile_binary_test<16>();
    total_failed += verify_tile_binary_result<16>(result16, block_num, thread_num);

    std::cout << "Testing binary_partition(thread_block_tile<32>, mixed pred)..." << std::endl;
    std::vector<uint32_t> result32 = run_tile_binary_test<32>();
    total_failed += verify_tile_binary_result<32>(result32, block_num, thread_num);

    std::cout << "Testing binary_partition(thread_block_tile<8>, all same pred)..." << std::endl;
    std::vector<uint32_t> tile_all_same8 = run_tile_all_same_test<8>();
    total_failed += verify_tile_all_same_result(tile_all_same8, block_num, thread_num);

    std::cout << "Testing binary_partition(thread_block_tile<16>, all same pred)..." << std::endl;
    std::vector<uint32_t> tile_all_same16 = run_tile_all_same_test<16>();
    total_failed += verify_tile_all_same_result(tile_all_same16, block_num, thread_num);

    if (total_failed == 0) {
        std::cout << "[Success] All binary_partition tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] binary_partition tests failed with " << total_failed << " total errors." << std::endl;
        return 1;
    }
}