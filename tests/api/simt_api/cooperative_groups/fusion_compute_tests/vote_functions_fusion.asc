/* !
 * \file vote_functions_fusion.asc
 * \brief Test vote functions in SIMD-SIMT fusion compute scenario
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

namespace {
    constexpr uint32_t THREAD_COUNT = 1024;
    constexpr uint32_t DATA_SIZE = 4096;
}

using namespace cooperative_groups;

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_vote_test_all_true_32(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    constexpr uint32_t TileSize = 32;
    thread_block g = this_thread_block();
    auto tile = tiled_partition<TileSize>(g);
    
    int predicate = 1;
    
    int any_result = tile.any(predicate);
    int all_result = tile.all(predicate);
    uint32_t ballot_result = tile.ballot(predicate);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < DATA_SIZE) {
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_vote_test_all_false_32(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    constexpr uint32_t TileSize = 32;
    thread_block g = this_thread_block();
    auto tile = tiled_partition<TileSize>(g);
    
    int predicate = 0;
    
    int any_result = tile.any(predicate);
    int all_result = tile.all(predicate);
    uint32_t ballot_result = tile.ballot(predicate);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < DATA_SIZE) {
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_vote_test_mixed_32(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    constexpr uint32_t TileSize = 32;
    thread_block g = this_thread_block();
    auto tile = tiled_partition<TileSize>(g);
    
    uint32_t tile_rank = tile.thread_rank();
    int predicate = (tile_rank % 2 == 0) ? 1 : 0;
    
    int any_result = tile.any(predicate);
    int all_result = tile.all(predicate);
    uint32_t ballot_result = tile.ballot(predicate);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < DATA_SIZE) {
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_coalesced_vote_test(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if ((threadIdx.x % 2) == 0) {
        coalesced_group g = coalesced_threads();
        
        uint32_t rank = g.thread_rank();
        int predicate = (rank % 2 == 0) ? 1 : 0;
        
        int any_result = g.any(predicate);
        int all_result = g.all(predicate);
        uint32_t ballot_result = g.ballot(predicate);
        
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    } else {
        output_any[global_idx] = 0;
        output_all[global_idx] = 0;
        output_ballot[global_idx] = 0;
    }
}

__global__ __vector__ void vote_functions_fusion_all_true_kernel(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    asc_vf_call<simt_vote_test_all_true_32>(dim3(THREAD_COUNT), 
        output_any, output_all, output_ballot);
}

__global__ __vector__ void vote_functions_fusion_all_false_kernel(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    asc_vf_call<simt_vote_test_all_false_32>(dim3(THREAD_COUNT), 
        output_any, output_all, output_ballot);
}

__global__ __vector__ void vote_functions_fusion_mixed_kernel(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    asc_vf_call<simt_vote_test_mixed_32>(dim3(THREAD_COUNT), 
        output_any, output_all, output_ballot);
}

__global__ __vector__ void vote_functions_fusion_coalesced_kernel(
    __gm__ int* output_any,
    __gm__ int* output_all,
    __gm__ uint32_t* output_ballot)
{
    asc_vf_call<simt_coalesced_vote_test>(dim3(THREAD_COUNT), 
        output_any, output_all, output_ballot);
}

std::vector<uint32_t> run_vote_test(uint32_t block_num, uint32_t thread_num, int test_type)
{
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(int);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    int* output_any = nullptr;
    int* output_all = nullptr;
    uint32_t* output_ballot = nullptr;
    
    int* output_any_host = nullptr;
    int* output_all_host = nullptr;
    uint32_t* output_ballot_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_any_host, total_byte_size);
    aclrtMallocHost((void**)&output_all_host, total_byte_size);
    aclrtMallocHost((void**)&output_ballot_host, total_byte_size);
    
    aclrtMalloc((void**)&output_any, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_all, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_ballot, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    
    if (test_type == 0) {
        vote_functions_fusion_all_true_kernel<<<block_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    } else if (test_type == 1) {
        vote_functions_fusion_all_false_kernel<<<block_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    } else if (test_type == 2) {
        vote_functions_fusion_mixed_kernel<<<block_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    } else {
        vote_functions_fusion_coalesced_kernel<<<block_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    }
    
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_any_host, total_byte_size, output_any, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_all_host, total_byte_size, output_all, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_ballot_host, total_byte_size, output_ballot, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_any_host, output_any_host + total_length);
    result.insert(result.end(), output_all_host, output_all_host + total_length);
    result.insert(result.end(), output_ballot_host, output_ballot_host + total_length);
    
    aclrtFree(output_any);
    aclrtFree(output_all);
    aclrtFree(output_ballot);
    aclrtFreeHost(output_any_host);
    aclrtFreeHost(output_all_host);
    aclrtFreeHost(output_ballot_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    constexpr uint32_t TileSize = 32;
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    std::cout << "Testing vote functions with all predicates true..." << std::endl;
    std::vector<uint32_t> result_true = run_vote_test(block_num, thread_num, 0);
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t thread_idx = i % thread_num;
        uint32_t tile_rank = thread_idx % TileSize;
        
        int expected_any = 1;
        int expected_all = 1;
        uint32_t expected_ballot = 0xFFFFFFFF;
        
        if (static_cast<int>(result_true[i]) != expected_any) {
            std::cout << "[Failed] any mismatch at " << i << ": got " << result_true[i] 
                      << ", expected " << expected_any << std::endl;
            failed++;
        }
        if (static_cast<int>(result_true[total_length + i]) != expected_all) {
            std::cout << "[Failed] all mismatch at " << i << ": got " << result_true[total_length + i] 
                      << ", expected " << expected_all << std::endl;
            failed++;
        }
        if (result_true[2 * total_length + i] != expected_ballot) {
            std::cout << "[Failed] ballot mismatch at " << i << ": got " << result_true[2 * total_length + i] 
                      << ", expected " << expected_ballot << std::endl;
            failed++;
        }
    }
    
    std::cout << "Testing vote functions with all predicates false..." << std::endl;
    std::vector<uint32_t> result_false = run_vote_test(block_num, thread_num, 1);
    
    for (uint32_t i = 0; i < total_length; i++) {
        int expected_any = 0;
        int expected_all = 0;
        uint32_t expected_ballot = 0;
        
        if (static_cast<int>(result_false[i]) != expected_any) {
            std::cout << "[Failed] any mismatch at " << i << ": got " << result_false[i] 
                      << ", expected " << expected_any << std::endl;
            failed++;
        }
        if (static_cast<int>(result_false[total_length + i]) != expected_all) {
            std::cout << "[Failed] all mismatch at " << i << ": got " << result_false[total_length + i] 
                      << ", expected " << expected_all << std::endl;
            failed++;
        }
        if (result_false[2 * total_length + i] != expected_ballot) {
            std::cout << "[Failed] ballot mismatch at " << i << ": got " << result_false[2 * total_length + i] 
                      << ", expected " << expected_ballot << std::endl;
            failed++;
        }
    }
    
    std::cout << "Testing vote functions with mixed predicates..." << std::endl;
    std::vector<uint32_t> result_mixed = run_vote_test(block_num, thread_num, 2);
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t thread_idx = i % thread_num;
        uint32_t tile_rank = thread_idx % TileSize;
        
        int expected_any = 1;
        int expected_all = 0;
        uint32_t expected_ballot = 0xAAAAAAAA;
        
        if (static_cast<int>(result_mixed[i]) != expected_any) {
            std::cout << "[Failed] any mismatch at " << i << ": got " << result_mixed[i] 
                      << ", expected " << expected_any << std::endl;
            failed++;
        }
        if (static_cast<int>(result_mixed[total_length + i]) != expected_all) {
            std::cout << "[Failed] all mismatch at " << i << ": got " << result_mixed[total_length + i] 
                      << ", expected " << expected_all << std::endl;
            failed++;
        }
        if (result_mixed[2 * total_length + i] != expected_ballot) {
            std::cout << "[Failed] ballot mismatch at " << i << ": got " << result_mixed[2 * total_length + i] 
                      << ", expected " << expected_ballot << std::endl;
            failed++;
        }
    }
    
    std::cout << "Testing vote functions with coalesced group..." << std::endl;
    std::vector<uint32_t> result_coalesced = run_vote_test(block_num, thread_num, 3);
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t thread_idx = i % thread_num;
        
        if ((thread_idx % 2) == 0) {
            uint32_t coalesced_rank = thread_idx / 2;
            
            int expected_any = 1;
            int expected_all = 0;
            uint32_t expected_ballot = (coalesced_rank % 2 == 0) ? 0x5555 : 0xAAAA;
            
            if (static_cast<int>(result_coalesced[i]) != expected_any) {
                std::cout << "[Failed] coalesced any mismatch at " << i << ": got " << result_coalesced[i] 
                          << ", expected " << expected_any << std::endl;
                failed++;
            }
            if (static_cast<int>(result_coalesced[total_length + i]) != expected_all) {
                std::cout << "[Failed] coalesced all mismatch at " << i << ": got " << result_coalesced[total_length + i] 
                          << ", expected " << expected_all << std::endl;
                failed++;
            }
        }
    }
    
    if (failed == 0) {
        std::cout << "[Success] All vote functions fusion tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] vote functions fusion tests failed with " << failed << " errors." << std::endl;
        return 1;
    }
}