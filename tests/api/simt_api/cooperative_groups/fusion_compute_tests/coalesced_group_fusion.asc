/* !
 * \file coalesced_group_fusion.asc
 * \brief Test coalesced_group in SIMD-SIMT fusion compute scenario
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

namespace {
    constexpr uint32_t THREAD_COUNT = 1024;
    constexpr uint32_t DATA_SIZE = 4096;
}

using namespace cooperative_groups;

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_coalesced_group_full_test(
    __gm__ uint32_t* output_size,
    __gm__ uint32_t* output_meta_size,
    __gm__ uint32_t* output_meta_rank)
{
    coalesced_group g = coalesced_threads();
    
    uint32_t size = static_cast<uint32_t>(g.num_threads());
    uint32_t meta_size = static_cast<uint32_t>(g.meta_group_size());
    uint32_t meta_rank = static_cast<uint32_t>(g.meta_group_rank());
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < DATA_SIZE) {
        output_size[global_idx] = size;
        output_meta_size[global_idx] = meta_size;
        output_meta_rank[global_idx] = meta_rank;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_coalesced_group_partial_test(
    __gm__ uint32_t* output_size,
    __gm__ uint32_t* output_rank)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if ((threadIdx.x % 2) == 0) {
        coalesced_group g = coalesced_threads();
        
        uint32_t size = static_cast<uint32_t>(g.num_threads());
        uint32_t rank = static_cast<uint32_t>(g.thread_rank());
        
        output_size[global_idx] = size;
        output_rank[global_idx] = rank;
    } else {
        output_size[global_idx] = 0;
        output_rank[global_idx] = 0;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_coalesced_group_sync_test(
    __gm__ uint32_t* output_result)
{
    coalesced_group g = coalesced_threads();
    
    g.sync();
    
    if (g.thread_rank() == 0) {
        output_result[blockIdx.x] = 1;
    }
}

__global__ __vector__ void coalesced_group_fusion_full_kernel(
    __gm__ uint32_t* output_size,
    __gm__ uint32_t* output_meta_size,
    __gm__ uint32_t* output_meta_rank)
{
    asc_vf_call<simt_coalesced_group_full_test>(dim3(THREAD_COUNT), 
        output_size, output_meta_size, output_meta_rank);
}

__global__ __vector__ void coalesced_group_fusion_partial_kernel(
    __gm__ uint32_t* output_size,
    __gm__ uint32_t* output_rank)
{
    asc_vf_call<simt_coalesced_group_partial_test>(dim3(THREAD_COUNT), 
        output_size, output_rank);
}

__global__ __vector__ void coalesced_group_fusion_sync_kernel(
    __gm__ uint32_t* output_result)
{
    asc_vf_call<simt_coalesced_group_sync_test>(dim3(THREAD_COUNT), output_result);
}

std::vector<uint32_t> run_full_test(uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_size = nullptr;
    uint32_t* output_meta_size = nullptr;
    uint32_t* output_meta_rank = nullptr;
    
    uint32_t* output_size_host = nullptr;
    uint32_t* output_meta_size_host = nullptr;
    uint32_t* output_meta_rank_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_rank_host, total_byte_size);
    
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    coalesced_group_fusion_full_kernel<<<block_num, dyn_ubuf_size, stream>>>(
        output_size, output_meta_size, output_meta_rank);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    
    aclrtFree(output_size);
    aclrtFree(output_meta_size);
    aclrtFree(output_meta_rank);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_size_host);
    aclrtFreeHost(output_meta_rank_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

std::vector<uint32_t> run_partial_test(uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_size = nullptr;
    uint32_t* output_rank = nullptr;
    
    uint32_t* output_size_host = nullptr;
    uint32_t* output_rank_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_rank_host, total_byte_size);
    
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    coalesced_group_fusion_partial_kernel<<<block_num, dyn_ubuf_size, stream>>>(
        output_size, output_rank);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    
    aclrtFree(output_size);
    aclrtFree(output_rank);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_rank_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

std::vector<uint32_t> run_sync_test(uint32_t block_num, uint32_t thread_num)
{
    size_t total_byte_size = block_num * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_result = nullptr;
    uint32_t* output_result_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_result_host, total_byte_size);
    aclrtMalloc((void**)&output_result, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    coalesced_group_fusion_sync_kernel<<<block_num, dyn_ubuf_size, stream>>>(output_result);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_result_host, total_byte_size, output_result, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result(output_result_host, output_result_host + block_num);
    
    aclrtFree(output_result);
    aclrtFreeHost(output_result_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    constexpr uint32_t warpSize = 32;
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    std::cout << "Testing coalesced_threads() with full warp..." << std::endl;
    std::vector<uint32_t> full_result = run_full_test(block_num, thread_num);
    
    for (uint32_t i = 0; i < total_length; i++) {
        if (full_result[i] != warpSize) {
            std::cout << "[Failed] num_threads mismatch at " << i << ": got " << full_result[i] 
                      << ", expected " << warpSize << std::endl;
            failed++;
        }
        if (full_result[total_length + i] != 1) {
            std::cout << "[Failed] meta_group_size mismatch at " << i << ": got " << full_result[total_length + i] 
                      << ", expected 1" << std::endl;
            failed++;
        }
        if (full_result[2 * total_length + i] != 0) {
            std::cout << "[Failed] meta_group_rank mismatch at " << i << ": got " << full_result[2 * total_length + i] 
                      << ", expected 0" << std::endl;
            failed++;
        }
    }
    
    std::cout << "Testing coalesced_threads() with partial warp (even threads)..." << std::endl;
    std::vector<uint32_t> partial_result = run_partial_test(block_num, thread_num);
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        if ((local_thread_idx % 2) == 0) {
            uint32_t expected_size = thread_num / 2;
            uint32_t expected_rank = local_thread_idx / 2;
            
            if (partial_result[i] != expected_size) {
                std::cout << "[Failed] partial num_threads mismatch at " << i << ": got " << partial_result[i] 
                          << ", expected " << expected_size << std::endl;
                failed++;
            }
            if (partial_result[total_length + i] != expected_rank) {
                std::cout << "[Failed] partial thread_rank mismatch at " << i << ": got " << partial_result[total_length + i] 
                          << ", expected " << expected_rank << std::endl;
                failed++;
            }
        }
    }
    
    std::cout << "Testing coalesced_group.sync()..." << std::endl;
    std::vector<uint32_t> sync_result = run_sync_test(block_num, thread_num);
    
    for (uint32_t i = 0; i < block_num; i++) {
        if (sync_result[i] != 1) {
            std::cout << "[Failed] sync result mismatch at block " << i << std::endl;
            failed++;
        }
    }
    
    if (failed == 0) {
        std::cout << "[Success] All coalesced_group fusion tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] coalesced_group fusion tests failed with " << failed << " errors." << std::endl;
        return 1;
    }
}