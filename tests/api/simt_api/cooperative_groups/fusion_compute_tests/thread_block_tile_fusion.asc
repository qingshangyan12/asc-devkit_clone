/* !
 * \file thread_block_tile_fusion.asc
 * \brief Test thread_block_tile in SIMD-SIMT fusion compute scenario
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

namespace {
    constexpr uint32_t THREAD_COUNT = 1024;
    constexpr uint32_t DATA_SIZE = 4096;
}

using namespace cooperative_groups;

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_thread_block_tile_test_32(
    __gm__ uint32_t* output_rank,
    __gm__ uint32_t* output_size,
    __gm__ uint32_t* output_meta_rank,
    __gm__ uint32_t* output_meta_size,
    __gm__ uint32_t* output_sync_result)
{
    constexpr uint32_t TileSize = 32;
    thread_block g = this_thread_block();
    auto tile = tiled_partition<TileSize>(g);
    
    uint32_t rank = static_cast<uint32_t>(tile.thread_rank());
    uint32_t size = static_cast<uint32_t>(tile.num_threads());
    uint32_t meta_rank = tile.meta_group_rank();
    uint32_t meta_size = tile.meta_group_size();
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < DATA_SIZE) {
        output_rank[global_idx] = rank;
        output_size[global_idx] = size;
        output_meta_rank[global_idx] = meta_rank;
        output_meta_size[global_idx] = meta_size;
    }
    
    tile.sync();
    
    if (tile.thread_rank() == 0) {
        uint32_t block_tile_idx = blockIdx.x * (blockDim.x / TileSize) + (threadIdx.x / TileSize);
        output_sync_result[block_tile_idx] = 1;
    }
}

__global__ __vector__ void thread_block_tile_fusion_kernel(
    __gm__ uint32_t* output_rank,
    __gm__ uint32_t* output_size,
    __gm__ uint32_t* output_meta_rank,
    __gm__ uint32_t* output_meta_size,
    __gm__ uint32_t* output_sync_result)
{
    asc_vf_call<simt_thread_block_tile_test_32>(dim3(THREAD_COUNT), 
        output_rank, output_size, output_meta_rank, output_meta_size, output_sync_result);
}

std::vector<uint32_t> run_test(uint32_t block_num, uint32_t thread_num)
{
    constexpr uint32_t tile_size = 32;
    uint32_t total_length = block_num * thread_num;
    uint32_t tiles_per_block = thread_num / tile_size;
    uint32_t total_tiles = block_num * tiles_per_block;
    
    size_t total_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_rank = nullptr;
    uint32_t* output_size = nullptr;
    uint32_t* output_meta_rank = nullptr;
    uint32_t* output_meta_size = nullptr;
    uint32_t* output_sync_result = nullptr;
    
    uint32_t* output_rank_host = nullptr;
    uint32_t* output_size_host = nullptr;
    uint32_t* output_meta_rank_host = nullptr;
    uint32_t* output_meta_size_host = nullptr;
    uint32_t* output_sync_result_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_sync_result_host, total_tiles * sizeof(uint32_t));
    
    aclrtMalloc((void**)&output_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_sync_result, total_tiles * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    thread_block_tile_fusion_kernel<<<block_num, dyn_ubuf_size, stream>>>(
        output_rank, output_size, output_meta_rank, output_meta_size, output_sync_result);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_sync_result_host, total_tiles * sizeof(uint32_t), output_sync_result, total_tiles * sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);
    result.insert(result.end(), output_sync_result_host, output_sync_result_host + total_tiles);
    
    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFree(output_sync_result);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);
    aclrtFreeHost(output_sync_result_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

uint32_t verify_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    constexpr uint32_t tile_size = 32;
    uint32_t tiles_per_block = thread_num / tile_size;
    uint32_t total_tiles = block_num * tiles_per_block;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t thread_idx = i % thread_num;
        uint32_t expected_rank = thread_idx % tile_size;
        uint32_t expected_size = tile_size;
        uint32_t expected_meta_rank = thread_idx / tile_size;
        uint32_t expected_meta_size = thread_num / tile_size;
        
        if (result[i] != expected_rank) {
            std::cout << "[Failed] thread_rank mismatch at " << i << ": got " << result[i] 
                      << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] size mismatch at " << i << ": got " << result[total_length + i] 
                      << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] meta_group_rank mismatch at " << i << ": got " << result[2 * total_length + i] 
                      << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] meta_group_size mismatch at " << i << ": got " << result[3 * total_length + i] 
                      << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }
    
    for (uint32_t i = 0; i < total_tiles; i++) {
        if (result[4 * total_length + i] != 1) {
            std::cout << "[Failed] sync result mismatch at tile " << i << std::endl;
            failed++;
        }
    }
    
    if (failed == 0) {
        std::cout << "[Success] thread_block_tile fusion test passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] thread_block_tile fusion test failed with " << failed << " errors." << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 4;
    constexpr uint32_t thread_num = 32;
    
    std::vector<uint32_t> result = run_test(block_num, thread_num);
    
    return verify_result(result, block_num, thread_num);
}