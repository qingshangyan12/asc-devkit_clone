/* !
 * \file shuffle_functions_fusion.asc
 * \brief Test shuffle functions in SIMD-SIMT fusion compute scenario
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

namespace {
    constexpr uint32_t THREAD_COUNT = 1024;
    constexpr uint32_t DATA_SIZE = 4096;
}

using namespace cooperative_groups;

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_shfl_test_32(
    __gm__ int32_t* input,
    __gm__ int32_t* output_shfl,
    __gm__ int32_t* output_shfl_up,
    __gm__ int32_t* output_shfl_down,
    __gm__ int32_t* output_shfl_xor)
{
    constexpr uint32_t TileSize = 32;
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    int32_t val = input[global_idx];
    
    int32_t shfl_result = tile.shfl(val, 0);
    int32_t shfl_up_result = tile.shfl_up(val, 1);
    int32_t shfl_down_result = tile.shfl_down(val, 1);
    int32_t shfl_xor_result = tile.shfl_xor(val, 1);
    
    if (global_idx < DATA_SIZE) {
        output_shfl[global_idx] = shfl_result;
        output_shfl_up[global_idx] = shfl_up_result;
        output_shfl_down[global_idx] = shfl_down_result;
        output_shfl_xor[global_idx] = shfl_xor_result;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_shfl_float_test_32(
    __gm__ float* input,
    __gm__ float* output_shfl,
    __gm__ float* output_shfl_up,
    __gm__ float* output_shfl_down,
    __gm__ float* output_shfl_xor)
{
    constexpr uint32_t TileSize = 32;
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    float val = input[global_idx];
    
    float shfl_result = tile.shfl(val, 0);
    float shfl_up_result = tile.shfl_up(val, 1);
    float shfl_down_result = tile.shfl_down(val, 1);
    float shfl_xor_result = tile.shfl_xor(val, 1);
    
    if (global_idx < DATA_SIZE) {
        output_shfl[global_idx] = shfl_result;
        output_shfl_up[global_idx] = shfl_up_result;
        output_shfl_down[global_idx] = shfl_down_result;
        output_shfl_xor[global_idx] = shfl_xor_result;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_coalesced_shfl_test(
    __gm__ int32_t* input,
    __gm__ int32_t* output_shfl)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if ((threadIdx.x % 2) == 0) {
        coalesced_group g = coalesced_threads();
        
        int32_t val = input[global_idx];
        int32_t shfl_result = g.shfl(val, 0);
        
        output_shfl[global_idx] = shfl_result;
    } else {
        output_shfl[global_idx] = 0;
    }
}

__global__ __vector__ void shuffle_functions_fusion_int_kernel(
    __gm__ int32_t* input,
    __gm__ int32_t* output_shfl,
    __gm__ int32_t* output_shfl_up,
    __gm__ int32_t* output_shfl_down,
    __gm__ int32_t* output_shfl_xor)
{
    asc_vf_call<simt_shfl_test_32>(dim3(THREAD_COUNT), 
        input, output_shfl, output_shfl_up, output_shfl_down, output_shfl_xor);
}

__global__ __vector__ void shuffle_functions_fusion_float_kernel(
    __gm__ float* input,
    __gm__ float* output_shfl,
    __gm__ float* output_shfl_up,
    __gm__ float* output_shfl_down,
    __gm__ float* output_shfl_xor)
{
    asc_vf_call<simt_shfl_float_test_32>(dim3(THREAD_COUNT), 
        input, output_shfl, output_shfl_up, output_shfl_down, output_shfl_xor);
}

__global__ __vector__ void shuffle_functions_fusion_coalesced_kernel(
    __gm__ int32_t* input,
    __gm__ int32_t* output_shfl)
{
    asc_vf_call<simt_coalesced_shfl_test>(dim3(THREAD_COUNT), input, output_shfl);
}

template <typename T>
std::vector<T> run_shfl_test_int(const std::vector<T>& input, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(T);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    T* input_dev = nullptr;
    T* output_shfl = nullptr;
    T* output_shfl_up = nullptr;
    T* output_shfl_down = nullptr;
    T* output_shfl_xor = nullptr;
    
    T* output_shfl_host = nullptr;
    T* output_shfl_up_host = nullptr;
    T* output_shfl_down_host = nullptr;
    T* output_shfl_xor_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_shfl_host, total_byte_size);
    aclrtMallocHost((void**)&output_shfl_up_host, total_byte_size);
    aclrtMallocHost((void**)&output_shfl_down_host, total_byte_size);
    aclrtMallocHost((void**)&output_shfl_xor_host, total_byte_size);
    
    aclrtMalloc((void**)&input_dev, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl_up, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl_down, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl_xor, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    aclrtMemcpy(input_dev, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    
    uint32_t dyn_ubuf_size = 0;
    shuffle_functions_fusion_int_kernel<<<block_num, dyn_ubuf_size, stream>>>(
        input_dev, output_shfl, output_shfl_up, output_shfl_down, output_shfl_xor);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_shfl_host, total_byte_size, output_shfl, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_shfl_up_host, total_byte_size, output_shfl_up, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_shfl_down_host, total_byte_size, output_shfl_down, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_shfl_xor_host, total_byte_size, output_shfl_xor, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<T> result;
    result.insert(result.end(), output_shfl_host, output_shfl_host + total_length);
    result.insert(result.end(), output_shfl_up_host, output_shfl_up_host + total_length);
    result.insert(result.end(), output_shfl_down_host, output_shfl_down_host + total_length);
    result.insert(result.end(), output_shfl_xor_host, output_shfl_xor_host + total_length);
    
    aclrtFree(input_dev);
    aclrtFree(output_shfl);
    aclrtFree(output_shfl_up);
    aclrtFree(output_shfl_down);
    aclrtFree(output_shfl_xor);
    aclrtFreeHost(output_shfl_host);
    aclrtFreeHost(output_shfl_up_host);
    aclrtFreeHost(output_shfl_down_host);
    aclrtFreeHost(output_shfl_xor_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

std::vector<float> run_shfl_test_float(const std::vector<float>& input, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(float);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    float* input_dev = nullptr;
    float* output_shfl = nullptr;
    float* output_shfl_up = nullptr;
    float* output_shfl_down = nullptr;
    float* output_shfl_xor = nullptr;
    
    float* output_shfl_host = nullptr;
    float* output_shfl_up_host = nullptr;
    float* output_shfl_down_host = nullptr;
    float* output_shfl_xor_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_shfl_host, total_byte_size);
    aclrtMallocHost((void**)&output_shfl_up_host, total_byte_size);
    aclrtMallocHost((void**)&output_shfl_down_host, total_byte_size);
    aclrtMallocHost((void**)&output_shfl_xor_host, total_byte_size);
    
    aclrtMalloc((void**)&input_dev, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl_up, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl_down, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_shfl_xor, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    aclrtMemcpy(input_dev, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    
    uint32_t dyn_ubuf_size = 0;
    shuffle_functions_fusion_float_kernel<<<block_num, dyn_ubuf_size, stream>>>(
        input_dev, output_shfl, output_shfl_up, output_shfl_down, output_shfl_xor);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_shfl_host, total_byte_size, output_shfl, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_shfl_up_host, total_byte_size, output_shfl_up, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_shfl_down_host, total_byte_size, output_shfl_down, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_shfl_xor_host, total_byte_size, output_shfl_xor, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<float> result;
    result.insert(result.end(), output_shfl_host, output_shfl_host + total_length);
    result.insert(result.end(), output_shfl_up_host, output_shfl_up_host + total_length);
    result.insert(result.end(), output_shfl_down_host, output_shfl_down_host + total_length);
    result.insert(result.end(), output_shfl_xor_host, output_shfl_xor_host + total_length);
    
    aclrtFree(input_dev);
    aclrtFree(output_shfl);
    aclrtFree(output_shfl_up);
    aclrtFree(output_shfl_down);
    aclrtFree(output_shfl_xor);
    aclrtFreeHost(output_shfl_host);
    aclrtFreeHost(output_shfl_up_host);
    aclrtFreeHost(output_shfl_down_host);
    aclrtFreeHost(output_shfl_xor_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    constexpr uint32_t TileSize = 32;
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    std::cout << "Testing int32_t shuffle functions..." << std::endl;
    std::vector<int32_t> input_int(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input_int[i] = static_cast<int32_t>(i % thread_num);
    }
    
    std::vector<int32_t> output_int = run_shfl_test_int<int32_t>(input_int, block_num, thread_num);
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t thread_idx = i % thread_num;
        uint32_t tile_rank = thread_idx % TileSize;
        uint32_t tile_base = thread_idx / TileSize * TileSize;
        
        int32_t expected_shfl = static_cast<int32_t>(tile_base);
        int32_t expected_shfl_up = (tile_rank > 0) ? static_cast<int32_t>(thread_idx - 1) : static_cast<int32_t>(thread_idx);
        int32_t expected_shfl_down = (tile_rank < TileSize - 1) ? static_cast<int32_t>(thread_idx + 1) : static_cast<int32_t>(thread_idx);
        int32_t expected_shfl_xor = static_cast<int32_t>(tile_base + (tile_rank ^ 1));
        
        if (output_int[i] != expected_shfl) {
            std::cout << "[Failed] shfl mismatch at " << i << ": got " << output_int[i] 
                      << ", expected " << expected_shfl << std::endl;
            failed++;
        }
        if (output_int[total_length + i] != expected_shfl_up) {
            std::cout << "[Failed] shfl_up mismatch at " << i << ": got " << output_int[total_length + i] 
                      << ", expected " << expected_shfl_up << std::endl;
            failed++;
        }
        if (output_int[2 * total_length + i] != expected_shfl_down) {
            std::cout << "[Failed] shfl_down mismatch at " << i << ": got " << output_int[2 * total_length + i] 
                      << ", expected " << expected_shfl_down << std::endl;
            failed++;
        }
        if (output_int[3 * total_length + i] != expected_shfl_xor) {
            std::cout << "[Failed] shfl_xor mismatch at " << i << ": got " << output_int[3 * total_length + i] 
                      << ", expected " << expected_shfl_xor << std::endl;
            failed++;
        }
    }
    
    std::cout << "Testing float shuffle functions..." << std::endl;
    std::vector<float> input_float(total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        input_float[i] = static_cast<float>(i % thread_num) * 1.5f;
    }
    
    std::vector<float> output_float = run_shfl_test_float(input_float, block_num, thread_num);
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t thread_idx = i % thread_num;
        uint32_t tile_rank = thread_idx % TileSize;
        uint32_t tile_base = thread_idx / TileSize * TileSize;
        
        float expected_shfl = static_cast<float>(tile_base) * 1.5f;
        float expected_shfl_up = (tile_rank > 0) ? static_cast<float>(thread_idx - 1) * 1.5f : static_cast<float>(thread_idx) * 1.5f;
        float expected_shfl_down = (tile_rank < TileSize - 1) ? static_cast<float>(thread_idx + 1) * 1.5f : static_cast<float>(thread_idx) * 1.5f;
        float expected_shfl_xor = static_cast<float>(tile_base + (tile_rank ^ 1)) * 1.5f;
        
        if (output_float[i] != expected_shfl) {
            std::cout << "[Failed] float shfl mismatch at " << i << ": got " << output_float[i] 
                      << ", expected " << expected_shfl << std::endl;
            failed++;
        }
    }
    
    if (failed == 0) {
        std::cout << "[Success] All shuffle functions fusion tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] shuffle functions fusion tests failed with " << failed << " errors." << std::endl;
        return 1;
    }
}