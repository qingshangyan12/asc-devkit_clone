uint32_t verify_tile_result(std::vector<uint32_t>& result, uint32_t TileSize, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t tiles_per_block = thread_num / TileSize;
    uint32_t total_tiles = block_num * tiles_per_block;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t expected_rank = (i % thread_num) % TileSize;
        uint32_t expected_size = TileSize;
        uint32_t expected_meta_rank = (i % thread_num) / TileSize;
        uint32_t expected_meta_size = tiles_per_block;
        
        if (result[i] != expected_rank) {
            std::cout << "[Failed] thread_rank mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[i] << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] num_threads mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[total_length + i] << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] meta_group_rank mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[2 * total_length + i] << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] meta_group_size mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[3 * total_length + i] << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }
    
    for (uint32_t i = 0; i < total_tiles; i++) {
        if (result[4 * total_length + i] != 1) {
            std::cout << "[Failed] sync result mismatch at tile " << i << " (TileSize=" << TileSize << ")" << std::endl;
            failed++;
        }
    }
    
    return failed;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_failed = 0;
    
    std::cout << "Testing thread_block_tile with TileSize=4..." << std::endl;
    std::vector<uint32_t> result4 = run_test_tile4();
    total_failed += verify_tile_result(result4, 4, block_num, thread_num);
    
    std::cout << "Testing thread_block_tile with TileSize=8..." << std::endl;
    std::vector<uint32_t> result8 = run_test_tile8();
    total_failed += verify_tile_result(result8, 8, block_num, thread_num);
    
    std::cout << "Testing thread_block_tile with TileSize=16..." << std::endl;
    std::vector<uint32_t> result16 = run_test_tile16();
    total_failed += verify_tile_result(result16, 16, block_num, thread_num);
    
    if (total_failed == 0) {
        std::cout << "[Success] All thread_block_tile tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] thread_block_tile tests failed with " << total_failed << " total errors." << std::endl;
        return 1;
    }
}
