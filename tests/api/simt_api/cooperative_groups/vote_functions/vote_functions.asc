/* !
 * \file vote_functions.asc
 * \brief Test Warp Vote Functions: any(), all(), ballot()
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"
#include "simt_api/cooperative_groups.h"

using namespace cooperative_groups;

template <unsigned int TileSize>
__global__ void vote_test_all_true(int* output_any, int* output_all, uint32_t* output_ballot)
{
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);
    
    int predicate = 1;
    
    int any_result = tile.any(predicate);
    int all_result = tile.all(predicate);
    uint32_t ballot_result = tile.ballot(predicate);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < blockDim.x * gridDim.x) {
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    }
}

template <unsigned int TileSize>
__global__ void vote_test_all_false(int* output_any, int* output_all, uint32_t* output_ballot)
{
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);
    
    int predicate = 0;
    
    int any_result = tile.any(predicate);
    int all_result = tile.all(predicate);
    uint32_t ballot_result = tile.ballot(predicate);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < blockDim.x * gridDim.x) {
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    }
}

template <unsigned int TileSize>
__global__ void vote_test_mixed(int* output_any, int* output_all, uint32_t* output_ballot)
{
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);
    
    uint32_t tile_rank = tile.thread_rank();
    int predicate = (tile_rank % 2 == 0) ? 1 : 0;
    
    int any_result = tile.any(predicate);
    int all_result = tile.all(predicate);
    uint32_t ballot_result = tile.ballot(predicate);
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < blockDim.x * gridDim.x) {
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    }
}

__global__ void coalesced_vote_test(int* output_any, int* output_all, uint32_t* output_ballot)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if ((threadIdx.x % 2) == 0) {
        coalesced_group g = coalesced_threads();
        
        uint32_t rank = g.thread_rank();
        int predicate = (rank % 2 == 0) ? 1 : 0;
        
        int any_result = g.any(predicate);
        int all_result = g.all(predicate);
        uint32_t ballot_result = g.ballot(predicate);
        
        output_any[global_idx] = any_result;
        output_all[global_idx] = all_result;
        output_ballot[global_idx] = ballot_result;
    } else {
        output_any[global_idx] = 0;
        output_all[global_idx] = 0;
        output_ballot[global_idx] = 0;
    }
}

template <unsigned int TileSize>
std::vector<int32_t> run_vote_test(const std::string& test_type)
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    size_t int_byte_size = total_length * sizeof(int);
    size_t uint_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    int* output_any = nullptr;
    int* output_all = nullptr;
    uint32_t* output_ballot = nullptr;
    
    int* output_any_host = nullptr;
    int* output_all_host = nullptr;
    uint32_t* output_ballot_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_any_host, int_byte_size);
    aclrtMallocHost((void**)&output_all_host, int_byte_size);
    aclrtMallocHost((void**)&output_ballot_host, uint_byte_size);
    
    aclrtMalloc((void**)&output_any, int_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_all, int_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_ballot, uint_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    
    if (test_type == "all_true") {
        vote_test_all_true<TileSize><<<block_num, thread_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    } else if (test_type == "all_false") {
        vote_test_all_false<TileSize><<<block_num, thread_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    } else if (test_type == "mixed") {
        vote_test_mixed<TileSize><<<block_num, thread_num, dyn_ubuf_size, stream>>>(
            output_any, output_all, output_ballot);
    }
    
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_any_host, int_byte_size, output_any, int_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_all_host, int_byte_size, output_all, int_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_ballot_host, uint_byte_size, output_ballot, uint_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<int32_t> result;
    result.insert(result.end(), output_any_host, output_any_host + total_length);
    result.insert(result.end(), output_all_host, output_all_host + total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        result.push_back(static_cast<int32_t>(output_ballot_host[i]));
    }
    
    aclrtFree(output_any);
    aclrtFree(output_all);
    aclrtFree(output_ballot);
    aclrtFreeHost(output_any_host);
    aclrtFreeHost(output_all_host);
    aclrtFreeHost(output_ballot_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

std::vector<int32_t> run_coalesced_vote_test()
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    size_t int_byte_size = total_length * sizeof(int);
    size_t uint_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    int* output_any = nullptr;
    int* output_all = nullptr;
    uint32_t* output_ballot = nullptr;
    
    int* output_any_host = nullptr;
    int* output_all_host = nullptr;
    uint32_t* output_ballot_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_any_host, int_byte_size);
    aclrtMallocHost((void**)&output_all_host, int_byte_size);
    aclrtMallocHost((void**)&output_ballot_host, uint_byte_size);
    
    aclrtMalloc((void**)&output_any, int_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_all, int_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_ballot, uint_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    coalesced_vote_test<<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_any, output_all, output_ballot);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_any_host, int_byte_size, output_any, int_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_all_host, int_byte_size, output_all, int_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_ballot_host, uint_byte_size, output_ballot, uint_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<int32_t> result;
    result.insert(result.end(), output_any_host, output_any_host + total_length);
    result.insert(result.end(), output_all_host, output_all_host + total_length);
    for (uint32_t i = 0; i < total_length; i++) {
        result.push_back(static_cast<int32_t>(output_ballot_host[i]));
    }
    
    aclrtFree(output_any);
    aclrtFree(output_all);
    aclrtFree(output_ballot);
    aclrtFreeHost(output_any_host);
    aclrtFreeHost(output_all_host);
    aclrtFreeHost(output_ballot_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

uint32_t verify_vote_result(std::vector<int32_t>& result, uint32_t TileSize, 
                            uint32_t block_num, uint32_t thread_num,
                            int expected_any, int expected_all, uint32_t expected_ballot_pattern)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        if (result[i] != expected_any) {
            std::cout << "[Failed] any mismatch at " << i << ": got " << result[i] 
                      << ", expected " << expected_any << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_all) {
            std::cout << "[Failed] all mismatch at " << i << ": got " << result[total_length + i] 
                      << ", expected " << expected_all << std::endl;
            failed++;
        }
        
        uint32_t local_thread_idx = i % thread_num;
        uint32_t tile_idx = local_thread_idx / TileSize;
        uint32_t expected_ballot = expected_ballot_pattern;
        
        if (static_cast<uint32_t>(result[2 * total_length + i]) != expected_ballot) {
            std::cout << "[Failed] ballot mismatch at " << i << " (tile_idx=" << tile_idx 
                      << "): got " << result[2 * total_length + i] 
                      << ", expected " << expected_ballot << std::endl;
            failed++;
        }
    }
    
    return failed;
}

uint32_t verify_coalesced_vote_result(std::vector<int32_t>& result, 
                                       uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    
    int expected_any = 1;
    int expected_all = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        if ((local_thread_idx % 2) == 0) {
            uint32_t group_rank = local_thread_idx / 2;
            uint32_t tile_idx = group_rank / 4;
            
            if (result[i] != expected_any) {
                std::cout << "[Failed] coalesced any mismatch at " << i << ": got " << result[i] 
                          << ", expected " << expected_any << std::endl;
                failed++;
            }
            if (result[total_length + i] != expected_all) {
                std::cout << "[Failed] coalesced all mismatch at " << i << ": got " << result[total_length + i] 
                          << ", expected " << expected_all << std::endl;
                failed++;
            }
            
            uint32_t expected_ballot = 0x5555;
            if (static_cast<uint32_t>(result[2 * total_length + i]) != expected_ballot) {
                std::cout << "[Failed] coalesced ballot mismatch at " << i << ": got " << result[2 * total_length + i] 
                          << ", expected " << expected_ballot << std::endl;
                failed++;
            }
        }
    }
    
    return failed;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t TileSize = 4;
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_failed = 0;
    
    std::cout << "Testing vote functions with all predicates true..." << std::endl;
    std::vector<int32_t> result_all_true = run_vote_test<TileSize>("all_true");
    uint32_t ballot_all_true = (1U << TileSize) - 1;
    total_failed += verify_vote_result(result_all_true, TileSize, block_num, thread_num, 
                                       1, 1, ballot_all_true);
    
    std::cout << "Testing vote functions with all predicates false..." << std::endl;
    std::vector<int32_t> result_all_false = run_vote_test<TileSize>("all_false");
    total_failed += verify_vote_result(result_all_false, TileSize, block_num, thread_num, 
                                       0, 0, 0);
    
    std::cout << "Testing vote functions with mixed predicates..." << std::endl;
    std::vector<int32_t> result_mixed = run_vote_test<TileSize>("mixed");
    uint32_t ballot_mixed = 0x5;
    total_failed += verify_vote_result(result_mixed, TileSize, block_num, thread_num, 
                                       1, 0, ballot_mixed);
    
    std::cout << "Testing vote functions on coalesced_group..." << std::endl;
    std::vector<int32_t> coalesced_result = run_coalesced_vote_test();
    total_failed += verify_coalesced_vote_result(coalesced_result, block_num, thread_num);
    
    if (total_failed == 0) {
        std::cout << "[Success] All vote function tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] vote function tests failed with " << total_failed << " total errors." << std::endl;
        return 1;
    }
}