/* !
 * \file tiled_partition.asc
 * \brief Test tiled_partition() function for thread_block and coalesced_group
 */

#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"
#include "simt_api/cooperative_groups.h"

using namespace cooperative_groups;

template <unsigned int TileSize>
__global__ void tiled_partition_thread_block_test(uint32_t* output_rank, uint32_t* output_size,
                                                   uint32_t* output_meta_rank, uint32_t* output_meta_size)
{
    thread_block g = this_thread_block();
    thread_block_tile<TileSize> tile = tiled_partition<TileSize>(g);
    
    uint32_t rank = static_cast<uint32_t>(tile.thread_rank());
    uint32_t size = static_cast<uint32_t>(tile.num_threads());
    uint32_t meta_rank = tile.meta_group_rank();
    uint32_t meta_size = tile.meta_group_size();
    
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (global_idx < blockDim.x * gridDim.x) {
        output_rank[global_idx] = rank;
        output_size[global_idx] = size;
        output_meta_rank[global_idx] = meta_rank;
        output_meta_size[global_idx] = meta_size;
    }
}

__global__ void tiled_partition_coalesced_group_test(uint32_t* output_rank, uint32_t* output_size,
                                                     uint32_t* output_meta_rank, uint32_t* output_meta_size)
{
    int32_t global_idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if ((threadIdx.x % 2) == 0) {
        coalesced_group g = coalesced_threads();
        coalesced_group tiled = tiled_partition(g, 4);
        
        uint32_t rank = static_cast<uint32_t>(tiled.thread_rank());
        uint32_t size = static_cast<uint32_t>(tiled.num_threads());
        uint32_t meta_rank = static_cast<uint32_t>(tiled.meta_group_rank());
        uint32_t meta_size = static_cast<uint32_t>(tiled.meta_group_size());
        
        output_rank[global_idx] = rank;
        output_size[global_idx] = size;
        output_meta_rank[global_idx] = meta_rank;
        output_meta_size[global_idx] = meta_size;
    } else {
        output_rank[global_idx] = 0;
        output_size[global_idx] = 0;
        output_meta_rank[global_idx] = 0;
        output_meta_size[global_idx] = 0;
    }
}

template <unsigned int TileSize>
std::vector<uint32_t> run_thread_block_test()
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_rank = nullptr;
    uint32_t* output_size = nullptr;
    uint32_t* output_meta_rank = nullptr;
    uint32_t* output_meta_size = nullptr;
    
    uint32_t* output_rank_host = nullptr;
    uint32_t* output_size_host = nullptr;
    uint32_t* output_meta_rank_host = nullptr;
    uint32_t* output_meta_size_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_size_host, total_byte_size);
    
    aclrtMalloc((void**)&output_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    tiled_partition_thread_block_test<TileSize><<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_rank, output_size, output_meta_rank, output_meta_size);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);
    
    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

std::vector<uint32_t> run_coalesced_group_test()
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_length = block_num * thread_num;
    size_t total_byte_size = total_length * sizeof(uint32_t);
    
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    
    uint32_t* output_rank = nullptr;
    uint32_t* output_size = nullptr;
    uint32_t* output_meta_rank = nullptr;
    uint32_t* output_meta_size = nullptr;
    
    uint32_t* output_rank_host = nullptr;
    uint32_t* output_size_host = nullptr;
    uint32_t* output_meta_rank_host = nullptr;
    uint32_t* output_meta_size_host = nullptr;
    
    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);
    
    aclrtMallocHost((void**)&output_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_size_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_rank_host, total_byte_size);
    aclrtMallocHost((void**)&output_meta_size_host, total_byte_size);
    
    aclrtMalloc((void**)&output_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_rank, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&output_meta_size, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    uint32_t dyn_ubuf_size = 0;
    tiled_partition_coalesced_group_test<<<block_num, thread_num, dyn_ubuf_size, stream>>>(
        output_rank, output_size, output_meta_rank, output_meta_size);
    aclrtSynchronizeStream(stream);
    
    aclrtMemcpy(output_rank_host, total_byte_size, output_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_size_host, total_byte_size, output_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_rank_host, total_byte_size, output_meta_rank, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(output_meta_size_host, total_byte_size, output_meta_size, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    
    std::vector<uint32_t> result;
    result.insert(result.end(), output_rank_host, output_rank_host + total_length);
    result.insert(result.end(), output_size_host, output_size_host + total_length);
    result.insert(result.end(), output_meta_rank_host, output_meta_rank_host + total_length);
    result.insert(result.end(), output_meta_size_host, output_meta_size_host + total_length);
    
    aclrtFree(output_rank);
    aclrtFree(output_size);
    aclrtFree(output_meta_rank);
    aclrtFree(output_meta_size);
    aclrtFreeHost(output_rank_host);
    aclrtFreeHost(output_size_host);
    aclrtFreeHost(output_meta_rank_host);
    aclrtFreeHost(output_meta_size_host);
    
    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }
    
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    
    return result;
}

uint32_t verify_thread_block_result(std::vector<uint32_t>& result, uint32_t TileSize, 
                                    uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t tiles_per_block = thread_num / TileSize;
    uint32_t failed = 0;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        uint32_t expected_rank = local_thread_idx % TileSize;
        uint32_t expected_size = TileSize;
        uint32_t expected_meta_rank = local_thread_idx / TileSize;
        uint32_t expected_meta_size = tiles_per_block;
        
        if (result[i] != expected_rank) {
            std::cout << "[Failed] thread_rank mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[i] << ", expected " << expected_rank << std::endl;
            failed++;
        }
        if (result[total_length + i] != expected_size) {
            std::cout << "[Failed] num_threads mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[total_length + i] << ", expected " << expected_size << std::endl;
            failed++;
        }
        if (result[2 * total_length + i] != expected_meta_rank) {
            std::cout << "[Failed] meta_group_rank mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[2 * total_length + i] << ", expected " << expected_meta_rank << std::endl;
            failed++;
        }
        if (result[3 * total_length + i] != expected_meta_size) {
            std::cout << "[Failed] meta_group_size mismatch at " << i << " (TileSize=" << TileSize 
                      << "): got " << result[3 * total_length + i] << ", expected " << expected_meta_size << std::endl;
            failed++;
        }
    }
    
    return failed;
}

uint32_t verify_coalesced_result(std::vector<uint32_t>& result, uint32_t block_num, uint32_t thread_num)
{
    uint32_t total_length = block_num * thread_num;
    uint32_t failed = 0;
    constexpr uint32_t TileSize = 4;
    
    for (uint32_t i = 0; i < total_length; i++) {
        uint32_t local_thread_idx = i % thread_num;
        if ((local_thread_idx % 2) == 0) {
            uint32_t group_rank = local_thread_idx / 2;
            uint32_t expected_rank = group_rank % TileSize;
            uint32_t expected_size = TileSize;
            uint32_t expected_meta_rank = group_rank / TileSize;
            uint32_t expected_meta_size = (thread_num / 2) / TileSize;
            
            if (result[i] != expected_rank) {
                std::cout << "[Failed] coalesced thread_rank mismatch at " << i << ": got " << result[i] 
                          << ", expected " << expected_rank << std::endl;
                failed++;
            }
            if (result[total_length + i] != expected_size) {
                std::cout << "[Failed] coalesced num_threads mismatch at " << i << ": got " << result[total_length + i] 
                          << ", expected " << expected_size << std::endl;
                failed++;
            }
            if (result[2 * total_length + i] != expected_meta_rank) {
                std::cout << "[Failed] coalesced meta_group_rank mismatch at " << i << ": got " << result[2 * total_length + i] 
                          << ", expected " << expected_meta_rank << std::endl;
                failed++;
            }
            if (result[3 * total_length + i] != expected_meta_size) {
                std::cout << "[Failed] coalesced meta_group_size mismatch at " << i << ": got " << result[3 * total_length + i] 
                          << ", expected " << expected_meta_size << std::endl;
                failed++;
            }
        }
    }
    
    return failed;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t block_num = 2;
    constexpr uint32_t thread_num = 32;
    uint32_t total_failed = 0;
    
    std::cout << "Testing tiled_partition<4>(thread_block)..." << std::endl;
    std::vector<uint32_t> result4 = run_thread_block_test<4>();
    total_failed += verify_thread_block_result(result4, 4, block_num, thread_num);
    
    std::cout << "Testing tiled_partition<8>(thread_block)..." << std::endl;
    std::vector<uint32_t> result8 = run_thread_block_test<8>();
    total_failed += verify_thread_block_result(result8, 8, block_num, thread_num);
    
    std::cout << "Testing tiled_partition<16>(thread_block)..." << std::endl;
    std::vector<uint32_t> result16 = run_thread_block_test<16>();
    total_failed += verify_thread_block_result(result16, 16, block_num, thread_num);
    
    std::cout << "Testing tiled_partition(coalesced_group, 4)..." << std::endl;
    std::vector<uint32_t> coalesced_result = run_coalesced_group_test();
    total_failed += verify_coalesced_result(coalesced_result, block_num, thread_num);
    
    if (total_failed == 0) {
        std::cout << "[Success] All tiled_partition tests passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] tiled_partition tests failed with " << total_failed << " total errors." << std::endl;
        return 1;
    }
}