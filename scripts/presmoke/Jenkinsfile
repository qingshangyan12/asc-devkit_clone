// ============================================================================
// asc-devkit presmoke Jenkinsfile
//
// Assumptions:
//   - Jenkins starts from an empty or reusable workspace and clones asc-devkit
//     into workspace/asc-devkit during this pipeline.
//   - The selected node already has CANN and device access prepared.
//   - One build runs one presmoke mode: npu or cpu.
// ============================================================================

def filterArgs() {
    return (params.FILTER_LIST ?: '')
        .split(/\r?\n/)
        .collect { it.trim() }
        .findAll { it && !it.startsWith('#') }
        .collect { "--filter ${it}" }
        .join(' ')
}

def mergedExtraArgs() {
    return [params.EXTRA_ARGS?.trim(), filterArgs()]
        .findAll { it }
        .join(' ')
}

pipeline {
    agent {
        docker {
            label "${env.NODE}"
            image "harbor.turing-ci.hisilicon.com/tbe-kits/ubuntu_ascendc:24.04"
            args """
                  --ipc=host
                  --device=/dev/davinci0
                  --device=/dev/davinci_manager
                  --device=/dev/devmm_svm
                  --device=/dev/hisi_hdc
                  -v /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro
                  -v /etc/ascend_install.info:/etc/ascend_install.info:ro
                  -e http_proxy=\"http://141.131.72.64:1080\"
                  -e https_proxy=\"http://141.131.72.64:1080\"
                  -e socks_proxy=\"socks5://141.131.72.64:1079\"
                  --privileged --entrypoint=''
                """
        }
    }

    environment {
        SOC_VERSION = "ascend910b"
        SHORT_SOC_VERSION = "910b"
        TORCH_DEVICE_BACKEND_AUTOLOAD = 0
        NLOHMANN_JSON_URL = 'file:///tmp/include.zip'
    }

    parameters {
        string(defaultValue: 'newest', name: 'URLS', trim: true, description: 'download pkg path\n示例： /compilepackage/CI_Version/cann/br_hisi_trunk_ai_PRE_COMPILE/202204/20220415_085143747_I56c0061\n填写 newest 会下载当天最新包')
        choice(name: 'ARCH', choices: ['dav-2201', 'dav-3510'], description: 'Target architecture: dav-2201 for 910B, dav-3510 for 950.')
        choice(name: 'MODES', choices: ['npu', 'cpu'], description: 'Presmoke execution mode.')
        string(name: 'PRIMARY_CARD', defaultValue: '0', trim: true, description: 'Primary NPU card id for npu mode.')
        string(name: 'RETRY_CARDS', defaultValue: '', trim: true, description: 'Space-separated retry card ids for timeout cases in npu mode.')
        string(name: 'JOBS', defaultValue: 'auto', trim: true, description: 'Build worker count, or auto.')
        string(name: 'NPU_SLOTS', defaultValue: '1', trim: true, description: 'NPU run queue concurrency. Keep 1 for watchdog runs.')
        string(name: 'MAKE_JOBS', defaultValue: 'auto', trim: true, description: 'Per-case make -j value, or auto.')
        string(name: 'CPU_RUN_SLOTS', defaultValue: 'auto', trim: true, description: 'CPU mode run queue slots, or auto.')
        string(name: 'TIMEOUT', defaultValue: '120', trim: true, description: 'NPU run-stage timeout in seconds.')
        string(name: 'CPU_RUN_TIMEOUT', defaultValue: '300', trim: true, description: 'CPU run-stage timeout in seconds.')
        string(name: 'EXTRA_ARGS', defaultValue: '', trim: true, description: 'Extra arguments passed to scripts/run_presmoke.sh, for example --filter <case>.')
        text(name: 'FILTER_LIST', defaultValue: '', description: 'Optional case filter list. One case path per line. Lines starting with # are ignored.')
        choice(name: 'NODE', choices: ['141.131.72.151'], description: 'Jenkins node label to select build node.')
    }

    options {
        timeout(time: 120, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {
        stage('clear workspace') {
            steps {
                sh """#!/bin/bash
                    du -h --max-depth=1
                    rm -rf ..?* .[!.]* *
                    du -h --max-depth=1
                    rm -rf /usr/local/Ascend/cann-* /usr/local/Ascend/cann /usr/local/Ascend/ascend-toolkit

                    git config --global user.email "ci_user@me.com"
                    git config --global user.name "ci_user"
                """
            }
        }

        stage('download and clone') {
            parallel {
                stage('download package') {
                    steps {
                        script {
                            if (env.URLS == "newest") {
                                env.URLS = sh(script: 'zsh -c "source /opt/conda/etc/profile.d/conda.sh && conda activate py312 && $(curl -L -k -s -o- http://tbe-kits.hisilicon.com/files/tbe_kits/get_latest_ci_url.sh)" cann_eco', returnStdout: true).trim()
                            }
                            def URLS_TAIL = "${env.URLS}".split('/')[-1]
                            currentBuild.description = "${env.NODE_NAME}: ${URLS_TAIL}"
                            sh """#!/bin/bash
                                set -e
                                set -x
                                echo "URLS: \$URLS"
                                URLS=\$(sed 's/\\/cann\\//\\/cann_eco\\//g' <<<"\$URLS")
                                bash -i -c "\$(curl -L -k -s -o- http://tbe-kits.hisilicon.com/files/tbe_kits/download_cann.sh)" -s -t toolkit ops -v ${env.SHORT_SOC_VERSION} -u \$URLS --install --pylocal --check
                            """
                        }
                    }
                }
                stage('git repo clone') {
                    steps {
                        script {
                            env.PRESMOKE_OUT_ROOT = "presmoke_reports/jenkins_${env.BUILD_NUMBER}_${params.ARCH}_${params.MODES}"
                        }
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'gitcode_http_key',
                                usernameVariable: 'GIT_USER',
                                passwordVariable: 'GIT_PASSWORD'
                            )
                        ]) {
                            sh '''#!/bin/bash
                                set -e

                                if [[ "${NODE_LABELS}" =~ "141.131.72" ]]; then
                                    PROXY_URL="141.131.72.90:3128"
                                else
                                    PROXY_URL="100.102.39.42:3128"
                                fi

                                (
                                    export http_proxy="http://${PROXY_URL}"
                                    export https_proxy="http://${PROXY_URL}"
                                    export HTTP_PROXY="http://${PROXY_URL}"
                                    export HTTPS_PROXY="http://${PROXY_URL}"

                                    source /opt/conda/etc/profile.d/conda.sh; conda activate py312
                                    rm -rf asc-devkit
                                    (cd /tmp; wget https://gitcode.com/cann-src-third-party/json/releases/download/v3.11.3/include.zip --no-check-certificate)

                                    git clone --depth 1 --branch "presmoke_opt" https://gitcode.com/xun_zhuge/asc-devkit.git asc-devkit

                                    cd asc-devkit
                                    python3 -m pip install -r .devcontainer/requirements.txt
                                    rm -rf "${PRESMOKE_OUT_ROOT}"
                                    mkdir -p "${PRESMOKE_OUT_ROOT}"
                                    bash -n scripts/run_presmoke.sh
                                )
                            '''
                        }
                    }
                }
            }
        }

        stage('presmoke') {
            steps {
                script {
                    int rc = 0
                    env.PRESMOKE_EXTRA_ARGS = mergedExtraArgs()
                    dir('asc-devkit') {
                        rc = sh(
                            returnStatus: true,
                            script: '''#!/bin/bash
                                set -o pipefail
                                source /opt/conda/etc/profile.d/conda.sh
                                conda activate py312
                                ARCH="${ARCH}" \
                                MODES="${MODES}" \
                                PRIMARY_CARD="${PRIMARY_CARD}" \
                                RETRY_CARDS="${RETRY_CARDS}" \
                                JOBS="${JOBS}" \
                                NPU_SLOTS="${NPU_SLOTS}" \
                                MAKE_JOBS="${MAKE_JOBS}" \
                                CPU_RUN_SLOTS="${CPU_RUN_SLOTS}" \
                                TIMEOUT="${TIMEOUT}" \
                                CPU_RUN_TIMEOUT="${CPU_RUN_TIMEOUT}" \
                                OUT_ROOT="${PRESMOKE_OUT_ROOT}" \
                                bash scripts/run_presmoke.sh ${PRESMOKE_EXTRA_ARGS} 2>&1 | tee "${PRESMOKE_OUT_ROOT}/jenkins_console.log"
                            '''
                        )
                    }
                    echo "presmoke rc=${rc}; report=${env.PRESMOKE_OUT_ROOT}/FINAL_REPORT.md"
                    if (rc != 0) {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            error("presmoke failed with rc=${rc}; see asc-devkit/${env.PRESMOKE_OUT_ROOT}/FINAL_REPORT.md")
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'asc-devkit/presmoke_reports/**/junit.xml'
            archiveArtifacts allowEmptyArchive: true, fingerprint: true,
                artifacts: 'asc-devkit/presmoke_reports/**/*.md, asc-devkit/presmoke_reports/**/*.tsv, asc-devkit/presmoke_reports/**/*.xml, asc-devkit/presmoke_reports/**/*.json, asc-devkit/presmoke_reports/**/*.log'
            echo "===== Final: ${currentBuild.currentResult} (duration: ${currentBuild.durationString}) ====="
        }
        success {
            echo 'All selected presmoke cases PASS'
        }
        unstable {
            echo 'Some presmoke cases FAIL or SKIP/FAIL details are available in Jenkins test view and presmoke_reports artifacts'
        }
        failure {
            echo 'Pipeline fatal error before presmoke report completion'
        }
    }
}
