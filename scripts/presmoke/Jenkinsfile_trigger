// ============================================================================
// asc-devkit presmoke trigger Jenkinsfile
//
// This upstream job only triggers downstream presmoke jobs and aggregates their
// results. The downstream jobs should use scripts/presmoke/Jenkinsfile.
// ============================================================================

def filterArgs() {
    return (params.FILTER_LIST ?: '')
        .split(/\r?\n/)
        .collect { it.trim() }
        .findAll { it && !it.startsWith('#') }
        .collect { "--filter ${it}" }
        .join(' ')
}

def mergedExtraArgs() {
    return [params.EXTRA_ARGS?.trim(), filterArgs()]
        .findAll { it }
        .join(' ')
}

def downstreamParams(Map spec) {
    return [
        string(name: 'URLS', value: params.URLS),
        string(name: 'ARCH', value: spec.arch),
        string(name: 'MODES', value: spec.mode),
        string(name: 'PRIMARY_CARD', value: spec.primaryCard),
        string(name: 'RETRY_CARDS', value: spec.retryCards),
        string(name: 'JOBS', value: params.JOBS),
        string(name: 'NPU_SLOTS', value: params.NPU_SLOTS),
        string(name: 'MAKE_JOBS', value: params.MAKE_JOBS),
        string(name: 'CPU_RUN_SLOTS', value: params.CPU_RUN_SLOTS),
        string(name: 'TIMEOUT', value: params.TIMEOUT),
        string(name: 'CPU_RUN_TIMEOUT', value: params.CPU_RUN_TIMEOUT),
        string(name: 'EXTRA_ARGS', value: mergedExtraArgs()),
    ]
}

def selectedRuns() {
    def runs = []
    if (params.RUN_910B_NPU) {
        runs << [
            id: '910B-NPU',
            job: params.JOB_910B,
            arch: 'dav-2201',
            mode: 'npu',
            primaryCard: params.PRIMARY_CARD_910B,
            retryCards: params.RETRY_CARDS_910B,
        ]
    }
    if (params.RUN_910B_CPU) {
        runs << [
            id: '910B-CPU',
            job: params.JOB_910B,
            arch: 'dav-2201',
            mode: 'cpu',
            primaryCard: params.PRIMARY_CARD_910B,
            retryCards: '',
        ]
    }
    if (params.RUN_950_NPU) {
        runs << [
            id: '950-NPU',
            job: params.JOB_950,
            arch: 'dav-3510',
            mode: 'npu',
            primaryCard: params.PRIMARY_CARD_950,
            retryCards: params.RETRY_CARDS_950,
        ]
    }
    if (params.RUN_950_CPU) {
        runs << [
            id: '950-CPU',
            job: params.JOB_950,
            arch: 'dav-3510',
            mode: 'cpu',
            primaryCard: params.PRIMARY_CARD_950,
            retryCards: '',
        ]
    }
    return runs
}

pipeline {
    agent any

    parameters {
        string(defaultValue: 'newest', name: 'URLS', trim: true, description: 'CANN package URL. Passed through to downstream jobs.')

        string(name: 'JOB_910B', defaultValue: 'asc-devkit-presmoke-910b', trim: true, description: 'Downstream 910B presmoke job name.')
        string(name: 'JOB_950', defaultValue: 'asc-devkit-presmoke-950', trim: true, description: 'Downstream 950 presmoke job name.')

        booleanParam(name: 'RUN_910B_NPU', defaultValue: true, description: 'Run 910B NPU presmoke.')
        booleanParam(name: 'RUN_910B_CPU', defaultValue: false, description: 'Run 910B CPU presmoke.')
        booleanParam(name: 'RUN_950_NPU', defaultValue: true, description: 'Run 950 NPU presmoke.')
        booleanParam(name: 'RUN_950_CPU', defaultValue: false, description: 'Run 950 CPU presmoke.')

        string(name: 'PRIMARY_CARD_910B', defaultValue: '7', trim: true, description: 'Primary card for 910B NPU mode.')
        string(name: 'RETRY_CARDS_910B', defaultValue: '0 1 2 3 4 5 6', trim: true, description: 'Retry cards for 910B timeout cases.')
        string(name: 'PRIMARY_CARD_950', defaultValue: '0', trim: true, description: 'Primary card for 950 NPU mode.')
        string(name: 'RETRY_CARDS_950', defaultValue: '', trim: true, description: 'Retry cards for 950 timeout cases.')

        string(name: 'JOBS', defaultValue: 'auto', trim: true, description: 'Build worker count passed to downstream jobs.')
        string(name: 'NPU_SLOTS', defaultValue: '1', trim: true, description: 'NPU run queue concurrency.')
        string(name: 'MAKE_JOBS', defaultValue: 'auto', trim: true, description: 'Per-case make -j value.')
        string(name: 'CPU_RUN_SLOTS', defaultValue: 'auto', trim: true, description: 'CPU mode run queue slots.')
        string(name: 'TIMEOUT', defaultValue: '120', trim: true, description: 'NPU run-stage timeout in seconds.')
        string(name: 'CPU_RUN_TIMEOUT', defaultValue: '300', trim: true, description: 'CPU run-stage timeout in seconds.')
        string(name: 'EXTRA_ARGS', defaultValue: '', trim: true, description: 'Extra args passed to downstream scripts/run_presmoke.sh.')
        text(name: 'FILTER_LIST', defaultValue: '', description: 'Optional case filter list. One case path per line. Lines starting with # are ignored.')
    }

    options {
        timeout(time: 240, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {
        stage('trigger downstream presmoke') {
            steps {
                script {
                    def runs = selectedRuns()
                    if (runs.isEmpty()) {
                        error('No downstream presmoke run selected.')
                    }

                    echo "Selected downstream runs: ${runs.collect { it.id }.join(', ')}"
                    def results = Collections.synchronizedMap([:])
                    def tasks = [:]

                    runs.each { runSpec ->
                        def spec = runSpec
                        tasks[spec.id] = {
                            def buildResult = build(
                                job: spec.job,
                                parameters: downstreamParams(spec),
                                wait: true,
                                propagate: false
                            )
                            results[spec.id] = [
                                job: spec.job,
                                number: buildResult.number,
                                result: buildResult.result ?: 'UNKNOWN',
                                url: buildResult.absoluteUrl ?: '',
                            ]
                        }
                    }

                    parallel tasks

                    echo '===== Downstream presmoke summary ====='
                    results.keySet().sort().each { key ->
                        def item = results[key]
                        echo "${key}: ${item.result} ${item.job} #${item.number} ${item.url}"
                    }

                    def failed = results.findAll { key, item -> item.result != 'SUCCESS' }
                    if (!failed.isEmpty()) {
                        currentBuild.description = failed.collect { key, item -> "${key}:${item.result}" }.join(', ')
                        unstable("Downstream presmoke has non-success result: ${currentBuild.description}")
                    } else {
                        currentBuild.description = 'all downstream presmoke success'
                    }
                }
            }
        }
    }

    post {
        always {
            echo "===== Trigger job final: ${currentBuild.currentResult} (duration: ${currentBuild.durationString}) ====="
        }
    }
}
