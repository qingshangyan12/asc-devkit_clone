 *
 * \file c_api_brcb_blkstride0.asc
 * \brief 测试 AscendC::Brcb dstBlkStride=0 是否等价于 dstBlkStride=1
 *
 * 验证结论:
 *   dstBlkStride=0 → 等价于 dstBlkStride=1
 *
 * 测试方法:
 *   1. 使用 dstBlkStride=1 执行 Brcb，记录输出 output_ref
 *   2. 使用 dstBlkStride=0 执行 Brcb，记录输出 output_test
 *   3. 比较 output_ref 和 output_test 是否完全一致
 *   4. 若一致 → PASS (确认 dstBlkStride=0 等价于 1)
 *
 * 覆盖数据类型: float
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr float INIT_VAL = 0.0f;
constexpr uint32_t SRC_COUNT = 32;
constexpr uint32_t DST_COUNT = 512;
constexpr uint8_t REPEAT_TIME = 2;
constexpr uint16_t DST_REP_STRIDE = 8;

__global__ __vector__ void brcb_blkstride1(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DST_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, SRC_COUNT);
    AscendC::DataCopy(dstLocal, dstGm, DST_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Brcb<float>(dstLocal, srcLocal, REPEAT_TIME, AscendC::BrcbRepeatParams{1, DST_REP_STRIDE});

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void brcb_blkstride0(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DST_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, SRC_COUNT);
    AscendC::DataCopy(dstLocal, dstGm, DST_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Brcb<float>(dstLocal, srcLocal, REPEAT_TIME, AscendC::BrcbRepeatParams{0, DST_REP_STRIDE});

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<typename KernelFunc>
std::vector<float> launch_brcb(std::vector<float>& src, std::vector<float>& dst, KernelFunc kernel)
{
    size_t srcBytes = src.size() * sizeof(float);
    size_t dstBytes = dst.size() * sizeof(float);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)dstOutHost, (float*)(dstOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

void print_tensor(const std::vector<float>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

bool verify_equivalent(const std::vector<float>& ref, const std::vector<float>& test, const char* name)
{
    print_tensor(ref, "Reference(dstBlkStride=1)");
    print_tensor(test, "Test(dstBlkStride=0)");

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < ref.size(); ++i) {
        if (ref[i] != test[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] FAIL: " << errIdx.size()
                  << " elements differ (expected equivalent)" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] ref=" << ref[idx]
                      << " test=" << test[idx] << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (" << (errIdx.size() - maxErr) << " more)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] PASS: all elements equivalent (dstBlkStride=0 == 1)" << std::endl;
    return true;
}

int32_t main()
{
    std::cout << "=== Brcb dstBlkStride=0 equivalence test ===" << std::endl;
    std::cout << "repeatTime: " << (int)REPEAT_TIME << ", dstRepStride: " << DST_REP_STRIDE << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    std::vector<float> src(SRC_COUNT);
    for (uint32_t i = 0; i < SRC_COUNT; ++i) {
        src[i] = (i * 0.37f) - 5.0f;
    }

    std::cout << ">>> Brcb dstBlkStride=0 vs dstBlkStride=1 <<<" << std::endl;
    print_tensor(src, "Input(src)");

    std::vector<float> dst1(DST_COUNT, INIT_VAL);
    auto output_ref = launch_brcb(src, dst1, brcb_blkstride1);

    std::vector<float> dst0(DST_COUNT, INIT_VAL);
    auto output_test = launch_brcb(src, dst0, brcb_blkstride0);

    if (!verify_equivalent(output_ref, output_test, "dstBlkStride=0")) {
        allPass = false;
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[Done] PASS - Brcb dstBlkStride=0 is equivalent to dstBlkStride=1." << std::endl;
    } else {
        std::cout << "[Done] FAILED - Brcb dstBlkStride=0 differs from dstBlkStride=1!" << std::endl;
    }
    return allPass ? 0 : 1;
}
