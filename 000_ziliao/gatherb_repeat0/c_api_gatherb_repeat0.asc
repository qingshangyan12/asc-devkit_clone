 *
 * \file c_api_gatherb_repeat0.asc
 * \brief 测试 AscendC::Gatherb repeatTime=0 时是否为空操作 (NOP)
 *
 * 验证结论:
 *   repeatTime=0 → NOP, 不写入 dst
 *
 * 测试方法:
 *   1. 将 dst LocalTensor 填充为哨兵值 999.0f
 *   2. 调用 Gatherb(dst, src, offset, repeatTime=0, {1, 8})
 *   3. 检查 dst 是否仍为 999.0f (未被修改)
 *   4. 若全部等于 999.0f → PASS (确认是 NOP)
 *
 * 覆盖数据类型: float
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr float SENTINEL_VAL = 999.0f;
constexpr uint32_t DATA_COUNT = 256;

// repeatTime=0
__global__ __vector__ void gatherb_repeat0(GM_ADDR src, GM_ADDR dst, GM_ADDR offset)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<uint32_t> offsetLocal = ubAllocator.Alloc<uint32_t, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    AscendC::GlobalTensor<uint32_t> offsetGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));
    offsetGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(offset));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::DataCopy(dstLocal, dstGm, DATA_COUNT);
    AscendC::DataCopy(offsetLocal, offsetGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // repeatTime=0, 预期 NOP
    AscendC::GatherRepeatParams params{1, 8};
    AscendC::Gatherb<float>(dstLocal, srcLocal, offsetLocal, (uint8_t)0, params);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<typename KernelFunc>
std::vector<float> launch_gatherb(std::vector<float>& src, std::vector<float>& dst,
    std::vector<uint32_t>& offset, KernelFunc kernel)
{
    size_t srcBytes = src.size() * sizeof(float);
    size_t dstBytes = dst.size() * sizeof(float);
    size_t offsetBytes = offset.size() * sizeof(uint32_t);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* offsetHost = reinterpret_cast<uint8_t*>(offset.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr, *offsetDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&offsetDev, offsetBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(offsetDev, offsetBytes, offsetHost, offsetBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(srcDev, dstDev, offsetDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)dstOutHost, (float*)(dstOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFree(offsetDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

void print_tensor(const std::vector<float>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

bool verify_nop(std::vector<float>& out, float sentinel, const char* name)
{
    print_tensor(out, "Output");

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < out.size(); ++i) {
        if (out[i] != sentinel) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] FAIL: " << errIdx.size()
                  << " elements were modified (expected NOP)" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << out[idx]
                      << " expected=" << sentinel << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (" << (errIdx.size() - maxErr) << " more)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] PASS: all elements unchanged (NOP confirmed)" << std::endl;
    return true;
}

int32_t main()
{
    std::cout << "=== Gatherb repeatTime=0 NOP test ===" << std::endl;
    std::cout << "Sentinel value: " << SENTINEL_VAL << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    std::vector<float> src(DATA_COUNT);
    std::vector<uint32_t> offset(DATA_COUNT);
    for (uint32_t i = 0; i < DATA_COUNT; ++i) {
        src[i] = (i * 0.37f) - 5.0f;
        offset[i] = i * 32;  // 32B 对齐的字节偏移
    }

    std::cout << ">>> repeatTime=0 <<<" << std::endl;
    std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
    print_tensor(src, "Input(src)");
    auto out = launch_gatherb(src, dst, offset, gatherb_repeat0);
    if (!verify_nop(out, SENTINEL_VAL, "repeatTime=0")) {
        allPass = false;
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[Done] PASS - Gatherb repeatTime=0 is confirmed NOP." << std::endl;
    } else {
        std::cout << "[Done] FAILED - Gatherb repeatTime=0 modified dst buffer!" << std::endl;
    }
    return allPass ? 0 : 1;
}
