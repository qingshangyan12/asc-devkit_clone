 *
 * \file c_api_mrgsort_repeat0.asc
 * \brief 测试 AscendC::MrgSort repeatTimes=0 时是否为空操作 (NOP)
 *
 * 验证结论:
 *   repeatTimes=0 → NOP, 不写入 dst
 *
 * 测试方法:
 *   1. 将 dst LocalTensor 填充为哨兵值 999.0f
 *   2. 调用 MrgSort(dst, srcList, MrgSort4Info{..., repeatTimes=0})
 *   3. 检查 dst 是否仍为 999.0f (未被修改)
 *   4. 若全部等于 999.0f → PASS (确认是 NOP)
 *
 * 覆盖数据类型: float
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr float SENTINEL_VAL = 999.0f;
constexpr uint32_t SRC_COUNT = 32;
constexpr uint32_t DST_COUNT = 256;

__global__ __vector__ void mrgsort_repeat0(GM_ADDR src1, GM_ADDR src2, GM_ADDR src3, GM_ADDR src4, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> src1Local = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<float> src2Local = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<float> src3Local = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<float> src4Local = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DST_COUNT>();

    AscendC::GlobalTensor<float> src1Gm;
    AscendC::GlobalTensor<float> src2Gm;
    AscendC::GlobalTensor<float> src3Gm;
    AscendC::GlobalTensor<float> src4Gm;
    AscendC::GlobalTensor<float> dstGm;
    src1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src1));
    src2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src2));
    src3Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src3));
    src4Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src4));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(src1Local, src1Gm, SRC_COUNT);
    AscendC::DataCopy(src2Local, src2Gm, SRC_COUNT);
    AscendC::DataCopy(src3Local, src3Gm, SRC_COUNT);
    AscendC::DataCopy(src4Local, src4Gm, SRC_COUNT);
    AscendC::DataCopy(dstLocal, dstGm, DST_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::MrgSortSrcList<float> srcList(src1Local, src2Local, src3Local, src4Local);
    uint16_t elemLens[4] = {SRC_COUNT, SRC_COUNT, SRC_COUNT, SRC_COUNT};
    AscendC::MrgSort4Info info(elemLens, false, 15, 0);

    AscendC::MrgSort<float>(dstLocal, srcList, info);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<typename KernelFunc>
std::vector<float> launch_mrgsort(std::vector<float>& src1, std::vector<float>& src2,
                                   std::vector<float>& src3, std::vector<float>& src4,
                                   std::vector<float>& dst, KernelFunc kernel)
{
    size_t srcBytes = src1.size() * sizeof(float);
    size_t dstBytes = dst.size() * sizeof(float);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* src1Host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* src2Host = reinterpret_cast<uint8_t*>(src2.data());
    uint8_t* src3Host = reinterpret_cast<uint8_t*>(src3.data());
    uint8_t* src4Host = reinterpret_cast<uint8_t*>(src4.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *src1Dev = nullptr, *src2Dev = nullptr, *src3Dev = nullptr, *src4Dev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&src1Dev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src2Dev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src3Dev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src4Dev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(src1Dev, srcBytes, src1Host, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src2Dev, srcBytes, src2Host, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src3Dev, srcBytes, src3Host, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src4Dev, srcBytes, src4Host, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(src1Dev, src2Dev, src3Dev, src4Dev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)dstOutHost, (float*)(dstOutHost + dstBytes));

    aclrtFree(src1Dev);
    aclrtFree(src2Dev);
    aclrtFree(src3Dev);
    aclrtFree(src4Dev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

void print_tensor(const std::vector<float>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

bool verify_nop(std::vector<float>& out, float sentinel, const char* name)
{
    print_tensor(out, "Output");

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < out.size(); ++i) {
        if (out[i] != sentinel) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] FAIL: " << errIdx.size()
                  << " elements were modified (expected NOP)" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << out[idx]
                      << " expected=" << sentinel << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (" << (errIdx.size() - maxErr) << " more)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] PASS: all elements unchanged (NOP confirmed)" << std::endl;
    return true;
}

int32_t main()
{
    std::cout << "=== MrgSort repeatTimes=0 NOP test ===" << std::endl;
    std::cout << "Sentinel value: " << SENTINEL_VAL << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    std::vector<float> src1(SRC_COUNT);
    std::vector<float> src2(SRC_COUNT);
    std::vector<float> src3(SRC_COUNT);
    std::vector<float> src4(SRC_COUNT);
    for (uint32_t i = 0; i < SRC_COUNT; ++i) {
        src1[i] = (i * 0.37f) - 5.0f;
        src2[i] = (i * 0.53f) - 3.0f;
        src3[i] = (i * 0.71f) - 7.0f;
        src4[i] = (i * 0.19f) - 1.0f;
    }

    std::cout << ">>> MrgSort repeatTimes=0 <<<" << std::endl;
    std::vector<float> dst(DST_COUNT, SENTINEL_VAL);
    print_tensor(src1, "Input(src1)");
    auto out = launch_mrgsort(src1, src2, src3, src4, dst, mrgsort_repeat0);
    if (!verify_nop(out, SENTINEL_VAL, "repeatTimes=0")) {
        allPass = false;
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[Done] PASS - MrgSort repeatTimes=0 is confirmed NOP." << std::endl;
    } else {
        std::cout << "[Done] FAILED - MrgSort repeatTimes=0 modified dst buffer!" << std::endl;
    }
    return allPass ? 0 : 1;
}
