 * Copyright (c) 2026 Huawei Technologies Co., Ltd.
 * CANN Open Software License Agreement Version 2.0
 *
 * \file c_api_setpadvalue_cross_core.asc
 * \brief 测试 SetPadValue 是否跨不同 AI Core 生效
 *
 * 测试方法:
 *   1. 使用 <<<2, ...>>> 启动 2 个 block，调度到 2 个不同的 AI Core
 *   2. Block 0: SetPadValue<int8_t>(7) + DataCopyPad(isPad=false) → dst[0..31]
 *   3. SyncAll() 确保 Block 0 的 SetPadValue 已完成
 *   4. Block 1: 不调用 SetPadValue, 直接 DataCopyPad(isPad=false) → dst[32..63]
 *   5. 验证:
 *      - dst[0..5] (Block 0 leftPad) 应为 7
 *      - dst[32..37] (Block 1 leftPad):
 *        - 若 = 7 → pad value 跨核共享（per-device）
 *        - 若 ≠ 7 → pad value 是 per-core
 *
 * 注意: 此测试假设 <<<2, ...>>> 会调度到不同 AI Core，
 *       实际调度行为取决于 runtime，不 100% 保证。
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr int8_t PAD_VAL = 7;
constexpr int8_t INIT_VAL = 0;
constexpr uint32_t BLOCK_COUNT = 1;
constexpr uint32_t BLOCK_LEN = 20;
constexpr uint8_t LEFT_PAD = 6;
constexpr uint8_t RIGHT_PAD = 6;
constexpr uint32_t DST_SIZE = 32;
constexpr uint32_t NUM_BLOCKS = 2;

__global__ __vector__ void cross_core_kernel(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    int32_t blockIdx = AscendC::GetBlockIdx();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<int8_t> dstLocal = ubAllocator.Alloc<int8_t, DST_SIZE>();

    AscendC::GlobalTensor<int8_t> srcGm;
    AscendC::GlobalTensor<int8_t> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(dst) + blockIdx * DST_SIZE);

    AscendC::DataCopyExtParams copyParams{BLOCK_COUNT, BLOCK_LEN, 0, 0, 0};
    AscendC::DataCopyPadExtParams<int8_t> padParams{false, LEFT_PAD, RIGHT_PAD, 0};

    if (blockIdx == 0) {
        AscendC::SetPadValue<int8_t>(PAD_VAL);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    AscendC::SyncAll();

    AscendC::DataCopyPad<int8_t>(dstLocal, srcGm, copyParams, padParams);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_SIZE);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main()
{
    std::cout << "=== SetPadValue cross-core test ===" << std::endl;
    std::cout << "Pad value: " << (int)PAD_VAL << std::endl;
    std::cout << "blockLen=" << BLOCK_LEN << " leftPad=" << (int)LEFT_PAD
              << " rightPad=" << (int)RIGHT_PAD << std::endl;
    std::cout << "numBlocks=" << NUM_BLOCKS << std::endl;
    std::cout << std::endl;

    size_t srcBytes = DST_SIZE * sizeof(int8_t);
    size_t dstBytes = DST_SIZE * NUM_BLOCKS * sizeof(int8_t);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    std::vector<int8_t> src(DST_SIZE);
    for (uint32_t i = 0; i < BLOCK_LEN; ++i) {
        src[i] = static_cast<int8_t>(i + 1);
    }
    std::vector<int8_t> dst(DST_SIZE * NUM_BLOCKS, INIT_VAL);

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    cross_core_kernel<<<NUM_BLOCKS, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> out((int8_t*)dstOutHost, (int8_t*)(dstOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    auto print_region = [&](size_t offset, size_t len, const std::string& name) {
        std::cout << "  " << name << " [" << offset << ".." << (offset + len - 1) << "]: ";
        for (size_t i = 0; i < len; ++i) {
            std::cout << (int)out[offset + i] << " ";
        }
        std::cout << std::endl;
    };

    auto check_padding = [&](size_t offset, int8_t expectedPad, const char* name) -> bool {
        bool ok = true;
        for (size_t i = 0; i < LEFT_PAD; ++i) {
            if (out[offset + i] != expectedPad) { ok = false; }
        }
        for (size_t i = 0; i < RIGHT_PAD; ++i) {
            if (out[offset + LEFT_PAD + BLOCK_LEN + i] != expectedPad) { ok = false; }
        }
        print_region(offset, LEFT_PAD, std::string(name) + " leftPad");
        print_region(offset + LEFT_PAD, BLOCK_LEN, std::string(name) + " data");
        print_region(offset + LEFT_PAD + BLOCK_LEN, RIGHT_PAD, std::string(name) + " rightPad");
        return ok;
    };

    std::cout << ">>> Block 0: SetPadValue(7) + DataCopyPad(isPad=false) <<<" << std::endl;
    bool block0_ok = check_padding(0, PAD_VAL, "block0");
    std::cout << "  [block0] " << (block0_ok ? "PASS" : "FAIL") << std::endl;

    std::cout << std::endl;
    std::cout << ">>> Block 1: NO SetPadValue, DataCopyPad(isPad=false) <<<" << std::endl;

    bool block1_is_7 = check_padding(DST_SIZE, PAD_VAL, "block1(=7?)");
    if (block1_is_7) {
        std::cout << "  [block1] padding = " << (int)PAD_VAL << " → pad value 跨核共享 (per-device)" << std::endl;
    } else {
        std::cout << "  [block1] padding ≠ " << (int)PAD_VAL << " → pad value 是 per-core" << std::endl;
        std::cout << "  block1 leftPad 实际值: ";
        for (size_t i = 0; i < LEFT_PAD; ++i) {
            std::cout << (int)out[DST_SIZE + i] << " ";
        }
        std::cout << std::endl;
    }

    std::cout << std::endl;
    if (!block0_ok) {
        std::cout << "[Done] Block 0 失败，测试无效。" << std::endl;
        return 1;
    }
    if (block1_is_7) {
        std::cout << "[Done] 结论: pad value 跨 AI Core 共享。" << std::endl;
    } else {
        std::cout << "[Done] 结论: pad value 是 per-core，不跨核共享。" << std::endl;
    }
    return 0;
}
