 *
 * \file c_api_sort32_repeat0.asc
 * \brief 测试 AscendC::Sort32 repeatTime=0 时是否为空操作 (NOP)
 *
 * 验证结论:
 *   repeatTime=0 → NOP, 不写入 dst
 *
 * 测试方法:
 *   1. 将 dst LocalTensor 填充为哨兵值 999.0f
 *   2. 调用 Sort32(dst, src0, src1, repeatTime=0)
 *   3. 检查 dst 是否仍为 999.0f (未被修改)
 *   4. 若全部等于 999.0f → PASS (确认是 NOP)
 *
 * 覆盖数据类型: float
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr float SENTINEL_VAL = 999.0f;
constexpr uint32_t SRC_COUNT = 32;
constexpr uint32_t DST_COUNT = 256;

__global__ __vector__ void sort32_repeat0(GM_ADDR src0, GM_ADDR src1, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> src0Local = ubAllocator.Alloc<float, SRC_COUNT>();
    AscendC::LocalTensor<uint32_t> src1Local = ubAllocator.Alloc<uint32_t, SRC_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DST_COUNT>();

    AscendC::GlobalTensor<float> src0Gm;
    AscendC::GlobalTensor<uint32_t> src1Gm;
    AscendC::GlobalTensor<float> dstGm;
    src0Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src0));
    src1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(src1));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(src0Local, src0Gm, SRC_COUNT);
    AscendC::DataCopy(src1Local, src1Gm, SRC_COUNT);
    AscendC::DataCopy(dstLocal, dstGm, DST_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Sort32<float>(dstLocal, src0Local, src1Local, (int32_t)0);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<typename KernelFunc>
std::vector<float> launch_sort32(std::vector<float>& src0, std::vector<uint32_t>& src1,
                                  std::vector<float>& dst, KernelFunc kernel)
{
    size_t src0Bytes = src0.size() * sizeof(float);
    size_t src1Bytes = src1.size() * sizeof(uint32_t);
    size_t dstBytes = dst.size() * sizeof(float);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* src0Host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* src1Host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *src0Dev = nullptr, *src1Dev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&src0Dev, src0Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1Dev, src1Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(src0Dev, src0Bytes, src0Host, src0Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1Dev, src1Bytes, src1Host, src1Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(src0Dev, src1Dev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)dstOutHost, (float*)(dstOutHost + dstBytes));

    aclrtFree(src0Dev);
    aclrtFree(src1Dev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

void print_tensor(const std::vector<float>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

bool verify_nop(std::vector<float>& out, float sentinel, const char* name)
{
    print_tensor(out, "Output");

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < out.size(); ++i) {
        if (out[i] != sentinel) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] FAIL: " << errIdx.size()
                  << " elements were modified (expected NOP)" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << out[idx]
                      << " expected=" << sentinel << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (" << (errIdx.size() - maxErr) << " more)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] PASS: all elements unchanged (NOP confirmed)" << std::endl;
    return true;
}

int32_t main()
{
    std::cout << "=== Sort32 repeatTime=0 NOP test ===" << std::endl;
    std::cout << "Sentinel value: " << SENTINEL_VAL << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    std::vector<float> src0(SRC_COUNT);
    std::vector<uint32_t> src1(SRC_COUNT);
    for (uint32_t i = 0; i < SRC_COUNT; ++i) {
        src0[i] = (i * 0.37f) - 5.0f;
        src1[i] = i;
    }

    std::cout << ">>> Sort32 repeatTime=0 <<<" << std::endl;
    std::vector<float> dst(DST_COUNT, SENTINEL_VAL);
    print_tensor(src0, "Input(src0)");
    auto out = launch_sort32(src0, src1, dst, sort32_repeat0);
    if (!verify_nop(out, SENTINEL_VAL, "repeatTime=0")) {
        allPass = false;
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[Done] PASS - Sort32 repeatTime=0 is confirmed NOP." << std::endl;
    } else {
        std::cout << "[Done] FAILED - Sort32 repeatTime=0 modified dst buffer!" << std::endl;
    }
    return allPass ? 0 : 1;
}
