 * CANN Open Software License Agreement Version 2.0
 *
 * \file c_api_gatherb_blkstride0.asc
 * \brief 测试 AscendC::Gatherb dstBlkStride=0 时是否等价于 dstBlkStride=1
 *
 * 验证结论:
 *   dstBlkStride=0 → 默认按照 1 来处理
 *
 * 测试方法:
 *   1. 用同一组 src 和 offset 数据
 *   2. 第一次调用: Gatherb(dst_a, src, offset, repeatTime=1, {0, 8}) — dstBlkStride=0
 *   3. 第二次调用: Gatherb(dst_b, src, offset, repeatTime=1, {1, 8}) — dstBlkStride=1
 *   4. 比较 dst_a 和 dst_b 的每个元素
 *   5. 若完全相同 → PASS (确认 dstBlkStride=0 等价于 1)
 *
 * 覆盖数据类型: float
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <fstream>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t DATA_COUNT = 256;

// 同一个 kernel 内做两次 Gatherb, 分别写入 dst_a 和 dst_b
__global__ __vector__ void gatherb_blkstride0(GM_ADDR src, GM_ADDR dst_a, GM_ADDR dst_b, GM_ADDR offset)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstALocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstBLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<uint32_t> offsetLocal = ubAllocator.Alloc<uint32_t, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstAGm;
    AscendC::GlobalTensor<float> dstBGm;
    AscendC::GlobalTensor<uint32_t> offsetGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstAGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst_a));
    dstBGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst_b));
    offsetGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(offset));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::DataCopy(dstALocal, dstAGm, DATA_COUNT);
    AscendC::DataCopy(dstBLocal, dstBGm, DATA_COUNT);
    AscendC::DataCopy(offsetLocal, offsetGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // 第一次: dstBlkStride=0
    AscendC::GatherRepeatParams params0{0, 8};
    AscendC::Gatherb<float>(dstALocal, srcLocal, offsetLocal, (uint8_t)1, params0);

    // 第二次: dstBlkStride=1
    AscendC::GatherRepeatParams params1{1, 8};
    AscendC::Gatherb<float>(dstBLocal, srcLocal, offsetLocal, (uint8_t)1, params1);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstAGm, dstALocal, DATA_COUNT);
    AscendC::DataCopy(dstBGm, dstBLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

std::pair<std::vector<float>, std::vector<float>> launch_gatherb(std::vector<float>& src,
    std::vector<float>& dst_a, std::vector<float>& dst_b, std::vector<uint32_t>& offset)
{
    size_t srcBytes = src.size() * sizeof(float);
    size_t dstBytes = dst_a.size() * sizeof(float);
    size_t offsetBytes = offset.size() * sizeof(uint32_t);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstAHost = reinterpret_cast<uint8_t*>(dst_a.data());
    uint8_t* dstBHost = reinterpret_cast<uint8_t*>(dst_b.data());
    uint8_t* offsetHost = reinterpret_cast<uint8_t*>(offset.data());
    uint8_t* dstAOutHost = nullptr;
    uint8_t* dstBOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstADev = nullptr, *dstBDev = nullptr, *offsetDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstAOutHost, dstBytes);
    aclrtMallocHost((void**)&dstBOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstADev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstBDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&offsetDev, offsetBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstADev, dstBytes, dstAHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstBDev, dstBytes, dstBHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(offsetDev, offsetBytes, offsetHost, offsetBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    gatherb_blkstride0<<<1, nullptr, stream>>>(srcDev, dstADev, dstBDev, offsetDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstAOutHost, dstBytes, dstADev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dstBOutHost, dstBytes, dstBDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out_a((float*)dstAOutHost, (float*)(dstAOutHost + dstBytes));
    std::vector<float> out_b((float*)dstBOutHost, (float*)(dstBOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstADev);
    aclrtFree(dstBDev);
    aclrtFree(offsetDev);
    aclrtFreeHost(dstAOutHost);
    aclrtFreeHost(dstBOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return {out_a, out_b};
}

void print_tensor(const std::vector<float>& t, const std::string& name)
{
    constexpr size_t maxPrint = 20;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

bool verify_equal(std::vector<float>& out_a, std::vector<float>& out_b, const char* name)
{
    print_tensor(out_a, "Output(dstBlkStride=0)");
    print_tensor(out_b, "Output(dstBlkStride=1)");

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < out_a.size(); ++i) {
        if (out_a[i] != out_b[i]) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] FAIL: " << errIdx.size()
                  << " elements differ between dstBlkStride=0 and dstBlkStride=1" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] dstBlkStride=0: " << out_a[idx]
                      << " dstBlkStride=1: " << out_b[idx] << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (" << (errIdx.size() - maxErr) << " more)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] PASS: dstBlkStride=0 produces identical output to dstBlkStride=1" << std::endl;
    return true;
}

int32_t main()
{
    std::cout << "=== Gatherb dstBlkStride=0 equivalence test ===" << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    std::vector<float> src(DATA_COUNT);
    std::vector<uint32_t> offset(DATA_COUNT);
    for (uint32_t i = 0; i < DATA_COUNT; ++i) {
        src[i] = (i * 0.37f) - 5.0f;
        offset[i] = i * 32;  // 32B 对齐的字节偏移
    }

    std::cout << ">>> repeatTime=1, dstBlkStride=0 vs dstBlkStride=1 <<<" << std::endl;
    std::vector<float> dst_a(DATA_COUNT, 0.0f);
    std::vector<float> dst_b(DATA_COUNT, 0.0f);
    print_tensor(src, "Input(src)");
    auto [out_a, out_b] = launch_gatherb(src, dst_a, dst_b, offset);
    if (!verify_equal(out_a, out_b, "dstBlkStride=0 vs 1")) {
        allPass = false;
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[Done] PASS - Gatherb dstBlkStride=0 is equivalent to dstBlkStride=1." << std::endl;
    } else {
        std::cout << "[Done] FAILED - Gatherb dstBlkStride=0 differs from dstBlkStride=1!" << std::endl;
    }
    return allPass ? 0 : 1;
}
