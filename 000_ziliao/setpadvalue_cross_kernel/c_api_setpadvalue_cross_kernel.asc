 *
 * \file c_api_setpadvalue_cross_kernel.asc
 * \brief 测试 SetPadValue 是否能跨多次 kernel launch 持久生效
 *
 * 测试方法:
 *   1. Kernel 1: SetPadValue<int8_t>(7) + DataCopyPad(isPad=false) → dst1
 *   2. Kernel 2: 不调用 SetPadValue, 直接 DataCopyPad(isPad=false) → dst2
 *   3. 验证 dst1 padding = 7 (kernel 1 设置生效)
 *   4. 验证 dst2 padding = 7 (SPR 跨 kernel launch 持久)
 *
 * 预期结论:
 *   InitSocState 不重置 pad value SPR，SetPadValue 跨 kernel launch 持久生效
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr int8_t PAD_VAL = 7;
constexpr int8_t INIT_VAL = 0;
constexpr uint32_t BLOCK_COUNT = 1;
constexpr uint32_t BLOCK_LEN = 20;
constexpr uint8_t LEFT_PAD = 6;
constexpr uint8_t RIGHT_PAD = 6;
constexpr uint32_t DST_SIZE = 32;

__global__ __vector__ void set_pad_kernel(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<int8_t> dstLocal = ubAllocator.Alloc<int8_t, DST_SIZE>();

    AscendC::GlobalTensor<int8_t> srcGm;
    AscendC::GlobalTensor<int8_t> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(dst));

    AscendC::SetPadValue<int8_t>(PAD_VAL);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopyExtParams copyParams{BLOCK_COUNT, BLOCK_LEN, 0, 0, 0};
    AscendC::DataCopyPadExtParams<int8_t> padParams{false, LEFT_PAD, RIGHT_PAD, 0};

    AscendC::DataCopyPad<int8_t>(dstLocal, srcGm, copyParams, padParams);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_SIZE);
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void check_pad_kernel(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<int8_t> dstLocal = ubAllocator.Alloc<int8_t, DST_SIZE>();

    AscendC::GlobalTensor<int8_t> srcGm;
    AscendC::GlobalTensor<int8_t> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(dst));

    AscendC::DataCopyExtParams copyParams{BLOCK_COUNT, BLOCK_LEN, 0, 0, 0};
    AscendC::DataCopyPadExtParams<int8_t> padParams{false, LEFT_PAD, RIGHT_PAD, 0};

    AscendC::DataCopyPad<int8_t>(dstLocal, srcGm, copyParams, padParams);

    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DST_SIZE);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<typename KernelFunc>
std::vector<int8_t> launch_kernel(std::vector<int8_t>& src, std::vector<int8_t>& dst, KernelFunc kernel)
{
    size_t srcBytes = src.size() * sizeof(int8_t);
    size_t dstBytes = dst.size() * sizeof(int8_t);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> out((int8_t*)dstOutHost, (int8_t*)(dstOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

void print_region(const std::vector<int8_t>& data, size_t offset, size_t len, const std::string& name)
{
    std::cout << "  " << name << " [" << offset << ".." << (offset + len - 1) << "]: ";
    for (size_t i = 0; i < len; ++i) {
        std::cout << (int)data[offset + i] << " ";
    }
    std::cout << std::endl;
}

bool verify_padding(const std::vector<int8_t>& data, size_t offset, int8_t padVal, const char* regionName)
{
    bool ok = true;

    for (size_t i = 0; i < LEFT_PAD; ++i) {
        if (data[offset + i] != padVal) { ok = false; }
    }
    for (size_t i = 0; i < RIGHT_PAD; ++i) {
        if (data[offset + LEFT_PAD + BLOCK_LEN + i] != padVal) { ok = false; }
    }

    print_region(data, offset, LEFT_PAD, std::string(regionName) + " leftPad");
    print_region(data, offset + LEFT_PAD, BLOCK_LEN, std::string(regionName) + " data");
    print_region(data, offset + LEFT_PAD + BLOCK_LEN, RIGHT_PAD, std::string(regionName) + " rightPad");

    if (!ok) {
        std::cout << "  [" << regionName << "] FAIL: padding != " << (int)padVal << std::endl;
        return false;
    }

    std::cout << "  [" << regionName << "] PASS: padding = " << (int)padVal << std::endl;
    return true;
}

int32_t main()
{
    std::cout << "=== SetPadValue cross-kernel persistence test ===" << std::endl;
    std::cout << "Pad value: " << (int)PAD_VAL << std::endl;
    std::cout << "blockLen=" << BLOCK_LEN << " leftPad=" << (int)LEFT_PAD
              << " rightPad=" << (int)RIGHT_PAD << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    std::vector<int8_t> src(DST_SIZE);
    for (uint32_t i = 0; i < BLOCK_LEN; ++i) {
        src[i] = static_cast<int8_t>(i + 1);
    }

    std::cout << ">>> Kernel 1: SetPadValue(7) + DataCopyPad(isPad=false) <<<" << std::endl;
    std::vector<int8_t> dst1(DST_SIZE, INIT_VAL);
    auto out1 = launch_kernel(src, dst1, set_pad_kernel);
    if (!verify_padding(out1, 0, PAD_VAL, "kernel1")) {
        allPass = false;
    }

    std::cout << std::endl;
    std::cout << ">>> Kernel 2: NO SetPadValue, DataCopyPad(isPad=false) <<<" << std::endl;
    std::vector<int8_t> dst2(DST_SIZE, INIT_VAL);
    auto out2 = launch_kernel(src, dst2, check_pad_kernel);
    if (!verify_padding(out2, 0, PAD_VAL, "kernel2")) {
        allPass = false;
    }

    std::cout << std::endl;
    if (allPass) {
        std::cout << "[Done] PASS - SetPadValue persists across kernel launches." << std::endl;
    } else {
        std::cout << "[Done] FAILED - SetPadValue did NOT persist across kernel launches!" << std::endl;
    }
    return allPass ? 0 : 1;
}
