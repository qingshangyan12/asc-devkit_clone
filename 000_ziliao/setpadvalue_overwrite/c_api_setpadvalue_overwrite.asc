 *
 * \file c_api_setpadvalue_overwrite.asc
 * \brief 测试 DataCopyPad(isPad=true) 是否会覆盖 SetPadValue 设置的 SPR 值
 *
 * 测试方法:
 *   1. SetPadValue<int8_t>(7)
 *   2. DataCopyPad(isPad=true, paddingValue=99) → dst1
 *   3. DataCopyPad(isPad=false) → dst2
 *   4. 验证 dst1 padding = 99, dst2 padding = ?
 *      - 若 dst2 padding = 99 → SPR 被覆盖 (DataCopyPad isPad=true 会覆写 SPR)
 *      - 若 dst2 padding = 7  → SPR 未被覆盖
 *
 * 预期结论:
 *   DataCopyPad(isPad=true) 内部调用 set_mov_pad_val，会覆盖 SPR 中的值
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr int8_t PAD_VAL_INITIAL = 7;
constexpr int8_t PAD_VAL_INLINE = 99;
constexpr int8_t INIT_VAL = 0;
constexpr uint32_t BLOCK_COUNT = 1;
constexpr uint32_t BLOCK_LEN = 20;
constexpr uint8_t LEFT_PAD = 6;
constexpr uint8_t RIGHT_PAD = 6;
constexpr uint32_t DST_SIZE = 32;

__global__ __vector__ void setpadvalue_overwrite_kernel(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<int8_t> srcLocal = ubAllocator.Alloc<int8_t, DST_SIZE>();
    AscendC::LocalTensor<int8_t> dst1Local = ubAllocator.Alloc<int8_t, DST_SIZE>();
    AscendC::LocalTensor<int8_t> dst2Local = ubAllocator.Alloc<int8_t, DST_SIZE>();

    AscendC::GlobalTensor<int8_t> srcGm;
    AscendC::GlobalTensor<int8_t> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DST_SIZE);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::SetPadValue<int8_t>(PAD_VAL_INITIAL);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopyExtParams copyParams{BLOCK_COUNT, BLOCK_LEN, 0, 0, 0};

    AscendC::DataCopyPadExtParams<int8_t> padParamsInline{true, 0, 0, PAD_VAL_INLINE};
    AscendC::DataCopyPad<int8_t>(dst1Local, srcGm, copyParams, padParamsInline);

    AscendC::DataCopyPadExtParams<int8_t> padParamsReg{false, 0, 0, 0};
    AscendC::DataCopyPad<int8_t>(dst2Local, srcGm, copyParams, padParamsReg);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dst1Local, DST_SIZE);
    AscendC::DataCopy(dstGm[DST_SIZE], dst2Local, DST_SIZE);
    AscendC::PipeBarrier<PIPE_ALL>();
}

template<typename KernelFunc>
std::vector<int8_t> launch_kernel(std::vector<int8_t>& src, std::vector<int8_t>& dst, KernelFunc kernel)
{
    size_t srcBytes = src.size() * sizeof(int8_t);
    size_t dstBytes = dst.size() * sizeof(int8_t);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int8_t> out((int8_t*)dstOutHost, (int8_t*)(dstOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

void print_region(const std::vector<int8_t>& data, size_t offset, size_t len, const std::string& name)
{
    std::cout << "  " << name << " [" << offset << ".." << (offset + len - 1) << "]: ";
    for (size_t i = 0; i < len; ++i) {
        std::cout << (int)(uint8_t)data[offset + i] << " ";
    }
    std::cout << std::endl;
}

bool check_padding(const std::vector<int8_t>& data, size_t offset, int8_t expectedPad, const char* regionName)
{
    bool ok = true;

    for (size_t i = 0; i < LEFT_PAD; ++i) {
        if (data[offset + i] != expectedPad) { ok = false; }
    }
    for (size_t i = 0; i < RIGHT_PAD; ++i) {
        if (data[offset + LEFT_PAD + BLOCK_LEN + i] != expectedPad) { ok = false; }
    }

    print_region(data, offset, LEFT_PAD, std::string(regionName) + " leftPad");
    print_region(data, offset + LEFT_PAD, BLOCK_LEN, std::string(regionName) + " data");
    print_region(data, offset + LEFT_PAD + BLOCK_LEN, RIGHT_PAD, std::string(regionName) + " rightPad");

    if (!ok) {
        std::cout << "  [" << regionName << "] padding != " << (int)expectedPad << std::endl;
    } else {
        std::cout << "  [" << regionName << "] padding = " << (int)expectedPad << std::endl;
    }
    return ok;
}

int32_t main()
{
    std::cout << "=== SetPadValue overwrite test ===" << std::endl;
    std::cout << "Initial pad: " << (int)PAD_VAL_INITIAL
              << ", Inline pad: " << (int)PAD_VAL_INLINE << std::endl;
    std::cout << "blockLen=" << BLOCK_LEN << " leftPad=" << (int)LEFT_PAD
              << " rightPad=" << (int)RIGHT_PAD << std::endl;
    std::cout << std::endl;

    std::vector<int8_t> src(DST_SIZE);
    for (uint32_t i = 0; i < BLOCK_LEN; ++i) {
        src[i] = static_cast<int8_t>(i + 1);
    }

    std::vector<int8_t> dst(DST_SIZE * 2, INIT_VAL);
    auto out = launch_kernel(src, dst, setpadvalue_overwrite_kernel);

    std::cout << ">>> copy1: DataCopyPad(isPad=true, paddingValue=" << (int)PAD_VAL_INLINE << ") <<<" << std::endl;
    bool copy1_99 = check_padding(out, 0, PAD_VAL_INLINE, "copy1");
    bool copy1_7 = false;
    if (!copy1_99) {
        copy1_7 = check_padding(out, 0, PAD_VAL_INITIAL, "copy1(fallback)");
    }

    std::cout << std::endl;
    std::cout << ">>> copy2: DataCopyPad(isPad=false) — 检查 SPR 中的值 <<<" << std::endl;
    bool copy2_99 = check_padding(out, DST_SIZE, PAD_VAL_INLINE, "copy2(=99?)");
    bool copy2_7 = false;
    if (!copy2_99) {
        copy2_7 = check_padding(out, DST_SIZE, PAD_VAL_INITIAL, "copy2(=7?)");
    }

    std::cout << std::endl;
    std::cout << "=== 结论 ===" << std::endl;
    if (copy1_99 && copy2_99) {
        std::cout << "[Done] SPR 被覆盖 — DataCopyPad(isPad=true) 内部调用 set_mov_pad_val 覆写了 SPR。" << std::endl;
        std::cout << "  copy1 padding = " << (int)PAD_VAL_INLINE << " (inline value)" << std::endl;
        std::cout << "  copy2 padding = " << (int)PAD_VAL_INLINE << " (SPR was overwritten)" << std::endl;
    } else if (copy1_99 && copy2_7) {
        std::cout << "[Done] SPR 未被覆盖 — DataCopyPad(isPad=true) 不影响 SPR 寄存器。" << std::endl;
        std::cout << "  copy1 padding = " << (int)PAD_VAL_INLINE << " (inline value)" << std::endl;
        std::cout << "  copy2 padding = " << (int)PAD_VAL_INITIAL << " (SPR preserved)" << std::endl;
    } else {
        std::cout << "[Done] 结果异常，padding 值既不是 " << (int)PAD_VAL_INLINE
                  << " 也不是 " << (int)PAD_VAL_INITIAL << std::endl;
    }
    return 0;
}
