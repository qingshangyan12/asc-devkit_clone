 *
 * \file c_api_datacopy_blockcount0.asc
 * \brief 测试 DataCopy(DataCopyParams) 中 blockCount/blockLen=0 时是否为 NOP
 *
 * 文档说明（仅针对 A3/A2）:
 *   当 DataCopyParams 的 blockCount 或 blockLen 任意一个为 0 时，该接口被视为 NOP。
 *   文档标注此约束仅针对 Atlas A3 和 Atlas A2 产品。
 *
 * 本测试验证 A5 (dav_3510) 上是否同样成立。
 *
 * 测试场景:
 *   1. GM->UB, blockCount=0, blockLen=4
 *   2. GM->UB, blockCount=2, blockLen=0
 *   3. GM->UB, blockCount=0, blockLen=0
 *   4. UB->GM, blockCount=0, blockLen=4
 *   5. UB->GM, blockCount=2, blockLen=0
 *   6. UB->GM, blockCount=0, blockLen=0
 *
 * 测试方法:
 *   dst 填充哨兵值 999.0f，调用 DataCopy(params含零值)，验证 dst 未被修改。
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr float SENTINEL_VAL = 999.0f;
constexpr uint32_t DATA_COUNT = 32;

// ============================================================================
// GM->UB direction: blockCount=0
// ============================================================================
__global__ __vector__ void kernel_gm2ub_count0(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    // Load sentinel into UB dst
    AscendC::DataCopy(dstLocal, dstGm, DATA_COUNT);
    // Load valid data into UB src (not strictly needed, but ensures srcGm is valid)
    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // blockCount=0, should be NOP
    AscendC::DataCopyParams params;
    params.blockCount = 0;
    params.blockLen = 4;  // 4 DataBlocks = 128B = 32 floats
    params.srcGap = 0;
    params.dstGap = 0;
    AscendC::DataCopy(dstLocal, srcGm, params);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// GM->UB direction: blockLen=0
// ============================================================================
__global__ __vector__ void kernel_gm2ub_len0(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(dstLocal, dstGm, DATA_COUNT);
    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // blockLen=0, should be NOP
    AscendC::DataCopyParams params;
    params.blockCount = 2;
    params.blockLen = 0;
    params.srcGap = 0;
    params.dstGap = 0;
    AscendC::DataCopy(dstLocal, srcGm, params);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// GM->UB direction: both=0
// ============================================================================
__global__ __vector__ void kernel_gm2ub_both0(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(dstLocal, dstGm, DATA_COUNT);
    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // both=0, should be NOP
    AscendC::DataCopyParams params;
    params.blockCount = 0;
    params.blockLen = 0;
    params.srcGap = 0;
    params.dstGap = 0;
    AscendC::DataCopy(dstLocal, srcGm, params);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// UB->GM direction: blockCount=0
// ============================================================================
__global__ __vector__ void kernel_ub2gm_count0(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    // Load valid data into UB src
    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // blockCount=0, should be NOP — dstGm (sentinel) should remain unchanged
    AscendC::DataCopyParams params;
    params.blockCount = 0;
    params.blockLen = 4;
    params.srcGap = 0;
    params.dstGap = 0;
    AscendC::DataCopy(dstGm, srcLocal, params);

    AscendC::PipeBarrier<PIPE_ALL>();
}

