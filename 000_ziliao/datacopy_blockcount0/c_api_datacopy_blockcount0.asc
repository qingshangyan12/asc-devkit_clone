    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // blockLen=0, should be NOP
    AscendC::DataCopyParams params;
    params.blockCount = 2;
    params.blockLen = 0;
    params.srcGap = 0;
    params.dstGap = 0;
    AscendC::DataCopy(dstGm, srcLocal, params);

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// UB->GM direction: both=0
// ============================================================================
__global__ __vector__ void kernel_ub2gm_both0(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // both=0, should be NOP
    AscendC::DataCopyParams params;
    params.blockCount = 0;
    params.blockLen = 0;
    params.srcGap = 0;
    params.dstGap = 0;
    AscendC::DataCopy(dstGm, srcLocal, params);

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Launch helper
// ============================================================================
template<typename KernelFunc>
std::vector<float> launch_kernel(std::vector<float>& src, std::vector<float>& dst, KernelFunc kernel)
{
    size_t srcBytes = src.size() * sizeof(float);
    size_t dstBytes = dst.size() * sizeof(float);
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dstHost = reinterpret_cast<uint8_t*>(dst.data());
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dstDev, dstBytes, dstHost, dstBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> out((float*)dstOutHost, (float*)(dstOutHost + dstBytes));

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

// ============================================================================
// Verification
// ============================================================================
void print_tensor(const std::vector<float>& t, const std::string& name)
{
    constexpr size_t maxPrint = 16;
    std::cout << "  " << name << " (" << t.size() << " elements): ";
    for (size_t i = 0; i < std::min(t.size(), maxPrint); ++i) {
        std::cout << t[i] << " ";
    }
    if (t.size() > maxPrint) std::cout << "...";
    std::cout << std::endl;
}

bool verify_nop(const std::vector<float>& out, float sentinel, const char* name)
{
    print_tensor(out, "Output");

    bool ok = true;
    std::vector<size_t> errIdx;
    for (size_t i = 0; i < out.size(); ++i) {
        if (out[i] != sentinel) {
            ok = false;
            errIdx.push_back(i);
        }
    }

    if (!ok) {
        std::cout << "  [" << name << "] FAIL: " << errIdx.size()
                  << " elements were modified (expected NOP)" << std::endl;
        size_t maxErr = std::min(errIdx.size(), size_t(8));
        for (size_t e = 0; e < maxErr; ++e) {
            size_t idx = errIdx[e];
            std::cout << "    [" << idx << "] output=" << out[idx]
                      << " expected=" << sentinel << std::endl;
        }
        if (errIdx.size() > maxErr) {
            std::cout << "    ... (" << (errIdx.size() - maxErr) << " more)" << std::endl;
        }
        return false;
    }

    std::cout << "  [" << name << "] PASS: all elements unchanged (NOP confirmed)" << std::endl;
    return true;
}

// ============================================================================
// Main
// ============================================================================
int32_t main()
{
    std::cout << "=== DataCopy blockCount/blockLen=0 NOP Test (dav_3510) ===" << std::endl;
    std::cout << "Sentinel value: " << SENTINEL_VAL << std::endl;
    std::cout << "DATA_COUNT: " << DATA_COUNT << " floats (" << DATA_COUNT * sizeof(float) << " bytes)" << std::endl;
    std::cout << std::endl;

    bool allPass = true;

    // Prepare source data
    std::vector<float> src(DATA_COUNT);
    for (uint32_t i = 0; i < DATA_COUNT; ++i) {
        src[i] = static_cast<float>(i + 1);
    }

    // ---- GM->UB tests ----

    // Test 1: GM->UB, blockCount=0, blockLen=4
    {
        std::cout << "--- Test 1: GM->UB, blockCount=0, blockLen=4 ---" << std::endl;
        std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
        auto out = launch_kernel(src, dst, kernel_gm2ub_count0);
        if (!verify_nop(out, SENTINEL_VAL, "gm2ub_count0")) allPass = false;
        std::cout << std::endl;
    }

    // Test 2: GM->UB, blockCount=2, blockLen=0
    {
        std::cout << "--- Test 2: GM->UB, blockCount=2, blockLen=0 ---" << std::endl;
        std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
        auto out = launch_kernel(src, dst, kernel_gm2ub_len0);
        if (!verify_nop(out, SENTINEL_VAL, "gm2ub_len0")) allPass = false;
        std::cout << std::endl;
    }

    // Test 3: GM->UB, blockCount=0, blockLen=0
    {
        std::cout << "--- Test 3: GM->UB, blockCount=0, blockLen=0 ---" << std::endl;
        std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
        auto out = launch_kernel(src, dst, kernel_gm2ub_both0);
        if (!verify_nop(out, SENTINEL_VAL, "gm2ub_both0")) allPass = false;
        std::cout << std::endl;
    }

    // ---- UB->GM tests ----

    // Test 4: UB->GM, blockCount=0, blockLen=4
    {
        std::cout << "--- Test 4: UB->GM, blockCount=0, blockLen=4 ---" << std::endl;
        std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
        auto out = launch_kernel(src, dst, kernel_ub2gm_count0);
        if (!verify_nop(out, SENTINEL_VAL, "ub2gm_count0")) allPass = false;
        std::cout << std::endl;
    }

    // Test 5: UB->GM, blockCount=2, blockLen=0
    {
        std::cout << "--- Test 5: UB->GM, blockCount=2, blockLen=0 ---" << std::endl;
        std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
        auto out = launch_kernel(src, dst, kernel_ub2gm_len0);
        if (!verify_nop(out, SENTINEL_VAL, "ub2gm_len0")) allPass = false;
        std::cout << std::endl;
    }

    // Test 6: UB->GM, blockCount=0, blockLen=0
    {
        std::cout << "--- Test 6: UB->GM, blockCount=0, blockLen=0 ---" << std::endl;
        std::vector<float> dst(DATA_COUNT, SENTINEL_VAL);
        auto out = launch_kernel(src, dst, kernel_ub2gm_both0);
        if (!verify_nop(out, SENTINEL_VAL, "ub2gm_both0")) allPass = false;
        std::cout << std::endl;
    }

    // Summary
    if (allPass) {
        std::cout << "[Done] PASS - All 6 tests passed. blockCount/blockLen=0 is NOP on dav_3510." << std::endl;
    } else {
        std::cout << "[Done] FAILED - Some tests failed. NOP behavior may not hold on dav_3510." << std::endl;
    }
    return allPass ? 0 : 1;
}
