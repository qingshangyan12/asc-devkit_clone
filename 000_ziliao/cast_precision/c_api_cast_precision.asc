        AscendC::Cast<int32_t, float>(d[2], s, CEIL, 1);
        AscendC::Cast<int32_t, float>(d[3], s, ROUND, 1);
        AscendC::Cast<int32_t, float>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[10], d, 5);
    }
    // Test 15: double→int32_t, input=-1.5, TRUNC
    {
        auto s = alloc.Alloc<double, 1>();
        AscendC::GlobalTensor<double> sg; sg.SetGlobalBuffer((__gm__ double*)src + 2);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int32_t, 1>();
        AscendC::Cast<int32_t, double>(d, s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[15], d, 1);
    }
    // Test 16: int8_t→int32_t, input=127 (no loss)
    {
        auto s = alloc.Alloc<int8_t, 1>();
        AscendC::GlobalTensor<int8_t> sg; sg.SetGlobalBuffer((__gm__ int8_t*)src + 20);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int32_t, 1>();
        AscendC::Cast<int32_t, int8_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[16], d, 1);
    }
    // Test 17: int16_t→int32_t, input=32767 (no loss)
    {
        auto s = alloc.Alloc<int16_t, 1>();
        AscendC::GlobalTensor<int16_t> sg; sg.SetGlobalBuffer((__gm__ int16_t*)src + 12);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
