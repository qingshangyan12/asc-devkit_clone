        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int64_t, 5>();
        AscendC::Cast<int64_t, float>(d, s, RINT, 1);
        AscendC::Cast<int64_t, float>(d[1], s, FLOOR, 1);
        AscendC::Cast<int64_t, float>(d[2], s, CEIL, 1);
        AscendC::Cast<int64_t, float>(d[3], s, ROUND, 1);
        AscendC::Cast<int64_t, float>(d[4], s, TRUNC, 1);
