 * \file c_api_cast_precision.asc
 * \brief 批量测试 Cast API 精度转换规则，验证文档描述和示例是否正确
 *
 * 覆盖文档 precision_conversion.md 中"精度转换规则"一节的所有转换
 * 输出格式便于分析：每个测试点显示 input/output/expected/PASS/FAIL
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <string>
#include <cmath>
#include <cstring>
#include <iomanip>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t DATA_COUNT = 256;

// Test result structure
struct TestResult {
    std::string name;
    bool passed;
    double expected;
    double actual;
};

std::vector<TestResult> g_results;

void record_result(const std::string& name, bool passed, double expected, double actual) {
    g_results.push_back({name, passed, expected, actual});
}

// ============================================================================
// Kernel: int8 -> half (5 round modes)
// ============================================================================
__global__ __vector__ void kernel_int8_to_half(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<int8_t> srcLocal = ubAllocator.Alloc<int8_t, DATA_COUNT>();
    AscendC::LocalTensor<half> dstLocal = ubAllocator.Alloc<half, DATA_COUNT>();

    AscendC::GlobalTensor<int8_t> srcGm;
    AscendC::GlobalTensor<half> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // Test input: -1 (at index 0)
    AscendC::Cast<half, int8_t>(dstLocal[0], srcLocal, AscendC::RoundMode::CAST_RINT, 1);
    AscendC::Cast<half, int8_t>(dstLocal[1], srcLocal, AscendC::RoundMode::CAST_FLOOR, 1);
    AscendC::Cast<half, int8_t>(dstLocal[2], srcLocal, AscendC::RoundMode::CAST_CEIL, 1);
    AscendC::Cast<half, int8_t>(dstLocal[3], srcLocal, AscendC::RoundMode::CAST_ROUND, 1);
    AscendC::Cast<half, int8_t>(dstLocal[4], srcLocal, AscendC::RoundMode::CAST_TRUNC, 1);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Kernel: int16 -> half (5 round modes)
// ============================================================================
__global__ __vector__ void kernel_int16_to_half(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
