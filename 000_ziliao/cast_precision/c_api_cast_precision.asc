        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 1);
    }
    // Test 1-5: float→int64_t, input=2^22+0.5
    {
        auto s = alloc.Alloc<float, 1>();
