// --- TO_UINT8: half→uint8, int16→uint8, int32→uint8, uint16→uint8, uint32→uint8 ---
__global__ __vector__ void kernel_to_uint8(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    AscendC::GlobalTensor<uint8_t> dstGm;
