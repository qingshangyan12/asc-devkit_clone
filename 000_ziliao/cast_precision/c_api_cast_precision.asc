        AscendC::Cast<bfloat16_t, double>(d[2], s, CEIL, 1);
        AscendC::Cast<bfloat16_t, double>(d[3], s, ROUND, 1);
        AscendC::Cast<bfloat16_t, double>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 5);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// --- SATURATION: int64→int32 ---
__global__ __vector__ void kernel_to_int32_sat(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    AscendC::GlobalTensor<int32_t> dstGm;
    dstGm.SetGlobalBuffer((__gm__ int32_t*)dst);

    // Test 0: int64_t→int32_t, input=2^31 (saturation)
    {
        auto s = alloc.Alloc<int64_t, 1>();
        AscendC::GlobalTensor<int64_t> sg; sg.SetGlobalBuffer((__gm__ int64_t*)src);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int32_t, 1>();
        AscendC::Cast<int32_t, int64_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 1);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== Host-side launch and verification ====================

template<typename HOST_SRC, typename HOST_DST, typename KernelFunc>
std::vector<HOST_DST> launch(KernelFunc kernel,
                              const std::vector<HOST_SRC>& src, size_t dstCount)
{
    size_t srcBytes = src.size() * sizeof(HOST_SRC);
    size_t dstBytes = dstCount * sizeof(HOST_DST);
    int32_t devId = 0;
    aclrtStream stream = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr, *dstOutHost = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);
    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(srcDev, srcBytes, src.data(), srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel<<<1, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<HOST_DST> out((HOST_DST*)dstOutHost, (HOST_DST*)(dstOutHost + dstBytes));
    aclrtFree(srcDev); aclrtFree(dstDev); aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream); aclrtResetDevice(devId); aclFinalize();
    return out;
}

static const char* rm_name(RM m) {
    if (m == RINT) return "RINT"; if (m == FLOOR) return "FLOOR";
    if (m == CEIL) return "CEIL"; if (m == ROUND) return "ROUND";
    if (m == TRUNC) return "TRUNC"; if (m == ODD) return "ODD";
    return "NONE";
}

template<typename T>
bool check_val(const T& actual, const T& expected, const char* id, const char* mode, double input_val) {
    bool ok = (memcmp(&actual, &expected, sizeof(T)) == 0);
    std::cout << "  [" << id << "] " << std::setw(5) << mode
              << "  input=" << std::setw(18) << input_val
              << "  output=";
    if constexpr (sizeof(T) <= 8) {
        if constexpr (std::is_same_v<T, float> || std::is_same_v<T, double>) {
            std::cout << std::setw(18) << std::setprecision(10) << (double)actual;
        } else {
            std::cout << std::setw(18) << (int64_t)actual;
        }
    }
    std::cout << "  expected=";
    if constexpr (sizeof(T) <= 8) {
        if constexpr (std::is_same_v<T, float> || std::is_same_v<T, double>) {
            std::cout << std::setw(18) << std::setprecision(10) << (double)expected;
        } else {
            std::cout << std::setw(18) << (int64_t)expected;
        }
    }
    std::cout << "  " << (ok ? "PASS" : "FAIL") << std::endl;
    if (ok) g_pass++; else g_fail++;
    return ok;
}

bool check_half(uint16_t actual_bits, float expected_val, const char* id, const char* mode, double input_val) {
    uint16_t exp_bits = host_to_half(expected_val);
    bool ok = (actual_bits == exp_bits);
    float actual_val = half_to_host(actual_bits);
    std::cout << "  [" << id << "] " << std::setw(5) << mode
              << "  input=" << std::setw(18) << std::setprecision(10) << input_val
              << "  output=" << std::setw(18) << std::setprecision(10) << actual_val
              << "(0x" << std::hex << actual_bits << std::dec << ")"
              << "  expected=" << std::setw(12) << std::setprecision(10) << expected_val
              << "(0x" << std::hex << exp_bits << std::dec << ")"
              << "  " << (ok ? "PASS" : "FAIL") << std::endl;
    if (ok) g_pass++; else g_fail++;
    return ok;
}

bool check_bf16(uint16_t actual_bits, float expected_val, const char* id, const char* mode, double input_val) {
    uint16_t exp_bits = host_to_bf16(expected_val);
    bool ok = (actual_bits == exp_bits);
    float actual_val = bf16_to_host(actual_bits);
    std::cout << "  [" << id << "] " << std::setw(5) << mode
              << "  input=" << std::setw(18) << std::setprecision(10) << input_val
              << "  output=" << std::setw(18) << std::setprecision(10) << actual_val
              << "(0x" << std::hex << actual_bits << std::dec << ")"
              << "  expected=" << std::setw(12) << std::setprecision(10) << expected_val
              << "(0x" << std::hex << exp_bits << std::dec << ")"
              << "  " << (ok ? "PASS" : "FAIL") << std::endl;
    if (ok) g_pass++; else g_fail++;
    return ok;
}

bool check_int(int64_t actual, int64_t expected, const char* id, const char* mode, double input_val) {
    bool ok = (actual == expected);
    std::cout << "  [" << id << "] " << std::setw(5) << mode
              << "  input=" << std::setw(18) << std::setprecision(10) << input_val
              << "  output=" << std::setw(18) << actual
              << "  expected=" << std::setw(18) << expected
              << "  " << (ok ? "PASS" : "FAIL") << std::endl;
    if (ok) g_pass++; else g_fail++;
    return ok;
}

// ==================== Main ====================

int32_t main()
{
    std::cout << "=== Cast Precision Conversion Test (dav_3510) ===" << std::endl;
    std::cout << std::endl;

    // ---- TO_HALF ----
    {
        std::cout << "--- TO_HALF ---" << std::endl;
        // Prepare src buffer with mixed types at known offsets
        // Offset 0: int8_t=-1 (1 byte)
        // Offset 8: int16_t=4098 (at byte 16, i.e. 8 int16_t elements from start)
        // Offset 20: uint8_t=1 (at byte 20)
        // Offset 8 (float area): float=0.5+2^-12 (at byte 32, i.e. 8 float elements)
        std::vector<uint8_t> src_buf(64, 0);
        int8_t v_i8 = -1; memcpy(src_buf.data() + 0, &v_i8, 1);
        int16_t v_i16 = 4098; memcpy(src_buf.data() + 16, &v_i16, 2);
        uint8_t v_u8 = 1; memcpy(src_buf.data() + 20, &v_u8, 1);
        float v_f = 0.5f + ldexpf(1.0f, -12); memcpy(src_buf.data() + 32, &v_f, 4);

        std::vector<uint8_t> dst_buf(64, 0);
        auto out = launch<uint8_t, uint16_t>(kernel_to_half, src_buf, 21);

        // int8→half: input=-1, expected=-1.0 for all modes
        for (int i = 0; i < 5; i++) {
            check_half(out[i], -1.0f, "A01 i8->half", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), -1);
        }
        // int16→half: input=4098
        float exp_c01[] = {4096.0f, 4096.0f, 4100.0f, 4100.0f, 4096.0f};
        for (int i = 0; i < 5; i++) {
            check_half(out[5+i], exp_c01[i], "C01 i16->half", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 4098);
        }
        // uint8→half: input=1, expected=1.0 for all modes
        for (int i = 0; i < 5; i++) {
            check_half(out[10+i], 1.0f, "A04 u8->half", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 1);
        }
        // float→half: input=0.5+2^-12
        float inp_c08 = 0.5f + ldexpf(1.0f, -12);
        float exp_c08[] = {0.5f, 0.5f, 0.5f+ldexpf(1.0f,-11), 0.5f+ldexpf(1.0f,-11), 0.5f, 0.5f+ldexpf(1.0f,-11)};
        const char* modes_c08[] = {"RINT","FLOOR","CEIL","ROUND","TRUNC","ODD"};
        for (int i = 0; i < 6; i++) {
            check_half(out[15+i], exp_c08[i], "C08 f->half", modes_c08[i], inp_c08);
        }
        std::cout << std::endl;
    }

    // ---- TO_BF16 ----
    {
        std::cout << "--- TO_BF16 ---" << std::endl;
        std::vector<uint8_t> src_buf(64, 0);
        uint16_t v_half_175 = host_to_half(1.75f); memcpy(src_buf.data() + 0, &v_half_175, 2);
        float v_f_bf = 0.5f + ldexpf(1.0f, -9) + ldexpf(1.0f, -11); memcpy(src_buf.data() + 32, &v_f_bf, 4);

        auto out = launch<uint8_t, uint16_t>(kernel_to_bf16, src_buf, 10);

        // half→bf16: input=1.75
        float exp_c04[] = {2.0f, 1.0f, 2.0f, 2.0f, 1.0f};
        for (int i = 0; i < 5; i++) {
            check_bf16(out[i], exp_c04[i], "C04 half->bf16", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 1.75);
        }
        // float→bf16: input=0.5+2^-9+2^-11
        float inp_c09 = 0.5f + ldexpf(1.0f, -9) + ldexpf(1.0f, -11);
        float exp_c09[] = {0.5f+ldexpf(1.0f,-8), 0.5f, 0.5f+ldexpf(1.0f,-8), 0.5f+ldexpf(1.0f,-8), 0.5f};
        for (int i = 0; i < 5; i++) {
            check_bf16(out[5+i], exp_c09[i], "C09 f->bf16", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), inp_c09);
        }
        std::cout << std::endl;
    }

    // ---- TO_FLOAT ----
    {
        std::cout << "--- TO_FLOAT ---" << std::endl;
        std::vector<uint8_t> src_buf(128, 0);
        int16_t v_i16 = 32767; memcpy(src_buf.data() + 0, &v_i16, 2);
        int32_t v_i32 = (1<<25)+3; memcpy(src_buf.data() + 16, &v_i32, 4);
        int64_t v_i64 = (1LL<<35)+(1LL<<12)+(1LL<<11); memcpy(src_buf.data() + 32, &v_i64, 8);
        uint16_t v_half = host_to_half(1.5f - ldexpf(1.0f, -10)); memcpy(src_buf.data() + 40, &v_half, 2);
        uint16_t v_bf16 = host_to_bf16(1.5f - ldexpf(1.0f, -6)); memcpy(src_buf.data() + 48, &v_bf16, 2);
        double v_dbl = (double)(1LL<<35)+(double)(1LL<<12)+(double)(1LL<<11); memcpy(src_buf.data() + 32, &v_dbl, 8);
        float v_f05 = 0.5f; memcpy(src_buf.data() + 48, &v_f05, 4);

        // Re-prepare with correct offsets for each sub-test
        std::vector<uint8_t> src2(128, 0);
        int16_t vv16 = 32767; memcpy(src2.data(), &vv16, 2); // offset 0: int16 for to_float test 0-4
        int32_t vv32 = (1<<25)+3; memcpy(src2.data()+16, &vv32, 4); // offset 16 (=4 int32): for test 5-9
        int64_t vv64 = (1LL<<35)+(1LL<<12)+(1LL<<11); memcpy(src2.data()+32, &vv64, 8); // offset 32 (=4 int64): for test 10-14
        uint16_t vh = host_to_half(1.5f - ldexpf(1.0f,-10)); memcpy(src2.data()+40, &vh, 2); // offset 40 (=20 half): test 15
        uint16_t vb = host_to_bf16(1.5f - ldexpf(1.0f,-6)); memcpy(src2.data()+48, &vb, 2); // offset 48 (=24 bf16): test 16
        double vd = (double)(1LL<<35)+(double)(1LL<<12)+(double)(1LL<<11); memcpy(src2.data()+32, &vd, 8); // offset 32 (=4 double): test 17-21
        float vf = 0.5f; memcpy(src2.data()+48, &vf, 4); // offset 48 (=12 float): test 22-26

        auto out = launch<uint8_t, float>(kernel_to_float, src2, 27);

        // int16→float: input=32767, no loss
        for (int i = 0; i < 5; i++) {
            check_val<float>(out[i], 32767.0f, "A08 i16->f", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 32767);
        }
        // int32→float: input=2^25+3=33554435
        float inp_c07 = 33554435.0f;
        float exp_c07[] = {33554436.0f, 33554432.0f, 33554436.0f, 33554436.0f, 33554432.0f};
        for (int i = 0; i < 5; i++) {
            check_val<float>(out[5+i], exp_c07[i], "C07 i32->f", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), inp_c07);
        }
        // int64→float: input=2^35+2^12+2^11
        double inp_f01 = (double)(1LL<<35)+(double)(1LL<<12)+(double)(1LL<<11);
        float exp_f01[] = {(float)(1LL<<35)+(float)(1LL<<13), (float)(1LL<<35)+(float)(1LL<<12),
                           (float)(1LL<<35)+(float)(1LL<<13), (float)(1LL<<35)+(float)(1LL<<13),
                           (float)(1LL<<35)+(float)(1LL<<12)};
        for (int i = 0; i < 5; i++) {
            check_val<float>(out[10+i], exp_f01[i], "F01 i64->f", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), inp_f01);
        }
        // half→float: input=1.5-2^-10, no loss
        float exp_a12 = 1.5f - ldexpf(1.0f, -10);
        check_val<float>(out[15], exp_a12, "A12 half->f", "NONE", exp_a12);
        // bf16→float: input=1.5-2^-6, no loss
        float exp_a13 = 1.5f - ldexpf(1.0f, -6);
        check_val<float>(out[16], exp_a13, "A13 bf16->f", "NONE", exp_a13);
        // double→float: input=2^35+2^12+2^11
        float exp_f03[] = {exp_f01[0], exp_f01[1], exp_f01[2], exp_f01[3], exp_f01[4]};
        for (int i = 0; i < 5; i++) {
            check_val<float>(out[17+i], exp_f03[i], "F03 d->f", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), inp_f01);
        }
        // float→float: input=0.5 (doc says RINT→0.0, CEIL→1.0 — suspected doc error)
        float exp_b[] = {0.5f, 0.5f, 0.5f, 0.5f, 0.5f}; // theoretical: 0.5 is exact in float
        float exp_b_doc[] = {0.0f, 0.0f, 1.0f, 1.0f, 0.0f}; // doc claims
        for (int i = 0; i < 5; i++) {
            bool ok = check_val<float>(out[22+i], exp_b[i], "B f->f", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 0.5);
            if (!ok) {
                std::cout << "         ^^^ doc says " << exp_b_doc[i] << " — possible DOC ERROR" << std::endl;
            }
        }
        std::cout << std::endl;
    }

    // ---- TO_INT16 ----
    {
        std::cout << "--- TO_INT16 ---" << std::endl;
        std::vector<uint8_t> src_buf(64, 0);
        uint16_t vh = host_to_half(127.5f); memcpy(src_buf.data(), &vh, 2);
        float vf = (float)(1<<22) + 0.5f; memcpy(src_buf.data()+16, &vf, 4);
        int32_t vi32 = 2147483647; memcpy(src_buf.data()+32, &vi32, 4); // 2^31-1
        uint32_t vu32 = 0xFFFFFFFF; memcpy(src_buf.data()+48, &vu32, 4);

        auto out = launch<uint8_t, int16_t>(kernel_to_int16, src_buf, 12);

        // half→int16: input=127.5
        int64_t exp_c02[] = {128, 127, 128, 128, 127};
        for (int i = 0; i < 5; i++) {
            check_int(out[i], exp_c02[i], "C02 half->i16", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 127.5);
        }
        // float→int16: input=2^22+0.5 (overflow→32767)
        for (int i = 0; i < 5; i++) {
            check_int(out[5+i], 32767, "E04 f->i16", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), (double)((1<<22)+0.5));
        }
        // int32→int16: input=2^31-1 (saturation→32767)
        check_int(out[10], 32767, "D06 i32->i16", "NONE", (double)((1LL<<31)-1));
        // uint32→int16: input=2^32-1 (saturation→32767)
        check_int(out[11], 32767, "D09 u32->i16", "NONE", (double)0xFFFFFFFF);
        std::cout << std::endl;
    }

    // ---- TO_INT32 ----
    {
        std::cout << "--- TO_INT32 ---" << std::endl;
        std::vector<uint8_t> src_buf(64, 0);
        uint16_t vh = host_to_half(-1.5f); memcpy(src_buf.data(), &vh, 2);
        uint16_t vb = host_to_bf16(64.5f); memcpy(src_buf.data()+4, &vb, 2);
        float vf = (float)(1<<22) + 0.5f; memcpy(src_buf.data()+8, &vf, 4);
        double vd = -1.5; memcpy(src_buf.data()+16, &vd, 8);
        int8_t vi8 = 127; memcpy(src_buf.data()+20, &vi8, 1);
        int16_t vi16 = 32767; memcpy(src_buf.data()+24, &vi16, 2);

        auto out = launch<uint8_t, int32_t>(kernel_to_int32, src_buf, 18);

        // half→int32: input=-1.5
        int64_t exp_c03[] = {-2, -2, -1, -2, -1};
        for (int i = 0; i < 5; i++) {
            check_int(out[i], exp_c03[i], "C03 half->i32", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), -1.5);
        }
        // bf16→int32: input=64.5
        int64_t exp_c05[] = {64, 64, 65, 65, 64};
        for (int i = 0; i < 5; i++) {
            check_int(out[5+i], exp_c05[i], "C05 bf16->i32", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 64.5);
        }
        // float→int32: input=2^22+0.5
        int64_t exp_c10[] = {(1<<22), (1<<22), (1<<22)+1, (1<<22)+1, (1<<22)};
        for (int i = 0; i < 5; i++) {
            check_int(out[10+i], exp_c10[i], "C10 f->i32", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), (double)((1<<22)+0.5));
        }
        // double→int32: input=-1.5, TRUNC→-1
        check_int(out[15], -1, "F05 d->i32", "TRUNC", -1.5);
        // int8→int32: input=127, no loss
        check_int(out[16], 127, "A03 i8->i32", "NONE", 127);
        // int16→int32: input=32767, no loss
        check_int(out[17], 32767, "A07 i16->i32", "NONE", 32767);
        std::cout << std::endl;
    }

    // ---- TO_INT64 ----
    {
        std::cout << "--- TO_INT64 ---" << std::endl;
        std::vector<uint8_t> src_buf(32, 0);
        int32_t vi32 = 2147483647; memcpy(src_buf.data(), &vi32, 4);
        float vf = (float)(1<<22) + 0.5f; memcpy(src_buf.data()+8, &vf, 4);
        double vd = -1.5; memcpy(src_buf.data()+16, &vd, 8);

        auto out = launch<uint8_t, int64_t>(kernel_to_int64, src_buf, 7);

        // int32→int64: input=2^31-1, no loss
        check_int(out[0], (1LL<<31)-1, "A14 i32->i64", "NONE", (double)((1LL<<31)-1));
        // float→int64: input=2^22+0.5
        int64_t exp_c11[] = {(1<<22), (1<<22), (1<<22)+1, (1<<22)+1, (1<<22)};
        for (int i = 0; i < 5; i++) {
            check_int(out[1+i], exp_c11[i], "C11 f->i64", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), (double)((1<<22)+0.5));
        }
        // double→int64: input=-1.5, TRUNC→-1
        check_int(out[6], -1, "F06 d->i64", "TRUNC", -1.5);
        std::cout << std::endl;
    }

    // ---- TO_INT8 ----
    {
        std::cout << "--- TO_INT8 ---" << std::endl;
        std::vector<uint8_t> src_buf(8, 0);
        uint16_t vh = host_to_half(127.5f); memcpy(src_buf.data(), &vh, 2);

        auto out = launch<uint8_t, int8_t>(kernel_to_int8, src_buf, 5);

        // half→int8: input=127.5 (overflow for all modes)
        int64_t exp_e02[] = {127, 127, 127, 127, 127};
        for (int i = 0; i < 5; i++) {
            check_int(out[i], exp_e02[i], "E02 half->i8", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 127.5);
        }
        std::cout << std::endl;
    }

    // ---- TO_UINT8 ----
    {
        std::cout << "--- TO_UINT8 ---" << std::endl;
        std::vector<uint8_t> src_buf(32, 0);
        uint16_t vh = host_to_half(1.75f); memcpy(src_buf.data(), &vh, 2);
        int16_t vi16 = 32767; memcpy(src_buf.data()+8, &vi16, 2);
        int32_t vi32 = 2147483647; memcpy(src_buf.data()+16, &vi32, 4);
        uint16_t vu16 = 65535; memcpy(src_buf.data()+12, &vu16, 2);
        uint32_t vu32 = 0xFFFFFFFF; memcpy(src_buf.data()+16, &vu32, 4);

        auto out = launch<uint8_t, uint8_t>(kernel_to_uint8, src_buf, 9);

        // half→uint8: input=1.75
        int64_t exp_e03[] = {2, 1, 2, 2, 1};
        for (int i = 0; i < 5; i++) {
            check_int(out[i], exp_e03[i], "E03 half->u8", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), 1.75);
        }
        // int16→uint8: input=32767 (saturation→255)
        check_int(out[5], 255, "D02 i16->u8", "NONE", 32767);
        // int32→uint8: input=2^31-1 (saturation→255)
        check_int(out[6], 255, "D04 i32->u8", "NONE", (double)((1LL<<31)-1));
        // uint16→uint8: input=65535 (saturation→255)
        check_int(out[7], 255, "D03 u16->u8", "NONE", 65535);
        // uint32→uint8: input=2^32-1 (saturation→255)
        check_int(out[8], 255, "D07 u32->u8", "NONE", (double)0xFFFFFFFF);
        std::cout << std::endl;
    }

    // ---- TO_UINT16 ----
    {
        std::cout << "--- TO_UINT16 ---" << std::endl;
        std::vector<uint8_t> src_buf(16, 0);
        int32_t vi32 = 2147483647; memcpy(src_buf.data(), &vi32, 4);
        uint32_t vu32 = 0xFFFFFFFF; memcpy(src_buf.data()+8, &vu32, 4);
        uint8_t vu8 = 255; memcpy(src_buf.data()+12, &vu8, 1);

        auto out = launch<uint8_t, uint16_t>(kernel_to_uint16, src_buf, 3);

        check_int(out[0], 65535, "D05 i32->u16", "NONE", (double)((1LL<<31)-1));
        check_int(out[1], 65535, "D08 u32->u16", "NONE", (double)0xFFFFFFFF);
        check_int(out[2], 255, "A06 u8->u16", "NONE", 255);
        std::cout << std::endl;
    }

    // ---- TO_UINT32 ----
    {
        std::cout << "--- TO_UINT32 ---" << std::endl;
        std::vector<uint8_t> src_buf(16, 0);
        int16_t vi16_pos = 32767; memcpy(src_buf.data(), &vi16_pos, 2);
        int16_t vi16_neg = -1; memcpy(src_buf.data()+4, &vi16_neg, 2);
        uint16_t vu16 = 65535; memcpy(src_buf.data()+8, &vu16, 2);
        uint8_t vu8 = 255; memcpy(src_buf.data()+12, &vu8, 1);

        auto out = launch<uint8_t, uint32_t>(kernel_to_uint32, src_buf, 4);

        check_int(out[0], 32767, "A09 i16->u32", "NONE", 32767);
        check_int(out[1], 0, "A10 i16->u32(neg)", "NONE", -1);
        check_int(out[2], 65535, "A11 u16->u32", "NONE", 65535);
        check_int(out[3], 255, "A06 u8->u32", "NONE", 255);
        std::cout << std::endl;
    }

    // ---- TO_DOUBLE ----
    {
        std::cout << "--- TO_DOUBLE ---" << std::endl;
        std::vector<uint8_t> src_buf(16, 0);
        int64_t vi64 = (1LL<<61)+(1LL<<9)+(1LL<<8); memcpy(src_buf.data(), &vi64, 8);

        auto out = launch<uint8_t, double>(kernel_to_double, src_buf, 5);

        double inp = (double)(1LL<<61)+(double)(1LL<<9)+(double)(1LL<<8);
        double exp_f02[] = {(double)(1LL<<61)+(double)(1LL<<10), (double)(1LL<<61)+(double)(1LL<<9),
                            (double)(1LL<<61)+(double)(1LL<<10), (double)(1LL<<61)+(double)(1LL<<10),
                            (double)(1LL<<61)+(double)(1LL<<9)};
        for (int i = 0; i < 5; i++) {
            check_val<double>(out[i], exp_f02[i], "F02 i64->d", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), inp);
        }
        std::cout << std::endl;
    }

    // ---- TO_BF16_EXTRA (double→bf16) ----
    {
        std::cout << "--- TO_BF16_EXTRA ---" << std::endl;
        std::vector<uint8_t> src_buf(16, 0);
        double vd = (double)(1LL<<35)+(double)(1LL<<28)+(double)(1LL<<27); memcpy(src_buf.data(), &vd, 8);

        auto out = launch<uint8_t, uint16_t>(kernel_to_bf16_extra, src_buf, 5);

        double inp = (double)(1LL<<35)+(double)(1LL<<28)+(double)(1LL<<27);
        float exp_f04[] = {(float)(1LL<<35)+(float)(1LL<<29), (float)(1LL<<35)+(float)(1LL<<28),
                           (float)(1LL<<35)+(float)(1LL<<29), (float)(1LL<<35)+(float)(1LL<<29),
                           (float)(1LL<<35)+(float)(1LL<<28)};
        for (int i = 0; i < 5; i++) {
            check_bf16(out[i], exp_f04[i], "F04 d->bf16", rm_name((RM[]){RINT,FLOOR,CEIL,ROUND,TRUNC}[i]), inp);
        }
        std::cout << std::endl;
    }

    // ---- SATURATION: int64→int32 ----
    {
        std::cout << "--- SATURATION: i64->i32 ---" << std::endl;
        std::vector<uint8_t> src_buf(16, 0);
        int64_t vi64 = (1LL<<31); memcpy(src_buf.data(), &vi64, 8);

        auto out = launch<uint8_t, int32_t>(kernel_to_int32_sat, src_buf, 1);

        check_int(out[0], (1LL<<31)-1, "D10 i64->i32", "NONE", (double)(1LL<<31));
        std::cout << std::endl;
    }

    // ---- Summary ----
    std::cout << "=== Summary ===" << std::endl;
    std::cout << "Total: " << (g_pass + g_fail) << " tests, "
              << g_pass << " PASS, " << g_fail << " FAIL" << std::endl;
    if (g_fail > 0) {
        std::cout << std::endl;
        std::cout << "NOTE: Review FAIL items above. Common causes:" << std::endl;
        std::cout << "  - float->float: doc likely has error (0.5 is exact in float, no rounding needed)" << std::endl;
        std::cout << "  - Saturation tests: doc says 'no precision loss' but values saturate" << std::endl;
    }
    return g_fail > 0 ? 1 : 0;
}
