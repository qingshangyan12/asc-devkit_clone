    AscendC::GlobalTensor<int16_t> srcGm;
    AscendC::GlobalTensor<half> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int16_t*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // Test input: 4098 (at index 0)
    AscendC::Cast<half, int16_t>(dstLocal[0], srcLocal, AscendC::RoundMode::CAST_RINT, 1);
    AscendC::Cast<half, int16_t>(dstLocal[1], srcLocal, AscendC::RoundMode::CAST_FLOOR, 1);
    AscendC::Cast<half, int16_t>(dstLocal[2], srcLocal, AscendC::RoundMode::CAST_CEIL, 1);
    AscendC::Cast<half, int16_t>(dstLocal[3], srcLocal, AscendC::RoundMode::CAST_ROUND, 1);
    AscendC::Cast<half, int16_t>(dstLocal[4], srcLocal, AscendC::RoundMode::CAST_TRUNC, 1);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Kernel: float -> half (5 round modes + ODD)
// ============================================================================
__global__ __vector__ void kernel_float_to_half(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<half> dstLocal = ubAllocator.Alloc<half, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<half> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // Test input: 0.5 + 2^-12 (at index 0)
    AscendC::Cast<half, float>(dstLocal[0], srcLocal, AscendC::RoundMode::CAST_RINT, 1);
    AscendC::Cast<half, float>(dstLocal[1], srcLocal, AscendC::RoundMode::CAST_FLOOR, 1);
    AscendC::Cast<half, float>(dstLocal[2], srcLocal, AscendC::RoundMode::CAST_CEIL, 1);
    AscendC::Cast<half, float>(dstLocal[3], srcLocal, AscendC::RoundMode::CAST_ROUND, 1);
    AscendC::Cast<half, float>(dstLocal[4], srcLocal, AscendC::RoundMode::CAST_TRUNC, 1);
    AscendC::Cast<half, float>(dstLocal[5], srcLocal, AscendC::RoundMode::CAST_ODD, 1);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Kernel: half -> int32 (5 round modes)
// ============================================================================
__global__ __vector__ void kernel_half_to_int32(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<half> srcLocal = ubAllocator.Alloc<half, DATA_COUNT>();
    AscendC::LocalTensor<int32_t> dstLocal = ubAllocator.Alloc<int32_t, DATA_COUNT>();

    AscendC::GlobalTensor<half> srcGm;
    AscendC::GlobalTensor<int32_t> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // Test input: -1.5 (at index 0)
    AscendC::Cast<int32_t, half>(dstLocal[0], srcLocal, AscendC::RoundMode::CAST_RINT, 1);
    AscendC::Cast<int32_t, half>(dstLocal[1], srcLocal, AscendC::RoundMode::CAST_FLOOR, 1);
    AscendC::Cast<int32_t, half>(dstLocal[2], srcLocal, AscendC::RoundMode::CAST_CEIL, 1);
    AscendC::Cast<int32_t, half>(dstLocal[3], srcLocal, AscendC::RoundMode::CAST_ROUND, 1);
    AscendC::Cast<int32_t, half>(dstLocal[4], srcLocal, AscendC::RoundMode::CAST_TRUNC, 1);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Kernel: float -> float (5 round modes, identity test)
// ============================================================================
__global__ __vector__ void kernel_float_to_float(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> srcLocal = ubAllocator.Alloc<float, DATA_COUNT>();
    AscendC::LocalTensor<float> dstLocal = ubAllocator.Alloc<float, DATA_COUNT>();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<float> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src));
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(dst));

    AscendC::DataCopy(srcLocal, srcGm, DATA_COUNT);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    // Test input: 0.5 (at index 0)
    AscendC::Cast<float, float>(dstLocal[0], srcLocal, AscendC::RoundMode::CAST_RINT, 1);
    AscendC::Cast<float, float>(dstLocal[1], srcLocal, AscendC::RoundMode::CAST_FLOOR, 1);
    AscendC::Cast<float, float>(dstLocal[2], srcLocal, AscendC::RoundMode::CAST_CEIL, 1);
    AscendC::Cast<float, float>(dstLocal[3], srcLocal, AscendC::RoundMode::CAST_ROUND, 1);
    AscendC::Cast<float, float>(dstLocal[4], srcLocal, AscendC::RoundMode::CAST_TRUNC, 1);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopy(dstGm, dstLocal, DATA_COUNT);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// Launch helper
// ============================================================================
template<typename KernelFunc>
std::vector<uint8_t> launch_kernel(std::vector<uint8_t>& src, size_t dstBytes, KernelFunc kernel)
{
    size_t srcBytes = src.size();
    int32_t devId = 0;
    aclrtStream stream = nullptr;

    uint8_t* srcHost = src.data();
    uint8_t* dstOutHost = nullptr;
    uint8_t *srcDev = nullptr, *dstDev = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(devId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)&dstOutHost, dstBytes);
    aclrtMalloc((void**)&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dstDev, dstBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(srcDev, srcBytes, srcHost, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel<<<1, nullptr, stream>>>(srcDev, dstDev);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dstOutHost, dstBytes, dstDev, dstBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint8_t> out(dstOutHost, dstOutHost + dstBytes);

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFreeHost(dstOutHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(devId);
    aclFinalize();

    return out;
}

// ============================================================================
// Helper to convert half to float
// ============================================================================
float half_to_float(uint16_t h) {
    uint32_t sign = (h >> 15) & 1;
    uint32_t exp  = (h >> 10) & 0x1f;
    uint32_t man  = h & 0x3ff;
    if (exp == 0) {
        if (man == 0) return sign ? -0.0f : 0.0f;
        float f = ldexpf((float)man, -24);
        return sign ? -f : f;
    }
    if (exp == 31) {
        float f = man ? NAN : INFINITY;
        return sign ? -f : f;
    }
    float f = ldexpf((float)(man | 0x400), (int)exp - 25);
    return sign ? -f : f;
}

uint16_t float_to_half(float f) {
    uint32_t x;
    memcpy(&x, &f, 4);
    uint16_t sign = (x >> 16) & 0x8000;
    int32_t  exp  = ((x >> 23) & 0xff) - 127 + 15;
    uint32_t man  = x & 0x7fffff;
    if (exp <= 0) return sign;
    if (exp >= 31) return sign | 0x7c00;
    return sign | (uint16_t)(exp << 10) | (uint16_t)(man >> 13);
}

// ============================================================================
// Main
// ============================================================================
int32_t main()
{
    std::cout << "=== Cast Precision Conversion Test (dav_3510) ===" << std::endl;
    std::cout << std::endl;

    int passed = 0, failed = 0;

    // Test 1: int8 -> half, input=-1
    {
        std::cout << "--- Test 1: int8 -> half, input=-1 ---" << std::endl;
        std::vector<uint8_t> src(DATA_COUNT, 0);
        src[0] = (uint8_t)(int8_t)(-1);  // -1 as int8_t
        
        std::vector<uint8_t> out = launch_kernel(src, DATA_COUNT * sizeof(half), kernel_int8_to_half);
        uint16_t* results = (uint16_t*)out.data();
        
        const char* modes[] = {"RINT", "FLOOR", "CEIL", "ROUND", "TRUNC"};
        float expected = -1.0f;
        uint16_t exp_bits = float_to_half(expected);
        
        for (int i = 0; i < 5; i++) {
            float actual = half_to_float(results[i]);
            bool pass = (actual == expected);
            std::cout << "  [int8->half] " << std::setw(5) << modes[i]
                      << "  input=-1  output=" << std::setw(8) << actual
                      << "  expected=" << std::setw(8) << expected
                      << "  " << (pass ? "PASS" : "FAIL") << std::endl;
            if (pass) passed++; else failed++;
            record_result(std::string("int8->half ") + modes[i], pass, expected, actual);
        }
        std::cout << std::endl;
    }

    // Test 2: int16 -> half, input=4098
    {
        std::cout << "--- Test 2: int16 -> half, input=4098 ---" << std::endl;
        std::vector<uint8_t> src(DATA_COUNT * sizeof(int16_t), 0);
        int16_t val = 4098;
        memcpy(src.data(), &val, sizeof(int16_t));
        
        std::vector<uint8_t> out = launch_kernel(src, DATA_COUNT * sizeof(half), kernel_int16_to_half);
        uint16_t* results = (uint16_t*)out.data();
        
        const char* modes[] = {"RINT", "FLOOR", "CEIL", "ROUND", "TRUNC"};
        float expected[] = {4096.0f, 4096.0f, 4100.0f, 4100.0f, 4096.0f};
        
        for (int i = 0; i < 5; i++) {
            float actual = half_to_float(results[i]);
            bool pass = (actual == expected[i]);
            std::cout << "  [int16->half] " << std::setw(5) << modes[i]
                      << "  input=4098  output=" << std::setw(8) << actual
                      << "  expected=" << std::setw(8) << expected[i]
                      << "  " << (pass ? "PASS" : "FAIL") << std::endl;
            if (pass) passed++; else failed++;
            record_result(std::string("int16->half ") + modes[i], pass, expected[i], actual);
        }
        std::cout << std::endl;
    }

    // Test 3: float -> half, input=0.5+2^-12
    {
        std::cout << "--- Test 3: float -> half, input=0.5+2^-12 ---" << std::endl;
        std::vector<uint8_t> src(DATA_COUNT * sizeof(float), 0);
        float val = 0.5f + ldexpf(1.0f, -12);
        memcpy(src.data(), &val, sizeof(float));
        
        std::vector<uint8_t> out = launch_kernel(src, DATA_COUNT * sizeof(half), kernel_float_to_half);
        uint16_t* results = (uint16_t*)out.data();
        
        const char* modes[] = {"RINT", "FLOOR", "CEIL", "ROUND", "TRUNC", "ODD"};
        float expected[] = {0.5f, 0.5f, 0.5f + ldexpf(1.0f, -11), 0.5f + ldexpf(1.0f, -11), 0.5f, 0.5f + ldexpf(1.0f, -11)};
        
        for (int i = 0; i < 6; i++) {
            float actual = half_to_float(results[i]);
            bool pass = (actual == expected[i]);
            std::cout << "  [float->half] " << std::setw(5) << modes[i]
                      << "  input=" << std::setw(12) << val
                      << "  output=" << std::setw(12) << actual
                      << "  expected=" << std::setw(12) << expected[i]
                      << "  " << (pass ? "PASS" : "FAIL") << std::endl;
            if (pass) passed++; else failed++;
            record_result(std::string("float->half ") + modes[i], pass, expected[i], actual);
        }
        std::cout << std::endl;
    }

    // Test 4: half -> int32, input=-1.5
    {
        std::cout << "--- Test 4: half -> int32, input=-1.5 ---" << std::endl;
        std::vector<uint8_t> src(DATA_COUNT * sizeof(half), 0);
        uint16_t val = float_to_half(-1.5f);
        memcpy(src.data(), &val, sizeof(uint16_t));
        
        std::vector<uint8_t> out = launch_kernel(src, DATA_COUNT * sizeof(int32_t), kernel_half_to_int32);
        int32_t* results = (int32_t*)out.data();
        
        const char* modes[] = {"RINT", "FLOOR", "CEIL", "ROUND", "TRUNC"};
        int32_t expected[] = {-2, -2, -1, -2, -1};
        
        for (int i = 0; i < 5; i++) {
            int32_t actual = results[i];
            bool pass = (actual == expected[i]);
            std::cout << "  [half->int32] " << std::setw(5) << modes[i]
                      << "  input=-1.5  output=" << std::setw(8) << actual
                      << "  expected=" << std::setw(8) << expected[i]
                      << "  " << (pass ? "PASS" : "FAIL") << std::endl;
            if (pass) passed++; else failed++;
            record_result(std::string("half->int32 ") + modes[i], pass, expected[i], actual);
        }
        std::cout << std::endl;
    }

    // Test 5: float -> float, input=0.5 (identity test)
    {
        std::cout << "--- Test 5: float -> float, input=0.5 (identity) ---" << std::endl;
        std::vector<uint8_t> src(DATA_COUNT * sizeof(float), 0);
        float val = 0.5f;
        memcpy(src.data(), &val, sizeof(float));
        
        std::vector<uint8_t> out = launch_kernel(src, DATA_COUNT * sizeof(float), kernel_float_to_float);
        float* results = (float*)out.data();
        
        const char* modes[] = {"RINT", "FLOOR", "CEIL", "ROUND", "TRUNC"};
        float expected_identity = 0.5f;  // 0.5 is exactly representable in float
        
        for (int i = 0; i < 5; i++) {
            float actual = results[i];
            bool pass = (actual == expected_identity);
            std::cout << "  [float->float] " << std::setw(5) << modes[i]
                      << "  input=0.5  output=" << std::setw(8) << actual
                      << "  expected=" << std::setw(8) << expected_identity
                      << "  " << (pass ? "PASS" : "FAIL");
            if (!pass) {
                std::cout << "  <-- DOC ERROR? (doc says " 
                          << (i == 0 ? "0.0" : i == 1 ? "0.0" : i == 2 ? "1.0" : i == 3 ? "1.0" : "0.0") << ")";
            }
            std::cout << std::endl;
            if (pass) passed++; else failed++;
            record_result(std::string("float->float ") + modes[i], pass, expected_identity, actual);
        }
        std::cout << std::endl;
    }

    // Summary
    std::cout << "=== Summary ===" << std::endl;
    std::cout << "Total: " << (passed + failed) << " tests, " << passed << " PASS, " << failed << " FAIL" << std::endl;
    
    if (failed > 0) {
        std::cout << std::endl << "Failed tests:" << std::endl;
        for (const auto& r : g_results) {
            if (!r.passed) {
                std::cout << "  " << r.name << ": output=" << r.actual << ", expected=" << r.expected << std::endl;
            }
        }
    }

    return (failed == 0) ? 0 : 1;
}
