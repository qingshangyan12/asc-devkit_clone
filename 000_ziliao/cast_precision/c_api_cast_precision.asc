 * \file c_api_cast_precision.asc
 * \brief 批量测试 Cast API 精度转换规则，验证文档描述和示例是否正确
 *
 * 覆盖文档 precision_conversion.md 中"精度转换规则"一节的所有转换
 * 输出格式便于分析：每个测试点显示 input/output/expected/PASS/FAIL
 */

#include <cstdint>
#include <cstring>
#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
#include <cmath>
#include <iomanip>
#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

using RM = AscendC::RoundMode;
constexpr RM RINT  = RM::CAST_RINT;
constexpr RM FLOOR = RM::CAST_FLOOR;
constexpr RM CEIL  = RM::CAST_CEIL;
constexpr RM ROUND = RM::CAST_ROUND;
constexpr RM TRUNC = RM::CAST_TRUNC;
constexpr RM ODD   = RM::CAST_ODD;
constexpr RM NONE  = RM::CAST_NONE;

static int g_pass = 0, g_fail = 0, g_skip = 0;

// ==================== Host-side type conversion helpers ====================

static float half_to_host(uint16_t h) {
    uint32_t sign = (h >> 15) & 1;
    uint32_t exp  = (h >> 10) & 0x1f;
    uint32_t man  = h & 0x3ff;
    if (exp == 0) {
        if (man == 0) return sign ? -0.0f : 0.0f;
        float f = ldexpf((float)man, -24);
        return sign ? -f : f;
    }
    if (exp == 31) {
        float f = man ? NAN : INFINITY;
        return sign ? -f : f;
    }
    float f = ldexpf((float)(man | 0x400), (int)exp - 25);
    return sign ? -f : f;
}

static uint16_t host_to_half(float f) {
    uint32_t x;
    memcpy(&x, &f, 4);
    uint16_t sign = (x >> 16) & 0x8000;
    int32_t  exp  = ((x >> 23) & 0xff) - 127 + 15;
    uint32_t man  = x & 0x7fffff;
    if (exp <= 0) return sign;
    if (exp >= 31) return sign | 0x7c00;
    return sign | (uint16_t)(exp << 10) | (uint16_t)(man >> 13);
}

static float bf16_to_host(uint16_t b) {
    uint32_t x = (uint32_t)b << 16;
    float f;
    memcpy(&f, &x, 4);
    return f;
}

static uint16_t host_to_bf16(float f) {
    uint32_t x;
    memcpy(&x, &f, 4);
    return (uint16_t)(x >> 16);
}

static void print_hex(const void* data, size_t bytes) {
    const uint8_t* p = (const uint8_t*)data;
    std::cout << "0x";
    for (int i = (int)bytes - 1; i >= 0; --i) {
        std::cout << std::hex << std::setw(2) << std::setfill('0') << (int)p[i];
    }
    std::cout << std::dec;
}

// ==================== Kernel functions ====================

// --- TO_HALF: int8→half, int16→half, uint8→half, float→half ---
__global__ __vector__ void kernel_to_half(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    auto halfPtr = alloc.Alloc<half, 5>();
    auto floatPtr = alloc.Alloc<float, 1>();
    auto i8Ptr = alloc.Alloc<int8_t, 1>();
    auto i16Ptr = alloc.Alloc<int16_t, 1>();
    auto u8Ptr = alloc.Alloc<uint8_t, 1>();
    AscendC::GlobalTensor<half> srcGm, dstGm;
    srcGm.SetGlobalBuffer((__gm__ half*)src);
    dstGm.SetGlobalBuffer((__gm__ half*)dst);

    // Test 0-4: int8_t→half, input=-1
    {
        AscendC::GlobalTensor<int8_t> s; s.SetGlobalBuffer((__gm__ int8_t*)src);
        AscendC::DataCopy(i8Ptr, s, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<half, 5>();
        AscendC::Cast<half, int8_t>(d, i8Ptr, RINT, 1);
        AscendC::Cast<half, int8_t>(d[1], i8Ptr, FLOOR, 1);
        AscendC::Cast<half, int8_t>(d[2], i8Ptr, CEIL, 1);
        AscendC::Cast<half, int8_t>(d[3], i8Ptr, ROUND, 1);
        AscendC::Cast<half, int8_t>(d[4], i8Ptr, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 5);
    }
    // Test 5-9: int16_t→half, input=4098
    {
        AscendC::GlobalTensor<int16_t> s; s.SetGlobalBuffer((__gm__ int16_t*)src + 8);
        AscendC::DataCopy(i16Ptr, s, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<half, 5>();
        AscendC::Cast<half, int16_t>(d, i16Ptr, RINT, 1);
        AscendC::Cast<half, int16_t>(d[1], i16Ptr, FLOOR, 1);
        AscendC::Cast<half, int16_t>(d[2], i16Ptr, CEIL, 1);
        AscendC::Cast<half, int16_t>(d[3], i16Ptr, ROUND, 1);
        AscendC::Cast<half, int16_t>(d[4], i16Ptr, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[5], d, 5);
    }
    // Test 10-14: uint8_t→half, input=1
    {
        AscendC::GlobalTensor<uint8_t> s; s.SetGlobalBuffer((__gm__ uint8_t*)src + 20);
        AscendC::DataCopy(u8Ptr, s, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<half, 5>();
        AscendC::Cast<half, uint8_t>(d, u8Ptr, RINT, 1);
        AscendC::Cast<half, uint8_t>(d[1], u8Ptr, FLOOR, 1);
        AscendC::Cast<half, uint8_t>(d[2], u8Ptr, CEIL, 1);
        AscendC::Cast<half, uint8_t>(d[3], u8Ptr, ROUND, 1);
        AscendC::Cast<half, uint8_t>(d[4], u8Ptr, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[10], d, 5);
    }
    // Test 15-20: float→half, input=0.5+2^-12
    {
        AscendC::GlobalTensor<float> s; s.SetGlobalBuffer((__gm__ float*)src + 8);
        AscendC::DataCopy(floatPtr, s, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<half, 6>();
        AscendC::Cast<half, float>(d, floatPtr, RINT, 1);
        AscendC::Cast<half, float>(d[1], floatPtr, FLOOR, 1);
        AscendC::Cast<half, float>(d[2], floatPtr, CEIL, 1);
        AscendC::Cast<half, float>(d[3], floatPtr, ROUND, 1);
        AscendC::Cast<half, float>(d[4], floatPtr, TRUNC, 1);
        AscendC::Cast<half, float>(d[5], floatPtr, ODD, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[15], d, 6);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// --- TO_BF16: half→bf16, bf16→bf16(same), float→bf16 ---
__global__ __vector__ void kernel_to_bf16(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    AscendC::GlobalTensor<bfloat16_t> dstGm;
    dstGm.SetGlobalBuffer((__gm__ bfloat16_t*)dst);

    // Test 0-4: half→bfloat16_t, input=1.75
    {
        auto s = alloc.Alloc<half, 1>();
        AscendC::GlobalTensor<half> sg; sg.SetGlobalBuffer((__gm__ half*)src);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<bfloat16_t, 5>();
        AscendC::Cast<bfloat16_t, half>(d, s, RINT, 1);
        AscendC::Cast<bfloat16_t, half>(d[1], s, FLOOR, 1);
        AscendC::Cast<bfloat16_t, half>(d[2], s, CEIL, 1);
        AscendC::Cast<bfloat16_t, half>(d[3], s, ROUND, 1);
        AscendC::Cast<bfloat16_t, half>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 5);
    }
    // Test 5-9: bfloat16_t→int32_t (stored separately, tested in kernel_to_int32)
    // Test 5-9: float→bfloat16_t, input=0.5+2^-9+2^-11
    {
        auto s = alloc.Alloc<float, 1>();
        AscendC::GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)src + 8);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<bfloat16_t, 5>();
        AscendC::Cast<bfloat16_t, float>(d, s, RINT, 1);
        AscendC::Cast<bfloat16_t, float>(d[1], s, FLOOR, 1);
        AscendC::Cast<bfloat16_t, float>(d[2], s, CEIL, 1);
        AscendC::Cast<bfloat16_t, float>(d[3], s, ROUND, 1);
        AscendC::Cast<bfloat16_t, float>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[5], d, 5);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// --- TO_FLOAT: int16→float, int32→float, int64→float, half→float, bf16→float, double→float, float→float ---
__global__ __vector__ void kernel_to_float(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    AscendC::GlobalTensor<float> dstGm;
    dstGm.SetGlobalBuffer((__gm__ float*)dst);

    // Test 0-4: int16_t→float, input=32767
    {
        auto s = alloc.Alloc<int16_t, 1>();
        AscendC::GlobalTensor<int16_t> sg; sg.SetGlobalBuffer((__gm__ int16_t*)src);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 5>();
        AscendC::Cast<float, int16_t>(d, s, RINT, 1);
        AscendC::Cast<float, int16_t>(d[1], s, FLOOR, 1);
        AscendC::Cast<float, int16_t>(d[2], s, CEIL, 1);
        AscendC::Cast<float, int16_t>(d[3], s, ROUND, 1);
        AscendC::Cast<float, int16_t>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 5);
    }
    // Test 5-9: int32_t→float, input=2^25+3=33554435
    {
        auto s = alloc.Alloc<int32_t, 1>();
        AscendC::GlobalTensor<int32_t> sg; sg.SetGlobalBuffer((__gm__ int32_t*)src + 4);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 5>();
        AscendC::Cast<float, int32_t>(d, s, RINT, 1);
        AscendC::Cast<float, int32_t>(d[1], s, FLOOR, 1);
        AscendC::Cast<float, int32_t>(d[2], s, CEIL, 1);
        AscendC::Cast<float, int32_t>(d[3], s, ROUND, 1);
        AscendC::Cast<float, int32_t>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[5], d, 5);
    }
    // Test 10-14: int64_t→float, input=2^35+2^12+2^11
    {
        auto s = alloc.Alloc<int64_t, 1>();
        AscendC::GlobalTensor<int64_t> sg; sg.SetGlobalBuffer((__gm__ int64_t*)src + 4);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 5>();
        AscendC::Cast<float, int64_t>(d, s, RINT, 1);
        AscendC::Cast<float, int64_t>(d[1], s, FLOOR, 1);
        AscendC::Cast<float, int64_t>(d[2], s, CEIL, 1);
        AscendC::Cast<float, int64_t>(d[3], s, ROUND, 1);
        AscendC::Cast<float, int64_t>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[10], d, 5);
    }
    // Test 15: half→float, input=1.5-2^-10 (no precision loss, single test)
    {
        auto s = alloc.Alloc<half, 1>();
        AscendC::GlobalTensor<half> sg; sg.SetGlobalBuffer((__gm__ half*)src + 20);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 1>();
        AscendC::Cast<float, half>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[15], d, 1);
    }
    // Test 16: bfloat16_t→float, input=1.5-2^-6 (no precision loss)
    {
        auto s = alloc.Alloc<bfloat16_t, 1>();
        AscendC::GlobalTensor<bfloat16_t> sg; sg.SetGlobalBuffer((__gm__ bfloat16_t*)src + 24);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 1>();
        AscendC::Cast<float, bfloat16_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[16], d, 1);
    }
    // Test 17-21: double→float, input=2^35+2^12+2^11
    {
        auto s = alloc.Alloc<double, 1>();
        AscendC::GlobalTensor<double> sg; sg.SetGlobalBuffer((__gm__ double*)src + 4);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 5>();
        AscendC::Cast<float, double>(d, s, RINT, 1);
        AscendC::Cast<float, double>(d[1], s, FLOOR, 1);
        AscendC::Cast<float, double>(d[2], s, CEIL, 1);
        AscendC::Cast<float, double>(d[3], s, ROUND, 1);
        AscendC::Cast<float, double>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[17], d, 5);
    }
    // Test 22-26: float→float, input=0.5
    {
        auto s = alloc.Alloc<float, 1>();
        AscendC::GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)src + 12);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<float, 5>();
        AscendC::Cast<float, float>(d, s, RINT, 1);
        AscendC::Cast<float, float>(d[1], s, FLOOR, 1);
        AscendC::Cast<float, float>(d[2], s, CEIL, 1);
        AscendC::Cast<float, float>(d[3], s, ROUND, 1);
        AscendC::Cast<float, float>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[22], d, 5);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// --- TO_INT16: half→int16, float→int16, int32→int16, uint32→int16 ---
__global__ __vector__ void kernel_to_int16(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    AscendC::GlobalTensor<int16_t> dstGm;
    dstGm.SetGlobalBuffer((__gm__ int16_t*)dst);

    // Test 0-4: half→int16_t, input=127.5
    {
        auto s = alloc.Alloc<half, 1>();
        AscendC::GlobalTensor<half> sg; sg.SetGlobalBuffer((__gm__ half*)src);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int16_t, 5>();
        AscendC::Cast<int16_t, half>(d, s, RINT, 1);
        AscendC::Cast<int16_t, half>(d[1], s, FLOOR, 1);
        AscendC::Cast<int16_t, half>(d[2], s, CEIL, 1);
        AscendC::Cast<int16_t, half>(d[3], s, ROUND, 1);
        AscendC::Cast<int16_t, half>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 5);
    }
    // Test 5-9: float→int16_t, input=2^22+0.5 (overflow)
    {
        auto s = alloc.Alloc<float, 1>();
        AscendC::GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)src + 4);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int16_t, 5>();
        AscendC::Cast<int16_t, float>(d, s, RINT, 1);
        AscendC::Cast<int16_t, float>(d[1], s, FLOOR, 1);
        AscendC::Cast<int16_t, float>(d[2], s, CEIL, 1);
        AscendC::Cast<int16_t, float>(d[3], s, ROUND, 1);
        AscendC::Cast<int16_t, float>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[5], d, 5);
    }
    // Test 10: int32_t→int16_t, input=2^31-1 (saturation)
    {
        auto s = alloc.Alloc<int32_t, 1>();
        AscendC::GlobalTensor<int32_t> sg; sg.SetGlobalBuffer((__gm__ int32_t*)src + 8);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int16_t, 1>();
        AscendC::Cast<int16_t, int32_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[10], d, 1);
    }
    // Test 11: uint32_t→int16_t, input=2^32-1 (saturation)
    {
        auto s = alloc.Alloc<uint32_t, 1>();
        AscendC::GlobalTensor<uint32_t> sg; sg.SetGlobalBuffer((__gm__ uint32_t*)src + 12);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int16_t, 1>();
        AscendC::Cast<int16_t, uint32_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[11], d, 1);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// --- TO_INT32: half→int32, bf16→int32, float→int32, double→int32, int16→int32, int8→int32 ---
__global__ __vector__ void kernel_to_int32(GM_ADDR src, GM_ADDR dst)
{
    AscendC::InitSocState();
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    AscendC::GlobalTensor<int32_t> dstGm;
    dstGm.SetGlobalBuffer((__gm__ int32_t*)dst);

    // Test 0-4: half→int32_t, input=-1.5
    {
        auto s = alloc.Alloc<half, 1>();
        AscendC::GlobalTensor<half> sg; sg.SetGlobalBuffer((__gm__ half*)src);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int32_t, 5>();
        AscendC::Cast<int32_t, half>(d, s, RINT, 1);
        AscendC::Cast<int32_t, half>(d[1], s, FLOOR, 1);
        AscendC::Cast<int32_t, half>(d[2], s, CEIL, 1);
        AscendC::Cast<int32_t, half>(d[3], s, ROUND, 1);
        AscendC::Cast<int32_t, half>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm, d, 5);
    }
    // Test 5-9: bfloat16_t→int32_t, input=64.5
    {
        auto s = alloc.Alloc<bfloat16_t, 1>();
        AscendC::GlobalTensor<bfloat16_t> sg; sg.SetGlobalBuffer((__gm__ bfloat16_t*)src + 2);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<int32_t, 5>();
        AscendC::Cast<int32_t, bfloat16_t>(d, s, RINT, 1);
        AscendC::Cast<int32_t, bfloat16_t>(d[1], s, FLOOR, 1);
        AscendC::Cast<int32_t, bfloat16_t>(d[2], s, CEIL, 1);
        AscendC::Cast<int32_t, bfloat16_t>(d[3], s, ROUND, 1);
        AscendC::Cast<int32_t, bfloat16_t>(d[4], s, TRUNC, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[5], d, 5);
    }
    // Test 10-14: float→int32_t, input=2^22+0.5
    {
        auto s = alloc.Alloc<float, 1>();
        AscendC::GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)src + 2);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
