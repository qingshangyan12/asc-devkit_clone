        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[5], d, 1);
    }
    // Test 6: int32_t→uint8_t, input=2^31-1 (saturation)
    {
        auto s = alloc.Alloc<int32_t, 1>();
        AscendC::GlobalTensor<int32_t> sg; sg.SetGlobalBuffer((__gm__ int32_t*)src + 4);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<uint8_t, 1>();
        AscendC::Cast<uint8_t, int32_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[6], d, 1);
    }
    // Test 7: uint16_t→uint8_t, input=65535 (saturation)
    {
        auto s = alloc.Alloc<uint16_t, 1>();
        AscendC::GlobalTensor<uint16_t> sg; sg.SetGlobalBuffer((__gm__ uint16_t*)src + 6);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<uint8_t, 1>();
        AscendC::Cast<uint8_t, uint16_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[7], d, 1);
    }
    // Test 8: uint32_t→uint8_t, input=2^32-1 (saturation)
    {
        auto s = alloc.Alloc<uint32_t, 1>();
        AscendC::GlobalTensor<uint32_t> sg; sg.SetGlobalBuffer((__gm__ uint32_t*)src + 4);
        AscendC::DataCopy(s, sg, 1);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        auto d = alloc.Alloc<uint8_t, 1>();
        AscendC::Cast<uint8_t, uint32_t>(d, s, NONE, 1);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(dstGm[8], d, 1);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
