#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_bf16.h"

namespace {
constexpr uint32_t THREAD_COUNT = 256;
constexpr float INIT_VAL = 1000.0f;
constexpr float HALF_SUB_VAL = 1.0f;
constexpr float BF16_SUB_VAL = 4.0f;
constexpr uint32_t DYN_UB_SIZE = 128;
} // namespace

void check_acl(aclError result, const char* const func, const char* const file, int const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, static_cast<int>(result),
            aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}

#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_sub_gm_half(__gm__ half* gm_h)
{
    asc_atomic_sub(gm_h, __float2half(HALF_SUB_VAL));
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_sub_gm_bf16(__gm__ bfloat16_t* gm_b)
{
    asc_atomic_sub(gm_b, __float2bfloat16(BF16_SUB_VAL));
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_sub_ub_half(__ubuf__ half* ub_h)
{
    asc_atomic_sub(ub_h, __float2half(HALF_SUB_VAL));
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_sub_ub_bf16(__ubuf__ bfloat16_t* ub_b)
{
    asc_atomic_sub(ub_b, __float2bfloat16(BF16_SUB_VAL));
}

/*
 * Host-side bfloat16_t is an opaque proxy struct (see __clang_cce_types.h), so a
 * host cast such as (bfloat16_t)1000.0f performs no conversion and yields 0x0000.
 * Build the bf16 bit pattern from the float bits instead: bf16 is the top 16 bits
 * of an IEEE-754 float, with round-to-nearest-even applied to the truncated part.
 */
uint16_t float_to_bf16_bits(float val)
{
    uint32_t bits = 0;
    std::memcpy(&bits, &val, sizeof(uint32_t));
    uint32_t lsb = (bits >> 16) & 1u;
    uint32_t round_bias = 0x7FFFu + lsb;
    return (uint16_t)((bits + round_bias) >> 16);
}

float bf16_bits_to_float(uint16_t bf16_bits)
{
    uint32_t bits = (uint32_t)bf16_bits << 16;
    float val = 0.0f;
    std::memcpy(&val, &bits, sizeof(float));
    return val;
}

__simt_vf__ __launch_bounds__(1) inline void simt_ub_init_half(__ubuf__ half* ub_h)
{
    if (threadIdx.x == 0) {
        ub_h[0] = __float2half(INIT_VAL);
    }
}

__simt_vf__ __launch_bounds__(1) inline void simt_ub_init_bf16(__ubuf__ bfloat16_t* ub_b)
{
    if (threadIdx.x == 0) {
        ub_b[0] = __float2bfloat16(INIT_VAL);
    }
}

__simt_vf__ __launch_bounds__(1) inline void simt_readback_gm_half(__gm__ half* gm_h, __gm__ float* results)
{
    if (threadIdx.x == 0) {
        results[0] = __half2float(gm_h[0]);
    }
}

__simt_vf__ __launch_bounds__(1) inline void simt_readback_gm_bf16(__gm__ bfloat16_t* gm_b, __gm__ float* results)
{
    if (threadIdx.x == 0) {
        results[1] = __bfloat162float(gm_b[0]);
    }
}

__simt_vf__ __launch_bounds__(1) inline void simt_readback_ub_half(__ubuf__ half* ub_h, __gm__ float* results)
{
    if (threadIdx.x == 0) {
        results[2] = __half2float(ub_h[0]);
    }
}

__simt_vf__ __launch_bounds__(1) inline void simt_readback_ub_bf16(__ubuf__ bfloat16_t* ub_b, __gm__ float* results)
{
    if (threadIdx.x == 0) {
        results[3] = __bfloat162float(ub_b[0]);
    }
}

__global__ __vector__ void test_gm_half_kernel(__gm__ half* gm_h, __gm__ float* results)
{
    asc_vf_call<simt_sub_gm_half>(dim3(THREAD_COUNT), gm_h);
    asc_vf_call<simt_readback_gm_half>(dim3(1), gm_h, results);
}

__global__ __vector__ void test_gm_bf16_kernel(__gm__ bfloat16_t* gm_b, __gm__ float* results)
{
    asc_vf_call<simt_sub_gm_bf16>(dim3(THREAD_COUNT), gm_b);
    asc_vf_call<simt_readback_gm_bf16>(dim3(1), gm_b, results);
}

__global__ __vector__ void test_ub_half_kernel(__gm__ float* results)
{
    extern __ubuf__ half ub_h[];
    asc_vf_call<simt_ub_init_half>(dim3(1), ub_h);
    asc_vf_call<simt_sub_ub_half>(dim3(THREAD_COUNT), ub_h);
    asc_vf_call<simt_readback_ub_half>(dim3(1), ub_h, results);
}

__global__ __vector__ void test_ub_bf16_kernel(__gm__ float* results)
{
    extern __ubuf__ bfloat16_t ub_b[];
    asc_vf_call<simt_ub_init_bf16>(dim3(1), ub_b);
    asc_vf_call<simt_sub_ub_bf16>(dim3(THREAD_COUNT), ub_b);
    asc_vf_call<simt_readback_ub_bf16>(dim3(1), ub_b, results);
}

int32_t main()
{
    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* gm_h_dev = nullptr;
    bfloat16_t* gm_b_dev = nullptr;
    float* results_dev = nullptr;
    float results_host[4] = {0.0f};

    CHECK_ACL(aclrtMalloc((void**)&gm_h_dev, 64, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&gm_b_dev, 64, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&results_dev, 32, ACL_MEM_MALLOC_HUGE_FIRST));

    half h_init = (half)INIT_VAL;
    uint16_t b_init_bits = float_to_bf16_bits(INIT_VAL);
    uint32_t b_init32 = (uint32_t)b_init_bits;

    /* Guard against a silently wrong host-side init: verify the bit pattern round-trips. */
    if (bf16_bits_to_float(b_init_bits) != INIT_VAL) {
        printf(
            "[ FATAL ] bf16 host init bits 0x%04X decode to %.2f, expected %.2f\n", b_init_bits,
            bf16_bits_to_float(b_init_bits), INIT_VAL);
        return EXIT_FAILURE;
    }

    CHECK_ACL(aclrtMemcpy(gm_h_dev, sizeof(half), &h_init, sizeof(half), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(gm_b_dev, sizeof(uint32_t), &b_init32, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE));

    test_gm_half_kernel<<<1, DYN_UB_SIZE, stream>>>(gm_h_dev, results_dev);
    test_gm_bf16_kernel<<<1, DYN_UB_SIZE, stream>>>(gm_b_dev, results_dev);
    test_ub_half_kernel<<<1, DYN_UB_SIZE, stream>>>(results_dev);
    test_ub_bf16_kernel<<<1, DYN_UB_SIZE, stream>>>(results_dev);

    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(results_host, 32, results_dev, 32, ACL_MEMCPY_DEVICE_TO_HOST));

    float half_expected = INIT_VAL - THREAD_COUNT * HALF_SUB_VAL;
    float bf16_expected = INIT_VAL - THREAD_COUNT * BF16_SUB_VAL;
    bool ok = true;
    const char* names[4] = {"GM half", "GM bfloat16_t", "UB half", "UB bfloat16_t"};
    float expected[4] = {half_expected, bf16_expected, half_expected, bf16_expected};
    for (int32_t i = 0; i < 4; i++) {
        bool pass = (results_host[i] == expected[i]);
        printf("[ %s ] %s: got=%.2f expected=%.2f\n", pass ? "PASS" : "FAIL", names[i], results_host[i], expected[i]);
        if (!pass) {
            ok = false;
        }
    }
    printf("=== %s ===\n", ok ? "ALL PASS" : "SOME FAILED");

    aclrtFree(gm_h_dev);
    aclrtFree(gm_b_dev);
    aclrtFree(results_dev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return ok ? EXIT_SUCCESS : EXIT_FAILURE;
}
