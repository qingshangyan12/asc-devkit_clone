/*
 * asc_atomic_sub (half / bfloat16_t) 边界值测试 —— pure SIMT 形态
 * 依据 BOUNDARY_TEST_DESIGN.md 实现。
 * pure SIMT 形态下被测过载为 asc_atomic_sub(T*, T)（非限定指针，对应 GM），
 * 因此覆盖 GM × half / GM × bfloat16_t 两个组合，单线程执行，位级校验。
 */

#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <cmath>

#include "acl/acl.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/asc_bf16.h"

namespace {
constexpr int32_t OPERAND_OFF = 0;
constexpr int32_t TARGET_OFF = 64;
constexpr int32_t RESULT_OFF = 256;
constexpr int32_t STRIDE = 4;
constexpr uint16_t NEIGHBOR_MAGIC = 0xA5A5;
constexpr int32_t BF16_NUM = 11;
constexpr int32_t HALF_NUM = 11;
constexpr int32_t CASE_NUM = BF16_NUM + HALF_NUM;
constexpr int32_t BF16_START = 0;
constexpr int32_t HALF_START = BF16_NUM;
constexpr uint32_t GM_BYTES = 4096;
} // namespace

enum MatchMode { M_EXACT, M_IS_NAN, M_IS_INF_NEG, M_IS_INF_POS };

struct Case {
    const char* id;
    const char* desc;
    uint16_t target;
    uint16_t val;
    uint16_t expect;
    int mode;
    bool is_bf16;
};

static const Case ALL_CASES[CASE_NUM] = {
    {"B1", "baseline", 0x447A, 0x4100, 0x4478, M_EXACT, true},
    {"B2", "self-to-zero", 0x447A, 0x447A, 0x0000, M_EXACT, true},
    {"B3", "sub-ULP absorbed", 0x447A, 0x3080, 0x447A, M_EXACT, true},
    {"B4", "-0 minus +0", 0x8000, 0x0000, 0x8000, M_EXACT, true},
    {"B5", "overflow to -inf", 0xFF7F, 0x7F7F, 0x0000, M_IS_INF_NEG, true},
    {"B6", "finite - +inf", 0x447A, 0x7F80, 0x0000, M_IS_INF_NEG, true},
    {"B7", "+inf - finite", 0x7F80, 0x4100, 0x0000, M_IS_INF_POS, true},
    {"B8", "inf - inf", 0x7F80, 0x7F80, 0x0000, M_IS_NAN, true},
    {"B9", "NaN target", 0x7FC0, 0x4100, 0x0000, M_IS_NAN, true},
    {"B10", "NaN operand", 0x447A, 0x7FC0, 0x0000, M_IS_NAN, true},
    {"B11", "min normal self-sub", 0x0080, 0x0080, 0x0000, M_EXACT, true},
    {"H1", "baseline", 0x63D0, 0x4800, 0x63C0, M_EXACT, false},
    {"H2", "self-to-zero", 0x63D0, 0x63D0, 0x0000, M_EXACT, false},
    {"H3", "subnormal absorbed", 0x63D0, 0x0001, 0x63D0, M_EXACT, false},
    {"H4", "-0 minus +0", 0x8000, 0x0000, 0x8000, M_EXACT, false},
    {"H5", "overflow to -inf", 0xFBFF, 0x7BFF, 0x0000, M_IS_INF_NEG, false},
    {"H6", "finite - +inf", 0x63D0, 0x7C00, 0x0000, M_IS_INF_NEG, false},
    {"H7", "+inf - finite", 0x7C00, 0x4800, 0x0000, M_IS_INF_POS, false},
    {"H8", "inf - inf", 0x7C00, 0x7C00, 0x0000, M_IS_NAN, false},
    {"H9", "NaN target", 0x7E00, 0x4800, 0x0000, M_IS_NAN, false},
    {"H10", "NaN operand", 0x63D0, 0x7E00, 0x0000, M_IS_NAN, false},
    {"H11", "min normal self-sub", 0x0400, 0x0400, 0x0000, M_EXACT, false},
};

void check_acl(aclError result, const char* const func, const char* const file, int const line)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(
            stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, static_cast<int>(result),
            aclGetRecentErrMsg(), func);
        std::exit(EXIT_FAILURE);
    }
}
#define CHECK_ACL(val) check_acl((val), #val, __FILE__, __LINE__)

/* ---------- pure SIMT kernels (__global__ void, 4-slot launch) ---------- */

__global__ void k_gm_bf16(uint16_t* raw, int32_t start, int32_t n)
{
    if (threadIdx.x != 0) {
        return;
    }
    for (int32_t k = 0; k < n; k++) {
        int32_t i = start + k;
        uint16_t vb = raw[OPERAND_OFF + i];
        bfloat16_t val = (bfloat16_t&)vb;
        bfloat16_t* tgt = (bfloat16_t*)(raw + TARGET_OFF + STRIDE * i);
        bfloat16_t ret = asc_atomic_sub(tgt, val);
        uint16_t* res = raw + RESULT_OFF + STRIDE * i;
        res[0] = ((uint16_t*)tgt)[0];
        res[1] = (uint16_t&)ret;
        res[2] = ((uint16_t*)tgt)[1];
    }
}

__global__ void k_gm_half(uint16_t* raw, int32_t start, int32_t n)
{
    if (threadIdx.x != 0) {
        return;
    }
    for (int32_t k = 0; k < n; k++) {
        int32_t i = start + k;
        uint16_t vb = raw[OPERAND_OFF + i];
        half val = (half&)vb;
        half* tgt = (half*)(raw + TARGET_OFF + STRIDE * i);
        half ret = asc_atomic_sub(tgt, val);
        uint16_t* res = raw + RESULT_OFF + STRIDE * i;
        res[0] = ((uint16_t*)tgt)[0];
        res[1] = (uint16_t&)ret;
        res[2] = ((uint16_t*)tgt)[1];
    }
}

/* ---------- host decode / classify helpers ---------- */

float bf16_bits_to_float(uint16_t b)
{
    uint32_t bits = (uint32_t)b << 16;
    float f = 0.0f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

float half_bits_to_float(uint16_t h)
{
    uint32_t sign = (uint32_t)(h >> 15) & 1u;
    uint32_t exp = (uint32_t)(h >> 10) & 0x1Fu;
    uint32_t mant = (uint32_t)h & 0x3FFu;
    float v;
    if (exp == 0x1Fu) {
        if (mant == 0) {
            return sign ? -INFINITY : INFINITY;
        }
        return NAN;
    }
    if (exp == 0) {
        v = std::ldexp((float)mant, -24); // 次正规: mant * 2^-24
    } else {
        v = std::ldexp(1.0f + (float)mant * 0.0009765625f, (int)exp - 15); // 1/1024 = 2^-10
    }
    return sign ? -v : v;
}

float bits_to_float(uint16_t b, bool is_bf16) { return is_bf16 ? bf16_bits_to_float(b) : half_bits_to_float(b); }

bool is_nan_bits(uint16_t b, bool is_bf16)
{
    uint16_t exp_mask = is_bf16 ? 0x7F80 : 0x7C00;
    uint16_t mant_mask = is_bf16 ? 0x007F : 0x03FF;
    return ((b & exp_mask) == exp_mask) && ((b & mant_mask) != 0);
}

bool is_inf_bits(uint16_t b, bool is_bf16, bool negative)
{
    uint16_t exp_mask = is_bf16 ? 0x7F80 : 0x7C00;
    uint16_t mant_mask = is_bf16 ? 0x007F : 0x03FF;
    uint16_t sign = negative ? 0x8000 : 0x0000;
    return ((b & exp_mask) == exp_mask) && ((b & mant_mask) == 0) && ((b & 0x8000) == sign);
}

/* ---------- host self-check of bit-pattern constants ---------- */

bool ck_decode(uint16_t b, bool is_bf16, float expf, const char* tag)
{
    float f = bits_to_float(b, is_bf16);
    bool ok;
    if (std::isnan(expf)) {
        ok = std::isnan(f);
    } else if (std::isinf(expf)) {
        ok = std::isinf(f) && (std::signbit(f) == std::signbit(expf));
    } else if (expf == 0.0f) {
        ok = (f == 0.0f) && (std::signbit(f) == std::signbit(expf));
    } else {
        ok = (f == expf);
    }
    if (!ok) {
        std::printf(
            "[ FATAL ] self-check %s: bits=0x%04X (%s) -> %.9g expected %.9g\n", tag, b, is_bf16 ? "bf16" : "half",
            (double)f, (double)expf);
    }
    return ok;
}

bool self_check()
{
    bool ok = true;
    const float bf16_max = 255.0f * std::ldexp(1.0f, 120);
    ok &= ck_decode(0x447A, true, 1000.0f, "bf16 0x447A");
    ok &= ck_decode(0x4100, true, 8.0f, "bf16 0x4100");
    ok &= ck_decode(0x4478, true, 992.0f, "bf16 0x4478");
    ok &= ck_decode(0x3080, true, std::ldexp(1.0f, -30), "bf16 0x3080");
    ok &= ck_decode(0x0080, true, std::ldexp(1.0f, -126), "bf16 0x0080");
    ok &= ck_decode(0x0000, true, 0.0f, "bf16 0x0000");
    ok &= ck_decode(0x8000, true, -0.0f, "bf16 0x8000");
    ok &= ck_decode(0x7F7F, true, bf16_max, "bf16 0x7F7F");
    ok &= ck_decode(0xFF7F, true, -bf16_max, "bf16 0xFF7F");
    ok &= ck_decode(0x7F80, true, INFINITY, "bf16 0x7F80");
    ok &= ck_decode(0xFF80, true, -INFINITY, "bf16 0xFF80");
    ok &= ck_decode(0x7FC0, true, NAN, "bf16 0x7FC0");
    ok &= ck_decode(0x63D0, false, 1000.0f, "half 0x63D0");
    ok &= ck_decode(0x4800, false, 8.0f, "half 0x4800");
    ok &= ck_decode(0x63C0, false, 992.0f, "half 0x63C0");
    ok &= ck_decode(0x0001, false, std::ldexp(1.0f, -24), "half 0x0001");
    ok &= ck_decode(0x0400, false, std::ldexp(1.0f, -14), "half 0x0400");
    ok &= ck_decode(0x0000, false, 0.0f, "half 0x0000");
    ok &= ck_decode(0x8000, false, -0.0f, "half 0x8000");
    ok &= ck_decode(0x7BFF, false, 65504.0f, "half 0x7BFF");
    ok &= ck_decode(0xFBFF, false, -65504.0f, "half 0xFBFF");
    ok &= ck_decode(0x7C00, false, INFINITY, "half 0x7C00");
    ok &= ck_decode(0xFC00, false, -INFINITY, "half 0xFC00");
    ok &= ck_decode(0x7E00, false, NAN, "half 0x7E00");
    if (!ok) {
        std::printf("[ FATAL ] bit-pattern self-check failed, aborting.\n");
    }
    return ok;
}

/* ---------- per-kernel validation & printing ---------- */

const char* mode_name(int m)
{
    switch (m) {
        case M_EXACT:
            return "EXACT";
        case M_IS_NAN:
            return "IS_NAN";
        case M_IS_INF_NEG:
            return "IS_INF(neg)";
        case M_IS_INF_POS:
            return "IS_INF(pos)";
        default:
            return "?";
    }
}

void fmt_value(uint16_t b, bool is_bf16, char* out, size_t n)
{
    if (is_nan_bits(b, is_bf16)) {
        std::snprintf(out, n, "nan");
        return;
    }
    if (is_inf_bits(b, is_bf16, false)) {
        std::snprintf(out, n, "+inf");
        return;
    }
    if (is_inf_bits(b, is_bf16, true)) {
        std::snprintf(out, n, "-inf");
        return;
    }
    std::snprintf(out, n, "%.4g", (double)bits_to_float(b, is_bf16));
}

bool validate_combo(const uint16_t* res, int32_t start, int32_t n, const char* combo, int* pass_cnt, int* fail_cnt)
{
    bool all_ok = true;
    for (int32_t k = 0; k < n; k++) {
        int32_t i = start + k;
        const Case& c = ALL_CASES[i];
        uint16_t got_mem = res[STRIDE * k + 0];
        uint16_t got_ret = res[STRIDE * k + 1];
        uint16_t got_nbr = res[STRIDE * k + 2];
        bool nbr_ok = (got_nbr == NEIGHBOR_MAGIC);
        bool ok = false;
        switch (c.mode) {
            case M_EXACT:
                ok = (got_mem == c.expect);
                break;
            case M_IS_NAN:
                ok = is_nan_bits(got_mem, c.is_bf16);
                break;
            case M_IS_INF_NEG:
                ok = is_inf_bits(got_mem, c.is_bf16, true);
                break;
            case M_IS_INF_POS:
                ok = is_inf_bits(got_mem, c.is_bf16, false);
                break;
        }
        ok = ok && nbr_ok;

        char gotv[32], retv[32];
        fmt_value(got_mem, c.is_bf16, gotv, sizeof(gotv));
        fmt_value(got_ret, c.is_bf16, retv, sizeof(retv));
        std::printf(
            "[ %s ] %-4s %-14s target=0x%04X val=0x%04X -> got=0x%04X (%s) expect=0x%04X %-11s nbr=%s ret=0x%04X "
            "(%s)\n",
            ok ? "PASS" : "FAIL", c.id, combo, c.target, c.val, got_mem, gotv, c.expect, mode_name(c.mode),
            nbr_ok ? "OK" : "BAD", got_ret, retv);
        if (ok) {
            (*pass_cnt)++;
        } else {
            (*fail_cnt)++;
            all_ok = false;
        }
    }
    return all_ok;
}

int32_t main()
{
    if (!self_check()) {
        return EXIT_FAILURE;
    }

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint16_t* raw_dev = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&raw_dev, GM_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));

    uint16_t operand[CASE_NUM];
    for (int32_t i = 0; i < CASE_NUM; i++) {
        operand[i] = ALL_CASES[i].val;
    }
    CHECK_ACL(aclrtMemcpy(raw_dev + OPERAND_OFF, CASE_NUM * 2, operand, CASE_NUM * 2, ACL_MEMCPY_HOST_TO_DEVICE));

    uint16_t target_init[STRIDE * CASE_NUM];
    for (int32_t i = 0; i < CASE_NUM; i++) {
        target_init[STRIDE * i + 0] = ALL_CASES[i].target;
        target_init[STRIDE * i + 1] = NEIGHBOR_MAGIC;
        target_init[STRIDE * i + 2] = 0x0000;
        target_init[STRIDE * i + 3] = 0x0000;
    }
    size_t target_bytes = (size_t)STRIDE * CASE_NUM * 2;

    uint16_t res_host[STRIDE * CASE_NUM];
    int total_pass = 0, total_fail = 0;
    bool all_ok = true;

    struct Run {
        const char* combo;
        int32_t start;
        int32_t n;
        bool is_bf16;
    };
    Run runs[2] = {
        {"GM bf16", BF16_START, BF16_NUM, true},
        {"GM half", HALF_START, HALF_NUM, false},
    };

    for (int r = 0; r < 2; r++) {
        CHECK_ACL(
            aclrtMemcpy(raw_dev + TARGET_OFF, target_bytes, target_init, target_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        std::memset(res_host, 0, sizeof(res_host));
        CHECK_ACL(
            aclrtMemcpy(raw_dev + RESULT_OFF, sizeof(res_host), res_host, sizeof(res_host), ACL_MEMCPY_HOST_TO_DEVICE));

        if (runs[r].is_bf16) {
            k_gm_bf16<<<1, 1, 0, stream>>>(raw_dev, runs[r].start, runs[r].n);
        } else {
            k_gm_half<<<1, 1, 0, stream>>>(raw_dev, runs[r].start, runs[r].n);
        }
        CHECK_ACL(aclrtGetLastError(ACL_RT_THREAD_LEVEL));
        CHECK_ACL(aclrtSynchronizeStream(stream));

        size_t bytes = (size_t)STRIDE * runs[r].n * 2;
        CHECK_ACL(aclrtMemcpy(
            res_host, bytes, raw_dev + RESULT_OFF + STRIDE * runs[r].start, bytes, ACL_MEMCPY_DEVICE_TO_HOST));

        int p = 0, f = 0;
        bool ok = validate_combo(res_host, runs[r].start, runs[r].n, runs[r].combo, &p, &f);
        total_pass += p;
        total_fail += f;
        if (!ok) {
            all_ok = false;
        }
        std::printf("--- %s: %d pass, %d fail ---\n\n", runs[r].combo, p, f);
    }

    std::printf(
        "=== PURE SIMT FORM TOTAL: %d pass, %d fail => %s ===\n", total_pass, total_fail,
        all_ok ? "ALL PASS" : "SOME FAILED");

    aclrtFree(raw_dev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return all_ok ? EXIT_SUCCESS : EXIT_FAILURE;
}
