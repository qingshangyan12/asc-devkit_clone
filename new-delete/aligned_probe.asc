/**
 * Array new/delete probe.
 * This file only calls the array allocation kernel.
 */

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t DEVICE_ID = 0;
constexpr uintptr_t HEAP_BYTES = 64 * 1024;

} // namespace

void CheckAcl(aclError result, const char* expr, const char* file, int32_t line)
{
    if (result == ACL_SUCCESS) {
        return;
    }
    const char* msg = aclGetRecentErrMsg();
    std::fprintf(stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, static_cast<int32_t>(result),
        (msg != nullptr) ? msg : "no detail", expr);
    std::exit(EXIT_FAILURE);
}

#define CHECK_ACL(expr) CheckAcl((expr), #expr, __FILE__, __LINE__)

__global__ void kernel(int32_t* d_result)
{
    int32_t* p = new int32_t[4];
    p[0] = 10;
    p[1] = 20;
    p[2] = 30;
    p[3] = 40;
    int32_t a = p[0] + p[1] + p[2] + p[3];
    delete[] p;
}

// void test() {
//     int32_t* p = new int32_t[4];
//     p[0] = 10;
//     p[1] = 20;
//     p[2] = 30;
//     p[3] = 40;
//     int32_t a = p[0] + p[1] + p[2] + p[3];
//     delete[] p;
// }

int main()
{
    std::printf("array new/delete probe starting...\n");

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));

    int32_t* result_device = nullptr;
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&result_device), sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    // kernel<<<1, 1, 0, stream>>>(result_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtDestroyStream(stream));

    int32_t result = -1;
    CHECK_ACL(aclrtMemcpy(&result, sizeof(result), result_device, sizeof(result), ACL_MEMCPY_DEVICE_TO_HOST));
    std::printf("array_result=%d\n", result);

    CHECK_ACL(aclrtFree(result_device));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());

    // test();

    return (result == 100) ? EXIT_SUCCESS : EXIT_FAILURE;
}
