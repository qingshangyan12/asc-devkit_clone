/**
 * This sample is adapted from NVIDIA CUDA Samples cpp/3_CUDA_Features/newdelete.
 * It demonstrates device-side C++ new/delete and placement new in Ascend C SIMT.
 */

#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

#include "container.hpp"

namespace cg = cooperative_groups;

namespace {
constexpr const char* SAMPLE_NAME = "newdelete";
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;
constexpr uint32_t DEVICE_ID = 0;
constexpr uint32_t HEAP_BYTES = 1024 * 1024;
constexpr uint32_t CONTAINER_BLOCKS = 128;
constexpr uint32_t CONTAINER_THREADS = 128;
constexpr uint32_t PLACEMENT_THREADS = 1024;

struct HeapHeader {
    uintptr_t total_size;
};

__gm__ uint8_t* g_heap_base = nullptr;
__gm__ uintptr_t g_heap_offset = 0;
__gm__ uintptr_t g_heap_capacity = 0;
} // namespace

__aicore__ uintptr_t dpp_alloc(uintptr_t size)
{
    constexpr uintptr_t ALIGNMENT = 8;
    uintptr_t payload_size = (size + ALIGNMENT - 1) & ~(ALIGNMENT - 1);
    uintptr_t total_size = payload_size + sizeof(HeapHeader);

    uintptr_t offset = g_heap_offset;
    if (g_heap_base == nullptr || offset + total_size > g_heap_capacity) {
        return 0;
    }

    HeapHeader* header = reinterpret_cast<HeapHeader*>(g_heap_base + offset);
    header->total_size = total_size;
    g_heap_offset += total_size;
    return reinterpret_cast<uintptr_t>(header + 1);
}

__aicore__ void dpp_dealloc(uintptr_t addr)
{
    if (addr == 0 || g_heap_base == nullptr) {
        return;
    }

    HeapHeader* header = reinterpret_cast<HeapHeader*>(addr - sizeof(HeapHeader));
    uintptr_t offset = reinterpret_cast<uintptr_t>(header) - reinterpret_cast<uintptr_t>(g_heap_base);
    uintptr_t total_size = header->total_size;
    if (offset + total_size == g_heap_offset) {
        g_heap_offset = offset;
    }
}

struct ComplexType {
    int32_t a;
    int32_t b;
    float c;
    float d;
};

void CheckAcl(aclError result, const char* func, const char* file, int32_t line)
{
    if (result == ACL_SUCCESS) {
        return;
    }
    const char* msg = aclGetRecentErrMsg();
    std::fprintf(
        stderr, "ACL error at %s:%d code=%d(%s) \"%s\"\n", file, line, static_cast<int32_t>(result),
        (msg != nullptr) ? msg : "no detail", func);
    std::exit(EXIT_FAILURE);
}

#define CHECK_ACL(expr) CheckAcl((expr), #expr, __FILE__, __LINE__)

__global__ void InitDeviceHeap(uint8_t* heap_base, uintptr_t heap_capacity)
{
    if (threadIdx.x == 0) {
        g_heap_base = heap_base;
        g_heap_offset = 0;
        g_heap_capacity = heap_capacity;
    }
}

__global__ void VectorCreate(Vector<int32_t>** g_container, int32_t max_size)
{
    if (threadIdx.x == 0) {
        *g_container = new Vector<int32_t>(max_size);
    }
}

__global__ void VectorFill(Vector<int32_t>** g_vector)
{
    if (threadIdx.x == 0 && *g_vector != nullptr) {
        (*g_vector)->Vector<int32_t>::Push(static_cast<int32_t>(blockIdx.x));
    }
}

__global__ void VectorConsume(Vector<int32_t>** g_vector, int32_t* result)
{
    int32_t idx = static_cast<int32_t>(blockIdx.x * blockDim.x + threadIdx.x);
    int32_t value = 0;

    if (*g_vector != nullptr && (*g_vector)->Vector<int32_t>::Pop(value)) {
        result[idx] = value;
    } else {
        result[idx] = -1;
    }
}

__global__ void VectorDelete(Vector<int32_t>** g_vector)
{
    if (threadIdx.x == 0 && *g_vector != nullptr) {
        delete *g_vector;
        *g_vector = nullptr;
    }
}

__global__ void PlacementNew(int32_t* result)
{
    cg::thread_block cta = cg::this_thread_block();
    __ubuf__ uint64_t buffer[(sizeof(Vector<int32_t>) + sizeof(uint64_t) - 1) / sizeof(uint64_t)];
    __ubuf__ int32_t data[PLACEMENT_THREADS];
    __ubuf__ Vector<int32_t>* vector;

    if (threadIdx.x == 0) {
        vector = new (reinterpret_cast<void*>(buffer)) Vector<int32_t>(PLACEMENT_THREADS, data);
    }

    cg::sync(cta);

    if ((threadIdx.x & 1) == 0) {
        vector->Vector<int32_t>::Push(static_cast<int32_t>(threadIdx.x >> 1));
    }

    cg::sync(cta);

    int32_t value = 0;
    if (vector->Vector<int32_t>::Pop(value)) {
        result[threadIdx.x] = value;
    } else {
        result[threadIdx.x] = -1;
    }
}

__global__ void ComplexVector(int32_t* result)
{
    cg::thread_block cta = cg::this_thread_block();
    __ubuf__ uint64_t buffer[(sizeof(Vector<ComplexType>) + sizeof(uint64_t) - 1) / sizeof(uint64_t)];
    __ubuf__ ComplexType data[PLACEMENT_THREADS];
    __ubuf__ Vector<ComplexType>* vector;

    if (threadIdx.x == 0) {
        vector = new (reinterpret_cast<void*>(buffer)) Vector<ComplexType>(PLACEMENT_THREADS, data);
    }

    cg::sync(cta);

    if ((threadIdx.x & 1) == 0) {
        ComplexType data_value;
        data_value.a = static_cast<int32_t>(threadIdx.x >> 1);
        data_value.b = static_cast<int32_t>(blockIdx.x);
        data_value.c = static_cast<float>(threadIdx.x) / static_cast<float>(blockDim.x);
        data_value.d = static_cast<float>(blockIdx.x) / static_cast<float>(gridDim.x);
        vector->Vector<ComplexType>::Push(data_value);
    }

    cg::sync(cta);

    ComplexType value;
    if (vector->Vector<ComplexType>::Pop(value)) {
        result[threadIdx.x] = value.a;
    } else {
        result[threadIdx.x] = -1;
    }
}

bool CheckResult(const std::vector<int32_t>& result, int32_t expected_count)
{
    std::vector<int32_t> sorted(result);
    std::sort(sorted.begin(), sorted.end());

    bool started = false;
    int32_t expected = 0;
    for (int32_t value : sorted) {
        if (value != -1) {
            started = true;
        }
        if (started && value != expected++) {
            return false;
        }
    }

    return expected == expected_count;
}

bool CopyAndCheck(int32_t* result_device, int32_t result_count, int32_t expected_count)
{
    std::vector<int32_t> result(result_count);
    CHECK_ACL(aclrtMemcpy(
        result.data(), result_count * sizeof(int32_t), result_device, result_count * sizeof(int32_t),
        ACL_MEMCPY_DEVICE_TO_HOST));
    return CheckResult(result, expected_count);
}

bool TestVector(Vector<int32_t>** vector_device, uint32_t blocks, uint32_t threads)
{
    int32_t* result_device = nullptr;
    uint32_t result_count = blocks * threads;
    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&result_device), result_count * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    VectorFill<<<blocks, threads, 0, stream>>>(vector_device);
    VectorConsume<<<blocks, threads, 0, stream>>>(vector_device, result_device);
    VectorDelete<<<1, 1, 0, stream>>>(vector_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtDestroyStream(stream));

    bool success = CopyAndCheck(result_device, static_cast<int32_t>(result_count), static_cast<int32_t>(blocks));
    CHECK_ACL(aclrtFree(result_device));
    return success;
}

bool TestPlacementNew(uint32_t threads)
{
    int32_t* result_device = nullptr;
    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&result_device), threads * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    PlacementNew<<<1, threads, 0, stream>>>(result_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtDestroyStream(stream));

    bool success = CopyAndCheck(result_device, static_cast<int32_t>(threads), static_cast<int32_t>(threads / 2));
    CHECK_ACL(aclrtFree(result_device));
    return success;
}

bool TestComplexType(uint32_t threads)
{
    int32_t* result_device = nullptr;
    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&result_device), threads * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    ComplexVector<<<1, threads, 0, stream>>>(result_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtDestroyStream(stream));

    bool success = CopyAndCheck(result_device, static_cast<int32_t>(threads), static_cast<int32_t>(threads / 2));
    CHECK_ACL(aclrtFree(result_device));
    return success;
}

int32_t main(int32_t argc, char* argv[])
{
    std::printf("%s Starting...\n\n", SAMPLE_NAME);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));

    uint8_t* heap_device = nullptr;
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&heap_device), HEAP_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));
    InitDeviceHeap<<<1, 1, 0, stream>>>(heap_device, HEAP_BYTES);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtDestroyStream(stream));

    Vector<int32_t>** vector_device = nullptr;
    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&vector_device), sizeof(Vector<int32_t>*), ACL_MEM_MALLOC_HUGE_FIRST));

    int32_t test_passed = 0;

    std::printf(" > Vector test ");
    CHECK_ACL(aclrtCreateStream(&stream));
    VectorCreate<<<1, 1, 0, stream>>>(
        vector_device, static_cast<int32_t>(CONTAINER_BLOCKS * CONTAINER_THREADS));
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtDestroyStream(stream));
    bool test_ok = TestVector(vector_device, CONTAINER_BLOCKS, CONTAINER_THREADS);
    std::printf(test_ok ? "OK\n\n" : "NOT OK\n\n");
    test_passed += test_ok ? 1 : 0;

    CHECK_ACL(aclrtFree(vector_device));

    std::printf(" > Vector, using placement new on UB buffer test ");
    test_ok = TestPlacementNew(PLACEMENT_THREADS);
    std::printf(test_ok ? "OK\n\n" : "NOT OK\n\n");
    test_passed += test_ok ? 1 : 0;

    std::printf(" > Vector, with user defined datatype test ");
    test_ok = TestComplexType(PLACEMENT_THREADS);
    std::printf(test_ok ? "OK\n\n" : "NOT OK\n\n");
    test_passed += test_ok ? 1 : 0;

    std::printf("Test Summary: %d/3 successfully run\n", test_passed);

    CHECK_ACL(aclrtFree(heap_device));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());

    return test_passed == 3 ? EXIT_SUCCESS : EXIT_FAILURE;
}
