/* !
 * \file gelu.asc
 * \brief GELU operator performance tuning sample
 *
 * GELU formula (tanh approximation):
 * GELU(x) ≈ x / (1 + e^(-1.595769 · (x + 0.044715 · x³)))
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace Custom {
template <typename T>
struct SoftmaxTiling {
    uint32_t aDim = 0;
    uint32_t rDim = 0;
    uint32_t rDimAlign = 0;
    uint32_t loopCount = 0;
    uint32_t singleCoreLength = 0;
    uint32_t singleCoreAlignLength = 0;
    T tData;
};
}

namespace Custom {
union DataUnion {
    constexpr __aicore__ DataUnion() : f(0.0f) {}
    constexpr __aicore__ DataUnion(uint32_t val) : i(val) {}
    float f;
    uint32_t i;
};
constexpr DataUnion fp32MinValue(0x00800000u);
}

template <typename T, typename U, typename V>
__simd_callee__ inline void LoadWithCastIfNeed(__ubuf__ T* srcAddr, U& dstReg, 
    V& preg, uint32_t offset)
{
    if constexpr (AscendC::IsSameType<T, half>::value) {
        AscendC::Reg::RegTensor<half> srcReg;
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, AscendC::layoutZMrgZ>(dstReg, srcReg, preg);
    } else {
        AscendC::Reg::LoadAlign(dstReg, srcAddr + offset);
    }
}

template <typename T, typename U, typename V>
__simd_callee__ inline void StoreWithCastIfNeed(__ubuf__ T* dstAddr, U& srcReg, 
    V& preg, uint32_t offset)
{
    if constexpr (AscendC::IsSameType<T, half>::value) {
        AscendC::Reg::RegTensor<half> dstReg;
        AscendC::Reg::Cast<T, float, AscendC::LayoutZMrgZRndRSatNS>(dstReg, srcReg, preg);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(dstAddr + offset, dstReg, preg);
    } else {
        AscendC::Reg::StoreAlign(dstAddr + offset, srcReg, preg);
    }
}

// Update Mask模式带尾块 : ReduceMax和ExpSub融合；ReduceSum和Div融合
// aiv_time(us)	aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 14.69	    23919	            2.422	            0.165
template <typename T>
__simd_vf__ inline void CustomSoftmaxVF0(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, __ubuf__ float* expAddr,
    __ubuf__ float* maxAddr, __ubuf__ float* sumAddr, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    uint16_t repeatTimes = AscendC::CeilDivision(rDim, oneRepeatSize);
    AscendC::Reg::MaskReg maskFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> expReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> divReg;

    // Phase 1: ReduceMax + Sub + Exp
    for (uint32_t i = 0; i < aDim; i++) {
        uint32_t count = rDim;
        AscendC::Reg::Duplicate(maxReg, Custom::fp32MinValue.f, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(count);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxReg, maxReg, srcReg, mask);
        }
        AscendC::Reg::ReduceMax(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(maxReg, maxReg, maskFull);
        uint32_t sreg0 = rDim;

        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg0);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::ExpSub(expReg, srcReg, maxReg, mask);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize, expReg, mask);
        }
    }
    mem_bar(VST_VLD);
    for (uint32_t i = 0; i < aDim; i++) {
        // ReduceSum + Div, Dtype: float
        uint32_t sreg1 = rDim;
        AscendC::Reg::Duplicate(sumReg, 0.0, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg1);
            AscendC::Reg::LoadAlign(srcReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumReg, sumReg, srcReg, mask);
        }
        AscendC::Reg::ReduceSum(sumReg, sumReg, maskFull);
        AscendC::Reg::Duplicate(sumReg, sumReg, maskFull);
        uint32_t sreg2 = rDim;
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg2);
            AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Div(divReg, maxReg, sumReg, mask);
            StoreWithCastIfNeed(dstAddr, divReg, mask, i * rDimAlign + j * oneRepeatSize);
        }
    }
}

// Update Mask模式带尾块 : ReduceMax和ExpSub以及ReduceSum融合；Div融合
// aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 25457	        2.399           	0.153
template <typename T>
__simd_vf__ inline void CustomSoftmaxVF00(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, __ubuf__ float* expAddr,
    __ubuf__ float* maxAddr, __ubuf__ float* sumAddr, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    uint16_t repeatTimes = AscendC::CeilDivision(rDim, oneRepeatSize);
    AscendC::Reg::MaskReg maskFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> expReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> divReg;

    AscendC::Reg::MaskReg maskReduce = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::VL8>();

    // Phase 1: ReduceMax + Sub + Exp + ReduceSum
    for (uint32_t i = 0; i < aDim; i++) {
        uint32_t count = rDim;
        AscendC::Reg::Duplicate(maxReg, Custom::fp32MinValue.f, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(count);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxReg, maxReg, srcReg, mask);
        }
        AscendC::Reg::ReduceMax(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(sumReg, 0.0, maskFull);
        uint32_t sreg0 = rDim;

        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg0);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::ExpSub(expReg, srcReg, maxReg, mask);
            AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumReg, sumReg, expReg, mask);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize, expReg, mask);
        }
        AscendC::Reg::ReduceSum(sumReg, sumReg, maskFull);
        AscendC::Reg::StoreAlign<float>(sumAddr + i  * 8, sumReg, maskReduce);
    }
    mem_bar(VST_VLD);
    for (uint32_t i = 0; i < aDim; i++) {
        AscendC::Reg::LoadAlign<float>(sumReg, sumAddr + i  * 8);
        AscendC::Reg::Duplicate(sumReg, sumReg, maskFull);
        uint32_t sreg2 = rDim;
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg2);
            AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Div(divReg, maxReg, sumReg, mask);
            StoreWithCastIfNeed(dstAddr, divReg, mask, i * rDimAlign + j * oneRepeatSize);
        }
    }
}

// 主尾块模式 带尾块: RedeuceMax和ExpSub融合；ReduceSum和Div融合
// 带尾轴判断：
// aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 28948	        4.992	            0.281
// 不带尾轴判断：
// aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 22754	        2.105	            0.15
template <typename T>
__simd_vf__ inline void CustomSoftmaxVF1(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, __ubuf__ float* expAddr,
    __ubuf__ float* maxAddr, __ubuf__ float* sumAddr, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign, uint16_t tail,
    uint16_t repeatTimesMain, uint16_t hasTail)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    AscendC::Reg::MaskReg maskFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::MaskReg mask = maskFull;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> expReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> divReg;

    uint32_t sreg = tail;
    AscendC::Reg::MaskReg maskTail = AscendC::Reg::UpdateMask<float>(sreg);

    // Phase 1: ReduceMax + Sub + Exp
    for (uint32_t i = 0; i < aDim; i++) {
        AscendC::Reg::Duplicate(maxReg, Custom::fp32MinValue.f, maskFull);
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     LoadWithCastIfNeed(srcAddr, srcReg, maskFull, i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     AscendC::Reg::Max(srcReg, maxReg, srcReg, maskTail);
        //     AscendC::Reg::Move(maxReg, srcReg, maskTail);
        // }
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            LoadWithCastIfNeed(srcAddr, srcReg, maskFull, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Max(maxReg, maxReg, srcReg, maskFull);
        }
        AscendC::Reg::ReduceMax(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(maxReg, maxReg, maskFull);
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            LoadWithCastIfNeed(srcAddr, srcReg, maskFull, i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::ExpSub(expReg, srcReg, maxReg, maskFull);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize, expReg, maskFull);
        }
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     LoadWithCastIfNeed(srcAddr, srcReg, maskTail, i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     AscendC::Reg::ExpSub(expReg, srcReg, maxReg, maskTail);
        //     AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize, expReg, maskTail); 
        // }
    }
    mem_bar(VST_VLD);
    for (uint32_t i = 0; i < aDim; i++) {
        AscendC::Reg::Duplicate(sumReg, 0.0, maskFull);
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     AscendC::Reg::LoadAlign(srcReg, expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     AscendC::Reg::Add<float>(srcReg, sumReg, srcReg, maskTail);
        //     AscendC::Reg::Move(sumReg, srcReg, maskTail);
        // }
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            AscendC::Reg::LoadAlign(srcReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Add<float>(sumReg, sumReg, srcReg, maskFull);
        }
        AscendC::Reg::ReduceSum(sumReg, sumReg, maskFull);
        AscendC::Reg::Duplicate(sumReg, sumReg, maskFull);
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::Div(divReg, maxReg, sumReg, mask);
            StoreWithCastIfNeed(dstAddr, divReg, mask, i * rDimAlign + j * oneRepeatSize);
        }
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     AscendC::Reg::Div(divReg, maxReg, sumReg, mask);
        //     StoreWithCastIfNeed(dstAddr, divReg, mask, i * rDimAlign + repeatTimesMain * oneRepeatSize);
        // }
    }
}

// Update Mask模式带尾块 切A轴 : ReduceMax和ExpSub融合；ReduceSum和Div融合
// aiv_time(us)	aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 14.83	    24143	            2.141	            0.144
template <typename T>
__simd_vf__ inline void CustomSoftmaxVF2(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, __ubuf__ float* expAddr,
    __ubuf__ float* maxAddr, __ubuf__ float* sumAddr, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    uint16_t repeatTimes = AscendC::CeilDivision(rDim, oneRepeatSize);
    AscendC::Reg::MaskReg maskFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> expReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> divReg;

    AscendC::Reg::MaskReg mask1;
    AscendC::Reg::RegTensor<float> srcReg1;
    AscendC::Reg::RegTensor<float> maxReg1;
    AscendC::Reg::RegTensor<float> expReg1;
    AscendC::Reg::RegTensor<float> sumReg1;
    AscendC::Reg::RegTensor<float> divReg1;

    uint16_t halfA = 64;

    // Phase 1: ReduceMax + Sub + Exp
    for (uint32_t i = 0; i < halfA; i++) {
        uint32_t count = rDim;
        AscendC::Reg::Duplicate(maxReg, Custom::fp32MinValue.f, maskFull);
        AscendC::Reg::Duplicate(maxReg1, Custom::fp32MinValue.f, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(count);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            LoadWithCastIfNeed(srcAddr, srcReg1, mask, i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxReg, maxReg, srcReg, mask);
            AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxReg1, maxReg1, srcReg1, mask);
        }
        AscendC::Reg::ReduceMax(maxReg, maxReg, maskFull);
        AscendC::Reg::ReduceMax(maxReg1, maxReg1, maskFull);
        AscendC::Reg::Duplicate(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(maxReg1, maxReg1, maskFull);
        uint32_t sreg0 = rDim;

        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg0);
            LoadWithCastIfNeed(srcAddr, srcReg, mask, i * rDimAlign + j * oneRepeatSize);
            LoadWithCastIfNeed(srcAddr, srcReg1, mask, i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::ExpSub(expReg, srcReg, maxReg, mask);
            AscendC::Reg::ExpSub(expReg1, srcReg1, maxReg1, mask);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize, expReg, mask);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign, expReg1, mask);
        }
    }
    mem_bar(VST_VLD);
    for (uint32_t i = 0; i < halfA; i++) {
        // ReduceSum + Div, Dtype: float
        uint32_t sreg1 = rDim;
        AscendC::Reg::Duplicate(sumReg, 0.0, maskFull);
        AscendC::Reg::Duplicate(sumReg1, 0.0, maskFull);
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg1);
            AscendC::Reg::LoadAlign(srcReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::LoadAlign(srcReg1, expAddr + i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumReg, sumReg, srcReg, mask);
            AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumReg1, sumReg1, srcReg1, mask);
        }
        AscendC::Reg::ReduceSum(sumReg, sumReg, maskFull);
        AscendC::Reg::ReduceSum(sumReg1, sumReg1, maskFull);
        AscendC::Reg::Duplicate(sumReg, sumReg, maskFull);
        AscendC::Reg::Duplicate(sumReg1, sumReg1, maskFull);
        uint32_t sreg2 = rDim;
        for (uint16_t j = 0; j < repeatTimes; j++) {
            mask = AscendC::Reg::UpdateMask<float>(sreg2);
            AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::LoadAlign(maxReg1, expAddr + i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::Div(divReg, maxReg, sumReg, mask);
            AscendC::Reg::Div(divReg1, maxReg1, sumReg1, mask);
            StoreWithCastIfNeed(dstAddr, divReg, mask, i * rDimAlign + j * oneRepeatSize);
            StoreWithCastIfNeed(dstAddr, divReg1, mask, i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
        }
    }
}

// 主尾块模式 切A轴: RedeuceMax和ExpSub融合；ReduceSum和Div融合
// 带尾轴判断：
// aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 25993	        3.233	            0.203
// 不带尾轴判断：
// aiv_total_cycles	aiv_vec_time(us)	aiv_vec_ratio
// 24160	        1.669	            0.113
template <typename T>
__simd_vf__ inline void CustomSoftmaxVF3(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr, __ubuf__ float* expAddr,
    __ubuf__ float* maxAddr, __ubuf__ float* sumAddr, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign, uint16_t tail,
    uint16_t repeatTimesMain, uint16_t hasTail)
{
    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    AscendC::Reg::MaskReg maskFull = AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::MaskReg mask = maskFull;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> expReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> divReg;

    AscendC::Reg::RegTensor<float> srcReg1;
    AscendC::Reg::RegTensor<float> maxReg1;
    AscendC::Reg::RegTensor<float> expReg1;
    AscendC::Reg::RegTensor<float> sumReg1;
    AscendC::Reg::RegTensor<float> divReg1;

    uint32_t sreg = tail;
    AscendC::Reg::MaskReg maskTail = AscendC::Reg::UpdateMask<float>(sreg);

    uint16_t halfA = 64;

    // Phase 1: ReduceMax + Sub + Exp
    for (uint32_t i = 0; i < halfA; i++) {
        AscendC::Reg::Duplicate(maxReg, Custom::fp32MinValue.f, maskFull);
        AscendC::Reg::Duplicate(maxReg1, Custom::fp32MinValue.f, maskFull);
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     LoadWithCastIfNeed(srcAddr, srcReg, maskFull, i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     LoadWithCastIfNeed(srcAddr, srcReg1, maskFull, i * rDimAlign + repeatTimesMain * oneRepeatSize + halfA * rDimAlign);
        //     AscendC::Reg::Max(srcReg, maxReg, srcReg, maskTail);
        //     AscendC::Reg::Max(srcReg1, maxReg1, srcReg1, maskTail);
        //     AscendC::Reg::Move(maxReg, srcReg, maskTail);
        //     AscendC::Reg::Move(maxReg1, srcReg1, maskTail);
        // }
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            LoadWithCastIfNeed(srcAddr, srcReg, maskFull, i * rDimAlign + j * oneRepeatSize);
            LoadWithCastIfNeed(srcAddr, srcReg1, maskFull, i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::Max(maxReg, maxReg, srcReg, maskFull);
            AscendC::Reg::Max(maxReg1, maxReg1, srcReg1, maskFull);
        }
        AscendC::Reg::ReduceMax(maxReg, maxReg, maskFull);
        AscendC::Reg::ReduceMax(maxReg1, maxReg1, maskFull);
        AscendC::Reg::Duplicate(maxReg, maxReg, maskFull);
        AscendC::Reg::Duplicate(maxReg1, maxReg1, maskFull);
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            LoadWithCastIfNeed(srcAddr, srcReg, maskFull, i * rDimAlign + j * oneRepeatSize);
            LoadWithCastIfNeed(srcAddr, srcReg1, maskFull, i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::ExpSub(expReg, srcReg, maxReg, maskFull);
            AscendC::Reg::ExpSub(expReg1, srcReg1, maxReg1, maskFull);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize, expReg, maskFull);
            AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign, expReg1, maskFull);
        }
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     LoadWithCastIfNeed(srcAddr, srcReg, maskTail, i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     LoadWithCastIfNeed(srcAddr, srcReg1, maskTail, i * rDimAlign + repeatTimesMain * oneRepeatSize + halfA * rDimAlign);
        //     AscendC::Reg::ExpSub(expReg, srcReg, maxReg, maskTail);
        //     AscendC::Reg::ExpSub(expReg1, srcReg1, maxReg1, maskTail);
        //     AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize, expReg, maskTail); 
        //     AscendC::Reg::StoreAlign<float>(expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize + halfA * rDimAlign, expReg1, maskTail); 
        // }
    }
    mem_bar(VST_VLD);
    for (uint32_t i = 0; i < halfA; i++) {
        AscendC::Reg::Duplicate(sumReg, 0.0, maskFull);
        AscendC::Reg::Duplicate(sumReg1, 0.0, maskFull);
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     AscendC::Reg::LoadAlign(srcReg, expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     AscendC::Reg::LoadAlign(srcReg1, expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize + halfA * rDimAlign);
        //     AscendC::Reg::Add<float>(srcReg, sumReg, srcReg, maskTail);
        //     AscendC::Reg::Add<float>(srcReg1, sumReg1, srcReg1, maskTail);
        //     AscendC::Reg::Move(sumReg, srcReg, maskTail);
        //     AscendC::Reg::Move(sumReg1, srcReg1, maskTail);
        // }
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            AscendC::Reg::LoadAlign(srcReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::LoadAlign(srcReg1, expAddr + i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::Add<float>(sumReg, sumReg, srcReg, maskFull);
            AscendC::Reg::Add<float>(sumReg1, sumReg1, srcReg1, maskFull);
        }
        AscendC::Reg::ReduceSum(sumReg, sumReg, maskFull);
        AscendC::Reg::ReduceSum(sumReg1, sumReg1, maskFull);
        AscendC::Reg::Duplicate(sumReg, sumReg, maskFull);
        AscendC::Reg::Duplicate(sumReg1, sumReg1, maskFull);
        for (uint16_t j = 0; j < repeatTimesMain; j++) {
            AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + j * oneRepeatSize);
            AscendC::Reg::LoadAlign(maxReg1, expAddr + i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
            AscendC::Reg::Div(divReg, maxReg, sumReg, maskFull);
            AscendC::Reg::Div(divReg1, maxReg1, sumReg1, maskFull);
            StoreWithCastIfNeed(dstAddr, divReg, maskFull, i * rDimAlign + j * oneRepeatSize);
            StoreWithCastIfNeed(dstAddr, divReg1, maskFull, i * rDimAlign + j * oneRepeatSize + halfA * rDimAlign);
        }
        // for (uint16_t j = 0; j < hasTail; j ++) {
        //     AscendC::Reg::LoadAlign(maxReg, expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     AscendC::Reg::LoadAlign(maxReg1, expAddr + i * rDimAlign + repeatTimesMain * oneRepeatSize + halfA * rDimAlign);
        //     AscendC::Reg::Div(divReg, maxReg, sumReg, maskTail);
        //     AscendC::Reg::Div(divReg1, maxReg1, sumReg1, maskTail);
        //     StoreWithCastIfNeed(dstAddr, divReg, maskTail, i * rDimAlign + repeatTimesMain * oneRepeatSize);
        //     StoreWithCastIfNeed(dstAddr, divReg1, maskTail, i * rDimAlign + repeatTimesMain * oneRepeatSize + halfA * rDimAlign);
        // }
    }
}


template <typename T>
__aicore__ inline void CustomSoftmax0(const AscendC::LocalTensor<T>& dstTensor, const AscendC::LocalTensor<T>& srcTensor,
    const AscendC::LocalTensor<float>& expTensor, const AscendC::LocalTensor<float>& maxTensor, 
    const AscendC::LocalTensor<float>& sumTensor, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(srcTensor.GetPhyAddr());
    __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(dstTensor.GetPhyAddr());
    __ubuf__ float* expAddr = reinterpret_cast<__ubuf__ float*>(expTensor.GetPhyAddr());
    __ubuf__ float* maxAddr = reinterpret_cast<__ubuf__ float*>(maxTensor.GetPhyAddr());
    __ubuf__ float* sumAddr = reinterpret_cast<__ubuf__ float*>(sumTensor.GetPhyAddr());

    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    uint16_t repeatTimes = AscendC::CeilDivision(rDim, oneRepeatSize);

    CustomSoftmaxVF0(yAddr, xAddr, expAddr, maxAddr, sumAddr, aDim, rDim, rDimAlign);
}

template <typename T>
__aicore__ inline void CustomSoftmax2(const AscendC::LocalTensor<T>& dstTensor, const AscendC::LocalTensor<T>& srcTensor,
    const AscendC::LocalTensor<float>& expTensor, const AscendC::LocalTensor<float>& maxTensor, 
    const AscendC::LocalTensor<float>& sumTensor, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(srcTensor.GetPhyAddr());
    __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(dstTensor.GetPhyAddr());
    __ubuf__ float* expAddr = reinterpret_cast<__ubuf__ float*>(expTensor.GetPhyAddr());
    __ubuf__ float* maxAddr = reinterpret_cast<__ubuf__ float*>(maxTensor.GetPhyAddr());
    __ubuf__ float* sumAddr = reinterpret_cast<__ubuf__ float*>(sumTensor.GetPhyAddr());

    constexpr uint32_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
    uint16_t repeatTimes = AscendC::CeilDivision(rDim, oneRepeatSize);

    CustomSoftmaxVF2(yAddr, xAddr, expAddr, maxAddr, sumAddr, aDim, rDim, rDimAlign);
}

template <typename T>
__aicore__ inline void CustomSoftmax1(const AscendC::LocalTensor<T>& dstTensor, const AscendC::LocalTensor<T>& srcTensor,
    const AscendC::LocalTensor<float>& expTensor, const AscendC::LocalTensor<float>& maxTensor, 
    const AscendC::LocalTensor<float>& sumTensor, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(srcTensor.GetPhyAddr());
    __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(dstTensor.GetPhyAddr());
    __ubuf__ float* expAddr = reinterpret_cast<__ubuf__ float*>(expTensor.GetPhyAddr());
    __ubuf__ float* maxAddr = reinterpret_cast<__ubuf__ float*>(maxTensor.GetPhyAddr());
    __ubuf__ float* sumAddr = reinterpret_cast<__ubuf__ float*>(sumTensor.GetPhyAddr());

    uint16_t tail = rDim % ( 256 / sizeof(float));
    uint16_t repeatTimesMain = rDim / (256 / sizeof(float));
    uint16_t hasTail = static_cast<uint16_t>(tail != 0);

    CustomSoftmaxVF1(yAddr, xAddr, expAddr, maxAddr, sumAddr, aDim, rDim, rDimAlign, tail, repeatTimesMain, hasTail);
}

template <typename T>
__aicore__ inline void CustomSoftmax3(const AscendC::LocalTensor<T>& dstTensor, const AscendC::LocalTensor<T>& srcTensor,
    const AscendC::LocalTensor<float>& expTensor, const AscendC::LocalTensor<float>& maxTensor, 
    const AscendC::LocalTensor<float>& sumTensor, uint32_t aDim, uint32_t rDim, uint32_t rDimAlign)
{
    __ubuf__ T* xAddr = reinterpret_cast<__ubuf__ T*>(srcTensor.GetPhyAddr());
    __ubuf__ T* yAddr = reinterpret_cast<__ubuf__ T*>(dstTensor.GetPhyAddr());
    __ubuf__ float* expAddr = reinterpret_cast<__ubuf__ float*>(expTensor.GetPhyAddr());
    __ubuf__ float* maxAddr = reinterpret_cast<__ubuf__ float*>(maxTensor.GetPhyAddr());
    __ubuf__ float* sumAddr = reinterpret_cast<__ubuf__ float*>(sumTensor.GetPhyAddr());

    uint16_t tail = rDim % ( 256 / sizeof(float));
    uint16_t repeatTimesMain = rDim / (256 / sizeof(float));
    uint16_t hasTail = static_cast<uint16_t>(tail != 0);

    // AscendC::printf("Tail is : %d", tail);
    // AscendC::printf("repeatTimesMain is : %d", repeatTimesMain);
    // AscendC::printf("hasTail is %d: ", hasTail);
    

    CustomSoftmaxVF3(yAddr, xAddr, expAddr, maxAddr, sumAddr, aDim, rDim, rDimAlign, tail, repeatTimesMain, hasTail);
}

// ======================= 核函数 =========================
template <typename T>
__global__ __vector__ void softmax_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, Custom::SoftmaxTiling<T> tiling)
{
    // ReduceSum必须使用TPipe，预计下个软件版本解耦
    AscendC::TPipe tPipe;
    AscendC::InitSocState();

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    xGm.SetGlobalBuffer((__gm__ T *)x + AscendC::GetBlockIdx() * tiling.singleCoreLength, tiling.singleCoreLength);
    yGm.SetGlobalBuffer((__gm__ T *)y + AscendC::GetBlockIdx() * tiling.singleCoreLength, tiling.singleCoreLength);

    // use local memory allocator to simplify memor allocation
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;

    // alloc localTensor
    AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T>(tiling.singleCoreAlignLength);
    AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T>(tiling.singleCoreAlignLength);
    AscendC::LocalTensor<float> expTensor = ubAllocator.Alloc<float>(tiling.singleCoreAlignLength);
    AscendC::LocalTensor<float> maxTensor = ubAllocator.Alloc<float>(8 * tiling.aDim);
    AscendC::LocalTensor<float> sumTensor = ubAllocator.Alloc<float>(8 * tiling.aDim);

    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    for (uint32_t i = 0; i < tiling.loopCount; i++) {
        // dependency of PIPE_MTE3 & PIPE_MTE2 caused by xLocal/yLocal between 2 sequential loops
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        for (uint32_t j = 0; j < tiling.aDim; j++) {
            AscendC::DataCopyPad(xLocal[j * tiling.rDimAlign], xGm[i * tiling.singleCoreLength + j * tiling.rDim], 
                {1, static_cast<uint16_t>(tiling.rDim * sizeof(T)), 0, 0, 0},
                {true, 0, static_cast<uint8_t>(tiling.rDimAlign - tiling.rDim), 0});
        }
        // dependency of PIPE_MTE2 & PIPE_V caused by xLocal/yLocal in one single loop
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        // call custom softmax API
        CustomSoftmax2(yLocal, xLocal, expTensor, maxTensor, sumTensor, tiling.aDim, tiling.rDim, tiling.rDimAlign);
        // dependency of PIPE_V & PIPE_MTE3 caused by yLocal in one single loop
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        for (uint32_t j = 0; j < tiling.aDim; j++) {
            AscendC::DataCopyPad(yGm[i * tiling.singleCoreLength + j * tiling.rDim], yLocal[j * tiling.rDimAlign], 
                {1, static_cast<uint16_t>(tiling.rDim * sizeof(T)), 0, 0, 0});
        }
        // dependency of PIPE_MTE3 & PIPE_MTE2 caused by yLocal between 2 sequential loops
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t blockLen = 128 * 128;
    uint32_t numBlocks = 1;

    constexpr uint32_t kDim = 1;
    constexpr uint32_t kHeight = 128;
    constexpr uint32_t kWidth = 128;
    constexpr uint32_t kTotalLen = kHeight * kWidth;

    constexpr uint32_t singleCoreHeight = kHeight;

    uint32_t loopCount = kHeight / singleCoreHeight;
    uint32_t singleCoreLength = singleCoreHeight * kWidth;
    uint32_t alignUnit = 32 / 4;
    uint32_t widthAlign = (kWidth + alignUnit - 1) / alignUnit * alignUnit;
    uint32_t singleCoreAlignLength = singleCoreHeight * widthAlign;
    Custom::SoftmaxTiling<float> tiling = {kHeight, kWidth, widthAlign, loopCount, singleCoreLength, singleCoreAlignLength};


    size_t inputByteSize = numBlocks * blockLen * sizeof(float);
    size_t outputByteSize = numBlocks * blockLen * sizeof(float);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* inputHost = nullptr;
    uint8_t* inputDevice = nullptr;
    aclrtMallocHost((void**)(&inputHost), inputByteSize);
    aclrtMalloc((void**)(&inputDevice), inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input.bin", inputByteSize, inputHost, inputByteSize);
    aclrtMemcpy(inputDevice, inputByteSize, inputHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;
    aclrtMallocHost((void**)(&outputHost), outputByteSize);
    aclrtMalloc((void**)(&outputDevice), outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    softmax_custom<float><<<numBlocks, nullptr, stream>>>(inputDevice, outputDevice, tiling);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outputHost, outputByteSize, outputDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, outputByteSize);

    aclrtFree(inputDevice);
    aclrtFreeHost(inputHost);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("operator completed.\n");
    return 0;
}