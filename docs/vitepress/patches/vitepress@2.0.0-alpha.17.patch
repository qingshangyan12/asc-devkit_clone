+function truncateAroundMatch(text: string, terms: string[]): string {
+  if (!text) return ''
+  if (!terms.length) return text.length > 120 ? text.slice(0, 120).trimEnd() + '...' : text
+  const maxLen = 200
+  const half = Math.floor(maxLen / 2)
+  let bestIdx = text.length
+  let bestLen = 0
+  for (const term of terms) {
+    const idx = text.toLowerCase().indexOf(term.toLowerCase())
+    if (idx >= 0 && idx < bestIdx) {
+      bestIdx = idx
+      bestLen = term.length
+    }
+  }
+  if (bestIdx >= text.length) {
+    return text.length > maxLen ? text.slice(0, maxLen).trimEnd() + '...' : text
+  }
+  let start = Math.max(0, bestIdx - half)
+  let end = Math.min(text.length, bestIdx + bestLen + half)
+  if (start > 0) {
+    const space = text.indexOf(' ', start)
+    if (space >= 0 && space < bestIdx) start = space + 1
+  }
+  if (end < text.length) {
+    const space = text.lastIndexOf(' ', end)
+    if (space > bestIdx + bestLen) end = space
+  }
+  let result = ''
+  if (start > 0) result += '...'
+  result += text.slice(start, end).trim()
+  if (end < text.length) result += '...'
+  return result
+}
