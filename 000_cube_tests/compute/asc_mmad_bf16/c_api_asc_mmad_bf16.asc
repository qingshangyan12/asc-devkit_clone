/* !
 * \file c_api_asc_mmad_bf16.asc
 * \brief 测试 asc_mmad (bf16×bf16→float): bfloat16 矩阵乘加 (dav-3510)
 *
 * 验证方式: asc_mmad(API Under Test) bf16→float MMAD → L0C→GM,
 *          与 CPU bf16 矩阵乘结果比较
 * 覆盖场景: 单核, 单分形 (16×16 bfloat16)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE, TOTAL_B = K_SIZE * N_SIZE;
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;

// Helper: bfloat16 → float
static inline float bf16_to_f32(uint16_t bf) {
    uint32_t bits = static_cast<uint32_t>(bf) << 16;
    return *reinterpret_cast<float*>(&bits);
}
// Helper: float → bfloat16
static inline uint16_t f32_to_bf16(float f) {
    uint32_t bits = *reinterpret_cast<uint32_t*>(&f);
    return static_cast<uint16_t>(bits >> 16);
}
// Host-side bfloat16 as uint16_t
typedef uint16_t bf16_h;

/* --------------------------------------------------------------------------
 * Kernel: asc_mmad (bfloat16 × bfloat16 → float)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_mmad_bf16(
    __gm__ bfloat16_t* gm_a, __gm__ bfloat16_t* gm_b, __gm__ float* gm_c)
{
    asc_init();
    __cbuf__ bfloat16_t l1_a[TOTAL_A], l1_b[TOTAL_B];
    __ca__ bfloat16_t l0a[TOTAL_A];
    __cb__ bfloat16_t l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    // 1. GM→L1→L0A/L0B (bfloat16 类型)
    //    bfloat16: 16bit, fractal: 16x16, k_step=1(32B)
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 2. API UNDER TEST: asc_mmad (bf16 → float)
    //    void asc_mmad(__cc__ float* c, __ca__ bfloat16_t* a, __cb__ bfloat16_t* b,
    //        uint16_t left_height, uint16_t n_dim, uint16_t right_width,
    //        uint8_t unit_flag, bool disable_gemv, bool c_matrix_source, bool c_matrix_init_val)
    asc_mmad(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
             0, false, false, true);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

    // 3. L0C→GM
    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, M_SIZE, 0,
        0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false, false);
}

std::vector<float> run_kernel(std::vector<bf16_h> &a, std::vector<bf16_h> &b)
{
    size_t ba = a.size()*2, bb = b.size()*2, bc = TOTAL_C*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    bfloat16_t *aD = nullptr, *bD = nullptr; float *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_mmad_bf16<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<bf16_h> a(TOTAL_A), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = f32_to_bf16((i + k) * 0.15f);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = f32_to_bf16((k + j) * 0.08f);

    std::vector<float> output = run_kernel(a, b);

    // Golden: CPU bf16 MM (使用 bf16 精度模拟)
    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k) {
                float av = bf16_to_f32(a[i*K_SIZE+k]);
                float bv = bf16_to_f32(b[k*N_SIZE+j]);
                sum += av * bv;
            }
            golden[i*N_SIZE+j] = sum;
        }

    float mx = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i] - golden[i]);
        if (e > mx) mx = e;
    }
    bool ok = mx < 0.02f;  // bf16 精度只有 7-8 bit 尾数, 放宽 tolerance
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_mmad_bf16 max_error=" << mx << std::endl;
    std::ofstream f("asc_mmad_bf16.csv");
    f << "result\n" << (ok?"PASS":"FAIL") << ",max_error=" << mx << "\n"; f.close();
    return ok?0:1;
}
