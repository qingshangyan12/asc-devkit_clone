/* !
 * \file c_api_asc_set_l0c2gm_config.asc
 * \brief 测试 asc_set_l0c2gm_config: 设置 L0C→GM 的随路量化参数 (dav-3510)
 *
 * 验证方式: MMAD→set_l0c2gm_config(F322F16)→L0C→GM(quant_pre=F322F16),
 *          验证输出为 float→half 量化后的值
 * 覆盖场景: 单核, 单分形 (16×16 half)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE, TOTAL_B = K_SIZE * N_SIZE;
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;

/* --------------------------------------------------------------------------
 * Kernel: asc_set_l0c2gm_config + L0C→GM with F322F16 quantization
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_set_l0c2gm_config(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ half* gm_c)
{
    asc_init();
    __cbuf__ half l1_a[TOTAL_A], l1_b[TOTAL_B];
    __ca__ half l0a[TOTAL_A];
    __cb__ half l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    // 1. GM→L1→L0A/L0B
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 2. MMAD
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, false, false, true);

    // 3. API UNDER TEST: asc_set_l0c2gm_config
    //    void asc_set_l0c2gm_config(uint64_t relu_pre, uint64_t quant_pre, bool enable_unit_flag)
    //    quant_pre=F322F16: float→half 量化
    constexpr uint64_t relu_pre = 0;
    constexpr uint64_t quant_pre = F322F16;  // float → half
    constexpr bool enable_unit_flag = false;
    asc_set_l0c2gm_config(relu_pre, quant_pre, enable_unit_flag);

    // 4. L0C→GM with the configured quantization
    asc_copy_l0c2gm_sync(
        (__gm__ half*)gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, 1, 0,
        0, 0, F322F16, 0, false, false, 0, 0, false, 0, false, false, false, false);
}

/* --------------------------------------------------------------------------
 * Host 侧调用
 * -------------------------------------------------------------------------- */
std::vector<float> run_kernel(std::vector<half> &a, std::vector<half> &b)
{
    size_t ba = a.size()*2, bb = b.size()*2, bc = TOTAL_C*2;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    half *aD = nullptr, *bD = nullptr, *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_set_l0c2gm_config<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    // 读回为 half, 转为 float 比较
    std::vector<float> c(TOTAL_C);
    for (uint32_t i = 0; i < TOTAL_C; ++i) c[i] = float(((half*)cH)[i]);
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

// Helper: float value printer (handles half/bf16/int8 conversion)
template<typename T>
void print_val(T val, std::ostream& os) {
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else if constexpr (std::is_same_v<T, bfloat16_t>) {
        uint16_t raw; memcpy(&raw, &val, 2);
        uint32_t bits = static_cast<uint32_t>(raw) << 16;
        os << *reinterpret_cast<float*>(&bits);
    } else {
        os << val;
    }
}

// Save a 2D matrix to CSV
template<typename T>
void save_matrix_csv(const std::vector<T>& mat, uint32_t rows, uint32_t cols,
                     const std::string& fname) {
    std::ofstream f(fname);
    f << "row,col,value\n";
    for (uint32_t r = 0; r < rows; ++r)
        for (uint32_t c = 0; c < cols; ++c) {
            f << r << "," << c << ",";
            print_val(mat[r*cols + c], f);
            f << "\n";
        }
    f.close();
    std::cout << "  [CSV] " << fname << " (" << rows << "x" << cols << ")\n";
}

// Save C output + expected  
template<typename T>
void save_c_csv(const std::vector<T>& output, const std::vector<T>& expected,
                uint32_t rows, uint32_t cols, const std::string& fname) {
    std::ofstream f(fname);
    f << "row,col,output,expected\n";
    for (uint32_t r = 0; r < rows; ++r)
        for (uint32_t c = 0; c < cols; ++c) {
            f << r << "," << c << ",";
            print_val(output[r*cols + c], f);
            f << ",";
            print_val(expected[r*cols + c], f);
            f << "\n";
        }
    f.close();
    std::cout << "  [CSV] " << fname << " (" << rows << "x" << cols << ")\n";
}

int32_t main(int32_t argc, char *argv[])
{
    // A: 递增序列, B: 全1 → C[i][j] = sum(A[i][k])
    std::vector<half> a(TOTAL_A), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = half((i + k) * 0.1f);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = half(1.0f);

    save_matrix_csv(a, M_SIZE, K_SIZE, "set_l0c2gm_config_a.csv");
    save_matrix_csv(b, K_SIZE, N_SIZE, "set_l0c2gm_config_b.csv");

    std::cout << "A[0:2]=";
    for (int i=0;i<3;++i) { print_val(a[i], std::cout); std::cout << " "; }
    std::cout << "\nB[0:2]=";
    for (int i=0;i<3;++i) { print_val(b[i], std::cout); std::cout << " "; }
    std::cout << std::endl;

    std::vector<float> output = run_kernel(a, b);

    // Golden: CPU float MM → 转为 half (模拟 F322F16 量化)
    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += float(a[i*K_SIZE+k]) * float(b[k*N_SIZE+j]);
            golden[i*N_SIZE+j] = float(half(sum));  // float→half→float 模拟量化
        }

    save_c_csv(output, golden, M_SIZE, N_SIZE, "set_l0c2gm_config_c.csv");

    std::cout << "output[0:2]=";
    for (int i=0;i<3;++i) { std::cout << output[i] << " "; }
    std::cout << "\ngolden[0:2]=";
    for (int i=0;i<3;++i) { std::cout << golden[i] << " "; }
    std::cout << std::endl;

    float mx = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i] - golden[i]);
        if (e > mx) mx = e;
    }
    bool ok = mx < 0.02f;  // half 精度 tolerance
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_set_l0c2gm_config max_error=" << mx << std::endl;
    std::ofstream f("asc_set_l0c2gm_config.csv");
    f << "result\n" << (ok?"PASS":"FAIL") << ",max_error=" << mx << "\n"; f.close();
    return ok?0:1;
}
