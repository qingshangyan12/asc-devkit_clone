/* !
 * \file c_api_asc_mmad_int8.asc
 * \brief 测试 asc_mmad (int8×int8→int32): int8 矩阵乘加 (dav-3510)
 *
 * 验证方式: asc_mmad(API Under Test) int8→int32 MMAD → L0C→GM,
 *          与 CPU int8 矩阵乘结果比较
 * 覆盖场景: 单核, 单分形 (16×16 int8)
 */

#include <cstdint>

// Workaround: CANN 9.0.0-beta.2 bisheng 缺少以下类型定义
struct fp4x2_e1m2_t { uint8_t v; };
struct fp4x2_e2m1_t { uint8_t v; };
struct fp8_e4m3fn_t { uint8_t v; };
struct fp8_e5m2_t   { uint8_t v; };
struct fp8_e8m0_t   { uint8_t v; };
struct int4b_t      { uint8_t v; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include <cstring>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t FRACTAL_K = 32;       // int8 L0A: 16×32, L0B: 32×16
constexpr uint32_t FRACTAL_B_COLS = 32;  // B补齐到32列以匹配k_step=1 (32B=32int8)
constexpr uint32_t TOTAL_A = M_SIZE * FRACTAL_K * 2;               // 1024
constexpr uint32_t TOTAL_B = FRACTAL_K * FRACTAL_B_COLS * 2;       // 2048
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE * 2;                  // 512

/* --------------------------------------------------------------------------
 * Kernel: asc_mmad (int8 × int8 → int32)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_mmad_int8(
    __gm__ int8_t* gm_a, __gm__ int8_t* gm_b, __gm__ int32_t* gm_c)
{
    asc_init();
    __cbuf__ int8_t l1_a[TOTAL_A], l1_b[TOTAL_B];
    __ca__ int8_t l0a[TOTAL_A];
    __cb__ int8_t l0b[TOTAL_B];
    __cc__ int32_t l0c[TOTAL_C];

    // 1. GM→L1→L0A/L0B
    //    A: 16×32 fractal, k_step=1=32B=32int8
    //    B: 32×32 (补齐到32列), m_step=2 (32K行/16), k_step=1
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 1, 0, 0);
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 2/*32行*/, 1, 0, 0);
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 2, 1, 0, 0);

    // 2. API UNDER TEST: asc_mmad (int8 → int32)
    //    void asc_mmad(__cc__ int32_t* c, __ca__ int8_t* a, __cb__ int8_t* b,
    //        uint16_t left_height, uint16_t n_dim, uint16_t right_width,
    //        uint8_t unit_flag, bool disable_gemv, bool c_matrix_source, bool c_matrix_init_val)
    asc_mmad(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
             0, false, false, true);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

    // 3. L0C→GM (int32 输出, C0_Size=16*4=64B)
    //    C0_Size = 16*sizeof(int32_t) = 64B, loop_src_stride=1
    asc_copy_l0c2gm_sync(
        gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, 1, 0,
        0, 0, 0, 0, false, false, 0, 0, false, 0, false, false, false, false);
}

std::vector<int32_t> run_kernel(std::vector<int8_t> &a, std::vector<int8_t> &b)
{
    size_t ba = a.size(), bb = b.size(), bc = TOTAL_C*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    int8_t *aD = nullptr, *bD = nullptr; int32_t *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_mmad_int8<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> c((int32_t*)cH, (int32_t*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

// Helper: float value printer (handles half/bf16/int8 conversion)
template<typename T>
void print_val(T val, std::ostream& os) {
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else if constexpr (std::is_same_v<T, int8_t> || std::is_same_v<T, uint8_t>) {
        os << static_cast<int>(val);
    } else if constexpr (std::is_same_v<T, bfloat16_t>) {
        uint16_t raw; memcpy(&raw, &val, 2);
        uint32_t bits = static_cast<uint32_t>(raw) << 16;
        os << *reinterpret_cast<float*>(&bits);
    } else {
        os << val;
    }
}

// Save all matrices and result to a single CSV
void save_all_csv(const std::string& apiname,
                  const std::vector<int8_t>& a, uint32_t a_rows, uint32_t a_cols,
                  const std::vector<int8_t>& b, uint32_t b_rows, uint32_t b_cols,
                  const std::vector<int32_t>& output, const std::vector<int32_t>& expected,
                  uint32_t c_rows, uint32_t c_cols,
                  bool passed, int32_t max_diff)
{
    std::string fname = apiname + "_result.csv";
    std::ofstream f(fname);
    f << "# API: " << apiname << "\n";
    f << "# A matrix (MxK): " << a_rows << "x" << a_cols << "\n";
    f << "row,col,value\n";
    for (uint32_t r = 0; r < a_rows; ++r)
        for (uint32_t c = 0; c < a_cols; ++c) {
            f << r << "," << c << "," << static_cast<int>(a[r*a_cols + c]) << "\n";
        }
    f << "# B matrix (KxN): " << b_rows << "x" << b_cols << "\n";
    f << "row,col,value\n";
    for (uint32_t r = 0; r < b_rows; ++r)
        for (uint32_t c = 0; c < b_cols; ++c) {
            f << r << "," << c << "," << static_cast<int>(b[r*b_cols + c]) << "\n";
        }
    f << "# C matrix (MxN): output vs expected\n";
    f << "row,col,output,expected\n";
    for (uint32_t r = 0; r < c_rows; ++r)
        for (uint32_t c = 0; c < c_cols; ++c) {
            f << r << "," << c << ","
              << output[r*c_cols + c] << ","
              << expected[r*c_cols + c] << "\n";
        }
    f << "# Result: " << (passed?"PASS":"FAIL") << " (max_diff=" << max_diff << ")\n";
    f.close();
    std::cout << "  [CSV] " << fname << "\n";
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<int8_t> a(TOTAL_A), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*FRACTAL_K + k] = static_cast<int8_t>((i + k) % 7 - 3);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*FRACTAL_B_COLS + j] = static_cast<int8_t>((k + j) % 5 - 2);

    std::cout << "A[0:2]=";
    for (int i=0;i<3;++i) { print_val(a[i], std::cout); std::cout << " "; }
    std::cout << "\nB[0:2]=";
    for (int i=0;i<3;++i) { print_val(b[i], std::cout); std::cout << " "; }
    std::cout << std::endl;

    std::vector<int32_t> output = run_kernel(a, b);

    // Golden: CPU int32 MM
    std::vector<int32_t> golden(TOTAL_C, 0);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            int32_t sum = 0;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += static_cast<int32_t>(a[i*FRACTAL_K+k]) * static_cast<int32_t>(b[k*FRACTAL_B_COLS+j]);
            golden[i*N_SIZE+j] = sum;
        }

    std::cout << "output[0:2]=";
    for (int i=0;i<3;++i) { std::cout << output[i] << " "; }
    std::cout << "\ngolden[0:2]=";
    for (int i=0;i<3;++i) { std::cout << golden[i] << " "; }
    std::cout << std::endl;

    int32_t maxDiff = 0;
    for (size_t i = 0; i < golden.size(); ++i) {
        int32_t d = std::abs(output[i] - golden[i]);
        if (d > maxDiff) maxDiff = d;
    }
    bool ok = maxDiff == 0;
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_mmad_int8 max_diff=" << maxDiff << std::endl;
    save_all_csv("asc_mmad_int8", a, M_SIZE, FRACTAL_K, b, FRACTAL_K, FRACTAL_B_COLS,
                 output, golden, M_SIZE, N_SIZE, ok, maxDiff);
    return ok?0:1;
}
