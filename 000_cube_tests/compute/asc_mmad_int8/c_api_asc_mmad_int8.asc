/* !
 * \file c_api_asc_mmad_int8.asc
 * \brief 测试 asc_mmad (int8×int8→int32): int8 矩阵乘加 (dav-3510)
 *
 * 验证方式: asc_mmad(API Under Test) int8→int32 MMAD → L0C→GM,
 *          与 CPU int8 矩阵乘结果比较
 * 覆盖场景: 单核, 单分形 (16×16 int8)
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE, TOTAL_B = K_SIZE * N_SIZE;
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;

/* --------------------------------------------------------------------------
 * Kernel: asc_mmad (int8 × int8 → int32)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_mmad_int8(
    __gm__ int8_t* gm_a, __gm__ int8_t* gm_b, __gm__ int32_t* gm_c)
{
    asc_init();
    __cbuf__ int8_t l1_a[TOTAL_A], l1_b[TOTAL_B];
    __ca__ int8_t l0a[TOTAL_A];
    __cb__ int8_t l0b[TOTAL_B];
    __cc__ int32_t l0c[TOTAL_C];

    // 1. GM→L1→L0A/L0B (int8 类型, k_step=1 对应 32B=32 个 int8)
    //    int8: 8bit, 分形 16x32(L0A) 和 32x16(L0B)
    //    一个 16x16 分形占用: 256B = 8*32B, 所以 k_step=8
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 8/*256B=8*32B*/, 0, 0);
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 8, 0, 0);
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 8, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 8, 0, 0);

    // 2. API UNDER TEST: asc_mmad (int8 → int32)
    //    void asc_mmad(__cc__ int32_t* c, __ca__ int8_t* a, __cb__ int8_t* b,
    //        uint16_t left_height, uint16_t n_dim, uint16_t right_width,
    //        uint8_t unit_flag, bool disable_gemv, bool c_matrix_source, bool c_matrix_init_val)
    asc_mmad(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
             0, false, false, true);
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

    // 3. L0C→GM (int32 输出, C0_Size=16*4=64B)
    //    n_size=1, m_size=1 单分形
    constexpr uint16_t c0_size = 16;  // C0_Size/4 = 64B/4 = 16 int32
    asc_copy_l0c2gm_sync(
        gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, c0_size, 0,
        0, 0, 0, 0, false, true, 0, 0, false, 0, false, false, false, false);
}

std::vector<int32_t> run_kernel(std::vector<int8_t> &a, std::vector<int8_t> &b)
{
    size_t ba = a.size(), bb = b.size(), bc = TOTAL_C*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    int8_t *aD = nullptr, *bD = nullptr; int32_t *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_mmad_int8<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> c((int32_t*)cH, (int32_t*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<int8_t> a(TOTAL_A), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = static_cast<int8_t>((i + k) % 7 - 3);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = static_cast<int8_t>((k + j) % 5 - 2);

    std::vector<int32_t> output = run_kernel(a, b);

    // Golden: CPU int32 MM
    std::vector<int32_t> golden(TOTAL_C, 0);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            int32_t sum = 0;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += static_cast<int32_t>(a[i*K_SIZE+k]) * static_cast<int32_t>(b[k*N_SIZE+j]);
            golden[i*N_SIZE+j] = sum;
        }

    int32_t maxDiff = 0;
    for (size_t i = 0; i < golden.size(); ++i) {
        int32_t d = std::abs(output[i] - golden[i]);
        if (d > maxDiff) maxDiff = d;
    }
    bool ok = maxDiff == 0;
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_mmad_int8 max_diff=" << maxDiff << std::endl;
    std::ofstream f("asc_mmad_int8.csv");
    f << "result\n" << (ok?"PASS":"FAIL") << ",max_diff=" << maxDiff << "\n"; f.close();
    return ok?0:1;
}
