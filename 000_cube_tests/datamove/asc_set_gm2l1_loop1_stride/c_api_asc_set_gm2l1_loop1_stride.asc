/* !
 * \file c_api_asc_set_gm2l1_loop1_stride.asc
 * \brief 测试 asc_set_gm2l1_loop1_stride: 设置 GM→L1 搬运的内循环步长 (dav-3510)
 *
 * 验证方式: asc_set_gm2l1_loop1_stride(API)→GM→L1→L0A→MMAD→L0C→GM,
 *          通过 MMAD 间接验证双块数据的分别搬运
 * 覆盖场景: 单核, 单分形 (16×16 half), 两块数据源中分离、目标中连续
 */

#include <cstdint>

// Workaround: CANN 9.0.0-beta.2 bisheng 缺少以下类型定义
struct fp4x2_e1m2_t { uint8_t v; };
struct fp4x2_e2m1_t { uint8_t v; };
struct fp8_e4m3fn_t { uint8_t v; };
struct fp8_e5m2_t   { uint8_t v; };
struct fp8_e8m0_t   { uint8_t v; };
struct int4b_t      { uint8_t v; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE, TOTAL_B = K_SIZE * N_SIZE, TOTAL_C = M_SIZE * N_SIZE;

/* --------------------------------------------------------------------------
 * Kernel: set loop1_stride → GM→L1(双块)→L0A→MMAD→L0C→GM
 * 源中有两块数据, stride=0(连续), 目标中 dst_stride=0(连续)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_set_gm2l1_loop1_stride(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();
    __cbuf__ half l1_a[TOTAL_A], l1_b[TOTAL_B];
    __ca__ half l0a[TOTAL_A];
    __cb__ half l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    // 1. API UNDER TEST: asc_set_gm2l1_loop_size + loop1_stride
    //    void asc_set_gm2l1_loop_size(uint64_t loop1, uint64_t loop2)
    //    void asc_set_gm2l1_loop1_stride(uint64_t src_stride, uint64_t dst_stride)
    asc_set_gm2l1_loop_size(2/*两块*/, 1);
    asc_set_gm2l1_loop1_stride(8/*src: 块间隔=8*32B=256B*/, 8/*dst: 块间隔=256B*/);

    // 2. GM→L1: 每块 256B=8*32B, 两块共 512B
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 8, 0, 0);
    asc_set_gm2l1_loop_size(1, 1);

    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);

    // 3. L1→L0A(第一块), L1→L0B
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 4. MMAD
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, false, false, true);

    // 5. L0C→GM
    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, 1, 0,
        0, 0, 0, 0, false, false, 0, 0, false, 0, false, false, false, false);
}

std::vector<float> run_kernel(std::vector<half> &a, std::vector<half> &b)
{
    size_t ba = a.size()*2, bb = b.size()*2, bc = TOTAL_C*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    half *aD = nullptr, *bD = nullptr; float *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_set_gm2l1_loop1_stride<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

template<typename T>
void print_val(T val, std::ostream& os) {
    if constexpr (std::is_same_v<T, half>) os << static_cast<float>(val);
    else os << val;
}

void save_all_csv(const std::string& apiname,
                  const std::vector<half>& a, uint32_t a_rows, uint32_t a_cols,
                  const std::vector<half>& b, uint32_t b_rows, uint32_t b_cols,
                  const std::vector<float>& output, const std::vector<float>& expected,
                  uint32_t c_rows, uint32_t c_cols,
                  bool passed, float max_error)
{
    std::string fname = apiname + "_result.csv";
    std::ofstream f(fname);
    f << "# API: " << apiname << "\n";
    f << "# Input A matrix (MxK): " << a_rows << "x" << a_cols << "\nrow,col,value\n";
    for (uint32_t r = 0; r < a_rows; ++r)
        for (uint32_t c = 0; c < a_cols; ++c) {
            f << r << "," << c << ",";
            print_val(a[r*a_cols+c], f);
            f << "\n";
        }
    f << "# Input B matrix (KxN): " << b_rows << "x" << b_cols << "\nrow,col,value\n";
    for (uint32_t r = 0; r < b_rows; ++r)
        for (uint32_t c = 0; c < b_cols; ++c) {
            f << r << "," << c << ",";
            print_val(b[r*b_cols+c], f);
            f << "\n";
        }
    f << "# Output C matrix (MxN): output vs expected\nrow,col,output,expected\n";
    for (uint32_t r = 0; r < c_rows; ++r)
        for (uint32_t c = 0; c < c_cols; ++c)
            f << r << "," << c << "," << output[r*c_cols+c] << "," << expected[r*c_cols+c] << "\n";
    f << "# Result: " << (passed?"PASS":"FAIL") << " (max_error=" << max_error << ")\n";
    f.close();
    std::cout << "  [CSV] " << fname << "\n";
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<half> a(TOTAL_A*2), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = half((i + k) * 0.1f);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = half(1.0f);

    std::vector<float> output = run_kernel(a, b);

    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += float(a[i*K_SIZE+k]) * float(b[k*N_SIZE+j]);
            golden[i*N_SIZE+j] = sum;
        }

    float mx = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i] - golden[i]);
        if (e > mx) mx = e;
    }
    bool ok = mx < 0.001f;
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_set_gm2l1_loop1_stride max_error=" << mx << std::endl;
    save_all_csv("asc_set_gm2l1_loop1_stride", a, M_SIZE, K_SIZE, b, K_SIZE, N_SIZE,
                 output, golden, M_SIZE, N_SIZE, ok, mx);
    return ok?0:1;
}
