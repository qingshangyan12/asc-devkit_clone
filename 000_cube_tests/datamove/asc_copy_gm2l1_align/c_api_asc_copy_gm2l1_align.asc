/* !
 * \file c_api_asc_copy_gm2l1_align.asc
 * \brief 测试 asc_copy_gm2l1_align: GM→L1 劈裂搬运 可用性测试 (dav-3510)
 *
 * 验证方式: GM→asc_copy_gm2l1_align_sync(API)→L1→L0A→MMAD→L0C→GM
 *          精度验证通过 MMAD 间接校验
 * 覆盖场景: 单核, 单分形 (16×16 half), n_burst=1,len_burst=16=512B
 */

#include <cstdint>
struct fp4x2_e1m2_t { uint8_t v; fp4x2_e1m2_t()=default; }; struct fp4x2_e2m1_t { uint8_t v; fp4x2_e2m1_t()=default; };
struct fp8_e4m3fn_t { uint8_t v; fp8_e4m3fn_t()=default; }; struct fp8_e5m2_t { uint8_t v; fp8_e5m2_t()=default; };
struct fp8_e8m0_t { uint8_t v; fp8_e8m0_t()=default; }; struct int4b_t { uint8_t v; int4b_t()=default; };
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M=16,K=16,N=16; constexpr uint32_t TA=M*K,TB=K*N,TC=M*N;

__cube__ __global__ __aicore__ void kernel_asc_copy_gm2l1_align(
    __gm__ half* a, __gm__ half* b, __gm__ float* c)
{
    asc_init();
    __cbuf__ half la[TA],lb[TB]; __ca__ half l0a[TA]; __cb__ half l0b[TB]; __cc__ float l0c[TC];

    // API UNDER TEST: asc_copy_gm2l1_align_sync
    asc_copy_gm2l1_align_sync(la, a, 1, 16/*512B*/, 0,0, false,0, 0,0);
    asc_copy_gm2l1_sync(lb,b,0,0,0,1,1,0,0);
    asc_copy_l12l0a_sync(l0a,la,0,0,1,1,0,0);
    asc_copy_l12l0b_sync(l0b,lb,0,0,1,1,0,0);
    asc_mmad_sync(l0c,l0a,l0b,M,K,N,0,false,false,true);
    asc_copy_l0c2gm_sync(c,l0c,N,M,N,1,0,0,0,0,0,false,false,0,0,false,0,false,false,false,false);
}

std::vector<float> run_kernel(std::vector<half>&a,std::vector<half>&b){
    size_t ba=a.size()*2,bb=b.size()*2,bc=TC*4; aclrtStream s=nullptr; uint8_t*ch=nullptr; half*ad=nullptr,*bd=nullptr; float*cd=nullptr;
    aclInit(nullptr);aclrtSetDevice(0);aclrtCreateStream(&s); aclrtMallocHost((void**)&ch,bc);
    aclrtMalloc((void**)&ad,ba,ACL_MEM_MALLOC_HUGE_FIRST); aclrtMalloc((void**)&bd,bb,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cd,bc,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)ad,ba,(uint8_t*)a.data(),ba,ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bd,bb,(uint8_t*)b.data(),bb,ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_copy_gm2l1_align<<<NUM_BLOCKS,nullptr,s>>>(ad,bd,cd); aclrtSynchronizeStream(s);
    aclrtMemcpy(ch,bc,(uint8_t*)cd,bc,ACL_MEMCPY_DEVICE_TO_HOST); std::vector<float> out((float*)ch,(float*)(ch+bc));
    aclrtFree(ad);aclrtFree(bd);aclrtFree(cd);aclrtFreeHost(ch); aclrtDestroyStream(s);aclrtResetDevice(0);aclFinalize(); return out;
}

int32_t main(int32_t argc,char*argv[]){
    std::vector<half> a(TA),b(TB);
    for(uint32_t i=0;i<M;++i)for(uint32_t k=0;k<K;++k)a[i*K+k]=half((i+k)*0.1f);
    for(uint32_t k=0;k<K;++k)for(uint32_t j=0;j<N;++j)b[k*N+j]=half(1.0f);

    std::vector<float> output=run_kernel(a,b);
    std::vector<float> golden(TC,0.0f);
    for(uint32_t i=0;i<M;++i)for(uint32_t j=0;j<N;++j){float s=0;for(uint32_t k=0;k<K;++k)s+=float(a[i*K+k])*float(b[k*N+j]);golden[i*N+j]=s;}

    std::ofstream f("asc_copy_gm2l1_align_result.csv");
    f<<"# API: asc_copy_gm2l1_align\n# GM→L1(align)→MMAD round-trip\nrow,col,output,expected\n";
    for(uint32_t r=0;r<M;++r)for(uint32_t c=0;c<N;++c)f<<r<<","<<c<<","<<output[r*N+c]<<","<<golden[r*N+c]<<"\n";

    float mx=0;for(size_t i=0;i<golden.size();++i){float e=abs(output[i]-golden[i]);if(e>mx)mx=e;}
    bool ok=mx<0.001f;
    std::cout<<(ok?"[PASS]":"[FAIL]")<<" asc_copy_gm2l1_align max_error="<<mx<<std::endl;
    f<<"# Result: "<<(ok?"PASS":"FAIL")<<" (max_error="<<mx<<")\n";f.close(); return ok?0:1;
}
