/* !
 * \file c_api_asc_set_gm2l1_loop_size.asc
 * \brief 测试 asc_set_gm2l1_loop_size: 设置 GM→L1 搬运的循环体配置 (dav-3510)
 *
 * 验证方式: asc_set_gm2l1_loop_size + stride → GM→L1(multi-block)→L0A→MMAD→L0C→GM,
 *          通过 MMAD 间接验证多个数据块被正确搬运
 * 覆盖场景: 单核, 单分形 (16×16 half), loop1=2
 */

#include <cstdint>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16, K_SIZE = 16, N_SIZE = 16;
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE, TOTAL_B = K_SIZE * N_SIZE, TOTAL_C = M_SIZE * N_SIZE;

/* --------------------------------------------------------------------------
 * Kernel: set loop_size=2 → GM→L1(two blocks)→L0A→MMAD→L0C→GM
 * 搬运 2 个 256B 块 (各 16×16 half)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void kernel_asc_set_gm2l1_loop_size(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();
    __cbuf__ half l1_a[TOTAL_A*2], l1_b[TOTAL_B];
    __ca__ half l0a[TOTAL_A];
    __cb__ half l0b[TOTAL_B];
    __cc__ float l0c[TOTAL_C];

    // 1. API UNDER TEST: 设置 loop 配置
    //    void asc_set_gm2l1_loop_size(uint64_t loop1_size, uint64_t loop2_size)
    //    loop1_size=2 (搬运 2 个块)
    asc_set_gm2l1_loop_size(2, 1);
    asc_set_gm2l1_loop1_stride(1/*src: 块间隔=1 fractal=32B*/, 0/*dst:连续*/);

    // 2. GM→L1: 2 个数据块, 每个 256B
    //    k_step 单位 32B, 一个 16×16 half 分形 = 256B = 8*32B
    asc_copy_gm2l1_sync(l1_a, gm_a, 0, 0, 0, 1, 8, 0, 0);

    // 3. 恢复 loop 配置
    asc_set_gm2l1_loop_size(1, 1);

    // 4. GM→L1 for B (ones)
    asc_copy_gm2l1_sync(l1_b, gm_b, 0, 0, 0, 1, 1, 0, 0);

    // 5. L1→L0A (取第一个分形), L1→L0B
    asc_copy_l12l0a_sync(l0a, l1_a, 0, 0, 1, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b, l1_b, 0, 0, 1, 1, 0, 0);

    // 6. MMAD
    asc_mmad_sync(l0c, l0a, l0b, M_SIZE, K_SIZE, N_SIZE,
                  0, false, false, true);

    // 7. L0C→GM
    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c,
        N_SIZE, M_SIZE, N_SIZE, 1, 0,
        0, 0, 0, 0, false, false, 0, 0, false, 0, false, false, false, false);
}

std::vector<float> run_kernel(std::vector<half> &a, std::vector<half> &b)
{
    size_t ba = a.size()*2, bb = b.size()*2, bc = TOTAL_C*4;
    aclrtStream s = nullptr; uint8_t *cH = nullptr;
    half *aD = nullptr, *bD = nullptr; float *cD = nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    aclrtMallocHost((void**)&cH, bc);
    aclrtMalloc((void**)&aD, ba, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bD, bb, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cD, bc, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy((uint8_t*)aD, ba, (uint8_t*)a.data(), ba, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bD, bb, (uint8_t*)b.data(), bb, ACL_MEMCPY_HOST_TO_DEVICE);
    kernel_asc_set_gm2l1_loop_size<<<NUM_BLOCKS, nullptr, s>>>(aD, bD, cD);
    aclrtSynchronizeStream(s);
    aclrtMemcpy(cH, bc, (uint8_t*)cD, bc, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> c((float*)cH, (float*)(cH + bc));
    aclrtFree(aD); aclrtFree(bD); aclrtFree(cD); aclrtFreeHost(cH);
    aclrtDestroyStream(s); aclrtResetDevice(0); aclFinalize();
    return c;
}

// Helper: half value printer
template<typename T>
void print_val(T val, std::ostream& os) {
    if constexpr (std::is_same_v<T, half>) {
        os << static_cast<float>(val);
    } else {
        os << val;
    }
}

// Save a 2D matrix to CSV
template<typename T>
void save_matrix_csv(const std::vector<T>& mat, uint32_t rows, uint32_t cols,
                     const std::string& fname) {
    std::ofstream f(fname);
    f << "row,col,value\n";
    for (uint32_t r = 0; r < rows; ++r)
        for (uint32_t c = 0; c < cols; ++c) {
            f << r << "," << c << ",";
            print_val(mat[r*cols + c], f);
            f << "\n";
        }
    f.close();
    std::cout << "  [CSV] " << fname << " (" << rows << "x" << cols << ")\n";
}

// Save C output + expected (float type)
void save_c_csv_float(const std::vector<float>& output, const std::vector<float>& expected,
                uint32_t rows, uint32_t cols, const std::string& fname) {
    std::ofstream f(fname);
    f << "row,col,output,expected\n";
    for (uint32_t r = 0; r < rows; ++r)
        for (uint32_t c = 0; c < cols; ++c) {
            f << r << "," << c << ","
              << output[r*cols + c] << ","
              << expected[r*cols + c] << "\n";
        }
    f.close();
    std::cout << "  [CSV] " << fname << " (" << rows << "x" << cols << ")\n";
}

int32_t main(int32_t argc, char *argv[])
{
    std::vector<half> a(TOTAL_A*2), b(TOTAL_B);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t k = 0; k < K_SIZE; ++k)
            a[i*K_SIZE + k] = half((i + k) * 0.1f);
    for (uint32_t k = 0; k < K_SIZE; ++k)
        for (uint32_t j = 0; j < N_SIZE; ++j)
            b[k*N_SIZE + j] = half(1.0f);

    save_matrix_csv(a, M_SIZE, K_SIZE, "set_gm2l1_loop_size_a.csv");
    save_matrix_csv(b, K_SIZE, N_SIZE, "set_gm2l1_loop_size_b.csv");

    std::vector<float> output = run_kernel(a, b);

    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i)
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k)
                sum += float(a[i*K_SIZE+k]) * float(b[k*N_SIZE+j]);
            golden[i*N_SIZE+j] = sum;
        }

    save_c_csv_float(output, golden, M_SIZE, N_SIZE, "set_gm2l1_loop_size_c.csv");

    float mx = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float e = std::abs(output[i] - golden[i]);
        if (e > mx) mx = e;
    }
    bool ok = mx < 0.001f;
    std::cout << (ok?"[PASS]":"[FAIL]") << " asc_set_gm2l1_loop_size max_error=" << mx << std::endl;
    std::ofstream f("asc_set_gm2l1_loop_size.csv");
    f << "result\n" << (ok?"PASS":"FAIL") << ",max_error=" << mx << "\n"; f.close();
    return ok?0:1;
}
