{
    "name": "asc-devkit",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    "workspaceFolder": "/workspaces/asc-devkit",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/asc-devkit,type=bind,consistency=cached",
    "customizations": {
        "vscode": {
            "extensions": [
                "eamodio.gitlens",
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",
                "twxs.cmake"
            ],
            "settings": {
                "cmake.sourceDirectory": "${workspaceFolder}",
                "cmake.buildDirectory": "${workspaceFolder}/build",
                "cmake.buildType": "Debug",
                "cmake.generator": "Ninja",
                "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools"
            }
        }
    },
    "postCreateCommand": "cmake -S ${containerWorkspaceFolder} -B ${containerWorkspaceFolder}/build -G Ninja -DCMAKE_BUILD_TYPE=Debug 2>/dev/null || true"
}
