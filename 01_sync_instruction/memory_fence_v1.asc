/* !
 * \file sync_barrier.asc
 * \brief
 */

#include <chrono>
#include <iostream>
#include <iterator>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
    constexpr uint32_t THREAD_COUNT = 2048;
}

__gm__ uint32_t count = 0;

__aicore__ inline void block_reduce(float* smem, uint32_t tid, float val) {
    smem[tid] = val;
    asc_syncthreads();
    for (int s = blockDim.x / 2; s > 0; s >>= 1) {
        if (tid < s) {
            smem[tid] += smem[tid + s];
        }
        asc_syncthreads();
    }
}

__global__ void __launch_bounds__(THREAD_COUNT) kernel_memory_fence(float* input, float* block_sums, float* output, uint32_t input_total_length) {
    extern __ubuf__ float smem[];
    uint32_t tid = threadIdx.x;
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;

    block_reduce(smem, tid, input[idx]);

    __ubuf__ uint32_t is_last;
    if (tid == 0) {
        block_sums[blockIdx.x] = smem[0];
        asc_threadfence();
        uint32_t ticket = asc_atomic_add(&count, 1);
        is_last = (ticket == gridDim.x - 1);
    }
    asc_syncthreads();

    if (is_last) {
        float val = (tid < gridDim.x) ? block_sums[tid] : 0;
        block_reduce(smem, tid, val);

        if (tid == 0) {
            output[0] = smem[0];
        }
    }
}

uint32_t verify_result(float output, float golden)
{
    std::cout << "Output: " << output << std::endl;
    std::cout << "Golden: " << golden << std::endl;
    if (output == golden) {
        std::cout << "[Success] Case accuracy verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
        return 1;
    }
}

float random_float(float min, float max)
{
    static std::mt19937 engine(std::chrono::system_clock::now().time_since_epoch().count());
    std::uniform_real_distribution<float> dist(min, max);
    return dist(engine);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t input_total_length = 36 * 2048;

    uint32_t thread_num_per_block = THREAD_COUNT;
    uint32_t dyn_ubuf_size = thread_num_per_block * sizeof(float);
    uint32_t numBlocks = (input_total_length + thread_num_per_block -1) / thread_num_per_block;

    size_t input_total_byte_size = input_total_length * sizeof(float);
    size_t block_sums_total_byte_size = numBlocks * sizeof(float);
    size_t output_total_byte_size = 1 * sizeof(float);

    std::vector<float> input(input_total_length);
    for (uint32_t i = 0; i < input_total_length; i++) {
        input[i] = random_float(0.0f, 10.0f);
    }

    int32_t device_id = 0;
    aclrtStream stream = nullptr;

    uint8_t* input_host = reinterpret_cast<uint8_t *>(input.data());
    uint8_t* output_host = nullptr;
    float* input_device = nullptr;
    float* block_sums_device = nullptr;
    float* output_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)&output_host, output_total_byte_size);
    aclrtMalloc((void **)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&block_sums_device, block_sums_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&output_device, output_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    
    aclrtMemcpy(input_device, input_total_byte_size, input_host, input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    kernel_memory_fence<<<numBlocks, thread_num_per_block, dyn_ubuf_size, stream>>>(
              input_device, block_sums_device, output_device, input_total_length);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_total_byte_size, output_device, output_total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    float output = *reinterpret_cast<float *>(output_host);

    aclrtFree(input_device);
    aclrtFree(block_sums_device);
    aclrtFree(output_device);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();


    std::vector<float> block_sums(numBlocks);
    for (uint32_t b = 0; b < numBlocks; b++) {
        std::vector<float> reduce_buf(input.begin() + b * thread_num_per_block,
                                      input.begin() + (b + 1) * thread_num_per_block);
        for (int s = thread_num_per_block / 2; s > 0; s >>= 1) {
            for (int i = 0; i < s; i++) {
                reduce_buf[i] += reduce_buf[i + s];
            }
        }
        block_sums[b] = reduce_buf[0];
    }

    std::vector<float> grid_partial(thread_num_per_block, 0.0f);
    for (uint32_t tid = 0; tid < thread_num_per_block; tid++) {
        grid_partial[tid] = (tid < numBlocks) ? block_sums[tid] : 0.0f;
    }

    for (int s = thread_num_per_block / 2; s > 0; s >>= 1) {
        for (int i = 0; i < s; i++) {
            grid_partial[i] += grid_partial[i + s];
        }
    }
    float golden = grid_partial[0];

    return verify_result(output, golden);
}
