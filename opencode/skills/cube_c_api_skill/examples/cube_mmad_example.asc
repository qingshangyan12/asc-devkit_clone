/* !
 * \file cube_mmad_example.asc
 * \brief Cube核 C API 矩阵乘加 (asc_mmad) 示例
 *
 * 覆盖数据类型: half (A) x half (B) -> float (C)
 * 覆盖场景: 单核, 单分形 (16x16)
 * 数据流: GM -> L1 -> L0A/L0B -> asc_mmad -> L0C -> GM
 * 架构: dav-2201 (分形概念同样适用于dav-3510)
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t M_SIZE = 16;
constexpr uint32_t K_SIZE = 16;
constexpr uint32_t N_SIZE = 16;

// 16x16 half = 512B = 16 DataBlocks (每DataBlock=32B)
constexpr uint32_t TOTAL_A = M_SIZE * K_SIZE;   // 256 elements
constexpr uint32_t TOTAL_B = K_SIZE * N_SIZE;   // 256 elements
constexpr uint32_t TOTAL_C = M_SIZE * N_SIZE;   // 256 elements

// 搬运参数: 512B / 32B = 16 个 DataBlock
constexpr uint16_t BURST_LEN_HALF = TOTAL_A * sizeof(half) / 32;  // 512/32 = 16

/* --------------------------------------------------------------------------
 * Cube核 kernel: half x half -> float 矩阵乘法 (单分形)
 * -------------------------------------------------------------------------- */
__cube__ __global__ __aicore__ void cube_mmad_kernel(
    __gm__ half* gm_a, __gm__ half* gm_b, __gm__ float* gm_c)
{
    asc_init();

    __cbuf__ half l1_a[TOTAL_A];
    __cbuf__ half l1_b[TOTAL_B];
    __ca__ half l0a_a[TOTAL_A];
    __cb__ half l0b_b[TOTAL_B];
    __cc__ float l0c_c[TOTAL_C];

    // GM -> L1: burst-based搬运
    // size=512: 256 half elements * 2B = 512B
    asc_copy_gm2l1_sync(
        (__cbuf__ void*)l1_a, (__gm__ void*)gm_a,
        TOTAL_A * sizeof(half));
    asc_copy_gm2l1_sync(
        (__cbuf__ void*)l1_b, (__gm__ void*)gm_b,
        TOTAL_B * sizeof(half));

    // L1 -> L0A, L0B: 分形搬运
    asc_copy_l12l0a_sync(l0a_a, l1_a, 0, 1, 0, 0);
    asc_copy_l12l0b_sync(l0b_b, l1_b, 0, 1, 0, 0);

    // Matrix multiply-add: C = A * B
    constexpr uint16_t left_height = M_SIZE;
    constexpr uint16_t n_dim = K_SIZE;
    constexpr uint16_t right_width = N_SIZE;
    constexpr uint8_t unit_flag = 0;
    constexpr bool k_direction_align = true;
    constexpr bool c_matrix_source = false;
    constexpr bool c_matrix_init_val = true;

    asc_mmad_sync(l0c_c, l0a_a, l0b_b,
                  left_height, n_dim, right_width,
                  unit_flag, k_direction_align,
                  c_matrix_source, c_matrix_init_val);

    // L0C -> GM
    constexpr uint16_t n_size_l0c = 1;
    constexpr uint16_t m_size_l0c = 1;
    constexpr uint32_t dst_stride_dst_d = 0;
    constexpr uint16_t src_stride_l0c = 0;
    constexpr uint8_t unit_flag_mode = 0;
    constexpr uint64_t quant_pre = 0;
    constexpr uint8_t relu_pre = 0;
    constexpr bool channel_split = false;
    constexpr bool nz2nd_en = true;

    asc_copy_l0c2gm_sync(
        (__gm__ float*)gm_c, l0c_c,
        n_size_l0c, m_size_l0c,
        dst_stride_dst_d, src_stride_l0c,
        unit_flag_mode, quant_pre,
        relu_pre, channel_split, nz2nd_en);
}

/* --------------------------------------------------------------------------
 * Host 侧调用
 * -------------------------------------------------------------------------- */
std::vector<float> kernel_cube_mmad(
    std::vector<half> &a, std::vector<half> &b)
{
    uint32_t totalLenA = a.size();
    uint32_t totalLenB = b.size();
    uint32_t totalLenC = TOTAL_C;

    size_t byteSizeA = totalLenA * sizeof(half);
    size_t byteSizeB = totalLenB * sizeof(half);
    size_t byteSizeC = totalLenC * sizeof(float);

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;

    uint8_t *aHost = reinterpret_cast<uint8_t *>(a.data());
    uint8_t *bHost = reinterpret_cast<uint8_t *>(b.data());
    uint8_t *cHost = nullptr;

    half *aDevice = nullptr;
    half *bDevice = nullptr;
    float *cDevice = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMallocHost((void **)(&cHost), byteSizeC);
    aclrtMalloc((void **)&aDevice, byteSizeA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&bDevice, byteSizeB, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&cDevice, byteSizeC, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)aDevice, byteSizeA, aHost, byteSizeA,
                ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)bDevice, byteSizeB, bHost, byteSizeB,
                ACL_MEMCPY_HOST_TO_DEVICE);

    cube_mmad_kernel<<<NUM_BLOCKS, nullptr, stream>>>(aDevice, bDevice, cDevice);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cHost, byteSizeC, (uint8_t*)cDevice, byteSizeC,
                ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> c((float *)cHost,
                         (float *)(cHost + byteSizeC));

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFreeHost(cHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return c;
}

/* --------------------------------------------------------------------------
 * 精度验证
 * -------------------------------------------------------------------------- */
uint32_t verify_result(
    std::vector<float> &output,
    std::vector<float> &golden)
{
    constexpr size_t maxPrintSize = 4;
    std::cout << "Output: ";
    for (size_t i = 0; i < std::min(output.size(), maxPrintSize); ++i) {
        std::cout << output[i] << " ";
    }
    std::cout << std::endl;

    std::cout << "Golden: ";
    for (size_t i = 0; i < std::min(golden.size(), maxPrintSize); ++i) {
        std::cout << golden[i] << " ";
    }
    std::cout << std::endl;

    float maxError = 0.0f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float error = std::abs(output[i] - golden[i]);
        if (error > maxError) {
            maxError = error;
        }
    }

    constexpr float epsilon = 0.001f;
    if (maxError < epsilon) {
        std::cout << "[Success] cube_mmad accuracy passed."
                  << " max_error=" << maxError << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] cube_mmad accuracy failed!"
                  << " max_error=" << maxError << std::endl;
        return 1;
    }
}

/* --------------------------------------------------------------------------
 * 主函数
 * -------------------------------------------------------------------------- */
int32_t main(int32_t argc, char *argv[])
{
    // 初始化 A (MxK) 和 B (KxN)
    std::vector<half> a(TOTAL_A);
    std::vector<half> b(TOTAL_B);

    for (uint32_t i = 0; i < M_SIZE; ++i) {
        for (uint32_t k = 0; k < K_SIZE; ++k) {
            a[i * K_SIZE + k] = half((i + k) * 0.1f);
        }
    }
    for (uint32_t k = 0; k < K_SIZE; ++k) {
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            b[k * N_SIZE + j] = half((k + j) * 0.1f);
        }
    }

    // 调用 kernel
    std::vector<float> output = kernel_cube_mmad(a, b);

    // 计算 CPU 真值
    std::vector<float> golden(TOTAL_C, 0.0f);
    for (uint32_t i = 0; i < M_SIZE; ++i) {
        for (uint32_t j = 0; j < N_SIZE; ++j) {
            float sum = 0.0f;
            for (uint32_t k = 0; k < K_SIZE; ++k) {
                sum += float(a[i * K_SIZE + k]) * float(b[k * N_SIZE + j]);
            }
            golden[i * N_SIZE + j] = sum;
        }
    }

    return verify_result(output, golden);
}
