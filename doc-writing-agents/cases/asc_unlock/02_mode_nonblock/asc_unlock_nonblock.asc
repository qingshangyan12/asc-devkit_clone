#include "c_api/asc_simd.h"
__global__ __vector__ void kernel_asc_unlock_nonblock()
{
    uint8_t mutex_id = 2;
    asc_lock(PIPE_S, mutex_id, ASC_LOCK_NON_BLOCK);
    asc_unlock(PIPE_S, mutex_id, ASC_LOCK_NON_BLOCK);
}
#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_asc_unlock_nonblock();
    printf("asc_unlock NON_BLOCK test (3510 only): compiled and executed successfully.\n");
    return 0;
}
#endif
