#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_sync_basic()
{
    asc_sync();
    asc_sync_vec();
    asc_sync_pipe(PIPE_MTE2);
    asc_sync_mte2(0);
    asc_sync_mte3(0);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_sync_basic();
    printf("sync basic test: compiled and executed successfully.\n");
    return 0;
}
#endif
