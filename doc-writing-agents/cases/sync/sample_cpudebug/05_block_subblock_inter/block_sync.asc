#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_block_sync()
{
    int64_t flag_id = 1;
    asc_sync_block_arrive(PIPE_S, flag_id);
    asc_sync_block_wait(PIPE_S, flag_id);

    asc_sync_subblock_arrive(PIPE_S, flag_id);
    asc_sync_subblock_wait(PIPE_S, flag_id);

    asc_sync_inter_arrive(PIPE_S, flag_id);
    asc_sync_inter_wait(PIPE_S, flag_id);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_block_sync();
    printf("block/subblock/inter sync test: compiled and executed successfully.\n");
    return 0;
}
#endif
