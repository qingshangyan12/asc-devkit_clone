#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_sync_dsb()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
    asc_sync_data_barrier(mem_dsb_t::DSB_DDR);
    asc_sync_data_barrier(mem_dsb_t::DSB_UB);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_sync_dsb();
    printf("sync_data_barrier test: compiled and executed successfully.\n");
    return 0;
}
#endif
