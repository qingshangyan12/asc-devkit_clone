#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_lock_unlock()
{
    uint8_t mutex_id = 1;
    asc_lock(PIPE_S, mutex_id);
    asc_unlock(PIPE_S, mutex_id);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_lock_unlock();
    printf("lock_unlock test (3510 only): compiled and executed successfully.\n");
    return 0;
}
#endif
