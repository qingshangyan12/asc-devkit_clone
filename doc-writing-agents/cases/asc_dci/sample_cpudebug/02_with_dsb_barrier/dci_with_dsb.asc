#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_dci_with_dsb()
{
    asc_sync_data_barrier(mem_dsb_t::DSB_ALL);
    asc_dci();
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_dci_with_dsb();
    printf("asc_dci with DSB barrier test (3510 only): compiled and executed successfully.\n");
    return 0;
}
#endif
