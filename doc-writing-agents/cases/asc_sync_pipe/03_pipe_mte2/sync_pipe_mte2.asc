#include "c_api/asc_simd.h"
constexpr uint32_t total_length = 128;
__global__ __vector__ void kernel_sync_pipe_mte2(__gm__ float* src0_gm, __gm__ float* src1_gm)
{
    __ubuf__ float src0[total_length];
    __ubuf__ float* src1 = src0 + 64;
    asc_copy_gm2ub(src0, src0_gm, 128 * sizeof(float));
    asc_sync_pipe(PIPE_MTE2);
    asc_copy_gm2ub(src1, src1_gm, 32 * sizeof(float));
}
#ifdef ASCENDC_CPU_DEBUG
int main()
{
    float src0_buf[128] = {0};
    float src1_buf[32] = {0};
    kernel_sync_pipe_mte2(
        reinterpret_cast<__gm__ float*>(src0_buf),
        reinterpret_cast<__gm__ float*>(src1_buf));
    printf("asc_sync_pipe MTE2 overlap test: compiled and executed successfully.\n");
    return 0;
}
#endif
