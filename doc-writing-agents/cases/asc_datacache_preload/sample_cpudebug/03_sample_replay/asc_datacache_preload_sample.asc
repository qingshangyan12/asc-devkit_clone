#include "c_api/asc_simd.h"

#define BUF_SIZE 16

__global__ __vector__ void kernel_asc_datacache_preload_sample(__gm__ float* x)
{
    int32_t block_idx = 0;
    __gm__ float* x_gm = x + block_idx * 16;
    int64_t cacheOffset = 0;
    asc_datacache_preload(reinterpret_cast<__gm__ uint64_t*>(x_gm), cacheOffset);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    float input_buf[BUF_SIZE];
    for (int i = 0; i < BUF_SIZE; i++) {
        input_buf[i] = static_cast<float>(i);
    }
    __gm__ float* x = reinterpret_cast<__gm__ float*>(input_buf);

    kernel_asc_datacache_preload_sample(x);

    printf("asc_datacache_preload sample replay: compiled and executed successfully.\n");
    return 0;
}
#endif
