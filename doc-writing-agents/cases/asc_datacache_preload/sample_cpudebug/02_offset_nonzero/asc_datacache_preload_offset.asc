#include "c_api/asc_simd.h"

#define BUF_SIZE 64

__global__ __vector__ void kernel_asc_datacache_preload_offset(__gm__ float* x_gm)
{
    int64_t cacheOffset = 64;
    asc_datacache_preload(reinterpret_cast<__gm__ uint64_t*>(x_gm), cacheOffset);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    float input_buf[BUF_SIZE];
    for (int i = 0; i < BUF_SIZE; i++) {
        input_buf[i] = static_cast<float>(i);
    }
    __gm__ float* x_gm = reinterpret_cast<__gm__ float*>(input_buf);

    kernel_asc_datacache_preload_offset(x_gm);

    printf("asc_datacache_preload offset=64 invoke test: compiled and executed successfully.\n");
    return 0;
}
#endif
