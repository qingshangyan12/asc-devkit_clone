#include "c_api/asc_simd.h"

#define BUF_SIZE 16

__global__ __vector__ void kernel_dcci_single_gm(__gm__ float* x_gm)
{
    for (int i = 0; i < 16; i++) {
        x_gm[i] = static_cast<float>(i);
    }
    asc_dcci_single(reinterpret_cast<__gm__ void*>(x_gm));
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    float input_buf[BUF_SIZE];
    for (int i = 0; i < BUF_SIZE; i++) {
        input_buf[i] = static_cast<float>(i);
    }
    __gm__ float* x_gm = reinterpret_cast<__gm__ float*>(input_buf);

    kernel_dcci_single_gm(x_gm);

    printf("asc_dcci_single (GM) test: compiled and executed successfully.\n");
    return 0;
}
#endif
