#include "c_api/asc_simd.h"

constexpr uint32_t BUF_SIZE = 16;

__global__ __vector__ void kernel_dcci_single_ub()
{
    __ubuf__ float ub_buf[BUF_SIZE];
    for (int i = 0; i < 16; i++) {
        ub_buf[i] = static_cast<float>(i);
    }
    asc_ub_dcci_single(reinterpret_cast<__ubuf__ void*>(ub_buf));
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_dcci_single_ub();
    printf("asc_ub_dcci_single test: compiled and executed successfully.\n");
    return 0;
}
#endif
