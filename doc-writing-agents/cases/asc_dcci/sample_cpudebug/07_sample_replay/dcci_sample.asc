#include "c_api/asc_simd.h"

#define BUF_SIZE 16

__global__ __vector__ void kernel_dcci_sample(__gm__ float* x)
{
    int32_t block_idx = 0;
    __gm__ float* x_gm = x + block_idx * 16;
    for (int i = 0; i < 16; i++) {
        x_gm[i] = static_cast<float>(i + block_idx);
    }
    asc_dcci_single(reinterpret_cast<__gm__ uint64_t*>(x_gm));
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    float input_buf[BUF_SIZE];
    __gm__ float* x = reinterpret_cast<__gm__ float*>(input_buf);

    kernel_dcci_sample(x);

    printf("asc_dcci sample replay: compiled and executed successfully.\n");
    return 0;
}
#endif
