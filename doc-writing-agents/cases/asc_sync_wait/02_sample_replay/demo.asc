#include "c_api/sync/sync.h"

class KernelSampleReplay {
public:
    __aicore__ inline void Init() {}
    __aicore__ inline void Process() {
        asc_sync_notify(PIPE_MTE3, PIPE_S, 0);
        asc_sync_wait(PIPE_S, PIPE_MTE3, 0);
    }
};

extern "C" __aicore__ inline void main() {
    KernelSampleReplay op;
    op.Init();
    op.Process();
}
