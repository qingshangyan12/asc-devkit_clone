#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_icache_preload_sample()
{
    int64_t prefetch_length = 32;
    int64_t pc = asc_get_program_counter() & 0xFFFFFFFFFFFF;
    asc_icache_preload(reinterpret_cast<void*>(pc), prefetch_length);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_icache_preload_sample();
    printf("asc_icache_preload sample replay: compiled and executed successfully.\n");
    return 0;
}
#endif
