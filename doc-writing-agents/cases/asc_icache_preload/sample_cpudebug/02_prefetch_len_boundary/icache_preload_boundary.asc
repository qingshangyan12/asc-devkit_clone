#include "c_api/asc_simd.h"

__global__ __vector__ void kernel_icache_preload_boundary()
{
    int64_t pc = 0;

    int64_t prefetch_len_1 = 1;
    asc_icache_preload(reinterpret_cast<void*>(pc), prefetch_len_1);

    int64_t prefetch_len_max_aic = 15;
    asc_icache_preload(reinterpret_cast<void*>(pc), prefetch_len_max_aic);

    int64_t prefetch_len_max_aiv = 7;
    asc_icache_preload(reinterpret_cast<void*>(pc), prefetch_len_max_aiv);
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    kernel_icache_preload_boundary();
    printf("asc_icache_preload boundary test: compiled and executed successfully.\n");
    printf("  AIC ICache=32KB, max prefetch_len=15 (32K/2K-1)\n");
    printf("  AIV ICache=16KB, max prefetch_len=7 (16K/2K-1)\n");
    return 0;
}
#endif
