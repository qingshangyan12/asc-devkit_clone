#include "c_api/asc_simd.h"
constexpr uint32_t total_length = 128;
__global__ __vector__ void kernel_sync_mte2_sample(__gm__ float* src0_gm, __gm__ float* src1_gm, __gm__ float* dst_gm)
{
    __ubuf__ float src0[total_length];
    __ubuf__ float src1[total_length];
    __ubuf__ float dst[total_length];
    asc_copy_gm2ub(src0, src0_gm, total_length * sizeof(float));
    asc_sync_mte2(0);
    asc_copy_gm2ub(src1, src1_gm, total_length * sizeof(float));
    asc_add(dst, src1, src0, total_length);
    asc_copy_ub2gm(dst_gm, dst, total_length * sizeof(float));
}
#ifdef ASCENDC_CPU_DEBUG
int main()
{
    float src0_buf[total_length] = {0};
    float src1_buf[total_length] = {0};
    float dst_buf[total_length] = {0};
    kernel_sync_mte2_sample(
        reinterpret_cast<__gm__ float*>(src0_buf),
        reinterpret_cast<__gm__ float*>(src1_buf),
        reinterpret_cast<__gm__ float*>(dst_buf));
    printf("asc_sync_mte2 sample replay: compiled and executed successfully.\n");
    return 0;
}
#endif
