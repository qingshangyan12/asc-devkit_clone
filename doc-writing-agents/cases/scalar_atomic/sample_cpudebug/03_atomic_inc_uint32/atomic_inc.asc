#include "c_api/asc_simd.h"

using namespace __asc_aicore;

__global__ __vector__ void kernel_atomic_inc(__gm__ uint32_t* addr)
{
    uint32_t val = 100;
    uint32_t old = asc_atomic_inc(addr, val);
    (void)old;
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    uint32_t data = 0;
    __gm__ uint32_t* addr = reinterpret_cast<__gm__ uint32_t*>(&data);
    kernel_atomic_inc(addr);
    printf("asc_atomic_inc test (3510 only): compiled and executed successfully.\n");
    return 0;
}
#endif
