#include "c_api/asc_simd.h"

using namespace __asc_aicore;

__global__ __vector__ void kernel_atomic_cas(__gm__ int32_t* addr)
{
    int32_t compare = 5;
    int32_t val = 10;
    int32_t old = asc_atomic_cas(addr, compare, val);
    (void)old;
}

#ifdef ASCENDC_CPU_DEBUG
int main()
{
    int32_t data = 5;
    __gm__ int32_t* addr = reinterpret_cast<__gm__ int32_t*>(&data);
    kernel_atomic_cas(addr);
    printf("asc_atomic_cas test (3510 only): compiled and executed successfully.\n");
    return 0;
}
#endif
